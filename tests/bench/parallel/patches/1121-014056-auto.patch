+from datetime import date
+
+import pytest
+
+from kakeibo.compare import Change, format_report, month_over_month
+from kakeibo.core import Expense
+
+
+def test_e4_1_missing_current_month_counts_as_zero() -> None:
+    """E4-1: 2026-01 食費 1000, month=2026-02 with no February rows."""
+    rows = [Expense(date(2026, 1, 15), "食費", 1000)]
+    assert month_over_month(rows, "2026-02") == [Change("食費", 1000, 0, -1000, -1.0)]
+
+
+def test_e4_2_new_category_has_no_ratio_and_is_marked_new() -> None:
+    """E4-2: previous 0, current 500 交通費 -> ratio None, line shows (新規)."""
+    rows = [Expense(date(2026, 2, 3), "交通費", 500)]
+    changes = month_over_month(rows, "2026-02")
+    assert changes == [Change("交通費", 0, 500, 500, None)]
+    assert "(新規)" in format_report(changes, "2026-02")
+
+
+def test_e4_3_invalid_month_raises_value_error() -> None:
+    """E4-3: month="2026-13" -> ValueError."""
+    with pytest.raises(ValueError):
+        month_over_month([], "2026-13")
