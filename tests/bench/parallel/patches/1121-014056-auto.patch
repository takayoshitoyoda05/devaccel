+"""Month-over-month spending comparison (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense, monthly_totals
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class Change:
+    category: str
+    previous: int
+    current: int
+    diff: int
+    ratio: float | None
+
+
+def _check_month(month: object) -> str:
+    if isinstance(month, bool) or not isinstance(month, str):
+        raise TypeError(f"month は str である必要があります: {month!r}")
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"month は YYYY-MM 形式である必要があります: {month!r}")
+    return month
+
+
+def _previous_month(month: str) -> str:
+    year, mon = int(month[:4]), int(month[5:7])
+    if mon == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mon - 1:02d}"
+
+
+def month_over_month(rows: list[Expense], month: str) -> list[Change]:
+    """Compare each category's total in `month` with the calendar previous month."""
+    _check_month(month)
+    totals = monthly_totals(rows)
+    cur = totals.get(month, {})
+    prev = totals.get(_previous_month(month), {})
+    changes: list[Change] = []
+    for category in set(cur) | set(prev):
+        p = prev.get(category, 0)
+        c = cur.get(category, 0)
+        if p == 0 and c == 0:
+            continue
+        diff = c - p
+        ratio = None if p == 0 else diff / p
+        changes.append(Change(category, p, c, diff, ratio))
+    changes.sort(key=lambda ch: (-abs(ch.diff), ch.category))
+    return changes
+
+
+def _format_line(ch: Change) -> str:
+    if ch.diff == 0:
+        return f"{ch.category}  変化なし"
+    word = "増" if ch.diff > 0 else "減"
+    if ch.previous == 0:
+        tag = "(新規)"
+    elif ch.current == 0:
+        tag = "(なくなった)"
+    else:
+        tag = f"({(ch.ratio or 0.0):+.1%})"
+    return f"{ch.category}  {ch.diff:+,}円 {tag} {word}"
+
+
+def format_report(changes: list[Change], month: str) -> str:
+    _check_month(month)
+    lines = [f"{month} の前月比"]
+    if not changes:
+        lines.append("変化なし")
+    lines.extend(_format_line(ch) for ch in changes)
+    return "\n".join(lines)
