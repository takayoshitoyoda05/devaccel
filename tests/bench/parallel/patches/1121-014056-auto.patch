--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,117 @@
+"""Condition-based search over Expense rows (pure functions, no I/O)."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable
+from datetime import date
+
+from kakeibo.core import Expense
+
+Query = Callable[[Expense], bool]
+
+_KEYS = ("category", "min_amount", "max_amount", "memo_contains", "since", "until")
+
+
+def _norm(s: str) -> str:
+    """D2: NFKC -> lowercase -> remove whitespace."""
+    return "".join(unicodedata.normalize("NFKC", s).lower().split())
+
+
+def _check_yen(key: str, v: object) -> int:
+    if isinstance(v, bool) or not isinstance(v, int):
+        raise TypeError(f"{key} は円の整数である必要があります: {v!r}")
+    return v
+
+
+def _check_date(key: str, v: object) -> date:
+    if not isinstance(v, date):
+        raise TypeError(f"{key} は date である必要があります: {v!r}")
+    return v
+
+
+def _category_query(v: object) -> Query:
+    if isinstance(v, str):
+        wanted = {_norm(v)}
+    elif isinstance(v, (set, frozenset, list, tuple)):
+        for item in v:
+            if not isinstance(item, str):
+                raise TypeError(f"category の要素は str である必要があります: {item!r}")
+        wanted = {_norm(item) for item in v}
+    else:
+        raise TypeError(
+            f"category は str か str の集合/リストである必要があります: {v!r}"
+        )
+    return lambda e: _norm(e.category) in wanted
+
+
+def make_filter(**cond: object) -> Query:
+    unknown = [k for k in cond if k not in _KEYS]
+    if unknown:
+        raise ValueError(f"未知の条件キーです: {', '.join(sorted(unknown))}")
+
+    preds: list[Query] = []
+    if "category" in cond:
+        preds.append(_category_query(cond["category"]))
+
+    lo = hi = None
+    if "min_amount" in cond:
+        lo = _check_yen("min_amount", cond["min_amount"])
+    if "max_amount" in cond:
+        hi = _check_yen("max_amount", cond["max_amount"])
+    if lo is not None and hi is not None and lo > hi:
+        raise ValueError(f"min_amount ({lo}) が max_amount ({hi}) より大きいです")
+    if lo is not None:
+        preds.append(lambda e, lo=lo: e.amount >= lo)
+    if hi is not None:
+        preds.append(lambda e, hi=hi: e.amount <= hi)
+
+    if "memo_contains" in cond:
+        if not isinstance(cond["memo_contains"], str):
+            raise TypeError(
+                f"memo_contains は str である必要があります: {cond['memo_contains']!r}"
+            )
+        needle = _norm(cond["memo_contains"])
+        if needle:
+            preds.append(lambda e, n=needle: n in _norm(e.memo))
+
+    since = until = None
+    if "since" in cond:
+        since = _check_date("since", cond["since"])
+    if "until" in cond:
+        until = _check_date("until", cond["until"])
+    if since is not None and until is not None and since > until:
+        raise ValueError(f"since ({since}) が until ({until}) より後です")
+    if since is not None:
+        preds.append(lambda e, s=since: e.day >= s)
+    if until is not None:
+        preds.append(lambda e, u=until: e.day <= u)
+
+    return all_of(*preds)
+
+
+def all_of(*qs: Query) -> Query:
+    for q in qs:
+        _require_query(q)
+    return lambda e: all(q(e) for q in qs)
+
+
+def any_of(*qs: Query) -> Query:
+    for q in qs:
+        _require_query(q)
+    return lambda e: any(q(e) for q in qs)
+
+
+def not_(q: Query) -> Query:
+    _require_query(q)
+    return lambda e: not q(e)
+
+
+def _require_query(q: object) -> None:
+    if not callable(q):
+        raise TypeError(f"Query は callable である必要があります: {q!r}")
+
+
+def search(rows: list[Expense], query: Query) -> list[Expense]:
+    _require_query(query)
+    return [e for e in rows if query(e)]
