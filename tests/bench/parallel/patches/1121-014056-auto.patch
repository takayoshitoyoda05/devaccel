+++ b/tests/test_recurring.py
@@ -0,0 +1,271 @@
+"""Tests for kakeibo.recurring (E1-*: 例の表の行、R/D: 規則)."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring
+
+
+def ex(day: str, amount: int, memo: str = "家賃", category: str = "住居") -> Expense:
+    return Expense(date.fromisoformat(day), category, amount, memo)
+
+
+# --- 例の表 ---------------------------------------------------------------
+
+
+def test_E1_1_next_day_is_month_after_last_with_clipped_day() -> None:
+    # E1-1: 家賃 80000 を 2026-01-31, 02-28, 03-31 → next_day 2026-04-30 (R3)
+    rows = [
+        ex("2026-01-31", 80000),
+        ex("2026-02-28", 80000),
+        ex("2026-03-31", 80000),
+    ]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="住居",
+            memo="家賃",
+            amount=80000,
+            count=3,
+            last_day=date(2026, 3, 31),
+            next_day=date(2026, 4, 30),
+        )
+    ]
+
+
+def test_E1_2_same_month_duplicates_count_once_using_first_occurrence() -> None:
+    # E1-2: 同月に 5 日と 20 日の同額 2 件 × 3 か月 → 1 系列、last_day は各月 1 件目 (R2)
+    rows = [
+        ex("2026-01-20", 500, memo="サブスク"),
+        ex("2026-01-05", 500, memo="サブスク"),
+        ex("2026-02-05", 500, memo="サブスク"),
+        ex("2026-02-20", 500, memo="サブスク"),
+        ex("2026-03-20", 500, memo="サブスク"),
+        ex("2026-03-05", 500, memo="サブスク"),
+    ]
+    found = find_recurring(rows)
+    assert len(found) == 1
+    assert found[0].count == 3
+    assert found[0].last_day == date(2026, 3, 5)
+
+
+def test_E1_3_min_months_below_two_raises_value_error() -> None:
+    # E1-3: min_months=1 → ValueError (R2)
+    with pytest.raises(ValueError, match="min_months"):
+        find_recurring([], min_months=1)
+
+
+# --- R1 系列キーと金額 ----------------------------------------------------
+
+
+def test_R1_amount_within_tolerance_joins_same_series_with_median_amount() -> None:
+    rows = [
+        ex("2026-01-01", 1000),
+        ex("2026-02-01", 1050),
+        ex("2026-03-01", 950),
+    ]
+    found = find_recurring(rows)
+    assert [r.amount for r in found] == [1000]
+    assert found[0].count == 3
+
+
+def test_R1_price_increase_becomes_separate_series() -> None:
+    rows = [
+        ex("2026-01-01", 1000),
+        ex("2026-02-01", 1000),
+        ex("2026-03-01", 1000),
+        ex("2026-04-01", 2000),
+        ex("2026-05-01", 2000),
+        ex("2026-06-01", 2000),
+    ]
+    found = find_recurring(rows)
+    assert [r.amount for r in found] == [2000, 1000]
+    assert all(r.count == 3 for r in found)
+
+
+def test_R1_different_category_is_different_series() -> None:
+    rows = [
+        ex("2026-01-01", 300, memo="電気", category="光熱"),
+        ex("2026-02-01", 300, memo="電気", category="雑費"),
+        ex("2026-02-01", 300, memo="電気", category="光熱"),
+        ex("2026-03-01", 300, memo="電気", category="光熱"),
+    ]
+    found = find_recurring(rows)
+    assert [r.category for r in found] == ["光熱"]
+
+
+# --- D2 メモの正規化 ------------------------------------------------------
+
+
+def test_D2_memo_normalized_by_nfkc_case_whitespace_and_trailing_number() -> None:
+    rows = [
+        ex("2026-01-01", 1200, memo="Netflix"),
+        ex("2026-02-01", 1200, memo="ｎｅｔｆｌｉｘ #2"),
+        ex("2026-03-01", 1200, memo=" NETFLIX "),
+    ]
+    found = find_recurring(rows)
+    assert len(found) == 1
+    assert found[0].count == 3
+    # 出力の memo は系列の最初の明細のメモ
+    assert found[0].memo == "Netflix"
+
+
+# --- R2 毎月とみなす条件 --------------------------------------------------
+
+
+def test_R2_one_missing_month_is_still_monthly() -> None:
+    rows = [
+        ex("2026-01-10", 700),
+        ex("2026-03-10", 700),
+        ex("2026-04-10", 700),
+    ]
+    found = find_recurring(rows)
+    assert len(found) == 1
+    assert found[0].count == 3
+    assert found[0].next_day == date(2026, 5, 10)
+
+
+def test_R2_two_missing_months_is_excluded() -> None:
+    rows = [
+        ex("2026-01-10", 700),
+        ex("2026-04-10", 700),
+        ex("2026-05-10", 700),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_R2_fewer_distinct_months_than_min_months_is_excluded() -> None:
+    rows = [ex("2026-01-10", 700), ex("2026-02-10", 700)]
+    assert find_recurring(rows, min_months=3) == []
+    assert len(find_recurring(rows, min_months=2)) == 1
+
+
+# --- R3 次回予測日 --------------------------------------------------------
+
+
+def test_R3_december_rolls_over_to_january_next_year() -> None:
+    rows = [
+        ex("2026-10-15", 400),
+        ex("2026-11-15", 400),
+        ex("2026-12-15", 400),
+    ]
+    assert find_recurring(rows)[0].next_day == date(2027, 1, 15)
+
+
+def test_R3_base_day_is_max_day_of_series_clipped_to_month_end() -> None:
+    # 31・31・28 → 基準 31 → 翌月 (4 月) は 30 日に切り詰め
+    rows = [
+        ex("2026-01-31", 80000),
+        ex("2026-02-28", 80000),
+        ex("2026-03-31", 80000),
+    ]
+    assert find_recurring(rows)[0].next_day == date(2026, 4, 30)
+
+
+def test_R3_clip_to_february_in_non_leap_year() -> None:
+    rows = [
+        ex("2026-11-30", 900),
+        ex("2026-12-31", 900),
+        ex("2027-01-31", 900),
+    ]
+    assert find_recurring(rows)[0].next_day == date(2027, 2, 28)
+
+
+def test_R3_clip_to_february_in_leap_year() -> None:
+    rows = [
+        ex("2027-11-30", 900),
+        ex("2027-12-31", 900),
+        ex("2028-01-31", 900),
+    ]
+    assert find_recurring(rows)[0].next_day == date(2028, 2, 29)
+
+
+def test_R3_next_day_is_month_after_last_even_with_missing_month() -> None:
+    rows = [
+        ex("2026-01-10", 700),
+        ex("2026-03-10", 700),
+        ex("2026-04-10", 700),
+    ]
+    assert find_recurring(rows)[0].next_day == date(2026, 5, 10)
+
+
+# --- R4 並び順 ------------------------------------------------------------
+
+
+def test_R4_sorted_by_amount_desc_then_category_then_memo() -> None:
+    rows = [
+        ex("2026-01-01", 100, memo="b", category="食費"),
+        ex("2026-02-01", 100, memo="b", category="食費"),
+        ex("2026-03-01", 100, memo="b", category="食費"),
+        ex("2026-01-01", 100, memo="a", category="食費"),
+        ex("2026-02-01", 100, memo="a", category="食費"),
+        ex("2026-03-01", 100, memo="a", category="食費"),
+        ex("2026-01-01", 100, memo="z", category="光熱"),
+        ex("2026-02-01", 100, memo="z", category="光熱"),
+        ex("2026-03-01", 100, memo="z", category="光熱"),
+        ex("2026-01-01", 900, memo="家賃", category="住居"),
+        ex("2026-02-01", 900, memo="家賃", category="住居"),
+        ex("2026-03-01", 900, memo="家賃", category="住居"),
+    ]
+    found = find_recurring(rows)
+    assert [(r.category, r.memo, r.amount) for r in found] == [
+        ("住居", "家賃", 900),
+        ("光熱", "z", 100),
+        ("食費", "a", 100),
+        ("食費", "b", 100),
+    ]
+
+
+def test_R4_median_of_even_count_is_floored_average() -> None:
+    rows = [
+        ex("2026-01-01", 1000),
+        ex("2026-02-01", 1001),
+        ex("2026-03-01", 1000),
+        ex("2026-04-01", 1001),
+    ]
+    found = find_recurring(rows)
+    assert [r.amount for r in found] == [1000]
+
+
+# --- D6 負の金額 ----------------------------------------------------------
+
+
+def test_D6_negative_amounts_are_excluded_from_series() -> None:
+    rows = [
+        ex("2026-01-01", 800),
+        ex("2026-02-01", 800),
+        ex("2026-02-15", -800),
+        ex("2026-03-01", 800),
+    ]
+    found = find_recurring(rows)
+    assert len(found) == 1
+    assert found[0].amount == 800
+    assert found[0].count == 3
+
+
+# --- D5 空入力・D1 引数検査 -----------------------------------------------
+
+
+def test_D5_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+@pytest.mark.parametrize("bad", [True, 3.0])
+def test_D1_min_months_bool_or_float_raises_type_error(bad: object) -> None:
+    with pytest.raises(TypeError, match="min_months"):
+        find_recurring([], min_months=bad)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad", [True, "0.1"])
+def test_D1_tolerance_bool_or_non_number_raises_type_error(bad: object) -> None:
+    with pytest.raises(TypeError, match="tolerance"):
+        find_recurring([], tolerance=bad)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad", [-0.1, 1.5])
+def test_D1_tolerance_out_of_range_raises_value_error(bad: float) -> None:
+    with pytest.raises(ValueError, match="tolerance"):
+        find_recurring([], tolerance=bad)
