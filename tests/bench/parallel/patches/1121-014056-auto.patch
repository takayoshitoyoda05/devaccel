+"""Import bank / card statement CSV text into Expense records (pure: no file I/O)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from datetime import date
+
+from kakeibo.core import CsvError, Expense
+
+_ALIASES: dict[str, tuple[str, ...]] = {
+    "date": ("日付", "利用日", "取引日", "ご利用日", "date"),
+    "amount": ("金額", "利用金額", "ご利用金額", "amount"),
+    "withdrawal": ("出金額", "お支払金額", "支払"),
+    "deposit": ("入金額", "お預入金額", "預入"),
+    "memo": ("摘要", "メモ", "利用店名", "ご利用店名", "内容", "description", "memo"),
+    "category": ("カテゴリ", "category"),
+}
+_ALIAS_TO_KEY: dict[str, str] = {
+    alias.lower(): key for key, aliases in _ALIASES.items() for alias in aliases
+}
+_LABELS = {"date": "日付", "amount": "金額", "withdrawal": "出金", "deposit": "入金"}
+
+_TIME = r"(?:\s+(?:[01]?[0-9]|2[0-3]):[0-5][0-9](?::[0-5][0-9])?)?"
+_DATE_PATTERNS = (
+    re.compile(
+        r"(?P<y>[0-9]{4})(?P<sep>[-/.])(?P<m>[0-9]{1,2})(?P=sep)(?P<d>[0-9]{1,2})"
+        + _TIME
+    ),
+    re.compile(r"(?P<y>[0-9]{4})年(?P<m>[0-9]{1,2})月(?P<d>[0-9]{1,2})日" + _TIME),
+    re.compile(r"(?P<y>[0-9]{4})(?P<m>[0-9]{2})(?P<d>[0-9]{2})" + _TIME),
+)
+_YEN_BODY = re.compile(r"[0-9]+|[0-9]{1,3}(?:,[0-9]{3})+")
+_NEG_PREFIXES = ("-", "−", "△", "▲")
+
+
+def _nfkc(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip()
+
+
+def _parse_date(raw: str) -> date:
+    s = _nfkc(raw)
+    for pattern in _DATE_PATTERNS:
+        m = pattern.fullmatch(s)
+        if m:
+            try:
+                return date(int(m["y"]), int(m["m"]), int(m["d"]))
+            except ValueError:
+                break
+    raise ValueError(f"日付が不正です: {raw!r}")
+
+
+def _parse_yen(raw: str) -> int:
+    s = _nfkc(raw)
+    neg = False
+    if s[:1] in _NEG_PREFIXES:
+        neg, s = True, s[1:].strip()
+    elif len(s) >= 2 and s[0] == "(" and s[-1] == ")":
+        neg, s = True, s[1:-1].strip()
+    elif s.endswith("-"):
+        neg, s = True, s[:-1].strip()
+    if s.startswith("¥"):
+        s = s[1:].strip()
+    elif s[:3].upper() == "JPY":
+        s = s[3:].strip()
+    if s.endswith("円"):
+        s = s[:-1].strip()
+    if not _YEN_BODY.fullmatch(s):
+        raise ValueError(f"金額が不正です: {raw!r}")
+    value = int(s.replace(",", ""))
+    return -value if neg else value
+
+
+def _header_map(header: list[str]) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for i, cell in enumerate(header):
+        key = _ALIAS_TO_KEY.get(_nfkc(cell).lower())
+        if key is not None and key not in out:
+            out[key] = i
+    return out
+
+
+def parse_bank_csv(text: str, *, default_category: str = "未分類") -> list[Expense]:
+    """Parse bank/card CSV text. Collects all row errors and raises CsvError once."""
+    if not isinstance(text, str):
+        raise TypeError("text は str である必要があります")
+    if not isinstance(default_category, str):
+        raise TypeError("default_category は str である必要があります")
+    text = text.removeprefix("﻿")
+
+    first_line = re.split(r"[\r\n]", text, maxsplit=1)[0]
+    delimiter = "\t" if first_line.count("\t") > first_line.count(",") else ","
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delimiter)
+
+    records: list[tuple[int, list[str]]] = []
+    prev_line = 0
+    for cells in reader:
+        start = prev_line + 1
+        prev_line = reader.line_num
+        if all(not c.strip() for c in cells):
+            continue
+        records.append((start, cells))
+    if not records:
+        return []
+
+    header = records[0][1]
+    cols = _header_map(header)
+    if "date" not in cols or not ({"amount", "withdrawal", "deposit"} & cols.keys()):
+        raise CsvError([(1, "必須列がありません: 日付・金額(または出金/入金)")])
+    if "amount" in cols and ("withdrawal" in cols or "deposit" in cols):
+        raise CsvError([(1, "金額と出金/入金は同時に指定できません")])
+    single = "amount" in cols
+
+    def cell(cells: list[str], key: str) -> str:
+        return cells[cols[key]] if key in cols else ""
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    for start, cells in records[1:]:
+        if len(cells) != len(header):
+            errors.append(
+                (
+                    start,
+                    f"列数が不正です: ヘッダーは {len(header)} 列、この行は {len(cells)} 列",
+                )
+            )
+            continue
+
+        row_errors: list[str] = []
+        day: date | None = None
+        try:
+            day = _parse_date(cell(cells, "date"))
+        except ValueError as e:
+            row_errors.append(str(e))
+
+        amount: int | None = None
+        if single:
+            try:
+                amount = _parse_yen(cell(cells, "amount"))
+            except ValueError as e:
+                row_errors.append(str(e))
+        else:
+            w_raw = cell(cells, "withdrawal")
+            d_raw = cell(cells, "deposit")
+            w_has = bool(_nfkc(w_raw))
+            d_has = bool(_nfkc(d_raw))
+            if w_has and d_has:
+                row_errors.append(
+                    f"出金と入金の両方に値があります: 出金 {w_raw!r}, 入金 {d_raw!r}"
+                )
+            elif not w_has and not d_has:
+                row_errors.append("出金と入金のどちらにも値がありません")
+            if w_has:
+                try:
+                    amount = _parse_yen(w_raw)
+                except ValueError as e:
+                    row_errors.append(str(e))
+            elif d_has:
+                try:
+                    _parse_yen(d_raw)
+                except ValueError as e:
+                    row_errors.append(str(e))
+                if not row_errors:
+                    # 入金だけの行は支出ではないのでスキップ(エラーにしない)
+                    continue
+
+        if row_errors:
+            errors.extend((start, msg) for msg in row_errors)
+            continue
+        assert day is not None and amount is not None
+        category = _nfkc(cell(cells, "category")) or default_category
+        expenses.append(
+            Expense(
+                day=day,
+                category=category,
+                amount=amount,
+                memo=_nfkc(cell(cells, "memo")),
+            )
+        )
+
+    if errors:
+        raise CsvError(errors)
+    return expenses
