@@ -0,0 +1,130 @@
+"""Detect recurring expenses (monthly subscriptions, rent) and predict the next payment.
+
+Pure functions only: input is a list of Expense, no file I/O.
+"""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_WS_RE = re.compile(r"\s+")
+# 系列キーでは末尾の連番を除く: "#12", "2026年1月", "12"
+_SERIES_SUFFIX_RE = re.compile(r"(?:#\d+|\d{4}年\d{1,2}月|\d+)$")
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int  # yen: median of the series
+    count: int  # number of months counted
+    last_day: date
+    next_day: date
+
+
+def _normalize(memo: str) -> str:
+    """D2: NFKC → 小文字化 → 空白除去."""
+    return _WS_RE.sub("", unicodedata.normalize("NFKC", memo).lower())
+
+
+def _series_memo(memo: str) -> str:
+    return _SERIES_SUFFIX_RE.sub("", _normalize(memo))
+
+
+def _median(amounts: list[int]) -> int:
+    s = sorted(amounts)
+    n = len(s)
+    mid = n // 2
+    if n % 2:
+        return s[mid]
+    return (s[mid - 1] + s[mid]) // 2  # 偶数個: 平均を切り捨て
+
+
+def _cluster(
+    items: list[tuple[int, Expense]], tolerance: float
+) -> list[list[tuple[int, Expense]]]:
+    """R1: 金額の昇順に走査し、現在の系列の中央値の ±tolerance 以内なら同じ系列."""
+    clusters: list[list[tuple[int, Expense]]] = []
+    for pos, e in sorted(items, key=lambda p: (p[1].amount, p[0])):
+        if clusters:
+            last = clusters[-1]
+            base = _median([x.amount for _, x in last])
+            if abs(e.amount - base) <= tolerance * base:
+                last.append((pos, e))
+                continue
+        clusters.append([(pos, e)])
+    return clusters
+
+
+def _detect(
+    category: str, cluster: list[tuple[int, Expense]], min_months: int
+) -> Recurring | None:
+    ordered = [e for _, e in sorted(cluster, key=lambda p: (p[1].day, p[0]))]
+
+    # R2: 同じ月の 2 件目以降は数えない(1 件目だけ使う)
+    firsts: dict[tuple[int, int], Expense] = {}
+    for e in ordered:
+        firsts.setdefault((e.day.year, e.day.month), e)
+    months = sorted(firsts)
+    if len(months) < min_months:
+        return None
+    (y0, m0), (y1, m1) = months[0], months[-1]
+    span = (y1 - y0) * 12 + (m1 - m0) + 1
+    if span - len(months) > 1:  # 欠けた月は 1 つまで
+        return None
+
+    # R3: 日は系列の中の最大の日を、翌月の末日で切り詰める
+    base_day = max(e.day.day for e in firsts.values())
+    ny, nm = (y1 + 1, 1) if m1 == 12 else (y1, m1 + 1)
+    next_day = date(ny, nm, min(base_day, calendar.monthrange(ny, nm)[1]))
+
+    return Recurring(
+        category=category,
+        memo=ordered[0].memo,
+        amount=_median([e.amount for _, e in cluster]),
+        count=len(months),
+        last_day=firsts[months[-1]].day,
+        next_day=next_day,
+    )
+
+
+def find_recurring(
+    rows: list[Expense], *, min_months: int = 3, tolerance: float = 0.1
+) -> list[Recurring]:
+    """Find monthly recurring expenses and their next expected date.
+
+    min_months: 異なる月の最少数(2 以上)。tolerance: 中央値からの許容割合(0〜1)。
+    返金・負の金額は系列から除外する(D6)。並びは amount 降順、同点は category・memo 昇順。
+    """
+    if isinstance(min_months, bool) or not isinstance(min_months, int):
+        raise TypeError(f"min_months は int で指定してください: {min_months!r}")
+    if min_months < 2:
+        raise ValueError(f"min_months は 2 以上で指定してください: {min_months}")
+    if isinstance(tolerance, bool) or not isinstance(tolerance, (int, float)):
+        raise TypeError(f"tolerance は数値で指定してください: {tolerance!r}")
+    if not 0 <= tolerance <= 1:  # NaN もここで弾く
+        raise ValueError(f"tolerance は 0〜1 の範囲で指定してください: {tolerance}")
+
+    # R1: 系列キー = (category, 正規化メモ)
+    groups: dict[tuple[str, str], list[tuple[int, Expense]]] = {}
+    for pos, e in enumerate(rows):
+        if e.amount < 0:  # D6
+            continue
+        groups.setdefault((e.category, _series_memo(e.memo)), []).append((pos, e))
+
+    found: list[Recurring] = []
+    for (category, _key), items in groups.items():
+        for cluster in _cluster(items, float(tolerance)):
+            r = _detect(category, cluster, min_months)
+            if r is not None:
+                found.append(r)
+
+    # R4
+    found.sort(key=lambda r: (-r.amount, r.category, r.memo))
+    return found
