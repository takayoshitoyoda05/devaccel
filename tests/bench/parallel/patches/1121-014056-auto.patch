+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import parse_bank_csv
+from kakeibo.core import CsvError, Expense
+
+# --- 例の表 (E2-1〜E2-3) ---------------------------------------------------
+
+
+def test_E2_1_alias_fullwidth_and_yen_suffix() -> None:
+    """E2-1: R2 R4 — 別名の列・全角英字のメモ・「円」付き金額。"""
+    text = '利用日,ご利用店名,利用金額\n2026/1/5,ＡＢＣ,"1,200円"\n'
+    assert parse_bank_csv(text) == [Expense(date(2026, 1, 5), "未分類", 1200, "ABC")]
+
+
+def test_E2_2_deposit_only_row_is_skipped() -> None:
+    """E2-2: R3 — 入金だけの行はスキップ(エラーにしない)。"""
+    text = "日付,出金額,入金額\n2026-01-05,,5000\n2026-01-06,300,\n"
+    assert parse_bank_csv(text) == [Expense(date(2026, 1, 6), "未分類", 300, "")]
+
+
+def test_E2_3_collects_all_field_errors_for_one_row() -> None:
+    """E2-3: R6 — 日付と金額の両方が不正なら、同じ行番号で 2 件報告する。"""
+    text = "日付,金額,摘要\n2026-01-01,100,ok\n2026-01-02,200,ok\n2026/2/30,abc,bad\n"
+    with pytest.raises(CsvError) as info:
+        parse_bank_csv(text)
+    assert info.value.errors == [
+        (4, "日付が不正です: '2026/2/30'"),
+        (4, "金額が不正です: 'abc'"),
+    ]
+
+
+# --- R1 区切り・BOM・改行・行番号 -----------------------------------------
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "日付\t金額\t摘要\r\n2026-01-05\t100\tA\r\n",
+        "日付\t金額\t摘要\n2026-01-05\t100\tA\n",
+        "日付\t金額\t摘要\r2026-01-05\t100\tA\r",
+        "﻿日付\t金額\t摘要\n2026-01-05\t100\tA",
+    ],
+    ids=["crlf", "lf", "cr", "bom-no-trailing-newline"],
+)
+def test_tab_delimiter_and_newlines(text: str) -> None:
+    assert parse_bank_csv(text) == [Expense(date(2026, 1, 5), "未分類", 100, "A")]
+
+
+def test_quoted_comma_and_newline_form_one_cell_and_report_start_line() -> None:
+    text = '日付,金額,摘要\n\n2026-01-05,100,"a,b\nc"\n2026-01-06,abc,x\n'
+    with pytest.raises(CsvError) as info:
+        parse_bank_csv(text)
+    # 空行は無視されるが行番号は物理行で数える。引用内改行で 3〜4 行目を使うので、
+    # 問題の行は 5 行目。
+    assert info.value.errors == [(5, "金額が不正です: 'abc'")]
+
+
+def test_quoted_multiline_memo_is_single_cell() -> None:
+    text = '日付,金額,摘要\n2026-01-05,100,"a,b\nc"\n'
+    assert parse_bank_csv(text) == [Expense(date(2026, 1, 5), "未分類", 100, "a,b\nc")]
+
+
+# --- R2 列名 ---------------------------------------------------------------
+
+
+def test_header_matching_ignores_case_and_surrounding_spaces() -> None:
+    text = " DATE , Amount ,  Memo \n2026-01-05,100,x\n"
+    assert parse_bank_csv(text) == [Expense(date(2026, 1, 5), "未分類", 100, "x")]
+
+
+def test_category_column_is_used_and_default_applies_when_empty() -> None:
+    text = "日付,金額,カテゴリ\n2026-01-05,100,食費\n2026-01-06,200,\n"
+    assert parse_bank_csv(text, default_category="雑費") == [
+        Expense(date(2026, 1, 5), "食費", 100, ""),
+        Expense(date(2026, 1, 6), "雑費", 200, ""),
+    ]
+
+
+# --- R3 単列 / 2 列 --------------------------------------------------------
+
+
+def test_single_amount_column_positive_is_expense_negative_is_refund() -> None:
+    text = "日付,金額\n2026-01-05,100\n2026-01-06,-300\n"
+    assert parse_bank_csv(text) == [
+        Expense(date(2026, 1, 5), "未分類", 100, ""),
+        Expense(date(2026, 1, 6), "未分類", -300, ""),
+    ]
+
+
+def test_two_columns_withdrawal_is_expense() -> None:
+    text = "日付,出金額,入金額\n2026-01-05,250,\n"
+    assert parse_bank_csv(text) == [Expense(date(2026, 1, 5), "未分類", 250, "")]
+
+
+def test_row_with_both_withdrawal_and_deposit_is_error() -> None:
+    text = "日付,出金額,入金額\n2026-01-05,100,200\n"
+    with pytest.raises(CsvError) as info:
+        parse_bank_csv(text)
+    assert [n for n, _ in info.value.errors] == [2]
+
+
+def test_row_with_neither_withdrawal_nor_deposit_is_error() -> None:
+    text = "日付,出金額,入金額\n2026-01-05,,\n"
+    with pytest.raises(CsvError) as info:
+        parse_bank_csv(text)
+    assert [n for n, _ in info.value.errors] == [2]
+
+
+def test_missing_required_columns_reports_line_1() -> None:
+    with pytest.raises(CsvError) as info:
+        parse_bank_csv("日付,摘要\n2026-01-05,x\n")
+    assert len(info.value.errors) == 1
+    assert info.value.errors[0][0] == 1
+
+
+# --- R4 金額 ---------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        ("1234", 1234),
+        ("1,234", 1234),
+        ("1，234", 1234),
+        ("１２３４", 1234),
+        ("¥1,234", 1234),
+        ("￥1,234", 1234),
+        ("1,234円", 1234),
+        ("JPY 1234", 1234),
+        ("  １，２３４円  ", 1234),
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+    ],
+)
+def test_amount_notation(raw: str, expected: int) -> None:
+    text = f'日付,金額\n2026-01-05,"{raw}"\n'
+    assert parse_bank_csv(text)[0].amount == expected
+
+
+@pytest.mark.parametrize("raw", ["12.5", "", "   ", "-", "—", "1,23", "¥", "--300"])
+def test_amount_invalid_notation_is_row_error(raw: str) -> None:
+    text = f'日付,金額\n2026-01-05,"{raw}"\n'
+    with pytest.raises(CsvError) as info:
+        parse_bank_csv(text)
+    assert info.value.errors[0][0] == 2
+    assert info.value.errors[0][1].startswith("金額が不正です")
+
+
+# --- R5 日付 ---------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026.1.5",
+        "2026年1月5日",
+        "20260105",
+        "2026-01-05 12:30",
+        "2026/1/5 12:30:45",
+        "２０２６/１/５",
+    ],
+)
+def test_date_notation(raw: str) -> None:
+    text = f"日付,金額\n{raw},100\n"
+    assert parse_bank_csv(text)[0].day == date(2026, 1, 5)
+
+
+@pytest.mark.parametrize("raw", ["2026/2/30", "令和8年1月5日", "2026-1/5"])
+def test_date_invalid_is_row_error(raw: str) -> None:
+    text = f"日付,金額\n{raw},100\n"
+    with pytest.raises(CsvError) as info:
+        parse_bank_csv(text)
+    assert info.value.errors == [(2, f"日付が不正です: {raw!r}")]
+
+
+# --- R6 列数・空入力 -------------------------------------------------------
+
+
+def test_unquoted_thousands_separator_is_column_count_error() -> None:
+    text = "日付,摘要,金額\n2026-01-05,ABC,1,234円\n"
+    with pytest.raises(CsvError) as info:
+        parse_bank_csv(text)
+    assert info.value.errors[0][0] == 2
+    assert "列数" in info.value.errors[0][1]
+
+
+def test_blank_lines_are_ignored() -> None:
+    text = "\n日付,金額\n\n2026-01-05,100\n\n"
+    assert parse_bank_csv(text) == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+@pytest.mark.parametrize("text", ["", "日付,金額\n", "日付,金額\r\n"])
+def test_empty_or_header_only_returns_empty_list(text: str) -> None:
+    assert parse_bank_csv(text) == []
+
+
+def test_non_string_text_raises_type_error() -> None:
+    with pytest.raises(TypeError):
+        parse_bank_csv(b"date,amount\n")  # type: ignore[arg-type]
