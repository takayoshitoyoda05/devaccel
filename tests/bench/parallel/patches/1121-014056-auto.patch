+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import make_filter
+
+
+@pytest.mark.parametrize(
+    "case_id, cond, row, expected",
+    [
+        (
+            "E3-1",
+            {"min_amount": 1000, "max_amount": 1000},
+            Expense(date(2026, 1, 5), "食費", 1000, ""),
+            True,
+        ),
+        (
+            "E3-2",
+            {"memo_contains": "ＮＥＴＦＬＩＸ"},
+            Expense(date(2026, 1, 5), "娯楽", 1490, "netflix 月額"),
+            True,
+        ),
+    ],
+    ids=["E3-1", "E3-2"],
+)
+def test_make_filter_examples(case_id, cond, row, expected):
+    assert make_filter(**cond)(row) is expected
+
+
+def test_E3_3_unknown_key_is_rejected():
+    with pytest.raises(ValueError, match="colour"):
+        make_filter(colour="x")
