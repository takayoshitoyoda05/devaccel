+++ b/tests/test_recurring.py
@@ -0,0 +1,170 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring
+
+
+def _e(
+    y: int, m: int, d: int, amount: int, memo: str = "家賃", category: str = "家賃"
+) -> Expense:
+    return Expense(day=date(y, m, d), category=category, amount=amount, memo=memo)
+
+
+# 表の全行(E1-1 〜 E1-3)
+@pytest.mark.parametrize(
+    ("rows", "expected"),
+    [
+        pytest.param(
+            [_e(2026, 1, 25, 80000), _e(2026, 2, 25, 80000), _e(2026, 3, 25, 80000)],
+            [
+                Recurring(
+                    category="家賃",
+                    memo="家賃",
+                    amount=80000,
+                    months=3,
+                    last=date(2026, 3, 25),
+                    next_date=date(2026, 4, 25),
+                )
+            ],
+            id="E1-1",
+        ),
+        pytest.param(
+            [
+                _e(2026, 1, 31, 1500, "通信費", "通信費"),
+                _e(2026, 2, 28, 1500, "通信費", "通信費"),
+                _e(2026, 3, 31, 1500, "通信費", "通信費"),
+            ],
+            [
+                Recurring(
+                    category="通信費",
+                    memo="通信費",
+                    amount=1500,
+                    months=3,
+                    last=date(2026, 3, 31),
+                    next_date=date(2026, 4, 30),
+                )
+            ],
+            id="E1-2",
+        ),
+        pytest.param(
+            [_e(2026, 1, 25, 80000), _e(2026, 3, 25, 80000), _e(2026, 4, 25, 80000)],
+            [],
+            id="E1-3",
+        ),
+    ],
+)
+def test_example_table(rows: list[Expense], expected: list[Recurring]) -> None:
+    assert find_recurring(rows) == expected
+
+
+def test_empty_input_returns_empty() -> None:
+    assert find_recurring([]) == []
+
+
+def test_series_shorter_than_min_months_is_excluded() -> None:
+    rows = [_e(2026, 2, 25, 80000), _e(2026, 3, 25, 80000)]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_months=2)) == 1
+
+
+def test_min_months_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_months=1)
+
+
+def test_memo_normalization_merges_variants() -> None:
+    rows = [
+        _e(2026, 1, 5, 1000, "Netflix #1"),
+        _e(2026, 2, 5, 1000, "ｎｅｔｆｌｉｘ  3"),
+        _e(2026, 3, 5, 1000, "NETFLIX"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].memo == "NETFLIX"  # 最新行の元のメモ
+    assert result[0].months == 3
+
+
+def test_amount_within_ten_percent_is_same_series() -> None:
+    rows = [_e(2026, 1, 5, 80000), _e(2026, 2, 5, 84000), _e(2026, 3, 5, 88000)]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].amount == 88000
+
+
+def test_amount_outside_ten_percent_breaks_series() -> None:
+    rows = [_e(2026, 1, 5, 80000), _e(2026, 2, 5, 80000), _e(2026, 3, 5, 70000)]
+    assert find_recurring(rows) == []
+
+
+def test_refunds_and_zero_amounts_are_not_in_series() -> None:
+    rows = [
+        _e(2026, 1, 5, 1000),
+        _e(2026, 2, 5, -1000),
+        _e(2026, 2, 6, 0),
+        _e(2026, 3, 5, 1000),
+    ]
+    assert find_recurring(rows, min_months=2) == []
+
+
+def test_two_charges_in_one_month_is_not_recurring() -> None:
+    rows = [
+        _e(2026, 1, 5, 1000),
+        _e(2026, 2, 5, 1000),
+        _e(2026, 2, 20, 1000),
+        _e(2026, 3, 5, 1000),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_series_must_end_at_latest_month() -> None:
+    rows = [
+        _e(2026, 1, 5, 1000),
+        _e(2026, 2, 5, 1000),
+        _e(2026, 3, 5, 1000),
+        _e(2026, 6, 1, 500, "別"),
+    ]
+    assert [r.memo for r in find_recurring(rows)] == []
+
+
+def test_year_wrap_next_month_is_january() -> None:
+    rows = [_e(2025, 11, 10, 1000), _e(2025, 12, 10, 1000), _e(2026, 1, 10, 1000)]
+    assert find_recurring(rows)[0].next_date == date(2026, 2, 10)
+
+
+def test_leap_year_february_next_is_march() -> None:
+    rows = [_e(2023, 12, 10, 1000), _e(2024, 1, 10, 1000), _e(2024, 2, 29, 1000)]
+    assert find_recurring(rows)[0].next_date == date(2024, 3, 29)
+
+
+def test_next_date_clipped_to_month_end() -> None:
+    rows = [_e(2026, 1, 31, 1000), _e(2026, 2, 28, 1000), _e(2026, 3, 31, 1000)]
+    assert find_recurring(rows)[0].next_date == date(2026, 4, 30)
+
+
+def test_result_is_independent_of_input_order() -> None:
+    rows = [
+        _e(2026, 1, 25, 80000),
+        _e(2026, 2, 25, 80000),
+        _e(2026, 3, 25, 80000),
+        _e(2026, 1, 5, 1500, "通信費", "通信費"),
+        _e(2026, 2, 5, 1500, "通信費", "通信費"),
+        _e(2026, 3, 5, 1500, "通信費", "通信費"),
+    ]
+    assert find_recurring(rows) == find_recurring(list(reversed(rows)))
+
+
+def test_sorted_by_next_date_then_category() -> None:
+    rows = [
+        _e(2026, 1, 25, 80000, "家賃", "家賃"),
+        _e(2026, 2, 25, 80000, "家賃", "家賃"),
+        _e(2026, 3, 25, 80000, "家賃", "家賃"),
+        _e(2026, 1, 5, 1500, "通信費", "通信費"),
+        _e(2026, 2, 5, 1500, "通信費", "通信費"),
+        _e(2026, 3, 5, 1500, "通信費", "通信費"),
+    ]
+    result = find_recurring(rows)
+    assert [r.category for r in result] == ["通信費", "家賃"]
diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..93790c4
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,239 @@
+from __future__ import annotations
+
+from datetime import date
+from typing import Any
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    all_of,
+    amount_between,
+    any_of,
+    between_dates,
+    category,
+    from_spec,
+    memo_contains,
+    not_,
+    search,
+)
+
+ROWS = [
+    Expense(date(2026, 1, 5), "食費", 800, "スーパー"),
+    Expense(date(2026, 1, 10), "交通", 1500, "定期券"),
+    Expense(date(2026, 1, 20), "食費", 3000, "外食 Lunch"),
+    Expense(date(2026, 2, 1), "娯楽", 500, "映画"),
+    Expense(date(2026, 2, 15), "食費", 1000, ""),
+]
+
+
+def _ids(rows: list[Expense]) -> list[tuple[str, int]]:
+    return [(r.category, r.amount) for r in rows]
+
+
+# --- 表の全行 (E3-1〜E3-3) ---
+
+
+@pytest.mark.parametrize(
+    ("case_id", "make", "expected"),
+    [
+        (
+            "E3-1",
+            lambda: from_spec({"category": ["食費", "交通"], "amount": [None, 1000]}),
+            [("食費", 800), ("食費", 1000)],
+        ),
+        ("E3-2a", lambda: all_of(), list(_ids(ROWS))),
+        ("E3-2b", lambda: any_of(), []),
+    ],
+    ids=["E3-1", "E3-2a", "E3-2b"],
+)
+def test_spec_table(case_id: str, make: Any, expected: list[tuple[str, int]]) -> None:
+    assert _ids(search(ROWS, make())) == expected
+
+
+def test_E3_3_unknown_key_raises_with_key_name() -> None:
+    with pytest.raises(ValueError, match="colour"):
+        from_spec({"colour": "x"})
+
+
+# --- R1: search ---
+
+
+def test_search_keeps_input_order_and_returns_new_list() -> None:
+    out = search(ROWS, all_of())
+    assert out == ROWS
+    assert out is not ROWS
+
+
+def test_search_empty_input_returns_empty_list() -> None:
+    assert search([], all_of()) == []
+
+
+# --- R2: category ---
+
+
+def test_category_matches_exactly_after_nfkc_and_strip() -> None:
+    # 全角英数字は NFKC で半角になる
+    rows = [
+        Expense(date(2026, 1, 1), "ＡＢＣ", 1),
+        Expense(date(2026, 1, 1), "ABCD", 2),
+    ]
+    assert _ids(search(rows, category(" ABC "))) == [("ＡＢＣ", 1)]
+
+
+def test_category_is_not_substring_match() -> None:
+    assert search(ROWS, category("食")) == []
+
+
+def test_category_any_of_names() -> None:
+    assert _ids(search(ROWS, category("交通", "娯楽"))) == [
+        ("交通", 1500),
+        ("娯楽", 500),
+    ]
+
+
+def test_category_without_names_raises() -> None:
+    with pytest.raises(ValueError):
+        category()
+
+
+# --- R2 / D5: amount_between ---
+
+
+@pytest.mark.parametrize(
+    ("low", "high", "expected_amounts"),
+    [
+        (None, None, [800, 1500, 3000, 500, 1000]),
+        (1000, None, [1500, 3000, 1000]),
+        (None, 1000, [800, 500, 1000]),
+        (1000, 1000, [1000]),  # 両端を含む
+        (801, 999, []),
+    ],
+    ids=["unbounded", "low-only", "high-only", "inclusive-edges", "empty-range"],
+)
+def test_amount_between(
+    low: int | None, high: int | None, expected_amounts: list[int]
+) -> None:
+    out = search(ROWS, amount_between(low, high))
+    assert [r.amount for r in out] == expected_amounts
+
+
+def test_amount_between_reversed_raises() -> None:
+    with pytest.raises(ValueError):
+        amount_between(1000, 500)
+
+
+# --- R2 / D5: memo_contains ---
+
+
+def test_memo_contains_case_and_width_insensitive_partial() -> None:
+    assert _ids(search(ROWS, memo_contains("lunch"))) == [("食費", 3000)]
+    assert _ids(search(ROWS, memo_contains("ｽｰﾊﾟｰ"))) == [("食費", 800)]
+
+
+def test_memo_contains_empty_matches_all() -> None:
+    assert len(search(ROWS, memo_contains(""))) == len(ROWS)
+
+
+# --- R2 / D5: between_dates ---
+
+
+def test_between_dates_inclusive_and_open_ended() -> None:
+    assert len(search(ROWS, between_dates(date(2026, 1, 10), date(2026, 1, 20)))) == 2
+    assert len(search(ROWS, between_dates(start=date(2026, 2, 1)))) == 2
+    assert len(search(ROWS, between_dates(end=date(2026, 1, 5)))) == 1
+
+
+def test_between_dates_reversed_raises() -> None:
+    with pytest.raises(ValueError):
+        between_dates(date(2026, 2, 1), date(2026, 1, 1))
+
+
+# --- 組み立て・D5 の空入力 ---
+
+
+def test_not_inverts() -> None:
+    assert _ids(search(ROWS, not_(category("食費")))) == [("交通", 1500), ("娯楽", 500)]
+
+
+def test_all_of_and_any_of_combine() -> None:
+    p = all_of(category("食費"), amount_between(None, 1000))
+    assert _ids(search(ROWS, p)) == [("食費", 800), ("食費", 1000)]
+    q = any_of(category("交通"), memo_contains("映画"))
+    assert _ids(search(ROWS, q)) == [("交通", 1500), ("娯楽", 500)]
+
+
+# --- R3: from_spec ---
+
+
+def test_from_spec_empty_dict_matches_all() -> None:
+    assert search(ROWS, from_spec({})) == ROWS
+
+
+def test_from_spec_multiple_keys_are_anded() -> None:
+    spec = {"category": "食費", "memo": "スーパー"}
+    assert _ids(search(ROWS, from_spec(spec))) == [("食費", 800)]
+
+
+def test_from_spec_category_string_and_list() -> None:
+    assert _ids(search(ROWS, from_spec({"category": "娯楽"}))) == [("娯楽", 500)]
+
+
+def test_from_spec_period() -> None:
+    spec = {"period": ["2026-01-01", "2026-01-31"]}
+    assert len(search(ROWS, from_spec(spec))) == 3
+    assert len(search(ROWS, from_spec({"period": [None, "2026-01-10"]}))) == 2
+
+
+def test_from_spec_and_or_not_nested() -> None:
+    spec: dict[str, Any] = {
+        "or": [
+            {"category": "交通"},
+            {"and": [{"category": "食費"}, {"not": {"amount": [None, 900]}}]},
+        ]
+    }
+    assert _ids(search(ROWS, from_spec(spec))) == [
+        ("交通", 1500),
+        ("食費", 3000),
+        ("食費", 1000),
+    ]
+
+
+def test_from_spec_empty_and_or() -> None:
+    assert len(search(ROWS, from_spec({"and": []}))) == len(ROWS)
+    assert search(ROWS, from_spec({"or": []})) == []
+
+
+# --- R4: 不正な spec ---
+
+
+@pytest.mark.parametrize(
+    ("spec", "key"),
+    [
+        ({"amount": [1000]}, "amount"),
+        ({"amount": [1, 2, 3]}, "amount"),
+        ({"amount": "1000"}, "amount"),
+        ({"and": {"category": "食費"}}, "and"),
+        ({"or": "x"}, "or"),
+        ({"period": ["2026-13-01", None]}, "period"),
+        ({"period": ["not-a-date", None]}, "period"),
+        ({"memo": 1}, "memo"),
+        ({"category": 1}, "category"),
+        ({"and": [{"colour": "x"}]}, "colour"),
+    ],
+    ids=[
+        "amount-short",
+        "amount-long",
+        "amount-not-list",
+        "and-not-list",
+        "or-not-list",
+        "period-bad-month",
+        "period-bad-string",
+        "memo-not-str",
+        "category-not-str",
+        "nested-unknown-key",
+    ],
+)
+def test_from_spec_invalid_raises_with_key(spec: dict[str, Any], key: str) -> None:
+    with pytest.raises(ValueError, match=key):
+        from_spec(spec)
