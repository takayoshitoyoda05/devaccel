@@ -0,0 +1,82 @@
+"""Month-over-month comparison of category totals (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    delta: int  # current - previous
+    pct: (
+        float | None
+    )  # delta / previous * 100, rounded to 1 decimal; None if previous == 0
+    status: str  # "up" | "down" | "same" | "new" | "gone"
+
+
+def _check_month(month: str) -> None:
+    if not isinstance(month, str) or not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def _previous_month(month: str) -> str:
+    year, mon = int(month[:4]), int(month[5:7])
+    if mon == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mon - 1:02d}"
+
+
+def compare_months(
+    totals: dict[str, dict[str, int]], month: str, prev: str | None = None
+) -> list[CategoryChange]:
+    _check_month(month)
+    if prev is None:
+        prev = _previous_month(month)
+    else:
+        _check_month(prev)
+
+    cur_cats = totals.get(month, {})
+    prev_cats = totals.get(prev, {})
+
+    changes: list[CategoryChange] = []
+    for cat in set(cur_cats) | set(prev_cats):
+        before = prev_cats.get(cat, 0)
+        after = cur_cats.get(cat, 0)
+        if before == 0 and after == 0:
+            continue
+        delta = after - before
+        pct = None if before == 0 else round(delta / before * 100, 1)
+        if before == 0:
+            status = "new"
+        elif after == 0:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        changes.append(CategoryChange(cat, before, after, delta, pct, status))
+
+    changes.sort(key=lambda c: (-abs(c.delta), c.category))
+    return changes
+
+
+def format_report(changes: list[CategoryChange], month: str, prev: str) -> str:
+    lines = [f"{prev} → {month}"]
+    if not changes:
+        lines.append("変化なし")
+    for c in changes:
+        base = f"{c.category}: {c.previous:,}円 → {c.current:,}円 ({c.delta:+,}円"
+        if c.pct is None:
+            word = "新規" if c.status == "new" else "なし"
+            lines.append(f"{base}, {word})")
+        else:
+            lines.append(f"{base}, {c.pct:+.1f}%)")
+    return "\n".join(lines)
