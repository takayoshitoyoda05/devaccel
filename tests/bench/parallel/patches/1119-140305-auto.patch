+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import BankCsvError, ImportResult, RowError, import_bank_csv
+from kakeibo.core import Expense
+
+
+def test_e2_1_alias_headers_and_quoted_amount() -> None:
+    """E2-1: 利用日/ご利用店名/利用金額 headers, quoted "1,234円", default category."""
+    text = '利用日,ご利用店名,利用金額\n2026/1/5,スーパーA,"1,234円"\n'
+    assert import_bank_csv(text) == ImportResult(
+        [Expense(date(2026, 1, 5), "未分類", 1234, "スーパーA")], [], 0
+    )
+
+
+def test_e2_2_invalid_date_and_decimal_amount_both_reported() -> None:
+    """E2-2: 2026-02-30 and 12.5 in one row -> 2 RowErrors, row excluded."""
+    text = "日付,摘要,金額\n2026-02-30,店,12.5\n"
+    result = import_bank_csv(text)
+    assert result.expenses == []
+    assert result.skipped == 0
+    assert [(e.line, e.column, e.value) for e in result.errors] == [
+        (2, "日付", "2026-02-30"),
+        (2, "金額", "12.5"),
+    ]
+
+
+def test_e2_3_deposit_only_row_is_skipped() -> None:
+    """E2-3: 出金/入金 format, deposit-only row -> skipped=1, not an error."""
+    text = "日付,出金額,入金額\n2026-01-05,,500\n"
+    assert import_bank_csv(text) == ImportResult([], [], 1)
+
+
+@pytest.mark.parametrize(
+    "amount_text",
+    ["-300", "−300", "△300", "▲300", "(300)", "300-"],
+)
+def test_r3_negative_forms_are_refunds(amount_text: str) -> None:
+    text = f"日付,摘要,金額\n2026-01-05,返金,{amount_text}\n"
+    assert import_bank_csv(text).expenses == [
+        Expense(date(2026, 1, 5), "未分類", -300, "返金")
+    ]
+
+
+@pytest.mark.parametrize("amount_text", ["12.5", "", "-", "abc"])
+def test_r3_invalid_amount_is_row_error(amount_text: str) -> None:
+    text = f"日付,摘要,金額\n2026-01-05,店,{amount_text}\n"
+    result = import_bank_csv(text)
+    assert result.expenses == []
+    assert [e.column for e in result.errors] == ["金額"]
+
+
+@pytest.mark.parametrize(
+    "date_text",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026.1.5",
+        "2026年1月5日",
+        "20260105",
+        "2026-01-05 10:00",
+        "2026-01-05T10:00:00",
+    ],
+)
+def test_r4_date_forms(date_text: str) -> None:
+    text = f"日付,金額\n{date_text},100\n"
+    assert import_bank_csv(text).expenses == [
+        Expense(date(2026, 1, 5), "未分類", 100, "")
+    ]
+
+
+def test_r4_era_date_is_row_error() -> None:
+    result = import_bank_csv("日付,金額\n令和8年1月5日,100\n")
+    assert result.errors == [
+        RowError(2, "日付", "令和8年1月5日", result.errors[0].reason)
+    ]
+
+
+def test_r1_bom_crlf_and_tab_delimiter() -> None:
+    text = "﻿日付\t摘要\t金額\r\n2026.1.5\t 店 \t-300\r\n"
+    assert import_bank_csv(text).expenses == [
+        Expense(date(2026, 1, 5), "未分類", -300, "店")
+    ]
+
+
+def test_r1_quoted_newline_is_one_value_and_line_numbers_count_it() -> None:
+    text = '日付,摘要,金額\n\n2026-01-05,"a\nb",100\n'
+    result = import_bank_csv(text)
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "a\nb")]
+
+
+def test_r2_missing_date_column_raises() -> None:
+    with pytest.raises(BankCsvError):
+        import_bank_csv("摘要,金額\n店,100\n")
+
+
+def test_r2_missing_amount_and_withdraw_raises() -> None:
+    with pytest.raises(BankCsvError):
+        import_bank_csv("日付,摘要\n2026-01-05,店\n")
+
+
+def test_r2_category_column_and_blank_uses_default() -> None:
+    text = "日付,カテゴリ,金額\n2026-01-05,食費,100\n2026-01-06,  ,200\n"
+    assert import_bank_csv(text, default_category="雑費").expenses == [
+        Expense(date(2026, 1, 5), "食費", 100, ""),
+        Expense(date(2026, 1, 6), "雑費", 200, ""),
+    ]
+
+
+def test_r5_blank_line_ignored_and_column_count_error() -> None:
+    text = "日付,摘要,金額\n\n2026-01-05,店\n"
+    result = import_bank_csv(text)
+    assert result.expenses == []
+    assert len(result.errors) == 1
+    assert result.errors[0].line == 3
+    assert result.errors[0].column == ""
+
+
+def test_r5_empty_and_header_only_inputs() -> None:
+    assert import_bank_csv("") == ImportResult([], [], 0)
+    assert import_bank_csv("日付,金額\n") == ImportResult([], [], 0)
+
+
+def test_r5_both_withdraw_and_deposit_blank_is_error() -> None:
+    result = import_bank_csv("日付,出金額,入金額\n2026-01-05,,\n")
+    assert result.skipped == 0
+    assert [e.column for e in result.errors] == ["出金額"]
+
+
+def test_r6_input_order_and_trimmed_memo() -> None:
+    text = "日付,摘要,金額\n2026-01-06,  B ,200\n2026-01-05,A,100\n"
+    assert import_bank_csv(text).expenses == [
+        Expense(date(2026, 1, 6), "未分類", 200, "B"),
+        Expense(date(2026, 1, 5), "未分類", 100, "A"),
+    ]
diff --git a/tests/test_month_diff.py b/tests/test_month_diff.py
new file mode 100644
index 0000000..e197b4c
--- /dev/null
+++ b/tests/test_month_diff.py
@@ -0,0 +1,140 @@
+from __future__ import annotations
+
+import pytest
+
+from kakeibo.month_diff import CategoryChange, compare_months, format_report
+
+
+@pytest.mark.parametrize(
+    ("case_id", "totals", "month", "prev", "expected"),
+    [
+        # E4-1: 両月にあるカテゴリの増加 (R2)
+        (
+            "E4-1",
+            {"2026-01": {"食費": 30000}, "2026-02": {"食費": 35000}},
+            "2026-02",
+            None,
+            [CategoryChange("食費", 30000, 35000, 5000, 16.7, "up")],
+        ),
+    ],
+    ids=["E4-1"],
+)
+def test_example_rows(
+    case_id: str,
+    totals: dict[str, dict[str, int]],
+    month: str,
+    prev: str | None,
+    expected: list[CategoryChange],
+) -> None:
+    assert compare_months(totals, month, prev) == expected
+
+
+def test_E4_2_new_category_has_no_pct() -> None:
+    # E4-2: 前月に無いカテゴリ (D6, R3)
+    totals = {"2026-01": {}, "2026-02": {"交通": 2000}}
+    (change,) = compare_months(totals, "2026-02")
+    assert change.previous == 0
+    assert change.pct is None
+    assert change.status == "new"
+
+
+def test_E4_3_invalid_month_raises() -> None:
+    # E4-3: 不正な月 (R1)
+    with pytest.raises(ValueError):
+        compare_months({}, "2026-13")
+
+
+@pytest.mark.parametrize(
+    "bad", ["2026-00", "2026-1", "202601", "2026/01", "abcd-01", ""]
+)
+def test_invalid_month_formats_raise(bad: str) -> None:
+    with pytest.raises(ValueError):
+        compare_months({}, bad)
+
+
+@pytest.mark.parametrize("bad_prev", ["2026-13", "2026-00", "x"])
+def test_invalid_prev_raises(bad_prev: str) -> None:
+    with pytest.raises(ValueError):
+        compare_months({}, "2026-02", bad_prev)
+
+
+def test_default_prev_is_previous_calendar_month_across_year() -> None:
+    # D6: 1 月の前月は前年 12 月
+    totals = {"2025-12": {"食費": 1000}, "2026-01": {"食費": 1500}}
+    (change,) = compare_months(totals, "2026-01")
+    assert change.previous == 1000
+    assert change.current == 1500
+
+
+def test_missing_month_treated_as_empty() -> None:
+    # R1: 月が totals に無ければ空として扱う
+    totals = {"2026-01": {"食費": 800}}
+    changes = compare_months(totals, "2026-02")
+    assert len(changes) == 1
+    assert changes[0].status == "gone"
+    assert changes[0].current == 0
+
+
+def test_gone_status_and_pct() -> None:
+    totals = {"2026-01": {"食費": 4000}, "2026-02": {}}
+    (change,) = compare_months(totals, "2026-02", "2026-01")
+    assert change.status == "gone"
+    assert change.pct == -100.0
+
+
+def test_down_and_same_status() -> None:
+    totals = {
+        "2026-01": {"食費": 40000, "通信": 5000},
+        "2026-02": {"食費": 30000, "通信": 5000},
+    }
+    changes = {c.category: c for c in compare_months(totals, "2026-02", "2026-01")}
+    assert changes["食費"].status == "down"
+    assert changes["食費"].delta == -10000
+    assert changes["通信"].status == "same"
+    assert changes["通信"].delta == 0
+    assert changes["通信"].pct == 0.0
+
+
+def test_both_zero_categories_excluded() -> None:
+    # R2: 両月とも 0 のカテゴリは含めない
+    totals = {"2026-01": {"食費": 0}, "2026-02": {"食費": 0, "交通": 100}}
+    names = [c.category for c in compare_months(totals, "2026-02", "2026-01")]
+    assert names == ["交通"]
+
+
+def test_union_of_categories_and_sort_order() -> None:
+    # R2: abs(delta) 降順、同じなら category 昇順
+    totals = {
+        "2026-01": {"B": 1000, "A": 1000, "C": 500},
+        "2026-02": {"B": 1000, "A": 1000, "D": 3000},
+    }
+    changes = compare_months(totals, "2026-02", "2026-01")
+    assert [c.category for c in changes] == ["D", "C", "A", "B"]
+
+
+def test_pct_rounded_to_one_decimal() -> None:
+    totals = {"2026-01": {"食費": 3}, "2026-02": {"食費": 2}}
+    (change,) = compare_months(totals, "2026-02", "2026-01")
+    assert change.pct == -33.3
+
+
+def test_format_report_lines() -> None:
+    changes = [
+        CategoryChange("食費", 30000, 35000, 5000, 16.7, "up"),
+        CategoryChange("交通", 0, 2000, 2000, None, "new"),
+    ]
+    report = format_report(changes, "2026-02", "2026-01")
+    assert report == (
+        "2026-01 → 2026-02\n"
+        "食費: 30,000円 → 35,000円 (+5,000円, +16.7%)\n"
+        "交通: 0円 → 2,000円 (+2,000円, 新規)"
+    )
+
+
+def test_format_report_no_changes() -> None:
+    assert format_report([], "2026-02", "2026-01") == "2026-01 → 2026-02\n変化なし"
+
+
+def test_format_report_no_trailing_newline() -> None:
+    changes = [CategoryChange("食費", 1, 2, 1, 100.0, "up")]
+    assert not format_report(changes, "2026-02", "2026-01").endswith("\n")
