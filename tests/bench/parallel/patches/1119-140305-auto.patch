new file mode 100644
index 0000000..26c79e2
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,176 @@
+"""Condition search over expenses (pure functions)."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable
+from datetime import date
+from typing import Any, NoReturn
+
+from kakeibo.core import Expense
+
+Predicate = Callable[[Expense], bool]
+
+
+def _norm(text: str) -> str:
+    return unicodedata.normalize("NFKC", text)
+
+
+def _text_key(text: str) -> str:
+    """NFKC + 大文字小文字無視の比較キー(D5)。"""
+    return _norm(text).casefold()
+
+
+def search(rows: list[Expense], predicate: Predicate) -> list[Expense]:
+    """述語に合う行を入力順のまま新しいリストで返す。"""
+    return [e for e in rows if predicate(e)]
+
+
+def category(*names: str) -> Predicate:
+    """いずれかの名前に NFKC 後の完全一致(前後の空白除去)。"""
+    if not names:
+        raise ValueError("category には 1 つ以上の名前が必要です")
+    wanted = {_norm(n).strip() for n in names}
+
+    def pred(e: Expense) -> bool:
+        return _norm(e.category).strip() in wanted
+
+    return pred
+
+
+def amount_between(low: int | None = None, high: int | None = None) -> Predicate:
+    """low 以上 high 以下(両端含む)。None は無制限。"""
+    if low is not None and high is not None and low > high:
+        raise ValueError(f"金額の範囲が逆です: low={low} > high={high}")
+
+    def pred(e: Expense) -> bool:
+        return (low is None or e.amount >= low) and (high is None or e.amount <= high)
+
+    return pred
+
+
+def memo_contains(text: str) -> Predicate:
+    """メモの部分一致(NFKC + 大文字小文字無視)。空文字は全件一致。"""
+    needle = _text_key(text)
+
+    def pred(e: Expense) -> bool:
+        return needle in _text_key(e.memo)
+
+    return pred
+
+
+def between_dates(start: date | None = None, end: date | None = None) -> Predicate:
+    """start 以上 end 以下(両端含む)。None は無制限。"""
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"期間が逆です: start={start} > end={end}")
+
+    def pred(e: Expense) -> bool:
+        return (start is None or e.day >= start) and (end is None or e.day <= end)
+
+    return pred
+
+
+def all_of(*ps: Predicate) -> Predicate:
+    """全て真。空なら真。"""
+
+    def pred(e: Expense) -> bool:
+        return all(p(e) for p in ps)
+
+    return pred
+
+
+def any_of(*ps: Predicate) -> Predicate:
+    """いずれかが真。空なら偽。"""
+
+    def pred(e: Expense) -> bool:
+        return any(p(e) for p in ps)
+
+    return pred
+
+
+def not_(p: Predicate) -> Predicate:
+    def pred(e: Expense) -> bool:
+        return not p(e)
+
+    return pred
+
+
+_SPEC_KEYS = frozenset({"category", "amount", "memo", "period", "and", "or", "not"})
+
+
+def _spec_amount(value: Any) -> Predicate:
+    if not isinstance(value, list) or len(value) != 2:
+        raise ValueError("amount は [low, high] の 2 要素のリストである必要があります")
+    low, high = value
+    for bound in (low, high):
+        if bound is not None and (
+            isinstance(bound, bool) or not isinstance(bound, int)
+        ):
+            raise ValueError("amount の要素は整数か null である必要があります")
+    return amount_between(low, high)
+
+
+def _invalid(msg: str) -> NoReturn:
+    """仕様の不正(型違いを含む)は ValueError で報告する(R4)。"""
+    raise ValueError(msg)
+
+
+def _parse_date(value: Any, key: str) -> date | None:
+    if value is None:
+        return None
+    if not isinstance(value, str):
+        _invalid(f"{key} の日付は ISO 形式の文字列か null である必要があります")
+    try:
+        return date.fromisoformat(value)
+    except ValueError:
+        raise ValueError(f"{key} の日付が不正です: {value!r}") from None
+
+
+def _spec_period(value: Any) -> Predicate:
+    if not isinstance(value, list) or len(value) != 2:
+        raise ValueError("period は [start, end] の 2 要素のリストである必要があります")
+    start = _parse_date(value[0], "period")
+    end = _parse_date(value[1], "period")
+    return between_dates(start, end)
+
+
+def _spec_list(value: Any, key: str) -> list[Predicate]:
+    if not isinstance(value, list):
+        _invalid(f"{key} はリストである必要があります")
+    return [from_spec(s) for s in value]
+
+
+def from_spec(spec: dict[str, Any]) -> Predicate:
+    """dict の条件仕様から述語を組み立てる。複数キーは AND。"""
+    if not isinstance(spec, dict):
+        _invalid("検索条件はオブジェクトである必要があります")
+    parts: list[Predicate] = []
+    for key, value in spec.items():
+        if key not in _SPEC_KEYS:
+            raise ValueError(f"未知の検索キーです: {key!r}")
+        if key == "category":
+            names = [value] if isinstance(value, str) else value
+            if not isinstance(names, list) or not all(
+                isinstance(n, str) for n in names
+            ):
+                raise ValueError(
+                    "category は文字列か文字列のリストである必要があります"
+                )
+            parts.append(category(*names))
+        elif key == "amount":
+            parts.append(_spec_amount(value))
+        elif key == "memo":
+            if not isinstance(value, str):
+                raise ValueError("memo は文字列である必要があります")
+            parts.append(memo_contains(value))
+        elif key == "period":
+            parts.append(_spec_period(value))
+        elif key == "and":
+            parts.append(all_of(*_spec_list(value, "and")))
+        elif key == "or":
+            parts.append(any_of(*_spec_list(value, "or")))
+        else:  # "not"
+            if not isinstance(value, dict):
+                raise ValueError("not は検索条件のオブジェクトである必要があります")
+            parts.append(not_(from_spec(value)))
+    return all_of(*parts)
