@@ -0,0 +1,253 @@
+"""Import bank / card statement CSV text into Expense records (pure functions).
+
+The caller passes the file contents as a string; this module does no file I/O.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+class BankCsvError(ValueError):
+    """Raised when the CSV header lacks a required column."""
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int  # start line of the record (header is line 1)
+    column: str  # original column name; "" for column-count errors
+    value: str  # original value
+    reason: str  # human-readable reason (Japanese)
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+    skipped: int
+
+
+_DATE_ALIASES = frozenset({"日付", "利用日", "取引日", "ご利用日", "date"})
+_AMOUNT_ALIASES = frozenset({"金額", "利用金額", "ご利用金額", "amount"})
+_WITHDRAW_ALIASES = frozenset({"出金額", "出金", "お支払金額", "支払"})
+_DEPOSIT_ALIASES = frozenset({"入金額", "入金", "お預入金額", "預入"})
+_MEMO_ALIASES = frozenset(
+    {"摘要", "メモ", "利用店名", "ご利用店名", "内容", "description", "memo"}
+)
+_CATEGORY_ALIASES = frozenset({"カテゴリ", "分類", "費目", "category"})
+
+_DATE_PATTERNS = (
+    re.compile(r"([0-9]{4})-([0-9]{1,2})-([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})/([0-9]{1,2})/([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})\.([0-9]{1,2})\.([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日"),
+    re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})"),
+)
+_LINE_SPLIT = re.compile(r"\r\n|\r|\n")
+_AMOUNT_NOISE = re.compile(r"JPY|[¥円,]", re.IGNORECASE)
+
+
+class _CellError(ValueError):
+    def __init__(self, reason: str) -> None:
+        super().__init__(reason)
+        self.reason = reason
+
+
+@dataclass(frozen=True)
+class _Columns:
+    header: list[str]
+    date_i: int
+    amount_i: int | None
+    withdraw_i: int | None
+    deposit_i: int | None
+    memo_i: int | None
+    category_i: int | None
+
+
+def _find(header: list[str], aliases: frozenset[str]) -> int | None:
+    for i, name in enumerate(header):
+        if name.strip().lower() in aliases:
+            return i
+    return None
+
+
+def _locate(header: list[str]) -> _Columns:
+    date_i = _find(header, _DATE_ALIASES)
+    amount_i = _find(header, _AMOUNT_ALIASES)
+    withdraw_i = _find(header, _WITHDRAW_ALIASES)
+    if date_i is None:
+        raise BankCsvError(
+            "日付列がありません(日付・利用日・取引日・ご利用日・date のいずれか)"
+        )
+    if amount_i is None and withdraw_i is None:
+        raise BankCsvError(
+            "金額列(金額・利用金額・ご利用金額・amount)か出金列(出金額・出金・お支払金額・支払)がありません"
+        )
+    return _Columns(
+        header=header,
+        date_i=date_i,
+        amount_i=amount_i,
+        withdraw_i=withdraw_i,
+        deposit_i=_find(header, _DEPOSIT_ALIASES),
+        memo_i=_find(header, _MEMO_ALIASES),
+        category_i=_find(header, _CATEGORY_ALIASES),
+    )
+
+
+def _parse_date(raw: str) -> date:
+    text = unicodedata.normalize("NFKC", raw).strip()
+    if not text:
+        raise _CellError("日付が空です")
+    # A time may follow after whitespace or "T"; ignore it.
+    head = re.split(r"[\sT]", text, maxsplit=1)[0]
+    for pattern in _DATE_PATTERNS:
+        m = pattern.fullmatch(head)
+        if m:
+            year, month, day = (int(g) for g in m.groups())
+            try:
+                return date(year, month, day)
+            except ValueError:
+                raise _CellError("存在しない日付です") from None
+    raise _CellError("日付の形式が不正です")
+
+
+def _parse_amount(raw: str) -> int:
+    s = unicodedata.normalize("NFKC", raw).strip()
+    s = _AMOUNT_NOISE.sub("", s).strip()
+    if not s:
+        raise _CellError("金額が空です")
+    negative = False
+    if s[0] in ("-", "−", "△", "▲"):
+        negative, s = True, s[1:]
+    elif len(s) >= 2 and s[0] == "(" and s[-1] == ")":
+        negative, s = True, s[1:-1]
+    elif s.endswith("-"):
+        negative, s = True, s[:-1]
+    s = s.strip()
+    if not re.fullmatch(r"[0-9]+", s):
+        raise _CellError("金額は円の整数で書いてください")
+    value = int(s)
+    return -value if negative else value
+
+
+def _convert(
+    line: int, cols: _Columns, row: list[str], default_category: str
+) -> tuple[Expense | None, bool, list[RowError]]:
+    """Return (expense, skipped, errors) for one record."""
+    errs: list[RowError] = []
+
+    def fail(idx: int | None, reason: str) -> None:
+        column = cols.header[idx] if idx is not None else ""
+        value = row[idx] if idx is not None else ""
+        errs.append(RowError(line, column, value, reason))
+
+    day: date | None = None
+    try:
+        day = _parse_date(row[cols.date_i])
+    except _CellError as e:
+        fail(cols.date_i, e.reason)
+
+    amount: int | None = None
+    skip = False
+    if cols.amount_i is not None:
+        try:
+            amount = _parse_amount(row[cols.amount_i])
+        except _CellError as e:
+            fail(cols.amount_i, e.reason)
+    else:
+        w_idx, d_idx = cols.withdraw_i, cols.deposit_i
+        w_raw = row[w_idx] if w_idx is not None else ""
+        d_raw = row[d_idx] if d_idx is not None else ""
+        w_blank = not w_raw.strip()
+        d_blank = not d_raw.strip()
+        w: int | None = None
+        d: int | None = None
+        if not w_blank:
+            try:
+                w = _parse_amount(w_raw)
+            except _CellError as e:
+                fail(w_idx, e.reason)
+        if not d_blank:
+            try:
+                d = _parse_amount(d_raw)
+            except _CellError as e:
+                fail(d_idx, e.reason)
+        if w_blank and d_blank:
+            fail(w_idx, "出金・入金がどちらも空です")
+        elif w_blank:
+            if d is not None and d != 0:
+                skip = True  # deposit-only row: not an expense (D1)
+            elif d is not None:
+                fail(w_idx, "出金が空です")
+        else:
+            amount = w
+
+    category = default_category
+    if cols.category_i is not None:
+        category = row[cols.category_i].strip() or default_category
+    memo = row[cols.memo_i].strip() if cols.memo_i is not None else ""
+
+    if errs:
+        return None, False, errs
+    if skip:
+        return None, True, []
+    if day is None or amount is None:  # unreachable: no errors were recorded
+        return None, False, errs
+    return Expense(day=day, category=category, amount=amount, memo=memo), False, []
+
+
+def _delimiter(text: str) -> str:
+    head = next((ln for ln in _LINE_SPLIT.split(text) if ln.strip()), "")
+    return "\t" if "\t" in head and "," not in head else ","
+
+
+def _records(text: str, delim: str) -> list[tuple[int, list[str]]]:
+    """(start line, fields) for each non-blank record."""
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delim)
+    out: list[tuple[int, list[str]]] = []
+    consumed = 0
+    for row in reader:
+        if row:
+            out.append((consumed + 1, row))
+        consumed = reader.line_num
+    return out
+
+
+def import_bank_csv(text: str, default_category: str = "未分類") -> ImportResult:
+    text = text.removeprefix("﻿")
+    delim = _delimiter(text)
+    rows = _records(text, delim)
+    if not rows:
+        return ImportResult([], [], 0)
+    _, header = rows[0]
+    cols = _locate(header)
+
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    skipped = 0
+    width = len(header)
+    for line, row in rows[1:]:
+        if len(row) != width:
+            errors.append(
+                RowError(
+                    line,
+                    "",
+                    delim.join(row),
+                    f"列数が {width} 個のはずですが {len(row)} 個あります",
+                )
+            )
+            continue
+        expense, skip, errs = _convert(line, cols, row, default_category)
+        errors.extend(errs)
+        if expense is not None:
+            expenses.append(expense)
+        elif skip:
+            skipped += 1
+    return ImportResult(expenses, errors, skipped)
