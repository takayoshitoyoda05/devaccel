+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,99 @@
+"""Detect fixed expenses (recurring monthly series) and predict the next charge date."""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_NUMBER_SUFFIX_RE = re.compile(r"[#＃]?\d+$")
+_SPACES_RE = re.compile(r"\s+")
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str  # 最新の行の元のメモ
+    amount: int  # 最新の金額(円)
+    months: int  # 系列の月数
+    last: date  # 最新の日付
+    next_date: date  # 次回予定日
+
+
+def _normalize_memo(memo: str) -> str:
+    s = unicodedata.normalize("NFKC", memo).casefold()
+    s = _SPACES_RE.sub(" ", s).strip()
+    return _NUMBER_SUFFIX_RE.sub("", s).strip()
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + (d.month - 1)
+
+
+def _series_of(
+    members: list[Expense], latest_month: int, min_months: int
+) -> Recurring | None:
+    # 同じ行の集合に対して決定的になるよう、日付・金額・メモで最新行を選ぶ
+    latest = max(members, key=lambda e: (e.day, e.amount, e.memo))
+    if _month_index(latest.day) != latest_month:
+        return None
+    ref = latest.amount
+    series: list[Expense] = []
+    idx = latest_month
+    while True:
+        # 金額は最新の金額の ±10% 以内(10 * |差| <= 最新額 を整数で判定)
+        hits = [
+            e
+            for e in members
+            if _month_index(e.day) == idx and abs(e.amount - ref) * 10 <= ref
+        ]
+        if not hits:
+            break
+        if len(hits) > 1:
+            # 同じ系列で 1 か月に 2 回以上あるものは固定費としない
+            return None
+        series.append(hits[0])
+        idx -= 1
+    if len(series) < min_months:
+        return None
+    # 次回: 系列の最後の月の翌月 × 系列内で最大の日(月末に切り詰め)
+    year, month_zero = divmod(latest_month + 1, 12)
+    month = month_zero + 1
+    day = min(max(e.day.day for e in series), calendar.monthrange(year, month)[1])
+    return Recurring(
+        category=latest.category,
+        memo=latest.memo,
+        amount=ref,
+        months=len(series),
+        last=latest.day,
+        next_date=date(year, month, day),
+    )
+
+
+def find_recurring(rows: list[Expense], min_months: int = 3) -> list[Recurring]:
+    """最新の月で終わる、連続した月の系列を固定費として返す。
+
+    同一の判定は (カテゴリ, 正規化メモ)。返金・0 円以下は系列に入れない。
+    並びは next_date → category → memo の昇順。
+    """
+    if min_months < 2:
+        raise ValueError("min_months は 2 以上である必要があります")
+    if not rows:
+        return []
+    latest_month = max(_month_index(e.day) for e in rows)
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        if e.amount <= 0:
+            continue
+        groups.setdefault((e.category, _normalize_memo(e.memo)), []).append(e)
+    result: list[Recurring] = []
+    for members in groups.values():
+        rec = _series_of(members, latest_month, min_months)
+        if rec is not None:
+            result.append(rec)
+    result.sort(key=lambda r: (r.next_date, r.category, r.memo))
+    return result
