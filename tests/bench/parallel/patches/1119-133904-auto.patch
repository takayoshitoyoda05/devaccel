index 0000000..a95d99a
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,124 @@
+"""Detect recurring monthly expenses and predict the next occurrence.
+
+Pure functions only: no I/O, no reference to the current time, input is not mutated.
+"""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+from itertools import pairwise
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str  # memo of the last entry in the series
+    amount: int  # median of the series (yen, truncated)
+    months: int  # number of months in the series
+    last_day: date
+    next_day: date
+
+
+def _norm_text(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).lower()
+
+
+def _norm_memo(memo: str) -> str:
+    s = re.sub(r"\s+", "", _norm_text(memo))
+    # 末尾の数字と記号(#12, 2026/05 など)を除去
+    return re.sub(r"[\d\W_]+$", "", s)
+
+
+def _median_amount(values: list[int]) -> int:
+    s = sorted(values)
+    n = len(s)
+    mid = n // 2
+    if n % 2:
+        return s[mid]
+    return (s[mid - 1] + s[mid]) // 2
+
+
+def _clusters(rows: list[Expense]) -> list[list[Expense]]:
+    """Split rows (sorted by day) into amount clusters within ±10% of the median."""
+    clusters: list[list[Expense]] = []
+    for e in rows:
+        for cluster in clusters:
+            m = _median_amount([x.amount for x in cluster])
+            if abs(e.amount - m) * 10 <= m:
+                cluster.append(e)
+                break
+        else:
+            clusters.append([e])
+    return clusters
+
+
+def _one_per_month(cluster: list[Expense]) -> list[Expense]:
+    """Keep the first entry of each month (cluster is sorted by day)."""
+    seen: set[tuple[int, int]] = set()
+    kept: list[Expense] = []
+    for e in cluster:
+        ym = (e.day.year, e.day.month)
+        if ym not in seen:
+            seen.add(ym)
+            kept.append(e)
+    return kept
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month
+
+
+def _is_regular(series: list[Expense]) -> bool:
+    for a, b in pairwise(series):
+        if _month_index(b.day) - _month_index(a.day) != 1:
+            return False  # 欠けた月がある
+        if not 25 <= (b.day - a.day).days <= 35:
+            return False
+    return True
+
+
+def _build(series: list[Expense]) -> Recurring:
+    last = series[-1]
+    days = sorted(e.day.day for e in series)
+    day_median = days[(len(days) - 1) // 2]  # 下側中央値
+    next_year = last.day.year + last.day.month // 12
+    next_month = last.day.month % 12 + 1
+    last_dom = calendar.monthrange(next_year, next_month)[1]
+    return Recurring(
+        category=last.category,
+        memo=last.memo,
+        amount=_median_amount([e.amount for e in series]),
+        months=len(series),
+        last_day=last.day,
+        next_day=date(next_year, next_month, min(day_median, last_dom)),
+    )
+
+
+def find_recurring(rows: list[Expense], min_months: int = 3) -> list[Recurring]:
+    """Return recurring series sorted by amount desc, then category, then memo."""
+    if min_months < 2:
+        raise ValueError("min_months は 2 以上である必要があります")
+
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        if e.amount <= 0:  # D1: 返金・0 円は含めない
+            continue
+        key = (_norm_text(e.category).strip(), _norm_memo(e.memo))
+        groups.setdefault(key, []).append(e)
+
+    out: list[Recurring] = []
+    for group in groups.values():
+        for cluster in _clusters(sorted(group, key=lambda e: e.day)):
+            series = _one_per_month(cluster)
+            if len(series) < min_months or not _is_regular(series):
+                continue
+            out.append(_build(series))
+
+    out.sort(key=lambda r: (-r.amount, r.category, r.memo))
+    return out
diff --git a/src/kakeibo/search.py b/src/kakeibo/search.py
