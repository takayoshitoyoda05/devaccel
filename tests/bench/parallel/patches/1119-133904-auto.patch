@@ -0,0 +1,105 @@
+"""Parsing helpers for bank CSV values (amount, date, header). Pure functions."""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from datetime import date
+
+# 符号として扱う記号: ASCII マイナス, U+2212 マイナス, 三角(△▲)
+_SIGNS = ("-", "−", "△", "▲")
+_AMOUNT_BODY_RE = re.compile(r"[0-9]{1,3}(?:,[0-9]{3})+|[0-9]+")
+_TIME_RE = re.compile(r"[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?")
+_ISO_RE = re.compile(r"([0-9]{4})([-/.])([0-9]{1,2})\2([0-9]{1,2})")
+_KANJI_RE = re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日")
+_COMPACT_RE = re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})")
+_REIWA_RE = re.compile(
+    r"R([0-9]{1,2})[-/.]([0-9]{1,2})[-/.]([0-9]{1,2})", re.IGNORECASE
+)
+_REIWA_BASE_YEAR = 2018  # 令和元年 = 2019 年 → 令和 N 年 = 2018 + N
+
+_HEADER_ALIASES: dict[str, str] = {}
+for _std, _names in {
+    "date": ["日付", "利用日", "取引日", "ご利用日", "date"],
+    "amount": ["金額", "利用金額", "ご利用金額", "amount"],
+    "withdrawal": ["出金額", "出金", "支払", "お支払金額", "withdrawal"],
+    "deposit": ["入金額", "入金", "預入", "お預入金額", "deposit"],
+    "description": [
+        "摘要",
+        "メモ",
+        "利用店名",
+        "ご利用店名",
+        "内容",
+        "description",
+        "memo",
+    ],
+}.items():
+    for _name in _names:
+        _HEADER_ALIASES[_name] = _std
+
+
+def parse_amount(s: str) -> int:
+    """Parse a bank amount. Sign markers (-, −, △, ▲, parentheses, trailing -) yield negatives."""
+    text = unicodedata.normalize("NFKC", s).strip()
+    text = re.sub(r"^(?:¥|JPY\s*)", "", text, flags=re.IGNORECASE).strip()
+    text = re.sub(r"円$", "", text).strip()
+
+    negative = False
+    signs = 0
+    if len(text) >= 2 and text.startswith("(") and text.endswith(")"):
+        text = text[1:-1].strip()
+        negative = True
+        signs += 1
+    if text[:1] in _SIGNS:
+        text = text[1:].strip()
+        negative = True
+        signs += 1
+    if text.endswith("-"):
+        text = text[:-1].strip()
+        negative = True
+        signs += 1
+
+    if signs > 1 or any(ch in _SIGNS for ch in text):
+        raise ValueError(f"符号が二重になっています: {s!r}")
+    if not _AMOUNT_BODY_RE.fullmatch(text):
+        raise ValueError(f"金額として解釈できません: {s!r}")
+
+    value = int(text.replace(",", ""))
+    return -value if negative else value
+
+
+def parse_date(s: str) -> date:
+    """Parse a bank date (ISO-like, kanji, compact, or Reiwa). An optional time part is ignored."""
+    text = unicodedata.normalize("NFKC", s).strip()
+    parts = text.split()
+    if len(parts) == 2:
+        if not _TIME_RE.fullmatch(parts[1]):
+            raise ValueError(f"時刻として解釈できません: {s!r}")
+        text = parts[0]
+    elif len(parts) > 2 or not parts:
+        raise ValueError(f"日付として解釈できません: {s!r}")
+
+    year: int | None = None
+    month = day = 0
+    m = _ISO_RE.fullmatch(text)
+    if m:
+        year, month, day = int(m.group(1)), int(m.group(3)), int(m.group(4))
+    m = _KANJI_RE.fullmatch(text) or _COMPACT_RE.fullmatch(text)
+    if m and year is None:
+        year, month, day = int(m.group(1)), int(m.group(2)), int(m.group(3))
+    m = _REIWA_RE.fullmatch(text)
+    if m:
+        year = _REIWA_BASE_YEAR + int(m.group(1))
+        month, day = int(m.group(2)), int(m.group(3))
+    if year is None:
+        raise ValueError(f"日付として解釈できません: {s!r}")
+    try:
+        return date(year, month, day)
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def normalize_header(s: str) -> str | None:
+    """Map a bank CSV column name to a standard name, or None when unknown."""
+    key = unicodedata.normalize("NFKC", s).lower().strip()
+    return _HEADER_ALIASES.get(key)
