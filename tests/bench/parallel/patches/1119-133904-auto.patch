+"""Month-over-month comparison per category (pure functions, no I/O)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryDiff:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    pct: float | None
+    status: str  # up / down / same / new / gone
+
+
+def _check_month(month: str, name: str) -> None:
+    if not isinstance(month, str) or not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"{name} は YYYY-MM 形式である必要があります: {month!r}")
+
+
+def _prev_month(month: str) -> str:
+    year, mon = int(month[:4]), int(month[5:])
+    if mon == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mon - 1:02d}"
+
+
+def _month_of(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def compare_months(
+    rows: list[Expense], month: str, previous: str | None = None
+) -> list[CategoryDiff]:
+    _check_month(month, "month")
+    if previous is None:
+        previous = _prev_month(month)
+    else:
+        _check_month(previous, "previous")
+
+    prev_totals: dict[str, int] = {}
+    cur_totals: dict[str, int] = {}
+    for e in rows:
+        m = _month_of(e)
+        if m == previous:
+            prev_totals[e.category] = prev_totals.get(e.category, 0) + e.amount
+        elif m == month:
+            cur_totals[e.category] = cur_totals.get(e.category, 0) + e.amount
+
+    diffs: list[CategoryDiff] = []
+    for cat in set(prev_totals) | set(cur_totals):
+        prev_amt = prev_totals.get(cat, 0)
+        cur_amt = cur_totals.get(cat, 0)
+        delta = cur_amt - prev_amt
+        pct = None if prev_amt == 0 else round(delta / prev_amt * 100, 1)
+        if prev_amt == 0 and cur_amt > 0:
+            status = "new"
+        elif cur_amt == 0 and prev_amt > 0:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        diffs.append(CategoryDiff(cat, prev_amt, cur_amt, delta, pct, status))
+
+    diffs.sort(key=lambda d: (-abs(d.delta), d.category))
+    return diffs
+
+
+def _line(d: CategoryDiff) -> str:
+    head = f"{d.category}  {d.previous:,} → {d.current:,}"
+    if d.status == "same":
+        return f"{head}  → 変化なし"
+    tail = f"{d.delta:+,}"
+    if d.status == "new":
+        tail += " (新規)"
+    elif d.status == "gone":
+        tail += " (なし)"
+    elif d.pct is not None:
+        tail += f" ({d.pct:+.1f}%)"
+    tail += " ↑" if d.delta > 0 else " ↓"
+    return f"{head}  {tail}"
+
+
+def format_report(diffs: list[CategoryDiff]) -> str:
+    if not diffs:
+        return "変化なし"
+    return "\n".join(_line(d) for d in diffs)
