+"""Tests for kakeibo.bankparse (bank CSV value parsing)."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankparse import normalize_header, parse_amount, parse_date
+
+# --- R1: amount notation -----------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param("▲１，２００円", -1200, id="E2-1"),
+        pytest.param("1234", 1234, id="R1-plain"),
+        pytest.param("1,234", 1234, id="R1-comma"),
+        pytest.param("1，２３４", 1234, id="R1-fullwidth-digits-and-comma"),
+        pytest.param("¥1,234", 1234, id="R1-yen-halfwidth"),
+        pytest.param("￥1,234", 1234, id="R1-yen-fullwidth"),
+        pytest.param("1,234円", 1234, id="R1-yen-suffix"),
+        pytest.param("JPY 1234", 1234, id="R1-jpy-prefix"),
+        pytest.param("-300", -300, id="R1-minus"),
+        pytest.param("−300", -300, id="R1-unicode-minus"),
+        pytest.param("△500", -500, id="R1-triangle"),
+        pytest.param("▲500", -500, id="R1-black-triangle"),
+        pytest.param("(500)", -500, id="R1-parens"),
+        pytest.param("500-", -500, id="R1-trailing-minus"),
+        pytest.param("　 1234 　", 1234, id="R1-surrounding-spaces"),
+        pytest.param("0", 0, id="R1-zero"),
+    ],
+)
+def test_parse_amount_accepts(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        pytest.param("", id="R2-empty"),
+        pytest.param("-", id="R2-minus-only"),
+        pytest.param("—", id="R2-dash-only"),
+        pytest.param("12.5", id="E2-2"),
+        pytest.param("abc", id="R2-no-digit"),
+        pytest.param("--5", id="R2-double-sign"),
+        pytest.param("(-5)", id="R2-double-sign-parens"),
+    ],
+)
+def test_parse_amount_rejects(text: str) -> None:
+    with pytest.raises(ValueError) as exc:
+        parse_amount(text)
+    assert text in str(exc.value)
+
+
+# --- R3: date notation -------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param("R8.1.5", date(2026, 1, 5), id="E2-3"),
+        pytest.param("2026-01-05", date(2026, 1, 5), id="R3-dash"),
+        pytest.param("2026/1/5", date(2026, 1, 5), id="R3-slash"),
+        pytest.param("2026.1.5", date(2026, 1, 5), id="R3-dot"),
+        pytest.param("2026年1月5日", date(2026, 1, 5), id="R3-kanji"),
+        pytest.param("20260105", date(2026, 1, 5), id="R3-compact"),
+        pytest.param("2026-01-05 12:30:00", date(2026, 1, 5), id="R3-with-time"),
+    ],
+)
+def test_parse_date_accepts(text: str, expected: date) -> None:
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        pytest.param("2026/2/30", id="R3-nonexistent-day"),
+        pytest.param("2026年", id="R3-year-only"),
+        pytest.param("abc", id="R3-garbage"),
+        pytest.param("2026-01", id="R3-no-day"),
+        pytest.param("2026-01-05 foo", id="R3-bad-time"),
+        pytest.param("2026-01-05 12:30:00 extra", id="R3-trailing-tokens"),
+    ],
+)
+def test_parse_date_rejects(text: str) -> None:
+    with pytest.raises(ValueError) as exc:
+        parse_date(text)
+    assert text.strip() in str(exc.value)
+
+
+# --- R4: header normalization ------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param("日付", "date", id="R4-date-ja"),
+        pytest.param("利用日", "date", id="R4-date-riyou"),
+        pytest.param("取引日", "date", id="R4-date-torihiki"),
