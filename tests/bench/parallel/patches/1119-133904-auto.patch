@@ -0,0 +1,161 @@
+"""Tests for kakeibo.bankimport (bank CSV -> Expense)."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import ImportResult, RowError, import_bank_csv
+from kakeibo.core import Expense
+
+
+def test_E3_1_amount_column_quoted_thousands_and_default_category() -> None:
+    """E3-1: 利用日/ご利用店名/利用金額 → 1 件、未分類、memo は店名 (R1 R4)."""
+    text = '利用日,ご利用店名,利用金額\n2026/1/5,スーパー,"1,200"\n'
+    result = import_bank_csv(text)
+    assert result == ImportResult(
+        expenses=[Expense(date(2026, 1, 5), "未分類", 1200, "スーパー")],
+        errors=[],
+        skipped=0,
+    )
+
+
+def test_E3_2_deposit_only_row_is_skipped() -> None:
+    """E3-2: 出金が空で入金のみ → expenses=[]、skipped=1 (R2)."""
+    text = "日付,出金額,入金額\n2026-01-05,,5000\n"
+    result = import_bank_csv(text)
+    assert result == ImportResult(expenses=[], errors=[], skipped=1)
+
+
+def test_E3_3_bad_date_and_amount_both_reported_on_line_2() -> None:
+    """E3-3: 日付も金額も不正な 2 行目 → errors に 2 つ (line=2、date と amount) (R3)."""
+    text = "日付,金額\nxx,yy\n"
+    result = import_bank_csv(text)
+    assert [(e.line, e.column) for e in result.errors] == [(2, "date"), (2, "amount")]
+    assert [e.value for e in result.errors] == ["xx", "yy"]
+    assert result.expenses == []
+
+
+# --- R1: ヘッダーと空入力 ---
+
+
+def test_R1_empty_string_raises() -> None:
+    with pytest.raises(ValueError):
+        import_bank_csv("")
+
+
+def test_R1_header_only_gives_empty_result() -> None:
+    assert import_bank_csv("日付,金額\n") == ImportResult([], [], 0)
+
+
+def test_R1_missing_date_column_raises_naming_it() -> None:
+    with pytest.raises(ValueError, match="date"):
+        import_bank_csv("金額,摘要\n100,a\n")
+
+
+@pytest.mark.parametrize("header", ["日付,摘要", "日付,入金額"])
+def test_R1_missing_amount_and_withdrawal_raises_naming_them(header: str) -> None:
+    with pytest.raises(ValueError, match="amount") as info:
+        import_bank_csv(header + "\n")
+    assert "withdrawal" in str(info.value)
+
+
+def test_R1_bom_is_ignored() -> None:
+    result = import_bank_csv("﻿日付,金額\n2026-01-05,100\n")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+def test_R1_tab_delimiter_is_detected() -> None:
+    result = import_bank_csv("日付\t金額\n2026-01-05\t100\n")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+# --- R2: 金額列と出金・入金 ---
+
+
+def test_R2_amount_column_is_preferred_over_withdrawal() -> None:
+    result = import_bank_csv("日付,金額,出金額\n2026-01-05,300,999\n")
+    assert [e.amount for e in result.expenses] == [300]
+
+
+def test_R2_withdrawal_present_uses_withdrawal_amount() -> None:
+    result = import_bank_csv("日付,出金額,入金額\n2026-01-05,700,\n")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 700, "")]
+
+
+def test_R2_both_withdrawal_and_deposit_empty_is_row_error() -> None:
+    result = import_bank_csv("日付,出金額,入金額\n2026-01-05,,\n")
+    assert result.errors == [RowError(2, "withdrawal", "", result.errors[0].reason)]
+    assert result.skipped == 0
+
+
+def test_R2_negative_withdrawal_is_kept_signed() -> None:
+    result = import_bank_csv("日付,出金額\n2026-01-05,△500\n")
+    assert [e.amount for e in result.expenses] == [-500]
+
+
+def test_R2_deposit_only_row_with_bad_date_is_error_not_skip() -> None:
+    result = import_bank_csv("日付,出金額,入金額\nxx,,5000\n")
+    assert [(e.line, e.column) for e in result.errors] == [(2, "date")]
+    assert result.skipped == 0
+
+
+# --- R3: 行番号・空行・エラー ---
+
+
+def test_R3_line_number_of_record_with_embedded_newline_is_start_line() -> None:
+    text = '日付,金額,摘要\n2026-01-05,100,"a\nb"\nxx,1,c\n'
+    result = import_bank_csv(text)
+    assert [e.line for e in result.errors] == [4]
+    assert [e.column for e in result.errors] == ["date"]
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "a\nb")]
+
+
+def test_R3_blank_lines_are_silently_skipped() -> None:
+    result = import_bank_csv("日付,金額\n\n2026-01-05,100\n\n")
+    assert result == ImportResult(
+        expenses=[Expense(date(2026, 1, 5), "未分類", 100, "")],
+        errors=[],
+        skipped=0,
+    )
+
+
+def test_R3_column_count_mismatch_is_row_error() -> None:
+    result = import_bank_csv("日付,金額\n2026-01-05\n")
+    assert len(result.errors) == 1
+    assert result.errors[0].line == 2
+    assert result.errors[0].column == ""
+    assert result.expenses == []
+
+
+def test_R3_invalid_amount_reports_original_value() -> None:
+    result = import_bank_csv("日付,金額\n2026-01-05,abc\n")
+    assert result.errors == [RowError(2, "amount", "abc", result.errors[0].reason)]
+
+
+# --- R4: カテゴリと memo ---
+
+
+def test_R4_all_rows_get_default_category() -> None:
+    result = import_bank_csv("日付,金額\n2026-01-05,1\n", default_category="雑費")
+    assert [e.category for e in result.expenses] == ["雑費"]
+
+
+def test_R4_memo_from_description_column() -> None:
+    result = import_bank_csv("日付,金額,摘要\n2026-01-05,1,  書店  \n")
+    assert [e.memo for e in result.expenses] == ["書店"]
+
+
+def test_R4_memo_empty_without_description_column() -> None:
+    result = import_bank_csv("日付,金額\n2026-01-05,1\n")
+    assert [e.memo for e in result.expenses] == [""]
+
+
+# --- R5: 元の行の順 ---
+
+
+def test_R5_expenses_keep_row_order() -> None:
+    text = "日付,金額\n2026-01-09,3\n2026-01-01,1\n2026-01-05,2\n"
+    result = import_bank_csv(text)
+    assert [e.amount for e in result.expenses] == [3, 1, 2]
diff --git a/tests/test_bankparse.py b/tests/test_bankparse.py
