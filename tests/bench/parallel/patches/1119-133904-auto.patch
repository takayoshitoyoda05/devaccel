@@ -0,0 +1,278 @@
+"""Tests for kakeibo.monthdiff (month-over-month comparison)."""
+
+from __future__ import annotations
+
+import copy
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import CategoryDiff, compare_months, format_report
+
+
+def _e(day: str, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+def _by_cat(diffs: list[CategoryDiff]) -> dict[str, CategoryDiff]:
+    return {d.category: d for d in diffs}
+
+
+# --- 例の表 (E5-*) -------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "case_id",
+    ["E5-1"],
+)
+def test_example_table_up(case_id: str) -> None:
+    # E5-1: 前月に食費 100、今月に食費 150 → delta=50, pct=50.0, status=up (R2 R3)
+    rows = [_e("2026-04-10", "食費", 100), _e("2026-05-10", "食費", 150)]
+    diffs = compare_months(rows, "2026-05")
+    d = _by_cat(diffs)["食費"]
+    assert (d.previous, d.current, d.delta, d.pct, d.status) == (
+        100,
+        150,
+        50,
+        50.0,
+        "up",
+    )
+
+
+@pytest.mark.parametrize(
+    "case_id",
+    ["E5-2"],
+)
+def test_example_table_new(case_id: str) -> None:
+    # E5-2: 今月だけ交通費 300 → previous=0, pct=None, status=new (R2 R3)
+    rows = [_e("2026-05-03", "交通費", 300)]
+    diffs = compare_months(rows, "2026-05")
+    d = _by_cat(diffs)["交通費"]
+    assert (d.previous, d.current, d.delta, d.pct, d.status) == (
+        0,
+        300,
+        300,
+        None,
+        "new",
+    )
+
+
+@pytest.mark.parametrize(
+    "case_id",
+    ["E5-3"],
+)
+def test_example_table_bad_month(case_id: str) -> None:
+    # E5-3: month="2026-1" → ValueError (R1)
+    with pytest.raises(ValueError):
+        compare_months([], "2026-1")
+
+
+# --- R1 month -------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "bad", ["2026-13", "2026-00", "26-05", "2026/05", "2026-05-01", ""]
+)
+def test_invalid_month_raises(bad: str) -> None:
+    with pytest.raises(ValueError):
+        compare_months([], bad)
+
+
+def test_invalid_previous_raises() -> None:
+    with pytest.raises(ValueError):
+        compare_months([], "2026-05", previous="2026-4")
+
+
+def test_previous_defaults_to_prior_month() -> None:
+    rows = [_e("2026-04-01", "食費", 100), _e("2026-05-01", "食費", 100)]
+    d = _by_cat(compare_months(rows, "2026-05"))["食費"]
+    assert d.previous == 100
+
+
+def test_january_previous_is_december_of_prior_year() -> None:
+    rows = [_e("2025-12-20", "食費", 80), _e("2026-01-05", "食費", 120)]
+    d = _by_cat(compare_months(rows, "2026-01"))["食費"]
+    assert (d.previous, d.current, d.delta, d.status) == (80, 120, 40, "up")
+
+
+def test_explicit_previous_is_used() -> None:
+    rows = [
+        _e("2026-03-01", "食費", 200),
+        _e("2026-04-01", "食費", 999),
+        _e("2026-05-01", "食費", 220),
+    ]
+    d = _by_cat(compare_months(rows, "2026-05", previous="2026-03"))["食費"]
+    assert (d.previous, d.current, d.delta) == (200, 220, 20)
+
+
+# --- R2 status ------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("prev_amt", "cur_amt", "status"),
+    [
+        (100, 150, "up"),
+        (150, 100, "down"),
+        (100, 100, "same"),
+        (0, 300, "new"),
+        (300, 0, "gone"),
+    ],
+)
+def test_status(prev_amt: int, cur_amt: int, status: str) -> None:
+    rows: list[Expense] = []
+    if prev_amt:
+        rows.append(_e("2026-04-01", "食費", prev_amt))
+    if cur_amt:
+        rows.append(_e("2026-05-01", "食費", cur_amt))
+    # 0 円側には行を置かないので、カテゴリ自体は存在する側の月に必ずある。
+    d = _by_cat(compare_months(rows, "2026-05"))["食費"]
+    assert d.status == status
+
+
+def test_category_in_neither_month_is_omitted() -> None:
+    rows = [_e("2026-02-01", "旅行", 5000), _e("2026-05-01", "食費", 100)]
+    cats = [d.category for d in compare_months(rows, "2026-05")]
+    assert "旅行" not in cats
+    assert "食費" in cats
+
+
+def test_missing_side_counts_as_zero() -> None:
+    rows = [_e("2026-04-01", "娯楽", 500)]
+    d = _by_cat(compare_months(rows, "2026-05"))["娯楽"]
+    assert (d.previous, d.current, d.delta, d.status) == (500, 0, -500, "gone")
+
+
+# --- R2 refunds are summed (返金は合算) ------------------------------------
+
+
+def test_refunds_are_netted_within_month() -> None:
+    rows = [
+        _e("2026-04-01", "食費", 1000),
+        _e("2026-05-01", "食費", 800),
+        _e("2026-05-02", "食費", -300),  # refund
+    ]
+    d = _by_cat(compare_months(rows, "2026-05"))["食費"]
+    assert (d.previous, d.current, d.delta, d.status) == (1000, 500, -500, "down")
+
+
+# --- R3 pct ---------------------------------------------------------------
+
+
+def test_pct_is_rounded_to_one_decimal() -> None:
+    rows = [_e("2026-04-01", "食費", 300), _e("2026-05-01", "食費", 400)]
+    d = _by_cat(compare_months(rows, "2026-05"))["食費"]
+    # 100 / 300 * 100 = 33.333... -> 33.3
+    assert d.pct == 33.3
+
+
+def test_pct_none_when_previous_zero() -> None:
+    rows = [_e("2026-05-03", "交通費", 300)]
+    d = _by_cat(compare_months(rows, "2026-05"))["交通費"]
+    assert d.pct is None
+
+
+def test_pct_for_gone_is_minus_hundred() -> None:
+    rows = [_e("2026-04-01", "娯楽", 500)]
+    d = _by_cat(compare_months(rows, "2026-05"))["娯楽"]
+    assert d.pct == -100.0
+
+
+# --- R4 ordering ----------------------------------------------------------
+
+
+def test_sorted_by_abs_delta_desc_then_category_asc() -> None:
+    rows = [
+        _e("2026-04-01", "A", 100),
+        _e("2026-05-01", "A", 200),  # delta +100
+        _e("2026-04-01", "B", 500),
+        _e("2026-05-01", "B", 400),  # delta -100 (tie with A)
+        _e("2026-05-01", "C", 1000),  # delta +1000
+        _e("2026-04-01", "D", 50),
+        _e("2026-05-01", "D", 60),  # delta +10
+    ]
+    cats = [d.category for d in compare_months(rows, "2026-05")]
+    assert cats == ["C", "A", "B", "D"]
+
+
+def test_input_list_not_mutated() -> None:
+    rows = [_e("2026-04-01", "食費", 100), _e("2026-05-01", "食費", 150)]
+    snapshot = copy.deepcopy(rows)
+    compare_months(rows, "2026-05")
+    assert rows == snapshot
+
+
+# --- R5 format_report -----------------------------------------------------
+
+
+def test_format_up_line() -> None:
+    d = CategoryDiff(
+        category="食費",
+        previous=50000,
+        current=62000,
+        delta=12000,
+        pct=24.0,
+        status="up",
+    )
+    assert format_report([d]) == "食費  50,000 → 62,000  +12,000 (+24.0%) ↑"
+
+
+def test_format_down_line() -> None:
+    d = CategoryDiff(
+        category="食費",
+        previous=62000,
+        current=50000,
+        delta=-12000,
+        pct=-19.4,
+        status="down",
+    )
+    assert format_report([d]) == "食費  62,000 → 50,000  -12,000 (-19.4%) ↓"
+
+
+def test_format_new_line() -> None:
+    d = CategoryDiff(
+        category="交通費", previous=0, current=300, delta=300, pct=None, status="new"
+    )
+    assert format_report([d]) == "交通費  0 → 300  +300 (新規) ↑"
+
+
+def test_format_gone_line() -> None:
+    d = CategoryDiff(
+        category="娯楽", previous=500, current=0, delta=-500, pct=-100.0, status="gone"
+    )
+    assert format_report([d]) == "娯楽  500 → 0  -500 (なし) ↓"
+
+
+def test_format_same_line() -> None:
+    d = CategoryDiff(
+        category="食費", previous=100, current=100, delta=0, pct=0.0, status="same"
+    )
+    assert format_report([d]) == "食費  100 → 100  → 変化なし"
+
+
+def test_format_pct_none_omits_percent() -> None:
+    d = CategoryDiff(
+        category="雑費", previous=100, current=150, delta=50, pct=None, status="up"
+    )
+    line = format_report([d])
+    assert "%" not in line
+    assert line == "雑費  100 → 150  +50 ↑"
+
+
+def test_format_empty_is_no_change() -> None:
+    assert format_report([]) == "変化なし"
+
+
+def test_format_multiple_lines_one_per_category() -> None:
+    a = CategoryDiff(
+        category="A", previous=1, current=2, delta=1, pct=100.0, status="up"
+    )
+    b = CategoryDiff(
+        category="B", previous=2, current=1, delta=-1, pct=-50.0, status="down"
+    )
+    lines = format_report([a, b]).split("\n")
+    assert len(lines) == 2
+    assert lines[0].startswith("A ")
+    assert lines[1].startswith("B ")
