+"""Tests for kakeibo.recurring.find_recurring."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring
+
+
+def _e(day: str, category: str, amount: int, memo: str) -> Expense:
+    return Expense(date.fromisoformat(day), category, amount, memo)
+
+
+# E1-1: 家賃 80000 が 1/31, 2/28, 3/31(メモ同じ) -> 1 件、next_day=4/30、months=3
+def test_E1_1_monthly_rent_predicts_next_month_end() -> None:
+    rows = [
+        _e("2026-01-31", "家賃", 80000, "家賃"),
+        _e("2026-02-28", "家賃", 80000, "家賃"),
+        _e("2026-03-31", "家賃", 80000, "家賃"),
+    ]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="家賃",
+            memo="家賃",
+            amount=80000,
+            months=3,
+            last_day=date(2026, 3, 31),
+            next_day=date(2026, 4, 30),
+        )
+    ]
+
+
+# E1-2: 動画 1500 が 5 日と 20 日に毎月 3 か月ずつ(メモ同じ)
+#   -> 1 件(同月 2 回目は無視し 5 日の系列、next_day の日=5)
+def test_E1_2_same_month_twice_uses_first_entry() -> None:
+    rows = [
+        _e("2026-01-05", "動画", 1500, "動画"),
+        _e("2026-01-20", "動画", 1500, "動画"),
+        _e("2026-02-05", "動画", 1500, "動画"),
+        _e("2026-02-20", "動画", 1500, "動画"),
+        _e("2026-03-05", "動画", 1500, "動画"),
+        _e("2026-03-20", "動画", 1500, "動画"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].months == 3
+    assert result[0].last_day == date(2026, 3, 5)
+    assert result[0].next_day == date(2026, 4, 5)
+
+
+# E1-3: 3 か月のうち 2 月が欠けた系列 -> 空リスト
+def test_E1_3_missing_months_is_not_recurring() -> None:
+    rows = [
+        _e("2026-01-05", "ジム", 5000, "ジム"),
+        _e("2026-04-05", "ジム", 5000, "ジム"),
+        _e("2026-05-05", "ジム", 5000, "ジム"),
+    ]
+    assert find_recurring(rows) == []
+
+
+# --- 以下は判断 D1〜D6 と R2・R3 の規則の確認(表にない端のケース) ---
+
+
+def test_refund_is_excluded_from_series() -> None:
+    # D1: 返金(負の金額)は定期判定に含めない -> 2 月が欠けて定期にならない
+    rows = [
+        _e("2026-01-31", "家賃", 80000, "家賃"),
+        _e("2026-02-28", "家賃", -80000, "家賃"),
+        _e("2026-03-31", "家賃", 80000, "家賃"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_memo_normalization_groups_variants() -> None:
+    # D2: NFKC・小文字化・空白除去・末尾の数字と記号の除去で同じ系列になる
+    rows = [
+        _e("2026-01-15", "通信", 1000, "Netflix #12"),
+        _e("2026-02-15", "通信", 1000, "ｎｅｔｆｌｉｘ 2026/02"),
+        _e("2026-03-15", "通信", 1000, "NETFLIX #3"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].memo == "NETFLIX #3"
+    assert result[0].months == 3
+
+
+def test_amount_within_ten_percent_is_same_series() -> None:
+    # D2: 中央値の ±10% 以内なら同じ系列。amount は系列の中央値
+    rows = [
+        _e("2026-01-10", "水道", 1000, "水道"),
+        _e("2026-02-10", "水道", 1100, "水道"),
+        _e("2026-03-10", "水道", 1000, "水道"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].amount == 1000
+
+
+def test_amount_outside_ten_percent_is_separate_series() -> None:
+    # D2: 中央値の ±10% を超える金額は別の系列として扱い、どちらも 3 か月に満たない
+    rows = [
+        _e("2026-01-10", "水道", 1000, "水道"),
+        _e("2026-02-10", "水道", 1200, "水道"),
+        _e("2026-03-10", "水道", 1000, "水道"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_sorted_by_amount_desc_then_category_then_memo() -> None:
+    # R2: amount 降順、同点はカテゴリ、メモの昇順
+    rows: list[Expense] = []
+    for month in ("01", "02", "03"):
+        rows.append(_e(f"2026-{month}-01", "B", 1000, "b"))
+        rows.append(_e(f"2026-{month}-01", "A", 1000, "a"))
+        rows.append(_e(f"2026-{month}-01", "C", 2000, "c"))
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [
+        ("C", 2000),
+        ("A", 1000),
+        ("B", 1000),
+    ]
+
+
+def test_empty_input_returns_empty_list() -> None:
+    # R3
+    assert find_recurring([]) == []
+
+
+@pytest.mark.parametrize("min_months", [1, 0, -1])
+def test_min_months_below_two_raises(min_months: int) -> None:
+    # R3
+    with pytest.raises(ValueError):
+        find_recurring([], min_months=min_months)
+
+
+def test_input_list_is_not_mutated() -> None:
+    rows = [
+        _e("2026-03-31", "家賃", 80000, "家賃"),
+        _e("2026-01-31", "家賃", 80000, "家賃"),
+        _e("2026-02-28", "家賃", 80000, "家賃"),
+    ]
+    snapshot = list(rows)
+    find_recurring(rows)
+    assert rows == snapshot
