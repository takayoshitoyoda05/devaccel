@@ -0,0 +1,144 @@
+"""Import bank CSV text into Expense records. Pure functions."""
+
+from __future__ import annotations
+
+import csv
+import io
+import unicodedata
+from dataclasses import dataclass
+
+from kakeibo.bankparse import normalize_header, parse_amount, parse_date
+from kakeibo.core import Expense
+
+_BOM = "﻿"
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int  # 1 始まり。引用符内の改行を含むレコードは開始行
+    column: str  # 標準名(date / amount / withdrawal)。列数不一致のときは ""
+    value: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+    skipped: int
+
+
+def _is_blank(s: str) -> bool:
+    return unicodedata.normalize("NFKC", s).strip() == ""
+
+
+def _detect_delimiter(text: str) -> str:
+    first = text.split("\n", 1)[0]
+    return "\t" if first.count("\t") > first.count(",") else ","
+
+
+def _cell(row: list[str], index: dict[str, int], std: str) -> str:
+    return row[index[std]] if std in index else ""
+
+
+def import_bank_csv(text: str, default_category: str = "未分類") -> ImportResult:
+    if text == "":
+        raise ValueError("入力が空です")
+    body = text.removeprefix(_BOM)
+    if body.strip() == "":
+        return ImportResult([], [], 0)
+
+    reader = csv.reader(
+        io.StringIO(body, newline=""), delimiter=_detect_delimiter(body)
+    )
+    records: list[tuple[int, list[str]]] = []
+    while True:
+        start = reader.line_num + 1  # 次のレコードの開始行
+        try:
+            row = next(reader)
+        except StopIteration:
+            break
+        records.append((start, row))
+
+    header = records[0][1]
+    index: dict[str, int] = {}
+    for i, name in enumerate(header):
+        std = normalize_header(name)
+        if std is not None and std not in index:
+            index[std] = i
+    missing: list[str] = []
+    if "date" not in index:
+        missing.append("date")
+    if "amount" not in index and "withdrawal" not in index:
+        missing.append("amount または withdrawal")
+    if missing:
+        raise ValueError("必須列がありません: " + ", ".join(missing))
+
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    skipped = 0
+    width = len(header)
+    for line, row in records[1:]:
+        if not row:  # 空行は黙ってスキップ
+            continue
+        if len(row) != width:
+            errors.append(
+                RowError(
+                    line,
+                    "",
+                    ",".join(row),
+                    f"列数が合いません(ヘッダー {width} 列、行 {len(row)} 列)",
+                )
+            )
+            continue
+
+        row_errors: list[RowError] = []
+        raw_date = _cell(row, index, "date")
+        day = None
+        try:
+            day = parse_date(raw_date)
+        except ValueError as e:
+            row_errors.append(RowError(line, "date", raw_date, str(e)))
+
+        amount: int | None = None
+        deposit_only = False
+        if "amount" in index:
+            raw_amount = _cell(row, index, "amount")
+            try:
+                amount = parse_amount(raw_amount)
+            except ValueError as e:
+                row_errors.append(RowError(line, "amount", raw_amount, str(e)))
+        else:
+            withdrawal = _cell(row, index, "withdrawal")
+            deposit = _cell(row, index, "deposit")
+            if not _is_blank(withdrawal):
+                try:
+                    amount = parse_amount(withdrawal)
+                except ValueError as e:
+                    row_errors.append(RowError(line, "withdrawal", withdrawal, str(e)))
+            elif not _is_blank(deposit):
+                deposit_only = True  # 入金だけの行は支出ではない
+            else:
+                row_errors.append(
+                    RowError(
+                        line, "withdrawal", withdrawal, "出金額・入金額がどちらも空です"
+                    )
+                )
+
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        if deposit_only:
+            skipped += 1
+            continue
+        assert day is not None and amount is not None
+        expenses.append(
+            Expense(
+                day=day,
+                category=default_category,
+                amount=amount,
+                memo=_cell(row, index, "description").strip(),
+            )
+        )
+
+    return ImportResult(expenses, errors, skipped)
