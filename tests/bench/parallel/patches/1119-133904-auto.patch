@@ -0,0 +1,156 @@
+"""Tests for kakeibo.search.search."""
+
+from __future__ import annotations
+
+from datetime import date, datetime
+from typing import Any
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import search
+
+ROWS = [
+    Expense(date(2026, 5, 1), "食費", 1200, "スーパー"),  # 0
+    Expense(date(2026, 5, 3), "食費", 800, "コンビニ"),  # 1
+    Expense(date(2026, 5, 5), "日用品", 12000, "家電"),  # 2
+    Expense(date(2026, 6, 1), "交通費", 5, "バス"),  # 3
+    Expense(date(2026, 6, 10), "食費", 3000, "ｽｰﾊﾟｰ"),  # 4 (半角カナ)
+]
+
+
+def _pick(*idx: int) -> list[Expense]:
+    return [ROWS[i] for i in idx]
+
+
+# --- 例の表(E4-*) ---
+
+
+@pytest.mark.parametrize(
+    ("query", "expected"),
+    [
+        # E4-1: 食費でメモに「スーパー」を含む(半角カナも NFKC で一致)
+        pytest.param({"category": "食費", "memo": "ｽｰﾊﾟｰ"}, _pick(0, 4), id="E4-1"),
+        # E4-2: どちらかを満たす行
+        pytest.param(
+            {"or": [{"category": "食費"}, {"min_amount": 10000}]},
+            _pick(0, 1, 2, 4),
+            id="E4-2",
+        ),
+    ],
+)
+def test_example_table(query: dict[str, Any], expected: list[Expense]) -> None:
+    assert search(ROWS, query) == expected
+
+
+def test_E4_3_min_greater_than_max_raises() -> None:
+    # E4-3: min_amount > max_amount は ValueError
+    with pytest.raises(ValueError):
+        search(ROWS, {"min_amount": 5, "max_amount": 1})
+
+
+# --- R1 葉のキー ---
+
+
+def test_category_list_matches_any() -> None:
+    assert search(ROWS, {"category": ["食費", "交通費"]}) == _pick(0, 1, 3, 4)
+
+
+def test_amount_bounds_are_inclusive() -> None:
+    assert search(ROWS, {"min_amount": 800, "max_amount": 1200}) == _pick(0, 1)
+
+
+def test_memo_empty_string_matches_all() -> None:
+    assert search(ROWS, {"memo": ""}) == ROWS
+
+
+def test_memo_partial_match_is_nfkc_and_case_insensitive() -> None:
+    assert search(ROWS, {"memo": "パー"}) == _pick(0, 4)
+
+
+def test_since_until_are_inclusive() -> None:
+    assert search(
+        ROWS, {"since": date(2026, 5, 3), "until": date(2026, 6, 1)}
+    ) == _pick(1, 2, 3)
+
+
+def test_leaf_keys_in_one_dict_are_and() -> None:
+    assert search(ROWS, {"category": "食費", "max_amount": 1000}) == _pick(1)
+
+
+# --- R2 結合 ---
+
+
+def test_not_negates() -> None:
+    assert search(ROWS, {"not": {"category": "食費"}}) == _pick(2, 3)
+
+
+def test_empty_and_matches_all() -> None:
+    assert search(ROWS, {"and": []}) == ROWS
+
+
+def test_empty_or_matches_none() -> None:
+    assert search(ROWS, {"or": []}) == []
+
+
+def test_empty_dict_matches_all() -> None:
+    assert search(ROWS, {}) == ROWS
+
+
+def test_nested_combinators() -> None:
+    query = {
+        "and": [
+            {"or": [{"category": "交通費"}, {"min_amount": 10000}]},
+            {"not": {"memo": "家電"}},
+        ]
+    }
+    assert search(ROWS, query) == _pick(3)
+
+
+def test_combinator_mixed_with_leaf_is_and() -> None:
+    query = {"min_amount": 1000, "or": [{"memo": "スーパー"}, {"memo": "家電"}]}
+    assert search(ROWS, query) == _pick(0, 2, 4)
+
+
+# --- R4 順序・重複 ---
+
+
+def test_keeps_order_and_duplicates() -> None:
+    rows = [ROWS[0], ROWS[3], ROWS[0]]
+    assert search(rows, {"category": "食費"}) == [ROWS[0], ROWS[0]]
+
+
+def test_does_not_modify_input() -> None:
+    rows = list(ROWS)
+    search(rows, {"category": "食費"})
+    assert rows == ROWS
+
+
+# --- R3 ValueError ---
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        pytest.param({"foo": 1}, id="unknown-key"),
+        pytest.param({"category": 1}, id="category-not-str"),
+        pytest.param({"category": ["食費", 1]}, id="category-list-not-str"),
+        pytest.param({"memo": 1}, id="memo-not-str"),
+        pytest.param({"min_amount": True}, id="min-bool"),
+        pytest.param({"max_amount": False}, id="max-bool"),
+        pytest.param({"min_amount": 1.5}, id="min-float"),
+        pytest.param({"since": "2026-05-01"}, id="since-str"),
+        pytest.param({"until": datetime(2026, 5, 1)}, id="until-datetime"),
+        pytest.param(
+            {"since": date(2026, 6, 1), "until": date(2026, 5, 1)},
+            id="since-after-until",
+        ),
+        pytest.param({"and": {"category": "食費"}}, id="and-not-list"),
+        pytest.param({"or": {"category": "食費"}}, id="or-not-list"),
+        pytest.param({"and": ["食費"]}, id="and-element-not-dict"),
+        pytest.param({"not": [{"category": "食費"}]}, id="not-not-dict"),
+    ],
+)
+def test_invalid_query_raises(query: dict[str, Any]) -> None:
+    with pytest.raises(ValueError):
+        search(ROWS, query)
