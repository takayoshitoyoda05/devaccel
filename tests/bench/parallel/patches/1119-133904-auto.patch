index 0000000..6b2f85c
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,106 @@
+"""Search expense records with a dict-based query."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable, Mapping
+from datetime import date, datetime
+from typing import Any
+
+from kakeibo.core import Expense
+
+Pred = Callable[[Expense], bool]
+
+_LEAF_KEYS = frozenset(
+    {"category", "min_amount", "max_amount", "memo", "since", "until"}
+)
+_JOIN_KEYS = frozenset({"and", "or", "not"})
+
+
+def _invalid(message: str) -> ValueError:
+    return ValueError(message)
+
+
+def _norm(text: str) -> str:
+    return unicodedata.normalize("NFKC", text).lower().strip()
+
+
+def _check_int(key: str, value: Any) -> int:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise _invalid(f"{key} は整数である必要があります: {value!r}")
+    return value
+
+
+def _check_date(key: str, value: Any) -> date:
+    if not isinstance(value, date) or isinstance(value, datetime):
+        raise _invalid(f"{key} は date である必要があります: {value!r}")
+    return value
+
+
+def _leaf(key: str, value: Any) -> Pred:
+    if key == "category":
+        if isinstance(value, str):
+            wanted = {_norm(value)}
+        elif isinstance(value, list) and all(isinstance(v, str) for v in value):
+            wanted = {_norm(v) for v in value}
+        else:
+            raise _invalid(
+                f"category は文字列または文字列のリストである必要があります: {value!r}"
+            )
+        return lambda e: _norm(e.category) in wanted
+    if key == "memo":
+        if not isinstance(value, str):
+            raise _invalid(f"memo は文字列である必要があります: {value!r}")
+        needle = _norm(value)
+        return lambda e: needle in _norm(e.memo)
+    if key == "min_amount":
+        lo = _check_int(key, value)
+        return lambda e: e.amount >= lo
+    if key == "max_amount":
+        hi = _check_int(key, value)
+        return lambda e: e.amount <= hi
+    if key == "since":
+        start = _check_date(key, value)
+        return lambda e: e.day >= start
+    until = _check_date(key, value)
+    return lambda e: e.day <= until
+
+
+def _join(key: str, value: Any) -> Pred:
+    if key == "not":
+        inner = _compile(value)
+        return lambda e: not inner(e)
+    if not isinstance(value, list):
+        raise _invalid(f"{key} の値はリストである必要があります: {value!r}")
+    subs = [_compile(q) for q in value]
+    if key == "and":
+        return lambda e: all(p(e) for p in subs)
+    return lambda e: any(p(e) for p in subs)
+
+
+def _compile(query: Any) -> Pred:
+    if not isinstance(query, Mapping):
+        raise _invalid(f"条件は辞書である必要があります: {query!r}")
+    preds: list[Pred] = []
+    for key, value in query.items():
+        if key in _JOIN_KEYS:
+            preds.append(_join(key, value))
+        elif key in _LEAF_KEYS:
+            preds.append(_leaf(key, value))
+        else:
+            raise _invalid(f"未知のキーです: {key!r}")
+    if (
+        "min_amount" in query
+        and "max_amount" in query
+        and (query["min_amount"] > query["max_amount"])
+    ):
+        raise _invalid("min_amount が max_amount より大きいです")
+    if "since" in query and "until" in query and query["since"] > query["until"]:
+        raise _invalid("since が until より後です")
+    return lambda e: all(p(e) for p in preds)
+
+
+def search(rows: list[Expense], query: Mapping[str, Any]) -> list[Expense]:
+    """Return the rows matching ``query``, in their original order."""
+    pred = _compile(query)
+    return [e for e in rows if pred(e)]
