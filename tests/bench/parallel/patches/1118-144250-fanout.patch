+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.stats import median_by_category
+
+
+def _e(category: str, amount: int) -> Expense:
+    return Expense(date(2026, 11, 1), category, amount)
+
+
+def test_median_by_category_empty():
+    assert median_by_category([]) == {}
+
+
+def test_median_by_category_odd_count_uses_middle_value():
+    rows = [_e("food", 100), _e("food", 900), _e("food", 300)]
+    assert median_by_category(rows) == {"food": 300.0}
+
+
+def test_median_by_category_even_count_averages_middle_two():
+    rows = [_e("food", 100), _e("food", 400), _e("food", 200), _e("food", 900)]
+    assert median_by_category(rows) == {"food": 300.0}
+
+
+def test_median_by_category_keys_sorted_ascending():
+    rows = [_e("rent", 80000), _e("food", 1200), _e("book", 500), _e("food", 800)]
+    result = median_by_category(rows)
+    assert list(result) == ["book", "food", "rent"]
+    assert result == {"book": 500.0, "food": 1000.0, "rent": 80000.0}
+
+
+def test_median_by_category_returns_float_values():
+    result = median_by_category([_e("food", 1)])
+    assert isinstance(result["food"], float)
