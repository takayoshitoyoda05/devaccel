@@ -0,0 +1,15 @@
+"""Split an amount evenly among people (yen integers)."""
+
+from __future__ import annotations
+
+
+def split_evenly(amount: int, people: int) -> list[int]:
+    """Split ``amount`` yen among ``people``.
+
+    Remainder yen are added one at a time starting from the first person,
+    so the parts always sum to ``amount``.
+    """
+    if people < 1:
+        raise ValueError(f"people は 1 以上が必要です: {people}")
+    base, remainder = divmod(amount, people)
+    return [base + 1 if i < remainder else base for i in range(people)]
