@@ -0,0 +1,24 @@
+"""Duplicate detection for expense rows."""
+
+from __future__ import annotations
+
+from collections import defaultdict
+
+from kakeibo.core import Expense
+
+
+def find_duplicates(rows: list[Expense]) -> list[tuple[int, int]]:
+    """Index pairs (i, j), i < j, whose day/category/amount/memo are all equal.
+
+    Sorted by i ascending, then j ascending.
+    """
+    groups: dict[tuple[object, ...], list[int]] = defaultdict(list)
+    for idx, e in enumerate(rows):
+        groups[(e.day, e.category, e.amount, e.memo)].append(idx)
+
+    out: list[tuple[int, int]] = []
+    for idx, e in enumerate(rows):
+        for other in groups[(e.day, e.category, e.amount, e.memo)]:
+            if other > idx:
+                out.append((idx, other))
+    return out
