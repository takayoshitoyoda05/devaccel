@@ -0,0 +1,47 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.streak import longest_no_spend_streak
+
+
+def _e(d: date) -> Expense:
+    return Expense(d, "food", 100)
+
+
+def test_no_rows_whole_period_is_streak():
+    assert longest_no_spend_streak([], date(2026, 11, 1), date(2026, 11, 7)) == 7
+
+
+def test_longest_run_between_spends():
+    rows = [_e(date(2026, 11, 2)), _e(date(2026, 11, 3)), _e(date(2026, 11, 7))]
+    # 11/1 (1日), 11/4〜11/6 (3日), 11/8 以降は期間外
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 7)) == 3
+
+
+def test_run_at_end_counts():
+    rows = [_e(date(2026, 11, 1))]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 5)) == 4
+
+
+def test_multiple_spends_same_day_and_outside_range_ignored():
+    rows = [
+        _e(date(2026, 10, 30)),
+        _e(date(2026, 11, 3)),
+        _e(date(2026, 11, 3)),
+        _e(date(2026, 12, 1)),
+    ]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 5)) == 2
+
+
+def test_single_day_period():
+    assert longest_no_spend_streak([], date(2026, 11, 1), date(2026, 11, 1)) == 1
+    assert (
+        longest_no_spend_streak(
+            [_e(date(2026, 11, 1))], date(2026, 11, 1), date(2026, 11, 1)
+        )
+        == 0
+    )
+
+
+def test_start_after_end_returns_zero():
+    assert longest_no_spend_streak([], date(2026, 11, 5), date(2026, 11, 1)) == 0
diff --git a/tests/test_topn.py b/tests/test_topn.py
new file mode 100644
index 0000000..a2785a8
--- /dev/null
+++ b/tests/test_topn.py
@@ -0,0 +1,56 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.topn import top_expenses
+
+
+def _e(day: str, amount: int, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category="food", amount=amount, memo=memo
+    )
+
+
+def test_orders_by_amount_desc():
+    rows = [_e("2026-11-01", 100), _e("2026-11-02", 300), _e("2026-11-03", 200)]
+    assert [e.amount for e in top_expenses(rows, 3)] == [300, 200, 100]
+
+
+def test_takes_only_n():
+    rows = [_e("2026-11-01", 100), _e("2026-11-02", 300), _e("2026-11-03", 200)]
+    assert [e.amount for e in top_expenses(rows, 2)] == [300, 200]
+
+
+def test_ties_broken_by_earlier_date():
+    rows = [_e("2026-11-05", 500, "late"), _e("2026-11-01", 500, "early")]
+    assert [e.memo for e in top_expenses(rows, 2)] == ["early", "late"]
+
+
+def test_full_tie_keeps_input_order():
+    rows = [_e("2026-11-01", 500, "first"), _e("2026-11-01", 500, "second")]
+    assert [e.memo for e in top_expenses(rows, 2)] == ["first", "second"]
+
+
+def test_n_zero_returns_empty():
+    rows = [_e("2026-11-01", 100)]
+    assert top_expenses(rows, 0) == []
+
+
+def test_negative_n_returns_empty():
+    rows = [_e("2026-11-01", 100)]
+    assert top_expenses(rows, -3) == []
+
+
+def test_n_larger_than_rows_returns_all():
+    rows = [_e("2026-11-01", 100), _e("2026-11-02", 300)]
+    assert [e.amount for e in top_expenses(rows, 10)] == [300, 100]
+
+
+def test_empty_input():
+    assert top_expenses([], 5) == []
+
+
+def test_does_not_mutate_input():
+    rows = [_e("2026-11-01", 100), _e("2026-11-02", 300)]
+    snapshot = list(rows)
+    top_expenses(rows, 2)
+    assert rows == snapshot
