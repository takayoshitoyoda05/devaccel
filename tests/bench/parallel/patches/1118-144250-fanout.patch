@@ -0,0 +1,27 @@
+import json
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.export import to_json
+
+
+def test_to_json_keeps_order_and_keys():
+    rows = [
+        Expense(date(2026, 11, 2), "rent", 80000, "家賃"),
+        Expense(date(2026, 10, 31), "food", 500),
+    ]
+    out = to_json(rows)
+    assert out == (
+        '[{"date": "2026-11-02", "category": "rent", "amount": 80000, "memo": "家賃"},'
+        ' {"date": "2026-10-31", "category": "food", "amount": 500, "memo": ""}]'
+    )
+    assert list(json.loads(out)[0]) == ["date", "category", "amount", "memo"]
+
+
+def test_to_json_non_ascii_not_escaped():
+    out = to_json([Expense(date(2026, 1, 1), "食費", 1, "ランチ")])
+    assert "食費" in out and "\\u" not in out
+
+
+def test_to_json_empty():
+    assert to_json([]) == "[]"
