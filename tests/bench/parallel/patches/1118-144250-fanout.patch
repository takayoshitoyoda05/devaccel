@@ -0,0 +1,46 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.dupes import find_duplicates
+
+
+def test_no_rows_no_duplicates():
+    assert find_duplicates([]) == []
+
+
+def test_no_duplicates_when_any_field_differs():
+    rows = [
+        Expense(date(2026, 11, 1), "food", 1200, "lunch"),
+        Expense(date(2026, 11, 2), "food", 1200, "lunch"),  # day differs
+        Expense(date(2026, 11, 1), "rent", 1200, "lunch"),  # category differs
+        Expense(date(2026, 11, 1), "food", 1201, "lunch"),  # amount differs
+        Expense(date(2026, 11, 1), "food", 1200, "dinner"),  # memo differs
+    ]
+    assert find_duplicates(rows) == []
+
+
+def test_simple_pair():
+    e = Expense(date(2026, 11, 1), "food", 1200, "lunch")
+    assert find_duplicates([e, e]) == [(0, 1)]
+
+
+def test_pairs_ordered_by_i_then_j():
+    a = Expense(date(2026, 11, 1), "food", 500)
+    b = Expense(date(2026, 11, 2), "rent", 80000)
+    rows = [a, b, a, b, a]
+    assert find_duplicates(rows) == [(0, 2), (0, 4), (1, 3), (2, 4)]
+
+
+def test_memo_default_matches_empty_memo():
+    rows = [
+        Expense(date(2026, 11, 1), "food", 500),
+        Expense(date(2026, 11, 1), "food", 500, ""),
+    ]
+    assert find_duplicates(rows) == [(0, 1)]
+
+
+def test_pairs_only_within_same_key_group():
+    x = Expense(date(2026, 11, 1), "food", 500, "a")
+    y = Expense(date(2026, 11, 1), "food", 500, "b")
+    rows = [x, y, x, y]
+    assert find_duplicates(rows) == [(0, 2), (1, 3)]
