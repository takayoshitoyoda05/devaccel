@@ -0,0 +1,87 @@
+"""Tests for bank_import column mapping."""
+
+from __future__ import annotations
+
+import pytest
+
+from kakeibo.column_map import ColumnMap, map_columns
+
+
+@pytest.mark.parametrize(
+    ("header", "expected"),
+    [
+        pytest.param(
+            ["利用日", "ご利用店名", "利用金額"],
+            ColumnMap(
+                date=0, amount=2, withdrawal=None, deposit=None, category=None, memo=1
+            ),
+            id="E3-1",
+        ),
+        pytest.param(
+            ["取引日", "出金額", "入金額", "摘要"],
+            ColumnMap(
+                date=0, amount=None, withdrawal=1, deposit=2, category=None, memo=3
+            ),
+            id="E3-2",
+        ),
+    ],
+)
+def test_example_table(header: list[str], expected: ColumnMap) -> None:
+    assert map_columns(header) == expected
+
+
+@pytest.mark.parametrize(
+    "header",
+    [pytest.param(["摘要", "金額"], id="E3-3")],
+)
+def test_example_table_error(header: list[str]) -> None:
+    with pytest.raises(ValueError, match="日付"):
+        map_columns(header)
+
+
+def test_alias_is_nfkc_stripped_and_case_insensitive() -> None:
+    result = map_columns(["  ＤＡＴＥ ", "Amount", "Category", "DESCRIPTION"])
+    assert result == ColumnMap(
+        date=0, amount=1, withdrawal=None, deposit=None, category=2, memo=3
+    )
+
+
+def test_leftmost_column_wins_for_same_kind() -> None:
+    result = map_columns(["日付", "取引日", "金額", "利用金額", "メモ", "摘要"])
+    assert result.date == 0
+    assert result.amount == 2
+    assert result.memo == 4
+
+
+def test_unknown_columns_are_ignored() -> None:
+    result = map_columns(["foo", "日付", "bar", "金額", "baz"])
+    assert result == ColumnMap(
+        date=1, amount=3, withdrawal=None, deposit=None, category=None, memo=None
+    )
+
+
+def test_withdrawal_only_without_deposit_is_accepted() -> None:
+    result = map_columns(["日付", "出金"])
+    assert result == ColumnMap(
+        date=0, amount=None, withdrawal=1, deposit=None, category=None, memo=None
+    )
+
+
+def test_amount_takes_priority_over_withdrawal_and_deposit() -> None:
+    result = map_columns(["日付", "出金", "入金", "金額"])
+    assert result == ColumnMap(
+        date=0, amount=3, withdrawal=None, deposit=None, category=None, memo=None
+    )
+
+
+def test_missing_amount_and_withdrawal_raises() -> None:
+    with pytest.raises(ValueError, match="金額または出金"):
+        map_columns(["日付", "摘要"])
+
+
+def test_missing_all_required_lists_every_kind() -> None:
+    with pytest.raises(ValueError) as excinfo:
+        map_columns(["摘要", "カテゴリ"])
+    message = str(excinfo.value)
+    assert "日付" in message
+    assert "金額または出金" in message
