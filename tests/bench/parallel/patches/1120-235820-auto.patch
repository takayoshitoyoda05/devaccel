@@ -0,0 +1,148 @@
+"""Import bank / credit-card CSV text into Expense rows (pure functions).
+
+Decisions (see docs/design/20261120-bank-import.md):
+D1: negative amounts (-300 / △500 / (500) ...) are refunds and kept negative.
+D2: decimals and blank/dash amounts are rejected.
+D3: withdrawal/deposit columns: withdrawal only -> positive; deposit only ->
+    skipped (counted); both filled or both empty -> row error.
+D4: no category column, or an empty category cell -> "未分類"; no memo column -> "".
+D5: every error in a row is reported (date, then amount); line number is the
+    line where the record starts (header = line 1).
+D6: delimiter (comma / tab) is auto-detected; BOM and CRLF are accepted; empty
+    input or header-only input gives an empty result; missing required columns
+    give one error on the header line and no rows.
+D7: short rows are padded with empty cells; fully blank lines are skipped.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+from dataclasses import dataclass, field
+
+from kakeibo.amount_text import parse_amount
+from kakeibo.column_map import ColumnMap, map_columns
+from kakeibo.core import Expense
+from kakeibo.date_text import parse_date
+
+UNCATEGORIZED = "未分類"
+_DASHES = {"-", "—", "―"}
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str
+    value: str
+    reason: str
+
+    def __str__(self) -> str:
+        return f"{self.line}行目 列「{self.column}」 {self.value!r}: {self.reason}"
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense] = field(default_factory=list)
+    errors: list[RowError] = field(default_factory=list)
+    skipped: int = 0
+
+
+def _detect_delimiter(text: str) -> str:
+    first = next((ln for ln in text.splitlines() if ln.strip()), "")
+    return "\t" if first.count("\t") > first.count(",") else ","
+
+
+def _cell(row: list[str], idx: int | None) -> str:
+    if idx is None or idx >= len(row):
+        return ""
+    return row[idx].strip()
+
+
+def _is_blank(s: str) -> bool:
+    return s == "" or s in _DASHES
+
+
+def import_bank_csv(text: str) -> ImportResult:
+    """Parse CSV text. Never raises for bad data; problems go to `errors`."""
+    text = text.lstrip("\ufeff")
+    if not text.strip():
+        return ImportResult()
+    reader = csv.reader(
+        io.StringIO(text, newline=""), delimiter=_detect_delimiter(text)
+    )
+
+    header: list[str] | None = None
+    cm: ColumnMap | None = None
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    skipped = 0
+    prev_end = 0
+    for row in reader:
+        start = prev_end + 1
+        prev_end = reader.line_num
+        if not any(c.strip() for c in row):
+            continue
+        if header is None:
+            header = [c.strip() for c in row]
+            try:
+                cm = map_columns(header)
+            except ValueError as e:
+                errors.append(RowError(start, "(ヘッダー)", ",".join(header), str(e)))
+                return ImportResult([], errors, 0)
+            continue
+        assert cm is not None
+
+        hdr = header
+
+        def name(idx: int | None, hdr: list[str] = hdr) -> str:
+            return hdr[idx] if idx is not None and idx < len(hdr) else "?"
+
+        # Amount state first: a deposit-only row is skipped without further checks.
+        amount_value: int | None = None
+        amount_err: RowError | None = None
+        if cm.amount is not None:
+            raw = _cell(row, cm.amount)
+            try:
+                amount_value = parse_amount(raw)
+            except ValueError as e:
+                amount_err = RowError(start, name(cm.amount), raw, str(e))
+        else:
+            w = _cell(row, cm.withdrawal)
+            d = _cell(row, cm.deposit)
+            if _is_blank(w) and not _is_blank(d):
+                skipped += 1
+                continue
+            if not _is_blank(w) and not _is_blank(d):
+                amount_err = RowError(
+                    start,
+                    name(cm.withdrawal),
+                    f"{w} / {d}",
+                    "出金と入金の両方に値があります",
+                )
+            elif _is_blank(w):
+                amount_err = RowError(start, name(cm.withdrawal), w, "金額が空です")
+            else:
+                try:
+                    amount_value = parse_amount(w)
+                except ValueError as e:
+                    amount_err = RowError(start, name(cm.withdrawal), w, str(e))
+
+        raw_date = _cell(row, cm.date)
+        day = None
+        try:
+            day = parse_date(raw_date)
+        except ValueError as e:
+            errors.append(RowError(start, name(cm.date), raw_date, str(e)))
+        if amount_err is not None:
+            errors.append(amount_err)
+        if day is None or amount_value is None:
+            continue
+        expenses.append(
+            Expense(
+                day=day,
+                category=_cell(row, cm.category) or UNCATEGORIZED,
+                amount=amount_value,
+                memo=_cell(row, cm.memo),
+            )
+        )
+    return ImportResult(expenses, errors, skipped)
