+from datetime import date
+
+import pytest
+
+from kakeibo.date_text import parse_date
+
+
+# 例の表 (E2-*) は ids に ID を残す。
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("令和8年1月5日", date(2026, 1, 5)),
+    ],
+    ids=["E2-1"],
+)
+def test_spec_examples_ok(text, expected):
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026/2/30",
+        "2026-1/5",
+    ],
+    ids=["E2-2", "E2-3"],
+)
+def test_spec_examples_error(text):
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+# R1: 西暦の書き方
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026-01-05", date(2026, 1, 5)),
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026.1.5", date(2026, 1, 5)),
+        ("20260105", date(2026, 1, 5)),
+        ("2026年1月5日", date(2026, 1, 5)),
+        ("2026/01/05 13:45", date(2026, 1, 5)),
+        ("2026-01-05T13:45:00", date(2026, 1, 5)),
+        ("  2026-01-05  ", date(2026, 1, 5)),
+        ("２０２６－０１－０５", date(2026, 1, 5)),
+    ],
+)
+def test_western_forms(text, expected):
+    assert parse_date(text) == expected
+
+
+# R2: 和暦
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("R8.1.5", date(2026, 1, 5)),
+        ("r8.1.5", date(2026, 1, 5)),
+        ("令和8年1月5日", date(2026, 1, 5)),
+        ("H30.4.1", date(2018, 4, 1)),
+        ("平成30年4月1日", date(2018, 4, 1)),
+        ("令和元年5月1日", date(2019, 5, 1)),
+        ("R1.5.1", date(2019, 5, 1)),
+    ],
+)
+def test_wareki_forms(text, expected):
+    assert parse_date(text) == expected
+
+
+# R3: 拒否する値
+@pytest.mark.parametrize(
+    "text",
+    [
+        "1/5",
+        "",
+        "26-01-05",
+        "2026-13-01",
+        "令和8年2月30日",
+        "令和0年1月1日",
+        "2026年1月5",
+        "2026-01-05 abc",
+    ],
+)
+def test_rejected_values(text):
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+# R4: 例外メッセージに元の値の repr を含める
+def test_error_message_contains_original_repr():
+    with pytest.raises(ValueError) as info:
+        parse_date("２０２６/２/３０")
+    assert repr("２０２６/２/３０") in str(info.value)
