@@ -0,0 +1,82 @@
+"""Map bank/card CSV header names to column indexes."""
+
+from __future__ import annotations
+
+import unicodedata
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class ColumnMap:
+    date: int
+    amount: int | None
+    withdrawal: int | None
+    deposit: int | None
+    category: int | None
+    memo: int | None
+
+
+_ALIASES: dict[str, tuple[str, ...]] = {
+    "date": ("date", "日付", "利用日", "取引日", "ご利用日", "年月日"),
+    "amount": ("amount", "金額", "利用金額", "ご利用金額", "支払金額"),
+    "withdrawal": ("出金額", "出金", "お支払金額", "支払", "引出"),
+    "deposit": ("入金額", "入金", "お預り金額", "預入", "預り金額"),
+    "category": ("category", "カテゴリ", "分類", "費目"),
+    "memo": (
+        "memo",
+        "メモ",
+        "摘要",
+        "適用",
+        "利用店名",
+        "ご利用店名",
+        "内容",
+        "description",
+    ),
+}
+
+
+def _normalize(name: str) -> str:
+    return unicodedata.normalize("NFKC", name).strip().lower()
+
+
+_KIND_BY_ALIAS: dict[str, str] = {
+    _normalize(alias): kind for kind, aliases in _ALIASES.items() for alias in aliases
+}
+
+
+def map_columns(header: list[str]) -> ColumnMap:
+    """Return the column index for each kind; leftmost match wins (R3).
+
+    Raises ValueError if the date column or both amount/withdrawal are missing.
+    """
+    found: dict[str, int] = {}
+    for index, name in enumerate(header):
+        kind = _KIND_BY_ALIAS.get(_normalize(name))
+        if kind is not None and kind not in found:
+            found[kind] = index
+
+    missing: list[str] = []
+    if "date" not in found:
+        missing.append("日付")
+    if "amount" not in found and "withdrawal" not in found:
+        missing.append("金額または出金")
+    if missing:
+        raise ValueError(f"必須の列がありません: {', '.join(missing)}")
+
+    amount = found.get("amount")
+    if amount is not None:
+        # 金額 takes priority over 出金/入金 (R2).
+        withdrawal = None
+        deposit = None
+    else:
+        withdrawal = found.get("withdrawal")
+        deposit = found.get("deposit")
+
+    return ColumnMap(
+        date=found["date"],
+        amount=amount,
+        withdrawal=withdrawal,
+        deposit=deposit,
+        category=found.get("category"),
+        memo=found.get("memo"),
+    )
