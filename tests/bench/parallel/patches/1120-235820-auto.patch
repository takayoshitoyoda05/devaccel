@@ -0,0 +1,56 @@
+"""銀行・カード会社の日付文字列を `date` に変換する純粋関数。"""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from datetime import date
+
+# 和暦の元年を西暦に直すときの基準年(令和元年=2019、平成元年=1989)。
+_ERA_BASE = {"令和": 2018, "R": 2018, "平成": 1988, "H": 1988}
+
+_ERA = r"(?P<era>令和|平成|[RrHh])(?P<y>元|[0-9]{1,2})"
+_TIME = r"(?:[ T][0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?)?"
+
+_WAREKI_PATTERNS = (
+    re.compile(_ERA + r"年(?P<m>[0-9]{1,2})月(?P<d>[0-9]{1,2})日"),
+    re.compile(_ERA + r"\.(?P<m>[0-9]{1,2})\.(?P<d>[0-9]{1,2})"),
+)
+
+_WESTERN_PATTERNS = (
+    re.compile(
+        r"(?P<y>[0-9]{4})(?P<s>[-/.])(?P<m>[0-9]{1,2})(?P=s)(?P<d>[0-9]{1,2})" + _TIME
+    ),
+    re.compile(r"(?P<y>[0-9]{4})年(?P<m>[0-9]{1,2})月(?P<d>[0-9]{1,2})日"),
+    re.compile(r"(?P<y>[0-9]{4})(?P<m>[0-9]{2})(?P<d>[0-9]{2})"),
+)
+
+
+def _to_date(original: str, year: int, month: int, day: int) -> date:
+    try:
+        return date(year, month, day)
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {original!r}") from None
+
+
+def parse_date(text: str) -> date:
+    """日付文字列を `date` にする。時刻は捨てる。読めない・存在しない日付は ValueError。"""
+    normalized = unicodedata.normalize("NFKC", text).strip()
+
+    for pattern in _WESTERN_PATTERNS:
+        m = pattern.fullmatch(normalized)
+        if m:
+            return _to_date(text, int(m["y"]), int(m["m"]), int(m["d"]))
+
+    for pattern in _WAREKI_PATTERNS:
+        m = pattern.fullmatch(normalized)
+        if m:
+            era = m["era"]
+            key = era if len(era) > 1 else era.upper()
+            y_text = m["y"]
+            era_year = 1 if y_text == "元" else int(y_text)
+            if era_year < 1:
+                raise ValueError(f"和暦の年が不正です: {text!r}")
+            return _to_date(text, _ERA_BASE[key] + era_year, int(m["m"]), int(m["d"]))
+
+    raise ValueError(f"日付として読めません: {text!r}")
diff --git a/tests/test_amount_text.py b/tests/test_amount_text.py
new file mode 100644
index 0000000..745de2f
