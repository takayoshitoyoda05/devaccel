@@ -0,0 +1,84 @@
+from datetime import date
+
+from kakeibo.bank_import import import_bank_csv
+from kakeibo.core import Expense
+
+
+def test_single_amount_column_with_aliases():
+    text = '利用日,ご利用店名,利用金額\n2026/1/5,コンビニ,"1,200円"\n'
+    r = import_bank_csv(text)
+    assert r.errors == []
+    assert r.expenses == [Expense(date(2026, 1, 5), "未分類", 1200, "コンビニ")]
+
+
+def test_category_column_and_empty_category():
+    text = "date,category,amount,memo\n2026-01-05,food,100,a\n2026-01-06,,200,b\n"
+    r = import_bank_csv(text)
+    assert [e.category for e in r.expenses] == ["food", "未分類"]
+
+
+def test_refund_is_negative():
+    r = import_bank_csv("日付,金額\n2026-01-05,▲500\n")
+    assert r.expenses[0].amount == -500
+
+
+def test_withdrawal_deposit_columns():
+    text = "取引日,出金額,入金額,摘要\n2026-01-05,300,,ATM\n2026-01-06,,5000,給与\n"
+    r = import_bank_csv(text)
+    assert r.expenses == [Expense(date(2026, 1, 5), "未分類", 300, "ATM")]
+    assert r.skipped == 1
+    assert r.errors == []
+
+
+def test_withdrawal_and_deposit_both_or_neither_is_error():
+    text = "取引日,出金額,入金額\n2026-01-05,1,2\n2026-01-06,,\n"
+    r = import_bank_csv(text)
+    assert r.expenses == []
+    assert [e.line for e in r.errors] == [2, 3]
+
+
+def test_all_errors_in_row_reported_with_line_column_value():
+    text = "日付,金額\n2026-01-05,100\n2026/2/30,abc\n"
+    r = import_bank_csv(text)
+    assert len(r.expenses) == 1
+    assert [(e.line, e.column, e.value) for e in r.errors] == [
+        (3, "日付", "2026/2/30"),
+        (3, "金額", "abc"),
+    ]
+    assert "3行目" in str(r.errors[0])
+
+
+def test_line_number_is_record_start_with_quoted_newline():
+    text = 'date,amount,memo\n2026-01-05,100,"a\nb"\n2026-01-06,x,\n'
+    r = import_bank_csv(text)
+    assert len(r.expenses) == 1
+    assert r.expenses[0].memo == "a\nb"
+    assert [e.line for e in r.errors] == [4]
+
+
+def test_tab_delimiter_bom_crlf():
+    text = "\ufeff日付\t金額\r\n2026-01-05\t1,200\r\n"
+    r = import_bank_csv(text)
+    assert r.errors == []
+    assert r.expenses[0].amount == 1200
+
+
+def test_missing_required_columns_single_error_on_header():
+    r = import_bank_csv("摘要,金額\nx,1\n")
+    assert r.expenses == []
+    assert len(r.errors) == 1
+    assert r.errors[0].line == 1
+
+
+def test_empty_and_header_only():
+    assert import_bank_csv("").expenses == []
+    assert import_bank_csv("\n  \n").errors == []
+    r = import_bank_csv("日付,金額\n")
+    assert (r.expenses, r.errors, r.skipped) == ([], [], 0)
+
+
+def test_short_rows_blank_lines():
+    text = "日付,金額,摘要\n\n2026-01-05,100\n2026-01-06\n"
+    r = import_bank_csv(text)
+    assert [e.amount for e in r.expenses] == [100]
+    assert [(e.line, e.column) for e in r.errors] == [(4, "金額")]
