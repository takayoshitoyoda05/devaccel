+++ b/tests/test_amount_text.py
@@ -0,0 +1,27 @@
+import re
+
+import pytest
+
+from kakeibo.amount_text import parse_amount
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param("▲1,200円", -1200, id="E1-1"),
+    ],
+)
+def test_parse_amount_accepts(text, expected):
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        pytest.param("12.5", id="E1-2"),
+        pytest.param("—", id="E1-3"),
+    ],
+)
+def test_parse_amount_rejects(text):
+    with pytest.raises(ValueError, match=re.escape(repr(text))):
+        parse_amount(text)
