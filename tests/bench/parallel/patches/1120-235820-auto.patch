@@ -0,0 +1,40 @@
+"""銀行・カード会社の金額文字列を円の整数に変換する。"""
+
+import re
+import unicodedata
+
+_NEGATIVE_PREFIXES = ("-", "−", "△", "▲")
+_BODY = re.compile(r"[0-9]+(,[0-9]+)*")
+
+
+def parse_amount(text: str) -> int:
+    """金額文字列を整数の円に変換する。解釈できなければ ValueError。"""
+    s = unicodedata.normalize("NFKC", text).strip()
+
+    negative = False
+    if s[:1] in _NEGATIVE_PREFIXES:
+        negative = True
+        s = s[1:].lstrip()
+    elif len(s) >= 2 and s[0] == "(" and s[-1] == ")":
+        negative = True
+        s = s[1:-1].strip()
+    elif s.endswith("-"):
+        negative = True
+        s = s[:-1].strip()
+
+    if s.startswith("¥"):
+        s = s[1:]
+    elif s.startswith("JPY"):
+        s = s[3:]
+    s = s.strip()
+    if s.endswith("円"):
+        s = s[:-1]
+    elif s.endswith("JPY"):
+        s = s[:-3]
+    s = s.strip()
+
+    if not _BODY.fullmatch(s):
+        raise ValueError(f"金額として読めません: {text!r}")
+
+    value = int(s.replace(",", ""))
+    return -value if negative else value
