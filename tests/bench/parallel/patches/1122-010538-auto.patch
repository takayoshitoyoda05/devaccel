+++ b/tests/test_statement.py
@@ -0,0 +1,223 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.statement import (
+    ImportFormatError,
+    parse_amount,
+    parse_date,
+    parse_statement,
+)
+
+
+@pytest.mark.parametrize(
+    "raw,want",
+    [
+        ("2026-01-05", date(2026, 1, 5)),
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026.1.5", date(2026, 1, 5)),
+        ("20260105", date(2026, 1, 5)),
+        ("2026年1月5日", date(2026, 1, 5)),
+        ("２０２６／１／５", date(2026, 1, 5)),
+        ("2026/1-5", date(2026, 1, 5)),
+        ("2026-01-05 10:30", date(2026, 1, 5)),
+        ("2026-01-05T10:30:00", date(2026, 1, 5)),
+        ("令和8年1月5日", date(2026, 1, 5)),
+        ("R8.1.5", date(2026, 1, 5)),
+        ("H30/4/1", date(2018, 4, 1)),
+        ("令和元年5月1日", date(2019, 5, 1)),
+        ("2024-02-29", date(2024, 2, 29)),
+    ],
+)
+def test_parse_date_ok(raw, want):
+    assert parse_date(raw) == want
+
+
+@pytest.mark.parametrize(
+    "raw", ["2026-02-30", "2025-02-29", "2026-13-01", "", "abc", "26/1/5", "R8.2.30"]
+)
+def test_parse_date_bad(raw):
+    with pytest.raises(ValueError):
+        parse_date(raw)
+
+
+@pytest.mark.parametrize(
+    "raw,want",
+    [
+        ("1200", 1200),
+        ("1,234", 1234),
+        ("１，２３４", 1234),
+        ("¥1,234", 1234),
+        ("￥1,234", 1234),
+        ("1,234円", 1234),
+        ("JPY 1,234", 1234),
+        (" 1 234 ", 1234),
+        ("0", 0),
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("-¥300", -300),
+    ],
+)
+def test_parse_amount_ok(raw, want):
+    assert parse_amount(raw) == want
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "",
+        "-",
+        "—",
+        "12.5",
+        "12.0",
+        "abc",
+        "1,2",
+        "1,2345",
+        "--300",
+        "(-500)",
+        "△500-",
+        "nan",
+    ],
+)
+def test_parse_amount_bad(raw):
+    with pytest.raises(ValueError):
+        parse_amount(raw)
+
+
+def test_single_amount_column_with_aliases():
+    text = '利用日,ご利用店名,利用金額\n2026/11/01,コンビニ,"1,200"\n2026/11/02,スーパー,800円\n'
+    r = parse_statement(text)
+    assert r.errors == []
+    assert r.expenses == [
+        Expense(date(2026, 11, 1), "未分類", 1200, "コンビニ"),
+        Expense(date(2026, 11, 2), "未分類", 800, "スーパー"),
+    ]
+
+
+def test_header_case_space_and_fullwidth():
+    r = parse_statement(" Date , ＡＭＯＵＮＴ \n2026-11-01,5\n")
+    assert [e.amount for e in r.expenses] == [5]
+
+
+def test_category_column_and_default_for_blank():
+    text = "date,category,amount\n2026-11-01,food,5\n2026-11-02,,7\n"
+    r = parse_statement(text, category="その他")
+    assert [e.category for e in r.expenses] == ["food", "その他"]
+
+
+def test_bom_crlf_and_tab():
+    text = "﻿取引日\t摘要\t金額\r\n2026-11-01\tATM\t1000\r\n"
+    r = parse_statement(text)
+    assert r.expenses == [Expense(date(2026, 11, 1), "未分類", 1000, "ATM")]
+
+
+def test_semicolon_delimiter():
+    r = parse_statement("date;amount\n2026-11-01;5\n")
+    assert [e.amount for e in r.expenses] == [5]
+
+
+def test_withdrawal_deposit_columns():
+    text = (
+        "取引日,摘要,出金額,入金額\n"
+        '2026/11/01,家賃,"80,000",\n'
+        "2026/11/02,給与,,300000\n"
+        "2026/11/03,返金,0,500\n"
+        "2026/11/04,手数料,110,-\n"
+    )
+    r = parse_statement(text)
+    assert r.errors == []
+    assert [e.amount for e in r.expenses] == [80000, 110]
+    assert r.skipped == [3, 4]
+
+
+def test_withdrawal_deposit_errors():
+    text = "日付,出金,入金\n2026-11-01,,\n2026-11-02,100,200\n2026-11-03,x,\n"
+    r = parse_statement(text)
+    assert r.expenses == []
+    assert [(e.line, e.column) for e in r.errors] == [
+        (2, "amount"),
+        (3, "amount"),
+        (4, "withdrawal"),
+    ]
+
+
+def test_negative_is_refund_and_zero_kept():
+    r = parse_statement("date,amount\n2026-11-01,△500\n2026-11-02,0\n")
+    assert [e.amount for e in r.expenses] == [-500, 0]
+
+
+def test_errors_report_line_column_value_all_columns():
+    text = "date,amount,memo\n2026-11-01,100,ok\n2026-02-30,12.5,x\n2026-11-03,abc,y\n"
+    r = parse_statement(text)
+    assert len(r.expenses) == 1  # good rows still imported
+    got = [(e.line, e.column, e.value) for e in r.errors]
+    assert got == [
+        (3, "date", "2026-02-30"),
+        (3, "amount", "12.5"),
+        (4, "amount", "abc"),
+    ]
+    assert "3行目 date" in str(r.errors[0])
+
+
+def test_unquoted_comma_amount_is_column_count_error():
+    text = "date,amount,memo\n2026-11-01,1,234円,shop\n"
+    r = parse_statement(text)
+    assert r.expenses == []
+    assert [(e.line, e.column) for e in r.errors] == [(2, "row")]
+    short = parse_statement("date,amount,memo\n2026-11-01,5\n")
+    assert [(e.line, e.column) for e in short.errors] == [(2, "row")]
+
+
+def test_line_number_is_record_start_with_quoted_newline():
+    text = 'date,amount,memo\n2026-11-01,100,"a\nb"\n2026-11-02,bad,z\n'
+    r = parse_statement(text)
+    assert len(r.expenses) == 1
+    assert r.expenses[0].memo == "a\nb"
+    assert [e.line for e in r.errors] == [4]
+    text2 = 'date,amount,memo\n2026-11-01,bad,"a\nb"\n'
+    assert parse_statement(text2).errors[0].line == 2
+
+
+def test_blank_lines_ignored_but_counted():
+    r = parse_statement("date,amount\n\n2026-11-01,x\n,\n")
+    assert [e.line for e in r.errors] == [3]
+
+
+@pytest.mark.parametrize("text", ["", "\n\n", "﻿", "date,amount\n"])
+def test_empty_and_header_only(text):
+    r = parse_statement(text)
+    assert (r.expenses, r.errors, r.skipped) == ([], [], [])
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "amount,memo\n5,x\n",
+        "date,memo\n2026-11-01,x\n",
+        "date,amount,金額\n2026-11-01,1,2\n",
+        "date,amount,出金\n2026-11-01,1,2\n",
+        "date,金額,利用金額\n2026-11-01,1,2\n",
+    ],
+)
+def test_bad_header_raises(text):
+    with pytest.raises(ImportFormatError):
+        parse_statement(text)
+
+
+@pytest.mark.parametrize("bad", [None, b"date,amount\n", 123])
+def test_text_type(bad):
+    with pytest.raises(TypeError):
+        parse_statement(bad)
+
+
+@pytest.mark.parametrize(
+    "cat,exc", [("", ValueError), ("  ", ValueError), (None, TypeError)]
+)
+def test_category_arg(cat, exc):
+    with pytest.raises(exc):
+        parse_statement("date,amount\n", category=cat)
