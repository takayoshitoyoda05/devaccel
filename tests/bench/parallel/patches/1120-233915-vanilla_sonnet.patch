@@ -0,0 +1,101 @@
+"""Detect monthly recurring expenses (rent, subscriptions) and predict the next one."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date, timedelta
+from statistics import median
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class RecurringExpense:
+    category: str
+    memo: str
+    amount: int  # typical (median) yen
+    occurrences: int  # length of the consecutive monthly run
+    typical_day: int  # day of month it usually lands on
+    last_date: date
+    next_date: date
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month - 1
+
+
+def _date_in_month(index: int, day: int) -> date:
+    year, month = divmod(index, 12)
+    month += 1
+    return date(year, month, min(day, calendar.monthrange(year, month)[1]))
+
+
+def _trailing_run(rows: list[Expense]) -> list[Expense] | None:
+    """Latest run of one-per-month, consecutive-month rows (rows sorted by date).
+
+    Returns None if the latest month has more than one entry.
+    """
+    run = [rows[-1]]
+    for e in reversed(rows[:-1]):
+        gap = _month_index(run[0].day) - _month_index(e.day)
+        if gap == 1:
+            run.insert(0, e)
+        else:
+            # gap 0 (same month twice) or a skipped month ends the run
+            if gap == 0 and len(run) == 1:
+                return None
+            break
+    return run
+
+
+def find_recurring(
+    rows: list[Expense],
+    *,
+    min_occurrences: int = 3,
+    amount_tolerance: float = 0.1,
+    day_tolerance: int = 5,
+    today: date | None = None,
+    grace_days: int = 10,
+) -> list[RecurringExpense]:
+    """Find monthly recurring expenses, sorted by next_date then category.
+
+    Expenses are grouped by (category, memo); a group counts as recurring when its
+    most recent entries fall in at least `min_occurrences` consecutive months, one per
+    month, with amounts within `amount_tolerance` of the median and days of month
+    within `day_tolerance` of each other. If `today` is given, items whose predicted
+    next date is more than `grace_days` in the past (cancelled?) are dropped.
+    """
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.memo.strip().casefold()), []).append(e)
+
+    out: list[RecurringExpense] = []
+    for (category, _), items in groups.items():
+        items = sorted(items, key=lambda e: e.day)
+        run = _trailing_run(items)
+        if run is None or len(run) < min_occurrences:
+            continue
+        amt = median(e.amount for e in run)
+        if any(abs(e.amount - amt) > amt * amount_tolerance for e in run):
+            continue
+        days = [e.day.day for e in run]
+        if max(days) - min(days) > day_tolerance:
+            continue
+        typical_day = round(median(days))
+        last = run[-1].day
+        nxt = _date_in_month(_month_index(last) + 1, typical_day)
+        if today is not None and nxt < today - timedelta(days=grace_days):
+            continue
+        out.append(
+            RecurringExpense(
+                category=category,
+                memo=run[-1].memo.strip(),
+                amount=round(amt),
+                occurrences=len(run),
+                typical_day=typical_day,
+                last_date=last,
+                next_date=nxt,
+            )
+        )
+    return sorted(out, key=lambda r: (r.next_date, r.category, r.memo))
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..7dd5a9f
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,103 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.recurring import find_recurring
+
+
+def E(d, cat="rent", amt=80000, memo=""):
+    return Expense(date.fromisoformat(d), cat, amt, memo)
+
+
+RENT = [E("2026-08-02"), E("2026-09-02"), E("2026-10-02")]
+
+
+def test_basic_detection_and_next_date():
+    (r,) = find_recurring(RENT)
+    assert (r.category, r.amount, r.occurrences, r.typical_day) == ("rent", 80000, 3, 2)
+    assert r.last_date == date(2026, 10, 2)
+    assert r.next_date == date(2026, 11, 2)
+
+
+def test_too_few_occurrences():
+    assert find_recurring(RENT[:2]) == []
+    assert len(find_recurring(RENT[:2], min_occurrences=2)) == 1
+
+
+def test_month_end_clamped_and_year_rollover():
+    rows = [
+        E("2026-10-31", "net", 3000),
+        E("2026-11-30", "net", 3000),
+        E("2026-12-31", "net", 3000),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.next_date == date(2027, 1, 31)
+    rows = [
+        E("2026-11-30", "net", 3000),
+        E("2026-12-31", "net", 3000),
+        E("2027-01-31", "net", 3000),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.next_date == date(2027, 2, 28)
+
+
+def test_unstable_amount_rejected():
+    rows = [
+        E("2026-08-05", "food", 1000),
+        E("2026-09-05", "food", 5000),
+        E("2026-10-05", "food", 900),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_unstable_day_rejected():
+    rows = [
+        E("2026-08-01", "x", 500),
+        E("2026-09-15", "x", 500),
+        E("2026-10-28", "x", 500),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_small_amount_change_within_tolerance():
+    rows = [
+        E("2026-08-05", "sub", 1000),
+        E("2026-09-05", "sub", 1050),
+        E("2026-10-06", "sub", 1000),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.amount == 1000
+
+
+def test_skipped_month_breaks_run():
+    rows = [E("2026-06-02"), E("2026-08-02"), E("2026-09-02"), E("2026-10-02")]
+    assert len(find_recurring(rows)) == 1
+    rows = [E("2026-06-02"), E("2026-07-02"), E("2026-09-02"), E("2026-10-02")]
+    assert find_recurring(rows) == []
+
+
+def test_two_in_same_month_rejected():
+    assert find_recurring(RENT + [E("2026-10-20")]) == []
+
+
+def test_groups_by_memo_case_insensitive():
+    rows = [
+        E("2026-08-10", "ent", 1490, "Netflix"),
+        E("2026-09-10", "ent", 1490, "netflix "),
+        E("2026-10-10", "ent", 1490, "NETFLIX"),
+        E("2026-08-12", "ent", 980, "music"),
+        E("2026-09-12", "ent", 980, "music"),
+        E("2026-10-12", "ent", 980, "music"),
+    ]
+    res = find_recurring(rows)
+    assert [r.memo for r in res] == ["NETFLIX", "music"]  # sorted by next_date
+
+
+def test_today_drops_stale():
+    assert find_recurring(RENT, today=date(2026, 11, 5)) != []
+    assert find_recurring(RENT, today=date(2026, 12, 20)) == []
+
+
+def test_empty_and_unsorted_input():
+    assert find_recurring([]) == []
+    (r,) = find_recurring(list(reversed(RENT)))
+    assert r.next_date == date(2026, 11, 2)
