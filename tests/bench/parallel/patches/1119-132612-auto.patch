@@ -0,0 +1,167 @@
+"""Import a bank statement CSV (as text) into Expense records. Pure functions only."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from collections.abc import Callable
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+UNCATEGORIZED = "未分類"
+
+_DATE_COLS = ("date", "日付", "利用日", "取引日", "ご利用日")
+_WITHDRAW_COLS = ("amount", "金額", "利用金額", "ご利用金額", "出金額")
+_DEPOSIT_COLS = ("入金額", "預入額", "預入")
+_MEMO_COLS = ("memo", "摘要", "メモ", "利用店名", "ご利用店名", "description")
+_CATEGORY_COLS = ("category", "カテゴリ", "分類")
+
+_TIME_SUFFIX = r"(?:\s+[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?)?"
+_DATE_PATTERNS = (
+    re.compile(r"([0-9]{4})[-/.]([0-9]{1,2})[-/.]([0-9]{1,2})" + _TIME_SUFFIX),
+    re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日" + _TIME_SUFFIX),
+    re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})" + _TIME_SUFFIX),
+)
+_AMOUNT_NOISE = re.compile(r"[,\s]|JPY|円|¥|￥", re.IGNORECASE)
+_AMOUNT_BODY = re.compile(r"[0-9]+(?:\.0+)?")
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str
+    value: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+    skipped: int
+
+
+def _parse_date(raw: str) -> date:
+    s = unicodedata.normalize("NFKC", raw).strip()
+    for pat in _DATE_PATTERNS:
+        m = pat.fullmatch(s)
+        if m:
+            year, month, day = (int(g) for g in m.groups())
+            try:
+                return date(year, month, day)
+            except ValueError:
+                raise ValueError("存在しない日付です") from None
+    raise ValueError("日付として解釈できません")
+
+
+def _parse_amount(raw: str) -> int:
+    s = _AMOUNT_NOISE.sub("", unicodedata.normalize("NFKC", raw))
+    if s in ("", "-", "—"):
+        return 0
+    neg = False
+    if s.startswith(("-", "−", "△", "▲")):
+        neg, s = True, s[1:]
+    elif s.endswith("-"):
+        neg, s = True, s[:-1]
+    elif s.startswith("(") and s.endswith(")"):
+        neg, s = True, s[1:-1]
+    if not _AMOUNT_BODY.fullmatch(s):
+        raise ValueError("金額として解釈できません")
+    value = int(s.split(".")[0])
+    return -value if neg else value
+
+
+def _find(names: list[str], aliases: tuple[str, ...]) -> int | None:
+    for alias in aliases:
+        key = alias.lower()
+        if key in names:
+            return names.index(key)
+    return None
+
+
+def _detect_delimiter(text: str) -> str:
+    header = next((ln for ln in text.splitlines() if ln.strip()), "")
+    return "\t" if header.count("\t") > header.count(",") else ","
+
+
+def _cell(row: list[str], idx: int | None) -> str | None:
+    if idx is None or idx >= len(row):
+        return None
+    return row[idx]
+
+
+def _read[T](
+    line: int,
+    row: list[str],
+    idx: int,
+    label: str,
+    parse: Callable[[str], T],
+    errs: list[RowError],
+) -> T | None:
+    raw = _cell(row, idx)
+    if raw is None:
+        errs.append(RowError(line, label, "", "列が足りません"))
+        return None
+    try:
+        return parse(raw)
+    except ValueError as e:
+        errs.append(RowError(line, label, raw, str(e)))
+        return None
+
+
+def import_bank_csv(text: str) -> ImportResult:
+    text = text.removeprefix("﻿")
+    reader = csv.reader(
+        io.StringIO(text, newline=""), delimiter=_detect_delimiter(text)
+    )
+
+    # (開始行, 行) のレコード列。空行は捨てる。
+    records: list[tuple[int, list[str]]] = []
+    prev_line = 0
+    for row in reader:
+        start = prev_line + 1
+        prev_line = reader.line_num
+        if all(not c.strip() for c in row):
+            continue
+        records.append((start, row))
+
+    if not records:
+        return ImportResult([], [], 0)
+
+    _, header = records[0]
+    names = [c.strip().lower() for c in header]
+    date_i = _find(names, _DATE_COLS)
+    withdraw_i = _find(names, _WITHDRAW_COLS)
+    if date_i is None:
+        raise ValueError("日付列が見つかりません")
+    if withdraw_i is None:
+        raise ValueError("金額列が見つかりません")
+    deposit_i = _find(names, _DEPOSIT_COLS)
+    memo_i = _find(names, _MEMO_COLS)
+    category_i = _find(names, _CATEGORY_COLS)
+
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    skipped = 0
+    for line, row in records[1:]:
+        row_errors: list[RowError] = []
+        day = _read(line, row, date_i, "日付", _parse_date, row_errors)
+        amount = _read(line, row, withdraw_i, "金額", _parse_amount, row_errors)
+        if deposit_i is not None:
+            _read(line, row, deposit_i, "入金額", _parse_amount, row_errors)
+        if row_errors or day is None or amount is None:
+            errors.extend(row_errors)
+            continue
+
+        memo = (_cell(row, memo_i) or "").strip()
+        category = (_cell(row, category_i) or "").strip() or UNCATEGORIZED
+        if amount == 0 or (deposit_i is not None and amount < 0):
+            skipped += 1
+            continue
+        expenses.append(Expense(day=day, category=category, amount=amount, memo=memo))
+
+    return ImportResult(expenses, errors, skipped)
