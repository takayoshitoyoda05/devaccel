@@ -0,0 +1,88 @@
+"""Month-over-month comparison of expenses by category (pure functions)."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class CategoryDiff:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    ratio: float | None
+    trend: str  # "増" / "減" / "変化なし"
+
+
+def _previous_month(year: int, month: int) -> tuple[int, int]:
+    if month == 1:
+        return year - 1, 12
+    return year, month - 1
+
+
+def _totals_for(expenses: list[Expense], year: int, month: int) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for e in expenses:
+        if e.day.year == year and e.day.month == month:
+            out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def compare_months(
+    expenses: list[Expense], year: int, month: int
+) -> list[CategoryDiff]:
+    """Compare (year, month) against the previous month, per category.
+
+    Sorted by |delta| descending, then category ascending.
+    """
+    if not 1 <= month <= 12:
+        raise ValueError(f"month must be 1..12: {month}")
+    prev_year, prev_month = _previous_month(year, month)
+    current = _totals_for(expenses, year, month)
+    previous = _totals_for(expenses, prev_year, prev_month)
+
+    diffs: list[CategoryDiff] = []
+    for category in set(current) | set(previous):
+        prev_amount = previous.get(category, 0)
+        cur_amount = current.get(category, 0)
+        delta = cur_amount - prev_amount
+        ratio = delta / prev_amount if prev_amount != 0 else None
+        if delta > 0:
+            trend = "増"
+        elif delta < 0:
+            trend = "減"
+        else:
+            trend = "変化なし"
+        diffs.append(
+            CategoryDiff(
+                category=category,
+                previous=prev_amount,
+                current=cur_amount,
+                delta=delta,
+                ratio=ratio,
+                trend=trend,
+            )
+        )
+    diffs.sort(key=lambda d: (-abs(d.delta), d.category))
+    return diffs
+
+
+def format_report(diffs: list[CategoryDiff]) -> str:
+    """One line per category: `カテゴリ: 前月 → 当月 (+1,234円, +12.3%)`."""
+    if not diffs:
+        return "差分なし"
+    lines: list[str] = []
+    for d in diffs:
+        if d.ratio is not None:
+            pct = f"{d.ratio * 100:+.1f}%"
+        elif d.previous == 0 and d.current > 0:
+            pct = "新規"
+        else:
+            pct = "—"
+        lines.append(
+            f"{d.category}: {d.previous} → {d.current} ({d.delta:+,}円, {pct})"
+        )
+    return "\n".join(lines)
