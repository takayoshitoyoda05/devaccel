@@ -0,0 +1,180 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    Cond,
+    all_of,
+    amount_between,
+    any_of,
+    category,
+    date_between,
+    memo_contains,
+    not_,
+    search,
+)
+
+ROWS = [
+    Expense(date(2026, 1, 5), "食費", 100, "netflix"),
+    Expense(date(2026, 2, 10), "日用品", 2500, "Amazon"),
+    Expense(date(2026, 2, 20), "食費", 800, ""),
+    Expense(date(2026, 3, 1), "交通費", 100, "定期"),
+]
+
+
+def _ids(rows: list[Expense]) -> list[tuple[date, int]]:
+    return [(e.day, e.amount) for e in rows]
+
+
+# 例の表 E3-1..E3-3 と、仕様の端のケース(R1〜R3)
+@pytest.mark.parametrize(
+    ("cond", "expected_idx"),
+    [
+        pytest.param(amount_between(100, 100), [0, 3], id="E3-1"),
+        pytest.param(all_of(), [0, 1, 2, 3], id="E3-2"),
+        pytest.param(memo_contains("ＮＥＴ"), [0], id="E3-3"),
+    ],
+)
+def test_examples_from_spec(cond: Cond, expected_idx: list[int]) -> None:
+    assert search(ROWS, cond) == [ROWS[i] for i in expected_idx]
+
+
+# R1: category は完全一致・前後空白除去・複数名は OR
+@pytest.mark.parametrize(
+    ("cond", "expected_idx"),
+    [
+        pytest.param(category("食費"), [0, 2], id="R1-exact"),
+        pytest.param(category("食"), [], id="R1-no-partial"),
+        pytest.param(category("  食費  "), [0, 2], id="R1-strip-arg"),
+        pytest.param(category("食費", "交通費"), [0, 2, 3], id="R1-or"),
+        pytest.param(category("娯楽"), [], id="R1-no-match"),
+    ],
+)
+def test_category(cond: Cond, expected_idx: list[int]) -> None:
+    assert search(ROWS, cond) == [ROWS[i] for i in expected_idx]
+
+
+def test_category_without_args_raises() -> None:
+    with pytest.raises(ValueError):
+        category()
+
+
+# R1: amount_between は両端含む・None は無制限
+@pytest.mark.parametrize(
+    ("lo", "hi", "expected_idx"),
+    [
+        pytest.param(100, 800, [0, 2, 3], id="R1-amount-inclusive"),
+        pytest.param(None, 100, [0, 3], id="R1-amount-lo-none"),
+        pytest.param(800, None, [1, 2], id="R1-amount-hi-none"),
+        pytest.param(None, None, [0, 1, 2, 3], id="R1-amount-both-none"),
+        pytest.param(101, 799, [], id="R1-amount-empty-range"),
+    ],
+)
+def test_amount_between(
+    lo: int | None, hi: int | None, expected_idx: list[int]
+) -> None:
+    assert search(ROWS, amount_between(lo, hi)) == [ROWS[i] for i in expected_idx]
+
+
+def test_amount_between_lo_greater_than_hi_raises() -> None:
+    with pytest.raises(ValueError):
+        amount_between(200, 100)
+
+
+# R1: date_between は両端含む・None は無制限
+@pytest.mark.parametrize(
+    ("start", "end", "expected_idx"),
+    [
+        pytest.param(
+            date(2026, 2, 10), date(2026, 2, 20), [1, 2], id="R1-date-inclusive"
+        ),
+        pytest.param(None, date(2026, 2, 10), [0, 1], id="R1-date-start-none"),
+        pytest.param(date(2026, 3, 1), None, [3], id="R1-date-end-none"),
+        pytest.param(None, None, [0, 1, 2, 3], id="R1-date-both-none"),
+        pytest.param(
+            date(2026, 2, 11), date(2026, 2, 19), [], id="R1-date-empty-range"
+        ),
+    ],
+)
+def test_date_between(
+    start: date | None, end: date | None, expected_idx: list[int]
+) -> None:
+    assert search(ROWS, date_between(start, end)) == [ROWS[i] for i in expected_idx]
+
+
+def test_date_between_start_greater_than_end_raises() -> None:
+    with pytest.raises(ValueError):
+        date_between(date(2026, 2, 2), date(2026, 2, 1))
+
+
+# R2: memo_contains は D6 (NFKC + 小文字化の部分一致)、空文字は常に真
+@pytest.mark.parametrize(
+    ("text", "expected_idx"),
+    [
+        pytest.param("netflix", [0], id="R2-lower"),
+        pytest.param("NETFLIX", [0], id="R2-upper-query"),
+        pytest.param("amazon", [1], id="R2-memo-upper"),
+        pytest.param("ｎｅｔ", [0], id="R2-fullwidth-query"),
+        pytest.param("", [0, 1, 2, 3], id="R2-empty-always-true"),
+        pytest.param("zzz", [], id="R2-no-match"),
+    ],
+)
+def test_memo_contains(text: str, expected_idx: list[int]) -> None:
+    assert search(ROWS, memo_contains(text)) == [ROWS[i] for i in expected_idx]
+
+
+# R2: all_of() は真、any_of() は偽、入れ子・not_ は自由
+def test_any_of_empty_is_false() -> None:
+    assert search(ROWS, any_of()) == []
+
+
+def test_all_of_empty_is_true() -> None:
+    assert search(ROWS, all_of()) == ROWS
+
+
+def test_nested_and_or_not() -> None:
+    cond = all_of(
+        any_of(category("食費"), category("交通費")),
+        not_(amount_between(800, None)),
+    )
+    assert search(ROWS, cond) == [ROWS[0], ROWS[3]]
+
+
+def test_not_negates_single_condition() -> None:
+    assert search(ROWS, not_(category("食費"))) == [ROWS[1], ROWS[3]]
+
+
+# R3: 入力順を保ち、新しいリストを返し、入力を変更しない
+def test_preserves_order_and_returns_new_list() -> None:
+    rows = list(ROWS)
+    snapshot = list(rows)
+    result = search(rows, category("食費", "交通費"))
+    assert result == [rows[0], rows[2], rows[3]]
+    assert result is not rows
+    assert rows == snapshot
+
+
+# R3: Cond 以外は TypeError
+@pytest.mark.parametrize(
+    "bad",
+    [
+        pytest.param("食費", id="R3-str"),
+        pytest.param(None, id="R3-none"),
+        pytest.param(100, id="R3-int"),
+    ],
+)
+def test_non_cond_raises_type_error(bad: object) -> None:
+    with pytest.raises(TypeError):
+        search(ROWS, bad)  # type: ignore[arg-type]
+
+
+def test_non_cond_inside_combinators_raises_type_error() -> None:
+    with pytest.raises(TypeError):
+        all_of("食費")  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        any_of(None)  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        not_("食費")  # type: ignore[arg-type]
