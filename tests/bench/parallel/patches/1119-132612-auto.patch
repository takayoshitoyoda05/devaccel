+++ b/tests/test_monthly_diff.py
@@ -0,0 +1,163 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthly_diff import CategoryDiff, compare_months, format_report
+
+
+def _e(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+def _by_cat(diffs: list[CategoryDiff]) -> dict[str, CategoryDiff]:
+    return {d.category: d for d in diffs}
+
+
+# E4-1: 2026-01 の食費 3000、2025-12 の食費 2000
+def test_E4_1_increase_computes_delta_ratio_and_trend() -> None:
+    expenses = [_e("2025-12-10", "食費", 2000), _e("2026-01-10", "食費", 3000)]
+    d = _by_cat(compare_months(expenses, 2026, 1))["食費"]
+    assert d.previous == 2000
+    assert d.current == 3000
+    assert d.delta == 1000
+    assert d.ratio == pytest.approx(0.5)
+    assert d.trend == "増"
+
+
+# E4-2: 前月だけにある交通費 500
+def test_E4_2_category_only_in_previous_month_counts_as_zero_current() -> None:
+    expenses = [_e("2025-12-01", "交通費", 500)]
+    d = _by_cat(compare_months(expenses, 2026, 1))["交通費"]
+    assert d.current == 0
+    assert d.delta == -500
+    assert d.trend == "減"
+
+
+# E4-3: 前月 0・当月 800 の新カテゴリ
+def test_E4_3_new_category_has_none_ratio_and_shinki_in_report() -> None:
+    expenses = [_e("2026-01-05", "娯楽", 800)]
+    diffs = compare_months(expenses, 2026, 1)
+    d = _by_cat(diffs)["娯楽"]
+    assert d.previous == 0
+    assert d.ratio is None
+    assert d.delta == 800
+    assert "新規" in format_report(diffs)
+
+
+# --- 追加の端のケース(仕様の文面から) ---
+
+
+def test_december_previous_month_wraps_to_prior_year() -> None:
+    expenses = [_e("2025-11-01", "食費", 100), _e("2025-12-01", "食費", 300)]
+    d = _by_cat(compare_months(expenses, 2025, 12))["食費"]
+    assert d.previous == 100
+    assert d.current == 300
+
+
+def test_january_previous_month_is_prior_december_not_same_year() -> None:
+    expenses = [_e("2025-12-01", "食費", 700), _e("2026-01-01", "食費", 700)]
+    d = _by_cat(compare_months(expenses, 2026, 1))["食費"]
+    assert d.previous == 700
+    assert d.delta == 0
+
+
+def test_other_months_are_ignored() -> None:
+    expenses = [
+        _e("2025-10-01", "食費", 9999),
+        _e("2026-02-01", "食費", 9999),
+        _e("2026-01-01", "食費", 100),
+    ]
+    d = _by_cat(compare_months(expenses, 2026, 1))["食費"]
+    assert d.previous == 0
+    assert d.current == 100
+
+
+def test_refund_is_subtracted_from_month_total() -> None:
+    expenses = [
+        _e("2026-01-01", "食費", 1000),
+        _e("2026-01-02", "食費", -300),
+    ]
+    d = _by_cat(compare_months(expenses, 2026, 1))["食費"]
+    assert d.current == 700
+
+
+@pytest.mark.parametrize(
+    ("delta", "trend"),
+    [(1, "増"), (-1, "減"), (0, "変化なし")],
+)
+def test_trend_follows_sign_of_delta(delta: int, trend: str) -> None:
+    previous = 1000
+    expenses = [
+        _e("2025-12-01", "食費", previous),
+        _e("2026-01-01", "食費", previous + delta),
+    ]
+    d = _by_cat(compare_months(expenses, 2026, 1))["食費"]
+    assert d.trend == trend
+
+
+def test_format_report_uses_dash_not_shinki_when_both_zero() -> None:
+    d = CategoryDiff(
+        "食費", previous=0, current=0, delta=0, ratio=None, trend="変化なし"
+    )
+    report = format_report([d])
+    assert "—" in report
+    assert "新規" not in report
+
+
+@pytest.mark.parametrize("month", [0, 13, -1])
+def test_invalid_month_raises_value_error(month: int) -> None:
+    with pytest.raises(ValueError):
+        compare_months([], 2026, month)
+
+
+def test_both_months_empty_returns_empty_list() -> None:
+    assert compare_months([], 2026, 1) == []
+
+
+def test_sorted_by_abs_delta_desc_then_category_asc() -> None:
+    expenses = [
+        _e("2025-12-01", "A", 1000),
+        _e("2026-01-01", "A", 1000),  # delta 0
+        _e("2025-12-01", "B", 0),
+        _e("2026-01-01", "B", 500),  # delta 500
+        _e("2025-12-01", "C", 2000),
+        _e("2026-01-01", "C", 0),  # delta -2000
+        _e("2025-12-01", "D", 500),
+        _e("2026-01-01", "D", 0),  # delta -500
+    ]
+    names = [d.category for d in compare_months(expenses, 2026, 1)]
+    assert names == ["C", "B", "D", "A"]
+
+
+def test_ties_on_abs_delta_are_ordered_by_category() -> None:
+    expenses = [
+        _e("2026-01-01", "Z", 300),
+        _e("2026-01-01", "Y", 300),
+    ]
+    names = [d.category for d in compare_months(expenses, 2026, 1)]
+    assert names == ["Y", "Z"]
+
+
+def test_ratio_present_when_previous_nonzero() -> None:
+    expenses = [_e("2025-12-01", "食費", 400), _e("2026-01-01", "食費", 100)]
+    d = _by_cat(compare_months(expenses, 2026, 1))["食費"]
+    assert d.ratio == pytest.approx(-0.75)
+
+
+def test_format_report_line_shape_with_percent() -> None:
+    d = CategoryDiff(
+        "食費", previous=2000, current=3000, delta=1000, ratio=0.5, trend="増"
+    )
+    assert format_report([d]) == "食費: 2000 → 3000 (+1,000円, +50.0%)"
+
+
+def test_format_report_shinki_line_shape_when_previous_zero() -> None:
+    d = CategoryDiff("娯楽", previous=0, current=800, delta=800, ratio=None, trend="増")
+    assert format_report([d]) == "娯楽: 0 → 800 (+800円, 新規)"
+
+
+def test_format_report_empty_says_no_difference() -> None:
+    assert format_report([]) == "差分なし"
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..6631fdb
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,239 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, next_due
+
+
+def ex(day: str, category: str, amount: int, memo: str) -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+# --- 表の例 (E2-*) ---
+
+
+def test_E2_1_rent_on_month_end_gives_day_31_and_next_due_april_30() -> None:
+    # E2-1: 家賃 1/31・2/28・3/31 の 3 件 -> day=31, next_due = 2026-04-30 (R4)
+    rows = [
+        ex("2026-01-31", "住居", 80000, "家賃"),
+        ex("2026-02-28", "住居", 80000, "家賃"),
+        ex("2026-03-31", "住居", 80000, "家賃"),
+    ]
+    [r] = find_recurring(rows)
+    assert r.day == 31
+    assert next_due(r) == date(2026, 4, 30)
+
+
+@pytest.mark.parametrize(
+    ("case_id", "rows", "expected_series"),
+    [
+        (
+            "E2-2",
+            [
+                ex("2026-01-05", "通信", 5000, "水道"),
+                ex("2026-02-05", "通信", 5000, "水道"),
+                ex("2026-03-05", "通信", 5000, "水道"),
+                ex("2026-01-20", "通信", 5000, "電気"),
+                ex("2026-02-20", "通信", 5000, "電気"),
+                ex("2026-03-20", "通信", 5000, "電気"),
+            ],
+            2,
+        ),
+        (
+            "E2-3",
+            [
+                ex("2026-01-10", "娯楽", 1000, "動画"),
+                ex("2026-02-10", "娯楽", 1000, "動画"),
+                ex("2026-04-10", "娯楽", 1000, "動画"),
+            ],
+            1,
+        ),
+    ],
+    ids=["E2-2", "E2-3"],
+)
+def test_table_examples(
+    case_id: str, rows: list[Expense], expected_series: int
+) -> None:
+    result = find_recurring(rows)
+    assert len(result) == expected_series, case_id
+
+
+# --- 端のケース ---
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+def test_min_months_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_months=1)
+
+
+def test_min_months_default_is_three() -> None:
+    rows = [
+        ex("2026-01-01", "a", 100, "x"),
+        ex("2026-02-01", "a", 100, "x"),
+    ]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_months=2)) == 1
+
+
+def test_non_positive_amounts_are_excluded() -> None:
+    rows = [
+        ex("2026-01-01", "a", 100, "x"),
+        ex("2026-02-01", "a", 100, "x"),
+        ex("2026-03-01", "a", -100, "x"),  # 返金は除外
+        ex("2026-04-01", "a", 0, "x"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_memo_normalization_merges_series() -> None:
+    # D3: NFKC・小文字・空白除去・末尾の数字/#数字/(数字) 除去
+    rows = [
+        ex("2026-01-01", "a", 100, "Netflix"),
+        ex("2026-02-01", "a", 100, "ｎｅｔｆｌｉｘ 2"),
+        ex("2026-03-01", "a", 100, "NETFLIX (3)"),
+    ]
+    [r] = find_recurring(rows)
+    assert r.memo == "Netflix"  # 系列で最初に現れた元のメモ
+    assert r.months == ((2026, 1), (2026, 2), (2026, 3))
+
+
+def test_different_category_is_different_series() -> None:
+    rows = [
+        ex("2026-01-01", "a", 100, "x"),
+        ex("2026-02-01", "b", 100, "x"),
+        ex("2026-03-01", "a", 100, "x"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_amount_variation_within_1_5x_is_same_series_and_amount_is_latest() -> None:
+    rows = [
+        ex("2026-01-01", "a", 100, "x"),
+        ex("2026-02-01", "a", 120, "x"),
+        ex("2026-03-01", "a", 150, "x"),  # 150 <= 100 * 1.5
+    ]
+    [r] = find_recurring(rows)
+    assert r.amount == 150
+
+
+def test_amount_range_over_1_5x_drops_whole_series() -> None:
+    rows = [
+        ex("2026-01-01", "a", 100, "x"),
+        ex("2026-02-01", "a", 100, "x"),
+        ex("2026-03-01", "a", 151, "x"),  # 151 > 100 * 1.5
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_same_month_counts_once_using_earliest_row() -> None:
+    rows = [
+        ex("2026-01-03", "a", 100, "x"),
+        ex("2026-01-25", "a", 100, "x"),
+        ex("2026-02-03", "a", 100, "x"),
+    ]
+    # 2 か月しかないので min_months=3 では不採用
+    assert find_recurring(rows) == []
+    [r] = find_recurring(rows, min_months=2)
+    assert r.months == ((2026, 1), (2026, 2))
+    assert r.last_date == date(2026, 2, 3)
+
+
+def test_two_missing_months_is_not_continuous() -> None:
+    rows = [
+        ex("2026-01-01", "a", 100, "x"),
+        ex("2026-02-01", "a", 100, "x"),
+        ex("2026-05-01", "a", 100, "x"),
+        ex("2026-06-01", "a", 100, "x"),
+    ]
+    # 欠けた月が 2 つ (3 月・4 月) なので連続とみなさない
+    assert find_recurring(rows, min_months=2) == []
+
+
+def test_day_mode_tie_prefers_larger_day() -> None:
+    rows = [
+        ex("2026-01-05", "a", 100, "x"),
+        ex("2026-02-20", "a", 100, "x"),
+        ex("2026-03-05", "a", 100, "x"),
+        ex("2026-04-20", "a", 100, "x"),
+    ]
+    [r] = find_recurring(rows)
+    assert r.day == 20  # 5 と 20 が各 2 回 -> 大きい方
+
+
+def test_output_sorted_by_last_date_then_category_then_memo() -> None:
+    base = [
+        ex("2026-01-01", "b", 100, "m"),
+        ex("2026-02-01", "b", 100, "m"),
+        ex("2026-03-01", "b", 100, "m"),
+        ex("2026-01-01", "a", 100, "z"),
+        ex("2026-02-01", "a", 100, "z"),
+        ex("2026-03-01", "a", 100, "z"),
+        ex("2026-01-01", "a", 100, "y"),
+        ex("2026-02-01", "a", 100, "y"),
+        ex("2026-03-01", "a", 100, "y"),
+        ex("2026-01-01", "c", 100, "q"),
+        ex("2026-02-01", "c", 100, "q"),
+        ex("2026-04-01", "c", 100, "q"),
+    ]
+    result = find_recurring(base)
+    assert [(r.category, r.memo) for r in result] == [
+        ("a", "y"),
+        ("a", "z"),
+        ("b", "m"),
+        ("c", "q"),  # 1・2・4 月 (欠けた月 1 つ) は last_date 4/1 で最後
+    ]
+
+
+def test_result_is_recurring_instance() -> None:
+    rows = [
+        ex("2026-01-01", "a", 100, "x"),
+        ex("2026-02-01", "a", 100, "x"),
+        ex("2026-03-01", "a", 100, "x"),
+    ]
+    [r] = find_recurring(rows)
+    assert isinstance(r, Recurring)
+
+
+def test_next_due_december_rolls_to_january() -> None:
+    r = Recurring(
+        category="a",
+        memo="x",
+        amount=100,
+        months=((2026, 10), (2026, 11), (2026, 12)),
+        last_date=date(2026, 12, 15),
+        day=15,
+    )
+    assert next_due(r) == date(2027, 1, 15)
+
+
+def test_next_due_clamps_to_february_end_in_leap_year() -> None:
+    r = Recurring(
+        category="a",
+        memo="x",
+        amount=100,
+        months=((2028, 1), (2028, 2), (2028, 3)),
+        last_date=date(2028, 1, 31),
+        day=31,
+    )
+    assert next_due(r) == date(2028, 2, 29)
+
+
+def test_next_due_clamps_to_february_end_in_common_year() -> None:
+    r = Recurring(
+        category="a",
+        memo="x",
+        amount=100,
+        months=((2026, 1), (2026, 2), (2026, 3)),
+        last_date=date(2026, 1, 31),
+        day=31,
+    )
+    assert next_due(r) == date(2026, 2, 28)
