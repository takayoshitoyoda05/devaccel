new file mode 100644
index 0000000..2016895
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,94 @@
+"""Pure search over expenses with composable conditions."""
+
+from __future__ import annotations
+
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Cond:
+    op: str
+    args: tuple
+
+
+def _check_cond(c: object) -> Cond:
+    if not isinstance(c, Cond):
+        raise TypeError(f"条件は Cond である必要があります: {c!r}")
+    return c
+
+
+def _fold(text: str) -> str:
+    """D6: NFKC + 小文字化。"""
+    return unicodedata.normalize("NFKC", text).lower()
+
+
+def category(*names: str) -> Cond:
+    """分類名のいずれかに完全一致(前後空白除去、複数名は OR)。"""
+    if not names:
+        raise ValueError("category() には 1 つ以上の分類名が必要です")
+    return Cond("category", tuple(n.strip() for n in names))
+
+
+def amount_between(lo: int | None, hi: int | None) -> Cond:
+    """金額が lo 以上 hi 以下(両端を含む)。None は無制限。"""
+    if lo is not None and hi is not None and lo > hi:
+        raise ValueError(f"lo > hi です: {lo} > {hi}")
+    return Cond("amount_between", (lo, hi))
+
+
+def date_between(start: date | None, end: date | None) -> Cond:
+    """日付が start 以上 end 以下(両端を含む)。None は無制限。"""
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"start > end です: {start} > {end}")
+    return Cond("date_between", (start, end))
+
+
+def memo_contains(text: str) -> Cond:
+    """メモが text を部分一致で含む(D6: NFKC + 小文字化)。空文字は常に真。"""
+    return Cond("memo_contains", (_fold(text),))
+
+
+def all_of(*conds: Cond) -> Cond:
+    """全条件が真。引数なしは真。"""
+    return Cond("all_of", tuple(_check_cond(c) for c in conds))
+
+
+def any_of(*conds: Cond) -> Cond:
+    """いずれかの条件が真。引数なしは偽。"""
+    return Cond("any_of", tuple(_check_cond(c) for c in conds))
+
+
+def not_(cond: Cond) -> Cond:
+    """条件を否定する。"""
+    return Cond("not", (_check_cond(cond),))
+
+
+def _match(e: Expense, c: Cond) -> bool:
+    op, args = c.op, c.args
+    if op == "category":
+        return e.category in args
+    if op == "amount_between":
+        lo, hi = args
+        return (lo is None or e.amount >= lo) and (hi is None or e.amount <= hi)
+    if op == "date_between":
+        start, end = args
+        return (start is None or e.day >= start) and (end is None or e.day <= end)
+    if op == "memo_contains":
+        return args[0] in _fold(e.memo)
+    if op == "all_of":
+        return all(_match(e, s) for s in args)
+    if op == "any_of":
+        return any(_match(e, s) for s in args)
+    if op == "not":
+        return not _match(e, args[0])
+    raise ValueError(f"未知の条件です: {op!r}")
+
+
+def search(expenses: list[Expense], cond: Cond) -> list[Expense]:
+    """条件に合う支出を入力順のまま新しいリストで返す(入力は変更しない)。"""
+    _check_cond(cond)
+    return [e for e in expenses if _match(e, cond)]
