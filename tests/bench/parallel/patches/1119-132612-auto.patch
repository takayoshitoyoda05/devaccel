@@ -0,0 +1,98 @@
+"""Detect recurring expenses (pure functions, standard library only)."""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from collections import Counter, defaultdict
+from dataclasses import dataclass
+from datetime import date
+from itertools import pairwise
+
+from kakeibo.core import Expense
+
+_SPACE_RE = re.compile(r"\s+")
+_TRAILING_RE = re.compile(r"(#[0-9]+|\([0-9]+\)|[0-9]+)$")
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str  # 系列で最初に現れた元のメモ
+    amount: int  # 最新の金額 (円)
+    months: tuple[tuple[int, int], ...]  # (year, month), 昇順
+    last_date: date
+    day: int  # 系列の日の最頻値 (同点は大きい方)
+
+
+def _normalize_memo(memo: str) -> str:
+    s = unicodedata.normalize("NFKC", memo).lower()
+    s = _SPACE_RE.sub("", s)
+    return _TRAILING_RE.sub("", s)
+
+
+def _month_index(ym: tuple[int, int]) -> int:
+    return ym[0] * 12 + ym[1]
+
+
+def _is_continuous(months: tuple[tuple[int, int], ...]) -> bool:
+    """Consecutive months, allowing at most one missing month in total."""
+    missing = 0
+    for a, b in pairwise(months):
+        gap = _month_index(b) - _month_index(a)
+        missing += gap - 1
+    return missing <= 1
+
+
+def find_recurring(expenses: list[Expense], min_months: int = 3) -> list[Recurring]:
+    if min_months < 2:
+        raise ValueError("min_months は 2 以上である必要があります")
+
+    groups: dict[tuple[str, str], list[Expense]] = defaultdict(list)
+    for e in expenses:
+        if e.amount > 0:
+            groups[(e.category, _normalize_memo(e.memo))].append(e)
+
+    result: list[Recurring] = []
+    for (category, _key), rows in groups.items():
+        rows.sort(key=lambda e: e.day)
+        lo = min(e.amount for e in rows)
+        hi = max(e.amount for e in rows)
+        if hi * 2 > lo * 3:  # hi > lo * 1.5 (整数比較)
+            continue
+
+        chosen: dict[tuple[int, int], Expense] = {}
+        for e in rows:  # 同じ月は最も早い行を採用
+            chosen.setdefault((e.day.year, e.day.month), e)
+        months = tuple(sorted(chosen))
+        if len(months) < min_months or not _is_continuous(months):
+            continue
+
+        last = chosen[months[-1]]
+        counts = Counter(e.day.day for e in chosen.values())
+        best = max(counts.values())
+        day = max(d for d, c in counts.items() if c == best)
+        result.append(
+            Recurring(
+                category=category,
+                memo=rows[0].memo,
+                amount=last.amount,
+                months=months,
+                last_date=last.day,
+                day=day,
+            )
+        )
+
+    result.sort(key=lambda r: (r.last_date, r.category, r.memo))
+    return result
+
+
+def next_due(r: Recurring) -> date:
+    year, month = r.last_date.year, r.last_date.month
+    if month == 12:
+        year, month = year + 1, 1
+    else:
+        month += 1
+    last_day = calendar.monthrange(year, month)[1]
+    return date(year, month, min(r.day, last_day))
