@@ -0,0 +1,82 @@
+"""Budget alerts: flag categories that exceeded or are close to a monthly budget.
+
+Pure functions only (no I/O). Amounts are integer yen; ratios use integer math.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Literal
+
+from kakeibo.core import Budget
+
+Level = Literal["over", "near"]
+
+DEFAULT_NEAR_PERCENT = 80
+
+
+@dataclass(frozen=True)
+class Alert:
+    month: str
+    category: str
+    level: Level
+    limit: int
+    actual: int
+
+    @property
+    def remaining(self) -> int:
+        """Yen left in the budget (negative when over)."""
+        return self.limit - self.actual
+
+    @property
+    def percent(self) -> int:
+        """Usage in whole percent, rounded down. With limit 0: 100 if any spend, else 0."""
+        if self.limit == 0:
+            return 100 if self.actual > 0 else 0
+        return self.actual * 100 // self.limit
+
+
+def classify(
+    actual: int, limit: int, near_percent: int = DEFAULT_NEAR_PERCENT
+) -> Level | None:
+    """ "over" if actual > limit; "near" if actual >= near_percent% of limit; else None.
+
+    A limit of 0 means "spend nothing": any spending is over, no spending is fine.
+    """
+    if not 0 <= near_percent <= 100:
+        raise ValueError("near_percent は 0〜100 である必要があります")
+    if actual > limit:
+        return "over"
+    if limit > 0 and actual * 100 >= limit * near_percent:
+        return "near"
+    return None
+
+
+def find_alerts(
+    totals: dict[str, dict[str, int]],
+    budget: Budget,
+    near_percent: int = DEFAULT_NEAR_PERCENT,
+) -> list[Alert]:
+    """Alerts for every (month, category) with a budget that is over or near.
+
+    totals is {"YYYY-MM": {category: yen}} (as from monthly_totals). Categories
+    without a budget are ignored. Result is ordered by month, then "over" before
+    "near", then by category name.
+    """
+    out: list[Alert] = []
+    for month in sorted(totals):
+        limits = budget.for_month(month)
+        for cat, actual in totals[month].items():
+            if cat not in limits:
+                continue
+            level = classify(actual, limits[cat], near_percent)
+            if level is not None:
+                out.append(Alert(month, cat, level, limits[cat], actual))
+    out.sort(key=lambda a: (a.month, a.level != "over", a.category))
+    return out
+
+
+def format_alert(a: Alert) -> str:
+    if a.level == "over":
+        return f"{a.month} {a.category}: 予算超過 {a.actual:,}円 / {a.limit:,}円(超過 {-a.remaining:,}円)"
+    return f"{a.month} {a.category}: 予算間近 {a.actual:,}円 / {a.limit:,}円(残り {a.remaining:,}円)"
diff --git a/tests/test_budget_alerts.py b/tests/test_budget_alerts.py
new file mode 100644
index 0000000..8cb6622
--- /dev/null
+++ b/tests/test_budget_alerts.py
@@ -0,0 +1,62 @@
+import pytest
+
+from kakeibo.budget_alerts import Alert, classify, find_alerts, format_alert
+from kakeibo.core import Budget
+
+
+def test_classify_boundaries():
+    assert classify(1001, 1000) == "over"
+    assert classify(1000, 1000) == "near"  # exactly at limit is not over
+    assert classify(800, 1000) == "near"
+    assert classify(799, 1000) is None
+    assert classify(0, 1000) is None
+
+
+def test_classify_zero_limit():
+    assert classify(1, 0) == "over"
+    assert classify(0, 0) is None
+
+
+def test_classify_custom_percent_and_validation():
+    assert classify(500, 1000, near_percent=50) == "near"
+    assert classify(499, 1000, near_percent=50) is None
+    with pytest.raises(ValueError):
+        classify(1, 10, near_percent=101)
+
+
+def test_find_alerts_uses_month_override_and_ignores_unbudgeted():
+    budget = Budget(
+        default={"food": 1000, "rent": 80000},
+        months={"2026-11": {"food": 5000}},
+    )
+    totals = {
+        "2026-10": {"food": 1200, "rent": 80000, "game": 99999},
+        "2026-11": {"food": 4100, "rent": 10000},
+    }
+    alerts = find_alerts(totals, budget)
+    assert alerts == [
+        Alert("2026-10", "food", "over", 1000, 1200),
+        Alert("2026-10", "rent", "near", 80000, 80000),
+        Alert("2026-11", "food", "near", 5000, 4100),
+    ]
+
+
+def test_find_alerts_empty():
+    assert find_alerts({}, Budget({}, {})) == []
+    assert find_alerts({"2026-11": {"food": 1}}, Budget({}, {})) == []
+
+
+def test_alert_properties():
+    a = Alert("2026-11", "food", "over", 1000, 1250)
+    assert a.remaining == -250
+    assert a.percent == 125
+    assert Alert("2026-11", "x", "over", 0, 5).percent == 100
+
+
+def test_format_alert():
+    assert format_alert(Alert("2026-11", "food", "over", 1000, 1250)) == (
+        "2026-11 food: 予算超過 1,250円 / 1,000円(超過 250円)"
+    )
+    assert format_alert(Alert("2026-11", "food", "near", 1000, 900)) == (
+        "2026-11 food: 予算間近 900円 / 1,000円(残り 100円)"
+    )
