index 0000000..617c990
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,94 @@
+"""Month-over-month comparison of expenses by category."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not isinstance(month, str) or not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def _month_of(e: Expense) -> str:
+    return e.day.strftime("%Y-%m")
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+
+    prev_total: dict[str, int] = {}
+    curr_total: dict[str, int] = {}
+    prev_count: dict[str, int] = {}
+    curr_count: dict[str, int] = {}
+    for e in rows:
+        m = _month_of(e)
+        if m == prev_month:
+            prev_total[e.category] = prev_total.get(e.category, 0) + e.amount
+            prev_count[e.category] = prev_count.get(e.category, 0) + 1
+        elif m == curr_month:
+            curr_total[e.category] = curr_total.get(e.category, 0) + e.amount
+            curr_count[e.category] = curr_count.get(e.category, 0) + 1
+
+    diffs: list[DiffRow] = []
+    for cat in set(prev_count) | set(curr_count):
+        prev = prev_total.get(cat, 0)
+        curr = curr_total.get(cat, 0)
+        delta = curr - prev
+        # `+ 0.0` turns -0.0 into 0.0 so it never renders as "-0.0%".
+        pct = round(delta / prev * 100, 1) + 0.0 if prev != 0 else None
+        if cat not in prev_count:
+            status = "new"
+        elif cat not in curr_count:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        diffs.append(DiffRow(cat, prev, curr, delta, pct, status))
+
+    diffs.sort(key=lambda d: (-abs(d.delta), d.category))
+    return diffs
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [d for d in diffs if d.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for d in diffs:
+        pct = "-" if d.pct is None else f"{d.pct:+.1f}%"
+        lines.append(f"{d.category}\t{d.prev}\t{d.curr}\t{d.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month_of(e) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には明細のある月が 2 つ以上必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..6715edd
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,166 @@
+"""Search query language: tokenizer, parser and evaluator for Expense rows.
+
+Grammar (lowest precedence first):
+    or_expr   := and_expr ("OR" and_expr)*
+    and_expr  := not_expr (["AND"] not_expr)*
+    not_expr  := "NOT" not_expr | primary
+    primary   := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+class QueryError(ValueError):
+    """Raised when a query is malformed."""
+
+
+Token = tuple[str, str]
+
+_KEYWORDS = {"AND", "OR", "NOT"}
+
+
+def _read_word(q: str, i: int) -> int:
+    while i < len(q) and not q[i].isspace() and q[i] not in '()"':
+        i += 1
+    return i
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    tokens: list[Token] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError("引用符が閉じられていません")
+            body = q[i + 1 : end]
+            if not body:
+                raise QueryError("空の引用は使えません")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            end = _read_word(q, i)
+            word = q[i:end]
+            i = end
+            if word in _KEYWORDS:
+                tokens.append((word, word))
+            elif word.startswith("cat:"):
+                value = word[len("cat:") :]
+                if not value:
+                    raise QueryError("cat: の後ろが空です")
+                tokens.append(("CAT", value))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+# AST: tuples tagged by kind.
+Node = tuple  # ("term", s) | ("cat", s) | ("not", n) | ("and", [n...]) | ("or", [n...])
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self.tokens = tokens
+        self.pos = 0
+
+    def _peek(self) -> str | None:
+        return self.tokens[self.pos][0] if self.pos < len(self.tokens) else None
+
+    def _take(self) -> Token:
+        tok = self.tokens[self.pos]
+        self.pos += 1
+        return tok
+
+    def parse(self) -> Node:
+        if not self.tokens:
+            raise QueryError("クエリが空です")
+        node = self._or()
+        if self.pos != len(self.tokens):
+            raise QueryError(f"予期しないトークン: {self.tokens[self.pos][1]!r}")
+        return node
+
+    def _or(self) -> Node:
+        items = [self._and()]
+        while self._peek() == "OR":
+            self._take()
+            items.append(self._and())
+        return items[0] if len(items) == 1 else ("or", items)
+
+    def _and(self) -> Node:
+        items = [self._not()]
+        while True:
+            kind = self._peek()
+            if kind == "AND":
+                self._take()
+                items.append(self._not())
+            elif kind in ("NOT", "TERM", "CAT", "LPAREN"):
+                items.append(self._not())
+            else:
+                break
+        return items[0] if len(items) == 1 else ("and", items)
+
+    def _not(self) -> Node:
+        if self._peek() == "NOT":
+            self._take()
+            return ("not", self._not())
+        return self._primary()
+
+    def _primary(self) -> Node:
+        kind = self._peek()
+        if kind == "TERM":
+            return ("term", self._take()[1])
+        if kind == "CAT":
+            return ("cat", self._take()[1])
+        if kind == "LPAREN":
+            self._take()
+            if self._peek() == "RPAREN":
+                raise QueryError("空の括弧は使えません")
+            node = self._or()
+            if self._peek() != "RPAREN":
+                raise QueryError("括弧が閉じられていません")
+            self._take()
+            return node
+        if kind is None:
+            raise QueryError("演算子の後ろに項がありません")
+        raise QueryError(f"項が必要です: {self.tokens[self.pos][1]!r}")
+
+
+def _parse(q: str) -> Node:
+    return _Parser(tokenize(q)).parse()
+
+
+def _eval(node: Node, e: Expense) -> bool:
+    kind = node[0]
+    if kind == "term":
+        needle = node[1].casefold()
+        return needle in e.memo.casefold() or needle in e.category.casefold()
+    if kind == "cat":
+        return node[1].casefold() == e.category.casefold()
+    if kind == "not":
+        return not _eval(node[1], e)
+    if kind == "and":
+        return all(_eval(n, e) for n in node[1])
+    if kind == "or":
+        return any(_eval(n, e) for n in node[1])
+    raise QueryError(f"不明なノード: {kind!r}")  # pragma: no cover
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _eval(_parse(q), e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    node = _parse(q)  # parse first so a bad query raises even when rows is empty
+    return [e for e in rows if _eval(node, e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..2bfb39f
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,65 @@
+"""Detect recurring expenses (same category and amount, roughly monthly)."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day in the next month, clamped to that month's last day."""
+    year = d.year + (d.month // 12)
+    month = d.month % 12 + 1
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def _runs(days: list[date], tolerance: int) -> list[list[date]]:
+    """Split sorted, unique dates into maximal runs whose neighbours are linked."""
+    runs: list[list[date]] = []
+    for d in days:
+        if runs and abs((d - add_month(runs[-1][-1])).days) <= tolerance:
+            runs[-1].append(d)
+        else:
+            runs.append([d])
+    return runs
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError("min_count は 2 以上である必要があります")
+    if tolerance < 0:
+        raise ValueError("tolerance は 0 以上である必要があります")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    out: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        for run in _runs(sorted(day_set), tolerance):
+            if len(run) >= min_count:
+                out.append(
+                    Recurring(
+                        category=category,
+                        amount=amount,
+                        days=tuple(run),
+                        next_expected=add_month(run[-1]),
+                    )
+                )
+
+    out.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return out
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..aecb2c1
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,183 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+HEADER = "利用日,分類,利用金額,利用店名\n"
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥1200", 1200),
+        ("-1,000円", -1000),
+        ("1,,2", 12),
+    ],
+)
+def test_parse_amount_accepts(text, expected):
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    ["", "円", "12.5", "1 200", "--5", "¥-5", "１２３", "-", "¥", "5¥", "円5", "1円円"],
+)
+def test_parse_amount_rejects(text):
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/12/31 ", date(2026, 12, 31)),
+        ("2026-1-5", date(2026, 1, 5)),
+    ],
+)
+def test_parse_date_accepts(text, expected):
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026/1-5",
+        "26/1/5",
+        "2026/02/30",
+        "2026/13/1",
+        "２０２６/1/5",
+        "2026.1.5",
+        "",
+        "2026/1",
+    ],
+)
+def test_parse_date_rejects(text):
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+def test_default_mapping_values():
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_import_rows_basic_with_default_mapping():
+    text = (
+        HEADER + '2026/11/1,食費,"1,200","ス ーパー, A"\n2026-11-02,交通,￥300, 駅 \n'
+    )
+    expenses, errors = import_rows(text)
+    assert errors == []
+    assert expenses == [
+        Expense(date(2026, 11, 1), "食費", 1200, "ス ーパー, A"),
+        Expense(date(2026, 11, 2), "交通", 300, "駅"),
+    ]
+
+
+def test_import_rows_custom_mapping_ignores_extra_columns():
+    text = "when,kind,yen,extra,shop\n2026/3/4,  雑費 ,-500円,zzz,本屋\n"
+    mapping = {"date": "when", "category": "kind", "amount": "yen", "memo": "shop"}
+    expenses, errors = import_rows(text, mapping)
+    assert errors == []
+    assert expenses == [Expense(date(2026, 3, 4), "雑費", -500, "本屋")]
+
+
+def test_import_rows_memo_optional_in_mapping():
+    text = "d,c,a\n2026/1/1,食費,100\n"
+    expenses, errors = import_rows(text, {"date": "d", "category": "c", "amount": "a"})
+    assert errors == []
+    assert expenses == [Expense(date(2026, 1, 1), "食費", 100, "")]
+
+
+def test_import_rows_missing_required_key_raises():
+    with pytest.raises(ValueError):
+        import_rows(HEADER, {"date": "利用日", "amount": "利用金額"})
+
+
+def test_import_rows_mapped_memo_column_absent_from_header_raises():
+    with pytest.raises(ValueError):
+        import_rows(
+            "利用日,分類,利用金額\n",
+            {
+                "date": "利用日",
+                "category": "分類",
+                "amount": "利用金額",
+                "memo": "利用店名",
+            },
+        )
+
+
+def test_import_rows_mapped_column_absent_from_header_raises():
+    with pytest.raises(ValueError):
+        import_rows("a,b,c\n1,2,3\n", {"date": "a", "category": "b", "amount": "x"})
+
+
+def test_import_rows_reports_all_errors_in_order_and_excludes_row():
+    text = HEADER + "bad,,abc,m\n2026/1/2,食費,100,ok\n2026/1/3,  ,1円円,x\n"
+    expenses, errors = import_rows(text)
+    assert errors == [
+        (2, "date"),
+        (2, "amount"),
+        (2, "category"),
+        (4, "amount"),
+        (4, "category"),
+    ]
+    assert expenses == [Expense(date(2026, 1, 2), "食費", 100, "ok")]
+
+
+def test_import_rows_error_only_date():
+    expenses, errors = import_rows(HEADER + "2026/1/2,食費,100,\n2026/2/30,食費,100,\n")
+    assert errors == [(3, "date")]
+    assert len(expenses) == 1
+
+
+def test_import_rows_blank_lines_counted_but_skipped():
+    text = HEADER + "\n2026/1/2,食費,100,a\n\n2026/1/x,食費,100,b\n"
+    expenses, errors = import_rows(text)
+    assert errors == [(5, "date")]
+    assert expenses == [Expense(date(2026, 1, 2), "食費", 100, "a")]
+
+
+def test_import_rows_short_row_treats_missing_as_empty():
+    text = HEADER + "2026/1/2,食費\n"
+    expenses, errors = import_rows(text)
+    assert errors == [(2, "amount")]
+    assert expenses == []
+
+
+def test_import_rows_short_row_missing_memo_is_empty():
+    text = "d,c,a,m\n2026/1/2,食費,100\n"
+    mapping = {"date": "d", "category": "c", "amount": "a", "memo": "m"}
+    expenses, errors = import_rows(text, mapping)
+    assert errors == []
+    assert expenses == [Expense(date(2026, 1, 2), "食費", 100, "")]
+
+
+def test_import_rows_category_map_applies_after_strip():
+    text = HEADER + "2026/1/2, 食料品 ,100,\n2026/1/3,交通,200,\n"
+    expenses, errors = import_rows(text, category_map={"食料品": "食費"})
+    assert errors == []
+    assert [e.category for e in expenses] == ["食費", "交通"]
+
+
+def test_import_rows_multiline_quoted_field_line_numbers():
+    text = HEADER + '2026/1/2,食費,100,"a\nb"\n2026/1/x,食費,100,c\n'
+    expenses, errors = import_rows(text)
+    assert expenses == [Expense(date(2026, 1, 2), "食費", 100, "a\nb")]
+    assert errors == [(4, "date")]
+
+
+def test_import_rows_empty_text_raises():
+    with pytest.raises(ValueError):
+        import_rows("")
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..d253a39
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,149 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def e(day: str, cat: str, amount: int) -> Expense:
+    return Expense(date.fromisoformat(day), cat, amount)
+
+
+ROWS = [
+    e("2026-01-05", "食費", 1000),
+    e("2026-01-20", "食費", 500),
+    e("2026-01-10", "娯楽", 2000),
+    e("2026-01-11", "光熱費", 0),  # 明細はあるが合計 0
+    e("2026-02-03", "食費", 1800),
+    e("2026-02-04", "交通", 300),
+    e("2026-02-05", "光熱費", 500),
+    e("2026-03-01", "食費", 100),
+]
+
+
+def by_cat(diffs):
+    return {d.category: d for d in diffs}
+
+
+def test_month_diff_values_and_status():
+    d = by_cat(month_diff(ROWS, "2026-01", "2026-02"))
+    assert d["食費"] == DiffRow("食費", 1500, 1800, 300, 20.0, "up")
+    assert d["娯楽"] == DiffRow("娯楽", 2000, 0, -2000, -100.0, "gone")
+    assert d["交通"] == DiffRow("交通", 0, 300, 300, None, "new")
+
+
+def test_status_uses_line_presence_not_totals():
+    # 光熱費: prev は明細あり(合計 0)、curr は 500 → 0 ではないので "up"、pct は None
+    d = by_cat(month_diff(ROWS, "2026-01", "2026-02"))["光熱費"]
+    assert d == DiffRow("光熱費", 0, 500, 500, None, "up")
+
+
+def test_same_status_and_zero_pct():
+    rows = [e("2026-01-01", "A", 100), e("2026-02-01", "A", 100)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row.status == "same"
+    assert row.delta == 0
+    assert row.pct == 0.0
+
+
+def test_status_zero_total_with_lines_is_same():
+    rows = [e("2026-01-01", "A", 0), e("2026-02-01", "A", 0)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row.status == "same"
+
+
+def test_pct_rounds_to_one_decimal_and_no_negative_zero():
+    rows = [e("2026-01-01", "A", 100000), e("2026-02-01", "A", 99999)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row.pct == 0.0
+    assert str(row.pct) == "0.0"
+
+
+def test_sort_by_abs_delta_then_category():
+    rows = [
+        e("2026-01-01", "b", 100),
+        e("2026-02-01", "b", 200),  # delta +100
+        e("2026-01-01", "a", 300),
+        e("2026-02-01", "a", 0),  # delta -300
+        e("2026-01-01", "c", 100),
+        e("2026-02-01", "c", 200),  # delta +100
+    ]
+    cats = [d.category for d in month_diff(rows, "2026-01", "2026-02")]
+    assert cats == ["a", "b", "c"]
+
+
+def test_invalid_month_raises():
+    for bad in ["2026-1", "2026-13", "2026-00", "202601", "2026/01", ""]:
+        with pytest.raises(ValueError):
+            month_diff(ROWS, bad, "2026-02")
+        with pytest.raises(ValueError):
+            month_diff(ROWS, "2026-01", bad)
+
+
+def test_top_movers_skips_same_and_keeps_order():
+    rows = [
+        e("2026-01-01", "same", 100),
+        e("2026-02-01", "same", 100),
+        e("2026-01-01", "x", 100),
+        e("2026-02-01", "x", 500),
+        e("2026-01-01", "y", 1000),
+        e("2026-02-01", "y", 0),
+    ]
+    diffs = month_diff(rows, "2026-01", "2026-02")
+    movers = top_movers(diffs, n=1)
+    assert [m.category for m in movers] == ["y"]
+    assert [m.category for m in top_movers(diffs)] == ["y", "x"]
+    assert top_movers(diffs, n=0) == []
+
+
+def test_top_movers_negative_n_raises():
+    with pytest.raises(ValueError):
+        top_movers([], n=-1)
+
+
+def test_render_diff_format():
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    text = render_diff(diffs)
+    lines = text.split("\n")
+    assert lines[0] == "category\tprev\tcurr\tdelta\tpct"
+    assert lines[1:] == [
+        "娯楽\t2000\t0\t-2000\t-100.0%",
+        "光熱費\t0\t500\t+500\t-",
+        "交通\t0\t300\t+300\t-",
+        "食費\t1500\t1800\t+300\t+20.0%",
+    ]
+    assert not text.endswith("\n")
+
+
+def test_render_diff_zero_delta_and_empty():
+    rows = [e("2026-01-01", "A", 100), e("2026-02-01", "A", 100)]
+    assert render_diff(month_diff(rows, "2026-01", "2026-02")).split("\n")[1] == (
+        "A\t100\t100\t+0\t+0.0%"
+    )
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_available_months_sorted_unique():
+    assert available_months(ROWS) == ["2026-01", "2026-02", "2026-03"]
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months():
+    d = by_cat(latest_diff(ROWS))
+    assert set(d) == {"食費", "交通", "光熱費"}
+    assert d["食費"] == DiffRow("食費", 1800, 100, -1700, -94.4, "down")
+
+
+def test_latest_diff_needs_two_months():
+    with pytest.raises(ValueError):
+        latest_diff([])
+    with pytest.raises(ValueError):
+        latest_diff([e("2026-01-01", "A", 1), e("2026-01-02", "A", 2)])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..5b22731
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,172 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+FOOD = Expense(date(2026, 1, 5), "食費", 1200, "Lunch with Bob")
+RENT = Expense(date(2026, 1, 1), "住居", 80000, "January rent")
+BOOK = Expense(date(2026, 2, 3), "教育", 1500, "")
+ROWS = [FOOD, RENT, BOOK]
+
+
+# --- tokenize ---
+
+
+def test_tokenize_empty_and_whitespace_only() -> None:
+    assert tokenize("") == []
+    assert tokenize("   \t ") == []
+
+
+def test_tokenize_parens_and_words() -> None:
+    assert tokenize("(a b)") == [
+        ("LPAREN", "("),
+        ("TERM", "a"),
+        ("TERM", "b"),
+        ("RPAREN", ")"),
+    ]
+
+
+def test_tokenize_keywords_only_uppercase() -> None:
+    assert tokenize("AND OR NOT and or not") == [
+        ("AND", "AND"),
+        ("OR", "OR"),
+        ("NOT", "NOT"),
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_quoted_term_keeps_spaces_and_parens() -> None:
+    assert tokenize('"a (b) c"') == [("TERM", "a (b) c")]
+
+
+def test_tokenize_cat() -> None:
+    assert tokenize("cat:食費 x") == [("CAT", "食費"), ("TERM", "x")]
+
+
+def test_tokenize_unclosed_quote_raises() -> None:
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_raises() -> None:
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_empty_cat_raises() -> None:
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_tokenize_quote_ends_word() -> None:
+    assert tokenize('ab"cd e"') == [("TERM", "ab"), ("TERM", "cd e")]
+
+
+# --- evaluation ---
+
+
+def test_term_matches_memo_and_category_case_insensitively() -> None:
+    assert matches("LUNCH", FOOD)
+    assert matches("食", FOOD)
+    assert not matches("rent", FOOD)
+
+
+def test_term_matches_category() -> None:
+    assert matches("住居", RENT)
+
+
+def test_cat_requires_exact_match_case_insensitive() -> None:
+    assert matches("cat:食費", FOOD)
+    assert not matches("cat:食", FOOD)
+    assert matches("cat:ABC", Expense(date(2026, 1, 1), "abc", 1))
+
+
+def test_implicit_and() -> None:
+    assert filter_rows("lunch bob", ROWS) == [FOOD]
+    assert filter_rows("lunch rent", ROWS) == []
+
+
+def test_explicit_and_equals_implicit() -> None:
+    assert filter_rows("january AND rent", ROWS) == [RENT]
+
+
+def test_or_and_precedence_over_or() -> None:
+    # AND binds tighter than OR: (lunch AND bob) OR cat:教育
+    assert filter_rows("lunch AND bob OR cat:教育", ROWS) == [FOOD, BOOK]
+
+
+def test_not_binds_tighter_than_and() -> None:
+    # (NOT rent) AND lunch
+    assert filter_rows("NOT rent lunch", ROWS) == [FOOD]
+
+
+def test_not_applies_to_group() -> None:
+    assert filter_rows("NOT (cat:食費 OR cat:住居)", ROWS) == [BOOK]
+
+
+def test_double_not() -> None:
+    assert filter_rows("NOT NOT cat:食費", ROWS) == [FOOD]
+
+
+def test_parens_override_precedence() -> None:
+    assert filter_rows("(lunch OR rent) bob", ROWS) == [FOOD]
+
+
+def test_quoted_term_with_space() -> None:
+    assert filter_rows('"january rent"', ROWS) == [RENT]
+
+
+def test_lowercase_and_is_a_term_not_operator() -> None:
+    assert filter_rows("lunch and bob", ROWS) == []
+
+
+def test_filter_rows_keeps_input_order() -> None:
+    assert filter_rows("cat:食費 OR cat:住居", [RENT, FOOD]) == [RENT, FOOD]
+
+
+def test_filter_rows_empty_input() -> None:
+    assert filter_rows("cat:食費", []) == []
+
+
+def test_filter_rows_no_match() -> None:
+    assert filter_rows("zzz", ROWS) == []
+
+
+# --- syntax errors ---
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(a",
+        "a)",
+        "a OR",
+        "OR a",
+        "AND a",
+        "NOT",
+        "a AND",
+        "(a OR)",
+        "cat:",
+        '"unclosed',
+        '""',
+    ],
+)
+def test_syntax_errors_raise(q: str) -> None:
+    with pytest.raises(QueryError):
+        matches(q, FOOD)
+
+
+def test_syntax_error_raises_even_with_empty_rows() -> None:
+    with pytest.raises(QueryError):
+        filter_rows("(a", [])
+
+
+def test_query_error_is_value_error() -> None:
+    assert issubclass(QueryError, ValueError)
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..674719f
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,116 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def E(d: str, category: str = "通信", amount: int = 1000, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(d), category=category, amount=amount, memo=memo
+    )
+
+
+@pytest.mark.parametrize(
+    ("src", "expected"),
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2024, 1, 31), date(2024, 2, 29)),
+        (date(2026, 12, 15), date(2027, 1, 15)),
+        (date(2026, 3, 10), date(2026, 4, 10)),
+    ],
+)
+def test_add_month(src: date, expected: date) -> None:
+    assert add_month(src) == expected
+
+
+def test_detects_monthly_run() -> None:
+    rows = [E("2026-01-05"), E("2026-02-05"), E("2026-03-05")]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="通信",
+            amount=1000,
+            days=(date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+            next_expected=date(2026, 4, 5),
+        )
+    ]
+
+
+def test_tolerance_allows_small_drift() -> None:
+    rows = [E("2026-01-05"), E("2026-02-07"), E("2026-03-05")]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+    assert find_recurring(rows, tolerance=1) == []
+
+
+def test_month_end_clamping_is_linked() -> None:
+    rows = [E("2026-01-31"), E("2026-02-28"), E("2026-03-31")]
+    (r,) = find_recurring(rows)
+    assert r.next_expected == date(2026, 4, 30)
+
+
+def test_run_below_min_count_is_dropped() -> None:
+    rows = [E("2026-01-05"), E("2026-02-05")]
+    assert find_recurring(rows, min_count=3) == []
+    assert len(find_recurring(rows, min_count=2)) == 1
+
+
+def test_gap_splits_runs() -> None:
+    rows = [
+        E("2026-01-05"),
+        E("2026-02-05"),
+        E("2026-03-05"),
+        E("2026-06-05"),
+        E("2026-07-05"),
+    ]
+    assert find_recurring(rows) == [
+        Recurring(
+            "通信",
+            1000,
+            (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+            date(2026, 4, 5),
+        )
+    ]
+
+
+def test_duplicate_days_are_collapsed() -> None:
+    rows = [E("2026-01-05"), E("2026-01-05"), E("2026-02-05"), E("2026-03-05")]
+    (r,) = find_recurring(rows)
+    assert r.days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_memo_is_ignored_and_amount_separates_groups() -> None:
+    rows = [
+        E("2026-01-05", memo="a"),
+        E("2026-02-05", memo="b"),
+        E("2026-03-05", amount=500),
+        E("2026-04-05", amount=500),
+        E("2026-05-05", amount=500),
+    ]
+    result = find_recurring(rows)
+    assert [(r.amount, len(r.days)) for r in result] == [(500, 3)]
+
+
+def test_result_is_sorted_by_category_amount_first_day() -> None:
+    rows = []
+    for cat, amt in [("食費", 300), ("家賃", 900), ("食費", 100)]:
+        for m in (1, 2, 3):
+            rows.append(E(f"2026-{m:02d}-10", category=cat, amount=amt))
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [
+        ("家賃", 900),
+        ("食費", 100),
+        ("食費", 300),
+    ]
+
+
+def test_empty_input() -> None:
+    assert find_recurring([]) == []
+
+
+@pytest.mark.parametrize("kwargs", [{"min_count": 1}, {"tolerance": -1}])
+def test_invalid_parameters_raise(kwargs: dict[str, int]) -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], **kwargs)
