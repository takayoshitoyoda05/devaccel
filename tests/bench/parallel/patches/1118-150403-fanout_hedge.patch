index 0000000..d88c2bb
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,114 @@
+"""Import bank statement CSV text into Expense records (pure functions, stdlib only)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"-?[¥￥]?[0-9][0-9,]*円?")
+_DATE_RES = (
+    re.compile(r"([0-9]{4})/([0-9]{1,2})/([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})-([0-9]{1,2})-([0-9]{1,2})"),
+)
+
+
+def parse_amount(s: str) -> int:
+    """'￥1,234' -> 1234, '-¥300' -> -300, '980円' -> 980. Raises ValueError otherwise."""
+    t = s.strip()
+    if not _AMOUNT_RE.fullmatch(t):
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    t = t.removesuffix("円")
+    t = t.replace("¥", "").replace("￥", "").replace(",", "")
+    return int(t)
+
+
+def parse_date(s: str) -> date:
+    """'YYYY/M/D' or 'YYYY-M-D' -> date. Raises ValueError otherwise."""
+    t = s.strip()
+    for pattern in _DATE_RES:
+        m = pattern.fullmatch(t)
+        if m is not None:
+            try:
+                return date(int(m.group(1)), int(m.group(2)), int(m.group(3)))
+            except ValueError:
+                raise ValueError(f"存在しない日付です: {s!r}") from None
+    raise ValueError(f"日付の形式が不正です: {s!r}")
+
+
+def _cell(row: list[str], index: dict[str, int], field: str) -> str:
+    """Value of a mapped field in a row; "" if unmapped or the row is short."""
+    i = index.get(field)
+    if i is None or i >= len(row):
+        return ""
+    return row[i]
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Parse CSV text (header on line 1) into (expenses, errors).
+
+    errors are (physical line number, field name); the header is line 1.
+    Rows with any error are excluded from the expenses.
+    """
+    cols = DEFAULT_MAPPING if mapping is None else mapping
+    for key in ("date", "category", "amount"):
+        if key not in cols:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header = next(reader, None)
+    if header is None:
+        raise ValueError("ヘッダー行がありません")
+    index: dict[str, int] = {}
+    for field, col in cols.items():
+        if col not in header:
+            raise ValueError(f"ヘッダーに列 {col!r} がありません")
+        index[field] = header.index(col)
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    line = reader.line_num  # physical line of the header's last line
+    for row in reader:
+        start = line + 1  # physical line where this record starts
+        line = reader.line_num
+        if not row:  # blank line: counted, but skipped
+            continue
+
+        row_errors: list[tuple[int, str]] = []
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(_cell(row, index, "date"))
+        except ValueError:
+            row_errors.append((start, "date"))
+        try:
+            amount = parse_amount(_cell(row, index, "amount"))
+        except ValueError:
+            row_errors.append((start, "amount"))
+        category = _cell(row, index, "category").strip()
+        if not category:
+            row_errors.append((start, "category"))
+
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        assert day is not None and amount is not None
+        if category_map and category in category_map:
+            category = category_map[category]
+        memo = _cell(row, index, "memo").strip()
+        expenses.append(Expense(day=day, category=category, amount=amount, memo=memo))
+    return expenses, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
