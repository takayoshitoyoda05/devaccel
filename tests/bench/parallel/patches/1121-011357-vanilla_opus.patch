@@ -0,0 +1,229 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.importer import (
+    ImportFormatError,
+    decode_csv_bytes,
+    import_bank_csv,
+    parse_amount,
+    parse_date,
+)
+
+
+@pytest.mark.parametrize(
+    "text, expected",
+    [
+        ("1200", 1200),
+        ("1,200", 1200),
+        ("¥1,200", 1200),
+        ("￥１，２００", 1200),
+        ("\\1,200", 1200),
+        ("1,200円", 1200),
+        ("JPY 1,200", 1200),
+        (" 1 200 ", 1200),
+        ("-1,200", -1200),
+        ("−1200", -1200),
+        ("－1200", -1200),
+        ("▲1,200", -1200),
+        ("△1200", -1200),
+        ("(1,200)", -1200),
+        ("-¥1,200", -1200),
+        ("¥-1,200", -1200),
+        ("1200.00", 1200),
+        ("0", 0),
+    ],
+)
+def test_parse_amount_accepts(text, expected):
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text, reason",
+    [
+        ("", "空"),
+        ("abc", "読めません"),
+        ("1,2,3", "読めません"),
+        ("12,00", "読めません"),
+        ("1200.5", "端数"),
+        ("--100", "読めません"),
+        ("¥¥100", "読めません"),
+    ],
+)
+def test_parse_amount_rejects_with_reason(text, reason):
+    with pytest.raises(ValueError, match=reason):
+        parse_amount(text)
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026-11-01",
+        "2026/11/01",
+        "2026/11/1",
+        "2026.11.01",
+        "2026年11月1日",
+        "20261101",
+        "２０２６／１１／０１",
+        "2026/11/01 12:34",
+        "2026-11-01T12:34:56",
+    ],
+)
+def test_parse_date_accepts(text):
+    assert parse_date(text) == date(2026, 11, 1)
+
+
+@pytest.mark.parametrize(
+    "text, reason",
+    [
+        ("", "空"),
+        ("26/11/01", "読めません"),
+        ("2026/02/30", "存在しない"),
+        ("2026/11/01 foo", "読めません"),
+    ],
+)
+def test_parse_date_rejects_with_reason(text, reason):
+    with pytest.raises(ValueError, match=reason):
+        parse_date(text)
+
+
+def test_card_statement_with_japanese_headers():
+    text = (
+        "ご利用日,ご利用店名,ご利用金額,備考\n"
+        '2026/11/01,AMAZON,"1,280",\n'
+        "2026/11/03,スターバックス,￥550,\n"
+        "2026/11/05,AMAZON 返品,-1280,\n"
+    )
+    res = import_bank_csv(text)
+    assert res.ok and res.skipped == []
+    assert res.columns == {
+        "date": "ご利用日",
+        "memo": "ご利用店名",
+        "amount": "ご利用金額",
+    }
+    assert res.expenses == [
+        Expense(date(2026, 11, 1), "未分類", 1280, "AMAZON"),
+        Expense(date(2026, 11, 3), "未分類", 550, "スターバックス"),
+        Expense(date(2026, 11, 5), "未分類", -1280, "AMAZON 返品"),
+    ]
+
+
+def test_bank_statement_with_split_columns_and_preamble():
+    text = (
+        "口座番号,1234567\n"
+        "期間,2026/11/01-2026/11/30\n"
+        "\n"
+        "取引日,摘要,お引出し,お預入れ,残高\n"
+        '2026/11/01,ATM,"10,000",,"90,000"\n'
+        '2026/11/02,給与,,"300,000","390,000"\n'
+        '2026/11/25,家賃,"80,000",,"310,000"\n'
+    )
+    res = import_bank_csv(text, default_category="bank")
+    assert res.ok
+    assert res.header_line == 4
+    assert [(e.memo, e.amount, e.category) for e in res.expenses] == [
+        ("ATM", 10000, "bank"),
+        ("家賃", 80000, "bank"),
+    ]
+    assert [(s.line, s.reason) for s in res.skipped] == [
+        (6, "入金のため取り込み対象外")
+    ]
+
+
+def test_signed_bank_column_with_expense_negative():
+    text = "Date,Description,Amount\n2026-11-01,Rent,-80000\n2026-11-02,Salary,300000\n"
+    res = import_bank_csv(text, sign="expense_negative")
+    assert [(e.memo, e.amount) for e in res.expenses] == [("Rent", 80000)]
+    assert [s.line for s in res.skipped] == [3]
+
+
+def test_bad_rows_are_reported_with_line_column_value_and_reason():
+    text = (
+        "日付,内容,金額\n"
+        "2026/11/01,ok,100\n"
+        "2026/13/01,bad month,100\n"
+        "2026/11/02,bad amount,12.5\n"
+        "\n"
+        '"2026/11/03","multi\nline",abc\n'
+        "合計,,200\n"
+        "2026/11/04,both bad\n"
+    )
+    res = import_bank_csv(text)
+    assert not res.ok
+    assert [e.memo for e in res.expenses] == ["ok"]
+    got = [(i.line, i.column, i.value) for i in res.errors]
+    assert got == [
+        (3, "日付", "2026/13/01"),
+        (4, "金額", "12.5"),
+        (6, "金額", "abc"),  # line where the multi-line record starts
+        (8, "日付", "合計"),
+        (9, "金額", ""),
+    ]
+    assert "存在しない日付" in res.errors[0].reason
+    assert "端数" in res.errors[1].reason
+    assert str(res.errors[0]) == "3行目 [日付]: 存在しない日付です ('2026/13/01')"
+    assert str(res.errors[4]) == "9行目 [金額]: 金額が空です"
+
+
+def test_one_row_can_have_several_errors():
+    res = import_bank_csv("date,amount\nxx,yy\n")
+    assert [i.column for i in res.errors] == ["date", "amount"]
+    assert {i.line for i in res.errors} == {2}
+
+
+def test_split_columns_errors():
+    text = "日付,出金,入金\n2026/11/01,100,200\n2026/11/02,,\n2026/11/03,,x\n"
+    res = import_bank_csv(text)
+    assert [(i.line, i.column, i.reason) for i in res.errors] == [
+        (2, None, "出金と入金の両方に値があります"),
+        (3, None, "出金・入金のどちらにも金額がありません"),
+        (4, "入金", "金額として読めません"),
+    ]
+
+
+def test_category_column_and_default():
+    text = "date,category,amount,memo\n2026-11-01,food,100,a\n2026-11-02,,200,b\n"
+    res = import_bank_csv(text, default_category="misc")
+    assert [e.category for e in res.expenses] == ["food", "misc"]
+
+
+def test_explicit_column_mapping_overrides_aliases():
+    text = "支払日,お店,支払い\n2026/11/01,shop,500\n"
+    with pytest.raises(ImportFormatError, match="ヘッダ行が見つかりません"):
+        import_bank_csv(text)
+    res = import_bank_csv(
+        text, columns={"date": "支払日", "amount": "支払い", "memo": "お店"}
+    )
+    assert res.expenses == [Expense(date(2026, 11, 1), "未分類", 500, "shop")]
+
+
+def test_header_matching_ignores_width_case_space_and_bom():
+    text = "﻿ DATE ,ＡＭＯＵＮＴ,Memo\n2026-11-01,1,x\n"
+    res = import_bank_csv(text)
+    assert res.expenses == [Expense(date(2026, 11, 1), "未分類", 1, "x")]
+
+
+def test_tab_delimited():
+    res = import_bank_csv("日付\t金額\n2026/11/01\t1,000\n", delimiter="\t")
+    assert [e.amount for e in res.expenses] == [1000]
+
+
+def test_format_errors():
+    with pytest.raises(ImportFormatError, match="空"):
+        import_bank_csv("")
+    with pytest.raises(ImportFormatError, match="未知の項目名"):
+        import_bank_csv("date,amount\n", columns={"price": "x"})
+    with pytest.raises(ImportFormatError, match="sign"):
+        import_bank_csv("date,amount\n", sign="nope")  # type: ignore[arg-type]
+    many_lines = "a,b\n" * 20 + "date,amount\n"
+    with pytest.raises(ImportFormatError):
+        import_bank_csv(many_lines)
+    assert import_bank_csv(many_lines, header_search_rows=30).header_line == 21
+
+
+def test_decode_csv_bytes():
+    s = "日付,金額\n"
+    assert decode_csv_bytes(s.encode("utf-8")) == s
+    assert decode_csv_bytes(b"\xef\xbb\xbf" + s.encode("utf-8")) == s
+    assert decode_csv_bytes(s.encode("cp932")) == s
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..be873ae
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,91 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import (
+    all_of,
+    amount_between,
+    any_of,
+    category,
+    date_between,
+    memo_contains,
+    not_,
+    search,
+)
+
+ROWS = [
+    Expense(date(2026, 10, 31), "food", 500, "Lunch"),
+    Expense(date(2026, 11, 1), "food", 1200, "lunch with team"),
+    Expense(date(2026, 11, 2), "rent", 80000, ""),
+    Expense(date(2026, 11, 3), "cafe", 800, "coffee"),
+    Expense(date(2026, 11, 30), "food", -300, "refund"),
+]
+
+
+def memos(rows):
+    return [e.memo for e in rows]
+
+
+def test_category():
+    assert memos(search(ROWS, category("cafe"))) == ["coffee"]
+    assert len(search(ROWS, category("food", "cafe"))) == 4
+    assert search(ROWS, category("Food")) == []
+    with pytest.raises(ValueError):
+        category()
+
+
+def test_amount_between_inclusive_and_open_ended():
+    assert memos(search(ROWS, amount_between(500, 1200))) == [
+        "Lunch",
+        "lunch with team",
+        "coffee",
+    ]
+    assert memos(search(ROWS, amount_between(min=10000))) == [""]
+    assert memos(search(ROWS, amount_between(max=0))) == ["refund"]
+    with pytest.raises(ValueError):
+        amount_between(10, 1)
+
+
+def test_memo_contains():
+    assert memos(search(ROWS, memo_contains("lunch"))) == ["lunch with team"]
+    assert memos(search(ROWS, memo_contains("LUNCH", ignore_case=True))) == [
+        "Lunch",
+        "lunch with team",
+    ]
+    assert len(search(ROWS, memo_contains(""))) == len(ROWS)
+
+
+def test_date_between_inclusive():
+    nov = date_between(date(2026, 11, 1), date(2026, 11, 30))
+    assert len(search(ROWS, nov)) == 4
+    assert memos(search(ROWS, date_between(end=date(2026, 10, 31)))) == ["Lunch"]
+    with pytest.raises(ValueError):
+        date_between(date(2026, 12, 1), date(2026, 11, 1))
+
+
+def test_and_or_not_operators():
+    q = (
+        (category("food") | category("cafe"))
+        & amount_between(min=600)
+        & ~memo_contains("refund")
+    )
+    assert memos(search(ROWS, q)) == ["lunch with team", "coffee"]
+    same = all_of(
+        any_of(category("food"), category("cafe")),
+        amount_between(min=600),
+        not_(memo_contains("refund")),
+    )
+    assert search(ROWS, same) == search(ROWS, q)
+
+
+def test_empty_combinators_and_no_filter():
+    assert search(ROWS, all_of()) == ROWS
+    assert search(ROWS, any_of()) == []
+    assert search(ROWS) == ROWS
+    assert search(iter(ROWS), category("rent"))[0].amount == 80000
+
+
+def test_description_is_readable():
+    q = category("food") & ~amount_between(max=0)
+    assert str(q) == "(category in ['food'] AND NOT amount in [, 0])"
