+++ b/tests/test_compare.py
@@ -0,0 +1,90 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.compare import compare_months, format_comparison
+from kakeibo.core import Expense
+
+
+def E(d: str, cat: str, amount: int) -> Expense:
+    return Expense(date.fromisoformat(d), cat, amount)
+
+
+ROWS = [
+    E("2026-10-01", "food", 1000),
+    E("2026-10-15", "food", 1000),
+    E("2026-10-02", "rent", 80000),
+    E("2026-10-03", "hobby", 5000),
+    E("2026-11-01", "food", 3000),
+    E("2026-11-02", "rent", 80000),
+    E("2026-11-03", "travel", 20000),
+    E("2026-12-01", "food", 99999),  # other months are ignored
+]
+
+
+def test_compare_with_previous_month():
+    c = compare_months(ROWS, "2026-11")
+    assert c.previous_month == "2026-10"
+    got = [(x.category, x.previous, x.current, x.diff, x.status) for x in c.changes]
+    assert got == [
+        ("travel", 0, 20000, 20000, "new"),
+        ("hobby", 5000, 0, -5000, "gone"),
+        ("food", 2000, 3000, 1000, "up"),
+        ("rent", 80000, 80000, 0, "same"),
+    ]
+    assert (c.previous_total, c.current_total, c.diff) == (87000, 103000, 16000)
+    food = c.by_status("up")[0]
+    assert food.pct == 50.0
+    assert c.by_status("new")[0].pct is None
+    assert c.by_status("gone")[0].pct == -100.0
+
+
+def test_down_status():
+    c = compare_months(
+        [E("2026-10-01", "x", 400), E("2026-11-01", "x", 100)], "2026-11"
+    )
+    [x] = c.changes
+    assert (x.status, x.pct) == ("down", -75.0)
+
+
+def test_year_boundary_default_previous():
+    c = compare_months([E("2025-12-10", "x", 1), E("2026-01-10", "x", 2)], "2026-01")
+    assert c.previous_month == "2025-12"
+    assert c.changes[0].diff == 1
+
+
+def test_explicit_previous_month():
+    c = compare_months(ROWS, "2026-12", previous_month="2026-10")
+    assert c.previous_month == "2026-10"
+    assert {x.category for x in c.changes} == {"food", "rent", "hobby"}
+
+
+def test_empty_months():
+    c = compare_months(ROWS, "2027-05")
+    assert c.changes == ()
+    assert c.diff == 0
+
+
+def test_invalid_month():
+    with pytest.raises(ValueError):
+        compare_months(ROWS, "2026-13")
+    with pytest.raises(ValueError):
+        compare_months(ROWS, "2026-11", previous_month="2026/10")
+
+
+def test_format_comparison():
+    out = format_comparison(compare_months(ROWS, "2026-11"))
+    assert out == (
+        "2026-10 → 2026-11\n"
+        "カテゴリ\t前月\t今月\t増減\t増減率\t状態\n"
+        "travel\t0\t20,000\t+20,000\t新規\t新規\n"
+        "hobby\t5,000\t0\t-5,000\t-100.0%\tなし\n"
+        "food\t2,000\t3,000\t+1,000\t+50.0%\t増\n"
+        "rent\t80,000\t80,000\t+0\t+0.0%\t横ばい\n"
+        "TOTAL\t87,000\t103,000\t+16,000\t+18.4%\t\n"
+    )
+
+
+def test_format_with_no_previous_total():
+    out = format_comparison(compare_months([E("2026-11-01", "x", 10)], "2026-11"))
+    assert out.splitlines()[-1] == "TOTAL\t0\t10\t+10\t-\t"
