+++ b/tests/test_recurring.py
@@ -0,0 +1,144 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import find_recurring, normalize_memo
+
+
+def E(d: str, cat: str, amount: int, memo: str = "") -> Expense:
+    return Expense(date.fromisoformat(d), cat, amount, memo)
+
+
+def test_detects_monthly_subscription_and_predicts_next():
+    rows = [
+        E("2026-08-05", "subscription", 1490, "Netflix"),
+        E("2026-09-05", "subscription", 1490, "Netflix"),
+        E("2026-10-06", "subscription", 1490, "Netflix"),
+        E("2026-11-05", "subscription", 1490, "Netflix"),
+        E("2026-11-07", "food", 800, "coffee"),
+    ]
+    [r] = find_recurring(rows)
+    assert (r.category, r.memo, r.amount, r.day_of_month) == (
+        "subscription",
+        "Netflix",
+        1490,
+        5,
+    )
+    assert r.last_date == date(2026, 11, 5)
+    assert r.next_date == date(2026, 12, 5)
+    assert len(r.occurrences) == 4
+
+
+def test_needs_min_months():
+    rows = [E("2026-10-25", "rent", 80000), E("2026-11-25", "rent", 80000)]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_months=2)) == 1
+
+
+def test_gap_in_months_uses_only_latest_run():
+    rows = [
+        E("2026-03-01", "gym", 5000),
+        E("2026-04-01", "gym", 5000),
+        E("2026-05-01", "gym", 5000),
+        # paused June..August
+        E("2026-09-01", "gym", 5000),
+        E("2026-10-01", "gym", 5000),
+    ]
+    assert find_recurring(rows) == []
+    rows.append(E("2026-11-01", "gym", 5000))
+    [r] = find_recurring(rows)
+    assert [e.day.month for e in r.occurrences] == [9, 10, 11]
+
+
+def test_multiple_rows_in_a_month_is_not_monthly():
+    rows = [
+        E(f"2026-{m:02d}-{d:02d}", "food", 500, "lunch")
+        for m in (9, 10, 11)
+        for d in (3, 17)
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_unstable_day_or_amount_is_rejected():
+    days = [
+        E("2026-09-01", "x", 100),
+        E("2026-10-15", "x", 100),
+        E("2026-11-01", "x", 100),
+    ]
+    assert find_recurring(days) == []
+    amounts = [
+        E("2026-09-01", "x", 100),
+        E("2026-10-01", "x", 300),
+        E("2026-11-01", "x", 100),
+    ]
+    assert find_recurring(amounts) == []
+
+
+def test_tolerances_are_configurable():
+    rows = [
+        E("2026-09-20", "utility", 6000, "電気"),
+        E("2026-10-22", "utility", 7500, "電気"),
+        E("2026-11-19", "utility", 6500, "電気"),
+    ]
+    assert find_recurring(rows) == []
+    [r] = find_recurring(rows, amount_tolerance=0.2)
+    assert r.amount == 6500
+    assert r.next_date == date(2026, 12, 20)
+
+
+def test_month_end_billing_is_clamped():
+    rows = [
+        E("2026-12-31", "rent", 80000),
+        E("2027-01-31", "rent", 80000),
+        E("2027-02-28", "rent", 80000),
+        E("2027-03-31", "rent", 80000),
+    ]
+    [r] = find_recurring(rows, day_tolerance=0)
+    assert r.day_of_month == 31
+    assert r.next_date == date(2027, 4, 30)
+
+
+def test_year_boundary_counts_as_consecutive():
+    rows = [E("2026-11-10", "x", 1), E("2026-12-10", "x", 1), E("2027-01-10", "x", 1)]
+    [r] = find_recurring(rows)
+    assert r.next_date == date(2027, 2, 10)
+
+
+def test_memo_is_normalized_for_grouping():
+    rows = [
+        E("2026-09-03", "sub", 980, "Spotify"),
+        E("2026-10-03", "sub", 980, "ＳＰＯＴＩＦＹ "),
+        E("2026-11-03", "sub", 980, "spotify"),
+    ]
+    [r] = find_recurring(rows)
+    assert r.memo == "spotify"
+    assert normalize_memo(" Ａ  b ") == "a b"
+
+
+def test_custom_key_groups_by_category_only():
+    rows = [
+        E("2026-09-27", "card", 3000, "ref 001"),
+        E("2026-10-27", "card", 3000, "ref 002"),
+        E("2026-11-27", "card", 3000, "ref 003"),
+    ]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, key=lambda e: e.category)) == 1
+
+
+def test_sorted_by_next_date():
+    rows = []
+    for m in (9, 10, 11):
+        rows.append(E(f"2026-{m:02d}-25", "rent", 80000))
+        rows.append(E(f"2026-{m:02d}-05", "sub", 1000))
+    assert [r.category for r in find_recurring(reversed(rows))] == ["sub", "rent"]
+
+
+def test_invalid_parameters():
+    with pytest.raises(ValueError):
+        find_recurring([], min_months=1)
+    with pytest.raises(ValueError):
+        find_recurring([], day_tolerance=-1)
+    with pytest.raises(ValueError):
+        find_recurring([], amount_tolerance=-0.1)
+    assert find_recurring([]) == []
