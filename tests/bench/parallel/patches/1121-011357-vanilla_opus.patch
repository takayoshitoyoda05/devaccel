diff --git a/src/kakeibo/_month.py b/src/kakeibo/_month.py
new file mode 100644
index 0000000..e6c51f0
--- /dev/null
+++ b/src/kakeibo/_month.py
@@ -0,0 +1,41 @@
+"""Small month arithmetic helpers shared by the analysis modules."""
+
+from __future__ import annotations
+
+import calendar
+import re
+from datetime import date
+
+_MONTH_RE = re.compile(r"([0-9]{4})-(0[1-9]|1[0-2])")
+
+
+def parse_month(text: str) -> tuple[int, int]:
+    """'YYYY-MM' -> (year, month). Raises ValueError on anything else."""
+    m = _MONTH_RE.fullmatch(text)
+    if m is None:
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {text!r}")
+    return int(m.group(1)), int(m.group(2))
+
+
+def format_month(year: int, month: int) -> str:
+    return f"{year:04d}-{month:02d}"
+
+
+def shift_month(year: int, month: int, n: int) -> tuple[int, int]:
+    """Move n months forward (negative n moves backward)."""
+    index = year * 12 + (month - 1) + n
+    return index // 12, index % 12 + 1
+
+
+def month_index(d: date) -> int:
+    """Monotonic month number, so consecutive months differ by exactly 1."""
+    return d.year * 12 + (d.month - 1)
+
+
+def last_day(year: int, month: int) -> int:
+    return calendar.monthrange(year, month)[1]
+
+
+def clamp_day(year: int, month: int, day: int) -> date:
+    """date(year, month, day), with day clipped to the month's last day (31 -> 28 in Feb)."""
+    return date(year, month, min(day, last_day(year, month)))
diff --git a/src/kakeibo/compare.py b/src/kakeibo/compare.py
new file mode 100644
index 0000000..1dd4771
--- /dev/null
+++ b/src/kakeibo/compare.py
@@ -0,0 +1,120 @@
+"""Month-over-month comparison per category."""
+
+from __future__ import annotations
+
+from collections.abc import Iterable
+from dataclasses import dataclass
+from typing import Literal
+
+from kakeibo._month import format_month, parse_month, shift_month
+from kakeibo.core import Expense, monthly_totals
+
+Status = Literal["new", "gone", "up", "down", "same"]
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    in_previous: bool  # category had rows in the previous month
+    in_current: bool  # category had rows in the current month
+
+    @property
+    def diff(self) -> int:
+        return self.current - self.previous
+
+    @property
+    def pct(self) -> float | None:
+        """Change in percent of the previous month; None when the previous amount is 0."""
+        if self.previous == 0:
+            return None
+        return self.diff / abs(self.previous) * 100
+
+    @property
+    def status(self) -> Status:
+        if not self.in_previous:
+            return "new"
+        if not self.in_current:
+            return "gone"
+        if self.diff > 0:
+            return "up"
+        if self.diff < 0:
+            return "down"
+        return "same"
+
+
+@dataclass(frozen=True)
+class MonthComparison:
+    month: str
+    previous_month: str
+    changes: tuple[CategoryChange, ...]  # biggest absolute change first, then name
+
+    @property
+    def previous_total(self) -> int:
+        return sum(c.previous for c in self.changes)
+
+    @property
+    def current_total(self) -> int:
+        return sum(c.current for c in self.changes)
+
+    @property
+    def diff(self) -> int:
+        return self.current_total - self.previous_total
+
+    def by_status(self, status: Status) -> list[CategoryChange]:
+        return [c for c in self.changes if c.status == status]
+
+
+def compare_months(
+    rows: Iterable[Expense], month: str, previous_month: str | None = None
+) -> MonthComparison:
+    """Compare category totals of ``month`` ('YYYY-MM') against ``previous_month``
+    (default: the calendar month before). Months with no rows count as all-zero.
+    """
+    y, m = parse_month(month)
+    if previous_month is None:
+        previous_month = format_month(*shift_month(y, m, -1))
+    else:
+        parse_month(previous_month)
+    totals = monthly_totals(list(rows))
+    prev = totals.get(previous_month, {})
+    cur = totals.get(month, {})
+    changes = [
+        CategoryChange(cat, prev.get(cat, 0), cur.get(cat, 0), cat in prev, cat in cur)
+        for cat in prev.keys() | cur.keys()
+    ]
+    changes.sort(key=lambda c: (-abs(c.diff), c.category))
+    return MonthComparison(month, previous_month, tuple(changes))
+
+
+_LABEL: dict[Status, str] = {
+    "new": "新規",
+    "gone": "なし",
+    "up": "増",
+    "down": "減",
+    "same": "横ばい",
+}
+
+
+def _pct_text(c: CategoryChange) -> str:
+    if c.status == "new":
+        return "新規"
+    pct = c.pct
+    return "-" if pct is None else f"{pct:+.1f}%"
+
+
+def format_comparison(cmp: MonthComparison) -> str:
+    """Tab-separated report: category, previous, current, diff, rate, status. Ends with TOTAL."""
+    lines = [
+        f"{cmp.previous_month} → {cmp.month}",
+        "カテゴリ\t前月\t今月\t増減\t増減率\t状態",
+    ]
+    for c in cmp.changes:
+        lines.append(
+            f"{c.category}\t{c.previous:,}\t{c.current:,}\t{c.diff:+,}\t{_pct_text(c)}\t{_LABEL[c.status]}"
+        )
+    prev_t, cur_t = cmp.previous_total, cmp.current_total
+    rate = f"{(cur_t - prev_t) / abs(prev_t) * 100:+.1f}%" if prev_t else "-"
+    lines.append(f"TOTAL\t{prev_t:,}\t{cur_t:,}\t{cur_t - prev_t:+,}\t{rate}\t")
+    return "\n".join(lines) + "\n"
diff --git a/src/kakeibo/importer.py b/src/kakeibo/importer.py
new file mode 100644
index 0000000..d8d669b
--- /dev/null
+++ b/src/kakeibo/importer.py
@@ -0,0 +1,388 @@
+"""Import bank / credit-card CSV exports with varying headers and amount formats.
+
+Pure functions on text: reading the file (and picking its encoding) is the
+caller's job; ``decode_csv_bytes`` helps with the usual UTF-8 / Shift_JIS mix.
+
+What is understood
+- Header names: Japanese/English aliases (日付, ご利用日, 金額, 出金, 摘要, ...),
+  compared after NFKC + casefold + whitespace removal. ``columns`` overrides them.
+- Preamble lines before the header (account info etc.) are skipped: the header
+  is the first row, within ``header_search_rows``, that has a date and an amount column.
+- Amounts: ``1,200`` ``¥1,200`` ``\\1,200`` ``1200円`` full-width digits,
+  ``-1200`` ``▲1200`` ``△1200`` ``(1,200)`` and ``1200.00``.
+- Dates: ``2026-11-01`` ``2026/11/1`` ``2026.11.01`` ``2026年11月1日`` ``20261101``,
+  optionally followed by a time (``2026/11/01 12:34``).
+- Separate withdrawal/deposit columns (出金/入金): withdrawals become expenses,
+  deposit-only rows are reported in ``skipped``.
+
+Bad rows never abort the import: each becomes a ``RowIssue`` in ``errors`` with
+the physical line number, the column, the raw value and the reason.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from collections.abc import Mapping
+from dataclasses import dataclass, field
+from datetime import date
+from typing import Literal
+
+from kakeibo.core import Expense
+
+Sign = Literal["expense_positive", "expense_negative"]
+
+# Field -> accepted header names (normalized with _norm_header before comparing).
+ALIASES: dict[str, tuple[str, ...]] = {
+    "date": (
+        "date",
+        "transaction date",
+        "日付",
+        "年月日",
+        "利用日",
+        "ご利用日",
+        "利用年月日",
+        "ご利用年月日",
+        "取引日",
+        "お取引日",
+        "取扱日",
+        "取引日付",
+    ),
+    "amount": (
+        "amount",
+        "金額",
+        "利用金額",
+        "ご利用金額",
+        "支払金額",
+        "お支払金額",
+        "支払額",
+        "取引金額",
+        "請求金額",
+        "ご請求金額",
+    ),
+    "withdrawal": (
+        "withdrawal",
+        "debit",
+        "出金",
+        "出金額",
+        "お引出し",
+        "引出額",
+        "お支払",
+        "支払",
+    ),
+    "deposit": (
+        "deposit",
+        "credit",
+        "入金",
+        "入金額",
+        "お預入れ",
+        "預入額",
+        "お預り金額",
+        "預り金額",
+        "お預かり金額",
+    ),
+    "category": ("category", "カテゴリ", "カテゴリー", "費目", "分類"),
+    "memo": (
+        "memo",
+        "description",
+        "摘要",
+        "内容",
+        "備考",
+        "取引内容",
+        "店名",
+        "利用店名",
+        "ご利用店名",
+        "利用先",
+        "ご利用先",
+        "利用店名・商品名",
+        "ご利用店名・商品名",
+    ),
+}
+FIELDS = tuple(ALIASES)
+
+
+@dataclass(frozen=True)
+class RowIssue:
+    line: int  # physical line number in the input (1-based)
+    column: str | None  # header name as written in the file, None for row-level issues
+    value: str
+    reason: str
+
+    def __str__(self) -> str:
+        where = f"{self.line}行目" + (f" [{self.column}]" if self.column else "")
+        return f"{where}: {self.reason}" + (f" ({self.value!r})" if self.value else "")
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowIssue]
+    skipped: list[RowIssue]  # valid but not expenses (deposits / income)
+    header_line: int
+    columns: dict[str, str] = field(default_factory=dict)  # field -> header used
+
+    @property
+    def ok(self) -> bool:
+        return not self.errors
+
+
+class ImportFormatError(ValueError):
+    """The input as a whole cannot be read (no recognizable header, bad options)."""
+
+
+# ---------------------------------------------------------------- value parsers
+
+_NEGATIVE_MARKS = ("-", "−", "▲", "△")
+_AMOUNT_RE = re.compile(r"(\d{1,3}(?:,\d{3})+|\d+)(?:\.(\d+))?")
+
+
+def parse_amount(text: str) -> int:
+    """Parse a yen amount written in any of the common bank/card styles.
+
+    Raises ValueError with a human-readable (Japanese) reason.
+    """
+    s = "".join(unicodedata.normalize("NFKC", text).split())
+    if not s:
+        raise ValueError("金額が空です")
+    negative = False
+    if s.startswith("(") and s.endswith(")"):
+        negative, s = True, s[1:-1]
+    s = s.removesuffix("円")
+    # The sign may come before or after the currency mark: -¥1,200 / ¥-1,200.
+    currency_seen = False
+    while True:
+        if s.startswith(_NEGATIVE_MARKS) and not negative:
+            negative, s = True, s[1:]
+        elif s.startswith(("¥", "\\")) and not currency_seen:
+            currency_seen, s = True, s[1:]
+        elif s.upper().startswith("JPY") and not currency_seen:
+            currency_seen, s = True, s[3:]
+        else:
+            break
+    m = _AMOUNT_RE.fullmatch(s)
+    if m is None:
+        raise ValueError("金額として読めません")
+    whole, frac = m.group(1), m.group(2)
+    if frac and frac.strip("0"):
+        raise ValueError("円未満の端数があります")
+    value = int(whole.replace(",", ""))
+    return -value if negative else value
+
+
+_DATE_RES = (
+    re.compile(r"(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})"),
+    re.compile(r"(\d{4})年(\d{1,2})月(\d{1,2})日"),
+    re.compile(r"(\d{4})(\d{2})(\d{2})"),
+)
+_TIME_RE = re.compile(r"\d{1,2}:\d{2}(?::\d{2})?")
+
+
+def parse_date(text: str) -> date:
+    """Parse common Japanese bank/card date styles. Raises ValueError with a reason."""
+    s = unicodedata.normalize("NFKC", text).strip()
+    if not s:
+        raise ValueError("日付が空です")
+    head, _, rest = s.partition(" ")
+    if rest and not _TIME_RE.fullmatch(rest.strip()):
+        raise ValueError("日付として読めません")
+    if "T" in head:
+        head, _, t = head.partition("T")
+        if not _TIME_RE.fullmatch(t):
+            raise ValueError("日付として読めません")
+    for rx in _DATE_RES:
+        m = rx.fullmatch(head)
+        if m is None:
+            continue
+        try:
+            return date(int(m.group(1)), int(m.group(2)), int(m.group(3)))
+        except ValueError:
+            raise ValueError("存在しない日付です") from None
+    raise ValueError("日付として読めません")
+
+
+def decode_csv_bytes(data: bytes) -> str:
+    """Decode a CSV export: UTF-8 (with or without BOM) first, then Shift_JIS (cp932)."""
+    try:
+        return data.decode("utf-8-sig")
+    except UnicodeDecodeError:
+        return data.decode("cp932")
+
+
+# ---------------------------------------------------------------- header handling
+
+
+def _norm_header(name: str) -> str:
+    return "".join(unicodedata.normalize("NFKC", name).lstrip("﻿").casefold().split())
+
+
+_ALIAS_INDEX = {_norm_header(a): f for f, names in ALIASES.items() for a in names}
+
+
+def _resolve(
+    header: list[str], columns: Mapping[str, str] | None
+) -> dict[str, int] | None:
+    """field -> column index, or None if this row is not a usable header."""
+    normed = [_norm_header(h) for h in header]
+    found: dict[str, int] = {}
+    if columns is not None:
+        for fld, name in columns.items():
+            try:
+                found[fld] = normed.index(_norm_header(name))
+            except ValueError:
+                return None
+    for i, h in enumerate(normed):
+        fld = _ALIAS_INDEX.get(h)
+        if fld is not None and fld not in found and i not in found.values():
+            found[fld] = i
+    if "date" not in found or not ({"amount", "withdrawal"} & found.keys()):
+        return None
+    return found
+
+
+# ---------------------------------------------------------------- main entry
+
+
+def import_bank_csv(
+    text: str,
+    *,
+    columns: Mapping[str, str] | None = None,
+    sign: Sign = "expense_positive",
+    default_category: str = "未分類",
+    delimiter: str = ",",
+    header_search_rows: int = 10,
+) -> ImportResult:
+    """Parse a bank/card CSV export into Expenses, collecting per-row problems.
+
+    columns: explicit ``{field: header name}`` for fields in FIELDS; takes
+        priority over the built-in aliases (the rest are still auto-detected).
+    sign: meaning of a single signed amount column.
+        "expense_positive" (credit cards): positive = spending, negative = refund
+            (kept as a negative expense).
+        "expense_negative" (bank statements): negative = spending (stored positive),
+            positive = income (reported in ``skipped``).
+        Ignored when separate withdrawal/deposit columns exist.
+    default_category: used when there is no category column or the cell is empty.
+    """
+    if columns is not None:
+        unknown = set(columns) - set(FIELDS)
+        if unknown:
+            raise ImportFormatError(f"未知の項目名です: {', '.join(sorted(unknown))}")
+    if sign not in ("expense_positive", "expense_negative"):
+        raise ImportFormatError(f"sign が不正です: {sign!r}")
+
+    reader = csv.reader(io.StringIO(text), delimiter=delimiter)
+    prev_line = 0
+    header_line = 0
+    cols: dict[str, int] | None = None
+    header: list[str] = []
+    seen: list[list[str]] = []
+    for row in reader:
+        line, prev_line = prev_line + 1, reader.line_num
+        if not any(c.strip() for c in row):
+            continue
+        cols = _resolve(row, columns)
+        if cols is not None:
+            header, header_line = row, line
+            break
+        seen.append(row)
+        if len(seen) >= header_search_rows:
+            break
+    if cols is None:
+        hint = f" 先頭行: {seen[0]}" if seen else " (入力が空です)"
+        raise ImportFormatError("日付と金額の列を含むヘッダ行が見つかりません。" + hint)
+
+    split_mode = "deposit" in cols
+    expense_col = cols.get("amount", cols.get("withdrawal"))
+    assert expense_col is not None  # guaranteed by _resolve
+
+    expenses: list[Expense] = []
+    errors: list[RowIssue] = []
+    skipped: list[RowIssue] = []
+
+    def cell(row: list[str], idx: int) -> str:
+        return row[idx].strip() if idx < len(row) else ""
+
+    for row in reader:
+        line, prev_line = prev_line + 1, reader.line_num
+        if not any(c.strip() for c in row):
+            continue
+        row_errors: list[RowIssue] = []
+
+        raw_date = cell(row, cols["date"])
+        day: date | None = None
+        try:
+            day = parse_date(raw_date)
+        except ValueError as e:
+            row_errors.append(RowIssue(line, header[cols["date"]], raw_date, str(e)))
+
+        raw_amount = cell(row, expense_col)
+        amount: int | None = None
+        skip_reason: str | None = None
+        amount_col_name = header[expense_col]
+        if split_mode:
+            raw_dep = cell(row, cols["deposit"])
+            if raw_amount and raw_dep:
+                row_errors.append(
+                    RowIssue(
+                        line,
+                        None,
+                        f"{raw_amount} / {raw_dep}",
+                        "出金と入金の両方に値があります",
+                    )
+                )
+            elif raw_amount:
+                try:
+                    amount = parse_amount(raw_amount)
+                except ValueError as e:
+                    row_errors.append(
+                        RowIssue(line, amount_col_name, raw_amount, str(e))
+                    )
+            elif raw_dep:
+                try:
+                    parse_amount(raw_dep)
+                    skip_reason = "入金のため取り込み対象外"
+                except ValueError as e:
+                    row_errors.append(
+                        RowIssue(line, header[cols["deposit"]], raw_dep, str(e))
+                    )
+            else:
+                row_errors.append(
+                    RowIssue(line, None, "", "出金・入金のどちらにも金額がありません")
+                )
+        else:
+            try:
+                value = parse_amount(raw_amount)
+                if sign == "expense_negative":
+                    if value > 0:
+                        skip_reason = "正の金額(入金)のため取り込み対象外"
+                    else:
+                        amount = -value
+                else:
+                    amount = value
+            except ValueError as e:
+                row_errors.append(RowIssue(line, amount_col_name, raw_amount, str(e)))
+
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        if skip_reason is not None:
+            skipped.append(
+                RowIssue(
+                    line, None, raw_amount or cell(row, cols["deposit"]), skip_reason
+                )
+            )
+            continue
+        assert day is not None and amount is not None
+        category = cell(row, cols["category"]) if "category" in cols else ""
+        memo = cell(row, cols["memo"]) if "memo" in cols else ""
+        expenses.append(Expense(day, category or default_category, amount, memo))
+
+    return ImportResult(
+        expenses=expenses,
+        errors=errors,
+        skipped=skipped,
+        header_line=header_line,
+        columns={f: header[i] for f, i in cols.items()},
+    )
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..63a914c
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,106 @@
+"""Composable filters for searching expenses.
+
+    from kakeibo.query import category, amount_between, memo_contains, date_between, search
+
+    q = (category("food") | category("cafe")) & amount_between(min=500) & ~memo_contains("refund")
+    hits = search(rows, q)
+
+``&`` / ``|`` / ``~`` (or ``all_of`` / ``any_of`` / ``not_``) combine filters.
+All bounds are inclusive.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable, Iterable
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Filter:
+    test: Callable[[Expense], bool]
+    description: str
+
+    def __call__(self, e: Expense) -> bool:
+        return self.test(e)
+
+    def __and__(self, other: Filter) -> Filter:
+        return all_of(self, other)
+
+    def __or__(self, other: Filter) -> Filter:
+        return any_of(self, other)
+
+    def __invert__(self) -> Filter:
+        return not_(self)
+
+    def __str__(self) -> str:
+        return self.description
+
+
+def category(*names: str) -> Filter:
+    """Category equals one of names (exact match, like the CLI's --category)."""
+    if not names:
+        raise ValueError("category() にはカテゴリ名が1つ以上必要です")
+    wanted = frozenset(names)
+    return Filter(lambda e: e.category in wanted, f"category in {sorted(wanted)}")
+
+
+def amount_between(min: int | None = None, max: int | None = None) -> Filter:
+    """min <= amount <= max; either bound may be omitted."""
+    if min is not None and max is not None and min > max:
+        raise ValueError(f"金額の範囲が逆です: {min} > {max}")
+    lo, hi = min, max
+    return Filter(
+        lambda e: (lo is None or e.amount >= lo) and (hi is None or e.amount <= hi),
+        f"amount in [{'' if lo is None else lo}, {'' if hi is None else hi}]",
+    )
+
+
+def memo_contains(text: str, *, ignore_case: bool = False) -> Filter:
+    """Memo contains text (substring). Case-sensitive by default, like --memo."""
+    if ignore_case:
+        needle = text.casefold()
+        return Filter(
+            lambda e: needle in e.memo.casefold(),
+            f"memo contains {text!r} (ignore case)",
+        )
+    return Filter(lambda e: text in e.memo, f"memo contains {text!r}")
+
+
+def date_between(start: date | None = None, end: date | None = None) -> Filter:
+    """start <= day <= end; either bound may be omitted."""
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"期間が逆です: {start} > {end}")
+    return Filter(
+        lambda e: (start is None or e.day >= start) and (end is None or e.day <= end),
+        f"date in [{start or ''}, {end or ''}]",
+    )
+
+
+def all_of(*filters: Filter) -> Filter:
+    """AND. With no filters, matches everything."""
+    return Filter(
+        lambda e: all(f(e) for f in filters),
+        "(" + " AND ".join(map(str, filters)) + ")" if filters else "ALL",
+    )
+
+
+def any_of(*filters: Filter) -> Filter:
+    """OR. With no filters, matches nothing."""
+    return Filter(
+        lambda e: any(f(e) for f in filters),
+        "(" + " OR ".join(map(str, filters)) + ")" if filters else "NONE",
+    )
+
+
+def not_(f: Filter) -> Filter:
+    return Filter(lambda e: not f(e), f"NOT {f}")
+
+
+def search(rows: Iterable[Expense], where: Filter | None = None) -> list[Expense]:
+    """Rows matching ``where`` (all rows if None), keeping the input order."""
+    if where is None:
+        return list(rows)
+    return [e for e in rows if where(e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..369bdb3
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,122 @@
+"""Detect monthly recurring expenses (subscriptions, rent, ...) and predict the next one.
+
+Rows are grouped by (category, normalized memo). A group counts as monthly
+recurring when its most recent run of *consecutive* months has exactly one
+row per month, at least ``min_months`` long, with a stable day of month and a
+stable amount. Only that latest run is used, so a subscription that was
+paused and resumed is judged on its current streak.
+
+Everything here is a pure function of the given rows; nothing reads the clock.
+"""
+
+from __future__ import annotations
+
+import statistics
+import unicodedata
+from collections.abc import Callable, Hashable, Iterable
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo._month import clamp_day, month_index, shift_month
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str  # memo of the latest occurrence
+    amount: int  # typical amount (median of the run)
+    day_of_month: int  # typical day (median of the run; clipped in short months)
+    occurrences: tuple[Expense, ...]  # the consecutive monthly run, oldest first
+
+    @property
+    def last_date(self) -> date:
+        return self.occurrences[-1].day
+
+    @property
+    def next_date(self) -> date:
+        """Expected date of the next charge: the month after the last one, on the usual day."""
+        y, m = shift_month(self.last_date.year, self.last_date.month, 1)
+        return clamp_day(y, m, self.day_of_month)
+
+
+def normalize_memo(memo: str) -> str:
+    """Width/case/whitespace-insensitive form, so 'Ｎｅｔｆｌｉｘ ' == 'netflix'."""
+    return " ".join(unicodedata.normalize("NFKC", memo).casefold().split())
+
+
+def _default_key(e: Expense) -> Hashable:
+    return (e.category, normalize_memo(e.memo))
+
+
+def _latest_monthly_run(rows: list[Expense]) -> list[Expense]:
+    """Longest suffix of consecutive months with exactly one row each (rows sorted by day)."""
+    by_month: dict[int, list[Expense]] = {}
+    for e in rows:
+        by_month.setdefault(month_index(e.day), []).append(e)
+    run: list[Expense] = []
+    month = max(by_month)
+    while month in by_month and len(by_month[month]) == 1:
+        run.append(by_month[month][0])
+        month -= 1
+    run.reverse()
+    return run
+
+
+def _is_stable(run: list[Expense], day_tolerance: int, amount_tolerance: float) -> bool:
+    anchor_day = statistics.median_low(e.day.day for e in run)
+    for e in run:
+        expected = clamp_day(e.day.year, e.day.month, anchor_day)
+        if abs(e.day.day - expected.day) > day_tolerance:
+            return False
+    typical = statistics.median_low(e.amount for e in run)
+    return all(abs(e.amount - typical) <= abs(typical) * amount_tolerance for e in run)
+
+
+def find_recurring(
+    rows: Iterable[Expense],
+    *,
+    min_months: int = 3,
+    day_tolerance: int = 3,
+    amount_tolerance: float = 0.1,
+    key: Callable[[Expense], Hashable] | None = None,
+) -> list[Recurring]:
+    """Monthly recurring expenses, sorted by next expected date then category.
+
+    min_months: required length of the consecutive monthly run (>= 2).
+    day_tolerance: allowed distance in days from the usual day of month.
+    amount_tolerance: allowed relative deviation from the typical amount (0.1 = ±10%).
+    key: grouping key; defaults to (category, normalized memo). Pass e.g.
+         ``lambda e: e.category`` when memos carry varying reference numbers.
+    """
+    if min_months < 2:
+        raise ValueError("min_months は 2 以上である必要があります")
+    if day_tolerance < 0:
+        raise ValueError("day_tolerance は 0 以上である必要があります")
+    if amount_tolerance < 0:
+        raise ValueError("amount_tolerance は 0 以上である必要があります")
+    key_fn = key or _default_key
+
+    groups: dict[Hashable, list[Expense]] = {}
+    for e in rows:
+        groups.setdefault(key_fn(e), []).append(e)
+
+    found: list[Recurring] = []
+    for group in groups.values():
+        group.sort(key=lambda e: e.day)
+        run = _latest_monthly_run(group)
+        if len(run) < min_months or not _is_stable(
+            run, day_tolerance, amount_tolerance
+        ):
+            continue
+        found.append(
+            Recurring(
+                category=run[-1].category,
+                memo=run[-1].memo,
+                amount=statistics.median_low(e.amount for e in run),
+                day_of_month=statistics.median_low(e.day.day for e in run),
+                occurrences=tuple(run),
+            )
+        )
+    found.sort(key=lambda r: (r.next_date, r.category, r.memo))
+    return found
diff --git a/tests/test_compare.py b/tests/test_compare.py
