@@ -122,6 +122,25 @@ def load_budget(path: Path) -> Budget:
     return Budget(default, months)
 
 
+def budget_alerts(
+    totals: dict[str, dict[str, int]], budget: Budget
+) -> list[tuple[str, str, str, int, int]]:
+    """(kind, month, category, limit, actual); kind is "over" (actual > limit)
+    or "near" (actual >= 90% of limit and not over)."""
+    out: list[tuple[str, str, str, int, int]] = []
+    for month, cats in totals.items():
+        limits = budget.for_month(month)
+        for cat, actual in cats.items():
+            if cat not in limits:
+                continue
+            limit = limits[cat]
+            if actual > limit:
+                out.append(("over", month, cat, limit, actual))
+            elif limit > 0 and actual * 10 >= limit * 9:
+                out.append(("near", month, cat, limit, actual))
+    return out
+
+
 def find_overruns(
     totals: dict[str, dict[str, int]], budget: Budget
 ) -> list[tuple[str, str, int, int, int]]:
