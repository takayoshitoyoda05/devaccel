+"""金額文字列を円の整数に解析する純粋関数。副作用なし・標準ライブラリのみ。"""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+
+_CURRENCY = ("¥", "円", "JPY")
+_NEGATIVE_SIGNS = ("-", "−", "△", "▲")
+_POSITIVE_SIGNS = ("+",)
+_PLAIN_INT = re.compile(r"[0-9]+")
+_GROUPED_INT = re.compile(r"[0-9]{1,3}(?:,[0-9]{3})+")
+
+
+def _strip_currency(text: str) -> str:
+    """先頭・末尾の通貨記号を、取れなくなるまで除く。"""
+    changed = True
+    while changed:
+        changed = False
+        text = text.strip()
+        for cur in _CURRENCY:
+            if text.startswith(cur):
+                text = text[len(cur) :]
+                changed = True
+            if text.endswith(cur):
+                text = text[: -len(cur)]
+                changed = True
+    return text.strip()
+
+
+def parse_amount(s: str) -> int:
+    """金額文字列を円の整数に変換する。負数は負の整数で返す。
+
+    受け付ける形: ``-300`` ``−300`` ``△500`` ``▲500`` ``(500)`` ``500-`` ``+500``。
+    通貨記号 (¥ ￥ 円 JPY) と桁区切り (, ，) は無視する。
+    小数・空文字・数字を含まない値・符号の重複・不正な桁区切りは ValueError。
+    """
+    raw = s
+    # NFKC で全角数字・全角記号・全角空白を半角にそろえる (￥ も ¥ になる)
+    text = unicodedata.normalize("NFKC", s)
+    text = _strip_currency(text)
+
+    negative = False
+    signs = 0
+    if text.startswith("(") and text.endswith(")"):
+        negative = True
+        signs += 1
+        text = text[1:-1].strip()
+    elif text[:1] in _NEGATIVE_SIGNS + _POSITIVE_SIGNS:
+        if text[0] in _NEGATIVE_SIGNS:
+            negative = True
+        signs += 1
+        text = text[1:].strip()
+    if text.endswith("-"):
+        negative = True
+        signs += 1
+        text = text[:-1].strip()
+    if signs > 1:
+        raise ValueError(f"符号が重複しています: {raw!r}")
+
+    if "." in text:
+        raise ValueError(f"円の整数のみ扱えます (小数不可): {raw!r}")
+    pattern = _GROUPED_INT if "," in text else _PLAIN_INT
+    if pattern.fullmatch(text) is None:
+        raise ValueError(f"金額として解釈できません: {raw!r}")
+
+    value = int(text.replace(",", ""))
+    return -value if negative else value
diff --git a/src/kakeibo/bank_import.py b/src/kakeibo/bank_import.py
