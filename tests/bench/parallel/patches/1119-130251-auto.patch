+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthly_diff import CategoryDelta, compare_months, format_diff
+
+
+def E(m: int, cat: str, amt: int, y: int = 2026) -> Expense:
+    return Expense(date(y, m, 1), cat, amt)
+
+
+def test_e5_1_increase():
+    d = compare_months([E(1, "食費", 30000), E(2, "食費", 33000)], "2026-02")
+    assert d == [CategoryDelta("食費", 30000, 33000, 3000, 10.0, "増")]
+
+
+def test_e5_2_vanished():
+    d = compare_months([E(1, "交通費", 5000)], "2026-02")
+    assert d == [CategoryDelta("交通費", 5000, 0, -5000, -100.0, "消滅")]
+
+
+def test_e5_3_default_prev_crosses_year():
+    d = compare_months([E(12, "食費", 100, 2025), E(1, "食費", 50)], "2026-01")
+    assert d[0].prev == 100 and d[0].trend == "減"
+
+
+def test_new_category_pct_none():
+    d = compare_months([E(2, "趣味", 700)], "2026-02")
+    assert d == [CategoryDelta("趣味", 0, 700, 700, None, "新規")]
+
+
+def test_no_change_and_order():
+    rows = [E(1, "a", 100), E(2, "a", 100), E(1, "b", 10), E(2, "b", 20), E(2, "c", 10)]
+    d = compare_months(rows, "2026-02")
+    assert [x.category for x in d] == ["b", "c", "a"]
+    assert d[2].trend == "変化なし"
+
+
+def test_refund_negative_prev_uses_abs():
+    d = compare_months([E(1, "a", -100), E(2, "a", -50)], "2026-02")
+    assert d[0].diff == 50 and d[0].pct == 50.0
+
+
+def test_explicit_prev_and_empty():
+    assert compare_months([], "2026-02") == []
+    d = compare_months([E(1, "a", 10), E(3, "a", 20)], "2026-03", prev="2026-01")
+    assert d[0].diff == 10
+
+
+@pytest.mark.parametrize("bad", ["2026-13", "2026/02", "202602", ""])
+def test_bad_month(bad):
+    with pytest.raises(ValueError):
+        compare_months([], bad)
+    with pytest.raises(ValueError):
+        compare_months([], "2026-02", prev=bad)
+
+
+def test_format_diff():
+    assert format_diff([]) == "差分なし"
+    d = compare_months(
+        [E(1, "食費", 30000), E(2, "食費", 33000), E(2, "趣味", 5)], "2026-02"
+    )
+    assert (
+        format_diff(d)
+        == "食費: 30000 → 33000 (+3000円, +10.0%, 増)\n趣味: 0 → 5 (+5円, 新規)"
+    )
