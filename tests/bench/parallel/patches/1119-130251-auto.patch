+++ b/tests/test_recurring.py
@@ -0,0 +1,102 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import find_recurring
+
+
+def E(y, m, d, amt, cat="サブスク", memo="Netflix"):
+    return Expense(date(y, m, d), cat, amt, memo)
+
+
+def test_e4_1_month_end_clamped():
+    rows = [
+        E(2026, 1, 31, 80000, "家賃", ""),
+        E(2026, 2, 28, 80000, "家賃", ""),
+        E(2026, 3, 31, 80000, "家賃", ""),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.next_date == date(2026, 4, 30)
+    assert r.months == 3 and r.last_date == date(2026, 3, 31)
+
+
+def test_e4_2_gap_breaks_run():
+    assert (
+        find_recurring([E(2026, 1, 5, 990), E(2026, 2, 5, 990), E(2026, 4, 5, 990)])
+        == []
+    )
+
+
+def test_e4_3_december_rolls_year():
+    rows = [E(2026, 10, 5, 990), E(2026, 11, 5, 990), E(2026, 12, 5, 990)]
+    assert find_recurring(rows)[0].next_date == date(2027, 1, 5)
+
+
+def test_run_uses_latest_after_gap():
+    rows = [
+        E(2026, 1, 5, 990),
+        E(2026, 3, 5, 990),
+        E(2026, 4, 5, 990),
+        E(2026, 5, 5, 990),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.months == 3 and r.next_date == date(2026, 6, 5)
+
+
+def test_min_months_validation_and_empty():
+    assert find_recurring([]) == []
+    with pytest.raises(ValueError):
+        find_recurring([], min_months=1)
+    assert (
+        len(find_recurring([E(2026, 1, 5, 100), E(2026, 2, 5, 100)], min_months=2)) == 1
+    )
+
+
+def test_refunds_excluded():
+    rows = [E(2026, 1, 5, -990), E(2026, 2, 5, -990), E(2026, 3, 5, -990)]
+    assert find_recurring(rows) == []
+
+
+def test_same_month_duplicate_counts_once():
+    rows = [
+        E(2026, 1, 5, 990),
+        E(2026, 1, 5, 990),
+        E(2026, 1, 20, 990),
+        E(2026, 2, 5, 990),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_amount_fluctuation_within_10_percent():
+    rows = [E(2026, 1, 5, 1000), E(2026, 2, 5, 1050), E(2026, 3, 5, 1080)]
+    assert find_recurring(rows)[0].amount == 1080
+    rows = [E(2026, 1, 5, 1000), E(2026, 2, 5, 5000), E(2026, 3, 5, 1000)]
+    assert find_recurring(rows) == []  # 2 月が外れて連続が切れる
+
+
+def test_memo_trailing_number_and_normalization():
+    rows = [
+        E(2026, 1, 5, 500, "ｻﾌﾞｽｸ", "Gym #1"),
+        E(2026, 2, 5, 500, "サブスク", "gym #2"),
+        E(2026, 3, 5, 500, "サブスク", "GYM 2026年3月分"),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.memo == "GYM 2026年3月分" and r.months == 3
+
+
+def test_separate_groups_sorted():
+    rows = []
+    for m in (1, 2, 3):
+        rows += [E(2026, m, 20, 500, memo="B"), E(2026, m, 5, 900, memo="A")]
+    assert [r.memo for r in find_recurring(rows)] == ["A", "B"]
+
+
+def test_even_count_median_day_lower():
+    rows = [
+        E(2026, 1, 4, 100),
+        E(2026, 2, 6, 100),
+        E(2026, 3, 8, 100),
+        E(2026, 4, 10, 100),
+    ]
+    assert find_recurring(rows)[0].next_date == date(2026, 5, 6)
