+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    amount_between,
+    and_,
+    category_is,
+    date_between,
+    filter_expenses,
+    memo_contains,
+    not_,
+    or_,
+)
+
+ROWS = [
+    Expense(date(2026, 1, 5), "食費", 1200, "ランチ"),
+    Expense(date(2026, 1, 10), "交通費", 500, "ABC 定期"),
+    Expense(date(2026, 2, 1), "食費", 3000, "まとめ買い"),
+]
+
+
+def test_e3_1_memo_fullwidth_case_insensitive():
+    e = Expense(date(2026, 1, 1), "x", 1, "abc 月額")
+    assert memo_contains("ＡＢＣ")(e)
+
+
+def test_e3_2_amount_range_reversed():
+    with pytest.raises(ValueError):
+        amount_between(500, 100)
+
+
+def test_e3_3_empty_or_is_false():
+    assert filter_expenses(ROWS, or_()) == []
+
+
+def test_empty_and_is_true():
+    assert filter_expenses(ROWS, and_()) == ROWS
+
+
+def test_category_multiple_and_empty():
+    assert len(filter_expenses(ROWS, category_is("食費", "交通費"))) == 3
+    with pytest.raises(ValueError):
+        category_is()
+
+
+def test_amount_bounds_inclusive_and_open():
+    assert [e.amount for e in filter_expenses(ROWS, amount_between(500, 1200))] == [
+        1200,
+        500,
+    ]
+    assert len(filter_expenses(ROWS, amount_between(None, None))) == 3
+    assert len(filter_expenses(ROWS, amount_between(1200, None))) == 2
+
+
+def test_date_bounds_inclusive():
+    p = date_between(date(2026, 1, 5), date(2026, 1, 10))
+    assert len(filter_expenses(ROWS, p)) == 2
+    with pytest.raises(ValueError):
+        date_between(date(2026, 2, 1), date(2026, 1, 1))
+
+
+def test_empty_memo_rejected():
+    with pytest.raises(ValueError):
+        memo_contains("  ")
+
+
+def test_nested_logic_keeps_order_and_input():
+    snapshot = list(ROWS)
+    p = and_(
+        category_is("食費"),
+        or_(amount_between(None, 1500), memo_contains("買")),
+        not_(memo_contains("ランチ")),
+    )
+    assert filter_expenses(ROWS, p) == [ROWS[2]]
+    assert ROWS == snapshot
+
+
+def test_non_callable_raises():
+    with pytest.raises(TypeError):
+        filter_expenses(ROWS, "x")  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        and_("x")  # type: ignore[arg-type]
