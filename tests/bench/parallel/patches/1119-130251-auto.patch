--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,70 @@
+"""明細の条件検索。述語を組み合わせて絞り込む純粋関数。"""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from collections.abc import Callable
+from datetime import date
+
+from kakeibo.core import Expense
+
+Predicate = Callable[[Expense], bool]
+
+
+def normalize_text(s: str) -> str:
+    """NFKC・前後空白除去・連続空白を 1 つに・小文字化。"""
+    return re.sub(r"\s+", " ", unicodedata.normalize("NFKC", s)).strip().lower()
+
+
+def category_is(*names: str) -> Predicate:
+    if not names:
+        raise ValueError("category_is には 1 つ以上のカテゴリが必要です")
+    wanted = {normalize_text(n) for n in names}
+    return lambda e: normalize_text(e.category) in wanted
+
+
+def amount_between(lo: int | None, hi: int | None) -> Predicate:
+    if lo is not None and hi is not None and lo > hi:
+        raise ValueError(f"下限 {lo} が上限 {hi} より大きいです")
+    return lambda e: (lo is None or e.amount >= lo) and (hi is None or e.amount <= hi)
+
+
+def memo_contains(text: str) -> Predicate:
+    needle = normalize_text(text)
+    if not needle:
+        raise ValueError("memo_contains に空文字は指定できません")
+    return lambda e: needle in normalize_text(e.memo)
+
+
+def date_between(start: date | None, end: date | None) -> Predicate:
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"開始 {start} が終了 {end} より後です")
+    return lambda e: (start is None or e.day >= start) and (end is None or e.day <= end)
+
+
+def _check(preds: tuple[Predicate, ...]) -> None:
+    for p in preds:
+        if not callable(p):
+            raise TypeError(f"述語が callable ではありません: {p!r}")
+
+
+def and_(*preds: Predicate) -> Predicate:
+    _check(preds)
+    return lambda e: all(p(e) for p in preds)
+
+
+def or_(*preds: Predicate) -> Predicate:
+    _check(preds)
+    return lambda e: any(p(e) for p in preds)
+
+
+def not_(pred: Predicate) -> Predicate:
+    _check((pred,))
+    return lambda e: not pred(e)
+
+
+def filter_expenses(rows: list[Expense], pred: Predicate) -> list[Expense]:
+    if not callable(pred):
+        raise TypeError(f"述語が callable ではありません: {pred!r}")
+    return [e for e in rows if pred(e)]
