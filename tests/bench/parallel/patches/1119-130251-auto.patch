+"""Tests for kakeibo.amounts.parse_amount (spec: R1-R5, examples E1-*)."""
+
+import re
+
+import pytest
+
+from kakeibo.amounts import parse_amount
+
+# --- 例の表 (E1-*) ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param("▲１，２３４円", -1234, id="E1-1"),
+        pytest.param("(500)", -500, id="E1-2"),
+    ],
+)
+def test_examples_returning_int(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        pytest.param("12.5", id="E1-3"),
+    ],
+)
+def test_examples_raising(text: str) -> None:
+    with pytest.raises(ValueError, match=re.escape(text)):
+        parse_amount(text)
+
+
+# --- R1: 符号 --------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param("-300", -300, id="R1-hyphen-minus"),
+        pytest.param("−300", -300, id="R1-unicode-minus-U+2212"),
+        pytest.param("△500", -500, id="R1-triangle-minus"),
+        pytest.param("▲500", -500, id="R1-black-triangle-minus"),
+        pytest.param("(500)", -500, id="R1-parentheses"),
+        pytest.param("500-", -500, id="R1-trailing-minus"),
+        pytest.param("+500", 500, id="R1-plus"),
+    ],
+)
+def test_r1_sign_forms(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+# --- R2: 記号・桁区切り・空白・全角数字 --------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param("¥500", 500, id="R2-yen-sign"),
+        pytest.param("￥500", 500, id="R2-fullwidth-yen-sign"),
+        pytest.param("500円", 500, id="R2-yen-kanji-suffix"),
+        pytest.param("JPY500", 500, id="R2-JPY-prefix"),
+        pytest.param("1,000", 1000, id="R2-comma-separator"),
+        pytest.param("1，000", 1000, id="R2-fullwidth-comma-separator"),
+        pytest.param("1,234,567", 1234567, id="R2-multiple-separators"),
+        pytest.param("　500　", 500, id="R2-fullwidth-space-around"),
+        pytest.param("  500  ", 500, id="R2-halfwidth-space-around"),
+        pytest.param("５００", 500, id="R2-fullwidth-digits-NFKC"),
+    ],
+)
+def test_r2_symbols_and_normalization(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+# --- R3: 拒否 (ValueError, メッセージに元の文字列) ---------------------------
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        pytest.param("12.5", id="R3-decimal-point"),
+        pytest.param("12.0", id="R3-decimal-zero-rejected"),
+        pytest.param("12.50", id="R3-decimal-two-places-rejected"),
+        pytest.param("", id="R3-empty"),
+        pytest.param("   ", id="R3-whitespace-only"),
+        pytest.param("-", id="R3-minus-only"),
+        pytest.param("—", id="R3-em-dash-only"),
+        pytest.param("円", id="R3-no-digits-symbol-only"),
+        pytest.param("abc", id="R3-no-digits-letters"),
+    ],
+)
+def test_r3_rejects(text: str) -> None:
+    with pytest.raises(ValueError, match=re.escape(text)):
+        parse_amount(text)
+
+
+# --- R4: ゼロ ---------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param("0", 0, id="R4-zero"),
+        pytest.param("-0", 0, id="R4-negative-zero"),
+    ],
+)
+def test_r4_zero(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+# --- R5: 不正な形 (ValueError) ----------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        pytest.param("-(500)", id="R5-double-sign-parens"),
+        pytest.param("△-5", id="R5-double-sign-triangle"),
+        pytest.param("1 000", id="R5-space-inside-digits"),
+        pytest.param("1,2,3", id="R5-bad-separator-position"),
+    ],
+)
+def test_r5_invalid_forms(text: str) -> None:
+    with pytest.raises(ValueError, match=re.escape(text)):
+        parse_amount(text)
