@@ -0,0 +1,90 @@
+"""毎月決まって出ていく支出(サブスク・家賃など)の検出と次回予測。"""
+
+from __future__ import annotations
+
+import calendar
+import re
+import statistics
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.search import normalize_text
+
+_TRAILING_NUMBER = re.compile(r"(?:[\s#\-]+\d+(?:年\d+月分?|月分?)?)+$")
+_TOLERANCE = 0.10
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str  # 系列の最新のメモ原文
+    amount: int  # 最新の金額
+    months: int  # 系列の月数
+    last_date: date
+    next_date: date
+
+
+def _memo_key(memo: str) -> str:
+    return _TRAILING_NUMBER.sub("", normalize_text(memo)).strip()
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month - 1
+
+
+def _latest_run(items: list[Expense]) -> list[Expense]:
+    """月ごとに 1 件(最も早い日)にし、最新側の連続した月の列を返す。"""
+    by_month: dict[int, Expense] = {}
+    for e in items:
+        k = _month_index(e.day)
+        if k not in by_month or e.day < by_month[k].day:
+            by_month[k] = e
+    cands = list(by_month.values())  # D4
+    med = statistics.median(e.amount for e in cands)
+    cands = [e for e in cands if abs(e.amount - med) <= abs(med) * _TOLERANCE]  # D5
+    if not cands:
+        return []
+    cands.sort(key=lambda e: e.day)
+    run = [cands[-1]]
+    for e in reversed(cands[:-1]):
+        if _month_index(run[0].day) - _month_index(e.day) != 1:
+            break
+        run.insert(0, e)
+    return run  # D3
+
+
+def _next_date(run: list[Expense]) -> date:
+    days = sorted(e.day.day for e in run)
+    day = days[(len(days) - 1) // 2]  # 偶数個なら小さい側
+    last = run[-1].day
+    y, m = (last.year + 1, 1) if last.month == 12 else (last.year, last.month + 1)
+    return date(y, m, min(day, calendar.monthrange(y, m)[1]))
+
+
+def find_recurring(rows: list[Expense], min_months: int = 3) -> list[Recurring]:
+    if min_months < 2:
+        raise ValueError(f"min_months は 2 以上にしてください: {min_months}")
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        if e.amount <= 0:  # D1
+            continue
+        groups.setdefault((normalize_text(e.category), _memo_key(e.memo)), []).append(e)
+    out: list[Recurring] = []
+    for items in groups.values():
+        run = _latest_run(items)
+        if len(run) < min_months:
+            continue
+        last = run[-1]
+        out.append(
+            Recurring(
+                last.category,
+                last.memo,
+                last.amount,
+                len(run),
+                last.day,
+                _next_date(run),
+            )
+        )
+    out.sort(key=lambda r: (r.next_date, -r.amount, r.category, r.memo))
+    return out
