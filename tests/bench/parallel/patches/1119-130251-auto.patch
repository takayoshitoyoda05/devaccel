--- /dev/null
+++ b/src/kakeibo/bank_import.py
@@ -0,0 +1,170 @@
+"""銀行・カード会社の CSV(文字列)を Expense に取り込む。ダメな行は errors に集める。"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from dataclasses import dataclass, field
+from datetime import date
+
+from kakeibo.amounts import parse_amount
+from kakeibo.core import Expense
+from kakeibo.search import normalize_text
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str
+    value: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense] = field(default_factory=list)
+    errors: list[RowError] = field(default_factory=list)
+
+
+_ALIASES: dict[str, tuple[str, ...]] = {
+    "date": ("date", "日付", "利用日", "取引日", "ご利用日"),
+    "amount": ("amount", "金額", "利用金額", "ご利用金額"),
+    "out": ("出金額", "出金", "支払", "支払金額"),
+    "in": ("入金額", "入金", "預入", "預入金額"),
+    "memo": ("memo", "description", "摘要", "メモ", "利用店名", "ご利用店名", "内容"),
+    "category": ("category", "カテゴリ", "分類"),
+}
+_ROLE_BY_NAME = {
+    normalize_text(n): role for role, names in _ALIASES.items() for n in names
+}
+
+_TIME = r"(?:[ T]\d{1,2}:\d{2}(?::\d{2})?)?"
+_DATE_PATTERNS = (
+    re.compile(rf"(\d{{4}})[-/.](\d{{1,2}})[-/.](\d{{1,2}}){_TIME}"),
+    re.compile(r"(\d{4})年(\d{1,2})月(\d{1,2})日"),
+    re.compile(r"(\d{4})(\d{2})(\d{2})"),
+)
+
+
+def _parse_date(raw: str) -> date:
+    s = normalize_text(raw)
+    for pat in _DATE_PATTERNS:
+        m = pat.fullmatch(s)
+        if m:
+            try:
+                return date(int(m[1]), int(m[2]), int(m[3]))
+            except ValueError:
+                break
+    raise ValueError(f"日付として解釈できません: {raw!r}")
+
+
+def _split(text: str) -> tuple[list[tuple[int, list[str]]], str]:
+    """(開始行, フィールド) の列と区切り文字を返す。空行は除く。"""
+    text = text.lstrip("﻿")
+    first = text.splitlines()[0] if text.strip() else ""
+    delim = "\t" if first.count("\t") > first.count(",") else ","
+    reader = csv.reader(io.StringIO(text, newline=None), delimiter=delim)
+    records: list[tuple[int, list[str]]] = []
+    prev = 0
+    for row in reader:
+        start = prev + 1
+        prev = reader.line_num
+        if all(not f.strip() for f in row):
+            continue
+        records.append((start, row))
+    return records, delim
+
+
+def import_bank_csv(text: str) -> ImportResult:
+    records, delim = _split(text)
+    if not records:
+        return ImportResult()
+    head_line, header = records[0]
+    cols: dict[str, int] = {}
+    names: dict[str, str] = {}
+    for i, h in enumerate(header):
+        role = _ROLE_BY_NAME.get(normalize_text(h))
+        if role and role not in cols:
+            cols[role] = i
+            names[role] = h.strip()
+
+    missing = []
+    if "date" not in cols:
+        missing.append("日付")
+    if "amount" not in cols and "out" not in cols:
+        missing.append("金額")
+    if missing:
+        err = RowError(
+            head_line, ", ".join(missing), delim.join(header), "必須列が見つかりません"
+        )
+        return ImportResult([], [err])
+
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    for line, row in records[1:]:
+        if len(row) != len(header):
+            reason = f"列数が {len(row)} です(ヘッダーは {len(header)})"
+            errors.append(RowError(line, "(行)", delim.join(row), reason))
+            continue
+        row_errs: list[tuple[int, RowError]] = []
+
+        def bad(
+            role: str,
+            reason: str,
+            _line: int = line,
+            _row: list[str] = row,
+            _errs: list[tuple[int, RowError]] = row_errs,
+        ) -> None:
+            _errs.append(
+                (cols[role], RowError(_line, names[role], _row[cols[role]], reason))
+            )
+
+        day: date | None = None
+        try:
+            day = _parse_date(row[cols["date"]])
+        except ValueError as e:
+            bad("date", str(e))
+
+        amount: int | None = None
+        skip = False
+        if "amount" in cols:
+            try:
+                amount = parse_amount(row[cols["amount"]])
+            except ValueError as e:
+                bad("amount", str(e))
+        else:
+            out_v = row[cols["out"]].strip()
+            in_v = row[cols["in"]].strip() if "in" in cols else ""
+            if out_v and in_v:
+                both = RowError(
+                    line,
+                    "出金額/入金額",
+                    f"{out_v} / {in_v}",
+                    "出金と入金の両方に値があります",
+                )
+                row_errs.append((cols["out"], both))
+            elif in_v:
+                skip = True
+            elif not out_v:
+                row_errs.append(
+                    (
+                        cols["out"],
+                        RowError(line, "出金額/入金額", "", "金額がありません"),
+                    )
+                )
+            else:
+                try:
+                    amount = parse_amount(out_v)
+                except ValueError as e:
+                    bad("out", str(e))
+
+        if row_errs:
+            errors.extend(err for _, err in sorted(row_errs, key=lambda t: t[0]))
+            continue
+        if skip or day is None or amount is None:
+            continue
+        category = row[cols["category"]].strip() if "category" in cols else ""
+        memo = row[cols["memo"]].strip() if "memo" in cols else ""
+        expenses.append(Expense(day, category or "未分類", amount, memo))
+    return ImportResult(expenses, errors)
