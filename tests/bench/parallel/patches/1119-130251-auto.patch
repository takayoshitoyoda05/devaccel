+"""前月比レポート。カテゴリごとの増減を出す純粋関数。"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH = re.compile(r"(\d{4})-(\d{2})")
+
+
+@dataclass(frozen=True)
+class CategoryDelta:
+    category: str
+    prev: int
+    current: int
+    diff: int
+    pct: float | None
+    trend: str  # 増 / 減 / 変化なし / 新規 / 消滅
+
+
+def _check_month(month: str) -> tuple[int, int]:
+    m = _MONTH.fullmatch(month)
+    if not m or not 1 <= int(m.group(2)) <= 12 or int(m.group(1)) < 1:
+        raise ValueError(f"月は YYYY-MM で指定してください: {month!r}")
+    return int(m.group(1)), int(m.group(2))
+
+
+def _previous(month: str) -> str:
+    y, m = _check_month(month)
+    return f"{y - 1:04d}-12" if m == 1 else f"{y:04d}-{m - 1:02d}"
+
+
+def _totals(rows: list[Expense], month: str) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for e in rows:
+        if e.day.strftime("%Y-%m") == month:
+            c = e.category.strip()
+            out[c] = out.get(c, 0) + e.amount
+    return out
+
+
+def compare_months(
+    rows: list[Expense], month: str, prev: str | None = None
+) -> list[CategoryDelta]:
+    _check_month(month)
+    if prev is None:
+        prev = _previous(month)
+    else:
+        _check_month(prev)
+    cur_t, prev_t = _totals(rows, month), _totals(rows, prev)
+    out: list[CategoryDelta] = []
+    for cat in set(cur_t) | set(prev_t):
+        p, c = prev_t.get(cat, 0), cur_t.get(cat, 0)
+        diff = c - p
+        pct = None if p == 0 else round(diff / abs(p) * 100, 1)
+        if cat not in prev_t:
+            trend = "新規"
+        elif cat not in cur_t:
+            trend = "消滅"
+        elif diff > 0:
+            trend = "増"
+        elif diff < 0:
+            trend = "減"
+        else:
+            trend = "変化なし"
+        out.append(CategoryDelta(cat, p, c, diff, pct, trend))
+    out.sort(key=lambda d: (-abs(d.diff), d.category))
+    return out
+
+
+def format_diff(deltas: list[CategoryDelta]) -> str:
+    if not deltas:
+        return "差分なし"
+    lines = []
+    for d in deltas:
+        extra = f"{d.diff:+d}円"
+        if d.pct is not None:
+            extra += f", {d.pct:+.1f}%"
+        lines.append(f"{d.category}: {d.prev} → {d.current} ({extra}, {d.trend})")
+    return "\n".join(lines)
