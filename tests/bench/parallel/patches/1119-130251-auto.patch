+from datetime import date
+
+from kakeibo.bank_import import ImportResult, RowError, import_bank_csv
+from kakeibo.core import Expense
+
+
+def test_e2_1_card_aliases_and_amount():
+    r = import_bank_csv('利用日,ご利用店名,利用金額\n2026/1/5,ABC,"1,200円"')
+    assert r == ImportResult([Expense(date(2026, 1, 5), "未分類", 1200, "ABC")], [])
+
+
+def test_e2_2_income_only_row_skipped():
+    r = import_bank_csv("日付,摘要,出金額,入金額\n2026-01-05,給与,,300000")
+    assert r.expenses == [] and r.errors == []
+
+
+def test_e2_3_multiple_errors_in_one_row():
+    r = import_bank_csv("date,amount\n2026-02-30,abc")
+    assert r.expenses == []
+    assert [(e.line, e.column, e.value) for e in r.errors] == [
+        (2, "date", "2026-02-30"),
+        (2, "amount", "abc"),
+    ]
+
+
+def test_out_column_positive_and_both_values_error():
+    r = import_bank_csv("日付,摘要,出金額,入金額\n2026-01-05,A,500,\n2026-01-06,B,1,2")
+    assert [e.amount for e in r.expenses] == [500]
+    assert r.errors[0].line == 3 and r.errors[0].column == "出金額/入金額"
+
+
+def test_single_column_keeps_refund_negative():
+    r = import_bank_csv("date,amount,category\n2026-01-05,▲300,食費")
+    assert r.expenses == [Expense(date(2026, 1, 5), "食費", -300, "")]
+
+
+def test_tab_bom_crlf():
+    r = import_bank_csv("﻿日付\t金額\t内容\r\n2026.1.5\t100\tX\r\n")
+    assert r.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "X")]
+    assert r.errors == []
+
+
+def test_date_formats():
+    days = ["2026年1月5日", "20260105", "2026-01-05 12:34", "2026/1/5 12:34:56"]
+    r = import_bank_csv("date,amount\n" + "\n".join(f"{d},1" for d in days))
+    assert {e.day for e in r.expenses} == {date(2026, 1, 5)} and len(r.expenses) == 4
+
+
+def test_missing_required_column():
+    r = import_bank_csv("date,memo\n2026-01-05,x")
+    assert r.expenses == []
+    assert r.errors == [RowError(1, "金額", "date,memo", "必須列が見つかりません")]
+
+
+def test_empty_and_header_only():
+    assert import_bank_csv("") == ImportResult()
+    assert import_bank_csv("date,amount\n") == ImportResult()
+
+
+def test_wrong_column_count_and_blank_lines():
+    r = import_bank_csv("date,amount\n\n2026-01-05,1,extra\n2026-01-06")
+    assert [e.line for e in r.errors] == [3, 4] and r.expenses == []
+
+
+def test_quoted_newline_line_numbers():
+    r = import_bank_csv('date,amount,memo\n2026-01-05,1,"a\nb"\nbad,2,x')
+    assert len(r.expenses) == 1 and r.expenses[0].memo == "a\nb"
+    assert [(e.line, e.column) for e in r.errors] == [(4, "date")]
+
+
+def test_unquoted_thousands_is_column_error():
+    r = import_bank_csv("date,amount\n2026-01-05,1,200円")
+    assert r.errors[0].column == "(行)"
