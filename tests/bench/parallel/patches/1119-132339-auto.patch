--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,111 @@
+"""Detect recurring (fixed-cost) expense series. Pure functions, stdlib only."""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo_key: str
+    typical_amount: int  # yen
+    months: tuple[str, ...]  # "YYYY-MM", ascending
+    day_of_month: int
+    count: int  # number of expense rows in the series
+
+
+_DATE_LIKE = re.compile(r"\d{4}[-/.]\d{1,2}[-/.]\d{1,2}|\d{1,2}[-/.]\d{1,2}|\d{6,8}")
+_TRAILING_NUM = re.compile(r"(?:#\d+|\d+)$")
+_SPACES = re.compile(r"\s+")
+
+
+def memo_key(memo: str) -> str:
+    """D2: NFKC -> lower -> drop whitespace -> drop date-like digits -> drop trailing numbers."""
+    s = unicodedata.normalize("NFKC", memo).lower()
+    s = _SPACES.sub("", s)
+    s = _DATE_LIKE.sub("", s)
+    while True:
+        stripped = _TRAILING_NUM.sub("", s)
+        if stripped == s:
+            return s
+        s = stripped
+
+
+def _lower_median(xs: list[int]) -> int:
+    s = sorted(xs)
+    return s[(len(s) - 1) // 2]
+
+
+def _cluster_amounts(rows: list[Expense], tolerance: float) -> list[list[Expense]]:
+    """Split one (category, memo_key) group into amount clusters.
+
+    Rows are visited in ascending amount; a row joins the current cluster when it lies
+    within `tolerance` (relative) of the cluster's median, otherwise it starts a new one.
+    """
+    clusters: list[list[Expense]] = []
+    for e in sorted(rows, key=lambda e: (e.amount, e.day)):
+        if clusters:
+            med = _lower_median([x.amount for x in clusters[-1]])
+            if abs(e.amount - med) <= tolerance * med:
+                clusters[-1].append(e)
+                continue
+        clusters.append([e])
+    return clusters
+
+
+def find_recurring(
+    rows: list[Expense], *, min_months: int = 3, amount_tolerance: float = 0.1
+) -> list[Recurring]:
+    if min_months < 2:
+        raise ValueError("min_months は 2 以上である必要があります")
+
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        if e.amount <= 0:  # R3: refunds and zero are not part of a series
+            continue
+        key = (e.category, memo_key(e.memo))
+        groups.setdefault(key, []).append(e)
+
+    out: list[Recurring] = []
+    for (category, mkey), group in groups.items():
+        for cluster in _cluster_amounts(group, amount_tolerance):
+            first_by_month: dict[str, Expense] = {}
+            for e in sorted(cluster, key=lambda e: (e.day, e.amount)):
+                first_by_month.setdefault(e.day.strftime("%Y-%m"), e)
+            if len(first_by_month) < min_months:
+                continue
+            months = tuple(sorted(first_by_month))
+            out.append(
+                Recurring(
+                    category=category,
+                    memo_key=mkey,
+                    typical_amount=_lower_median([e.amount for e in cluster]),
+                    months=months,
+                    day_of_month=_lower_median(
+                        [first_by_month[m].day.day for m in months]
+                    ),
+                    count=len(cluster),
+                )
+            )
+
+    out.sort(key=lambda r: (-r.typical_amount, r.category, r.memo_key))
+    return out
+
+
+def next_due(r: Recurring) -> date:
+    """R5: the day_of_month in the month after the last observed month (clamped, D3)."""
+    year_s, month_s = r.months[-1].split("-")
+    year, month = int(year_s), int(month_s)
+    if month == 12:
+        year, month = year + 1, 1
+    else:
+        month += 1
+    last_day = calendar.monthrange(year, month)[1]
+    return date(year, month, min(r.day_of_month, last_day))
