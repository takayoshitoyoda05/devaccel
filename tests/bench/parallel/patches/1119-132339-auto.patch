+++ b/tests/test_recurring.py
@@ -0,0 +1,253 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, memo_key, next_due
+
+
+def ex(day: str, amount: int, memo: str = "", category: str = "住居") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+# --- 例の表 (E1-*) -----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "rows, expected_next",
+    [
+        pytest.param(
+            [
+                ex("2026-01-25", 80000, "家賃"),
+                ex("2026-02-25", 80000, "家賃"),
+                ex("2026-03-25", 80000, "家賃"),
+            ],
+            date(2026, 4, 25),
+            id="E1-1",
+        ),
+    ],
+)
+def test_e1_1_monthly_rent_series_and_next_due(
+    rows: list[Expense], expected_next: date
+) -> None:
+    found = find_recurring(rows)
+    assert len(found) == 1
+    assert next_due(found[0]) == expected_next
+
+
+@pytest.mark.parametrize(
+    "rows, expected_next",
+    [
+        pytest.param(
+            # 最後が 1 月、day_of_month=31 (days 30,31,31 の中央値)
+            [
+                ex("2025-11-30", 5000, "保険"),
+                ex("2025-12-31", 5000, "保険"),
+                ex("2026-01-31", 5000, "保険"),
+            ],
+            date(2026, 2, 28),
+            id="E1-2",
+        ),
+        pytest.param(
+            # 閏年版: 翌 2 月が 2028 年
+            [
+                ex("2027-11-30", 5000, "保険"),
+                ex("2027-12-31", 5000, "保険"),
+                ex("2028-01-31", 5000, "保険"),
+            ],
+            date(2028, 2, 29),
+            id="E1-2-leap",
+        ),
+    ],
+)
+def test_e1_2_next_due_clamps_to_month_end(
+    rows: list[Expense], expected_next: date
+) -> None:
+    found = find_recurring(rows)
+    assert len(found) == 1
+    assert found[0].day_of_month == 31
+    assert next_due(found[0]) == expected_next
+
+
+@pytest.mark.parametrize(
+    "rows",
+    [
+        pytest.param(
+            [
+                ex("2026-01-10", 1000, "ジム"),
+                ex("2026-02-10", 1000, "ジム"),
+                ex("2026-03-10", 1000, "ジム"),
+                ex("2026-01-20", 5000, "ジム"),
+                ex("2026-02-20", 5000, "ジム"),
+                ex("2026-03-20", 5000, "ジム"),
+            ],
+            id="E1-3",
+        ),
+    ],
+)
+def test_e1_3_different_amounts_are_separate_series(rows: list[Expense]) -> None:
+    found = find_recurring(rows)
+    assert len(found) == 2
+    assert [r.typical_amount for r in found] == [5000, 1000]
+
+
+# --- 追加の規則テスト ---------------------------------------------------------
+
+
+def test_min_months_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_months=1)
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+def test_fewer_months_than_min_is_excluded() -> None:
+    rows = [ex("2026-01-05", 900, "電気"), ex("2026-02-05", 900, "電気")]
+    assert find_recurring(rows, min_months=3) == []
+    assert len(find_recurring(rows, min_months=2)) == 1
+
+
+def test_missing_month_still_counts_when_enough_months() -> None:
+    rows = [
+        ex("2026-01-05", 900, "電気"),
+        ex("2026-02-05", 900, "電気"),
+        ex("2026-04-05", 900, "電気"),
+    ]
+    found = find_recurring(rows, min_months=3)
+    assert len(found) == 1
+    assert found[0].months == ("2026-01", "2026-02", "2026-04")
+
+
+def test_same_month_twice_counts_once_and_uses_first_date() -> None:
+    rows = [
+        ex("2026-01-20", 900, "電気"),
+        ex("2026-01-05", 900, "電気"),
+        ex("2026-02-05", 900, "電気"),
+    ]
+    assert find_recurring(rows, min_months=3) == []
+    rows.append(ex("2026-03-05", 900, "電気"))
+    found = find_recurring(rows, min_months=3)
+    assert len(found) == 1
+    assert found[0].months == ("2026-01", "2026-02", "2026-03")
+    assert found[0].day_of_month == 5
+
+
+def test_negative_and_zero_amounts_are_excluded() -> None:
+    rows = [
+        ex("2026-01-05", 900, "電気"),
+        ex("2026-02-05", -900, "電気"),
+        ex("2026-03-05", 0, "電気"),
+        ex("2026-04-05", 900, "電気"),
+    ]
+    assert find_recurring(rows, min_months=2) == [
+        Recurring(
+            category="住居",
+            memo_key="電気",
+            typical_amount=900,
+            months=("2026-01", "2026-04"),
+            day_of_month=5,
+            count=2,
+        )
+    ]
+
+
+def test_empty_memo_is_grouped_by_category_and_amount() -> None:
+    rows = [ex("2026-01-03", 300), ex("2026-02-03", 300), ex("2026-03-03", 300)]
+    found = find_recurring(rows)
+    assert len(found) == 1
+    assert found[0].memo_key == ""
+
+
+def test_different_category_same_memo_is_separate() -> None:
+    rows = [
+        ex("2026-01-03", 300, "月額", category="通信"),
+        ex("2026-02-03", 300, "月額", category="通信"),
+        ex("2026-03-03", 300, "月額", category="娯楽"),
+        ex("2026-04-03", 300, "月額", category="娯楽"),
+    ]
+    found = find_recurring(rows, min_months=2)
+    assert sorted(r.category for r in found) == ["娯楽", "通信"]
+
+
+def test_small_tolerance_drift_is_same_series() -> None:
+    # 10000 と 10500 は中央値から 5% 以内
+    rows = [
+        ex("2026-01-05", 10000, "水道"),
+        ex("2026-02-05", 10500, "水道"),
+        ex("2026-03-05", 10000, "水道"),
+    ]
+    found = find_recurring(rows)
+    assert len(found) == 1
+    assert found[0].count == 3
+
+
+def test_out_of_tolerance_amount_is_separate_candidate() -> None:
+    rows = [
+        ex("2026-01-05", 10000, "水道"),
+        ex("2026-02-05", 10000, "水道"),
+        ex("2026-03-05", 10000, "水道"),
+        ex("2026-04-05", 12000, "水道"),
+    ]
+    found = find_recurring(rows, min_months=3)
+    assert len(found) == 1
+    assert found[0].typical_amount == 10000
+
+
+def test_typical_amount_and_day_use_lower_median_for_even_count() -> None:
+    rows = [
+        ex("2026-01-05", 1000, "x"),
+        ex("2026-02-10", 1050, "x"),
+        ex("2026-03-05", 1000, "x"),
+        ex("2026-04-10", 1050, "x"),
+    ]
+    found = find_recurring(rows, min_months=3)
+    assert len(found) == 1
+    assert found[0].typical_amount == 1000
+    # days 5,10,5,10 -> lower median 5
+    assert found[0].day_of_month == 5
+
+
+def test_next_due_rolls_over_year_from_december() -> None:
+    rows = [
+        ex("2025-10-15", 500, "新聞"),
+        ex("2025-11-15", 500, "新聞"),
+        ex("2025-12-15", 500, "新聞"),
+    ]
+    found = find_recurring(rows)
+    assert next_due(found[0]) == date(2026, 1, 15)
+
+
+@pytest.mark.parametrize(
+    "raw, key",
+    [
+        pytest.param("Netflix", "netflix", id="case"),
+        pytest.param("ＮＥＴＦＬＩＸ", "netflix", id="nfkc"),
+        pytest.param("net flix", "netflix", id="inner-space"),
+        pytest.param("netflix #3", "netflix", id="hash-number"),
+        pytest.param("netflix 2026-01-05", "netflix", id="date-like"),
+        pytest.param("netflix 12", "netflix", id="trailing-number"),
+    ],
+)
+def test_memo_key_normalization(raw: str, key: str) -> None:
+    assert memo_key(raw) == key
+
+
+def test_result_order_is_amount_desc_then_category_and_memo() -> None:
+    rows = []
+    for memo in ("b", "a"):
+        for m in ("01", "02", "03"):
+            rows.append(ex(f"2026-{m}-01", 700, memo))
+    for m in ("01", "02", "03"):
+        rows.append(ex(f"2026-{m}-01", 900, "z"))
+    found = find_recurring(rows)
+    assert [(r.typical_amount, r.memo_key) for r in found] == [
+        (900, "z"),
+        (700, "a"),
+        (700, "b"),
+    ]
diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..fef3467
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,191 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    amount_between,
+    and_,
+    between_dates,
+    category,
+    memo_contains,
+    not_,
+    or_,
+    search,
+)
+
+ROWS = [
+    Expense(date(2026, 1, 1), "食費", 100, "ランチ"),
+    Expense(date(2026, 1, 15), "交通", 500, "Suica"),
+    Expense(date(2026, 2, 28), "食費", 1200, "スーパー ＡＢＣ"),
+    Expense(date(2026, 3, 31), "娯楽", 0, ""),
+]
+
+
+def _amounts(rows: list[Expense]) -> list[int]:
+    return [e.amount for e in rows]
+
+
+# --- 表の例 (E3-*) ---
+
+
+def test_E3_1_amount_between_equal_bounds_includes_exact_match() -> None:
+    rows = [Expense(date(2026, 1, 1), "食費", 100)]
+    assert search(rows, amount_between(100, 100)) == rows
+
+
+def test_E3_2_amount_between_lo_above_hi_raises() -> None:
+    with pytest.raises(ValueError):
+        amount_between(500, 100)
+
+
+def test_E3_3_and_empty_is_all_and_or_empty_is_none() -> None:
+    assert search(ROWS, and_()) == ROWS
+    assert search(ROWS, or_()) == []
+
+
+# --- category (R1) ---
+
+
+@pytest.mark.parametrize(
+    ("names", "expected"),
+    [
+        (("食費",), [100, 1200]),
+        (("食費", "交通"), [100, 500, 1200]),
+        ((" 食費 ",), [100, 1200]),  # 前後の空白は除去
+        (("食",), []),  # 部分一致は不可
+        (("",), []),
+    ],
+    ids=["R1-single", "R1-multi", "R1-strip", "R1-no-partial", "R1-empty-name"],
+)
+def test_R1_category_exact_match(names: tuple[str, ...], expected: list[int]) -> None:
+    assert _amounts(search(ROWS, category(*names))) == expected
+
+
+def test_R1_category_without_names_raises() -> None:
+    with pytest.raises(ValueError):
+        category()
+
+
+# --- amount_between (R2) ---
+
+
+@pytest.mark.parametrize(
+    ("lo", "hi", "expected"),
+    [
+        (100, 500, [100, 500]),  # 両端含む
+        (101, 499, []),
+        (None, 100, [100, 0]),  # 下限 None は無制限
+        (500, None, [500, 1200]),  # 上限 None は無制限
+        (None, None, [100, 500, 1200, 0]),  # 両方 None は常に真
+        (0, 0, [0]),
+    ],
+    ids=[
+        "R2-inclusive",
+        "R2-gap",
+        "R2-lo-none",
+        "R2-hi-none",
+        "R2-both-none",
+        "R2-zero",
+    ],
+)
+def test_R2_amount_between_bounds(
+    lo: int | None, hi: int | None, expected: list[int]
+) -> None:
+    assert _amounts(search(ROWS, amount_between(lo, hi))) == expected
+
+
+# --- memo_contains (R3) ---
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("ラン", [100]),  # 部分一致
+        ("suica", [500]),  # 大文字小文字無視
+        ("SUICA", [500]),
+        ("abc", [1200]),  # NFKC: 全角 ＡＢＣ に一致
+        ("", [100, 500, 1200, 0]),  # 空文字は常に真
+        ("無い", []),
+    ],
+    ids=[
+        "R3-partial",
+        "R3-case-lower",
+        "R3-case-upper",
+        "R3-nfkc",
+        "R3-empty",
+        "R3-none",
+    ],
+)
+def test_R3_memo_contains(text: str, expected: list[int]) -> None:
+    assert _amounts(search(ROWS, memo_contains(text))) == expected
+
+
+# --- between_dates (R2, R6) ---
+
+
+@pytest.mark.parametrize(
+    ("start", "end", "expected"),
+    [
+        (date(2026, 1, 1), date(2026, 1, 15), [100, 500]),  # 両端含む
+        (date(2026, 1, 2), date(2026, 2, 27), [500]),
+        (None, date(2026, 1, 1), [100]),
+        (date(2026, 3, 31), None, [0]),
+        (None, None, [100, 500, 1200, 0]),
+    ],
+    ids=["R6-inclusive", "R6-inner", "R6-start-none", "R6-end-none", "R6-both-none"],
+)
+def test_R6_between_dates(
+    start: date | None, end: date | None, expected: list[int]
+) -> None:
+    assert _amounts(search(ROWS, between_dates(start, end))) == expected
+
+
+def test_R2_between_dates_start_after_end_raises() -> None:
+    with pytest.raises(ValueError):
+        between_dates(date(2026, 2, 1), date(2026, 1, 1))
+
+
+# --- 合成 (R4) ---
+
+
+def test_R4_not_inverts() -> None:
+    assert _amounts(search(ROWS, not_(category("食費")))) == [500, 0]
+
+
+def test_R4_and_or_compose() -> None:
+    pred = or_(category("交通"), and_(category("食費"), amount_between(1000, None)))
+    assert _amounts(search(ROWS, pred)) == [500, 1200]
+
+
+@pytest.mark.parametrize(
+    "build",
+    [
+        lambda: and_(category("食費"), 1),  # type: ignore[arg-type]
+        lambda: or_("食費"),  # type: ignore[arg-type]
+        lambda: not_(None),  # type: ignore[arg-type]
+    ],
+    ids=["R4-and-non-pred", "R4-or-non-pred", "R4-not-non-pred"],
+)
+def test_R4_non_predicate_raises_type_error(build) -> None:  # type: ignore[no-untyped-def]
+    with pytest.raises(TypeError):
+        build()
+
+
+def test_R4_search_non_predicate_raises_type_error() -> None:
+    with pytest.raises(TypeError):
+        search(ROWS, 42)  # type: ignore[arg-type]
+
+
+# --- search の順序・非破壊 (R5) ---
+
+
+def test_R5_keeps_order_and_does_not_mutate_input() -> None:
+    rows = list(ROWS)
+    snapshot = list(rows)
+    result = search(rows, amount_between(None, None))
+    assert result == snapshot
+    assert rows == snapshot
+    assert result is not rows
