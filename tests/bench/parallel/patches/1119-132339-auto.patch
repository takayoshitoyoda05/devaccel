+"""Tests for kakeibo.bank_import: the E2 examples table and rules R1-R6."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import ImportResult, import_bank_csv
+from kakeibo.core import Expense
+
+# --- 例の表 (E2) -----------------------------------------------------------
+
+
+def test_E2_1_triangle_minus_amount_is_negative() -> None:
+    """E2-1: 金額列が ▲500 → amount=-500 の Expense (R3)."""
+    result = import_bank_csv("date,amount,memo\n2026-01-05,▲500,ramen")
+    assert result.errors == []
+    assert result.expenses == [
+        Expense(day=date(2026, 1, 5), category="未分類", amount=-500, memo="ramen")
+    ]
+
+
+def test_E2_2_bad_date_and_amount_gives_two_row_errors() -> None:
+    """E2-2: 日付 2026/2/30、金額 abc の 1 行 → RowError 2 件(日付・金額)、expenses は空 (R6)."""
+    result = import_bank_csv("date,amount,memo\n2026/2/30,abc,x")
+    assert result.expenses == []
+    assert [(e.line, e.column, e.value) for e in result.errors] == [
+        (2, "date", "2026/2/30"),
+        (2, "amount", "abc"),
+    ]
+
+
+def test_E2_3_income_only_row_is_skipped() -> None:
+    """E2-3: 出金/入金の列で入金だけの行 → skipped が 1 増える (R5)."""
+    result = import_bank_csv("date,出金,入金,memo\n2026-01-05,,1000,salary")
+    assert result.expenses == []
+    assert result.errors == []
+    assert result.skipped == 1
+
+
+# --- R1: BOM・区切り・改行・引用符 ---------------------------------------
+
+
+def test_R1_bom_is_removed() -> None:
+    result = import_bank_csv("﻿date,amount,memo\n2026-01-05,100,x")
+    assert [e.amount for e in result.expenses] == [100]
+
+
+def test_R1_tab_delimiter_chosen_when_more_tabs_than_commas() -> None:
+    result = import_bank_csv("date\tamount\tmemo\n2026-01-05\t100\tx")
+    assert [e.amount for e in result.expenses] == [100]
+
+
+def test_R1_tie_between_comma_and_tab_uses_comma() -> None:
+    # ヘッダーにカンマとタブが 1 つずつ → カンマ区切りになり、amount 列が無い
+    with pytest.raises(ValueError):
+        import_bank_csv("date,amount\tmemo\n2026-01-05,100\tx")
+
+
+@pytest.mark.parametrize("newline", ["\r\n", "\n", "\r"], ids=["CRLF", "LF", "CR"])
+def test_R1_all_newline_styles_accepted(newline: str) -> None:
+    text = newline.join(["date,amount,memo", "2026-01-05,100,x", "2026-01-06,200,y"])
+    result = import_bank_csv(text + newline)
+    assert [e.amount for e in result.expenses] == [100, 200]
+    assert result.errors == []
+
+
+def test_R1_line_number_counts_cr_only_newlines() -> None:
+    result = import_bank_csv("date,amount\r2026-01-05,100\r2026-01-06,abc")
+    assert [(e.line, e.column) for e in result.errors] == [(3, "amount")]
+
+
+def test_R1_quoted_newline_reports_record_start_line() -> None:
+    text = 'date,amount,memo\n2026-01-05,abc,"a\nb"\n2026-01-06,abc,x'
+    result = import_bank_csv(text)
+    # 1 件目のレコードは 2-3 行目にまたがるので開始行は 2、2 件目は 4
+    assert [e.line for e in result.errors] == [2, 4]
+    assert result.expenses == []
+
+
+def test_R1_quoted_newline_and_comma_kept_in_memo() -> None:
+    result = import_bank_csv(
+        'date,amount,memo\n2026-01-05,100,"a\nb"\n2026-01-06,200,"x,y"'
+    )
+    assert [e.memo for e in result.expenses] == ["a\nb", "x,y"]
+
+
+def test_R1_oversized_field_is_reported_not_dropped() -> None:
+    text = 'date,amount,memo\n2026-01-05,100,"' + "x" * 200_000 + '"'
+    result = import_bank_csv(text)
+    assert result.expenses == []
+    assert [e.line for e in result.errors] == [2]
+
+
+# --- R2: 列名 ----------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("header", "amount_cell"),
+    [
+        pytest.param(("日付", "金額", "摘要"), "100", id="日付-金額-摘要"),
+        pytest.param(
+            ("利用日", "ご利用金額", "ご利用店名"), "100", id="利用日-ご利用金額"
+        ),
+        pytest.param(("取引日", "利用金額", "内容"), "100", id="取引日-利用金額"),
+        pytest.param(("年月日", "お支払金額", "メモ"), "100", id="年月日-お支払金額"),
+        pytest.param(
+            ("ご利用日", "支払金額", "description"), "100", id="ご利用日-支払金額"
+        ),
+    ],
+)
+def test_R2_japanese_and_english_aliases(
+    header: tuple[str, str, str], amount_cell: str
+) -> None:
+    text = ",".join(header) + f"\n2026-01-05,{amount_cell},x"
+    result = import_bank_csv(text)
+    assert result.errors == []
+    assert [(e.amount, e.memo) for e in result.expenses] == [(100, "x")]
+
+
+def test_R2_header_names_are_trimmed_and_normalized() -> None:
+    result = import_bank_csv(" ＤＡＴＥ , Amount , Memo \n2026-01-05,100,x")
+    assert [(e.day, e.amount, e.memo) for e in result.expenses] == [
+        (date(2026, 1, 5), 100, "x")
+    ]
+
+
+@pytest.mark.parametrize("category_header", ["category", "カテゴリ", "分類", "費目"])
+def test_R2_category_column_used(category_header: str) -> None:
+    result = import_bank_csv(f"date,amount,{category_header}\n2026-01-05,100,食費")
+    assert [e.category for e in result.expenses] == ["食費"]
+
+
+def test_R2_category_defaults_to_uncategorized_without_column() -> None:
+    result = import_bank_csv("date,amount\n2026-01-05,100")
+    assert [e.category for e in result.expenses] == ["未分類"]
+
+
+def test_R2_missing_date_column_raises_value_error() -> None:
+    with pytest.raises(ValueError):
+        import_bank_csv("amount,memo\n100,x")
+
+
+def test_R2_missing_amount_column_raises_value_error() -> None:
+    with pytest.raises(ValueError):
+        import_bank_csv("date,memo\n2026-01-05,x")
+
+
+def test_R2_deposit_only_header_has_no_amount_column() -> None:
+    # 入金列だけでは金額列とみなさない(支出を 1 件も作れないため)
+    with pytest.raises(ValueError):
+        import_bank_csv("date,入金\n2026-01-05,100")
+
+
+@pytest.mark.parametrize("text", ["", "  \n\t"], ids=["empty", "whitespace"])
+def test_R2_empty_input_returns_empty_result(text: str) -> None:
+    assert import_bank_csv(text) == ImportResult(expenses=[], errors=[], skipped=0)
+
+
+# --- R3: 金額 ----------------------------------------------------------------
+
+AMOUNT_OK = [
+    ("1234", 1234),
+    ("1,234", 1234),
+    ("1，234", 1234),
+    ("１２３４", 1234),
+    ("¥1,234", 1234),
+    ("￥1,234", 1234),
+    ("1,234円", 1234),
+    ("JPY 1234", 1234),
+    (" 1234 ", 1234),
+    ("　1234　", 1234),
+    ("-300", -300),
+    ("−300", -300),
+    ("△500", -500),
+    ("▲500", -500),
+    ("(500)", -500),
+    ("500-", -500),
+]
+
+
+@pytest.mark.parametrize(("raw", "expected"), AMOUNT_OK, ids=[r for r, _ in AMOUNT_OK])
+def test_R3_accepted_amount_forms(raw: str, expected: int) -> None:
+    # タブ区切りにして、金額欄の "1,234" をカンマ区切りと混同させない
+    result = import_bank_csv(f"date\tamount\tmemo\n2026-01-05\t{raw}\tx")
+    assert result.errors == []
+    assert [e.amount for e in result.expenses] == [expected]
+
+
+AMOUNT_ERR = ["12.5", "", "   ", "-", "—", "abc", "1,23"]
+
+
+@pytest.mark.parametrize("raw", AMOUNT_ERR, ids=[repr(r) for r in AMOUNT_ERR])
+def test_R3_rejected_amount_forms(raw: str) -> None:
+    result = import_bank_csv(f"date\tamount\tmemo\n2026-01-05\t{raw}\tx")
+    assert result.expenses == []
+    assert [(e.line, e.column, e.value) for e in result.errors] == [(2, "amount", raw)]
+
+
+# --- R4: 日付 ----------------------------------------------------------------
+
+DATE_OK = [
+    ("2026-01-05", date(2026, 1, 5)),
+    ("2026/1/5", date(2026, 1, 5)),
+    ("2026.1.5", date(2026, 1, 5)),
+    ("20260105", date(2026, 1, 5)),
+    ("2026年1月5日", date(2026, 1, 5)),
+    ("2026-01-05 10:30", date(2026, 1, 5)),
+    ("2026-01-05 10:30:00", date(2026, 1, 5)),
+    ("2026/1/5 10:30", date(2026, 1, 5)),
+    ("20260105 10:30:00", date(2026, 1, 5)),
+    ("2026年1月5日 10:30", date(2026, 1, 5)),
+    ("2028-02-29", date(2028, 2, 29)),
+]
+
+
+@pytest.mark.parametrize(("raw", "expected"), DATE_OK, ids=[r for r, _ in DATE_OK])
+def test_R4_accepted_date_forms(raw: str, expected: date) -> None:
+    result = import_bank_csv(f"date\tamount\tmemo\n{raw}\t100\tx")
+    assert result.errors == []
+    assert [e.day for e in result.expenses] == [expected]
+
+
+DATE_ERR = ["2026/2/30", "2026-13-01", "2026/2/29", "abc"]
+
+
+@pytest.mark.parametrize("raw", DATE_ERR, ids=DATE_ERR)
+def test_R4_rejected_date_forms(raw: str) -> None:
+    result = import_bank_csv(f"date\tamount\tmemo\n{raw}\t100\tx")
+    assert result.expenses == []
+    assert [(e.line, e.column, e.value) for e in result.errors] == [(2, "date", raw)]
+
+
+# --- R5: 出金/入金 ------------------------------------------------------------
+
+
+def test_R5_withdrawal_is_positive_expense() -> None:
+    result = import_bank_csv("date,出金,入金,memo\n2026-01-05,500,,x")
+    assert [e.amount for e in result.expenses] == [500]
+    assert result.skipped == 0
+
+
+def test_R5_withdrawal_wins_when_both_filled() -> None:
+    result = import_bank_csv("date,出金,入金,memo\n2026-01-05,300,200,x")
+    assert [e.amount for e in result.expenses] == [300]
+
+
+def test_R5_income_row_with_bad_date_is_error_not_skipped() -> None:
+    result = import_bank_csv("date,出金,入金\n2026/2/30,,1000")
+    assert result.expenses == []
+    assert result.skipped == 0
+    assert [(e.line, e.column) for e in result.errors] == [(2, "date")]
+
+
+def test_R5_income_column_with_invalid_value_is_error() -> None:
+    result = import_bank_csv("date,出金,入金\n2026-01-05,,abc")
+    assert result.skipped == 0
+    assert [(e.line, e.column, e.value) for e in result.errors] == [(2, "入金", "abc")]
+
+
+# --- R6: 空行・列不足・行単位のエラー -------------------------------------------
+
+
+def test_R6_blank_rows_are_skipped_silently() -> None:
+    text = "date,amount,memo\n\n2026-01-05,100,x\n,,\n   ,  ,  "
+    result = import_bank_csv(text)
+    assert [e.amount for e in result.expenses] == [100]
+    assert result.errors == []
+    assert result.skipped == 3
+
+
+def test_R6_short_row_reports_each_missing_column() -> None:
+    result = import_bank_csv("date,amount,memo\n2026-01-05")
+    assert result.expenses == []
+    assert [(e.column, e.value) for e in result.errors] == [
+        ("amount", ""),
+        ("memo", ""),
+    ]
+
+
+def test_R6_row_with_several_errors_reports_all() -> None:
+    result = import_bank_csv("date,amount,memo\n2026/2/30")
+    assert result.expenses == []
+    assert {e.column for e in result.errors} == {"date", "amount", "memo"}
+    assert len(result.errors) == 3
+
+
+def test_R6_bad_row_does_not_stop_later_rows_and_keeps_order() -> None:
+    text = "date,amount\n2026-01-05,100\n2026/2/30,200\n2026-01-07,300"
+    result = import_bank_csv(text)
+    assert [e.amount for e in result.expenses] == [100, 300]
+    assert [(e.line, e.column) for e in result.errors] == [(3, "date")]
diff --git a/tests/test_compare.py b/tests/test_compare.py
new file mode 100644
index 0000000..d911a41
--- /dev/null
+++ b/tests/test_compare.py
@@ -0,0 +1,126 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.compare import CategoryChange, format_report, month_over_month
+from kakeibo.core import Expense
+
+
+def E(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+# E4-1: 食費 前月 10000 → 今月 12500 → diff=2500, pct=25.0, trend=増 (R3)
+# E4-2: 前月に無い新カテゴリ 3000 → previous=0, pct=None (R3)
+@pytest.mark.parametrize(
+    ("rows", "expected"),
+    [
+        pytest.param(
+            [E("2026-03-05", "食費", 10000), E("2026-04-05", "食費", 12500)],
+            CategoryChange("食費", 10000, 12500, 2500, 25.0, "増"),
+            id="E4-1",
+        ),
+        pytest.param(
+            [E("2026-04-05", "娯楽", 3000)],
+            CategoryChange("娯楽", 0, 3000, 3000, None, "増"),
+            id="E4-2",
+        ),
+    ],
+)
+def test_table_cases(rows: list[Expense], expected: CategoryChange) -> None:
+    result = month_over_month(rows, "2026-04")
+    assert result == [expected]
+
+
+# E4-3: month="2026-13" → ValueError (R1)
+def test_E4_3_invalid_month_raises() -> None:
+    with pytest.raises(ValueError):
+        month_over_month([], "2026-13")
+
+
+# R1: January's previous month is December of the previous year.
+def test_january_compares_with_previous_december() -> None:
+    rows = [E("2025-12-20", "食費", 8000), E("2026-01-10", "食費", 6000)]
+    result = month_over_month(rows, "2026-01")
+    assert result == [CategoryChange("食費", 8000, 6000, -2000, -25.0, "減")]
+
+
+# R1: refunds (negative amounts) are summed into the month totals.
+def test_refund_is_included_in_totals() -> None:
+    rows = [E("2026-03-01", "日用品", 5000), E("2026-04-01", "日用品", -1000)]
+    result = month_over_month(rows, "2026-04")
+    assert result == [CategoryChange("日用品", 5000, -1000, -6000, -120.0, "減")]
+
+
+# R2: categories present in only one of the two months are included.
+def test_categories_only_in_one_month_are_included() -> None:
+    rows = [E("2026-03-01", "交通", 2000), E("2026-04-01", "通信", 1500)]
+    result = month_over_month(rows, "2026-04")
+    by_cat = {c.category: c for c in result}
+    assert by_cat["交通"] == CategoryChange("交通", 2000, 0, -2000, -100.0, "減")
+    assert by_cat["通信"] == CategoryChange("通信", 0, 1500, 1500, None, "増")
+
+
+# R2: categories in neither month are not included.
+def test_categories_outside_both_months_are_excluded() -> None:
+    rows = [E("2026-01-01", "旅行", 9000), E("2026-04-01", "食費", 100)]
+    result = month_over_month(rows, "2026-04")
+    assert [c.category for c in result] == ["食費"]
+
+
+# R3: diff 0 gives trend 変化なし and is still included.
+def test_zero_diff_is_included_as_unchanged() -> None:
+    rows = [E("2026-03-01", "光熱費", 4000), E("2026-04-01", "光熱費", 4000)]
+    result = month_over_month(rows, "2026-04")
+    assert result == [CategoryChange("光熱費", 4000, 4000, 0, 0.0, "変化なし")]
+
+
+# R3: pct is rounded to one decimal place.
+def test_pct_rounded_to_one_decimal() -> None:
+    rows = [E("2026-03-01", "食費", 3), E("2026-04-01", "食費", 4)]
+    result = month_over_month(rows, "2026-04")
+    assert result[0].pct == 33.3
+
+
+# R4: sorted by abs(diff) descending, ties by category ascending.
+def test_sort_order_abs_diff_then_category() -> None:
+    rows = [
+        E("2026-03-01", "B", 1000),
+        E("2026-04-01", "B", 1000 + 500),  # diff +500
+        E("2026-03-01", "A", 1000),
+        E("2026-04-01", "A", 1000 - 500),  # diff -500 (tie on abs, category A first)
+        E("2026-04-01", "C", 2000),  # diff +2000
+    ]
+    result = month_over_month(rows, "2026-04")
+    assert [c.category for c in result] == ["C", "A", "B"]
+
+
+# R6: no rows gives an empty list.
+def test_no_rows_returns_empty() -> None:
+    assert month_over_month([], "2026-04") == []
+
+
+# R6: rows exist but neither month has any.
+def test_neither_month_has_rows_returns_empty() -> None:
+    rows = [E("2026-01-01", "食費", 100)]
+    assert month_over_month(rows, "2026-04") == []
+
+
+# R5: report line format for increase, new category, and decrease.
+def test_format_report_lines() -> None:
+    changes = [
+        CategoryChange("食費", 12000, 15000, 3000, 25.0, "増"),
+        CategoryChange("娯楽", 0, 3000, 3000, None, "増"),
+        CategoryChange("交通", 2000, 0, -2000, -100.0, "減"),
+    ]
+    expected_lines = [
+        "食費: 12,000円 → 15,000円 (+3,000円, +25.0%) 増",
+        "娯楽: 0円 → 3,000円 (+3,000円, 新規) 増",
+        "交通: 2,000円 → 0円 (-2,000円, -100.0%) 減",
+    ]
+    assert format_report(changes) == "\n".join(expected_lines)
+
+
+# R5: empty list yields データなし, not 変化なし.
+def test_format_report_empty() -> None:
+    assert format_report([]) == "データなし"
