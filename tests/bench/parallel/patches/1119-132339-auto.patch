@@ -0,0 +1,235 @@
+"""Import bank CSV exports into Expense records (pure: text in, result out)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_CATEGORY = "未分類"
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int  # 1 始まりのレコード開始行(ヘッダーが 1 行目)
+    column: str
+    value: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+    skipped: int
+
+
+def _norm(name: str) -> str:
+    return unicodedata.normalize("NFKC", name).strip().lower()
+
+
+def _aliases(*names: str) -> frozenset[str]:
+    return frozenset(_norm(n) for n in names)
+
+
+_DATE_NAMES = _aliases("date", "日付", "利用日", "取引日", "ご利用日", "年月日")
+_AMOUNT_NAMES = _aliases(
+    "amount", "金額", "利用金額", "ご利用金額", "出金額", "支払金額", "お支払金額"
+)
+_DEPOSIT_NAMES = _aliases("入金額", "預入額", "入金", "預入")
+_WITHDRAW_NAMES = _aliases("出金額", "支払金額", "出金", "支払")
+_MEMO_NAMES = _aliases(
+    "memo", "摘要", "メモ", "利用店名", "ご利用店名", "内容", "description"
+)
+_CATEGORY_NAMES = _aliases("category", "カテゴリ", "分類", "費目")
+
+_AMOUNT_BODY = re.compile(r"[0-9]{1,3}(?:,[0-9]{3})+|[0-9]+")
+_CURRENCY_PREFIX = re.compile(r"(?:(?i:JPY)|¥)\s*")
+_DATE_RE = re.compile(
+    r"(?:([0-9]{4})[-/.]([0-9]{1,2})[-/.]([0-9]{1,2})"
+    r"|([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日"
+    r"|([0-9]{4})([0-9]{2})([0-9]{2}))"
+    r"(?:\s*[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?)?"
+)
+
+
+def _parse_amount(raw: str) -> int:
+    if not raw.strip():
+        raise ValueError("金額が空です")
+    # U+2212 は NFKC で変わらないので先に置き換える
+    s = unicodedata.normalize("NFKC", raw.replace("−", "-")).strip()
+    if s.endswith("円"):
+        s = s[:-1].strip()
+    prefix = _CURRENCY_PREFIX.match(s)
+    if prefix is not None:
+        s = s[prefix.end() :]
+    negative = False
+    if s[:1] in ("-", "▲", "△"):
+        negative, s = True, s[1:].strip()
+    elif s.startswith("(") and s.endswith(")"):
+        negative, s = True, s[1:-1].strip()
+    elif s.endswith("-"):
+        negative, s = True, s[:-1].strip()
+    if not _AMOUNT_BODY.fullmatch(s):
+        raise ValueError("金額として読めません")
+    value = int(s.replace(",", ""))
+    return -value if negative else value
+
+
+def _parse_date(raw: str) -> date:
+    m = _DATE_RE.fullmatch(raw.strip())
+    if m is None:
+        raise ValueError("日付として読めません")
+    year, month, day = [int(g) for g in m.groups() if g is not None]
+    try:
+        return date(year, month, day)
+    except ValueError:
+        raise ValueError("存在しない日付です") from None
+
+
+def _find(names: list[str], wanted: frozenset[str]) -> int | None:
+    for i, name in enumerate(names):
+        if name in wanted:
+            return i
+    return None
+
+
+@dataclass(frozen=True)
+class _Layout:
+    header: list[str]
+    date_col: int
+    spend: list[int]  # 出金・金額の列。優先順
+    deposit_col: int | None
+    memo_col: int | None
+    category_col: int | None
+
+
+def _layout(header: list[str]) -> _Layout:
+    names = [_norm(h) for h in header]
+    date_col = _find(names, _DATE_NAMES)
+    if date_col is None:
+        raise ValueError("日付列が見つかりません")
+    withdraw = _find(names, _WITHDRAW_NAMES)
+    amount = _find(names, _AMOUNT_NAMES)
+    spend = list(dict.fromkeys(c for c in (withdraw, amount) if c is not None))
+    if not spend:
+        raise ValueError("金額列が見つかりません")
+    return _Layout(
+        header=header,
+        date_col=date_col,
+        spend=spend,
+        deposit_col=_find(names, _DEPOSIT_NAMES),
+        memo_col=_find(names, _MEMO_NAMES),
+        category_col=_find(names, _CATEGORY_NAMES),
+    )
+
+
+def _convert(
+    line: int, row: list[str], lay: _Layout
+) -> tuple[list[RowError], Expense | None, bool]:
+    """1 行を変換する。戻り値は (エラー, Expense, 入金だけの行か)。"""
+    header = lay.header
+    errors: list[RowError] = []
+
+    def cell(i: int) -> str | None:
+        return row[i] if i < len(row) else None
+
+    def fail(i: int, value: str, reason: str) -> None:
+        errors.append(RowError(line, header[i], value, reason))
+
+    day: date | None = None
+    raw_date = cell(lay.date_col)
+    if raw_date is not None:
+        try:
+            day = _parse_date(raw_date)
+        except ValueError as e:
+            fail(lay.date_col, raw_date, str(e))
+
+    amount: int | None = None
+    is_income = False
+    filled = next((c for c in lay.spend if (cell(c) or "").strip()), None)
+    if filled is not None:
+        raw = cell(filled) or ""
+        try:
+            amount = _parse_amount(raw)
+        except ValueError as e:
+            fail(filled, raw, str(e))
+    elif any(cell(c) is None for c in lay.spend):
+        pass  # 列が足りない。下の不足エラーで報告する
+    elif lay.deposit_col is not None and (cell(lay.deposit_col) or "").strip():
+        raw = cell(lay.deposit_col) or ""
+        try:
+            _parse_amount(raw)
+        except ValueError as e:
+            fail(lay.deposit_col, raw, str(e))
+        else:
+            is_income = True
+    else:
+        first = lay.spend[0]
+        fail(first, cell(first) or "", "金額が空です")
+
+    memo = ""
+    if lay.memo_col is not None:
+        memo = (cell(lay.memo_col) or "").strip()
+    category = DEFAULT_CATEGORY
+    if lay.category_col is not None:
+        category = (cell(lay.category_col) or "").strip()
+
+    for i in range(len(header)):
+        if i >= len(row):
+            errors.append(RowError(line, header[i], "", "列が不足しています"))
+
+    if errors:
+        return errors, None, False
+    if is_income:
+        return [], None, True
+    if day is None or amount is None:  # エラーが無ければ到達しない
+        return [RowError(line, header[lay.date_col], "", "変換できません")], None, False
+    return [], Expense(day=day, category=category, amount=amount, memo=memo), False
+
+
+def import_bank_csv(text: str) -> ImportResult:
+    """銀行 CSV のテキストを取り込む。不正な行は RowError にし、例外は投げない。
+
+    ヘッダーに日付列または金額列が無いときだけ ValueError を投げる。
+    """
+    text = text.removeprefix("﻿")
+    if not text.strip():
+        return ImportResult(expenses=[], errors=[], skipped=0)
+
+    first_line = re.split(r"\r\n|\r|\n", text, maxsplit=1)[0]
+    delimiter = "\t" if first_line.count("\t") > first_line.count(",") else ","
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delimiter)
+    try:
+        header = next(reader)
+    except csv.Error as e:
+        raise ValueError(f"ヘッダーを解析できません: {e}") from None
+    lay = _layout(header)
+
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    skipped = 0
+    while True:
+        line = reader.line_num + 1  # 次のレコードの開始行
+        try:
+            row = next(reader)
+        except StopIteration:
+            break
+        except csv.Error as e:
+            errors.append(RowError(line, "", "", f"CSV を解析できません: {e}"))
+            break
+        if not any(c.strip() for c in row):
+            skipped += 1
+            continue
+        row_errors, expense, is_income = _convert(line, row, lay)
+        errors.extend(row_errors)
+        if expense is not None:
+            expenses.append(expense)
+        elif is_income:
+            skipped += 1
+    return ImportResult(expenses=expenses, errors=errors, skipped=skipped)
