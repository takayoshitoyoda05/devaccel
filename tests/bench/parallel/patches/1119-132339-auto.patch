@@ -0,0 +1,70 @@
+"""Predicate builders and a pure search over Expense rows."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable
+from datetime import date
+
+from kakeibo.core import Expense
+
+Predicate = Callable[[Expense], bool]
+
+
+def _check_pred(p: object) -> Predicate:
+    if not callable(p):
+        raise TypeError(f"述語ではありません: {p!r}")
+    return p  # type: ignore[return-value]
+
+
+def _normalize(text: str) -> str:
+    return unicodedata.normalize("NFKC", text).casefold()
+
+
+def category(*names: str) -> Predicate:
+    """いずれかの名前と完全一致(前後の空白は除去して比較)。"""
+    if not names:
+        raise ValueError("category には 1 つ以上の名前が必要です")
+    wanted = frozenset(n.strip() for n in names)
+    return lambda e: e.category in wanted
+
+
+def amount_between(lo: int | None = None, hi: int | None = None) -> Predicate:
+    """lo 以上 hi 以下(両端含む)。None は無制限。"""
+    if lo is not None and hi is not None and lo > hi:
+        raise ValueError(f"下限 {lo} が上限 {hi} を超えています")
+    return lambda e: (lo is None or e.amount >= lo) and (hi is None or e.amount <= hi)
+
+
+def memo_contains(text: str) -> Predicate:
+    """NFKC 正規化・大文字小文字無視の部分一致。空文字は常に真。"""
+    needle = _normalize(text)
+    return lambda e: needle in _normalize(e.memo)
+
+
+def between_dates(start: date | None = None, end: date | None = None) -> Predicate:
+    """day が start 以上 end 以下(両端含む)。None は無制限。"""
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"開始 {start} が終了 {end} を超えています")
+    return lambda e: (start is None or e.day >= start) and (end is None or e.day <= end)
+
+
+def and_(*preds: Predicate) -> Predicate:
+    checked = [_check_pred(p) for p in preds]
+    return lambda e: all(p(e) for p in checked)
+
+
+def or_(*preds: Predicate) -> Predicate:
+    checked = [_check_pred(p) for p in preds]
+    return lambda e: any(p(e) for p in checked)
+
+
+def not_(pred: Predicate) -> Predicate:
+    checked = _check_pred(pred)
+    return lambda e: not checked(e)
+
+
+def search(rows: list[Expense], pred: Predicate) -> list[Expense]:
+    """pred を満たす行を入力順に返す。rows は変更しない。"""
+    checked = _check_pred(pred)
+    return [e for e in rows if checked(e)]
