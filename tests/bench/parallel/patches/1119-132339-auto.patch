@@ -0,0 +1,88 @@
+"""Month-over-month comparison of category totals (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    diff: int
+    pct: float | None
+    trend: str
+
+
+def _parse_month(month: str) -> tuple[int, int]:
+    if not isinstance(month, str) or not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+    year, mon = int(month[:4]), int(month[5:])
+    return year, mon
+
+
+def _previous_month(year: int, mon: int) -> str:
+    if mon == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mon - 1:02d}"
+
+
+def _totals(rows: list[Expense], month: str) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for e in rows:
+        if e.day.strftime("%Y-%m") == month:
+            out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def month_over_month(rows: list[Expense], month: str) -> list[CategoryChange]:
+    year, mon = _parse_month(month)
+    prev_month = _previous_month(year, mon)
+
+    current_totals = _totals(rows, month)
+    previous_totals = _totals(rows, prev_month)
+
+    changes: list[CategoryChange] = []
+    for category in set(current_totals) | set(previous_totals):
+        previous = previous_totals.get(category, 0)
+        current = current_totals.get(category, 0)
+        diff = current - previous
+        pct = None if previous == 0 else round(diff / previous * 100, 1) + 0.0
+        if diff > 0:
+            trend = "増"
+        elif diff < 0:
+            trend = "減"
+        else:
+            trend = "変化なし"
+        changes.append(
+            CategoryChange(
+                category=category,
+                previous=previous,
+                current=current,
+                diff=diff,
+                pct=pct,
+                trend=trend,
+            )
+        )
+
+    changes.sort(key=lambda c: (-abs(c.diff), c.category))
+    return changes
+
+
+def format_report(changes: list[CategoryChange]) -> str:
+    if not changes:
+        return "データなし"
+    lines: list[str] = []
+    for c in changes:
+        pct_text = "新規" if c.pct is None else f"{c.pct:+.1f}%"
+        lines.append(
+            f"{c.category}: {c.previous:,}円 → {c.current:,}円 "
+            f"({c.diff:+,}円, {pct_text}) {c.trend}"
+        )
+    return "\n".join(lines)
