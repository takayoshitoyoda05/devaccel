@@ -0,0 +1,134 @@
+"""Detect recurring expenses (subscriptions, rent, ...) from a list of Expense.
+
+Pure functions only: no file I/O, no persistence.
+"""
+
+from __future__ import annotations
+
+import calendar
+import itertools
+import math
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_TRAILING_RE = re.compile(r"[0-9#\-_/ ]+$")
+_DAY_GAP_LIMIT = 3
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int  # yen, amount of the latest month
+    months: tuple[str, ...]  # "YYYY-MM", ascending
+    day: int  # max day of month within the run
+    next_date: date
+
+
+def _norm_memo(memo: str) -> str:
+    s = unicodedata.normalize("NFKC", memo).casefold()
+    s = re.sub(r"\s+", " ", s).strip()
+    return _TRAILING_RE.sub("", s).strip()
+
+
+def _check_args(rows: object, min_count: object, tolerance: object) -> None:
+    if not isinstance(rows, list):
+        raise TypeError("rows は list[Expense] である必要があります")
+    if isinstance(min_count, bool) or not isinstance(min_count, int):
+        raise TypeError("min_count は int である必要があります")
+    if min_count < 2:
+        raise ValueError(f"min_count は 2 以上である必要があります: {min_count}")
+    if isinstance(tolerance, bool) or not isinstance(tolerance, (int, float)):
+        raise TypeError("tolerance は int か float である必要があります")
+    if math.isnan(tolerance):
+        raise ValueError("tolerance は nan にできません")
+    if not 0 <= tolerance < 1:
+        raise ValueError(f"tolerance は 0 以上 1 未満である必要があります: {tolerance}")
+
+
+def _split_series(items: list[Expense]) -> list[list[Expense]]:
+    """Split one (category, memo) group into series by day-of-month gaps."""
+    ordered = sorted(items, key=lambda e: e.day.day)
+    out: list[list[Expense]] = [[ordered[0]]]
+    for prev, cur in itertools.pairwise(ordered):
+        if cur.day.day - prev.day.day > _DAY_GAP_LIMIT:
+            out.append([cur])
+        else:
+            out[-1].append(cur)
+    return out
+
+
+def _prev_month(y: int, m: int) -> tuple[int, int]:
+    return (y - 1, 12) if m == 1 else (y, m - 1)
+
+
+def _next_month(y: int, m: int) -> tuple[int, int]:
+    return (y + 1, 1) if m == 12 else (y, m + 1)
+
+
+def _detect(
+    series: list[Expense], category: str, min_count: int, tolerance: float
+) -> Recurring | None:
+    by_month: dict[str, Expense] = {}
+    for e in series:
+        key = e.day.strftime("%Y-%m")
+        if key in by_month:
+            return None  # two or more entries in one month: not a subscription
+        by_month[key] = e
+
+    latest = max(by_month.values(), key=lambda e: e.day)
+    y, m = latest.day.year, latest.day.month
+    run = [f"{y:04d}-{m:02d}"]
+    py, pm = y, m
+    while True:
+        py, pm = _prev_month(py, pm)
+        key = f"{py:04d}-{pm:02d}"
+        if key not in by_month:
+            break
+        run.append(key)
+    if len(run) < min_count:
+        return None
+    for key in run:
+        if abs(by_month[key].amount - latest.amount) > tolerance * latest.amount:
+            return None
+
+    run.reverse()
+    day = max(by_month[key].day.day for key in run)
+    ny, nm = _next_month(y, m)
+    last = calendar.monthrange(ny, nm)[1]
+    return Recurring(
+        category=category,
+        memo=latest.memo.strip(),
+        amount=latest.amount,
+        months=tuple(run),
+        day=day,
+        next_date=date(ny, nm, min(day, last)),
+    )
+
+
+def find_recurring(
+    rows: list[Expense], *, min_count: int = 3, tolerance: float = 0.1
+) -> list[Recurring]:
+    """Return recurring series sorted by (next_date, category, normalized memo)."""
+    _check_args(rows, min_count, tolerance)
+
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        if e.amount <= 0:  # refunds and zero-yen rows are not subscriptions
+            continue
+        key = (e.category.strip(), _norm_memo(e.memo))
+        groups.setdefault(key, []).append(e)
+
+    found: list[tuple[tuple[date, str, str], Recurring]] = []
+    for (category, memo_key), items in groups.items():
+        for series in _split_series(items):
+            rec = _detect(series, category, min_count, tolerance)
+            if rec is not None:
+                found.append(((rec.next_date, category, memo_key), rec))
+
+    found.sort(key=lambda pair: pair[0])
+    return [rec for _, rec in found]
