+"""Month-over-month comparison of expenses (pure functions)."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from kakeibo.core import Expense, monthly_totals
+
+_LABELS = {
+    "up": "増",
+    "down": "減",
+    "same": "変わらず",
+    "new": "新規",
+    "gone": "なくなった",
+}
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    diff: int
+    ratio: float | None
+    status: str
+
+
+@dataclass(frozen=True)
+class MonthComparison:
+    month: str
+    previous_month: str
+    changes: tuple[CategoryChange, ...]
+    total_previous: int
+    total_current: int
+
+
+def _prev_month(month: str) -> str:
+    year, mon = int(month[:4]), int(month[5:7])
+    if mon == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mon - 1:02d}"
+
+
+def _next_month(month: str) -> str:
+    year, mon = int(month[:4]), int(month[5:7])
+    if mon == 12:
+        return f"{year + 1:04d}-01"
+    return f"{year:04d}-{mon + 1:02d}"
+
+
+def _compare(
+    month: str,
+    previous_month: str,
+    prev_cats: dict[str, int],
+    cur_cats: dict[str, int],
+) -> MonthComparison:
+    changes: list[CategoryChange] = []
+    for cat in set(prev_cats) | set(cur_cats):
+        previous = prev_cats.get(cat, 0)
+        current = cur_cats.get(cat, 0)
+        diff = current - previous
+        ratio = diff / previous if previous != 0 else None
+        if cat not in prev_cats:
+            status = "new"
+        elif cat not in cur_cats:
+            status = "gone"
+        elif diff > 0:
+            status = "up"
+        elif diff < 0:
+            status = "down"
+        else:
+            status = "same"
+        changes.append(CategoryChange(cat, previous, current, diff, ratio, status))
+    changes.sort(key=lambda ch: (-abs(ch.diff), ch.category))
+    return MonthComparison(
+        month=month,
+        previous_month=previous_month,
+        changes=tuple(changes),
+        total_previous=sum(prev_cats.values()),
+        total_current=sum(cur_cats.values()),
+    )
+
+
+def compare_months(rows: list[Expense]) -> list[MonthComparison]:
+    """Compare each month with the calendar month before it.
+
+    Runs from the month after the first month to the last month, including
+    gap months (which are empty). Fewer than two months gives [].
+    """
+    if not isinstance(rows, list):
+        raise TypeError("rows は list[Expense] である必要があります")
+    for i, e in enumerate(rows):
+        if not isinstance(e, Expense):
+            raise TypeError(f"rows[{i}] は Expense である必要があります")
+    totals = monthly_totals(rows)
+    if len(totals) <= 1:
+        return []
+    first, last = min(totals), max(totals)
+    result: list[MonthComparison] = []
+    month = _next_month(first)
+    while month <= last:
+        prev = _prev_month(month)
+        result.append(
+            _compare(month, prev, totals.get(prev, {}), totals.get(month, {}))
+        )
+        month = _next_month(month)
+    return result
+
+
+def format_comparison(c: MonthComparison) -> str:
+    if not isinstance(c, MonthComparison):
+        raise TypeError("c は MonthComparison である必要があります")
+    lines = [f"{c.month} (前月 {c.previous_month})"]
+    for ch in c.changes:
+        pct = "-" if ch.ratio is None else f"{ch.ratio * 100:+.1f}%"
+        lines.append(f"{ch.category}\t{ch.diff:+d}円\t{pct}\t{_LABELS[ch.status]}")
+    return "\n".join(lines)
diff --git a/tests/test_bank_import.py b/tests/test_bank_import.py
new file mode 100644
index 0000000..103a2a4
--- /dev/null
+++ b/tests/test_bank_import.py
@@ -0,0 +1,385 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import import_bank_csv
+from kakeibo.core import CsvError, Expense
+
+Result = tuple[list[Expense], list[tuple[int, str]]]
+
+
+def _one(day: date, amount: int, category: str = "未分類", memo: str = "") -> Expense:
+    return Expense(day, category, amount, memo)
+
+
+# --- 例の表 (E1-1 .. E1-3) ---------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param(
+            '利用日,利用店名,利用金額\n2026/1/5,カフェ,"1,234円"',
+            ([_one(date(2026, 1, 5), 1234, "未分類", "カフェ")], []),
+            id="E1-1",
+        ),
+        pytest.param(
+            "日付,摘要,出金額,入金額\n2026-01-05,給与,,300000",
+            ([], []),
+            id="E1-2",
+        ),
+        pytest.param(
+            "日付,金額\n2026/2/30,12.5",
+            (
+                [],
+                [
+                    (
+                        2,
+                        (
+                            "日付が不正です(列 日付): '2026/2/30'; "
+                            "金額が整数ではありません(列 金額): '12.5'"
+                        ),
+                    )
+                ],
+            ),
+            id="E1-3",
+        ),
+    ],
+)
+def test_spec_table(text: str, expected: Result) -> None:
+    assert import_bank_csv(text) == expected
+
+
+# --- R1: 入力の形 -------------------------------------------------------------
+
+
+@pytest.mark.parametrize("newline", ["\r\n", "\n", "\r"])
+def test_bom_and_every_newline_style(newline: str) -> None:
+    text = "﻿" + newline.join(["日付,金額", "2026-01-05,100", ""])
+    assert import_bank_csv(text) == ([_one(date(2026, 1, 5), 100)], [])
+
+
+def test_tab_delimiter_when_tabs_outnumber_commas() -> None:
+    assert import_bank_csv("日付\t金額\n2026-01-05\t100") == (
+        [_one(date(2026, 1, 5), 100)],
+        [],
+    )
+
+
+def test_tie_between_comma_and_tab_uses_comma() -> None:
+    # ヘッダーのカンマとタブが同数 → カンマ区切り。金額\t は前後空白除去で「金額」になる。
+    assert import_bank_csv("日付,金額\t\n2026-01-05,100") == (
+        [_one(date(2026, 1, 5), 100)],
+        [],
+    )
+
+
+def test_quoted_comma_newline_and_escaped_quote_form_one_record() -> None:
+    text = '日付,摘要,金額\n2026-01-05,"a,b\nc ""d""",100'
+    assert import_bank_csv(text) == (
+        [_one(date(2026, 1, 5), 100, "未分類", 'a,b\nc "d"')],
+        [],
+    )
+
+
+def test_error_line_number_is_record_start_after_quoted_newline() -> None:
+    text = '日付,摘要,金額\n2026-01-05,"a\nb",100\n2026/2/30,x,5'
+    assert import_bank_csv(text) == (
+        [_one(date(2026, 1, 5), 100, "未分類", "a\nb")],
+        [(4, "日付が不正です(列 日付): '2026/2/30'")],
+    )
+
+
+def test_blank_lines_are_skipped_but_counted() -> None:
+    assert import_bank_csv("日付,金額\n\n2026/2/30,5\n\n") == (
+        [],
+        [(3, "日付が不正です(列 日付): '2026/2/30'")],
+    )
+
+
+@pytest.mark.parametrize("text", ["", "日付,金額", "日付,金額\n", "\n\n"])
+def test_empty_or_header_only_returns_empty(text: str) -> None:
+    assert import_bank_csv(text) == ([], [])
+
+
+def test_non_str_input_is_type_error() -> None:
+    with pytest.raises(TypeError):
+        import_bank_csv(None)  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        import_bank_csv(b"date,amount\n2026-01-05,100")  # type: ignore[arg-type]
+
+
+# --- R2: ヘッダーの別名 -------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "name", ["日付", "利用日", "ご利用日", "取引日", "年月日", "date"]
+)
+def test_date_header_aliases(name: str) -> None:
+    assert import_bank_csv(f"{name},金額\n2026-01-05,100") == (
+        [_one(date(2026, 1, 5), 100)],
+        [],
+    )
+
+
+@pytest.mark.parametrize("name", ["金額", "利用金額", "ご利用金額", "amount"])
+def test_amount_header_aliases(name: str) -> None:
+    assert import_bank_csv(f"日付,{name}\n2026-01-05,100") == (
+        [_one(date(2026, 1, 5), 100)],
+        [],
+    )
