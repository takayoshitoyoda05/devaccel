@@ -0,0 +1,63 @@
+# 明細ツール 4 種(取込・定期支出・検索・前月比)
+目的: 明細(`Expense`)を扱う純粋関数のモジュールを 4 つ足す。 / やらないこと: CLI・既存ファイルの変更、ファイル I/O(入力は str か `list[Expense]`)、永続化
+共通前提: 標準ライブラリのみ・既存ファイル不変・金額は円の整数。既存の `kakeibo.core` から `Expense`(day, category, amount, memo)・`CsvError`(errors: list[tuple[int,str]])・`monthly_totals` を import して使い、同じ型を作り直さない。月キーは `"YYYY-MM"` 文字列。テストは各件の `tests/test_<module>.py`。公開関数の引数検査: `bool` は `int` として受けず `TypeError`、型違い(`str` を int に等)は `TypeError`、範囲違いは `ValueError`(どの引数が悪いかをメッセージに書く)。どれもテストにする。
+判断一覧:
+- D1 取込は例外で止めず `(明細, エラー)` を返す: 悪い行だけ `errors: list[tuple[int, str]]`(`CsvError.errors` と同じ形)に入れ、良い行は読む。ヘッダーに日付列か金額列(金額 or 出金/入金)が無いときだけ `CsvError([(1, 理由)])` を送出
+- D2 1 列の金額で負数は返金として負の `Expense.amount` で残す(正が支出)。出金/入金の 2 列形式は、入金だけの行を黙ってスキップ
+- D3 カテゴリ列が無い CSV はカテゴリを `"未分類"` にする
+- D4 定期支出の金額は ±10 % までの揺れ・値上げを同じ系列とみなす。返金・0 円は系列に混ぜない
+- D5 前月比は、データの最初の月の次の月から最後の月まで途中の欠けた月も含めて並べる。欠けた月は空の月(全カテゴリ 0)
+- D6 検索の文字列一致は NFKC + 大文字小文字無視の部分一致、範囲・期間は両端を含む
+
+1. `src/kakeibo/bank_import.py` + `tests/test_bank_import.py` — `def import_bank_csv(text: str) -> tuple[list[Expense], list[tuple[int, str]]]`
+規則:
+- R1 入力: BOM(`﻿`)は除く。改行は `\r\n` `\n` `\r`。区切りはヘッダー行の `,` とタブの数が多い方(同数は `,`)。引用符内の区切り・改行は 1 つのレコード。報告する行番号はそのレコードの開始行(ヘッダーが 1)。空行は黙って飛ばす。空文字列・ヘッダーだけは `([], [])`
+- R2 ヘッダーは NFKC 正規化・前後空白除去・大文字小文字無視で次の別名を受ける。日付: `日付` `利用日` `ご利用日` `取引日` `年月日` `date`。金額: `金額` `利用金額` `ご利用金額` `amount`。出金: `出金額` `出金` `支払` `お支払金額`。入金: `入金額` `入金` `預入` `お預り金額`。メモ: `摘要` `メモ` `利用店名` `ご利用店名` `内容` `description` `memo`。カテゴリ: `カテゴリ` `分類` `category`。金額列があればそれを使い出金/入金は無視。日付が無い・金額系が無い → `CsvError`(D1)。メモ・カテゴリ列は無くてもよい(メモ `""`、カテゴリ D3)
+- R3 金額は NFKC 後に空白(全角含む)・`¥` `￥` `円` `JPY` `,` `，` を除いて解釈。負数は `-300` `−300`(U+2212)`△500` `▲500` `(500)` `500-`、それ以外は正。小数は `1200.00` のように小数部が全て 0 なら受け、`12.5` は拒否。`1e3` や `abc` も拒否。1 列形式で空欄・`-`・`—` は拒否(「金額が空です」)。`0` は 0 として受ける。出金/入金形式: 出金が非空かつ 0 でなければそれを正の支出にし、入金のみの行は D2 でスキップ、出金・入金とも有効な非 0 値は「出金と入金が両方あります」エラー、両方空/0 の行はスキップ
+- R4 日付は `2026-01-05` `2026/1/5` `2026.1.5` `20260105` `2026年1月5日` と、和暦 `R8.1.5` `令和8年1月5日`(R=2018+年、H=1988+年、S=1925+年、`令和` `平成` `昭和` も可、元年 `元` も可)。末尾の時刻(空白または `T` の後ろ)は無視。存在しない日付(2/30)は拒否
+- R5 1 行に複数の誤りがあれば全てを `; ` で連ねて 1 件にする。各メッセージは列名(ヘッダーの書かれたまま)と元の値を含める(例: `日付が不正です(列 利用日): '2026/2/30'`)。列数がヘッダーと違う行は他を検査せず `列数が合いません(ヘッダー 4 列 / この行 5 列)` とし、過剰のときは「引用されていない区切りを含む可能性」と添える。カテゴリ・メモは前後空白除去
+- R6 結果の `Expense` は入力の行順
+例:
+| ID | 入力 | 出力 | 規則 |
+| E1-1 | `利用日,利用店名,利用金額\n2026/1/5,カフェ,"1,234円"` | `[Expense(2026-01-05,"未分類",1234,"カフェ")]`, `[]` | R2,R3 |
+| E1-2 | `日付,摘要,出金額,入金額\n2026-01-05,給与,,300000` | `([], [])` | R3,D2 |
+| E1-3 | `日付,金額\n2026/2/30,12.5` | `([], [(2, "日付が不正です(列 日付): '2026/2/30'; 金額が整数ではありません(列 金額): '12.5'")])` | R5 |
+
+2. `src/kakeibo/recurring.py` + `tests/test_recurring.py` — `@dataclass(frozen=True) class Recurring(category: str, memo: str, amount: int, months: tuple[str, ...], day: int, next_date: date)` と `def find_recurring(rows: list[Expense], *, min_count: int = 3, tolerance: float = 0.1) -> list[Recurring]`
+規則:
+- R1 同一とみなす鍵は (category 前後空白除去, 正規化メモ)。正規化メモ = NFKC・casefold・空白の連続を 1 つに・前後空白除去・末尾の数字と記号(`#` `-` `_` `/` 空白)を除去。メモが空でも鍵になる(カテゴリだけで束ねる)
+- R2 負・0 円の明細は無視(D4)。鍵ごとに、日(day of month)で並べ、隣との差が 3 日を超えたところで別の系列に分ける(5 日と 20 日に来る同カテゴリ・同メモの別物を分ける。月末またぎの巻き戻しは考えない)
+- R3 系列から、同じ月に 2 件以上ある月を持つものは繰り返しとみなさない。月の並びは、最新の月から遡って 1 か月ずつ連続する区間(欠けた月より前は無視)。その区間の長さが `min_count` 以上で、区間内の全金額が最新の金額の ±`tolerance`(比率、両端を含む)以内なら繰り返し
+- R4 `amount` は最新月の金額、`months` は区間の月(昇順)、`day` は区間内の日の最大値。`next_date` = 最新月の翌月の `min(day, その月の末日)`(1/31・2/28・3/31 の系列は 4/30、12 月の翌月は翌年 1 月、閏年を考慮)
+- R5 並びは `next_date` 昇順、同じなら category、memo(正規化メモ)の昇順。`memo` は区間内の最新明細の元のメモ(前後空白除去)
+- R6 引数検査: `min_count` は int で 2 以上(`TypeError`/`ValueError`)、`tolerance` は int か float で 0 以上 1 未満(`nan` は `ValueError`)。空の `rows` は `[]`
+例:
+| ID | 入力 | 出力 | 規則 |
+| E2-1 | Netflix 1490 円が 9/5・10/5・11/5(category=娯楽) | 1 件、`next_date=2026-12-05`、months=3 か月 | R3,R4 |
+| E2-2 | 家賃 1/31・2/28・3/31 | `next_date=2026-04-30`、day=31 | R4 |
+| E2-3 | 娯楽 同メモ 5 日 1000 円と 20 日 500 円が各 3 か月 | 2 件 | R2 |
+
+3. `src/kakeibo/search.py` + `tests/test_search.py` — 述語を組み立てる関数群と `def search(rows: list[Expense], pred: Predicate) -> list[Expense]`(`Predicate = Callable[[Expense], bool]`)
+規則:
+- R1 述語を返す関数: `category(*names: str)`(いずれかと完全一致、前後空白除去、名前が 0 個・非 str は `ValueError`/`TypeError`)、`amount_between(lo: int | None = None, hi: int | None = None)`(`None` は無制限、両端を含む、`lo > hi` は `ValueError`、`bool`・`float` は `TypeError`)、`memo_contains(text: str)`(D6、空文字は全件一致)、`between(start: date | None = None, end: date | None = None)`(`None` は無制限、両端を含む、`start > end` は `ValueError`、`datetime` と `str` は `TypeError`)
+- R2 組み合わせ: `all_of(*preds)`(AND、引数 0 個は常に真)、`any_of(*preds)`(OR、0 個は常に偽)、`not_(pred)`(NOT)。入れ子は自由。述語でないもの(`callable` でない)は `TypeError`。優先順位は呼び出しの入れ子で表す(文字列の式は解釈しない)
+- R3 `search` は入力の順序を保ち、新しい list を返す(入力は変更しない)。空の `rows` は `[]`
+例:
+| ID | 入力 | 出力 | 規則 |
+| E3-1 | `all_of(category("food"), amount_between(500, 1000))` で金額 500・1000・1001 の food | 500 と 1000 の 2 件 | R1,R2 |
+| E3-2 | `memo_contains("ｽﾀﾊﾞ")` と memo `スターバックス` ・`スタバ` | `スタバ` のみ(半角カナも NFKC で一致) | D6 |
+| E3-3 | `any_of()` と `all_of()` | 全件除外と全件一致 | R2 |
+
+4. `src/kakeibo/trend.py` + `tests/test_trend.py` — `@dataclass(frozen=True) class CategoryChange(category: str, previous: int, current: int, diff: int, ratio: float | None, status: str)` / `@dataclass(frozen=True) class MonthComparison(month: str, previous_month: str, changes: tuple[CategoryChange, ...], total_previous: int, total_current: int)` / `def compare_months(rows: list[Expense]) -> list[MonthComparison]` / `def format_comparison(c: MonthComparison) -> str`
+規則:
+- R1 月別・カテゴリ別の合計は `kakeibo.core.monthly_totals` を使う(返金の負数も合算)。`compare_months` は D5 に従い、最初の月の次の月から最後の月まで 1 か月ずつ、直前の暦月と比べる。月が 1 つ以下・空の `rows` は `[]`。`previous_month` は直前の暦月(`"2026-01"` の前は `"2025-12"`)
+- R2 `changes` は前月か今月のどちらかに現れたカテゴリ全て(合計が 0 でも現れていれば含める)。`diff = current - previous`。`ratio = diff / previous`(小数、`previous == 0` なら `None`)。`status`: 前月に無い → `"new"`、今月に無い → `"gone"`、それ以外で `diff > 0` → `"up"`、`diff < 0` → `"down"`、`diff == 0` → `"same"`(両月とも無い・前月 0 円で現れたカテゴリは数値として扱う)
+- R3 `changes` の並びは `abs(diff)` の降順、同じなら category 昇順。`total_previous` / `total_current` は各月の全カテゴリ合計
+- R4 `format_comparison` は 1 行目 `YYYY-MM (前月 YYYY-MM)`、続けて changes の順に 1 カテゴリ 1 行 `{category}\t{diff:+d}円\t{割合}\t{ラベル}`。割合は `ratio` を百分率で小数 1 桁(`+15.0%` `-8.3%`、0 は `+0.0%`)、`None` は `-`。ラベルは up=`増` down=`減` same=`変わらず` new=`新規` gone=`なくなった`。changes が空なら 1 行目だけ。末尾に改行は付けない
+- R5 引数検査: `rows` の要素が `Expense` でなければ `TypeError`
+例:
+| ID | 入力 | 出力 | 規則 |
+| E4-1 | 10 月 food 1000・11 月 food 1150 | diff=150、ratio=0.15、status=`up` | R2 |
+| E4-2 | 1 月に food があり 2 月が無く 3 月に food(3 月が最後の月) | 2 月は food が `gone`、3 月は food が `new` | D5,R2 |
+| E4-3 | 先月 0 円の food が今月 500 円 | status=`up`、ratio=`None`、割合表示 `-` | R2,R4 |
+<!-- end -->
diff --git a/src/kakeibo/bank_import.py b/src/kakeibo/bank_import.py
new file mode 100644
index 0000000..5e5b8b8
--- /dev/null
+++ b/src/kakeibo/bank_import.py
@@ -0,0 +1,326 @@
+"""銀行明細 CSV の取込: テキストを Expense の列に変換する。
+
+ファイル I/O はしない。悪い行で止めず、行番号付きのエラーとして返す。
+"""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import CsvError, Expense
+
+UNCATEGORIZED = "未分類"
+
+
+def _norm(text: str) -> str:
+    return unicodedata.normalize("NFKC", text).strip().casefold()
+
+
+def _aliases(*names: str) -> frozenset[str]:
+    return frozenset(_norm(n) for n in names)
+
+
+_DATE_KEYS = _aliases("日付", "利用日", "ご利用日", "取引日", "年月日", "date")
+_AMOUNT_KEYS = _aliases("金額", "利用金額", "ご利用金額", "amount")
+_WITHDRAW_KEYS = _aliases("出金額", "出金", "支払", "お支払金額")
+_DEPOSIT_KEYS = _aliases("入金額", "入金", "預入", "お預り金額")
+_MEMO_KEYS = _aliases(
+    "摘要", "メモ", "利用店名", "ご利用店名", "内容", "description", "memo"
+)
+_CATEGORY_KEYS = _aliases("カテゴリ", "分類", "category")
+
+# 空欄扱いの金額セル(クリーニング後)。
+_BLANK = frozenset({"", "-", "−", "—"})
+_DECIMAL = re.compile(r"([0-9]+)(?:\.([0-9]+))?")
+_WEST = re.compile(r"([0-9]{4})(?:[-/.]|年)([0-9]{1,2})(?:[-/.]|月)([0-9]{1,2})日?")
+_COMPACT = re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})")
+_WAREKI = re.compile(
+    r"(令和|平成|昭和|[RHS])(元|[0-9]{1,2})(?:年|[-/.])([0-9]{1,2})(?:月|[-/.])([0-9]{1,2})日?",
+    re.IGNORECASE,
+)
+_ERA_START = {"令和": 2018, "R": 2018, "平成": 1988, "H": 1988, "昭和": 1925, "S": 1925}
+
+
+class _FieldError(Exception):
+    def __init__(self, reason: str) -> None:
+        super().__init__(reason)
+        self.reason = reason
+
+
+@dataclass(frozen=True)
+class _Columns:
+    names: list[str]  # ヘッダーの書かれたまま(エラーメッセージ用)
+    day_col: int
+    amount_col: int | None
+    withdraw_col: int | None
+    deposit_col: int | None
+    memo_col: int | None
+    category_col: int | None
+
+
+def _split_records(text: str) -> list[tuple[int, str]]:
+    """(開始行, 生のレコード) の列。引用符内の改行はレコードに含める。"""
+    out: list[tuple[int, str]] = []
+    n = len(text)
+    i = 0
+    line = 1
+    start = 0
+    start_line = 1
+    quoted = False
+    at_start = True  # フィールドの先頭か
+    while i < n:
+        c = text[i]
+        if quoted:
+            if c == '"':
+                if i + 1 < n and text[i + 1] == '"':
+                    i += 2
+                    continue
+                quoted = False
+            elif c == "\n" or (c == "\r" and not (i + 1 < n and text[i + 1] == "\n")):
+                line += 1
+            i += 1
+            continue
+        if c == '"' and at_start:
+            quoted = True
+            at_start = False
+        elif c in ",\t":
+            at_start = True
+        elif c in "\r\n":
+            out.append((start_line, text[start:i]))
+            if c == "\r" and i + 1 < n and text[i + 1] == "\n":
+                i += 1
+            line += 1
+            start = i + 1
+            start_line = line
+            at_start = True
+        else:
+            at_start = False
+        i += 1
+    if start < n:
+        out.append((start_line, text[start:]))
+    return out
+
+
+def _split_fields(record: str, delim: str) -> list[str]:
+    fields: list[str] = []
+    buf: list[str] = []
+    at_start = True
+    i = 0
+    n = len(record)
+    while i < n:
+        c = record[i]
+        if at_start and c == '"':
+            i += 1
+            while i < n:
+                if record[i] == '"':
+                    if i + 1 < n and record[i + 1] == '"':
+                        buf.append('"')
+                        i += 2
+                        continue
+                    i += 1
+                    break
+                buf.append(record[i])
+                i += 1
+            at_start = False
+            continue
+        if c == delim:
+            fields.append("".join(buf))
+            buf = []
+            at_start = True
+        else:
+            buf.append(c)
+            at_start = False
+        i += 1
+    fields.append("".join(buf))
+    return fields
+
+
+def _delimiter(header_raw: str) -> str:
+    commas = len(_split_fields(header_raw, ",")) - 1
+    tabs = len(_split_fields(header_raw, "\t")) - 1
+    return "\t" if tabs > commas else ","
+
+
+def _find(keys: list[str], aliases: frozenset[str]) -> int | None:
+    for i, k in enumerate(keys):
+        if k in aliases:
+            return i
+    return None
+
+
+def _columns(header: list[str], line: int) -> _Columns:
+    keys = [_norm(h) for h in header]
+    day_col = _find(keys, _DATE_KEYS)
+    amount_col = _find(keys, _AMOUNT_KEYS)
+    withdraw_col = _find(keys, _WITHDRAW_KEYS)
+    deposit_col = _find(keys, _DEPOSIT_KEYS)
+    missing: list[str] = []
+    if day_col is None:
+        missing.append("日付列が見つかりません")
+    if amount_col is None and withdraw_col is None and deposit_col is None:
+        missing.append("金額列が見つかりません")
+    if missing or day_col is None:
+        raise CsvError([(line, "; ".join(missing))])
+    return _Columns(
+        names=[h.strip() for h in header],
+        day_col=day_col,
+        amount_col=amount_col,
+        withdraw_col=withdraw_col,
+        deposit_col=deposit_col,
+        memo_col=_find(keys, _MEMO_KEYS),
+        category_col=_find(keys, _CATEGORY_KEYS),
+    )
+
+
+def _ymd(text: str) -> tuple[int, int, int] | None:
+    m = _WEST.fullmatch(text) or _COMPACT.fullmatch(text)
+    if m is not None:
+        return int(m[1]), int(m[2]), int(m[3])
+    m = _WAREKI.fullmatch(text)
+    if m is None:
+        return None
+    year = _ERA_START[m[1].upper()] + (1 if m[2] == "元" else int(m[2]))
+    return year, int(m[3]), int(m[4])
+
+
+def _parse_date(raw: str) -> date | None:
+    text = unicodedata.normalize("NFKC", raw).strip()
+    text = re.split(r"[\sT]", text, maxsplit=1)[0]  # 末尾の時刻は無視
+    ymd = _ymd(text)
+    if ymd is None:
+        return None
+    try:
+        return date(*ymd)
+    except ValueError:
+        return None
+
+
+def _clean_yen(raw: str) -> str:
+    s = "".join(unicodedata.normalize("NFKC", raw).split())
+    s = re.sub(r"JPY", "", s, flags=re.IGNORECASE)
+    for ch in "¥円,":
+        s = s.replace(ch, "")
+    return s
+
+
+def _parse_yen(raw: str) -> int:
+    s = _clean_yen(raw)
+    if s in _BLANK:
+        raise _FieldError("金額が空です")
+    neg = False
+    if s[0] in "-−△▲":
+        neg, s = True, s[1:]
+    elif s[0] == "(" and s[-1] == ")":
+        neg, s = True, s[1:-1]
+    elif s[-1] == "-":
+        neg, s = True, s[:-1]
+    m = _DECIMAL.fullmatch(s)
+    if m is None or (m.group(2) is not None and m.group(2).strip("0") != ""):
+        raise _FieldError("金額が整数ではありません")
+    value = int(m.group(1))
+    return -value if neg else value
+
+
+def _cell_error(reason: str, col: str, raw: str) -> str:
+    return f"{reason}(列 {col})" + (f": '{raw}'" if raw else "")
+
+
+def _optional_yen(
+    col: int | None, fields: list[str], cols: _Columns, msgs: list[str]
+) -> int | None:
+    """出金/入金セル。空欄・- ・— は None(空)。"""
+    if col is None:
+        return None
+    raw = fields[col]
+    if _clean_yen(raw) in _BLANK:
+        return None
+    try:
+        return _parse_yen(raw)
+    except _FieldError as e:
+        msgs.append(_cell_error(e.reason, cols.names[col], raw.strip()))
+        return None
+
+
+def _convert(fields: list[str], cols: _Columns) -> tuple[Expense | None, list[str]]:
+    msgs: list[str] = []
+    raw_day = fields[cols.day_col].strip()
+    day = _parse_date(raw_day)
+    if day is None:
+        msgs.append(_cell_error("日付が不正です", cols.names[cols.day_col], raw_day))
+    category = (
+        fields[cols.category_col].strip()
+        if cols.category_col is not None
+        else UNCATEGORIZED
+    )
+    memo = fields[cols.memo_col].strip() if cols.memo_col is not None else ""
+
+    amount: int | None = None
+    skip = False
+    if cols.amount_col is not None:
+        raw = fields[cols.amount_col]
+        try:
+            amount = _parse_yen(raw)
+        except _FieldError as e:
+            msgs.append(_cell_error(e.reason, cols.names[cols.amount_col], raw.strip()))
+    else:
+        withdraw = _optional_yen(cols.withdraw_col, fields, cols, msgs)
+        deposit = _optional_yen(cols.deposit_col, fields, cols, msgs)
+        if withdraw and deposit:
+            msgs.append("出金と入金が両方あります")
+        elif withdraw:
+            amount = abs(withdraw)
+        else:
+            skip = True  # 入金のみ・両方空/0 は取込まない(D2)
+
+    if msgs:
+        return None, msgs
+    if skip or day is None or amount is None:
+        return None, []
+    return Expense(day, category, amount, memo), []
+
+
+def _count_message(header_n: int, row_n: int) -> str:
+    msg = f"列数が合いません(ヘッダー {header_n} 列 / この行 {row_n} 列)"
+    if row_n > header_n:
+        msg += "。引用されていない区切りを含む可能性があります"
+    return msg
+
+
+def import_bank_csv(text: str) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """銀行明細 CSV のテキストを (明細, エラー) に変換する。
+
+    エラーは (行番号, 理由) で、行番号はレコードの開始行(ヘッダーが 1)。
+    ヘッダーに日付列か金額列が無いときだけ CsvError を送出する。
+    """
+    if not isinstance(text, str):
+        raise TypeError(
+            f"text は str である必要があります(実際: {type(text).__name__})"
+        )
+    records = [
+        (line, raw)
+        for line, raw in _split_records(text.removeprefix("﻿"))
+        if raw.strip()
+    ]
+    if not records:
+        return [], []
+    header_line, header_raw = records[0]
+    delim = _delimiter(header_raw)
+    header = _split_fields(header_raw, delim)
+    cols = _columns(header, header_line)
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    for line, raw in records[1:]:
+        fields = _split_fields(raw, delim)
+        if len(fields) != len(header):
+            errors.append((line, _count_message(len(header), len(fields))))
+            continue
+        expense, msgs = _convert(fields, cols)
+        if msgs:
+            errors.append((line, "; ".join(msgs)))
+        elif expense is not None:
+            expenses.append(expense)
+    return expenses, errors
