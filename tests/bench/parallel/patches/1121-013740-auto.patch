@@ -0,0 +1,125 @@
+"""Predicate builders and search over Expense rows (pure functions)."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable
+from datetime import date, datetime
+
+from kakeibo.core import Expense
+
+Predicate = Callable[[Expense], bool]
+
+
+def _check_pred(pred: object, where: str) -> None:
+    if not callable(pred):
+        raise TypeError(f"{where} は述語(callable)である必要があります: {pred!r}")
+
+
+def _check_int_or_none(value: object, name: str) -> None:
+    if value is None:
+        return
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{name} は int か None である必要があります: {value!r}")
+
+
+def _check_date_or_none(value: object, name: str) -> None:
+    if value is None:
+        return
+    if isinstance(value, datetime) or not isinstance(value, date):
+        raise TypeError(f"{name} は date か None である必要があります: {value!r}")
+
+
+def _normalize(text: str) -> str:
+    return unicodedata.normalize("NFKC", text).casefold()
+
+
+def category(*names: str) -> Predicate:
+    """Match if the category equals any of ``names`` (surrounding spaces ignored)."""
+    if not names:
+        raise ValueError("category には名前を 1 つ以上渡してください")
+    for name in names:
+        if not isinstance(name, str):
+            raise TypeError(f"category の名前は str である必要があります: {name!r}")
+    wanted = frozenset(name.strip() for name in names)
+
+    def pred(e: Expense) -> bool:
+        return e.category in wanted
+
+    return pred
+
+
+def amount_between(lo: int | None = None, hi: int | None = None) -> Predicate:
+    """Match if lo <= amount <= hi (inclusive). None means unbounded."""
+    _check_int_or_none(lo, "lo")
+    _check_int_or_none(hi, "hi")
+    if lo is not None and hi is not None and lo > hi:
+        raise ValueError(f"lo({lo}) は hi({hi}) 以下である必要があります")
+
+    def pred(e: Expense) -> bool:
+        return (lo is None or e.amount >= lo) and (hi is None or e.amount <= hi)
+
+    return pred
+
+
+def memo_contains(text: str) -> Predicate:
+    """Match if memo contains ``text`` (NFKC + case-insensitive partial match)."""
+    if not isinstance(text, str):
+        raise TypeError(f"memo_contains には str を渡してください: {text!r}")
+    needle = _normalize(text)
+
+    def pred(e: Expense) -> bool:
+        return needle in _normalize(e.memo)
+
+    return pred
+
+
+def between(start: date | None = None, end: date | None = None) -> Predicate:
+    """Match if start <= day <= end (inclusive). None means unbounded."""
+    _check_date_or_none(start, "start")
+    _check_date_or_none(end, "end")
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"start({start}) は end({end}) 以前である必要があります")
+
+    def pred(e: Expense) -> bool:
+        return (start is None or e.day >= start) and (end is None or e.day <= end)
+
+    return pred
+
+
+def all_of(*preds: Predicate) -> Predicate:
+    """AND of predicates. With no arguments, always True."""
+    for p in preds:
+        _check_pred(p, "all_of の引数")
+
+    def pred(e: Expense) -> bool:
+        return all(p(e) for p in preds)
+
+    return pred
+
+
+def any_of(*preds: Predicate) -> Predicate:
+    """OR of predicates. With no arguments, always False."""
+    for p in preds:
+        _check_pred(p, "any_of の引数")
+
+    def pred(e: Expense) -> bool:
+        return any(p(e) for p in preds)
+
+    return pred
+
+
+def not_(p: Predicate) -> Predicate:
+    """Negation of a predicate."""
+    _check_pred(p, "not_ の引数")
+
+    def pred(e: Expense) -> bool:
+        return not p(e)
+
+    return pred
+
+
+def search(rows: list[Expense], pred: Predicate) -> list[Expense]:
+    """Return the rows matching ``pred``, in input order, as a new list."""
+    _check_pred(pred, "search の pred")
+    return [e for e in rows if pred(e)]
