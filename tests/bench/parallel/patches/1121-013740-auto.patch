+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring
+
+
+def _e(
+    y: int, m: int, d: int, amount: int, category: str = "娯楽", memo: str = "Netflix"
+) -> Expense:
+    return Expense(date(y, m, d), category, amount, memo)
+
+
+# --- 表の例 (E2-1 .. E2-3) -------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("case_id", "rows", "expected"),
+    [
+        pytest.param(
+            "E2-1",
+            [_e(2026, 9, 5, 1490), _e(2026, 10, 5, 1490), _e(2026, 11, 5, 1490)],
+            [
+                Recurring(
+                    "娯楽",
+                    "Netflix",
+                    1490,
+                    ("2026-09", "2026-10", "2026-11"),
+                    5,
+                    date(2026, 12, 5),
+                )
+            ],
+            id="E2-1",
+        ),
+        pytest.param(
+            "E2-2",
+            [
+                _e(2026, 1, 31, 80000, "住居", "家賃"),
+                _e(2026, 2, 28, 80000, "住居", "家賃"),
+                _e(2026, 3, 31, 80000, "住居", "家賃"),
+            ],
+            [
+                Recurring(
+                    "住居",
+                    "家賃",
+                    80000,
+                    ("2026-01", "2026-02", "2026-03"),
+                    31,
+                    date(2026, 4, 30),
+                )
+            ],
+            id="E2-2",
+        ),
+        pytest.param(
+            "E2-3",
+            [
+                _e(2026, 9, 5, 1000, memo="映画"),
+                _e(2026, 10, 5, 1000, memo="映画"),
+                _e(2026, 11, 5, 1000, memo="映画"),
+                _e(2026, 9, 20, 500, memo="映画"),
+                _e(2026, 10, 20, 500, memo="映画"),
+                _e(2026, 11, 20, 500, memo="映画"),
+            ],
+            [
+                Recurring(
+                    "娯楽",
+                    "映画",
+                    1000,
+                    ("2026-09", "2026-10", "2026-11"),
+                    5,
+                    date(2026, 12, 5),
+                ),
+                Recurring(
+                    "娯楽",
+                    "映画",
+                    500,
+                    ("2026-09", "2026-10", "2026-11"),
+                    20,
+                    date(2026, 12, 20),
+                ),
+            ],
+            id="E2-3",
+        ),
+    ],
+)
+def test_spec_examples(
+    case_id: str, rows: list[Expense], expected: list[Recurring]
+) -> None:
+    assert find_recurring(rows) == expected, case_id
+
+
+# --- R1: 鍵(カテゴリ・正規化メモ) ------------------------------------------
+
+
+def test_R1_memo_variants_share_one_key() -> None:
+    rows = [
+        _e(2026, 9, 5, 1490, memo="Netflix"),
+        _e(2026, 10, 5, 1490, memo="ＮＥＴＦＬＩＸ  #2"),
+        _e(2026, 11, 5, 1490, memo=" netflix -3 "),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].memo == "netflix -3"
+
+
+def test_R1_category_is_stripped_for_key() -> None:
+    rows = [
+        _e(2026, 9, 5, 1490, category=" 娯楽 "),
+        _e(2026, 10, 5, 1490, category="娯楽"),
+        _e(2026, 11, 5, 1490, category="娯楽 "),
+    ]
+    result = find_recurring(rows)
+    assert [r.category for r in result] == ["娯楽"]
+
+
+def test_R1_empty_memo_groups_by_category_only() -> None:
+    rows = [
+        _e(2026, 9, 5, 1490, memo=""),
+        _e(2026, 10, 5, 1490, memo="  "),
+        _e(2026, 11, 5, 1490, memo=""),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].memo == ""
+
+
+def test_R1_different_memo_is_different_key() -> None:
+    rows = [
+        _e(2026, 9, 5, 1490, memo="Netflix"),
+        _e(2026, 10, 5, 1490, memo="Hulu"),
+        _e(2026, 11, 5, 1490, memo="Netflix"),
+    ]
+    assert find_recurring(rows) == []
+
+
+# --- R2: 負・0 円は無視、日で系列に分ける ---------------------------------
+
+
+def test_R2_refund_and_zero_rows_are_ignored() -> None:
+    rows = [
+        _e(2026, 9, 5, 1490),
+        _e(2026, 10, 5, 1490),
+        _e(2026, 11, 5, 1490),
+        _e(2026, 11, 6, -1490),  # refund: must not make 11月 a duplicate
+        _e(2026, 11, 7, 0),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].amount == 1490
+
+
+def test_R2_gap_of_three_days_stays_in_one_series() -> None:
+    rows = [
+        _e(2026, 9, 5, 1490),
+        _e(2026, 10, 8, 1490),  # 3 日差: 同じ系列
+        _e(2026, 11, 5, 1490),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].day == 8
+
+
+def test_R2_gap_over_three_days_splits_series() -> None:
+    rows = [
+        _e(2026, 9, 5, 1490),
+        _e(2026, 10, 9, 1490),  # 4 日差: 別の系列
+        _e(2026, 11, 5, 1490),
+    ]
+    assert find_recurring(rows) == []
+
+
+# --- R3: 同月複数件・連続区間・min_count・tolerance -----------------------
+
+
+def test_R3_two_entries_in_one_month_is_not_recurring() -> None:
+    rows = [
+        _e(2026, 9, 5, 1490),
+        _e(2026, 10, 5, 1490),
+        _e(2026, 10, 6, 1490),
+        _e(2026, 11, 5, 1490),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_R3_gap_month_cuts_run_and_older_months_are_ignored() -> None:
+    rows = [
+        _e(2026, 1, 5, 9999),
+        _e(2026, 2, 5, 9999),
+        _e(2026, 3, 5, 9999),
+        # 2026-04 missing
+        _e(2026, 5, 5, 1490),
+        _e(2026, 6, 5, 1490),
+        _e(2026, 7, 5, 1490),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].months == ("2026-05", "2026-06", "2026-07")
+    assert result[0].amount == 1490
+
+
+def test_R3_run_shorter_than_min_count_is_not_recurring() -> None:
+    rows = [
+        _e(2026, 1, 5, 1490),
+        _e(2026, 2, 5, 1490),
+        # gap at 2026-03
+        _e(2026, 4, 5, 1490),
+        _e(2026, 5, 5, 1490),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_R3_min_count_two_accepts_two_months() -> None:
+    rows = [_e(2026, 10, 5, 1490), _e(2026, 11, 5, 1490)]
+    assert find_recurring(rows) == []
+    result = find_recurring(rows, min_count=2)
+    assert len(result) == 1
+    assert result[0].months == ("2026-10", "2026-11")
+
+
+def test_R3_tolerance_upper_bound_is_inclusive() -> None:
+    rows = [_e(2026, 9, 5, 900), _e(2026, 10, 5, 1000), _e(2026, 11, 5, 1000)]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_R3_outside_tolerance_is_not_recurring() -> None:
+    rows = [_e(2026, 9, 5, 899), _e(2026, 10, 5, 1000), _e(2026, 11, 5, 1000)]
+    assert find_recurring(rows) == []
+
+
+def test_R3_price_increase_beyond_tolerance_is_not_recurring() -> None:
+    rows = [_e(2026, 9, 5, 1000), _e(2026, 10, 5, 1000), _e(2026, 11, 5, 1200)]
+    assert find_recurring(rows) == []
+
+
+def test_R3_tolerance_is_relative_to_latest_amount() -> None:
+    # latest 1000: 1100 is within 10 % (inclusive), 1000 is the base
+    rows = [_e(2026, 9, 5, 1100), _e(2026, 10, 5, 1000), _e(2026, 11, 5, 1000)]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_R3_zero_tolerance_requires_exact_amount() -> None:
+    rows = [_e(2026, 9, 5, 1000), _e(2026, 10, 5, 1001), _e(2026, 11, 5, 1000)]
+    assert find_recurring(rows, tolerance=0) == []
+    assert find_recurring(rows, tolerance=0.1) != []
+
+
+# --- R4: amount / months / day / next_date --------------------------------
+
+
+def test_R4_next_date_uses_month_end_for_day_31_series() -> None:
+    rows = [
+        _e(2026, 1, 31, 80000, "住居", "家賃"),
+        _e(2026, 2, 28, 80000, "住居", "家賃"),
+        _e(2026, 3, 31, 80000, "住居", "家賃"),
+    ]
+    result = find_recurring(rows)
+    assert result[0].next_date == date(2026, 4, 30)
+    assert result[0].day == 31
+
+
+def test_R4_december_rolls_over_to_january() -> None:
+    rows = [_e(2026, 10, 15, 500), _e(2026, 11, 15, 500), _e(2026, 12, 15, 500)]
+    assert find_recurring(rows)[0].next_date == date(2027, 1, 15)
+
+
+def test_R4_next_date_in_leap_february() -> None:
+    rows = [_e(2028, 10, 31, 500), _e(2028, 11, 30, 500), _e(2028, 12, 31, 500)]
+    assert find_recurring(rows)[0].next_date == date(2029, 1, 31)
+    rows2 = [_e(2027, 11, 30, 500), _e(2027, 12, 31, 500), _e(2028, 1, 31, 500)]
+    assert find_recurring(rows2)[0].next_date == date(2028, 2, 29)
+
+
+def test_R4_next_date_in_non_leap_february() -> None:
+    rows = [_e(2026, 11, 30, 500), _e(2026, 12, 31, 500), _e(2027, 1, 31, 500)]
+    assert find_recurring(rows)[0].next_date == date(2027, 2, 28)
+
+
+def test_R4_amount_is_latest_month_amount() -> None:
+    rows = [_e(2026, 9, 5, 950), _e(2026, 10, 5, 980), _e(2026, 11, 5, 1000)]
+    result = find_recurring(rows)
+    assert result[0].amount == 1000
+
+
+# --- R5: 並び順 -------------------------------------------------------------
+
+
+def test_R5_sorted_by_next_date_then_category_then_memo() -> None:
+    def trio(cat: str, memo: str, d: int) -> list[Expense]:
+        return [
+            _e(2026, 9, d, 100, cat, memo),
+            _e(2026, 10, d, 100, cat, memo),
+            _e(2026, 11, d, 100, cat, memo),
+        ]
+
+    rows = trio("b", "x", 5) + trio("a", "y", 5) + trio("a", "x", 5) + trio("z", "q", 1)
+    result = find_recurring(rows)
+    assert [(r.next_date.day, r.category, r.memo) for r in result] == [
+        (1, "z", "q"),
+        (5, "a", "x"),
+        (5, "a", "y"),
+        (5, "b", "x"),
+    ]
+
+
+# --- R6: 引数検査 ----------------------------------------------------------
+
+
+def test_R6_empty_rows_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+@pytest.mark.parametrize("bad", [True, "3", 3.0, None])
+def test_R6_min_count_wrong_type_is_type_error(bad: object) -> None:
+    with pytest.raises(TypeError, match="min_count"):
+        find_recurring([], min_count=bad)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad", [1, 0, -3])
+def test_R6_min_count_below_two_is_value_error(bad: int) -> None:
+    with pytest.raises(ValueError, match="min_count"):
+        find_recurring([], min_count=bad)
+
+
+@pytest.mark.parametrize("bad", [True, "0.1", None])
+def test_R6_tolerance_wrong_type_is_type_error(bad: object) -> None:
+    with pytest.raises(TypeError, match="tolerance"):
+        find_recurring([], tolerance=bad)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad", [float("nan"), 1, 1.0, -0.1, float("inf")])
+def test_R6_tolerance_out_of_range_is_value_error(bad: float) -> None:
+    with pytest.raises(ValueError, match="tolerance"):
+        find_recurring([], tolerance=bad)
+
+
+def test_R6_tolerance_int_zero_is_accepted() -> None:
+    assert find_recurring([], tolerance=0) == []
diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..5ae096d
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,213 @@
+from __future__ import annotations
+
+from datetime import date, datetime
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    all_of,
+    amount_between,
+    any_of,
+    between,
+    category,
+    memo_contains,
+    not_,
+    search,
+)
+
+
+def _e(
+    day: date = date(2026, 1, 1), cat: str = "food", amount: int = 100, memo: str = ""
+) -> Expense:
+    return Expense(day=day, category=cat, amount=amount, memo=memo)
+
+
+# --- 例の表 E3-1..E3-3 ---------------------------------------------------
+
+
+def test_E3_1_all_of_category_and_amount_between_keeps_inclusive_bounds() -> None:
+    # E3-1 (R1, R2): 金額 500・1000・1001 の food -> 500 と 1000 の 2 件
+    rows = [
+        _e(amount=500),
+        _e(amount=1000),
+        _e(amount=1001),
+        _e(cat="cafe", amount=700),
+    ]
+    got = search(rows, all_of(category("food"), amount_between(500, 1000)))
+    assert [e.amount for e in got] == [500, 1000]
+
+
+def test_E3_2_memo_contains_matches_halfwidth_kana_via_nfkc() -> None:
+    # E3-2 (D6): "ｽﾀﾊﾞ" は NFKC で "スタバ" に一致。スターバックス は一致しない
+    rows = [_e(memo="スターバックス"), _e(memo="スタバ")]
+    got = search(rows, memo_contains("ｽﾀﾊﾞ"))
+    assert [e.memo for e in got] == ["スタバ"]
+
+
+def test_E3_3_any_of_empty_excludes_all_and_all_of_empty_includes_all() -> None:
+    # E3-3 (R2): any_of() は全件除外、all_of() は全件一致
+    rows = [_e(amount=1), _e(amount=2)]
+    assert search(rows, any_of()) == []
+    assert search(rows, all_of()) == rows
+
+
+# --- R1: category --------------------------------------------------------
+
+
+def test_category_matches_any_name_after_stripping_spaces() -> None:
+    rows = [_e(cat="food"), _e(cat="cafe"), _e(cat="rent")]
+    assert [e.category for e in search(rows, category(" food ", "cafe"))] == [
+        "food",
+        "cafe",
+    ]
+
+
+def test_category_requires_exact_match_not_partial() -> None:
+    rows = [_e(cat="food"), _e(cat="foods")]
+    assert [e.category for e in search(rows, category("food"))] == ["food"]
+
+
+def test_category_with_no_names_raises_value_error() -> None:
+    with pytest.raises(ValueError):
+        category()
+
+
+@pytest.mark.parametrize("bad", [1, None, b"food"])
+def test_category_non_str_name_raises_type_error(bad: object) -> None:
+    with pytest.raises(TypeError):
+        category("food", bad)  # type: ignore[arg-type]
+
+
+# --- R1: amount_between --------------------------------------------------
+
+
+def test_amount_between_none_bounds_are_unbounded() -> None:
+    rows = [_e(amount=-5), _e(amount=0), _e(amount=10**9)]
+    assert search(rows, amount_between()) == rows
+    assert [e.amount for e in search(rows, amount_between(lo=0))] == [0, 10**9]
+    assert [e.amount for e in search(rows, amount_between(hi=0))] == [-5, 0]
+
+
+def test_amount_between_lo_greater_than_hi_raises_value_error() -> None:
+    with pytest.raises(ValueError, match="lo"):
+        amount_between(1000, 500)
+
+
+@pytest.mark.parametrize(
+    "lo, hi, name",
+    [
+        (True, None, "lo"),
+        (None, False, "hi"),
+        (1.0, None, "lo"),
+        (None, 2.5, "hi"),
+        ("1", None, "lo"),
+    ],
+)
+def test_amount_between_bool_float_or_str_raises_type_error(
+    lo: object, hi: object, name: str
+) -> None:
+    with pytest.raises(TypeError, match=name):
+        amount_between(lo, hi)  # type: ignore[arg-type]
+
+
+# --- R1: memo_contains (D6) ----------------------------------------------
+
+
+def test_memo_contains_empty_text_matches_all() -> None:
+    rows = [_e(memo=""), _e(memo="x")]
+    assert search(rows, memo_contains("")) == rows
+
+
+def test_memo_contains_is_case_insensitive_partial_match() -> None:
+    rows = [_e(memo="Coffee Shop"), _e(memo="tea")]
+    assert [e.memo for e in search(rows, memo_contains("coffee"))] == ["Coffee Shop"]
+
+
+def test_memo_contains_non_str_raises_type_error() -> None:
+    with pytest.raises(TypeError):
+        memo_contains(1)  # type: ignore[arg-type]
+
+
+# --- R1: between (inclusive, D6) -----------------------------------------
+
+
+def test_between_includes_both_endpoints() -> None:
+    rows = [_e(day=date(2026, 1, d)) for d in (9, 10, 20, 21)]
+    got = search(rows, between(date(2026, 1, 10), date(2026, 1, 20)))
+    assert [e.day.day for e in got] == [10, 20]
+
+
+def test_between_none_bounds_are_unbounded() -> None:
+    rows = [_e(day=date(2026, 1, 1)), _e(day=date(2030, 1, 1))]
+    assert search(rows, between()) == rows
+    assert len(search(rows, between(start=date(2026, 1, 2)))) == 1
+    assert len(search(rows, between(end=date(2026, 1, 2)))) == 1
+
+
+def test_between_start_after_end_raises_value_error() -> None:
+    with pytest.raises(ValueError):
+        between(date(2026, 2, 1), date(2026, 1, 1))
+
+
+@pytest.mark.parametrize("bad", [datetime(2026, 1, 1), "2026-01-01"])
+def test_between_datetime_or_str_raises_type_error(bad: object) -> None:
+    with pytest.raises(TypeError):
+        between(bad, None)  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        between(None, bad)  # type: ignore[arg-type]
+
+
+# --- R2: combinators -----------------------------------------------------
+
+
+def test_not_inverts_predicate() -> None:
+    rows = [_e(cat="food"), _e(cat="cafe")]
+    assert [e.category for e in search(rows, not_(category("food")))] == ["cafe"]
+
+
+def test_nested_combinators_follow_call_nesting() -> None:
+    rows = [
+        _e(cat="food", amount=1),
+        _e(cat="food", amount=5),
+        _e(cat="cafe", amount=1),
+    ]
+    pred = any_of(
+        all_of(category("food"), not_(amount_between(hi=1))), category("cafe")
+    )
+    assert [(e.category, e.amount) for e in search(rows, pred)] == [
+        ("food", 5),
+        ("cafe", 1),
+    ]
+
+
+@pytest.mark.parametrize("fn", [all_of, any_of])
+def test_all_of_any_of_non_callable_raises_type_error(fn: object) -> None:
+    with pytest.raises(TypeError):
+        fn(category("food"), "food")  # type: ignore[operator]
+
+
+def test_not_non_callable_raises_type_error() -> None:
+    with pytest.raises(TypeError):
+        not_("food")  # type: ignore[arg-type]
+
+
+# --- R3: search ----------------------------------------------------------
+
+
+def test_search_keeps_input_order_and_returns_new_list() -> None:
+    rows = [_e(amount=3), _e(amount=1), _e(amount=2)]
+    snapshot = list(rows)
+    got = search(rows, all_of())
+    assert got == snapshot
+    assert got is not rows
+    assert rows == snapshot
+
+
+def test_search_empty_rows_returns_empty_list() -> None:
+    assert search([], all_of()) == []
+
+
+def test_search_non_callable_pred_raises_type_error() -> None:
+    with pytest.raises(TypeError):
+        search([_e()], "food")  # type: ignore[arg-type]
diff --git a/tests/test_trend.py b/tests/test_trend.py
new file mode 100644
index 0000000..e5381bb
--- /dev/null
+++ b/tests/test_trend.py
@@ -0,0 +1,214 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.trend import (
+    CategoryChange,
+    MonthComparison,
+    compare_months,
+    format_comparison,
+)
+
+
+def _e(y: int, m: int, cat: str, amt: int) -> Expense:
+    return Expense(date(y, m, 1), cat, amt)
+
+
+def _summary(
+    rows: list[Expense],
+) -> dict[tuple[str, str], tuple[str, int, float | None]]:
+    out: dict[tuple[str, str], tuple[str, int, float | None]] = {}
+    for c in compare_months(rows):
+        for ch in c.changes:
+            out[(c.month, ch.category)] = (ch.status, ch.diff, ch.ratio)
+    return out
+
+
+# 表の例 E4-1 / E4-2 / E4-3 を ID 付きで写す
+@pytest.mark.parametrize(
+    ("rows", "expected"),
+    [
+        pytest.param(
+            [_e(2026, 10, "food", 1000), _e(2026, 11, "food", 1150)],
+            {("2026-11", "food"): ("up", 150, 0.15)},
+            id="E4-1",
+        ),
+        pytest.param(
+            [_e(2026, 1, "food", 1000), _e(2026, 3, "food", 800)],
+            {
+                ("2026-02", "food"): ("gone", -1000, -1.0),
+                ("2026-03", "food"): ("new", 800, None),
+            },
+            id="E4-2",
+        ),
+        pytest.param(
+            [_e(2026, 1, "food", 0), _e(2026, 2, "food", 500)],
+            {("2026-02", "food"): ("up", 500, None)},
+            id="E4-3",
+        ),
+    ],
+)
+def test_example_table(rows, expected):
+    actual = _summary(rows)
+    assert actual.keys() == expected.keys()
+    for key, (status, diff, ratio) in expected.items():
+        a_status, a_diff, a_ratio = actual[key]
+        assert a_status == status
+        assert a_diff == diff
+        if ratio is None:
+            assert a_ratio is None
+        else:
+            assert a_ratio == pytest.approx(ratio)
+
+
+# --- 境界・端のケース ---
+
+
+def test_empty_rows_returns_empty_list():
+    assert compare_months([]) == []
+
+
+def test_single_month_returns_empty_list():
+    assert compare_months([_e(2026, 1, "food", 100), _e(2026, 1, "rent", 5)]) == []
+
+
+def test_previous_month_crosses_year_boundary():
+    result = compare_months([_e(2025, 12, "food", 100), _e(2026, 1, "food", 200)])
+    assert [c.month for c in result] == ["2026-01"]
+    assert result[0].previous_month == "2025-12"
+
+
+def test_gap_months_are_included_and_empty():
+    result = compare_months([_e(2026, 1, "food", 100), _e(2026, 3, "rent", 50)])
+    assert [(c.month, c.previous_month) for c in result] == [
+        ("2026-02", "2026-01"),
+        ("2026-03", "2026-02"),
+    ]
+    feb = result[0]
+    assert feb.total_current == 0
+    assert feb.total_previous == 100
+
+
+def test_totals_include_refunds_as_negative():
+    result = compare_months(
+        [
+            _e(2026, 1, "food", 1000),
+            _e(2026, 1, "food", -200),
+            _e(2026, 2, "food", 500),
+        ]
+    )
+    assert result[0].total_previous == 800
+    assert result[0].total_current == 500
+
+
+def test_zero_sum_category_is_included_as_same():
+    result = compare_months(
+        [
+            _e(2026, 1, "misc", 0),
+            _e(2026, 2, "misc", 0),
+        ]
+    )
+    (change,) = result[0].changes
+    assert change == CategoryChange("misc", 0, 0, 0, None, "same")
+
+
+def test_same_amount_status_same_with_ratio():
+    result = compare_months([_e(2026, 1, "food", 300), _e(2026, 2, "food", 300)])
+    (change,) = result[0].changes
+    assert change.status == "same"
+    assert change.ratio == 0.0
+
+
+def test_down_status_negative_diff():
+    result = compare_months([_e(2026, 1, "food", 1000), _e(2026, 2, "food", 920)])
+    (change,) = result[0].changes
+    assert change.status == "down"
+    assert change.diff == -80
+    assert change.ratio == pytest.approx(-0.08)
+
+
+def test_changes_sorted_by_abs_diff_desc_then_category():
+    rows = [
+        _e(2026, 1, "b", 100),
+        _e(2026, 1, "a", 100),
+        _e(2026, 1, "c", 500),
+        _e(2026, 2, "a", 200),  # diff +100
+        _e(2026, 2, "b", 0),  # diff -100
+        _e(2026, 2, "c", 500),  # diff 0
+    ]
+    (c,) = compare_months(rows)
+    assert [ch.category for ch in c.changes] == ["a", "b", "c"]
+
+
+def test_totals_for_each_month():
+    rows = [
+        _e(2026, 1, "food", 100),
+        _e(2026, 1, "rent", 50),
+        _e(2026, 2, "food", 70),
+    ]
+    (c,) = compare_months(rows)
+    assert c.total_previous == 150
+    assert c.total_current == 70
+
+
+def test_rows_with_non_expense_raises_type_error():
+    with pytest.raises(TypeError):
+        compare_months([_e(2026, 1, "food", 1), "not an expense"])  # type: ignore[list-item]
+
+
+def test_non_list_rows_raises_type_error():
+    with pytest.raises(TypeError):
+        compare_months(_e(2026, 1, "food", 1))  # type: ignore[arg-type]
+
+
+def test_format_comparison_rejects_wrong_type():
+    with pytest.raises(TypeError):
+        format_comparison("2026-01")  # type: ignore[arg-type]
+
+
+# --- format_comparison ---
+
+
+def test_format_header_only_when_no_changes():
+    c = MonthComparison("2026-02", "2026-01", (), 0, 0)
+    assert format_comparison(c) == "2026-02 (前月 2026-01)"
+
+
+def test_format_lines_and_labels():
+    c = MonthComparison(
+        "2026-11",
+        "2026-10",
+        (
+            CategoryChange("food", 1000, 1150, 150, 0.15, "up"),
+            CategoryChange("rent", 960, 880, -80, -80 / 960, "down"),
+            CategoryChange("misc", 300, 300, 0, 0.0, "same"),
+            CategoryChange("gift", 0, 500, 500, None, "up"),
+            CategoryChange("old", 400, 0, -400, -1.0, "gone"),
+            CategoryChange("new", 0, 200, 200, None, "new"),
+        ),
+        1300,
+        2270,
+    )
+    assert format_comparison(c).split("\n") == [
+        "2026-11 (前月 2026-10)",
+        "food\t+150円\t+15.0%\t増",
+        "rent\t-80円\t-8.3%\t減",
+        "misc\t+0円\t+0.0%\t変わらず",
+        "gift\t+500円\t-\t増",
+        "old\t-400円\t-100.0%\tなくなった",
+        "new\t+200円\t-\t新規",
+    ]
+
+
+def test_format_has_no_trailing_newline():
+    c = MonthComparison(
+        "2026-02",
+        "2026-01",
+        (CategoryChange("food", 100, 100, 0, 0.0, "same"),),
+        100,
+        100,
+    )
+    assert not format_comparison(c).endswith("\n")
