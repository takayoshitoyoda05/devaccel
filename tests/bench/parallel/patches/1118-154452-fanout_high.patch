diff --git a/src/kakeibo/bankimport.py b/src/kakeibo/bankimport.py
new file mode 100644
index 0000000..9dbaa67
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,111 @@
+"""他行(銀行・カード)の明細 CSV を Expense に取り込む純粋関数群。"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from collections.abc import Callable
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+# 日付: YYYY/M/D または YYYY-M-D(区切りは両方同じ)。数字は ASCII のみ。
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+# 金額: 任意の "-" → 任意の "¥"/"￥" → ASCII 数字で始まる数字とカンマの列 → 任意の "円"
+_AMOUNT_RE = re.compile(r"(-?)[¥￥]?([0-9][0-9,]*)円?")
+
+
+def parse_amount(s: str) -> int:
+    """他行の金額表記を円の整数にする。形式が違えば ValueError。"""
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    sign, digits = m.groups()
+    value = int(digits.replace(",", ""))
+    return -value if sign else value
+
+
+def parse_date(s: str) -> date:
+    """YYYY/M/D または YYYY-M-D を date にする。形式・日付が不正なら ValueError。"""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    year, _sep, month, day = m.groups()
+    return date(int(year), int(month), int(day))
+
+
+def _try[T](parse: Callable[[str], T], raw: str) -> T | None:
+    try:
+        return parse(raw)
+    except ValueError:
+        return None
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """1 行目がヘッダーの CSV 文字列を明細にする。
+
+    戻り値は (取り込めた明細(入力順), [(物理行番号, フィールド名), ...])。
+    エラーのある行は明細に含めない。
+    """
+    cols = DEFAULT_MAPPING if mapping is None else mapping
+    missing = [f for f in ("date", "category", "amount") if f not in cols]
+    if missing:
+        raise ValueError(f"mapping に必要なキーがありません: {missing}")
+
+    reader = csv.reader(io.StringIO(text))
+    header = next(reader, None)
+    if header is None:
+        raise ValueError("ヘッダー行がありません")
+
+    index: dict[str, int] = {}
+    for field in ("date", "category", "amount", "memo"):
+        if field not in cols:
+            continue
+        name = cols[field]
+        if name not in header:
+            raise ValueError(f"ヘッダーに列 {name!r} がありません")
+        index[field] = header.index(name)
+
+    def cell(row: list[str], field: str) -> str:
+        i = index.get(field)
+        if i is None or i >= len(row):
+            return ""
+        return row[i]
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    prev_end = reader.line_num
+    for row in reader:
+        start = prev_end + 1  # 行の先頭の物理行番号(引用符内の改行を数える)
+        prev_end = reader.line_num
+        if not row:
+            continue
+
+        day = _try(parse_date, cell(row, "date"))
+        amount = _try(parse_amount, cell(row, "amount"))
+        category = cell(row, "category").strip()
+        if day is None:
+            errors.append((start, "date"))
+        if amount is None:
+            errors.append((start, "amount"))
+        if not category:
+            errors.append((start, "category"))
+        if day is None or amount is None or not category:
+            continue
+
+        mapped = (category_map or {}).get(category, category)
+        memo = cell(row, "memo").strip()
+        expenses.append(Expense(day=day, category=mapped, amount=amount, memo=memo))
+    return expenses, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
new file mode 100644
index 0000000..dead3e6
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,98 @@
+"""前月比レポート(純粋関数)。"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def _month_of(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+    prev_sum: dict[str, int] = {}
+    curr_sum: dict[str, int] = {}
+    for e in rows:
+        m = _month_of(e)
+        if m == prev_month:
+            prev_sum[e.category] = prev_sum.get(e.category, 0) + e.amount
+        if m == curr_month:
+            curr_sum[e.category] = curr_sum.get(e.category, 0) + e.amount
+
+    out: list[DiffRow] = []
+    for cat in prev_sum.keys() | curr_sum.keys():
+        # 存在判定は明細の有無で行う(合計が 0 でも存在する)
+        prev = prev_sum.get(cat, 0)
+        curr = curr_sum.get(cat, 0)
+        delta = curr - prev
+        pct: float | None = None
+        if prev != 0:
+            # + 0.0 で -0.0 を +0.0 に正規化する
+            pct = round(delta / prev * 100, 1) + 0.0
+        if cat not in prev_sum:
+            status = "new"
+        elif cat not in curr_sum:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+    out.sort(key=lambda r: (-abs(r.delta), r.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [d for d in diffs if d.status != "same"][:n]
+
+
+def _fmt_pct(pct: float | None) -> str:
+    if pct is None:
+        return "-"
+    return f"{pct + 0.0:+.1f}%"
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for d in diffs:
+        lines.append(
+            f"{d.category}\t{d.prev}\t{d.curr}\t{d.delta:+d}\t{_fmt_pct(d.pct)}"
+        )
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month_of(e) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には 2 か月以上の明細が必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..6f750db
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,194 @@
+"""Search query language for filtering Expense rows.
+
+Grammar (lowest precedence first)::
+
+    or_expr  := and_expr ("OR" and_expr)*
+    and_expr := not_expr (["AND"] not_expr)*
+    not_expr := "NOT" not_expr | primary
+    primary  := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+
+from kakeibo.core import Expense
+
+Pred = Callable[[Expense], bool]
+
+_CAT_PREFIX = "cat:"
+_KEYWORDS = ("AND", "OR", "NOT")
+# Token kinds that can begin a not_expr (used for implicit AND).
+_OPERAND_START = frozenset({"NOT", "TERM", "CAT", "LPAREN"})
+
+
+class QueryError(ValueError):
+    """Raised when a search query is malformed."""
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    """Split a query into (kind, value) tokens."""
+    tokens: list[tuple[str, str]] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end < 0:
+                raise QueryError("閉じていない引用符があります")
+            body = q[i + 1 : end]
+            if body == "":
+                raise QueryError("空の引用符は使えません")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            j = i
+            while j < n and not q[j].isspace() and q[j] not in '()"':
+                j += 1
+            tokens.append(_word_token(q[i:j]))
+            i = j
+    return tokens
+
+
+def _word_token(word: str) -> tuple[str, str]:
+    if word in _KEYWORDS:
+        return (word, word)
+    if word.startswith(_CAT_PREFIX):
+        value = word[len(_CAT_PREFIX) :]
+        if value == "":
+            raise QueryError("cat: の後ろに値がありません")
+        return ("CAT", value)
+    return ("TERM", word)
+
+
+def _term(value: str) -> Pred:
+    needle = value.casefold()
+
+    def pred(e: Expense) -> bool:
+        return needle in e.memo.casefold() or needle in e.category.casefold()
+
+    return pred
+
+
+def _cat(value: str) -> Pred:
+    target = value.casefold()
+
+    def pred(e: Expense) -> bool:
+        return e.category.casefold() == target
+
+    return pred
+
+
+def _any_of(preds: list[Pred]) -> Pred:
+    def pred(e: Expense) -> bool:
+        return any(p(e) for p in preds)
+
+    return pred
+
+
+def _all_of(preds: list[Pred]) -> Pred:
+    def pred(e: Expense) -> bool:
+        return all(p(e) for p in preds)
+
+    return pred
+
+
+class _Parser:
+    """Recursive-descent parser that compiles tokens into a predicate."""
+
+    def __init__(self, tokens: list[tuple[str, str]]) -> None:
+        self._tokens = tokens
+        self._pos = 0
+
+    def parse(self) -> Pred:
+        if not self._tokens:
+            raise QueryError("検索式が空です")
+        pred = self._or_expr()
+        if self._pos != len(self._tokens):
+            raise QueryError(f"予期しないトークンです: {self._tokens[self._pos][1]!r}")
+        return pred
+
+    def _peek(self) -> str | None:
+        if self._pos < len(self._tokens):
+            return self._tokens[self._pos][0]
+        return None
+
+    def _advance(self) -> tuple[str, str]:
+        tok = self._tokens[self._pos]
+        self._pos += 1
+        return tok
+
+    def _or_expr(self) -> Pred:
+        preds = [self._and_expr()]
+        while self._peek() == "OR":
+            self._advance()
+            preds.append(self._and_expr())
+        return _any_of(preds) if len(preds) > 1 else preds[0]
+
+    def _and_expr(self) -> Pred:
+        preds = [self._not_expr()]
+        while True:
+            kind = self._peek()
+            if kind == "AND":
+                self._advance()
+                preds.append(self._not_expr())
+            elif kind in _OPERAND_START:
+                preds.append(self._not_expr())
+            else:
+                break
+        return _all_of(preds) if len(preds) > 1 else preds[0]
+
+    def _not_expr(self) -> Pred:
+        if self._peek() == "NOT":
+            self._advance()
+            inner = self._not_expr()
+
+            def pred(e: Expense) -> bool:
+                return not inner(e)
+
+            return pred
+        return self._primary()
+
+    def _primary(self) -> Pred:
+        kind = self._peek()
+        if kind is None:
+            raise QueryError("項がありません")
+        if kind == "TERM":
+            return _term(self._advance()[1])
+        if kind == "CAT":
+            return _cat(self._advance()[1])
+        if kind == "LPAREN":
+            self._advance()
+            pred = self._or_expr()
+            if self._peek() != "RPAREN":
+                raise QueryError("閉じ括弧 ')' がありません")
+            self._advance()
+            return pred
+        raise QueryError(f"項が必要ですが {self._tokens_at_pos()!r} がありました")
+
+    def _tokens_at_pos(self) -> str:
+        return self._tokens[self._pos][1]
+
+
+def _compile(q: str) -> Pred:
+    return _Parser(tokenize(q)).parse()
+
+
+def matches(q: str, e: Expense) -> bool:
+    """Return True if expense ``e`` satisfies query ``q``."""
+    return _compile(q)(e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    """Return the rows matching ``q``, in input order."""
+    pred = _compile(q)
+    return [e for e in rows if pred(e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..197b486
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,54 @@
+"""Detect recurring expenses: same category and amount on a roughly monthly cadence."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day in the next month, clamped to that month's last day."""
+    year, month = (d.year + 1, 1) if d.month == 12 else (d.year, d.month + 1)
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError(f"min_count は 2 以上である必要があります: {min_count}")
+    if tolerance < 0:
+        raise ValueError(f"tolerance は 0 以上である必要があります: {tolerance}")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    found: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        runs: list[list[date]] = []
+        for d in sorted(day_set):
+            if runs and abs((d - add_month(runs[-1][-1])).days) <= tolerance:
+                runs[-1].append(d)
+            else:
+                runs.append([d])
+        for run in runs:
+            if len(run) >= min_count:
+                found.append(
+                    Recurring(category, amount, tuple(run), add_month(run[-1]))
+                )
+
+    found.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return found
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..f56460f
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,265 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+DEFAULT_HEADER = "利用日,分類,利用金額,利用店名\n"
+
+
+# --- parse_amount ---
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥1234", 1234),
+        ("-￥1,000円", -1000),
+        ("1,2,3", 123),  # カンマの位置は検査しない
+        ("1,,0", 10),
+        ("\t500\n", 500),
+        ("0012", 12),
+    ],
+)
+def test_parse_amount_accepts(text, expected):
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "   ",
+        "円",
+        "¥",
+        "-",
+        "¥円",
+        "12.5",
+        "1 200",
+        "1200 円",
+        "--5",
+        "¥-5",
+        "-¥-5",
+        "5¥",
+        "5-",
+        "１２３",
+        "+5",
+        "円5",
+        "¥¥5",
+        "5円円",
+        ",1",
+    ],
+)
+def test_parse_amount_rejects(text):
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+# --- parse_date ---
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        ("2026/01/05", date(2026, 1, 5)),
+        ("2026-1-5", date(2026, 1, 5)),
+        (" 2026/11/18 ", date(2026, 11, 18)),
+        ("2024/2/29", date(2024, 2, 29)),
+    ],
+)
+def test_parse_date_accepts(text, expected):
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026/1-5",
+        "2026-1/5",
+        "26/1/5",
+        "2026/02/30",
+        "2026/2/29",
+        "2026/13/1",
+        "2026/0/1",
+        "2026/1/32",
+        "2026/1/",
+        "2026.1.5",
+        "２０２６/1/5",
+        "2026/123/1",
+        "20260105",
+        "2026//1",
+        "2026/1/5/1",
+        "0000/1/1",
+        "",
+    ],
+)
+def test_parse_date_rejects(text):
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+# --- import_rows ---
+
+
+def test_default_mapping_constant():
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_default_mapping_imports_rows():
+    text = DEFAULT_HEADER + "2026/11/1,食費,1200,ランチ\n2026-11-02,家賃,80000,\n"
+    expenses, errors = import_rows(text)
+    assert expenses == [
+        Expense(date(2026, 11, 1), "食費", 1200, "ランチ"),
+        Expense(date(2026, 11, 2), "家賃", 80000, ""),
+    ]
+    assert errors == []
+
+
+def test_header_only_returns_empty():
+    assert import_rows(DEFAULT_HEADER) == ([], [])
+
+
+def test_custom_mapping_and_extra_columns_ignored():
+    text = "取引日,摘要,金額,備考,残高\n2026/11/3,ストア,500,メモ,99999\n"
+    mapping = {"date": "取引日", "category": "摘要", "amount": "金額", "memo": "備考"}
+    expenses, errors = import_rows(text, mapping)
+    assert expenses == [Expense(date(2026, 11, 3), "ストア", 500, "メモ")]
+    assert errors == []
+
+
+def test_memo_missing_from_mapping_is_empty():
+    mapping = {"date": "利用日", "category": "分類", "amount": "利用金額"}
+    text = DEFAULT_HEADER + "2026/11/1,食費,100,店\n"
+    expenses, _ = import_rows(text, mapping)
+    assert expenses == [Expense(date(2026, 11, 1), "食費", 100, "")]
+
+
+@pytest.mark.parametrize("field", ["date", "category", "amount"])
+def test_mapping_missing_required_key_raises(field):
+    mapping = {k: v for k, v in DEFAULT_MAPPING.items() if k != field}
+    with pytest.raises(ValueError):
+        import_rows(DEFAULT_HEADER, mapping)
+
+
+@pytest.mark.parametrize("field", ["date", "category", "amount", "memo"])
+def test_mapping_column_not_in_header_raises(field):
+    mapping = {**DEFAULT_MAPPING, field: "無い列"}
+    with pytest.raises(ValueError):
+        import_rows(DEFAULT_HEADER + "2026/11/1,食費,100,店\n", mapping)
+
+
+def test_empty_text_raises():
+    with pytest.raises(ValueError):
+        import_rows("")
+
+
+def test_blank_lines_skipped_but_counted():
+    text = DEFAULT_HEADER + "\n2026/11/1,食費,100,a\n\nbad,食費,100,\n"
+    expenses, errors = import_rows(text)
+    assert expenses == [Expense(date(2026, 11, 1), "食費", 100, "a")]
+    assert errors == [(5, "date")]
+
+
+def test_multiline_quoted_field_counts_physical_lines():
+    text = DEFAULT_HEADER + '2026/11/1,"食費\n外食",100,a\n' + "bad,食費,100,\n"
+    expenses, errors = import_rows(text)
+    assert expenses == [Expense(date(2026, 11, 1), "食費\n外食", 100, "a")]
+    assert errors == [(4, "date")]
+
+
+def test_all_errors_in_row_recorded_in_order_and_row_excluded():
+    text = DEFAULT_HEADER + "x,,y,\n2026/11/2,食費,100,\n"
+    expenses, errors = import_rows(text)
+    assert errors == [(2, "date"), (2, "amount"), (2, "category")]
+    assert expenses == [Expense(date(2026, 11, 2), "食費", 100, "")]
+
+
+def test_blank_category_is_error():
+    expenses, errors = import_rows(DEFAULT_HEADER + "2026/11/1, ,100,\n")
+    assert expenses == []
+    assert errors == [(2, "category")]
+
+
+def test_bad_amount_only_is_error():
+    expenses, errors = import_rows(DEFAULT_HEADER + "2026/11/1,食費,12.5,\n")
+    assert expenses == []
+    assert errors == [(2, "amount")]
+
+
+def test_short_row_missing_values_are_empty():
+    text = DEFAULT_HEADER + "2026/11/1,食費\n2026/11/2,食費,300\n"
+    expenses, errors = import_rows(text)
+    assert errors == [(2, "amount")]
+    assert expenses == [Expense(date(2026, 11, 2), "食費", 300, "")]
+
+
+def test_row_with_only_date_reports_amount_and_category():
+    expenses, errors = import_rows(DEFAULT_HEADER + "2026/11/1\n")
+    assert expenses == []
+    assert errors == [(2, "amount"), (2, "category")]
+
+
+def test_extra_columns_in_row_ignored():
+    expenses, errors = import_rows(DEFAULT_HEADER + "2026/11/1,食費,100,店,余分,余分\n")
+    assert expenses == [Expense(date(2026, 11, 1), "食費", 100, "店")]
+    assert errors == []
+
+
+def test_quoted_comma_values():
+    text = DEFAULT_HEADER + '2026/11/1,"食費, 外食",1200,"ランチ, 本店"\n'
+    expenses, _ = import_rows(text)
+    assert expenses == [Expense(date(2026, 11, 1), "食費, 外食", 1200, "ランチ, 本店")]
+
+
+def test_category_and_memo_are_stripped():
+    expenses, _ = import_rows(DEFAULT_HEADER + "2026/11/1, 食費 ,100,  ランチ  \n")
+    assert expenses == [Expense(date(2026, 11, 1), "食費", 100, "ランチ")]
+
+
+def test_category_map_applies_after_strip_and_keeps_unmapped():
+    text = DEFAULT_HEADER + "2026/11/1, 食費 ,100,\n2026/11/2,家賃,80000,\n"
+    expenses, _ = import_rows(text, category_map={"食費": "Food"})
+    assert [e.category for e in expenses] == ["Food", "家賃"]
+
+
+def test_date_and_amount_formats_in_rows():
+    text = DEFAULT_HEADER + '2026-1-5,食費,"￥1,200",\n2026/1/6,返金,-¥300,返金\n'
+    expenses, errors = import_rows(text)
+    assert expenses == [
+        Expense(date(2026, 1, 5), "食費", 1200, ""),
+        Expense(date(2026, 1, 6), "返金", -300, "返金"),
+    ]
+    assert errors == []
+
+
+def test_crlf_line_endings():
+    text = DEFAULT_HEADER.replace("\n", "\r\n") + "2026/11/1,食費,100,a\r\n"
+    expenses, errors = import_rows(text)
+    assert expenses == [Expense(date(2026, 11, 1), "食費", 100, "a")]
+    assert errors == []
+
+
+def test_valid_and_invalid_rows_keep_input_order():
+    text = (
+        DEFAULT_HEADER
+        + "2026/11/1,A,1,\n"
+        + "bad,B,2,\n"
+        + "2026/11/3,C,3,\n"
+        + "2026/11/4,,4,\n"
+        + "2026/11/5,E,5,\n"
+    )
+    expenses, errors = import_rows(text)
+    assert [e.category for e in expenses] == ["A", "C", "E"]
+    assert errors == [(3, "date"), (5, "category")]
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..d7d1ce9
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,199 @@
+import dataclasses
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def _e(day: str, category: str, amount: int) -> Expense:
+    return Expense(date.fromisoformat(day), category, amount)
+
+
+def test_diffrow_fields_in_order_and_frozen():
+    assert [f.name for f in dataclasses.fields(DiffRow)] == [
+        "category",
+        "prev",
+        "curr",
+        "delta",
+        "pct",
+        "status",
+    ]
+    row = DiffRow("food", 1, 2, 1, 100.0, "up")
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        row.prev = 5  # type: ignore[misc]
+
+
+def test_month_diff_basic_statuses_and_order():
+    rows = [
+        _e("2026-09-30", "food", 9999),  # 対象外の月
+        _e("2026-10-05", "food", 300),
+        _e("2026-10-20", "food", 200),
+        _e("2026-10-10", "rent", 80000),
+        _e("2026-10-11", "books", 2000),
+        _e("2026-11-01", "food", 800),
+        _e("2026-11-02", "rent", 80000),
+        _e("2026-11-03", "cafe", 300),
+        _e("2026-12-01", "cafe", 7777),  # 対象外の月
+    ]
+    assert month_diff(rows, "2026-10", "2026-11") == [
+        DiffRow("books", 2000, 0, -2000, -100.0, "gone"),
+        DiffRow("cafe", 0, 300, 300, None, "new"),
+        DiffRow("food", 500, 800, 300, 60.0, "up"),
+        DiffRow("rent", 80000, 80000, 0, 0.0, "same"),
+    ]
+
+
+def test_month_diff_down_and_rounding():
+    rows = [
+        _e("2026-10-01", "food", 3),
+        _e("2026-11-01", "food", 4),
+        _e("2026-10-02", "rent", 1000),
+        _e("2026-11-02", "rent", 400),
+    ]
+    got = {r.category: r for r in month_diff(rows, "2026-10", "2026-11")}
+    assert got["food"] == DiffRow("food", 3, 4, 1, 33.3, "up")
+    assert got["rent"] == DiffRow("rent", 1000, 400, -600, -60.0, "down")
+
+
+def test_status_uses_presence_not_sum():
+    rows = [
+        # prev: 合計 0 だが明細はある → new/gone ではない
+        _e("2026-10-01", "food", 100),
+        _e("2026-10-02", "food", -100),
+        _e("2026-10-03", "refund", 0),
+        _e("2026-10-04", "gone0", 0),
+        # curr
+        _e("2026-11-01", "food", 500),
+        _e("2026-11-02", "refund", 0),
+        _e("2026-11-03", "zero", 0),
+    ]
+    assert month_diff(rows, "2026-10", "2026-11") == [
+        DiffRow("food", 0, 500, 500, None, "up"),  # prev == 0 → pct は None
+        DiffRow("gone0", 0, 0, 0, None, "gone"),
+        DiffRow("refund", 0, 0, 0, None, "same"),
+        DiffRow("zero", 0, 0, 0, None, "new"),
+    ]
+
+
+def test_month_diff_zero_delta_with_negative_prev_has_no_negative_zero():
+    rows = [_e("2026-10-01", "refund", -500), _e("2026-11-01", "refund", -500)]
+    (got,) = month_diff(rows, "2026-10", "2026-11")
+    assert got.status == "same"
+    assert got.pct == 0.0
+    assert str(got.pct) == "0.0"
+
+
+def test_month_diff_no_rows_is_empty():
+    assert month_diff([], "2026-10", "2026-11") == []
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        "2026-1",
+        "2026-13",
+        "2026-00",
+        "26-11",
+        "2026/11",
+        "2026-11\n",
+        "２０２６-11",
+        "",
+        "2026-011",
+    ],
+)
+def test_month_diff_rejects_bad_month(bad):
+    with pytest.raises(ValueError):
+        month_diff([], bad, "2026-11")
+    with pytest.raises(ValueError):
+        month_diff([], "2026-10", bad)
+
+
+def test_top_movers():
+    d1 = DiffRow("a", 1000, 0, -1000, -100.0, "gone")
+    d2 = DiffRow("b", 0, 0, 0, None, "same")
+    d3 = DiffRow("c", 100, 300, 200, 200.0, "up")
+    d4 = DiffRow("d", 50, 40, -10, -20.0, "down")
+    d5 = DiffRow("e", 0, 5, 5, None, "new")
+    diffs = [d1, d2, d3, d4, d5]
+    assert top_movers(diffs) == [d1, d3, d4]
+    assert top_movers(diffs, 2) == [d1, d3]
+    assert top_movers(diffs, 0) == []
+    assert top_movers(diffs, 10) == [d1, d3, d4, d5]
+    assert top_movers([d4, d3, d1]) == [d4, d3, d1]  # 入力の順序を保つ
+    assert top_movers([d2]) == []
+
+
+def test_top_movers_rejects_negative_n():
+    with pytest.raises(ValueError):
+        top_movers([], -1)
+
+
+def test_render_diff():
+    diffs = [
+        DiffRow("books", 2000, 0, -2000, -100.0, "gone"),
+        DiffRow("cafe", 0, 300, 300, None, "new"),
+        DiffRow("food", 500, 800, 300, 60.0, "up"),
+        DiffRow("rent", 80000, 80000, 0, 0.0, "same"),
+    ]
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "books\t2000\t0\t-2000\t-100.0%\n"
+        "cafe\t0\t300\t+300\t-\n"
+        "food\t500\t800\t+300\t+60.0%\n"
+        "rent\t80000\t80000\t+0\t+0.0%"
+    )
+
+
+def test_render_diff_empty_and_negative_zero():
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+    assert render_diff([DiffRow("x", -5, -5, 0, -0.0, "same")]) == (
+        "category\tprev\tcurr\tdelta\tpct\nx\t-5\t-5\t+0\t+0.0%"
+    )
+
+
+def test_available_months_sorted_unique():
+    rows = [
+        _e("2026-11-02", "food", 1),
+        _e("2026-10-31", "food", 1),
+        _e("2026-11-30", "rent", 1),
+        _e("2026-09-01", "food", 1),
+        _e("0005-03-01", "food", 1),
+    ]
+    assert available_months(rows) == ["0005-03", "2026-09", "2026-10", "2026-11"]
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_available_months():
+    rows = [
+        _e("2026-09-01", "food", 100),
+        _e("2026-10-01", "food", 200),
+        _e("2026-11-01", "food", 500),
+        _e("2026-11-02", "rent", 10),
+    ]
+    assert latest_diff(rows) == [
+        DiffRow("food", 200, 500, 300, 150.0, "up"),
+        DiffRow("rent", 0, 10, 10, None, "new"),
+    ]
+
+
+def test_latest_diff_skips_calendar_gaps():
+    rows = [_e("2026-09-01", "food", 100), _e("2026-11-01", "food", 150)]
+    assert latest_diff(rows) == [DiffRow("food", 100, 150, 50, 50.0, "up")]
+
+
+@pytest.mark.parametrize(
+    "rows",
+    [[], [_e("2026-11-01", "food", 1), _e("2026-11-02", "food", 2)]],
+)
+def test_latest_diff_needs_two_months(rows):
+    with pytest.raises(ValueError):
+        latest_diff(rows)
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..3f7aa84
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,297 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+LUNCH = Expense(date(2026, 11, 1), "food", 1200, "lunch")
+RENT = Expense(date(2026, 11, 2), "rent", 80000, "")
+COFFEE = Expense(date(2026, 11, 3), "food", 800, "coffee")
+FRIENDS = Expense(date(2026, 11, 4), "food", 500, "lunch with friends")
+STREET = Expense(date(2026, 11, 5), "Snacks", 300, "Straße")
+ROWS = [LUNCH, RENT, COFFEE, FRIENDS, STREET]
+
+
+def _memos(rows: list[Expense]) -> list[str]:
+    return [e.memo for e in rows]
+
+
+# --- tokenize -------------------------------------------------------------
+
+
+def test_tokenize_whitespace_separates_terms() -> None:
+    assert tokenize("food  lunch\tcoffee\n") == [
+        ("TERM", "food"),
+        ("TERM", "lunch"),
+        ("TERM", "coffee"),
+    ]
+
+
+def test_tokenize_parens() -> None:
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+
+
+def test_tokenize_parens_split_words() -> None:
+    assert tokenize("a(b)") == [
+        ("TERM", "a"),
+        ("LPAREN", "("),
+        ("TERM", "b"),
+        ("RPAREN", ")"),
+    ]
+
+
+def test_tokenize_quoted_term_keeps_spaces_and_parens() -> None:
+    assert tokenize('"hot coffee (x)"') == [("TERM", "hot coffee (x)")]
+
+
+def test_tokenize_quote_has_no_escapes() -> None:
+    assert tokenize('"a\\b"') == [("TERM", "a\\b")]
+
+
+def test_tokenize_quote_then_word_are_separate_tokens() -> None:
+    assert tokenize('"ab"cd') == [("TERM", "ab"), ("TERM", "cd")]
+
+
+def test_tokenize_unterminated_quote_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize('"lunch')
+
+
+def test_tokenize_empty_quote_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_keywords_are_uppercase_only() -> None:
+    assert tokenize("AND OR NOT and or not") == [
+        ("AND", "AND"),
+        ("OR", "OR"),
+        ("NOT", "NOT"),
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_keyword_inside_word_is_term() -> None:
+    assert tokenize("ANDROID") == [("TERM", "ANDROID")]
+
+
+def test_tokenize_quoted_keyword_is_term() -> None:
+    assert tokenize('"AND"') == [("TERM", "AND")]
+
+
+def test_tokenize_cat_prefix() -> None:
+    assert tokenize("cat:food") == [("CAT", "food")]
+
+
+def test_tokenize_cat_prefix_is_case_sensitive() -> None:
+    assert tokenize("CAT:food") == [("TERM", "CAT:food")]
+
+
+def test_tokenize_cat_without_value_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_tokenize_cat_without_value_before_space_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize("cat: lunch")
+
+
+# --- matches: TERM / CAT --------------------------------------------------
+
+
+def test_term_matches_memo_substring() -> None:
+    assert matches("lunch", LUNCH) is True
+    assert matches("friends", FRIENDS) is True
+
+
+def test_term_matches_category_substring() -> None:
+    assert matches("foo", LUNCH) is True
+
+
+def test_term_no_match() -> None:
+    assert matches("zzz", LUNCH) is False
+
+
+def test_term_is_case_insensitive() -> None:
+    assert matches("COFFEE", COFFEE) is True
+    assert matches("FOOD", LUNCH) is True
+
+
+def test_term_uses_casefold_not_lower() -> None:
+    # "ß".casefold() == "ss" while "ß".lower() == "ß", so only casefold makes
+    # "STRASSE" match "Straße".
+    assert matches("STRASSE", STREET) is True
+
+
+def test_term_empty_memo_only_matches_category() -> None:
+    assert matches("lunch", RENT) is False
+    assert matches("rent", RENT) is True
+
+
+def test_cat_is_exact_match_on_category() -> None:
+    assert matches("cat:food", LUNCH) is True
+    assert matches("cat:FOOD", LUNCH) is True
+
+
+def test_cat_is_not_substring() -> None:
+    assert matches("cat:foo", LUNCH) is False
+
+
+def test_cat_does_not_match_memo() -> None:
+    assert matches("cat:lunch", LUNCH) is False
+
+
+def test_term_matches_category_with_mixed_case() -> None:
+    assert matches("snacks", STREET) is True
+    assert matches("cat:snacks", STREET) is True
+
+
+# --- matches: operators and precedence ------------------------------------
+
+
+def test_explicit_and() -> None:
+    assert matches("food AND lunch", LUNCH) is True
+    assert matches("food AND rent", LUNCH) is False
+
+
+def test_implicit_and() -> None:
+    assert matches("food lunch", LUNCH) is True
+    assert matches("food coffee", LUNCH) is False
+
+
+def test_or() -> None:
+    assert matches("rent OR lunch", LUNCH) is True
+    assert matches("rent OR coffee", LUNCH) is False
+
+
+def test_or_is_lower_than_and() -> None:
+    # a OR (b AND c)
+    assert matches("rent OR food lunch", LUNCH) is True
+    assert matches("rent OR food coffee", LUNCH) is False
+    assert matches("rent OR food coffee", COFFEE) is True
+
+
+def test_not_binds_tighter_than_and() -> None:
+    # (NOT coffee) AND food
+    assert matches("NOT coffee food", LUNCH) is True
+    assert matches("NOT coffee food", COFFEE) is False
+
+
+def test_not_binds_tighter_than_or() -> None:
+    # (NOT food) OR lunch
+    assert matches("NOT food OR lunch", RENT) is True
+    assert matches("NOT food OR lunch", COFFEE) is False
+
+
+def test_parens_override_not() -> None:
+    assert matches("NOT (rent OR coffee)", LUNCH) is True
+    assert matches("NOT (rent OR lunch)", LUNCH) is False
+
+
+def test_double_not() -> None:
+    assert matches("NOT NOT lunch", LUNCH) is True
+    assert matches("NOT NOT lunch", COFFEE) is False
+
+
+def test_and_with_not_without_explicit_and() -> None:
+    # "a NOT b" is a AND (NOT b)
+    assert matches("food NOT coffee", LUNCH) is True
+    assert matches("food NOT coffee", COFFEE) is False
+
+
+def test_quoted_term_with_space() -> None:
+    assert matches('"lunch with"', FRIENDS) is True
+    assert matches('"lunch with"', LUNCH) is False
+
+
+def test_quoted_keyword_is_literal_term() -> None:
+    assert (
+        matches('"AND"', Expense(date(2026, 11, 1), "x", 1, "salad and rice")) is True
+    )
+
+
+def test_lowercase_or_is_term() -> None:
+    row = Expense(date(2026, 11, 1), "x", 1, "or")
+    assert matches("or", row) is True
+
+
+def test_parens_group_or_inside_and() -> None:
+    assert matches("food (rent OR coffee)", COFFEE) is True
+    assert matches("food (rent OR coffee)", LUNCH) is False
+
+
+# --- matches: errors -------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "",
+        "   ",
+        "(",
+        ")",
+        "()",
+        "( )",
+        "a)",
+        "(a",
+        "((a)",
+        "(a))",
+        "a OR",
+        "OR a",
+        "a OR OR b",
+        "a AND",
+        "AND a",
+        "a AND OR b",
+        "NOT",
+        "NOT )",
+        "a NOT",
+        "cat:",
+    ],
+)
+def test_invalid_queries_raise(query: str) -> None:
+    with pytest.raises(QueryError):
+        matches(query, LUNCH)
+
+
+def test_query_error_is_value_error() -> None:
+    assert issubclass(QueryError, ValueError)
+
+
+# --- filter_rows ------------------------------------------------------------
+
+
+def test_filter_rows_keeps_input_order() -> None:
+    out = filter_rows("food", ROWS)
+    assert out == [LUNCH, COFFEE, FRIENDS]
+
+
+def test_filter_rows_no_match_is_empty() -> None:
+    assert filter_rows("zzz", ROWS) == []
+
+
+def test_filter_rows_empty_input_valid_query() -> None:
+    assert filter_rows("food", []) == []
+
+
+def test_filter_rows_empty_input_invalid_query_raises() -> None:
+    with pytest.raises(QueryError):
+        filter_rows("food OR", [])
+
+
+def test_filter_rows_invalid_query_raises() -> None:
+    with pytest.raises(QueryError):
+        filter_rows("(food", ROWS)
+
+
+def test_filter_rows_does_not_mutate_input() -> None:
+    rows = list(ROWS)
+    filter_rows("food", rows)
+    assert rows == ROWS
+
+
+def test_filter_rows_with_or_and_memo() -> None:
+    assert _memos(filter_rows("rent OR coffee", ROWS)) == ["", "coffee"]
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..41c0e21
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,293 @@
+import dataclasses
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def _e(
+    day: date, category: str = "subscription", amount: int = 1000, memo: str = ""
+) -> Expense:
+    return Expense(day, category, amount, memo)
+
+
+@pytest.mark.parametrize(
+    "src, expected",
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2024, 1, 31), date(2024, 2, 29)),
