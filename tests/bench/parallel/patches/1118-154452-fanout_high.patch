+def test_tolerance_boundary_later_direction():
+    # 2026-02-10 からの +3 日は許容、+3 日の次が 03-13 基準の +3 日(03-16)も許容
+    rows = [_e(date(2026, 1, 10)), _e(date(2026, 2, 13)), _e(date(2026, 3, 16))]
+    (r,) = find_recurring(rows, tolerance=3)
+    assert r.days == (date(2026, 1, 10), date(2026, 2, 13), date(2026, 3, 16))
+    assert r.next_expected == date(2026, 4, 16)
+    assert find_recurring(rows, tolerance=2) == []
