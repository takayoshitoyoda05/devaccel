+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def E(y, m, d, cat="家賃", amt=50000, memo=""):
+    return Expense(date(y, m, d), cat, amt, memo)
+
+
+@pytest.mark.parametrize(
+    "src,dst",
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2024, 1, 31), date(2024, 2, 29)),
+        (date(2026, 12, 15), date(2027, 1, 15)),
+        (date(2026, 3, 31), date(2026, 4, 30)),
+        (date(2026, 5, 10), date(2026, 6, 10)),
+    ],
+)
+def test_add_month(src, dst):
+    assert add_month(src) == dst
+
+
+def test_basic_detection():
+    rows = [E(2026, 1, 25), E(2026, 2, 25), E(2026, 3, 26)]
+    assert find_recurring(rows) == [
+        Recurring(
+            "家賃",
+            50000,
+            (date(2026, 1, 25), date(2026, 2, 25), date(2026, 3, 26)),
+            date(2026, 4, 26),
+        )
+    ]
+
+
+def test_validation():
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+    assert find_recurring([]) == []
+
+
+def test_too_short_and_gap_split():
+    rows = [E(2026, 1, 1), E(2026, 2, 1), E(2026, 4, 1), E(2026, 5, 1), E(2026, 6, 1)]
+    out = find_recurring(rows)
+    assert [r.days[0] for r in out] == [date(2026, 4, 1)]
+    assert len(find_recurring(rows, min_count=2)) == 2
+
+
+def test_tolerance_boundary():
+    rows = [E(2026, 1, 10), E(2026, 2, 13), E(2026, 3, 16)]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+    assert find_recurring(rows, tolerance=2) == []
+
+
+def test_duplicates_and_memo_ignored_and_groups():
+    rows = [
+        E(2026, 1, 5, memo="a"),
+        E(2026, 1, 5, memo="b"),
+        E(2026, 2, 5),
+        E(2026, 3, 5),
+        E(2026, 1, 5, amt=900),
+        E(2026, 2, 5, amt=900),
+        E(2026, 3, 5, amt=900),
+        E(2026, 1, 5, cat="A"),
+        E(2026, 2, 5, cat="A"),
+        E(2026, 3, 5, cat="A"),
+    ]
+    out = find_recurring(rows)
+    assert [(r.category, r.amount) for r in out] == [
+        ("A", 50000),
+        ("家賃", 900),
+        ("家賃", 50000),
+    ]
+    assert len(out[2].days) == 3
+
+
+def test_month_end_chain():
+    rows = [E(2026, 1, 31), E(2026, 2, 28), E(2026, 3, 28)]
+    assert len(find_recurring(rows, tolerance=0)) == 1
