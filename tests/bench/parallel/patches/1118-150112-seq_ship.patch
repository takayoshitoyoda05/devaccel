index 0000000..2566db7
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,91 @@
+"""Import CSVs exported from other banks / card issuers."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"(-?)[¥￥]?([0-9][0-9,]*)円?", re.ASCII)
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})", re.ASCII)
+
+
+def parse_amount(s: str) -> int:
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if not m:
+        raise ValueError(f"invalid amount: {s!r}")
+    n = int(m.group(2).replace(",", ""))
+    return -n if m.group(1) else n
+
+
+def parse_date(s: str) -> date:
+    m = _DATE_RE.fullmatch(s.strip())
+    if not m:
+        raise ValueError(f"invalid date: {s!r}")
+    return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping lacks {key!r}")
+    category_map = category_map or {}
+    reader = csv.reader(io.StringIO(text, newline=""))
+    try:
+        header = next(reader)
+    except StopIteration:
+        raise ValueError("empty input") from None
+    index: dict[str, int] = {}
+    for field, col in mapping.items():
+        if col not in header:
+            raise ValueError(f"column {col!r} not in header")
+        index[field] = header.index(col)
+
+    def cell(row: list[str], field: str) -> str:
+        i = index.get(field)
+        return row[i] if i is not None and i < len(row) else ""
+
+    rows: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    prev_end = reader.line_num
+    for row in reader:
+        end = reader.line_num
+        line = prev_end + 1  # physical line where this record starts
+        prev_end = end
+        if not row:
+            continue
+        bad: list[str] = []
+        day = amount = None
+        try:
+            day = parse_date(cell(row, "date"))
+        except ValueError:
+            bad.append("date")
+        try:
+            amount = parse_amount(cell(row, "amount"))
+        except ValueError:
+            bad.append("amount")
+        category = cell(row, "category").strip()
+        if not category:
+            bad.append("category")
+        if bad or day is None or amount is None:
+            errors.extend((line, f) for f in bad)
+            continue
+        category = category_map.get(category, category)
+        rows.append(Expense(day, category, amount, cell(row, "memo").strip()))
+    return rows, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
