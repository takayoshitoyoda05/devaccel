@@ -0,0 +1,26 @@
+"""Longest run of days without any expense record."""
+
+from __future__ import annotations
+
+from datetime import date, timedelta
+
+from kakeibo.core import Expense
+
+
+def longest_no_spend_streak(rows: list[Expense], start: date, end: date) -> int:
+    """Longest run of consecutive days in [start, end] (both inclusive) with no record.
+
+    Records outside the period are ignored. Returns 0 if start is after end.
+    """
+    spend_days = {e.day for e in rows if start <= e.day <= end}
+    best = 0
+    run = 0
+    day = start
+    while day <= end:
+        if day in spend_days:
+            run = 0
+        else:
+            run += 1
+            best = max(best, run)
+        day += timedelta(days=1)
+    return best
diff --git a/src/kakeibo/topn.py b/src/kakeibo/topn.py
new file mode 100644
index 0000000..23d3c34
--- /dev/null
+++ b/src/kakeibo/topn.py
@@ -0,0 +1,14 @@
+"""Top-N expenses by amount."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def top_expenses(rows: list[Expense], n: int) -> list[Expense]:
+    """金額の大きい順に n 件。同額は日付の早い順、同日なら入力の順。n <= 0 なら []。"""
+    if n <= 0:
+        return []
+    # sorted は安定ソートなので、同額・同日の要素は入力の順を保つ。入力は変更しない。
+    ordered = sorted(rows, key=lambda e: (-e.amount, e.day))
+    return ordered[:n]
