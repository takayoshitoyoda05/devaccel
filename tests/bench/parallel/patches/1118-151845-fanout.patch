@@ -0,0 +1,16 @@
+"""Expense totals grouped by day of the week."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+_WEEKDAYS = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
+
+
+def total_by_weekday(rows: list[Expense]) -> dict[str, int]:
+    """{"Mon".."Sun": yen}; only weekdays that have rows, Monday-first order."""
+    totals: dict[str, int] = {}
+    for e in rows:
+        name = _WEEKDAYS[e.day.weekday()]
+        totals[name] = totals.get(name, 0) + e.amount
+    return {name: totals[name] for name in _WEEKDAYS if name in totals}
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..9a2dfda
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,203 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+HEADER = "利用日,分類,利用金額,利用店名"
+
+
+# --- parse_amount ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥1200", 1200),
+        ("￥5", 5),
+        ("-1,000円", -1000),
+        ("1,2", 12),  # カンマの位置は検査しない
+        ("-0", 0),
+    ],
+)
+def test_parse_amount_accepts(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "   ",
+        "円",
+        "12.5",
+        "1 200",
+        "--5",
+        "¥-5",
+        "１２３",
+        "-",
+        "¥",
+        "-円",
+        ",123",
+        "¥円",
+        "100円円",
+        "円100",
+        "1000 円",
+        "12-3",
+    ],
+)
+def test_parse_amount_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+# --- parse_date -----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        ("2026/12/31", date(2026, 12, 31)),
+        ("  2026-1-5  ", date(2026, 1, 5)),
+        ("2024/2/29", date(2024, 2, 29)),
+    ],
+)
+def test_parse_date_accepts(text: str, expected: date) -> None:
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026/1-5",
+        "2026-1/5",
+        "26/1/5",
+        "2026/02/30",
+        "2026/2/29",
+        "2026/13/1",
+        "２０２６/1/5",
+        "2026/1/5/",
+        "",
+        "2026/1",
+        "2026/123/1",
+        "2026.1.5",
+    ],
+)
+def test_parse_date_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+# --- import_rows ----------------------------------------------------------
+
+
+def test_default_mapping_values() -> None:
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_import_basic_default_mapping() -> None:
+    text = f'{HEADER}\n2026/1/5,食費,"1,200円",  スーパー  \n'
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 1200, "スーパー")]
+
+
+def test_quoted_comma_in_memo() -> None:
+    text = f'{HEADER}\n2026-01-05,食費,500,"A, B"\n'
+    rows, _ = import_rows(text)
+    assert rows[0].memo == "A, B"
+
+
+def test_extra_columns_ignored_and_order_kept() -> None:
+    text = "x,利用日,分類,利用金額,利用店名,y\n1,2026/1/1,交通,100,a,2\n9,2026/1/2,食費,200,b,3\n"
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert [r.amount for r in rows] == [100, 200]
+    assert [r.category for r in rows] == ["交通", "食費"]
+
+
+def test_custom_mapping_and_missing_memo() -> None:
+    text = "d,c,a\n2026/3/3,  雑費 ,70\n"
+    mapping = {"date": "d", "category": "c", "amount": "a"}
+    rows, errors = import_rows(text, mapping)
+    assert errors == []
+    assert rows == [Expense(date(2026, 3, 3), "雑費", 70, "")]
+
+
+def test_category_map_applied_after_strip() -> None:
+    text = f"{HEADER}\n2026/1/5, 食品 ,100,x\n2026/1/6,交通,200,y\n"
+    rows, _ = import_rows(text, category_map={"食品": "食費"})
+    assert [r.category for r in rows] == ["食費", "交通"]
+
+
+def test_mapping_missing_required_key_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows(HEADER, {"date": "利用日", "amount": "利用金額"})
+
+
+def test_mapping_column_not_in_header_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows(
+            HEADER, {"date": "無い列", "category": "分類", "amount": "利用金額"}
+        )
+
+
+def test_memo_mapping_column_not_in_header_raises() -> None:
+    mapping = {**DEFAULT_MAPPING, "memo": "無い列"}
+    with pytest.raises(ValueError):
+        import_rows(HEADER, mapping)
+
+
+def test_error_line_numbers_count_blank_lines_and_row_is_skipped() -> None:
+    text = f"{HEADER}\n\n2026/1/5,食費,100,ok\n\n2026/13/1,食費,100,bad\n"
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "ok")]
+    assert errors == [(5, "date")]
+
+
+def test_multiple_errors_in_one_row_recorded_in_order() -> None:
+    text = f"{HEADER}\n不正,   ,abc,x\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "date"), (2, "amount"), (2, "category")]
+
+
+def test_amount_and_category_errors_only() -> None:
+    text = f"{HEADER}\n2026/1/5,,12.5,x\n"
+    _, errors = import_rows(text)
+    assert errors == [(2, "amount"), (2, "category")]
+
+
+def test_short_row_missing_values_become_errors() -> None:
+    text = f"{HEADER}\n2026/1/5\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "amount"), (2, "category")]
+
+
+def test_short_row_missing_memo_is_empty_string() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,100\n"
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows[0].memo == ""
+
+
+def test_empty_category_is_error_even_with_map() -> None:
+    text = f"{HEADER}\n2026/1/5,   ,100,x\n"
+    rows, errors = import_rows(text, category_map={"": "x"})
+    assert rows == []
+    assert errors == [(2, "category")]
