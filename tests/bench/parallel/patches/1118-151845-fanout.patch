+++ b/tests/test_stats.py
@@ -0,0 +1,58 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.stats import median_by_category
+
+
+def _e(category: str, amount: int) -> Expense:
+    return Expense(day=date(2026, 1, 1), category=category, amount=amount)
+
+
+def test_empty_returns_empty_dict() -> None:
+    assert median_by_category([]) == {}
+
+
+def test_single_expense_is_its_own_median() -> None:
+    assert median_by_category([_e("食費", 500)]) == {"食費": 500.0}
+
+
+def test_odd_count_takes_middle_value() -> None:
+    rows = [_e("食費", 300), _e("食費", 100), _e("食費", 200)]
+    assert median_by_category(rows) == {"食費": 200.0}
+
+
+def test_even_count_averages_middle_two() -> None:
+    rows = [_e("食費", 100), _e("食費", 400), _e("食費", 300), _e("食費", 200)]
+    assert median_by_category(rows) == {"食費": 250.0}
+
+
+def test_even_count_with_two_values() -> None:
+    rows = [_e("交通費", 100), _e("交通費", 300)]
+    assert median_by_category(rows) == {"交通費": 200.0}
+
+
+def test_duplicate_values() -> None:
+    rows = [_e("食費", 100), _e("食費", 100), _e("食費", 900)]
+    assert median_by_category(rows) == {"食費": 100.0}
+
+
+def test_categories_are_computed_separately() -> None:
+    rows = [
+        _e("食費", 100),
+        _e("住居", 10000),
+        _e("食費", 300),
+        _e("住居", 20000),
+        _e("食費", 200),
+    ]
+    assert median_by_category(rows) == {"食費": 200.0, "住居": 15000.0}
+
+
+def test_keys_are_sorted_by_category_name_ascending() -> None:
+    rows = [_e("娯楽", 1), _e("食費", 2), _e("交通費", 3), _e("住居", 4)]
+    result = median_by_category(rows)
+    assert list(result) == ["交通費", "住居", "娯楽", "食費"]
+
+
+def test_values_are_float() -> None:
+    result = median_by_category([_e("食費", 100)])
+    assert isinstance(result["食費"], float)
