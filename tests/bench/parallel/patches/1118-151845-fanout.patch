@@ -0,0 +1,68 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.dupes import find_duplicates
+
+D = date(2026, 1, 5)
+
+
+def e(
+    day: date = D, category: str = "食費", amount: int = 500, memo: str = ""
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+def test_empty_list_has_no_duplicates() -> None:
+    assert find_duplicates([]) == []
+
+
+def test_single_row_has_no_duplicates() -> None:
+    assert find_duplicates([e()]) == []
+
+
+def test_distinct_rows_have_no_duplicates() -> None:
+    assert find_duplicates([e(), e(amount=600), e(category="交通費")]) == []
+
+
+def test_identical_pair_is_reported_once() -> None:
+    assert find_duplicates([e(), e()]) == [(0, 1)]
+
+
+def test_non_adjacent_duplicates_use_input_indices() -> None:
+    rows = [e(), e(amount=1), e()]
+    assert find_duplicates(rows) == [(0, 2)]
+
+
+def test_three_identical_rows_yield_all_pairs_in_order() -> None:
+    assert find_duplicates([e(), e(), e()]) == [(0, 1), (0, 2), (1, 2)]
+
+
+def test_result_is_sorted_by_i_then_j() -> None:
+    # 0 と 3 が同じ、1 と 2 が同じ。i の昇順、同じ i なら j の昇順。
+    rows = [e(amount=1), e(amount=2), e(amount=2), e(amount=1)]
+    assert find_duplicates(rows) == [(0, 3), (1, 2)]
+
+
+def test_differing_day_is_not_duplicate() -> None:
+    assert find_duplicates([e(), e(day=date(2026, 1, 6))]) == []
+
+
+def test_differing_category_is_not_duplicate() -> None:
+    assert find_duplicates([e(), e(category="交通費")]) == []
+
+
+def test_differing_amount_is_not_duplicate() -> None:
+    assert find_duplicates([e(), e(amount=501)]) == []
+
+
+def test_differing_memo_is_not_duplicate() -> None:
+    assert find_duplicates([e(memo="昼食"), e(memo="夕食")]) == []
+
+
+def test_memo_comparison_is_exact_not_stripped() -> None:
+    # 空文字と空白だけのメモは別物として扱う(正規化しない)。
+    assert find_duplicates([e(memo=""), e(memo=" ")]) == []
+
+
+def test_memo_equal_non_empty_is_duplicate() -> None:
+    assert find_duplicates([e(memo="昼食"), e(memo="昼食")]) == [(0, 1)]
