diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..c2161cb
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,287 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def E(d: str, cat: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(d), category=cat, amount=amount)
+
+
+ROWS = [
+    E("2024-01-05", "食費", 10000),
+    E("2024-01-20", "食費", 2000),
+    E("2024-01-10", "交通", 1000),
+    E("2024-02-03", "食費", 12300),
+    E("2024-02-15", "娯楽", 500),
+    E("2024-02-16", "交通", 1000),
+]
+
+
+def by_cat(rows: list[DiffRow]) -> dict[str, DiffRow]:
+    return {r.category: r for r in rows}
+
+
+# --- month_diff: 集計・status・pct ---
+
+
+def test_month_diff_totals_delta_and_pct() -> None:
+    rows = by_cat(month_diff(ROWS, "2024-01", "2024-02"))
+    food = rows["食費"]
+    assert (food.prev, food.curr, food.delta) == (12000, 12300, 300)
+    assert food.pct == 2.5
+    assert food.status == "up"
+
+
+def test_status_down_and_same() -> None:
+    rows = by_cat(month_diff(ROWS, "2024-01", "2024-02"))
+    assert rows["交通"].delta == 0
+    assert rows["交通"].status == "same"
+    assert rows["交通"].pct == 0.0
+
+
+def test_new_and_gone_categories() -> None:
+    rows = by_cat(month_diff(ROWS, "2024-01", "2024-02"))
+    assert rows["娯楽"].status == "new"
+    assert rows["娯楽"].prev == 0
+    assert rows["娯楽"].pct is None
+
+
+def test_gone_category_pct_is_minus_100() -> None:
+    rows = [E("2024-01-01", "旅行", 5000)]
+    diffs = month_diff(rows + [E("2024-02-01", "食費", 1)], "2024-01", "2024-02")
+    travel = by_cat(diffs)["旅行"]
+    assert travel.status == "gone"
+    assert travel.curr == 0
+    assert travel.delta == -5000
+    assert travel.pct == -100.0
+
+
+def test_down_status_and_negative_pct() -> None:
+    rows = [E("2024-01-01", "食費", 2000), E("2024-02-01", "食費", 1500)]
+    food = month_diff(rows, "2024-01", "2024-02")[0]
+    assert food.status == "down"
+    assert food.delta == -500
+    assert food.pct == -25.0
+
+
+def test_pct_rounds_to_one_decimal() -> None:
+    rows = [E("2024-01-01", "食費", 3000), E("2024-02-01", "食費", 4000)]
+    assert month_diff(rows, "2024-01", "2024-02")[0].pct == 33.3
+
+
+def test_zero_total_with_records_is_same_not_new() -> None:
+    # 明細はあるが合計 0: status は明細の有無で決まる(合計では決めない)
+    rows = [E("2024-01-01", "雑費", 0), E("2024-02-01", "雑費", 0)]
+    r = month_diff(rows, "2024-01", "2024-02")[0]
+    assert r.status == "same"
+    assert r.delta == 0
+    assert r.pct is None  # prev == 0
+
+
+def test_zero_prev_with_records_is_up_with_no_pct() -> None:
+    rows = [E("2024-01-01", "雑費", 0), E("2024-02-01", "雑費", 300)]
+    r = month_diff(rows, "2024-01", "2024-02")[0]
+    assert r.status == "up"
+    assert r.prev == 0
+    assert r.pct is None
+
+
+def test_other_months_do_not_count_as_prev_records() -> None:
+    # 2023-12 の明細は prev_month(2024-01)の判定に入らない → new
+    rows = [E("2023-12-01", "食費", 100), E("2024-02-01", "食費", 200)]
+    r = month_diff(rows, "2024-01", "2024-02")[0]
+    assert r.status == "new"
+    assert r.prev == 0
+
+
+def test_rows_outside_both_months_are_ignored() -> None:
+    rows = [E("2023-12-31", "食費", 999), E("2024-03-01", "食費", 999)]
+    assert month_diff(rows, "2024-01", "2024-02") == []
+
+
+def test_empty_rows_gives_empty_list() -> None:
+    assert month_diff([], "2024-01", "2024-02") == []
+
+
+def test_only_categories_present_in_either_month_are_listed() -> None:
+    rows = [E("2024-01-01", "食費", 1)]
+    diffs = month_diff(rows, "2024-01", "2024-02")
+    assert [r.category for r in diffs] == ["食費"]
+
+
+def test_sorted_by_abs_delta_desc_then_category_asc() -> None:
+    rows = [
+        E("2024-01-01", "b", 1000),
+        E("2024-01-01", "a", 1000),
+        E("2024-01-01", "c", 5000),
+        E("2024-02-01", "b", 1000),  # delta 0 (same)
+        E("2024-02-01", "a", 0),  # delta -1000 (down)
+        E("2024-02-01", "d", -3000),  # delta -3000 (new)
+    ]
+    diffs = month_diff(rows, "2024-01", "2024-02")
+    # c: |-5000|, d: |-3000|, a: |-1000|, b: 0
+    assert [r.category for r in diffs] == ["c", "d", "a", "b"]
+
+
+def test_equal_abs_delta_sorted_by_category() -> None:
+    rows = [
+        E("2024-01-01", "z", 100),
+        E("2024-02-01", "z", 200),
+        E("2024-01-01", "y", 300),
+        E("2024-02-01", "y", 0),
+    ]
+    diffs = month_diff(rows, "2024-01", "2024-02")
+    assert [(r.category, r.delta) for r in diffs] == [("y", -300), ("z", 100)]
+
+
+@pytest.mark.parametrize(
+    "prev,curr",
+    [
+        ("2024-1", "2024-02"),
+        ("2024-01", "2024-13"),
+        ("2024-00", "2024-02"),
+        ("24-01", "2024-02"),
+        ("2024/01", "2024-02"),
+        ("2024-01", "2024-2"),
+        ("2024-01", ""),
+        ("2024-01\n", "2024-02"),
+    ],
+)
+def test_invalid_month_format_raises(prev: str, curr: str) -> None:
+    with pytest.raises(ValueError):
+        month_diff(ROWS, prev, curr)
+
+
+# --- top_movers ---
+
+
+def test_top_movers_excludes_same_and_keeps_order() -> None:
+    diffs = month_diff(ROWS, "2024-01", "2024-02")
+    movers = top_movers(diffs, n=10)
+    # month_diff の並び(|delta| 降順)を保つ: 娯楽 +500 → 食費 +300
+    assert [r.category for r in movers] == ["娯楽", "食費"]
+    assert all(r.status != "same" for r in movers)
+
+
+def test_top_movers_default_n_is_three() -> None:
+    rows = [E("2024-01-01", f"c{i}", 0) for i in range(5)]
+    rows += [E("2024-02-01", f"c{i}", (i + 1) * 100) for i in range(5)]
+    diffs = month_diff(rows, "2024-01", "2024-02")
+    assert len(top_movers(diffs)) == 3
+
+
+def test_top_movers_takes_first_n_after_filtering() -> None:
+    diffs = [
+        DiffRow("a", 100, 100, 0, 0.0, "same"),
+        DiffRow("b", 100, 200, 100, 100.0, "up"),
+        DiffRow("c", 100, 50, -50, -50.0, "down"),
+    ]
+    assert [r.category for r in top_movers(diffs, n=1)] == ["b"]
+
+
+def test_top_movers_zero_returns_empty() -> None:
+    diffs = month_diff(ROWS, "2024-01", "2024-02")
+    assert top_movers(diffs, n=0) == []
+
+
+def test_top_movers_negative_n_raises() -> None:
+    with pytest.raises(ValueError):
+        top_movers([], n=-1)
+
+
+def test_top_movers_empty_input() -> None:
+    assert top_movers([]) == []
+
+
+# --- render_diff ---
+
+
+def test_render_header_and_rows() -> None:
+    diffs = month_diff(ROWS, "2024-01", "2024-02")
+    text = render_diff(diffs)
+    assert text.split("\n") == [
+        "category\tprev\tcurr\tdelta\tpct",
+        "娯楽\t0\t500\t+500\t-",
+        "食費\t12000\t12300\t+300\t+2.5%",
+        "交通\t1000\t1000\t+0\t+0.0%",
+    ]
+
+
+def test_render_signed_negative_delta_and_minus_100() -> None:
+    rows = [E("2024-01-01", "旅行", 5000), E("2024-02-01", "食費", 1)]
+    text = render_diff(month_diff(rows, "2024-01", "2024-02"))
+    lines = text.split("\n")
+    assert "旅行\t5000\t0\t-5000\t-100.0%" in lines
+
+
+def test_render_has_no_trailing_newline() -> None:
+    text = render_diff(month_diff(ROWS, "2024-01", "2024-02"))
+    assert not text.endswith("\n")
+
+
+def test_render_empty_list_is_header_only() -> None:
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_render_small_negative_pct_does_not_show_negative_zero() -> None:
+    # delta -1 / 10000 => -0.01 -> round -> -0.0 ; 符号は "+0.0%" と表示する
+    rows = [E("2024-01-01", "食費", 10000), E("2024-02-01", "食費", 9999)]
+    text = render_diff(month_diff(rows, "2024-01", "2024-02"))
+    assert text.split("\n")[1] == "食費\t10000\t9999\t-1\t+0.0%"
+
+
+def test_render_pct_none_shows_dash() -> None:
+    r = DiffRow("x", 0, 10, 10, None, "new")
+    assert render_diff([r]).split("\n")[1] == "x\t0\t10\t+10\t-"
+
+
+# --- available_months / latest_diff ---
+
+
+def test_available_months_sorted_unique() -> None:
+    rows = [
+        E("2024-03-01", "a", 1),
+        E("2023-12-31", "a", 1),
+        E("2024-03-30", "a", 1),
+        E("2024-01-01", "a", 1),
+    ]
+    assert available_months(rows) == ["2023-12", "2024-01", "2024-03"]
+
+
+def test_available_months_empty() -> None:
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months() -> None:
+    rows = ROWS + [E("2024-03-01", "食費", 1000)]
+    diffs = by_cat(latest_diff(rows))
+    # 直近 2 か月 = 2024-02 (prev) と 2024-03 (curr)。2024-01 の明細は使わない
+    assert diffs["食費"].prev == 12300
+    assert diffs["食費"].curr == 1000
+    assert diffs["交通"].status == "gone"
+
+
+def test_latest_diff_with_exactly_two_months() -> None:
+    assert latest_diff(ROWS) == month_diff(ROWS, "2024-01", "2024-02")
+
+
+def test_latest_diff_one_month_raises() -> None:
+    with pytest.raises(ValueError):
+        latest_diff([E("2024-01-01", "食費", 1)])
+
+
+def test_latest_diff_no_rows_raises() -> None:
+    with pytest.raises(ValueError):
+        latest_diff([])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..a733dc3
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,170 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def ex(category: str, memo: str = "", amount: int = 100) -> Expense:
+    return Expense(day=date(2026, 1, 1), category=category, amount=amount, memo=memo)
+
+
+ROWS = [
+    ex("食費", "ランチ 鶏肉"),
+    ex("Food", "dinner pizza"),
+    ex("交通費", "電車 定期"),
+    ex("食費", ""),
+]
+
+
+# --- tokenize ---
+
+
+def test_tokenize_skips_whitespace_and_yields_parens() -> None:
+    assert tokenize("  a  (b) ") == [
+        ("TERM", "a"),
+        ("LPAREN", "("),
+        ("TERM", "b"),
+        ("RPAREN", ")"),
+    ]
+
+
+def test_tokenize_only_whitespace_gives_no_tokens() -> None:
+    assert tokenize("   ") == []
+
+
+def test_tokenize_quoted_term_keeps_spaces_and_parens() -> None:
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+
+
+def test_tokenize_quote_has_no_escapes() -> None:
+    assert tokenize(r'"a\"') == [("TERM", "a\\")]
+
+
+def test_tokenize_unclosed_quote_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_operators_only_when_uppercase() -> None:
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+    assert tokenize("and or not") == [
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_cat_prefix() -> None:
+    assert tokenize("cat:食費") == [("CAT", "食費")]
+
+
+def test_tokenize_cat_with_empty_value_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_tokenize_word_stops_at_quote_and_paren() -> None:
+    assert tokenize('ab"cd"(ef)') == [
+        ("TERM", "ab"),
+        ("TERM", "cd"),
+        ("LPAREN", "("),
+        ("TERM", "ef"),
+        ("RPAREN", ")"),
+    ]
+
+
+def test_tokenize_uppercase_cat_is_plain_term() -> None:
+    assert tokenize("CAT:x") == [("TERM", "CAT:x")]
+
+
+# --- parsing errors ---
+
+
+@pytest.mark.parametrize(
+    "q",
+    ["", "   ", "()", "(a", "a)", "a AND", "AND a", "a OR", "OR a", "NOT", "a ( )"],
+)
+def test_malformed_queries_raise(q: str) -> None:
+    with pytest.raises(QueryError):
+        filter_rows(q, [])
+
+
+def test_invalid_query_raises_even_with_empty_rows() -> None:
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
+
+
+# --- evaluation ---
+
+
+def test_term_matches_memo_or_category_case_insensitively() -> None:
+    assert matches("PIZZA", ROWS[1])
+    assert matches("food", ROWS[1])
+    assert not matches("pizza", ROWS[0])
+
+
+def test_term_is_substring_match() -> None:
+    assert matches("ラン", ROWS[0])
+
+
+def test_cat_requires_exact_category_casefolded() -> None:
+    assert matches("cat:food", ROWS[1])
+    assert not matches("cat:foo", ROWS[1])
+    assert not matches("cat:食", ROWS[0])
+    assert matches("cat:食費", ROWS[0])
+
+
+def test_cat_does_not_match_memo() -> None:
+    assert not matches("cat:ランチ", ROWS[0])
+
+
+def test_implicit_and_between_terms() -> None:
+    assert filter_rows("食費 鶏肉", ROWS) == [ROWS[0]]
+
+
+def test_explicit_and() -> None:
+    assert filter_rows("食費 AND 鶏肉", ROWS) == [ROWS[0]]
+    assert filter_rows("食費 AND 電車", ROWS) == []
+
+
+def test_or() -> None:
+    assert filter_rows("鶏肉 OR 電車", ROWS) == [ROWS[0], ROWS[2]]
+
+
+def test_not_binds_tighter_than_and() -> None:
+    # NOT 食費 AND 定期 == (NOT 食費) AND 定期
+    assert filter_rows("NOT cat:食費 鶏肉", ROWS) == []
+    assert filter_rows("NOT cat:食費 電車", ROWS) == [ROWS[2]]
+
+
+def test_and_binds_tighter_than_or() -> None:
+    # a OR b AND c == a OR (b AND c)
+    assert filter_rows("cat:Food OR 食費 鶏肉", ROWS) == [ROWS[0], ROWS[1]]
+
+
+def test_parentheses_override_precedence() -> None:
+    assert filter_rows("(cat:Food OR 食費) 鶏肉", ROWS) == [ROWS[0]]
+
+
+def test_double_not() -> None:
+    assert filter_rows("NOT NOT 電車", ROWS) == [ROWS[2]]
+
+
+def test_quoted_term_with_space() -> None:
+    assert filter_rows('"電車 定期"', ROWS) == [ROWS[2]]
+
+
+def test_filter_keeps_input_order_and_duplicates() -> None:
+    rows = [ROWS[3], ROWS[0], ROWS[3]]
+    assert filter_rows("cat:食費", rows) == [ROWS[3], ROWS[0], ROWS[3]]
+
+
+def test_filter_empty_rows_with_valid_query() -> None:
+    assert filter_rows("食費", []) == []
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..bdaaead
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,277 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def ex(d: date, category: str = "通信", amount: int = 1000, memo: str = "") -> Expense:
+    return Expense(day=d, category=category, amount=amount, memo=memo)
+
+
+# --- add_month ---------------------------------------------------------------
+
+
+def test_add_month_normal_day() -> None:
+    assert add_month(date(2026, 3, 15)) == date(2026, 4, 15)
+
+
+def test_add_month_clamps_to_end_of_short_month() -> None:
+    assert add_month(date(2026, 1, 31)) == date(2026, 2, 28)
+
+
+def test_add_month_clamps_to_leap_day() -> None:
+    assert add_month(date(2024, 1, 31)) == date(2024, 2, 29)
+
+
+def test_add_month_day_31_into_30_day_month() -> None:
+    assert add_month(date(2026, 3, 31)) == date(2026, 4, 30)
+
+
+def test_add_month_rolls_over_year() -> None:
+    assert add_month(date(2026, 12, 15)) == date(2027, 1, 15)
+
+
+def test_add_month_rolls_over_year_with_clamp() -> None:
+    assert add_month(date(2026, 12, 31)) == date(2027, 1, 31)
+
+
+# --- find_recurring: argument validation -------------------------------------
+
+
+def test_min_count_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+
+
+def test_negative_tolerance_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_min_count_two_and_zero_tolerance_are_accepted() -> None:
+    assert find_recurring([], min_count=2, tolerance=0) == []
+
+
+# --- find_recurring: basic detection -----------------------------------------
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+def test_three_consecutive_months_detected() -> None:
+    rows = [ex(date(2026, 1, 10)), ex(date(2026, 2, 10)), ex(date(2026, 3, 10))]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="通信",
+            amount=1000,
+            days=(date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10)),
+            next_expected=date(2026, 4, 10),
+        )
+    ]
+
+
+def test_two_occurrences_not_enough_with_default_min_count() -> None:
+    rows = [ex(date(2026, 1, 10)), ex(date(2026, 2, 10))]
+    assert find_recurring(rows) == []
+
+
+def test_two_occurrences_enough_when_min_count_two() -> None:
+    rows = [ex(date(2026, 1, 10)), ex(date(2026, 2, 10))]
+    result = find_recurring(rows, min_count=2)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 10))
+    assert result[0].next_expected == date(2026, 3, 10)
+
+
+def test_run_exactly_min_count_is_included() -> None:
+    rows = [ex(date(2026, 1, 10)), ex(date(2026, 2, 10)), ex(date(2026, 3, 10))]
+    assert len(find_recurring(rows, min_count=3)) == 1
+
+
+def test_run_shorter_than_min_count_is_excluded() -> None:
+    rows = [ex(date(2026, 1, 10)), ex(date(2026, 2, 10)), ex(date(2026, 3, 10))]
+    assert find_recurring(rows, min_count=4) == []
+
+
+def test_memo_is_ignored_in_grouping() -> None:
+    rows = [
+        ex(date(2026, 1, 10), memo="A"),
+        ex(date(2026, 2, 10), memo="B"),
+        ex(date(2026, 3, 10), memo=""),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_different_amounts_same_category_are_separate_groups() -> None:
+    rows = [
+        ex(date(2026, 1, 10), amount=1000),
+        ex(date(2026, 2, 10), amount=1000),
+        ex(date(2026, 3, 10), amount=1000),
+        ex(date(2026, 1, 10), amount=500),
+        ex(date(2026, 2, 10), amount=500),
+    ]
+    result = find_recurring(rows)
+    assert [(r.amount, len(r.days)) for r in result] == [(1000, 3)]
+
+
+def test_different_categories_same_amount_are_separate_groups() -> None:
+    rows = [
+        ex(date(2026, 1, 10), category="A"),
+        ex(date(2026, 2, 10), category="A"),
+        ex(date(2026, 3, 10), category="A"),
+        ex(date(2026, 1, 10), category="B"),
+        ex(date(2026, 2, 10), category="B"),
+    ]
+    result = find_recurring(rows)
+    assert [r.category for r in result] == ["A"]
+
+
+def test_duplicate_dates_are_collapsed() -> None:
+    rows = [
+        ex(date(2026, 1, 10)),
+        ex(date(2026, 1, 10)),
+        ex(date(2026, 2, 10)),
+        ex(date(2026, 3, 10)),
+    ]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10))
+
+
+def test_duplicates_do_not_count_toward_min_count() -> None:
+    rows = [ex(date(2026, 1, 10)), ex(date(2026, 1, 10)), ex(date(2026, 2, 10))]
+    assert find_recurring(rows, min_count=3) == []
+
+
+def test_unsorted_input_yields_ascending_days() -> None:
+    rows = [ex(date(2026, 3, 10)), ex(date(2026, 1, 10)), ex(date(2026, 2, 10))]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10))
+
+
+# --- find_recurring: tolerance -----------------------------------------------
+
+
+def test_drift_within_tolerance_is_connected() -> None:
+    # 翌月の同日 2/10 からの差 +2 日は tolerance=3 以内
+    rows = [ex(date(2026, 1, 10)), ex(date(2026, 2, 12)), ex(date(2026, 3, 10))]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 12), date(2026, 3, 10))
+
+
+def test_drift_exactly_at_tolerance_is_connected() -> None:
+    rows = [ex(date(2026, 1, 10)), ex(date(2026, 2, 13)), ex(date(2026, 3, 13))]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_drift_beyond_tolerance_breaks_run() -> None:
+    # 2/14 は 2/10 から +4 日で tolerance=3 を超える → つながらない
+    rows = [ex(date(2026, 1, 10)), ex(date(2026, 2, 14)), ex(date(2026, 3, 14))]
+    assert find_recurring(rows) == []
+
+
+def test_drift_beyond_tolerance_below_is_also_break() -> None:
+    # 2/6 は 2/10 から -4 日
+    rows = [ex(date(2026, 1, 10)), ex(date(2026, 2, 6)), ex(date(2026, 3, 6))]
+    assert find_recurring(rows) == []
+
+
+def test_tolerance_zero_requires_exact_day() -> None:
+    rows = [ex(date(2026, 1, 10)), ex(date(2026, 2, 11)), ex(date(2026, 3, 11))]
+    assert find_recurring(rows, tolerance=0) == []
+
+
+def test_tolerance_zero_exact_match_detected() -> None:
+    rows = [ex(date(2026, 1, 10)), ex(date(2026, 2, 10)), ex(date(2026, 3, 10))]
+    assert len(find_recurring(rows, tolerance=0)) == 1
+
+
+def test_break_splits_run_and_only_long_piece_is_kept() -> None:
+    # 1〜3 月は連続、4 月は 5 月とずれて切れる。4〜5 月の 2 件は min_count=3 未満。
+    rows = [
+        ex(date(2026, 1, 10)),
+        ex(date(2026, 2, 10)),
+        ex(date(2026, 3, 10)),
+        ex(date(2026, 4, 25)),
+        ex(date(2026, 5, 25)),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10))
+    assert result[0].next_expected == date(2026, 4, 10)
+
+
+def test_break_splits_into_two_qualifying_runs() -> None:
+    rows = [
+        ex(date(2026, 1, 10)),
+        ex(date(2026, 2, 10)),
+        ex(date(2026, 3, 10)),
+        ex(date(2026, 4, 25)),
+        ex(date(2026, 5, 25)),
+        ex(date(2026, 6, 25)),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 10), date(2026, 4, 25)]
+
+
+# --- find_recurring: month-end behaviour -------------------------------------
+
+
+def test_month_end_run_connects_via_clamp() -> None:
+    rows = [ex(date(2026, 1, 31)), ex(date(2026, 2, 28)), ex(date(2026, 3, 31))]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 30)
+
+
+def test_leap_year_month_end_run() -> None:
+    rows = [ex(date(2024, 1, 31)), ex(date(2024, 2, 29)), ex(date(2024, 3, 31))]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2024, 4, 30)
+
+
+# --- find_recurring: next_expected and ordering ------------------------------
+
+
+def test_next_expected_crosses_year() -> None:
+    rows = [ex(date(2026, 10, 5)), ex(date(2026, 11, 5)), ex(date(2026, 12, 5))]
+    assert find_recurring(rows)[0].next_expected == date(2027, 1, 5)
+
+
+def test_result_sorted_by_category_then_amount_then_first_day() -> None:
+    rows = [
+        ex(date(2026, 1, 10), category="B", amount=100),
+        ex(date(2026, 2, 10), category="B", amount=100),
+        ex(date(2026, 3, 10), category="B", amount=100),
+        ex(date(2026, 1, 5), category="A", amount=300),
+        ex(date(2026, 2, 5), category="A", amount=300),
+        ex(date(2026, 3, 5), category="A", amount=300),
+        ex(date(2026, 1, 7), category="A", amount=200),
+        ex(date(2026, 2, 7), category="A", amount=200),
+        ex(date(2026, 3, 7), category="A", amount=200),
+    ]
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [
+        ("A", 200),
+        ("A", 300),
+        ("B", 100),
+    ]
+
+
+def test_same_group_two_runs_sorted_by_first_day() -> None:
+    rows = [
+        ex(date(2026, 1, 10)),
+        ex(date(2026, 2, 10)),
+        ex(date(2026, 3, 10)),
+        ex(date(2026, 4, 25)),
+        ex(date(2026, 5, 25)),
+        ex(date(2026, 6, 25)),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 10), date(2026, 4, 25)]
diff --git a/tests/test_split.py b/tests/test_split.py
new file mode 100644
