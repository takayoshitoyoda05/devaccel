@@ -0,0 +1,48 @@
+import json
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.export import to_json
+
+
+def test_empty_list_gives_empty_array():
+    assert to_json([]) == "[]"
+
+
+def test_single_row_fields_and_key_order():
+    out = to_json([Expense(date(2026, 11, 2), "rent", 80000, "11月家賃")])
+    assert out == (
+        '[{"date": "2026-11-02", "category": "rent", "amount": 80000, "memo": "11月家賃"}]'
+    )
+    assert list(json.loads(out)[0]) == ["date", "category", "amount", "memo"]
+
+
+def test_preserves_input_order():
+    rows = [
+        Expense(date(2026, 11, 3), "food", 800, ""),
+        Expense(date(2026, 10, 31), "food", 500, ""),
+    ]
+    dates = [item["date"] for item in json.loads(to_json(rows))]
+    assert dates == ["2026-11-03", "2026-10-31"]
+
+
+def test_non_ascii_is_not_escaped():
+    out = to_json([Expense(date(2026, 11, 1), "食費", 1200, "ランチ")])
+    assert "食費" in out and "ランチ" in out
+    assert "\\u" not in out
+
+
+def test_empty_memo_is_kept_as_empty_string():
+    out = json.loads(to_json([Expense(date(2026, 11, 1), "food", 1, "")]))
+    assert out[0]["memo"] == ""
+
+
+def test_amount_stays_integer():
+    out = json.loads(to_json([Expense(date(2026, 11, 1), "food", 0, "")]))
+    assert out[0]["amount"] == 0
+    assert isinstance(out[0]["amount"], int)
+
+
+def test_no_indentation_or_newlines():
+    out = to_json([Expense(date(2026, 11, 1), "food", 1, "a")])
+    assert "\n" not in out
