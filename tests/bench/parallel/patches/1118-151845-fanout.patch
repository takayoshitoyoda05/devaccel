diff --git a/src/kakeibo/bankimport.py b/src/kakeibo/bankimport.py
new file mode 100644
index 0000000..d6ee426
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,108 @@
+"""Import bank-statement CSV text into Expense records."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"(-?)[¥￥]?([0-9][0-9,]*)円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    """'-' ? '¥'/'￥'? digits-and-commas '円'? を整数にする。それ以外は ValueError。"""
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    sign, digits = m.groups()
+    return int(sign + digits.replace(",", ""))
+
+
+def parse_date(s: str) -> date:
+    """YYYY/M/D または YYYY-M-D(区切りは統一、ASCII 数字のみ)。"""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    year, _, month, day = m.groups()
+    return date(int(year), int(month), int(day))  # ValueError if nonexistent
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """1 行目がヘッダーの CSV 文字列を明細に変換する。
+
+    戻り値は (取り込めた明細, [(行番号, フィールド名)])。行番号は物理行番号(ヘッダーが 1)。
+    """
+    cols = DEFAULT_MAPPING if mapping is None else mapping
+    for key in ("date", "category", "amount"):
+        if key not in cols:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header = next(reader, [])
+    index: dict[str, int] = {}
+    for field, column in cols.items():
+        if field not in ("date", "category", "amount", "memo"):
+            continue
+        if column not in header:
+            raise ValueError(f"CSV に列 {column!r} がありません")
+        index[field] = header.index(column)
+
+    def cell(row: list[str], field: str) -> str:
+        i = index.get(field)
+        if i is None or i >= len(row):
+            return ""
+        return row[i]
+
+    rows: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    prev_end = reader.line_num
+    for record in reader:
+        start = prev_end + 1
+        prev_end = reader.line_num
+        if record == []:
+            continue
+
+        row_errors: list[tuple[int, str]] = []
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(cell(record, "date"))
+        except ValueError:
+            row_errors.append((start, "date"))
+        try:
+            amount = parse_amount(cell(record, "amount"))
+        except ValueError:
+            row_errors.append((start, "amount"))
+        category = cell(record, "category").strip()
+        if category == "":
+            row_errors.append((start, "category"))
+
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        assert day is not None and amount is not None
+        mapped = (category_map or {}).get(category, category)
+        rows.append(
+            Expense(
+                day=day,
+                category=mapped,
+                amount=amount,
+                memo=cell(record, "memo").strip(),
+            )
+        )
+    return rows, errors
diff --git a/src/kakeibo/dupes.py b/src/kakeibo/dupes.py
