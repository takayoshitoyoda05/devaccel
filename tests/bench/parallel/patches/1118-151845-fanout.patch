--- /dev/null
+++ b/src/kakeibo/dupes.py
@@ -0,0 +1,24 @@
+"""Duplicate detection for expense rows."""
+
+from __future__ import annotations
+
+from collections import defaultdict
+
+from kakeibo.core import Expense
+
+
+def find_duplicates(rows: list[Expense]) -> list[tuple[int, int]]:
+    """Index pairs (i, j), i < j, of rows with equal day, category, amount and memo.
+
+    Sorted by i ascending, then j ascending.
+    """
+    groups: dict[tuple[object, ...], list[int]] = defaultdict(list)
+    for idx, row in enumerate(rows):
+        groups[(row.day, row.category, row.amount, row.memo)].append(idx)
+    pairs = [
+        (i, j)
+        for indices in groups.values()
+        for a, i in enumerate(indices)
+        for j in indices[a + 1 :]
+    ]
+    return sorted(pairs)
