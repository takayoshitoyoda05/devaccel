index 0000000..d2ea61e
--- /dev/null
+++ b/tests/test_streak.py
@@ -0,0 +1,68 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.streak import longest_no_spend_streak
+
+
+def _e(day: date, amount: int = 100) -> Expense:
+    return Expense(day, "food", amount)
+
+
+def test_no_rows_counts_whole_period_inclusive():
+    assert longest_no_spend_streak([], date(2026, 11, 1), date(2026, 11, 7)) == 7
+
+
+def test_single_day_period_without_rows_is_one():
+    assert longest_no_spend_streak([], date(2026, 11, 5), date(2026, 11, 5)) == 1
+
+
+def test_single_day_period_with_row_is_zero():
+    rows = [_e(date(2026, 11, 5))]
+    assert longest_no_spend_streak(rows, date(2026, 11, 5), date(2026, 11, 5)) == 0
+
+
+def test_every_day_has_spending_is_zero():
+    start, end = date(2026, 11, 1), date(2026, 11, 3)
+    rows = [_e(date(2026, 11, d)) for d in (1, 2, 3)]
+    assert longest_no_spend_streak(rows, start, end) == 0
+
+
+def test_longest_run_wins_over_earlier_shorter_run():
+    # spend on 3 -> runs: 1..2 (2 days), 4..7 (4 days)
+    rows = [_e(date(2026, 11, 3))]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 7)) == 4
+
+
+def test_spend_on_first_and_last_day_splits_run():
+    rows = [_e(date(2026, 11, 1)), _e(date(2026, 11, 7))]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 7)) == 5
+
+
+def test_both_endpoints_are_included_in_streak():
+    # only day 2 has spending; the run 3..3 is at the end, 1..1 at the start
+    rows = [_e(date(2026, 11, 2))]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 3)) == 1
+
+
+def test_rows_outside_period_are_ignored():
+    rows = [_e(date(2026, 10, 31)), _e(date(2026, 11, 8))]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 7)) == 7
+
+
+def test_multiple_rows_on_same_day_count_once():
+    rows = [_e(date(2026, 11, 4), 100), _e(date(2026, 11, 4), 200)]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 7)) == 3
+
+
+def test_zero_amount_row_still_counts_as_spending_day():
+    rows = [_e(date(2026, 11, 4), 0)]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 7)) == 3
+
+
+def test_unsorted_rows_give_same_result():
+    rows = [_e(date(2026, 11, 6)), _e(date(2026, 11, 2))]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 7)) == 3
+
+
+def test_start_after_end_is_zero():
+    assert longest_no_spend_streak([], date(2026, 11, 7), date(2026, 11, 1)) == 0
diff --git a/tests/test_topn.py b/tests/test_topn.py
new file mode 100644
index 0000000..1d20051
--- /dev/null
+++ b/tests/test_topn.py
@@ -0,0 +1,59 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.topn import top_expenses
+
+
+def _e(day: str, amount: int, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category="食費", amount=amount, memo=memo
+    )
+
+
+def test_returns_largest_amounts_first() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 500), _e("2026-01-03", 300)]
+    assert [e.amount for e in top_expenses(rows, 2)] == [500, 300]
+
+
+def test_n_larger_than_rows_returns_all_sorted() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 500)]
+    assert [e.amount for e in top_expenses(rows, 10)] == [500, 100]
+
+
+def test_n_zero_returns_empty() -> None:
+    assert top_expenses([_e("2026-01-01", 100)], 0) == []
+
+
+def test_negative_n_returns_empty() -> None:
+    assert top_expenses([_e("2026-01-01", 100)], -3) == []
+
+
+def test_empty_input_returns_empty() -> None:
+    assert top_expenses([], 5) == []
+
+
+def test_equal_amounts_ordered_by_earlier_date() -> None:
+    late = _e("2026-03-01", 400, "late")
+    early = _e("2026-01-01", 400, "early")
+    assert top_expenses([late, early], 2) == [early, late]
+
+
+def test_equal_amount_and_date_keeps_input_order() -> None:
+    first = _e("2026-02-01", 400, "first")
+    second = _e("2026-02-01", 400, "second")
+    assert top_expenses([first, second], 2) == [first, second]
+    assert top_expenses([second, first], 2) == [second, first]
+
+
+def test_n_cuts_through_tie_group_by_date_then_input_order() -> None:
+    a = _e("2026-05-01", 900, "a")
+    b = _e("2026-01-01", 900, "b")
+    c = _e("2026-01-01", 900, "c")
+    assert top_expenses([a, b, c], 2) == [b, c]
+
+
+def test_input_list_is_not_mutated() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 500)]
+    snapshot = list(rows)
+    top_expenses(rows, 1)
+    assert rows == snapshot
diff --git a/tests/test_weekday.py b/tests/test_weekday.py
new file mode 100644
index 0000000..1e326c0
--- /dev/null
+++ b/tests/test_weekday.py
@@ -0,0 +1,64 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.weekday import total_by_weekday
+
+
+def _e(day: date, amount: int) -> Expense:
+    return Expense(day=day, category="食費", amount=amount)
+
+
+def test_empty_rows_gives_empty_dict() -> None:
+    assert total_by_weekday([]) == {}
+
+
+def test_single_row_uses_english_three_letter_weekday() -> None:
+    # 2026-11-16 is a Monday
+    assert total_by_weekday([_e(date(2026, 11, 16), 500)]) == {"Mon": 500}
+
+
+def test_same_weekday_rows_are_summed() -> None:
+    rows = [_e(date(2026, 11, 16), 500), _e(date(2026, 11, 23), 300)]
+    assert total_by_weekday(rows) == {"Mon": 800}
+
+
+def test_weekdays_without_rows_are_omitted() -> None:
+    rows = [_e(date(2026, 11, 20), 100), _e(date(2026, 11, 16), 200)]  # Fri, Mon
+    assert total_by_weekday(rows) == {"Mon": 200, "Fri": 100}
+
+
+def test_keys_are_in_monday_first_order_regardless_of_input_order() -> None:
+    rows = [
+        _e(date(2026, 11, 22), 1),  # Sun
+        _e(date(2026, 11, 18), 2),  # Wed
+        _e(date(2026, 11, 16), 3),  # Mon
+        _e(date(2026, 11, 21), 4),  # Sat
+    ]
+    result = total_by_weekday(rows)
+    assert list(result) == ["Mon", "Wed", "Sat", "Sun"]
+    assert result == {"Mon": 3, "Wed": 2, "Sat": 4, "Sun": 1}
+
+
+def test_all_seven_weekdays() -> None:
+    rows = [_e(date(2026, 11, 16 + i), 10 * (i + 1)) for i in range(7)]
+    assert total_by_weekday(rows) == {
+        "Mon": 10,
+        "Tue": 20,
+        "Wed": 30,
+        "Thu": 40,
+        "Fri": 50,
+        "Sat": 60,
+        "Sun": 70,
+    }
+
+
+def test_zero_amount_row_still_counts_as_detail() -> None:
+    # 明細がある曜日は含める(金額が 0 でも明細は存在する)
+    assert total_by_weekday([_e(date(2026, 11, 17), 0)]) == {"Tue": 0}
+
+
+def test_does_not_mutate_input() -> None:
+    rows = [_e(date(2026, 11, 16), 5)]
+    before = list(rows)
+    total_by_weekday(rows)
+    assert rows == before
