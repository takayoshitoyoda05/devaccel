+def test_gap_one_over_tolerance_is_split() -> None:
+    # 3/14 は差 4 日 > tolerance 3 → 切れる。前半 2 件は min_count=3 未満
+    rows = [ex(date(2026, 1, 10)), ex(date(2026, 2, 10)), ex(date(2026, 3, 14))]
+    assert find_recurring(rows, tolerance=3) == []
+
