+def test_early_payment_within_tolerance_is_linked() -> None:
+    # 3/7 は差 -3 日。abs なので早すぎる場合もつながる
+    rows = [ex(date(2026, 1, 10)), ex(date(2026, 2, 10)), ex(date(2026, 3, 7))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
