+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,94 @@
+"""Month-over-month comparison of expenses by category."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(m: object) -> str:
+    if not isinstance(m, str) or not _MONTH_RE.fullmatch(m):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {m!r}")
+    return m
+
+
+def _month_of(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    prev_month = _check_month(prev_month)
+    curr_month = _check_month(curr_month)
+
+    prev_sum: dict[str, int] = {}
+    curr_sum: dict[str, int] = {}
+    prev_seen: set[str] = set()
+    curr_seen: set[str] = set()
+    for e in rows:
+        m = _month_of(e)
+        if m == prev_month:
+            prev_sum[e.category] = prev_sum.get(e.category, 0) + e.amount
+            prev_seen.add(e.category)
+        elif m == curr_month:
+            curr_sum[e.category] = curr_sum.get(e.category, 0) + e.amount
+            curr_seen.add(e.category)
+
+    out: list[DiffRow] = []
+    for cat in prev_seen | curr_seen:
+        prev = prev_sum.get(cat, 0)
+        curr = curr_sum.get(cat, 0)
+        delta = curr - prev
+        pct = None if prev == 0 else round(delta / prev * 100, 1) + 0.0
+        if cat not in prev_seen:
+            status = "new"
+        elif cat not in curr_seen:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+
+    out.sort(key=lambda d: (-abs(d.delta), d.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [d for d in diffs if d.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for d in diffs:
+        pct = "-" if d.pct is None else f"{d.pct + 0.0:+.1f}%"
+        lines.append(f"{d.category}\t{d.prev}\t{d.curr}\t{d.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month_of(e) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には明細のある月が 2 つ以上必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..7c0f772
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,171 @@
+"""Search query language: tokenize, parse and evaluate filters over Expense rows.
+
+Grammar (lowest to highest precedence: OR < AND < NOT):
+    or_expr  := and_expr ("OR" and_expr)*
+    and_expr := not_expr (["AND"] not_expr)*
+    not_expr := "NOT" not_expr | primary
+    primary  := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+
+class QueryError(ValueError):
+    """Raised when a search query is malformed."""
+
+
+_OPERATORS = {"AND", "OR", "NOT"}
+_CAT_PREFIX = "cat:"
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    tokens: list[tuple[str, str]] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        ch = q[i]
+        if ch.isspace():
+            i += 1
+        elif ch == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif ch == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif ch == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError("閉じていない引用符があります")
+            body = q[i + 1 : end]
+            if body == "":
+                raise QueryError("空の引用符は使えません")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            j = i
+            while j < n and not q[j].isspace() and q[j] not in '()"':
+                j += 1
+            word = q[i:j]
+            i = j
+            if word in _OPERATORS:
+                tokens.append((word, word))
+            elif word.startswith(_CAT_PREFIX):
+                cat = word[len(_CAT_PREFIX) :]
+                if cat == "":
+                    raise QueryError("cat: の後ろにカテゴリ名がありません")
+                tokens.append(("CAT", cat))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+@dataclass(frozen=True)
+class _Leaf:
+    kind: str  # "TERM" or "CAT"
+    value: str
+
+
+@dataclass(frozen=True)
+class _Not:
+    operand: _Node
+
+
+@dataclass(frozen=True)
+class _Bin:
+    op: str  # "AND" or "OR"
+    left: _Node
+    right: _Node
+
+
+_Node = _Leaf | _Not | _Bin
+
+
+class _Parser:
+    def __init__(self, tokens: list[tuple[str, str]]) -> None:
+        self.tokens = tokens
+        self.pos = 0
+
+    def _peek(self) -> str | None:
+        return self.tokens[self.pos][0] if self.pos < len(self.tokens) else None
+
+    def parse(self) -> _Node:
+        if not self.tokens:
+            raise QueryError("クエリが空です")
+        node = self._or_expr()
+        if self.pos != len(self.tokens):
+            raise QueryError(f"想定外のトークンです: {self.tokens[self.pos][1]!r}")
+        return node
+
+    def _or_expr(self) -> _Node:
+        node = self._and_expr()
+        while self._peek() == "OR":
+            self.pos += 1
+            node = _Bin("OR", node, self._and_expr())
+        return node
+
+    def _and_expr(self) -> _Node:
+        node = self._not_expr()
+        while True:
+            kind = self._peek()
+            if kind == "AND":
+                self.pos += 1
+                node = _Bin("AND", node, self._not_expr())
+            elif kind in ("TERM", "CAT", "NOT", "LPAREN"):
+                node = _Bin("AND", node, self._not_expr())
+            else:
+                return node
+
+    def _not_expr(self) -> _Node:
+        if self._peek() == "NOT":
+            self.pos += 1
+            return _Not(self._not_expr())
+        return self._primary()
+
+    def _primary(self) -> _Node:
+        kind = self._peek()
+        if kind is None:
+            raise QueryError("演算子の後ろに項がありません")
+        if kind in ("TERM", "CAT"):
+            _, value = self.tokens[self.pos]
+            self.pos += 1
+            return _Leaf(kind, value)
+        if kind == "LPAREN":
+            self.pos += 1
+            node = self._or_expr()
+            if self._peek() != "RPAREN":
+                raise QueryError("括弧が閉じられていません")
+            self.pos += 1
+            return node
+        raise QueryError(f"想定外のトークンです: {self.tokens[self.pos][1]!r}")
+
+
+def _parse(q: str) -> _Node:
+    return _Parser(tokenize(q)).parse()
+
+
+def _eval(node: _Node, e: Expense) -> bool:
+    if isinstance(node, _Leaf):
+        value = node.value.casefold()
+        if node.kind == "CAT":
+            return value == e.category.casefold()
+        return value in e.memo.casefold() or value in e.category.casefold()
+    if isinstance(node, _Not):
+        return not _eval(node.operand, e)
+    if node.op == "AND":
+        return _eval(node.left, e) and _eval(node.right, e)
+    return _eval(node.left, e) or _eval(node.right, e)
+
+
+def matches(q: str, e: Expense) -> bool:
+    """Return True if the query q matches the expense e."""
+    return _eval(_parse(q), e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    """Return the rows matching q, in input order. Raises QueryError even when rows is empty."""
+    node = _parse(q)
+    return [e for e in rows if _eval(node, e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..53ee5eb
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,68 @@
+"""Detect recurring expenses (monthly series). Pure functions, stdlib only."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day in the next month, clamped to that month's last day."""
+    if d.month == 12:
+        year, month = d.year + 1, 1
+    else:
+        year, month = d.year, d.month + 1
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def _runs(days: list[date], tolerance: int) -> list[list[date]]:
+    """Split ascending distinct days into maximal runs of linked neighbours."""
+    runs: list[list[date]] = []
+    run: list[date] = []
+    for d in days:
+        if run and abs((d - add_month(run[-1])).days) > tolerance:
+            runs.append(run)
+            run = []
+        run.append(d)
+    if run:
+        runs.append(run)
+    return runs
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError(f"min_count は 2 以上である必要があります: {min_count}")
+    if tolerance < 0:
+        raise ValueError(f"tolerance は 0 以上である必要があります: {tolerance}")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    out: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        for run in _runs(sorted(day_set), tolerance):
+            if len(run) >= min_count:
+                out.append(
+                    Recurring(
+                        category=category,
+                        amount=amount,
+                        days=tuple(run),
+                        next_expected=add_month(run[-1]),
+                    )
+                )
+    return sorted(out, key=lambda r: (r.category, r.amount, r.days[0]))
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..4ff9568
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,255 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+# --- parse_amount ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "s, expected",
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("-0", 0),
+        ("¥1000", 1000),
+        ("1,,2", 12),  # カンマの位置は検査しない
+        ("-￥5円", -5),
+    ],
+)
+def test_parse_amount_accepts(s, expected):
+    assert parse_amount(s) == expected
+
+
+@pytest.mark.parametrize(
+    "s",
+    [
+        "",
+        "   ",
+        "円",
+        "12.5",
+        "1 200",
+        "--5",
+        "¥-5",
+        "１２３",
+        "-",
+        "¥",
+        "¥円",
+        "1円円",
+        "円5",
+        "5¥",
+        "- ¥5",
+        "¥ 5",
+        ",5",
+        "1,234.5",
+    ],
+)
+def test_parse_amount_rejects(s):
+    with pytest.raises(ValueError):
+        parse_amount(s)
+
+
+# --- parse_date -----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "s, expected",
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        ("2026-1-5", date(2026, 1, 5)),
+        ("2026/12/31", date(2026, 12, 31)),
+        (" 2026/1/5 ", date(2026, 1, 5)),
+    ],
+)
+def test_parse_date_accepts(s, expected):
+    assert parse_date(s) == expected
+
+
+@pytest.mark.parametrize(
+    "s",
+    [
+        "",
+        "2026/1-5",
+        "2026-1/5",
+        "26/1/5",
+        "2026/02/30",
+        "2026/2/29",  # 2026 は平年
+        "2026/13/1",
+        "2026/0/1",
+        "2026/1/",
+        "2026/1/5/",
+        "2026/001/5",
+        "2026/1/005",
+        "２０２６/1/5",
+        "2026.1.5",
+        "20260105",
+    ],
+)
+def test_parse_date_rejects(s):
+    with pytest.raises(ValueError):
+        parse_date(s)
+
+
+def test_parse_date_accepts_leap_day():
+    assert parse_date("2028/2/29") == date(2028, 2, 29)
+
+
+# --- import_rows ----------------------------------------------------------
+
+BANK_HEADER = "利用日,分類,利用金額,利用店名,カード\n"
+
+
+def test_default_mapping_constant():
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_import_basic_default_mapping():
+    text = BANK_HEADER + '2026/1/5,食費,"1,200",コンビニ,VISA\n'
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 1200, "コンビニ")]
+    assert errors == []
+
+
+def test_quoted_comma_in_memo_is_kept():
+    text = BANK_HEADER + '2026-01-05,食費,300,"A店, 本店",VISA\n'
+    rows, _ = import_rows(text)
+    assert rows[0].memo == "A店, 本店"
+
+
+def test_custom_mapping_and_missing_memo_gives_empty_string():
+    text = "day,cat,yen\n2026/1/5,交通,¥250円\n"
+    mapping = {"date": "day", "category": "cat", "amount": "yen"}
+    rows, errors = import_rows(text, mapping)
+    assert rows == [Expense(date(2026, 1, 5), "交通", 250, "")]
+    assert errors == []
+
+
+def test_mapping_missing_required_key_raises():
+    with pytest.raises(ValueError):
+        import_rows(BANK_HEADER, {"date": "利用日", "category": "分類"})
+
+
+def test_mapping_column_absent_from_header_raises():
+    with pytest.raises(ValueError):
+        import_rows(
+            BANK_HEADER, {"date": "無い列", "category": "分類", "amount": "利用金額"}
+        )
+
+
+def test_mapping_memo_column_absent_from_header_raises():
+    mapping = dict(DEFAULT_MAPPING, memo="無い列")
+    with pytest.raises(ValueError):
+        import_rows(BANK_HEADER, mapping)
+
+
+def test_missing_header_raises():
+    with pytest.raises(ValueError):
+        import_rows("")
+
+
+def test_header_only_gives_empty_results():
+    assert import_rows(BANK_HEADER) == ([], [])
+
+
+def test_extra_columns_are_ignored():
+    text = BANK_HEADER + "2026/1/5,食費,100,店,VISA,余分,余分2\n"
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "店")]
+    assert errors == []
+
+
+def test_rows_keep_input_order():
+    text = BANK_HEADER + "2026/1/2,b,2,,\n2026/1/1,a,1,,\n"
+    rows, _ = import_rows(text)
+    assert [r.category for r in rows] == ["b", "a"]
+
+
+def test_error_line_numbers_are_physical_and_blank_lines_are_counted():
+    text = BANK_HEADER + "2026/1/5,食費,100,,\n\nbad,食費,100,,\n2026/1/6,食費,xyz,,\n"
+    rows, errors = import_rows(text)
+    assert errors == [(4, "date"), (5, "amount")]
+    assert [r.day for r in rows] == [date(2026, 1, 5)]
+
+
+def test_multiline_quoted_record_reports_its_starting_line():
+    text = BANK_HEADER + '2026/1/5,食費,100,"改行\nあり",VISA\nbad,食費,100,,\n'
+    rows, errors = import_rows(text)
+    assert errors == [(4, "date")]
+    assert len(rows) == 1
+    assert rows[0].memo == "改行\nあり"
+
+
+def test_all_errors_in_one_row_are_recorded_in_order():
+    text = BANK_HEADER + "bad,,abc,,\n"
+    rows, errors = import_rows(text)
+    assert errors == [(2, "date"), (2, "amount"), (2, "category")]
+    assert rows == []
+
+
+def test_error_row_is_excluded_but_other_rows_kept():
+    text = BANK_HEADER + "2026/1/5,食費,100,,\n2026/1/6,,100,,\n"
+    rows, errors = import_rows(text)
+    assert errors == [(3, "category")]
+    assert len(rows) == 1
+
+
+def test_category_whitespace_only_is_error():
+    text = BANK_HEADER + "2026/1/5,   ,100,,\n"
+    rows, errors = import_rows(text)
+    assert errors == [(2, "category")]
+    assert rows == []
+
+
+def test_short_row_missing_values_become_errors():
+    text = BANK_HEADER + "2026/1/5\n"
+    rows, errors = import_rows(text)
+    assert errors == [(2, "amount"), (2, "category")]
+    assert rows == []
+
+
+def test_short_row_missing_memo_gives_empty_memo():
+    text = BANK_HEADER + "2026/1/5,食費,100\n"
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "")]
+    assert errors == []
+
+
+def test_category_and_memo_are_stripped():
+    text = BANK_HEADER + "2026/1/5,  食費  ,100,  店  ,VISA\n"
+    rows, _ = import_rows(text)
+    assert rows[0].category == "食費"
+    assert rows[0].memo == "店"
+
+
+def test_category_map_replaces_stripped_category():
+    text = BANK_HEADER + "2026/1/5, 外食 ,100,,\n2026/1/6,日用品,200,,\n"
+    rows, _ = import_rows(text, category_map={"外食": "食費"})
+    assert [r.category for r in rows] == ["食費", "日用品"]
+
+
+def test_category_map_does_not_rescue_empty_category():
+    text = BANK_HEADER + "2026/1/5,  ,100,,\n"
+    rows, errors = import_rows(text, category_map={"": "食費"})
+    assert errors == [(2, "category")]
+    assert rows == []
+
+
+def test_amount_with_yen_mark_and_commas():
+    text = BANK_HEADER + '2026/1/5,食費,"-￥1,234円",,\n'
+    rows, _ = import_rows(text)
+    assert rows[0].amount == -1234
+
+
+def test_mapping_none_equals_default_mapping():
+    text = BANK_HEADER + "2026/1/5,食費,100,店,\n"
+    assert import_rows(text, None) == import_rows(text, DEFAULT_MAPPING)
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..6719cb8
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,219 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def _e(y, m, d, category, amount):
+    return Expense(date(y, m, d), category, amount)
+
+
+ROWS = [
+    _e(2026, 10, 1, "food", 1000),
+    _e(2026, 10, 2, "food", 500),
+    _e(2026, 10, 3, "rent", 80000),
+    _e(2026, 10, 4, "fun", 2000),
+    _e(2026, 11, 1, "food", 1800),
+    _e(2026, 11, 2, "rent", 80000),
+    _e(2026, 11, 3, "misc", 300),
+    _e(2026, 9, 30, "old", 999),  # other month, must be ignored
+    _e(2026, 12, 5, "later", 1),  # other month, must be ignored
+]
+
+
+def _by_cat(diffs):
+    return {d.category: d for d in diffs}
+
+
+# --- month_diff: basic values and status -----------------------------------
+
+
+def test_month_diff_values_and_status():
+    diffs = _by_cat(month_diff(ROWS, "2026-10", "2026-11"))
+    assert diffs["food"] == DiffRow("food", 1500, 1800, 300, 20.0, "up")
+    assert diffs["rent"] == DiffRow("rent", 80000, 80000, 0, 0.0, "same")
+    assert diffs["fun"] == DiffRow("fun", 2000, 0, -2000, -100.0, "gone")
+    assert diffs["misc"] == DiffRow("misc", 0, 300, 300, None, "new")
+
+
+def test_month_diff_ignores_other_months_and_absent_categories():
+    cats = {d.category for d in month_diff(ROWS, "2026-10", "2026-11")}
+    assert cats == {"food", "rent", "fun", "misc"}
+
+
+def test_month_diff_down():
+    rows = [_e(2026, 10, 1, "food", 1000), _e(2026, 11, 1, "food", 400)]
+    (d,) = month_diff(rows, "2026-10", "2026-11")
+    assert d == DiffRow("food", 1000, 400, -600, -60.0, "down")
+
+
+def test_month_diff_pct_rounds_to_one_decimal():
+    rows = [_e(2026, 10, 1, "food", 3), _e(2026, 11, 1, "food", 4)]
+    (d,) = month_diff(rows, "2026-10", "2026-11")
+    assert d.pct == round(1 / 3 * 100, 1) == 33.3
+
+
+def test_status_uses_record_presence_not_totals():
+    # prev has records that sum to 0 -> still counts as present, pct is None
+    rows = [
+        _e(2026, 10, 1, "a", 500),
+        _e(2026, 10, 2, "a", -500),
+        _e(2026, 11, 1, "a", 100),
+    ]
+    (d,) = month_diff(rows, "2026-10", "2026-11")
+    assert d == DiffRow("a", 0, 100, 100, None, "up")
+
+
+def test_zero_amount_records_are_same_when_both_present():
+    rows = [_e(2026, 10, 1, "a", 0), _e(2026, 11, 1, "a", 0)]
+    (d,) = month_diff(rows, "2026-10", "2026-11")
+    assert d == DiffRow("a", 0, 0, 0, None, "same")
+
+
+def test_zero_delta_with_negative_prev_has_no_negative_zero_pct():
+    rows = [_e(2026, 10, 1, "a", -5), _e(2026, 11, 1, "a", -5)]
+    (d,) = month_diff(rows, "2026-10", "2026-11")
+    assert d.pct == 0.0
+    assert str(d.pct) == "0.0"
+
+
+def test_month_diff_empty_rows():
+    assert month_diff([], "2026-10", "2026-11") == []
+
+
+# --- month_diff: ordering ---------------------------------------------------
+
+
+def test_month_diff_sorted_by_abs_delta_desc_then_category_asc():
+    rows = [
+        _e(2026, 10, 1, "b", 1000),  # delta -1000
+        _e(2026, 11, 1, "a", 1000),  # a: new, delta +1000 (tie with b)
+        _e(2026, 11, 1, "c", 5000),  # delta +5000
+        _e(2026, 10, 1, "d", 100),
+        _e(2026, 11, 1, "d", 100),  # delta 0
+    ]
+    cats = [d.category for d in month_diff(rows, "2026-10", "2026-11")]
+    assert cats == ["c", "a", "b", "d"]
+
+
+# --- month_diff: validation -------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        "2026-1",
+        "2026-13",
+        "2026-00",
+        "2026/11",
+        "202611",
+        "2026-11\n",
+        "２０２６-11",
+        "",
+        None,
+        202611,
+    ],
+)
+def test_month_diff_rejects_bad_month(bad):
+    with pytest.raises(ValueError):
+        month_diff(ROWS, bad, "2026-11")
+    with pytest.raises(ValueError):
+        month_diff(ROWS, "2026-10", bad)
+
+
+# --- top_movers -------------------------------------------------------------
+
+
+def _diffs():
+    return month_diff(ROWS, "2026-10", "2026-11")
+
+
+def test_top_movers_excludes_same_and_keeps_order():
+    movers = top_movers(_diffs(), n=10)
+    assert [d.category for d in movers] == ["fun", "food", "misc"]
+    assert all(d.status != "same" for d in movers)
+
+
+def test_top_movers_default_n_is_three_and_truncates():
+    rows = [_e(2026, 10, 1, f"c{i}", 0) for i in range(5)]
+    rows += [_e(2026, 11, 1, f"c{i}", (i + 1) * 100) for i in range(5)]
+    movers = top_movers(month_diff(rows, "2026-10", "2026-11"))
+    assert [d.category for d in movers] == ["c4", "c3", "c2"]
+
+
+def test_top_movers_zero_and_large_n():
+    diffs = _diffs()
+    assert top_movers(diffs, n=0) == []
+    assert top_movers(diffs, n=100) == [d for d in diffs if d.status != "same"]
+
+
+def test_top_movers_negative_n_raises():
+    with pytest.raises(ValueError):
+        top_movers(_diffs(), n=-1)
+
+
+def test_top_movers_empty():
+    assert top_movers([]) == []
+
+
+# --- render_diff ------------------------------------------------------------
+
+
+def test_render_diff_format():
+    text = render_diff(_diffs())
+    assert text == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "fun\t2000\t0\t-2000\t-100.0%\n"
+        "food\t1500\t1800\t+300\t+20.0%\n"
+        "misc\t0\t300\t+300\t-\n"
+        "rent\t80000\t80000\t+0\t+0.0%"
+    )
+
+
+def test_render_diff_no_trailing_newline_and_header_only_when_empty():
+    assert not render_diff(_diffs()).endswith("\n")
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_render_diff_down_sign_and_pct_formats():
+    row = DiffRow("x", 1000, 400, -600, -60.0, "down")
+    assert render_diff([row]).splitlines()[1] == "x\t1000\t400\t-600\t-60.0%"
+
+
+# --- available_months -------------------------------------------------------
+
+
+def test_available_months_sorted_unique():
+    assert available_months(ROWS) == ["2026-09", "2026-10", "2026-11", "2026-12"]
+
+
+def test_available_months_empty():
+    assert available_months([]) == []
+
+
+# --- latest_diff ------------------------------------------------------------
+
+
+def test_latest_diff_uses_last_two_months():
+    assert latest_diff(ROWS) == month_diff(ROWS, "2026-11", "2026-12")
+
+
+def test_latest_diff_uses_last_two_of_three():
+    rows = [_e(2026, 1, 1, "a", 1), _e(2026, 2, 1, "a", 2), _e(2026, 3, 1, "a", 4)]
+    assert latest_diff(rows) == month_diff(rows, "2026-02", "2026-03")
+
+
+def test_latest_diff_needs_two_months():
+    with pytest.raises(ValueError):
+        latest_diff([])
+    with pytest.raises(ValueError):
+        latest_diff([_e(2026, 11, 1, "a", 1), _e(2026, 11, 2, "a", 2)])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..08ef14a
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,251 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+FOOD = Expense(date(2026, 11, 1), "food", 1200, "Lunch with Ann")
+RENT = Expense(date(2026, 11, 2), "rent", 80000, "")
+BOOK = Expense(date(2026, 11, 3), "Books", 1500, "stationery and pens")
+
+
+# --- tokenize -------------------------------------------------------------
+
+
+def test_tokenize_skips_whitespace_and_yields_nothing_for_blank():
+    assert tokenize("   \t ") == []
+    assert tokenize("") == []
+
+
+def test_tokenize_parens_and_plain_words():
+    assert tokenize("(food)") == [("LPAREN", "("), ("TERM", "food"), ("RPAREN", ")")]
+
+
+def test_tokenize_word_stops_at_paren_and_quote():
+    assert tokenize('ab(cd)"ef"') == [
+        ("TERM", "ab"),
+        ("LPAREN", "("),
+        ("TERM", "cd"),
+        ("RPAREN", ")"),
+        ("TERM", "ef"),
+    ]
+
+
+def test_tokenize_quoted_term_keeps_spaces_and_parens():
+    assert tokenize('"a (b) c"') == [("TERM", "a (b) c")]
+
+
+def test_tokenize_quoted_and_keyword_is_term():
+    assert tokenize('"AND"') == [("TERM", "AND")]
+
+
+def test_tokenize_operators_only_when_uppercase_exact():
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+    assert tokenize("and or not") == [
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_operator_word_must_be_whole_word():
+    assert tokenize("ANDx") == [("TERM", "ANDx")]
+
+
+def test_tokenize_cat_prefix():
+    assert tokenize("cat:food") == [("CAT", "food")]
+    assert tokenize("cat:AND") == [("CAT", "AND")]
+
+
+def test_tokenize_cat_prefix_is_case_sensitive():
+    assert tokenize("CAT:food") == [("TERM", "CAT:food")]
+
+
+def test_tokenize_empty_cat_value_is_error():
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+    with pytest.raises(QueryError):
+        tokenize("cat: x")
+
+
+def test_tokenize_unclosed_quote_is_error():
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_is_error():
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+# --- parsing errors -------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(",
+        ")",
+        "(a",
+        "a)",
+        "(a))",
+        "a OR",
+        "OR a",
+        "a AND",
+        "AND a",
+        "a AND AND b",
+        "a OR OR b",
+        "a OR AND b",
+        "NOT",
+        "a NOT",
+        "(a OR)",
+    ],
+)
+def test_malformed_queries_raise(q):
+    with pytest.raises(QueryError):
+        filter_rows(q, [FOOD])
+
+
+def test_malformed_query_raises_even_with_no_rows():
+    with pytest.raises(QueryError):
+        filter_rows("a AND", [])
+
+
+def test_query_error_is_value_error():
+    assert issubclass(QueryError, ValueError)
+
+
+# --- evaluation -----------------------------------------------------------
+
+
+def test_term_matches_memo_substring():
+    assert matches("ann", FOOD)
+
+
+def test_term_matches_category_substring():
+    assert matches("foo", FOOD)
+
+
+def test_term_is_case_insensitive():
+    assert matches("LUNCH", FOOD)
+    assert matches("books", BOOK)
+    assert matches("BOOKS", BOOK)
+
+
+def test_term_does_not_match_when_absent():
+    assert not matches("train", FOOD)
+
+
+def test_term_empty_memo_only_matches_category():
+    assert matches("rent", RENT)
+    assert not matches("x", RENT)
+
+
+def test_term_with_spaces_matches_substring_of_memo():
+    assert matches('"with ann"', FOOD)
+
+
+def test_cat_requires_full_category_match():
+    assert matches("cat:food", FOOD)
+    assert not matches("cat:foo", FOOD)
+    assert not matches("cat:lunch", FOOD)  # memo text does not count for CAT
+
+
+def test_cat_is_case_insensitive():
+    assert matches("cat:BOOKS", BOOK)
+    assert matches("cat:books", BOOK)
+
+
+def test_cat_does_not_match_memo_only_term():
+    assert not matches("cat:Ann", FOOD)
+
+
+def test_bare_terms_are_and_ed():
+    assert matches("lunch ann", FOOD)
+    assert not matches("lunch rent", FOOD)
+
+
+def test_explicit_and_same_as_implicit():
+    assert matches("lunch AND ann", FOOD)
+    assert not matches("lunch AND rent", FOOD)
+
+
+def test_or_has_lower_precedence_than_and():
+    # food AND rent OR ann  ==  (food AND rent) OR ann
+    assert matches("food AND rent OR ann", FOOD)
+    assert not matches("food AND rent OR zzz", FOOD)
+
+
+def test_and_binds_tighter_than_or_with_implicit_and():
+    assert matches("zzz OR food ann", FOOD)  # zzz OR (food AND ann)
+    assert not matches("zzz OR food rent", FOOD)
+
+
+def test_not_binds_tighter_than_and():
+    # NOT rent AND food == (NOT rent) AND food
+    assert matches("NOT rent AND food", FOOD)
+    assert not matches("NOT food AND food", FOOD)
+
+
+def test_not_binds_tighter_than_or():
+    # NOT food OR ann == (NOT food) OR ann
+    assert matches("NOT food OR ann", FOOD)
+    assert not matches("NOT food OR zzz", FOOD)
+
+
+def test_double_not():
+    assert matches("NOT NOT food", FOOD)
+
+
+def test_parens_override_precedence():
+    assert not matches("(zzz OR food) rent", FOOD)
+    assert matches("zzz OR (food rent)", FOOD) is False
+    assert matches("zzz OR (rent cat:rent)", RENT) is True
+
+
+def test_not_with_parens():
+    assert matches("NOT (rent OR books)", FOOD)
+    assert not matches("NOT (food OR rent)", FOOD)
+
+
+def test_quoted_keyword_is_plain_term():
+    assert not matches('"AND"', FOOD)
+    assert matches('"ann"', FOOD)
+
+
+def test_lowercase_and_is_a_term_not_operator():
+    # "and" is a TERM, so the memo must contain it
+    assert not matches("lunch and ann", FOOD)
+    assert matches("lunch and ann", Expense(FOOD.day, "food", 1, "lunch and ann"))
+
+
+def test_empty_quoted_term_is_error_not_matching_everything():
+    with pytest.raises(QueryError):
+        matches('""', FOOD)
+
+
+# --- filter_rows ----------------------------------------------------------
+
+
+def test_filter_rows_keeps_input_order():
+    rows = [BOOK, RENT, FOOD]
+    assert filter_rows("cat:food OR cat:books OR cat:rent", rows) == [BOOK, RENT, FOOD]
+    assert filter_rows("e", rows) == [BOOK, RENT]
+
+
+def test_filter_rows_empty_result():
+    assert filter_rows("zzz", [FOOD, RENT]) == []
+
+
+def test_filter_rows_empty_input_with_valid_query():
+    assert filter_rows("food", []) == []
+
+
+def test_filter_rows_does_not_mutate_input():
+    rows = [FOOD, RENT]
+    filter_rows("rent", rows)
+    assert rows == [FOOD, RENT]
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..2885a1d
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,325 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def ex(
+    day: date, category: str = "通信", amount: int = 1000, memo: str = ""
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- add_month -------------------------------------------------------------
+
+
+def test_add_month_plain() -> None:
+    assert add_month(date(2026, 3, 10)) == date(2026, 4, 10)
+
+
+def test_add_month_clamps_to_end_of_non_leap_february() -> None:
+    assert add_month(date(2026, 1, 31)) == date(2026, 2, 28)
+
+
+def test_add_month_clamps_to_end_of_leap_february() -> None:
+    assert add_month(date(2024, 1, 31)) == date(2024, 2, 29)
+
+
+def test_add_month_clamps_to_30_day_month() -> None:
+    assert add_month(date(2026, 3, 31)) == date(2026, 4, 30)
+
+
+def test_add_month_rolls_over_year() -> None:
+    assert add_month(date(2026, 12, 15)) == date(2027, 1, 15)
+
+
+def test_add_month_rolls_over_year_with_clamp() -> None:
+    assert add_month(date(2026, 12, 31)) == date(2027, 1, 31)
+
+
+# --- Recurring dataclass ---------------------------------------------------
+
+
+def test_recurring_fields_in_order() -> None:
+    r = Recurring("通信", 1000, (date(2026, 1, 10),), date(2026, 2, 10))
+    assert r.category == "通信"
+    assert r.amount == 1000
+    assert r.days == (date(2026, 1, 10),)
+    assert r.next_expected == date(2026, 2, 10)
+
+
+def test_recurring_is_frozen() -> None:
+    r = Recurring("通信", 1000, (date(2026, 1, 10),), date(2026, 2, 10))
+    with pytest.raises(AttributeError):
+        r.amount = 5  # type: ignore[misc]
+
+
+# --- find_recurring: argument validation ------------------------------------
+
+
+def test_min_count_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+
+
+def test_negative_tolerance_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_min_count_validation_applies_even_with_rows() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([ex(date(2026, 1, 10))], min_count=0)
+
+
+# --- find_recurring: basic behaviour ----------------------------------------
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+def test_three_monthly_payments_detected() -> None:
+    rows = [ex(date(2026, 1, 10)), ex(date(2026, 2, 10)), ex(date(2026, 3, 10))]
+    assert find_recurring(rows) == [
+        Recurring(
+            "通信",
+            1000,
+            (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10)),
+            date(2026, 4, 10),
+        )
+    ]
+
+
+def test_two_payments_not_enough_with_default_min_count() -> None:
+    rows = [ex(date(2026, 1, 10)), ex(date(2026, 2, 10))]
+    assert find_recurring(rows) == []
+
+
