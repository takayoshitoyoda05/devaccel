+def test_gap_exactly_tolerance_is_linked() -> None:
+    # 2/10 の翌月同日は 3/10。3/13 は差 3 日 = tolerance 3 なのでつながる
+    rows = [ex(date(2026, 1, 10)), ex(date(2026, 2, 10)), ex(date(2026, 3, 13))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
