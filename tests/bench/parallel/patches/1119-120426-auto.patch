@@ -0,0 +1,91 @@
+"""Detect recurring expenses (pure functions, no I/O)."""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from collections import Counter
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo_key: str
+    amount: int  # amount of the latest (max date) record in the series
+    count: int  # length of the last consecutive-month run
+    last_day: date
+    next_day: date
+
+
+_TRAILING_DIGITS_RE = re.compile(r"[0-9]+$")
+_WHITESPACE_RE = re.compile(r"\s+")
+
+
+def _normalize_memo(memo: str) -> str:
+    """NFKC -> lowercase -> remove whitespace -> remove trailing digits."""
+    s = unicodedata.normalize("NFKC", memo).lower()
+    s = _WHITESPACE_RE.sub("", s)
+    return _TRAILING_DIGITS_RE.sub("", s)
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + (d.month - 1)
+
+
+def detect_recurring(rows: list[Expense], min_count: int = 3) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError("min_count は 2 以上である必要があります")
+
+    series: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        if e.amount <= 0:  # D2: refunds are excluded
+            continue
+        series.setdefault((e.category, _normalize_memo(e.memo)), []).append(e)
+
+    out: list[Recurring] = []
+    for (category, memo_key), items in series.items():
+        # R1: one record per month -- the earliest day in that month.
+        first_by_month: dict[int, Expense] = {}
+        for e in sorted(items, key=lambda x: x.day):
+            first_by_month.setdefault(_month_index(e.day), e)
+        months = sorted(first_by_month)
+
+        # R2: only the last run of consecutive months is considered.
+        start = len(months) - 1
+        while start > 0 and months[start - 1] == months[start] - 1:
+            start -= 1
+        run = months[start:]
+        if len(run) < min_count:
+            continue
+
+        counted = [first_by_month[m] for m in run]
+        last = counted[-1]
+
+        # R3: mode of the counted days (ties -> larger), clipped to next month's end.
+        day_counts = Counter(e.day.day for e in counted)
+        mode_day = max(day_counts, key=lambda d: (day_counts[d], d))
+        y, rem = divmod(run[-1] + 1, 12)
+        month = rem + 1
+        last_dom = calendar.monthrange(y, month)[1]
+        next_day = date(y, month, min(mode_day, last_dom))
+
+        latest = max(items, key=lambda e: (e.day, e.amount))
+        out.append(
+            Recurring(
+                category=category,
+                memo_key=memo_key,
+                amount=latest.amount,
+                count=len(run),
+                last_day=last.day,
+                next_day=next_day,
+            )
+        )
+
+    # R4: next_day asc, amount desc, category asc, memo_key asc.
+    out.sort(key=lambda r: (r.next_day, -r.amount, r.category, r.memo_key))
+    return out
