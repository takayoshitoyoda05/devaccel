+from datetime import date
+
+import pytest
+
+from kakeibo.bankcsv import ImportResult, RowError, import_bank_csv
+from kakeibo.core import Expense
+
+
+def _amount(s: str) -> int:
+    return int(s.replace(",", ""))
+
+
+# --- 例の表 (E3-1 〜 E3-3) ---
+
+
+def test_e3_1_header_aliases_amount_with_commas_and_default_category() -> None:
+    """E3-1: ヘッダー 利用日,ご利用店名,利用金額 / R2,R3,R4"""
+    text = '利用日,ご利用店名,利用金額\n2026/1/5,店,"1,200"\n'
+    result = import_bank_csv(text, _amount)
+    assert result == ImportResult([Expense(date(2026, 1, 5), "未分類", 1200, "店")], [])
+
+
+def test_e3_2_invalid_date_reported_and_other_rows_kept() -> None:
+    """E3-2: 日付が 2026/2/30 の行(3 行目) / R3,R8"""
+    text = (
+        "利用日,ご利用店名,利用金額\n2026/1/4,a,100\n2026/2/30,b,200\n2026/1/6,c,300\n"
+    )
+    result = import_bank_csv(text, _amount)
+    assert result.expenses == [
+        Expense(date(2026, 1, 4), "未分類", 100, "a"),
+        Expense(date(2026, 1, 6), "未分類", 300, "c"),
+    ]
+    assert len(result.errors) == 1
+    err = result.errors[0]
+    assert (err.line, err.column, err.value) == (3, "利用日", "2026/2/30")
+    assert err.reason
+
+
+def test_e3_3_deposit_only_row_is_skipped_silently() -> None:
+    """E3-3: 日付,出金額,入金額 で入金だけの行 / R7"""
+    text = "日付,出金額,入金額\n2026-01-05,,5000\n"
+    assert import_bank_csv(text, _amount) == ImportResult([], [])
+
+
+# --- 入力形式 (R1) ---
+
+
+def test_bom_is_removed_before_header_lookup() -> None:
+    text = "﻿日付,金額\n2026-01-05,100\n"
+    assert import_bank_csv(text, _amount).expenses == [
+        Expense(date(2026, 1, 5), "未分類", 100, "")
+    ]
+
+
+def test_tab_delimiter_when_header_has_tab_and_no_comma() -> None:
+    text = "日付\t金額\t摘要\n2026-01-05\t100\t店\n"
+    assert import_bank_csv(text, _amount).expenses == [
+        Expense(date(2026, 1, 5), "未分類", 100, "店")
+    ]
+
+
+def test_comma_wins_when_header_has_both_tab_and_comma() -> None:
+    text = "日付,金額,\t摘要\n2026-01-05,100,店\n"
+    assert import_bank_csv(text, _amount).expenses == [
+        Expense(date(2026, 1, 5), "未分類", 100, "店")
+    ]
+
+
+def test_quoted_newline_in_memo_keeps_record_and_line_numbers() -> None:
+    text = '日付,金額,摘要\n2026-01-05,100,"a\nb"\n2026-01-06,x,店\n'
+    result = import_bank_csv(text, _amount)
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "a\nb")]
+    assert [(e.line, e.column) for e in result.errors] == [(4, "金額")]
+
+
+# --- ヘッダー (R2) ---
+
+
+@pytest.mark.parametrize("header", ["  Date  ", "取引日", "ご利用日", "利用日"])
+def test_date_header_aliases(header: str) -> None:
+    text = f"{header},金額\n2026-01-05,100\n"
+    assert import_bank_csv(text, _amount).expenses[0].day == date(2026, 1, 5)
+
+
+@pytest.mark.parametrize(
+    "header", ["金額", "利用金額", "ご利用金額", "出金額", "支払", "お支払金額"]
+)
+def test_amount_header_aliases(header: str) -> None:
+    text = f"日付,{header}\n2026-01-05,100\n"
+    assert import_bank_csv(text, _amount).expenses[0].amount == 100
+
+
+@pytest.mark.parametrize(
+    "header", ["摘要", "メモ", "ご利用店名", "description", "内容"]
+)
+def test_memo_header_aliases(header: str) -> None:
+    text = f"日付,金額,{header}\n2026-01-05,100,店\n"
+    assert import_bank_csv(text, _amount).expenses[0].memo == "店"
+
+
+def test_category_header_alias_and_blank_category_becomes_uncategorized() -> None:
+    text = "日付,金額,分類\n2026-01-05,100,食費\n2026-01-06,200,  \n"
+    result = import_bank_csv(text, _amount)
+    assert [e.category for e in result.expenses] == ["食費", "未分類"]
+
+
+def test_missing_memo_column_gives_empty_memo() -> None:
+    text = "日付,金額\n2026-01-05,100\n"
+    assert import_bank_csv(text, _amount).expenses[0].memo == ""
+
+
+def test_missing_date_column_raises_naming_it() -> None:
+    with pytest.raises(ValueError, match="日付"):
+        import_bank_csv("金額,摘要\n100,店\n", _amount)
+
+
+def test_missing_amount_column_raises_naming_it() -> None:
+    with pytest.raises(ValueError, match="金額"):
+        import_bank_csv("日付,入金額\n2026-01-05,100\n", _amount)
+
+
+@pytest.mark.parametrize("text", ["", "   \n\t\n"])
+def test_empty_or_blank_input_raises(text: str) -> None:
+    with pytest.raises(ValueError):
+        import_bank_csv(text, _amount)
+
+
+def test_header_only_returns_empty_result() -> None:
+    assert import_bank_csv("日付,金額\n", _amount) == ImportResult([], [])
+
+
+# --- 日付 (R3) ---
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-01-05",
+        "2026/01/05",
+        "2026/1/5",
+        "2026.1.5",
+        "2026年1月5日",
+        "２０２６/１/５",
+        "2026-01-05 10:30",
+        "2026/1/5 9:00:00",
+        "2026-01-05T10:30:00",
+    ],
+)
+def test_accepted_date_formats(raw: str) -> None:
+    result = import_bank_csv(f"日付,金額\n{raw},100\n", _amount)
+    assert result.errors == []
+    assert result.expenses[0].day == date(2026, 1, 5)
+
+
+@pytest.mark.parametrize(
+    "raw", ["2026-1-5", "2026/01-05", "2026.01/05", "2026/02/30", "not a date"]
+)
+def test_rejected_date_formats_are_row_errors(raw: str) -> None:
+    result = import_bank_csv(f"日付,金額\n{raw},100\n", _amount)
+    assert result.expenses == []
+    assert [(e.line, e.column, e.value) for e in result.errors] == [(2, "日付", raw)]
+
+
+def test_empty_date_is_row_error() -> None:
+    result = import_bank_csv("日付,金額\n,100\n", _amount)
+    assert [(e.line, e.column, e.value) for e in result.errors] == [(2, "日付", "")]
+    assert result.expenses == []
+
+
+# --- 金額・返金・入金 (R7, R8, D3) ---
+
+
+def test_negative_amount_refund_is_kept_as_negative() -> None:
+    text = "日付,金額\n2026-01-05,-500\n"
+    assert import_bank_csv(text, _amount).expenses[0].amount == -500
+
+
+def test_deposit_row_with_amount_present_is_not_skipped() -> None:
+    text = "日付,出金額,入金額\n2026-01-05,100,\n"
+    assert import_bank_csv(text, _amount).expenses[0].amount == 100
+
+
+def test_both_amount_and_deposit_empty_is_amount_error() -> None:
+    text = "日付,出金額,入金額\n2026-01-05,,\n"
+    result = import_bank_csv(text, _amount)
+    assert result.expenses == []
+    assert [(e.column, e.value) for e in result.errors] == [("出金額", "")]
+
+
+def test_unparseable_amount_from_parser_is_row_error() -> None:
+    result = import_bank_csv("日付,金額\n2026-01-05,abc\n", _amount)
+    assert result.expenses == []
+    assert [(e.line, e.column, e.value) for e in result.errors] == [(2, "金額", "abc")]
+
+
+def test_all_errors_in_one_row_are_reported_and_row_dropped() -> None:
+    result = import_bank_csv("日付,金額\n2026-02-30,abc\n2026-01-05,1\n", _amount)
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 1, "")]
+    assert [(e.line, e.column) for e in result.errors] == [(2, "日付"), (2, "金額")]
+
+
+# --- 空行・列数 (R6) と行順 (R9) ---
+
+
+def test_blank_rows_are_skipped_silently() -> None:
+    text = "日付,金額\n\n,\n2026-01-05,100\n"
+    assert import_bank_csv(text, _amount) == ImportResult(
+        [Expense(date(2026, 1, 5), "未分類", 100, "")], []
+    )
+
+
+def test_wrong_column_count_reports_raw_line() -> None:
+    text = "日付,金額\n2026-01-05,100,extra\n"
+    result = import_bank_csv(text, _amount)
+    assert result == ImportResult(
+        [], [RowError(2, "", "2026-01-05,100,extra", "列数が違います")]
+    )
+
+
+def test_expense_order_follows_input_rows() -> None:
+    text = "日付,金額\n2026-03-01,3\n2026-01-01,1\n2026-02-01,2\n"
+    assert [e.amount for e in import_bank_csv(text, _amount).expenses] == [3, 1, 2]
+
+
+def test_parser_is_injected_and_used_for_amounts() -> None:
+    seen: list[str] = []
+
+    def spy(s: str) -> int:
+        seen.append(s)
+        return 7
+
+    result = import_bank_csv("日付,金額\n2026-01-05,xyz\n", spy)
+    assert seen == ["xyz"]
+    assert result.expenses[0].amount == 7
