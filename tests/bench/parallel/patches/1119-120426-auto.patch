diff --git a/tests/test_monthly_diff.py b/tests/test_monthly_diff.py
new file mode 100644
index 0000000..1833743
--- /dev/null
+++ b/tests/test_monthly_diff.py
@@ -0,0 +1,182 @@
+"""Tests for monthly_diff.compare_months."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthly_diff import CategoryDiff, compare_months
+
+
+def _e(day: str, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+def _find(diffs: list[CategoryDiff], category: str) -> CategoryDiff:
+    matches = [d for d in diffs if d.category == category]
+    assert len(matches) == 1, f"{category} の行が {len(matches)} 件"
+    return matches[0]
+
+
+# --- 表の全行 (E5-*) ---------------------------------------------------------
+
+
+@pytest.mark.parametrize("case_id", ["E5-1"])
+def test_E5_1_food_increase_ratio_and_trend(case_id: str) -> None:
+    # R3, R4: 食費 前月 30000 → 今月 36000
+    rows = [
+        _e("2027-01-05", "食費", 30000),
+        _e("2027-02-05", "食費", 36000),
+    ]
+    diffs = compare_months(rows, "2027-02", "2027-01")
+    d = _find(diffs, "食費")
+    assert d.previous == 30000
+    assert d.current == 36000
+    assert d.delta == 6000
+    assert d.ratio == pytest.approx(0.2)
+    assert d.trend == "増"
+
+
+@pytest.mark.parametrize("case_id", ["E5-2"])
+def test_E5_2_category_only_this_month(case_id: str) -> None:
+    # R2, D6: 交通費 今月だけ 5000 → 前月 0 扱い, ratio None
+    rows = [_e("2027-02-10", "交通費", 5000)]
+    diffs = compare_months(rows, "2027-02", "2027-01")
+    d = _find(diffs, "交通費")
+    assert d.previous == 0
+    assert d.current == 5000
+    assert d.delta == 5000
+    assert d.ratio is None
+    assert d.trend == "増"
+
+
+@pytest.mark.parametrize("case_id", ["E5-3"])
+def test_E5_3_prev_none_defaults_to_previous_calendar_month(case_id: str) -> None:
+    # R1: month="2027-01", prev=None → 2026-12 と比べる
+    rows = [
+        _e("2026-12-03", "食費", 1000),
+        _e("2027-01-03", "食費", 2000),
+        _e("2027-02-03", "食費", 9999),  # 対象外
+    ]
+    diffs = compare_months(rows, "2027-01", None)
+    d = _find(diffs, "食費")
+    assert d.previous == 1000
+    assert d.current == 2000
+    assert d.delta == 1000
+    assert d.ratio == pytest.approx(1.0)
+
+
+# --- 端のケース (仕様の文面から) ---------------------------------------------
+
+
+def test_prev_none_in_january_uses_previous_december_of_prior_year() -> None:
+    rows = [_e("2026-12-31", "食費", 700), _e("2027-01-01", "食費", 700)]
+    d = _find(compare_months(rows, "2027-01"), "食費")
+    assert d.previous == 700
+    assert d.delta == 0
+    assert d.trend == "変化なし"
+
+
+@pytest.mark.parametrize(
+    "month, prev",
+    [
+        ("2027-1", "2026-12"),
+        ("2027-13", "2027-12"),
+        ("2027/01", "2026-12"),
+        ("27-01", "2026-12"),
+        ("2027-00", "2026-12"),
+        ("2027-01", "2026-1"),
+        ("2027-01", "abcd-ef"),
+    ],
+)
+def test_invalid_month_format_raises(month: str, prev: str) -> None:
+    with pytest.raises(ValueError):
+        compare_months([], month, prev)
+
+
+def test_invalid_prev_none_month_raises() -> None:
+    with pytest.raises(ValueError):
+        compare_months([], "2027-13", None)
+
+
+def test_both_months_empty_returns_empty_list() -> None:
+    # R6
+    assert compare_months([], "2027-02", "2027-01") == []
+
+
+def test_category_only_in_previous_month_is_decrease_to_zero() -> None:
+    # R2, R3, R4: 前月だけにある → current 0, delta 負, ratio -1.0
+    rows = [_e("2027-01-10", "娯楽", 4000)]
+    d = _find(compare_months(rows, "2027-02", "2027-01"), "娯楽")
+    assert d.previous == 4000
+    assert d.current == 0
+    assert d.delta == -4000
+    assert d.ratio == pytest.approx(-1.0)
+    assert d.trend == "減"
+
+
+def test_category_absent_in_both_months_is_omitted() -> None:
+    # R2: どちらの月にも明細がないカテゴリは出さない
+    rows = [_e("2026-06-01", "医療", 100), _e("2027-02-01", "食費", 100)]
+    cats = {d.category for d in compare_months(rows, "2027-02", "2027-01")}
+    assert "医療" not in cats
+    assert "食費" in cats
+
+
+def test_refund_negative_amounts_are_summed() -> None:
+    # R2: 返金の負数も単純合計に含む
+    rows = [
+        _e("2027-01-01", "食費", 5000),
+        _e("2027-02-01", "食費", 3000),
+        _e("2027-02-02", "食費", -1000),
+    ]
+    d = _find(compare_months(rows, "2027-02", "2027-01"), "食費")
+    assert d.current == 2000
+    assert d.delta == -3000
+    assert d.trend == "減"
+
+
+def test_negative_previous_uses_abs_for_ratio() -> None:
+    # R3: previous が負のとき delta / abs(previous)
+    rows = [
+        _e("2027-01-01", "雑費", -1000),
+        _e("2027-02-01", "雑費", 500),
+    ]
+    d = _find(compare_months(rows, "2027-02", "2027-01"), "雑費")
+    assert d.previous == -1000
+    assert d.current == 500
+    assert d.delta == 1500
+    assert d.ratio == pytest.approx(1.5)
+    assert d.trend == "増"
+
+
+def test_no_change_trend_and_zero_ratio() -> None:
+    # R4
+    rows = [_e("2027-01-01", "食費", 800), _e("2027-02-01", "食費", 800)]
+    d = _find(compare_months(rows, "2027-02", "2027-01"), "食費")
+    assert d.delta == 0
+    assert d.ratio == pytest.approx(0.0)
+    assert d.trend == "変化なし"
+
+
+def test_sorted_by_abs_delta_desc_then_category_asc() -> None:
+    # R5
+    rows = [
+        _e("2027-01-01", "B", 1000),
+        _e("2027-02-01", "B", 1000),  # delta 0
+        _e("2027-02-01", "C", 3000),  # delta +3000
+        _e("2027-02-01", "A", 3000),  # delta +3000 (同じ abs → カテゴリ昇順で A が先)
+        _e("2027-01-01", "D", 5000),  # delta -5000 (abs 最大)
+    ]
+    cats = [d.category for d in compare_months(rows, "2027-02", "2027-01")]
+    assert cats == ["D", "A", "C", "B"]
+
+
+def test_returns_category_diff_instances() -> None:
+    rows = [_e("2027-02-01", "食費", 100)]
+    diffs = compare_months(rows, "2027-02", "2027-01")
+    assert all(isinstance(d, CategoryDiff) for d in diffs)
