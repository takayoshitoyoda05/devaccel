+++ b/tests/test_search.py
@@ -0,0 +1,185 @@
+"""Tests for kakeibo.search (condition-based expense search)."""
+
+from __future__ import annotations
+
+from datetime import date, datetime
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import matches, search
+
+
+def ex(day: date, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+D1 = date(2026, 1, 1)
+D2 = date(2026, 1, 15)
+D3 = date(2026, 1, 31)
+
+
+# --- 例の表 (E4-*) ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("expense", "cond", "expected"),
+    [
+        # E4-1: or 条件、メモは全角 "ｕｂｅｒ" で NFKC 正規化して "Uber Eats" に部分一致 (R2,R3)
+        pytest.param(
+            ex(D1, "交通費", 800, "Uber Eats"),
+            {"or": [{"category": "食費"}, {"memo": "ｕｂｅｒ"}]},
+            True,
+            id="E4-1",
+        ),
+    ],
+)
+def test_example_table(
+    expense: Expense, cond: dict[str, object], expected: bool
+) -> None:
+    assert matches(expense, cond) is expected
+
+
+@pytest.mark.parametrize(
+    ("rows", "expected_idx"),
+    [
+        # E4-2: min_amount == max_amount == 1000 は金額 1000 の明細だけ (R1)
+        pytest.param(
+            [ex(D1, "食費", 999), ex(D2, "食費", 1000), ex(D3, "食費", 1001)],
+            [1],
+            id="E4-2",
+        ),
+    ],
+)
+def test_example_amount_range_only_exact(
+    rows: list[Expense], expected_idx: list[int]
+) -> None:
+    cond: dict[str, object] = {"min_amount": 1000, "max_amount": 1000}
+    assert search(rows, cond) == [rows[i] for i in expected_idx]
+
+
+@pytest.mark.parametrize(
+    "cond",
+    [
+        # E4-3: 未知のキー "colour" は ValueError (R5)
+        pytest.param({"colour": "red"}, id="E4-3"),
+    ],
+)
+def test_example_unknown_key_raises(cond: dict[str, object]) -> None:
+    with pytest.raises(ValueError, match="colour"):
+        matches(ex(D1, "食費", 100), cond)
+
+
+# --- 規則のテスト ---------------------------------------------------------
+
+
+def test_R1_empty_dict_matches_everything() -> None:
+    assert matches(ex(D1, "食費", 100), {}) is True
+
+
+def test_R1_multiple_keys_are_anded() -> None:
+    e = ex(D2, "食費", 500, "lunch")
+    assert matches(e, {"category": "食費", "memo": "lunch"}) is True
+    assert matches(e, {"category": "食費", "memo": "dinner"}) is False
+
+
+def test_R2_empty_and_is_true() -> None:
+    assert matches(ex(D1, "食費", 100), {"and": []}) is True
+
+
+def test_R2_empty_or_is_false() -> None:
+    assert matches(ex(D1, "食費", 100), {"or": []}) is False
+
+
+def test_R2_nested_logic() -> None:
+    cond: dict[str, object] = {
+        "and": [
+            {"not": {"category": "交通費"}},
+            {"or": [{"min_amount": 1000}, {"memo": "gift"}]},
+        ]
+    }
+    assert matches(ex(D1, "食費", 1200), cond) is True
+    assert matches(ex(D1, "食費", 300, "gift"), cond) is True
+    assert matches(ex(D1, "食費", 300, "lunch"), cond) is False
+    assert matches(ex(D1, "交通費", 1200), cond) is False
+
+
+def test_R3_memo_is_nfkc_and_case_insensitive_partial() -> None:
+    e = ex(D1, "食費", 100, "Ｕｂｅｒ EATS")
+    assert matches(e, {"memo": "uber"}) is True
+    assert matches(e, {"memo": "EATS"}) is True
+    assert matches(e, {"memo": "lyft"}) is False
+
+
+def test_R3_empty_memo_condition_is_always_true() -> None:
+    assert matches(ex(D1, "食費", 100, ""), {"memo": ""}) is True
+    assert matches(ex(D1, "食費", 100, "anything"), {"memo": ""}) is True
+
+
+def test_R3_category_exact_after_strip_and_case_sensitive() -> None:
+    e = ex(D1, "食費", 100)
+    assert matches(e, {"category": " 食費 "}) is True
+    assert matches(e, {"category": "食"}) is False
+    assert matches(ex(D1, "Food", 100), {"category": "food"}) is False
+
+
+def test_R4_min_greater_than_max_matches_nothing() -> None:
+    rows = [ex(D1, "食費", 500), ex(D2, "食費", 1000)]
+    assert search(rows, {"min_amount": 1000, "max_amount": 500}) == []
+
+
+def test_R4_since_greater_than_until_matches_nothing() -> None:
+    rows = [ex(D1, "食費", 500), ex(D2, "食費", 1000)]
+    assert search(rows, {"since": D3, "until": D1}) == []
+
+
+def test_D5_bounds_are_inclusive() -> None:
+    rows = [ex(D1, "食費", 100), ex(D2, "食費", 200), ex(D3, "食費", 300)]
+    assert search(rows, {"since": D1, "until": D3}) == rows
+    assert search(rows, {"min_amount": 100, "max_amount": 300}) == rows
+    assert search(rows, {"since": D2, "until": D2}) == [rows[1]]
+
+
+@pytest.mark.parametrize(
+    "cond",
+    [
+        pytest.param({"min_amount": True}, id="min_amount-bool"),
+        pytest.param({"max_amount": "1000"}, id="max_amount-str"),
+        pytest.param({"since": "2026-01-01"}, id="since-str"),
+        pytest.param({"until": datetime(2026, 1, 1)}, id="until-datetime"),
+        pytest.param({"category": 1}, id="category-int"),
+        pytest.param({"memo": None}, id="memo-none"),
+        pytest.param({"and": {"category": "食費"}}, id="and-not-list"),
+        pytest.param({"or": "食費"}, id="or-not-list"),
+        pytest.param({"not": [{"category": "食費"}]}, id="not-not-dict"),
+        pytest.param({"and": [1]}, id="and-element-not-dict"),
+        pytest.param({"not": {"colour": "red"}}, id="nested-unknown-key"),
+    ],
+)
+def test_R5_invalid_conditions_raise(cond: dict[str, object]) -> None:
+    with pytest.raises(ValueError):
+        matches(ex(D1, "食費", 100), cond)
+
+
+def test_R5_error_message_names_the_key() -> None:
+    with pytest.raises(ValueError, match="min_amount"):
+        matches(ex(D1, "食費", 100), {"min_amount": "1000"})
+
+
+def test_R5_search_validates_even_when_rows_empty() -> None:
+    with pytest.raises(ValueError, match="colour"):
+        search([], {"colour": "red"})
+
+
+def test_R6_search_keeps_original_order() -> None:
+    rows = [
+        ex(D3, "食費", 300),
+        ex(D1, "食費", 100),
+        ex(D2, "交通費", 200),
+        ex(D1, "食費", 50),
+    ]
+    assert search(rows, {"category": "食費"}) == [rows[0], rows[1], rows[3]]
+
+
+def test_search_empty_rows_returns_empty() -> None:
+    assert search([], {}) == []
