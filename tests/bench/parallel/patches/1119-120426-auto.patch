@@ -0,0 +1,81 @@
+"""Month-over-month comparison of expenses by category (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryDiff:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    ratio: float | None
+    trend: str  # "増" | "減" | "変化なし"
+
+
+def _check_month(month: str) -> None:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def _previous_month(month: str) -> str:
+    year, mon = int(month[:4]), int(month[5:7])
+    if mon == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mon - 1:02d}"
+
+
+def _month_key(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def compare_months(
+    rows: list[Expense], month: str, prev: str | None = None
+) -> list[CategoryDiff]:
+    """Compare category totals of ``month`` against ``prev`` (default: the calendar month before)."""
+    _check_month(month)
+    if prev is None:
+        prev = _previous_month(month)
+    else:
+        _check_month(prev)
+
+    totals: dict[str, dict[str, int]] = {}
+    for e in rows:
+        key = _month_key(e)
+        if key != month and key != prev:
+            continue
+        bucket = totals.setdefault(e.category, {month: 0, prev: 0})
+        bucket[key] += e.amount
+
+    diffs: list[CategoryDiff] = []
+    for category, bucket in totals.items():
+        previous = bucket[prev]
+        current = bucket[month]
+        delta = current - previous
+        ratio = None if previous == 0 else delta / abs(previous)
+        if delta > 0:
+            trend = "増"
+        elif delta < 0:
+            trend = "減"
+        else:
+            trend = "変化なし"
+        diffs.append(
+            CategoryDiff(
+                category=category,
+                previous=previous,
+                current=current,
+                delta=delta,
+                ratio=ratio,
+                trend=trend,
+            )
+        )
+
+    diffs.sort(key=lambda d: (-abs(d.delta), d.category))
+    return diffs
