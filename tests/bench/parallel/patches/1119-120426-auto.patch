@@ -0,0 +1,173 @@
+"""Import bank statement CSV text into Expense records (pure: no file I/O)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from collections.abc import Callable
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+UNCATEGORIZED = "未分類"
+
+_DATE_ALIASES = ("date", "日付", "利用日", "取引日", "ご利用日")
+_AMOUNT_ALIASES = (
+    "amount",
+    "金額",
+    "利用金額",
+    "ご利用金額",
+    "出金額",
+    "支払",
+    "お支払金額",
+)
+_DEPOSIT_ALIASES = ("入金額", "預入")
+_CATEGORY_ALIASES = ("category", "カテゴリ", "分類")
+_MEMO_ALIASES = (
+    "memo",
+    "摘要",
+    "メモ",
+    "利用店名",
+    "ご利用店名",
+    "description",
+    "内容",
+)
+
+# 日付の後ろに付く時刻(例: " 10:30", "T10:30:00")
+_TIME_SUFFIX_RE = re.compile(r"[\sT]*[0-9]{1,2}:[0-9]{2}(?::[0-9]{2}(?:\.[0-9]+)?)?$")
+_DATE_PATTERNS = (
+    re.compile(r"([0-9]{4})-([0-9]{2})-([0-9]{2})"),
+    re.compile(r"([0-9]{4})/([0-9]{1,2})/([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})\.([0-9]{1,2})\.([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日"),
+)
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str
+    value: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+
+
+def _parse_date_cell(raw: str) -> date:
+    if not raw.strip():
+        raise ValueError("日付が空です")
+    s = _TIME_SUFFIX_RE.sub("", unicodedata.normalize("NFKC", raw).strip()).strip()
+    for pattern in _DATE_PATTERNS:
+        m = pattern.fullmatch(s)
+        if m:
+            year, month, day = (int(g) for g in m.groups())
+            try:
+                return date(year, month, day)
+            except ValueError:
+                raise ValueError("存在しない日付です") from None
+    raise ValueError("日付の書式が不正です")
+
+
+def _find_column(names: list[str], aliases: tuple[str, ...]) -> int | None:
+    return next((i for i, n in enumerate(names) if n in aliases), None)
+
+
+def import_bank_csv(
+    text: str, parse_amount: Callable[[str], int] | None = None
+) -> ImportResult:
+    """銀行 CSV のテキストを支出の一覧に変換する。1 行の誤りは errors に集める。"""
+    amount_parser: Callable[[str], int]
+    if parse_amount is None:
+        from kakeibo.jpamount import parse_amount as default  # pyright: ignore[reportMissingImports]
+
+        amount_parser = default
+    else:
+        amount_parser = parse_amount
+
+    text = text.removeprefix("﻿")
+    if not text.strip():
+        raise ValueError("入力が空です")
+
+    lines = io.StringIO(text, newline="").readlines()
+    delimiter = "\t" if "\t" in lines[0] and "," not in lines[0] else ","
+    reader = csv.reader(lines, delimiter=delimiter)
+    header = next(reader)
+    names = [h.strip().lower() for h in header]
+
+    date_i = _find_column(names, _DATE_ALIASES)
+    amount_i = _find_column(names, _AMOUNT_ALIASES)
+    deposit_i = _find_column(names, _DEPOSIT_ALIASES)
+    category_i = _find_column(names, _CATEGORY_ALIASES)
+    memo_i = _find_column(names, _MEMO_ALIASES)
+
+    missing = []
+    if date_i is None:
+        missing.append("日付列(date/日付/利用日/取引日/ご利用日)")
+    if amount_i is None:
+        missing.append("金額列(amount/金額/利用金額/ご利用金額/出金額/支払/お支払金額)")
+    if missing:
+        raise ValueError("必要な列が見つかりません: " + ", ".join(missing))
+    assert date_i is not None and amount_i is not None  # narrowed above
+
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    while True:
+        start = reader.line_num + 1
+        try:
+            row = next(reader)
+        except StopIteration:
+            break
+        if all(not cell.strip() for cell in row):
+            continue
+        raw_line = "".join(lines[start - 1 : reader.line_num]).rstrip("\r\n")
+        if len(row) != len(header):
+            errors.append(RowError(start, "", raw_line, "列数が違います"))
+            continue
+
+        raw_amount = row[amount_i]
+        raw_deposit = row[deposit_i] if deposit_i is not None else ""
+        if not raw_amount.strip() and raw_deposit.strip():
+            continue  # 入金だけの行はスキップ
+
+        row_errors: list[RowError] = []
+        day: date | None = None
+        try:
+            day = _parse_date_cell(row[date_i])
+        except ValueError as e:
+            row_errors.append(RowError(start, header[date_i], row[date_i], str(e)))
+
+        amount: int | None = None
+        if not raw_amount.strip():
+            row_errors.append(
+                RowError(start, header[amount_i], raw_amount, "金額が空です")
+            )
+        else:
+            try:
+                amount = amount_parser(raw_amount.strip())
+            except ValueError as e:
+                row_errors.append(
+                    RowError(
+                        start, header[amount_i], raw_amount, f"金額が不正です: {e}"
+                    )
+                )
+
+        if row_errors or day is None or amount is None:
+            errors.extend(row_errors)
+            continue
+
+        category = row[category_i].strip() if category_i is not None else ""
+        memo = row[memo_i].strip() if memo_i is not None else ""
+        expenses.append(
+            Expense(
+                day=day, category=category or UNCATEGORIZED, amount=amount, memo=memo
+            )
+        )
+
+    return ImportResult(expenses, errors)
