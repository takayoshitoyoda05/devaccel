+"""日本語の金額表記を円の整数に変換する。"""
+
+import re
+import unicodedata
+
+_DIGITS = re.compile(r"[0-9]+")
+_NEG_PREFIXES = ("-", "−", "△", "▲")
+
+
+def parse_amount(text: str) -> int:
+    """金額文字列を整数(円)に変換する。解析できなければ ValueError。"""
+    s = unicodedata.normalize("NFKC", text).strip()
+
+    # R2: 通貨記号・単位を除く
+    if s.startswith("¥"):
+        s = s[1:].lstrip()
+    if s.endswith("円"):
+        s = s[:-1].rstrip()
+    if s[:3].upper() == "JPY":
+        s = s[3:].lstrip()
+    elif s[-3:].upper() == "JPY":
+        s = s[:-3].rstrip()
+
+    # R4: 負数の書き方
+    negative = False
+    if s.startswith(_NEG_PREFIXES):
+        negative = True
+        s = s[1:].lstrip()
+    elif s.startswith("(") and s.endswith(")"):
+        negative = True
+        s = s[1:-1].strip()
+    elif s.endswith("-"):
+        negative = True
+        s = s[:-1].rstrip()
+
+    # R3: 桁区切り(NFKC 後の "，" は "," になる)
+    s = s.replace(",", "")
+
+    # R5/R6: 整数のみ、数字が 1 文字以上必要
+    if not _DIGITS.fullmatch(s):
+        raise ValueError(f"金額として解釈できません: {text!r}")
+
+    value = int(s)
+    return -value if negative else value
