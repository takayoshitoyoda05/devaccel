@@ -0,0 +1,90 @@
+"""Condition-based search over expense records (pure functions, no I/O)."""
+
+from __future__ import annotations
+
+import unicodedata
+from datetime import date, datetime
+from typing import cast
+
+from kakeibo.core import Expense
+
+
+def _norm_memo(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).casefold()
+
+
+def _check(cond: object, where: str = "cond") -> None:
+    """Validate a condition recursively; raise ValueError naming the offending key."""
+    if not isinstance(cond, dict):
+        # R5 requires ValueError (not TypeError) for every invalid condition.
+        raise ValueError(f"{where} は dict である必要があります")  # noqa: TRY004
+    for key, value in cond.items():
+        if key in ("and", "or"):
+            if not isinstance(value, list):
+                raise ValueError(f"{key} は list である必要があります")
+            for sub in value:
+                _check(sub, key)
+        elif key == "not":
+            if not isinstance(value, dict):
+                raise ValueError("not は dict である必要があります")
+            _check(value, "not")
+        elif key in ("category", "memo"):
+            if not isinstance(value, str):
+                raise ValueError(f"{key} は str である必要があります")
+        elif key in ("min_amount", "max_amount"):
+            if isinstance(value, bool) or not isinstance(value, int):
+                raise ValueError(f"{key} は int である必要があります")
+        elif key in ("since", "until"):
+            if not isinstance(value, date) or isinstance(value, datetime):
+                raise ValueError(f"{key} は date である必要があります")
+        else:
+            raise ValueError(f"未知のキーです: {key}")
+
+
+def _eval_leaf(e: Expense, key: str, value: object) -> bool:
+    if key == "category":
+        return e.category.strip() == cast(str, value).strip()
+    if key == "memo":
+        return _norm_memo(cast(str, value)) in _norm_memo(e.memo)
+    if key == "min_amount":
+        return e.amount >= cast(int, value)
+    if key == "max_amount":
+        return e.amount <= cast(int, value)
+    if key == "since":
+        return e.day >= cast(date, value)
+    if key == "until":
+        return e.day <= cast(date, value)
+    raise ValueError(f"未知のキーです: {key}")  # unreachable after _check
+
+
+def _eval(e: Expense, cond: dict[str, object]) -> bool:
+    for key, value in cond.items():
+        if key == "and":
+            if not all(
+                _eval(e, cast(dict[str, object], c)) for c in cast(list[object], value)
+            ):
+                return False
+        elif key == "or":
+            if not any(
+                _eval(e, cast(dict[str, object], c)) for c in cast(list[object], value)
+            ):
+                return False
+        elif key == "not":
+            if _eval(e, cast(dict[str, object], value)):
+                return False
+        else:
+            if not _eval_leaf(e, key, value):
+                return False
+    return True
+
+
+def matches(e: Expense, cond: dict[str, object]) -> bool:
+    """Return True if expense e satisfies cond. Raises ValueError on an invalid cond."""
+    _check(cond)
+    return _eval(e, cond)
+
+
+def search(rows: list[Expense], cond: dict[str, object]) -> list[Expense]:
+    """Return the rows matching cond, in original order. Raises ValueError on an invalid cond."""
+    _check(cond)
+    return [e for e in rows if _eval(e, cond)]
