+++ b/tests/test_recurring.py
@@ -0,0 +1,188 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, detect_recurring
+
+
+def _e(
+    day: date, category: str = "住居", amount: int = 1000, memo: str = ""
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- spec examples (E1-*) ---------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "rows, min_count, expected",
+    [
+        pytest.param(
+            [
+                _e(date(2025, 1, 31), "住居", 80000, "家賃"),
+                _e(date(2025, 2, 28), "住居", 80000, "家賃"),
+                _e(date(2025, 3, 31), "住居", 80000, "家賃"),
+            ],
+            3,
+            [Recurring("住居", "家賃", 80000, 3, date(2025, 3, 31), date(2025, 4, 30))],
+            id="E1-1",
+        ),
+        pytest.param(
+            [
+                _e(date(2025, 11, 5), "動画", 980, "動画"),
+                _e(date(2025, 12, 5), "動画", 980, "動画"),
+                _e(date(2026, 1, 5), "動画", 1200, "動画"),
+            ],
+            3,
+            [Recurring("動画", "動画", 1200, 3, date(2026, 1, 5), date(2026, 2, 5))],
+            id="E1-2",
+        ),
+        pytest.param(
+            [
+                _e(date(2025, 1, 5), "動画", 980, "動画"),
+                _e(date(2025, 3, 5), "動画", 980, "動画"),
+                _e(date(2025, 4, 5), "動画", 980, "動画"),
+                _e(date(2025, 5, 5), "動画", 980, "動画"),
+            ],
+            3,
+            [Recurring("動画", "動画", 980, 3, date(2025, 5, 5), date(2025, 6, 5))],
+            id="E1-3",
+        ),
+    ],
+)
+def test_spec_examples(
+    rows: list[Expense], min_count: int, expected: list[Recurring]
+) -> None:
+    assert detect_recurring(rows, min_count=min_count) == expected
+
+
+# --- rule-level edge cases ---------------------------------------------------
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert detect_recurring([]) == []
+
+
+def test_min_count_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        detect_recurring([], min_count=1)
+
+
+def test_same_month_counts_only_first_day() -> None:
+    rows = [
+        _e(date(2025, 1, 3), memo="A"),
+        _e(date(2025, 1, 20), memo="A"),
+        _e(date(2025, 2, 3), memo="A"),
+    ]
+    # Only 2 distinct months -> below min_count 3.
+    assert detect_recurring(rows, min_count=3) == []
+    assert detect_recurring(rows, min_count=2)[0].count == 2
+
+
+def test_refunds_are_excluded() -> None:
+    rows = [
+        _e(date(2025, 1, 3), memo="A"),
+        _e(date(2025, 2, 3), memo="A"),
+        _e(date(2025, 3, 3), amount=0, memo="A"),
+        _e(date(2025, 3, 4), amount=-500, memo="A"),
+    ]
+    assert detect_recurring(rows, min_count=3) == []
+
+
+def test_gap_uses_only_last_consecutive_run() -> None:
+    rows = [
+        _e(date(2025, 1, 5), memo="動画"),
+        _e(date(2025, 3, 5), memo="動画"),
+        _e(date(2025, 4, 5), memo="動画"),
+        _e(date(2025, 5, 5), memo="動画"),
+    ]
+    assert detect_recurring(rows, min_count=4) == []
+    assert detect_recurring(rows, min_count=3)[0].count == 3
+
+
+def test_december_rolls_over_to_january() -> None:
+    rows = [
+        _e(date(2025, 10, 9), memo="A"),
+        _e(date(2025, 11, 9), memo="A"),
+        _e(date(2025, 12, 9), memo="A"),
+    ]
+    assert detect_recurring(rows)[0].next_day == date(2026, 1, 9)
+
+
+def test_next_day_clipped_to_leap_year_february() -> None:
+    rows = [
+        _e(date(2027, 11, 30), memo="A"),
+        _e(date(2027, 12, 31), memo="A"),
+        _e(date(2028, 1, 31), memo="A"),
+    ]
+    # mode day = 31 -> February 2028 (leap year) ends on 29.
+    assert detect_recurring(rows)[0].next_day == date(2028, 2, 29)
+
+
+def test_mode_tie_prefers_larger_day() -> None:
+    rows = [
+        _e(date(2025, 1, 10), memo="A"),
+        _e(date(2025, 2, 20), memo="A"),
+        _e(date(2025, 3, 10), memo="A"),
+        _e(date(2025, 4, 20), memo="A"),
+    ]
+    # counts: 10 -> 2, 20 -> 2 (tie) -> 20; next month is May.
+    assert detect_recurring(rows, min_count=4)[0].next_day == date(2025, 5, 20)
+
+
+def test_memo_normalization_groups_variants() -> None:
+    rows = [
+        _e(date(2025, 1, 5), memo="ＮＥＴ 動画１"),
+        _e(date(2025, 2, 5), memo="net動画2"),
+        _e(date(2025, 3, 5), memo="Net 動画"),
+    ]
+    result = detect_recurring(rows)
+    assert len(result) == 1
+    assert result[0].memo_key == "net動画"
+    assert result[0].count == 3
+
+
+def test_amount_change_does_not_split_series() -> None:
+    rows = [
+        _e(date(2025, 1, 5), amount=900, memo="A"),
+        _e(date(2025, 2, 5), amount=1000, memo="A"),
+        _e(date(2025, 3, 5), amount=1100, memo="A"),
+    ]
+    result = detect_recurring(rows)
+    assert len(result) == 1
+    assert result[0].amount == 1100
+
+
+def test_different_category_is_separate_series() -> None:
+    rows = [
+        _e(date(2025, 1, 5), category="A", memo="x"),
+        _e(date(2025, 2, 5), category="B", memo="x"),
+        _e(date(2025, 3, 5), category="A", memo="x"),
+    ]
+    assert detect_recurring(rows) == []
+
+
+def test_sort_order_next_day_amount_category_memo() -> None:
+    def series(category: str, memo: str, amount: int, day: int) -> list[Expense]:
+        return [
+            _e(date(2025, 1, day), category, amount, memo),
+            _e(date(2025, 2, day), category, amount, memo),
+            _e(date(2025, 3, day), category, amount, memo),
+        ]
+
+    rows = (
+        series("B", "x", 100, 10)  # next 4/10
+        + series("A", "y", 100, 10)  # next 4/10, same amount -> category A first
+        + series("C", "z", 500, 10)  # next 4/10, larger amount -> first
+        + series("D", "w", 100, 1)  # next 4/1 -> very first
+    )
+    result = detect_recurring(rows)
+    assert [(r.category, r.next_day) for r in result] == [
+        ("D", date(2025, 4, 1)),
+        ("C", date(2025, 4, 10)),
+        ("A", date(2025, 4, 10)),
+        ("B", date(2025, 4, 10)),
+    ]
