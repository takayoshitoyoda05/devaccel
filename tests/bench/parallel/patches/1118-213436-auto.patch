@@ -0,0 +1,57 @@
+"""Detect recurring (monthly) expenses."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+from itertools import pairwise
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Same day next month, clamped to the last day of that month."""
+    year, month = (d.year + 1, 1) if d.month == 12 else (d.year, d.month + 1)
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2 or tolerance < 0:
+        raise ValueError("min_count must be >= 2 and tolerance >= 0")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for r in rows:
+        groups.setdefault((r.category, r.amount), set()).add(r.day)
+
+    result: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        days = sorted(day_set)
+        run = [days[0]]
+        runs: list[list[date]] = []
+        for prev, cur in pairwise(days):
+            if abs((cur - add_month(prev)).days) <= tolerance:
+                run.append(cur)
+            else:
+                runs.append(run)
+                run = [cur]
+        runs.append(run)
+        for run in runs:
+            if len(run) >= min_count:
+                result.append(
+                    Recurring(category, amount, tuple(run), add_month(run[-1]))
+                )
+
+    result.sort(key=lambda x: (x.category, x.amount, x.days[0]))
+    return result
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..8e6ac21
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,123 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def e(d: str, cat: str = "rent", amount: int = 1000, memo: str = "") -> Expense:
+    return Expense(date.fromisoformat(d), cat, amount, memo)
+
+
+@pytest.mark.parametrize(
+    ("src", "want"),
+    [
+        ("2026-01-31", "2026-02-28"),
+        ("2024-01-31", "2024-02-29"),
+        ("2026-12-15", "2027-01-15"),
+        ("2026-03-31", "2026-04-30"),
+        ("2026-05-10", "2026-06-10"),
+    ],
+)
+def test_add_month(src: str, want: str) -> None:
+    assert add_month(date.fromisoformat(src)) == date.fromisoformat(want)
+
+
+def test_basic_detection() -> None:
+    rows = [e("2026-01-05"), e("2026-02-05"), e("2026-03-05")]
+    assert find_recurring(rows) == [
+        Recurring(
+            "rent",
+            1000,
+            (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+            date(2026, 4, 5),
+        )
+    ]
+
+
+def test_empty_and_no_match() -> None:
+    assert find_recurring([]) == []
+    assert find_recurring([e("2026-01-05"), e("2026-02-05")]) == []
+
+
+def test_invalid_args() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_tolerance_boundary() -> None:
+    rows = [e("2026-01-05"), e("2026-02-08"), e("2026-03-11")]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+    assert find_recurring(rows, tolerance=2) == []
+
+
+def test_tolerance_early_side() -> None:
+    rows = [e("2026-01-10"), e("2026-02-07"), e("2026-03-04")]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+
+
+def test_memo_ignored_and_duplicates_removed() -> None:
+    rows = [
+        e("2026-01-05", memo="a"),
+        e("2026-01-05", memo="b"),
+        e("2026-02-05", memo="c"),
+        e("2026-03-05"),
+    ]
+    (r,) = find_recurring(rows)
+    assert len(r.days) == 3
+
+
+def test_groups_by_category_and_amount() -> None:
+    rows = [
+        e("2026-01-05", amount=1000),
+        e("2026-02-05", amount=2000),
+        e("2026-03-05", amount=1000),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_split_into_runs() -> None:
+    rows = [
+        e("2026-01-05"),
+        e("2026-02-05"),
+        e("2026-03-05"),
+        e("2026-06-05"),  # gap
+        e("2026-07-05"),
+        e("2026-08-05"),
+    ]
+    got = find_recurring(rows)
+    assert [r.days[0] for r in got] == [date(2026, 1, 5), date(2026, 6, 5)]
+    assert got[1].next_expected == date(2026, 9, 5)
+
+
+def test_short_run_dropped_and_min_count() -> None:
+    rows = [e("2026-01-05"), e("2026-02-05"), e("2026-05-05"), e("2026-06-05")]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_count=2)) == 2
+
+
+def test_month_end_chain() -> None:
+    rows = [e("2026-01-31"), e("2026-02-28"), e("2026-03-31")]
+    (r,) = find_recurring(rows)
+    assert r.next_expected == date(2026, 4, 30)
+
+
+def test_sorted_output() -> None:
+    def three(cat: str, amount: int) -> list[Expense]:
+        return [e(d, cat, amount) for d in ("2026-01-05", "2026-02-05", "2026-03-05")]
+
+    rows = three("b", 1) + three("a", 2) + three("a", 1)
+    assert [(r.category, r.amount) for r in find_recurring(rows)] == [
+        ("a", 1),
+        ("a", 2),
+        ("b", 1),
+    ]
+
+
+def test_unsorted_input() -> None:
+    rows = [e("2026-03-05"), e("2026-01-05"), e("2026-02-05")]
+    (r,) = find_recurring(rows)
+    assert r.days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
