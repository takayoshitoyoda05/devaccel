diff --git a/src/kakeibo/bankimport.py b/src/kakeibo/bankimport.py
new file mode 100644
index 0000000..27ab00d
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,137 @@
+"""Import bank statement CSV (他行 CSV) into Expense records.
+
+Decisions for the input edge cases:
+D1: 区切りは `,` 固定。タブや区切りの自動判定はしない。
+D2: text 先頭の BOM (U+FEFF) は除去してからパースする。
+D3: 改行は \\r\\n と \\n のどちらも可。引用符の中の区切りと改行は同じ 1 レコードとして扱う。
+D4: 行番号は text 上の物理行番号(ヘッダーが 1)。レコードが複数行にまたがる場合は
+    レコードの開始行を報告する。空行と空白だけの行は読み飛ばすが行番号は数える。
+D5: ヘッダーのセルは前後の空白を除いてから列名と照合する。照合は大文字小文字を区別する
+    完全一致。別名(日付/利用日/取引日 など)の自動推定はしない。列名は mapping で指定する。
+D6: 空の text(ヘッダーが無い)は ValueError。ヘッダーだけの text は ([], []) を返す。
+D7: 金額は先頭の任意の `-` 1 つ、任意の `¥`/`￥`、ASCII 数字とカンマ、任意の `円` のみ。
+    `+`、括弧、`▲`、`△`、末尾の `-`、U+2212 の `−`、`JPY` は拒否する。0 は有効。
+    カンマの位置は検査しない。
+D8: 前後の空白は str.strip() で除く(全角スペース U+3000 を含む)。内部の空白は拒否する。
+D9: 引用されていないカンマ入りの金額(例: `1,234円`)は列がずれる。ずれは検出も修復もしない
+    (余分な列は無視する仕様のため)。引用されたカンマは正しく読む。
+D10: 1 行の誤りは date → amount → category の順にすべて記録する。エラーには値を含めず、
+    (行番号, フィールド名) だけを返す。
+D11: category_map は前後の空白を除いた category と完全一致で照合する。置換後の値はそのまま使う。
+D12: memo の列が mapping に無い場合は memo = ""。mapping に memo があるのにヘッダーに無い場合は
+    ValueError。列が行に足りない場合の欠けた値は "" として扱う(date/amount/category は誤り)。
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"(-?)[¥￥]?([0-9][0-9,]*)円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    """Parse a yen amount string such as ``￥1,234`` or ``-300円`` (see D7, D8)."""
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額が不正です: {s!r}")
+    value = int(m.group(2).replace(",", ""))
+    return -value if m.group(1) else value
+
+
+def parse_date(s: str) -> date:
+    """Parse ``YYYY/M/D`` or ``YYYY-M-D`` (see D8, separators must match)."""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付が不正です: {s!r}")
+    try:
+        return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Read a CSV whose first line is the header.
+
+    Returns ``(expenses in input order, [(line_number, field), ...])``.
+    Rows with any error are excluded from the expenses (see D4, D10).
+    """
+    text = text.removeprefix("﻿")  # D2
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))  # D1, D3
+    header = [h.strip() for h in next(reader, [])]  # D5
+    index: dict[str, int] = {}
+    for i, name in enumerate(header):
+        index.setdefault(name, i)
+    for key, column in mapping.items():
+        if key not in ("date", "category", "amount", "memo"):
+            continue
+        if column not in index:
+            raise ValueError(f"ヘッダーに列 {column!r} がありません")
+
+    date_i = index[mapping["date"]]
+    category_i = index[mapping["category"]]
+    amount_i = index[mapping["amount"]]
+    memo_i = index[mapping["memo"]] if "memo" in mapping else None
+
+    def cell(record: list[str], i: int | None) -> str:
+        if i is None or i >= len(record):
+            return ""
+        return record[i].strip()  # D8
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    prev_end = reader.line_num
+    for record in reader:
+        start = prev_end + 1  # D4: start physical line of this record
+        prev_end = reader.line_num
+        if not any(c.strip() for c in record):  # blank line: skipped, but counted
+            continue
+
+        before = len(errors)
+        day: date | None = None
+        try:
+            day = parse_date(cell(record, date_i))
+        except ValueError:
+            errors.append((start, "date"))
+        amount: int | None = None
+        try:
+            amount = parse_amount(cell(record, amount_i))
+        except ValueError:
+            errors.append((start, "amount"))
+        raw_category = cell(record, category_i)
+        if raw_category == "":
+            errors.append((start, "category"))
+        if len(errors) != before or day is None or amount is None:
+            continue
+
+        category = raw_category
+        if category_map is not None:
+            category = category_map.get(raw_category, raw_category)  # D11
+        expenses.append(
+            Expense(
+                day=day, category=category, amount=amount, memo=cell(record, memo_i)
+            )
+        )
+    return expenses, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
new file mode 100644
index 0000000..92c8b1b
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,128 @@
+"""Month-over-month comparison of expenses (pure functions, standard library only).
+
+D1: 月は "YYYY-MM"(4 桁の年・01〜12 の 2 桁)だけ受け付ける。それ以外は ValueError。
+D2: month_diff は明細の無い月を「全カテゴリ 0 の月」として扱う(途中の月を飛ばさない)。
+    latest_diff は available_months の末尾 2 つ(明細のある月同士)を比べるので、
+    途中の欠けた月は飛ばされる。
+D3: 片方の月にしか明細のないカテゴリは、もう一方の月を 0 として扱う。
+    pct は prev == 0 なら None。
+D4: status は合計ではなく明細の有無で決める。合計が 0 でも明細があれば
+    delta の符号で up / down / same を決める。
+D5: 並びは abs(delta) の降順、同点は category の昇順。入力の並び順には依存しない。
+D6: prev_month == curr_month は許す。全カテゴリ delta 0 で status は "same"。
+D7: render_diff の空入力はヘッダ行だけを返す。pct が -0.0 になる場合は +0.0 と表示する。
+D8: top_movers の n == 0 は空リスト。
+D9: latest_diff は明細のある月が 2 つ未満なら ValueError(比較の基準が無いため)。
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not isinstance(month, str) or not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def _month_key(day: date) -> str:
+    return f"{day.year:04d}-{day.month:02d}"
+
+
+def _summarize(
+    rows: list[Expense], month: str
+) -> tuple[dict[str, int], dict[str, int]]:
+    """(category -> total, category -> number of rows) for one month."""
+    totals: dict[str, int] = {}
+    counts: dict[str, int] = {}
+    for e in rows:
+        if _month_key(e.day) != month:
+            continue
+        totals[e.category] = totals.get(e.category, 0) + e.amount
+        counts[e.category] = counts.get(e.category, 0) + 1
+    return totals, counts
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+    prev_tot, prev_cnt = _summarize(rows, prev_month)
+    curr_tot, curr_cnt = _summarize(rows, curr_month)
+
+    diffs: list[DiffRow] = []
+    for cat in set(prev_cnt) | set(curr_cnt):
+        prev = prev_tot.get(cat, 0)
+        curr = curr_tot.get(cat, 0)
+        delta = curr - prev
+        pct = None if prev == 0 else round(delta / prev * 100, 1)
+        if cat not in prev_cnt:
+            status = "new"
+        elif cat not in curr_cnt:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        diffs.append(DiffRow(cat, prev, curr, delta, pct, status))
+
+    diffs.sort(key=lambda r: (-abs(r.delta), r.category))
+    return diffs
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [d for d in diffs if d.status != "same"][:n]
+
+
+def _pct_text(pct: float | None) -> str:
+    if pct is None:
+        return "-"
+    # + 0.0 turns -0.0 into 0.0 so it renders as +0.0%.
+    return f"{pct + 0.0:+.1f}%"
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for d in diffs:
+        lines.append(
+            "\t".join(
+                [
+                    d.category,
+                    str(d.prev),
+                    str(d.curr),
+                    f"{d.delta:+d}",
+                    _pct_text(d.pct),
+                ]
+            )
+        )
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month_key(e.day) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError(f"比較には明細のある月が 2 つ以上必要です: {len(months)} 月")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..2267cba
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,171 @@
+"""Search query language for Expense records (pure functions, stdlib only).
+
+Decisions (D-list):
+D1: 空のクエリ(空白のみ・トークン無し)と `()` は QueryError。文法上、空の AND(真)・
+    空の OR(偽)は表現できないので、どちらも作らない。
+D2: 文字列比較は部分一致(TERM)または完全一致(CAT)で、どちらも str.casefold() して比べる。
+    全角/半角やUnicode正規化はしない(ＡとAは別物)。
+D3: 空の値は QueryError: 空の引用 `""` と、後ろが空の `cat:`。
+D4: `cat:` 以外のキー(`foo:bar` など)は例外にせず TERM として扱う。全フィールドは
+    文字列として比べるので、型違いという概念は無い。
+D5: 演算子は大文字の AND / OR / NOT と完全一致する語だけ。小文字(and など)や
+    引用符の中の語は TERM。
+D6: 優先順位は NOT > AND > OR。AND は省略でき、項を並べると AND になる。NOT は連続してよい。
+D7: TERM は memo または category の部分文字列なら真。空の memo は category だけで判定される。
+D8: filter_rows は rows が空でもクエリを先に検査するので、不正なクエリは QueryError。
+D9: 例外は QueryError(ValueError のサブクラス)だけを送出する。
+"""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+__all__ = ["QueryError", "filter_rows", "matches", "tokenize"]
+
+
+class QueryError(ValueError):
+    """Raised when a search query is invalid."""
+
+
+Token = tuple[str, str]
+Node = tuple[object, ...]
+
+_SPACE = " \t\r\n\f\v"
+_OPERATORS = {"AND", "OR", "NOT"}
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    """Split a query into (kind, value) tokens."""
+    tokens: list[Token] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        ch = q[i]
+        if ch in _SPACE:
+            i += 1
+        elif ch == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif ch == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif ch == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError(f"閉じていない引用符があります: {q[i:]!r}")
+            body = q[i + 1 : end]
+            if body == "":
+                raise QueryError("空の引用符は使えません")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            start = i
+            while i < n and q[i] not in _SPACE and q[i] not in '()"':
+                i += 1
+            word = q[start:i]
+            if word in _OPERATORS:
+                tokens.append((word, word))
+            elif word.startswith("cat:"):
+                value = word[len("cat:") :]
+                if value == "":
+                    raise QueryError("cat: の後ろに値がありません")
+                tokens.append(("CAT", value))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self.tokens = tokens
+        self.pos = 0
+
+    def peek(self) -> str | None:
+        return self.tokens[self.pos][0] if self.pos < len(self.tokens) else None
+
+    def advance(self) -> Token:
+        tok = self.tokens[self.pos]
+        self.pos += 1
+        return tok
+
+    def parse(self) -> Node:
+        if not self.tokens:
+            raise QueryError("クエリが空です")
+        node = self.or_expr()
+        if self.pos != len(self.tokens):
+            raise QueryError(f"余分なトークンがあります: {self.tokens[self.pos][1]!r}")
+        return node
+
+    def or_expr(self) -> Node:
+        items = [self.and_expr()]
+        while self.peek() == "OR":
+            self.advance()
+            items.append(self.and_expr())
+        return items[0] if len(items) == 1 else ("or", tuple(items))
+
+    def and_expr(self) -> Node:
+        items = [self.not_expr()]
+        while True:
+            kind = self.peek()
+            if kind == "AND":
+                self.advance()
+                items.append(self.not_expr())
+            elif kind in ("TERM", "CAT", "NOT", "LPAREN"):
+                items.append(self.not_expr())
+            else:
+                break
+        return items[0] if len(items) == 1 else ("and", tuple(items))
+
+    def not_expr(self) -> Node:
+        if self.peek() == "NOT":
+            self.advance()
+            return ("not", self.not_expr())
+        return self.primary()
+
+    def primary(self) -> Node:
+        kind = self.peek()
+        if kind == "TERM":
+            return ("term", self.advance()[1])
+        if kind == "CAT":
+            return ("cat", self.advance()[1])
+        if kind == "LPAREN":
+            self.advance()
+            node = self.or_expr()
+            if self.peek() != "RPAREN":
+                raise QueryError("閉じ括弧がありません")
+            self.advance()
+            return node
+        if kind is None:
+            raise QueryError("項がありません")
+        raise QueryError(f"項が必要な位置に {self.tokens[self.pos][1]!r} があります")
+
+
+def _parse(q: str) -> Node:
+    return _Parser(tokenize(q)).parse()
+
+
+def _eval(node: Node, e: Expense) -> bool:
+    kind = node[0]
+    if kind == "or":
+        return any(_eval(child, e) for child in node[1])  # type: ignore[arg-type]
+    if kind == "and":
+        return all(_eval(child, e) for child in node[1])  # type: ignore[arg-type]
+    if kind == "not":
+        return not _eval(node[1], e)  # type: ignore[arg-type]
+    value = str(node[1]).casefold()
+    if kind == "term":
+        return value in e.memo.casefold() or value in e.category.casefold()
+    if kind == "cat":
+        return value == e.category.casefold()
+    raise AssertionError(f"unknown node: {kind!r}")
+
+
+def matches(q: str, e: Expense) -> bool:
+    """Return True if the expense satisfies the query."""
+    return _eval(_parse(q), e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    """Return the expenses matching the query, in input order."""
+    node = _parse(q)
+    return [e for e in rows if _eval(node, e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..fb1aafe
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,79 @@
+"""Detect recurring monthly expenses (pure functions, standard library only).
+
+Decisions (D1..D8):
+D1: 翌月の同じ日が存在しない場合は翌月の末日に丸める(1/31 → 2/28 or 2/29)。
+D2: 12 月の翌月は翌年 1 月として扱う。閏年の 2 月は暦どおり(2024 年は 29 日まで)。
+D3: 同一とみなす単位は (category, amount) の完全一致。memo は無視し、カテゴリ名の正規化もしない。
+D4: 金額が変わった明細(値上げなど)は別の系列とみなす。数 % の揺れは吸収しない。
+D5: 負の金額(返金)も特別扱いせず、(category, amount) の 1 グループとして扱う。
+D6: 同じ日付の重複は 1 回として数える。系列の基準は「直前の日付」からの翌月予定日で、
+    隣り合う日付の差が tolerance 日以内(両端を含む)なら連続とみなす。
+    系列の途中で月が欠ければ、そこで切れる(欠けた月をまたいで連続させない)。
+D7: 同じ (category, amount) で 1 か月に 2 回ある場合、2 つ目はそのまま次の判定対象となる。
+    5 日と 20 日のように 1 か月に別の日で 2 回来るものは、連続判定で互いに切れて系列にならない。
+D8: min_count < 2 と tolerance < 0 は ValueError。next_expected は区間の最後の日付の翌月の同日(D1 で丸める)。
+"""
+
+from __future__ import annotations
+
+import calendar
+import itertools
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """翌月の同じ日を返す。翌月にその日がなければ翌月の末日(D1, D2)。"""
+    year = d.year + (1 if d.month == 12 else 0)
+    month = d.month % 12 + 1
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def _runs(days: list[date], tolerance: int) -> list[list[date]]:
+    """昇順の日付列を、隣どうしが連続している極大区間に分ける(D6)。"""
+    runs: list[list[date]] = [[days[0]]]
+    for prev, cur in itertools.pairwise(days):
+        if abs((cur - add_month(prev)).days) <= tolerance:
+            runs[-1].append(cur)
+        else:
+            runs.append([cur])
+    return runs
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError(f"min_count は 2 以上である必要があります: {min_count}")
+    if tolerance < 0:
+        raise ValueError(f"tolerance は 0 以上である必要があります: {tolerance}")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    out: list[Recurring] = []
+    for (category, amount), dates in groups.items():
+        for run in _runs(sorted(dates), tolerance):
+            if len(run) >= min_count:
+                out.append(
+                    Recurring(
+                        category=category,
+                        amount=amount,
+                        days=tuple(run),
+                        next_expected=add_month(run[-1]),
+                    )
+                )
+    out.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return out
