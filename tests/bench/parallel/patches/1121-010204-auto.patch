+        "１２３",  # D11: 全角数字は拒否(NFKC しない)
+        "１，２３４",  # D11
+        "(500)",  # D7: 括弧の負数は拒否
+        "▲500",  # D7
+        "△500",  # D7
+        "−300",  # D7: U+2212 は拒否
+        "500-",  # D7: 末尾の符号は拒否
+        "+500",  # D7: 正の符号は拒否
+        ",",  # 先頭は数字
+        ",100",  # 先頭は数字
