@@ -0,0 +1,274 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def e(day: str, cat: str, amt: int) -> Expense:
+    return Expense(date.fromisoformat(day), cat, amt)
+
+
+# D1: 月の形式
+@pytest.mark.parametrize(
+    "bad",
+    [
+        "2026-1",
+        "2026/01",
+        "2026-13",
+        "2026-00",
+        "202601",
+        "26-01",
+        "2026-1a",
+        "",
+        "2026-01 ",
+    ],
+)
+def test_invalid_month_format_raises(bad: str) -> None:
+    rows = [e("2026-01-05", "food", 100)]
+    with pytest.raises(ValueError):
+        month_diff(rows, bad, "2026-01")
+    with pytest.raises(ValueError):
+        month_diff(rows, "2026-01", bad)
+
+
+# 基本の集計と各フィールド
+def test_basic_fields() -> None:
+    rows = [
+        e("2026-01-05", "food", 1000),
+        e("2026-01-09", "food", 500),
+        e("2026-02-03", "food", 1800),
+    ]
+    assert month_diff(rows, "2026-01", "2026-02") == [
+        DiffRow("food", 1500, 1800, 300, 20.0, "up"),
+    ]
+
+
+def test_row_fields_are_in_spec_order() -> None:
+    assert DiffRow.__dataclass_fields__.keys() == {
+        "category",
+        "prev",
+        "curr",
+        "delta",
+        "pct",
+        "status",
+    }
+    assert list(DiffRow.__dataclass_fields__) == [
+        "category",
+        "prev",
+        "curr",
+        "delta",
+        "pct",
+        "status",
+    ]
+
+
+# D2: 空の月は全カテゴリ 0 として扱う / latest_diff は欠けた月を飛ばす
+def test_empty_month_counts_as_zero() -> None:
+    rows = [e("2026-01-05", "food", 100)]
+    assert month_diff(rows, "2026-01", "2026-03") == [
+        DiffRow("food", 100, 0, -100, -100.0, "gone"),
+    ]
+
+
+def test_latest_diff_skips_gap_months() -> None:
+    rows = [
+        e("2026-01-05", "food", 100),
+        e("2026-03-05", "food", 150),
+    ]
+    assert available_months(rows) == ["2026-01", "2026-03"]
+    assert latest_diff(rows) == [DiffRow("food", 100, 150, 50, 50.0, "up")]
+
+
+# D3: 片方にしかないカテゴリ / pct は prev == 0 なら None
+def test_category_only_in_one_month() -> None:
+    rows = [
+        e("2026-01-05", "rent", 1000),
+        e("2026-02-05", "travel", 3000),
+    ]
+    got = {d.category: d for d in month_diff(rows, "2026-01", "2026-02")}
+    assert got["rent"] == DiffRow("rent", 1000, 0, -1000, -100.0, "gone")
+    assert got["travel"] == DiffRow("travel", 0, 3000, 3000, None, "new")
+
+
+def test_pct_none_when_prev_zero() -> None:
+    rows = [e("2026-02-05", "travel", 3000)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row.pct is None
+    assert row.status == "new"
+
+
+# D4: status は明細の有無で決める(合計ではない)
+def test_status_uses_row_presence_not_total() -> None:
+    rows = [
+        e("2026-01-05", "misc", 100),
+        e("2026-01-06", "misc", -100),  # prev 合計は 0
+        e("2026-02-05", "misc", 50),
+    ]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row == DiffRow("misc", 0, 50, 50, None, "up")
+
+
+def test_same_status_when_delta_zero() -> None:
+    rows = [e("2026-01-05", "food", 100), e("2026-02-05", "food", 100)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row == DiffRow("food", 100, 100, 0, 0.0, "same")
+
+
+def test_down_status() -> None:
+    rows = [e("2026-01-05", "food", 200), e("2026-02-05", "food", 100)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row == DiffRow("food", 200, 100, -100, -50.0, "down")
+
+
+# D5: 並び順
+def test_sorted_by_abs_delta_desc_then_category_asc() -> None:
+    rows = [
+        e("2026-01-05", "b", 100),
+        e("2026-01-05", "a", 500),
+        e("2026-01-05", "c", 100),
+        e("2026-02-05", "b", 100),  # delta 0
+        e("2026-02-05", "a", 0),  # delta -500 (abs 500)
+        e("2026-02-05", "c", 300),  # delta +200
+        e("2026-02-05", "d", -200),  # new, delta -200 (abs 200)
+    ]
+    cats = [d.category for d in month_diff(rows, "2026-01", "2026-02")]
+    # abs: a=500, c=200, d=200, b=0 -> c/d は同点なので category 昇順
+    assert cats == ["a", "c", "d", "b"]
+
+
+def test_result_independent_of_input_order() -> None:
+    rows = [
+        e("2026-01-05", "x", 10),
+        e("2026-02-05", "y", 10),
+        e("2026-02-06", "x", 30),
+    ]
+    assert month_diff(rows, "2026-01", "2026-02") == month_diff(
+        list(reversed(rows)), "2026-01", "2026-02"
+    )
+
+
+# 空・重複
+def test_empty_rows_gives_empty_list() -> None:
+    assert month_diff([], "2026-01", "2026-02") == []
+
+
+def test_duplicate_rows_are_summed() -> None:
+    rows = [
+        e("2026-01-05", "food", 100),
+        e("2026-01-06", "food", 100),
+        e("2026-02-05", "food", 100),
+    ]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row == DiffRow("food", 200, 100, -100, -50.0, "down")
+
+
+# D6: 同じ月同士
+def test_prev_equals_curr_all_same() -> None:
+    rows = [e("2026-01-05", "food", 100), e("2026-01-06", "rent", 50)]
+    diffs = month_diff(rows, "2026-01", "2026-01")
+    assert all(d.delta == 0 and d.status == "same" for d in diffs)
+    assert {d.category for d in diffs} == {"food", "rent"}
+
+
+# D7: render_diff
+def test_render_header_only_for_empty() -> None:
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_render_format_and_no_trailing_newline() -> None:
+    diffs = [
+        DiffRow("food", 1500, 1800, 300, 20.0, "up"),
+        DiffRow("rent", 2000, 0, -2000, -100.0, "gone"),
+        DiffRow("misc", 500, 500, 0, 0.0, "same"),
+        DiffRow("travel", 0, 3000, 3000, None, "new"),
+    ]
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "food\t1500\t1800\t+300\t+20.0%\n"
+        "rent\t2000\t0\t-2000\t-100.0%\n"
+        "misc\t500\t500\t+0\t+0.0%\n"
+        "travel\t0\t3000\t+3000\t-"
+    )
+
+
+def test_render_negative_zero_pct_shown_as_positive_zero() -> None:
+    assert render_diff([DiffRow("a", 1, 1, 0, -0.0, "same")]).endswith("\t+0\t+0.0%")
+
+
+# D8 / top_movers
+def test_top_movers_excludes_same_and_keeps_order() -> None:
+    diffs = [
+        DiffRow("a", 0, 10, 10, None, "new"),
+        DiffRow("b", 5, 5, 0, 0.0, "same"),
+        DiffRow("c", 20, 0, -20, -100.0, "gone"),
+        DiffRow("d", 1, 2, 1, 100.0, "up"),
+        DiffRow("e", 3, 1, -2, -66.7, "down"),
+    ]
+    assert [d.category for d in top_movers(diffs)] == ["a", "c", "d"]
+    assert [d.category for d in top_movers(diffs, 2)] == ["a", "c"]
+
+
+def test_top_movers_n_zero_is_empty() -> None:
+    diffs = [DiffRow("a", 0, 10, 10, None, "new")]
+    assert top_movers(diffs, 0) == []
+
+
+def test_top_movers_negative_n_raises() -> None:
+    with pytest.raises(ValueError):
+        top_movers([], -1)
+
+
+def test_top_movers_on_empty_input() -> None:
+    assert top_movers([]) == []
+
+
+# available_months / latest_diff
+def test_available_months_sorted_unique() -> None:
+    rows = [
+        e("2026-02-05", "food", 1),
+        e("2025-12-31", "food", 1),
+        e("2026-02-06", "rent", 1),
+        e("2026-01-01", "food", 1),
+    ]
+    assert available_months(rows) == ["2025-12", "2026-01", "2026-02"]
+
+
+def test_available_months_empty() -> None:
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months_across_year() -> None:
+    rows = [
+        e("2025-12-10", "food", 100),
+        e("2026-01-10", "food", 300),
+        e("2026-01-11", "rent", 50),
+    ]
+    assert latest_diff(rows) == [
+        DiffRow("food", 100, 300, 200, 200.0, "up"),
+        DiffRow("rent", 0, 50, 50, None, "new"),
+    ]
+
+
+# D9: 月が 2 つ未満
+@pytest.mark.parametrize(
+    "rows",
+    [
+        [],
+        [e("2026-01-05", "food", 100)],
+        [e("2026-01-05", "food", 100), e("2026-01-06", "rent", 5)],
+    ],
+)
+def test_latest_diff_needs_two_months(rows: list[Expense]) -> None:
+    with pytest.raises(ValueError):
+        latest_diff(rows)
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..0149465
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,264 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+E1 = Expense(date(2024, 1, 5), "食費", 1200, "ランチ 定食")
+E2 = Expense(date(2024, 1, 6), "交通費", 300, "電車")
+E3 = Expense(date(2024, 2, 1), "食費", 800, "Coffee Shop")
+E4 = Expense(date(2024, 2, 2), "雑費", 500, "")
+ROWS = [E1, E2, E3, E4]
+
+
+# --- tokenize -------------------------------------------------------------
+
+
+def test_tokenize_skips_whitespace_only_between_tokens():
+    assert tokenize("  食費   電車 ") == [("TERM", "食費"), ("TERM", "電車")]
+
+
+def test_tokenize_parens():
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+
+
+def test_tokenize_quoted_keeps_spaces_and_parens():
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+
+
+def test_tokenize_quote_has_no_escape():
+    # 引用は次の " まで。 \ はエスケープにならない。
+    assert tokenize('"a\\"') == [("TERM", "a\\")]
+
+
+def test_tokenize_uppercase_operators():
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+
+
+@pytest.mark.parametrize("word", ["and", "or", "not", "And", "nOT"])
+def test_tokenize_lowercase_operators_are_terms(word: str):
+    assert tokenize(word) == [("TERM", word)]
+
+
+def test_tokenize_quoted_operator_is_term():
+    assert tokenize('"AND"') == [("TERM", "AND")]
+
+
+def test_tokenize_cat_prefix():
+    assert tokenize("cat:食費") == [("CAT", "食費")]
+
+
+def test_tokenize_cat_prefix_keeps_colon_inside_value():
+    assert tokenize("cat:a:b") == [("CAT", "a:b")]
+
+
+def test_tokenize_unknown_key_is_term():
+    assert tokenize("foo:bar") == [("TERM", "foo:bar")]
+
+
+def test_tokenize_word_stops_at_quote():
+    assert tokenize('ab"cd"') == [("TERM", "ab"), ("TERM", "cd")]
+
+
+def test_tokenize_empty_input_gives_no_tokens():
+    assert tokenize("") == []
+    assert tokenize("   ") == []
+
+
+@pytest.mark.parametrize("q", ['"abc', '"', '""', 'x "'])
+def test_tokenize_unclosed_or_empty_quote_is_error(q: str):
+    with pytest.raises(QueryError):
+        tokenize(q)
+
+
+def test_tokenize_empty_cat_is_error():
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_query_error_is_value_error():
+    assert issubclass(QueryError, ValueError)
+
+
+# --- grammar errors ------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",  # トークンが無い
+        "   ",
+        "()",  # 空の括弧
+        "(",
+        ")",
+        "(a",
+        "a)",
+        "(a))",
+        "AND",  # 先頭が演算子
+        "OR a",
+        "a OR",  # 演算子の後ろに項が無い
+        "a AND",
+        "NOT",
+        "a NOT",  # NOT は前置のみ
+        "a OR OR b",
+        "(a OR)",
+        "(AND a)",
+    ],
+)
+def test_grammar_errors(q: str):
+    with pytest.raises(QueryError):
+        matches(q, E1)
+
+
+# --- precedence and structure -------------------------------------------
+
+
+def test_implicit_and_between_terms():
+    assert matches("ランチ 定食", E1)
+    assert not matches("ランチ 電車", E1)
+
+
+def test_explicit_and_same_as_implicit():
+    assert matches("ランチ AND 定食", E1)
+    assert not matches("ランチ AND 電車", E1)
+
+
+def test_and_binds_tighter_than_or():
+    # a OR b AND c  ==  a OR (b AND c)
+    assert matches("電車 OR ランチ AND 食費", E1)  # 右側が真
+    assert matches("電車 OR ランチ AND 食費", E2)  # 左側が真
+    assert not matches("電車 OR ランチ AND 食費", E4)
+
+
+def test_not_binds_tighter_than_and():
+    # NOT a b == (NOT a) AND b
+    assert matches("NOT 電車 食費", E1)
+    assert not matches("NOT 食費 ランチ", E1)
+
+
+def test_not_binds_tighter_than_or():
+    # NOT a OR b == (NOT a) OR b
+    assert matches("NOT 食費 OR 電車", E2)
+    assert not matches("NOT 食費 OR 電車", E1)
+
+
+def test_parentheses_override_precedence():
+    assert not matches("(電車 OR ランチ) 食費 AND 電車", E1)
+    assert matches("(電車 OR ランチ) 食費", E1)
+
+
+def test_double_not():
+    assert matches("NOT NOT ランチ", E1)
+    assert not matches("NOT NOT ランチ", E2)
+
+
+def test_not_of_parenthesized_group():
+    assert matches("NOT (電車 OR 雑費)", E1)
+    assert not matches("NOT (電車 OR 雑費)", E4)
+
+
+def test_nested_parentheses():
+    assert matches("((食費))", E1)
+
+
+def test_lowercase_and_is_term_not_operator():
+    # "and" は TERM なので、memo/category の部分一致で判定される
+    assert not matches("ランチ and 定食", E1)
+    assert not matches("ランチ and", E1)
+
+
+# --- term / cat evaluation ----------------------------------------------
+
+
+def test_term_matches_memo_substring():
+    assert matches("定食", E1)
+
+
+def test_term_matches_category_substring():
+    assert matches("食", E1)
+
+
+def test_term_does_not_match_amount_or_date():
+    assert not matches("1200", E1)
+    assert not matches("2024", E1)
+
+
+def test_term_casefold_case_insensitive():
+    assert matches("coffee", E3)
+    assert matches("COFFEE SHOP", E3)
+
+
+def test_term_full_width_and_half_width_are_distinct():
+    # 全角/半角は正規化しない
+    assert not matches("ＣＯＦＦＥＥ", E3)
+
+
+def test_term_matches_empty_memo_only_via_category():
+    assert matches("雑", E4)
+    assert not matches("電車", E4)
+
+
+def test_cat_exact_match():
+    assert matches("cat:食費", E1)
+    assert not matches("cat:食", E1)  # 完全一致のみ
+
+
+def test_cat_does_not_match_memo():
+    assert not matches("cat:定食", E1)
+
+
+def test_cat_case_insensitive():
+    e = Expense(date(2024, 1, 1), "Food", 1, "")
+    assert matches("cat:food", e)
+    assert matches("cat:FOOD", e)
+
+
+def test_cat_value_with_colon():
+    e = Expense(date(2024, 1, 1), "a:b", 1, "")
+    assert matches("cat:a:b", e)
+
+
+def test_quoted_term_with_spaces():
+    assert matches('"ランチ 定食"', E1)
+    assert not matches('"定食 ランチ"', E1)
+
+
+def test_quoted_term_with_parens_is_literal():
+    e = Expense(date(2024, 1, 1), "x", 1, "(a)")
+    assert matches('"(a)"', e)
+
+
+# --- filter_rows ---------------------------------------------------------
+
+
+def test_filter_rows_keeps_input_order():
+    assert filter_rows("食費", ROWS) == [E1, E3]
+
+
+def test_filter_rows_no_match_is_empty_list():
+    assert filter_rows("存在しない", ROWS) == []
+
+
+def test_filter_rows_empty_rows_returns_empty():
+    assert filter_rows("食費", []) == []
+
+
+def test_filter_rows_invalid_query_with_empty_rows_raises():
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
+
+
+def test_filter_rows_invalid_query_raises():
+    with pytest.raises(QueryError):
+        filter_rows("", ROWS)
+
+
+def test_filter_rows_does_not_mutate_input():
+    before = list(ROWS)
+    filter_rows("食費 OR 電車", ROWS)
+    assert ROWS == before
+
+
+def test_filter_rows_or_and_not():
+    assert filter_rows("cat:交通費 OR NOT 食費", ROWS) == [E2, E4]
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..cbcff35
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,218 @@
+from __future__ import annotations
+
+import random
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def exp(d: date, cat: str = "家賃", amt: int = 50000, memo: str = "") -> Expense:
+    return Expense(day=d, category=cat, amount=amt, memo=memo)
+
+
+# --- add_month ---------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("start", "expected"),
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),  # 月末に丸める
+        (date(2024, 1, 31), date(2024, 2, 29)),  # 閏年の 2 月末
+        (date(2026, 12, 15), date(2027, 1, 15)),  # 12 月 → 翌年 1 月
+        (date(2026, 12, 31), date(2027, 1, 31)),  # 12 月末 → 1 月末
+        (date(2026, 3, 31), date(2026, 4, 30)),  # 30 日までの月
+        (date(2025, 2, 28), date(2025, 3, 28)),  # 2 月末 → 3 月の同日
+        (date(2023, 2, 28), date(2023, 3, 28)),
+        (date(2026, 1, 5), date(2026, 2, 5)),  # 1 桁の日
+    ],
+)
+def test_add_month(start: date, expected: date) -> None:
+    assert add_month(start) == expected
+
+
+# --- 引数の検査 -----------------------------------------------------------------
+
+
+@pytest.mark.parametrize("min_count", [1, 0, -3])
+def test_min_count_below_two_raises(min_count: int) -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=min_count)
+
+
+def test_negative_tolerance_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_zero_tolerance_is_allowed() -> None:
+    rows = [exp(date(2026, 1, 1)), exp(date(2026, 2, 1)), exp(date(2026, 3, 1))]
+    assert len(find_recurring(rows, tolerance=0)) == 1
+
+
+# --- 基本 ----------------------------------------------------------------------
+
+
+def test_empty_input_returns_empty() -> None:
+    assert find_recurring([]) == []
+
+
+def test_monthly_series_detected() -> None:
+    rows = [exp(date(2026, 1, 1)), exp(date(2026, 2, 1)), exp(date(2026, 3, 1))]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="家賃",
+            amount=50000,
+            days=(date(2026, 1, 1), date(2026, 2, 1), date(2026, 3, 1)),
+            next_expected=date(2026, 4, 1),
+        )
+    ]
+
+
+def test_below_min_count_returns_empty() -> None:
+    rows = [exp(date(2026, 1, 1)), exp(date(2026, 2, 1))]
+    assert find_recurring(rows, min_count=3) == []
+
+
+def test_min_count_two_accepts_two_items() -> None:
+    rows = [exp(date(2026, 1, 1)), exp(date(2026, 2, 1))]
+    assert len(find_recurring(rows, min_count=2)) == 1
+
+
+def test_memo_is_ignored_for_grouping() -> None:
+    rows = [
+        exp(date(2026, 1, 1), memo="A"),
+        exp(date(2026, 2, 1), memo=""),
+        exp(date(2026, 3, 1), memo="別の文"),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_duplicate_rows_on_same_day_count_once() -> None:
+    rows = [
+        exp(date(2026, 1, 1)),
+        exp(date(2026, 1, 1)),
+        exp(date(2026, 2, 1)),
+        exp(date(2026, 3, 1)),
+    ]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 1), date(2026, 2, 1), date(2026, 3, 1))
+
+
+def test_input_order_does_not_matter() -> None:
+    base = [exp(date(2026, m, 1)) for m in range(1, 7)]
+    shuffled = base[:]
+    random.Random(0).shuffle(shuffled)
+    assert find_recurring(shuffled) == find_recurring(base)
+
+
+# --- 連続性・切れ目 -----------------------------------------------------------------
+
+
+def test_gap_month_splits_series() -> None:
+    # 1,2 月と 4,5 月の間に 3 月がない → 2 つの区間に分かれる
+    rows = [exp(date(2026, m, 1)) for m in (1, 2, 4, 5)]
+    result = find_recurring(rows, min_count=2)
+    assert [r.days for r in result] == [
+        (date(2026, 1, 1), date(2026, 2, 1)),
+        (date(2026, 4, 1), date(2026, 5, 1)),
+    ]
+
+
+def test_gap_leaves_no_run_long_enough() -> None:
+    rows = [exp(date(2026, m, 1)) for m in (1, 2, 4, 5)]
+    assert find_recurring(rows, min_count=3) == []
+
+
+def test_same_category_and_amount_on_two_days_a_month_are_not_merged() -> None:
+    # 5 日と 20 日に来る 2 つのサブスク(同じカテゴリ・金額)は別の系列にならない
+    rows = []
+    for m in (1, 2, 3):
+        rows.append(exp(date(2026, m, 5), cat="サブスク", amt=980))
+        rows.append(exp(date(2026, m, 20), cat="サブスク", amt=980))
+    assert find_recurring(rows, min_count=2) == []
+
+
+def test_amount_change_starts_a_different_series() -> None:
+    rows = [
+        exp(date(2026, 1, 1), amt=1000),
+        exp(date(2026, 2, 1), amt=1000),
+        exp(date(2026, 3, 1), amt=1000),
+        exp(date(2026, 4, 1), amt=1100),
+        exp(date(2026, 5, 1), amt=1100),
+    ]
+    result = find_recurring(rows, min_count=3)
+    assert [(r.amount, len(r.days)) for r in result] == [(1000, 3)]
+
+
+def test_negative_amount_is_its_own_series() -> None:
+    # 返金(負の金額)は (カテゴリ, 金額) の別グループとして扱う
+    rows = [exp(date(2026, m, 1), amt=-1000) for m in (1, 2, 3)]
+    rows += [exp(date(2026, m, 1), amt=1000) for m in (1, 2, 3)]
+    result = find_recurring(rows)
+    assert sorted(r.amount for r in result) == [-1000, 1000]
+
+
+def test_series_crosses_year_boundary() -> None:
+    rows = [exp(date(2026, 11, 15)), exp(date(2026, 12, 15)), exp(date(2027, 1, 15))]
+    result = find_recurring(rows)
+    assert result[0].next_expected == date(2027, 2, 15)
+
+
+def test_month_end_clamp_chains_and_next_expected_uses_last_day() -> None:
+    # 1/31 → 2/28 → 3/31: 2/28 から 1 か月後は 3/28、3/31 との差は 3 日
+    rows = [exp(date(2026, 1, 31)), exp(date(2026, 2, 28)), exp(date(2026, 3, 31))]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 30)
+
+
+def test_leap_year_series() -> None:
+    rows = [exp(date(2024, 1, 31)), exp(date(2024, 2, 29)), exp(date(2024, 3, 29))]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2024, 4, 29)
+
+
+def test_tolerance_boundary_is_inclusive() -> None:
+    # 1/10 の翌月は 2/10。2/13 はちょうど 3 日ずれ、2/7 は 3 日早い
+    late = [exp(date(2026, 1, 10)), exp(date(2026, 2, 13))]
+    early = [exp(date(2026, 1, 10)), exp(date(2026, 2, 7))]
+    assert len(find_recurring(late, min_count=2, tolerance=3)) == 1
+    assert len(find_recurring(early, min_count=2, tolerance=3)) == 1
+    assert find_recurring(late, min_count=2, tolerance=2) == []
+    assert find_recurring(early, min_count=2, tolerance=2) == []
+
+
+def test_drift_within_tolerance_is_chained() -> None:
+    # 1/31 → 2/28 → 3/31 は許容 3 日では連続、許容 2 日では切れる
+    rows = [exp(date(2026, 1, 31)), exp(date(2026, 2, 28)), exp(date(2026, 3, 31))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+    assert find_recurring(rows, tolerance=2) == []
+
+
+# --- 結果の並び ------------------------------------------------------------------
+
+
+def test_results_sorted_by_category_amount_first_day() -> None:
+    rows = []
+    for m in (1, 2, 3):
+        rows.append(exp(date(2026, m, 1), cat="通信", amt=3000))
+        rows.append(exp(date(2026, m, 2), cat="家賃", amt=50000))
+        rows.append(exp(date(2026, m, 3), cat="家賃", amt=20000))
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [
+        ("家賃", 20000),
+        ("家賃", 50000),
+        ("通信", 3000),
+    ]
+
+
+def test_same_category_and_amount_two_runs_sorted_by_first_day() -> None:
+    # 同じ (カテゴリ, 金額) で 2 つの区間に分かれたとき、先頭の日付順
+    rows = [exp(date(2026, m, 1)) for m in (1, 2, 3)]
+    rows += [exp(date(2026, m, 1)) for m in (7, 8, 9)]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 1), date(2026, 7, 1)]
