+# --- combinators ----------------------------------------------------------
+
+
+def test_all_of_is_and() -> None:
+    q = all_of(category("food", "cafe"), amount_between(min=1000))
+    got = search(_rows(), q)
+    assert [(e.category, e.amount) for e in got] == [("food", 1000)]
+
+
+def test_any_of_is_or() -> None:
+    q = any_of(category("rent"), memo_contains("dinner"))
+    got = search(_rows(), q)
+    assert [e.category for e in got] == ["rent", "food"]
+
+
+def test_not_inverts_query() -> None:
+    got = search(_rows(), not_(category("food")))
+    assert [e.category for e in got] == ["cafe", "rent", "transport"]
+
+
+def test_nested_and_or_not() -> None:
+    q = all_of(
+        not_(category("rent")),
+        any_of(
+            memo_contains("lunch"), all_of(amount_between(max=500), category("cafe"))
+        ),
+    )
+    got = search(_rows(), q)
+    assert [e.memo for e in got] == [
+        "lunch with friends",
+        "Coffee",
+        "train LUNCH pass",
+    ]
+
+
+def test_empty_all_of_is_always_true() -> None:
+    assert search(_rows(), all_of()) == _rows()
+
+
+def test_empty_any_of_is_always_false() -> None:
+    assert search(_rows(), any_of()) == []
+
+
+def test_not_of_empty_all_of_is_false() -> None:
+    assert search(_rows(), not_(all_of())) == []
