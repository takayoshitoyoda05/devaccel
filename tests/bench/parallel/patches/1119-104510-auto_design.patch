+++ b/tests/test_monthly_diff.py
@@ -0,0 +1,108 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthly_diff import CategoryDiff, compare_months, render_diff
+
+
+def E(y: int, m: int, d: int, cat: str, amt: int) -> Expense:
+    return Expense(day=date(y, m, d), category=cat, amount=amt, memo="")
+
+
+def _sample() -> list[Expense]:
+    return [
+        E(2026, 12, 1, "food", 10000),
+        E(2026, 12, 2, "rent", 80000),
+        E(2026, 12, 3, "game", 3000),
+        E(2027, 1, 1, "food", 11500),
+        E(2027, 1, 2, "rent", 80000),
+        E(2027, 1, 3, "cafe", 700),
+    ]
+
+
+def test_spec_example_values_and_order() -> None:
+    got = compare_months(_sample(), "2027-01")
+    assert got == [
+        CategoryDiff("game", 3000, 0, -3000, -1.0, "gone"),
+        CategoryDiff("food", 10000, 11500, 1500, 0.15, "up"),
+        CategoryDiff("cafe", 0, 700, 700, None, "new"),
+        CategoryDiff("rent", 80000, 80000, 0, 0.0, "same"),
+    ]
+
+
+def test_status_down() -> None:
+    rows = [E(2026, 11, 1, "food", 5000), E(2026, 12, 1, "food", 4000)]
+    got = compare_months(rows, "2026-12")
+    assert got == [CategoryDiff("food", 5000, 4000, -1000, -0.2, "down")]
+
+
+def test_year_rollover_compares_with_previous_december() -> None:
+    rows = [E(2026, 12, 1, "food", 1000), E(2027, 1, 1, "food", 1200)]
+    got = compare_months(rows, "2027-01")
+    assert got == [CategoryDiff("food", 1000, 1200, 200, 0.2, "up")]
+
+
+def test_previous_month_empty_makes_all_new() -> None:
+    rows = [E(2027, 1, 1, "food", 300), E(2027, 1, 2, "cafe", 100)]
+    got = compare_months(rows, "2027-01")
+    assert got == [
+        CategoryDiff("food", 0, 300, 300, None, "new"),
+        CategoryDiff("cafe", 0, 100, 100, None, "new"),
+    ]
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert compare_months([], "2026-11") == []
+
+
+def test_other_months_are_ignored() -> None:
+    rows = [E(2026, 10, 1, "old", 999), E(2027, 2, 1, "later", 100)]
+    got = compare_months(rows, "2026-12")
+    assert got == []
+
+
+def test_ties_sorted_by_category_name() -> None:
+    rows = [
+        E(2026, 12, 1, "b", 100),
+        E(2026, 12, 1, "a", 100),
+        E(2027, 1, 1, "c", 200),
+    ]
+    got = compare_months(rows, "2027-01")
+    # |delta|: a=100, b=100, c=200 -> c first, then a, b by name
+    assert [d.category for d in got] == ["c", "a", "b"]
+
+
+def test_input_not_mutated() -> None:
+    rows = _sample()
+    snapshot = list(rows)
+    compare_months(rows, "2027-01")
+    assert rows == snapshot
+
+
+@pytest.mark.parametrize("month", ["2026-13", "202611", "", "2026-00", "2026-1"])
+def test_invalid_month_raises(month: str) -> None:
+    with pytest.raises(ValueError):
+        compare_months(_sample(), month)
+
+
+def test_render_empty_is_empty_string() -> None:
+    assert render_diff([]) == ""
+
+
+def test_render_exact_output_with_total() -> None:
+    text = render_diff(compare_months(_sample(), "2027-01"))
+    assert text == (
+        "game\t3,000\t0\t-3,000\t-100.0%\n"
+        "food\t10,000\t11,500\t+1,500\t+15.0%\n"
+        "cafe\t0\t700\t+700\t-\n"
+        "rent\t80,000\t80,000\t+0\t+0.0%\n"
+        "TOTAL\t93,000\t92,200\t-800\t-0.9%\n"
+    )
+
+
+def test_render_total_ratio_none_when_previous_total_zero() -> None:
+    text = render_diff(compare_months([E(2027, 1, 1, "food", 300)], "2027-01"))
+    assert text == ("food\t0\t300\t+300\t-\nTOTAL\t0\t300\t+300\t-\n")
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..35b6985
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,254 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, next_due
+
+
+def _row(day: str, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+def test_monthly_rent_detected() -> None:
+    rows = [
+        _row("2026-08-01", "rent", 80000),
+        _row("2026-09-01", "rent", 80000),
+        _row("2026-10-01", "rent", 80000),
+    ]
+    assert find_recurring(rows) == [
+        Recurring(
+            key="rent:",
+            category="rent",
+            amount=80000,
+            day_of_month=1,
+            months=("2026-08", "2026-09", "2026-10"),
+            last_date=date(2026, 10, 1),
+            next_date=date(2026, 11, 1),
+        )
+    ]
+
+
+def test_gap_month_breaks_run() -> None:
+    rows = [
+        _row("2026-08-01", "rent", 80000),
+        _row("2026-09-01", "rent", 80000),
+        _row("2026-11-01", "rent", 80000),
+    ]
+    assert find_recurring(rows) == []
+    assert find_recurring(rows, min_months=2) == []
+
+
+def test_fewer_than_min_months_not_detected() -> None:
+    rows = [_row("2026-09-01", "rent", 80000), _row("2026-10-01", "rent", 80000)]
+    assert find_recurring(rows) == []
+
+
+def test_same_month_two_entries_breaks_run() -> None:
+    rows = [
+        _row("2026-07-01", "rent", 80000),
+        _row("2026-08-01", "rent", 80000),
+        _row("2026-09-01", "rent", 80000),
+        _row("2026-09-02", "rent", 80000),
+        _row("2026-10-01", "rent", 80000),
+        _row("2026-11-01", "rent", 80000),
+    ]
+    assert find_recurring(rows, min_months=3) == []
+    assert find_recurring(rows, min_months=2) == [
+        Recurring(
+            key="rent:",
+            category="rent",
+            amount=80000,
+            day_of_month=1,
+            months=("2026-10", "2026-11"),
+            last_date=date(2026, 11, 1),
+            next_date=date(2026, 12, 1),
+        )
+    ]
+
+
+def test_latest_month_with_two_entries_not_recurring() -> None:
+    rows = [
+        _row("2026-08-01", "rent", 80000),
+        _row("2026-09-01", "rent", 80000),
+        _row("2026-10-01", "rent", 80000),
+        _row("2026-10-05", "rent", 80000),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_run_counts_only_latest_consecutive_months() -> None:
+    months = [1, 2, 3, 5, 6, 7, 8, 9, 10]
+    rows = [_row(f"2026-{m:02d}-01", "rent", 80000) for m in months]
+    result = find_recurring(rows, min_months=3)
+    assert len(result) == 1
+    assert result[0].months == tuple(f"2026-{m:02d}" for m in range(5, 11))
+    assert find_recurring(rows, min_months=7) == []
+
+
+def test_year_boundary_is_consecutive() -> None:
+    rows = [
+        _row("2025-12-15", "phone", 4000),
+        _row("2026-01-15", "phone", 4000),
+        _row("2026-02-15", "phone", 4000),
+    ]
+    assert find_recurring(rows) == [
+        Recurring(
+            key="phone:",
+            category="phone",
+            amount=4000,
+            day_of_month=15,
+            months=("2025-12", "2026-01", "2026-02"),
+            last_date=date(2026, 2, 15),
+            next_date=date(2026, 3, 15),
+        )
+    ]
+
+
+def test_tolerance_zero_requires_same_amount() -> None:
+    rows = [
+        _row("2026-08-01", "rent", 80000),
+        _row("2026-09-01", "rent", 80000),
+        _row("2026-10-01", "rent", 80500),
+    ]
+    assert find_recurring(rows) == []
+    assert find_recurring(rows, amount_tolerance=0.0) == []
+
+
+def test_tolerance_allows_amounts_within_range() -> None:
+    rows = [
+        _row("2026-08-01", "rent", 72000),
+        _row("2026-09-01", "rent", 84000),
+        _row("2026-10-01", "rent", 80000),
+    ]
+    assert find_recurring(rows) == []
+    result = find_recurring(rows, amount_tolerance=0.1)
+    assert len(result) == 1
+    assert result[0].amount == 80000
+    assert result[0].months == ("2026-08", "2026-09", "2026-10")
+
+
+def test_tolerance_outside_range_breaks_run() -> None:
+    rows = [
+        _row("2026-08-01", "rent", 72000),
+        _row("2026-09-01", "rent", 84000),
+        _row("2026-10-01", "rent", 80000),
+    ]
+    assert find_recurring(rows, amount_tolerance=0.05) == []
+
+
+def test_memo_grouping_normalizes_whitespace_and_case() -> None:
+    rows = [
+        _row("2026-08-01", "sub", 1200, " Netflix "),
+        _row("2026-09-01", "sub", 1200, "netflix"),
+        _row("2026-10-01", "sub", 1200, "NETFLIX"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].key == "sub:netflix"
+    assert result[0].months == ("2026-08", "2026-09", "2026-10")
+
+
+def test_same_memo_different_category_not_merged() -> None:
+    rows = []
+    for m in ("2026-08", "2026-09", "2026-10"):
+        rows.append(_row(f"{m}-01", "a", 100, "x"))
+        rows.append(_row(f"{m}-01", "b", 100, "x"))
+    assert [r.key for r in find_recurring(rows)] == ["a:x", "b:x"]
+
+
+def test_day_of_month_is_median_low() -> None:
+    rows = [
+        _row("2026-08-10", "gym", 5000),
+        _row("2026-09-20", "gym", 5000),
+        _row("2026-10-12", "gym", 5000),
+    ]
+    result = find_recurring(rows)
+    assert result[0].day_of_month == 12
+    assert result[0].next_date == date(2026, 11, 12)
+
+
+def test_median_low_even_count_takes_lower() -> None:
+    rows = [
+        _row("2026-07-03", "gym", 5000),
+        _row("2026-08-01", "gym", 5000),
+        _row("2026-09-04", "gym", 5000),
+        _row("2026-10-02", "gym", 5000),
+    ]
+    result = find_recurring(rows)
+    assert result[0].day_of_month == 2
+    assert result[0].next_date == date(2026, 11, 2)
+
+
+def test_next_date_clamped_to_month_end() -> None:
+    rows = [
+        _row("2026-08-31", "rent", 80000),
+        _row("2026-09-30", "rent", 80000),
+        _row("2026-10-31", "rent", 80000),
+    ]
+    result = find_recurring(rows)
+    assert result[0].day_of_month == 31
+    assert result[0].next_date == date(2026, 11, 30)
+
+
+def test_empty_rows_returns_empty() -> None:
+    assert find_recurring([]) == []
+
+
+def test_input_not_mutated() -> None:
+    rows = [
+        _row("2026-08-01", "rent", 80000),
+        _row("2026-09-01", "rent", 80000),
+        _row("2026-10-01", "rent", 80000),
+    ]
+    before = list(rows)
+    find_recurring(rows)
+    assert rows == before
+
+
+def test_result_sorted_by_next_date_category_key() -> None:
+    rows: list[Expense] = []
+    for m in ("2026-08", "2026-09", "2026-10"):
+        rows.append(_row(f"{m}-01", "rent", 80000))
+        rows.append(_row(f"{m}-01", "rent", 300, "b"))
+        rows.append(_row(f"{m}-01", "rent", 200, "a"))
+        rows.append(_row(f"{m}-01", "gym", 5000, "x"))
+        rows.append(_row(f"{m}-15", "phone", 4000))
+    keys = [r.key for r in find_recurring(rows)]
+    assert keys == ["gym:x", "rent:", "rent:a", "rent:b", "phone:"]
+
+
+def test_next_due_examples() -> None:
+    assert next_due(date(2026, 1, 31), 31) == date(2026, 2, 28)
+    assert next_due(date(2026, 12, 15), 15) == date(2027, 1, 15)
+    assert next_due(date(2024, 1, 31), 31) == date(2024, 2, 29)
+
+
+def test_next_due_leap_and_non_leap_february() -> None:
+    assert next_due(date(2025, 1, 31), 31) == date(2025, 2, 28)
+    assert next_due(date(2024, 1, 15), 30) == date(2024, 2, 29)
+
+
+def test_next_due_year_rollover_and_month_end() -> None:
+    assert next_due(date(2026, 12, 31), 1) == date(2027, 1, 1)
+    assert next_due(date(2026, 11, 30), 31) == date(2026, 12, 31)
+
+
+@pytest.mark.parametrize("bad", [0, 32, -1])
+def test_next_due_rejects_out_of_range_day(bad: int) -> None:
+    with pytest.raises(ValueError):
+        next_due(date(2026, 1, 1), bad)
+
+
+def test_min_months_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_months=1)
+
+
+def test_negative_tolerance_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], amount_tolerance=-0.1)
diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..556fa92
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,231 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    all_of,
+    amount_between,
+    any_of,
+    category,
+    date_between,
+    memo_contains,
+    not_,
+    search,
+)
+
+
+def _rows() -> list[Expense]:
+    return [
+        Expense(date(2024, 1, 1), "food", 1000, "lunch with friends"),
+        Expense(date(2024, 1, 5), "cafe", 500, "Coffee"),
+        Expense(date(2024, 2, 1), "rent", 80000, ""),
+        Expense(date(2024, 2, 10), "food", 999, "dinner"),
+        Expense(date(2024, 3, 31), "transport", 500, "train LUNCH pass"),
+    ]
+
+
+# --- category -------------------------------------------------------------
+
+
+def test_category_matches_any_of_names() -> None:
+    rows = _rows()
+    got = search(rows, category("food", "cafe"))
+    assert [e.category for e in got] == ["food", "cafe", "food"]
+
+
+def test_category_is_exact_not_partial() -> None:
+    assert search(_rows(), category("foo")) == []
+
+
+def test_category_ignores_surrounding_whitespace_in_names() -> None:
+    got = search(_rows(), category("  rent  "))
+    assert [e.category for e in got] == ["rent"]
+
+
+def test_category_is_case_sensitive() -> None:
+    assert search(_rows(), category("FOOD")) == []
+
+
+def test_category_without_names_raises() -> None:
+    with pytest.raises(ValueError):
+        category()
+
+
+# --- amount_between -------------------------------------------------------
+
+
+def test_amount_between_includes_both_ends() -> None:
+    got = search(_rows(), amount_between(500, 1000))
+    assert [e.amount for e in got] == [1000, 500, 999, 500]
+
+
+def test_amount_between_exact_value() -> None:
+    got = search(_rows(), amount_between(500, 500))
+    assert [e.amount for e in got] == [500, 500]
+
+
+def test_amount_between_min_only() -> None:
+    got = search(_rows(), amount_between(min=1000))
+    assert [e.amount for e in got] == [1000, 80000]
+
+
+def test_amount_between_max_only() -> None:
+    got = search(_rows(), amount_between(max=500))
+    assert [e.amount for e in got] == [500, 500]
+
+
+def test_amount_between_both_none_raises() -> None:
+    with pytest.raises(ValueError):
+        amount_between(None, None)
+
+
+def test_amount_between_min_greater_than_max_raises() -> None:
+    with pytest.raises(ValueError):
+        amount_between(min=1000, max=999)
+
+
+# --- date_between ---------------------------------------------------------
+
+
+def test_date_between_includes_both_ends() -> None:
+    got = search(_rows(), date_between(date(2024, 1, 5), date(2024, 2, 1)))
+    assert [e.day for e in got] == [date(2024, 1, 5), date(2024, 2, 1)]
+
+
+def test_date_between_same_start_and_end() -> None:
