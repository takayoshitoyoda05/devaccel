new file mode 100644
index 0000000..1b8016a
--- /dev/null
+++ b/src/kakeibo/importer.py
@@ -0,0 +1,194 @@
+"""Import bank / card statement CSV text into Expense records (pure functions)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+class ImportFormatError(ValueError):
+    """Raised when the whole statement cannot be read (empty input, missing columns)."""
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int  # physical line number in the source text (header is line 1)
+    column: str | None  # original header of the bad column; None for whole-row problems
+    reason: str
+    raw: str  # the original text of the row
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+
+
+_DATE_ALIASES = frozenset({"date", "日付", "利用日", "ご利用日", "取引日", "年月日"})
+_AMOUNT_ALIASES = frozenset(
+    {"amount", "金額", "利用金額", "ご利用金額", "支払金額", "出金", "出金金額"}
+)
+_CATEGORY_ALIASES = frozenset({"category", "カテゴリ", "分類", "費目"})
+_MEMO_ALIASES = frozenset(
+    {"memo", "メモ", "摘要", "内容", "利用店名", "ご利用店名・商品名", "description"}
+)
+
+_DATE_SEP_RE = re.compile(r"([0-9]{4})([-/])([0-9]{1,2})\2([0-9]{1,2})")
+_DATE_JP_RE = re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日")
+_DATE_COMPACT_RE = re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})")
+_AMOUNT_RE = re.compile(r"([-▲△]?)([0-9]+)")
+_AMOUNT_NOISE_RE = re.compile(r"[\s¥￥円,]")
+_THOUSANDS_HEAD_RE = re.compile(r"\s*[¥￥]?[-▲△]?[0-9]{1,3}\s*")
+_THOUSANDS_TAIL_RE = re.compile(r"\s*[0-9]{3}\s*円?\s*")
+
+
+def _records(text: str) -> list[tuple[int, str, list[str]]]:
+    """Non-blank CSV records as (start physical line, raw text, cells)."""
+    raw_lines = text.split("\n")
+    reader = csv.reader(io.StringIO(text))
+    out: list[tuple[int, str, list[str]]] = []
+    prev = 0
+    for row in reader:
+        end = reader.line_num
+        start = prev + 1
+        prev = end
+        if all(not cell.strip() for cell in row):
+            continue
+        raw = "\n".join(line.rstrip("\r") for line in raw_lines[start - 1 : end])
+        out.append((start, raw, row))
+    return out
+
+
+def _find(names: list[str], aliases: frozenset[str]) -> int | None:
+    for i, name in enumerate(names):
+        if name.lower() in aliases:
+            return i
+    return None
+
+
+@dataclass(frozen=True)
+class _Layout:
+    header: list[str]
+    day: int
+    amount: int
+    category: int | None
+    memo: int | None
+
+
+def _layout(header: list[str]) -> _Layout:
+    names = [h.strip() for h in header]
+    day = _find(names, _DATE_ALIASES)
+    if day is None:
+        raise ImportFormatError(f"日付列が見つかりません(見出し: {names})")
+    amount = _find(names, _AMOUNT_ALIASES)
+    if amount is None:
+        raise ImportFormatError(f"金額列が見つかりません(見出し: {names})")
+    return _Layout(
+        header=names,
+        day=day,
+        amount=amount,
+        category=_find(names, _CATEGORY_ALIASES),
+        memo=_find(names, _MEMO_ALIASES),
+    )
+
+
+def _parse_day(cell: str) -> date:
+    s = cell.strip()
+    parts: tuple[int, int, int] | None = None
+    m = _DATE_SEP_RE.fullmatch(s)
+    if m is not None:
+        parts = (int(m.group(1)), int(m.group(3)), int(m.group(4)))
+    else:
+        m = _DATE_JP_RE.fullmatch(s) or _DATE_COMPACT_RE.fullmatch(s)
+        if m is not None:
+            parts = (int(m.group(1)), int(m.group(2)), int(m.group(3)))
+    if parts is not None:
+        try:
+            return date(*parts)
+        except ValueError:
+            pass  # e.g. 2026/02/30: same reason as a malformed date
+    raise ValueError(f"日付の形式が不正です: '{s}'")
+
+
+def _parse_amount(cell: str) -> int:
+    s = cell.strip()
+    cleaned = _AMOUNT_NOISE_RE.sub("", unicodedata.normalize("NFKC", s))
+    m = _AMOUNT_RE.fullmatch(cleaned)
+    if m is None:
+        raise ValueError(f"金額が整数ではありません: '{s}'")
+    value = int(m.group(2))
+    if m.group(1):
+        value = -value
+    if value <= 0:
+        raise ValueError(f"金額は 1 円以上が必要です(入金・返金は対象外): '{s}'")
+    return value
+
+
+def _rejoin_thousands(row: list[str], header_len: int, amount: int) -> list[str]:
+    """Undo unquoted thousands separators in the amount cell.
+
+    An unquoted ``¥3,980円`` splits into ``¥3`` and ``980円``. Only applied when the
+    row has more cells than the header, and only when the amount cell is followed by
+    a 3-digit group. Quoted cells never split, so they are unaffected.
+    """
+    cells = list(row)
+    while len(cells) > header_len and amount + 1 < len(cells):
+        head, tail = cells[amount], cells[amount + 1]
+        if _THOUSANDS_HEAD_RE.fullmatch(head) is None:
+            break
+        if _THOUSANDS_TAIL_RE.fullmatch(tail) is None:
+            break
+        cells[amount : amount + 2] = [f"{head},{tail}"]
+    return cells
+
+
+def _cell(row: list[str], index: int | None) -> str:
+    return "" if index is None else row[index]
+
+
+def parse_statement(text: str, *, default_category: str = "未分類") -> ImportResult:
+    """Parse statement CSV text. Bad rows go to ``errors``; good rows still import."""
+    text = text.removeprefix("﻿")
+    records = _records(text)
+    if not records:
+        raise ImportFormatError("入力が空です")
+    _, _, header = records[0]
+    layout = _layout(header)
+
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    for line, raw, cells in records[1:]:
+        row = _rejoin_thousands(cells, len(layout.header), layout.amount)
+        if len(row) < len(layout.header):
+            errors.append(
+                RowError(
+                    line=line,
+                    column=None,
+                    reason=(
+                        f"列数が足りません(期待 {len(layout.header)} 列、"
+                        f"実際 {len(row)} 列)"
+                    ),
+                    raw=raw,
+                )
+            )
+            continue
+        try:
+            day = _parse_day(row[layout.day])
+        except ValueError as err:
+            errors.append(RowError(line, layout.header[layout.day], str(err), raw))
+            continue
+        try:
+            amount = _parse_amount(row[layout.amount])
+        except ValueError as err:
+            errors.append(RowError(line, layout.header[layout.amount], str(err), raw))
+            continue
+        category = _cell(row, layout.category).strip() or default_category
+        memo = _cell(row, layout.memo).strip()
+        expenses.append(Expense(day=day, category=category, amount=amount, memo=memo))
+    return ImportResult(expenses=expenses, errors=errors)
diff --git a/src/kakeibo/monthly_diff.py b/src/kakeibo/monthly_diff.py
new file mode 100644
index 0000000..4b33b57
--- /dev/null
+++ b/src/kakeibo/monthly_diff.py
@@ -0,0 +1,92 @@
+"""Month-over-month comparison of expenses by category."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from typing import Literal
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryDiff:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    ratio: float | None
+    status: Literal["up", "down", "same", "new", "gone"]
+
+
+def _previous_month(month: str) -> str:
+    y, m = int(month[:4]), int(month[5:7])
+    if m == 1:
+        return f"{y - 1:04d}-12"
+    return f"{y:04d}-{m - 1:02d}"
+
+
+def _month_key(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def _status(
+    previous: int, current: int
+) -> Literal["up", "down", "same", "new", "gone"]:
+    if previous == 0 and current > 0:
+        return "new"
+    if previous > 0 and current == 0:
+        return "gone"
+    delta = current - previous
+    if delta > 0:
+        return "up"
+    if delta < 0:
+        return "down"
+    return "same"
+
+
+def compare_months(rows: list[Expense], month: str) -> list[CategoryDiff]:
+    """Compare category totals of `month` (YYYY-MM) with the calendar month before it."""
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+    prev_month = _previous_month(month)
+    current: dict[str, int] = {}
+    previous: dict[str, int] = {}
+    for e in rows:
+        key = _month_key(e)
+        if key == month:
+            current[e.category] = current.get(e.category, 0) + e.amount
+        elif key == prev_month:
+            previous[e.category] = previous.get(e.category, 0) + e.amount
+    diffs: list[CategoryDiff] = []
+    for cat in set(current) | set(previous):
+        p = previous.get(cat, 0)
+        c = current.get(cat, 0)
+        delta = c - p
+        ratio = None if p == 0 else delta / p
+        diffs.append(CategoryDiff(cat, p, c, delta, ratio, _status(p, c)))
+    diffs.sort(key=lambda d: (-abs(d.delta), d.category))
+    return diffs
+
+
+def _fmt_row(
+    name: str, previous: int, current: int, delta: int, ratio: float | None
+) -> str:
+    pct = "-" if ratio is None else f"{ratio * 100:+.1f}%"
+    return f"{name}\t{previous:,}\t{current:,}\t{delta:+,}\t{pct}"
+
+
+def render_diff(diffs: list[CategoryDiff]) -> str:
+    if not diffs:
+        return ""
+    lines = [
+        _fmt_row(d.category, d.previous, d.current, d.delta, d.ratio) for d in diffs
+    ]
+    total_prev = sum(d.previous for d in diffs)
+    total_cur = sum(d.current for d in diffs)
+    total_delta = total_cur - total_prev
+    total_ratio = None if total_prev == 0 else total_delta / total_prev
+    lines.append(_fmt_row("TOTAL", total_prev, total_cur, total_delta, total_ratio))
+    return "\n".join(lines) + "\n"
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
