index 0000000..cf833fe
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,97 @@
+"""Detect recurring expenses (fixed monthly payments)."""
+
+from __future__ import annotations
+
+import calendar
+import statistics
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    key: str
+    category: str
+    amount: int  # yen, latest occurrence
+    day_of_month: int
+    months: tuple[str, ...]  # consecutive "YYYY-MM", ascending
+    last_date: date
+    next_date: date
+
+
+def _index(day: date) -> int:
+    return day.year * 12 + (day.month - 1)
+
+
+def _fmt(index: int) -> str:
+    return f"{index // 12:04d}-{index % 12 + 1:02d}"
+
+
+def next_due(last: date, day_of_month: int) -> date:
+    """Return the day_of_month of the month after `last` (clamped to month end)."""
+    if not 1 <= day_of_month <= 31:
+        raise ValueError(f"日は 1〜31 の範囲である必要があります: {day_of_month}")
+    if last.month == 12:
+        year, month = last.year + 1, 1
+    else:
+        year, month = last.year, last.month + 1
+    last_day = calendar.monthrange(year, month)[1]
+    return date(year, month, min(day_of_month, last_day))
+
+
+def find_recurring(
+    rows: list[Expense], *, min_months: int = 3, amount_tolerance: float = 0.0
+) -> list[Recurring]:
+    if min_months < 2:
+        raise ValueError(f"min_months は 2 以上である必要があります: {min_months}")
+    if amount_tolerance < 0:
+        raise ValueError(
+            f"amount_tolerance は 0 以上である必要があります: {amount_tolerance}"
+        )
+
+    # (category, normalized memo) -> {month index: expenses in that month}
+    groups: dict[tuple[str, str], dict[int, list[Expense]]] = {}
+    for e in rows:
+        norm = e.memo.strip().casefold()
+        groups.setdefault((e.category, norm), {}).setdefault(_index(e.day), []).append(
+            e
+        )
+
+    found: list[Recurring] = []
+    for (category, norm), by_idx in groups.items():
+        last_idx = max(by_idx)
+        last_entries = by_idx[last_idx]
+        if len(last_entries) != 1:
+            continue
+        last = last_entries[0]
+
+        run: list[int] = []  # month indices, newest first
+        idx = last_idx
+        while True:
+            entries = by_idx.get(idx, [])
+            if len(entries) != 1:
+                break
+            if abs(entries[0].amount - last.amount) > amount_tolerance * abs(
+                last.amount
+            ):
+                break
+            run.append(idx)
+            idx -= 1
+        if len(run) < min_months:
+            continue
+
+        day_of_month = statistics.median_low([by_idx[i][0].day.day for i in run])
+        found.append(
+            Recurring(
+                key=f"{category}:{norm}",
+                category=category,
+                amount=last.amount,
+                day_of_month=day_of_month,
+                months=tuple(_fmt(i) for i in reversed(run)),
+                last_date=last.day,
+                next_date=next_due(last.day, day_of_month),
+            )
+        )
+    return sorted(found, key=lambda r: (r.next_date, r.category, r.key))
diff --git a/src/kakeibo/search.py b/src/kakeibo/search.py
new file mode 100644
index 0000000..3b4c7d2
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,83 @@
+"""Filter expense rows with composable predicates."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from datetime import date
+
+from kakeibo.core import Expense
+
+Query = Callable[[Expense], bool]
+
+
+def category(*names: str) -> Query:
+    """Match rows whose category exactly equals one of ``names`` (outer spaces ignored)."""
+    if not names:
+        raise ValueError("カテゴリ名を 1 つ以上指定してください")
+    wanted = {n.strip() for n in names}
+    return lambda e: e.category.strip() in wanted
+
+
+def amount_between(min: int | None = None, max: int | None = None) -> Query:
+    """Match rows whose amount lies within [min, max] (both ends included)."""
+    if min is None and max is None:
+        raise ValueError("min と max の少なくとも一方を指定してください")
+    if min is not None and max is not None and min > max:
+        raise ValueError(f"min ({min}) が max ({max}) より大きくなっています")
+
+    def pred(e: Expense) -> bool:
+        if min is not None and e.amount < min:
+            return False
+        return not (max is not None and e.amount > max)
+
+    return pred
+
+
+def date_between(start: date | None = None, end: date | None = None) -> Query:
+    """Match rows whose date lies within [start, end] (both ends included)."""
+    if start is None and end is None:
+        raise ValueError("start と end の少なくとも一方を指定してください")
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"start ({start}) が end ({end}) より後になっています")
+
+    def pred(e: Expense) -> bool:
+        if start is not None and e.day < start:
+            return False
+        return not (end is not None and e.day > end)
+
+    return pred
+
+
+def memo_contains(text: str, *, ignore_case: bool = True) -> Query:
+    """Match rows whose memo contains ``text`` as a substring."""
+    if text == "":
+        raise ValueError("検索する文字列が空です")
+    needle = text.casefold() if ignore_case else text
+
+    def pred(e: Expense) -> bool:
+        hay = e.memo.casefold() if ignore_case else e.memo
+        return needle in hay
+
+    return pred
+
+
+def all_of(*queries: Query) -> Query:
+    """AND of all queries. With no queries, always True."""
+    return lambda e: all(q(e) for q in queries)
+
+
+def any_of(*queries: Query) -> Query:
+    """OR of all queries. With no queries, always False."""
+    return lambda e: any(q(e) for q in queries)
+
+
+def not_(query: Query) -> Query:
+    """Negation of ``query``."""
+    return lambda e: not query(e)
+
+
+def search(rows: list[Expense], query: Query | None = None) -> list[Expense]:
+    """Return the rows matching ``query`` in input order. ``None`` returns a copy of all rows."""
+    if query is None:
+        return list(rows)
+    return [e for e in rows if query(e)]
diff --git a/tests/test_importer.py b/tests/test_importer.py
new file mode 100644
index 0000000..ed9c984
--- /dev/null
+++ b/tests/test_importer.py
@@ -0,0 +1,232 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.importer import ImportFormatError, ImportResult, RowError, parse_statement
+
+
+def test_import_format_error_is_value_error() -> None:
+    assert issubclass(ImportFormatError, ValueError)
+
+
+def test_basic_row_with_quoted_amount() -> None:
+    text = '日付,摘要,出金\n2026/11/03,スーパー,"1,200"\n'
+    result = parse_statement(text)
+    assert result == ImportResult(
+        expenses=[Expense(date(2026, 11, 3), "未分類", 1200, "スーパー")],
+        errors=[],
+    )
+
+
+def test_good_rows_kept_and_bad_row_reported() -> None:
+    text = (
+        "利用日,ご利用金額,ご利用店名・商品名\n"
+        "2026年11月3日,¥3,980円,書店\n"
+        "2026-13-01,500,x\n"
+    )
+    result = parse_statement(text)
+    assert result.expenses == [Expense(date(2026, 11, 3), "未分類", 3980, "書店")]
+    assert result.errors == [
+        RowError(
+            line=3,
+            column="利用日",
+            reason="日付の形式が不正です: '2026-13-01'",
+            raw="2026-13-01,500,x",
+        )
+    ]
+
+
+def test_empty_text_raises_format_error() -> None:
+    with pytest.raises(ImportFormatError):
+        parse_statement("")
+
+
+def test_whitespace_only_text_raises_format_error() -> None:
+    with pytest.raises(ImportFormatError):
+        parse_statement("\n\n  \n")
+
+
+def test_header_only_returns_empty_result() -> None:
+    assert parse_statement("日付,金額\n") == ImportResult([], [])
+
+
+def test_missing_date_column_raises() -> None:
+    with pytest.raises(ImportFormatError):
+        parse_statement("memo,amount\n2026-11-03,100\n")
+
+
+def test_missing_amount_column_raises() -> None:
+    with pytest.raises(ImportFormatError):
+        parse_statement("日付,摘要\n2026-11-03,x\n")
+
+
+def test_bom_is_ignored() -> None:
+    result = parse_statement("﻿日付,金額\n2026-11-03,100\n")
+    assert result.expenses == [Expense(date(2026, 11, 3), "未分類", 100, "")]
+    assert result.errors == []
+
+
+def test_fullwidth_digits_in_amount() -> None:
+    result = parse_statement("日付,金額\n2026-11-03,１２００\n")
+    assert [e.amount for e in result.expenses] == [1200]
+
+
+@pytest.mark.parametrize(
+    "cell",
+    ["1,200", "¥1,200", "￥1,200", "1200円", "１２００", "1,200 円", " 1200 "],
+)
+def test_amount_surface_forms_all_mean_1200(cell: str) -> None:
+    result = parse_statement(f"日付,金額\n2026-11-03,{cell}\n")
+    assert [e.amount for e in result.expenses] == [1200]
+    assert result.errors == []
+
+
+@pytest.mark.parametrize(
+    "header",
+    [
+        "date,amount",
+        "DATE,AMOUNT",
+        " 日付 , 金額 ",
+        "年月日,出金金額",
+        "取引日,支払金額",
+    ],
+)
+def test_header_aliases(header: str) -> None:
+    result = parse_statement(f"{header}\n2026-11-03,100\n")
+    assert result.expenses == [Expense(date(2026, 11, 3), "未分類", 100, "")]
+
+
+def test_memo_aliases_are_read() -> None:
+    for memo_header in ["memo", "DESCRIPTION", "摘要", "内容", "利用店名"]:
+        result = parse_statement(f"日付,金額,{memo_header}\n2026-11-03,100,店\n")
+        assert result.expenses[0].memo == "店", memo_header
+
+
+def test_leftmost_alias_column_wins() -> None:
+    result = parse_statement("日付,利用日,金額\n2026-11-03,2026-11-04,100\n")
+    assert result.expenses[0].day == date(2026, 11, 3)
+
+
+@pytest.mark.parametrize(
+    ("cell", "expected"),
+    [
+        ("2026-11-03", date(2026, 11, 3)),
+        ("2026/11/03", date(2026, 11, 3)),
+        ("2026/1/3", date(2026, 1, 3)),
+        ("2026年11月3日", date(2026, 11, 3)),
+        ("20261103", date(2026, 11, 3)),
+    ],
+)
+def test_five_date_forms(cell: str, expected: date) -> None:
+    result = parse_statement(f"日付,金額\n{cell},100\n")
+    assert result.expenses[0].day == expected
+    assert result.errors == []
+
+
+@pytest.mark.parametrize("cell", ["2026.11.03", "2026-11/03", "11/03/2026", "abc"])
+def test_malformed_date_reported(cell: str) -> None:
+    result = parse_statement(f"日付,金額\n{cell},100\n")
+    assert result.expenses == []
+    assert result.errors == [
+        RowError(
+            line=2,
+            column="日付",
+            reason=f"日付の形式が不正です: '{cell}'",
+            raw=f"{cell},100",
+        )
+    ]
+
+
+@pytest.mark.parametrize("cell", ["2026-13-01", "2026/02/30"])
+def test_nonexistent_date_uses_same_reason(cell: str) -> None:
+    result = parse_statement(f"日付,金額\n{cell},100\n")
+    assert result.errors[0].reason == f"日付の形式が不正です: '{cell}'"
+
+
+@pytest.mark.parametrize("cell", ["0", "-500", "▲500", "△500", "¥0", "▲0"])
+def test_zero_or_negative_amount_rejected(cell: str) -> None:
+    result = parse_statement(f"日付,金額\n2026-11-03,{cell}\n")
+    assert result.expenses == []
+    assert len(result.errors) == 1
+    assert result.errors[0].column == "金額"
+    assert result.errors[0].reason == (
+        f"金額は 1 円以上が必要です(入金・返金は対象外): '{cell}'"
+    )
+
+
+@pytest.mark.parametrize("cell", ["12.5", "abc", ""])
+def test_non_integer_amount_rejected(cell: str) -> None:
+    result = parse_statement(f"日付,金額\n2026-11-03,{cell}\n")
+    assert result.expenses == []
+    assert result.errors == [
+        RowError(
+            line=2,
+            column="金額",
+            reason=f"金額が整数ではありません: '{cell}'",
+            raw=f"2026-11-03,{cell}",
+        )
+    ]
+
+
+def test_short_row_reports_column_count() -> None:
+    text = "日付,摘要,金額\n2026-11-03,スーパー\n"
+    result = parse_statement(text)
+    assert result.expenses == []
+    assert result.errors == [
+        RowError(
+            line=2,
+            column=None,
+            reason="列数が足りません(期待 3 列、実際 2 列)",
+            raw="2026-11-03,スーパー",
+        )
+    ]
+
+
+def test_blank_lines_keep_physical_line_numbers() -> None:
+    text = "日付,金額\n\n2026-11-03,100\n\n2026-13-01,5\n"
+    result = parse_statement(text)
+    assert result.expenses == [Expense(date(2026, 11, 3), "未分類", 100, "")]
+    assert [e.line for e in result.errors] == [5]
+
+
+def test_date_error_takes_precedence_over_amount_error() -> None:
+    result = parse_statement("日付,金額\n2026-13-01,abc\n")
+    assert len(result.errors) == 1
+    assert result.errors[0].column == "日付"
+
+
+def test_errors_sorted_by_line_and_expenses_in_file_order() -> None:
+    text = (
+        "日付,金額,摘要\n"
+        "2026-11-05,300,c\n"
+        "bad,100,x\n"
+        "2026-11-01,200,a\n"
+        "2026-11-09,0,y\n"
+        "2026-11-02,400,b\n"
+    )
+    result = parse_statement(text)
+    assert [e.memo for e in result.expenses] == ["c", "a", "b"]
+    assert [err.line for err in result.errors] == [3, 5]
+
+
+def test_default_category_used_when_no_category_column() -> None:
+    result = parse_statement("日付,金額\n2026-11-03,100\n", default_category="食費")
+    assert result.expenses[0].category == "食費"
+
+
+def test_empty_category_cell_uses_default() -> None:
+    result = parse_statement("日付,金額,カテゴリ\n2026-11-03,100,\n")
+    assert result.expenses[0].category == "未分類"
+
+
+def test_category_column_is_stripped() -> None:
+    result = parse_statement("日付,金額,分類\n2026-11-03,100, 食費 \n")
+    assert result.expenses[0].category == "食費"
+
+
+def test_missing_memo_column_gives_empty_memo() -> None:
+    result = parse_statement("日付,金額\n2026-11-03,100\n")
+    assert result.expenses[0].memo == ""
diff --git a/tests/test_monthly_diff.py b/tests/test_monthly_diff.py
