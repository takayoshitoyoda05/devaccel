+import pytest
+
+from kakeibo.core import format_yen
+
+
+@pytest.mark.parametrize(
+    ("amount", "expected"),
+    [
+        (1234567, "¥1,234,567"),
+        (-500, "-¥500"),
+        (0, "¥0"),
+        (999, "¥999"),
+        (1000, "¥1,000"),
+        (-1234567, "-¥1,234,567"),
+        (-1, "-¥1"),
+    ],
+)
+def test_format_yen(amount, expected):
+    assert format_yen(amount) == expected
+
+
+def test_negative_uses_ascii_hyphen_and_halfwidth_yen():
+    s = format_yen(-1000)
+    assert s[0] == "-" and s[1] == "¥" and "," in s
+
+
+@pytest.mark.parametrize("bad", [12.5, True, "100", None])
+def test_rejects_non_int(bad):
+    with pytest.raises(TypeError):
+        format_yen(bad)
