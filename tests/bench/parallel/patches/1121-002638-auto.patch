+def format_yen(amount: int) -> str:
+    """Format yen for display: 1234567 -> "¥1,234,567", -500 -> "-¥500".
+
+    D1: 負数は先頭に ASCII の `-` を置き `-¥500` とする(△・▲・括弧は使わない)。
+    D2: 0 は `¥0`(符号なし)。
+    D3: 桁区切りは ASCII の `,`、記号は半角の `¥`(U+00A5)。全角にはしない。
+    D4: 整数以外(float・bool・str)は TypeError で拒否する(金額は円の整数)。
+    """
+    if isinstance(amount, bool) or not isinstance(amount, int):
+        raise TypeError(f"金額は整数である必要があります: {amount!r}")
+    sign = "-" if amount < 0 else ""
+    return f"{sign}¥{abs(amount):,}"
+
