+def test_gap_within_tolerance_links() -> None:
+    # add_month(2026-01-05) = 2026-02-05; 2026-02-08 is 3 days later
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 8)), e(date(2026, 3, 8))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+
+
+def test_gap_beyond_tolerance_splits() -> None:
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 8)), e(date(2026, 3, 8))]
+    assert find_recurring(rows, tolerance=2) == []
+
+
+def test_early_date_within_tolerance_links() -> None:
+    # 2026-02-02 is 3 days before add_month(2026-01-05) = 2026-02-05
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 2)), e(date(2026, 3, 2))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+
+
+def test_month_end_linking_uses_clamped_next_month() -> None:
+    # add_month(2026-01-31) = 2026-02-28 (exact); add_month(2026-02-28) = 2026-03-28,
+    # so 2026-03-31 is 3 days later: linked only with tolerance >= 3
+    rows = [e(date(2026, 1, 31)), e(date(2026, 2, 28)), e(date(2026, 3, 31))]
+    assert find_recurring(rows, tolerance=2) == []
+    result = find_recurring(rows, tolerance=3)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 30)
+
