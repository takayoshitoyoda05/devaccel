+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,93 @@
+"""Month-over-month category comparison (前月比)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def _month_of(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+
+    prev_total: dict[str, int] = {}
+    curr_total: dict[str, int] = {}
+    prev_seen: set[str] = set()
+    curr_seen: set[str] = set()
+    for e in rows:
+        m = _month_of(e)
+        if m == prev_month:
+            prev_total[e.category] = prev_total.get(e.category, 0) + e.amount
+            prev_seen.add(e.category)
+        elif m == curr_month:
+            curr_total[e.category] = curr_total.get(e.category, 0) + e.amount
+            curr_seen.add(e.category)
+
+    out: list[DiffRow] = []
+    for cat in prev_seen | curr_seen:
+        prev = prev_total.get(cat, 0)
+        curr = curr_total.get(cat, 0)
+        delta = curr - prev
+        pct = None if prev == 0 else round(delta / prev * 100, 1) + 0.0
+        if cat not in prev_seen:
+            status = "new"
+        elif cat not in curr_seen:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+
+    out.sort(key=lambda r: (-abs(r.delta), r.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [r for r in diffs if r.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for r in diffs:
+        pct = "-" if r.pct is None else f"{r.pct:+.1f}%"
+        lines.append(f"{r.category}\t{r.prev}\t{r.curr}\t{r.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month_of(e) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には明細のある月が 2 つ以上必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..7962537
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,163 @@
+"""Search query language for expenses.
+
+Grammar (lowest precedence first)::
+
+    or_expr  := and_expr ("OR" and_expr)*
+    and_expr := not_expr (["AND"] not_expr)*
+    not_expr := "NOT" not_expr | primary
+    primary  := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from .core import Expense
+
+Token = tuple[str, str]
+
+
+class QueryError(ValueError):
+    """Raised when a search query cannot be tokenized or parsed."""
+
+
+_SPECIAL = ' \t\r\n()"'
+_OPERATORS = {"AND", "OR", "NOT"}
+
+
+def tokenize(q: str) -> list[Token]:
+    tokens: list[Token] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end < 0:
+                raise QueryError("閉じていない引用符があります")
+            body = q[i + 1 : end]
+            if body == "":
+                raise QueryError("空の引用符は使えません")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            j = i
+            while j < n and q[j] not in _SPECIAL and not q[j].isspace():
+                j += 1
+            word = q[i:j]
+            i = j
+            if word in _OPERATORS:
+                tokens.append((word, word))
+            elif word.startswith("cat:"):
+                value = word[len("cat:") :]
+                if value == "":
+                    raise QueryError("cat: の後に値がありません")
+                tokens.append(("CAT", value))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+@dataclass(frozen=True)
+class _Node:
+    kind: str  # "term" | "cat" | "not" | "and" | "or"
+    value: str = ""
+    children: tuple[_Node, ...] = ()
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self.tokens = tokens
+        self.pos = 0
+
+    def _peek(self) -> str | None:
+        return self.tokens[self.pos][0] if self.pos < len(self.tokens) else None
+
+    def _take(self) -> Token:
+        tok = self.tokens[self.pos]
+        self.pos += 1
+        return tok
+
+    def parse(self) -> _Node:
+        if not self.tokens:
+            raise QueryError("検索条件が空です")
+        node = self._or()
+        if self.pos != len(self.tokens):
+            raise QueryError("構文が不正です(余分なトークン)")
+        return node
+
+    def _or(self) -> _Node:
+        node = self._and()
+        while self._peek() == "OR":
+            self._take()
+            node = _Node("or", children=(node, self._and()))
+        return node
+
+    def _starts_not_expr(self) -> bool:
+        return self._peek() in {"NOT", "TERM", "CAT", "LPAREN"}
+
+    def _and(self) -> _Node:
+        node = self._not()
+        while True:
+            if self._peek() == "AND":
+                self._take()
+                node = _Node("and", children=(node, self._not()))
+            elif self._starts_not_expr():
+                node = _Node("and", children=(node, self._not()))
+            else:
+                return node
+
+    def _not(self) -> _Node:
+        if self._peek() == "NOT":
+            self._take()
+            return _Node("not", children=(self._not(),))
+        return self._primary()
+
+    def _primary(self) -> _Node:
+        kind = self._peek()
+        if kind == "TERM":
+            return _Node("term", self._take()[1])
+        if kind == "CAT":
+            return _Node("cat", self._take()[1])
+        if kind == "LPAREN":
+            self._take()
+            node = self._or()
+            if self._peek() != "RPAREN":
+                raise QueryError("括弧が閉じられていません")
+            self._take()
+            return node
+        raise QueryError("項がありません")
+
+
+def _eval(node: _Node, e: Expense) -> bool:
+    if node.kind == "term":
+        needle = node.value.casefold()
+        return needle in e.memo.casefold() or needle in e.category.casefold()
+    if node.kind == "cat":
+        return node.value.casefold() == e.category.casefold()
+    if node.kind == "not":
+        return not _eval(node.children[0], e)
+    if node.kind == "and":
+        return _eval(node.children[0], e) and _eval(node.children[1], e)
+    return _eval(node.children[0], e) or _eval(node.children[1], e)
+
+
+def _compile(q: str) -> _Node:
+    return _Parser(tokenize(q)).parse()
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _eval(_compile(q), e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    node = _compile(q)  # validates the query even when rows is empty
+    return [e for e in rows if _eval(node, e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..42ad380
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,64 @@
+"""Detect recurring expenses (same category and amount, roughly monthly)."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day in the next month, clamped to that month's last day."""
+    year, month = (d.year, d.month + 1) if d.month < 12 else (d.year + 1, 1)
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def _runs(days: list[date], tolerance: int) -> list[list[date]]:
+    """Split sorted, unique dates into maximal runs of monthly-linked dates."""
+    runs: list[list[date]] = []
+    for d in days:
+        if runs and abs((d - add_month(runs[-1][-1])).days) <= tolerance:
+            runs[-1].append(d)
+        else:
+            runs.append([d])
+    return runs
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError(f"min_count は 2 以上である必要があります: {min_count}")
+    if tolerance < 0:
+        raise ValueError(f"tolerance は 0 以上である必要があります: {tolerance}")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    found: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        for run in _runs(sorted(day_set), tolerance):
+            if len(run) >= min_count:
+                found.append(
+                    Recurring(
+                        category=category,
+                        amount=amount,
+                        days=tuple(run),
+                        next_expected=add_month(run[-1]),
+                    )
+                )
+
+    found.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return found
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..ad9011d
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,221 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+HDR = "利用日,分類,利用金額,利用店名\n"
+
+
+@pytest.mark.parametrize(
+    ("s", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥1,000", 1000),
+        ("￥1000", 1000),
+        ("-980円", -980),
+        ("-￥5", -5),
+        ("1,,2", 12),  # comma positions are not checked
+        ("12,", 12),
+        ("1234", 1234),
+    ],
+)
+def test_parse_amount_accepts(s, expected):
+    assert parse_amount(s) == expected
+
+
+@pytest.mark.parametrize(
+    "s",
+    [
+        "",
+        "   ",
+        "円",
+        "¥",
+        "-",
+        ",",
+        "12.5",
+        "1 200",
+        "980 円",
+        "--5",
+        "¥-5",
+        "-円5",
+        "¥¥5",
+        "5円円",
+        "5円¥",
+        "５",  # full-width digit
+        "１２３",
+        "abc",
+        ",5",
+    ],
+)
+def test_parse_amount_rejects(s):
+    with pytest.raises(ValueError):
+        parse_amount(s)
+
+
+@pytest.mark.parametrize(
+    ("s", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/1/5 ", date(2026, 1, 5)),
+        ("2026-1-05", date(2026, 1, 5)),
+        ("2026/12/31", date(2026, 12, 31)),
+        ("2024/02/29", date(2024, 2, 29)),
+    ],
+)
+def test_parse_date_accepts(s, expected):
+    assert parse_date(s) == expected
+
+
+@pytest.mark.parametrize(
+    "s",
+    [
+        "",
+        "2026/1-5",
+        "2026-1/5",
+        "26/1/5",
+        "2026/02/30",
+        "2025/02/29",
+        "2026/13/1",
+        "2026/0/1",
+        "2026.1.5",
+        "２０２６/1/5",
+        "2026/1/5 10:00",
+        "2026/1/",
+        "2026//5",
+    ],
+)
+def test_parse_date_rejects(s):
+    with pytest.raises(ValueError):
+        parse_date(s)
+
+
+def test_default_mapping_values():
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_import_rows_basic_and_order():
+    text = HDR + '2026/1/5,食費,"1,200",スーパー\n2026-01-06,交通,￥300,駅\n'
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [
+        Expense(date(2026, 1, 5), "食費", 1200, "スーパー"),
+        Expense(date(2026, 1, 6), "交通", 300, "駅"),
+    ]
+
+
+def test_import_rows_quoted_comma_in_memo():
+    text = HDR + '2026/1/5,食費,100,"A店, 本店"\n'
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows[0].memo == "A店, 本店"
+
+
+def test_import_rows_strips_and_maps_category():
+    text = HDR + "2026/1/5,  食費  , 100 ,  店  \n"
+    rows, errors = import_rows(text, category_map={"食費": "food"})
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "food", 100, "店")]
+
+
+def test_category_map_only_replaces_exact_keys():
+    text = HDR + "2026/1/5,食費,100,\n2026/1/6,交通,200,\n"
+    rows, _ = import_rows(text, category_map={"食費": "food"})
+    assert [e.category for e in rows] == ["food", "交通"]
+
+
+def test_custom_mapping_and_extra_columns_ignored():
+    text = "when,kind,yen,shop,extra\n2026/1/5,A,10,S,zzz\n"
+    mapping = {"date": "when", "category": "kind", "amount": "yen", "memo": "shop"}
+    rows, errors = import_rows(text, mapping)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "A", 10, "S")]
+
+
+def test_memo_optional_in_mapping():
+    text = "d,c,a,x\n2026/1/5,食費,100,ignored\n"
+    rows, errors = import_rows(text, {"date": "d", "category": "c", "amount": "a"})
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+@pytest.mark.parametrize("missing", ["date", "category", "amount"])
+def test_mapping_missing_required_key_raises(missing):
+    mapping = {k: v for k, v in DEFAULT_MAPPING.items() if k != missing}
+    with pytest.raises(ValueError):
+        import_rows(HDR, mapping)
+
+
+def test_mapping_column_not_in_header_raises():
+    with pytest.raises(ValueError):
+        import_rows("日付,分類,金額\n", None)
+
+
+def test_none_mapping_uses_default():
+    rows, errors = import_rows(HDR + "2026/1/5,食費,100,店\n", None)
+    assert errors == []
+    assert len(rows) == 1
+
+
+def test_errors_recorded_in_field_order_per_row():
+    text = HDR + "bad,,xyz,店\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "date"), (2, "amount"), (2, "category")]
+
+
+def test_row_with_error_excluded_others_kept():
+    text = (
+        HDR
+        + "2026/1/5,食費,100,A\n2026/1/6,,200,B\n2026/1/7,交通,abc,C\n2026/1/8,交通,400,D\n"
+    )
+    rows, errors = import_rows(text)
+    assert [e.memo for e in rows] == ["A", "D"]
+    assert errors == [(3, "category"), (4, "amount")]
+
+
+def test_blank_lines_skipped_but_counted():
+    text = HDR + "\n2026/1/5,食費,100,A\n\nbad,食費,100,B\n"
+    rows, errors = import_rows(text)
+    assert [e.memo for e in rows] == ["A"]
+    assert errors == [(5, "date")]
+
+
+def test_short_row_missing_values_are_empty():
+    text = HDR + "2026/1/5,食費\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "amount")]
+
+
+def test_short_row_memo_missing_is_empty_string():
+    text = HDR + "2026/1/5,食費,100\n"
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+def test_physical_line_number_with_multiline_quoted_field():
+    text = HDR + '2026/1/5,食費,100,"改行\nあり"\n2026/1/x,食費,100,B\n'
+    rows, errors = import_rows(text)
+    assert [e.memo for e in rows] == ["改行\nあり"]
+    assert errors == [(4, "date")]
+
+
+def test_header_only_returns_empty():
+    assert import_rows(HDR) == ([], [])
+
+
+def test_empty_text_raises():
+    with pytest.raises(ValueError):
+        import_rows("")
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..70533c8
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,271 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def E(d: str, cat: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(d), category=cat, amount=amount)
+
+
+# --- month_diff ---------------------------------------------------------
+
+
+def test_month_diff_basic_values_and_pct():
+    rows = [
+        E("2026-01-05", "食費", 1000),
+        E("2026-02-05", "食費", 1200),
+    ]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    assert r == DiffRow("食費", 1000, 1200, 200, 20.0, "up")
+
+
+def test_month_diff_down_and_same_status():
+    rows = [
+        E("2026-01-05", "食費", 1000),
+        E("2026-02-05", "食費", 800),
+        E("2026-01-06", "光熱費", 500),
+        E("2026-02-06", "光熱費", 500),
+    ]
+    by_cat = {r.category: r for r in month_diff(rows, "2026-01", "2026-02")}
+    assert by_cat["食費"].status == "down"
+    assert by_cat["食費"].pct == -20.0
+    assert by_cat["光熱費"].delta == 0
+    assert by_cat["光熱費"].status == "same"
+    assert by_cat["光熱費"].pct == 0.0
+
+
+def test_month_diff_zero_prev_pct_none_and_new_status():
+    rows = [E("2026-02-01", "趣味", 300)]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    assert r == DiffRow("趣味", 0, 300, 300, None, "new")
+
+
+def test_month_diff_gone_status_pct_minus_100():
+    rows = [E("2026-01-01", "趣味", 300)]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    assert r == DiffRow("趣味", 300, 0, -300, -100.0, "gone")
+
+
+def test_status_uses_presence_not_sum_zero():
+    # prev has an entry whose amount sums to 0: not "new", and delta 0 -> "same"
+    rows = [
+        E("2026-01-01", "雑費", 0),
+        E("2026-02-01", "雑費", 0),
+    ]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    assert r.status == "same"
+    assert r.pct is None  # prev == 0
+
+
+def test_status_not_gone_when_curr_entries_sum_to_zero():
+    rows = [
+        E("2026-01-01", "雑費", 100),
+        E("2026-02-01", "雑費", 50),
+        E("2026-02-02", "雑費", -50),
+    ]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    assert r.curr == 0
+    assert r.status == "down"  # curr has entries, so not "gone"
+
+
+def test_categories_only_in_other_months_are_included_and_others_excluded():
+    rows = [
+        E("2026-01-01", "A", 10),
+        E("2026-03-01", "B", 99),  # outside both months: excluded
+    ]
+    diffs = month_diff(rows, "2026-01", "2026-02")
+    assert [r.category for r in diffs] == ["A"]
+
+
+def test_month_diff_sorted_by_abs_delta_desc_then_category():
+    rows = [
+        E("2026-01-01", "b", 100),
+        E("2026-02-01", "b", 200),  # delta +100
+        E("2026-01-01", "a", 500),
+        E("2026-02-01", "a", 400),  # delta -100
+        E("2026-02-01", "c", 1000),  # delta +1000
+        E("2026-01-01", "d", 50),
+        E("2026-02-01", "d", 50),  # delta 0
+    ]
+    cats = [r.category for r in month_diff(rows, "2026-01", "2026-02")]
+    assert cats == ["c", "a", "b", "d"]
+
+
+def test_month_diff_empty_rows_returns_empty():
+    assert month_diff([], "2026-01", "2026-02") == []
+
+
+def test_month_diff_pct_rounded_to_one_decimal():
+    rows = [
+        E("2026-01-01", "x", 3),
+        E("2026-02-01", "x", 4),
+    ]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    assert r.pct == 33.3
+
+
+def test_month_diff_negative_zero_pct_normalized():
+    # prev negative, delta 0 -> must not produce -0.0 (renders as "-0.0%")
+    rows = [
+        E("2026-01-01", "x", -100),
+        E("2026-02-01", "x", -100),
+    ]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    assert r.pct == 0.0
+    assert str(r.pct) == "0.0"
+
+
+@pytest.mark.parametrize(
+    "prev, curr",
+    [
+        ("2026-1", "2026-02"),
+        ("2026-01", "2026-2"),
+        ("2026-00", "2026-02"),
+        ("2026-13", "2026-02"),
+        ("2026/01", "2026-02"),
+        ("20260101", "2026-02"),
+        ("2026-01", ""),
+        ("abcd-01", "2026-02"),
+        (" 2026-01", "2026-02"),
+    ],
+)
+def test_month_diff_invalid_month_format_raises(prev, curr):
+    with pytest.raises(ValueError):
+        month_diff([], prev, curr)
+
+
+# --- top_movers ---------------------------------------------------------
+
+
+def _row(cat: str, delta: int, status: str) -> DiffRow:
+    return DiffRow(cat, 0, delta, delta, None, status)
+
+
+def test_top_movers_excludes_same_and_keeps_order():
+    diffs = [
+        _row("a", 500, "up"),
+        _row("b", 400, "same"),
+        _row("c", -300, "down"),
+        _row("d", 200, "new"),
+    ]
+    got = top_movers(diffs)
+    assert [r.category for r in got] == ["a", "c", "d"]
+
+
+def test_top_movers_default_n_is_3_and_takes_first_n():
+    diffs = [_row(str(i), 100 - i, "up") for i in range(5)]
+    assert [r.category for r in top_movers(diffs)] == ["0", "1", "2"]
+
+
+def test_top_movers_n_limits_after_filtering_same():
+    diffs = [
+        _row("a", 500, "same"),
+        _row("b", 400, "up"),
+        _row("c", 300, "down"),
+    ]
+    assert [r.category for r in top_movers(diffs, n=1)] == ["b"]
+
+
+def test_top_movers_n_zero_returns_empty():
+    assert top_movers([_row("a", 1, "up")], n=0) == []
+
+
+def test_top_movers_n_larger_than_list_returns_all_non_same():
+    diffs = [_row("a", 1, "up")]
+    assert top_movers(diffs, n=10) == diffs
+
+
+def test_top_movers_negative_n_raises():
+    with pytest.raises(ValueError):
+        top_movers([], n=-1)
+
+
+def test_top_movers_does_not_mutate_input():
+    diffs = [_row("a", 1, "same"), _row("b", 2, "up")]
+    snapshot = list(diffs)
+    top_movers(diffs)
+    assert diffs == snapshot
+
+
+# --- render_diff --------------------------------------------------------
+
+
+def test_render_diff_format_and_no_trailing_newline():
+    diffs = [
+        DiffRow("食費", 1000, 1300, 300, 30.0, "up"),
+        DiffRow("家賃", 2000, 0, -2000, -100.0, "gone"),
+        DiffRow("雑費", 0, 0, 0, None, "same"),
+        DiffRow("趣味", 1000, 1000, 0, 0.0, "same"),
+    ]
+    out = render_diff(diffs)
+    assert out == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "食費\t1000\t1300\t+300\t+30.0%\n"
+        "家賃\t2000\t0\t-2000\t-100.0%\n"
+        "雑費\t0\t0\t+0\t-\n"
+        "趣味\t1000\t1000\t+0\t+0.0%"
+    )
+    assert not out.endswith("\n")
+
+
+def test_render_diff_empty_is_header_only():
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_render_diff_negative_pct_has_sign():
+    out = render_diff([DiffRow("x", 100, 80, -20, -20.0, "down")])
+    assert out.splitlines()[1] == "x\t100\t80\t-20\t-20.0%"
+
+
+# --- available_months ---------------------------------------------------
+
+
+def test_available_months_sorted_unique():
+    rows = [
+        E("2026-03-01", "a", 1),
+        E("2025-12-31", "a", 1),
+        E("2026-03-20", "b", 1),
+        E("2026-01-15", "a", 1),
+        E("2026-10-01", "a", 1),
+    ]
+    assert available_months(rows) == ["2025-12", "2026-01", "2026-03", "2026-10"]
+
+
+def test_available_months_empty():
+    assert available_months([]) == []
+
+
+# --- latest_diff --------------------------------------------------------
+
+
+def test_latest_diff_uses_last_two_months():
+    rows = [
+        E("2026-01-01", "食費", 100),
+        E("2026-02-01", "食費", 200),
+        E("2026-03-01", "食費", 150),
+    ]
+    (r,) = latest_diff(rows)
+    assert r == DiffRow("食費", 200, 150, -50, -25.0, "down")
+
+
+def test_latest_diff_with_fewer_than_two_months_raises():
+    with pytest.raises(ValueError):
+        latest_diff([])
+    with pytest.raises(ValueError):
+        latest_diff([E("2026-01-01", "食費", 100), E("2026-01-02", "食費", 5)])
+
+
+def test_latest_diff_two_months_exactly():
+    rows = [E("2026-01-01", "a", 10), E("2026-02-01", "a", 10)]
+    (r,) = latest_diff(rows)
+    assert r.status == "same"
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..b5d593a
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,250 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def _e(category: str, memo: str = "", amount: int = 100) -> Expense:
+    return Expense(day=date(2026, 1, 5), category=category, amount=amount, memo=memo)
+
+
+# --- tokenize ---------------------------------------------------------------
+
+
+def test_tokenize_empty_and_whitespace_only_gives_no_tokens() -> None:
+    assert tokenize("") == []
+    assert tokenize("   \t ") == []
+
+
+def test_tokenize_whitespace_separates_and_is_not_a_token() -> None:
+    assert tokenize("  a   b ") == [("TERM", "a"), ("TERM", "b")]
+
+
+def test_tokenize_parens() -> None:
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+
+
+def test_tokenize_quote_keeps_spaces_and_parens() -> None:
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+
+
+def test_tokenize_quote_has_no_escape() -> None:
+    assert tokenize('"a\\"') == [("TERM", "a\\")]
+
+
+def test_tokenize_unclosed_quote_raises() -> None:
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_raises() -> None:
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_bare_word_stops_at_quote_or_paren() -> None:
+    assert tokenize('ab"cd"(ef)') == [
+        ("TERM", "ab"),
+        ("TERM", "cd"),
+        ("LPAREN", "("),
+        ("TERM", "ef"),
+        ("RPAREN", ")"),
+    ]
+
+
+def test_tokenize_operators_only_uppercase_exact() -> None:
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+    assert tokenize("and or not") == [
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_operator_word_must_be_whole_word() -> None:
+    assert tokenize("ANDx") == [("TERM", "ANDx")]
+    assert tokenize('"AND"') == [("TERM", "AND")]
+
+
+def test_tokenize_cat_prefix() -> None:
+    assert tokenize("cat:食費") == [("CAT", "食費")]
+
+
+def test_tokenize_cat_with_empty_value_raises() -> None:
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_tokenize_cat_is_case_sensitive_prefix() -> None:
+    assert tokenize("CAT:食費") == [("TERM", "CAT:食費")]
+
+
+def test_tokenize_cat_value_may_not_contain_spaces_unless_quoted() -> None:
+    assert tokenize("cat:食費 x") == [("CAT", "食費"), ("TERM", "x")]
+
+
+# --- matches / filter_rows: evaluation --------------------------------------
+
+
+def test_term_matches_memo_substring() -> None:
+    assert matches("ランチ", _e("食費", memo="駅前ランチ"))
+
+
+def test_term_matches_category_substring() -> None:
+    assert matches("食", _e("食費"))
+
+
+def test_term_does_not_match_amount_or_date() -> None:
+    assert not matches("100", _e("食費", amount=100))
+    assert not matches("2026", _e("食費"))
+
+
+def test_term_is_case_insensitive_via_casefold() -> None:
+    assert matches("coffee", _e("Food", memo="COFFEE beans"))
+    assert matches("STRASSE", _e("x", memo="straße"))  # casefold: ß -> ss
+
+
+def test_cat_requires_exact_category_match() -> None:
+    assert matches("cat:食費", _e("食費"))
+    assert not matches("cat:食", _e("食費"))
+    assert not matches("cat:食費", _e("食費X"))
+
+
+def test_cat_does_not_look_at_memo() -> None:
+    assert not matches("cat:ランチ", _e("食費", memo="ランチ"))
+
+
+def test_cat_is_case_insensitive() -> None:
+    assert matches("cat:food", _e("FOOD"))
+
+
+def test_quoted_term_with_space_is_substring_search() -> None:
+    assert matches('"駅前 ラン"', _e("食費", memo="駅前 ランチ"))
+    assert not matches('"駅前ラン"', _e("食費", memo="駅前 ランチ"))
+
+
+def test_and_is_implicit_between_terms() -> None:
+    e = _e("食費", memo="ランチ")
+    assert matches("食費 ランチ", e)
+    assert not matches("食費 ディナー", e)
+
+
+def test_explicit_and() -> None:
+    e = _e("食費", memo="ランチ")
+    assert matches("食費 AND ランチ", e)
+    assert not matches("食費 AND ディナー", e)
+
+
+def test_or() -> None:
+    e = _e("食費", memo="ランチ")
+    assert matches("ディナー OR ランチ", e)
+    assert not matches("ディナー OR 交通", e)
+
+
+def test_not() -> None:
+    e = _e("食費", memo="ランチ")
+    assert matches("NOT 交通", e)
+    assert not matches("NOT 食費", e)
+
+
+def test_precedence_or_lowest_then_and_then_not() -> None:
+    # a OR b AND c  ==  a OR (b AND c)
+    e = _e("x", memo="a")
+    assert matches("a OR b AND c", e)
+    # NOT a AND b  ==  (NOT a) AND b
+    assert not matches("NOT a b", _e("x", memo="a b"))
+    assert matches("NOT a b", _e("x", memo="b"))
+
+
+def test_parens_override_precedence() -> None:
+    e = _e("x", memo="a")
+    assert not matches("(a OR b) AND c", e)
+    assert matches("a OR (b AND c)", e)
+
+
+def test_nested_not() -> None:
+    assert matches("NOT NOT a", _e("x", memo="a"))
+    assert not matches("NOT NOT a", _e("x", memo="b"))
+
+
+def test_not_applies_to_parenthesized_group() -> None:
+    e = _e("食費", memo="ランチ")
+    assert not matches("NOT (食費 OR 交通)", e)
+    assert matches("NOT (交通 OR 光熱費)", e)
+
+
+def test_implicit_and_with_group_and_cat() -> None:
+    e = _e("食費", memo="ランチ")
+    assert matches("(ランチ OR ディナー) cat:食費", e)
+
+
+def test_matches_is_plain_bool() -> None:
+    assert matches("x", _e("x")) is True
+    assert matches("y", _e("x")) is False
+
+
+# --- syntax errors -----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "()",
+        "(a",
+        "a)",
+        ")a(",
+        "a OR",
+        "OR a",
+        "a AND",
+        "AND a",
+        "NOT",
+        "a NOT",
+        "a OR OR b",
+        "a AND AND b",
+        "NOT AND a",
+        "(a OR)",
+        "cat:",
+        '"unterminated',
+        '""',
+        "   ",
+        "",
+    ],
+)
+def test_syntax_errors_raise(q: str) -> None:
+    with pytest.raises(QueryError):
+        matches(q, _e("x", memo="a"))
+
+
+def test_query_error_is_value_error() -> None:
+    assert issubclass(QueryError, ValueError)
+
+
+# --- filter_rows -------------------------------------------------------------
+
+
+def test_filter_rows_keeps_input_order() -> None:
+    rows = [_e("食費", memo="b"), _e("交通", memo="a"), _e("食費", memo="a2")]
+    out = filter_rows("a", rows)
+    assert out == [rows[1], rows[2]]
+
+
+def test_filter_rows_empty_input_returns_empty() -> None:
+    assert filter_rows("食費", []) == []
+
+
+def test_filter_rows_empty_input_still_validates_query() -> None:
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
+
+
+def test_filter_rows_no_match_returns_empty_list() -> None:
+    assert filter_rows("zzz", [_e("食費", memo="a")]) == []
+
+
+def test_filter_rows_does_not_mutate_input() -> None:
+    rows = [_e("食費", memo="a"), _e("交通", memo="b")]
+    snapshot = list(rows)
+    filter_rows("a", rows)
+    assert rows == snapshot
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..9af8327
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,202 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def e(day: date, category: str = "通信", amount: int = 1000, memo: str = "") -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- add_month ---
+
+
+@pytest.mark.parametrize(
+    ("src", "expected"),
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2024, 1, 31), date(2024, 2, 29)),
+        (date(2026, 12, 15), date(2027, 1, 15)),
+        (date(2026, 3, 5), date(2026, 4, 5)),
+        (date(2026, 11, 30), date(2026, 12, 30)),
+    ],
+)
+def test_add_month(src: date, expected: date) -> None:
+    assert add_month(src) == expected
+
+
+# --- argument validation ---
+
+
+def test_min_count_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+
+
+def test_negative_tolerance_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+# --- basic detection ---
+
+
+def test_empty_input_returns_empty() -> None:
+    assert find_recurring([]) == []
+
+
+def test_three_monthly_charges_detected() -> None:
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 5)), e(date(2026, 3, 5))]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="通信",
+            amount=1000,
+            days=(date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+            next_expected=date(2026, 4, 5),
+        )
+    ]
+
+
+def test_two_occurrences_below_default_min_count_ignored() -> None:
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 5))]
+    assert find_recurring(rows) == []
+
+
+def test_two_occurrences_found_when_min_count_is_two() -> None:
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 5))]
+    result = find_recurring(rows, min_count=2)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5))
