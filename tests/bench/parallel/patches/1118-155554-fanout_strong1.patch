new file mode 100644
index 0000000..e01056c
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,93 @@
+"""Import other banks' CSV exports into Expense records."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"(-?)[¥￥]?([0-9][0-9,]*)円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    return int(m.group(1) + m.group(2).replace(",", ""))
+
+
+def parse_date(s: str) -> date:
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header = next(reader, None)
+    if header is None:
+        raise ValueError("ヘッダーがありません")
+    index: dict[str, int] = {}
+    for field, col in mapping.items():
+        if col not in header:
+            raise ValueError(f"列 {col!r} がヘッダーにありません")
+        index[field] = header.index(col)
+
+    cmap = category_map or {}
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    prev = reader.line_num
+    for row in reader:
+        lineno = prev + 1
+        prev = reader.line_num
+        if not row:
+            continue
+
+        def get(field: str, row: list[str] = row) -> str:
+            i = index.get(field)
+            return row[i] if i is not None and i < len(row) else ""
+
+        bad = False
+        day = None
+        amount = 0
+        try:
+            day = parse_date(get("date"))
+        except ValueError:
+            errors.append((lineno, "date"))
+            bad = True
+        try:
+            amount = parse_amount(get("amount"))
+        except ValueError:
+            errors.append((lineno, "amount"))
+            bad = True
+        category = get("category").strip()
+        if not category:
+            errors.append((lineno, "category"))
+            bad = True
+        if bad or day is None:
+            continue
+        expenses.append(
+            Expense(day, cmap.get(category, category), amount, get("memo").strip())
+        )
+    return expenses, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
