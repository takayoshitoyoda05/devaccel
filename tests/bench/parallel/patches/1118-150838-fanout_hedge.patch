+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,94 @@
+"""Month-over-month comparison of expenses by category."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not isinstance(month, str) or not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+
+    prev_sum: dict[str, int] = {}
+    curr_sum: dict[str, int] = {}
+    for e in rows:
+        m = e.day.strftime("%Y-%m")
+        if m == prev_month:
+            prev_sum[e.category] = prev_sum.get(e.category, 0) + e.amount
+        elif m == curr_month:
+            curr_sum[e.category] = curr_sum.get(e.category, 0) + e.amount
+
+    out: list[DiffRow] = []
+    for cat in set(prev_sum) | set(curr_sum):
+        prev = prev_sum.get(cat, 0)
+        curr = curr_sum.get(cat, 0)
+        delta = curr - prev
+        pct = None if prev == 0 else round(delta / prev * 100, 1)
+        if cat not in prev_sum:
+            status = "new"
+        elif cat not in curr_sum:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+
+    out.sort(key=lambda r: (-abs(r.delta), r.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [r for r in diffs if r.status != "same"][:n]
+
+
+def _fmt_pct(pct: float | None) -> str:
+    if pct is None:
+        return "-"
+    if pct == 0:
+        pct = 0.0  # avoid "-0.0%" from a tiny negative rounding to zero
+    return f"{pct:+.1f}%"
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for r in diffs:
+        lines.append(
+            f"{r.category}\t{r.prev}\t{r.curr}\t{r.delta:+d}\t{_fmt_pct(r.pct)}"
+        )
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({e.day.strftime("%Y-%m") for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には明細のある月が 2 つ以上必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..140d61a
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,171 @@
+"""Search query language: tokenizer, parser and evaluator for expenses.
+
+Grammar (lowest to highest precedence: OR < AND < NOT):
+    or_expr   := and_expr ("OR" and_expr)*
+    and_expr  := not_expr (["AND"] not_expr)*
+    not_expr  := "NOT" not_expr | primary
+    primary   := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+
+class QueryError(ValueError):
+    """Raised when a search query cannot be tokenized or parsed."""
+
+
+Token = tuple[str, str]
+
+_WORD_END = frozenset(' \t\r\n()"')
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    tokens: list[Token] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError("引用符が閉じられていません")
+            body = q[i + 1 : end]
+            if body == "":
+                raise QueryError("空の引用は使えません")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            j = i
+            while j < n and q[j] not in _WORD_END:
+                j += 1
+            word = q[i:j]
+            i = j
+            if word in ("AND", "OR", "NOT"):
+                tokens.append((word, word))
+            elif word.startswith("cat:"):
+                cat = word[len("cat:") :]
+                if cat == "":
+                    raise QueryError("cat: の後ろに値がありません")
+                tokens.append(("CAT", cat))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+@dataclass(frozen=True)
+class _Node:
+    kind: str  # "TERM" | "CAT" | "NOT" | "AND" | "OR"
+    value: str = ""
+    children: tuple[_Node, ...] = ()
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self._tokens = tokens
+        self._pos = 0
+
+    def _peek(self) -> str | None:
+        return self._tokens[self._pos][0] if self._pos < len(self._tokens) else None
+
+    def _next(self) -> Token:
+        tok = self._tokens[self._pos]
+        self._pos += 1
+        return tok
+
+    def parse(self) -> _Node:
+        if not self._tokens:
+            raise QueryError("検索条件が空です")
+        node = self._or_expr()
+        if self._pos != len(self._tokens):
+            raise QueryError(f"想定外のトークンです: {self._tokens[self._pos][1]!r}")
+        return node
+
+    def _or_expr(self) -> _Node:
+        left = self._and_expr()
+        while self._peek() == "OR":
+            self._next()
+            right = self._and_expr()
+            left = _Node("OR", children=(left, right))
+        return left
+
+    def _and_expr(self) -> _Node:
+        left = self._not_expr()
+        while True:
+            kind = self._peek()
+            if kind == "AND":
+                self._next()
+                right = self._not_expr()
+            elif kind in ("TERM", "CAT", "NOT", "LPAREN"):
+                right = self._not_expr()
+            else:
+                break
+            left = _Node("AND", children=(left, right))
+        return left
+
+    def _not_expr(self) -> _Node:
+        if self._peek() == "NOT":
+            self._next()
+            return _Node("NOT", children=(self._not_expr(),))
+        return self._primary()
+
+    def _primary(self) -> _Node:
+        kind = self._peek()
+        if kind is None:
+            raise QueryError("項がありません")
+        if kind in ("TERM", "CAT"):
+            _, value = self._next()
+            return _Node(kind, value=value)
+        if kind == "LPAREN":
+            self._next()
+            if self._peek() == "RPAREN":
+                raise QueryError("空の括弧は使えません")
+            inner = self._or_expr()
+            if self._peek() != "RPAREN":
+                raise QueryError("括弧が閉じられていません")
+            self._next()
+            return inner
+        if kind == "RPAREN":
+            raise QueryError("対応する開き括弧がありません")
+        raise QueryError(
+            f"項が必要な位置に演算子があります: {self._tokens[self._pos][1]!r}"
+        )
+
+
+def _eval(node: _Node, e: Expense) -> bool:
+    if node.kind == "TERM":
+        needle = node.value.casefold()
+        return needle in e.memo.casefold() or needle in e.category.casefold()
+    if node.kind == "CAT":
+        return node.value.casefold() == e.category.casefold()
+    if node.kind == "NOT":
+        return not _eval(node.children[0], e)
+    if node.kind == "AND":
+        return _eval(node.children[0], e) and _eval(node.children[1], e)
+    if node.kind == "OR":
+        return _eval(node.children[0], e) or _eval(node.children[1], e)
+    raise QueryError(f"未知のノードです: {node.kind}")  # pragma: no cover
+
+
+def _compile(q: str) -> _Node:
+    return _Parser(tokenize(q)).parse()
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _eval(_compile(q), e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    tree = _compile(q)
+    return [e for e in rows if _eval(tree, e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..b0e1ae2
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,69 @@
+"""Detect recurring expenses (same category and amount, roughly monthly)."""
+
+from __future__ import annotations
+
+import calendar
+from collections import defaultdict
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day in the next month, clamped to that month's last day."""
+    year, month = (d.year, d.month + 1) if d.month < 12 else (d.year + 1, 1)
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def _runs(days: list[date], tolerance: int) -> list[list[date]]:
+    """Split sorted unique dates into maximal runs where neighbours are linked."""
+    runs: list[list[date]] = []
+    for d in days:
+        if runs and abs((d - add_month(runs[-1][-1])).days) <= tolerance:
+            runs[-1].append(d)
+        else:
+            runs.append([d])
+    return runs
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    """Find (category, amount) series that recur monthly on about the same day.
+
+    Raises ValueError if min_count < 2 or tolerance < 0.
+    """
+    if min_count < 2:
+        raise ValueError(f"min_count は 2 以上である必要があります: {min_count}")
+    if tolerance < 0:
+        raise ValueError(f"tolerance は 0 以上である必要があります: {tolerance}")
+
+    groups: dict[tuple[str, int], set[date]] = defaultdict(set)
+    for row in rows:
+        groups[(row.category, row.amount)].add(row.day)
+
+    result: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        for run in _runs(sorted(day_set), tolerance):
+            if len(run) >= min_count:
+                result.append(
+                    Recurring(
+                        category=category,
+                        amount=amount,
+                        days=tuple(run),
+                        next_expected=add_month(run[-1]),
+                    )
+                )
+
+    result.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return result
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..d2b2d31
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,125 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+HEADER = "利用日,分類,利用金額,利用店名,備考\n"
+
+
+@pytest.mark.parametrize(
+    "text, expected",
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥1,000", 1000),
+        ("-1,200円", -1200),
+    ],
+)
+def test_parse_amount_accepts(text, expected):
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    ["", "円", "12.5", "1 200", "--5", "¥-5", "１２３", "-", "¥", ",", "5円円"],
+)
+def test_parse_amount_rejects(text):
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+@pytest.mark.parametrize(
+    "text, expected",
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/12/31 ", date(2026, 12, 31)),
+        ("2026-1-5", date(2026, 1, 5)),
+    ],
+)
+def test_parse_date_accepts(text, expected):
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    ["2026/1-5", "26/1/5", "2026/02/30", "", "2026.1.5", "２０２６/1/5", "2026/13/1"],
+)
+def test_parse_date_rejects(text):
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+def test_import_rows_default_mapping_and_extra_columns():
+    text = (
+        HEADER
+        + '2026/11/1,食費,"1,200円",スーパー A,x\n'
+        + "2026-11-02, 交通費 ,￥300, 駅 ,y\n"
+    )
+    expenses, errors = import_rows(text)
+    assert errors == []
+    assert expenses == [
+        Expense(date(2026, 11, 1), "食費", 1200, "スーパー A"),
+        Expense(date(2026, 11, 2), "交通費", 300, "駅"),
+    ]
+
+
+def test_import_rows_reports_all_errors_per_row_with_physical_lines():
+    text = (
+        HEADER
+        + "2026/11/01,食費,100,ok\n"  # line 2 ok
+        + "\n"  # line 3 blank, skipped
+        + "bad,  ,abc,m\n"  # line 4: date, amount, category
+        + "2026/11/03,,500,m\n"  # line 5: category
+        + '"2026/11/04",食費\n'  # line 6: amount and memo missing
+    )
+    expenses, errors = import_rows(text)
+    assert expenses == [Expense(date(2026, 11, 1), "食費", 100, "ok")]
+    assert errors == [
+        (4, "date"),
+        (4, "amount"),
+        (4, "category"),
+        (5, "category"),
+        (6, "amount"),
+    ]
+
+
+def test_import_rows_category_map_and_quoted_multiline_keeps_order():
+    text = HEADER + '2026/11/01,"コンビニ",100,"a,b"\n2026/11/02,食費,200,c\n'
+    expenses, errors = import_rows(
+        text, category_map={"コンビニ": "食費", "食費": "食料"}
+    )
+    assert errors == []
+    assert [e.category for e in expenses] == ["食費", "食料"]
+    assert expenses[0].memo == "a,b"
+
+
+def test_import_rows_custom_mapping_memo_optional():
+    text = "d,c,a\n2026/11/01,食費,50\n"
+    expenses, errors = import_rows(
+        text, mapping={"date": "d", "category": "c", "amount": "a"}
+    )
+    assert errors == []
+    assert expenses == [Expense(date(2026, 11, 1), "食費", 50, "")]
+
+
+def test_import_rows_missing_required_key_raises():
+    with pytest.raises(ValueError):
+        import_rows(HEADER, mapping={"date": "利用日", "amount": "利用金額"})
+
+
+def test_import_rows_missing_column_in_header_raises():
+    with pytest.raises(ValueError):
+        import_rows("a,b\n1,2\n", mapping=DEFAULT_MAPPING)
+
+
+def test_import_rows_memo_column_missing_in_header_raises():
+    with pytest.raises(ValueError):
+        import_rows(
+            "d,c,a\n",
+            mapping={"date": "d", "category": "c", "amount": "a", "memo": "m"},
+        )
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..72d4197
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,150 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def E(day: str, cat: str, amount: int) -> Expense:
+    return Expense(date.fromisoformat(day), cat, amount, "")
+
+
+ROWS = [
+    E("2026-10-05", "food", 1000),
+    E("2026-10-20", "food", 500),
+    E("2026-10-03", "rent", 5000),
+    E("2026-10-09", "fun", 300),
+    E("2026-11-02", "food", 1200),
+    E("2026-11-04", "rent", 5000),
+    E("2026-11-07", "travel", 800),
+    E("2026-11-09", "fun", 0),
+]
+
+
+def _by_cat(diffs):
+    return {r.category: r for r in diffs}
+
+
+def test_month_diff_rows_and_fields():
+    d = _by_cat(month_diff(ROWS, "2026-10", "2026-11"))
+    assert d["food"] == DiffRow("food", 1500, 1200, -300, -20.0, "down")
+    assert d["rent"] == DiffRow("rent", 5000, 5000, 0, 0.0, "same")
+    assert d["travel"] == DiffRow("travel", 0, 800, 800, None, "new")
+    assert d["fun"] == DiffRow("fun", 300, 0, -300, -100.0, "down")
+
+
+def test_status_is_presence_based_not_sum_based():
+    rows = [E("2026-10-01", "x", 0), E("2026-11-01", "y", 10)]
+    d = _by_cat(month_diff(rows, "2026-10", "2026-11"))
+    assert d["x"].status == "gone"
+    assert d["x"].pct is None
+    assert d["y"].status == "new"
+
+
+def test_zero_sum_on_both_sides_is_same_not_up_down():
+    rows = [E("2026-10-01", "z", 0), E("2026-11-01", "z", 0)]
+    (r,) = month_diff(rows, "2026-10", "2026-11")
+    assert r.status == "same"
+    assert r.pct is None
+
+
+def test_status_up_and_gone():
+    rows = [
+        E("2026-10-01", "a", 100),
+        E("2026-11-01", "a", 150),
+        E("2026-10-02", "b", 7),
+    ]
+    d = _by_cat(month_diff(rows, "2026-10", "2026-11"))
+    assert d["a"].status == "up"
+    assert d["a"].pct == 50.0
+    assert d["b"].status == "gone"
+    assert d["b"].pct == -100.0
+
+
+def test_sort_by_abs_delta_desc_then_category():
+    rows = [
+        E("2026-10-01", "b", 100),
+        E("2026-11-01", "b", 200),  # delta +100
+        E("2026-10-01", "a", 300),
+        E("2026-11-01", "a", 200),  # delta -100
+        E("2026-11-01", "c", 500),  # delta +500
+    ]
+    cats = [r.category for r in month_diff(rows, "2026-10", "2026-11")]
+    assert cats == ["c", "a", "b"]
+
+
+def test_month_diff_rejects_bad_month_format():
+    for bad in ["2026-1", "2026-13", "2026-00", "202611", "2026/11", "26-11-01"]:
+        with pytest.raises(ValueError):
+            month_diff(ROWS, bad, "2026-11")
+        with pytest.raises(ValueError):
+            month_diff(ROWS, "2026-10", bad)
+
+
+def test_top_movers_skips_same_and_keeps_order():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    got = [r.category for r in top_movers(diffs, 2)]
+    assert got == [
+        "travel",
+        "food",
+    ]  # abs deltas 800, 300 (fun also 300, but food < fun by name)
+    assert all(r.status != "same" for r in top_movers(diffs, 10))
+    assert "rent" not in [r.category for r in top_movers(diffs, 10)]
+
+
+def test_top_movers_default_n_and_negative_n():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    assert len(top_movers(diffs)) == 3
+    assert top_movers(diffs, 0) == []
+    with pytest.raises(ValueError):
+        top_movers(diffs, -1)
+
+
+def test_render_diff_format():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    text = render_diff(diffs)
+    lines = text.split("\n")
+    assert lines[0] == "category\tprev\tcurr\tdelta\tpct"
+    assert lines[1:] == [
+        "travel\t0\t800\t+800\t-",
+        "food\t1500\t1200\t-300\t-20.0%",
+        "fun\t300\t0\t-300\t-100.0%",
+        "rent\t5000\t5000\t+0\t+0.0%",
+    ]
+    assert not text.endswith("\n")
+
+
+def test_render_diff_positive_pct_and_negative_delta_sign():
+    rows = [E("2026-10-01", "a", 1000), E("2026-11-01", "a", 1200)]
+    text = render_diff(month_diff(rows, "2026-10", "2026-11"))
+    assert text.split("\n")[1] == "a\t1000\t1200\t+200\t+20.0%"
+
+
+def test_render_diff_empty_has_only_header():
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_available_months_sorted_unique():
+    assert available_months(ROWS) == ["2026-10", "2026-11"]
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months():
+    rows = ROWS + [E("2026-09-01", "food", 9999)]
+    assert available_months(rows) == ["2026-09", "2026-10", "2026-11"]
+    assert latest_diff(rows) == month_diff(ROWS, "2026-10", "2026-11")
+
+
+def test_latest_diff_requires_two_months():
+    with pytest.raises(ValueError):
+        latest_diff([])
+    with pytest.raises(ValueError):
+        latest_diff([E("2026-10-01", "a", 1), E("2026-10-02", "a", 2)])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..a99072b
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,165 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def _e(category, memo="", amount=100):
+    return Expense(day=date(2026, 11, 1), category=category, amount=amount, memo=memo)
+
+
+ROWS = [
+    _e("food", "Lunch at Cafe"),
+    _e("transport", "train pass"),
+    _e("Food", "dinner"),
+    _e("books", "Cafe novel"),
+]
+
+
+# --- tokenize ---
+
+
+def test_tokenize_splits_on_whitespace_and_parens():
+    assert tokenize(" a (b) ") == [
+        ("TERM", "a"),
+        ("LPAREN", "("),
+        ("TERM", "b"),
+        ("RPAREN", ")"),
+    ]
+
+
+def test_tokenize_quoted_term_keeps_spaces_and_parens():
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+
+
+def test_tokenize_operators_only_uppercase():
+    assert tokenize("AND OR NOT and or not") == [
+        ("AND", "AND"),
+        ("OR", "OR"),
+        ("NOT", "NOT"),
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_cat_prefix():
+    assert tokenize("cat:food") == [("CAT", "food")]
+
+
+def test_tokenize_empty_cat_is_error():
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_tokenize_unclosed_quote_is_error():
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_is_error():
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_empty_input_gives_no_tokens():
+    assert tokenize("   ") == []
+
+
+# --- parsing errors ---
+
+
+@pytest.mark.parametrize(
+    "q",
+    ["", "   ", "()", "(a", "a)", "a AND", "OR a", "NOT", "a OR", "(a OR)", "NOT )"],
+)
+def test_invalid_queries_raise(q):
+    with pytest.raises(QueryError):
+        filter_rows(q, ROWS)
+
+
+def test_invalid_query_raises_even_with_no_rows():
+    with pytest.raises(QueryError):
+        filter_rows("a AND", [])
+
+
+# --- evaluation ---
+
+
+def test_term_matches_memo_or_category_case_insensitively():
+    assert [e.memo for e in filter_rows("cafe", ROWS)] == [
+        "Lunch at Cafe",
+        "Cafe novel",
+    ]
+    assert [e.category for e in filter_rows("FOOD", ROWS)] == ["food", "Food"]
+
+
+def test_term_matches_substring():
+    assert matches("pass", ROWS[1])
+    assert not matches("pass", ROWS[0])
+
+
+def test_cat_requires_exact_category_casefolded():
+    assert [e.memo for e in filter_rows("cat:food", ROWS)] == [
+        "Lunch at Cafe",
+        "dinner",
+    ]
+    assert filter_rows("cat:foo", ROWS) == []
+
+
+def test_quoted_term_with_space():
+    assert [e.memo for e in filter_rows('"train pass"', ROWS)] == ["train pass"]
+
+
+def test_implicit_and_between_terms():
+    assert [e.memo for e in filter_rows("cafe lunch", ROWS)] == ["Lunch at Cafe"]
+
+
+def test_explicit_and_same_as_implicit():
+    assert filter_rows("cafe AND lunch", ROWS) == filter_rows("cafe lunch", ROWS)
+
+
+def test_or():
+    got = filter_rows("cat:transport OR cat:books", ROWS)
+    assert [e.category for e in got] == ["transport", "books"]
+
+
+def test_not_binds_tighter_than_and():
+    got = filter_rows("NOT cat:food cafe", ROWS)
+    assert [e.memo for e in got] == ["Cafe novel"]
+
+
+def test_and_binds_tighter_than_or():
+    # cat:transport OR (cat:books AND cafe) -> transport row + books row
+    got = filter_rows("cat:transport OR cat:books cafe", ROWS)
+    assert [e.category for e in got] == ["transport", "books"]
+    # (cat:food AND cafe) OR cat:transport -> without precedence this would differ
+    got = filter_rows("cat:food cafe OR cat:transport", ROWS)
+    assert [e.memo for e in got] == ["Lunch at Cafe", "train pass"]
+
+
+def test_parentheses_override_precedence():
+    got = filter_rows("cat:food (cafe OR dinner)", ROWS)
+    assert [e.memo for e in got] == ["Lunch at Cafe", "dinner"]
+
+
+def test_double_not():
+    got = filter_rows("NOT NOT cat:books", ROWS)
+    assert [e.category for e in got] == ["books"]
+
+
+def test_filter_rows_keeps_input_order():
+    rows = [_e("b", "x"), _e("a", "x"), _e("c", "x")]
+    assert filter_rows("x", rows) == rows
+
+
+def test_filter_rows_empty_input_returns_empty():
+    assert filter_rows("cafe", []) == []
+
+
+def test_matches_single_expense():
+    assert matches("cafe", ROWS[0])
+    assert not matches("cafe", ROWS[1])
+    assert matches("NOT cat:food", ROWS[1])
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..aef2403
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,132 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def e(day: str, category: str = "rent", amount: int = 80000, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+@pytest.mark.parametrize(
+    ("start", "expected"),
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2024, 1, 31), date(2024, 2, 29)),
+        (date(2026, 12, 15), date(2027, 1, 15)),
+        (date(2026, 3, 30), date(2026, 4, 30)),
+        (date(2026, 4, 15), date(2026, 5, 15)),
+    ],
+)
+def test_add_month(start: date, expected: date) -> None:
+    assert add_month(start) == expected
+
+
+def test_detects_monthly_series() -> None:
+    rows = [e("2026-01-05"), e("2026-02-05"), e("2026-03-05")]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="rent",
+            amount=80000,
+            days=(date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+            next_expected=date(2026, 4, 5),
+        )
+    ]
+
+
+def test_memo_is_ignored_and_duplicates_collapse() -> None:
+    rows = [
+        e("2026-01-05", memo="a"),
+        e("2026-01-05", memo="b"),
+        e("2026-02-05"),
+        e("2026-03-05", memo="c"),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_below_min_count_is_not_reported() -> None:
+    rows = [e("2026-01-05"), e("2026-02-05")]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_count=2)) == 1
+
+
+def test_tolerance_allows_day_drift() -> None:
+    # 02-08 is 3 days after 01-05's month-shift (02-05); 03-07 is 1 day before 03-08.
+    rows = [e("2026-01-05"), e("2026-02-08"), e("2026-03-07")]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+    assert find_recurring(rows, tolerance=2) == []
+
+
+def test_gap_splits_runs() -> None:
+    # Jan-Mar is one run of 3; the isolated May entry breaks the chain.
+    rows = [
+        e("2026-01-05"),
+        e("2026-02-05"),
+        e("2026-03-05"),
+        e("2026-05-05"),
+        e("2026-06-05"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+    assert result[0].next_expected == date(2026, 4, 5)
+
+
+def test_run_split_yields_two_series() -> None:
+    rows = [
+        e("2026-01-05"),
+        e("2026-02-05"),
+        e("2026-03-05"),
+        e("2026-06-05"),
+        e("2026-07-05"),
+        e("2026-08-05"),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 5), date(2026, 6, 5)]
+
+
+def test_month_end_clamping_is_linked() -> None:
+    rows = [e("2026-01-31"), e("2026-02-28"), e("2026-03-31")]
+    (r,) = find_recurring(rows)
+    assert r.next_expected == date(2026, 4, 30)
+
+
+def test_groups_by_category_and_amount() -> None:
+    rows = [
+        e("2026-01-05", category="rent", amount=80000),
+        e("2026-02-05", category="rent", amount=80000),
+        e("2026-03-05", category="rent", amount=80000),
+        e("2026-01-10", category="gym", amount=8000),
+        e("2026-02-10", category="gym", amount=9000),
+        e("2026-03-10", category="gym", amount=8000),
+    ]
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [("rent", 80000)]
+
+
+def test_result_order() -> None:
+    rows = []
+    for cat, amt, day in [
+        ("water", 1000, "05"),
+        ("gas", 2000, "20"),
+        ("gas", 1000, "20"),
+    ]:
+        for m in ("01", "02", "03"):
+            rows.append(e(f"2026-{m}-{day}", category=cat, amount=amt))
+    result = [(r.category, r.amount) for r in find_recurring(rows)]
+    assert result == [("gas", 1000), ("gas", 2000), ("water", 1000)]
+
+
+def test_empty_input() -> None:
+    assert find_recurring([]) == []
+
+
+@pytest.mark.parametrize(("min_count", "tolerance"), [(1, 3), (0, 3), (3, -1)])
+def test_invalid_arguments_raise(min_count: int, tolerance: int) -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=min_count, tolerance=tolerance)
