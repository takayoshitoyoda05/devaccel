new file mode 100644
index 0000000..56d36e2
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,112 @@
+"""Import bank statement CSV (他行 CSV) into Expense records."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+# YYYY/M/D or YYYY-M-D (same separator both times, ASCII digits only)
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+# optional "-", optional ¥/￥, digits and commas starting with a digit, optional 円
+_AMOUNT_RE = re.compile(r"(-?)[¥￥]?([0-9][0-9,]*)円?")
+
+
+def parse_amount(s: str) -> int:
+    """Parse a bank amount such as "￥1,234" or "-300円" into yen."""
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    value = int(m.group(2).replace(",", ""))
+    return -value if m.group(1) else value
+
+
+def parse_date(s: str) -> date:
+    """Parse "YYYY/M/D" or "YYYY-M-D" into a date."""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    try:
+        return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def _cell(row: list[str], index: int) -> str:
+    return row[index] if index < len(row) else ""
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Convert bank CSV text (first line is the header).
+
+    Returns (valid expenses in input order, errors as (physical line, field)).
+    Rows with any error are excluded from the expenses.
+    """
+    cols = DEFAULT_MAPPING if mapping is None else mapping
+    for key in ("date", "category", "amount"):
+        if key not in cols:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text))
+    try:
+        header = next(reader)
+    except StopIteration:
+        raise ValueError("CSV にヘッダー行がありません") from None
+
+    index: dict[str, int] = {}
+    for field in ("date", "category", "amount", "memo"):
+        if field not in cols:
+            continue
+        col = cols[field]
+        if col not in header:
+            raise ValueError(f"CSV のヘッダーに列 {col!r} がありません")
+        index[field] = header.index(col)
+
+    rows: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    while True:
+        # physical line where the next record starts (blank lines count)
+        lineno = reader.line_num + 1
+        try:
+            row = next(reader)
+        except StopIteration:
+            break
+        if not row or (len(row) == 1 and not row[0].strip()):
+            continue
+
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(_cell(row, index["date"]))
+        except ValueError:
+            errors.append((lineno, "date"))
+        try:
+            amount = parse_amount(_cell(row, index["amount"]))
+        except ValueError:
+            errors.append((lineno, "amount"))
+        category = _cell(row, index["category"]).strip()
+        if not category:
+            errors.append((lineno, "category"))
+        if day is None or amount is None or not category:
+            continue
+
+        memo = _cell(row, index["memo"]).strip() if "memo" in index else ""
+        if category_map is not None:
+            category = category_map.get(category, category)
+        rows.append(Expense(day=day, category=category, amount=amount, memo=memo))
+    return rows, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
new file mode 100644
index 0000000..3891430
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,102 @@
+"""Month-over-month category diff report."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def _month_of(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+
+    prev_tot: dict[str, int] = {}
+    curr_tot: dict[str, int] = {}
+    prev_seen: set[str] = set()
+    curr_seen: set[str] = set()
+    for e in rows:
+        m = _month_of(e)
+        if m == prev_month:
+            prev_tot[e.category] = prev_tot.get(e.category, 0) + e.amount
+            prev_seen.add(e.category)
+        if m == curr_month:
+            curr_tot[e.category] = curr_tot.get(e.category, 0) + e.amount
+            curr_seen.add(e.category)
+
+    out: list[DiffRow] = []
+    for cat in prev_seen | curr_seen:
+        prev = prev_tot.get(cat, 0)
+        curr = curr_tot.get(cat, 0)
+        delta = curr - prev
+        pct = None if prev == 0 else round(delta / prev * 100, 1)
+        if cat not in prev_seen:
+            status = "new"
+        elif cat not in curr_seen:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+
+    out.sort(key=lambda r: (-abs(r.delta), r.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [r for r in diffs if r.status != "same"][:n]
+
+
+def _signed_pct(pct: float | None) -> str:
+    if pct is None:
+        return "-"
+    if pct == 0:
+        pct = 0.0  # avoid rendering -0.0
+    return f"{pct:+.1f}%"
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for r in diffs:
+        lines.append(
+            f"{r.category}\t{r.prev}\t{r.curr}\t{r.delta:+d}\t{_signed_pct(r.pct)}"
+        )
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month_of(e) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には 2 か月以上の明細が必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..8c72b8c
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,162 @@
+"""Search query language for expense rows.
+
+Grammar (lowest precedence first):
+    or_expr  := and_expr ("OR" and_expr)*
+    and_expr := not_expr (["AND"] not_expr)*
+    not_expr := "NOT" not_expr | primary
+    primary  := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+from kakeibo.core import Expense
+
+
+class QueryError(ValueError):
+    """Raised when a search query cannot be tokenized or parsed."""
+
+
+Token = tuple[str, str]
+
+# AST nodes: ("term", s) | ("cat", s) | ("not", node) | ("and", l, r) | ("or", l, r)
+Node = tuple[Any, ...]
+
+_SPECIAL = ' \t\r\n()"'
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    tokens: list[Token] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError("閉じていない引用符があります")
+            body = q[i + 1 : end]
+            if body == "":
+                raise QueryError("空の引用符は使えません")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            start = i
+            while i < n and not (q[i].isspace() or q[i] in _SPECIAL):
+                i += 1
+            word = q[start:i]
+            if word == "AND":
+                tokens.append(("AND", "AND"))
+            elif word == "OR":
+                tokens.append(("OR", "OR"))
+            elif word == "NOT":
+                tokens.append(("NOT", "NOT"))
+            elif word.startswith("cat:"):
+                value = word[len("cat:") :]
+                if value == "":
+                    raise QueryError("cat: の後ろが空です")
+                tokens.append(("CAT", value))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self.tokens = tokens
+        self.pos = 0
+
+    def _peek(self) -> str | None:
+        return self.tokens[self.pos][0] if self.pos < len(self.tokens) else None
+
+    def _next(self) -> Token:
+        if self.pos >= len(self.tokens):
+            raise QueryError("クエリが途中で終わっています")
+        tok = self.tokens[self.pos]
+        self.pos += 1
+        return tok
+
+    def parse(self) -> Node:
+        if not self.tokens:
+            raise QueryError("クエリが空です")
+        node = self._or_expr()
+        if self.pos != len(self.tokens):
+            raise QueryError(f"想定外のトークンです: {self.tokens[self.pos][1]!r}")
+        return node
+
+    def _or_expr(self) -> Node:
+        node = self._and_expr()
+        while self._peek() == "OR":
+            self._next()
+            node = ("or", node, self._and_expr())
+        return node
+
+    def _and_expr(self) -> Node:
+        node = self._not_expr()
+        while True:
+            kind = self._peek()
+            if kind == "AND":
+                self._next()
+                node = ("and", node, self._not_expr())
+            elif kind in ("TERM", "CAT", "NOT", "LPAREN"):
+                node = ("and", node, self._not_expr())
+            else:
+                return node
+
+    def _not_expr(self) -> Node:
+        if self._peek() == "NOT":
+            self._next()
+            return ("not", self._not_expr())
+        return self._primary()
+
+    def _primary(self) -> Node:
+        kind, value = self._next()
+        if kind == "TERM":
+            return ("term", value)
+        if kind == "CAT":
+            return ("cat", value)
+        if kind == "LPAREN":
+            node = self._or_expr()
+            if self._peek() != "RPAREN":
+                raise QueryError("対応する ) がありません")
+            self._next()
+            return node
+        raise QueryError(f"項が必要な位置に {value!r} があります")
+
+
+def _compile(q: str) -> Node:
+    return _Parser(tokenize(q)).parse()
+
+
+def _eval(node: Node, e: Expense) -> bool:
+    op = node[0]
+    if op == "term":
+        needle = str(node[1]).casefold()
+        return needle in e.memo.casefold() or needle in e.category.casefold()
+    if op == "cat":
+        return str(node[1]).casefold() == e.category.casefold()
+    if op == "not":
+        return not _eval(node[1], e)
+    if op == "and":
+        return _eval(node[1], e) and _eval(node[2], e)
+    if op == "or":
+        return _eval(node[1], e) or _eval(node[2], e)
+    raise AssertionError(f"unknown node: {op!r}")
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _eval(_compile(q), e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    node = _compile(q)  # validate before looking at rows
+    return [e for e in rows if _eval(node, e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..0848df9
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,68 @@
+"""Detect recurring expenses: same (category, amount) at a roughly monthly interval."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day in the next month, clamped to that month's last day."""
+    if d.month == 12:
+        year, month = d.year + 1, 1
+    else:
+        year, month = d.year, d.month + 1
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def _split_runs(days: list[date], tolerance: int) -> list[list[date]]:
+    """Split ascending, unique days into maximal chains where each day is
+    within `tolerance` days of the next month's same day after the previous one."""
+    runs: list[list[date]] = []
+    for d in days:
+        if runs and abs((d - add_month(runs[-1][-1])).days) <= tolerance:
+            runs[-1].append(d)
+        else:
+            runs.append([d])
+    return runs
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError(f"min_count は 2 以上である必要があります: {min_count}")
+    if tolerance < 0:
+        raise ValueError(f"tolerance は 0 以上である必要があります: {tolerance}")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    out: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        for run in _split_runs(sorted(day_set), tolerance):
+            if len(run) >= min_count:
+                out.append(
+                    Recurring(
+                        category=category,
+                        amount=amount,
+                        days=tuple(run),
+                        next_expected=add_month(run[-1]),
+                    )
+                )
+
+    out.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return out
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..3990c71
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,205 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+HEADER = "利用日,分類,利用金額,利用店名"
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("-0", 0),
+        ("¥1000", 1000),
+        ("￥1000", 1000),
+        ("1,,2", 12),  # comma positions are not checked
+        ("1,", 1),
+        ("-￥5,000円", -5000),
+    ],
+)
+def test_parse_amount_accepts(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "   ",
+        "円",
+        "12.5",
+        "1 200",
+        "--5",
+        "¥-5",
+        "１２３",
+        "-",
+        "¥",
+        "-円5",
+        "1円円",
+        "1円 2",
+        ",1",
+        "1-",
+    ],
+)
+def test_parse_amount_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        ("2026-1-5", date(2026, 1, 5)),
+        (" 2026/12/31 ", date(2026, 12, 31)),
+        ("2024/02/29", date(2024, 2, 29)),
+    ],
+)
+def test_parse_date_accepts(text: str, expected: date) -> None:
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026/1-5",
+        "2026-1/5",
+        "26/1/5",
+        "2026/02/30",
+        "2026/2/29",
+        "2026/13/1",
+        "2026/1/0",
+        "2026/001/5",
+        "2026/1/005",
+        "２０２６/1/5",
+        "2026/1/5/",
+        "2026.1.5",
+        "",
+    ],
+)
+def test_parse_date_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+def test_default_mapping() -> None:
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_import_basic_default_mapping() -> None:
+    text = f'{HEADER}\n2026/1/5,食費,"1,200円",ラーメン\n'
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 1200, "ラーメン")]
+    assert errors == []
+
+
+def test_import_empty_header_only_gives_nothing() -> None:
+    assert import_rows(f"{HEADER}\n") == ([], [])
+
+
+def test_import_empty_text_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows("")
+
+
+def test_import_custom_mapping_column_order_and_extra_columns() -> None:
+    text = "残高,店,金額,日付,備考\n5000,Shop,300,2026-02-03,x\n"
+    mapping = {"date": "日付", "category": "店", "amount": "金額"}
+    rows, errors = import_rows(text, mapping)
+    assert rows == [Expense(date(2026, 2, 3), "Shop", 300, "")]
+    assert errors == []
+
+
+def test_import_mapping_missing_required_key_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows(f"{HEADER}\n", {"date": "利用日", "amount": "利用金額"})
+
+
+def test_import_mapping_column_not_in_header_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows(
+            f"{HEADER}\n", {"date": "無い列", "category": "分類", "amount": "利用金額"}
+        )
+
+
+def test_import_mapping_memo_column_not_in_header_raises() -> None:
+    mapping = {**DEFAULT_MAPPING, "memo": "無い列"}
+    with pytest.raises(ValueError):
+        import_rows(f"{HEADER}\n", mapping)
+
+
+def test_import_memo_optional_in_mapping() -> None:
+    mapping = {"date": "利用日", "category": "分類", "amount": "利用金額"}
+    text = f"{HEADER}\n2026/1/5,食費,100,店\n"
+    rows, errors = import_rows(text, mapping)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "")]
+    assert errors == []
+
+
+def test_import_strips_category_and_memo_and_applies_category_map() -> None:
+    text = f"{HEADER}\n2026/1/5,  食料品  , 100 ,   スーパー  \n"
+    rows, errors = import_rows(text, category_map={"食料品": "食費"})
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "スーパー")]
+    assert errors == []
+
+
+def test_import_category_map_only_for_matching_keys() -> None:
+    text = f"{HEADER}\n2026/1/5,娯楽,100,x\n"
+    rows, _ = import_rows(text, category_map={"食料品": "食費"})
+    assert rows[0].category == "娯楽"
+
+
+def test_import_quoted_comma_values() -> None:
+    text = f'{HEADER}\n2026/1/5,"食費, 外食","1,200円","ラーメン, 店"\n'
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費, 外食", 1200, "ラーメン, 店")]
+    assert errors == []
+
+
+def test_import_errors_are_recorded_in_order_per_row() -> None:
+    text = f"{HEADER}\n2026/2/30,  ,abc,x\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "date"), (2, "amount"), (2, "category")]
+
+
+def test_import_invalid_row_excluded_valid_rows_kept_in_order() -> None:
+    text = f"{HEADER}\n2026/1/5,A,1,a\n2026/1/x,B,2,b\n2026/1/7,C,3,c\n"
+    rows, errors = import_rows(text)
+    assert [r.category for r in rows] == ["A", "C"]
+    assert errors == [(3, "date")]
+
+
+def test_import_missing_columns_treated_as_empty() -> None:
+    text = f"{HEADER}\n2026/1/5,食費\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "amount")]
+
+
+def test_import_blank_lines_skipped_but_counted() -> None:
+    text = f"{HEADER}\n\n2026/1/5,A,1,a\n\n2026/1/6,B,x,b\n"
+    rows, errors = import_rows(text)
+    assert [r.category for r in rows] == ["A"]
+    assert errors == [(5, "amount")]
+
+
+def test_import_multiline_record_reports_its_starting_line() -> None:
+    text = f'{HEADER}\n2026/1/5,食費,100,"a\nb"\n\n2026/1/6,食費,x,c\n'
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "a\nb")]
+    assert errors == [(5, "amount")]
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..e88abff
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,202 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def e(d: str, cat: str, amt: int) -> Expense:
+    return Expense(date.fromisoformat(d), cat, amt)
+
+
+def test_month_diff_basic_statuses_pct_and_order() -> None:
+    rows = [
+        e("2026-01-05", "food", 1000),
+        e("2026-01-06", "rent", 5000),
+        e("2026-02-05", "food", 1300),
+        e("2026-02-06", "rent", 5000),
+        e("2026-02-07", "utilities", 800),
+    ]
+    diffs = month_diff(rows, "2026-01", "2026-02")
+    assert diffs == [
+        DiffRow("utilities", 0, 800, 800, None, "new"),
+        DiffRow("food", 1000, 1300, 300, 30.0, "up"),
+        DiffRow("rent", 5000, 5000, 0, 0.0, "same"),
+    ]
+
+
+def test_gone_category_has_minus_100_pct() -> None:
+    rows = [e("2026-01-05", "travel", 2000), e("2026-02-05", "food", 100)]
+    diffs = month_diff(rows, "2026-01", "2026-02")
+    assert DiffRow("travel", 2000, 0, -2000, -100.0, "gone") in diffs
+    assert DiffRow("food", 0, 100, 100, None, "new") in diffs
+
+
+def test_status_uses_presence_not_sum() -> None:
+    # prev has food rows summing to 0 -> present, so not "new"; prev_total 0 -> pct None
+    rows = [
+        e("2026-01-01", "food", 500),
+        e("2026-01-02", "food", -500),
+        e("2026-02-01", "food", 100),
+    ]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row == DiffRow("food", 0, 100, 100, None, "up")
+
+
+def test_curr_present_but_sum_zero_is_not_gone() -> None:
+    rows = [
+        e("2026-01-01", "food", 100),
+        e("2026-02-01", "food", 50),
+        e("2026-02-02", "food", -50),
+    ]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row == DiffRow("food", 100, 0, -100, -100.0, "down")
+
+
+def test_zero_delta_is_same() -> None:
+    rows = [e("2026-01-01", "food", 100), e("2026-02-01", "food", 100)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row.status == "same"
+    assert row.delta == 0
+    assert row.pct == 0.0
+
+
+def test_empty_rows_gives_empty_list() -> None:
+    assert month_diff([], "2026-01", "2026-02") == []
+
+
+def test_order_by_abs_delta_desc_then_category_asc() -> None:
+    rows = [
+        e("2026-01-01", "b", 100),
+        e("2026-02-01", "b", 200),  # +100
+        e("2026-01-01", "a", 500),
+        e("2026-02-01", "a", 600),  # +100 (tie -> category asc)
+        e("2026-01-01", "c", 1000),
+        e("2026-02-01", "c", 700),  # -300 (larger abs first)
+        e("2026-01-01", "d", 0),
+        e("2026-02-01", "d", 200),  # +200
+    ]
+    cats = [r.category for r in month_diff(rows, "2026-01", "2026-02")]
+    assert cats == ["c", "d", "a", "b"]
+
+
+def test_pct_rounded_to_one_decimal() -> None:
+    rows = [e("2026-01-01", "x", 3), e("2026-02-01", "x", 4)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row.pct == 33.3
+
+
+def test_same_month_both_sides() -> None:
+    rows = [e("2026-01-01", "x", 3)]
+    (row,) = month_diff(rows, "2026-01", "2026-01")
+    assert row == DiffRow("x", 3, 3, 0, 0.0, "same")
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        "2026-1",
+        "2026-13",
+        "2026-00",
+        "202601",
+        "2026/01",
+        "",
+        "26-01",
+        "2026-01 ",
+        "2026-1x",
+    ],
+)
+def test_invalid_month_format_raises(bad: str) -> None:
+    rows = [e("2026-01-01", "x", 1)]
+    with pytest.raises(ValueError):
+        month_diff(rows, bad, "2026-02")
+    with pytest.raises(ValueError):
+        month_diff(rows, "2026-01", bad)
+
+
+def test_top_movers_excludes_same_keeps_order_and_limits() -> None:
+    diffs = [
+        DiffRow("a", 0, 1, 1, None, "new"),
+        DiffRow("b", 5, 5, 0, 0.0, "same"),
+        DiffRow("c", 1, 0, -1, -100.0, "gone"),
+        DiffRow("d", 1, 2, 1, 100.0, "up"),
+        DiffRow("e", 2, 1, -1, -50.0, "down"),
+    ]
+    assert [r.category for r in top_movers(diffs)] == ["a", "c", "d"]
+    assert [r.category for r in top_movers(diffs, 2)] == ["a", "c"]
+    assert top_movers(diffs, 0) == []
+    assert [r.category for r in top_movers(diffs, 100)] == ["a", "c", "d", "e"]
+
+
+def test_top_movers_negative_n_raises() -> None:
+    with pytest.raises(ValueError):
+        top_movers([], -1)
+
+
+def test_render_diff_format() -> None:
+    diffs = [
+        DiffRow("food", 1000, 1300, 300, 30.0, "up"),
+        DiffRow("travel", 2000, 0, -2000, -100.0, "gone"),
+        DiffRow("new", 0, 5, 5, None, "new"),
+        DiffRow("same", 100, 100, 0, 0.0, "same"),
+    ]
+    assert render_diff(diffs).split("\n") == [
+        "category\tprev\tcurr\tdelta\tpct",
+        "food\t1000\t1300\t+300\t+30.0%",
+        "travel\t2000\t0\t-2000\t-100.0%",
+        "new\t0\t5\t+5\t-",
+        "same\t100\t100\t+0\t+0.0%",
+    ]
+
+
+def test_render_diff_zero_pct_never_negative_zero() -> None:
+    # prev negative -> 0 / -500 == -0.0; must still render as +0.0%
+    diffs = [DiffRow("x", -500, -500, 0, -0.0, "same")]
+    assert render_diff(diffs).splitlines()[1] == "x\t-500\t-500\t+0\t+0.0%"
+
+
+def test_render_diff_no_trailing_newline() -> None:
+    diffs = [DiffRow("x", 1, 2, 1, 100.0, "up")]
+    out = render_diff(diffs)
+    assert not out.endswith("\n")
+    assert out.count("\n") == 1
+
+
+def test_render_diff_empty_is_header_only() -> None:
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_available_months_sorted_unique() -> None:
+    rows = [
+        e("2026-02-01", "x", 1),
+        e("2025-12-31", "x", 1),
+        e("2026-02-20", "y", 1),
+        e("2026-01-01", "x", 1),
+    ]
+    assert available_months(rows) == ["2025-12", "2026-01", "2026-02"]
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months() -> None:
+    rows = [
+        e("2026-01-01", "x", 100),
+        e("2026-02-01", "x", 200),
+        e("2026-03-01", "x", 150),
+    ]
+    (row,) = latest_diff(rows)
+    assert row == DiffRow("x", 200, 150, -50, -25.0, "down")
+
+
+def test_latest_diff_needs_two_months() -> None:
+    with pytest.raises(ValueError):
+        latest_diff([])
+    with pytest.raises(ValueError):
+        latest_diff([e("2026-01-01", "x", 1), e("2026-01-02", "x", 2)])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..3734394
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,202 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def _e(
+    category: str, memo: str = "", day: date = date(2026, 11, 1), amount: int = 100
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- tokenize -------------------------------------------------------------
+
+
+def test_tokenize_empty_and_whitespace_only_gives_no_tokens():
+    assert tokenize("") == []
+    assert tokenize("   \t ") == []
+
+
+def test_tokenize_whitespace_separates_words():
+    assert tokenize("  lunch   dinner ") == [("TERM", "lunch"), ("TERM", "dinner")]
+
+
+def test_tokenize_parens():
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+
+
+def test_tokenize_quoted_term_keeps_spaces_and_parens():
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+
+
+def test_tokenize_unterminated_quote_is_error():
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_is_error():
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_quoted_operator_words_are_terms():
+    assert tokenize('"AND" "cat:x"') == [("TERM", "AND"), ("TERM", "cat:x")]
+
+
+def test_tokenize_only_uppercase_operators_are_operators():
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+    assert tokenize("and or not") == [("TERM", "and"), ("TERM", "or"), ("TERM", "not")]
+
+
+def test_tokenize_cat_prefix_is_lowercase_only():
+    assert tokenize("cat:food") == [("CAT", "food")]
+    assert tokenize("CAT:food") == [("TERM", "CAT:food")]
+
+
+def test_tokenize_empty_cat_is_error():
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_tokenize_word_stops_at_quote():
+    assert tokenize('abc"d e"') == [("TERM", "abc"), ("TERM", "d e")]
+
+
+# --- parsing errors -------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(",
+        ")",
+        "a)",
+        "(a",
+        "a AND",
+        "OR a",
+        "NOT",
+        "a OR",
+        "a (",
+        "a AND )",
+    ],
+)
+def test_invalid_syntax_is_query_error(q):
+    with pytest.raises(QueryError):
+        filter_rows(q, [])
+
+
+def test_invalid_query_raises_even_with_no_rows():
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
+
+
+# --- matches: evaluation --------------------------------------------------
+
+
+def test_term_matches_memo_substring():
+    assert matches("lun", _e("food", memo="Lunch set"))
+
+
+def test_term_matches_category_substring():
+    assert matches("foo", _e("food", memo=""))
+
+
+def test_term_is_case_insensitive():
+    assert matches("LUNCH", _e("food", memo="lunch"))
+    assert matches("lunch", _e("food", memo="LUNCH"))
+
+
+def test_term_does_not_match_amount_or_date():
+    e = _e("food", memo="x", day=date(2026, 11, 1), amount=1234)
+    assert not matches("1234", e)
+    assert not matches("2026", e)
+
+
+def test_term_with_spaces_must_match_as_substring():
+    assert matches('"set lunch"', _e("food", memo="a set lunch b"))
+    assert not matches('"set lunch"', _e("food", memo="set  lunch"))
+
+
+def test_cat_matches_category_exactly_case_insensitive():
+    assert matches("cat:FOOD", _e("food"))
+    assert not matches("cat:foo", _e("food"))
+    assert not matches("cat:food", _e("food2"))
+
+
+def test_cat_does_not_match_memo():
+    assert not matches("cat:lunch", _e("food", memo="lunch"))
+
+
+def test_cat_term_does_not_match_partial_category_only_by_term():
+    # TERM is substring, CAT is exact: "food" is a TERM hit, not a CAT hit.
+    assert matches("food", _e("food"))
+    assert not matches("cat:fo", _e("food"))
+
+
+def test_and_is_implicit_between_terms():
+    e = _e("food", memo="lunch")
+    assert matches("lunch food", e)
+    assert matches("lunch AND food", e)
+    assert not matches("lunch dinner", e)
+
+
+def test_or_binds_looser_than_and():
+    e = _e("food", memo="lunch")
+    # a OR (b AND c)
+    assert matches("zzz OR lunch food", e)
+    assert not matches("zzz OR lunch rent", e)
+
+
+def test_not_binds_tighter_than_and():
+    e = _e("food", memo="lunch")
+    # (NOT a) AND b
+    assert matches("NOT rent lunch", e)
+    assert not matches("NOT food lunch", e)
+
+
+def test_not_binds_tighter_than_or():
+    e = _e("food", memo="lunch")
+    # (NOT a) OR b
+    assert matches("NOT food OR lunch", e)
+    assert not matches("NOT lunch OR rent", e)
+
+
+def test_double_not():
+    assert matches("NOT NOT lunch", _e("food", memo="lunch"))
+    assert not matches("NOT NOT lunch", _e("food", memo="dinner"))
+
+
+def test_parens_override_precedence():
+    e = _e("food", memo="lunch")
+    # (zzz OR lunch) AND food
+    assert matches("(zzz OR lunch) food", e)
+    assert not matches("(zzz OR lunch) rent", e)
+
+
+def test_explicit_and_and_or_operators():
+    e = _e("food", memo="lunch")
+    assert matches("lunch AND cat:food", e)
+    assert matches("rent OR lunch", e)
+    assert not matches("rent OR dinner", e)
+
+
+# --- filter_rows ----------------------------------------------------------
+
+
+def test_filter_rows_keeps_input_order():
+    rows = [_e("food", "a"), _e("rent", "b"), _e("food", "c")]
+    assert filter_rows("cat:food", rows) == [rows[0], rows[2]]
+
+
+def test_filter_rows_empty_rows_valid_query_gives_empty_list():
+    assert filter_rows("lunch", []) == []
+
+
+def test_filter_rows_no_match_gives_empty_list():
+    assert filter_rows("zzz", [_e("food", "lunch")]) == []
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..3381ef6
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,252 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def _e(day: str, category: str = "通信", amount: int = 1000, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+# --- add_month -------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("src", "expected"),
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),  # clamp to shorter month
+        (date(2024, 1, 31), date(2024, 2, 29)),  # clamp in leap year
+        (date(2026, 12, 15), date(2027, 1, 15)),  # year rollover
+        (date(2026, 11, 30), date(2026, 12, 30)),
+        (date(2026, 3, 31), date(2026, 4, 30)),
+        (date(2026, 1, 10), date(2026, 2, 10)),  # ordinary day kept
+    ],
+)
+def test_add_month(src, expected):
+    assert add_month(src) == expected
+
+
+# --- validation ------------------------------------------------------------
+
+
+def test_min_count_below_two_is_rejected():
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=0)
+
+
+def test_negative_tolerance_is_rejected():
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_min_count_two_and_zero_tolerance_are_accepted():
+    assert find_recurring([], min_count=2, tolerance=0) == []
+
+
+# --- basic detection --------------------------------------------------------
+
+
+def test_empty_input_returns_empty_list():
+    assert find_recurring([]) == []
+
+
+def test_three_monthly_charges_form_one_recurring():
+    rows = [_e("2026-01-10"), _e("2026-02-10"), _e("2026-03-10")]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="通信",
+            amount=1000,
+            days=(date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10)),
+            next_expected=date(2026, 4, 10),
+        )
+    ]
+
+
+def test_run_shorter_than_min_count_is_dropped():
+    rows = [_e("2026-01-10"), _e("2026-02-10")]
+    assert find_recurring(rows, min_count=3) == []
+    assert len(find_recurring(rows, min_count=2)) == 1
+
+
+def test_run_of_exactly_min_count_is_kept():
+    rows = [_e("2026-01-10"), _e("2026-02-10"), _e("2026-03-10")]
+    assert len(find_recurring(rows, min_count=3)) == 1
+    assert find_recurring(rows, min_count=4) == []
+
+
+# --- tolerance ---------------------------------------------------------------
+
+
+def test_tolerance_boundary_is_inclusive():
+    # add_month(01-10)=02-10; 02-13 is 3 days off -> connected at tolerance=3
+    rows = [_e("2026-01-10"), _e("2026-02-13"), _e("2026-03-16")]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+
+
+def test_gap_beyond_tolerance_breaks_chain():
+    rows = [_e("2026-01-10"), _e("2026-02-13"), _e("2026-03-16")]
+    assert find_recurring(rows, tolerance=2) == []
+
+
+def test_early_charge_within_tolerance_counts():
+    # add_month(02-10)=03-10; 03-07 is 3 days early -> connected
+    rows = [_e("2026-01-10"), _e("2026-02-10"), _e("2026-03-07")]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 7)
+
+
+def test_chain_uses_previous_actual_day_not_first_day():
+    # 01-31 -> 02-28 (clamped), then 03-31 is 3 days from add_month(02-28)=03-28
+    rows = [_e("2026-01-31"), _e("2026-02-28"), _e("2026-03-31")]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 30)
+
+
+def test_year_boundary_is_connected():
+    rows = [_e("2025-11-10"), _e("2025-12-10"), _e("2026-01-10")]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days[-1] == date(2026, 1, 10)
+    assert result[0].next_expected == date(2026, 2, 10)
+
+
+def test_leap_year_next_expected_clamps():
+    rows = [_e("2024-01-31"), _e("2024-02-29"), _e("2024-03-31")]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2024, 4, 30)
+
+
+# --- splitting into maximal runs ---------------------------------------------
+
+
+def test_gap_splits_into_separate_runs():
+    rows = [
+        _e("2026-01-10"),
+        _e("2026-02-10"),
+        _e("2026-03-10"),
+        _e("2026-04-10"),
+        _e("2026-07-10"),
+        _e("2026-08-10"),
+    ]
+    result = find_recurring(rows, min_count=2)
+    assert [r.days for r in result] == [
+        (
+            date(2026, 1, 10),
+            date(2026, 2, 10),
+            date(2026, 3, 10),
+            date(2026, 4, 10),
+        ),
+        (date(2026, 7, 10), date(2026, 8, 10)),
+    ]
+    assert [r.next_expected for r in result] == [date(2026, 5, 10), date(2026, 9, 10)]
+
+
+def test_short_run_after_gap_is_dropped_but_long_run_kept():
+    rows = [
+        _e("2026-01-10"),
+        _e("2026-02-10"),
+        _e("2026-03-10"),
+        _e("2026-07-10"),
+        _e("2026-08-10"),
+    ]
+    result = find_recurring(rows, min_count=3)
+    assert len(result) == 1
+    assert len(result[0].days) == 3
+
+
+# --- duplicates, grouping, input order ---------------------------------------
+
+
+def test_duplicate_dates_are_counted_once():
+    rows = [_e("2026-01-10"), _e("2026-01-10"), _e("2026-02-10")]
+    assert find_recurring(rows, min_count=3) == []
+    rows.append(_e("2026-03-10"))
+    result = find_recurring(rows, min_count=3)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10))
+
+
+def test_different_amounts_in_same_category_are_separate_groups():
+    rows = [
+        _e("2026-01-10", amount=1000),
+        _e("2026-02-10", amount=1000),
+        _e("2026-03-10", amount=1000),
+        _e("2026-01-15", amount=2000),
+        _e("2026-02-15", amount=2000),
+    ]
+    result = find_recurring(rows, min_count=3)
+    assert [(r.category, r.amount) for r in result] == [("通信", 1000)]
+    assert [(r.category, r.amount) for r in find_recurring(rows, min_count=2)] == [
+        ("通信", 1000),
+        ("通信", 2000),
+    ]
+
