+"""Receipt OCR text parser (pure functions, standard library only).
+
+parse_receipt never raises for bad OCR text: fields that cannot be read become
+None and the reason is recorded in ``warnings``. Only a non-str argument raises.
+"""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+__all__ = ["ReceiptInfo", "parse_receipt"]
+
+
+@dataclass(frozen=True)
+class ReceiptInfo:
+    day: date | None
+    total: int | None
+    store: str | None
+    warnings: tuple[str, ...]
+
+
+# A digit as printed by OCR: real digits plus the look-alikes O/o (0) and l/I (1).
+_D = "[0-9OoIl]"
+_OCR = str.maketrans({"O": "0", "o": "0", "l": "1", "I": "1"})
+
+
+def _fixnum(s: str) -> int:
+    return int(s.translate(_OCR))
+
+
+# --- R2: dates -----------------------------------------------------------------
+
+_DATE_RES = (
+    (
+        "ad",
+        re.compile(
+            rf"(?<!{_D})(?P<y>{_D}{{4}}|{_D}{{2}})[ \t]*(?P<s>[/.\-])[ \t]*"
+            rf"(?P<m>{_D}{{1,2}})[ \t]*(?P=s)[ \t]*(?P<d>{_D}{{1,2}})(?!{_D})"
+        ),
+    ),
+    (
+        "jp",
+        re.compile(
+            rf"(?<!{_D})(?P<y>{_D}{{4}}|{_D}{{2}})年[ \t]*"
+            rf"(?P<m>{_D}{{1,2}})月[ \t]*(?P<d>{_D}{{1,2}})(?!{_D})日?"
+        ),
+    ),
+    (
+        "reiwa_jp",
+        re.compile(
+            rf"令和[ \t]*(?P<n>{_D}{{1,2}})年[ \t]*"
+            rf"(?P<m>{_D}{{1,2}})月[ \t]*(?P<d>{_D}{{1,2}})(?!{_D})日?"
+        ),
+    ),
+    (
+        "reiwa_ad",
+        re.compile(
+            rf"[Rr](?P<n>{_D}{{1,2}})[ \t]*(?P<s>[/.\-])[ \t]*"
+            rf"(?P<m>{_D}{{1,2}})[ \t]*(?P=s)[ \t]*(?P<d>{_D}{{1,2}})(?!{_D})"
+        ),
+    ),
+)
+
+
+def _date_matches(line: str) -> list[tuple[str, re.Match[str]]]:
+    """Date-shaped matches in one line, in order; overlapping ones are dropped."""
+    found: list[tuple[int, int, str, re.Match[str]]] = []
+    for kind, rx in _DATE_RES:
+        for m in rx.finditer(line):
+            found.append((m.start(), m.end(), kind, m))
+    found.sort(key=lambda t: (t[0], -t[1]))
+    out: list[tuple[str, re.Match[str]]] = []
+    last_end = -1
+    for start, end, kind, m in found:
+        if start < last_end:
+            continue
+        out.append((kind, m))
+        last_end = end
+    return out
+
+
+def _to_date(kind: str, m: re.Match[str]) -> date | None:
+    try:
+        if kind in ("reiwa_jp", "reiwa_ad"):
+            n = _fixnum(m.group("n"))
+            if n < 1:
+                return None
+            year = 2018 + n
+        else:
+            raw = m.group("y")
+            year = _fixnum(raw)
+            if len(raw) == 2:
+                year += 2000
+        return date(year, _fixnum(m.group("m")), _fixnum(m.group("d")))
+    except ValueError:
+        return None
+
+
+def _find_date(lines: list[str]) -> tuple[date | None, str | None]:
+    seen_candidate = False
+    for line in lines:
+        for kind, m in _date_matches(line):
+            seen_candidate = True
+            day = _to_date(kind, m)
+            if day is not None:
+                return day, None
+    if seen_candidate:
+        return None, "有効な日付がありません(存在しない日付のみ)"
+    return None, "日付が見つかりません"
+
+
+# --- R3: total -----------------------------------------------------------------
+
+_P1_WORDS = ("合計", "総合計", "お会計")
+_P2_WORDS = ("お買上", "お支払")
+_EXCLUDE_WORDS = ("お預り", "お預かり", "釣", "お釣り", "ポイント", "割引")
+
+
+def _priority(line: str) -> int | None:
+    """1 = best total keyword, 2 = payment keyword, 3 = subtotal, None = not a total line."""
+    upper = line.upper()
+    if any(w in line for w in _P1_WORDS) or (
+        "TOTAL" in upper and "SUBTOTAL" not in upper
+    ):
+        return 1
+    if any(w in line for w in _P2_WORDS):
+        return 2
+    if "小計" in line or "SUBTOTAL" in upper:
+        return 3
+    return None
+
+
+def _excluded(line: str) -> bool:
+    if any(w in line for w in _EXCLUDE_WORDS):
+        return True
+    # 税 notes (内消費税・消費税等・税込) are excluded unless the line is a 合計 line.
+    return "税" in line and "合計" not in line
+
+
+# --- R4: amounts ---------------------------------------------------------------
+
+_NUM = re.compile(
+    r"(?<![.,0-9OoIl])"
+    r"(?:[0-9OoIl]+(?:,[0-9OoIl]{3})+(?![0-9OoIl.,])"  # 1,234
+    r"|[0-9OoIl]+\.[0-9OoIl]{3}(?![0-9OoIl])"  # 1.234 (OCR for 1,234)
+    r"|[0-9OoIl]+(?: [0-9OoIl]{3})+(?![0-9OoIl])"  # 1 234
+    r"|[0-9OoIl]+(?![0-9OoIl.,]))"  # 1234
+)
+
+
+def _read_amounts(line: str) -> list[int]:
+    """Every readable amount in the line, in order. A leading '-' makes it negative."""
+    out: list[int] = []
+    for m in _NUM.finditer(line):
+        raw = m.group()
+        if not re.search(r"[0-9]", raw):  # e.g. a bare "O" in a word is not a number
+            continue
+        value = int(re.sub(r"[ ,.]", "", raw).translate(_OCR))
+        if m.start() > 0 and line[m.start() - 1] == "-":
+            value = -value
+        out.append(value)
+    return out
+
+
+def _find_total(lines: list[str]) -> tuple[int | None, list[str]]:
+    best: tuple[int, int] | None = None  # (priority, line index); later line wins ties
+    for i, line in enumerate(lines):
+        prio = _priority(line)
+        if prio is None or _excluded(line):
+            continue
+        if best is None or prio <= best[0]:
+            best = (prio, i)
+    if best is None:
+        return None, ["合計が見つかりません"]
+
+    prio, i = best
+    warnings: list[str] = []
+    if prio == 3:
+        warnings.append("小計から推定")
+
+    same_line = _read_amounts(lines[i])
+    value: int | None = None
+    if same_line:
+        value = same_line[-1]
+    elif i + 1 < len(lines):
+        next_line = _read_amounts(lines[i + 1])
+        if next_line:
+            value = next_line[0]
+
+    if value is None:
+        warnings.append("合計の金額が読めません")
+        return None, warnings
+    if value <= 0:
+        warnings.append(f"合計の金額が 0 以下です: {value}")
+        return None, warnings
+    return value, warnings
+
+
+# --- R5: store -----------------------------------------------------------------
+
+_STORE_NG = re.compile(
+    r"TEL|電話|〒|[0-9]{2,4}-[0-9]{2,4}-[0-9]{3,4}"
+    r"|(?i:RECEIPT|No\.)|領収書|領収証|レシート|伝票|責"
+)
+_PREFECTURE = re.compile(
+    r"^(?:北海道|東京都|京都府|大阪府|"
+    r"(?:青森|岩手|宮城|秋田|山形|福島|茨城|栃木|群馬|埼玉|千葉|神奈川|新潟|富山|石川|福井"
+    r"|山梨|長野|岐阜|静岡|愛知|三重|滋賀|兵庫|奈良|和歌山|鳥取|島根|岡山|広島|山口|徳島"
+    r"|香川|愛媛|高知|福岡|佐賀|長崎|熊本|大分|宮崎|鹿児島|沖縄)県)"
+)
+_LETTER = re.compile(r"[^\W\d_]")
+
+
+def _find_store(lines: list[str]) -> str | None:
+    for line in lines[:6]:
+        if _date_matches(line) or _STORE_NG.search(line) or _PREFECTURE.match(line):
+            continue
+        if not _LETTER.search(line):  # digits and symbols only
+            continue
+        cleaned = re.sub(r"^[\s*=\-]+|[\s*=\-]+$", "", line)
+        cleaned = re.sub(r"\s+", " ", cleaned)
+        if cleaned:
+            return cleaned
+    return None
+
+
+# --- entry point ---------------------------------------------------------------
+
+
+def parse_receipt(text: str) -> ReceiptInfo:
+    if not isinstance(text, str):
+        raise TypeError(f"text は str である必要があります: {type(text).__name__}")
+
+    normalized = unicodedata.normalize("NFKC", text)  # R1
+    lines = [ln.strip() for ln in normalized.splitlines()]
+    lines = [ln for ln in lines if ln]
+
+    day, date_warning = _find_date(lines)
+    total, total_warnings = _find_total(lines)
+    store = _find_store(lines)
+
+    warnings: list[str] = []
+    if date_warning is not None:
+        warnings.append(date_warning)
+    warnings.extend(total_warnings)
+    if store is None:
+        warnings.append("店名が見つかりません")
+    return ReceiptInfo(day=day, total=total, store=store, warnings=tuple(warnings))
diff --git a/src/kakeibo/year_summary.py b/src/kakeibo/year_summary.py
new file mode 100644
index 0000000..56fa87a
--- /dev/null
+++ b/src/kakeibo/year_summary.py
@@ -0,0 +1,75 @@
+"""Yearly summary: monthly totals, top month, and category shares (pure functions)."""
+
+from __future__ import annotations
+
+import unicodedata
+from dataclasses import dataclass
+from fractions import Fraction
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class YearSummary:
+    year: int
+    monthly: dict[str, int]
+    total: int
+    top_month: str | None
+    top_month_total: int
+    shares: dict[str, float]
+
+
+def _check_year(year: object) -> int:
+    # type() is int excludes bool; a single check keeps the spec's ValueError for any non-int.
+    if not (type(year) is int and 1 <= year <= 9999):
+        raise ValueError(f"年は 1〜9999 の整数である必要があります: {year!r}")
+    return year
+
+
+def _key(category: str) -> str:
+    """Category identity: surrounding spaces, case, and full/half width ignored."""
+    return unicodedata.normalize("NFKC", category.strip()).casefold()
+
+
+def _shares(positive: dict[str, int]) -> dict[str, float]:
+    """Percent per category in 0.1% units by largest remainder; sums to exactly 100.0."""
+    if not positive:
+        return {}
+    denom = sum(positive.values())
+    exact = {c: Fraction(v * 1000, denom) for c, v in positive.items()}
+    units = {c: int(q) for c, q in exact.items()}  # all positive, so int() floors
+    left = 1000 - sum(units.values())
+    for c in sorted(positive, key=lambda c: (-(exact[c] - units[c]), c))[:left]:
+        units[c] += 1
+    ordered = sorted(units, key=lambda c: (-units[c], c))
+    return {c: units[c] / 10 for c in ordered}
+
+
+def summarize_year(rows: list[Expense], year: int) -> YearSummary:
+    y = _check_year(year)
+    monthly = {f"{y:04d}-{m:02d}": 0 for m in range(1, 13)}
+    net: dict[str, int] = {}
+    names: dict[str, str] = {}
+    for e in rows:
+        if e.day.year != y:
+            continue
+        monthly[f"{y:04d}-{e.day.month:02d}"] += e.amount
+        k = _key(e.category)
+        names.setdefault(k, e.category.strip())
+        net[k] = net.get(k, 0) + e.amount
+
+    top_month: str | None = None
+    top_month_total = 0
+    for m, v in monthly.items():  # ascending, so ties keep the earliest month
+        if v > 0 and v > top_month_total:
+            top_month, top_month_total = m, v
+
+    positive = {names[k]: v for k, v in net.items() if v > 0}
+    return YearSummary(
+        year=y,
+        monthly=monthly,
+        total=sum(monthly.values()),
+        top_month=top_month,
+        top_month_total=top_month_total,
+        shares=_shares(positive),
+    )
diff --git a/tests/test_budget_alert.py b/tests/test_budget_alert.py
new file mode 100644
index 0000000..39e4e4a
--- /dev/null
+++ b/tests/test_budget_alert.py
@@ -0,0 +1,191 @@
+"""Tests for kakeibo.budget_alert."""
+
+from __future__ import annotations
+
+import pytest
+
+from kakeibo.budget_alert import BudgetAlert, check_budget
+
+
+# 例の表 E1-1 / E1-2 / E1-3
+@pytest.mark.parametrize(
+    ("case_id", "spent", "limits", "warn_percent", "expected"),
+    [
+        pytest.param(
+            "E1-1",
+            {"食費": 40000},
+            {"食費": 40000},
+            80,
+            [BudgetAlert("食費", "near", 40000, 40000, 0)],
+            id="E1-1",
+        ),
+        pytest.param(
+            "E1-2",
+            {"食費": 1},
+            {"食費": 0},
+            80,
+            [BudgetAlert("食費", "over", 0, 1, 1)],
+            id="E1-2",
+        ),
+        pytest.param(
+            "E1-3",
+            {"食費": 100},
+            {"食費": 100},
+            0,
+            ValueError,
+            id="E1-3",
+        ),
+    ],
+)
+def test_example_table(
+    case_id: str,
+    spent: dict[str, int],
+    limits: dict[str, int],
+    warn_percent: int,
+    expected: object,
+) -> None:
+    assert case_id
+    if expected is ValueError:
+        with pytest.raises(ValueError):
+            check_budget(spent, limits, warn_percent)
+    else:
+        assert check_budget(spent, limits, warn_percent) == expected
+
+
+# R1: 予算なしのカテゴリは無視、spent に無いカテゴリは使用額 0 でアラートなし
+def test_R1_category_without_limit_is_ignored() -> None:
+    assert check_budget({"娯楽": 99999}, {"食費": 100}) == []
+
+
+def test_R1_limit_without_spent_gives_no_alert() -> None:
+    assert check_budget({}, {"食費": 100}) == []
+
+
+# R2: 超過は over、warn_percent 以上かつ上限以内は near、ちょうど上限は near
+def test_R2_over_when_spent_exceeds_limit() -> None:
+    assert check_budget({"食費": 1001}, {"食費": 1000}) == [
+        BudgetAlert("食費", "over", 1000, 1001, 1)
+    ]
+
+
+def test_R2_limit_exactly_is_near_not_over() -> None:
+    [alert] = check_budget({"食費": 1000}, {"食費": 1000})
+    assert alert.status == "near"
+    assert alert.over == 0
+
+
+def test_R2_near_threshold_is_inclusive() -> None:
+    # 80% ちょうど(800/1000)は near
+    assert check_budget({"食費": 800}, {"食費": 1000}) == [
+        BudgetAlert("食費", "near", 1000, 800, 0)
+    ]
+
+
+def test_R2_below_threshold_gives_no_alert() -> None:
+    # 799/1000 は 79.9% なのでアラートなし
+    assert check_budget({"食費": 799}, {"食費": 1000}) == []
+
+
+def test_R2_warn_percent_is_applied() -> None:
+    assert check_budget({"食費": 500}, {"食費": 1000}, warn_percent=50) == [
+        BudgetAlert("食費", "near", 1000, 500, 0)
+    ]
+
+
+def test_R2_comparison_is_exact_integer() -> None:
+    # 1 円差の境界で float 誤差が出ないこと: 0.8 * 3 は 2.4000000000000004 になる
+    assert check_budget({"食費": 2400}, {"食費": 3000}) == [
+        BudgetAlert("食費", "near", 3000, 2400, 0)
+    ]
+    assert check_budget({"食費": 2399}, {"食費": 3000}) == []
+
+
+# R3: 上限 0
+def test_R3_zero_limit_with_spending_is_over() -> None:
+    assert check_budget({"食費": 5}, {"食費": 0}) == [
+        BudgetAlert("食費", "over", 0, 5, 5)
+    ]
+
+
+def test_R3_zero_limit_with_zero_spending_has_no_alert() -> None:
+    assert check_budget({"食費": 0}, {"食費": 0}) == []
+
+
+def test_R3_zero_limit_with_negative_spending_has_no_alert() -> None:
+    # 返金で使用額が負になった場合も 0 以下としてアラートなし
+    assert check_budget({"食費": -10}, {"食費": 0}) == []
+
+
+# D6: 返金(負の金額)は使用額に含めて相殺する
+def test_D6_refund_offsets_spending_below_threshold() -> None:
+    assert check_budget({"食費": 500}, {"食費": 1000}) == []
+    assert check_budget({"食費": 900 - 400}, {"食費": 1000}) == []
+
+
+# R4: 並び順
+def test_R4_over_comes_before_near() -> None:
+    result = check_budget(
+        {"A": 900, "B": 2000},
+        {"A": 1000, "B": 1000},
+    )
+    assert [a.status for a in result] == ["over", "near"]
+    assert [a.category for a in result] == ["B", "A"]
+
+
+def test_R4_over_sorted_by_overage_desc() -> None:
+    result = check_budget(
+        {"A": 1100, "B": 1500, "C": 1200},
+        {"A": 1000, "B": 1000, "C": 1000},
+    )
+    assert [a.category for a in result] == ["B", "C", "A"]
+
+
+def test_R4_near_sorted_by_usage_ratio_desc() -> None:
+    # 使用割合: X=850/1000=85%, Y=800/900≈88.9%, Z=900/1000=90%(over ではないので near)
+    result = check_budget(
+        {"X": 850, "Y": 800, "Z": 900},
+        {"X": 1000, "Y": 900, "Z": 1000},
+    )
+    assert [a.category for a in result] == ["Z", "Y", "X"]
+
+
+def test_R4_ties_sorted_by_category_name() -> None:
+    result = check_budget(
+        {"いろ": 1100, "あ": 1100},
+        {"いろ": 1000, "あ": 1000},
+    )
+    assert [a.category for a in result] == ["あ", "いろ"]
+
+
+# R5: 不正な引数
+@pytest.mark.parametrize("wp", [0, 101, -1])
+def test_R5_warn_percent_out_of_range(wp: int) -> None:
+    with pytest.raises(ValueError):
+        check_budget({"食費": 1}, {"食費": 10}, warn_percent=wp)
+
+
+def test_R5_warn_percent_must_be_int() -> None:
+    with pytest.raises(TypeError):
+        check_budget({"食費": 1}, {"食費": 10}, warn_percent=80.0)  # type: ignore[arg-type]
+
+
+def test_R5_negative_limit_is_value_error() -> None:
+    with pytest.raises(ValueError):
+        check_budget({"食費": 1}, {"食費": -1})
+
+
+def test_R5_bool_amount_is_value_error() -> None:
+    with pytest.raises(ValueError):
+        check_budget({"食費": True}, {"食費": 10})
+    with pytest.raises(ValueError):
+        check_budget({"食費": 1}, {"食費": False})
+
+
+def test_R5_float_amount_is_type_error() -> None:
+    with pytest.raises(TypeError):
+        check_budget({"食費": 1.5}, {"食費": 10})  # type: ignore[dict-item]
+
+
+def test_R5_error_message_contains_offending_value() -> None:
+    with pytest.raises(ValueError, match="-1"):
+        check_budget({"食費": 1}, {"食費": -1})
diff --git a/tests/test_fx_convert.py b/tests/test_fx_convert.py
new file mode 100644
index 0000000..0fb5dfe
--- /dev/null
+++ b/tests/test_fx_convert.py
@@ -0,0 +1,214 @@
+"""Tests for kakeibo.fx_convert (pure functions, no I/O)."""
+
+from __future__ import annotations
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.fx_convert import (
+    ConvertedExpense,
+    ConvertResult,
+    ForeignExpense,
+    convert_to_yen,
+)
+
+
+def _usd(day: date, amount: str, memo: str = "") -> ForeignExpense:
+    return ForeignExpense(
+        day=day, currency="USD", amount=Decimal(amount), category="食費", memo=memo
+    )
+
+
+NOV1 = date(2026, 11, 1)
+NOV3 = date(2026, 11, 3)
+NOV20 = date(2026, 11, 20)
+
+
+# --- 例の表 (E2-*) ---------------------------------------------------------
+
+
+def test_E2_1_gap_rate_rounds_half_up_and_is_estimated() -> None:
+    # E2-1: USD 12.50, rate 150.2 on 11/1, converted on 11/3 -> 1877.5 -> 1878 (R3, D3)
+    result = convert_to_yen([_usd(NOV3, "12.50")], {"USD": {NOV1: Decimal("150.2")}})
+    assert result == ConvertResult(
+        converted=[
+            ConvertedExpense(
+                expense=Expense(day=NOV3, category="食費", amount=1878, memo=""),
+                rate=Decimal("150.2"),
+                rate_day=NOV1,
+                estimated=True,
+            )
+        ],
+        missing=[],
+    )
+
+
+def test_E2_2_rate_older_than_max_gap_is_missing() -> None:
+    # E2-2: same rate, converted on 11/20 with max_gap_days=7 -> missing (D2)
+    result = convert_to_yen(
+        [_usd(NOV20, "12.50")], {"USD": {NOV1: Decimal("150.2")}}, max_gap_days=7
+    )
+    assert result.converted == []
+    assert result.missing == [_usd(NOV20, "12.50")]
+
+
+def test_E2_3_refund_stays_negative_and_keeps_fields() -> None:
+    # E2-3: USD -3.00 at rate 150 on the same day -> -450 yen (D3, D6)
+    result = convert_to_yen(
+        [_usd(NOV3, "-3.00", memo="返金")], {"USD": {NOV3: Decimal(150)}}
+    )
+    assert len(result.converted) == 1
+    item = result.converted[0]
+    assert item.expense == Expense(day=NOV3, category="食費", amount=-450, memo="返金")
+    assert item.rate == Decimal(150)
+    assert item.rate_day == NOV3
+    assert item.estimated is False
+
+
+# --- 規則の端のケース -------------------------------------------------------
+
+
+def test_R1_currency_code_is_stripped_and_uppercased_on_items() -> None:
+    item = ForeignExpense(
+        day=NOV3, currency=" usd ", amount=Decimal(1), category="食費"
+    )
+    result = convert_to_yen([item], {"USD": {NOV3: Decimal(150)}})
+    assert [c.expense.amount for c in result.converted] == [150]
+
+
+def test_R1_currency_code_is_normalized_on_rates_keys() -> None:
+    result = convert_to_yen([_usd(NOV3, "2")], {"usd": {NOV3: Decimal(150)}})
+    assert [c.expense.amount for c in result.converted] == [300]
+
+
+def test_R1_duplicate_currency_after_normalization_is_value_error() -> None:
+    with pytest.raises(ValueError):
+        convert_to_yen([], {"USD": {}, " usd ": {}})
+
+
+def test_R3_same_day_rate_is_not_estimated() -> None:
+    result = convert_to_yen([_usd(NOV3, "1")], {"USD": {NOV3: Decimal(150)}})
+    assert result.converted[0].estimated is False
+    assert result.converted[0].rate_day == NOV3
+
+
+def test_R3_future_rate_is_not_used() -> None:
+    result = convert_to_yen([_usd(NOV1, "1")], {"USD": {NOV3: Decimal(150)}})
+    assert result.converted == []
+    assert len(result.missing) == 1
+
+
+def test_D2_gap_exactly_max_gap_days_is_used() -> None:
+    result = convert_to_yen(
+        [_usd(date(2026, 11, 8), "1")], {"USD": {NOV1: Decimal(150)}}, max_gap_days=7
+    )
+    assert result.converted[0].rate_day == NOV1
+    assert result.converted[0].estimated is True
+
+
+def test_D2_max_gap_zero_disables_carry_over() -> None:
+    result = convert_to_yen(
+        [_usd(NOV3, "1")], {"USD": {NOV1: Decimal(150)}}, max_gap_days=0
+    )
+    assert result.converted == []
+    assert len(result.missing) == 1
+
+
+def test_D2_uses_nearest_previous_rate() -> None:
+    rates = {"USD": {date(2026, 11, 1): Decimal(100), date(2026, 11, 4): Decimal(200)}}
+    result = convert_to_yen([_usd(NOV3, "1")], rates)
+    assert result.converted[0].rate == Decimal(100)
+    assert result.converted[0].rate_day == NOV1
+
+
+def test_R1_unknown_currency_in_rates_is_missing_not_error() -> None:
+    result = convert_to_yen([_usd(NOV3, "1")], {"EUR": {NOV3: Decimal(160)}})
+    assert result.converted == []
+    assert len(result.missing) == 1
+
+
+def test_R1_JPY_passes_through_with_rate_one() -> None:
+    item = ForeignExpense(
+        day=NOV3, currency="JPY", amount=Decimal(1200), category="食費"
+    )
+    result = convert_to_yen([item], {})
+    assert result.converted == [
+        ConvertedExpense(
+            expense=Expense(day=NOV3, category="食費", amount=1200, memo=""),
+            rate=Decimal(1),
+            rate_day=NOV3,
+            estimated=False,
+        )
+    ]
+
+
+def test_R1_JPY_fraction_rounds_half_up() -> None:
+    item = ForeignExpense(
+        day=NOV3, currency="JPY", amount=Decimal("1200.5"), category="食費"
+    )
+    result = convert_to_yen([item], {})
+    assert result.converted[0].expense.amount == 1201
+
+
+def test_D3_negative_half_rounds_away_from_zero_with_sign() -> None:
+    result = convert_to_yen([_usd(NOV3, "-0.5")], {"USD": {NOV3: Decimal(1)}})
+    assert result.converted[0].expense.amount == -1
+
+
+def test_D3_rounding_is_per_item_not_on_total() -> None:
+    items = [_usd(NOV3, "0.5"), _usd(NOV3, "0.5")]
+    result = convert_to_yen(items, {"USD": {NOV3: Decimal(1)}})
+    assert [c.expense.amount for c in result.converted] == [1, 1]
+
+
+def test_R4_input_order_is_kept_in_both_lists() -> None:
+    items = [
+        _usd(NOV3, "1", memo="a"),
+        ForeignExpense(
+            day=NOV20, currency="EUR", amount=Decimal(1), category="x", memo="b"
+        ),
+        _usd(NOV3, "2", memo="c"),
+        ForeignExpense(
+            day=NOV3, currency="JPY", amount=Decimal(5), category="y", memo="d"
+        ),
+    ]
+    result = convert_to_yen(items, {"USD": {NOV3: Decimal(150)}})
+    assert [c.expense.memo for c in result.converted] == ["a", "c", "d"]
+    assert [m.memo for m in result.missing] == ["b"]
+
+
+def test_R4_empty_input_gives_empty_result() -> None:
+    assert convert_to_yen([], {}) == ConvertResult(converted=[], missing=[])
+
+
+def test_R5_float_amount_is_type_error() -> None:
+    item = ForeignExpense(day=NOV3, currency="USD", amount=1.5, category="x")  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        convert_to_yen([item], {"USD": {NOV3: Decimal(150)}})
+
+
+def test_R5_bool_amount_is_type_error() -> None:
+    item = ForeignExpense(day=NOV3, currency="USD", amount=True, category="x")  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        convert_to_yen([item], {"USD": {NOV3: Decimal(150)}})
+
+
+@pytest.mark.parametrize("rate", [Decimal(0), Decimal(-1)])
+def test_R5_non_positive_rate_is_value_error(rate: Decimal) -> None:
+    with pytest.raises(ValueError):
+        convert_to_yen([_usd(NOV3, "1")], {"USD": {NOV3: rate}})
+
+
+def test_R5_negative_max_gap_is_value_error() -> None:
+    with pytest.raises(ValueError):
+        convert_to_yen([], {}, max_gap_days=-1)
+
+
+@pytest.mark.parametrize("code", ["US", "US1", "", "USDX", "日本円", "usd$"])
+def test_R5_invalid_currency_code_is_value_error(code: str) -> None:
+    item = ForeignExpense(day=NOV3, currency=code, amount=Decimal(1), category="x")
+    with pytest.raises(ValueError):
+        convert_to_yen([item], {})
