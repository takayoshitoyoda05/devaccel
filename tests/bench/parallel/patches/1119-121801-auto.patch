@@ -0,0 +1,116 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.year_summary import YearSummary, summarize_year
+
+MONTHS_2026 = [f"2026-{m:02d}" for m in range(1, 13)]
+
+
+def _e(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+def test_e4_1_top_month_and_shares_full_year() -> None:
+    """E4-1: R1, R2, R3."""
+    rows = [
+        _e("2026-01-03", "食費", 3000),
+        _e("2026-03-02", "食費", 2000),
+        _e("2026-03-09", "交通", 5000),
+    ]
+    s = summarize_year(rows, 2026)
+    assert list(s.monthly) == MONTHS_2026  # R1: 12 か月すべて、昇順
+    assert s.monthly["2026-01"] == 3000
+    assert s.monthly["2026-02"] == 0
+    assert s.monthly["2026-03"] == 7000
+    assert s.total == 10000
+    assert s.top_month == "2026-03"  # R2
+    assert s.top_month_total == 7000
+    assert s.shares == {"食費": 50.0, "交通": 50.0}  # R3
+
+
+def test_e4_2_largest_remainder_rounding_sums_to_100() -> None:
+    """E4-2: R3 (33.4 / 33.3 / 33.3, 合計 100.0)."""
+    rows = [
+        _e("2026-01-01", "食費", 1000),
+        _e("2026-01-02", "交通", 1000),
+        _e("2026-01-03", "娯楽", 1000),
+    ]
+    s = summarize_year(rows, 2026)
+    # 同点は名前順(交通 < 娯楽 < 食費)で先頭に 0.1 を配る
+    assert s.shares == {"交通": 33.4, "娯楽": 33.3, "食費": 33.3}
+    assert list(s.shares) == ["交通", "娯楽", "食費"]
+    assert round(sum(s.shares.values()), 1) == 100.0
+
+
+def test_e4_3_refund_category_excluded_from_shares() -> None:
+    """E4-3: D5, R3 (返金で純額 0 以下のカテゴリは割合から外す)."""
+    rows = [
+        _e("2026-01-01", "食費", 3000),
+        _e("2026-01-02", "食費", -3000),
+        _e("2026-01-03", "交通", 1000),
+    ]
+    s = summarize_year(rows, 2026)
+    assert s.shares == {"交通": 100.0}  # D5, R3
+    assert s.total == 1000  # D6: 返金は月合計に含める
+
+
+def test_r1_other_years_ignored() -> None:
+    rows = [_e("2025-12-31", "食費", 999), _e("2027-01-01", "食費", 888)]
+    s = summarize_year(rows, 2026)
+    assert s.total == 0
+    assert all(v == 0 for v in s.monthly.values())
+
+
+def test_r2_tie_top_month_is_earliest() -> None:
+    rows = [_e("2026-07-01", "食費", 500), _e("2026-02-01", "食費", 500)]
+    s = summarize_year(rows, 2026)
+    assert s.top_month == "2026-02"
+    assert s.top_month_total == 500
+
+
+def test_r2_all_non_positive_months_gives_none() -> None:
+    rows = [_e("2026-05-01", "食費", 1000), _e("2026-05-02", "食費", -1000)]
+    s = summarize_year(rows, 2026)
+    assert s.top_month is None
+    assert s.top_month_total == 0
+
+
+def test_r3_no_positive_category_gives_empty_shares() -> None:
+    rows = [_e("2026-01-01", "食費", -100)]
+    assert summarize_year(rows, 2026).shares == {}
+
+
+def test_r4_category_names_normalized() -> None:
+    rows = [
+        _e("2026-01-01", " Food ", 100),
+        _e("2026-01-02", "food", 100),
+        _e("2026-01-03", "ＦＯＯＤ", 200),
+    ]
+    s = summarize_year(rows, 2026)
+    assert len(s.shares) == 1
+    assert list(s.shares.values()) == [100.0]
+
+
+def test_r5_empty_rows() -> None:
+    s = summarize_year([], 2026)
+    assert isinstance(s, YearSummary)
+    assert s.year == 2026
+    assert list(s.monthly) == MONTHS_2026
+    assert all(v == 0 for v in s.monthly.values())
+    assert s.total == 0
+    assert s.top_month is None
