@@ -0,0 +1,135 @@
+"""Convert foreign-currency expenses to yen (pure functions, no I/O)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from datetime import date
+from decimal import ROUND_HALF_UP, Decimal
+
+from kakeibo.core import Expense
+
+_CODE_RE = re.compile(r"[A-Z]{3}")
+_JPY = "JPY"
+
+
+@dataclass(frozen=True)
+class ForeignExpense:
+    day: date
+    currency: str
+    amount: Decimal
+    category: str
+    memo: str = ""
+
+
+@dataclass(frozen=True)
+class ConvertedExpense:
+    expense: Expense
+    rate: Decimal  # yen per 1 unit of the currency
+    rate_day: date  # the day whose rate was actually used
+    estimated: bool  # True when rate_day != expense day (carried over)
+
+
+@dataclass(frozen=True)
+class ConvertResult:
+    converted: list[ConvertedExpense]
+    missing: list[ForeignExpense]
+
+
+def _normalize_code(code: object, where: str) -> str:
+    if not isinstance(code, str):
+        raise TypeError(f"{where} の通貨コードは文字列である必要があります: {code!r}")
+    norm = code.strip().upper()
+    if not _CODE_RE.fullmatch(norm):
+        raise ValueError(f"{where} の通貨コードが不正です(英字3文字): {code!r}")
+    return norm
+
+
+def _as_decimal(value: object, where: str) -> Decimal:
+    if isinstance(value, (bool, float)) or not isinstance(value, (Decimal, int)):
+        raise TypeError(f"{where} は Decimal である必要があります: {value!r}")
+    d = Decimal(value)
+    if not d.is_finite():
+        raise ValueError(f"{where} が有限の数ではありません: {value!r}")
+    return d
+
+
+def _round_yen(value: Decimal) -> int:
+    """Round to whole yen per item: half away from zero (ROUND_HALF_UP on |value|)."""
+    magnitude = int(abs(value).to_integral_value(rounding=ROUND_HALF_UP))
+    return -magnitude if value < 0 else magnitude
+
+
+def _find_rate(
+    by_day: dict[date, Decimal], day: date, max_gap_days: int
+) -> tuple[date, Decimal] | None:
+    if day in by_day:
+        return day, by_day[day]
+    # Only past rates; the nearest earlier day within max_gap_days. Never future rates.
+    candidates = [d for d in by_day if d < day and (day - d).days <= max_gap_days]
+    if not candidates:
+        return None
+    best = max(candidates)
+    return best, by_day[best]
+
+
+def convert_to_yen(
+    items: list[ForeignExpense],
+    rates: dict[str, dict[date, Decimal]],
+    max_gap_days: int = 7,
+) -> ConvertResult:
+    if isinstance(max_gap_days, bool) or not isinstance(max_gap_days, int):
+        raise TypeError(f"max_gap_days は int である必要があります: {max_gap_days!r}")
+    if max_gap_days < 0:
+        raise ValueError(f"max_gap_days は 0 以上である必要があります: {max_gap_days}")
+
+    table: dict[str, dict[date, Decimal]] = {}
+    for cur, by_day in rates.items():
+        code = _normalize_code(cur, "rates のキー")
+        if code in table:
+            raise ValueError(
+                f"通貨コードが重複しています(大文字・空白を除いて比較): {cur!r}"
+            )
+        table[code] = {}
+        for day, raw in by_day.items():
+            if not isinstance(day, date):
+                raise TypeError(
+                    f"rates[{cur!r}] のキーは date である必要があります: {day!r}"
+                )
+            rate = _as_decimal(raw, f"rates[{cur!r}][{day}]")
+            if rate <= 0:
+                raise ValueError(
+                    f"レートは 0 より大きい必要があります: rates[{cur!r}][{day}]={raw}"
+                )
+            table[code][day] = rate
+
+    prepared: list[tuple[ForeignExpense, str, Decimal]] = []
+    for item in items:
+        code = _normalize_code(item.currency, "items")
+        amount = _as_decimal(item.amount, f"amount({item.currency!r})")
+        prepared.append((item, code, amount))
+
+    converted: list[ConvertedExpense] = []
+    missing: list[ForeignExpense] = []
+    for item, code, amount in prepared:
+        if code == _JPY:
+            rate, rate_day, estimated = Decimal(1), item.day, False
+        else:
+            found = _find_rate(table.get(code, {}), item.day, max_gap_days)
+            if found is None:
+                missing.append(item)
+                continue
+            rate_day, rate = found
+            estimated = rate_day != item.day
+        yen = _round_yen(amount * rate)
+        converted.append(
+            ConvertedExpense(
+                expense=Expense(
+                    day=item.day, category=item.category, amount=yen, memo=item.memo
+                ),
+                rate=rate,
+                rate_day=rate_day,
+                estimated=estimated,
+            )
+        )
+    return ConvertResult(converted=converted, missing=missing)
