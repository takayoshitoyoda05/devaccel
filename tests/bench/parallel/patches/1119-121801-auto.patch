@@ -0,0 +1,75 @@
+"""Monthly budget alerts per category (pure functions, integer yen only)."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from fractions import Fraction
+from typing import Literal
+
+
+@dataclass(frozen=True)
+class BudgetAlert:
+    category: str
+    status: Literal["over", "near"]
+    limit: int
+    spent: int
+    over: int  # max(0, spent - limit)
+
+
+def _check_amounts(obj: object, where: str) -> dict[str, int]:
+    if not isinstance(obj, dict):
+        raise TypeError(f"{where} は辞書である必要があります: {type(obj).__name__}")
+    for cat, yen in obj.items():
+        if yen is True or yen is False:
+            raise ValueError(f"{where}.{cat} に真偽値は使えません: {yen!r}")
+        if not isinstance(yen, int):
+            raise TypeError(f"{where}.{cat} は整数である必要があります: {yen!r}")
+    return obj
+
+
+def check_budget(
+    spent: dict[str, int],
+    limits: dict[str, int],
+    warn_percent: int = 80,
+) -> list[BudgetAlert]:
+    """Compare monthly spending with limits and return alerts.
+
+    - spent > limit            -> "over"
+    - spent >= limit * p/100   -> "near" (and spent <= limit)
+    - limit 0: spent > 0 is "over", otherwise no alert.
+    Result: "over" first, then by overage (over) or usage ratio (near) desc,
+    ties by category name asc.
+    """
+    if isinstance(warn_percent, bool) or not isinstance(warn_percent, int):
+        raise TypeError(f"warn_percent は整数である必要があります: {warn_percent!r}")
+    if not 1 <= warn_percent <= 100:
+        raise ValueError(
+            f"warn_percent は 1〜100 の整数である必要があります: {warn_percent}"
+        )
+    _check_amounts(spent, "spent")
+    _check_amounts(limits, "limits")
+    for cat, limit in limits.items():
+        if limit < 0:
+            raise ValueError(f"上限は 0 以上である必要があります: {cat}={limit}")
+
+    # 並び替えキー: (over=0 / near=1, 超過額または使用割合の負値, カテゴリ名)
+    keyed: list[tuple[tuple[int, Fraction, str], BudgetAlert]] = []
+    for cat, used in spent.items():
+        if cat not in limits:
+            continue  # 予算なしのカテゴリは無視
+        limit = limits[cat]
+        if limit == 0:
+            if used > 0:
+                alert = BudgetAlert(cat, "over", 0, used, used)
+                keyed.append(((0, Fraction(-used), cat), alert))
+            continue
+        if used > limit:
+            over = used - limit
+            alert = BudgetAlert(cat, "over", limit, used, over)
+            keyed.append(((0, Fraction(-over), cat), alert))
+        elif used * 100 >= limit * warn_percent:
+            alert = BudgetAlert(cat, "near", limit, used, 0)
+            keyed.append(((1, -Fraction(used, limit), cat), alert))
+
+    keyed.sort(key=lambda pair: pair[0])
+    return [alert for _, alert in keyed]
