@@ -0,0 +1,291 @@
+from __future__ import annotations
+
+import dataclasses
+from datetime import date
+
+import pytest
+
+from kakeibo.receipt_ocr import ReceiptInfo, parse_receipt
+
+
+# 仕様の例の表(E3-1 〜 E3-3)をそのまま写す
+@pytest.mark.parametrize(
+    ("text", "day", "total", "store", "n_warnings"),
+    [
+        pytest.param(
+            "ファミリーマート\n2O26/11/l9 12:30\n小計 ¥980\n合計 ¥1.O78\nお預り ¥2,000",
+            date(2026, 11, 19),
+            1078,
+            "ファミリーマート",
+            0,
+            id="E3-1",
+        ),
+        pytest.param(
+            "R8.11.19\n合計\n¥3,300\n(内消費税 300)",
+            date(2026, 11, 19),
+            3300,
+            None,  # 店名は仕様で指定なし(「合計」行が店名候補になる)
+            None,  # 警告数も仕様で指定なし
+            id="E3-2",
+        ),
+        pytest.param(
+            "2026/02/30\n小計 500",
+            None,
+            500,
+            "小計 500",  # 店名は「小計 500」行が候補になるため警告 0 件
+            2,
+            id="E3-3",
+        ),
+    ],
+)
+def test_spec_examples(
+    text: str,
+    day: date | None,
+    total: int | None,
+    store: str | None,
+    n_warnings: int | None,
+) -> None:
+    info = parse_receipt(text)
+    assert info.day == day
+    assert info.total == total
+    if store is not None:
+        assert info.store == store
+    if n_warnings is not None:
+        assert len(info.warnings) == n_warnings
+
+
+def test_e3_1_has_no_warnings() -> None:
+    assert (
+        parse_receipt(
+            "ファミリーマート\n2O26/11/l9 12:30\n小計 ¥980\n合計 ¥1.O78\nお預り ¥2,000"
+        ).warnings
+        == ()
+    )
+
+
+def test_e3_3_warns_about_date_and_subtotal() -> None:
+    info = parse_receipt("2026/02/30\n小計 500")
+    assert any("小計から推定" in w for w in info.warnings)
+    assert any("日付" in w for w in info.warnings)
+
+
+def test_receipt_info_is_frozen() -> None:
+    info = ReceiptInfo(day=None, total=None, store=None, warnings=())
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        info.total = 1  # type: ignore[misc]
+
+
+# R2: date formats
+@pytest.mark.parametrize(
+    ("line", "expected"),
+    [
+        ("2026/11/19", date(2026, 11, 19)),
+        ("2026-11-19", date(2026, 11, 19)),
+        ("2026.11.19", date(2026, 11, 19)),
+        ("2026年11月19日", date(2026, 11, 19)),
+        ("2026年 11月 19日", date(2026, 11, 19)),
+        ("26/11/19", date(2026, 11, 19)),
+        ("令和8年11月19日", date(2026, 11, 19)),
+        ("R8.11.19", date(2026, 11, 19)),
+        ("R8/11/19", date(2026, 11, 19)),
+        ("2026/11/19 12:34", date(2026, 11, 19)),
+        ("２０２６／１１／１９", date(2026, 11, 19)),
+        ("2O26年1l月l9日", date(2026, 11, 19)),
+    ],
+    ids=[
+        "slash",
+        "hyphen",
+        "dot",
+        "kanji",
+        "kanji-spaces",
+        "2digit-year",
+        "reiwa-kanji",
+        "reiwa-dot",
+        "reiwa-slash",
+        "time-suffix",
+        "fullwidth",
+        "ocr-letters",
+    ],
+)
+def test_date_formats(line: str, expected: date) -> None:
+    assert parse_receipt(f"店\n{line}\n合計 100").day == expected
+
+
+def test_invalid_date_is_skipped_for_next_candidate() -> None:
+    info = parse_receipt("2026/02/30\n2026/11/19\n合計 100")
+    assert info.day == date(2026, 11, 19)
+    assert not any("日付" in w for w in info.warnings)
+
+
+def test_no_date_warns() -> None:
+    info = parse_receipt("店\n合計 100")
+    assert info.day is None
+    assert any("日付" in w for w in info.warnings)
+
+
+def test_ocr_letters_outside_date_are_not_fixed() -> None:
+    # 日付の数字の並びの外の O は直さない(店名の O はそのまま)
+    assert parse_receipt("CoffeeO\n2026/11/19\n合計 100").store == "CoffeeO"
+
+
+# R3: total lines and priority
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param("小計 1000\n合計 1200", 1200, id="goukei-beats-subtotal"),
+        pytest.param("お買上 500\nお支払 600", 600, id="same-priority-last-wins"),
+        pytest.param("お買上 500\n合計 700", 700, id="goukei-beats-payment"),
+        pytest.param("合計 100\n総合計 200", 200, id="sougoukei-last-wins"),
+        pytest.param("お会計 ¥300", 300, id="okaikei"),
+        pytest.param("total ¥500", 500, id="total-case-insensitive"),
+        pytest.param("TOTAL ¥500", 500, id="total-upper"),
+        pytest.param("税込合計 ¥1,080\n内消費税 80", 1080, id="zeikomi-goukei-kept"),
+        pytest.param(
+            "合計 ¥980\nお預り ¥2,000\nお釣り ¥1,020", 980, id="change-lines-excluded"
+        ),
+        pytest.param("合計 ¥500\nポイント 10", 500, id="point-line-excluded"),
+        pytest.param("合計 ¥500\n割引 -50", 500, id="discount-line-excluded"),
+        pytest.param(
+            "小計 ¥980\n内消費税 80", 980, id="subtotal-with-tax-note-excluded-tax"
+        ),
+    ],
+)
+def test_total_selection(text: str, expected: int) -> None:
+    assert parse_receipt(text).total == expected
+
+
+def test_subtotal_used_only_when_nothing_else() -> None:
+    info = parse_receipt("小計 980")
+    assert info.total == 980
+    assert "小計から推定" in info.warnings
+
+
+def test_subtotal_warning_absent_when_total_keyword_present() -> None:
+    assert "小計から推定" not in parse_receipt("小計 980\n合計 1000").warnings
+
+
+def test_subtotal_word_not_taken_as_total_keyword() -> None:
+    info = parse_receipt("SUBTOTAL 300\nTOTAL 330")
+    assert info.total == 330
+
+
+def test_no_total_keyword_warns() -> None:
+    info = parse_receipt("店\n2026/11/19\nありがとう")
+    assert info.total is None
+    assert info.warnings != ()
+
+
+def test_total_with_no_amount_warns() -> None:
+    info = parse_receipt("合計\n次の行もなし")
+    assert info.total is None
+    assert info.warnings != ()
+
+
+def test_total_zero_becomes_none_with_warning() -> None:
+    info = parse_receipt("合計 ¥0")
+    assert info.total is None
+    assert any("0 以下" in w for w in info.warnings)
+
+
+def test_total_negative_becomes_none_with_warning() -> None:
+    info = parse_receipt("合計 -500")
+    assert info.total is None
+    assert any("0 以下" in w for w in info.warnings)
+
+
+def test_total_amount_on_next_line() -> None:
+    assert parse_receipt("合計\n¥3,300").total == 3300
+
+
+# R4: amount formats
+@pytest.mark.parametrize(
+    ("amount_text", "expected"),
+    [
+        pytest.param("¥1,234", 1234, id="yen-sign-comma"),
+        pytest.param("￥1234", 1234, id="fullwidth-yen-sign"),
+        pytest.param("1,234円", 1234, id="comma-yen-suffix"),
+        pytest.param("1234円", 1234, id="plain-yen-suffix"),
+        pytest.param(r"\1,234", 1234, id="backslash"),
+        pytest.param("1,234-", 1234, id="trailing-hyphen"),
+        pytest.param("1.234", 1234, id="dot-thousands-ocr"),
+        pytest.param("¥1.O78", 1078, id="dot-thousands-with-ocr-o"),
+        pytest.param("1 234", 1234, id="space-thousands"),
+        pytest.param("1 234円", 1234, id="space-thousands-yen"),
+        pytest.param("1,234,567", 1234567, id="multi-comma"),
+    ],
+)
+def test_amount_formats(amount_text: str, expected: int) -> None:
+    assert parse_receipt(f"店\n合計 {amount_text}").total == expected
+
+
+def test_amount_uses_last_on_keyword_line() -> None:
+    assert parse_receipt("店\n合計 ¥100 (税込 ¥110)").total == 110
+
+
+def test_ocr_o_in_amount_is_fixed() -> None:
+    assert parse_receipt("店\n合計 ¥1,O23").total == 1023
+
+
+def test_unreadable_amount_is_not_read_from_fraction() -> None:
+    # 「1.23」は桁区切りとして読めないので 23 にはしない
+    assert parse_receipt("店\n合計 1.23").total is None
+
+
+# R5: store name
+def test_store_skips_header_lines_and_takes_first_name_like_line() -> None:
+    text = "TEL 03-1234-5678\n〒100-0001\n東京都千代田区1-1\nレシート\n*** ベーカリー   本店 ***\n合計 100"
+    assert parse_receipt(text).store == "ベーカリー 本店"
+
+
+def test_store_ignores_lines_after_sixth() -> None:
+    text = "1\n2\n3\n4\n5\n6\n店\n合計 100"
+    info = parse_receipt(text)
+    assert info.store is None
+    assert "店名が見つかりません" in info.warnings
+
+
+def test_store_ignores_digit_and_symbol_only_lines() -> None:
+    assert parse_receipt("1234\n--==--\nパン屋\n合計 100").store == "パン屋"
+
+
+def test_store_skips_receipt_title_words() -> None:
+    assert parse_receipt("領収書\nパン屋\n合計 100").store == "パン屋"
+
+
+def test_store_skips_no_marker() -> None:
+    assert parse_receipt("No.12\nカフェ\n合計 100").store == "カフェ"
+
+
+# R1: newlines and blank lines
+def test_crlf_cr_lf_are_equivalent_and_blank_lines_ignored() -> None:
+    base = "ファミリーマート\n\n2026/11/19\n合計 500"
+    for text in (
+        base,
+        base.replace("\n", "\r\n"),
+        base.replace("\n", "\r"),
+        "\n\n" + base + "\n\n",
+    ):
+        info = parse_receipt(text)
+        assert info.store == "ファミリーマート"
+        assert info.day == date(2026, 11, 19)
+        assert info.total == 500
+
+
+# R6: empty input and types
+@pytest.mark.parametrize(
+    "text", ["", "   ", " \n\t\n "], ids=["empty", "spaces", "blank-lines"]
+)
+def test_empty_text_returns_all_none_with_warnings(text: str) -> None:
+    info = parse_receipt(text)
+    assert info.day is None
+    assert info.total is None
+    assert info.store is None
+    assert len(info.warnings) >= 3
+
+
+@pytest.mark.parametrize(
+    "value", [None, 123, ["合計 100"]], ids=["none", "int", "list"]
+)
+def test_non_str_raises_type_error(value: object) -> None:
+    with pytest.raises(TypeError):
+        parse_receipt(value)  # type: ignore[arg-type]
