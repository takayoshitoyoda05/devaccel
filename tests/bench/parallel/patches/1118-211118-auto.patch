@@ -0,0 +1,76 @@
+"""Tests for kakeibo.export.to_json."""
+
+from __future__ import annotations
+
+import json
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.export import to_json
+
+
+def test_empty_list_gives_empty_array() -> None:
+    assert to_json([]) == "[]"
+
+
+def test_single_row_exact_output() -> None:
+    rows = [Expense(date(2026, 3, 7), "食費", 1200, "昼食")]
+    assert to_json(rows) == (
+        '[{"date": "2026-03-07", "category": "食費", "amount": 1200, "memo": "昼食"}]'
+    )
+
+
+def test_keeps_input_order_not_date_order() -> None:
+    rows = [
+        Expense(date(2026, 5, 1), "食費", 100, ""),
+        Expense(date(2026, 1, 1), "交通費", 200, ""),
+    ]
+    parsed = json.loads(to_json(rows))
+    assert [item["date"] for item in parsed] == ["2026-05-01", "2026-01-01"]
+
+
+def test_keys_are_in_date_category_amount_memo_order() -> None:
+    rows = [Expense(date(2026, 2, 2), "娯楽", 300, "映画")]
+    parsed = json.loads(to_json(rows))
+    assert list(parsed[0].keys()) == ["date", "category", "amount", "memo"]
+
+
+def test_non_ascii_is_not_escaped() -> None:
+    rows = [Expense(date(2026, 4, 4), "日用品", 500, "洗剤")]
+    out = to_json(rows)
+    assert "日用品" in out
+    assert "\\u" not in out
+
+
+def test_output_has_no_indentation_or_newlines() -> None:
+    rows = [
+        Expense(date(2026, 4, 4), "食費", 10, "a"),
+        Expense(date(2026, 4, 5), "食費", 20, "b"),
+    ]
+    assert "\n" not in to_json(rows)
+
+
+def test_empty_memo_is_empty_string() -> None:
+    rows = [Expense(date(2026, 6, 6), "食費", 50)]
+    parsed = json.loads(to_json(rows))
+    assert parsed[0]["memo"] == ""
+
+
+def test_date_is_zero_padded_iso() -> None:
+    rows = [Expense(date(2026, 1, 5), "食費", 1)]
+    parsed = json.loads(to_json(rows))
+    assert parsed[0]["date"] == "2026-01-05"
+
+
+def test_amount_is_integer_not_string() -> None:
+    rows = [Expense(date(2026, 1, 5), "食費", 0)]
+    parsed = json.loads(to_json(rows))
+    assert parsed[0]["amount"] == 0
+    assert isinstance(parsed[0]["amount"], int)
+
+
+def test_special_characters_in_memo_round_trip() -> None:
+    memo = 'say "hi"\\\n改行'
+    rows = [Expense(date(2026, 7, 7), "雑費", 99, memo)]
+    parsed = json.loads(to_json(rows))
+    assert parsed[0]["memo"] == memo
