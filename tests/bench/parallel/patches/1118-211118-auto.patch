+++ b/src/kakeibo/streak.py
@@ -0,0 +1,30 @@
+"""No-spend streak calculation."""
+
+from __future__ import annotations
+
+from datetime import date, timedelta
+
+from kakeibo.core import Expense
+
+
+def longest_no_spend_streak(rows: list[Expense], start: date, end: date) -> int:
+    """Longest run of consecutive days in [start, end] with no expense at all.
+
+    Both ends are inclusive. Days with one or more rows (any amount) count as
+    spend days. Rows outside the period are ignored. If start is after end the
+    period is empty and the result is 0.
+    """
+    if start > end:
+        return 0
+    spend_days = {e.day for e in rows if start <= e.day <= end}
+    best = 0
+    run = 0
+    day = start
+    while day <= end:
+        if day in spend_days:
+            run = 0
+        else:
+            run += 1
+            best = max(best, run)
+        day += timedelta(days=1)
+    return best
diff --git a/src/kakeibo/topn.py b/src/kakeibo/topn.py
new file mode 100644
index 0000000..666686b
--- /dev/null
+++ b/src/kakeibo/topn.py
@@ -0,0 +1,19 @@
+"""Top-N expense selection."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def top_expenses(rows: list[Expense], n: int) -> list[Expense]:
+    """Return up to n expenses, largest amount first.
+
+    Ties on amount are broken by earlier date, then by input order.
+    Returns [] when n is 0 or negative.
+    """
+    if n <= 0:
+        return []
+    ordered = sorted(
+        rows, key=lambda e: (-e.amount, e.day)
+    )  # stable sort keeps input order
+    return ordered[:n]
