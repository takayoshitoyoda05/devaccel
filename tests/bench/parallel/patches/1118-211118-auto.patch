@@ -0,0 +1,73 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.streak import longest_no_spend_streak
+
+
+def _e(day: date, amount: int = 100) -> Expense:
+    return Expense(day=day, category="food", amount=amount)
+
+
+def test_no_rows_whole_period_is_one_streak() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 1), date(2026, 1, 5)) == 5
+
+
+def test_single_day_period_without_spend_is_one() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 3), date(2026, 1, 3)) == 1
+
+
+def test_single_day_period_with_spend_is_zero() -> None:
+    rows = [_e(date(2026, 1, 3))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 3), date(2026, 1, 3)) == 0
+
+
+def test_every_day_has_spend_is_zero() -> None:
+    rows = [_e(date(2026, 1, d)) for d in range(1, 4)]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 3)) == 0
+
+
+def test_start_and_end_days_are_included() -> None:
+    # spend only on Jan 2 -> Jan 1 alone (1) and Jan 3..Jan 5 (3); longest is 3
+    rows = [_e(date(2026, 1, 2))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 5)) == 3
+
+
+def test_spend_at_start_and_end_boundaries_are_counted() -> None:
+    rows = [_e(date(2026, 1, 1)), _e(date(2026, 1, 5))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 5)) == 3
+
+
+def test_longest_run_is_chosen_over_earlier_run() -> None:
+    # Jan1 free(1), Jan2 spend, Jan3-6 free(4), Jan7 spend, Jan8 free(1)
+    rows = [_e(date(2026, 1, 2)), _e(date(2026, 1, 7))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 8)) == 4
+
+
+def test_multiple_expenses_on_same_day_count_as_one_spend_day() -> None:
+    rows = [_e(date(2026, 1, 2), 100), _e(date(2026, 1, 2), 200)]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 3)) == 1
+
+
+def test_rows_outside_period_are_ignored() -> None:
+    rows = [_e(date(2025, 12, 31)), _e(date(2026, 1, 10))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 5)) == 5
+
+
+def test_zero_amount_expense_still_counts_as_spend() -> None:
+    # 明細が 1 件でもあれば「支出あり」扱い(金額は問わない)
+    rows = [_e(date(2026, 1, 2), 0)]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 3)) == 1
+
+
+def test_row_order_does_not_matter() -> None:
+    rows = [_e(date(2026, 1, 7)), _e(date(2026, 1, 2))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 8)) == 4
+
+
+def test_streak_crosses_month_boundary() -> None:
+    rows = [_e(date(2026, 1, 30))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 29), date(2026, 2, 3)) == 4
+
+
+def test_start_after_end_returns_zero() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 5), date(2026, 1, 1)) == 0
diff --git a/tests/test_topn.py b/tests/test_topn.py
new file mode 100644
index 0000000..44cfa41
--- /dev/null
+++ b/tests/test_topn.py
@@ -0,0 +1,75 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.topn import top_expenses
+
+
+def _e(day: str, amount: int, category: str = "食費", memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+def test_returns_largest_amounts_first() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 500), _e("2026-01-03", 300)]
+    assert [e.amount for e in top_expenses(rows, 2)] == [500, 300]
+
+
+def test_n_larger_than_rows_returns_all_sorted() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 500)]
+    assert [e.amount for e in top_expenses(rows, 10)] == [500, 100]
+
+
+def test_n_equal_to_rows_returns_all() -> None:
+    rows = [_e("2026-01-01", 1), _e("2026-01-02", 2)]
+    assert [e.amount for e in top_expenses(rows, 2)] == [2, 1]
+
+
+def test_n_zero_returns_empty() -> None:
+    rows = [_e("2026-01-01", 100)]
+    assert top_expenses(rows, 0) == []
+
+
+def test_negative_n_returns_empty() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 200)]
+    assert top_expenses(rows, -1) == []
+
+
+def test_empty_input_returns_empty() -> None:
+    assert top_expenses([], 3) == []
+
+
+def test_same_amount_ordered_by_earlier_date() -> None:
+    rows = [
+        _e("2026-03-05", 500, "A"),
+        _e("2026-01-10", 500, "B"),
+        _e("2026-02-01", 500, "C"),
+    ]
+    assert [e.category for e in top_expenses(rows, 3)] == ["B", "C", "A"]
+
+
+def test_same_amount_and_date_keeps_input_order() -> None:
+    rows = [
+        _e("2026-01-01", 500, "first"),
+        _e("2026-01-01", 500, "second"),
+        _e("2026-01-01", 500, "third"),
+    ]
+    assert [e.category for e in top_expenses(rows, 3)] == ["first", "second", "third"]
+
+
+def test_tie_break_only_applies_among_equal_amounts() -> None:
+    rows = [_e("2026-01-01", 100, "small-early"), _e("2026-12-31", 900, "big-late")]
+    assert [e.category for e in top_expenses(rows, 2)] == ["big-late", "small-early"]
+
+
+def test_does_not_mutate_input() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 500)]
+    snapshot = list(rows)
+    top_expenses(rows, 1)
+    assert rows == snapshot
+
+
+def test_returns_original_expense_objects() -> None:
+    rows = [_e("2026-01-01", 100, memo="x"), _e("2026-01-02", 500, memo="y")]
+    result = top_expenses(rows, 1)
+    assert result[0] is rows[1]
diff --git a/tests/test_weekday.py b/tests/test_weekday.py
new file mode 100644
index 0000000..7d5048e
--- /dev/null
+++ b/tests/test_weekday.py
@@ -0,0 +1,87 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.weekday import total_by_weekday
+
+
+def _e(day: date, amount: int, category: str = "food") -> Expense:
+    return Expense(day=day, category=category, amount=amount)
+
+
+def test_empty_rows_returns_empty_dict() -> None:
+    assert total_by_weekday([]) == {}
+
+
+def test_single_row_maps_to_its_weekday() -> None:
+    # 2026-11-16 is a Monday
+    assert total_by_weekday([_e(date(2026, 11, 16), 100)]) == {"Mon": 100}
+
+
+def test_each_weekday_name_is_three_letter_english() -> None:
+    # 2026-11-16 (Mon) .. 2026-11-22 (Sun)
+    rows = [_e(date(2026, 11, 16 + i), 10 * (i + 1)) for i in range(7)]
+    assert total_by_weekday(rows) == {
+        "Mon": 10,
+        "Tue": 20,
+        "Wed": 30,
+        "Thu": 40,
+        "Fri": 50,
+        "Sat": 60,
+        "Sun": 70,
+    }
+
+
+def test_same_weekday_amounts_are_summed() -> None:
+    rows = [
+        _e(date(2026, 11, 16), 100),  # Mon
+        _e(date(2026, 11, 23), 250),  # Mon
+        _e(date(2026, 11, 30), 50),  # Mon
+    ]
+    assert total_by_weekday(rows) == {"Mon": 400}
+
+
+def test_weekdays_without_rows_are_omitted() -> None:
+    rows = [
+        _e(date(2026, 11, 18), 300),  # Wed
+        _e(date(2026, 11, 21), 500),  # Sat
+    ]
+    result = total_by_weekday(rows)
+    assert result == {"Wed": 300, "Sat": 500}
+    assert "Mon" not in result
+    assert "Sun" not in result
+
+
+def test_keys_are_in_monday_first_order_regardless_of_input_order() -> None:
+    rows = [
+        _e(date(2026, 11, 22), 1),  # Sun
+        _e(date(2026, 11, 18), 2),  # Wed
+        _e(date(2026, 11, 16), 3),  # Mon
+        _e(date(2026, 11, 20), 4),  # Fri
+    ]
+    assert list(total_by_weekday(rows)) == ["Mon", "Wed", "Fri", "Sun"]
+
+
+def test_zero_amount_row_still_includes_its_weekday() -> None:
+    # 明細はあるので、合計が 0 でも曜日は含める
+    rows = [_e(date(2026, 11, 17), 0)]  # Tue
+    assert total_by_weekday(rows) == {"Tue": 0}
+
+
+def test_zero_and_positive_on_same_weekday_sum_correctly() -> None:
+    rows = [_e(date(2026, 11, 17), 0), _e(date(2026, 11, 24), 80)]  # Tue, Tue
+    assert total_by_weekday(rows) == {"Tue": 80}
+
+
+def test_categories_do_not_split_weekday_totals() -> None:
+    rows = [
+        _e(date(2026, 11, 19), 100, "food"),  # Thu
+        _e(date(2026, 11, 19), 200, "transport"),  # Thu
+    ]
+    assert total_by_weekday(rows) == {"Thu": 300}
+
+
+def test_input_list_is_not_modified() -> None:
+    rows = [_e(date(2026, 11, 22), 1), _e(date(2026, 11, 16), 2)]
+    snapshot = list(rows)
+    total_by_weekday(rows)
+    assert rows == snapshot
