@@ -0,0 +1,16 @@
+"""Per-weekday aggregation of expenses."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+_WEEKDAYS = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
+
+
+def total_by_weekday(rows: list[Expense]) -> dict[str, int]:
+    """{"Mon".."Sun": yen}; only weekdays with at least one row, Monday first."""
+    totals: dict[str, int] = {}
+    for e in rows:
+        name = _WEEKDAYS[e.day.weekday()]
+        totals[name] = totals.get(name, 0) + e.amount
+    return {name: totals[name] for name in _WEEKDAYS if name in totals}
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
