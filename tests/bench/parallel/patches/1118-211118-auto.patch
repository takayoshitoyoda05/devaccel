index 0000000..fdaef8e
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,204 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+
+HEADER = "利用日,分類,利用金額,利用店名"
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥5", 5),
+        ("1,234円", 1234),
+        ("-0", 0),
+        ("1,", 1),
+    ],
+)
+def test_parse_amount_accepts(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "   ",
+        "円",
+        "12.5",
+        "1 200",
+        "--5",
+        "¥-5",
+        "１２３",
+        "-円",
+        ",1",
+        "1円円",
+        "¥¥5",
+    ],
+)
+def test_parse_amount_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/1/5 ", date(2026, 1, 5)),
+        ("2026-1-5", date(2026, 1, 5)),
+        ("2026/12/31", date(2026, 12, 31)),
+    ],
+)
+def test_parse_date_accepts(text: str, expected: date) -> None:
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026/1-5",
+        "26/1/5",
+        "2026/02/30",
+        "",
+        "2026.1.5",
+        "２０２６/1/5",
+        "2026/13/1",
+        "2026//1",
+    ],
+)
+def test_parse_date_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+def test_default_mapping_values() -> None:
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_import_basic_in_input_order() -> None:
+    text = f'{HEADER}\n2026/1/5,食費,"1,200",  スーパー  \n2026-01-06,交通,-300,\n'
+    expenses, errors = import_rows(text)
+    assert errors == []
+    assert expenses[0].day == date(2026, 1, 5)
+    assert expenses[0].amount == 1200
+    assert expenses[0].memo == "スーパー"
+    assert expenses[1].day == date(2026, 1, 6)
+    assert expenses[1].amount == -300
+    assert expenses[1].memo == ""
+    assert [e.category for e in expenses] == ["食費", "交通"]
+
+
+def test_category_is_stripped_and_mapped() -> None:
+    text = f"{HEADER}\n2026/1/5, 食費 ,100,x\n2026/1/6,外食,200,y\n"
+    expenses, errors = import_rows(
+        text, category_map={"食費": "Food", "外食": "Dining"}
+    )
+    assert errors == []
+    assert [e.category for e in expenses] == ["Food", "Dining"]
+
+
+def test_category_map_applies_after_strip_only_on_exact_key() -> None:
+    text = f"{HEADER}\n2026/1/5,食費 x,100,\n"
+    expenses, _ = import_rows(text, category_map={"食費": "Food"})
+    assert expenses[0].category == "食費 x"
+
+
+def test_extra_columns_are_ignored() -> None:
+    text = "番号,利用日,備考,分類,利用金額,利用店名\n1,2026/1/5,zz,食費,100,店\n"
+    expenses, errors = import_rows(text)
+    assert errors == []
+    assert expenses[0].category == "食費"
+    assert expenses[0].memo == "店"
+
+
+def test_custom_mapping_and_memo_optional() -> None:
+    text = "日,種別,額\n2026/1/5,食費,100\n"
+    mapping = {"date": "日", "category": "種別", "amount": "額"}
+    expenses, errors = import_rows(text, mapping)
+    assert errors == []
+    assert expenses[0].memo == ""
+
+
+def test_mapping_missing_required_key_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows(f"{HEADER}\n", {"date": "利用日", "amount": "利用金額"})
+
+
+def test_mapping_column_not_in_header_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows(
+            "日,分類,額\n", {"date": "利用日", "category": "分類", "amount": "額"}
+        )
+
+
+def test_mapping_memo_column_not_in_header_raises() -> None:
+    mapping = {**DEFAULT_MAPPING, "memo": "存在しない"}
+    with pytest.raises(ValueError):
+        import_rows(f"{HEADER}\n2026/1/5,食費,100,x\n", mapping)
+
+
+def test_errors_report_physical_line_numbers_and_skip_blank_lines() -> None:
+    text = f"{HEADER}\n\n2026/1/5,食費,100,\n\n2026/1/x,食費,100,\n"
+    expenses, errors = import_rows(text)
+    assert errors == [(5, "date")]
+    assert len(expenses) == 1
+
+
+def test_multiple_errors_in_one_row_recorded_in_order() -> None:
+    text = f"{HEADER}\n bad ,  ,12.5,\n"
+    expenses, errors = import_rows(text)
+    assert expenses == []
+    assert errors == [(2, "date"), (2, "amount"), (2, "category")]
+
+
+def test_row_with_error_is_excluded_but_others_kept() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,100,a\n2026/1/6,,100,b\n2026/1/7,交通,200,c\n"
+    expenses, errors = import_rows(text)
+    assert errors == [(3, "category")]
+    assert [e.memo for e in expenses] == ["a", "c"]
+
+
+def test_short_row_missing_values_treated_as_empty() -> None:
+    text = f"{HEADER}\n2026/1/5,食費\n"
+    expenses, errors = import_rows(text)
+    assert expenses == []
+    assert errors == [(2, "amount")]
+
+
+def test_short_row_memo_missing_is_empty_string() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,100\n"
+    expenses, errors = import_rows(text)
+    assert errors == []
+    assert expenses[0].memo == ""
+
+
+def test_quoted_field_with_newline_counts_physical_lines() -> None:
+    text = f'{HEADER}\n2026/1/5,食費,100,"a\nb"\n2026/1/x,食費,100,c\n'
+    expenses, errors = import_rows(text)
+    assert [e.memo for e in expenses] == ["a\nb"]
+    assert errors == [(4, "date")]
+
+
+def test_empty_text_with_default_mapping_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows("")
+
+
+def test_header_only_returns_nothing() -> None:
+    expenses, errors = import_rows(f"{HEADER}\n")
+    assert expenses == []
+    assert errors == []
