+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,91 @@
+"""Month-over-month comparison of expenses by category."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def _month_of(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+
+    totals: dict[str, dict[str, int]] = {prev_month: {}, curr_month: {}}
+    counts: dict[str, dict[str, int]] = {prev_month: {}, curr_month: {}}
+    for e in rows:
+        m = _month_of(e)
+        if m in totals:
+            totals[m][e.category] = totals[m].get(e.category, 0) + e.amount
+            counts[m][e.category] = counts[m].get(e.category, 0) + 1
+
+    categories = set(counts[prev_month]) | set(counts[curr_month])
+    out: list[DiffRow] = []
+    for cat in categories:
+        prev = totals[prev_month].get(cat, 0)
+        curr = totals[curr_month].get(cat, 0)
+        delta = curr - prev
+        pct = None if prev == 0 else round(delta / prev * 100, 1) + 0.0
+        has_prev = counts[prev_month].get(cat, 0) > 0
+        has_curr = counts[curr_month].get(cat, 0) > 0
+        if not has_prev:
+            status = "new"
+        elif not has_curr:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+
+    out.sort(key=lambda r: (-abs(r.delta), r.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [r for r in diffs if r.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for r in diffs:
+        pct = "-" if r.pct is None else f"{r.pct:+.1f}%"
+        lines.append(f"{r.category}\t{r.prev}\t{r.curr}\t{r.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month_of(e) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には明細のある月が 2 つ以上必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..c0aae64
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,182 @@
+"""Search query language for expense rows.
+
+Grammar (lowest precedence first):
+    or_expr  := and_expr ("OR" and_expr)*
+    and_expr := not_expr (["AND"] not_expr)*
+    not_expr := "NOT" not_expr | primary
+    primary  := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+
+from kakeibo.core import Expense
+
+Token = tuple[str, str]
+Node = Callable[[Expense], bool]
+
+_KEYWORDS = {"AND": "AND", "OR": "OR", "NOT": "NOT"}
+_CAT_PREFIX = "cat:"
+
+
+class QueryError(ValueError):
+    """Raised when a search query cannot be tokenized or parsed."""
+
+
+def _is_word_char(c: str) -> bool:
+    return not (c.isspace() or c in '()"')
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    tokens: list[tuple[str, str]] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError("閉じていない引用符があります")
+            content = q[i + 1 : end]
+            if content == "":
+                raise QueryError("空の引用符は使えません")
+            tokens.append(("TERM", content))
+            i = end + 1
+        else:
+            start = i
+            while i < n and _is_word_char(q[i]):
+                i += 1
+            word = q[start:i]
+            if word in _KEYWORDS:
+                tokens.append((_KEYWORDS[word], word))
+            elif word.startswith(_CAT_PREFIX):
+                value = word[len(_CAT_PREFIX) :]
+                if value == "":
+                    raise QueryError("cat: の後ろにカテゴリ名がありません")
+                tokens.append(("CAT", value))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self.tokens = tokens
+        self.pos = 0
+
+    def _peek_kind(self) -> str | None:
+        return self.tokens[self.pos][0] if self.pos < len(self.tokens) else None
+
+    def _starts_operand(self) -> bool:
+        return self._peek_kind() in ("NOT", "TERM", "CAT", "LPAREN")
+
+    def parse(self) -> Node:
+        if not self.tokens:
+            raise QueryError("検索条件が空です")
+        node = self._or()
+        if self.pos != len(self.tokens):
+            raise QueryError(f"想定外のトークン: {self.tokens[self.pos][1]!r}")
+        return node
+
+    def _or(self) -> Node:
+        left = self._and()
+        while self._peek_kind() == "OR":
+            self.pos += 1
+            right = self._and()
+            left = _make_or(left, right)
+        return left
+
+    def _and(self) -> Node:
+        left = self._not()
+        while True:
+            if self._peek_kind() == "AND":
+                self.pos += 1
+                if not self._starts_operand():
+                    raise QueryError("AND の後ろに項がありません")
+            elif not self._starts_operand():
+                break
+            right = self._not()
+            left = _make_and(left, right)
+        return left
+
+    def _not(self) -> Node:
+        if self._peek_kind() == "NOT":
+            self.pos += 1
+            if not self._starts_operand():
+                raise QueryError("NOT の後ろに項がありません")
+            inner = self._not()
+            return _make_not(inner)
+        return self._primary()
+
+    def _primary(self) -> Node:
+        kind = self._peek_kind()
+        if kind == "TERM":
+            value = self.tokens[self.pos][1]
+            self.pos += 1
+            return _make_term(value)
+        if kind == "CAT":
+            value = self.tokens[self.pos][1]
+            self.pos += 1
+            return _make_cat(value)
+        if kind == "LPAREN":
+            self.pos += 1
+            inner = self._or()
+            if self._peek_kind() != "RPAREN":
+                raise QueryError("対応する ) がありません")
+            self.pos += 1
+            return inner
+        if kind is None:
+            raise QueryError("項が必要です")
+        raise QueryError(f"項が必要ですが {self.tokens[self.pos][1]!r} がありました")
+
+
+def _make_term(value: str) -> Node:
+    needle = value.casefold()
+
+    def node(e: Expense) -> bool:
+        return needle in e.memo.casefold() or needle in e.category.casefold()
+
+    return node
+
+
+def _make_cat(value: str) -> Node:
+    target = value.casefold()
+
+    def node(e: Expense) -> bool:
+        return e.category.casefold() == target
+
+    return node
+
+
+def _make_not(inner: Node) -> Node:
+    return lambda e: not inner(e)
+
+
+def _make_and(left: Node, right: Node) -> Node:
+    return lambda e: left(e) and right(e)
+
+
+def _make_or(left: Node, right: Node) -> Node:
+    return lambda e: left(e) or right(e)
+
+
+def _compile(q: str) -> Node:
+    return _Parser(tokenize(q)).parse()
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _compile(q)(e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    node = _compile(q)
+    return [e for e in rows if node(e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..4f2038d
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,62 @@
+"""Detect recurring expenses (same category and amount, roughly monthly)."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day in the next month, or that month's last day if absent."""
+    year, month = d.year, d.month + 1
+    if month == 13:
+        year, month = year + 1, 1
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2 or tolerance < 0:
+        raise ValueError("min_count は 2 以上、tolerance は 0 以上である必要があります")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    found: list[Recurring] = []
+
+    def flush(category: str, amount: int, run: list[date]) -> None:
+        if len(run) >= min_count:
+            found.append(
+                Recurring(
+                    category=category,
+                    amount=amount,
+                    days=tuple(run),
+                    next_expected=add_month(run[-1]),
+                )
+            )
+
+    for (category, amount), dates in groups.items():
+        run: list[date] = []
+        for cur in sorted(dates):
+            if run and abs((cur - add_month(run[-1])).days) > tolerance:
+                flush(category, amount, run)
+                run = []
+            run.append(cur)
+        flush(category, amount, run)
+
+    found.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return found
