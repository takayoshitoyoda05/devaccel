+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.stats import median_by_category
+
+
+def _e(category: str, amount: int) -> Expense:
+    return Expense(day=date(2026, 11, 1), category=category, amount=amount)
+
+
+def test_empty_returns_empty_dict():
+    assert median_by_category([]) == {}
+
+
+def test_single_row_is_its_own_median_as_float():
+    out = median_by_category([_e("food", 100)])
+    assert out == {"food": 100.0}
+    assert isinstance(out["food"], float)
+
+
+def test_odd_count_takes_middle_value():
+    rows = [_e("food", 300), _e("food", 100), _e("food", 200)]
+    assert median_by_category(rows) == {"food": 200.0}
+
+
+def test_even_count_averages_two_middle_values():
+    rows = [_e("food", 100), _e("food", 300)]
+    assert median_by_category(rows) == {"food": 200.0}
+
+
+def test_even_count_with_four_values_uses_middle_two():
+    rows = [_e("food", 10), _e("food", 1000), _e("food", 20), _e("food", 30)]
+    # sorted: 10, 20, 30, 1000 -> middle two 20 and 30
+    assert median_by_category(rows) == {"food": 25.0}
+
+
+def test_half_yen_result_is_kept_as_float():
+    rows = [_e("food", 1), _e("food", 2)]
+    assert median_by_category(rows) == {"food": 1.5}
+
+
+def test_all_equal_values_give_that_value():
+    rows = [_e("food", 500), _e("food", 500), _e("food", 500), _e("food", 500)]
+    assert median_by_category(rows) == {"food": 500.0}
+
+
+def test_even_count_with_equal_middle_values():
+    rows = [_e("food", 100), _e("food", 100)]
+    assert median_by_category(rows) == {"food": 100.0}
+
+
+def test_categories_are_computed_separately():
+    rows = [
+        _e("food", 100),
+        _e("rent", 90000),
+        _e("food", 300),
+        _e("rent", 80000),
+        _e("transport", 50),
+    ]
+    assert median_by_category(rows) == {
+        "food": 200.0,
+        "rent": 85000.0,
+        "transport": 50.0,
+    }
+
+
+def test_keys_are_sorted_by_category_name_ascending():
+    rows = [_e("rent", 1), _e("food", 2), _e("transport", 3), _e("book", 4)]
+    out = median_by_category(rows)
+    assert list(out) == ["book", "food", "rent", "transport"]
+
+
+def test_input_order_does_not_change_result():
+    rows = [_e("food", 300), _e("food", 100), _e("food", 200), _e("food", 400)]
+    assert median_by_category(rows) == median_by_category(list(reversed(rows)))
+
+
+def test_input_list_is_not_mutated():
+    rows = [_e("food", 300), _e("food", 100), _e("book", 5)]
+    snapshot = list(rows)
+    median_by_category(rows)
+    assert rows == snapshot
