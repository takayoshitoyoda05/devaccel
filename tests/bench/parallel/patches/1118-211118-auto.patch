@@ -0,0 +1,71 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.dupes import find_duplicates
+
+D = date(2024, 1, 5)
+
+
+def _e(
+    amount: int = 100, category: str = "food", memo: str = "", day: date = D
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+def test_empty_list_has_no_duplicates() -> None:
+    assert find_duplicates([]) == []
+
+
+def test_single_row_has_no_duplicates() -> None:
+    assert find_duplicates([_e()]) == []
+
+
+def test_no_matching_rows_returns_empty() -> None:
+    rows = [_e(amount=1), _e(amount=2), _e(amount=3)]
+    assert find_duplicates(rows) == []
+
+
+def test_pair_of_identical_rows() -> None:
+    assert find_duplicates([_e(), _e()]) == [(0, 1)]
+
+
+def test_differs_in_day_is_not_duplicate() -> None:
+    assert find_duplicates([_e(), _e(day=date(2024, 1, 6))]) == []
+
+
+def test_differs_in_category_is_not_duplicate() -> None:
+    assert find_duplicates([_e(), _e(category="rent")]) == []
+
+
+def test_differs_in_amount_is_not_duplicate() -> None:
+    assert find_duplicates([_e(amount=100), _e(amount=101)]) == []
+
+
+def test_differs_in_memo_is_not_duplicate() -> None:
+    assert find_duplicates([_e(memo="a"), _e(memo="b")]) == []
+
+
+def test_empty_memo_vs_memo_is_not_duplicate() -> None:
+    assert find_duplicates([_e(memo=""), _e(memo="x")]) == []
+
+
+def test_three_identical_rows_yield_all_pairs_in_order() -> None:
+    rows = [_e(), _e(), _e()]
+    assert find_duplicates(rows) == [(0, 1), (0, 2), (1, 2)]
+
+
+def test_non_adjacent_duplicates_and_ordering() -> None:
+    rows = [_e(amount=1), _e(amount=2), _e(amount=1), _e(amount=2)]
+    assert find_duplicates(rows) == [(0, 2), (1, 3)]
+
+
+def test_pairs_sorted_by_i_then_j() -> None:
+    # index 0 matches 3 and 1 (given in that order of input); result must be sorted.
+    rows = [_e(amount=5), _e(amount=7), _e(amount=7), _e(amount=5)]
+    assert find_duplicates(rows) == [(0, 3), (1, 2)]
+
+
+def test_only_strictly_ordered_pairs_i_less_than_j() -> None:
+    rows = [_e(), _e()]
+    for i, j in find_duplicates(rows):
+        assert i < j
