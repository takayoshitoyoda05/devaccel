@@ -0,0 +1,40 @@
+import pytest
+
+from kakeibo.split import split_evenly
+
+
+def test_exact_division_gives_equal_shares() -> None:
+    assert split_evenly(900, 3) == [300, 300, 300]
+
+
+def test_remainder_goes_to_first_people_one_yen_each() -> None:
+    assert split_evenly(10, 3) == [4, 3, 3]
+    assert split_evenly(7, 4) == [2, 2, 2, 1]
+
+
+def test_single_person_gets_everything() -> None:
+    assert split_evenly(1234, 1) == [1234]
+
+
+def test_zero_amount_gives_zero_shares() -> None:
+    assert split_evenly(0, 3) == [0, 0, 0]
+
+
+def test_amount_smaller_than_people_gives_one_yen_to_first_ones() -> None:
+    assert split_evenly(2, 3) == [1, 1, 0]
+
+
+@pytest.mark.parametrize("people", [0, -1])
+def test_people_below_one_raises(people: int) -> None:
+    with pytest.raises(ValueError):
+        split_evenly(100, people)
+
+
+@pytest.mark.parametrize(
+    ("amount", "people"), [(1, 1), (10, 3), (7, 4), (999_999, 7), (5, 5), (2, 3)]
+)
+def test_sum_always_equals_amount(amount: int, people: int) -> None:
+    shares = split_evenly(amount, people)
+    assert len(shares) == people
+    assert sum(shares) == amount
+    assert max(shares) - min(shares) <= 1
