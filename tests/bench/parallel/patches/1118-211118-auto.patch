diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..ed1fc00
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,164 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def E(y: int, m: int, cat: str, amount: int) -> Expense:
+    return Expense(date(y, m, 1), cat, amount)
+
+
+ROWS = [
+    E(2026, 10, "food", 1000),
+    E(2026, 10, "rent", 80000),
+    E(2026, 10, "book", 500),
+    E(2026, 11, "food", 1300),
+    E(2026, 11, "rent", 80000),
+    E(2026, 11, "fun", 700),
+]
+
+
+def test_month_diff_statuses_and_values():
+    by = {r.category: r for r in month_diff(ROWS, "2026-10", "2026-11")}
+    assert by["food"] == DiffRow("food", 1000, 1300, 300, 30.0, "up")
+    assert by["rent"] == DiffRow("rent", 80000, 80000, 0, 0.0, "same")
+    assert by["book"] == DiffRow("book", 500, 0, -500, -100.0, "gone")
+    assert by["fun"] == DiffRow("fun", 0, 700, 700, None, "new")
+    assert len(by) == 4
+
+
+def test_down_status():
+    rows = [E(2026, 10, "food", 2000), E(2026, 11, "food", 1000)]
+    (r,) = month_diff(rows, "2026-10", "2026-11")
+    assert (r.delta, r.pct, r.status) == (-1000, -50.0, "down")
+
+
+def test_only_the_two_months_and_missing_is_zero():
+    rows = [E(2026, 10, "food", 100), E(2026, 9, "misc", 5), E(2026, 12, "x", 9)]
+    got = month_diff(rows, "2026-10", "2026-11")
+    assert got == [DiffRow("food", 100, 0, -100, -100.0, "gone")]
+
+
+def test_status_uses_row_existence_not_sum():
+    # prev のカテゴリは合計 0 だが明細はある -> new にならない。pct は None。
+    rows = [
+        E(2026, 10, "food", 500),
+        E(2026, 10, "food", -500),
+        E(2026, 11, "food", 100),
+    ]
+    (r,) = month_diff(rows, "2026-10", "2026-11")
+    assert (r.prev, r.curr, r.delta, r.pct, r.status) == (0, 100, 100, None, "up")
+
+
+def test_same_status_when_rows_exist_but_sum_equal():
+    rows = [E(2026, 10, "food", 100), E(2026, 11, "food", 50), E(2026, 11, "food", 50)]
+    (r,) = month_diff(rows, "2026-10", "2026-11")
+    assert (r.delta, r.status) == (0, "same")
+
+
+def test_pct_rounding():
+    rows = [E(2026, 10, "a", 3), E(2026, 11, "a", 4)]
+    (r,) = month_diff(rows, "2026-10", "2026-11")
+    assert r.pct == 33.3
+
+
+def test_zero_delta_pct_is_not_negative_zero():
+    rows = [E(2026, 10, "a", -5), E(2026, 11, "a", -5)]
+    (r,) = month_diff(rows, "2026-10", "2026-11")
+    assert r.pct == 0.0
+    assert str(r.pct) == "0.0"
+
+
+def test_sort_by_abs_delta_desc_then_category_asc():
+    rows = [
+        E(2026, 10, "b", 100),
+        E(2026, 11, "b", 200),  # +100
+        E(2026, 10, "a", 500),
+        E(2026, 11, "a", 400),  # -100
+        E(2026, 11, "c", 1000),  # +1000 new
+    ]
+    got = [r.category for r in month_diff(rows, "2026-10", "2026-11")]
+    assert got == ["c", "a", "b"]
+
+
+def test_same_month_twice_gives_all_same():
+    rows = [E(2026, 10, "food", 100)]
+    (r,) = month_diff(rows, "2026-10", "2026-10")
+    assert r.status == "same"
+
+
+@pytest.mark.parametrize(
+    "bad",
+    ["2026-1", "2026-13", "2026-00", "2026/11", "26-11", "2026-11\n", "2026-11-01"],
+)
+def test_bad_month_raises(bad):
+    with pytest.raises(ValueError):
+        month_diff(ROWS, bad, "2026-11")
+    with pytest.raises(ValueError):
+        month_diff(ROWS, "2026-10", bad)
+
+
+def test_top_movers_excludes_same_keeps_order():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    got = [r.category for r in top_movers(diffs)]
+    assert got == ["fun", "book", "food"]
+    assert [r.category for r in top_movers(diffs, 1)] == ["fun"]
+    assert top_movers(diffs, 0) == []
+
+
+def test_top_movers_n_negative_raises():
+    with pytest.raises(ValueError):
+        top_movers([], -1)
+
+
+def test_render_diff_format():
+    diffs = [
+        DiffRow("food", 1000, 1300, 300, 30.0, "up"),
+        DiffRow("rent", 80000, 80000, 0, 0.0, "same"),
+        DiffRow("book", 2000, 0, -2000, -100.0, "gone"),
+        DiffRow("fun", 0, 700, 700, None, "new"),
+    ]
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "food\t1000\t1300\t+300\t+30.0%\n"
+        "rent\t80000\t80000\t+0\t+0.0%\n"
+        "book\t2000\t0\t-2000\t-100.0%\n"
+        "fun\t0\t700\t+700\t-"
+    )
+
+
+def test_render_diff_empty_is_header_only():
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_available_months_sorted_unique():
+    rows = [
+        E(2026, 11, "a", 1),
+        E(2026, 9, "a", 1),
+        E(2026, 11, "b", 1),
+        E(2025, 12, "a", 1),
+    ]
+    assert available_months(rows) == ["2025-12", "2026-09", "2026-11"]
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months():
+    rows = ROWS + [E(2026, 9, "food", 1)]
+    got = latest_diff(rows)
+    assert got == month_diff(rows, "2026-10", "2026-11")
+
+
+def test_latest_diff_needs_two_months():
+    with pytest.raises(ValueError):
+        latest_diff([E(2026, 11, "food", 1), E(2026, 11, "rent", 2)])
+    with pytest.raises(ValueError):
+        latest_diff([])
diff --git a/tests/test_query.py b/tests/test_query.py
