index 0000000..c029761
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,254 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def _e(category: str, memo: str = "", amount: int = 100) -> Expense:
+    return Expense(day=date(2026, 11, 1), category=category, amount=amount, memo=memo)
+
+
+ROWS = [
+    _e("food", "lunch", 1200),
+    _e("rent", "", 80000),
+    _e("food", "coffee", 800),
+    _e("food2", "food", 300),
+    _e("食費", "lunch with friends", 500),
+]
+
+
+# --- tokenize -------------------------------------------------------------
+
+
+@pytest.mark.parametrize("q", ["", "   ", "\t \n"])
+def test_tokenize_blank_gives_no_tokens(q):
+    assert tokenize(q) == []
+
+
+def test_tokenize_words_split_on_spaces():
+    assert tokenize("食費  lunch") == [("TERM", "食費"), ("TERM", "lunch")]
+
+
+def test_tokenize_parens():
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+
+
+def test_tokenize_quoted_keeps_spaces_and_parens():
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+
+
+def test_tokenize_quoted_space_only_is_not_empty():
+    assert tokenize('" "') == [("TERM", " ")]
+
+
+@pytest.mark.parametrize("q", ['"abc', '""', 'x "y'])
+def test_tokenize_bad_quotes_raise(q):
+    with pytest.raises(QueryError):
+        tokenize(q)
+
+
+def test_tokenize_operator_keywords_uppercase_only():
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+    assert tokenize("and or not Not") == [
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+        ("TERM", "Not"),
+    ]
+
+
+def test_tokenize_cat_prefix():
+    assert tokenize("cat:食費") == [("CAT", "食費")]
+    assert tokenize("cat:food y") == [("CAT", "food"), ("TERM", "y")]
+
+
+def test_tokenize_cat_prefix_is_lowercase_only():
+    assert tokenize("CAT:food") == [("TERM", "CAT:food")]
+
+
+def test_tokenize_bare_cat_is_term():
+    assert tokenize("cat") == [("TERM", "cat")]
+
+
+def test_tokenize_empty_cat_raises():
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+    with pytest.raises(QueryError):
+        tokenize("(cat:)")
+
+
+def test_tokenize_word_stops_at_quote():
+    assert tokenize('a"b"') == [("TERM", "a"), ("TERM", "b")]
+
+
+def test_tokenize_word_stops_at_paren():
+    assert tokenize("NOT(a)") == [
+        ("NOT", "NOT"),
+        ("LPAREN", "("),
+        ("TERM", "a"),
+        ("RPAREN", ")"),
+    ]
+
+
+# --- parse errors ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "(",
+        ")",
+        "()",
+        "a)",
+        "(a",
+        "a OR",
+        "OR a",
+        "a AND",
+        "AND a",
+        "a AND AND b",
+        "a OR OR b",
+        "a OR (b",
+        "NOT",
+        "NOT )",
+        "NOT AND a",
+        "( ) a",
+    ],
+)
+def test_invalid_query_raises(q):
+    with pytest.raises(QueryError):
+        matches(q, ROWS[0])
+
+
+@pytest.mark.parametrize("q", ["", "(", "a AND", "cat:", '"x'])
+def test_invalid_query_raises_even_with_no_rows(q):
+    with pytest.raises(QueryError):
+        filter_rows(q, [])
+
+
+def test_valid_query_with_no_rows_is_empty():
+    assert filter_rows("lunch", []) == []
+
+
+# --- evaluation -----------------------------------------------------------
+
+
+def test_term_matches_memo_substring():
+    assert matches("lunch", ROWS[0])
+    assert matches("with", ROWS[4])
+
+
+def test_term_matches_category_substring():
+    assert matches("食", ROWS[4])
+
+
+def test_term_does_not_match_when_absent():
+    assert not matches("lunch", ROWS[1])
+
+
+def test_term_is_case_insensitive():
+    assert matches("LUNCH", ROWS[0])
+    assert matches("Food", ROWS[0])
+
+
+def test_term_uses_casefold_not_lower():
+    assert matches("STRASSE", _e("x", "straße"))
+
+
+def test_cat_is_exact_on_category():
+    assert matches("cat:food", ROWS[0])
+    assert not matches("cat:food", ROWS[3])  # "food2" is not "food"
+    assert not matches("cat:food", _e("rent", "food"))  # memo does not count
+
+
+def test_cat_is_case_insensitive():
+    assert matches("cat:FOOD", ROWS[0])
+
+
+def test_cat_does_not_do_substring():
+    assert not matches("cat:foo", ROWS[0])
+
+
+def test_and_requires_both():
+    assert matches("food lunch", ROWS[0])
+    assert not matches("food coffee AND lunch", ROWS[2])
+
+
+def test_and_explicit_equals_implicit():
+    q1 = filter_rows("food lunch", ROWS)
+    q2 = filter_rows("food AND lunch", ROWS)
+    assert q1 == q2 == [ROWS[0]]
+
+
+def test_or_either():
+    assert matches("rent OR lunch", ROWS[0])
+    assert matches("rent OR lunch", ROWS[1])
+    assert not matches("rent OR lunch", ROWS[2])
+
+
+def test_and_binds_tighter_than_or():
+    # rent OR (lunch AND coffee): row "rent" with empty memo is true.
+    # ((rent OR lunch) AND coffee) would be false for it.
+    assert matches("rent OR lunch coffee", ROWS[1])
+
+
+def test_not_binds_tighter_than_and():
+    # (NOT a) AND b
+    assert not matches("NOT lunch coffee", ROWS[0])  # lunch present -> false
+    assert matches("NOT lunch coffee", ROWS[2])  # coffee present, lunch absent
+
+
+def test_not_binds_tighter_than_or():
+    # (NOT a) OR b, not NOT (a OR b)
+    row = _e("x", "a b")
+    assert matches("NOT a OR b", row)
+
+
+def test_not_not():
+    assert matches("NOT NOT lunch", ROWS[0])
+    assert not matches("NOT NOT lunch", ROWS[1])
+
+
+def test_not_term_absent_is_true():
+    assert matches("NOT zzz", ROWS[0])
+    assert not matches("NOT lunch", ROWS[0])
+
+
+def test_parens_override_precedence():
+    assert matches("food AND (coffee OR rent)", ROWS[2])
+    assert not matches("food AND (coffee OR rent)", ROWS[0])
+
+
+def test_quoted_term_with_space():
+    assert matches('"lunch with"', ROWS[4])
+    assert not matches('"lunch with"', ROWS[0])
+
+
+def test_quoted_term_with_parens_is_literal():
+    assert matches('"(x)"', _e("a", "a (x) b"))
+    assert not matches('"(x)"', _e("a", "x"))
+
+
+def test_matches_returns_bool():
+    assert matches("lunch", ROWS[0]) is True
+    assert matches("zzz", ROWS[0]) is False
+
+
+# --- filter_rows ----------------------------------------------------------
+
+
+def test_filter_rows_keeps_input_order():
+    assert filter_rows("food", ROWS) == [ROWS[0], ROWS[2], ROWS[3]]
+
+
+def test_filter_rows_no_match_is_empty():
+    assert filter_rows("zzz", ROWS) == []
+
+
+def test_filter_rows_returns_new_list():
+    out = filter_rows("food", ROWS)
+    assert out is not ROWS
+    assert len(ROWS) == 5
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..658e7a9
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,180 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def e(day: date, category: str = "通信", amount: int = 1000, memo: str = "") -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# add_month
+
+
+@pytest.mark.parametrize(
+    ("src", "expected"),
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2024, 1, 31), date(2024, 2, 29)),
+        (date(2026, 12, 15), date(2027, 1, 15)),
+        (date(2026, 3, 31), date(2026, 4, 30)),
+        (date(2026, 11, 5), date(2026, 12, 5)),
+        (date(2026, 2, 28), date(2026, 3, 28)),
+    ],
+)
+def test_add_month(src: date, expected: date) -> None:
+    assert add_month(src) == expected
+
+
+# find_recurring: argument validation
+
+
+@pytest.mark.parametrize(("min_count", "tolerance"), [(1, 3), (0, 3), (3, -1)])
+def test_invalid_arguments_raise(min_count: int, tolerance: int) -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=min_count, tolerance=tolerance)
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+# find_recurring: detection
+
+
+def test_three_monthly_payments_detected() -> None:
+    rows = [e(date(2026, 1, 15)), e(date(2026, 2, 15)), e(date(2026, 3, 15))]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="通信",
+            amount=1000,
+            days=(date(2026, 1, 15), date(2026, 2, 15), date(2026, 3, 15)),
+            next_expected=date(2026, 4, 15),
+        )
+    ]
+
+
+def test_fewer_than_min_count_not_detected() -> None:
+    rows = [e(date(2026, 1, 15)), e(date(2026, 2, 15))]
+    assert find_recurring(rows) == []
+
+
+def test_min_count_two_accepts_two() -> None:
+    rows = [e(date(2026, 1, 15)), e(date(2026, 2, 15))]
+    result = find_recurring(rows, min_count=2)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 15), date(2026, 2, 15))
+
+
+def test_memo_is_ignored_for_grouping() -> None:
+    rows = [
+        e(date(2026, 1, 15), memo="a"),
+        e(date(2026, 2, 15), memo="b"),
+        e(date(2026, 3, 15), memo=""),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_different_amount_is_separate_group() -> None:
+    rows = [
+        e(date(2026, 1, 15), amount=1000),
+        e(date(2026, 2, 15), amount=1000),
+        e(date(2026, 3, 15), amount=999),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_duplicate_dates_counted_once() -> None:
+    rows = [
+        e(date(2026, 1, 15)),
+        e(date(2026, 1, 15)),
+        e(date(2026, 2, 15)),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_unsorted_input_is_sorted_in_days() -> None:
+    rows = [e(date(2026, 3, 15)), e(date(2026, 1, 15)), e(date(2026, 2, 15))]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 15), date(2026, 2, 15), date(2026, 3, 15))
+
+
+def test_month_end_within_tolerance_connects() -> None:
+    # add_month(01-31) = 02-28, 03-31 is 3 days after add_month(02-28) = 03-28
+    rows = [e(date(2026, 1, 31)), e(date(2026, 2, 28)), e(date(2026, 3, 31))]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 30)
+
+
+def test_gap_beyond_tolerance_splits_run() -> None:
+    # expected 2026-02-15 after 01-15, got 02-19 (4 days off > tolerance 3): run is cut
+    rows = [e(date(2026, 1, 15)), e(date(2026, 2, 19)), e(date(2026, 3, 19))]
+    assert find_recurring(rows) == []
+
+
+def test_gap_within_tolerance_connects() -> None:
+    rows = [e(date(2026, 1, 15)), e(date(2026, 2, 18)), e(date(2026, 3, 18))]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_tolerance_zero_requires_exact_day() -> None:
+    rows = [e(date(2026, 1, 15)), e(date(2026, 2, 16)), e(date(2026, 3, 15))]
+    assert find_recurring(rows, tolerance=0) == []
+    rows_exact = [e(date(2026, 1, 15)), e(date(2026, 2, 15)), e(date(2026, 3, 15))]
+    assert len(find_recurring(rows_exact, tolerance=0)) == 1
+
+
+def test_break_splits_into_runs_and_short_run_dropped() -> None:
+    rows = [
+        e(date(2026, 1, 15)),
+        e(date(2026, 2, 15)),
+        e(date(2026, 3, 15)),
+        e(date(2026, 6, 15)),  # break: long gap
+        e(date(2026, 7, 15)),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 15), date(2026, 2, 15), date(2026, 3, 15))
+
+
+def test_two_runs_both_kept() -> None:
+    rows = [
+        e(date(2026, 1, 15)),
+        e(date(2026, 2, 15)),
+        e(date(2026, 3, 15)),
+        e(date(2026, 8, 1)),
+        e(date(2026, 9, 1)),
+        e(date(2026, 10, 1)),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 15), date(2026, 8, 1)]
+
+
+def test_year_boundary_connects() -> None:
+    rows = [e(date(2025, 12, 10)), e(date(2026, 1, 10)), e(date(2026, 2, 10))]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 3, 10)
+
+
+def test_results_sorted_by_category_amount_first_day() -> None:
+    rows = [
+        e(date(2026, 1, 1), category="食費", amount=500),
+        e(date(2026, 2, 1), category="食費", amount=500),
+        e(date(2026, 3, 1), category="食費", amount=500),
+        e(date(2026, 1, 5), category="交通", amount=2000),
+        e(date(2026, 2, 5), category="交通", amount=2000),
+        e(date(2026, 3, 5), category="交通", amount=2000),
+        e(date(2026, 1, 9), category="交通", amount=100),
+        e(date(2026, 2, 9), category="交通", amount=100),
+        e(date(2026, 3, 9), category="交通", amount=100),
+    ]
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [
+        ("交通", 100),
+        ("交通", 2000),
+        ("食費", 500),
+    ]
