@@ -0,0 +1,23 @@
+"""Detect duplicate expense rows."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def find_duplicates(rows: list[Expense]) -> list[tuple[int, int]]:
+    """Return index pairs (i, j), i < j, of rows that are fully equal.
+
+    Sorted by i ascending, then j ascending.
+    """
+    groups: dict[Expense, list[int]] = {}
+    for idx, row in enumerate(rows):
+        groups.setdefault(row, []).append(idx)
+
+    pairs: list[tuple[int, int]] = []
+    for idxs in groups.values():
+        for a in range(len(idxs)):
+            for b in range(a + 1, len(idxs)):
+                pairs.append((idxs[a], idxs[b]))
+    pairs.sort()
+    return pairs
