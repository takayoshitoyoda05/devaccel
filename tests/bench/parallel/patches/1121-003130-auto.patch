+"""月ごとのカテゴリ別支出と前月比(純粋関数)。
+
+入力は core.monthly_totals の形 ``{"YYYY-MM": {category: yen}}``。
+
+決めた扱い:
+D1: 「前月」は暦の前月。データにある直前の月ではない(2025-12 の前月は 2025-11、
+    2026-01 の前月は 2025-12)。
+D2: 前月がデータに無い月(最初の月・欠けた月の翌月)は比較の基準が無いので結果に含めない。
+    支出ゼロの月と「データ無し」は区別できないため、推測で全カテゴリを「新規」にしない。
+D3: 区分は金額ではなくキーの有無で決める。前月に無く今月にある=new、前月にあり今月に無い=gone、
+    両方にあり金額が増=up・減=down・同額=same。金額 0 のカテゴリも「ある」と数える。
+D4: delta は今月 - 前月。new は前月を 0、gone は今月を 0 として数える(prev/curr 自体は None)。
+D5: 増減率 pct(%)は前月が正のときだけ。前月が 0 以下(new・返金で負の月を含む)は None
+    (0 での割り算を避ける)。gone は -100.0。
+D6: 返金などの負の金額はそのまま合計に含める(丸めも除外もしない)。
+D7: 並びは |delta| の降順、同点はカテゴリ名の昇順。same も含める。
+D8: 月キーが YYYY-MM でなければ ValueError。空入力・1 か月だけの入力は空の dict。
+D9: 入力は変更しない。
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from typing import Literal
+
+Status = Literal["new", "gone", "up", "down", "same"]
+
+_MONTH_RE = re.compile(r"([0-9]{4})-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    status: Status
+    prev: int | None  # 前月の金額(前月に無ければ None)
+    curr: int | None  # 今月の金額(今月に無ければ None)
+    delta: int  # 今月 - 前月(無い側は 0 として)
+    pct: float | None  # 増減率(%)。前月が正のときだけ
+
+
+def previous_month(month: str) -> str:
+    """ "2026-01" -> "2025-12"。"""
+    m = _MONTH_RE.fullmatch(month)
+    if m is None:
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+    year, mon = int(m.group(1)), int(m.group(2))
+    if mon == 1:
+        year, mon = year - 1, 12
+    else:
+        mon -= 1
+    return f"{year:04d}-{mon:02d}"
+
+
+def diff_categories(prev: dict[str, int], curr: dict[str, int]) -> list[CategoryChange]:
+    """2 か月分のカテゴリ別合計を比べる。"""
+    out: list[CategoryChange] = []
+    for cat in prev.keys() | curr.keys():
+        p = prev.get(cat)
+        c = curr.get(cat)
+        delta = (c or 0) - (p or 0)
+        status: Status
+        if p is None:
+            status = "new"
+        elif c is None:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        pct = delta / p * 100 if p is not None and p > 0 else None
+        out.append(CategoryChange(cat, status, p, c, delta, pct))
+    out.sort(key=lambda ch: (-abs(ch.delta), ch.category))
+    return out
+
+
+def monthly_changes(
+    totals: dict[str, dict[str, int]],
+) -> dict[str, list[CategoryChange]]:
+    """{"YYYY-MM": 前月比の一覧}。前月がデータにある月だけ、月の昇順で返す。"""
+    prevs = {month: previous_month(month) for month in totals}  # 不正な月はここで例外
+    return {
+        month: diff_categories(totals[prevs[month]], totals[month])
+        for month in sorted(totals)
+        if prevs[month] in totals
+    }
diff --git a/tests/test_monthly_diff.py b/tests/test_monthly_diff.py
