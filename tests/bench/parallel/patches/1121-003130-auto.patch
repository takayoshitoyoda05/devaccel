+++ b/tests/test_monthly_diff.py
@@ -0,0 +1,111 @@
+import pytest
+
+from kakeibo.monthly_diff import (
+    CategoryChange,
+    diff_categories,
+    monthly_changes,
+    previous_month,
+)
+
+
+def by_cat(changes: list[CategoryChange]) -> dict[str, CategoryChange]:
+    return {c.category: c for c in changes}
+
+
+def test_all_statuses() -> None:
+    prev = {"food": 1000, "rent": 5000, "fun": 800, "gas": 300}
+    curr = {"food": 1500, "rent": 5000, "fun": 200, "pet": 700}
+    r = by_cat(diff_categories(prev, curr))
+    assert r["food"] == CategoryChange("food", "up", 1000, 1500, 500, 50.0)
+    assert r["fun"] == CategoryChange("fun", "down", 800, 200, -600, -75.0)
+    assert r["rent"] == CategoryChange("rent", "same", 5000, 5000, 0, 0.0)
+    assert r["gas"] == CategoryChange("gas", "gone", 300, None, -300, -100.0)
+    assert r["pet"] == CategoryChange("pet", "new", None, 700, 700, None)
+
+
+def test_zero_amount_category_counts_as_present() -> None:
+    r = by_cat(diff_categories({"a": 0}, {"a": 500}))
+    assert r["a"].status == "up"
+    assert r["a"].pct is None  # 前月 0 での割り算は避ける
+    r2 = by_cat(diff_categories({"a": 500}, {"a": 0}))
+    assert r2["a"].status == "down"
+    assert r2["a"].curr == 0
+
+
+def test_negative_prev_has_no_pct() -> None:
+    r = by_cat(diff_categories({"a": -300}, {"a": 200}))
+    assert r["a"].status == "up"
+    assert r["a"].delta == 500
+    assert r["a"].pct is None
+
+
+def test_order_abs_delta_desc_then_name() -> None:
+    prev = {"b": 100, "a": 100, "c": 1000}
+    curr = {"b": 200, "a": 200, "c": 0}
+    assert [c.category for c in diff_categories(prev, curr)] == ["c", "a", "b"]
+
+
+def test_empty_both() -> None:
+    assert diff_categories({}, {}) == []
+
+
+def test_inputs_not_mutated() -> None:
+    prev = {"a": 1}
+    curr = {"b": 2}
+    diff_categories(prev, curr)
+    assert prev == {"a": 1} and curr == {"b": 2}
+
+
+@pytest.mark.parametrize(
+    ("month", "expected"),
+    [("2026-03", "2026-02"), ("2026-01", "2025-12"), ("0001-12", "0001-11")],
+)
+def test_previous_month(month: str, expected: str) -> None:
+    assert previous_month(month) == expected
+
+
+@pytest.mark.parametrize(
+    "bad", ["2026-13", "2026-00", "2026-1", "202601", "", "abcd-ef"]
+)
+def test_previous_month_invalid(bad: str) -> None:
+    with pytest.raises(ValueError):
+        previous_month(bad)
+
+
+def test_monthly_changes_year_boundary() -> None:
+    totals = {"2025-12": {"food": 1000}, "2026-01": {"food": 900, "gym": 300}}
+    res = monthly_changes(totals)
+    assert list(res) == ["2026-01"]
+    assert [(c.category, c.status) for c in res["2026-01"]] == [
+        ("gym", "new"),
+        ("food", "down"),
+    ]
+
+
+def test_monthly_changes_gap_month_has_no_baseline() -> None:
+    totals = {
+        "2026-01": {"a": 100},
+        "2026-02": {"a": 150},
+        "2026-04": {"a": 999},  # 3 月が無い → 基準なし
+    }
+    assert list(monthly_changes(totals)) == ["2026-02"]
+
+
+def test_monthly_changes_sorted_by_month() -> None:
+    totals = {"2026-03": {"a": 3}, "2026-01": {"a": 1}, "2026-02": {"a": 2}}
+    assert list(monthly_changes(totals)) == ["2026-02", "2026-03"]
+
+
+def test_monthly_changes_empty_and_single() -> None:
+    assert monthly_changes({}) == {}
+    assert monthly_changes({"2026-01": {"a": 1}}) == {}
+
+
+def test_monthly_changes_empty_month_is_baseline() -> None:
+    res = monthly_changes({"2026-01": {}, "2026-02": {"a": 5}})
+    assert res["2026-02"][0].status == "new"
+
+
+def test_monthly_changes_invalid_month_key() -> None:
+    with pytest.raises(ValueError):
+        monthly_changes({"2026-1": {"a": 1}})
