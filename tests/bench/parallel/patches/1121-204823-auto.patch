diff --git a/tests/test_report_total.py b/tests/test_report_total.py
new file mode 100644
index 0000000..2664ffc
--- /dev/null
+++ b/tests/test_report_total.py
@@ -0,0 +1,96 @@
+import sys
+
+from kakeibo import main
+
+HEADER = "date,category,amount,memo\n"
+BODY = (
+    "2026-10-15,food,500,coffee\n"
+    "2026-11-01,food,1200,lunch\n"
+    "2026-11-02,rent,80000,\n"
+    "2026-11-03,food,800,coffee\n"
+    "2026-12-01,food,300,\n"
+)
+
+
+def _run(tmp_path, monkeypatch, capsys, *args, body=BODY):
+    p = tmp_path / "in.csv"
+    p.write_text(HEADER + body, encoding="utf-8")
+    monkeypatch.setattr(sys, "argv", ["kakeibo", str(p), *args])
+    main()
+    return capsys.readouterr()
+
+
+def test_report_without_total_unchanged(tmp_path, monkeypatch, capsys):
+    out = _run(tmp_path, monkeypatch, capsys, "--report")
+    assert out.out == (
+        "2026-10\tfood\t500\n"
+        "2026-11\trent\t80000\n"
+        "2026-11\tfood\t2000\n"
+        "2026-12\tfood\t300\n"
+    )
+
+
+def test_report_total_has_monthly_subtotals_and_grand_total(
+    tmp_path, monkeypatch, capsys
+):
+    out = _run(tmp_path, monkeypatch, capsys, "--report", "--total")
+    assert out.out == (
+        "2026-10\tfood\t500\n"
+        "2026-10\tSUBTOTAL\t500\n"
+        "2026-11\trent\t80000\n"
+        "2026-11\tfood\t2000\n"
+        "2026-11\tSUBTOTAL\t82000\n"
+        "2026-12\tfood\t300\n"
+        "2026-12\tSUBTOTAL\t300\n"
+        "TOTAL\t82800\n"
+    )
+    assert out.err == ""
+
+
+def test_report_total_with_memo_filter(tmp_path, monkeypatch, capsys):
+    out = _run(tmp_path, monkeypatch, capsys, "--report", "--total", "--memo", "coffee")
+    assert out.out == (
+        "2026-10\tfood\t500\n"
+        "2026-10\tSUBTOTAL\t500\n"
+        "2026-11\tfood\t800\n"
+        "2026-11\tSUBTOTAL\t800\n"
+        "TOTAL\t1300\n"
+    )
+
+
+def test_report_total_memo_no_match_is_total_zero_only(tmp_path, monkeypatch, capsys):
+    out = _run(tmp_path, monkeypatch, capsys, "--report", "--total", "--memo", "zzz")
+    assert out.out == "TOTAL\t0\n"
+    assert "メモに一致する行がありません" in out.err
+
+
+def test_report_total_header_only_csv(tmp_path, monkeypatch, capsys):
+    out = _run(tmp_path, monkeypatch, capsys, "--report", "--total", body="")
+    assert out.out == "TOTAL\t0\n"
+
+
+def test_report_total_refund_nets_out_to_zero_month(tmp_path, monkeypatch, capsys):
+    body = "2026-11-01,food,1000,\n2026-11-02,food,-1000,\n"
+    out = _run(tmp_path, monkeypatch, capsys, "--report", "--total", body=body)
+    assert out.out == ("2026-11\tfood\t0\n2026-11\tSUBTOTAL\t0\nTOTAL\t0\n")
+
+
+def test_report_total_ignores_category_and_format(tmp_path, monkeypatch, capsys):
+    base = _run(tmp_path, monkeypatch, capsys, "--report", "--total")
+    out = _run(
+        tmp_path,
+        monkeypatch,
+        capsys,
+        "--report",
+        "--total",
+        "--category",
+        "food",
+        "--format",
+        "csv",
+    )
+    assert out.out == base.out
+
+
+def test_default_total_still_unchanged(tmp_path, monkeypatch, capsys):
+    out = _run(tmp_path, monkeypatch, capsys, "--total")
+    assert out.out == "rent\t80,000\nfood\t2,800\nTOTAL\t82,800\n"
