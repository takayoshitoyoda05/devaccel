+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.weekday import total_by_weekday
+
+
+def _e(day: date, amount: int) -> Expense:
+    return Expense(day=day, category="食費", amount=amount)
+
+
+def test_empty_rows_returns_empty_dict() -> None:
+    assert total_by_weekday([]) == {}
+
+
+def test_sums_amounts_per_weekday() -> None:
+    rows = [
+        _e(date(2026, 11, 16), 1000),  # Mon
+        _e(date(2026, 11, 23), 500),  # Mon
+        _e(date(2026, 11, 18), 300),  # Wed
+    ]
+    assert total_by_weekday(rows) == {"Mon": 1500, "Wed": 300}
+
+
+def test_keys_are_in_monday_first_order() -> None:
+    rows = [
+        _e(date(2026, 11, 22), 1),  # Sun
+        _e(date(2026, 11, 18), 2),  # Wed
+        _e(date(2026, 11, 16), 3),  # Mon
+    ]
+    assert list(total_by_weekday(rows)) == ["Mon", "Wed", "Sun"]
+
+
+def test_omits_weekdays_without_expenses() -> None:
+    rows = [_e(date(2026, 11, 21), 700)]  # Sat
+    result = total_by_weekday(rows)
+    assert result == {"Sat": 700}
+    assert "Mon" not in result
+
+
+def test_all_seven_weekdays() -> None:
+    rows = [_e(date(2026, 11, 16 + i), 10 * (i + 1)) for i in range(7)]
+    assert total_by_weekday(rows) == {
+        "Mon": 10,
+        "Tue": 20,
+        "Wed": 30,
+        "Thu": 40,
+        "Fri": 50,
+        "Sat": 60,
+        "Sun": 70,
+    }
