@@ -0,0 +1,16 @@
+"""Expense totals grouped by day of the week."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+_WEEKDAYS = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
+
+
+def total_by_weekday(rows: list[Expense]) -> dict[str, int]:
+    """{"Mon".."Sun": yen}; weekdays without expenses are omitted, Monday first."""
+    totals: dict[str, int] = {}
+    for e in rows:
+        name = _WEEKDAYS[e.day.weekday()]
+        totals[name] = totals.get(name, 0) + e.amount
+    return {name: totals[name] for name in _WEEKDAYS if name in totals}
diff --git a/tests/test_dupes.py b/tests/test_dupes.py
new file mode 100644
index 0000000..1739a51
--- /dev/null
+++ b/tests/test_dupes.py
@@ -0,0 +1,66 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.dupes import find_duplicates
+
+
+def _e(day: str, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(date.fromisoformat(day), category, amount, memo)
+
+
+def test_empty_list_has_no_duplicates() -> None:
+    assert find_duplicates([]) == []
+
+
+def test_no_duplicates_returns_empty() -> None:
+    rows = [_e("2024-01-01", "food", 100), _e("2024-01-02", "food", 100)]
+    assert find_duplicates(rows) == []
+
+
+def test_single_pair() -> None:
+    rows = [
+        _e("2024-01-01", "food", 100, "lunch"),
+        _e("2024-01-01", "food", 100, "lunch"),
+    ]
+    assert find_duplicates(rows) == [(0, 1)]
+
+
+def test_differs_in_any_field_is_not_duplicate() -> None:
+    rows = [
+        _e("2024-01-01", "food", 100, "lunch"),
+        _e("2024-01-02", "food", 100, "lunch"),  # day differs
+        _e("2024-01-01", "fun", 100, "lunch"),  # category differs
+        _e("2024-01-01", "food", 101, "lunch"),  # amount differs
+        _e("2024-01-01", "food", 100, "dinner"),  # memo differs
+        _e("2024-01-01", "food", 100, ""),  # memo empty
+    ]
+    assert find_duplicates(rows) == []
+
+
+def test_empty_memo_matches_empty_memo() -> None:
+    rows = [_e("2024-01-01", "food", 100), _e("2024-01-01", "food", 100)]
+    assert find_duplicates(rows) == [(0, 1)]
+
+
+def test_triple_yields_all_pairs_in_order() -> None:
+    rows = [_e("2024-01-01", "food", 100)] * 3
+    assert find_duplicates(rows) == [(0, 1), (0, 2), (1, 2)]
+
+
+def test_order_by_i_then_j_with_interleaved_groups() -> None:
+    rows = [
+        _e("2024-01-01", "food", 100),  # 0
+        _e("2024-01-02", "fun", 50),  # 1
+        _e("2024-01-02", "fun", 50),  # 2
+        _e("2024-01-01", "food", 100),  # 3
+        _e("2024-01-02", "fun", 50),  # 4
+    ]
+    assert find_duplicates(rows) == [(0, 3), (1, 2), (1, 4), (2, 4)]
+
+
+def test_pairs_are_index_ordered_i_less_than_j() -> None:
+    rows = [_e("2024-01-01", "food", 100)] * 4
+    result = find_duplicates(rows)
+    assert all(i < j for i, j in result)
+    assert result == sorted(result)
+    assert len(result) == 6
