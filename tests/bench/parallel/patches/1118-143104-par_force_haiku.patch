index 0000000..c9ac1ad
--- /dev/null
+++ b/src/kakeibo/streak.py
@@ -0,0 +1,27 @@
+"""No-spend streak: longest run of consecutive days without any expense."""
+
+from __future__ import annotations
+
+from datetime import date, timedelta
+
+from kakeibo.core import Expense
+
+
+def longest_no_spend_streak(rows: list[Expense], start: date, end: date) -> int:
+    """Return the longest run of consecutive days in [start, end] with no expense.
+
+    Both ends are inclusive. Expenses outside the range are ignored.
+    Returns 0 when the range is empty (start > end) or every day has an expense.
+    """
+    spend_days = {e.day for e in rows if start <= e.day <= end}
+    longest = 0
+    current = 0
+    day = start
+    while day <= end:
+        if day in spend_days:
+            current = 0
+        else:
+            current += 1
+            longest = max(longest, current)
+        day += timedelta(days=1)
+    return longest
