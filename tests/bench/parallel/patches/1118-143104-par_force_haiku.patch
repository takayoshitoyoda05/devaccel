+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.stats import median_by_category
+
+
+def _e(category: str, amount: int) -> Expense:
+    return Expense(day=date(2026, 1, 1), category=category, amount=amount)
+
+
+def test_empty_returns_empty_dict() -> None:
+    assert median_by_category([]) == {}
+
+
+def test_odd_count_uses_middle_value() -> None:
+    rows = [_e("食費", 300), _e("食費", 100), _e("食費", 200)]
+    assert median_by_category(rows) == {"食費": 200.0}
+
+
+def test_even_count_averages_middle_two() -> None:
+    rows = [_e("食費", 100), _e("食費", 400), _e("食費", 200), _e("食費", 300)]
+    assert median_by_category(rows) == {"食費": 250.0}
+
+
+def test_single_row() -> None:
+    assert median_by_category([_e("交通", 540)]) == {"交通": 540.0}
+
+
+def test_keys_sorted_ascending_by_category_name() -> None:
+    rows = [_e("娯楽", 1), _e("交通", 2), _e("食費", 3)]
+    result = median_by_category(rows)
+    assert list(result) == ["交通", "娯楽", "食費"]
+
+
+def test_categories_are_independent() -> None:
+    rows = [_e("食費", 100), _e("食費", 300), _e("交通", 1000)]
+    assert median_by_category(rows) == {"交通": 1000.0, "食費": 200.0}
+
+
+def test_returns_float_values() -> None:
+    result = median_by_category([_e("食費", 1), _e("食費", 2)])
+    assert isinstance(result["食費"], float)
+    assert result["食費"] == 1.5
