@@ -0,0 +1,59 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.streak import longest_no_spend_streak
+
+
+def _e(day: date) -> Expense:
+    return Expense(day=day, category="食費", amount=100)
+
+
+def test_no_rows_counts_whole_range_inclusive() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 1), date(2026, 1, 5)) == 5
+
+
+def test_single_day_range_without_spend() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 1), date(2026, 1, 1)) == 1
+
+
+def test_single_day_range_with_spend() -> None:
+    rows = [_e(date(2026, 1, 1))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 1)) == 0
+
+
+def test_every_day_has_spend() -> None:
+    rows = [_e(date(2026, 1, d)) for d in range(1, 6)]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 5)) == 0
+
+
+def test_longest_run_in_middle() -> None:
+    rows = [_e(date(2026, 1, 1)), _e(date(2026, 1, 4)), _e(date(2026, 1, 8))]
+    # no-spend runs: 2-3 (2 days), 5-7 (3 days)
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 8)) == 3
+
+
+def test_run_at_start_and_end() -> None:
+    rows = [_e(date(2026, 1, 3))]
+    # 1-2 (2 days) and 4-5 (2 days)
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 5)) == 2
+
+
+def test_multiple_expenses_same_day_are_one_spend_day() -> None:
+    rows = [_e(date(2026, 1, 2)), _e(date(2026, 1, 2)), _e(date(2026, 1, 5))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 5)) == 2
+
+
+def test_expenses_outside_range_are_ignored() -> None:
+    rows = [_e(date(2025, 12, 31)), _e(date(2026, 1, 10))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 5)) == 5
+
+
+def test_run_crosses_month_boundary() -> None:
+    rows = [_e(date(2026, 1, 30)), _e(date(2026, 2, 3))]
+    # no-spend days 1/31, 2/1, 2/2 cross the month boundary
+    assert longest_no_spend_streak(rows, date(2026, 1, 30), date(2026, 2, 3)) == 3
+    assert longest_no_spend_streak([], date(2026, 1, 30), date(2026, 2, 3)) == 5
+
+
+def test_start_after_end_returns_zero() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 5), date(2026, 1, 1)) == 0
diff --git a/tests/test_topn.py b/tests/test_topn.py
