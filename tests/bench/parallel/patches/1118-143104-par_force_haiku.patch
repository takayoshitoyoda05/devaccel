+import json
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.export import to_json
+
+
+def test_to_json_keeps_input_order_and_key_order():
+    rows = [
+        Expense(date(2026, 11, 2), "rent", 80000, "家賃"),
+        Expense(date(2026, 11, 1), "food", 1200),
+    ]
+    out = to_json(rows)
+    assert out == (
+        '[{"date": "2026-11-02", "category": "rent", "amount": 80000, "memo": "家賃"}, '
+        '{"date": "2026-11-01", "category": "food", "amount": 1200, "memo": ""}]'
+    )
+
+
+def test_to_json_does_not_escape_non_ascii():
+    out = to_json([Expense(date(2026, 11, 1), "食費", 500, "お弁当")])
+    assert "食費" in out
+    assert "\\u" not in out
+
+
+def test_to_json_empty_list():
+    assert to_json([]) == "[]"
+
+
+def test_to_json_round_trips():
+    rows = [Expense(date(2026, 1, 31), "misc", 0, 'a "quoted" memo')]
+    data = json.loads(to_json(rows))
+    assert data == [
+        {
+            "date": "2026-01-31",
+            "category": "misc",
+            "amount": 0,
+            "memo": 'a "quoted" memo',
+        }
+    ]
