+import pytest
+
+from kakeibo.split import split_evenly
+
+
+def test_even_split() -> None:
+    assert split_evenly(900, 3) == [300, 300, 300]
+
+
+def test_remainder_goes_to_first_people() -> None:
+    assert split_evenly(10, 3) == [4, 3, 3]
+    assert split_evenly(1, 3) == [1, 0, 0]
+
+
+def test_single_person_gets_all() -> None:
+    assert split_evenly(1234, 1) == [1234]
+
+
+def test_zero_amount() -> None:
+    assert split_evenly(0, 4) == [0, 0, 0, 0]
+
+
+def test_sum_matches_amount() -> None:
+    for amount in range(200):
+        for people in range(1, 9):
+            shares = split_evenly(amount, people)
+            assert sum(shares) == amount
+            assert len(shares) == people
+            assert max(shares) - min(shares) <= 1
+
+
+@pytest.mark.parametrize("people", [0, -1])
+def test_people_below_one_raises(people: int) -> None:
+    with pytest.raises(ValueError):
+        split_evenly(100, people)
