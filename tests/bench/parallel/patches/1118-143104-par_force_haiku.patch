@@ -0,0 +1,54 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.topn import top_expenses
+
+
+def _e(day: str, amount: int, memo: str = "") -> Expense:
+    return Expense(date.fromisoformat(day), "food", amount, memo)
+
+
+def test_orders_by_amount_desc():
+    rows = [_e("2026-11-01", 100), _e("2026-11-02", 300), _e("2026-11-03", 200)]
+    assert [e.amount for e in top_expenses(rows, 3)] == [300, 200, 100]
+
+
+def test_returns_only_n():
+    rows = [_e("2026-11-01", 100), _e("2026-11-02", 300), _e("2026-11-03", 200)]
+    assert [e.amount for e in top_expenses(rows, 2)] == [300, 200]
+
+
+def test_n_larger_than_rows_returns_all():
+    rows = [_e("2026-11-01", 100), _e("2026-11-02", 300)]
+    assert [e.amount for e in top_expenses(rows, 10)] == [300, 100]
+
+
+def test_ties_broken_by_earlier_date():
+    rows = [_e("2026-11-05", 500, "late"), _e("2026-11-01", 500, "early")]
+    assert [e.memo for e in top_expenses(rows, 2)] == ["early", "late"]
+
+
+def test_ties_same_date_keep_input_order():
+    rows = [_e("2026-11-01", 500, "first"), _e("2026-11-01", 500, "second")]
+    assert [e.memo for e in top_expenses(rows, 2)] == ["first", "second"]
+
+
+def test_n_zero_returns_empty():
+    rows = [_e("2026-11-01", 100)]
+    assert top_expenses(rows, 0) == []
+
+
+def test_negative_n_returns_empty():
+    rows = [_e("2026-11-01", 100)]
+    assert top_expenses(rows, -3) == []
+
+
+def test_empty_rows_returns_empty():
+    assert top_expenses([], 5) == []
+
+
+def test_does_not_mutate_input():
+    rows = [_e("2026-11-01", 100), _e("2026-11-02", 300)]
+    snapshot = list(rows)
+    top_expenses(rows, 1)
+    assert rows == snapshot
