diff --git a/src/kakeibo/bankimport.py b/src/kakeibo/bankimport.py
new file mode 100644
index 0000000..3d92df1
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,114 @@
+"""Import expense rows from other banks' CSV exports."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"-?[¥￥]?[0-9][0-9,]*円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    """Parse `-?[¥￥]?digits(,digits)*円?` (commas unchecked) into yen."""
+    text = s.strip()
+    if not _AMOUNT_RE.fullmatch(text):
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    negative = text.startswith("-")
+    if negative:
+        text = text[1:]
+    if text[0] in "¥￥":
+        text = text[1:]
+    text = text.removesuffix("円")
+    value = int(text.replace(",", ""))
+    return -value if negative else value
+
+
+def parse_date(s: str) -> date:
+    """Parse `YYYY/M/D` or `YYYY-M-D` (same separator both times)."""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    try:
+        return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def _cell(row: list[str], index: int) -> str:
+    return row[index] if index < len(row) else ""
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Read CSV text (header on line 1) into expenses.
+
+    Returns (valid expenses in input order, [(line_number, field), ...]).
+    Line numbers are physical lines in `text`, header = 1; blank lines are
+    skipped but still counted.
+    """
+    cols = DEFAULT_MAPPING if mapping is None else mapping
+    for key in ("date", "category", "amount"):
+        if key not in cols:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text))
+    header = next(reader, [])
+    index: dict[str, int] = {}
+    for i, name in enumerate(header):
+        index.setdefault(name, i)
+    pos: dict[str, int] = {}
+    for field, column in cols.items():
+        if column not in index:
+            raise ValueError(f"列 {column!r} がヘッダーにありません")
+        pos[field] = index[column]
+
+    rows: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    while True:
+        lineno = reader.line_num + 1
+        row = next(reader, None)
+        if row is None:
+            break
+        if not row:
+            continue
+
+        raw_date = _cell(row, pos["date"])
+        raw_amount = _cell(row, pos["amount"])
+        category = _cell(row, pos["category"]).strip()
+
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(raw_date)
+        except ValueError:
+            errors.append((lineno, "date"))
+        try:
+            amount = parse_amount(raw_amount)
+        except ValueError:
+            errors.append((lineno, "amount"))
+        if not category:
+            errors.append((lineno, "category"))
+        if day is None or amount is None or not category:
+            continue
+
+        if category_map is not None:
+            category = category_map.get(category, category)
+        memo = _cell(row, pos["memo"]).strip() if "memo" in pos else ""
+        rows.append(Expense(day=day, category=category, amount=amount, memo=memo))
+
+    return rows, errors
diff --git a/src/kakeibo/dupes.py b/src/kakeibo/dupes.py
