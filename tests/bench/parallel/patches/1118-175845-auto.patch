diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..7e3f927
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,232 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def e(d: str, cat: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(d), category=cat, amount=amount)
+
+
+ROWS = [
+    e("2024-01-05", "食費", 1000),
+    e("2024-01-20", "食費", 500),
+    e("2024-01-10", "交通", 300),
+    e("2024-02-03", "食費", 1200),
+    e("2024-02-09", "娯楽", 800),
+    e("2024-03-01", "食費", 10),
+]
+
+
+def by_cat(rows: list[DiffRow]) -> dict[str, DiffRow]:
+    return {r.category: r for r in rows}
+
+
+# --- month_diff ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "prev, curr",
+    [
+        ("2024-1", "2024-02"),
+        ("2024-13", "2024-02"),
+        ("2024-00", "2024-02"),
+        ("24-01", "2024-02"),
+        ("2024/01", "2024-02"),
+        ("2024-02", "2024-1"),
+        ("2024-02", "2024-12x"),
+    ],
+)
+def test_month_diff_rejects_bad_month_format(prev: str, curr: str) -> None:
+    with pytest.raises(ValueError):
+        month_diff(ROWS, prev, curr)
+
+
+def test_month_diff_totals_delta_and_pct() -> None:
+    rows = by_cat(month_diff(ROWS, "2024-01", "2024-02"))
+    assert rows["食費"] == DiffRow("食費", 1500, 1200, -300, -20.0, "down")
+    assert rows["娯楽"] == DiffRow("娯楽", 0, 800, 800, None, "new")
+    assert rows["交通"] == DiffRow("交通", 300, 0, -300, -100.0, "gone")
+
+
+def test_month_diff_up_and_same() -> None:
+    rows = [
+        e("2024-01-01", "A", 100),
+        e("2024-02-01", "A", 150),
+        e("2024-01-01", "B", 50),
+        e("2024-02-01", "B", 50),
+    ]
+    got = by_cat(month_diff(rows, "2024-01", "2024-02"))
+    assert got["A"].status == "up"
+    assert got["A"].pct == 50.0
+    assert got["B"].status == "same"
+    assert got["B"].delta == 0
+    assert got["B"].pct == 0.0
+
+
+def test_month_diff_excludes_categories_outside_both_months() -> None:
+    got = month_diff(ROWS, "2024-01", "2024-02")
+    assert "" not in by_cat(got)
+    assert len(got) == 3  # 食費, 交通, 娯楽 only; 2024-03 の明細は無視
+
+
+def test_month_diff_ignores_other_months() -> None:
+    got = by_cat(month_diff(ROWS, "2024-02", "2024-03"))
+    assert set(got) == {"食費", "娯楽"}
+    assert got["食費"].prev == 1200
+    assert got["食費"].curr == 10
+    assert got["娯楽"].status == "gone"
+
+
+def test_status_uses_row_presence_not_sum() -> None:
+    # prev に明細はあるが合計 0 → new ではなく up
+    rows = [e("2024-01-01", "A", 0), e("2024-02-01", "A", 50)]
+    got = month_diff(rows, "2024-01", "2024-02")
+    assert got[0].status == "up"
+    assert got[0].prev == 0
+    assert got[0].pct is None
+
+
+def test_status_gone_when_curr_rows_sum_to_zero() -> None:
+    rows = [e("2024-01-01", "A", 50), e("2024-02-01", "A", 0)]
+    got = month_diff(rows, "2024-01", "2024-02")
+    assert got[0].status == "down"
+    assert got[0].curr == 0
+
+
+def test_status_same_when_both_sums_zero_with_rows() -> None:
+    rows = [e("2024-01-01", "A", 0), e("2024-02-01", "A", 0)]
+    got = month_diff(rows, "2024-01", "2024-02")
+    assert got[0].status == "same"
+    assert got[0].pct is None
+
+
+def test_month_diff_empty_rows() -> None:
+    assert month_diff([], "2024-01", "2024-02") == []
+
+
+def test_month_diff_sorted_by_abs_delta_then_category() -> None:
+    rows = [
+        e("2024-01-01", "b", 100),
+        e("2024-02-01", "b", 0),  # |delta| 100
+        e("2024-01-01", "a", 0),
+        e("2024-02-01", "a", 100),  # |delta| 100
+        e("2024-02-01", "c", 500),  # |delta| 500
+        e("2024-01-01", "d", 1000),  # |delta| 1000
+    ]
+    got = [r.category for r in month_diff(rows, "2024-01", "2024-02")]
+    assert got == ["d", "c", "a", "b"]
+
+
+def test_pct_rounded_to_one_decimal() -> None:
+    rows = [e("2024-01-01", "A", 3), e("2024-02-01", "A", 4)]
+    got = month_diff(rows, "2024-01", "2024-02")
+    assert got[0].pct == 33.3
+
+
+# --- top_movers ---------------------------------------------------------
+
+
+def _row(cat: str, status: str, delta: int = 1) -> DiffRow:
+    return DiffRow(cat, 0, 0, delta, None, status)
+
+
+def test_top_movers_excludes_same_and_keeps_order() -> None:
+    diffs = [
+        _row("a", "up", 9),
+        _row("b", "same", 0),
+        _row("c", "down", -5),
+        _row("d", "new", 4),
+    ]
+    assert [r.category for r in top_movers(diffs)] == ["a", "c", "d"]
+
+
+def test_top_movers_default_limit_three() -> None:
+    diffs = [_row(str(i), "up", 10 - i) for i in range(5)]
+    assert [r.category for r in top_movers(diffs)] == ["0", "1", "2"]
+
+
+def test_top_movers_n_limits_and_zero() -> None:
+    diffs = [_row("a", "up"), _row("b", "up")]
+    assert [r.category for r in top_movers(diffs, 1)] == ["a"]
+    assert top_movers(diffs, 0) == []
+    assert [r.category for r in top_movers(diffs, 10)] == ["a", "b"]
+
+
+def test_top_movers_negative_n_raises() -> None:
+    with pytest.raises(ValueError):
+        top_movers([], -1)
+
+
+def test_top_movers_all_same_is_empty() -> None:
+    assert top_movers([_row("a", "same", 0)]) == []
+
+
+# --- render_diff --------------------------------------------------------
+
+
+def test_render_diff_format() -> None:
+    diffs = [
+        DiffRow("食費", 1000, 1200, 200, 20.0, "up"),
+        DiffRow("交通", 300, 0, -300, -100.0, "gone"),
+        DiffRow("娯楽", 0, 800, 800, None, "new"),
+        DiffRow("雑費", 500, 500, 0, 0.0, "same"),
+    ]
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "食費\t1000\t1200\t+200\t+20.0%\n"
+        "交通\t300\t0\t-300\t-100.0%\n"
+        "娯楽\t0\t800\t+800\t-\n"
+        "雑費\t500\t500\t+0\t+0.0%"
+    )
+
+
+def test_render_diff_negative_zero_pct_has_no_minus() -> None:
+    diffs = [DiffRow("A", -5, -5, 0, -0.0, "same")]
+    assert render_diff(diffs).splitlines()[1] == "A\t-5\t-5\t+0\t+0.0%"
+
+
+def test_render_diff_no_trailing_newline() -> None:
+    assert not render_diff([_row("a", "up", 1)]).endswith("\n")
+
+
+def test_render_diff_empty_is_header_only() -> None:
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+# --- available_months / latest_diff ------------------------------------
+
+
+def test_available_months_sorted_unique() -> None:
+    rows = [
+        e("2024-03-01", "A", 1),
+        e("2023-12-31", "A", 1),
+        e("2024-03-09", "B", 1),
+        e("2024-01-01", "A", 1),
+    ]
+    assert available_months(rows) == ["2023-12", "2024-01", "2024-03"]
+
+
+def test_available_months_empty() -> None:
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months() -> None:
+    got = by_cat(latest_diff(ROWS))
+    assert got == by_cat(month_diff(ROWS, "2024-02", "2024-03"))
+
+
+def test_latest_diff_needs_two_months() -> None:
+    with pytest.raises(ValueError):
+        latest_diff([])
+    with pytest.raises(ValueError):
+        latest_diff([e("2024-01-01", "A", 1), e("2024-01-02", "A", 1)])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..def6696
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,233 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+R1 = Expense(date(2026, 1, 5), "食費", 1200, "ランチ 外食")
+R2 = Expense(date(2026, 1, 6), "交通費", 300, "電車")
+R3 = Expense(date(2026, 2, 1), "食費", 3000, "スーパー")
+R4 = Expense(date(2026, 2, 2), "娯楽", 0, "")
+ROWS = [R1, R2, R3, R4]
+
+
+# --- tokenize ---
+
+
+def test_empty_and_whitespace_only_give_no_tokens() -> None:
+    assert tokenize("") == []
+    assert tokenize("  \t ") == []
+
+
+def test_parens_become_tokens() -> None:
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+
+
+def test_word_stops_at_paren() -> None:
+    assert tokenize("foo(bar") == [
+        ("TERM", "foo"),
+        ("LPAREN", "("),
+        ("TERM", "bar"),
+    ]
+
+
+def test_quoted_keeps_spaces_and_parens() -> None:
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+
+
+def test_quoted_has_no_escapes() -> None:
+    # 引用の中の \ は普通の文字。最初の " で閉じる。
+    assert tokenize('"a\\"') == [("TERM", "a\\")]
+
+
+def test_unclosed_quote_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_word_then_unclosed_quote_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize('ab"c')
+
+
+def test_empty_quote_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_uppercase_operators_only() -> None:
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+    assert tokenize("and or not") == [
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_operator_word_must_be_exact() -> None:
+    assert tokenize("ANDx") == [("TERM", "ANDx")]
+
+
+def test_quoted_operator_is_term() -> None:
+    assert tokenize('"AND"') == [("TERM", "AND")]
+
+
+def test_cat_prefix() -> None:
+    assert tokenize("cat:食費") == [("CAT", "食費")]
+    assert tokenize("cat:AND") == [("CAT", "AND")]
+
+
+def test_cat_prefix_is_lowercase_only() -> None:
+    assert tokenize("CAT:x") == [("TERM", "CAT:x")]
+
+
+def test_cat_with_empty_value_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+    with pytest.raises(QueryError):
+        tokenize("cat: (")
+
+
+# --- parse / evaluate ---
+
+
+def test_term_matches_memo() -> None:
+    assert filter_rows("ランチ", ROWS) == [R1]
+
+
+def test_term_matches_category() -> None:
+    assert filter_rows("交通", ROWS) == [R2]
+
+
+def test_term_is_substring() -> None:
+    assert filter_rows("ーパ", ROWS) == [R3]
+
+
+def test_term_is_case_insensitive() -> None:
+    row = Expense(date(2026, 3, 1), "Food", 10, "Coffee")
+    assert matches("COFFEE", row)
+    assert matches("food", row)
+
+
+def test_term_uses_casefold() -> None:
+    row = Expense(date(2026, 3, 1), "食費", 10, "Straße")
+    assert matches("STRASSE", row)
+
+
+def test_cat_is_exact_match() -> None:
+    assert filter_rows("cat:食費", ROWS) == [R1, R3]
+    assert filter_rows("cat:食", ROWS) == []
+
+
+def test_cat_is_case_insensitive() -> None:
+    row = Expense(date(2026, 3, 1), "Food", 10, "")
+    assert matches("cat:FOOD", row)
+
+
+def test_cat_does_not_match_memo() -> None:
+    assert filter_rows("cat:ランチ", ROWS) == []
+
+
+def test_implicit_and() -> None:
+    assert filter_rows("食費 ランチ", ROWS) == [R1]
+    assert filter_rows("食費 電車", ROWS) == []
+
+
+def test_explicit_and() -> None:
+    assert filter_rows("食費 AND ランチ", ROWS) == [R1]
+
+
+def test_or() -> None:
+    assert filter_rows("電車 OR スーパー", ROWS) == [R2, R3]
+
+
+def test_not() -> None:
+    assert filter_rows("NOT 食費", ROWS) == [R2, R4]
+
+
+def test_double_not() -> None:
+    assert filter_rows("NOT NOT 食費", ROWS) == [R1, R3]
+
+
+def test_implicit_and_with_not() -> None:
+    assert filter_rows("食費 NOT ランチ", ROWS) == [R3]
+
+
+def test_not_binds_tighter_than_and() -> None:
+    # (NOT 食費) AND 電車
+    assert filter_rows("NOT 食費 電車", ROWS) == [R2]
+
+
+def test_and_binds_tighter_than_or() -> None:
+    # ランチ OR (電車 AND スーパー)
+    assert filter_rows("ランチ OR 電車 スーパー", ROWS) == [R1]
+
+
+def test_parens_override_precedence() -> None:
+    # (ランチ OR 電車) AND NOT 電車
+    assert filter_rows("(ランチ OR 電車) NOT 電車", ROWS) == [R1]
+
+
+def test_cat_combined_with_not() -> None:
+    assert filter_rows("cat:食費 NOT スーパー", ROWS) == [R1]
+
+
+def test_quoted_term_with_space() -> None:
+    assert filter_rows('"ランチ 外食"', ROWS) == [R1]
+
+
+def test_empty_memo_row_matches_only_by_category() -> None:
+    assert filter_rows("娯楽", ROWS) == [R4]
+    assert filter_rows("NOT 娯楽", ROWS) == [R1, R2, R3]
+
+
+def test_result_keeps_input_order() -> None:
+    assert filter_rows("食費", [R3, R1]) == [R3, R1]
+
+
+def test_empty_rows_with_valid_query() -> None:
+    assert filter_rows("食費", []) == []
+
+
+def test_empty_rows_with_invalid_query_still_raises() -> None:
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
+
+
+def test_matches_single_row() -> None:
+    assert matches("食費", R1)
+    assert not matches("食費", R2)
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "NOT",
+        "a AND",
+        "AND a",
+        "a OR",
+        "OR a",
+        "AND",
+        "OR",
+        "a AND AND b",
+        "a OR OR b",
+        "a OR AND b",
+        "NOT )",
+        "()",
+        "(a",
+        "a)",
+        "(a))",
+        "(a AND)",
+        "(a) )",
+        "a ) b",
+        "cat:",
+    ],
+)
+def test_invalid_syntax_raises(q: str) -> None:
+    with pytest.raises(QueryError):
+        filter_rows(q, ROWS)
+    with pytest.raises(QueryError):
+        matches(q, R1)
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..e212365
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,183 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def ex(
+    day: date, category: str = "家賃", amount: int = 50000, memo: str = ""
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- add_month ---------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("src", "expected"),
+    [
+        (date(2026, 1, 15), date(2026, 2, 15)),
+        (date(2026, 1, 31), date(2026, 2, 28)),  # 2026 is not a leap year
+        (date(2024, 1, 31), date(2024, 2, 29)),  # leap year
+        (date(2026, 3, 31), date(2026, 4, 30)),
+        (date(2026, 12, 15), date(2027, 1, 15)),  # year rollover
+        (date(2026, 12, 31), date(2027, 1, 31)),
+    ],
+)
+def test_add_month(src: date, expected: date) -> None:
+    assert add_month(src) == expected
+
+
+# --- argument validation -----------------------------------------------------
+
+
+def test_min_count_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([ex(date(2026, 1, 1))], min_count=1)
+
+
+def test_negative_tolerance_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([ex(date(2026, 1, 1))], tolerance=-1)
+
+
+def test_validation_applies_even_for_empty_input() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+# --- detection --------------------------------------------------------------
+
+
+def test_monthly_payment_detected() -> None:
+    rows = [ex(date(2026, 1, 25)), ex(date(2026, 2, 25)), ex(date(2026, 3, 25))]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="家賃",
+            amount=50000,
+            days=(date(2026, 1, 25), date(2026, 2, 25), date(2026, 3, 25)),
+            next_expected=date(2026, 4, 25),
+        )
+    ]
+
+
+def test_min_count_boundary() -> None:
+    rows = [ex(date(2026, 1, 25)), ex(date(2026, 2, 25))]
+    assert find_recurring(rows, min_count=3) == []
+    result = find_recurring(rows, min_count=2)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 25), date(2026, 2, 25))
+
+
+def test_memo_is_ignored_for_grouping() -> None:
+    rows = [
+        ex(date(2026, 1, 25), memo="a"),
+        ex(date(2026, 2, 25), memo="b"),
+        ex(date(2026, 3, 25)),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_different_amount_or_category_not_grouped() -> None:
+    rows = [
+        ex(date(2026, 1, 25), amount=50000),
+        ex(date(2026, 2, 25), amount=50001),
+        ex(date(2026, 3, 25), amount=50000),
+        ex(date(2026, 1, 25), category="通信"),
+        ex(date(2026, 2, 25), category="通信"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_tolerance_connects_within_limit_only() -> None:
+    # add_month(Jan 10) = Feb 10; Feb 13 is 3 days off (connected),
+    # Feb 14 would be 4 days off.
+    connected = [ex(date(2026, 1, 10)), ex(date(2026, 2, 13)), ex(date(2026, 3, 13))]
+    assert len(find_recurring(connected, tolerance=3)) == 1
+
+    broken = [ex(date(2026, 1, 10)), ex(date(2026, 2, 14)), ex(date(2026, 3, 14))]
+    assert find_recurring(broken, tolerance=3) == []
+    assert len(find_recurring(broken, tolerance=4)) == 1
+
+
+def test_tolerance_zero_requires_exact_day() -> None:
+    rows = [ex(date(2026, 1, 10)), ex(date(2026, 2, 11)), ex(date(2026, 3, 11))]
+    assert find_recurring(rows, tolerance=0) == []
+
+
+def test_month_end_chain_uses_add_month() -> None:
+    # add_month(Jan 31) = Feb 28, add_month(Feb 28) = Mar 28; Mar 31 is 3 days off.
+    rows = [ex(date(2026, 1, 31)), ex(date(2026, 2, 28)), ex(date(2026, 3, 31))]
+    result = find_recurring(rows, tolerance=3)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 30)
+
+
+def test_duplicate_dates_are_collapsed() -> None:
+    rows = [
+        ex(date(2026, 1, 10)),
+        ex(date(2026, 1, 10), memo="dup"),
+        ex(date(2026, 2, 10)),
+        ex(date(2026, 3, 10)),
+    ]
+    result = find_recurring(rows, min_count=3)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10))
+
+
+def test_input_order_does_not_matter() -> None:
+    rows = [ex(date(2026, 3, 10)), ex(date(2026, 1, 10)), ex(date(2026, 2, 10))]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10))
+
+
+def test_split_at_break_yields_separate_runs() -> None:
+    rows = [
+        ex(date(2026, 1, 10)),
+        ex(date(2026, 2, 10)),
+        ex(date(2026, 3, 10)),
+        # gap: Mar 10 -> Aug 10 is not connected
+        ex(date(2026, 8, 10)),
+        ex(date(2026, 9, 10)),
+        ex(date(2026, 10, 10)),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 10), date(2026, 8, 10)]
+    assert [r.next_expected for r in result] == [date(2026, 4, 10), date(2026, 11, 10)]
+
+
+def test_short_run_is_discarded() -> None:
+    rows = [
+        ex(date(2026, 1, 10)),
+        ex(date(2026, 2, 10)),
+        ex(date(2026, 6, 10)),
+    ]
+    assert find_recurring(rows, min_count=3) == []
+
+
+def test_results_sorted_by_category_amount_then_first_day() -> None:
+    rows = [
+        ex(date(2026, 2, 5), category="通信", amount=100),
+        ex(date(2026, 3, 5), category="通信", amount=100),
+        ex(date(2026, 4, 5), category="通信", amount=100),
+        ex(date(2026, 1, 1), category="家賃", amount=200),
+        ex(date(2026, 2, 1), category="家賃", amount=200),
+        ex(date(2026, 3, 1), category="家賃", amount=200),
+        ex(date(2026, 1, 2), category="家賃", amount=100),
+        ex(date(2026, 2, 2), category="家賃", amount=100),
+        ex(date(2026, 3, 2), category="家賃", amount=100),
+    ]
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [
+        ("家賃", 100),
+        ("家賃", 200),
+        ("通信", 100),
+    ]
