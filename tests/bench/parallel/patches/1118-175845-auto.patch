--- /dev/null
+++ b/tests/test_export.py
@@ -0,0 +1,66 @@
+import json
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.export import to_json
+
+
+def test_empty_list_gives_empty_array() -> None:
+    assert to_json([]) == "[]"
+
+
+def test_single_row_fields_and_key_order() -> None:
+    out = to_json([Expense(date(2026, 3, 5), "食費", 1200, "昼")])
+    assert out == (
+        '[{"date": "2026-03-05", "category": "食費", "amount": 1200, "memo": "昼"}]'
+    )
+    assert list(json.loads(out)[0].keys()) == ["date", "category", "amount", "memo"]
+
+
+def test_preserves_input_order_not_sorted() -> None:
+    rows = [
+        Expense(date(2026, 1, 10), "b", 1),
+        Expense(date(2026, 1, 1), "a", 2),
+    ]
+    data = json.loads(to_json(rows))
+    assert [d["date"] for d in data] == ["2026-01-10", "2026-01-01"]
+
+
+def test_identical_rows_are_all_kept() -> None:
+    row = Expense(date(2026, 2, 2), "交通", 300, "電車")
+    data = json.loads(to_json([row, row]))
+    assert len(data) == 2
+    assert data[0] == data[1]
+
+
+def test_empty_memo_is_empty_string() -> None:
+    out = to_json([Expense(date(2026, 4, 1), "雑費", 50)])
+    assert json.loads(out)[0]["memo"] == ""
+
+
+def test_non_ascii_is_not_escaped() -> None:
+    out = to_json([Expense(date(2026, 4, 1), "食費", 1, "コンビニ")])
+    assert "食費" in out
+    assert "\\u" not in out
+
+
+def test_no_indentation_or_newlines() -> None:
+    out = to_json(
+        [
+            Expense(date(2026, 4, 1), "食費", 1),
+            Expense(date(2026, 4, 2), "食費", 2),
+        ]
+    )
+    assert "\n" not in out
+
+
+def test_amount_stays_integer() -> None:
+    out = to_json([Expense(date(2026, 4, 1), "食費", 980)])
+    assert json.loads(out)[0]["amount"] == 980
+    assert isinstance(json.loads(out)[0]["amount"], int)
+
+
+def test_special_characters_in_memo_are_escaped_validly() -> None:
+    memo = 'say "hi"\nline2'
+    out = to_json([Expense(date(2026, 4, 1), "雑費", 1, memo)])
+    assert json.loads(out)[0]["memo"] == memo
