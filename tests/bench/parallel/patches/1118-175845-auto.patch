+++ b/src/kakeibo/stats.py
@@ -0,0 +1,25 @@
+"""Statistics over expense records."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def median_by_category(rows: list[Expense]) -> dict[str, float]:
+    """{category: median yen}; keys in ascending category order.
+
+    For an even number of amounts the median is the mean of the two middle values.
+    """
+    by_cat: dict[str, list[int]] = {}
+    for e in rows:
+        by_cat.setdefault(e.category, []).append(e.amount)
+    out: dict[str, float] = {}
+    for cat in sorted(by_cat):
+        amounts = sorted(by_cat[cat])
+        n = len(amounts)
+        mid = n // 2
+        if n % 2:
+            out[cat] = float(amounts[mid])
+        else:
+            out[cat] = (amounts[mid - 1] + amounts[mid]) / 2
+    return out
