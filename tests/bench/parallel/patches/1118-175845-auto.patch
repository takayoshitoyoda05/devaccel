@@ -0,0 +1,16 @@
+"""Totals by day of week."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+WEEKDAYS: tuple[str, ...] = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
+
+
+def total_by_weekday(rows: list[Expense]) -> dict[str, int]:
+    """{"Mon".."Sun": yen}; weekdays without expenses are omitted, Monday first."""
+    totals: dict[str, int] = {}
+    for e in rows:
+        name = WEEKDAYS[e.day.weekday()]
+        totals[name] = totals.get(name, 0) + e.amount
+    return {name: totals[name] for name in WEEKDAYS if name in totals}
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..54b2a4b
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,219 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+HEADER = "利用日,分類,利用金額,利用店名"
+
+
+# --- parse_amount ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "value"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥1200", 1200),
+    ],
+)
+def test_parse_amount_accepts(text: str, value: int) -> None:
+    assert parse_amount(text) == value
+
+
+def test_parse_amount_comma_position_not_checked() -> None:
+    assert parse_amount("1,2") == 12
+    assert parse_amount("1,,000") == 1000
+
+
+def test_parse_amount_negative_with_yen_and_suffix() -> None:
+    assert parse_amount("-500円") == -500
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "   ",
+        "円",
+        "12.5",
+        "1 200",
+        "--5",
+        "¥-5",
+        "１２３",
+        "-",
+        "¥",
+        "円980",
+        "980円円",
+        "¥円",
+        ",1",
+    ],
+)
+def test_parse_amount_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+# --- parse_date -----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "value"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/1/5 ", date(2026, 1, 5)),
+        ("2026/12/31", date(2026, 12, 31)),
+        ("2024/2/29", date(2024, 2, 29)),
+        ("2026-1-5", date(2026, 1, 5)),
+    ],
+)
+def test_parse_date_accepts(text: str, value: date) -> None:
+    assert parse_date(text) == value
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026/1-5",
+        "2026-1/5",
+        "26/1/5",
+        "2026/02/30",
+        "2025/2/29",
+        "2026/13/1",
+        "2026/0/1",
+        "2026/1/5/",
+        "2026.1.5",
+        "２０２６/1/5",
+        "",
+        "2026/1",
+    ],
+)
+def test_parse_date_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+# --- import_rows ----------------------------------------------------------
+
+
+def test_default_mapping_imports_rows_in_order() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,1200,スーパー\n2026-01-06,交通,300,電車\n"
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [
+        Expense(date(2026, 1, 5), "食費", 1200, "スーパー"),
+        Expense(date(2026, 1, 6), "交通", 300, "電車"),
+    ]
+
+
+def test_default_mapping_constant() -> None:
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_quoted_field_with_comma_and_extra_columns_ignored() -> None:
+    text = 'X,利用日,分類,利用金額,利用店名\nzz,2026/1/5,食費,"1,200","  a, b  "\n'
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 1200, "a, b")]
+
+
+def test_custom_mapping_and_memo_optional() -> None:
+    text = "when,what,yen\n2026/3/1,  外食 ,500\n"
+    mapping = {"date": "when", "category": "what", "amount": "yen"}
+    rows, errors = import_rows(text, mapping)
+    assert errors == []
+    assert rows == [Expense(date(2026, 3, 1), "外食", 500, "")]
+
+
+def test_mapping_missing_required_key_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows(f"{HEADER}\n", {"date": "利用日", "amount": "利用金額"})
+
+
+def test_mapping_column_not_in_header_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows(
+            f"{HEADER}\n",
+            {"date": "利用日", "category": "無い列", "amount": "利用金額"},
+        )
+
+
+def test_mapping_memo_column_not_in_header_raises() -> None:
+    mapping = {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "無い",
+    }
+    with pytest.raises(ValueError):
+        import_rows(f"{HEADER}\n", mapping)
+
+
+def test_header_only_gives_no_rows() -> None:
+    assert import_rows(f"{HEADER}\n") == ([], [])
+
+
+def test_errors_collected_per_row_in_date_amount_category_order() -> None:
+    text = f"{HEADER}\n2026/02/30,,abc,x\n2026/1/5,食費,12.5,y\n2026/1/5,  ,100,z\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [
+        (2, "date"),
+        (2, "amount"),
+        (2, "category"),
+        (3, "amount"),
+        (4, "category"),
+    ]
+
+
+def test_row_with_error_excluded_but_others_kept() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,100,a\nbad,食費,100,b\n2026/1/7,交通,200,c\n"
+    rows, errors = import_rows(text)
+    assert errors == [(3, "date")]
+    assert rows == [
+        Expense(date(2026, 1, 5), "食費", 100, "a"),
+        Expense(date(2026, 1, 7), "交通", 200, "c"),
+    ]
+
+
+def test_blank_lines_skipped_but_counted_in_line_numbers() -> None:
+    text = f"{HEADER}\n\n2026/1/5,食費,100,a\n\nxx,食費,100,b\n"
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "a")]
+    assert errors == [(5, "date")]
+
+
+def test_short_row_missing_values_treated_as_empty() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,100\n2026/1/5\n"
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "")]
+    assert errors == [(3, "amount"), (3, "category")]
+
+
+def test_category_map_applied_after_strip() -> None:
+    text = f"{HEADER}\n2026/1/5, 食料品 ,100,a\n2026/1/6,交通,200,b\n"
+    rows, errors = import_rows(text, category_map={"食料品": "食費"})
+    assert errors == []
+    assert [e.category for e in rows] == ["食費", "交通"]
+
+
+def test_category_map_none_keeps_category() -> None:
+    text = f"{HEADER}\n2026/1/5,食料品,100,a\n"
+    rows, _ = import_rows(text, category_map=None)
+    assert rows[0].category == "食料品"
+
+
+def test_memo_stripped() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,100,  スーパー  \n"
+    rows, _ = import_rows(text)
+    assert rows[0].memo == "スーパー"
diff --git a/tests/test_dupes.py b/tests/test_dupes.py
new file mode 100644
index 0000000..efa3230
--- /dev/null
+++ b/tests/test_dupes.py
@@ -0,0 +1,68 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.dupes import find_duplicates
+
+D = date(2026, 1, 5)
+
+
+def e(
+    day: date = D, category: str = "食費", amount: int = 100, memo: str = ""
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+def test_empty_list_has_no_duplicates() -> None:
+    assert find_duplicates([]) == []
+
+
+def test_single_row_has_no_duplicates() -> None:
+    assert find_duplicates([e()]) == []
+
+
+def test_identical_pair_is_reported() -> None:
+    assert find_duplicates([e(), e()]) == [(0, 1)]
+
+
+def test_no_duplicates_when_all_distinct() -> None:
+    rows = [e(amount=100), e(amount=200), e(category="交通費")]
+    assert find_duplicates(rows) == []
+
+
+def test_differs_in_day_is_not_duplicate() -> None:
+    assert find_duplicates([e(), e(day=date(2026, 1, 6))]) == []
+
+
+def test_differs_in_category_is_not_duplicate() -> None:
+    assert find_duplicates([e(), e(category="交通費")]) == []
+
+
+def test_differs_in_amount_is_not_duplicate() -> None:
+    assert find_duplicates([e(), e(amount=101)]) == []
+
+
+def test_differs_in_memo_is_not_duplicate() -> None:
+    assert find_duplicates([e(memo="昼"), e(memo="夜")]) == []
+
+
+def test_memo_empty_vs_nonempty_is_not_duplicate() -> None:
+    assert find_duplicates([e(), e(memo="x")]) == []
+
+
+def test_three_identical_rows_give_all_pairs_in_order() -> None:
+    assert find_duplicates([e(), e(), e()]) == [(0, 1), (0, 2), (1, 2)]
+
+
+def test_indices_refer_to_input_positions_not_groups() -> None:
+    rows = [e(amount=1), e(amount=2), e(amount=1), e(amount=2)]
+    assert find_duplicates(rows) == [(0, 2), (1, 3)]
+
+
+def test_sorted_by_i_then_j_even_when_groups_interleave() -> None:
+    rows = [e(amount=1), e(amount=2), e(amount=2), e(amount=1), e(amount=1)]
+    assert find_duplicates(rows) == [(0, 3), (0, 4), (1, 2), (3, 4)]
+
+
+def test_only_pairs_with_i_less_than_j() -> None:
+    result = find_duplicates([e(), e()])
+    assert all(i < j for i, j in result)
diff --git a/tests/test_export.py b/tests/test_export.py
