@@ -0,0 +1,45 @@
+import pytest
+
+from kakeibo.split import split_evenly
+
+
+def test_exact_division() -> None:
+    assert split_evenly(300, 3) == [100, 100, 100]
+
+
+def test_remainder_goes_to_first_people_one_yen_each() -> None:
+    assert split_evenly(100, 3) == [34, 33, 33]
+
+
+def test_multiple_remainder_units() -> None:
+    assert split_evenly(10, 4) == [3, 3, 2, 2]
+
+
+def test_zero_amount() -> None:
+    assert split_evenly(0, 3) == [0, 0, 0]
+
+
+def test_single_person_gets_everything() -> None:
+    assert split_evenly(777, 1) == [777]
+
+
+def test_more_people_than_yen() -> None:
+    assert split_evenly(2, 5) == [1, 1, 0, 0, 0]
+
+
+def test_result_length_equals_people() -> None:
+    assert len(split_evenly(1000, 7)) == 7
+
+
+@pytest.mark.parametrize("amount", range(50))
+@pytest.mark.parametrize("people", range(1, 9))
+def test_sum_matches_amount(amount: int, people: int) -> None:
+    parts = split_evenly(amount, people)
+    assert sum(parts) == amount
+    assert max(parts) - min(parts) <= 1
+
+
+@pytest.mark.parametrize("people", [0, -1])
+def test_people_less_than_one_raises(people: int) -> None:
+    with pytest.raises(ValueError):
+        split_evenly(100, people)
