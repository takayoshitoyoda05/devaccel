+++ b/tests/test_stats.py
@@ -0,0 +1,65 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.stats import median_by_category
+
+
+def _e(category: str, amount: int) -> Expense:
+    return Expense(day=date(2026, 1, 1), category=category, amount=amount)
+
+
+def test_empty_returns_empty_dict() -> None:
+    assert median_by_category([]) == {}
+
+
+def test_single_row_is_its_amount_as_float() -> None:
+    result = median_by_category([_e("食費", 500)])
+    assert result == {"食費": 500.0}
+    assert isinstance(result["食費"], float)
+
+
+def test_odd_count_takes_middle_value_regardless_of_input_order() -> None:
+    rows = [_e("食費", 300), _e("食費", 100), _e("食費", 200)]
+    assert median_by_category(rows) == {"食費": 200.0}
+
+
+def test_even_count_averages_two_middle_values() -> None:
+    rows = [_e("食費", 100), _e("食費", 400), _e("食費", 200), _e("食費", 300)]
+    assert median_by_category(rows) == {"食費": 250.0}
+
+
+def test_even_count_can_be_fractional() -> None:
+    rows = [_e("食費", 1), _e("食費", 2)]
+    assert median_by_category(rows) == {"食費": 1.5}
+
+
+def test_identical_values_return_that_value() -> None:
+    rows = [_e("食費", 700), _e("食費", 700), _e("食費", 700), _e("食費", 700)]
+    assert median_by_category(rows) == {"食費": 700.0}
+
+
+def test_outlier_does_not_shift_median() -> None:
+    rows = [_e("食費", 100), _e("食費", 200), _e("食費", 300_000)]
+    assert median_by_category(rows) == {"食費": 200.0}
+
+
+def test_categories_are_computed_independently() -> None:
+    rows = [
+        _e("食費", 100),
+        _e("交通", 1000),
+        _e("食費", 300),
+        _e("交通", 3000),
+        _e("食費", 200),
+    ]
+    assert median_by_category(rows) == {"交通": 2000.0, "食費": 200.0}
+
+
+def test_keys_are_sorted_by_category_name_not_by_value() -> None:
+    rows = [_e("交通", 1), _e("娯楽", 999), _e("食費", 50)]
+    result = median_by_category(rows)
+    assert list(result) == ["交通", "娯楽", "食費"]
+
+
+def test_keys_sorted_ascending_as_strings() -> None:
+    rows = [_e("b", 1), _e("a", 2), _e("c", 3)]
+    assert list(median_by_category(rows)) == ["a", "b", "c"]
diff --git a/tests/test_streak.py b/tests/test_streak.py
new file mode 100644
index 0000000..bacc0c2
--- /dev/null
+++ b/tests/test_streak.py
@@ -0,0 +1,76 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.streak import longest_no_spend_streak
+
+
+def _e(d: date, amount: int = 100) -> Expense:
+    return Expense(d, "food", amount)
+
+
+def test_no_rows_means_whole_period_is_streak():
+    assert longest_no_spend_streak([], date(2026, 11, 1), date(2026, 11, 5)) == 5
+
+
+def test_every_day_has_spend_gives_zero():
+    rows = [_e(date(2026, 11, d)) for d in range(1, 4)]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 3)) == 0
+
+
+def test_single_day_period_without_spend_is_one():
+    assert longest_no_spend_streak([], date(2026, 11, 1), date(2026, 11, 1)) == 1
+
+
+def test_single_day_period_with_spend_is_zero():
+    rows = [_e(date(2026, 11, 1))]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 1)) == 0
+
+
+def test_start_greater_than_end_gives_zero():
+    assert longest_no_spend_streak([], date(2026, 11, 5), date(2026, 11, 1)) == 0
+
+
+def test_longest_of_multiple_streaks_is_returned():
+    # spend on 2, 5, 6 within 1..10 -> gaps: [1]=1, [3,4]=2, [7..10]=4
+    rows = [_e(date(2026, 11, 2)), _e(date(2026, 11, 5)), _e(date(2026, 11, 6))]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 10)) == 4
+
+
+def test_streak_at_start_of_period_is_counted():
+    rows = [_e(date(2026, 11, 4))]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 5)) == 3
+
+
+def test_streak_at_end_of_period_is_counted():
+    rows = [_e(date(2026, 11, 1))]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 5)) == 4
+
+
+def test_multiple_expenses_on_same_day_count_as_one_spend_day():
+    rows = [_e(date(2026, 11, 2)), _e(date(2026, 11, 2), 300), _e(date(2026, 11, 2), 1)]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 4)) == 2
+
+
+def test_zero_amount_record_still_counts_as_spend():
+    rows = [_e(date(2026, 11, 2), 0)]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 3)) == 1
+
+
+def test_rows_outside_period_are_ignored():
+    rows = [
+        _e(date(2026, 10, 31)),
+        _e(date(2026, 11, 6)),
+    ]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 5)) == 5
+
+
+def test_period_bounds_are_inclusive():
+    rows = [_e(date(2026, 11, 1)), _e(date(2026, 11, 5))]
+    # 2..4 are spend-free: streak of 3, endpoints themselves are spend days
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 5)) == 3
+
+
+def test_streak_spans_month_boundary():
+    # spend only on 11/3; 10/30, 10/31, 11/1, 11/2 are spend-free -> 4
+    rows = [_e(date(2026, 11, 3))]
+    assert longest_no_spend_streak(rows, date(2026, 10, 30), date(2026, 11, 4)) == 4
diff --git a/tests/test_topn.py b/tests/test_topn.py
new file mode 100644
index 0000000..b295bce
--- /dev/null
+++ b/tests/test_topn.py
@@ -0,0 +1,64 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.topn import top_expenses
+
+
+def _e(day: str, amount: int, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category="食費", amount=amount, memo=memo
+    )
+
+
+def test_returns_largest_amounts_first():
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300), _e("2026-01-03", 200)]
+    assert top_expenses(rows, 2) == [rows[1], rows[2]]
+
+
+def test_ties_on_amount_break_by_earlier_date():
+    late = _e("2026-02-10", 500, "late")
+    early = _e("2026-01-05", 500, "early")
+    rows = [late, early]
+    assert top_expenses(rows, 2) == [early, late]
+
+
+def test_ties_on_amount_and_date_keep_input_order():
+    first = _e("2026-03-01", 700, "first")
+    second = _e("2026-03-01", 700, "second")
+    rows = [first, second]
+    assert top_expenses(rows, 2) == [first, second]
+    rows_rev = [second, first]
+    assert top_expenses(rows_rev, 2) == [second, first]
+
+
+def test_n_zero_returns_empty():
+    rows = [_e("2026-01-01", 100)]
+    assert top_expenses(rows, 0) == []
+
+
+def test_negative_n_returns_empty():
+    rows = [_e("2026-01-01", 100)]
+    assert top_expenses(rows, -3) == []
+
+
+def test_empty_input_returns_empty():
+    assert top_expenses([], 5) == []
+
+
+def test_n_larger_than_input_returns_all_sorted():
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300)]
+    assert top_expenses(rows, 10) == [rows[1], rows[0]]
+
+
+def test_does_not_mutate_input():
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300)]
+    snapshot = list(rows)
+    top_expenses(rows, 2)
+    assert rows == snapshot
+
+
+def test_returns_only_n_items_not_more():
+    rows = [_e("2026-01-0" + str(i), i * 10) for i in range(1, 6)]
+    result = top_expenses(rows, 3)
+    assert len(result) == 3
+    assert [e.amount for e in result] == [50, 40, 30]
diff --git a/tests/test_weekday.py b/tests/test_weekday.py
new file mode 100644
index 0000000..9c83aed
--- /dev/null
+++ b/tests/test_weekday.py
@@ -0,0 +1,66 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.weekday import total_by_weekday
+
+# 2026-11-16 は月曜、2026-11-18 は水曜、2026-11-22 は日曜
+MON_1 = date(2026, 11, 16)
+MON_2 = date(2026, 11, 23)
+WED = date(2026, 11, 18)
+SUN = date(2026, 11, 22)
+
+
+def _e(day: date, amount: int, category: str = "食費") -> Expense:
+    return Expense(day=day, category=category, amount=amount)
+
+
+def test_empty_rows_gives_empty_dict() -> None:
+    assert total_by_weekday([]) == {}
+
+
+def test_single_expense_keyed_by_english_three_letter_weekday() -> None:
+    assert total_by_weekday([_e(MON_1, 500)]) == {"Mon": 500}
+
+
+def test_same_weekday_in_different_weeks_is_summed() -> None:
+    rows = [_e(MON_1, 300), _e(MON_2, 700)]
+    assert total_by_weekday(rows) == {"Mon": 1000}
+
+
+def test_multiple_categories_on_same_day_are_summed() -> None:
+    rows = [_e(WED, 200, "食費"), _e(WED, 1300, "交通費")]
+    assert total_by_weekday(rows) == {"Wed": 1500}
+
+
+def test_zero_amount_still_counts_as_detail_for_that_weekday() -> None:
+    assert total_by_weekday([_e(WED, 0)]) == {"Wed": 0}
+
+
+def test_weekdays_without_expenses_are_not_included() -> None:
+    result = total_by_weekday([_e(MON_1, 100), _e(WED, 200)])
+    assert "Tue" not in result
+    assert "Sun" not in result
+    assert list(result) == ["Mon", "Wed"]
+
+
+def test_keys_are_in_monday_first_order_regardless_of_input_order() -> None:
+    rows = [_e(SUN, 10), _e(WED, 20), _e(MON_1, 30)]
+    result = total_by_weekday(rows)
+    assert list(result) == ["Mon", "Wed", "Sun"]
+    assert result == {"Mon": 30, "Wed": 20, "Sun": 10}
+
+
+def test_all_seven_weekdays_present_in_order() -> None:
+    days = [date(2026, 11, d) for d in range(16, 23)]  # 月〜日
+    rows = [_e(d, i + 1) for i, d in enumerate(reversed(days))]
+    result = total_by_weekday(rows)
+    assert list(result) == ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
+    assert result == {
+        "Mon": 7,
+        "Tue": 6,
+        "Wed": 5,
+        "Thu": 4,
+        "Fri": 3,
+        "Sat": 2,
+        "Sun": 1,
+    }
