diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..a2de1f3 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -188,3 +188,121 @@ def test_path_type(runner, cls, expect):
 
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
+
+
+@pytest.mark.parametrize(
+    "name", ["a.csv", "a.TSV", "A.Csv", "dir/a.tsv", "a.b.csv", ".csv"]
+)
+def test_path_extensions_accepted(name):
+    type = click.Path(extensions=[".csv", ".tsv"])
+    assert type.convert(name, None, None) == name
+
+
+@pytest.mark.parametrize("name", ["a.txt", "a", "a.csv.bak", "csv", "a.csvx", ""])
+def test_path_extensions_rejected(name):
+    type = click.Path(extensions=[".csv", ".tsv"])
+
+    with pytest.raises(click.BadParameter, match="must end with one of: .csv, .tsv"):
+        type.convert(name, None, None)
+
+
+def test_path_extensions_leading_dot_optional_and_case_insensitive():
+    type = click.Path(extensions=("CSV", ".Tsv"))
+    assert type.extensions == (".csv", ".tsv")
+    assert type.convert("a.CSV", None, None) == "a.CSV"
+    assert type.convert("a.tsv", None, None) == "a.tsv"
+
+
+def test_path_extensions_multi_dot():
+    type = click.Path(extensions=[".tar.gz"])
+    assert type.convert("a.TAR.GZ", None, None) == "a.TAR.GZ"
+
+    with pytest.raises(click.BadParameter):
+        type.convert("a.gz", None, None)
+
+
+def test_path_extensions_default_accepts_anything():
+    assert click.Path().extensions is None
+    assert click.Path().convert("a.whatever", None, None) == "a.whatever"
+
+
+@pytest.mark.parametrize("value", [b"a.CSV", pathlib.Path("a.csv")])
+def test_path_extensions_bytes_and_pathlike(value):
+    type = click.Path(extensions=[".csv"])
+    assert type.convert(value, None, None) == value
+
+    with pytest.raises(click.BadParameter):
+        type.convert(
+            os.fsencode("a.txt") if isinstance(value, bytes) else pathlib.Path("a.txt"),
+            None,
+            None,
+        )
+
+
+def test_path_extensions_existing_file(tmp_path):
+    good = tmp_path / "a.CSV"
+    bad = tmp_path / "a.txt"
+    good.write_text("")
+    bad.write_text("")
+    type = click.Path(exists=True, extensions=[".csv"])
+    assert type.convert(os.fspath(good), None, None) == os.fspath(good)
+
+    with pytest.raises(click.BadParameter, match="must end with"):
+        type.convert(os.fspath(bad), None, None)
+
+
+def test_path_extensions_missing_file_still_checked_without_exists(tmp_path):
+    type = click.Path(extensions=[".csv"])
+
+    with pytest.raises(click.BadParameter, match="must end with"):
+        type.convert(os.fspath(tmp_path / "new.txt"), None, None)
+
+
+def test_path_extensions_missing_file_with_exists_reports_missing(tmp_path):
+    type = click.Path(exists=True, extensions=[".csv"])
+
+    with pytest.raises(click.BadParameter, match="does not exist"):
+        type.convert(os.fspath(tmp_path / "new.csv"), None, None)
+
+
+def test_path_extensions_skips_existing_directory(tmp_path):
+    directory = tmp_path / "data.d"
+    directory.mkdir()
+    type = click.Path(exists=True, extensions=[".csv"])
+    assert type.convert(os.fspath(directory), None, None) == os.fspath(directory)
+
+
+def test_path_extensions_skips_dash():
+    type = click.Path(allow_dash=True, extensions=[".csv"])
+    assert type.convert("-", None, None) == "-"
+
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions=[".csv"]).convert("-", None, None)
+
+
+@pytest.mark.parametrize(
+    ("value", "exc"),
+    [
+        (".csv", TypeError),
+        ([], ValueError),
+        ([""], ValueError),
+        ([".", ".csv"], ValueError),
+        ([1], TypeError),
+        ([None], TypeError),
+    ],
+)
+def test_path_extensions_invalid_argument(value, exc):
+    with pytest.raises(exc):
+        click.Path(extensions=value)
+
+
+def test_path_extensions_in_command(runner, tmp_path):
+    cli = click.Command(
+        "cli",
+        params=[click.Argument(["p"], type=click.Path(extensions=[".csv", ".tsv"]))],
+        callback=lambda p: click.echo(p),
+    )
+    assert runner.invoke(cli, ["x.TSV"]).output == "x.TSV\n"
+    result = runner.invoke(cli, ["x.txt"])
+    assert result.exit_code == 2
+    assert "must end with one of: .csv, .tsv" in result.output
