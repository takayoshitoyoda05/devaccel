diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..61769fe 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -188,3 +188,123 @@ def test_path_type(runner, cls, expect):
 
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
+
+
+@pytest.mark.parametrize(
+    "name",
+    ["a.csv", "a.tsv", "A.CSV", "dir/b.Tsv", "x.y.csv", pathlib.Path("c.csv")],
+)
+def test_path_extensions_accept(name):
+    type = click.Path(extensions=[".csv", ".tsv"])
+    assert type.convert(name, None, None) == name
+
+
+@pytest.mark.parametrize("name", ["a.txt", "a", "a.csv.bak", ".csv", "csv", "a.csv/"])
+def test_path_extensions_reject(name):
+    type = click.Path(extensions=[".csv", ".tsv"])
+
+    with pytest.raises(click.BadParameter, match="must have one of the extensions"):
+        type.convert(name, None, None)
+
+
+def test_path_extensions_message_lists_normalized_extensions():
+    type = click.Path(extensions=["CSV", ".Tsv"])
+
+    with pytest.raises(click.BadParameter, match=r"\.csv, \.tsv"):
+        type.convert("a.txt", None, None)
+
+
+def test_path_extensions_without_dot_and_multi_part():
+    type = click.Path(extensions=("csv", "tar.gz"))
+    assert type.convert("a.CSV", None, None) == "a.CSV"
+    assert type.convert("a.tar.gz", None, None) == "a.tar.gz"
+
+    with pytest.raises(click.BadParameter):
+        type.convert("a.gz", None, None)
+
+
+def test_path_extensions_checked_with_exists(tmp_path):
+    good = tmp_path / "a.CSV"
+    bad = tmp_path / "a.txt"
+    good.write_text("")
+    bad.write_text("")
+    type = click.Path(exists=True, extensions=[".csv"])
+
+    assert type.convert(str(good), None, None) == str(good)
+
+    with pytest.raises(click.BadParameter, match="extensions"):
+        type.convert(str(bad), None, None)
+
+
+def test_path_extensions_missing_file_is_checked_unless_exists_required(tmp_path):
+    type = click.Path(extensions=[".csv"])
+    assert type.convert(str(tmp_path / "new.csv"), None, None)
+
+    with pytest.raises(click.BadParameter, match="extensions"):
+        type.convert(str(tmp_path / "new.txt"), None, None)
+
+    # A missing file still reports that it does not exist first.
+    with pytest.raises(click.BadParameter, match="does not exist"):
+        click.Path(exists=True, extensions=[".csv"]).convert(
+            str(tmp_path / "new.txt"), None, None
+        )
+
+
+def test_path_extensions_not_applied_to_directories(tmp_path):
+    folder = tmp_path / "data.d"
+    folder.mkdir()
+    type = click.Path(extensions=[".csv"])
+    assert type.convert(str(folder), None, None) == str(folder)
+
+    # Not even when it does not exist, if only directories are allowed.
+    only_dirs = click.Path(file_okay=False, extensions=[".csv"])
+    assert only_dirs.convert(str(tmp_path / "new.d"), None, None)
+
+
+def test_path_extensions_not_applied_to_dash():
+    type = click.Path(allow_dash=True, extensions=[".csv"])
+    assert type.convert("-", None, None) == "-"
+    assert type.convert(b"-", None, None) == b"-"
+
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions=[".csv"]).convert("-", None, None)
+
+
+def test_path_extensions_bytes_and_path_type():
+    assert click.Path(extensions=[".csv"]).convert(b"a.CSV", None, None) == b"a.CSV"
+    type = click.Path(extensions=[".csv"], path_type=pathlib.Path)
+    assert type.convert("a.csv", None, None) == pathlib.Path("a.csv")
+
+
+def test_path_extensions_default_accepts_anything():
+    assert click.Path().extensions is None
+    assert click.Path().convert("a.whatever", None, None) == "a.whatever"
+
+
+def test_path_extensions_invalid_arguments():
+    with pytest.raises(ValueError, match="must not be empty"):
+        click.Path(extensions=[])
+
+    with pytest.raises(ValueError, match="empty extension"):
+        click.Path(extensions=[".csv", ""])
+
+    with pytest.raises(ValueError, match="empty extension"):
+        click.Path(extensions=["."])
+
+    with pytest.raises(TypeError, match="not a string"):
+        click.Path(extensions=".csv")  # type: ignore[arg-type]
+
+
+def test_path_extensions_in_command(runner):
+    @click.command()
+    @click.argument("p", type=click.Path(extensions=[".csv", ".tsv"]))
+    def cli(p):
+        click.echo(p)
+
+    ok = runner.invoke(cli, ["Data.TSV"])
+    assert ok.exit_code == 0
+    assert ok.output == "Data.TSV\n"
+
+    bad = runner.invoke(cli, ["data.json"])
+    assert bad.exit_code == 2
+    assert "must have one of the extensions: .csv, .tsv" in bad.output
