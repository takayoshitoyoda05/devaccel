+++ b/tests/test_statement.py
@@ -0,0 +1,204 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.statement import (
+    RowError,
+    StatementError,
+    parse_amount,
+    parse_date,
+    parse_statement,
+)
+
+
+@pytest.mark.parametrize(
+    "raw,want",
+    [
+        ("1234", 1234),
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("+500", 500),
+        ("¥1,234", 1234),
+        ("￥１，２３４円", 1234),
+        ("1,234 円", 1234),
+        ("JPY 1234", 1234),
+        ("1，234", 1234),
+        ("0", 0),
+    ],
+)
+def test_parse_amount_ok(raw: str, want: int) -> None:
+    assert parse_amount(raw) == want
+
+
+@pytest.mark.parametrize(
+    "raw", ["", "  ", "-", "12.5", "12.0", "abc", "1 2x", "--5", "(5"]
+)
+def test_parse_amount_bad(raw: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(raw)
+
+
+def test_parse_amount_type() -> None:
+    with pytest.raises(TypeError):
+        parse_amount(None)  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        parse_amount(1234)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize(
+    "raw,want",
+    [
+        ("2026-01-05", date(2026, 1, 5)),
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026.1.5", date(2026, 1, 5)),
+        ("2026年1月5日", date(2026, 1, 5)),
+        ("20260105", date(2026, 1, 5)),
+        ("2026/01-05", date(2026, 1, 5)),
+        ("２０２６／１／５".replace("／", "/"), date(2026, 1, 5)),
+        ("2026-01-05 12:30", date(2026, 1, 5)),
+        ("2026/1/5 12:30:45", date(2026, 1, 5)),
+        ("令和8年1月5日", date(2026, 1, 5)),
+        ("R8.1.5", date(2026, 1, 5)),
+        ("H30/4/1", date(2018, 4, 1)),
+        ("令和元年5月1日", date(2019, 5, 1)),
+        ("S64.1.7", date(1989, 1, 7)),
+        ("2024-02-29", date(2024, 2, 29)),
+    ],
+)
+def test_parse_date_ok(raw: str, want: date) -> None:
+    assert parse_date(raw) == want
+
+
+@pytest.mark.parametrize(
+    "raw", ["", "2026-02-30", "2025/2/29", "5/1", "yesterday", "2026-13-01"]
+)
+def test_parse_date_bad(raw: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(raw)
+
+
+def test_basic_japanese_bank() -> None:
+    text = (
+        '日付,摘要,出金額,入金額\n2026/1/5,スーパー,"1,200",\n2026/1/6,給与,,300000\n'
+    )
+    r = parse_statement(text)
+    assert r.expenses == [Expense(date(2026, 1, 5), "未分類", 1200, "スーパー")]
+    assert r.skipped_deposits == 1
+    assert r.errors == []
+
+
+def test_card_single_amount_with_category_and_refund() -> None:
+    text = 'ご利用日,ご利用店名,ご利用金額,費目\n2026/01/05,A店,"¥1,000",食費\n2026/01/06,B店,△300,食費\n'
+    r = parse_statement(text)
+    assert [e.amount for e in r.expenses] == [1000, -300]
+    assert r.expenses[0].category == "食費"
+
+
+def test_bom_tab_crlf_and_header_case() -> None:
+    text = "﻿ Date \t AMOUNT\tDescription\r\n2026-01-05\t500\tcoffee\r\n"
+    r = parse_statement(text)
+    assert r.expenses == [Expense(date(2026, 1, 5), "未分類", 500, "coffee")]
+
+
+def test_semicolon_delimiter() -> None:
+    r = parse_statement("date;amount\n2026-01-05;500\n")
+    assert len(r.expenses) == 1
+
+
+def test_single_amount_wins_over_two_columns() -> None:
+    r = parse_statement("日付,金額,出金,入金\n2026-01-05,700,1,2\n")
+    assert r.expenses[0].amount == 700
+
+
+def test_blank_rows_ignored_and_header_only_is_empty() -> None:
+    r = parse_statement("日付,金額\n\n2026-01-05,100\n,\n")
+    assert len(r.expenses) == 1 and r.errors == []
+    assert parse_statement("日付,金額\n").expenses == []
+
+
+def test_row_errors_report_all_problems_with_position() -> None:
+    text = "日付,金額,メモ\n2026-02-30,12.5,x\n2026-01-05,100,ok\n"
+    r = parse_statement(text)
+    assert [e.line for e in r.errors] == [2, 2]
+    assert [e.column for e in r.errors] == ["日付", "金額"]
+    assert [e.value for e in r.errors] == ["2026-02-30", "12.5"]
+    assert "存在しない日付" in r.errors[0].reason
+    assert "整数" in r.errors[1].reason
+    assert len(r.expenses) == 1  # valid rows still come through
+
+
+def test_unquoted_comma_amount_reports_column_count() -> None:
+    r = parse_statement("日付,金額\n2026-01-05,1,234円\n")
+    assert len(r.errors) == 1
+    err = r.errors[0]
+    assert err.line == 2 and err.column == "" and "列数" in err.reason
+
+
+def test_short_row_and_trailing_empty_cells() -> None:
+    r = parse_statement("日付,金額,メモ\n2026-01-05\n2026-01-06,100,m,,\n")
+    assert [e.line for e in r.errors] == [2]
+    assert len(r.expenses) == 1
+
+
+def test_line_number_is_record_start_with_quoted_newline() -> None:
+    text = '日付,金額,メモ\n2026-01-05,100,"a\nb"\nbad,100,x\n'
+    r = parse_statement(text)
+    assert len(r.expenses) == 1
+    assert r.expenses[0].memo == "a\nb"
+    assert r.errors == [RowError(4, "日付", "bad", "日付の書式が不明です")]
+
+
+def test_two_column_errors() -> None:
+    text = "日付,出金,入金\n2026-01-05,,\n2026-01-06,100,200\n2026-01-07,x,\n2026-01-08,,y\n"
+    r = parse_statement(text)
+    assert [e.line for e in r.errors] == [2, 3, 4, 5]
+    assert [e.column for e in r.errors] == ["出金", "出金", "出金", "入金"]
+    assert r.skipped_deposits == 0
+
+
+def test_two_column_dash_means_empty() -> None:
+    r = parse_statement("日付,出金,入金\n2026-01-05,500,-\n2026-01-06,—,1000\n")
+    assert [e.amount for e in r.expenses] == [500]
+    assert r.skipped_deposits == 1
+
+
+def test_deposit_with_bad_date_is_error_not_skipped() -> None:
+    r = parse_statement("日付,出金,入金\nbad,,1000\n")
+    assert r.skipped_deposits == 0 and len(r.errors) == 1
+
+
+def test_empty_amount_in_single_column_is_error() -> None:
+    r = parse_statement("日付,金額\n2026-01-05,\n2026-01-06,-\n")
+    assert len(r.errors) == 2 and r.expenses == []
+
+
+@pytest.mark.parametrize("text", ["", "  \n\n", "﻿"])
+def test_empty_input_raises(text: str) -> None:
+    with pytest.raises(StatementError):
+        parse_statement(text)
+
+
+def test_missing_columns_raise_and_name_them() -> None:
+    with pytest.raises(StatementError, match="日付"):
+        parse_statement("金額\n100\n")
+    with pytest.raises(StatementError, match="金額"):
+        parse_statement("日付,摘要\n2026-01-05,x\n")
+    with pytest.raises(StatementError):
+        parse_statement("日付,出金\n2026-01-05,100\n")  # 入金 missing, no amount
+
+
+def test_non_str_input_raises_type_error() -> None:
+    with pytest.raises(TypeError):
+        parse_statement(b"date,amount\n")  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        parse_statement(None)  # type: ignore[arg-type]
+
+
+def test_row_error_str() -> None:
+    s = str(RowError(3, "金額", "abc", "金額として読めません"))
+    assert "3行目" in s and "金額" in s and "abc" in s
