@@ -0,0 +1,303 @@
+"""Import bank / credit-card statement CSV text into Expense records.
+
+Pure functions only (no file or CLI access): pass the decoded text.
+Reuses ``kakeibo.core.Expense``. Amounts are positive for spending.
+
+Decisions:
+D1: Input must be ``str`` (``bytes`` / ``None`` -> TypeError). A BOM is stripped.
+    Empty or blank-only input, or a header without date / amount columns,
+    raises ``StatementError`` (nothing can be imported at all).
+D2: Delimiter is auto-detected from the header line among ``,`` TAB ``;``
+    (most fields wins, ties -> ``,``). Both LF and CRLF are fine.
+D3: Header names are matched after NFKC + casefold + whitespace removal, with
+    aliases (日付/利用日/ご利用日/取引日/年月日/date, 金額/利用金額/ご利用金額/amount,
+    出金額/出金/お支払金額/支払金額/支払/引出 and 入金額/入金/お預り金額/預入金額/預入,
+    摘要/メモ/利用店名/ご利用店名/内容/お取り扱い内容/description/memo,
+    カテゴリ/費目/分類/category). Category is optional (default 未分類),
+    memo is optional (default "").
+D4: Single amount column wins over 出金/入金 columns when both exist. With
+    出金/入金: withdrawal -> positive; deposit-only row -> skipped (counted in
+    ``skipped_deposits``); both filled or both empty -> row error.
+D5: Amount strings: NFKC-normalised, then accepts ``-300`` ``−300`` ``△500``
+    ``▲500`` ``(500)`` ``500-`` ``+500``, ``¥ ￥ 円 JPY``, ``,`` ``，`` and spaces
+    (full-width too: ``１，２３４円``). Negative = refund and kept negative.
+    Zero is accepted. Decimals (``12.5``), empty, ``-``, text -> row error.
+    In the 出金/入金 form, empty / ``-`` / ``—`` means "no value".
+D6: Dates: ``2026-01-05`` ``2026/1/5`` ``2026.1.5`` ``2026年1月5日`` ``20260105``
+    (mixed separators ok), optional trailing time (``12:30``, ``12:30:45``),
+    和暦 ``令和8年1月5日`` ``R8.1.5`` ``H30/4/1`` ``S64.1.7`` (元年 = 1).
+    Era boundaries are not checked. Non-existent dates (2/30) -> row error.
+E1: Blank rows are ignored. A row with more columns than the header (typically
+    an unquoted ``1,234円``) or fewer -> a single row error about the column
+    count (trailing empty extra cells are tolerated). Reported line numbers are
+    the record's first line (quoted newlines are handled).
+E2: Every problem in a row is reported (date and amount both), each with
+    line, column name as written in the file, raw value and reason.
+    Valid rows are still returned.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass, field
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_CATEGORY = "未分類"
+
+
+class StatementError(ValueError):
+    """The statement as a whole cannot be imported (empty, bad header)."""
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int  # 1-based first line of the record
+    column: str  # header name as written; "" for whole-row problems
+    value: str  # raw cell text ("" for whole-row problems)
+    reason: str
+
+    def __str__(self) -> str:
+        where = f"{self.line}行目"
+        if self.column:
+            where += f" 列「{self.column}」"
+        shown = f" ({self.value!r})" if self.value else ""
+        return f"{where}: {self.reason}{shown}"
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense] = field(default_factory=list)
+    errors: list[RowError] = field(default_factory=list)
+    skipped_deposits: int = 0
+
+
+_ALIASES: dict[str, tuple[str, ...]] = {
+    "date": ("日付", "利用日", "ご利用日", "取引日", "年月日", "date"),
+    "amount": ("金額", "利用金額", "ご利用金額", "amount"),
+    "withdrawal": (
+        "出金額",
+        "出金",
+        "お支払金額",
+        "支払金額",
+        "支払",
+        "引出",
+        "引出額",
+    ),
+    "deposit": ("入金額", "入金", "お預り金額", "預入金額", "預入", "預入額"),
+    "memo": (
+        "摘要",
+        "メモ",
+        "利用店名",
+        "ご利用店名",
+        "内容",
+        "お取り扱い内容",
+        "description",
+        "memo",
+    ),
+    "category": ("カテゴリ", "費目", "分類", "category"),
+}
+
+
+def _norm_header(s: str) -> str:
+    return re.sub(r"\s+", "", unicodedata.normalize("NFKC", s)).casefold()
+
+
+_ALIAS_LOOKUP: dict[str, str] = {
+    _norm_header(a): key for key, names in _ALIASES.items() for a in names
+}
+
+_DASHES = "−‐‑‒–—―－"
+
+
+def parse_amount(text: str) -> int:
+    """Parse one amount string to int yen. Raises ValueError (reason in Japanese)."""
+    if not isinstance(text, str):  # pyright: ignore[reportUnnecessaryIsInstance]
+        raise TypeError("text must be str")
+    s = unicodedata.normalize("NFKC", text)
+    for d in _DASHES:
+        s = s.replace(d, "-")
+    s = re.sub(r"JPY", "", s, flags=re.IGNORECASE)
+    s = re.sub(r"[\s¥円,]", "", s)
+    if s == "":
+        raise ValueError("金額が空です")
+    negative = False
+    if s[0] in "△▲":
+        negative, s = True, s[1:]
+    elif s.startswith("(") and s.endswith(")"):
+        negative, s = True, s[1:-1]
+    elif s.startswith("-"):
+        negative, s = True, s[1:]
+    elif s.startswith("+"):
+        s = s[1:]
+    elif s.endswith("-"):
+        negative, s = True, s[:-1]
+    if re.fullmatch(r"[0-9]+\.[0-9]*", s) or re.fullmatch(r"\.[0-9]+", s):
+        raise ValueError("金額が整数ではありません(小数)")
+    if not re.fullmatch(r"[0-9]+", s):
+        raise ValueError("金額として読めません")
+    n = int(s)
+    return -n if negative else n
+
+
+_ERA_BASE = {"令和": 2018, "r": 2018, "平成": 1988, "h": 1988, "昭和": 1925, "s": 1925}
+_TIME_TAIL = re.compile(r"[ T]\d{1,2}:\d{2}(:\d{2})?$")
+_WESTERN = re.compile(r"(\d{4})[-/.年](\d{1,2})[-/.月](\d{1,2})日?")
+_COMPACT = re.compile(r"(\d{4})(\d{2})(\d{2})")
+_ERA = re.compile(
+    r"(令和|平成|昭和|[rhs])(元|\d{1,2})[-/.年](\d{1,2})[-/.月](\d{1,2})日?"
+)
+
+
+def parse_date(text: str) -> date:
+    """Parse one date string. Raises ValueError (reason in Japanese)."""
+    if not isinstance(text, str):  # pyright: ignore[reportUnnecessaryIsInstance]
+        raise TypeError("text must be str")
+    s = unicodedata.normalize("NFKC", text).strip().casefold()
+    s = _TIME_TAIL.sub("", s).strip()
+    if s == "":
+        raise ValueError("日付が空です")
+    try:
+        if m := (_WESTERN.fullmatch(s) or _COMPACT.fullmatch(s)):
+            y, mo, d = (int(g) for g in m.groups())
+        elif m := _ERA.fullmatch(s):
+            era, yy, mo_s, d_s = m.groups()
+            y = _ERA_BASE[era] + (1 if yy == "元" else int(yy))
+            mo, d = int(mo_s), int(d_s)
+        else:
+            raise ValueError("日付の書式が不明です")
+        return date(y, mo, d)
+    except ValueError as e:
+        if str(e).startswith("日付の書式"):
+            raise
+        raise ValueError("存在しない日付です") from None
+
+
+def _detect_delimiter(header_line: str) -> str:
+    best, best_n = ",", 0
+    for d in (",", "\t", ";"):
+        n = len(next(csv.reader([header_line], delimiter=d), []))
+        if n > best_n:
+            best, best_n = d, n
+    return best
+
+
+def _is_blank(row: list[str]) -> bool:
+    return all(c.strip() == "" for c in row)
+
+
+def _empty_amount(s: str) -> bool:
+    t = unicodedata.normalize("NFKC", s).strip()
+    return t == "" or t in ("-", "—", "−", "―")
+
+
+def parse_statement(text: str) -> ImportResult:
+    """Parse statement CSV text. Valid rows -> expenses, bad rows -> errors."""
+    if not isinstance(text, str):  # pyright: ignore[reportUnnecessaryIsInstance]
+        raise TypeError("text must be str")
+    text = text.removeprefix("﻿")
+    first = next((ln for ln in text.splitlines() if ln.strip()), None)
+    if first is None:
+        raise StatementError("入力が空です")
+    reader = csv.reader(
+        io.StringIO(text, newline=""), delimiter=_detect_delimiter(first)
+    )
+
+    def read() -> tuple[int, list[str]] | None:
+        start = reader.line_num + 1
+        row = next(reader, None)
+        return None if row is None else (start, row)
+
+    header: list[str] = []
+    while (rec := read()) is not None:
+        if not _is_blank(rec[1]):
+            header = rec[1]
+            break
+    cols: dict[str, int] = {}
+    for i, h in enumerate(header):
+        key = _ALIAS_LOOKUP.get(_norm_header(h))
+        if key is not None and key not in cols:
+            cols[key] = i
+    two_col = "amount" not in cols and "withdrawal" in cols and "deposit" in cols
+    missing: list[str] = []
+    if "date" not in cols:
+        missing.append("日付")
+    if "amount" not in cols and not two_col:
+        missing.append("金額(または出金・入金)")
+    if missing:
+        raise StatementError(
+            f"ヘッダーに必須の列がありません: {', '.join(missing)} (見つかった列: {header})"
+        )
+
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    skipped = 0
+    n = len(header)
+
+    def cell(row: list[str], key: str) -> str:
+        return row[cols[key]] if key in cols else ""
+
+    while (rec := read()) is not None:
+        line, row = rec
+        if _is_blank(row):
+            continue
+        if len(row) != n and not (len(row) > n and _is_blank(row[n:])):
+            errors.append(
+                RowError(
+                    line,
+                    "",
+                    "",
+                    f"列数が違います(ヘッダー {n} 列、この行 {len(row)} 列)。"
+                    "引用符のない区切り文字を含む値かもしれません",
+                )
+            )
+            continue
+        row_errors: list[RowError] = []
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(cell(row, "date"))
+        except ValueError as e:
+            row_errors.append(
+                RowError(line, header[cols["date"]], cell(row, "date"), str(e))
+            )
+        if two_col:
+            w_raw, d_raw = cell(row, "withdrawal"), cell(row, "deposit")
+            w_empty, d_empty = _empty_amount(w_raw), _empty_amount(d_raw)
+            w_name, d_name = header[cols["withdrawal"]], header[cols["deposit"]]
+            if w_empty and d_empty:
+                row_errors.append(RowError(line, w_name, w_raw, "出金も入金も空です"))
+            elif not w_empty and not d_empty:
+                row_errors.append(
+                    RowError(line, w_name, w_raw, "出金と入金の両方に値があります")
+                )
+            elif w_empty:
+                try:
+                    parse_amount(d_raw)
+                    if not row_errors:
+                        skipped += 1
+                        continue
+                except ValueError as e:
+                    row_errors.append(RowError(line, d_name, d_raw, str(e)))
+            else:
+                try:
+                    amount = parse_amount(w_raw)
+                except ValueError as e:
+                    row_errors.append(RowError(line, w_name, w_raw, str(e)))
+        else:
+            a_raw = cell(row, "amount")
+            try:
+                amount = parse_amount(a_raw)
+            except ValueError as e:
+                row_errors.append(RowError(line, header[cols["amount"]], a_raw, str(e)))
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        if day is not None and amount is not None:
+            category = cell(row, "category").strip() or DEFAULT_CATEGORY
+            expenses.append(Expense(day, category, amount, cell(row, "memo").strip()))
+    return ImportResult(expenses, errors, skipped)
diff --git a/tests/test_statement.py b/tests/test_statement.py
