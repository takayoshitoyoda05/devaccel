diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..e6ec520 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -188,3 +188,107 @@ def test_path_type(runner, cls, expect):
 
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["a.csv", "a.CSV", "a.Tsv", "dir.d/a.tsv", "a.b.csv", pathlib.Path("a.csv")],
+)
+def test_path_extensions_accept(value):
+    type = click.Path(extensions=[".csv", ".tsv"])
+    assert type.convert(value, None, None) == value
+
+
+@pytest.mark.parametrize("value", ["a.txt", "a", "a.csv.bak", "csv", ".csv", "a.csv/"])
+def test_path_extensions_reject(value):
+    type = click.Path(extensions=[".csv", ".tsv"])
+
+    with pytest.raises(click.BadParameter, match="must have one of the extensions"):
+        type.convert(value, None, None)
+
+
+def test_path_extensions_normalized():
+    type = click.Path(extensions=["CSV", ".Tsv"])
+    assert type.extensions == (".csv", ".tsv")
+    assert type.to_info_dict()["extensions"] == [".csv", ".tsv"]
+    assert click.Path().to_info_dict()["extensions"] is None
+    assert type.convert("A.TSV", None, None) == "A.TSV"
+
+
+def test_path_extensions_multi_part():
+    type = click.Path(extensions=[".tar.gz"])
+    assert type.convert("a.TAR.GZ", None, None) == "a.TAR.GZ"
+
+    with pytest.raises(click.BadParameter):
+        type.convert("a.gz", None, None)
+
+
+def test_path_extensions_bytes():
+    type = click.Path(extensions=[".csv"])
+    assert type.convert(b"a.CSV", None, None) == b"a.CSV"
+
+    with pytest.raises(click.BadParameter):
+        type.convert(b"a.txt", None, None)
+
+
+def test_path_extensions_dash():
+    type = click.Path(extensions=[".csv"], allow_dash=True)
+    assert type.convert("-", None, None) == "-"
+
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions=[".csv"]).convert("-", None, None)
+
+
+def test_path_extensions_existing_file(tmp_path):
+    good = tmp_path / "data.CSV"
+    good.write_text("x")
+    bad = tmp_path / "data.txt"
+    bad.write_text("x")
+    type = click.Path(exists=True, extensions=[".csv"], path_type=pathlib.Path)
+
+    assert type.convert(str(good), None, None) == good
+
+    with pytest.raises(click.BadParameter, match="must have one of the extensions"):
+        type.convert(str(bad), None, None)
+
+
+def test_path_extensions_directory_not_checked(tmp_path):
+    directory = tmp_path / "plain"
+    directory.mkdir()
+    type = click.Path(exists=True, extensions=[".csv"])
+    assert type.convert(str(directory), None, None) == str(directory)
+
+
+def test_path_extensions_missing_file_checked(tmp_path):
+    type = click.Path(extensions=[".csv"])
+    missing = str(tmp_path / "missing.csv")
+    assert type.convert(missing, None, None) == missing
+
+    with pytest.raises(click.BadParameter, match="must have one of the extensions"):
+        type.convert(str(tmp_path / "missing.txt"), None, None)
+
+
+@pytest.mark.parametrize(
+    ("extensions", "error"),
+    [([], ValueError), ([""], ValueError), (["."], ValueError), (".csv", TypeError)],
+)
+def test_path_extensions_invalid_argument(extensions, error):
+    with pytest.raises(error):
+        click.Path(extensions=extensions)
+
+
+def test_path_extensions_generator():
+    type = click.Path(extensions=(e for e in ["csv"]))
+    assert type.extensions == (".csv",)
+
+
+def test_path_extensions_in_command(runner):
+    @click.command()
+    @click.option("--f", type=click.Path(extensions=[".csv", ".tsv"]))
+    def cli(f):
+        click.echo(f)
+
+    assert runner.invoke(cli, ["--f", "x.TSV"]).output == "x.TSV\n"
+    result = runner.invoke(cli, ["--f", "x.txt"])
+    assert result.exit_code == 2
+    assert "must have one of the extensions: .csv, .tsv." in result.output
