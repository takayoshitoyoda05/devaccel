@@ -0,0 +1,67 @@
+"""Budgets and overrun detection."""
+
+from __future__ import annotations
+
+import json
+import re
+from dataclasses import dataclass
+from pathlib import Path
+
+
+class BudgetError(ValueError):
+    """Raised when budget.json is missing or invalid."""
+
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class Budget:
+    default: dict[str, int]
+    months: dict[str, dict[str, int]]
+
+    def for_month(self, month: str) -> dict[str, int]:
+        return {**self.default, **self.months.get(month, {})}
+
+
+def _amounts(obj: object, where: str) -> dict[str, int]:
+    if not isinstance(obj, dict):
+        raise BudgetError(f"{where} はオブジェクトである必要があります")
+    for cat, yen in obj.items():
+        if isinstance(yen, bool) or not isinstance(yen, int) or yen < 0:
+            raise BudgetError(f"{where}.{cat} は 0 以上の整数である必要があります")
+    return dict(obj)
+
+
+def load_budget(path: Path) -> Budget:
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+    except OSError as e:
+        raise BudgetError(f"予算ファイルを読めません: {e.strerror}: {path}") from None
+    except ValueError as e:
+        raise BudgetError(f"予算ファイルが不正な JSON です: {e}") from None
+    if not isinstance(data, dict):
+        raise BudgetError("予算ファイルの最上位はオブジェクトである必要があります")
+    default = _amounts(data.get("default", {}), "default")
+    raw_months = data.get("months", {})
+    if not isinstance(raw_months, dict):
+        raise BudgetError("months はオブジェクトである必要があります")
+    months: dict[str, dict[str, int]] = {}
+    for m, amounts in raw_months.items():
+        if not _MONTH_RE.fullmatch(m):
+            raise BudgetError(f"月の形式が不正です(YYYY-MM): {m!r}")
+        months[m] = _amounts(amounts, f"months.{m}")
+    return Budget(default, months)
+
+
+def find_overruns(
+    totals: dict[str, dict[str, int]], budget: Budget
+) -> list[tuple[str, str, int, int, int]]:
+    """(month, category, over, limit, actual) for actual > limit."""
+    out: list[tuple[str, str, int, int, int]] = []
+    for month, cats in totals.items():
+        limits = budget.for_month(month)
+        for cat, actual in cats.items():
+            if cat in limits and actual > limits[cat]:
+                out.append((month, cat, actual - limits[cat], limits[cat], actual))
+    return out
