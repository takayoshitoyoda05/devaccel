@@ -0,0 +1,269 @@
+"""銀行・カード会社の CSV 取り込み(純粋関数)。
+
+`import_csv(text)` は CSV の文字列から Expense のリストと、行ごとの誤りを返す。
+ファイルや CLI には触れない。金額は円の整数、支出が正・返金が負。
+
+判断:
+D1: 区切りは見出し行から `,` / タブ / `;` を自動判定する(最多の記号。同数なら `,`)。
+D2: 先頭の BOM は無視する。改行は CRLF・LF どちらも可。
+D3: 列名は NFKC・前後空白除去・大文字小文字無視で別名に照合する。
+    日付: 日付/利用日/ご利用日/取引日/年月日/date
+    金額: 金額/利用金額/ご利用金額/支払金額/amount
+    出金: 出金額/出金/お支払金額/お支払い金額/支払/引出/引出額
+    入金: 入金額/入金/預入/お預入れ/預入額
+    摘要: 摘要/メモ/利用店名/ご利用店名/店名/内容/description/memo
+    分類: カテゴリ/分類/区分/category
+D4: 日付・(金額 または 出金/入金)の列が無ければ、見出し行に 1 件の誤りを返し、明細は読まない。
+    同じ意味の列が複数ある場合も見出し行の誤り。
+D5: 分類の列が無い、または値が空なら "未分類"。摘要は無ければ空文字。
+D6: 日付は `2026-01-05` `2026/1/5` `2026.1.5` `2026年1月5日`(全角可)。時刻付き
+    (`2026/01/05 12:34`)は時刻を捨てる。和暦・西暦 2 桁・存在しない日付(2/30)は誤り。
+D7: 金額は NFKC 後に `¥` `円` `JPY` `,` 空白を除き、負は `-` `−`(U+2212) `△` `▲`
+    の前置、`500-` の後置、`(500)` で書く。`+` 前置は可。負数は返金として負のまま受ける。
+D8: 0 は有効な金額として受ける。小数(`12.5`)は丸めず誤りにする。
+D9: 金額が 1 列のとき、空欄・`-`・`—` は誤り(金額がありません)。
+D10: 出金/入金の 2 列形式は、出金があればその額(正)、入金だけの行は skipped に行番号を
+     入れて取り込まない。両方に 0 以外の値、または両方空は誤り。空欄・`-`・`—` は「なし」。
+     金額列があるときは金額列を優先し、出金/入金列は見ない。
+D11: 列数が見出しと違う行は誤り(引用されていない `1,234円` が割れた場合を含む)。
+     修復はしない。
+D12: 1 行に誤りが複数あれば、日付・金額の順にすべて報告する。誤りは
+     行番号・列名・元の値・理由を持つ。行番号は引用符内の改行があってもレコードの開始行
+     (1 始まり。見出しが 1 行目)。
+D13: 空行、全セルが空の行は無視する(誤りでも skipped でもない)。
+D14: 空入力・見出しだけは、明細も誤りも空の結果を返す(例外にしない)。
+D15: 誤りがあっても読めた行の expenses は返す(全か無かにはしない)。
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from collections.abc import Callable
+from dataclasses import dataclass, field
+from datetime import date
+
+from kakeibo.core import Expense
+
+UNCATEGORIZED = "未分類"
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str | None  # None は行全体の誤り(列数など)
+    value: str
+    reason: str
+
+    def __str__(self) -> str:
+        where = f"{self.line}行目" + (f" 列 {self.column}" if self.column else "")
+        return f"{where}: {self.reason}: {self.value!r}"
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense] = field(default_factory=list)
+    errors: list[RowError] = field(default_factory=list)
+    skipped: list[int] = field(default_factory=list)  # 入金だけの行の行番号
+
+
+_ALIASES: dict[str, tuple[str, ...]] = {
+    "date": ("日付", "利用日", "ご利用日", "取引日", "年月日", "date"),
+    "amount": ("金額", "利用金額", "ご利用金額", "支払金額", "amount"),
+    "out": ("出金額", "出金", "お支払金額", "お支払い金額", "支払", "引出", "引出額"),
+    "in": ("入金額", "入金", "預入", "お預入れ", "預入額"),
+    "memo": (
+        "摘要",
+        "メモ",
+        "利用店名",
+        "ご利用店名",
+        "店名",
+        "内容",
+        "description",
+        "memo",
+    ),
+    "category": ("カテゴリ", "分類", "区分", "category"),
+}
+_LOOKUP = {_n.casefold(): k for k, names in _ALIASES.items() for _n in names}
+
+_DATE_RE = re.compile(
+    r"([0-9]{4})[-/.年]([0-9]{1,2})[-/.月]([0-9]{1,2})日?"
+    r"(?:[ T]+[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?)?"
+)
+_NEG_PREFIX = "-−△▲"
+_BLANKS = {"", "-", "−", "—", "–", "ー"}
+
+
+def _norm(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip()
+
+
+def _parse_date(raw: str) -> date:
+    m = _DATE_RE.fullmatch(_norm(raw))
+    if not m:
+        raise ValueError("日付の書式が不正です(和暦・2桁年は未対応)")
+    try:
+        return date(int(m[1]), int(m[2]), int(m[3]))
+    except ValueError:
+        raise ValueError("存在しない日付です") from None
+
+
+def _is_blank_amount(raw: str) -> bool:
+    return _norm(raw).replace(" ", "") in _BLANKS
+
+
+def _parse_amount(raw: str) -> int:
+    s = _norm(raw)
+    s = re.sub(r"JPY", "", s, flags=re.IGNORECASE)
+    s = re.sub(r"[¥￥円,\s]", "", s)
+    neg = False
+    if len(s) >= 2 and s[0] == "(" and s[-1] == ")":
+        neg, s = True, s[1:-1]
+    elif s[:1] in _NEG_PREFIX and s[:1]:
+        neg, s = True, s[1:]
+    elif s[:1] == "+":
+        s = s[1:]
+    elif s[-1:] == "-":
+        neg, s = True, s[:-1]
+    if re.fullmatch(r"[0-9]+\.[0-9]*|\.[0-9]+", s):
+        raise ValueError("金額が整数ではありません(小数は未対応)")
+    if not re.fullmatch(r"[0-9]+", s):
+        raise ValueError("金額の書式が不正です")
+    return -int(s) if neg else int(s)
+
+
+def _detect_delimiter(header_line: str) -> str:
+    counts = {d: header_line.count(d) for d in (",", "\t", ";")}
+    best = max(counts.values())
+    if best == 0:
+        return ","
+    return next(d for d in (",", "\t", ";") if counts[d] == best)
+
+
+def _map_header(cells: list[str]) -> tuple[dict[str, int], str | None]:
+    cols: dict[str, int] = {}
+    for i, c in enumerate(cells):
+        key = _LOOKUP.get(_norm(c).casefold())
+        if key is None:
+            continue
+        if key in cols:
+            return {}, f"同じ意味の列が複数あります: {_norm(c)!r}"
+        cols[key] = i
+    if "date" not in cols:
+        return {}, "日付の列がありません"
+    if "amount" not in cols and "out" not in cols and "in" not in cols:
+        return {}, "金額(または出金/入金)の列がありません"
+    return cols, None
+
+
+def import_csv(text: str) -> ImportResult:
+    text = text.lstrip("﻿")
+    first = next((ln for ln in text.splitlines() if ln.strip()), "")
+    reader = csv.reader(
+        io.StringIO(text, newline=""), delimiter=_detect_delimiter(first)
+    )
+
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    skipped: list[int] = []
+    cols: dict[str, int] | None = None
+    width = 0
+    prev_end = 0
+    for row in reader:
+        start = prev_end + 1
+        prev_end = reader.line_num
+        if not any(c.strip() for c in row):
+            continue
+        if cols is None:
+            cols, why = _map_header(row)
+            width = len(row)
+            if why:
+                return ImportResult([], [RowError(start, None, ",".join(row), why)], [])
+            continue
+        if len(row) != width:
+            errors.append(
+                RowError(
+                    start,
+                    None,
+                    ",".join(row),
+                    f"列数が見出し({width})と違います({len(row)})",
+                )
+            )
+            continue
+
+        def cell(key: str, row: list[str] = row, cols: dict[str, int] = cols) -> str:
+            return row[cols[key]] if key in cols else ""
+
+        row_errors: list[RowError] = []
+        day: date | None = None
+        amount: int | None = None
+        skip = False
+        try:
+            day = _parse_date(cell("date"))
+        except ValueError as e:
+            row_errors.append(RowError(start, _COLNAME["date"], cell("date"), str(e)))
+        try:
+            amount, skip = _row_amount(cols, cell)
+        except _AmountError as e:
+            row_errors.append(RowError(start, e.column, e.value, e.reason))
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        if skip:
+            skipped.append(start)
+            continue
+        assert day is not None and amount is not None
+        expenses.append(
+            Expense(
+                day=day,
+                category=cell("category").strip() or UNCATEGORIZED,
+                amount=amount,
+                memo=cell("memo").strip(),
+            )
+        )
+    return ImportResult(expenses, errors, skipped)
+
+
+class _AmountError(Exception):
+    def __init__(self, column: str, value: str, reason: str) -> None:
+        super().__init__(reason)
+        self.column, self.value, self.reason = column, value, reason
+
+
+_COLNAME = {"date": "日付", "amount": "金額", "out": "出金", "in": "入金"}
+
+
+def _row_amount(
+    cols: dict[str, int], cell: Callable[[str], str]
+) -> tuple[int | None, bool]:
+    """(amount, skip)。誤りは _AmountError。"""
+    if "amount" in cols:
+        raw = cell("amount")
+        if _is_blank_amount(raw):
+            raise _AmountError("金額", raw, "金額がありません")
+        try:
+            return _parse_amount(raw), False
+        except ValueError as e:
+            raise _AmountError("金額", raw, str(e)) from None
+    vals: dict[str, int | None] = {}
+    for key in ("out", "in"):
+        raw = cell(key)
+        if key not in cols or _is_blank_amount(raw):
+            vals[key] = None
+            continue
+        try:
+            vals[key] = _parse_amount(raw)
+        except ValueError as e:
+            raise _AmountError(_COLNAME[key], raw, str(e)) from None
+    out, inc = vals["out"], vals["in"]
+    if out is None and inc is None:
+        raise _AmountError("出金/入金", "", "出金も入金もありません")
+    if out and inc:
+        raise _AmountError(
+            "出金/入金", f"{cell('out')}|{cell('in')}", "出金と入金の両方に値があります"
+        )
+    if out is not None and (out != 0 or not inc):
+        return out, False
+    return None, True  # 入金だけ
diff --git a/tests/test_importer.py b/tests/test_importer.py
