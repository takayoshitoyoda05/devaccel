@@ -0,0 +1,172 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.importer import import_csv
+
+
+def _one(amount: str) -> int:
+    r = import_csv(f"日付,金額\n2026-01-05,{amount}\n")
+    assert not r.errors, r.errors
+    return r.expenses[0].amount
+
+
+@pytest.mark.parametrize(
+    "raw,want",
+    [
+        ("500", 500),
+        ('"1,234"', 1234),
+        ('"¥1,234"', 1234),
+        ("￥１２３", 123),
+        ("500円", 500),
+        ("JPY 500", 500),
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("+500", 500),
+        ("0", 0),
+    ],
+)
+def test_amount_notations(raw, want):  # D7, D8
+    assert _one(raw) == want
+
+
+@pytest.mark.parametrize("raw", ["12.5", "abc", "5-0", "--5", "1 2.", ""])
+def test_bad_amounts_reported(raw):  # D8, D9
+    r = import_csv(f"日付,金額\n2026-01-05,{raw}\n")
+    assert r.expenses == []
+    assert [(e.line, e.column, e.value) for e in r.errors] == [(2, "金額", raw)]
+
+
+@pytest.mark.parametrize("raw", ["-", "—"])
+def test_single_amount_dash_is_error(raw):  # D9
+    assert (
+        import_csv(f"日付,金額\n2026-01-05,{raw}\n").errors[0].reason
+        == "金額がありません"
+    )
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026.1.5",
+        "2026年1月5日",
+        "２０２６／１／５",
+        "2026/01/05 12:34",
+    ],
+)
+def test_date_formats(raw):  # D6
+    r = import_csv(f'日付,金額\n"{raw}",1\n'.replace("／", "/"))
+    assert r.expenses[0].day == date(2026, 1, 5)
+
+
+@pytest.mark.parametrize(
+    "raw", ["2026-02-30", "令和8年1月5日", "26/1/5", "2026-13-01", ""]
+)
+def test_bad_dates_reported(raw):  # D6
+    r = import_csv(f"日付,金額\n{raw},1\n")
+    assert [(e.line, e.column, e.value) for e in r.errors] == [(2, "日付", raw)]
+
+
+def test_leap_day_ok():
+    assert import_csv("日付,金額\n2024-02-29,1\n").expenses[0].day == date(2024, 2, 29)
+
+
+def test_header_aliases_bank_style():  # D3, D10
+    text = "取引日,摘要,出金額,入金額\n2026/1/5,コンビニ,500,\n2026/1/6,給与,,300000\n2026/1/7,ATM,-,-\n"
+    r = import_csv(text)
+    assert r.expenses == [Expense(date(2026, 1, 5), "未分類", 500, "コンビニ")]
+    assert r.skipped == [3]
+    assert [(e.line, e.column) for e in r.errors] == [(4, "出金/入金")]
+
+
+def test_header_aliases_card_style_and_case():  # D3
+    text = ' Date ,ご利用店名,ご利用金額,区分\n2026/1/5,スーパー,"1,200円",食費\n'
+    r = import_csv(text)
+    assert r.expenses == [Expense(date(2026, 1, 5), "食費", 1200, "スーパー")]
+
+
+def test_both_out_and_in_is_error():  # D10
+    r = import_csv("日付,出金,入金\n2026-01-05,100,200\n")
+    assert r.errors[0].column == "出金/入金"
+    assert r.skipped == []
+
+
+def test_amount_column_wins_over_out_in():  # D10
+    r = import_csv("日付,金額,出金,入金\n2026-01-05,700,1,2\n")
+    assert r.expenses[0].amount == 700
+
+
+def test_missing_required_columns():  # D4
+    r = import_csv("日付,メモ\n2026-01-05,x\n")
+    assert r.expenses == []
+    assert [(e.line, e.column) for e in r.errors] == [(1, None)]
+    assert "金額" in r.errors[0].reason
+    r = import_csv("メモ,金額\nx,1\n")
+    assert "日付" in r.errors[0].reason
+
+
+def test_duplicate_meaning_columns():  # D4
+    r = import_csv("日付,金額,利用金額\n2026-01-05,1,2\n")
+    assert r.expenses == [] and "複数" in r.errors[0].reason
+
+
+def test_bom_tab_semicolon_crlf():  # D1, D2
+    assert import_csv("﻿日付\t金額\r\n2026-01-05\t100\r\n").expenses[0].amount == 100
+    assert import_csv("date;amount\n2026-01-05;100\n").expenses[0].amount == 100
+
+
+def test_unquoted_thousands_separator_is_column_count_error():  # D11
+    r = import_csv("日付,金額\n2026-01-05,1,234円\n")
+    assert r.expenses == []
+    assert r.errors[0].line == 2 and r.errors[0].column is None
+    assert "列数" in r.errors[0].reason
+
+
+def test_short_row_is_error():  # D11
+    r = import_csv("日付,金額,メモ\n2026-01-05,100\n")
+    assert r.errors[0].line == 2
+
+
+def test_multiple_errors_in_one_row_all_reported():  # D12
+    r = import_csv("日付,金額\n2026-02-30,abc\n")
+    assert [(e.line, e.column) for e in r.errors] == [(2, "日付"), (2, "金額")]
+
+
+def test_line_number_is_record_start_with_quoted_newline():  # D12
+    text = '日付,金額,メモ\n2026-01-05,100,"a\nb"\n2026-01-06,x,\n'
+    r = import_csv(text)
+    assert len(r.expenses) == 1 and r.expenses[0].memo == "a\nb"
+    assert [e.line for e in r.errors] == [4]
+
+
+def test_blank_lines_ignored_and_good_rows_kept():  # D13, D15
+    text = "日付,金額\n\n2026-01-05,100\n,,\n2026-01-06,zzz\n2026-01-07,300\n"
+    r = import_csv(text)
+    assert [e.amount for e in r.expenses] == [100, 300]
+    assert [e.line for e in r.errors] == [5]
+    assert r.skipped == []
+
+
+@pytest.mark.parametrize("text", ["", "\n\n", "日付,金額\n", "﻿日付,金額"])
+def test_empty_and_header_only(text):  # D14
+    r = import_csv(text)
+    assert r.expenses == [] and r.errors == [] and r.skipped == []
+
+
+def test_category_default_and_memo():  # D5
+    r = import_csv(
+        "日付,金額,カテゴリ,メモ\n2026-01-05,1,,  x \n2026-01-06,2, 食費 ,\n"
+    )
+    assert [(e.category, e.memo) for e in r.expenses] == [("未分類", "x"), ("食費", "")]
+
+
+def test_error_str_has_line_column_value():
+    e = import_csv("日付,金額\n2026-01-05,abc\n").errors[0]
+    assert "2行目" in str(e) and "金額" in str(e) and "'abc'" in str(e)
