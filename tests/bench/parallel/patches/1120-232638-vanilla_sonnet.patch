@@ -0,0 +1,122 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.importer import RowError, parse_amount, parse_csv_text, parse_date
+
+
+@pytest.mark.parametrize(
+    "s",
+    [
+        "2026-11-01",
+        "2026/11/1",
+        "2026年11月1日",
+        "20261101",
+        "２０２６/１１/０１",
+        "令和8年11月1日",
+        "R8.11.1",
+    ],
+)
+def test_parse_date_formats(s):
+    assert parse_date(s) == date(2026, 11, 1)
+
+
+@pytest.mark.parametrize("s", ["", "abc", "2026-13-01", "2026/02/30"])
+def test_parse_date_bad(s):
+    with pytest.raises(ValueError):
+        parse_date(s)
+
+
+@pytest.mark.parametrize(
+    "s,n",
+    [
+        ("1234", 1234),
+        ("1,234", 1234),
+        ("¥1,234", 1234),
+        ("1,234円", 1234),
+        ("１２３４", 1234),
+        ("-500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("1000.00", 1000),
+    ],
+)
+def test_parse_amount(s, n):
+    assert parse_amount(s) == n
+
+
+@pytest.mark.parametrize("s", ["", "abc", "1.5", "12,3x"])
+def test_parse_amount_bad(s):
+    with pytest.raises(ValueError):
+        parse_amount(s)
+
+
+def test_card_style_japanese_headers():
+    r = parse_csv_text('﻿利用日,ご利用店名,利用金額\n2026/11/01,コンビニ,"1,200円"\n')
+    assert r.errors == []
+    assert r.expenses == [Expense(date(2026, 11, 1), "未分類", 1200, "コンビニ")]
+
+
+def test_bank_style_withdrawal_deposit_columns():
+    r = parse_csv_text(
+        "日付,摘要,出金,入金\n2026-11-01,家賃,80000,\n2026-11-02,給与,,300000\n"
+    )
+    assert [e.amount for e in r.expenses] == [80000]
+    assert r.skipped == 1 and r.errors == []
+
+
+def test_signed_amount_modes():
+    text = "date,amount\n2026-11-01,-500\n2026-11-02,700\n"
+    r = parse_csv_text(text, negative_is_expense=True)
+    assert [e.amount for e in r.expenses] == [500] and r.skipped == 1
+    r = parse_csv_text(text)
+    assert [e.amount for e in r.expenses] == [700] and r.skipped == 1
+
+
+def test_english_headers_with_category():
+    r = parse_csv_text("Date,Category,Amount,Description\n2026-11-01,food,100,lunch\n")
+    assert r.expenses == [Expense(date(2026, 11, 1), "food", 100, "lunch")]
+
+
+def test_bad_rows_report_line_and_column_and_good_rows_survive():
+    text = (
+        "date,amount,memo\n2026-11-01,100,a\nxx,200,b\n\n"
+        "2026-11-03,abc,c\n2026-11-04,0,d\n"
+    )
+    r = parse_csv_text(text)
+    assert len(r.expenses) == 1
+    assert [(e.line, e.column) for e in r.errors] == [
+        (3, "date"),
+        (5, "amount"),
+        (6, "amount"),
+    ]
+    assert "xx" in r.errors[0].message
+    assert str(r.errors[0]).startswith("3行目: [date]")
+
+
+def test_multiple_errors_in_one_row_and_short_row():
+    r = parse_csv_text("date,amount\nxx,abc\n2026-11-01\n")
+    assert [(e.line, e.column) for e in r.errors] == [
+        (2, "date"),
+        (2, "amount"),
+        (3, "amount"),
+    ]
+
+
+def test_quoted_multiline_field_line_numbers():
+    r = parse_csv_text('date,memo,amount\n2026-11-01,"a\nb",100\nbad,x,1\n')
+    assert len(r.expenses) == 1
+    assert r.errors == [RowError(4, "date", "日付の形式を認識できません: 'bad'")]
+
+
+def test_missing_required_columns():
+    r = parse_csv_text("foo,bar\n1,2\n")
+    assert r.expenses == [] and len(r.errors) == 1
+    assert r.errors[0].line == 1 and r.errors[0].column == "date,amount"
+
+
+def test_empty_input():
+    r = parse_csv_text("")
+    assert r.errors[0].line == 0
