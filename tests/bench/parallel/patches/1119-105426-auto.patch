@@ -0,0 +1,207 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring
+
+
+def E(day: date, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+def test_example_rent_detected_with_next_expected() -> None:
+    rows = [
+        E(date(2026, 1, 25), "住居", 80000, "家賃"),
+        E(date(2026, 2, 25), "住居", 80000, "家賃"),
+        E(date(2026, 3, 25), "住居", 80000, "家賃"),
+    ]
+    assert find_recurring(rows) == [
+        Recurring("住居", "家賃", 80000, date(2026, 3, 25), date(2026, 4, 25), 3)
+    ]
+
+
+def test_month_end_clamps_to_last_day_of_next_month() -> None:
+    rows = [
+        E(date(2026, 1, 31), "通信", 5000, "回線"),
+        E(date(2026, 2, 28), "通信", 5000, "回線"),
+        E(date(2026, 3, 31), "通信", 5000, "回線"),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.next_expected == date(2026, 4, 30)
+
+
+def test_leap_year_february_clamps_to_29() -> None:
+    rows = [
+        E(date(2028, 11, 30), "雑費", 300, "x"),
+        E(date(2028, 12, 30), "雑費", 300, "x"),
+        E(date(2029, 1, 29), "雑費", 300, "x"),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.next_expected == date(2029, 2, 28)
+
+    rows = [
+        E(date(2027, 11, 29), "雑費", 300, "x"),
+        E(date(2027, 12, 29), "雑費", 300, "x"),
+        E(date(2028, 1, 31), "雑費", 300, "x"),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.next_expected == date(2028, 2, 29)
+
+
+def test_december_rolls_over_to_next_year() -> None:
+    rows = [
+        E(date(2025, 10, 15), "保険", 2000, "生命"),
+        E(date(2025, 11, 15), "保険", 2000, "生命"),
+        E(date(2025, 12, 15), "保険", 2000, "生命"),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.next_expected == date(2026, 1, 15)
+
+
+def test_gap_in_months_uses_only_last_run_and_drops_short_run() -> None:
+    rows = [
+        E(date(2026, 1, 5), "娯楽", 1000, "配信"),
+        E(date(2026, 2, 5), "娯楽", 1000, "配信"),
+        E(date(2026, 4, 5), "娯楽", 1000, "配信"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_gap_keeps_last_run_when_long_enough() -> None:
+    rows = [
+        E(date(2026, 1, 5), "娯楽", 1000, "配信"),
+        E(date(2026, 2, 5), "娯楽", 1000, "配信"),
+        E(date(2026, 4, 5), "娯楽", 1000, "配信"),
+        E(date(2026, 5, 5), "娯楽", 1000, "配信"),
+        E(date(2026, 6, 5), "娯楽", 1000, "配信"),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.count == 3
+    assert r.last == date(2026, 6, 5)
+
+
+def test_same_month_duplicates_count_as_one() -> None:
+    rows = [
+        E(date(2026, 1, 3), "食費", 500, "コンビニ"),
+        E(date(2026, 1, 20), "食費", 500, "コンビニ"),
+        E(date(2026, 2, 3), "食費", 500, "コンビニ"),
+    ]
+    assert find_recurring(rows, min_count=3) == []
+    (r,) = find_recurring(rows, min_count=2)
+    assert r.count == 2
+
+
+def test_same_month_duplicate_uses_first_expense_amount() -> None:
+    rows = [
+        E(date(2026, 1, 20), "食費", 900, "定期"),
+        E(date(2026, 1, 3), "食費", 500, "定期"),
+        E(date(2026, 2, 3), "食費", 500, "定期"),
+        E(date(2026, 3, 3), "食費", 500, "定期"),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.count == 3
+    assert r.amount == 500
+
+
+def test_amount_jump_over_5_percent_is_excluded() -> None:
+    rows = [
+        E(date(2026, 1, 1), "水道", 1000, "水"),
+        E(date(2026, 2, 1), "水道", 1100, "水"),
+        E(date(2026, 3, 1), "水道", 1000, "水"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_amount_within_5_percent_is_included_and_amount_is_latest() -> None:
+    rows = [
+        E(date(2026, 1, 1), "水道", 1000, "水"),
+        E(date(2026, 2, 1), "水道", 1040, "水"),
+        E(date(2026, 3, 1), "水道", 1000, "水"),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.amount == 1000
+    assert r.count == 3
+
+
+def test_amount_exactly_5_percent_is_included() -> None:
+    rows = [
+        E(date(2026, 1, 1), "水道", 1000, "水"),
+        E(date(2026, 2, 1), "水道", 950, "水"),
+        E(date(2026, 3, 1), "水道", 1000, "水"),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_amount_just_over_5_percent_is_excluded() -> None:
+    rows = [
+        E(date(2026, 1, 1), "水道", 1000, "水"),
+        E(date(2026, 2, 1), "水道", 949, "水"),
+        E(date(2026, 3, 1), "水道", 1000, "水"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_memo_normalization_groups_fullwidth_case_and_spaces() -> None:
+    rows = [
+        E(date(2026, 1, 1), "通信", 3000, "  Ｓｍａｒｔ "),
+        E(date(2026, 2, 1), "通信", 3000, "smart"),
+        E(date(2026, 3, 1), "通信", 3000, "SMART"),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.memo == "SMART"
+    assert r.count == 3
+
+
+def test_different_category_is_separate_group() -> None:
+    rows = [
+        E(date(2026, 1, 1), "通信", 3000, "回線"),
+        E(date(2026, 2, 1), "雑費", 3000, "回線"),
+        E(date(2026, 3, 1), "通信", 3000, "回線"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_min_count_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+def test_input_list_is_not_mutated() -> None:
+    rows = [
+        E(date(2026, 3, 1), "水道", 1000, "水"),
+        E(date(2026, 1, 1), "水道", 1000, "水"),
+        E(date(2026, 2, 1), "水道", 1000, "水"),
+    ]
+    snapshot = list(rows)
+    find_recurring(rows)
+    assert rows == snapshot
+
+
+def test_output_sorted_by_next_expected_then_amount_desc_then_category_memo() -> None:
+    rows: list[Expense] = []
+    # A: next 2026-04-10, amount 500
+    for m in (1, 2, 3):
+        rows.append(E(date(2026, m, 10), "B", 500, "a"))
+    # B: next 2026-04-10, amount 900 (higher amount goes first)
+    for m in (1, 2, 3):
+        rows.append(E(date(2026, m, 10), "A", 900, "z"))
+    # C: next 2026-04-05 (earliest)
+    for m in (1, 2, 3):
+        rows.append(E(date(2026, m, 5), "C", 100, "c"))
+    # D: same next/amount as A but category tie-break
+    for m in (1, 2, 3):
+        rows.append(E(date(2026, m, 10), "B", 500, "b"))
+    result = find_recurring(rows)
+    assert [(r.next_expected, r.amount, r.category, r.memo) for r in result] == [
+        (date(2026, 4, 5), 100, "C", "c"),
+        (date(2026, 4, 10), 900, "A", "z"),
+        (date(2026, 4, 10), 500, "B", "a"),
+        (date(2026, 4, 10), 500, "B", "b"),
+    ]
diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..9b36234
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,246 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    all_of,
+    amount_between,
+    any_of,
+    category_is,
+    date_between,
+    memo_contains,
+    not_,
+    search,
+)
+
+
+def _e(day: date, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+ROWS = [
+    _e(date(2026, 2, 28), "食費", 1000, "ランチ"),
+    _e(date(2026, 3, 1), "食費", 999, "コーヒー"),
+    _e(date(2026, 3, 15), "交通費", 1000, "Bus Pass"),
+    _e(date(2026, 3, 31), "食費", 5000, "スーパー"),
+    _e(date(2026, 4, 1), "娯楽", 0, ""),
+]
+
+
+def _memos(rows: list[Expense]) -> list[str]:
+    return [e.memo for e in rows]
+
+
+# --- category_is ---
+
+
+def test_category_is_matches_any_listed_name() -> None:
+    assert _memos(search(ROWS, category_is("食費", "交通費"))) == [
+        "ランチ",
+        "コーヒー",
+        "Bus Pass",
+        "スーパー",
+    ]
+
+
+def test_category_is_no_names_never_matches() -> None:
+    assert search(ROWS, category_is()) == []
+
+
+def test_category_is_exact_not_substring() -> None:
+    assert search(ROWS, category_is("食")) == []
+
+
+def test_category_is_nfkc_normalizes() -> None:
+    rows = [_e(date(2026, 1, 1), "ｶﾌｪ", 300)]
+    assert search(rows, category_is("カフェ")) == rows
+
+
+# --- amount_between ---
+
+
+def test_amount_between_inclusive_both_ends() -> None:
+    assert [e.amount for e in search(ROWS, amount_between(999, 1000))] == [
+        1000,
+        999,
+        1000,
+    ]
+
+
+def test_amount_between_same_value_range() -> None:
+    assert [e.amount for e in search(ROWS, amount_between(1000, 1000))] == [1000, 1000]
+
+
+def test_amount_between_none_low_is_unbounded_below() -> None:
+    assert [e.amount for e in search(ROWS, amount_between(None, 999))] == [999, 0]
+
+
+def test_amount_between_none_high_is_unbounded_above() -> None:
+    assert [e.amount for e in search(ROWS, amount_between(1000, None))] == [
+        1000,
+        1000,
+        5000,
+    ]
+
+
+def test_amount_between_both_none_matches_all() -> None:
+    assert search(ROWS, amount_between()) == ROWS
+
+
+def test_amount_between_zero_included() -> None:
+    assert [e.amount for e in search(ROWS, amount_between(0, 0))] == [0]
+
+
+def test_amount_between_low_greater_than_high_raises() -> None:
+    with pytest.raises(ValueError):
+        amount_between(1001, 1000)
+
+
+# --- memo_contains ---
+
+
+def test_memo_contains_empty_text_always_matches() -> None:
+    assert search(ROWS, memo_contains("")) == ROWS
+    assert search(ROWS, memo_contains("", ignore_case=False)) == ROWS
+
+
+def test_memo_contains_substring() -> None:
+    assert _memos(search(ROWS, memo_contains("コーヒー"))) == ["コーヒー"]
+
+
+def test_memo_contains_ignore_case_default() -> None:
+    assert _memos(search(ROWS, memo_contains("bus"))) == ["Bus Pass"]
+    assert _memos(search(ROWS, memo_contains("BUS PASS"))) == ["Bus Pass"]
+
+
+def test_memo_contains_case_sensitive_when_disabled() -> None:
+    assert search(ROWS, memo_contains("bus", ignore_case=False)) == []
+    assert _memos(search(ROWS, memo_contains("Bus", ignore_case=False))) == ["Bus Pass"]
+
+
+def test_memo_contains_nfkc_fullwidth_halfwidth() -> None:
+    assert _memos(search(ROWS, memo_contains("ｺｰﾋｰ"))) == ["コーヒー"]
+    assert _memos(search(ROWS, memo_contains("ＢＵＳ"))) == ["Bus Pass"]
+
+
+def test_memo_contains_no_match() -> None:
+    assert search(ROWS, memo_contains("ビール")) == []
+
+
+def test_memo_contains_empty_memo_only_matches_empty_text() -> None:
+    rows = [_e(date(2026, 4, 1), "娯楽", 0, "")]
+    assert search(rows, memo_contains("a")) == []
+    assert search(rows, memo_contains("")) == rows
+
+
+# --- date_between ---
+
+
+def test_date_between_includes_both_ends() -> None:
+    got = search(ROWS, date_between(date(2026, 3, 1), date(2026, 3, 31)))
+    assert [e.day for e in got] == [
+        date(2026, 3, 1),
+        date(2026, 3, 15),
+        date(2026, 3, 31),
+    ]
+
+
+def test_date_between_excludes_outside_days() -> None:
+    got = search(ROWS, date_between(date(2026, 3, 1), date(2026, 3, 31)))
+    assert date(2026, 2, 28) not in [e.day for e in got]
+    assert date(2026, 4, 1) not in [e.day for e in got]
+
+
+def test_date_between_same_day() -> None:
+    got = search(ROWS, date_between(date(2026, 3, 15), date(2026, 3, 15)))
+    assert [e.day for e in got] == [date(2026, 3, 15)]
+
+
+def test_date_between_none_start_unbounded() -> None:
+    got = search(ROWS, date_between(None, date(2026, 3, 1)))
+    assert [e.day for e in got] == [date(2026, 2, 28), date(2026, 3, 1)]
+
+
+def test_date_between_none_end_unbounded() -> None:
+    got = search(ROWS, date_between(date(2026, 3, 31), None))
+    assert [e.day for e in got] == [date(2026, 3, 31), date(2026, 4, 1)]
+
+
+def test_date_between_both_none_matches_all() -> None:
+    assert search(ROWS, date_between()) == ROWS
+
+
+def test_date_between_start_after_end_raises() -> None:
+    with pytest.raises(ValueError):
+        date_between(date(2026, 3, 31), date(2026, 3, 1))
+
+
+# --- combinators ---
+
+
+def test_all_of_and_example() -> None:
+    got = search(ROWS, all_of(category_is("食費"), amount_between(1000, None)))
+    assert _memos(got) == ["ランチ", "スーパー"]
+
+
+def test_any_of_or_example() -> None:
+    got = search(ROWS, any_of(category_is("食費"), memo_contains("コーヒー")))
+    assert _memos(got) == ["ランチ", "コーヒー", "スーパー"]
+
+
+def test_all_of_no_args_always_true() -> None:
+    assert search(ROWS, all_of()) == ROWS
+
+
+def test_any_of_no_args_always_false() -> None:
+    assert search(ROWS, any_of()) == []
+
+
+def test_not_negates() -> None:
+    got = search(ROWS, not_(category_is("食費")))
+    assert _memos(got) == ["Bus Pass", ""]
+
+
+def test_not_of_all_of_no_args_is_false() -> None:
+    assert search(ROWS, not_(all_of())) == []
+
+
+def test_nested_and_or_not() -> None:
+    pred = all_of(
+        any_of(category_is("食費"), category_is("交通費")),
+        not_(any_of(memo_contains("ランチ"), amount_between(5000, None))),
+    )
+    assert _memos(search(ROWS, pred)) == ["コーヒー", "Bus Pass"]
+
+
+def test_nested_any_of_inside_not_inside_all_of_with_empty_any() -> None:
+    pred = all_of(not_(any_of()), category_is("娯楽"))
+    assert _memos(search(ROWS, pred)) == [""]
+
+
+# --- search ---
+
+
+def test_search_preserves_input_order() -> None:
+    got = search(ROWS, amount_between(1000, 1000))
+    assert _memos(got) == ["ランチ", "Bus Pass"]
+
+
+def test_search_returns_new_list_and_does_not_mutate_input() -> None:
+    rows = list(ROWS)
+    snapshot = list(rows)
+    got = search(rows, all_of())
+    assert got == rows
+    assert got is not rows
+    assert rows == snapshot
+
+
+def test_search_empty_input() -> None:
+    assert search([], all_of()) == []
+
+
+def test_search_result_is_empty_list_when_nothing_matches() -> None:
+    assert search(ROWS, category_is("存在しない")) == []
