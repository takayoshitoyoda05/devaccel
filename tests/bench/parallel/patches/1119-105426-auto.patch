@@ -0,0 +1,144 @@
+"""Import bank / card CSV text into Expense records (pure: no file IO)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+
+
+_DATE_ALIASES = ("date", "日付", "利用日", "取引日", "ご利用日")
+_AMOUNT_ALIASES = ("amount", "金額", "利用金額", "支払金額", "出金額", "お支払金額")
+_MEMO_ALIASES = ("memo", "摘要", "内容", "利用先", "ご利用店名", "備考", "description")
+_CATEGORY_ALIASES = ("category", "カテゴリ", "分類")
+
+_KIND_BY_ALIAS: dict[str, str] = {}
+for _kind, _aliases in (
+    ("date", _DATE_ALIASES),
+    ("amount", _AMOUNT_ALIASES),
+    ("memo", _MEMO_ALIASES),
+    ("category", _CATEGORY_ALIASES),
+):
+    for _alias in _aliases:
+        _KIND_BY_ALIAS[_alias.casefold()] = _kind
+
+_DATE_PATTERNS = (
+    re.compile(r"([0-9]{4})-([0-9]{2})-([0-9]{2})"),
+    re.compile(r"([0-9]{4})/([0-9]{1,2})/([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日"),
+    re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})"),
+)
+_DECIMAL_RE = re.compile(r"[0-9]*\.[0-9]*")
+_DIGITS_RE = re.compile(r"[0-9]+")
+
+
+class _RowProblem(Exception):
+    """A row-level problem; the message is the Japanese reason."""
+
+
+def _parse_date(raw: str) -> date:
+    text = raw.strip()
+    if text == "":
+        raise _RowProblem("日付が空です")
+    norm = unicodedata.normalize("NFKC", text).strip()
+    for pattern in _DATE_PATTERNS:
+        m = pattern.fullmatch(norm)
+        if m is not None:
+            try:
+                return date(int(m.group(1)), int(m.group(2)), int(m.group(3)))
+            except ValueError:
+                break
+    raise _RowProblem(f"日付が不正です: {text!r}")
+
+
+def _parse_amount(raw: str) -> int:
+    text = raw.strip()
+    if text == "":
+        raise _RowProblem("金額が空です")
+    s = unicodedata.normalize("NFKC", text).strip()
+    negative = False
+    if s[0] in "△▲-":
+        negative = True
+        s = s[1:]
+    elif s.endswith("-"):
+        negative = True
+        s = s[:-1]
+    if s.startswith(("¥", "円")):
+        s = s[1:]
+    s = s.replace(",", "")
+    if _DECIMAL_RE.fullmatch(s):
+        raise _RowProblem(f"金額が整数ではありません: {text!r}")
+    if not _DIGITS_RE.fullmatch(s):
+        raise _RowProblem(f"金額が不正です: {text!r}")
+    value = int(s)
+    return -value if negative else value
+
+
+def _resolve_columns(header: list[str]) -> dict[str, int]:
+    """Map kind ("date", "amount", "memo", "category") to the first matching column."""
+    found: dict[str, int] = {}
+    for index, name in enumerate(header):
+        kind = _KIND_BY_ALIAS.get(name.strip().casefold())
+        if kind is not None and kind not in found:
+            found[kind] = index
+    missing = [
+        label
+        for kind, label in (("date", "日付"), ("amount", "金額"))
+        if kind not in found
+    ]
+    if missing:
+        raise ValueError(f"必須列がありません: {', '.join(missing)}")
+    return found
+
+
+def _cell(row: list[str], index: int | None) -> str:
+    if index is None or index >= len(row):
+        return ""
+    return row[index].strip()
+
+
+def parse_bank_csv(text: str, default_category: str = "未分類") -> ImportResult:
+    if text.strip() == "":
+        raise ValueError("CSV が空です")
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header = next(reader)
+    columns = _resolve_columns(header)
+    memo_index = columns.get("memo")
+    category_index = columns.get("category")
+
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    line = reader.line_num  # last physical line consumed so far (the header)
+    for row in reader:
+        start_line = (
+            line + 1
+        )  # a record begins on the line after the previous one ended
+        line = reader.line_num
+        if all(cell.strip() == "" for cell in row):
+            continue
+        try:
+            day = _parse_date(_cell(row, columns["date"]))
+            amount = _parse_amount(_cell(row, columns["amount"]))
+        except _RowProblem as e:
+            errors.append(RowError(start_line, str(e)))
+            continue
+        category = _cell(row, category_index) or default_category
+        expenses.append(Expense(day, category, amount, _cell(row, memo_index)))
+    return ImportResult(expenses=expenses, errors=errors)
