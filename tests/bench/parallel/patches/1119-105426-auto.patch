@@ -0,0 +1,105 @@
+"""Filter expense records with composable predicates (pure functions)."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable
+from datetime import date
+
+from kakeibo.core import Expense
+
+Predicate = Callable[[Expense], bool]
+
+
+def _nfkc(text: str) -> str:
+    return unicodedata.normalize("NFKC", text)
+
+
+def category_is(*names: str) -> Predicate:
+    """Match if the category equals any of ``names`` (NFKC-compared). No names -> never matches."""
+    wanted = frozenset(_nfkc(n) for n in names)
+
+    def pred(e: Expense) -> bool:
+        return _nfkc(e.category) in wanted
+
+    return pred
+
+
+def amount_between(low: int | None = None, high: int | None = None) -> Predicate:
+    """Match if low <= amount <= high (both inclusive). None means unbounded."""
+    if low is not None and high is not None and low > high:
+        raise ValueError(f"low ({low}) は high ({high}) 以下である必要があります")
+
+    def pred(e: Expense) -> bool:
+        if low is not None and e.amount < low:
+            return False
+        return not (high is not None and e.amount > high)
+
+    return pred
+
+
+def memo_contains(text: str, *, ignore_case: bool = True) -> Predicate:
+    """Match if the memo contains ``text`` (NFKC-compared; case-folded unless ignore_case=False).
+
+    An empty ``text`` always matches.
+    """
+    needle = _nfkc(text)
+    if ignore_case:
+        needle = needle.casefold()
+
+    def pred(e: Expense) -> bool:
+        if needle == "":
+            return True
+        hay = _nfkc(e.memo)
+        if ignore_case:
+            hay = hay.casefold()
+        return needle in hay
+
+    return pred
+
+
+def date_between(start: date | None = None, end: date | None = None) -> Predicate:
+    """Match if start <= day <= end (both inclusive). None means unbounded."""
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"start ({start}) は end ({end}) 以前である必要があります")
+
+    def pred(e: Expense) -> bool:
+        if start is not None and e.day < start:
+            return False
+        return not (end is not None and e.day > end)
+
+    return pred
+
+
+def all_of(*preds: Predicate) -> Predicate:
+    """AND of predicates. No arguments -> always True."""
+    items = tuple(preds)
+
+    def pred(e: Expense) -> bool:
+        return all(p(e) for p in items)
+
+    return pred
+
+
+def any_of(*preds: Predicate) -> Predicate:
+    """OR of predicates. No arguments -> always False."""
+    items = tuple(preds)
+
+    def pred(e: Expense) -> bool:
+        return any(p(e) for p in items)
+
+    return pred
+
+
+def not_(pred: Predicate) -> Predicate:
+    """Negate a predicate."""
+
+    def negated(e: Expense) -> bool:
+        return not pred(e)
+
+    return negated
+
+
+def search(rows: list[Expense], pred: Predicate) -> list[Expense]:
+    """Return a new list of rows matching ``pred``, preserving input order."""
+    return [e for e in rows if pred(e)]
