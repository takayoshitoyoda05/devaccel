+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankcsv import ImportResult, RowError, parse_bank_csv
+from kakeibo.core import Expense
+
+
+def test_spec_example_parses_row() -> None:
+    result = parse_bank_csv('利用日,ご利用店名,利用金額\n2026/03/05,スーパー,"1,280"')
+    assert result == ImportResult(
+        expenses=[Expense(date(2026, 3, 5), "未分類", 1280, "スーパー")],
+        errors=[],
+    )
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        ("△500", -500),
+        ("▲500", -500),
+        ("-500", -500),
+        ("500-", -500),
+        ("¥3,000", 3000),
+        ("円3,000", 3000),
+        ("-¥3,000", -3000),
+        ("０", 0),
+        ("１，２８０", 1280),
+        ("0", 0),
+    ],
+)
+def test_amount_forms(raw: str, expected: int) -> None:
+    result = parse_bank_csv(f'日付,金額\n2026-01-01,"{raw}"')
+    assert result.errors == []
+    assert [e.amount for e in result.expenses] == [expected]
+    assert type(result.expenses[0].amount) is int
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-03-05",
+        "2026/3/5",
+        "2026年3月5日",
+        "20260305",
+        "２０２６／３／５",
+        "２０２６-03-05",
+    ],
+)
+def test_date_forms(raw: str) -> None:
+    result = parse_bank_csv(f"日付,金額\n{raw},100")
+    assert result.errors == []
+    assert result.expenses[0].day == date(2026, 3, 5)
+
+
+def test_invalid_calendar_date_is_row_error() -> None:
+    result = parse_bank_csv("日付,金額\n2026/02/30,100")
+    assert result.expenses == []
+    assert len(result.errors) == 1
+    assert result.errors[0].line == 2
+    assert result.errors[0].reason.startswith("日付が不正です")
+
+
+def test_unknown_date_format_is_row_error() -> None:
+    result = parse_bank_csv("日付,金額\n2026/13/01,100")
+    assert result.errors == [RowError(2, "日付が不正です: '2026/13/01'")]
+
+
+def test_decimal_amount_is_row_error() -> None:
+    result = parse_bank_csv("日付,金額\n2026-01-01,12.5")
+    assert result.errors == [RowError(2, "金額が整数ではありません: '12.5'")]
+
+
+def test_non_numeric_amount_is_row_error() -> None:
+    result = parse_bank_csv("日付,金額\n2026-01-01,abc")
+    assert len(result.errors) == 1
+    assert result.errors[0].line == 2
+    assert "金額" in result.errors[0].reason
+
+
+def test_good_and_bad_rows_mixed_keep_physical_line_numbers() -> None:
+    text = "日付,金額,摘要\n2026-01-01,100,a\n\n2026-13-01,200,b\n2026-01-03,300,c\n"
+    result = parse_bank_csv(text)
+    assert [e.amount for e in result.expenses] == [100, 300]
+    assert [e.memo for e in result.expenses] == ["a", "c"]
+    assert [(r.line, r.reason) for r in result.errors] == [
+        (4, "日付が不正です: '2026-13-01'")
+    ]
+
+
+def test_fully_blank_rows_are_ignored() -> None:
+    result = parse_bank_csv("日付,金額\n\n2026-01-01,100\n\n")
+    assert result.errors == []
+    assert len(result.expenses) == 1
+
+
+def test_one_bad_cell_per_row_reports_first_problem_only() -> None:
+    result = parse_bank_csv("日付,金額\n2026-02-30,12.5")
+    assert len(result.errors) == 1
+    assert result.errors[0].reason.startswith("日付が不正です")
+
+
+def test_expenses_keep_input_order() -> None:
+    text = "日付,金額\n2026-03-01,3\n2026-01-01,1\n2026-02-01,2"
+    result = parse_bank_csv(text)
+    assert [e.amount for e in result.expenses] == [3, 1, 2]
+
+
+def test_header_aliases_are_stripped_and_casefolded() -> None:
+    result = parse_bank_csv(" Date , AMOUNT ,Memo\n2026-01-01,50,x")
+    assert result.expenses == [Expense(date(2026, 1, 1), "未分類", 50, "x")]
+
+
+def test_category_column_is_used_and_default_otherwise() -> None:
+    result = parse_bank_csv("日付,金額,カテゴリ\n2026-01-01,50,食費")
+    assert result.expenses[0].category == "食費"
+    result = parse_bank_csv("日付,金額\n2026-01-01,50", default_category="雑費")
+    assert result.expenses[0].category == "雑費"
+
+
+def test_memo_column_missing_gives_empty_memo() -> None:
+    result = parse_bank_csv("日付,金額\n2026-01-01,50")
+    assert result.expenses[0].memo == ""
+
+
+def test_quoted_multiline_field_reports_record_start_line() -> None:
+    text = '日付,金額,摘要\n2026-01-01,100,"a\nb"\n2026-13-01,5,c'
+    result = parse_bank_csv(text)
+    assert [e.amount for e in result.expenses] == [100]
+    assert [r.line for r in result.errors] == [4]
+
+
+def test_missing_date_column_raises() -> None:
+    with pytest.raises(ValueError, match="必須列がありません: 日付"):
+        parse_bank_csv("金額,摘要\n100,a")
+
+
+def test_missing_amount_column_raises() -> None:
+    with pytest.raises(ValueError, match="必須列がありません: 金額"):
+        parse_bank_csv("日付,摘要\n2026-01-01,a")
+
+
+def test_missing_both_columns_lists_both() -> None:
+    with pytest.raises(ValueError, match="日付.*金額"):
+        parse_bank_csv("摘要,カテゴリ\na,b")
+
+
+@pytest.mark.parametrize("text", ["", "   \n  "])
+def test_empty_text_raises(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_bank_csv(text)
diff --git a/tests/test_monthly_diff.py b/tests/test_monthly_diff.py
new file mode 100644
index 0000000..be3f194
--- /dev/null
+++ b/tests/test_monthly_diff.py
@@ -0,0 +1,136 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthly_diff import CategoryDiff, compare_months, format_diff_report
+
+
+def e(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+def test_example_increase() -> None:
+    rows = [e("2026-02-10", "食費", 30000), e("2026-03-05", "食費", 35000)]
+    assert compare_months(rows, "2026-03") == [
+        CategoryDiff("食費", 30000, 35000, 5000, "増")
+    ]
+
+
+def test_decrease_status() -> None:
+    rows = [e("2026-02-01", "光熱費", 5000), e("2026-03-01", "光熱費", 3000)]
+    assert compare_months(rows, "2026-03") == [
+        CategoryDiff("光熱費", 5000, 3000, -2000, "減")
+    ]
+
+
+def test_unchanged_status() -> None:
+    rows = [e("2026-02-01", "食費", 4000), e("2026-03-01", "食費", 4000)]
+    assert compare_months(rows, "2026-03") == [
+        CategoryDiff("食費", 4000, 4000, 0, "変わらず")
+    ]
+
+
+def test_new_status_when_previous_zero_and_current_positive() -> None:
+    rows = [e("2026-03-01", "娯楽", 1500)]
+    assert compare_months(rows, "2026-03") == [
+        CategoryDiff("娯楽", 0, 1500, 1500, "新規")
+    ]
+
+
+def test_gone_status_when_previous_positive_and_current_zero() -> None:
+    rows = [e("2026-02-01", "交通", 2000)]
+    assert compare_months(rows, "2026-03") == [
+        CategoryDiff("交通", 2000, 0, -2000, "なし")
+    ]
+
+
+def test_category_absent_in_both_months_is_omitted() -> None:
+    rows = [e("2026-01-01", "食費", 100), e("2026-03-01", "食費", 100)]
+    result = compare_months(rows, "2026-03")
+    assert [d.category for d in result] == ["食費"]
+
+
+def test_sorted_by_abs_delta_desc_then_category_asc() -> None:
+    rows = [
+        e("2026-02-01", "A", 1000),
+        e("2026-03-01", "A", 1000),  # delta 0
+        e("2026-02-01", "B", 0),
+        e("2026-03-01", "B", 3000),  # delta +3000
+        e("2026-02-01", "C", 5000),
+        e("2026-03-01", "C", 2000),  # delta -3000 (same abs as B)
+        e("2026-02-01", "D", 500),
+        e("2026-03-01", "D", 9000),  # delta +8500
+    ]
+    result = compare_months(rows, "2026-03")
+    assert [d.category for d in result] == ["D", "B", "C", "A"]
+
+
+def test_same_abs_delta_sorts_by_category() -> None:
+    rows = [
+        e("2026-02-01", "ZZ", 1000),
+        e("2026-03-01", "ZZ", 2000),
+        e("2026-02-01", "AA", 3000),
+        e("2026-03-01", "AA", 2000),
+    ]
+    result = compare_months(rows, "2026-03")
+    assert [d.category for d in result] == ["AA", "ZZ"]
+
+
+def test_january_compares_with_previous_december() -> None:
+    rows = [
+        e("2025-12-20", "食費", 40000),
+        e("2026-01-03", "食費", 42000),
+        e("2026-02-03", "食費", 99999),  # must be ignored
+    ]
+    assert compare_months(rows, "2026-01") == [
+        CategoryDiff("食費", 40000, 42000, 2000, "増")
+    ]
+
+
+@pytest.mark.parametrize(
+    "bad",
+    ["2026-3", "2026-00", "2026-13", "202603", "2026/03", "", "abcd-ef", "2026-03-01"],
+)
+def test_invalid_month_raises(bad: str) -> None:
+    with pytest.raises(ValueError):
+        compare_months([], bad)
+
+
+def test_no_rows_for_month_returns_empty() -> None:
+    rows = [e("2026-01-01", "食費", 100)]
+    assert compare_months(rows, "2026-03") == []
+
+
+def test_empty_rows_returns_empty() -> None:
+    assert compare_months([], "2026-03") == []
+
+
+def test_format_increase_decrease_unchanged_new_gone() -> None:
+    diffs = [
+        CategoryDiff("食費", 30000, 35000, 5000, "増"),
+        CategoryDiff("光熱費", 5000, 3000, -2000, "減"),
+        CategoryDiff("食費2", 4000, 4000, 0, "変わらず"),
+        CategoryDiff("娯楽", 0, 1500, 1500, "新規"),
+        CategoryDiff("交通", 2000, 0, -2000, "なし"),
+    ]
+    lines = [
+        "食費: 30000円 → 35000円 (+5000円 増)",
+        "光熱費: 5000円 → 3000円 (-2000円 減)",
+        "食費2: 4000円 → 4000円 (±0円 変わらず)",
+        "娯楽: 0円 → 1500円 (+1500円 新規)",
+        "交通: 2000円 → 0円 (-2000円 なし)",
+    ]
+    expected = "\n".join(lines)
+    assert format_diff_report(diffs) == expected
+
+
+def test_format_empty_list() -> None:
+    assert format_diff_report([]) == "差分なし"
+
+
+def test_format_has_no_trailing_newline() -> None:
+    out = format_diff_report([CategoryDiff("食費", 1, 2, 1, "増")])
+    assert not out.endswith("\n")
