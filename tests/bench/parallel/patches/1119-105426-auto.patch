@@ -0,0 +1,82 @@
+"""Detect recurring expenses and predict their next occurrence."""
+
+from __future__ import annotations
+
+import unicodedata
+from calendar import monthrange
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int
+    last: date
+    next_expected: date
+    count: int
+
+
+def _group_key(e: Expense) -> tuple[str, str]:
+    return (e.category, unicodedata.normalize("NFKC", e.memo).strip().casefold())
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month - 1
+
+
+def _next_month_same_day(d: date) -> date:
+    year, month = (d.year, d.month + 1) if d.month < 12 else (d.year + 1, 1)
+    day = min(d.day, monthrange(year, month)[1])
+    return date(year, month, day)
+
+
+def find_recurring(rows: list[Expense], min_count: int = 3) -> list[Recurring]:
+    """Return expenses that repeat monthly in the latest unbroken month run.
+
+    Expenses are grouped by (category, memo normalized with NFKC/strip/casefold).
+    Within a group only the first expense of each month is used. The last run of
+    consecutive months must have at least ``min_count`` entries, and its amounts
+    must be all equal or differ by at most 5% of the maximum.
+    """
+    if min_count < 2:
+        raise ValueError("min_count は 2 以上である必要があります")
+
+    groups: dict[tuple[str, str], dict[int, Expense]] = {}
+    # sorted() is stable, so for the same day the input order is kept.
+    for e in sorted(rows, key=lambda e: e.day):
+        by_month = groups.setdefault(_group_key(e), {})
+        by_month.setdefault(_month_index(e.day), e)
+
+    result: list[Recurring] = []
+    for by_month in groups.values():
+        idxs = sorted(by_month)
+        start = len(idxs) - 1
+        while start > 0 and idxs[start - 1] == idxs[start] - 1:
+            start -= 1
+        run = [by_month[i] for i in idxs[start:]]
+        if len(run) < min_count:
+            continue
+
+        amounts = [e.amount for e in run]
+        lo, hi = min(amounts), max(amounts)
+        if lo != hi and (hi - lo) * 100 > 5 * hi:
+            continue
+
+        latest = run[-1]
+        result.append(
+            Recurring(
+                category=latest.category,
+                memo=latest.memo.strip(),
+                amount=latest.amount,
+                last=latest.day,
+                next_expected=_next_month_same_day(latest.day),
+                count=len(run),
+            )
+        )
+
+    result.sort(key=lambda r: (r.next_expected, -r.amount, r.category, r.memo))
+    return result
