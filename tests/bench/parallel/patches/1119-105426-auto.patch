@@ -0,0 +1,84 @@
+"""Month-over-month comparison of category totals (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"([0-9]{4})-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryDiff:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    status: str
+
+
+def _parse_month(month: str) -> tuple[int, int]:
+    m = _MONTH_RE.fullmatch(month)
+    if m is None:
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+    return int(m.group(1)), int(m.group(2))
+
+
+def _previous_month(year: int, mon: int) -> tuple[int, int]:
+    if mon == 1:
+        return year - 1, 12
+    return year, mon - 1
+
+
+def _totals(rows: list[Expense], year: int, mon: int) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for e in rows:
+        if e.day.year == year and e.day.month == mon:
+            out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def _status(previous: int, current: int, delta: int) -> str:
+    if previous == 0 and current > 0:
+        return "新規"
+    if previous > 0 and current == 0:
+        return "なし"
+    if delta > 0:
+        return "増"
+    if delta < 0:
+        return "減"
+    return "変わらず"
+
+
+def compare_months(rows: list[Expense], month: str) -> list[CategoryDiff]:
+    year, mon = _parse_month(month)
+    prev_year, prev_mon = _previous_month(year, mon)
+    cur = _totals(rows, year, mon)
+    prev = _totals(rows, prev_year, prev_mon)
+
+    diffs: list[CategoryDiff] = []
+    for category in set(cur) | set(prev):
+        previous = prev.get(category, 0)
+        current = cur.get(category, 0)
+        delta = current - previous
+        diffs.append(
+            CategoryDiff(
+                category, previous, current, delta, _status(previous, current, delta)
+            )
+        )
+    diffs.sort(key=lambda d: (-abs(d.delta), d.category))
+    return diffs
+
+
+def format_diff_report(diffs: list[CategoryDiff]) -> str:
+    if not diffs:
+        return "差分なし"
+    lines: list[str] = []
+    for d in diffs:
+        delta_txt = "±0" if d.delta == 0 else f"{d.delta:+d}"
+        lines.append(
+            f"{d.category}: {d.previous}円 → {d.current}円 ({delta_txt}円 {d.status})"
+        )
+    return "\n".join(lines)
