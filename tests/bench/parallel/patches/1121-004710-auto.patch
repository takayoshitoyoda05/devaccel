+"""Budget alerts: flag categories that are over, or close to, their monthly budget.
+
+Pure functions over the existing types: `monthly_totals()` output and `Budget`
+(`Budget.for_month` already merges default and per-month limits; reused as is).
+
+Decisions:
+D1: Only months present in `totals` are checked. A month with no data is not
+    reported (no spending means nothing to warn about); no gap-filling.
+D2: Only categories that have a limit for that month are checked. Spending in a
+    category without a budget is ignored; a budgeted category with no spending
+    that month is not reported.
+D3: "Over" is strictly actual > limit. actual == limit is a warning, not over.
+D4: "Warn" is actual * 100 >= limit * warn_percent (integer arithmetic, no
+    floats) while not over. Default warn_percent is 80.
+D5: limit == 0: any positive spending is over; zero spending is OK (not warn).
+D6: Non-positive actual (zero, or net refunds) is always OK and never reported.
+D7: warn_percent must satisfy 0 < warn_percent <= 100, otherwise ValueError.
+D8: Only non-OK alerts are returned. Order: month ascending, then over before
+    warn, then the smaller remaining (larger overspend) first, then category name.
+D9: No projection from the day of the month; the threshold is the only "about
+    to exceed" signal.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Literal
+
+from kakeibo.core import Budget
+
+Status = Literal["over", "warn"]
+
+
+@dataclass(frozen=True)
+class Alert:
+    month: str
+    category: str
+    limit: int  # yen
+    actual: int  # yen
+    status: Status
+
+    @property
+    def remaining(self) -> int:
+        """limit - actual; negative when over."""
+        return self.limit - self.actual
+
+
+def classify(
+    actual: int, limit: int, warn_percent: int = 80
+) -> Literal["ok", "warn", "over"]:
+    """Status of one category's spending against its limit."""
+    _check_percent(warn_percent)
+    if actual > limit:
+        return "over"
+    if actual > 0 and actual * 100 >= limit * warn_percent:
+        return "warn"
+    return "ok"
+
+
+def budget_alerts(
+    totals: dict[str, dict[str, int]], budget: Budget, warn_percent: int = 80
+) -> list[Alert]:
+    """Alerts for every (month, category) that is over or near its budget."""
+    _check_percent(warn_percent)
+    out: list[Alert] = []
+    for month, cats in totals.items():
+        limits = budget.for_month(month)
+        for cat, actual in cats.items():
+            if cat not in limits:
+                continue
+            status = classify(actual, limits[cat], warn_percent)
+            if status != "ok":
+                out.append(Alert(month, cat, limits[cat], actual, status))
+    out.sort(key=lambda a: (a.month, a.status != "over", a.remaining, a.category))
+    return out
+
+
+def _check_percent(warn_percent: int) -> None:
+    if not 0 < warn_percent <= 100:
+        raise ValueError(f"warn_percent は 1〜100 である必要があります: {warn_percent}")
diff --git a/tests/test_budget_alert.py b/tests/test_budget_alert.py
new file mode 100644
index 0000000..7aecb8c
--- /dev/null
+++ b/tests/test_budget_alert.py
@@ -0,0 +1,99 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.budget_alert import Alert, budget_alerts, classify
+from kakeibo.core import Budget, Expense, monthly_totals
+
+
+def test_over_warn_ok():
+    b = Budget({"食費": 1000, "交通": 1000, "趣味": 1000}, {})
+    totals = {"2026-01": {"食費": 1001, "交通": 800, "趣味": 799}}
+    got = budget_alerts(totals, b)
+    assert got == [
+        Alert("2026-01", "食費", 1000, 1001, "over"),
+        Alert("2026-01", "交通", 1000, 800, "warn"),
+    ]
+    assert got[0].remaining == -1 and got[1].remaining == 200
+
+
+def test_exactly_at_limit_is_warn_not_over():  # D3
+    assert classify(1000, 1000) == "warn"
+    assert classify(1001, 1000) == "over"
+
+
+def test_warn_boundary_integer():  # D4
+    assert classify(80, 100) == "warn"
+    assert classify(79, 100) == "ok"
+    assert classify(50, 100, warn_percent=50) == "warn"
+    assert classify(7, 9, warn_percent=77) == "warn"  # 700 >= 693
+
+
+def test_zero_limit():  # D5
+    assert classify(1, 0) == "over"
+    assert classify(0, 0) == "ok"
+
+
+def test_non_positive_actual_ok():  # D6
+    assert classify(0, 1000) == "ok"
+    assert classify(-500, 1000) == "ok"
+    assert classify(-500, 0) == "ok"
+
+
+def test_invalid_warn_percent():  # D7
+    for p in (0, -1, 101):
+        with pytest.raises(ValueError):
+            classify(1, 10, p)
+        with pytest.raises(ValueError):
+            budget_alerts({}, Budget({}, {}), p)
+
+
+def test_gap_months_not_filled():  # D1
+    b = Budget({"食費": 100}, {})
+    totals = {"2026-01": {"食費": 150}, "2026-03": {"食費": 90}}
+    assert [(a.month, a.status) for a in budget_alerts(totals, b)] == [
+        ("2026-01", "over"),
+        ("2026-03", "warn"),
+    ]
+
+
+def test_unbudgeted_and_missing_categories_ignored():  # D2
+    b = Budget({"食費": 100, "交通": 100}, {})
+    assert budget_alerts({"2026-01": {"趣味": 99999}}, b) == []
+
+
+def test_month_override_limit():
+    b = Budget({"食費": 1000}, {"2026-02": {"食費": 100}})
+    totals = {"2026-01": {"食費": 500}, "2026-02": {"食費": 500}}
+    assert [(a.month, a.limit, a.status) for a in budget_alerts(totals, b)] == [
+        ("2026-02", 100, "over")
+    ]
+
+
+def test_ordering():  # D8
+    b = Budget({"a": 100, "b": 100, "c": 100, "d": 100}, {})
+    totals = {
+        "2026-02": {"a": 90},
+        "2026-01": {"d": 85, "c": 120, "b": 150, "a": 150},
+    }
+    assert [(a.month, a.category) for a in budget_alerts(totals, b)] == [
+        ("2026-01", "a"),  # over by 50, name tie-break
+        ("2026-01", "b"),
+        ("2026-01", "c"),
+        ("2026-01", "d"),
+        ("2026-02", "a"),
+    ]
+
+
+def test_empty():
+    assert budget_alerts({}, Budget({}, {})) == []
+
+
+def test_with_monthly_totals():
+    rows = [
+        Expense(date(2026, 1, 3), "食費", 600),
+        Expense(date(2026, 1, 20), "食費", 300),
+        Expense(date(2026, 1, 21), "食費", -50),  # refund
+    ]
+    got = budget_alerts(monthly_totals(rows), Budget({"食費": 1000}, {}))
+    assert got == [Alert("2026-01", "食費", 1000, 850, "warn")]
