+"""Month-over-month comparison of per-category spending (pure functions).
+
+Input is the shape returned by ``core.monthly_totals``:
+``{"YYYY-MM": {category: yen}}``. Nothing here does I/O.
+
+Decisions:
+D1: The previous month is the calendar-previous month (2026-01 -> 2025-12).
+    If that month is absent from the input, it counts as an empty month; the
+    previous *existing* month is never substituted.
+D2: The earliest month has no data before it, so it is compared with an empty
+    month: every category is "new".
+D3: Status is by presence of the category key, not by amount.
+    "new" = only in current, "gone" = only in previous,
+    "up"/"down"/"same" = in both, by sign of delta. A category present with
+    amount 0 (or a net 0) still counts as present.
+D4: ``rate`` = delta / previous (a ratio, 0.25 = +25%). It is None when previous
+    <= 0 (division by zero, or a refund-dominated negative base) and for
+    "new"/"gone" categories.
+D5: Negative amounts (refunds) are accepted and summed as given.
+D6: Months ascending. Within a month, categories by |delta| descending, ties
+    by category name ascending (stable and deterministic).
+D7: Empty input gives an empty list; a month with no categories is kept
+    (all previous categories become "gone").
+D8: A month key that is not ``YYYY-MM`` (month 01-12) raises ValueError.
+"""
+
+from __future__ import annotations
+
+import re
+from collections.abc import Mapping
+from dataclasses import dataclass
+from typing import Literal
+
+from kakeibo.core import Expense, monthly_totals
+
+Status = Literal["new", "gone", "up", "down", "same"]
+
+_MONTH_RE = re.compile(r"([0-9]{4})-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryDiff:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    rate: float | None
+    status: Status
+
+
+@dataclass(frozen=True)
+class MonthDiff:
+    month: str
+    previous_month: str
+    diffs: list[CategoryDiff]
+
+
+def previous_month(month: str) -> str:
+    """Calendar-previous month of ``YYYY-MM``."""
+    m = _MONTH_RE.fullmatch(month)
+    if m is None:
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+    year, mon = int(m.group(1)), int(m.group(2))
+    if mon == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mon - 1:02d}"
+
+
+def diff_categories(
+    previous: Mapping[str, int], current: Mapping[str, int]
+) -> list[CategoryDiff]:
+    """Compare two months' category totals."""
+    out: list[CategoryDiff] = []
+    for cat in previous.keys() | current.keys():
+        in_prev, in_cur = cat in previous, cat in current
+        prev = previous.get(cat, 0)
+        cur = current.get(cat, 0)
+        delta = cur - prev
+        status: Status
+        if not in_prev:
+            status = "new"
+        elif not in_cur:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        rate = delta / prev if in_prev and in_cur and prev > 0 else None
+        out.append(CategoryDiff(cat, prev, cur, delta, rate, status))
+    out.sort(key=lambda d: (-abs(d.delta), d.category))
+    return out
+
+
+def compare_months(totals: Mapping[str, Mapping[str, int]]) -> list[MonthDiff]:
+    """Month-over-month diffs for every month in ``totals``, ascending."""
+    for month in totals:
+        previous_month(month)  # validates the key (D8)
+    result: list[MonthDiff] = []
+    for month in sorted(totals):
+        prev = previous_month(month)
+        result.append(
+            MonthDiff(month, prev, diff_categories(totals.get(prev, {}), totals[month]))
+        )
+    return result
+
+
+def compare_expenses(rows: list[Expense]) -> list[MonthDiff]:
+    """Convenience: aggregate ``rows`` by month, then compare."""
+    return compare_months(monthly_totals(rows))
diff --git a/tests/test_monthly_diff.py b/tests/test_monthly_diff.py
new file mode 100644
index 0000000..6150665
--- /dev/null
+++ b/tests/test_monthly_diff.py
@@ -0,0 +1,118 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthly_diff import (
+    CategoryDiff,
+    compare_expenses,
+    compare_months,
+    diff_categories,
+    previous_month,
+)
+
+
+def by_cat(diffs: list[CategoryDiff]) -> dict[str, CategoryDiff]:
+    return {d.category: d for d in diffs}
+
+
+def test_statuses_up_down_same_new_gone():
+    d = by_cat(
+        diff_categories(
+            {"food": 1000, "rent": 5000, "fun": 800, "old": 300},
+            {"food": 1500, "rent": 5000, "fun": 200, "fresh": 400},
+        )
+    )
+    assert d["food"].status == "up" and d["food"].delta == 500
+    assert d["food"].rate == 0.5
+    assert d["fun"].status == "down" and d["fun"].delta == -600
+    assert d["fun"].rate == -0.75
+    assert d["rent"].status == "same" and d["rent"].delta == 0
+    assert d["rent"].rate == 0.0
+    assert d["fresh"].status == "new" and d["fresh"].delta == 400
+    assert d["fresh"].rate is None
+    assert d["old"].status == "gone" and d["old"].delta == -300
+    assert d["old"].current == 0 and d["old"].rate is None
+
+
+def test_zero_previous_present_has_no_rate():
+    d = by_cat(diff_categories({"a": 0}, {"a": 100}))["a"]
+    assert d.status == "up" and d.rate is None
+
+
+def test_zero_amount_present_is_not_new_or_gone():
+    assert by_cat(diff_categories({"a": 0}, {}))["a"].status == "gone"
+    assert by_cat(diff_categories({}, {"a": 0}))["a"].status == "new"
+    assert by_cat(diff_categories({"a": 0}, {"a": 0}))["a"].status == "same"
+
+
+def test_negative_previous_has_no_rate():
+    d = by_cat(diff_categories({"a": -100}, {"a": 50}))["a"]
+    assert d.status == "up" and d.delta == 150 and d.rate is None
+
+
+def test_sort_by_abs_delta_then_name():
+    diffs = diff_categories({"b": 0, "a": 0, "c": 0}, {"b": 100, "a": -100, "c": 500})
+    assert [d.category for d in diffs] == ["c", "a", "b"]
+
+
+def test_previous_month_rollover():
+    assert previous_month("2026-01") == "2025-12"
+    assert previous_month("2026-03") == "2026-02"
+
+
+@pytest.mark.parametrize("bad", ["2026-13", "2026-1", "202601", "", "2026-00"])
+def test_invalid_month_raises(bad: str):
+    with pytest.raises(ValueError):
+        previous_month(bad)
+    with pytest.raises(ValueError):
+        compare_months({bad: {"a": 1}})
+
+
+def test_empty_input():
+    assert compare_months({}) == []
+    assert compare_expenses([]) == []
+
+
+def test_first_month_all_new():
+    (m,) = compare_months({"2026-01": {"a": 10}})
+    assert m.previous_month == "2025-12"
+    assert [d.status for d in m.diffs] == ["new"]
+
+
+def test_year_boundary_compares_december():
+    res = compare_months({"2025-12": {"a": 100}, "2026-01": {"a": 150}})
+    assert res[1].previous_month == "2025-12"
+    assert res[1].diffs[0].delta == 50
+
+
+def test_gap_month_treated_as_empty():
+    res = compare_months({"2026-01": {"a": 100}, "2026-03": {"a": 100}})
+    assert [m.month for m in res] == ["2026-01", "2026-03"]
+    assert res[1].diffs[0].status == "new"
+
+
+def test_months_ascending_regardless_of_input_order():
+    res = compare_months({"2026-02": {"a": 1}, "2026-01": {"a": 1}})
+    assert [m.month for m in res] == ["2026-01", "2026-02"]
+
+
+def test_empty_month_makes_everything_gone():
+    res = compare_months({"2026-01": {"a": 1}, "2026-02": {}})
+    assert [d.status for d in res[1].diffs] == ["gone"]
+
+
+def test_compare_expenses_end_to_end():
+    rows = [
+        Expense(date(2026, 1, 5), "food", 1000),
+        Expense(date(2026, 1, 20), "food", 500),
+        Expense(date(2026, 1, 9), "old", 300),
+        Expense(date(2026, 2, 1), "food", 900),
+        Expense(date(2026, 2, 2), "fresh", 700),
+    ]
+    jan, feb = compare_expenses(rows)
+    assert jan.month == "2026-01"
+    d = by_cat(feb.diffs)
+    assert d["food"].previous == 1500 and d["food"].status == "down"
+    assert d["fresh"].status == "new"
+    assert d["old"].status == "gone"
