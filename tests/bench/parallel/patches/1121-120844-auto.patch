@@ -0,0 +1,224 @@
+from dataclasses import FrozenInstanceError
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def _e(
+    day: date, category: str = "rent", amount: int = 50000, memo: str = ""
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# add_month
+
+
+@pytest.mark.parametrize(
+    "start, expected",
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2024, 1, 31), date(2024, 2, 29)),
+        (date(2026, 12, 15), date(2027, 1, 15)),
+        (date(2026, 12, 31), date(2027, 1, 31)),
+        (date(2026, 3, 31), date(2026, 4, 30)),
+        (date(2026, 11, 1), date(2026, 12, 1)),
+    ],
+    ids=[
+        "jan31-to-feb28",
+        "jan31-to-feb29-leap",
+        "dec15-year-rollover",
+        "dec31-year-rollover",
+        "mar31-to-apr30",
+        "plain",
+    ],
+)
+def test_add_month(start, expected):
+    assert add_month(start) == expected
+
+
+# find_recurring: arguments
+
+
+def test_min_count_below_two_raises():
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+
+
+def test_negative_tolerance_raises():
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+# find_recurring: basics
+
+
+def test_empty_input_returns_empty_list():
+    assert find_recurring([]) == []
+
+
+def test_monthly_three_times_is_recurring():
+    rows = [_e(date(2026, 1, 15)), _e(date(2026, 2, 15)), _e(date(2026, 3, 15))]
+    assert find_recurring(rows) == [
+        Recurring(
+            "rent",
+            50000,
+            (date(2026, 1, 15), date(2026, 2, 15), date(2026, 3, 15)),
+            date(2026, 4, 15),
+        )
+    ]
+
+
+def test_two_occurrences_qualify_only_when_min_count_is_two():
+    rows = [_e(date(2026, 1, 15)), _e(date(2026, 2, 15))]
+    assert find_recurring(rows) == []
+    assert find_recurring(rows, min_count=2) == [
+        Recurring(
+            "rent", 50000, (date(2026, 1, 15), date(2026, 2, 15)), date(2026, 3, 15)
+        )
+    ]
+
+
+def test_recurring_is_frozen():
+    r = Recurring("rent", 1, (date(2026, 1, 1),), date(2026, 2, 1))
+    with pytest.raises(FrozenInstanceError):
+        r.amount = 2  # type: ignore[misc]
+
+
+def test_input_order_does_not_matter():
+    rows = [_e(date(2026, 3, 15)), _e(date(2026, 1, 15)), _e(date(2026, 2, 15))]
+    (r,) = find_recurring(rows)
+    assert r.days == (date(2026, 1, 15), date(2026, 2, 15), date(2026, 3, 15))
+
+
+# find_recurring: tolerance
+
+
+@pytest.mark.parametrize(
+    "third, connected",
+    [
+        (date(2026, 3, 18), True),  # +3 days from expected 03-15
+        (date(2026, 3, 12), True),  # -3 days
+        (date(2026, 3, 19), False),  # +4 days
+        (date(2026, 3, 11), False),  # -4 days
+    ],
+    ids=["plus3", "minus3", "plus4", "minus4"],
+)
+def test_tolerance_boundary_with_default_tolerance(third, connected):
+    rows = [_e(date(2026, 1, 15)), _e(date(2026, 2, 15)), _e(third)]
+    assert (len(find_recurring(rows)) == 1) is connected
+
+
+def test_zero_tolerance_requires_exact_day():
+    rows = [_e(date(2026, 1, 15)), _e(date(2026, 2, 15)), _e(date(2026, 3, 16))]
+    assert find_recurring(rows, tolerance=0) == []
+    assert len(find_recurring(rows, tolerance=1)) == 1
+
+
+def test_end_of_month_chain_uses_clamped_expected_date():
+    # 01-31 -> expected 02-28 (exact); 02-28 -> expected 03-28, actual 03-31 (+3)
+    rows = [_e(date(2026, 1, 31)), _e(date(2026, 2, 28)), _e(date(2026, 3, 31))]
+    assert find_recurring(rows) == [
+        Recurring(
+            "rent",
+            50000,
+            (date(2026, 1, 31), date(2026, 2, 28), date(2026, 3, 31)),
+            date(2026, 4, 30),
+        )
+    ]
+    assert find_recurring(rows, tolerance=0) == []
+
+
+# find_recurring: splitting and filtering runs
+
+
+def test_gap_splits_runs_and_short_run_is_dropped():
+    rows = [
+        _e(date(2026, 1, 15)),
+        _e(date(2026, 2, 15)),
+        _e(date(2026, 3, 15)),
+        _e(date(2026, 7, 15)),
+        _e(date(2026, 8, 15)),
+    ]
+    assert find_recurring(rows) == [
+        Recurring(
+            "rent",
+            50000,
+            (date(2026, 1, 15), date(2026, 2, 15), date(2026, 3, 15)),
+            date(2026, 4, 15),
+        )
+    ]
+
+
+def test_two_separate_runs_each_become_a_recurring_sorted_by_first_day():
+    rows = [
+        _e(date(2026, 7, 15)),
+        _e(date(2026, 8, 15)),
+        _e(date(2026, 9, 15)),
+        _e(date(2026, 1, 15)),
+        _e(date(2026, 2, 15)),
+        _e(date(2026, 3, 15)),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 15), date(2026, 7, 15)]
+    assert [r.next_expected for r in result] == [date(2026, 4, 15), date(2026, 10, 15)]
+
+
+def test_duplicate_days_are_counted_once():
+    rows = [_e(date(2026, 1, 15)), _e(date(2026, 1, 15)), _e(date(2026, 2, 15))]
+    assert find_recurring(rows) == []
+    rows.append(_e(date(2026, 3, 15)))
+    (r,) = find_recurring(rows)
+    assert r.days == (date(2026, 1, 15), date(2026, 2, 15), date(2026, 3, 15))
+
+
+def test_same_day_repeated_is_not_recurring():
+    rows = [_e(date(2026, 1, 15))] * 3
+    assert find_recurring(rows) == []
+
+
+# find_recurring: grouping keys
+
+
+def test_memo_is_ignored_for_grouping():
+    rows = [
+        _e(date(2026, 1, 15), memo="a"),
+        _e(date(2026, 2, 15), memo="b"),
+        _e(date(2026, 3, 15), memo=""),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_different_amounts_are_grouped_separately():
+    rows = []
+    for d in (date(2026, 1, 15), date(2026, 2, 15), date(2026, 3, 15)):
+        rows.append(_e(d, amount=50000))
+        rows.append(_e(d, amount=1000))
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [("rent", 1000), ("rent", 50000)]
+
+
+def test_mixed_amounts_do_not_join_into_one_run():
+    # Same days but alternating amounts: neither (category, amount) group has 3 entries.
+    rows = [
+        _e(date(2026, 1, 15), amount=1000),
+        _e(date(2026, 2, 15), amount=2000),
+        _e(date(2026, 3, 15), amount=1000),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_results_sorted_by_category_then_amount():
