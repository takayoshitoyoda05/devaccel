+++ b/tests/test_query.py
@@ -0,0 +1,136 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+E = Expense(date(2026, 11, 1), "Food", 1200, "Lunch at Cafe")
+OTHER = Expense(date(2026, 11, 2), "rent", 80000, "")
+
+
+@pytest.mark.parametrize(
+    ("q", "expected"),
+    [
+        ("", []),
+        ("   \t ", []),
+        ("food lunch", [("TERM", "food"), ("TERM", "lunch")]),
+        ("(a)", [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]),
+        ('"a b"', [("TERM", "a b")]),
+        ('"(x)"', [("TERM", "(x)")]),
+        ('"   "', [("TERM", "   ")]),
+        ("AND OR NOT", [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]),
+        ("and", [("TERM", "and")]),
+        ("ANDx", [("TERM", "ANDx")]),
+        ("cat:food", [("CAT", "food")]),
+        ("cat:AND", [("CAT", "AND")]),
+        ("cat:food(", [("CAT", "food"), ("LPAREN", "(")]),
+        ('food"x"', [("TERM", "food"), ("TERM", "x")]),
+        ("a-b", [("TERM", "a-b")]),
+    ],
+)
+def test_tokenize(q, expected):
+    assert tokenize(q) == expected
+
+
+@pytest.mark.parametrize(
+    "q",
+    ['"abc', '""', "cat:", "cat:("],
+)
+def test_tokenize_rejects_bad_input(q):
+    with pytest.raises(QueryError):
+        tokenize(q)
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(",
+        ")",
+        "lunch)",
+        "(lunch",
+        "lunch OR",
+        "OR lunch",
+        "AND lunch",
+        "lunch AND",
+        "NOT",
+        "NOT)",
+        "lunch OR OR food",
+        '"unclosed',
+        '""',
+        "cat:",
+    ],
+)
+def test_invalid_queries_raise(q):
+    with pytest.raises(QueryError):
+        matches(q, E)
+
+
+def test_query_error_is_value_error():
+    assert issubclass(QueryError, ValueError)
+
+
+@pytest.mark.parametrize(
+    ("q", "expected"),
+    [
+        ("lunch", True),
+        ("LUNCH", True),
+        ("food", True),  # category substring, casefolded
+        ("cafe lunch", True),  # implicit AND
+        ("cafe OR rent", True),
+        ("rent", False),
+        ("cat:food", True),
+        ("cat:FOOD", True),
+        ("cat:foo", False),  # CAT is an exact match
+        ("cat:lunch", False),  # CAT does not look at memo
+        ("NOT lunch", False),
+        ("NOT rent", True),
+        ("NOT NOT lunch", True),
+        ("NOT lunch OR food", True),  # NOT binds tighter than OR
+        ("lunch rent OR cafe", True),  # (lunch AND rent) OR cafe
+        ("lunch AND rent", False),
+        ("lunch AND NOT rent", True),
+        ("(rent OR food) lunch", True),
+        ("(rent OR food) AND rent", False),
+        ('"at cafe"', True),
+        ('"Lunch at Cafe"', True),
+        ('"lunch" "food"', True),
+        ("cat:cafe", False),
+    ],
+)
+def test_matches(q, expected):
+    assert matches(q, E) is expected
+
+
+def test_term_does_not_match_when_memo_is_empty():
+    assert matches("lunch", OTHER) is False
+    assert matches("rent", OTHER) is True
+
+
+def test_cat_uses_casefold():
+    e = Expense(date(2026, 11, 3), "Straße", 500, "")
+    assert matches("cat:STRASSE", e) is True
+
+
+def test_filter_rows_keeps_input_order():
+    rows = [
+        Expense(date(2026, 11, 1), "food", 100, "a"),
+        Expense(date(2026, 11, 2), "rent", 200, "food"),
+        Expense(date(2026, 11, 3), "food", 300, "b"),
+    ]
+    assert filter_rows("food", rows) == [rows[0], rows[1], rows[2]]
+    assert filter_rows("cat:food", rows) == [rows[0], rows[2]]
+    assert filter_rows("cat:food OR rent", rows) == rows
+
+
+def test_filter_rows_no_match_returns_empty():
+    assert filter_rows("zzz", [E, OTHER]) == []
+
+
+def test_filter_rows_empty_input_still_validates():
+    assert filter_rows("lunch", []) == []
+    with pytest.raises(QueryError):
+        filter_rows("lunch OR", [])
