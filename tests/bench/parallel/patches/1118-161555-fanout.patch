+def test_output_sorted_by_category_then_amount_then_first_day():
+    rows = [
+        _e(date(2026, 9, 1), category="b", amount=5),
+        _e(date(2026, 10, 1), category="b", amount=5),
+        _e(date(2026, 11, 1), category="b", amount=5),
+        _e(date(2026, 9, 1), category="a", amount=9),
+        _e(date(2026, 10, 1), category="a", amount=9),
+        _e(date(2026, 11, 1), category="a", amount=9),
+        _e(date(2026, 9, 1), category="a", amount=2),
+        _e(date(2026, 10, 1), category="a", amount=2),
+        _e(date(2026, 11, 1), category="a", amount=2),
+    ]
+    keys = [(r.category, r.amount) for r in find_recurring(rows)]
+    assert keys == [("a", 2), ("a", 9), ("b", 5)]
