index 0000000..485314d
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,113 @@
+"""Import bank CSV exports (他行 CSV) into Expense records. Standard library only."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+# 任意の "-"、任意の "¥"/"￥"、ASCII 数字で始まる数字とカンマの列、任意の "円"
+_AMOUNT_RE = re.compile(r"(-?)[¥￥]?([0-9][0-9,]*)円?")
+# YYYY/M/D または YYYY-M-D(区切りは両方同じ)。数字は ASCII のみ。
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    """Parse a bank amount string such as "￥1,234" or "-300円" into yen."""
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    sign, body = m.group(1), m.group(2)
+    value = int(body.replace(",", ""))
+    return -value if sign else value
+
+
+def parse_date(s: str) -> date:
+    """Parse "YYYY/M/D" or "YYYY-M-D" into a date."""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    try:
+        return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Convert a bank CSV (header on line 1) into expenses.
+
+    Returns (valid expenses in input order, [(physical line number, field), ...]).
+    Rows with any error are excluded from the expenses.
+    """
+    cols = DEFAULT_MAPPING if mapping is None else mapping
+    for key in ("date", "category", "amount"):
+        if key not in cols:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header: list[str] = next(reader, [])
+    for col in cols.values():
+        if col not in header:
+            raise ValueError(f"ヘッダーに列 {col!r} がありません")
+    index = {key: header.index(col) for key, col in cols.items()}
+
+    def cell(raw: list[str], key: str) -> str:
+        i = index.get(key)
+        if i is None or i >= len(raw):
+            return ""
+        return raw[i]
+
+    rows: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    last_line = reader.line_num
+    for raw in reader:
+        start = last_line + 1  # physical line where this record begins
+        last_line = reader.line_num
+        if not raw:  # blank line: skipped, but still counted
+            continue
+
+        bad: list[str] = []
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(cell(raw, "date"))
+        except ValueError:
+            bad.append("date")
+        try:
+            amount = parse_amount(cell(raw, "amount"))
+        except ValueError:
+            bad.append("amount")
+        category = cell(raw, "category").strip()
+        if not category:
+            bad.append("category")
+
+        if bad:
+            errors.extend((start, field) for field in bad)
+            continue
+        assert day is not None and amount is not None  # narrowed by `bad`
+
+        if category_map is not None and category in category_map:
+            category = category_map[category]
+        rows.append(
+            Expense(
+                day=day,
+                category=category,
+                amount=amount,
+                memo=cell(raw, "memo").strip(),
+            )
+        )
+    return rows, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
