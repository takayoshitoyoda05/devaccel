diff --git a/tests/test_types/test_Path_suffixes.py b/tests/test_types/test_Path_suffixes.py
new file mode 100644
index 0000000..fc57ba7
--- /dev/null
+++ b/tests/test_types/test_Path_suffixes.py
@@ -0,0 +1,126 @@
+import pathlib
+
+import pytest
+
+import click
+
+CSV_TSV = click.Path(suffixes=[".csv", ".tsv"])
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["a.csv", "a.tsv", "A.CSV", "dir/data.TsV", "a.b.csv", ".csv"],
+)
+def test_suffix_accepted(value):
+    assert CSV_TSV.convert(value, None, None) == value
+
+
+@pytest.mark.parametrize("value", ["a.txt", "a", "a.csv.bak", "csv", "a.csv/", ""])
+def test_suffix_rejected(value):
+    with pytest.raises(click.BadParameter, match="must end with .csv, .tsv"):
+        CSV_TSV.convert(value, None, None)
+
+
+def test_suffix_case_insensitive_declaration():
+    assert click.Path(suffixes=[".CSV"]).convert("a.csv", None, None) == "a.csv"
+
+
+def test_suffix_multi_dot():
+    type = click.Path(suffixes=[".tar.gz"])
+    assert type.convert("x.TAR.GZ", None, None) == "x.TAR.GZ"
+
+    with pytest.raises(click.BadParameter):
+        type.convert("x.gz", None, None)
+
+
+def test_suffix_checks_nonexistent_path(tmp_path):
+    with pytest.raises(click.BadParameter):
+        CSV_TSV.convert(str(tmp_path / "missing.txt"), None, None)
+
+
+def test_suffix_checks_existing_file(tmp_path):
+    f = tmp_path / "a.txt"
+    f.touch()
+
+    with pytest.raises(click.BadParameter):
+        CSV_TSV.convert(str(f), None, None)
+
+    g = tmp_path / "a.CSV"
+    g.touch()
+    assert CSV_TSV.convert(str(g), None, None) == str(g)
+
+
+def test_suffix_directory_not_checked(tmp_path):
+    d = tmp_path / "plain"
+    d.mkdir()
+    assert CSV_TSV.convert(str(d), None, None) == str(d)
+
+
+def test_suffix_dash_not_checked():
+    type = click.Path(allow_dash=True, suffixes=[".csv"])
+    assert type.convert("-", None, None) == "-"
+
+    with pytest.raises(click.BadParameter):
+        click.Path(suffixes=[".csv"]).convert("-", None, None)
+
+
+def test_suffix_bytes_and_pathlike():
+    assert CSV_TSV.convert(b"a.CSV", None, None) == b"a.CSV"
+    assert CSV_TSV.convert(pathlib.Path("a.tsv"), None, None) == pathlib.Path("a.tsv")
+
+    with pytest.raises(click.BadParameter):
+        CSV_TSV.convert(pathlib.Path("a.txt"), None, None)
+
+
+def test_suffix_with_path_type():
+    type = click.Path(suffixes=[".csv"], path_type=pathlib.Path)
+    assert type.convert("a.CSV", None, None) == pathlib.Path("a.CSV")
+
+
+def test_suffix_default_unchanged():
+    assert click.Path().suffixes is None
+    assert click.Path().convert("a.anything", None, None) == "a.anything"
+
+
+def test_suffix_accepts_any_iterable():
+    type = click.Path(suffixes=iter([".csv"]))
+    assert type.suffixes == (".csv",)
+
+
+@pytest.mark.parametrize("bad", [[], ()])
+def test_suffix_empty_raises(bad):
+    with pytest.raises(ValueError, match="must not be empty"):
+        click.Path(suffixes=bad)
+
+
+@pytest.mark.parametrize("bad", [["csv"], [".csv", "tsv"], ["."], [""], ["csv."]])
+def test_suffix_without_leading_dot_raises(bad):
+    with pytest.raises(ValueError, match="must start with a dot"):
+        click.Path(suffixes=bad)
+
+
+@pytest.mark.parametrize("bad", [".csv", b".csv", [b".csv"], [None], [1]])
+def test_suffix_wrong_type_raises(bad):
+    with pytest.raises(TypeError):
+        click.Path(suffixes=bad)
+
+
+def test_suffix_info_dict():
+    info = CSV_TSV.to_info_dict()
+    assert info["suffixes"] == [".csv", ".tsv"]
+    assert click.Path().to_info_dict()["suffixes"] is None
+
+
+def test_suffix_in_command(runner):
+    @click.command()
+    @click.argument("f", type=click.Path(suffixes=[".csv", ".tsv"]))
+    def cli(f):
+        click.echo(f)
+
+    ok = runner.invoke(cli, ["Data.CSV"])
+    assert ok.exit_code == 0
+    assert ok.output == "Data.CSV\n"
+
+    bad = runner.invoke(cli, ["data.txt"])
+    assert bad.exit_code == 2
+    assert "must end with .csv, .tsv" in bad.output
