--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,93 @@
+"""Import CSV exports from other banks / card issuers."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"(-?)[¥￥]?([0-9][0-9,]*)円?", re.ASCII)
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})", re.ASCII)
+
+
+def parse_amount(s: str) -> int:
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if not m:
+        raise ValueError(f"invalid amount: {s!r}")
+    value = int(m.group(2).replace(",", ""))
+    return -value if m.group(1) else value
+
+
+def parse_date(s: str) -> date:
+    m = _DATE_RE.fullmatch(s.strip())
+    if not m:
+        raise ValueError(f"invalid date: {s!r}")
+    return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+    category_map = category_map or {}
+    reader = csv.reader(io.StringIO(text))
+    try:
+        header = next(reader)
+    except StopIteration:
+        raise ValueError("ヘッダーがありません") from None
+    index: dict[str, int] = {}
+    for field, col in mapping.items():
+        if col not in header:
+            raise ValueError(f"列 {col} がヘッダーにありません")
+        index[field] = header.index(col)
+
+    def cell(row: list[str], field: str) -> str:
+        i = index.get(field)
+        return row[i] if i is not None and i < len(row) else ""
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    for row in reader:
+        if not row or (len(row) == 1 and not row[0].strip()):
+            continue
+        # line_num is the last physical line consumed; a quoted multi-line
+        # record starts earlier, so report the record's first line.
+        start = reader.line_num - sum(c.count("\n") for c in row)
+        bad = False
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(cell(row, "date"))
+        except ValueError:
+            errors.append((start, "date"))
+            bad = True
+        try:
+            amount = parse_amount(cell(row, "amount"))
+        except ValueError:
+            errors.append((start, "amount"))
+            bad = True
+        category = cell(row, "category").strip()
+        if not category:
+            errors.append((start, "category"))
+            bad = True
+        if bad or day is None or amount is None:
+            continue
+        category = category_map.get(category, category)
+        expenses.append(Expense(day, category, amount, cell(row, "memo").strip()))
+    return expenses, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
