+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def e(d: date, cat: str = "家賃", amt: int = 1000, memo: str = "") -> Expense:
+    return Expense(d, cat, amt, memo)
+
+
+@pytest.mark.parametrize(
+    ("src", "dst"),
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2024, 1, 31), date(2024, 2, 29)),
+        (date(2026, 12, 15), date(2027, 1, 15)),
+        (date(2026, 3, 31), date(2026, 4, 30)),
+    ],
+)
+def test_add_month(src: date, dst: date) -> None:
+    assert add_month(src) == dst
+
+
+def test_basic() -> None:
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 5), memo="x"), e(date(2026, 3, 6))]
+    assert find_recurring(rows) == [
+        Recurring(
+            "家賃",
+            1000,
+            (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 6)),
+            date(2026, 4, 6),
+        )
+    ]
+
+
+def test_invalid_args() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_empty_and_too_short() -> None:
+    assert find_recurring([]) == []
+    assert find_recurring([e(date(2026, 1, 5)), e(date(2026, 2, 5))]) == []
+
+
+def test_duplicates_removed() -> None:
+    rows = [e(date(2026, 1, 5)), e(date(2026, 1, 5)), e(date(2026, 2, 5))]
+    assert find_recurring(rows, min_count=3) == []
+    assert len(find_recurring(rows, min_count=2)[0].days) == 2
+
+
+def test_split_on_gap() -> None:
+    rows = [
+        e(date(2026, 1, 5)),
+        e(date(2026, 2, 5)),
+        e(date(2026, 4, 5)),
+        e(date(2026, 5, 5)),
+        e(date(2026, 6, 5)),
+    ]
+    res = find_recurring(rows, min_count=2)
+    assert [r.days[0] for r in res] == [date(2026, 1, 5), date(2026, 4, 5)]
+    assert len(find_recurring(rows, min_count=3)) == 1
+
+
+def test_tolerance_boundary() -> None:
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 9))]  # 4 days off
+    assert find_recurring(rows, min_count=2, tolerance=3) == []
+    assert len(find_recurring(rows, min_count=2, tolerance=4)) == 1
+
+
+def test_sorting_and_grouping() -> None:
+    rows: list[Expense] = []
+    for cat, amt in [("b", 2), ("a", 5), ("a", 3)]:
+        rows += [e(date(2026, m, 1), cat, amt) for m in (1, 2, 3)]
+    assert [(r.category, r.amount) for r in find_recurring(rows)] == [
+        ("a", 3),
+        ("a", 5),
+        ("b", 2),
+    ]
