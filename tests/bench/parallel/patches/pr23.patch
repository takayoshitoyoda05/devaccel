--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,86 @@
+"""Month-over-month category comparison."""
+
+from __future__ import annotations
+
+import re
+from collections import defaultdict
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])", re.ASCII)
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(m: str) -> None:
+    if not _MONTH_RE.fullmatch(m):
+        raise ValueError(f"invalid month: {m!r}")
+
+
+def _month_of(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+    prev: dict[str, int] = defaultdict(int)
+    curr: dict[str, int] = defaultdict(int)
+    for r in rows:
+        m = _month_of(r)
+        if m == prev_month:
+            prev[r.category] += r.amount
+        if m == curr_month:
+            curr[r.category] += r.amount
+    out: list[DiffRow] = []
+    for cat in set(prev) | set(curr):
+        p, c = prev.get(cat, 0), curr.get(cat, 0)
+        delta = c - p
+        pct = round(delta / p * 100, 1) if p != 0 else None
+        if cat not in prev:
+            status = "new"
+        elif cat not in curr:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, p, c, delta, pct, status))
+    out.sort(key=lambda d: (-abs(d.delta), d.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError("n must be >= 0")
+    return [d for d in diffs if d.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for d in diffs:
+        pct = "-" if d.pct is None else f"{d.pct:+.1f}%"
+        lines.append(f"{d.category}\t{d.prev}\t{d.curr}\t{d.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month_of(r) for r in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("2 か月以上のデータが必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..07cc508
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,142 @@
+"""Search query language: tokenizer, parser and evaluator."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+
+from kakeibo.core import Expense
+
+
+class QueryError(ValueError):
+    pass
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    tokens: list[tuple[str, str]] = []
+    i, n = 0, len(q)
+    while i < n:
+        ch = q[i]
+        if ch.isspace():
+            i += 1
+        elif ch == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif ch == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif ch == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError("閉じていない引用符")
+            body = q[i + 1 : end]
+            if not body:
+                raise QueryError("空の引用")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            j = i
+            while j < n and not q[j].isspace() and q[j] not in '()"':
+                j += 1
+            word = q[i:j]
+            i = j
+            if word in ("AND", "OR", "NOT"):
+                tokens.append((word, word))
+            elif word.startswith("cat:"):
+                value = word[4:]
+                if not value:
+                    raise QueryError("cat: の値が空")
+                tokens.append(("CAT", value))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+Pred = Callable[[Expense], bool]
+
+_START = {"NOT", "TERM", "CAT", "LPAREN"}
+
+
+class _Parser:
+    def __init__(self, tokens: list[tuple[str, str]]) -> None:
+        self.tokens = tokens
+        self.pos = 0
+
+    def peek(self) -> str | None:
+        return self.tokens[self.pos][0] if self.pos < len(self.tokens) else None
+
+    def next(self) -> tuple[str, str]:
+        if self.pos >= len(self.tokens):
+            raise QueryError("式が途中で終わっています")
+        tok = self.tokens[self.pos]
+        self.pos += 1
+        return tok
+
+    def parse(self) -> Pred:
+        if not self.tokens:
+            raise QueryError("空のクエリ")
+        pred = self.or_expr()
+        if self.peek() is not None:
+            raise QueryError(f"予期しないトークン: {self.tokens[self.pos][1]!r}")
+        return pred
+
+    def or_expr(self) -> Pred:
+        parts = [self.and_expr()]
+        while self.peek() == "OR":
+            self.next()
+            parts.append(self.and_expr())
+        if len(parts) == 1:
+            return parts[0]
+        return lambda e: any(p(e) for p in parts)
+
+    def and_expr(self) -> Pred:
+        parts = [self.not_expr()]
+        while True:
+            kind = self.peek()
+            if kind == "AND":
+                self.next()
+                parts.append(self.not_expr())
+            elif kind in _START:
+                parts.append(self.not_expr())
+            else:
+                break
+        if len(parts) == 1:
+            return parts[0]
+        return lambda e: all(p(e) for p in parts)
+
+    def not_expr(self) -> Pred:
+        if self.peek() == "NOT":
+            self.next()
+            inner = self.not_expr()
+            return lambda e: not inner(e)
+        return self.primary()
+
+    def primary(self) -> Pred:
+        kind, value = self.next()
+        if kind == "TERM":
+            needle = value.casefold()
+            return lambda e: (
+                needle in e.memo.casefold() or needle in e.category.casefold()
+            )
+        if kind == "CAT":
+            want = value.casefold()
+            return lambda e: e.category.casefold() == want
+        if kind == "LPAREN":
+            inner = self.or_expr()
+            if self.peek() != "RPAREN":
+                raise QueryError("括弧が閉じていません")
+            self.next()
+            return inner
+        raise QueryError(f"予期しないトークン: {value!r}")
+
+
+def _compile(q: str) -> Pred:
+    return _Parser(tokenize(q)).parse()
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _compile(q)(e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    pred = _compile(q)
+    return [r for r in rows if pred(r)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..bbc22f1
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,51 @@
+"""Recurring expense detection."""
+
+from __future__ import annotations
+
+import calendar
+from collections import defaultdict
+from dataclasses import dataclass
+from datetime import date
+from itertools import pairwise
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    year, month = (d.year + 1, 1) if d.month == 12 else (d.year, d.month + 1)
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2 or tolerance < 0:
+        raise ValueError("invalid min_count or tolerance")
+    groups: dict[tuple[str, int], set[date]] = defaultdict(set)
+    for r in rows:
+        groups[(r.category, r.amount)].add(r.day)
+    out: list[Recurring] = []
+    for (category, amount), dayset in groups.items():
+        days = sorted(dayset)
+        run = [days[0]]
+        runs = [run]
+        for prev, cur in pairwise(days):
+            if abs((cur - add_month(prev)).days) <= tolerance:
+                run.append(cur)
+            else:
+                run = [cur]
+                runs.append(run)
+        for run in runs:
+            if len(run) >= min_count:
+                out.append(Recurring(category, amount, tuple(run), add_month(run[-1])))
+    out.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return out
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..64df9d5
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,89 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+
+@pytest.mark.parametrize(
+    ("s", "want"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("-1,2,3円", -123),
+        ("¥5円", 5),
+    ],
+)
+def test_parse_amount_ok(s: str, want: int) -> None:
+    assert parse_amount(s) == want
+
+
+@pytest.mark.parametrize(
+    "s", ["", "円", "12.5", "1 200", "--5", "¥-5", "１２３", ",5", "¥", "5¥", "-"]
+)
+def test_parse_amount_bad(s: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(s)
+
+
+@pytest.mark.parametrize(
+    ("s", "want"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        (" 2026-01-05 ", date(2026, 1, 5)),
+        ("2024/02/29", date(2024, 2, 29)),
+    ],
+)
+def test_parse_date_ok(s: str, want: date) -> None:
+    assert parse_date(s) == want
+
+
+@pytest.mark.parametrize(
+    "s",
+    ["2026/1-5", "26/1/5", "2026/02/30", "", "2026/1", "2026/001/5", "２０２６/1/5"],
+)
+def test_parse_date_bad(s: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(s)
+
+
+CSV = (
+    "利用日,分類,利用金額,利用店名,extra\n"
+    '2026/1/5,食費,"¥1,200","A,B店",x\n'
+    "\n"
+    "bad,,xx,店,y\n"
+    "2026-01-06,  交通 ,300円\n"
+)
+
+
+def test_import_rows() -> None:
+    rows, errors = import_rows(CSV, category_map={"交通": "電車"})
+    assert rows == [
+        Expense(date(2026, 1, 5), "食費", 1200, "A,B店"),
+        Expense(date(2026, 1, 6), "電車", 300, ""),
+    ]
+    assert errors == [(4, "date"), (4, "amount"), (4, "category")]
+
+
+def test_custom_mapping_without_memo() -> None:
+    text = "d,c,a\n2026/1/1,x,5\n"
+    rows, errors = import_rows(text, {"date": "d", "category": "c", "amount": "a"})
+    assert rows == [Expense(date(2026, 1, 1), "x", 5, "")]
+    assert errors == []
+
+
+def test_mapping_errors() -> None:
+    with pytest.raises(ValueError):
+        import_rows("a\n", {"date": "a", "category": "a"})
+    with pytest.raises(ValueError):
+        import_rows("a\n", dict(DEFAULT_MAPPING))
+
+
+def test_whitespace_only_category() -> None:
+    text = "利用日,分類,利用金額,利用店名\n2026/1/1,  ,5,m\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "category")]
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..a375bd5
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,89 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def e(m: int, cat: str, amt: int, y: int = 2026) -> Expense:
+    return Expense(date(y, m, 1), cat, amt, "")
+
+
+ROWS = [
+    e(1, "食費", 10000),
+    e(1, "食費", 5000),
+    e(2, "食費", 18000),
+    e(1, "家賃", 70000),
+    e(2, "家賃", 70000),
+    e(1, "旅行", 2000),
+    e(2, "新規", 700),
+    e(1, "零", 0),
+    e(2, "零", 0),
+    e(1, "減", 1000),
+    e(2, "減", 0),
+    e(3, "別月", 1),
+]
+
+
+def test_month_diff() -> None:
+    res = month_diff(ROWS, "2026-01", "2026-02")
+    assert res == [
+        DiffRow("食費", 15000, 18000, 3000, 20.0, "up"),
+        DiffRow("旅行", 2000, 0, -2000, -100.0, "gone"),
+        DiffRow("減", 1000, 0, -1000, -100.0, "down"),
+        DiffRow("新規", 0, 700, 700, None, "new"),
+        DiffRow("家賃", 70000, 70000, 0, 0.0, "same"),
+        DiffRow("零", 0, 0, 0, None, "same"),
+    ]
+
+
+def test_invalid_months() -> None:
+    for bad in ["2026-1", "2026-13", "2026-00", "202601", "２０２６-01", "2026-01 "]:
+        with pytest.raises(ValueError):
+            month_diff([], bad, "2026-02")
+        with pytest.raises(ValueError):
+            month_diff([], "2026-01", bad)
+
+
+def test_top_movers() -> None:
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    assert [d.category for d in top_movers(diffs)] == ["食費", "旅行", "減"]
+    assert len(top_movers(diffs, 10)) == 4
+    assert top_movers(diffs, 0) == []
+    with pytest.raises(ValueError):
+        top_movers(diffs, -1)
+
+
+def test_render() -> None:
+    diffs = [
+        DiffRow("a", 10, 12, 2, 20.0, "up"),
+        DiffRow("b", 5, 0, -5, -100.0, "gone"),
+        DiffRow("c", 3, 3, 0, 0.0, "same"),
+        DiffRow("d", 0, 4, 4, None, "new"),
+    ]
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "a\t10\t12\t+2\t+20.0%\n"
+        "b\t5\t0\t-5\t-100.0%\n"
+        "c\t3\t3\t+0\t+0.0%\n"
+        "d\t0\t4\t+4\t-"
+    )
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_available_and_latest() -> None:
+    assert available_months(ROWS) == ["2026-01", "2026-02", "2026-03"]
+    assert available_months([]) == []
+    res = latest_diff(ROWS)
+    assert res[0] == DiffRow("家賃", 70000, 0, -70000, -100.0, "gone")
+    assert DiffRow("別月", 0, 1, 1, None, "new") in res
+    with pytest.raises(ValueError):
+        latest_diff([e(1, "a", 1)])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..a438324
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,71 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+E = Expense(date(2026, 1, 1), "Food", 500, "Lunch at Cafe (west)")
+
+
+def test_tokenize() -> None:
+    assert tokenize('a AND (b) OR NOT "x (y)" cat:Food and') == [
+        ("TERM", "a"),
+        ("AND", "AND"),
+        ("LPAREN", "("),
+        ("TERM", "b"),
+        ("RPAREN", ")"),
+        ("OR", "OR"),
+        ("NOT", "NOT"),
+        ("TERM", "x (y)"),
+        ("CAT", "Food"),
+        ("TERM", "and"),
+    ]
+    assert tokenize("   ") == []
+
+
+@pytest.mark.parametrize("q", ['"abc', '""', "cat:", "(cat:)"])
+def test_tokenize_errors(q: str) -> None:
+    with pytest.raises(QueryError):
+        tokenize(q)
+
+
+@pytest.mark.parametrize(
+    "q",
+    ["", "  ", "()", "(a", "a)", "a AND", "OR a", "a OR", "NOT", "a OR OR b", "AND a"],
+)
+def test_syntax_errors(q: str) -> None:
+    with pytest.raises(QueryError):
+        matches(q, E)
+
+
+@pytest.mark.parametrize(
+    ("q", "want"),
+    [
+        ("lunch", True),
+        ("FOOD", True),
+        ("cat:food", True),
+        ("cat:foo", False),
+        ("lunch cafe", True),
+        ("lunch AND dinner", False),
+        ("dinner OR cafe", True),
+        ("NOT dinner", True),
+        ("NOT NOT lunch", True),
+        ("NOT lunch OR food", True),
+        ("lunch OR dinner AND zzz", True),
+        ("(lunch OR dinner) zzz", False),
+        ('"(west)"', True),
+        ('"at cafe"', True),
+        ("lunch NOT cat:Food", False),
+        ("a b", False),
+    ],
+)
+def test_eval(q: str, want: bool) -> None:
+    assert matches(q, E) is want
+
+
+def test_filter_rows() -> None:
+    rows = [E, Expense(date(2026, 1, 2), "Rent", 1, "")]
+    assert filter_rows("NOT cat:food", rows) == [rows[1]]
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
