+"""Month-over-month comparison by category (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class Change:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    percent: float | None
+    trend: str  # "up" / "down" / "same"
+
+
+def _parse_month(month: str) -> tuple[int, int]:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+    return int(month[:4]), int(month[5:7])
+
+
+def _previous_month(year: int, mon: int) -> tuple[int, int]:
+    return (year - 1, 12) if mon == 1 else (year, mon - 1)
+
+
+def _totals(rows: list[Expense], ym: tuple[int, int]) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for e in rows:
+        if (e.day.year, e.day.month) == ym:
+            out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def compare_months(rows: list[Expense], month: str) -> list[Change]:
+    """Compare category totals of `month` (YYYY-MM) with the calendar month before it.
+
+    Categories appearing in either month are included; a missing side counts as 0.
+    Sorted by abs(delta) descending, then category ascending.
+    """
+    year, mon = _parse_month(month)
+    current = _totals(rows, (year, mon))
+    previous = _totals(rows, _previous_month(year, mon))
+
+    changes: list[Change] = []
+    for cat in set(current) | set(previous):
+        prev_amount = previous.get(cat, 0)
+        cur_amount = current.get(cat, 0)
+        delta = cur_amount - prev_amount
+        percent = None if prev_amount == 0 else round(delta / prev_amount * 100, 1)
+        trend = "up" if delta > 0 else "down" if delta < 0 else "same"
+        changes.append(Change(cat, prev_amount, cur_amount, delta, percent, trend))
+
+    changes.sort(key=lambda ch: (-abs(ch.delta), ch.category))
+    return changes
