@@ -0,0 +1,78 @@
+"""Detect monthly recurring expenses (rent, subscriptions) and predict the next one."""
+
+from __future__ import annotations
+
+import calendar
+import re
+from collections import Counter
+from dataclasses import dataclass
+from datetime import date
+from itertools import pairwise
+
+from kakeibo.core import Expense
+
+_MIN_COUNT = 3
+_MIN_GAP = 28
+_MAX_GAP = 31
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str  # normalized memo (the grouping key)
+    amount: int  # most common amount; ties go to the larger one
+    count: int
+    last: date
+
+
+def _normalize_memo(memo: str) -> str:
+    no_digits = re.sub(r"[0-9]+", "", memo.strip().lower())
+    return " ".join(no_digits.split())
+
+
+def _mode(amounts: list[int]) -> int:
+    counts = Counter(amounts)
+    return max(counts, key=lambda a: (counts[a], a))
+
+
+def find_recurring(rows: list[Expense]) -> list[Recurring]:
+    """Groups by (category, normalized memo) with >=3 monthly (28-31 day) hits."""
+    groups: dict[tuple[str, str], dict[date, int]] = {}
+    for e in rows:
+        if e.amount < 0:  # refunds are not recurring spending
+            continue
+        memo = _normalize_memo(e.memo)
+        if not memo:
+            continue
+        # same-day duplicates collapse into one occurrence (first one wins)
+        groups.setdefault((e.category, memo), {}).setdefault(e.day, e.amount)
+
+    found: list[Recurring] = []
+    for (category, memo), by_day in groups.items():
+        days = sorted(by_day)
+        if len(days) < _MIN_COUNT:
+            continue
+        gaps = [(b - a).days for a, b in pairwise(days)]
+        if not all(_MIN_GAP <= g <= _MAX_GAP for g in gaps):
+            continue
+        found.append(
+            Recurring(
+                category=category,
+                memo=memo,
+                amount=_mode([by_day[d] for d in days]),
+                count=len(days),
+                last=days[-1],
+            )
+        )
+    found.sort(key=lambda r: (r.category, r.memo))  # stable: ties after last-desc
+    found.sort(key=lambda r: r.last, reverse=True)
+    return found
+
+
+def next_due(r: Recurring) -> date:
+    """Same day next month; clamps to month end (1/31 -> 2/28 or 2/29)."""
+    year, month = r.last.year, r.last.month + 1
+    if month == 13:
+        year, month = year + 1, 1
+    day = min(r.last.day, calendar.monthrange(year, month)[1])
+    return date(year, month, day)
