@@ -0,0 +1,108 @@
+"""Import CSVs from banks / card companies with varying headers and amount styles."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int  # 1-based line in the original text (header is line 1)
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    rows: list[Expense]
+    errors: list[RowError]
+
+
+_ALIASES = {
+    "date": {"date", "日付", "利用日", "取引日"},
+    "category": {"category", "カテゴリ", "分類", "費目"},
+    "amount": {"amount", "金額", "利用金額", "出金額"},
+    "memo": {"memo", "メモ", "摘要", "内容", "利用店名"},
+}
+_LABELS = {"date": "日付", "amount": "金額"}
+_DATE_RES = (
+    re.compile(r"([0-9]{4})[-/]([0-9]{1,2})[-/]([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日"),
+)
+_DIGITS = re.compile(r"[0-9]+")
+
+
+def _parse_date(raw: str) -> date:
+    s = unicodedata.normalize("NFKC", raw).strip()
+    for pat in _DATE_RES:
+        m = pat.fullmatch(s)
+        if m:
+            try:
+                return date(int(m[1]), int(m[2]), int(m[3]))
+            except ValueError:
+                break
+    raise ValueError(f"日付が不正です: {raw!r}")
+
+
+def _parse_amount(raw: str) -> int:
+    s = unicodedata.normalize("NFKC", raw)
+    for ch in "¥円,":
+        s = s.replace(ch, "")
+    s = "".join(s.split())
+    negative = False
+    if len(s) >= 2 and s[0] == "(" and s[-1] == ")":
+        negative, s = True, s[1:-1]
+    if s[:1] in ("▲", "△", "-", "−"):
+        negative, s = True, s[1:]
+    if not _DIGITS.fullmatch(s):
+        raise ValueError(f"金額が整数ではありません: {raw!r}")
+    n = int(s)
+    return -n if negative else n
+
+
+def _resolve_columns(header: list[str]) -> dict[str, int]:
+    cols: dict[str, int] = {}
+    for i, name in enumerate(header):
+        key = name.strip().lower()
+        for field, names in _ALIASES.items():
+            if key in names and field not in cols:
+                cols[field] = i
+    missing = [label for f, label in _LABELS.items() if f not in cols]
+    if missing:
+        raise ValueError(f"必要な列がありません: {', '.join(missing)}")
+    return cols
+
+
+def import_csv(text: str) -> ImportResult:
+    reader = csv.reader(io.StringIO(text.lstrip("﻿"), newline=""))
+    cols: dict[str, int] | None = None
+    rows: list[Expense] = []
+    errors: list[RowError] = []
+    for record in reader:
+        if not any(c.strip() for c in record):
+            continue
+        # line_num is the record's last line; walk back over embedded newlines
+        line = reader.line_num - sum(c.count("\n") for c in record)
+        if cols is None:
+            cols = _resolve_columns(record)
+            continue
+        try:
+            if len(record) <= max(cols.values()):
+                raise ValueError("列が足りません")
+            day = _parse_date(record[cols["date"]])
+            amount = _parse_amount(record[cols["amount"]])
+        except ValueError as e:
+            errors.append(RowError(line, str(e)))
+            continue
+        category = record[cols["category"]].strip() if "category" in cols else ""
+        memo = record[cols["memo"]].strip() if "memo" in cols else ""
+        rows.append(Expense(day, category or "未分類", amount, memo))
+    if cols is None:
+        raise ValueError("ヘッダ行がありません")
+    return ImportResult(rows, errors)
