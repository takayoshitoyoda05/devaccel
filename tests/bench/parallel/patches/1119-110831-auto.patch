@@ -0,0 +1,103 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, next_due
+
+
+def _e(day, memo="家賃", amount=50000, category="住居"):
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+def _monthly(memo="家賃", amount=50000, months=(1, 2, 3), day=25):
+    return [_e(date(2026, m, day), memo, amount) for m in months]
+
+
+def test_E1_1_basic_monthly():
+    got = find_recurring(_monthly())
+    assert got == [
+        Recurring(
+            category="住居", memo="家賃", amount=50000, count=3, last=date(2026, 3, 25)
+        )
+    ]
+
+
+def test_E1_2_two_hits_is_not_enough():
+    assert find_recurring(_monthly(months=(1, 2))) == []
+
+
+def test_E1_3_gap_too_long():
+    assert find_recurring(_monthly(months=(1, 2, 4))) == []
+
+
+def test_E1_4_memo_normalization_merges():
+    rows = [
+        _e(date(2026, 1, 10), "Netflix 2026-01", 1490),
+        _e(date(2026, 2, 10), "netflix 2026-02", 1490),
+        _e(date(2026, 3, 10), "NETFLIX  2026-03", 1490),
+    ]
+    got = find_recurring(rows)
+    assert len(got) == 1
+    assert got[0].count == 3
+    assert got[0].amount == 1490
+
+
+@pytest.mark.parametrize("memo", ["", "   "])
+def test_E1_5_empty_memo_ignored(memo):
+    assert find_recurring(_monthly(memo=memo)) == []
+
+
+def test_E1_6_same_day_duplicates_collapse():
+    rows = _monthly() + [_e(date(2026, 2, 25))]
+    got = find_recurring(rows)
+    assert [r.count for r in got] == [3]
+
+
+def test_E1_7_empty():
+    assert find_recurring([]) == []
+
+
+@pytest.mark.parametrize(
+    "last,expected",
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2028, 1, 31), date(2028, 2, 29)),
+        (date(2026, 12, 15), date(2027, 1, 15)),
+    ],
+    ids=["E1-8a-nonleap", "E1-8b-leap", "E1-8c-year-end"],
+)
+def test_E1_8_next_due(last, expected):
+    r = Recurring(category="c", memo="m", amount=1, count=3, last=last)
+    assert next_due(r) == expected
+
+
+def test_E1_9_refunds_excluded():
+    assert find_recurring(_monthly(amount=-500)) == []
+
+
+def test_amount_is_mode_with_larger_on_ties():
+    rows = [
+        _e(date(2026, 1, 5), "x", 100),
+        _e(date(2026, 2, 5), "x", 200),
+        _e(date(2026, 3, 5), "x", 200),
+        _e(date(2026, 4, 5), "x", 100),
+    ]
+    assert find_recurring(rows)[0].amount == 200
+
+
+def test_ordering_last_desc_then_category_memo():
+    rows = (
+        _monthly("b", months=(1, 2, 3))
+        + _monthly("a", months=(1, 2, 3))
+        + _monthly("z", months=(2, 3, 4))
+    )
+    assert [r.memo for r in find_recurring(rows)] == ["z", "a", "b"]
+
+
+def test_P1_P2_count_min_and_input_untouched():
+    rows = _monthly() + _monthly("ジム", 8000, months=(1, 2))
+    snapshot = list(rows)
+    got = find_recurring(rows)
+    assert all(r.count >= 3 for r in got)
+    assert rows == snapshot
diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..0545433
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,176 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    amount_between,
+    and_,
+    between_dates,
+    category,
+    memo_contains,
+    not_,
+    or_,
+    search,
+)
+
+
+def E(day: date, cat: str, amount: int, memo: str = "") -> Expense:
+    return Expense(day=day, category=cat, amount=amount, memo=memo)
+
+
+# E3-1: amount_between(1000, 1000) で金額 999/1000/1001 -> 1000 だけ (R2)
+def test_E3_1_amount_between_single_value_is_inclusive() -> None:
+    rows = [
+        E(date(2026, 1, 1), "食費", 999),
+        E(date(2026, 1, 2), "食費", 1000),
+        E(date(2026, 1, 3), "食費", 1001),
+    ]
+    assert [e.amount for e in search(rows, amount_between(1000, 1000))] == [1000]
+
+
+# E3-2: amount_between(hi=0) で金額 -500/0/1 -> -500 と 0 (R2)
+def test_E3_2_amount_between_open_lower_bound_with_negatives() -> None:
+    rows = [
+        E(date(2026, 1, 1), "返金", -500),
+        E(date(2026, 1, 2), "食費", 0),
+        E(date(2026, 1, 3), "食費", 1),
+    ]
+    assert [e.amount for e in search(rows, amount_between(hi=0))] == [-500, 0]
+
+
+# E3-3: between_dates(2026-01-31, 2026-02-01) で 1/30〜2/2 -> 1/31 と 2/1 (R2)
+def test_E3_3_between_dates_inclusive_both_ends() -> None:
+    rows = [
+        E(date(2026, 1, 30), "食費", 1),
+        E(date(2026, 1, 31), "食費", 2),
+        E(date(2026, 2, 1), "食費", 3),
+        E(date(2026, 2, 2), "食費", 4),
+    ]
+    out = search(rows, between_dates(date(2026, 1, 31), date(2026, 2, 1)))
+    assert [e.day for e in out] == [date(2026, 1, 31), date(2026, 2, 1)]
+
+
+# E3-4: memo_contains("net") でメモ "Netflix" と "NET" と "" -> 先の 2 件 (R3)
+def test_E3_4_memo_contains_is_case_insensitive_substring() -> None:
+    rows = [
+        E(date(2026, 1, 1), "娯楽", 1, "Netflix"),
+        E(date(2026, 1, 2), "娯楽", 1, "NET"),
+        E(date(2026, 1, 3), "娯楽", 1, ""),
+    ]
+    out = search(rows, memo_contains("net"))
+    assert [e.memo for e in out] == ["Netflix", "NET"]
+
+
+# E3-5: and_(category("食費"), amount_between(lo=1000)) -> 両方を満たす行 (R4)
+def test_E3_5_and_requires_all_predicates() -> None:
+    rows = [
+        E(date(2026, 1, 1), "食費", 1000),
+        E(date(2026, 1, 2), "食費", 999),
+        E(date(2026, 1, 3), "家賃", 5000),
+    ]
+    out = search(rows, and_(category("食費"), amount_between(lo=1000)))
+    assert [(e.category, e.amount) for e in out] == [("食費", 1000)]
+
+
+# E3-6: or_(category("食費"), category("家賃")) と not_ -> 該当行、元の順序 (R4)
+def test_E3_6_or_and_not_keep_original_order() -> None:
+    rows = [
+        E(date(2026, 1, 1), "家賃", 1),
+        E(date(2026, 1, 2), "娯楽", 2),
+        E(date(2026, 1, 3), "食費", 3),
+    ]
+    assert [
+        e.amount for e in search(rows, or_(category("食費"), category("家賃")))
+    ] == [1, 3]
+    assert [
+        e.amount for e in search(rows, not_(or_(category("食費"), category("家賃"))))
+    ] == [2]
+
+
+# E3-7: and_() / or_() / category() -> 全一致 / 全不一致 / 全不一致 (R1,R4)
+@pytest.mark.parametrize(
+    ("pred", "expected_count"),
+    [
+        pytest.param(and_(), 3, id="E3-7-and-empty"),
+        pytest.param(or_(), 0, id="E3-7-or-empty"),
+        pytest.param(category(), 0, id="E3-7-category-no-args"),
+    ],
+)
+def test_E3_7_empty_builders(pred, expected_count: int) -> None:
+    rows = [
+        E(date(2026, 1, 1), "食費", 1),
+        E(date(2026, 1, 2), "家賃", 2),
+        E(date(2026, 1, 3), "", 3),
+    ]
+    assert len(search(rows, pred)) == expected_count
+
+
+# E3-8: amount_between(5, 1) -> ValueError (R2)
+def test_E3_8_amount_between_lo_greater_than_hi_raises() -> None:
+    with pytest.raises(ValueError):
+        amount_between(5, 1)
+
+
+# E3-9: 空リスト -> [] (R4)
+def test_E3_9_empty_input_returns_empty() -> None:
+    assert search([], category("食費")) == []
+
+
+# --- 追加の規則テスト(表に無い端ケースは仕様文面から) ---
+
+
+def test_category_matches_any_name_after_strip() -> None:
+    rows = [
+        E(date(2026, 1, 1), "食費", 1),
+        E(date(2026, 1, 2), "家賃", 2),
+        E(date(2026, 1, 3), "娯楽", 3),
+    ]
+    out = search(rows, category(" 食費 ", "家賃"))
+    assert [e.category for e in out] == ["食費", "家賃"]
+
+
+def test_category_is_exact_not_substring() -> None:
+    rows = [E(date(2026, 1, 1), "食費外", 1)]
+    assert search(rows, category("食費")) == []
+
+
+def test_amount_between_none_is_unbounded() -> None:
+    rows = [E(date(2026, 1, 1), "食費", -(10**9)), E(date(2026, 1, 2), "食費", 10**9)]
+    assert len(search(rows, amount_between())) == 2
+
+
+def test_between_dates_open_ends() -> None:
+    rows = [E(date(2025, 12, 31), "食費", 1), E(date(2026, 1, 1), "食費", 2)]
+    assert [e.amount for e in search(rows, between_dates(start=date(2026, 1, 1)))] == [
+        2
+    ]
+    assert [e.amount for e in search(rows, between_dates(end=date(2025, 12, 31)))] == [
+        1
+    ]
+
+
+def test_between_dates_start_after_end_raises() -> None:
+    with pytest.raises(ValueError):
+        between_dates(date(2026, 2, 1), date(2026, 1, 31))
+
+
+def test_memo_contains_empty_text_matches_all() -> None:
+    rows = [E(date(2026, 1, 1), "食費", 1, "x"), E(date(2026, 1, 2), "食費", 2, "")]
+    assert len(search(rows, memo_contains(""))) == 2
+
+
+def test_search_does_not_mutate_input() -> None:
+    rows = [E(date(2026, 1, 1), "食費", 1), E(date(2026, 1, 2), "家賃", 2)]
+    snapshot = list(rows)
+    search(rows, not_(category("食費")))
+    assert rows == snapshot
+
+
+def test_result_is_subsequence_of_input() -> None:
+    rows = [E(date(2026, 1, d), "食費", d) for d in range(1, 6)]
+    out = search(rows, amount_between(lo=2, hi=4))
+    it = iter(rows)
+    assert all(any(x is r for r in it) for x in out)
