@@ -0,0 +1,55 @@
+"""Condition search over Expense rows (pure functions)."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from datetime import date
+
+from kakeibo.core import Expense
+
+Predicate = Callable[[Expense], bool]
+
+
+def search(rows: list[Expense], pred: Predicate) -> list[Expense]:
+    """Return the rows matching pred, in input order. Does not modify rows."""
+    return [e for e in rows if pred(e)]
+
+
+def category(*names: str) -> Predicate:
+    """Match if the category equals any of names (stripped). No names -> never match."""
+    wanted = {n.strip() for n in names}
+    return lambda e: e.category in wanted
+
+
+def amount_between(lo: int | None = None, hi: int | None = None) -> Predicate:
+    """Inclusive amount range; None means unbounded."""
+    if lo is not None and hi is not None and lo > hi:
+        raise ValueError(f"lo must be <= hi: {lo} > {hi}")
+    return lambda e: (lo is None or e.amount >= lo) and (hi is None or e.amount <= hi)
+
+
+def memo_contains(text: str) -> Predicate:
+    """Case-insensitive substring match on memo. Empty text matches everything."""
+    needle = text.casefold()
+    return lambda e: needle in e.memo.casefold()
+
+
+def between_dates(start: date | None = None, end: date | None = None) -> Predicate:
+    """Inclusive date range; None means unbounded."""
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"start must be <= end: {start} > {end}")
+    return lambda e: (start is None or e.day >= start) and (end is None or e.day <= end)
+
+
+def and_(*ps: Predicate) -> Predicate:
+    """All predicates match. and_() matches everything."""
+    return lambda e: all(p(e) for p in ps)
+
+
+def or_(*ps: Predicate) -> Predicate:
+    """Any predicate matches. or_() matches nothing."""
+    return lambda e: any(p(e) for p in ps)
+
+
+def not_(p: Predicate) -> Predicate:
+    return lambda e: not p(e)
diff --git a/tests/test_compare.py b/tests/test_compare.py
new file mode 100644
index 0000000..75824b1
--- /dev/null
+++ b/tests/test_compare.py
@@ -0,0 +1,121 @@
+"""Tests for kakeibo.compare (E4-* cases from the spec table, plus P1/P2)."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.compare import Change, compare_months
+from kakeibo.core import Expense
+
+
+def _e(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+def test_E4_1_increase_percent_and_trend() -> None:
+    """E4-1: 食費 前月 10000・当月 12500 -> delta=2500, percent=25.0, up."""
+    rows = [_e("2026-01-05", "食費", 10000), _e("2026-02-05", "食費", 12500)]
+    assert compare_months(rows, "2026-02") == [
+        Change(
+            "食費", previous=10000, current=12500, delta=2500, percent=25.0, trend="up"
+        )
+    ]
+
+
+def test_E4_2_missing_current_counts_as_zero() -> None:
+    """E4-2: 家賃 前月 50000・当月 無し -> current=0, delta=-50000, percent=-100.0, down."""
+    rows = [_e("2026-01-01", "家賃", 50000), _e("2026-02-01", "食費", 1)]
+    result = {c.category: c for c in compare_months(rows, "2026-02")}
+    assert result["家賃"] == Change(
+        "家賃", previous=50000, current=0, delta=-50000, percent=-100.0, trend="down"
+    )
+
+
+def test_E4_3_new_category_percent_none() -> None:
+    """E4-3: 新カテゴリ 前月 無し・当月 3000 -> previous=0, percent=None, up."""
+    rows = [_e("2026-01-01", "食費", 1000), _e("2026-02-10", "趣味", 3000)]
+    result = {c.category: c for c in compare_months(rows, "2026-02")}
+    assert result["趣味"] == Change(
+        "趣味", previous=0, current=3000, delta=3000, percent=None, trend="up"
+    )
+
+
+def test_E4_4_same_amount_is_same_trend() -> None:
+    """E4-4: 同額 -> delta=0, trend=same."""
+    rows = [_e("2026-01-01", "食費", 800), _e("2026-02-01", "食費", 800)]
+    (change,) = compare_months(rows, "2026-02")
+    assert change.delta == 0
+    assert change.trend == "same"
+    assert change.percent == 0.0
+
+
+def test_E4_5_january_uses_previous_december() -> None:
+    """E4-5: month="2026-01" -> 前月は 2025-12 のデータ。"""
+    rows = [
+        _e("2025-11-01", "食費", 9999),
+        _e("2025-12-31", "食費", 1000),
+        _e("2026-01-01", "食費", 1500),
+    ]
+    (change,) = compare_months(rows, "2026-01")
+    assert change.previous == 1000
+    assert change.current == 1500
+    assert change.delta == 500
+
+
+def test_E4_6_sorted_by_abs_delta_then_category() -> None:
+    """E4-6: delta が +500, -500, +1000 (名前 b,a,c) -> c, a, b の順。"""
+    rows = [
+        _e("2026-01-01", "a", 1000),
+        _e("2026-02-01", "a", 500),  # -500
+        _e("2026-01-01", "b", 1000),
+        _e("2026-02-01", "b", 1500),  # +500
+        _e("2026-01-01", "c", 1000),
+        _e("2026-02-01", "c", 2000),  # +1000
+    ]
+    names = [c.category for c in compare_months(rows, "2026-02")]
+    assert names == ["c", "a", "b"]
+
+
+@pytest.mark.parametrize("month", ["2026-13", "2026-1", "2026-00", "202602", "2026/02"])
+def test_E4_7_invalid_month_raises(month: str) -> None:
+    """E4-7: month="2026-13" / "2026-1" -> ValueError (加えて不正形式も同様)。"""
+    with pytest.raises(ValueError):
+        compare_months([], month)
+
+
+def test_E4_8_no_data_in_either_month_returns_empty() -> None:
+    """E4-8: 両月ともデータ無し(他の月だけにある) -> []。"""
+    rows = [_e("2026-05-01", "食費", 1000)]
+    assert compare_months(rows, "2026-02") == []
+
+
+def test_E4_9_percent_rounded_to_one_decimal() -> None:
+    """E4-9: previous=3 で 33.333… -> percent は小数 1 桁に丸まる (33.3)。"""
+    rows = [_e("2026-01-01", "食費", 3), _e("2026-02-01", "食費", 4)]
+    (change,) = compare_months(rows, "2026-02")
+    assert change.percent == 33.3
+
+
+def test_P1_sum_delta_equals_current_total_minus_previous_total() -> None:
+    """P1: sum(delta) == 当月合計 - 前月合計。"""
+    rows = [
+        _e("2026-01-01", "食費", 1000),
+        _e("2026-01-01", "家賃", 5000),
+        _e("2026-02-01", "食費", 1200),
+        _e("2026-02-01", "光熱費", 700),
+        _e("2026-02-01", "返金", -300),
+    ]
+    changes = compare_months(rows, "2026-02")
+    prev_total = 1000 + 5000
+    cur_total = 1200 + 700 - 300
+    assert sum(c.delta for c in changes) == cur_total - prev_total
+
+
+def test_P2_input_not_mutated() -> None:
+    """P2: 入力リストを変更しない。"""
+    rows = [_e("2026-01-01", "食費", 1000), _e("2026-02-01", "食費", 2000)]
+    snapshot = list(rows)
+    compare_months(rows, "2026-02")
+    assert rows == snapshot
