@@ -0,0 +1,97 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.importer import RowError, import_csv
+
+H = "date,category,amount,memo\n"
+
+
+def test_E2_1_standard():
+    r = import_csv(H + '2026-01-05,食費,"1,200",ランチ\n')
+    assert r.rows == [Expense(date(2026, 1, 5), "食費", 1200, "ランチ")]
+    assert r.errors == []
+
+
+def test_E2_2_bank_headers_no_category():
+    r = import_csv('利用日,利用店名,利用金額\n2026/1/5,ABC店,"¥3,000"\n')
+    assert r.rows == [Expense(date(2026, 1, 5), "未分類", 3000, "ABC店")]
+
+
+def test_E2_3_bom_and_blank_lines():
+    r = import_csv("﻿" + H + "\n2026-01-05,食費,100,\n\n  \n")
+    assert len(r.rows) == 1
+    assert r.errors == []
+
+
+@pytest.mark.parametrize(
+    "raw,expected",
+    [
+        ("▲500", -500),
+        ("(500)", -500),
+        ("-500", -500),
+        ("１２００", 1200),
+        ("△300", -300),
+        ("－300", -300),
+        ("1,000円", 1000),
+        ("￥2,500", 2500),
+    ],
+)
+def test_E2_4_amount_styles(raw, expected):
+    r = import_csv(H + f'2026-01-05,食費,"{raw}",\n')
+    assert r.errors == []
+    assert r.rows[0].amount == expected
+
+
+def test_E2_5_bad_rows_reported():
+    r = import_csv(H + "2026-01-05,食費,12.5,\n2026-02-30,食費,100,\n")
+    assert r.rows == []
+    assert r.errors == [
+        RowError(2, "金額が整数ではありません: '12.5'"),
+        RowError(3, "日付が不正です: '2026-02-30'"),
+    ]
+
+
+def test_E2_6_line_numbers_with_multiline_quoted_field():
+    text = H + '2026-01-05,食費,100,"a\nb"\n2026-01-06,食費,xx,\n'
+    r = import_csv(text)
+    assert len(r.rows) == 1
+    assert [e.line for e in r.errors] == [4]
+
+
+def test_E2_7_missing_amount_column():
+    with pytest.raises(ValueError, match="金額"):
+        import_csv("date,category,memo\n2026-01-05,食費,x\n")
+
+
+def test_E2_8_header_only_and_empty():
+    r = import_csv(H)
+    assert r.rows == [] and r.errors == []
+    with pytest.raises(ValueError):
+        import_csv("")
+
+
+def test_E2_9_short_row():
+    r = import_csv(H + "2026-01-05,食費\n")
+    assert r.errors == [RowError(2, "列が足りません")]
+
+
+@pytest.mark.parametrize(
+    "raw", ["2026-01-05", "2026/01/05", "2026/1/5", "2026年1月5日"]
+)
+def test_date_formats(raw):
+    assert import_csv(H + f"{raw},食費,1,\n").rows[0].day == date(2026, 1, 5)
+
+
+@pytest.mark.parametrize("raw", ["", "abc", "1.5", "--5", "¥"])
+def test_bad_amounts(raw):
+    assert len(import_csv(H + f'2026-01-05,食費,"{raw}",\n').errors) == 1
+
+
+def test_first_problem_only_and_P1_P2():
+    text = H + "bad,食費,bad,\n2026-01-05,食費,1,\n2026-01-06,食費\n"
+    r = import_csv(text)
+    assert len(r.errors) == 2  # one per bad row, not per problem
+    assert len(r.rows) + len(r.errors) == 3
+    assert [e.line for e in r.errors] == sorted(e.line for e in r.errors)
