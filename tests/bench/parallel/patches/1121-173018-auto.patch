diff --git a/tests/test_budget.py b/tests/test_budget.py
index 3420921..d8a36d4 100644
--- a/tests/test_budget.py
+++ b/tests/test_budget.py
@@ -5,6 +5,7 @@ import pytest
 
 from kakeibo import main
 from kakeibo.core import (
+    Budget,
     BudgetError,
     Expense,
     find_overruns,
@@ -12,6 +13,24 @@ from kakeibo.core import (
     monthly_totals,
 )
 
+
+def test_monthly_totals_keys_are_zero_padded_and_sorted():
+    rows = [
+        Expense(date(2026, 10, 1), "food", 1),
+        Expense(date(2026, 2, 1), "food", 2),
+        Expense(date(2026, 1, 1), "food", 3),
+    ]
+    assert list(monthly_totals(rows)) == ["2026-01", "2026-02", "2026-10"]
+
+
+def test_overrun_detected_for_single_digit_month():
+    rows = [Expense(date(2026, 3, 5), "food", 5000)]
+    budget = Budget({"food": 1000}, {})
+    assert find_overruns(monthly_totals(rows), budget) == [
+        ("2026-03", "food", 4000, 1000, 5000)
+    ]
+
+
 HEADER = "date,category,amount,memo\n"
