+class JsonError(ValueError):
+    """Raised when an expense JSON is unreadable or invalid.
+
+    errors: list of (where, reason). where is e.g. "3行 5列" for syntax errors,
+    "2件目" / "2件目 amount" for bad records (1-based), or "" for file-level errors.
+    """
+
+    def __init__(self, errors: list[tuple[str, str]]) -> None:
+        super().__init__("; ".join(f"{w}: {why}" if w else why for w, why in errors))
+        self.errors = errors
+
+
+class _FieldError(ValueError):
+    def __init__(self, field: str | None, reason: str) -> None:
+        super().__init__(reason)
+        self.field = field
+
+
+def _parse_record(obj: object) -> Expense:
+    if not isinstance(obj, dict):
+        raise _FieldError(None, f"オブジェクトである必要があります: {obj!r}")
+    missing = [k for k in ("date", "category", "amount") if k not in obj]
+    if missing:
+        raise _FieldError(None, f"項目 {', '.join(missing)} がありません")
+    raw_day, category, amount = obj["date"], obj["category"], obj["amount"]
+    memo = obj.get("memo")
+    if not isinstance(raw_day, str):
+        raise _FieldError(
+            "date", f"日付は文字列(YYYY-MM-DD)である必要があります: {raw_day!r}"
+        )
+    try:
+        day = date.fromisoformat(raw_day)
+    except ValueError:
+        raise _FieldError("date", f"日付が不正です: {raw_day!r}") from None
+    if not isinstance(category, str):
+        raise _FieldError(
+            "category", f"カテゴリは文字列である必要があります: {category!r}"
+        )
+    if isinstance(amount, bool) or not isinstance(amount, int):
+        raise _FieldError("amount", f"金額が整数ではありません: {amount!r}")
+    if memo is not None and not isinstance(memo, str):
+        raise _FieldError("memo", f"メモは文字列である必要があります: {memo!r}")
+    return Expense(day=day, category=category.strip(), amount=amount, memo=memo or "")
+
+
+def load_json(path: Path) -> list[Expense]:
+    """Load expenses from a JSON array of {date, category, amount, memo?} objects.
+
+    All invalid records are collected and reported together, like load_csv.
+    """
+    try:
+        text = path.read_text(encoding="utf-8")
+    except OSError as e:
+        raise JsonError([("", f"ファイルを読めません: {e.strerror}: {path}")]) from None
+    except UnicodeDecodeError:
+        raise JsonError([("", f"UTF-8 として読めません: {path}")]) from None
+    try:
+        data = json.loads(text)
+    except json.JSONDecodeError as e:
+        raise JsonError(
+            [(f"{e.lineno}行 {e.colno}列", f"JSON の構文エラー: {e.msg}")]
+        ) from None
+    if not isinstance(data, list):
+        raise JsonError([("", "最上位は配列である必要があります")])
+    rows: list[Expense] = []
+    errors: list[tuple[str, str]] = []
+    for i, obj in enumerate(data, start=1):
+        try:
+            rows.append(_parse_record(obj))
+        except _FieldError as e:
+            where = f"{i}件目" if e.field is None else f"{i}件目 {e.field}"
+            errors.append((where, str(e)))
+    if errors:
+        raise JsonError(errors)
+    return rows
+
+
+def dump_json(rows: list[Expense], path: Path) -> None:
+    """Write expenses as a JSON array readable by load_json (UTF-8, indented)."""
+    data = [
+        {
+            "date": e.day.isoformat(),
+            "category": e.category,
+            "amount": e.amount,
+            "memo": e.memo,
+        }
+        for e in rows
+    ]
+    path.write_text(
+        json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
+    )
+
+
