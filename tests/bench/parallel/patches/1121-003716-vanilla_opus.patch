@@ -0,0 +1,232 @@
+import json
+from datetime import date
+
+import pytest
+
+from kakeibo import main
+from kakeibo.core import Expense, JsonError, dump_json, load_csv, load_json
+
+CSV = (
+    "date,category,amount,memo\n"
+    "2026-10-31,食費,500,おやつ\n"
+    "2026-11-01,food,1200,lunch\n"
+    "2026-11-02,rent,80000,\n"
+    "2026-11-03,food,800,coffee\n"
+)
+
+
+def _csv(tmp_path):
+    p = tmp_path / "in.csv"
+    p.write_text(CSV, encoding="utf-8")
+    return p
+
+
+def _json(tmp_path, obj, name="in.json"):
+    p = tmp_path / name
+    p.write_text(obj if isinstance(obj, str) else json.dumps(obj), encoding="utf-8")
+    return p
+
+
+def _run(monkeypatch, capsys, *argv):
+    monkeypatch.setattr("sys.argv", ["kakeibo", *map(str, argv)])
+    try:
+        main()
+        code = 0
+    except SystemExit as e:
+        code = e.code
+    cap = capsys.readouterr()
+    return code, cap.out, cap.err
+
+
+def _errors(p):
+    with pytest.raises(JsonError) as ei:
+        load_json(p)
+    return ei.value.errors
+
+
+# --- core: load_json / dump_json ---
+
+
+def test_dump_then_load_round_trips(tmp_path):
+    rows = load_csv(_csv(tmp_path))
+    out = tmp_path / "out.json"
+    dump_json(rows, out)
+    assert load_json(out) == rows
+
+
+def test_dump_json_format_is_readable_utf8(tmp_path):
+    out = tmp_path / "out.json"
+    dump_json([Expense(date(2026, 11, 1), "食費", 1200, "昼")], out)
+    text = out.read_text(encoding="utf-8")
+    assert "食費" in text  # ensure_ascii=False
+    assert json.loads(text) == [
+        {"date": "2026-11-01", "category": "食費", "amount": 1200, "memo": "昼"}
+    ]
+
+
+def test_load_json_memo_optional_and_null(tmp_path):
+    p = _json(
+        tmp_path,
+        [
+            {"date": "2026-11-01", "category": " food ", "amount": 100},
+            {"date": "2026-11-02", "category": "food", "amount": -50, "memo": None},
+        ],
+    )
+    assert load_json(p) == [
+        Expense(date(2026, 11, 1), "food", 100, ""),
+        Expense(date(2026, 11, 2), "food", -50, ""),
+    ]
+
+
+def test_load_json_empty_array(tmp_path):
+    assert load_json(_json(tmp_path, [])) == []
+
+
+def test_broken_json_reports_line_and_column(tmp_path):
+    p = _json(tmp_path, '[\n  {"date": "2026-11-01",\n   "amount" 1}\n]')
+    [(where, reason)] = _errors(p)
+    assert where == "3行 13列"
+    assert "JSON の構文エラー" in reason
+
+
+def test_top_level_must_be_array(tmp_path):
+    [(where, reason)] = _errors(_json(tmp_path, {"date": "2026-11-01"}))
+    assert where == ""
+    assert "配列" in reason
+
+
+def test_missing_file(tmp_path):
+    [(_, reason)] = _errors(tmp_path / "nope.json")
+    assert "ファイルを読めません" in reason
+    assert "nope.json" in reason
+
+
+def test_missing_fields_are_listed(tmp_path):
+    p = _json(tmp_path, [{"date": "2026-11-01"}])
+    assert _errors(p) == [("1件目", "項目 category, amount がありません")]
+
+
+@pytest.mark.parametrize(
+    ("record", "field", "fragment"),
+    [
+        ({"date": "2026-13-01", "category": "f", "amount": 1}, "date", "日付が不正"),
+        ({"date": 20261101, "category": "f", "amount": 1}, "date", "文字列"),
+        ({"date": "2026-11-01", "category": 3, "amount": 1}, "category", "文字列"),
+        ({"date": "2026-11-01", "category": "f", "amount": "1"}, "amount", "整数"),
+        ({"date": "2026-11-01", "category": "f", "amount": 1.5}, "amount", "整数"),
+        ({"date": "2026-11-01", "category": "f", "amount": True}, "amount", "整数"),
+        (
+            {"date": "2026-11-01", "category": "f", "amount": 1, "memo": 1},
+            "memo",
+            "文字列",
+        ),
+    ],
+)
+def test_bad_field_names_record_and_field(tmp_path, record, field, fragment):
+    [(where, reason)] = _errors(_json(tmp_path, [record]))
+    assert where == f"1件目 {field}"
+    assert fragment in reason
+
+
+def test_all_bad_records_reported_with_index(tmp_path):
+    good = {"date": "2026-11-01", "category": "f", "amount": 1}
+    p = _json(
+        tmp_path,
+        [good, "oops", good, {**good, "amount": "x"}, {"category": "f"}],
+    )
+    assert [w for w, _ in _errors(p)] == ["2件目", "4件目 amount", "5件目"]
+
+
+# --- CLI ---
+
+
+def test_cli_export_writes_json_and_no_stdout(tmp_path, monkeypatch, capsys):
+    out = tmp_path / "out.json"
+    code, stdout, stderr = _run(monkeypatch, capsys, _csv(tmp_path), "--export", out)
+    assert code == 0
+    assert stdout == ""
+    assert "4 件を書き出しました" in stderr
+    assert len(json.loads(out.read_text(encoding="utf-8"))) == 4
+
+
+def test_cli_export_respects_memo_filter(tmp_path, monkeypatch, capsys):
+    out = tmp_path / "out.json"
+    code, _, _ = _run(
+        monkeypatch, capsys, _csv(tmp_path), "--memo", "coffee", "--export", out
+    )
+    assert code == 0
+    assert [r["memo"] for r in json.loads(out.read_text(encoding="utf-8"))] == [
+        "coffee"
+    ]
+
+
+def test_cli_export_unwritable_path_exits_1(tmp_path, monkeypatch, capsys):
+    out = tmp_path / "no-such-dir" / "out.json"
+    code, stdout, stderr = _run(monkeypatch, capsys, _csv(tmp_path), "--export", out)
+    assert code == 1
+    assert stdout == ""
+    assert "書き出せません" in stderr
+    assert "Traceback" not in stderr
+
+
+@pytest.mark.parametrize(
+    "extra",
+    [
+        [],
+        ["--total"],
+        ["--report"],
+        ["--format", "csv", "--sort", "name"],
+        ["--memo", "o", "--category", "food"],
+    ],
+)
+def test_cli_json_input_aggregates_same_as_csv(tmp_path, monkeypatch, capsys, extra):
+    csv_path = _csv(tmp_path)
+    js = tmp_path / "data.json"
+    assert _run(monkeypatch, capsys, csv_path, "--export", js)[0] == 0
+    from_csv = _run(monkeypatch, capsys, csv_path, *extra)
+    from_json = _run(monkeypatch, capsys, js, *extra)
+    assert from_json == from_csv
+    assert from_csv[1] != ""
+
+
+def test_cli_input_format_overrides_extension(tmp_path, monkeypatch, capsys):
+    p = _json(
+        tmp_path,
+        [{"date": "2026-11-01", "category": "food", "amount": 1200}],
+        name="data.txt",
+    )
+    code, stdout, _ = _run(monkeypatch, capsys, p, "--input-format", "json")
+    assert (code, stdout) == (0, "food\t1,200\n")
+
+
+def test_cli_json_to_json_export(tmp_path, monkeypatch, capsys):
+    src = _json(tmp_path, [{"date": "2026-11-01", "category": "food", "amount": 1}])
+    out = tmp_path / "copy.json"
+    assert _run(monkeypatch, capsys, src, "--export", out)[0] == 0
+    assert load_json(out) == load_json(src)
+
+
+def test_cli_bad_json_prints_location_and_exits_1(tmp_path, monkeypatch, capsys):
+    p = _json(
+        tmp_path,
+        [
+            {"date": "2026-11-01", "category": "food", "amount": 1},
+            {"date": "2026-11-02", "amount": "abc"},
+            {"date": "bad", "category": "food", "amount": 1},
+        ],
+    )
+    code, stdout, stderr = _run(monkeypatch, capsys, p)
+    assert code == 1
+    assert stdout == ""
+    assert stderr.splitlines() == [
+        "2件目: 項目 category がありません",
+        "3件目 date: 日付が不正です: 'bad'",
+    ]
+
+
+def test_cli_syntax_error_exits_1_without_traceback(tmp_path, monkeypatch, capsys):
+    code, stdout, stderr = _run(monkeypatch, capsys, _json(tmp_path, "[1,"))
+    assert code == 1
+    assert stdout == ""
+    assert stderr.startswith("1行 4列: JSON の構文エラー")
+    assert "Traceback" not in stderr
