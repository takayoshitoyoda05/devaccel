+"""Month-over-month change of per-category spending (pure functions).
+
+Input is the output of ``core.monthly_totals`` (reused, not re-implemented):
+``{"YYYY-MM": {category: yen}}``.
+
+D1: 入力は core.monthly_totals の形をそのまま受ける。行(Expense)からは
+    ``compare_months(monthly_totals(rows))`` で使う。
+D2: 最初の月は比べる前月が無いので結果に含めない(1 か月だけなら空の dict)。
+D3: データに無い途中の月は「空の月(全カテゴリ 0)」として比べる。
+    1 月にあって 2 月に無いカテゴリは 2 月に removed、3 月に再登場すれば new。
+    空の月も結果に含める(その月の項目は removed だけ)。
+D4: 金額 0 は「無い」と同じ。前月 0 かつ今月 != 0 → new、前月 != 0 かつ今月 0
+    → removed、両方 0 の項目は出さない。両方非 0 で、増=increased・減=decreased・
+    同額=unchanged。負の金額(返金で差し引きが負)もそのまま金額として比べる。
+D5: rate(増減率, %)は前月 0(new)なら None、それ以外は delta / abs(previous) * 100。
+    removed は -100.0。
+D6: 月内の並びは abs(delta) の降順、同点はカテゴリ名の昇順(安定・決定的)。
+    月は昇順。
+D7: 月キーが "YYYY-MM" でなければ ValueError(どの月かを書く)。金額が
+    int でない(bool・float・str・None)なら TypeError。
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from typing import Literal
+
+Status = Literal["increased", "decreased", "new", "removed", "unchanged"]
+
+_MONTH_RE = re.compile(r"([0-9]{4})-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    status: Status
+    rate: float | None  # percent; None when previous == 0
+
+
+def _parse_month(month: str) -> tuple[int, int]:
+    m = _MONTH_RE.fullmatch(month) if isinstance(month, str) else None
+    if m is None:
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+    return int(m.group(1)), int(m.group(2))
+
+
+def _month_key(index: int) -> str:
+    return f"{index // 12:04d}-{index % 12 + 1:02d}"
+
+
+def _check_amounts(month: str, cats: dict[str, int]) -> None:
+    for cat, yen in cats.items():
+        if isinstance(yen, bool) or not isinstance(yen, int):
+            raise TypeError(f"{month}.{cat} の金額は int である必要があります: {yen!r}")
+
+
+def compare_categories(
+    previous: dict[str, int], current: dict[str, int]
+) -> list[CategoryChange]:
+    """Compare two months' category totals (see D4–D6)."""
+    out: list[CategoryChange] = []
+    for cat in previous.keys() | current.keys():
+        prev = previous.get(cat, 0)
+        cur = current.get(cat, 0)
+        if prev == 0 and cur == 0:
+            continue
+        delta = cur - prev
+        status: Status
+        if prev == 0:
+            status = "new"
+        elif cur == 0:
+            status = "removed"
+        elif delta > 0:
+            status = "increased"
+        elif delta < 0:
+            status = "decreased"
+        else:
+            status = "unchanged"
+        rate = None if prev == 0 else delta / abs(prev) * 100
+        out.append(CategoryChange(cat, prev, cur, delta, status, rate))
+    out.sort(key=lambda c: (-abs(c.delta), c.category))
+    return out
+
+
+def compare_months(
+    totals: dict[str, dict[str, int]],
+) -> dict[str, list[CategoryChange]]:
+    """{"YYYY-MM": [CategoryChange, ...]} for every month after the first."""
+    parsed: dict[int, dict[str, int]] = {}
+    for month, cats in totals.items():
+        y, mo = _parse_month(month)
+        _check_amounts(month, cats)
+        parsed[y * 12 + mo - 1] = cats
+    if not parsed:
+        return {}
+    first, last = min(parsed), max(parsed)
+    result: dict[str, list[CategoryChange]] = {}
+    for idx in range(first + 1, last + 1):
+        result[_month_key(idx)] = compare_categories(
+            parsed.get(idx - 1, {}), parsed.get(idx, {})
+        )
+    return result
diff --git a/tests/test_trend.py b/tests/test_trend.py
new file mode 100644
index 0000000..4a5b00f
--- /dev/null
+++ b/tests/test_trend.py
@@ -0,0 +1,85 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense, monthly_totals
+from kakeibo.trend import CategoryChange, compare_categories, compare_months
+
+
+def by_cat(changes: list[CategoryChange]) -> dict[str, CategoryChange]:
+    return {c.category: c for c in changes}
+
+
+def test_all_statuses() -> None:
+    prev = {"食費": 1000, "交通": 500, "家賃": 3000, "趣味": 200}
+    cur = {"食費": 1500, "交通": 300, "家賃": 3000, "娯楽": 400}
+    r = by_cat(compare_categories(prev, cur))
+    assert r["食費"].status == "increased" and r["食費"].delta == 500
+    assert r["食費"].rate == 50.0
+    assert r["交通"].status == "decreased" and r["交通"].rate == -40.0
+    assert r["家賃"].status == "unchanged" and r["家賃"].rate == 0.0
+    assert r["娯楽"].status == "new" and r["娯楽"].rate is None
+    assert r["趣味"].status == "removed" and r["趣味"].rate == -100.0
+    assert r["趣味"].current == 0 and r["趣味"].delta == -200
+
+
+def test_zero_amount_means_absent() -> None:
+    r = by_cat(compare_categories({"a": 0, "b": 100}, {"a": 50, "b": 0, "c": 0}))
+    assert r["a"].status == "new"
+    assert r["b"].status == "removed"
+    assert "c" not in r
+
+
+def test_negative_amounts_compared_as_values() -> None:
+    (c,) = compare_categories({"返金": -100}, {"返金": -300})
+    assert c.status == "decreased" and c.delta == -200 and c.rate == -200.0
+
+
+def test_order_abs_delta_desc_then_name() -> None:
+    r = compare_categories({"b": 0, "a": 0, "c": 100}, {"b": 10, "a": 10, "c": 200})
+    assert [c.category for c in r] == ["c", "a", "b"]
+
+
+def test_first_month_excluded_and_single_month_empty() -> None:
+    assert compare_months({}) == {}
+    assert compare_months({"2026-01": {"a": 1}}) == {}
+    r = compare_months({"2026-01": {"a": 1}, "2026-02": {"a": 2}})
+    assert list(r) == ["2026-02"]
+
+
+def test_gap_month_is_empty_month() -> None:
+    r = compare_months({"2026-01": {"a": 100}, "2026-03": {"a": 100}})
+    assert list(r) == ["2026-02", "2026-03"]
+    assert [c.status for c in r["2026-02"]] == ["removed"]
+    assert [c.status for c in r["2026-03"]] == ["new"]
+
+
+def test_year_boundary_and_unsorted_input() -> None:
+    r = compare_months({"2027-01": {"a": 3}, "2026-12": {"a": 1}})
+    assert list(r) == ["2027-01"]
+    assert r["2027-01"][0].delta == 2
+
+
+def test_works_with_monthly_totals() -> None:
+    rows = [
+        Expense(date(2026, 1, 5), "食費", 1000),
+        Expense(date(2026, 2, 5), "食費", 800),
+        Expense(date(2026, 2, 6), "交通", 300),
+    ]
+    r = compare_months(monthly_totals(rows))
+    assert {c.category: c.status for c in r["2026-02"]} == {
+        "食費": "decreased",
+        "交通": "new",
+    }
+
+
+@pytest.mark.parametrize("bad", ["2026-13", "2026-1", "202601", "", "2026-01-01"])
+def test_bad_month_key(bad: str) -> None:
+    with pytest.raises(ValueError, match="月の形式"):
+        compare_months({bad: {"a": 1}})
+
+
+@pytest.mark.parametrize("bad", [True, 1.0, "100", None])
+def test_bad_amount_type(bad: object) -> None:
+    with pytest.raises(TypeError, match="2026-01.a"):
+        compare_months({"2026-01": {"a": bad}})  # type: ignore[dict-item]
