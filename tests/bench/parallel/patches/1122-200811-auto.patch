diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..3ba76e4 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -186,5 +186,83 @@ def test_path_type(runner, cls, expect):
     assert result.return_value == expect
 
 
+@pytest.mark.parametrize(
+    "name",
+    ["a.csv", "a.TSV", "dir/A.Csv", "a.b.tsv", "a.csv.tsv"],
+)
+@pytest.mark.parametrize(
+    "extensions", [[".csv", ".tsv"], ["csv", "TSV"], {".csv", ".tsv"}]
+)
+def test_path_extensions_accepted(name, extensions):
+    assert click.Path(extensions=extensions).convert(name, None, None) == name
+
+
+@pytest.mark.parametrize(
+    "name", ["a.txt", "a", "a.csv.bak", "csv", ".csv", "a.csv/", "a.tsvx"]
+)
+def test_path_extensions_rejected(name):
+    with pytest.raises(click.BadParameter, match=r"extensions: \.csv, \.tsv"):
+        click.Path(extensions=[".csv", ".tsv"]).convert(name, None, None)
+
+
+def test_path_extensions_existing_file(tmp_path):
+    good = tmp_path / "a.CSV"
+    bad = tmp_path / "a.txt"
+    good.touch()
+    bad.touch()
+    type = click.Path(exists=True, extensions=[".csv"])
+    assert type.convert(str(good), None, None) == str(good)
+
+    with pytest.raises(click.BadParameter, match="extensions"):
+        type.convert(str(bad), None, None)
+
+
+def test_path_extensions_skips_directory_and_dash(tmp_path):
+    d = tmp_path / "data.txt"
+    d.mkdir()
+    type = click.Path(extensions=[".csv"], allow_dash=True)
+    assert type.convert(str(d), None, None) == str(d)
+    assert type.convert("-", None, None) == "-"
+
+    # Without allow_dash, "-" is an ordinary name and is checked.
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions=[".csv"]).convert("-", None, None)
+
+
+def test_path_extensions_bytes_and_pathlib():
+    type = click.Path(extensions=[".csv"])
+    assert type.convert(b"a.CSV", None, None) == b"a.CSV"
+    assert type.convert(pathlib.Path("a.csv"), None, None) == pathlib.Path("a.csv")
+
+    with pytest.raises(click.BadParameter):
+        type.convert(pathlib.Path("a.txt"), None, None)
+
+
+def test_path_extensions_default_accepts_anything():
+    assert click.Path().extensions is None
+    assert click.Path().convert("a.txt", None, None) == "a.txt"
+
+
+@pytest.mark.parametrize(
+    ("extensions", "error"),
+    [([], ValueError), ([""], ValueError), (["."], ValueError), (".csv", TypeError)],
+)
+def test_path_extensions_invalid_argument(extensions, error):
+    with pytest.raises(error, match="extensions"):
+        click.Path(extensions=extensions)
+
+
+def test_path_extensions_in_command(runner):
+    @click.command()
+    @click.argument("p", type=click.Path(extensions=[".csv", ".tsv"]))
+    def cli(p):
+        click.echo(p)
+
+    assert runner.invoke(cli, ["x.TSV"]).output == "x.TSV\n"
+    result = runner.invoke(cli, ["x.txt"])
+    assert result.exit_code == 2
+    assert "must have one of the extensions: .csv, .tsv" in result.output
+
+
 def test_path_converted_type_parameter_at_runtime():
