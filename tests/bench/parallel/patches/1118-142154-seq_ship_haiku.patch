+"""Export expense records as JSON."""
+
+from __future__ import annotations
+
+import json
+
+from kakeibo.core import Expense
+
+
+def to_json(rows: list[Expense]) -> str:
+    """JSON array of {date, category, amount, memo} in input order (no indent)."""
+    records = [
+        {
+            "date": e.day.isoformat(),
+            "category": e.category,
+            "amount": e.amount,
+            "memo": e.memo,
+        }
+        for e in rows
+    ]
+    return json.dumps(records, ensure_ascii=False)
