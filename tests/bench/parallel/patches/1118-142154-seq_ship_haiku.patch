@@ -0,0 +1,57 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.dupes import find_duplicates
+
+
+def _e(day: int, cat: str, amount: int, memo: str = "") -> Expense:
+    return Expense(date(2026, 11, day), cat, amount, memo)
+
+
+def test_empty():
+    assert find_duplicates([]) == []
+
+
+def test_no_duplicates():
+    rows = [_e(1, "food", 100), _e(1, "food", 200), _e(2, "food", 100)]
+    assert find_duplicates(rows) == []
+
+
+def test_simple_pair():
+    rows = [_e(1, "food", 100), _e(1, "food", 100)]
+    assert find_duplicates(rows) == [(0, 1)]
+
+
+def test_memo_must_match():
+    rows = [_e(1, "food", 100, "a"), _e(1, "food", 100, "b")]
+    assert find_duplicates(rows) == []
+
+
+def test_day_category_amount_must_match():
+    rows = [
+        _e(1, "food", 100),
+        _e(2, "food", 100),
+        _e(1, "rent", 100),
+        _e(1, "food", 101),
+    ]
+    assert find_duplicates(rows) == []
+
+
+def test_triple_gives_all_pairs_sorted():
+    rows = [
+        _e(1, "food", 100),
+        _e(1, "rent", 5),
+        _e(1, "food", 100),
+        _e(1, "food", 100),
+    ]
+    assert find_duplicates(rows) == [(0, 2), (0, 3), (2, 3)]
+
+
+def test_interleaved_groups_sorted_by_i_then_j():
+    rows = [
+        _e(1, "a", 1),  # 0
+        _e(1, "b", 2),  # 1
+        _e(1, "b", 2),  # 2
+        _e(1, "a", 1),  # 3
+    ]
+    assert find_duplicates(rows) == [(0, 3), (1, 2)]
