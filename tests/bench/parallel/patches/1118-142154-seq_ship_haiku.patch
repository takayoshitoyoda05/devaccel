@@ -0,0 +1,38 @@
+import json
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.export import to_json
+
+
+def test_empty():
+    assert to_json([]) == "[]"
+
+
+def test_record_shape_and_key_order():
+    rows = [Expense(date(2026, 11, 2), "food", 1200, "ランチ")]
+    out = to_json(rows)
+    assert out == (
+        '[{"date": "2026-11-02", "category": "food", "amount": 1200, "memo": "ランチ"}]'
+    )
+    assert list(json.loads(out)[0]) == ["date", "category", "amount", "memo"]
+
+
+def test_non_ascii_not_escaped():
+    out = to_json([Expense(date(2026, 1, 1), "食費", 1, "おにぎり")])
+    assert "食費" in out and "おにぎり" in out
+    assert "\\u" not in out
+
+
+def test_keeps_input_order():
+    rows = [
+        Expense(date(2026, 11, 3), "rent", 80000, ""),
+        Expense(date(2026, 11, 1), "food", 1200, ""),
+    ]
+    data = json.loads(to_json(rows))
+    assert [d["date"] for d in data] == ["2026-11-03", "2026-11-01"]
+
+
+def test_no_indent():
+    out = to_json([Expense(date(2026, 11, 1), "food", 1, "")])
+    assert "\n" not in out
