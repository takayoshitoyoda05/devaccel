+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.stats import median_by_category
+
+
+def _e(cat: str, amount: int) -> Expense:
+    return Expense(date(2026, 11, 1), cat, amount)
+
+
+def test_empty():
+    assert median_by_category([]) == {}
+
+
+def test_odd_count_uses_middle():
+    rows = [_e("food", 100), _e("food", 300), _e("food", 200)]
+    assert median_by_category(rows) == {"food": 200.0}
+
+
+def test_even_count_averages_middle_two():
+    rows = [_e("food", 100), _e("food", 400), _e("food", 200), _e("food", 300)]
+    assert median_by_category(rows) == {"food": 250.0}
+
+
+def test_keys_sorted_by_category_name():
+    rows = [_e("rent", 80000), _e("book", 500), _e("food", 1200)]
+    assert list(median_by_category(rows)) == ["book", "food", "rent"]
+
+
+def test_each_category_separately():
+    rows = [_e("food", 1000), _e("food", 3000), _e("rent", 50000)]
+    assert median_by_category(rows) == {"food": 2000.0, "rent": 50000.0}
+
+
+def test_returns_float_values():
+    result = median_by_category([_e("food", 5)])
+    assert isinstance(result["food"], float)
