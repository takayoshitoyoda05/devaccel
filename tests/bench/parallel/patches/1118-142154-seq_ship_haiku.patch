@@ -0,0 +1,41 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.topn import top_expenses
+
+
+def _e(day: int, cat: str, amount: int) -> Expense:
+    return Expense(date(2026, 11, day), cat, amount)
+
+
+def test_empty_rows():
+    assert top_expenses([], 3) == []
+
+
+def test_zero_or_negative_n_returns_empty():
+    rows = [_e(1, "food", 100)]
+    assert top_expenses(rows, 0) == []
+    assert top_expenses(rows, -2) == []
+
+
+def test_largest_first_and_limited():
+    rows = [_e(1, "food", 1200), _e(2, "rent", 80000), _e(3, "book", 500)]
+    assert top_expenses(rows, 2) == [rows[1], rows[0]]
+
+
+def test_n_larger_than_rows_returns_all_sorted():
+    rows = [_e(1, "food", 1200), _e(2, "book", 500)]
+    assert top_expenses(rows, 10) == [rows[0], rows[1]]
+
+
+def test_tie_broken_by_earlier_day():
+    late = _e(9, "food", 500)
+    early = _e(2, "book", 500)
+    assert top_expenses([late, early], 2) == [early, late]
+
+
+def test_tie_on_day_keeps_input_order():
+    first = _e(5, "food", 500)
+    second = _e(5, "book", 500)
+    assert top_expenses([first, second], 2) == [first, second]
+    assert top_expenses([second, first], 2) == [second, first]
diff --git a/tests/test_weekday.py b/tests/test_weekday.py
