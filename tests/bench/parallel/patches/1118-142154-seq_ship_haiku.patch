+"""Top-N expenses by amount."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def top_expenses(rows: list[Expense], n: int) -> list[Expense]:
+    """Up to n records, largest amount first; ties by earlier day, then input order."""
+    if n <= 0:
+        return []
+    return sorted(rows, key=lambda e: (-e.amount, e.day))[:n]
