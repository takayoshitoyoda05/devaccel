@@ -0,0 +1,38 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.weekday import total_by_weekday
+
+
+def test_empty():
+    assert total_by_weekday([]) == {}
+
+
+def test_weekday_names_for_known_dates():
+    # 2026-11-16 is a Monday
+    rows = [
+        Expense(date(2026, 11, 16), "food", 100),  # Mon
+        Expense(date(2026, 11, 22), "food", 200),  # Sun
+        Expense(date(2026, 11, 18), "food", 300),  # Wed
+    ]
+    assert total_by_weekday(rows) == {"Mon": 100, "Wed": 300, "Sun": 200}
+
+
+def test_sums_same_weekday_and_omits_empty_days():
+    rows = [
+        Expense(date(2026, 11, 2), "food", 1200),  # Mon
+        Expense(date(2026, 11, 9), "rent", 80000),  # Mon
+        Expense(date(2026, 11, 5), "food", 800),  # Thu
+    ]
+    result = total_by_weekday(rows)
+    assert result == {"Mon": 81200, "Thu": 800}
+    assert "Tue" not in result
+
+
+def test_monday_first_order_regardless_of_input_order():
+    rows = [
+        Expense(date(2026, 11, 22), "food", 1),  # Sun
+        Expense(date(2026, 11, 17), "food", 1),  # Tue
+        Expense(date(2026, 11, 16), "food", 1),  # Mon
+    ]
+    assert list(total_by_weekday(rows)) == ["Mon", "Tue", "Sun"]
