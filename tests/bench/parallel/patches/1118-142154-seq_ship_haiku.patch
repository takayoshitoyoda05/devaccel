+"""Totals by day of week."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+# Fixed English names (not strftime, which is locale-dependent), Monday first.
+_WEEKDAYS = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
+
+
+def total_by_weekday(rows: list[Expense]) -> dict[str, int]:
+    """{"Mon".."Sun": yen}, Monday-first order; weekdays with no records are omitted."""
+    totals: dict[str, int] = {}
+    for e in rows:
+        name = _WEEKDAYS[e.day.weekday()]
+        totals[name] = totals.get(name, 0) + e.amount
+    return {name: totals[name] for name in _WEEKDAYS if name in totals}
