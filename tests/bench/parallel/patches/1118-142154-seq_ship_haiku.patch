@@ -0,0 +1,45 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.streak import longest_no_spend_streak
+
+
+def _at(day: int) -> Expense:
+    return Expense(date(2026, 11, day), "food", 100)
+
+
+def test_no_records_whole_range_counts():
+    assert longest_no_spend_streak([], date(2026, 11, 1), date(2026, 11, 5)) == 5
+
+
+def test_single_day_range_no_spend():
+    assert longest_no_spend_streak([], date(2026, 11, 1), date(2026, 11, 1)) == 1
+
+
+def test_single_day_range_with_spend():
+    assert longest_no_spend_streak([_at(1)], date(2026, 11, 1), date(2026, 11, 1)) == 0
+
+
+def test_longest_run_between_spend_days():
+    # spend on 2, 3, 7 within 1..10 -> gaps: [1], [4,5,6], [8,9,10]
+    rows = [_at(2), _at(3), _at(7)]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 10)) == 3
+
+
+def test_both_ends_inclusive():
+    rows = [_at(3)]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 5)) == 2
+
+
+def test_records_outside_range_ignored():
+    rows = [_at(20)]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 5)) == 5
+
+
+def test_multiple_spends_same_day_count_once():
+    rows = [_at(2), _at(2), _at(2)]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 3)) == 1
+
+
+def test_start_after_end_is_zero():
+    assert longest_no_spend_streak([], date(2026, 11, 5), date(2026, 11, 1)) == 0
