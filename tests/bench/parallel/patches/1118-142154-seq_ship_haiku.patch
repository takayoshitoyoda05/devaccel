+"""Split an amount evenly among people."""
+
+from __future__ import annotations
+
+
+def split_evenly(amount: int, people: int) -> list[int]:
+    """Split yen among `people`; remainder yen go to the first people, one each.
+
+    The result always sums to `amount`. Raises ValueError if people < 1.
+    """
+    if people < 1:
+        raise ValueError("people は 1 以上である必要があります")
+    base, rem = divmod(amount, people)
+    return [base + 1] * rem + [base] * (people - rem)
