@@ -0,0 +1,56 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.dupes import find_duplicates
+
+D = date(2026, 1, 5)
+
+
+def e(day=D, category="食費", amount=500, memo="") -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+def test_empty_list_has_no_duplicates() -> None:
+    assert find_duplicates([]) == []
+
+
+def test_single_row_has_no_duplicates() -> None:
+    assert find_duplicates([e()]) == []
+
+
+def test_identical_pair_is_reported_once() -> None:
+    assert find_duplicates([e(), e()]) == [(0, 1)]
+
+
+def test_non_adjacent_duplicates_use_input_indices() -> None:
+    rows = [e(memo="a"), e(memo="b"), e(memo="a")]
+    assert find_duplicates(rows) == [(0, 2)]
+
+
+def test_triple_yields_all_pairs_in_order() -> None:
+    assert find_duplicates([e(), e(), e()]) == [(0, 1), (0, 2), (1, 2)]
+
+
+def test_result_ordered_by_i_then_j() -> None:
+    rows = [e(memo="x"), e(memo="y"), e(memo="y"), e(memo="x")]
+    assert find_duplicates(rows) == [(0, 3), (1, 2)]
+
+
+def test_differs_in_day_is_not_duplicate() -> None:
+    assert find_duplicates([e(), e(day=date(2026, 1, 6))]) == []
+
+
+def test_differs_in_category_is_not_duplicate() -> None:
+    assert find_duplicates([e(), e(category="交通費")]) == []
+
+
+def test_differs_in_amount_is_not_duplicate() -> None:
+    assert find_duplicates([e(), e(amount=501)]) == []
+
+
+def test_differs_in_memo_is_not_duplicate() -> None:
+    assert find_duplicates([e(memo="a"), e(memo="")]) == []
+
+
+def test_memo_compared_exactly_not_trimmed() -> None:
+    assert find_duplicates([e(memo="ランチ"), e(memo="ランチ ")]) == []
