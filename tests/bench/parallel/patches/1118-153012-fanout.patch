+++ b/src/kakeibo/weekday.py
@@ -0,0 +1,18 @@
+"""Expense totals grouped by day of week."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+_WEEKDAYS = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")  # date.weekday() order
+
+
+def total_by_weekday(rows: list[Expense]) -> dict[str, int]:
+    """{"Mon".."Sun": yen}; weekdays without expenses are omitted, Monday first."""
+    sums = [0] * 7
+    seen = [False] * 7
+    for e in rows:
+        i = e.day.weekday()
+        sums[i] += e.amount
+        seen[i] = True
+    return {_WEEKDAYS[i]: sums[i] for i in range(7) if seen[i]}
