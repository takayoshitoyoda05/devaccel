+++ b/src/kakeibo/stats.py
@@ -0,0 +1,25 @@
+"""Per-category statistics over expense records."""
+
+from __future__ import annotations
+
+from collections import defaultdict
+
+from kakeibo.core import Expense
+
+
+def median_by_category(rows: list[Expense]) -> dict[str, float]:
+    """カテゴリごとの金額の中央値。偶数個なら中央 2 つの平均。キーはカテゴリ名の昇順。"""
+    by_cat: defaultdict[str, list[int]] = defaultdict(list)
+    for e in rows:
+        by_cat[e.category].append(e.amount)
+
+    out: dict[str, float] = {}
+    for cat in sorted(by_cat):
+        amounts = sorted(by_cat[cat])
+        n = len(amounts)
+        mid = n // 2
+        if n % 2:
+            out[cat] = float(amounts[mid])
+        else:
+            out[cat] = (amounts[mid - 1] + amounts[mid]) / 2
+    return out
