+"""Export expense records to JSON."""
+
+from __future__ import annotations
+
+import json
+
+from kakeibo.core import Expense
+
+
+def to_json(rows: list[Expense]) -> str:
+    """Serialize rows to a compact JSON array, keeping input order.
+
+    Each object has the keys date, category, amount, memo (in that order).
+    Non-ASCII characters are written as-is.
+    """
+    items = [
+        {
+            "date": e.day.isoformat(),
+            "category": e.category,
+            "amount": e.amount,
+            "memo": e.memo,
+        }
+        for e in rows
+    ]
+    return json.dumps(items, ensure_ascii=False)
