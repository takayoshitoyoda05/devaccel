--- /dev/null
+++ b/tests/test_split.py
@@ -0,0 +1,39 @@
+import pytest
+
+from kakeibo.split import split_evenly
+
+
+def test_even_split():
+    assert split_evenly(3000, 3) == [1000, 1000, 1000]
+
+
+def test_remainder_goes_to_first_people_one_yen_each():
+    assert split_evenly(10, 3) == [4, 3, 3]
+    assert split_evenly(11, 3) == [4, 4, 3]
+
+
+def test_single_person_gets_everything():
+    assert split_evenly(1234, 1) == [1234]
+
+
+def test_zero_amount():
+    assert split_evenly(0, 4) == [0, 0, 0, 0]
+
+
+def test_amount_smaller_than_people():
+    assert split_evenly(2, 5) == [1, 1, 0, 0, 0]
+
+
+def test_sum_always_matches_amount():
+    for amount in range(50):
+        for people in range(1, 9):
+            parts = split_evenly(amount, people)
+            assert len(parts) == people
+            assert sum(parts) == amount
+            assert max(parts) - min(parts) <= 1
+
+
+@pytest.mark.parametrize("people", [0, -1])
+def test_people_below_one_raises(people):
+    with pytest.raises(ValueError):
+        split_evenly(100, people)
diff --git a/tests/test_stats.py b/tests/test_stats.py
new file mode 100644
index 0000000..92da9c9
--- /dev/null
+++ b/tests/test_stats.py
@@ -0,0 +1,54 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.stats import median_by_category
+
+
+def _e(category: str, amount: int) -> Expense:
+    return Expense(date(2026, 11, 1), category, amount)
+
+
+def test_empty_returns_empty_dict():
+    assert median_by_category([]) == {}
+
+
+def test_single_row_is_its_own_median():
+    assert median_by_category([_e("food", 1200)]) == {"food": 1200.0}
+
+
+def test_odd_count_uses_middle_value():
+    rows = [_e("food", 300), _e("food", 100), _e("food", 200)]
+    assert median_by_category(rows) == {"food": 200.0}
+
+
+def test_even_count_averages_two_middle_values():
+    rows = [_e("food", 100), _e("food", 400), _e("food", 200), _e("food", 300)]
+    assert median_by_category(rows) == {"food": 250.0}
+
+
+def test_even_count_with_odd_sum_gives_fraction():
+    rows = [_e("food", 100), _e("food", 201)]
+    assert median_by_category(rows) == {"food": 150.5}
+
+
+def test_categories_are_medianed_separately():
+    rows = [_e("rent", 80000), _e("food", 1000), _e("food", 3000), _e("rent", 90000)]
+    assert median_by_category(rows) == {"food": 2000.0, "rent": 85000.0}
+
+
+def test_keys_are_sorted_by_category_name_not_by_value():
+    rows = [_e("rent", 80000), _e("food", 1000), _e("cafe", 500)]
+    result = median_by_category(rows)
+    assert list(result) == ["cafe", "food", "rent"]
+
+
+def test_result_does_not_depend_on_input_order():
+    rows = [_e("food", 300), _e("food", 100), _e("food", 200), _e("food", 400)]
+    assert median_by_category(rows) == median_by_category(list(reversed(rows)))
+
+
+def test_input_list_is_not_mutated():
+    rows = [_e("food", 300), _e("food", 100)]
+    before = list(rows)
+    median_by_category(rows)
+    assert rows == before
diff --git a/tests/test_streak.py b/tests/test_streak.py
new file mode 100644
index 0000000..1a13de2
--- /dev/null
+++ b/tests/test_streak.py
@@ -0,0 +1,57 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.streak import longest_no_spend_streak
+
+
+def _e(day: date, amount: int = 100) -> Expense:
+    return Expense(day=day, category="食費", amount=amount)
+
+
+def test_no_rows_whole_period_is_streak() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 1), date(2026, 1, 3)) == 3
+
+
+def test_single_day_without_rows_is_one() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 5), date(2026, 1, 5)) == 1
+
+
+def test_single_day_with_row_is_zero() -> None:
+    rows = [_e(date(2026, 1, 5))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 5), date(2026, 1, 5)) == 0
+
+
+def test_start_after_end_is_zero() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 5), date(2026, 1, 4)) == 0
+
+
+def test_spend_day_breaks_streak() -> None:
+    rows = [_e(date(2026, 1, 2))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 5)) == 3
+
+
+def test_longest_gap_is_returned_not_first() -> None:
+    # 1日と4日に支出 → 2-3日(2日) と 5-9日(5日) → 5
+    rows = [_e(date(2026, 1, 1)), _e(date(2026, 1, 4))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 9)) == 5
+
+
+def test_multiple_rows_same_day_count_once() -> None:
+    rows = [_e(date(2026, 1, 2), 100), _e(date(2026, 1, 2), 200)]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 5)) == 3
+
+
+def test_rows_outside_period_are_ignored() -> None:
+    rows = [_e(date(2025, 12, 31)), _e(date(2026, 1, 10))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 5)) == 5
+
+
+def test_spend_on_start_and_end_days() -> None:
+    rows = [_e(date(2026, 1, 1)), _e(date(2026, 1, 5))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 5)) == 3
+
+
+def test_consecutive_spend_days_do_not_create_extra_streaks() -> None:
+    # 2・3・6日に支出 → 1日(1)・4-5日(2)・7-8日(2) → 2
+    rows = [_e(date(2026, 1, 2)), _e(date(2026, 1, 3)), _e(date(2026, 1, 6))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 8)) == 2
diff --git a/tests/test_topn.py b/tests/test_topn.py
new file mode 100644
index 0000000..e5c4fbb
--- /dev/null
+++ b/tests/test_topn.py
@@ -0,0 +1,55 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.topn import top_expenses
+
+
+def _e(day: str, amount: int, category: str = "food", memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+def test_returns_largest_first() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 500), _e("2026-01-03", 300)]
+    assert [e.amount for e in top_expenses(rows, 2)] == [500, 300]
+
+
+def test_n_larger_than_rows_returns_all_sorted() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 500)]
+    assert [e.amount for e in top_expenses(rows, 10)] == [500, 100]
+
+
+def test_equal_amount_earlier_date_first() -> None:
+    rows = [_e("2026-03-01", 200, memo="late"), _e("2026-01-01", 200, memo="early")]
+    assert [e.memo for e in top_expenses(rows, 2)] == ["early", "late"]
+
+
+def test_equal_amount_and_date_keeps_input_order() -> None:
+    rows = [
+        _e("2026-01-01", 200, memo="first"),
+        _e("2026-01-01", 200, memo="second"),
+        _e("2026-01-01", 200, memo="third"),
+    ]
+    assert [e.memo for e in top_expenses(rows, 3)] == ["first", "second", "third"]
+
+
+def test_n_zero_returns_empty() -> None:
+    rows = [_e("2026-01-01", 100)]
+    assert top_expenses(rows, 0) == []
+
+
+def test_negative_n_returns_empty() -> None:
+    rows = [_e("2026-01-01", 100)]
+    assert top_expenses(rows, -3) == []
+
+
+def test_empty_rows_returns_empty() -> None:
+    assert top_expenses([], 5) == []
+
+
+def test_does_not_mutate_input() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 500)]
+    snapshot = list(rows)
+    top_expenses(rows, 2)
+    assert rows == snapshot
diff --git a/tests/test_weekday.py b/tests/test_weekday.py
new file mode 100644
index 0000000..b6ac5b5
--- /dev/null
+++ b/tests/test_weekday.py
@@ -0,0 +1,73 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.weekday import total_by_weekday
+
+
+def _e(day: date, amount: int, category: str = "食費") -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo="")
+
+
+def test_empty_rows_returns_empty_dict() -> None:
+    assert total_by_weekday([]) == {}
+
+
+def test_single_row_gives_its_weekday_only() -> None:
+    # 2026-11-18 は水曜日
+    assert total_by_weekday([_e(date(2026, 11, 18), 500)]) == {"Wed": 500}
+
+
+def test_same_weekday_rows_are_summed() -> None:
+    rows = [
+        _e(date(2026, 11, 18), 500),  # Wed
+        _e(date(2026, 11, 25), 300),  # Wed
+    ]
+    assert total_by_weekday(rows) == {"Wed": 800}
+
+
+def test_multiple_rows_on_same_day_are_summed() -> None:
+    rows = [_e(date(2026, 11, 16), 100), _e(date(2026, 11, 16), 250)]
+    assert total_by_weekday(rows) == {"Mon": 350}
+
+
+def test_weekdays_without_expenses_are_omitted() -> None:
+    rows = [_e(date(2026, 11, 16), 100), _e(date(2026, 11, 20), 200)]  # Mon, Fri
+    result = total_by_weekday(rows)
+    assert result == {"Mon": 100, "Fri": 200}
+    assert "Tue" not in result
+
+
+def test_keys_are_in_monday_first_order_regardless_of_input_order() -> None:
+    rows = [
+        _e(date(2026, 11, 22), 7),  # Sun
+        _e(date(2026, 11, 18), 3),  # Wed
+        _e(date(2026, 11, 16), 1),  # Mon
+        _e(date(2026, 11, 21), 6),  # Sat
+    ]
+    result = total_by_weekday(rows)
+    assert list(result) == ["Mon", "Wed", "Sat", "Sun"]
+    assert result == {"Mon": 1, "Wed": 3, "Sat": 6, "Sun": 7}
+
+
+def test_all_seven_weekdays_use_english_three_letter_keys() -> None:
+    rows = [_e(date(2026, 11, 16 + i), 10) for i in range(7)]  # Mon..Sun
+    result = total_by_weekday(rows)
+    assert list(result) == ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
+    assert all(v == 10 for v in result.values())
+
+
+def test_negative_amounts_are_summed_as_is() -> None:
+    rows = [_e(date(2026, 11, 16), 1000), _e(date(2026, 11, 23), -400)]  # Mon, Mon
+    assert total_by_weekday(rows) == {"Mon": 600}
+
+
+def test_category_does_not_affect_weekday_totals() -> None:
+    rows = [_e(date(2026, 11, 16), 100, "食費"), _e(date(2026, 11, 16), 200, "交通")]
+    assert total_by_weekday(rows) == {"Mon": 300}
+
+
+def test_input_rows_are_not_modified() -> None:
+    rows = [_e(date(2026, 11, 16), 100)]
+    before = list(rows)
+    total_by_weekday(rows)
+    assert rows == before
