diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
new file mode 100644
index 0000000..d0cf26d
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,95 @@
+"""前月比レポート: 月ごとのカテゴリ合計の差分を計算・整形する。"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def _month_of(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+
+    prev_totals: dict[str, int] = {}
+    curr_totals: dict[str, int] = {}
+    for e in rows:
+        m = _month_of(e)
+        if m == prev_month:
+            prev_totals[e.category] = prev_totals.get(e.category, 0) + e.amount
+        elif m == curr_month:
+            curr_totals[e.category] = curr_totals.get(e.category, 0) + e.amount
+
+    out: list[DiffRow] = []
+    for cat in set(prev_totals) | set(curr_totals):
+        # 判定は明細の有無で行う(合計が 0 かどうかではない)
+        prev_has = cat in prev_totals
+        curr_has = cat in curr_totals
+        prev = prev_totals.get(cat, 0)
+        curr = curr_totals.get(cat, 0)
+        delta = curr - prev
+        pct: float | None = None
+        if prev != 0:
+            # -0.0 を 0.0 に正規化する
+            pct = round(delta / prev * 100, 1) + 0.0
+        if not prev_has:
+            status = "new"
+        elif not curr_has:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+
+    out.sort(key=lambda r: (-abs(r.delta), r.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [r for r in diffs if r.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for r in diffs:
+        pct = "-" if r.pct is None else f"{r.pct + 0.0:+.1f}%"
+        lines.append(f"{r.category}\t{r.prev}\t{r.curr}\t{r.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month_of(e) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には明細のある月が 2 つ以上必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..f72dc44
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,161 @@
+"""Search query language: tokenizer, parser and evaluator for Expense rows.
+
+Grammar (lowest precedence first)::
+
+    or_expr  := and_expr ("OR" and_expr)*
+    and_expr := not_expr (["AND"] not_expr)*
+    not_expr := "NOT" not_expr | primary
+    primary  := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+class QueryError(ValueError):
+    """Raised when a query cannot be tokenized or parsed."""
+
+
+Token = tuple[str, str]
+
+_WORD_STOP = frozenset(' \t\r\n\f\v()"')
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    tokens: list[Token] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        ch = q[i]
+        if ch.isspace():
+            i += 1
+        elif ch == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif ch == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif ch == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError("閉じていない引用符があります")
+            body = q[i + 1 : end]
+            if body == "":
+                raise QueryError("空の引用符は使えません")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            start = i
+            while i < n and q[i] not in _WORD_STOP:
+                i += 1
+            word = q[start:i]
+            if word in ("AND", "OR", "NOT"):
+                tokens.append((word, word))
+            elif word.startswith("cat:"):
+                cat = word[len("cat:") :]
+                if cat == "":
+                    raise QueryError("cat: の後ろに値がありません")
+                tokens.append(("CAT", cat))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+# AST nodes: ("term", value) | ("cat", value) | ("not", node)
+#            | ("and", left, right) | ("or", left, right)
+Node = tuple
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self.tokens = tokens
+        self.pos = 0
+
+    def _peek(self) -> str | None:
+        return self.tokens[self.pos][0] if self.pos < len(self.tokens) else None
+
+    def _take(self, kind: str) -> Token:
+        if self._peek() != kind:
+            raise QueryError(f"{kind} が必要ですが {self._describe()} があります")
+        tok = self.tokens[self.pos]
+        self.pos += 1
+        return tok
+
+    def _describe(self) -> str:
+        if self.pos >= len(self.tokens):
+            return "入力の終わり"
+        return repr(self.tokens[self.pos][1])
+
+    def parse(self) -> Node:
+        if not self.tokens:
+            raise QueryError("クエリが空です")
+        node = self._or_expr()
+        if self.pos != len(self.tokens):
+            raise QueryError(f"予期しない {self._describe()} があります")
+        return node
+
+    def _or_expr(self) -> Node:
+        node = self._and_expr()
+        while self._peek() == "OR":
+            self._take("OR")
+            node = ("or", node, self._and_expr())
+        return node
+
+    def _and_expr(self) -> Node:
+        node = self._not_expr()
+        while True:
+            kind = self._peek()
+            if kind == "AND":
+                self._take("AND")
+                node = ("and", node, self._not_expr())
+            elif kind in ("TERM", "CAT", "NOT", "LPAREN"):
+                node = ("and", node, self._not_expr())
+            else:
+                return node
+
+    def _not_expr(self) -> Node:
+        if self._peek() == "NOT":
+            self._take("NOT")
+            return ("not", self._not_expr())
+        return self._primary()
+
+    def _primary(self) -> Node:
+        kind = self._peek()
+        if kind == "TERM":
+            return ("term", self._take("TERM")[1])
+        if kind == "CAT":
+            return ("cat", self._take("CAT")[1])
+        if kind == "LPAREN":
+            self._take("LPAREN")
+            node = self._or_expr()
+            self._take("RPAREN")
+            return node
+        raise QueryError(f"項が必要ですが {self._describe()} があります")
+
+
+def _parse(q: str) -> Node:
+    return _Parser(tokenize(q)).parse()
+
+
+def _eval(node: Node, e: Expense) -> bool:
+    kind = node[0]
+    if kind == "term":
+        needle = node[1].casefold()
+        return needle in e.memo.casefold() or needle in e.category.casefold()
+    if kind == "cat":
+        return node[1].casefold() == e.category.casefold()
+    if kind == "not":
+        return not _eval(node[1], e)
+    if kind == "and":
+        return _eval(node[1], e) and _eval(node[2], e)
+    return _eval(node[1], e) or _eval(node[2], e)
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _eval(_parse(q), e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    node = _parse(q)  # validate first so an invalid query fails even with no rows
+    return [e for e in rows if _eval(node, e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..4698cf6
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,64 @@
+"""Detect recurring (monthly) expenses."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day in the next month, clamped to that month's last day."""
+    year, month = (d.year + 1, 1) if d.month == 12 else (d.year, d.month + 1)
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def _runs(days: list[date], tolerance: int) -> list[list[date]]:
+    """Split sorted, unique dates into maximal runs of linked neighbours."""
+    runs: list[list[date]] = []
+    for d in days:
+        if runs and abs((d - add_month(runs[-1][-1])).days) <= tolerance:
+            runs[-1].append(d)
+        else:
+            runs.append([d])
+    return runs
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError("min_count は 2 以上である必要があります")
+    if tolerance < 0:
+        raise ValueError("tolerance は 0 以上である必要があります")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    result: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        for run in _runs(sorted(day_set), tolerance):
+            if len(run) >= min_count:
+                result.append(
+                    Recurring(
+                        category=category,
+                        amount=amount,
+                        days=tuple(run),
+                        next_expected=add_month(run[-1]),
+                    )
+                )
+
+    result.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return result
