+"""No-spend streak calculation."""
+
+from __future__ import annotations
+
+from datetime import date, timedelta
+
+from kakeibo.core import Expense
+
+
+def longest_no_spend_streak(rows: list[Expense], start: date, end: date) -> int:
+    """start〜end(両端含む)で明細が 1 件もない日の最長連続日数を返す。
+
+    start > end の場合は 0。同じ日に複数明細があっても 1 日として数える。
+    期間外の明細は無視する。
+    """
+    if start > end:
+        return 0
+    spend_days = {r.day for r in rows if start <= r.day <= end}
+    best = 0
+    current = 0
+    day = start
+    while day <= end:
+        if day in spend_days:
+            current = 0
+        else:
+            current += 1
+            best = max(best, current)
+        day += timedelta(days=1)
+    return best
diff --git a/src/kakeibo/topn.py b/src/kakeibo/topn.py
new file mode 100644
index 0000000..6d69b7e
--- /dev/null
+++ b/src/kakeibo/topn.py
@@ -0,0 +1,17 @@
+"""Top-N expense selection."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def top_expenses(rows: list[Expense], n: int) -> list[Expense]:
+    """金額の大きい順に n 件を返す。同額は日付の早い順、それも同じなら入力の順。
+
+    n が 0 以下なら空リスト。入力リストは変更しない。
+    """
+    if n <= 0:
+        return []
+    # sorted は安定ソートなので、同じ (金額, 日付) の要素は入力の順を保つ。
+    ordered = sorted(rows, key=lambda e: (-e.amount, e.day))
+    return ordered[:n]
