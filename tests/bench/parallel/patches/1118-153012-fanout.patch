diff --git a/src/kakeibo/bankimport.py b/src/kakeibo/bankimport.py
new file mode 100644
index 0000000..48b1770
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,112 @@
+"""Import bank statement CSV text into Expense records."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"-?[¥￥]?[0-9][0-9,]*円?")
+_DATE_RE = re.compile(
+    r"([0-9]{4})/([0-9]{1,2})/([0-9]{1,2})|([0-9]{4})-([0-9]{1,2})-([0-9]{1,2})"
+)
+
+
+def parse_amount(s: str) -> int:
+    """Parse a yen amount such as '¥1,234' or '980円' into an int."""
+    t = s.strip()
+    if not _AMOUNT_RE.fullmatch(t):
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    body = t.replace("¥", "").replace("￥", "").replace("円", "")
+    return int(body.replace(",", ""))
+
+
+def parse_date(s: str) -> date:
+    """Parse 'YYYY/M/D' or 'YYYY-M-D' into a date."""
+    t = s.strip()
+    m = _DATE_RE.fullmatch(t)
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    groups = m.groups()
+    y, mo, d = (groups[0], groups[1], groups[2]) if groups[0] else groups[3:6]
+    try:
+        return date(int(y), int(mo), int(d))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def _cell(row: list[str], index: dict[str, int], field: str) -> str:
+    """Value of `field` in `row`; missing column or short row gives ''."""
+    i = index.get(field)
+    if i is None or i >= len(row):
+        return ""
+    return row[i]
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Convert CSV text (header on line 1) into expenses.
+
+    Returns (valid expenses in input order, [(line_number, field), ...]).
+    Rows with any error are excluded from the expenses.
+    """
+    mp = DEFAULT_MAPPING if mapping is None else mapping
+    for key in ("date", "category", "amount"):
+        if key not in mp:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header = next(reader, None)
+    if header is None:
+        raise ValueError("ヘッダー行がありません")
+    for col in mp.values():
+        if col not in header:
+            raise ValueError(f"CSV にヘッダー列 {col!r} がありません")
+    index = {field: header.index(col) for field, col in mp.items()}
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    line = reader.line_num
+    for row in reader:
+        line_no = line + 1
+        line = reader.line_num
+        if row == [] or (len(row) == 1 and row[0].strip() == ""):
+            continue
+
+        row_errors = False
+        day = None
+        try:
+            day = parse_date(_cell(row, index, "date"))
+        except ValueError:
+            errors.append((line_no, "date"))
+            row_errors = True
+        amount = None
+        try:
+            amount = parse_amount(_cell(row, index, "amount"))
+        except ValueError:
+            errors.append((line_no, "amount"))
+            row_errors = True
+        category = _cell(row, index, "category").strip()
+        if category == "":
+            errors.append((line_no, "category"))
+            row_errors = True
+        if row_errors or day is None or amount is None:
+            continue
+        if category_map and category in category_map:
+            category = category_map[category]
+        memo = _cell(row, index, "memo").strip()
+        expenses.append(Expense(day=day, category=category, amount=amount, memo=memo))
+    return expenses, errors
diff --git a/src/kakeibo/dupes.py b/src/kakeibo/dupes.py
