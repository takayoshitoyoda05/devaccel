@@ -0,0 +1,15 @@
+"""Split an amount evenly among people."""
+
+from __future__ import annotations
+
+
+def split_evenly(amount: int, people: int) -> list[int]:
+    """Split ``amount`` yen among ``people``.
+
+    The remainder is distributed one yen at a time starting from the first person,
+    so the result always sums to ``amount``.
+    """
+    if people < 1:
+        raise ValueError("people must be >= 1")
+    base, remainder = divmod(amount, people)
+    return [base + 1 if i < remainder else base for i in range(people)]
