@@ -0,0 +1,61 @@
+from __future__ import annotations
+
+import json
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.export import to_json
+
+
+def test_empty_list_gives_empty_array() -> None:
+    assert to_json([]) == "[]"
+
+
+def test_single_row_has_fields_in_order() -> None:
+    out = to_json([Expense(date(2026, 1, 5), "食費", 1200, "昼")])
+    assert out == (
+        '[{"date": "2026-01-05", "category": "食費", "amount": 1200, "memo": "昼"}]'
+    )
+
+
+def test_keys_are_date_category_amount_memo_in_order() -> None:
+    out = to_json([Expense(date(2026, 3, 1), "交通", 300, "電車")])
+    assert list(json.loads(out)[0].keys()) == ["date", "category", "amount", "memo"]
+
+
+def test_input_order_is_preserved() -> None:
+    rows = [
+        Expense(date(2026, 2, 1), "B", 2),
+        Expense(date(2026, 1, 1), "A", 1),
+    ]
+    data = json.loads(to_json(rows))
+    assert [d["category"] for d in data] == ["B", "A"]
+
+
+def test_non_ascii_is_not_escaped() -> None:
+    out = to_json([Expense(date(2026, 1, 1), "食費", 1, "コンビニ")])
+    assert "食費" in out
+    assert "\\u" not in out
+
+
+def test_amount_stays_integer() -> None:
+    data = json.loads(to_json([Expense(date(2026, 1, 1), "A", 980)]))
+    assert data[0]["amount"] == 980
+    assert isinstance(data[0]["amount"], int)
+
+
+def test_empty_memo_is_empty_string() -> None:
+    data = json.loads(to_json([Expense(date(2026, 1, 1), "A", 1)]))
+    assert data[0]["memo"] == ""
+
+
+def test_date_is_zero_padded_iso() -> None:
+    data = json.loads(to_json([Expense(date(2026, 1, 9), "A", 1)]))
+    assert data[0]["date"] == "2026-01-09"
+
+
+def test_output_has_no_indentation() -> None:
+    out = to_json(
+        [Expense(date(2026, 1, 1), "A", 1), Expense(date(2026, 1, 2), "B", 2)]
+    )
+    assert "\n" not in out
