+++ b/tests/test_bankimport.py
@@ -0,0 +1,238 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+HEADER = "利用日,分類,利用金額,利用店名"
+
+
+# --- parse_amount ---
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥1234", 1234),
+        ("1,2,3", 123),  # カンマの位置は検査しない
+        ("-￥5", -5),
+        ("-0", 0),
+    ],
+)
+def test_parse_amount_accepts(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "   ",
+        "円",
+        "12.5",
+        "1 200",
+        "--5",
+        "¥-5",
+        "１２３",
+        "-",
+        "¥",
+        "5円円",
+        ",5",
+        "5¥",
+    ],
+)
+def test_parse_amount_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+# --- parse_date ---
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/12/31 ", date(2026, 12, 31)),
+        ("2026-1-5", date(2026, 1, 5)),
+        ("2024/02/29", date(2024, 2, 29)),
+    ],
+)
+def test_parse_date_accepts(text: str, expected: date) -> None:
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026/1-5",
+        "26/1/5",
+        "2026/02/30",
+        "",
+        "2026.1.5",
+        "２０２６/1/5",
+        "2026/13/1",
+        "2026/1/5/1",
+    ],
+)
+def test_parse_date_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+# --- import_rows ---
+
+
+def test_default_mapping_values() -> None:
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_import_basic_in_input_order() -> None:
+    text = f'{HEADER}\n2026/1/5,食費,"1,200",スーパー\n2026-01-06,交通,￥300,駅\n'
+    expenses, errors = import_rows(text)
+    assert errors == []
+    assert expenses == [
+        Expense(date(2026, 1, 5), "食費", 1200, "スーパー"),
+        Expense(date(2026, 1, 6), "交通", 300, "駅"),
+    ]
+
+
+def test_quoted_comma_in_memo() -> None:
+    text = f'{HEADER}\n2026/1/5,食費,100,"A, B"\n'
+    expenses, errors = import_rows(text)
+    assert errors == []
+    assert expenses[0].memo == "A, B"
+
+
+def test_extra_columns_ignored_and_memo_optional() -> None:
+    text = "利用日,分類,利用金額,無視,余分\n2026/1/5,食費,100,x,y\n"
+    expenses, errors = import_rows(
+        text, mapping={"date": "利用日", "category": "分類", "amount": "利用金額"}
+    )
+    assert errors == []
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+def test_custom_mapping_and_memo_missing_from_mapping() -> None:
+    text = "d,c,a\n2026/1/5,食費,100\n"
+    expenses, errors = import_rows(
+        text, mapping={"date": "d", "category": "c", "amount": "a"}
+    )
+    assert errors == []
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+def test_mapping_missing_required_key_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows(f"{HEADER}\n", mapping={"date": "利用日", "category": "分類"})
+
+
+def test_mapping_memo_is_optional_key() -> None:
+    expenses, errors = import_rows(
+        f"{HEADER}\n",
+        mapping={"date": "利用日", "category": "分類", "amount": "利用金額"},
+    )
+    assert expenses == [] and errors == []
+
+
+def test_mapping_column_not_in_header_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows(
+            "利用日,分類\n2026/1/5,食費\n",
+            mapping={"date": "利用日", "category": "分類", "amount": "利用金額"},
+        )
+
+
+def test_mapping_memo_column_missing_from_header_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows(
+            "利用日,分類,利用金額\n2026/1/5,食費,100\n", mapping=DEFAULT_MAPPING
+        )
+
+
+def test_default_mapping_none_uses_default() -> None:
+    expenses, _ = import_rows(f"{HEADER}\n2026/1/5,食費,100,店\n", mapping=None)
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "店")]
+
+
+def test_errors_recorded_per_field_in_order_and_row_excluded() -> None:
+    text = f"{HEADER}\nbad,,abc,店\n2026/1/5,食費,100,店\n"
+    expenses, errors = import_rows(text)
+    assert errors == [(2, "date"), (2, "amount"), (2, "category")]
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "店")]
+
+
+def test_single_error_excludes_row() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,abc,店\n"
+    expenses, errors = import_rows(text)
+    assert errors == [(2, "amount")]
+    assert expenses == []
+
+
+def test_category_blank_after_strip_is_error() -> None:
+    text = f"{HEADER}\n2026/1/5,   ,100,店\n"
+    expenses, errors = import_rows(text)
+    assert errors == [(2, "category")]
+    assert expenses == []
+
+
+def test_short_row_missing_values_are_empty() -> None:
+    text = f"{HEADER}\n2026/1/5\n"
+    expenses, errors = import_rows(text)
+    assert errors == [(2, "amount"), (2, "category")]
+    assert expenses == []
+
+
+def test_short_row_without_memo_gets_empty_memo() -> None:
+    text = "利用日,分類,利用金額,利用店名\n2026/1/5,食費,100\n"
+    expenses, errors = import_rows(text)
+    assert errors == []
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+def test_blank_lines_skipped_but_counted() -> None:
+    text = f"{HEADER}\n\n2026/1/5,食費,100,店\n\nbad,食費,100,店\n"
+    expenses, errors = import_rows(text)
+    assert errors == [(5, "date")]
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "店")]
+
+
+def test_line_number_is_physical_line_across_multiline_field() -> None:
+    text = f'{HEADER}\n2026/1/5,食費,100,"改行\nあり"\nbad,食費,100,店\n'
+    expenses, errors = import_rows(text)
+    assert errors == [(4, "date")]
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "改行\nあり")]
+
+
+def test_category_and_memo_stripped_and_category_map_applied() -> None:
+    text = f"{HEADER}\n2026/1/5, 食費 ,100, 店 \n2026/1/6,外食,200,店\n"
+    expenses, errors = import_rows(
+        text, category_map={"食費": "Food", "外食": "Dining"}
+    )
+    assert errors == []
+    assert expenses == [
+        Expense(date(2026, 1, 5), "Food", 100, "店"),
+        Expense(date(2026, 1, 6), "Dining", 200, "店"),
+    ]
+
+
+def test_category_map_not_applied_to_unlisted_category() -> None:
+    expenses, _ = import_rows(
+        f"{HEADER}\n2026/1/5,交通,100,店\n", category_map={"食費": "Food"}
+    )
+    assert expenses[0].category == "交通"
+
+
+def test_header_only_returns_empty() -> None:
+    assert import_rows(f"{HEADER}\n") == ([], [])
