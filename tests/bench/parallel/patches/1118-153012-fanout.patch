+from kakeibo.fmt import yen
+
+
+def test_thousands_separator_and_suffix():
+    assert yen(1234567) == "1,234,567円"
+
+
+def test_zero():
+    assert yen(0) == "0円"
+
+
+def test_below_one_thousand_has_no_separator():
+    assert yen(999) == "999円"
+
+
+def test_exactly_one_thousand():
+    assert yen(1000) == "1,000円"
+
+
+def test_negative_keeps_sign_before_digits():
+    assert yen(-1200) == "-1,200円"
+
+
+def test_negative_below_one_thousand():
+    assert yen(-5) == "-5円"
+
+
+def test_billions():
+    assert yen(1000000000) == "1,000,000,000円"
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..c930e91
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,223 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def e(y: int, m: int, cat: str, amount: int) -> Expense:
+    return Expense(date(y, m, 1), cat, amount)
+
+
+ROWS = [
+    e(2026, 1, "食費", 1000),
+    e(2026, 1, "交通", 500),
+    e(2026, 2, "食費", 1200),
+    e(2026, 2, "娯楽", 300),
+]
+
+
+def by_cat(diffs: list[DiffRow]) -> dict[str, DiffRow]:
+    return {d.category: d for d in diffs}
+
+
+# --- month_diff: 月の検証 ---
+
+
+@pytest.mark.parametrize(
+    "bad", ["2026-13", "2026-00", "2026-1", "2026/01", "26-01", "2026-01-01", ""]
+)
+def test_month_diff_rejects_bad_month_format(bad: str) -> None:
+    with pytest.raises(ValueError):
+        month_diff(ROWS, bad, "2026-02")
+    with pytest.raises(ValueError):
+        month_diff(ROWS, "2026-01", bad)
+
+
+# --- month_diff: status / 値 ---
+
+
+def test_status_up_down_new_gone() -> None:
+    d = by_cat(month_diff(ROWS, "2026-01", "2026-02"))
+    assert d["食費"] == DiffRow("食費", 1000, 1200, 200, 20.0, "up")
+    assert d["交通"] == DiffRow("交通", 500, 0, -500, -100.0, "gone")
+    assert d["娯楽"] == DiffRow("娯楽", 0, 300, 300, None, "new")
+
+
+def test_down_and_same() -> None:
+    rows = [
+        e(2026, 1, "A", 1000),
+        e(2026, 2, "A", 400),
+        e(2026, 1, "B", 50),
+        e(2026, 2, "B", 50),
+    ]
+    d = by_cat(month_diff(rows, "2026-01", "2026-02"))
+    assert d["A"].status == "down"
+    assert d["A"].pct == -60.0
+    assert d["B"].status == "same"
+    assert d["B"].delta == 0
+    assert d["B"].pct == 0.0
+
+
+def test_ignores_rows_outside_both_months() -> None:
+    rows = ROWS + [e(2025, 12, "古い", 9999), e(2026, 3, "未来", 9999)]
+    cats = {d.category for d in month_diff(rows, "2026-01", "2026-02")}
+    assert cats == {"食費", "交通", "娯楽"}
+
+
+def test_status_uses_presence_not_zero_total() -> None:
+    # prev に明細はあるが合計 0 -> gone ではなく up(prev 有・curr 有)、pct は None
+    rows = [e(2026, 1, "X", 100), e(2026, 1, "X", -100), e(2026, 2, "X", 500)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row.prev == 0
+    assert row.status == "up"
+    assert row.pct is None
+
+
+def test_new_with_zero_total_is_new_not_same() -> None:
+    rows = [e(2026, 2, "X", 100), e(2026, 2, "X", -100)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row.delta == 0
+    assert row.status == "new"
+
+
+def test_gone_with_zero_total_is_gone_not_same() -> None:
+    rows = [e(2026, 1, "X", 100), e(2026, 1, "X", -100)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row.status == "gone"
+
+
+def test_pct_rounding_to_one_decimal() -> None:
+    rows = [e(2026, 1, "A", 3000), e(2026, 2, "A", 1000)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row.pct == -66.7
+
+
+def test_negative_zero_pct_is_normalized() -> None:
+    # -1 / 100000 * 100 = -0.001 -> round で -0.0 になるが +0.0 に正規化
+    rows = [e(2026, 1, "A", 100000), e(2026, 2, "A", 99999)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row.pct == 0.0
+    assert str(row.pct) == "0.0"
+
+
+def test_empty_rows_gives_empty_list() -> None:
+    assert month_diff([], "2026-01", "2026-02") == []
+
+
+# --- month_diff: 並び順 ---
+
+
+def test_sorted_by_abs_delta_desc_then_category_asc() -> None:
+    rows = [
+        e(2026, 1, "b", 100),
+        e(2026, 2, "b", 200),  # delta +100
+        e(2026, 1, "a", 500),
+        e(2026, 2, "a", 400),  # delta -100
+        e(2026, 2, "c", 1000),  # delta +1000 (new)
+    ]
+    cats = [d.category for d in month_diff(rows, "2026-01", "2026-02")]
+    assert cats == ["c", "a", "b"]
+
+
+# --- top_movers ---
+
+
+def test_top_movers_excludes_same_and_keeps_order() -> None:
+    rows = [
+        e(2026, 1, "A", 100),
+        e(2026, 2, "A", 100),
+        e(2026, 1, "B", 0),
+        e(2026, 2, "B", 500),
+    ]
+    diffs = month_diff(rows, "2026-01", "2026-02")
+    assert [d.category for d in top_movers(diffs)] == ["B"]
+
+
+def test_top_movers_default_n_is_3() -> None:
+    rows = [e(2026, 2, f"c{i}", (i + 1) * 100) for i in range(5)]
+    diffs = month_diff(rows, "2026-01", "2026-02")
+    assert len(top_movers(diffs)) == 3
+    assert top_movers(diffs) == diffs[:3]
+
+
+def test_top_movers_n_zero_and_large() -> None:
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    assert top_movers(diffs, 0) == []
+    assert top_movers(diffs, 100) == diffs
+
+
+def test_top_movers_negative_n_raises() -> None:
+    with pytest.raises(ValueError):
+        top_movers(month_diff(ROWS, "2026-01", "2026-02"), -1)
+
+
+# --- render_diff ---
+
+
+def test_render_diff_format() -> None:
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    text = render_diff(diffs)
+    expected_lines = [
+        "category\tprev\tcurr\tdelta\tpct",
+        "交通\t500\t0\t-500\t-100.0%",
+        "娯楽\t0\t300\t+300\t-",
+        "食費\t1000\t1200\t+200\t+20.0%",
+    ]
+    assert (
+        text
+        == f"{expected_lines[0]}\n{expected_lines[1]}\n{expected_lines[2]}\n{expected_lines[3]}"
+    )
+    assert not text.endswith("\n")
+
+
+def test_render_diff_zero_delta_and_negative() -> None:
+    rows = [
+        e(2026, 1, "A", 100),
+        e(2026, 2, "A", 100),
+        e(2026, 1, "B", 100000),
+        e(2026, 2, "B", 99999),
+    ]
+    lines = render_diff(month_diff(rows, "2026-01", "2026-02")).split("\n")
+    assert lines[1:] == ["B\t100000\t99999\t-1\t+0.0%", "A\t100\t100\t+0\t+0.0%"]
+
+
+def test_render_diff_empty_is_header_only() -> None:
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+# --- available_months / latest_diff ---
+
+
+def test_available_months_sorted_unique() -> None:
+    rows = [
+        e(2026, 3, "A", 1),
+        e(2025, 12, "A", 1),
+        e(2026, 3, "B", 1),
+        e(2026, 1, "A", 1),
+    ]
+    assert available_months(rows) == ["2025-12", "2026-01", "2026-03"]
+
+
+def test_available_months_empty() -> None:
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months() -> None:
+    rows = ROWS + [e(2026, 3, "食費", 1500), e(2025, 12, "古い", 1)]
+    assert latest_diff(rows) == month_diff(rows, "2026-02", "2026-03")
+
+
+def test_latest_diff_needs_two_months() -> None:
+    with pytest.raises(ValueError):
+        latest_diff([])
+    with pytest.raises(ValueError):
+        latest_diff([e(2026, 1, "A", 1), e(2026, 1, "B", 2)])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..aeb5faf
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,214 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def _e(category, memo="", amount=100, day=date(2026, 11, 1)):
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+ROWS = [
+    _e("food", "lunch at Cafe"),
+    _e("Food", "groceries"),
+    _e("transport", "train to office"),
+    _e("food", ""),
+    _e("utilities", "electricity and gas"),
+]
+
+
+# --- tokenize ---------------------------------------------------------------
+
+
+def test_tokenize_skips_whitespace_and_splits_parens():
+    assert tokenize("  a  (b)\t") == [
+        ("TERM", "a"),
+        ("LPAREN", "("),
+        ("TERM", "b"),
+        ("RPAREN", ")"),
+    ]
+
+
+def test_tokenize_empty_and_blank_input_gives_no_tokens():
+    assert tokenize("") == []
+    assert tokenize("   ") == []
+
+
+def test_tokenize_quoted_term_keeps_spaces_and_parens_without_escape():
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+    assert tokenize('"a\\"') == [("TERM", "a\\")]
+
+
+def test_tokenize_unclosed_quote_is_error():
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_is_error():
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_operators_only_when_uppercase():
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+    assert tokenize("and or not") == [
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_cat_prefix():
+    assert tokenize("cat:food") == [("CAT", "food")]
+
+
+def test_tokenize_cat_with_empty_value_is_error():
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_tokenize_word_stops_at_quote_and_paren():
+    assert tokenize('abc"def"') == [("TERM", "abc"), ("TERM", "def")]
+    assert tokenize("(abc)") == [("LPAREN", "("), ("TERM", "abc"), ("RPAREN", ")")]
+
+
+def test_tokenize_cat_prefix_is_case_sensitive():
+    assert tokenize("CAT:food") == [("TERM", "CAT:food")]
+
+
+# --- parsing errors ----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(a",
+        "a)",
+        "a AND",
+        "OR a",
+        "a OR",
+        "a AND OR b",
+        "NOT",
+        "a NOT",
+        "(a OR)",
+        "a ) b",
+    ],
+)
+def test_malformed_queries_raise(q):
+    with pytest.raises(QueryError):
+        filter_rows(q, ROWS)
+
+
+def test_query_error_is_value_error():
+    assert issubclass(QueryError, ValueError)
+
+
+# --- evaluation --------------------------------------------------------------
+
+
+def test_term_matches_memo_or_category_substring():
+    assert matches("cafe", _e("food", "lunch at Cafe"))
+    assert matches("FOO", _e("food", ""))
+    assert not matches("train", _e("food", "lunch"))
+
+
+def test_term_casefold_is_applied_to_both_sides():
+    assert matches("STRASSE", _e("x", "straße"))  # casefold: ß -> ss
+    assert matches("ÉCOLE", _e("x", "école"))
+
+
+def test_cat_requires_full_category_match_case_insensitive():
+    assert matches("cat:food", _e("Food"))
+    assert not matches("cat:foo", _e("food"))
+    assert not matches("cat:food", _e("food-out"))
+
+
+def test_cat_does_not_match_memo():
+    assert not matches("cat:lunch", _e("food", "lunch"))
+
+
+def test_term_matches_category_too():
+    assert matches("transp", _e("transport"))
+
+
+def test_term_with_spaces_from_quotes():
+    assert matches('"lunch at"', _e("food", "lunch at Cafe"))
+    assert not matches('"at lunch"', _e("food", "lunch at Cafe"))
+
+
+def test_implicit_and_between_terms():
+    assert matches("lunch cafe", _e("food", "lunch at Cafe"))
+    assert not matches("lunch train", _e("food", "lunch at Cafe"))
+
+
+def test_explicit_and_equals_implicit():
+    q1 = filter_rows("food lunch", ROWS)
+    q2 = filter_rows("food AND lunch", ROWS)
+    assert q1 == q2 == [ROWS[0]]
+
+
+def test_or_matches_either_side():
+    assert filter_rows("cat:transport OR cat:utilities", ROWS) == [ROWS[2], ROWS[4]]
+
+
+def test_not_negates_primary():
+    assert filter_rows("NOT cat:food", ROWS) == [ROWS[2], ROWS[4]]
+
+
+def test_precedence_not_binds_tighter_than_and():
+    # NOT a b  ==  (NOT a) AND b
+    rows = [_e("food", "b"), _e("x", "a b"), _e("x", "b")]
+    assert filter_rows("NOT a b", rows) == [rows[0], rows[2]]
+
+
+def test_precedence_and_binds_tighter_than_or():
+    # a AND b OR c  ==  (a AND b) OR c
+    rows = [_e("x", "a b"), _e("x", "a"), _e("x", "c"), _e("x", "b")]
+    assert filter_rows("a AND b OR c", rows) == [rows[0], rows[2]]
+
+
+def test_parentheses_override_precedence():
+    rows = [_e("x", "a b"), _e("x", "a"), _e("x", "c"), _e("x", "b")]
+    assert filter_rows("a AND (b OR c)", rows) == [rows[0]]
+
+
+def test_double_not():
+    assert filter_rows("NOT NOT cat:food", ROWS) == [ROWS[0], ROWS[1], ROWS[3]]
+
+
+def test_not_followed_by_parenthesized_group():
+    assert filter_rows("NOT (cat:food OR cat:transport)", ROWS) == [ROWS[4]]
+
+
+def test_lowercase_or_is_a_term_not_operator():
+    assert filter_rows("cat:food or", ROWS) == []
+
+
+def test_filter_preserves_input_order():
+    rows = [_e("food", "b"), _e("food", "a"), _e("food", "b2")]
+    assert filter_rows("b", rows) == [rows[0], rows[2]]
+
+
+def test_filter_rows_empty_input_returns_empty():
+    assert filter_rows("food", []) == []
+
+
+def test_filter_rows_empty_input_still_validates_query():
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
+
+
+def test_matches_validates_query():
+    with pytest.raises(QueryError):
+        matches("a AND", _e("food"))
+
+
+def test_empty_memo_only_matches_category_terms():
+    row = _e("food", "")
+    assert matches("food", row)
+    assert not matches("lunch", row)
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..6d30edc
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,254 @@
+"""Tests for recurring expense detection."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def e(day: str, category: str = "通信", amount: int = 1000, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+# --- add_month ---------------------------------------------------------------
+
+
+def test_add_month_same_day() -> None:
+    assert add_month(date(2026, 3, 10)) == date(2026, 4, 10)
+
+
+def test_add_month_clamps_to_end_of_february_non_leap() -> None:
+    assert add_month(date(2026, 1, 31)) == date(2026, 2, 28)
+
+
+def test_add_month_clamps_to_end_of_february_leap() -> None:
+    assert add_month(date(2024, 1, 31)) == date(2024, 2, 29)
+
+
+def test_add_month_mid_month_december_rolls_year() -> None:
+    assert add_month(date(2026, 12, 15)) == date(2027, 1, 15)
+
+
+def test_add_month_clamps_30_day_month() -> None:
+    assert add_month(date(2026, 3, 31)) == date(2026, 4, 30)
+
+
+# --- find_recurring: validation ----------------------------------------------
+
+
+def test_min_count_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+
+
+def test_negative_tolerance_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_zero_tolerance_is_allowed() -> None:
+    assert find_recurring([], tolerance=0) == []
+
+
+# --- find_recurring: basic behaviour ------------------------------------------
+
+
+def test_empty_input_returns_empty() -> None:
+    assert find_recurring([]) == []
+
+
+def test_three_monthly_payments_detected() -> None:
+    rows = [e("2026-01-05"), e("2026-02-05"), e("2026-03-05")]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="通信",
+            amount=1000,
+            days=(date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+            next_expected=date(2026, 4, 5),
+        )
+    ]
+
+
+def test_two_payments_below_default_min_count_not_reported() -> None:
+    rows = [e("2026-01-05"), e("2026-02-05")]
+    assert find_recurring(rows) == []
+
+
+def test_two_payments_reported_when_min_count_is_two() -> None:
+    rows = [e("2026-01-05"), e("2026-02-05")]
+    result = find_recurring(rows, min_count=2)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5))
+    assert result[0].next_expected == date(2026, 3, 5)
+
+
+def test_memo_is_ignored_for_grouping() -> None:
+    rows = [
+        e("2026-01-05", memo="a"),
+        e("2026-02-05", memo="b"),
+        e("2026-03-05", memo=""),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_different_amount_is_a_different_group() -> None:
+    rows = [
+        e("2026-01-05", amount=1000),
+        e("2026-02-05", amount=1001),
+        e("2026-03-05", amount=1000),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_different_category_is_a_different_group() -> None:
+    rows = [
+        e("2026-01-05", category="A"),
+        e("2026-02-05", category="B"),
+        e("2026-03-05", category="A"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_duplicate_dates_in_group_are_collapsed() -> None:
+    rows = [
+        e("2026-01-05"),
+        e("2026-01-05"),
+        e("2026-02-05"),
+        e("2026-03-05"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_duplicates_alone_do_not_meet_min_count() -> None:
+    rows = [e("2026-01-05"), e("2026-01-05"), e("2026-01-05")]
+    assert find_recurring(rows) == []
+
+
+def test_input_order_does_not_matter() -> None:
+    rows = [e("2026-03-05"), e("2026-01-05"), e("2026-02-05")]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+# --- find_recurring: tolerance and chain breaks -------------------------------
+
+
+def test_within_tolerance_is_linked() -> None:
+    # 2026-02-08 is 3 days after the expected 2026-02-05 -> still linked
+    rows = [e("2026-01-05"), e("2026-02-08"), e("2026-03-08")]
+    result = find_recurring(rows, tolerance=3)
+    assert len(result) == 1
+
+
+def test_earlier_than_tolerance_is_linked() -> None:
+    # 2026-02-02 is 3 days before the expected 2026-02-05 -> still linked
+    rows = [e("2026-01-05"), e("2026-02-02"), e("2026-03-02")]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+
+
+def test_beyond_tolerance_breaks_chain() -> None:
+    # 2026-02-09 is 4 days after 2026-02-05 -> not linked, so no run of 3
+    rows = [e("2026-01-05"), e("2026-02-09"), e("2026-03-09")]
+    assert find_recurring(rows, tolerance=3) == []
+
+
+def test_zero_tolerance_requires_exact_day() -> None:
+    rows = [e("2026-01-05"), e("2026-02-06"), e("2026-03-05")]
+    assert find_recurring(rows, tolerance=0) == []
+
+
+def test_chain_is_split_at_break_and_only_long_runs_kept() -> None:
+    # run 1: Jan, Feb, Mar (length 3, kept); break; run 2: Oct, Nov (length 2, dropped)
+    rows = [
+        e("2026-01-05"),
+        e("2026-02-05"),
+        e("2026-03-05"),
+        e("2026-10-05"),
+        e("2026-11-05"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_two_separate_runs_both_kept() -> None:
+    rows = [
+        e("2026-01-05"),
+        e("2026-02-05"),
+        e("2026-03-05"),
+        e("2026-08-05"),
+        e("2026-09-05"),
+        e("2026-10-05"),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 5), date(2026, 8, 5)]
+
+
+def test_link_uses_add_month_of_previous_date_with_clamp() -> None:
+    # 2026-01-31 -> expected 2026-02-28; 2026-02-28 -> expected 2026-03-28
+    rows = [e("2026-01-31"), e("2026-02-28"), e("2026-03-28")]
+    result = find_recurring(rows, tolerance=0)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 28)
+
+
+def test_next_expected_is_add_month_of_last_date() -> None:
+    rows = [e("2026-10-31"), e("2026-11-30"), e("2026-12-30")]
+    result = find_recurring(rows, tolerance=0)
+    assert result[0].next_expected == date(2027, 1, 30)
+
+
+# --- find_recurring: ordering -------------------------------------------------
+
+
+def test_results_sorted_by_category_then_amount_then_first_day() -> None:
+    rows = [
+        e("2026-01-05", category="B", amount=500),
+        e("2026-02-05", category="B", amount=500),
+        e("2026-03-05", category="B", amount=500),
+        e("2026-01-10", category="A", amount=900),
+        e("2026-02-10", category="A", amount=900),
+        e("2026-03-10", category="A", amount=900),
+        e("2026-01-20", category="A", amount=100),
+        e("2026-02-20", category="A", amount=100),
+        e("2026-03-20", category="A", amount=100),
+    ]
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [
+        ("A", 100),
+        ("A", 900),
+        ("B", 500),
+    ]
+
+
+def test_same_category_and_amount_sorted_by_first_day() -> None:
+    # same group, two separate runs -> ordered by days[0]
+    rows = [
+        e("2026-08-05"),
+        e("2026-09-05"),
+        e("2026-10-05"),
+        e("2026-01-05"),
+        e("2026-02-05"),
+        e("2026-03-05"),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 5), date(2026, 8, 5)]
+
+
+def test_min_count_larger_than_run_excludes_it() -> None:
+    rows = [e("2026-01-05"), e("2026-02-05"), e("2026-03-05")]
+    assert find_recurring(rows, min_count=4) == []
+
+
+def test_recurring_is_frozen() -> None:
+    r = Recurring("通信", 1000, (date(2026, 1, 5),), date(2026, 2, 5))
+    with pytest.raises(AttributeError):
+        r.amount = 2000  # type: ignore[misc]
diff --git a/tests/test_split.py b/tests/test_split.py
new file mode 100644
