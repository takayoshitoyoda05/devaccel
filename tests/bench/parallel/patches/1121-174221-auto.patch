diff --git a/src/kakeibo/core.py b/src/kakeibo/core.py
index 8c3cbab..69ed2e5 100644
--- a/src/kakeibo/core.py
+++ b/src/kakeibo/core.py
@@ -1,4 +1,14 @@
-"""Expense records and aggregation."""
+"""Expense records and aggregation.
+
+予算警告の扱い:
+D1: 割合 = 実績 ÷ 予算 × 100、小数点以下切り捨ての整数 %。
+D2: 超過(実績 > 予算)は「警告」に割合を添える。予算 0 は割合が出せないので添えない。
+D3: 予算の 90% 以上〜100% 以下(ちょうど予算も含む)は「注意」。超過とは別の行。
+D4: 予算 0 のカテゴリは注意の対象外(実績 0 でも注意にしない。実績 > 0 なら超過)。
+D5: 90% の判定は整数比較(実績×100 >= 予算×90)。89.9% は注意にならない。
+D6: 出力は警告(月順)のあとに注意(月順)。予算のないカテゴリは対象外。
+D7: find_cautions の threshold は bool/非整数を TypeError、1〜100 外を ValueError。
+"""
 
 from __future__ import annotations
 
@@ -122,6 +132,35 @@ def load_budget(path: Path) -> Budget:
     return Budget(default, months)
 
 
+def percent_of(actual: int, limit: int) -> int | None:
+    """実績が予算の何 % か(小数点以下切り捨て)。予算 0 は None。"""
+    if limit == 0:
+        return None
+    return actual * 100 // limit
+
+
+def find_cautions(
+    totals: dict[str, dict[str, int]], budget: Budget, threshold: int = 90
+) -> list[tuple[str, str, int, int, int]]:
+    """(month, category, limit, actual, percent) for threshold% <= usage <= 100%.
+
+    超過(actual > limit)は含めない(find_overruns の担当)。予算 0 は対象外。
+    比較は整数のまま行う(actual*100 >= limit*threshold)ので丸めで境界がずれない。
+    """
+    if isinstance(threshold, bool) or not isinstance(threshold, int):
+        raise TypeError("threshold は整数である必要があります")
+    if not 1 <= threshold <= 100:
+        raise ValueError("threshold は 1〜100 である必要があります")
+    out: list[tuple[str, str, int, int, int]] = []
+    for month, cats in totals.items():
+        limits = budget.for_month(month)
+        for cat, actual in cats.items():
+            limit = limits.get(cat)
+            if limit and actual <= limit and actual * 100 >= limit * threshold:
+                out.append((month, cat, limit, actual, actual * 100 // limit))
+    return out
+
+
 def find_overruns(
     totals: dict[str, dict[str, int]], budget: Budget
 ) -> list[tuple[str, str, int, int, int]]:
