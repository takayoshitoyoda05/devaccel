index 0000000..1d296f7
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,111 @@
+"""Import expense rows from another bank's CSV export."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_FIELDS = ("date", "category", "amount", "memo")
+_REQUIRED = ("date", "category", "amount")
+
+# 任意の "-" → 任意の "¥" / "￥" → ASCII 数字で始まる数字とカンマ → 任意の "円"
+_AMOUNT_RE = re.compile(r"(-?)[¥￥]?([0-9][0-9,]*)円?")
+# 年 4 桁、月日 1〜2 桁、区切りは "/" か "-" のどちらか一方で統一
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    """Parse a yen amount such as "￥1,234" or "-300円" into an int."""
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    sign, digits = m.groups()
+    value = int(digits.replace(",", ""))
+    return -value if sign else value
+
+
+def parse_date(s: str) -> date:
+    """Parse "YYYY/M/D" or "YYYY-M-D" into a date."""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    year, _sep, month, day = m.groups()
+    try:
+        return date(int(year), int(month), int(day))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def _cell(row: list[str], idx: dict[str, int], field: str) -> str:
+    i = idx.get(field)
+    if i is None or i >= len(row):
+        return ""
+    return row[i]
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Convert a bank CSV (header on line 1) into Expenses.
+
+    Returns (imported expenses in input order, errors as (physical line, field)).
+    Rows with any error are left out of the expenses.
+    """
+    cols = DEFAULT_MAPPING if mapping is None else mapping
+    for key in _REQUIRED:
+        if key not in cols:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header = next(reader, [])
+    for field in _FIELDS:
+        if field in cols and cols[field] not in header:
+            raise ValueError(f"ヘッダーに列 {cols[field]!r} がありません")
+    idx = {field: header.index(cols[field]) for field in _FIELDS if field in cols}
+    cmap = category_map or {}
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    while True:
+        line = reader.line_num + 1  # 記録の開始行(引用符内の改行を考慮)
+        row = next(reader, None)
+        if row is None:
+            break
+        if not any(c.strip() for c in row):
+            continue  # 空行
+
+        day: date | None
+        amount: int | None
+        try:
+            day = parse_date(_cell(row, idx, "date"))
+        except ValueError:
+            errors.append((line, "date"))
+            day = None
+        try:
+            amount = parse_amount(_cell(row, idx, "amount"))
+        except ValueError:
+            errors.append((line, "amount"))
+            amount = None
+        category = _cell(row, idx, "category").strip()
+        if not category:
+            errors.append((line, "category"))
+
+        if day is None or amount is None or not category:
+            continue
+        category = cmap.get(category, category)
+        memo = _cell(row, idx, "memo").strip()
+        expenses.append(Expense(day=day, category=category, amount=amount, memo=memo))
+    return expenses, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
