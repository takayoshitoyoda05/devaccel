+"""Tests for kakeibo.search (R1–R7, E3-1..E3-12, P1–P3)."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import Cond, filter_expenses
+
+
+def e(day: str, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+# E3-1: R1, R6
+def test_E3_1_category_exact_keeps_input_order() -> None:
+    rows = [
+        e("2024-01-01", "食費", 1000),
+        e("2024-01-02", "交通", 500),
+        e("2024-01-03", "食費", 300),
+    ]
+    out = filter_expenses(rows, Cond(category="食費"))
+    assert out == [rows[0], rows[2]]
+
+
+# E3-2: R2
+def test_E3_2_amount_range_inclusive() -> None:
+    rows = [
+        e("2024-01-01", "a", 500),
+        e("2024-01-02", "a", 1000),
+        e("2024-01-03", "a", 1001),
+    ]
+    out = filter_expenses(rows, Cond(min_amount=500, max_amount=1000))
+    assert out == [rows[0], rows[1]]
+
+
+# E3-3: R2 (negative amounts compared as-is)
+def test_E3_3_negative_refund_in_range() -> None:
+    rows = [e("2024-01-01", "a", -300), e("2024-01-02", "a", 200)]
+    out = filter_expenses(rows, Cond(min_amount=-500, max_amount=0))
+    assert out == [rows[0]]
+
+
+# E3-4: R2 (min > max is empty, no exception)
+def test_E3_4_min_greater_than_max_is_empty() -> None:
+    rows = [e("2024-01-01", "a", 700)]
+    assert filter_expenses(rows, Cond(min_amount=1000, max_amount=500)) == []
+
+
+# E3-5: R3 (case sensitive)
+def test_E3_5_memo_contains_is_case_sensitive() -> None:
+    rows = [
+        e("2024-01-01", "a", 1, "Lunch"),
+        e("2024-01-02", "a", 1, "ランチ"),
+        e("2024-01-03", "a", 1, ""),
+    ]
+    assert filter_expenses(rows, Cond(memo_contains="lunch")) == []
+
+
+# E3-6: R3 (partial match; empty string matches all)
+def test_E3_6_memo_contains_partial_and_empty() -> None:
+    rows = [e("2024-01-01", "a", 1, "ランチ代"), e("2024-01-02", "a", 1, "夕食")]
+    assert filter_expenses(rows, Cond(memo_contains="ランチ")) == [rows[0]]
+    assert filter_expenses(rows, Cond(memo_contains="")) == rows
+
+
+# E3-7: R4 (leap day, inclusive both ends)
+def test_E3_7_period_inclusive_across_leap_day() -> None:
+    rows = [
+        e("2024-02-28", "a", 1),
+        e("2024-02-29", "a", 1),
+        e("2024-03-01", "a", 1),
+    ]
+    out = filter_expenses(rows, Cond(start=date(2024, 2, 29), end=date(2024, 3, 1)))
+    assert out == [rows[1], rows[2]]
+
+
+# E3-8: R4 (start > end empty; one-sided bounds)
+def test_E3_8_start_after_end_is_empty() -> None:
+    rows = [e("2024-01-31", "a", 1)]
+    assert (
+        filter_expenses(rows, Cond(start=date(2024, 2, 1), end=date(2024, 1, 1))) == []
+    )
+
+
+def test_E3_8_only_start_bound() -> None:
+    rows = [e("2024-01-31", "a", 1)]
+    assert filter_expenses(rows, Cond(start=date(2024, 1, 31))) == rows
+
+
+# E3-9: R5 all_of
+def test_E3_9_all_of_requires_every_child() -> None:
+    rows = [
+        e("2024-01-01", "食費", 300),
+        e("2024-01-02", "食費", 800),
+        e("2024-01-03", "交通", 900),
+    ]
+    cond = Cond(all_of=(Cond(category="食費"), Cond(min_amount=500)))
+    assert filter_expenses(rows, cond) == [rows[1]]
+
+
+# E3-10: R5, R6 any_of keeps input order
+def test_E3_10_any_of_matches_one_child_in_input_order() -> None:
+    rows = [
+        e("2024-01-01", "食費", 1),
+        e("2024-01-02", "交通", 1),
+        e("2024-01-03", "日用品", 1),
+    ]
+    cond = Cond(any_of=(Cond(category="食費"), Cond(category="交通")))
+    assert filter_expenses(rows, cond) == [rows[0], rows[1]]
+
+
+# E3-11: R5 leaf fields AND any_of
+def test_E3_11_leaf_and_any_of_combined_with_and() -> None:
+    rows = [
+        e("2024-01-01", "食費", 300, "外食"),
+        e("2024-01-02", "食費", 300, ""),
+        e("2024-01-03", "交通", 900, "外食"),
+    ]
+    cond = Cond(
+        category="食費", any_of=(Cond(min_amount=500), Cond(memo_contains="外食"))
+    )
+    assert filter_expenses(rows, cond) == [rows[0]]
+
+
+# E3-12: R5, R6, R7 empty composition means no condition
+def test_E3_12_empty_cond_on_empty_rows() -> None:
+    assert filter_expenses([], Cond()) == []
+    assert filter_expenses([], Cond(all_of=(), any_of=())) == []
+
+
+def test_E3_12_empty_cond_and_empty_composition_pass_all() -> None:
+    rows = [e("2024-01-01", "a", 1), e("2024-01-02", "b", 2)]
+    assert filter_expenses(rows, Cond()) == rows
+    assert filter_expenses(rows, Cond(all_of=(), any_of=())) == rows
+
+
+# Nested composition (R5 入れ子可)
+def test_nested_all_of_inside_any_of() -> None:
+    rows = [
+        e("2024-01-01", "食費", 800),
+        e("2024-01-02", "食費", 100),
+        e("2024-01-03", "交通", 900),
+        e("2024-01-04", "交通", 100),
+    ]
+    cond = Cond(
+        any_of=(
+            Cond(all_of=(Cond(category="食費"), Cond(min_amount=500))),
+            Cond(all_of=(Cond(category="交通"), Cond(max_amount=200))),
+        )
+    )
+    assert filter_expenses(rows, cond) == [rows[0], rows[3]]
+
+
+# P1 / P2 / P3 invariants and R6 new list
+@pytest.mark.parametrize(
+    "cond",
+    [
+        Cond(),
+        Cond(category="食費"),
+        Cond(any_of=(Cond(category="交通"), Cond(min_amount=500))),
+    ],
+)
+def test_P1_output_is_subsequence_of_input(cond: Cond) -> None:
+    rows = [
+        e("2024-01-01", "食費", 1000),
+        e("2024-01-02", "交通", 500),
+        e("2024-01-03", "食費", 300),
+    ]
+    out = filter_expenses(rows, cond)
+    it = iter(rows)
+    assert all(any(x is y for y in it) for x in out)
+
+
+def test_P2_empty_cond_returns_equal_new_list() -> None:
+    rows = [e("2024-01-01", "a", 1), e("2024-01-02", "b", 2)]
+    out = filter_expenses(rows, Cond())
+    assert out == rows
+    assert out is not rows
+
+
+def test_P3_input_rows_not_mutated() -> None:
+    rows = [e("2024-01-01", "食費", 1000), e("2024-01-02", "交通", 500)]
+    snapshot = list(rows)
+    filter_expenses(rows, Cond(category="食費"))
+    assert rows == snapshot
