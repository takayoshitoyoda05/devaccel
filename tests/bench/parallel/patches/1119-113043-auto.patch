@@ -0,0 +1,143 @@
+"""Tests for month-over-month comparison (E4-1 .. E4-8, P1 .. P4)."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.month_compare import CategoryDiff, compare_months, format_report
+
+
+def e(y: int, m: int, cat: str, amount: int) -> Expense:
+    return Expense(day=date(y, m, 15), category=cat, amount=amount)
+
+
+# (ID, rows, month, expected) — 例の表 E4-1〜E4-6 の全行
+COMPARE_CASES = [
+    pytest.param(
+        [
+            e(2026, 1, "食費", 10000),
+            e(2026, 1, "交通", 5000),
+            e(2026, 2, "食費", 12000),
+            e(2026, 2, "交通", 3000),
+        ],
+        "2026-02",
+        [
+            CategoryDiff("交通", 5000, 3000, -2000, -40.0),
+            CategoryDiff("食費", 10000, 12000, 2000, 20.0),
+        ],
+        id="E4-1",
+    ),
+    pytest.param(
+        [e(2026, 1, "光熱", 8000), e(2026, 2, "娯楽", 3000)],
+        "2026-02",
+        [
+            CategoryDiff("光熱", 8000, 0, -8000, -100.0),
+            CategoryDiff("娯楽", 0, 3000, 3000, None),
+        ],
+        id="E4-2",
+    ),
+    pytest.param(
+        [e(2025, 12, "食費", 1000), e(2026, 1, "食費", 1500)],
+        "2026-01",
+        [CategoryDiff("食費", 1000, 1500, 500, 50.0)],
+        id="E4-3",
+    ),
+    pytest.param(
+        [
+            e(2026, 1, "食費", 10000),
+            e(2026, 1, "食費", -2000),
+            e(2026, 2, "食費", 8000),
+        ],
+        "2026-02",
+        [CategoryDiff("食費", 8000, 8000, 0, 0.0)],
+        id="E4-4",
+    ),
+    pytest.param(
+        [e(2026, 1, "食費", -500), e(2026, 2, "食費", 1000)],
+        "2026-02",
+        [CategoryDiff("食費", -500, 1000, 1500, None)],
+        id="E4-5",
+    ),
+    pytest.param(
+        [e(2025, 12, "食費", 1000), e(2026, 3, "食費", 2000)],
+        "2026-02",
+        [],
+        id="E4-6",
+    ),
+    pytest.param([], "2026-02", [], id="E4-6-empty"),
+]
+
+
+@pytest.mark.parametrize(("rows", "month", "expected"), COMPARE_CASES)
+def test_compare_months_examples(
+    rows: list[Expense], month: str, expected: list[CategoryDiff]
+) -> None:
+    assert compare_months(rows, month) == expected
+
+
+@pytest.mark.parametrize(
+    "month",
+    [
+        pytest.param("2026-13", id="E4-7"),
+        pytest.param("2026-1", id="E4-7-short"),
+        pytest.param("", id="E4-7-empty"),
+    ],
+)
+def test_invalid_month_raises(month: str) -> None:
+    with pytest.raises(ValueError):
+        compare_months([], month)
+
+
+@pytest.mark.parametrize(
+    ("diffs", "expected"),
+    [
+        pytest.param(
+            [
+                CategoryDiff("交通", 5000, 3000, -2000, -40.0),
+                CategoryDiff("食費", 10000, 12000, 2000, 20.0),
+            ],
+            "交通: 5,000 → 3,000 (-2,000, -40.0%)\n食費: 10,000 → 12,000 (+2,000, +20.0%)",
+            id="E4-8",
+        ),
+        pytest.param(
+            [
+                CategoryDiff("光熱", 8000, 0, -8000, -100.0),
+                CategoryDiff("娯楽", 0, 3000, 3000, None),
+            ],
+            "光熱: 8,000 → 0 (-8,000, -100.0%)\n娯楽: 0 → 3,000 (+3,000, n/a)",
+            id="E4-8-na",
+        ),
+        pytest.param([], "差分なし", id="E4-8-empty"),
+    ],
+)
+def test_format_report_examples(diffs: list[CategoryDiff], expected: str) -> None:
+    assert format_report(diffs) == expected
+
+
+def test_invariants_P1_to_P4() -> None:
+    rows = [
+        e(2026, 1, "食費", 10000),
+        e(2026, 1, "食費", -2000),
+        e(2026, 1, "交通", 5000),
+        e(2026, 2, "食費", 8000),
+        e(2026, 2, "光熱", 3000),
+        e(2026, 2, "娯楽", 0),
+        e(2026, 3, "食費", 99999),
+    ]
+    snapshot = list(rows)
+    result = compare_months(rows, "2026-02")
+
+    # P1: diff == cur - prev
+    assert all(d.diff == d.cur - d.prev for d in result)
+    # P2: rate is None exactly when prev <= 0
+    assert all((d.rate is None) == (d.prev <= 0) for d in result)
+    # P3: sorted by abs(diff) desc, categories unique
+    assert [abs(d.diff) for d in result] == sorted(
+        (abs(d.diff) for d in result), reverse=True
+    )
+    assert len({d.category for d in result}) == len(result)
+    # P4: rows unchanged
+    assert rows == snapshot
