index 0000000..f865f0e
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,51 @@
+"""Search expenses with composable conditions (AND / OR)."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Cond:
+    """Condition. Leaf fields are ANDed; all_of / any_of are nested conditions.
+
+    Unset (None) leaf fields are ignored. Empty all_of / any_of impose no constraint.
+    A non-empty any_of requires at least one child to match.
+    """
+
+    category: str | None = None
+    min_amount: int | None = None
+    max_amount: int | None = None
+    memo_contains: str | None = None
+    start: date | None = None
+    end: date | None = None
+    all_of: tuple[Cond, ...] = ()
+    any_of: tuple[Cond, ...] = ()
+
+
+def _leaf_match(e: Expense, cond: Cond) -> bool:
+    if cond.category is not None and e.category != cond.category:
+        return False
+    if cond.min_amount is not None and e.amount < cond.min_amount:
+        return False
+    if cond.max_amount is not None and e.amount > cond.max_amount:
+        return False
+    if cond.memo_contains is not None and cond.memo_contains not in e.memo:
+        return False
+    if cond.start is not None and e.day < cond.start:
+        return False
+    return cond.end is None or e.day <= cond.end
+
+
+def _matches(e: Expense, cond: Cond) -> bool:
+    all_ok = all(_matches(e, child) for child in cond.all_of)
+    any_ok = not cond.any_of or any(_matches(e, child) for child in cond.any_of)
+    return _leaf_match(e, cond) and all_ok and any_ok
+
+
+def filter_expenses(rows: list[Expense], cond: Cond) -> list[Expense]:
+    """Return a new list of matching rows, preserving input order."""
+    return [e for e in rows if _matches(e, cond)]
