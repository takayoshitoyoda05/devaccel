@@ -0,0 +1,180 @@
+"""Tests for kakeibo.recurring (定期支出の検出と次回予想日)."""
+
+from __future__ import annotations
+
+import itertools
+import random
+from collections.abc import Callable
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, predict_next
+
+
+def ex(day: str, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+def rent(*days: str) -> list[Expense]:
+    return [ex(d, "住居", 80000, "家賃") for d in days]
+
+
+def _e1_1() -> None:
+    rows = rent("2026-10-05", "2026-11-05", "2026-12-05") + [
+        ex("2026-10-20", "通信", 4000, "ネット"),
+        ex("2026-11-20", "通信", 4000, "ネット"),
+        ex("2026-12-20", "通信", 4000, "ネット"),
+    ]
+    result = find_recurring(rows)
+    assert [(r.category, r.amount, r.last_day) for r in result] == [
+        ("住居", 80000, date(2026, 12, 5)),
+        ("通信", 4000, date(2026, 12, 20)),
+    ]
+    assert result[0].months == ("2026-10", "2026-11", "2026-12")
+    assert predict_next(result[0]) == date(2027, 1, 5)
+
+
+def _e1_2() -> None:
+    # 空入力
+    assert find_recurring([]) == []
+    # 同キーが連続 2 か月だけ
+    assert find_recurring(rent("2026-01-05", "2026-02-05")) == []
+
+
+def _e1_3() -> None:
+    # 3 月が欠ける: 区間は 4 月のみ
+    assert find_recurring(rent("2026-01-05", "2026-02-05", "2026-04-05")) == []
+
+
+def _e1_4() -> None:
+    def series(a: int, b: int, c: int) -> list[Expense]:
+        return [
+            ex("2026-01-10", "雑費", a, "洗剤"),
+            ex("2026-02-10", "雑費", b, "洗剤"),
+            ex("2026-03-10", "雑費", c, "洗剤"),
+        ]
+
+    assert find_recurring(series(1000, 1000, 1200)) == []
+    result = find_recurring(series(1000, 1080, 1100))
+    assert [r.amount for r in result] == [1100]
+
+
+def _e1_5() -> None:
+    plain = [
+        ex("2026-01-03", "娯楽", 1500, "Netflix 2026-01"),
+        ex("2026-02-03", "娯楽", 1500, "Netflix  2026-02"),
+        ex("2026-03-03", "娯楽", 1500, "Netflix2026-03"),
+    ]
+    result = find_recurring(plain)
+    assert len(result) == 1
+    assert result[0].memo == "Netflix"
+
+    mixed = [
+        ex("2026-01-03", "娯楽", 1500, "Netflix 2026-01"),
+        ex("2026-02-03", "娯楽", 1500, "Netflix　２０２６-02"),
+        ex("2026-03-03", "娯楽", 1500, "Netflix２０２６－０３"),
+    ]
+    assert [r.memo for r in find_recurring(mixed)] == ["Netflix"]
+
+
+def _e1_6() -> None:
+    rows = rent("2026-01-05", "2026-03-05") + [
+        ex("2026-02-05", "住居", 80000, "家賃"),
+        ex("2026-02-06", "住居", -80000, "家賃"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].months == ("2026-01", "2026-02", "2026-03")
+
+
+def _e1_7() -> None:
+    rows = [
+        ex("2026-01-01", "雑費", 500, "電池"),
+        ex("2026-01-15", "雑費", 500, "電池"),
+        ex("2026-02-01", "雑費", 1000, "電池"),
+        ex("2026-03-01", "雑費", 1000, "電池"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].amount == 1000
+
+
+def _e1_8() -> None:
+    def r(last_day: date) -> Recurring:
+        return Recurring(
+            category="x",
+            memo="y",
+            amount=1,
+            months=("2026-01", "2026-02", "2026-03"),
+            last_day=last_day,
+        )
+
+    assert predict_next(r(date(2026, 1, 31))) == date(2026, 2, 28)
+    assert predict_next(r(date(2028, 1, 31))) == date(2028, 2, 29)
+
+
+@pytest.mark.parametrize(
+    "check",
+    [
+        pytest.param(_e1_1, id="E1-1"),
+        pytest.param(_e1_2, id="E1-2"),
+        pytest.param(_e1_3, id="E1-3"),
+        pytest.param(_e1_4, id="E1-4"),
+        pytest.param(_e1_5, id="E1-5"),
+        pytest.param(_e1_6, id="E1-6"),
+        pytest.param(_e1_7, id="E1-7"),
+        pytest.param(_e1_8, id="E1-8"),
+    ],
+)
+def test_examples_table(check: Callable[[], None]) -> None:
+    check()
+
+
+# --- 追加の規則と不変条件 -------------------------------------------------
+
+
+def test_R7_december_rolls_over_to_january() -> None:
+    r = Recurring(
+        category="x",
+        memo="y",
+        amount=1,
+        months=("2026-10", "2026-11", "2026-12"),
+        last_day=date(2026, 12, 31),
+    )
+    assert predict_next(r) == date(2027, 1, 31)
+
+
+def test_R2_zero_amount_rows_are_ignored() -> None:
+    rows = rent("2026-01-05", "2026-02-05", "2026-03-05") + [
+        ex("2026-03-06", "住居", 0, "家賃")
+    ]
+    result = find_recurring(rows)
+    assert result[0].last_day == date(2026, 3, 5)
+
+
+def test_P1_order_independent_and_input_not_mutated() -> None:
+    rows = rent("2026-10-05", "2026-11-05", "2026-12-05") + [
+        ex("2026-10-20", "通信", 4000, "ネット"),
+        ex("2026-11-20", "通信", 4000, "ネット"),
+        ex("2026-12-20", "通信", 4000, "ネット"),
+    ]
+    snapshot = list(rows)
+    expected = find_recurring(rows)
+    shuffled = list(rows)
+    random.Random(0).shuffle(shuffled)
+    assert find_recurring(shuffled) == expected
+    assert rows == snapshot
+
+
+def test_P2_P3_invariants_hold() -> None:
+    rows = rent("2026-10-05", "2026-11-05", "2026-12-05", "2027-01-05")
+    for r in find_recurring(rows):
+        assert len(r.months) >= 3
+        y_m = [(int(m[:4]), int(m[5:])) for m in r.months]
+        for (y1, m1), (y2, m2) in itertools.pairwise(y_m):
+            assert (y1 * 12 + m1) + 1 == y2 * 12 + m2
+        assert predict_next(r) > r.last_day
