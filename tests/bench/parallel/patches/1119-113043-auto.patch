--- /dev/null
+++ b/src/kakeibo/bank_import.py
@@ -0,0 +1,187 @@
+"""Import bank-statement style CSV text into Expense records.
+
+Pure functions: the caller passes text, nothing is read from disk.
+Bad rows never raise; they are collected in ImportResult.errors (D3).
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+UNCATEGORIZED = "未分類"
+_SPLIT_COLUMN = "出金/入金"
+
+# role -> accepted header names (compared after NFKC, strip, lower)
+_ALIASES: dict[str, tuple[str, ...]] = {
+    "date": ("日付", "利用日", "date"),
+    "memo": ("摘要", "内容", "メモ", "description"),
+    "amount": ("金額", "amount"),
+    "withdrawal": ("出金", "withdrawal"),
+    "deposit": ("入金", "deposit"),
+    "category": ("カテゴリ", "category"),
+}
+
+_DATE_SEP_RE = re.compile(r"(\d{4})([-/])(\d{1,2})\2(\d{1,2})")
+_DATE_KANJI_RE = re.compile(r"(\d{4})年(\d{1,2})月(\d{1,2})日")
+_AMOUNT_RE = re.compile(r"[+-]?\d+")
+_AMOUNT_NOISE_RE = re.compile(r"[¥円,\s]")
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+
+
+class _RowFault(Exception):
+    def __init__(self, column: str, reason: str) -> None:
+        super().__init__(reason)
+        self.column = column
+        self.reason = reason
+
+
+def _norm(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip().lower()
+
+
+def _resolve(header: list[str]) -> dict[str, tuple[int, str]]:
+    """role -> (column index, header name as written). First occurrence wins."""
+    out: dict[str, tuple[int, str]] = {}
+    for idx, name in enumerate(header):
+        key = _norm(name)
+        for role, aliases in _ALIASES.items():
+            if role not in out and key in aliases:
+                out[role] = (idx, name.strip())
+    return out
+
+
+def _to_date(raw: str) -> date:
+    s = unicodedata.normalize("NFKC", raw).strip()
+    m = _DATE_SEP_RE.fullmatch(s)
+    if m is not None:
+        year, month, day = m.group(1), m.group(3), m.group(4)
+    else:
+        k = _DATE_KANJI_RE.fullmatch(s)
+        if k is None:
+            raise ValueError("日付の形式が不正です")
+        year, month, day = k.group(1), k.group(2), k.group(3)
+    try:
+        return date(int(year), int(month), int(day))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {raw!r}") from None
+
+
+def _to_yen(raw: str) -> int:
+    s = _AMOUNT_NOISE_RE.sub("", unicodedata.normalize("NFKC", raw))
+    if s == "":
+        raise ValueError("金額が空です")
+    if not _AMOUNT_RE.fullmatch(s):
+        raise ValueError(f"金額が整数ではありません: {raw!r}")
+    return int(s)
+
+
+def _parse_row(row: list[str], mapping: dict[str, tuple[int, str]]) -> Expense:
+    def cell(role: str) -> str:
+        return row[mapping[role][0]] if role in mapping else ""
+
+    def col(role: str) -> str:
+        return mapping[role][1] if role in mapping else role
+
+    try:
+        day = _to_date(cell("date"))
+    except ValueError as e:
+        raise _RowFault(col("date"), str(e)) from None
+
+    if "amount" in mapping:
+        try:
+            amount = _to_yen(cell("amount"))
+        except ValueError as e:
+            raise _RowFault(col("amount"), str(e)) from None
+    else:
+        withdrawal = cell("withdrawal").strip()
+        deposit = cell("deposit").strip()
+        if bool(withdrawal) == bool(deposit):
+            raise _RowFault(
+                _SPLIT_COLUMN, "出金と入金はどちらか一方だけに金額を入れてください"
+            )
+        try:
+            if withdrawal:
+                amount = _to_yen(withdrawal)
+            else:
+                amount = -_to_yen(deposit)
+        except ValueError as e:
+            name = col("withdrawal") if withdrawal else col("deposit")
+            raise _RowFault(name, str(e)) from None
+
+    category = cell("category").strip() or UNCATEGORIZED
+    return Expense(day=day, category=category, amount=amount, memo=cell("memo"))
+
+
+def import_rows(text: str) -> ImportResult:
+    """Parse CSV text (header on line 1). Never raises."""
+    text = text.removeprefix("﻿")
+    reader = csv.reader(io.StringIO(text, newline=""))
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+
+    header: list[str] = []
+    mapping: dict[str, tuple[int, str]] = {}
+    seen_header = False
+
+    while True:
+        start = reader.line_num + 1
+        try:
+            row = next(reader)
+        except StopIteration:
+            break
+        except csv.Error as e:
+            errors.append(RowError(start, "-", f"CSV として読めません: {e}"))
+            break
+
+        if not seen_header:
+            seen_header = True
+            header = row
+            mapping = _resolve(header)
+            if "date" not in mapping:
+                return ImportResult([], [RowError(1, "日付", "日付列がありません")])
+            if not {"amount", "withdrawal", "deposit"} & mapping.keys():
+                return ImportResult(
+                    [], [RowError(1, "金額", "金額列(金額/出金/入金)がありません")]
+                )
+            continue
+
+        if not row or (len(row) == 1 and not row[0].strip()):
+            continue  # blank line
+
+        if len(row) != len(header):
+            errors.append(
+                RowError(
+                    start,
+                    "-",
+                    f"列数がヘッダと一致しません({len(row)} 列、期待 {len(header)} 列)",
+                )
+            )
+            continue
+
+        try:
+            expenses.append(_parse_row(row, mapping))
+        except _RowFault as f:
+            errors.append(RowError(start, f.column, f.reason))
+
+    if not seen_header:
+        return ImportResult([], [RowError(1, "日付", "日付列がありません")])
+    return ImportResult(expenses, errors)
