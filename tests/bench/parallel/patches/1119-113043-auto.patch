+"""Tests for kakeibo.bank_import (E2-1..E2-8 and invariants P1-P4)."""
+
+from __future__ import annotations
+
+from datetime import date
+
+from kakeibo.bank_import import RowError, import_rows
+from kakeibo.core import Expense
+
+
+def test_E2_1_bom_is_removed_and_quoted_yen_amount_is_parsed() -> None:
+    """E2-1: BOM+`Date,Description,Amount` / `2024-01-31,Coffee,"¥1,200"` -> 1 expense (R1,R2)."""
+    result = import_rows('﻿Date,Description,Amount\n2024-01-31,Coffee,"¥1,200"\n')
+    assert result.expenses == [Expense(date(2024, 1, 31), "未分類", 1200, "Coffee")]
+    assert result.errors == []
+
+
+def test_E2_2_fullwidth_leap_day_and_amount_are_normalized() -> None:
+    """E2-2: `日付,摘要,金額` / `2024/２/29,昼食,１２００` -> 2024-02-29, 1200 (R2,R4)."""
+    result = import_rows("日付,摘要,金額\n2024/２/29,昼食,１２００\n")
+    assert result.expenses == [Expense(date(2024, 2, 29), "未分類", 1200, "昼食")]
+    assert result.errors == []
+
+
+def test_E2_3_withdrawal_positive_and_deposit_negative() -> None:
+    """E2-3: 出金 500 / 入金 300 in separate rows -> amounts 500 and -300 (R3)."""
+    text = "日付,摘要,出金,入金\n2024-01-01,A,500,\n2024-01-02,B,,300\n"
+    result = import_rows(text)
+    assert [e.amount for e in result.expenses] == [500, -300]
+    assert result.errors == []
+
+
+def test_E2_4_both_withdrawal_and_deposit_is_row_error() -> None:
+    """E2-4: 出金 500 and 入金 300 on the same row -> expenses=[], error line 2 column 出金/入金 (R3,R6)."""
+    result = import_rows("日付,摘要,出金,入金\n2024-01-01,C,500,300\n")
+    assert result.expenses == []
+    assert len(result.errors) == 1
+    err = result.errors[0]
+    assert (err.line, err.column) == (2, "出金/入金")
+    assert err.reason
+
+
+def test_E2_5_quoted_memo_with_comma_and_newline_is_one_field() -> None:
+    """E2-5: memo `"a,b` + newline + `c"` is one record -> memo "a,b\\nc" (R5)."""
+    result = import_rows('日付,摘要,金額\n2024-01-01,"a,b\nc",100\n')
+    assert result.expenses == [Expense(date(2024, 1, 1), "未分類", 100, "a,b\nc")]
+    assert result.errors == []
+
+
+def test_E2_5_line_numbers_after_multiline_record_are_physical() -> None:
+    """E2-5 (line numbering): a row after a 2-line quoted record is reported at its physical line 4 (R6)."""
+    result = import_rows('日付,摘要,金額\n2024-01-01,"a,b\nc",100\n2023-02-29,x,1\n')
+    assert len(result.expenses) == 1
+    assert [e.line for e in result.errors] == [4]
+
+
+def test_E2_6_blank_lines_are_skipped_silently() -> None:
+    """E2-6: header + blank line + normal row -> 1 expense, errors=[] (R5)."""
+    result = import_rows("日付,摘要,金額\n\n2024-01-01,x,100\n")
+    assert result.expenses == [Expense(date(2024, 1, 1), "未分類", 100, "x")]
+    assert result.errors == []
+
+
+def test_E2_7_bad_rows_are_reported_and_good_rows_kept() -> None:
+    """E2-7: invalid date (3), short row (4), decimal amount (5) -> errors in line order (R2,R4,R6)."""
+    text = (
+        "日付,摘要,金額\n"
+        "2024-01-01,ok,100\n"
+        "2023-02-29,x,100\n"
+        "2024-01-02,z\n"
+        "2024-01-01,y,12.5\n"
+    )
+    result = import_rows(text)
+    assert result.expenses == [Expense(date(2024, 1, 1), "未分類", 100, "ok")]
+    assert [(e.line, e.column) for e in result.errors] == [
+        (3, "日付"),
+        (4, "-"),
+        (5, "金額"),
+    ]
+    assert all(e.reason for e in result.errors)
+
+
+def test_E2_8_missing_amount_column_returns_header_error() -> None:
+    """E2-8: header `日付,摘要` only (no amount column) -> expenses=[], errors=[(1,"金額",理由)] (R7)."""
+    result = import_rows("日付,摘要\n2024-01-01,x\n")
+    assert result.expenses == []
+    assert len(result.errors) == 1
+    err = result.errors[0]
+    assert (err.line, err.column) == (1, "金額")
+    assert err.reason
+
+
+def test_R4_kanji_date_with_fullwidth_digits_is_accepted() -> None:
+    """R4: `YYYY年M月D日` (full-width digits allowed) is accepted."""
+    result = import_rows("日付,摘要,金額\n２０２４年１月５日,x,100\n")
+    assert result.expenses == [Expense(date(2024, 1, 5), "未分類", 100, "x")]
+    assert result.errors == []
+
+
+def test_R4_nonexistent_date_is_error_not_exception() -> None:
+    """R4: 2023-02-29 is an error on the date column (P1: no exception)."""
+    result = import_rows("日付,摘要,金額\n2023-02-29,x,100\n")
+    assert result.expenses == []
+    assert result.errors == [RowError(2, "日付", result.errors[0].reason)]
+
+
+def test_R1_category_column_is_used_when_present() -> None:
+    """R1: カテゴリ column is read; absent column falls back to 未分類."""
+    result = import_rows("日付,摘要,金額,カテゴリ\n2024-01-01,x,100,食費\n")
+    assert result.expenses == [Expense(date(2024, 1, 1), "食費", 100, "x")]
+
+
+def test_R3_single_amount_column_keeps_negative_sign() -> None:
+    """R3: a single 金額 column keeps the sign as-is (negative = refund)."""
+    result = import_rows("日付,摘要,金額\n2024-01-01,返金,-300\n")
+    assert [e.amount for e in result.expenses] == [-300]
+
+
+def test_R3_both_split_columns_empty_is_error() -> None:
+    """R3: both 出金 and 入金 empty -> error column 出金/入金."""
+    result = import_rows("日付,摘要,出金,入金\n2024-01-01,x,,\n")
+    assert result.expenses == []
+    assert [(e.line, e.column) for e in result.errors] == [(2, "出金/入金")]
+
+
+def test_P1_malformed_input_never_raises() -> None:
+    """P1: unclosed quotes and NUL bytes do not raise."""
+    for text in [
+        '日付,摘要,金額\n2024-01-01,"unclosed,100\n',
+        "日付,摘要,金額\n\x00,a,b\n",
+        "",
+    ]:
+        result = import_rows(text)
+        assert isinstance(result.errors, list)
+
+
+def test_P2_P3_P4_invariants_on_mixed_input() -> None:
+    """P2: data rows == len(expenses)+len(errors); P3: error lines ascending; P4: amount is int."""
+    text = (
+        "日付,摘要,金額\n"
+        "2024-01-01,ok,100\n"
+        "2023-02-29,x,100\n"
+        "\n"
+        "2024-01-02,z\n"
+        "2024-01-01,y,12.5\n"
+    )
+    result = import_rows(text)
+    data_rows = 4
+    assert len(result.expenses) + len(result.errors) == data_rows
+    lines = [e.line for e in result.errors]
+    assert lines == sorted(lines)
+    assert all(type(e.amount) is int for e in result.expenses)
