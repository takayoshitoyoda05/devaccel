+++ b/src/kakeibo/month_compare.py
@@ -0,0 +1,64 @@
+"""Month-over-month comparison of expenses by category."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-[0-9]{2}")
+
+
+@dataclass(frozen=True)
+class CategoryDiff:
+    category: str
+    prev: int
+    cur: int
+    diff: int
+    rate: float | None
+
+
+def _parse_month(month: str) -> tuple[int, int]:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"month は YYYY-MM 形式である必要があります: {month!r}")
+    year, mon = int(month[:4]), int(month[5:])
+    if not 1 <= mon <= 12:
+        raise ValueError(f"月は 1〜12 の範囲である必要があります: {month!r}")
+    return year, mon
+
+
+def compare_months(rows: list[Expense], month: str) -> list[CategoryDiff]:
+    year, mon = _parse_month(month)
+    prev_key = (year - 1, 12) if mon == 1 else (year, mon - 1)
+    cur_key = (year, mon)
+
+    prev_totals: dict[str, int] = {}
+    cur_totals: dict[str, int] = {}
+    for e in rows:
+        key = (e.day.year, e.day.month)
+        if key == prev_key:
+            prev_totals[e.category] = prev_totals.get(e.category, 0) + e.amount
+        elif key == cur_key:
+            cur_totals[e.category] = cur_totals.get(e.category, 0) + e.amount
+
+    diffs: list[CategoryDiff] = []
+    for cat in set(prev_totals) | set(cur_totals):
+        prev = prev_totals.get(cat, 0)
+        cur = cur_totals.get(cat, 0)
+        diff = cur - prev
+        rate = round(diff / prev * 100, 1) + 0.0 if prev > 0 else None
+        diffs.append(CategoryDiff(cat, prev, cur, diff, rate))
+
+    diffs.sort(key=lambda d: (-abs(d.diff), d.category))
+    return diffs
+
+
+def format_report(diffs: list[CategoryDiff]) -> str:
+    if not diffs:
+        return "差分なし"
+    lines = []
+    for d in diffs:
+        rate = "n/a" if d.rate is None else f"{d.rate:+.1f}%"
+        lines.append(f"{d.category}: {d.prev:,} → {d.cur:,} ({d.diff:+,}, {rate})")
+    return "\n".join(lines)
