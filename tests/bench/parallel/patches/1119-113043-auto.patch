--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,90 @@
+"""Detect recurring expenses (定期支出) and predict their next date."""
+
+from __future__ import annotations
+
+import calendar
+import re
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+# 空白(全角空白含む)・数字(全角含む)・ハイフン(半角/全角)を除く。
+# 「2026-01」のような年月表記の区切りも除くため、ハイフンも対象にする。
+_STRIP_RE = re.compile(r"[\s\d\-－]")
+
+_MIN_RUN = 3
+_TOLERANCE_PERCENT = 10
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str  # 正規化後のメモ
+    amount: int  # 最新月の金額(円)
+    months: tuple[str, ...]  # "YYYY-MM" 昇順
+    last_day: date  # 最新月の最新日
+
+
+def _normalize(memo: str) -> str:
+    return _STRIP_RE.sub("", memo)
+
+
+def _month_key(d: date) -> str:
+    return f"{d.year:04d}-{d.month:02d}"
+
+
+def _prev_month(month: str) -> str:
+    y, m = int(month[:4]), int(month[5:])
+    if m == 1:
+        return f"{y - 1:04d}-12"
+    return f"{y:04d}-{m - 1:02d}"
+
+
+def find_recurring(rows: list[Expense]) -> list[Recurring]:
+    # (category, 正規化メモ) -> {月: (合計金額, 最新日)}
+    buckets: dict[tuple[str, str], dict[str, tuple[int, date]]] = {}
+    for e in rows:
+        if e.amount <= 0:  # 返金・取消・0 円は対象外
+            continue
+        key = (e.category, _normalize(e.memo))
+        month = _month_key(e.day)
+        months = buckets.setdefault(key, {})
+        total, last = months.get(month, (0, e.day))
+        months[month] = (total + e.amount, max(last, e.day))
+
+    result: list[Recurring] = []
+    for (category, memo), months in buckets.items():
+        latest = max(months)
+        amount, last_day = months[latest]
+        run = [latest]
+        cur = latest
+        while True:
+            prev = _prev_month(cur)
+            if prev not in months:
+                break
+            prev_amount = months[prev][0]
+            if abs(prev_amount - amount) * 10 > amount:  # ±10% を超えたら区間終了
+                break
+            run.append(prev)
+            cur = prev
+        if len(run) >= _MIN_RUN:
+            result.append(
+                Recurring(
+                    category=category,
+                    memo=memo,
+                    amount=amount,
+                    months=tuple(sorted(run)),
+                    last_day=last_day,
+                )
+            )
+
+    result.sort(key=lambda r: (r.category, r.memo))
+    return result
+
+
+def predict_next(r: Recurring) -> date:
+    d = r.last_day
+    y, m = (d.year + 1, 1) if d.month == 12 else (d.year, d.month + 1)
+    last = calendar.monthrange(y, m)[1]
+    return date(y, m, min(d.day, last))
