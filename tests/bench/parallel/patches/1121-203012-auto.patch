diff --git a/src/kakeibo/core.py b/src/kakeibo/core.py
index 8c3cbab..257d4a3 100644
--- a/src/kakeibo/core.py
+++ b/src/kakeibo/core.py
@@ -133,3 +133,30 @@ def find_overruns(
             if cat in limits and actual > limits[cat]:
                 out.append((month, cat, actual - limits[cat], limits[cat], actual))
     return out
+
+
+NOTICE_PERCENT = 90
+
+
+def find_budget_alerts(
+    totals: dict[str, dict[str, int]], budget: Budget
+) -> list[tuple[str, str, str, int, int, int | None]]:
+    """(kind, month, category, limit, actual, tenths) in month/category order.
+
+    kind is "over" (actual > limit) or "notice" (limit > 0 and actual is at
+    least NOTICE_PERCENT% of limit, not over). tenths is the usage percent
+    in 0.1% units, rounded down (None when limit is 0).
+    """
+    out: list[tuple[str, str, str, int, int, int | None]] = []
+    for month, cats in totals.items():
+        limits = budget.for_month(month)
+        for cat, actual in cats.items():
+            if cat not in limits:
+                continue
+            limit = limits[cat]
+            tenths = actual * 1000 // limit if limit > 0 else None
+            if actual > limit:
+                out.append(("over", month, cat, limit, actual, tenths))
+            elif limit > 0 and actual * 100 >= limit * NOTICE_PERCENT:
+                out.append(("notice", month, cat, limit, actual, tenths))
+    return out
