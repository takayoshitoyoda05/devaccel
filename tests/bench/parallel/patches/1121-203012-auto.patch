+def _alerts(totals, default):
+    from kakeibo.core import Budget, find_budget_alerts
+
+    return [
+        (k, m, c) for k, m, c, *_ in find_budget_alerts(totals, Budget(default, {}))
+    ]
+
+
+def test_alerts_threshold_boundaries():
+    totals = {
+        "2026-11": {"a": 899, "b": 900, "c": 1000, "d": 1001, "e": 5, "f": 0, "g": 0}
+    }
+    default = {"a": 1000, "b": 1000, "c": 1000, "d": 1000, "f": 1000, "g": 0}
+    # a: 89.9% 対象外 / b: ちょうど 90% 注意 / c: ちょうど 100% 注意 / d: 超過
+    # e: 予算なし対象外 / f: 0% 対象外 / g: 上限 0・実績 0 は対象外
+    assert _alerts(totals, default) == [
+        ("notice", "2026-11", "b"),
+        ("notice", "2026-11", "c"),
+        ("over", "2026-11", "d"),
+    ]
+
+
+def test_alerts_zero_limit_overrun_has_no_percent():
+    from kakeibo.core import Budget, find_budget_alerts
+
+    got = find_budget_alerts({"2026-11": {"x": 10}}, Budget({"x": 0}, {}))
+    assert got == [("over", "2026-11", "x", 0, 10, None)]
+
+
+def test_alerts_percent_rounds_down():
+    from kakeibo.core import Budget, find_budget_alerts
+
+    got = find_budget_alerts({"2026-11": {"x": 9999}}, Budget({"x": 10000}, {}))
+    assert got == [("notice", "2026-11", "x", 10000, 9999, 999)]  # 99.9%
+
+
