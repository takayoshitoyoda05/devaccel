+from datetime import date
+
+import pytest
+
+from kakeibo.core import CsvError, Expense, load_csv, monthly_totals
+
+HEADER = "date,category,amount,memo\n"
+
+
+def _write(tmp_path, text, header=HEADER):
+    p = tmp_path / "in.csv"
+    p.write_text(header + text, encoding="utf-8", newline="")
+    return p
+
+
+# ---- load_csv ----
+
+
+def test_load_csv_header_only_is_empty(tmp_path):
+    assert load_csv(_write(tmp_path, "")) == []
+
+
+def test_load_csv_completely_empty_file_is_empty(tmp_path):
+    assert load_csv(_write(tmp_path, "", header="")) == []
+
+
+def test_load_csv_skips_blank_lines(tmp_path):
+    rows = load_csv(_write(tmp_path, "\n2026-11-01,food,100,\n\n"))
+    assert rows == [Expense(date(2026, 11, 1), "food", 100)]
+
+
+def test_load_csv_strips_category_whitespace(tmp_path):
+    rows = load_csv(_write(tmp_path, "2026-11-01,  food ,100,\n"))
+    assert rows[0].category == "food"
+
+
+def test_load_csv_memo_optional_and_quoted_comma(tmp_path):
+    rows = load_csv(
+        _write(tmp_path, '2026-11-01,food,100\n2026-11-02,food,200,"a,b"\n')
+    )
+    assert [r.memo for r in rows] == ["", "a,b"]
+
+
+def test_load_csv_negative_and_zero_amounts_accepted(tmp_path):
+    rows = load_csv(_write(tmp_path, "2026-11-01,food,-300,\n2026-11-02,food,0,\n"))
+    assert [r.amount for r in rows] == [-300, 0]
+
+
+@pytest.mark.parametrize("amount", ["1,200", "12.5", "", "1e3", "¥100"])
+def test_load_csv_rejects_non_integer_amount(tmp_path, amount):
+    with pytest.raises(CsvError) as ei:
+        load_csv(_write(tmp_path, f'2026-11-01,food,"{amount}",\n'))
+    assert [line for line, _ in ei.value.errors] == [2]
+
+
+@pytest.mark.parametrize("day", ["2026/11/01", "2026-02-30", "2026-13-01", ""])
+def test_load_csv_rejects_bad_date(tmp_path, day):
+    with pytest.raises(CsvError) as ei:
+        load_csv(_write(tmp_path, f"{day},food,100,\n"))
+    assert [line for line, _ in ei.value.errors] == [2]
+
+
+def test_load_csv_leap_day(tmp_path):
+    rows = load_csv(_write(tmp_path, "2028-02-29,food,100,\n"))
+    assert rows[0].day == date(2028, 2, 29)
+
+
+def test_load_csv_line_number_after_multiline_memo(tmp_path):
+    body = '2026-11-01,food,100,"line1\nline2"\nbad,food,100,\n'
+    with pytest.raises(CsvError) as ei:
+        load_csv(_write(tmp_path, body))
+    assert [line for line, _ in ei.value.errors] == [4]
+
+
+def test_load_csv_missing_required_column_in_header(tmp_path):
+    p = _write(tmp_path, "2026-11-01,100\n", header="date,amount\n")
+    with pytest.raises(CsvError) as ei:
+        load_csv(p)
+    assert [line for line, _ in ei.value.errors] == [2]
+
+
+def test_load_csv_error_message_has_line_and_reason(tmp_path):
+    with pytest.raises(CsvError) as ei:
+        load_csv(_write(tmp_path, "nope,food,100,\n"))
+    assert str(ei.value).startswith("2: ")
+
+
+# ---- monthly_totals ----
+
+
+def test_monthly_totals_empty():
+    assert monthly_totals([]) == {}
+
+
+def test_monthly_totals_year_boundary_order_and_zero_padding():
+    rows = [
+        Expense(date(2026, 1, 5), "food", 1),
+        Expense(date(2025, 12, 31), "food", 2),
+        Expense(date(2025, 2, 1), "food", 3),
+    ]
+    assert list(monthly_totals(rows)) == ["2025-02", "2025-12", "2026-01"]
+
+
+def test_monthly_totals_same_month_different_years_not_merged():
+    rows = [
+        Expense(date(2025, 11, 1), "food", 100),
+        Expense(date(2026, 11, 1), "food", 200),
+    ]
+    assert monthly_totals(rows) == {
+        "2025-11": {"food": 100},
+        "2026-11": {"food": 200},
+    }
+
+
+def test_monthly_totals_month_boundaries():
+    rows = [
+        Expense(date(2026, 10, 31), "food", 1),
+        Expense(date(2026, 11, 1), "food", 2),
+        Expense(date(2026, 11, 30), "food", 4),
+        Expense(date(2026, 12, 1), "food", 8),
+    ]
+    assert monthly_totals(rows) == {
+        "2026-10": {"food": 1},
+        "2026-11": {"food": 6},
+        "2026-12": {"food": 8},
+    }
+
+
+def test_monthly_totals_negative_amounts_net_out():
+    rows = [
+        Expense(date(2026, 11, 1), "food", 1000),
+        Expense(date(2026, 11, 2), "food", -1000),
+    ]
+    assert monthly_totals(rows) == {"2026-11": {"food": 0}}
+
+
+def test_monthly_totals_ties_keep_first_seen_order():
+    rows = [
+        Expense(date(2026, 11, 1), "b", 100),
+        Expense(date(2026, 11, 2), "a", 100),
+    ]
+    assert list(monthly_totals(rows)["2026-11"]) == ["b", "a"]
+
+
+def test_monthly_totals_categories_are_case_sensitive():
+    rows = [
+        Expense(date(2026, 11, 1), "Food", 1),
+        Expense(date(2026, 11, 2), "food", 2),
+    ]
+    assert monthly_totals(rows) == {"2026-11": {"food": 2, "Food": 1}}
+
+
+def test_monthly_totals_does_not_mutate_input():
+    rows = [Expense(date(2026, 11, 2), "a", 1), Expense(date(2026, 10, 1), "b", 2)]
+    snapshot = list(rows)
+    monthly_totals(rows)
+    assert rows == snapshot
