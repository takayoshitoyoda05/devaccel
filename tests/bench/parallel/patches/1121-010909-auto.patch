+"""Month-over-month category changes."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from itertools import pairwise
+
+from kakeibo.core import Expense, monthly_totals
+
+
+@dataclass(frozen=True)
+class Change:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    ratio: float | None
+    kind: str  # "up" | "down" | "flat" | "new" | "gone"
+
+
+@dataclass(frozen=True)
+class MonthReport:
+    month: str
+    previous_month: str
+    changes: list[Change]
+
+
+def _next_month(m: str) -> str:
+    y, mo = int(m[:4]), int(m[5:7])
+    if mo == 12:
+        return f"{y + 1:04d}-01"
+    return f"{y:04d}-{mo + 1:02d}"
+
+
+def _kind(previous: int, current: int, delta: int) -> str:
+    if previous == 0 and current > 0:
+        return "new"
+    if previous > 0 and current == 0:
+        return "gone"
+    if delta > 0:
+        return "up"
+    if delta < 0:
+        return "down"
+    return "flat"
+
+
+def month_over_month(rows: list[Expense]) -> list[MonthReport]:
+    totals = monthly_totals(rows)
+    if not totals:
+        return []
+    # Calendar-continuous months from the first to the last data month.
+    months: list[str] = []
+    m = min(totals)
+    last = max(totals)
+    while m <= last:
+        months.append(m)
+        m = _next_month(m)
+
+    reports: list[MonthReport] = []
+    for prev, cur in pairwise(months):
+        prev_cats = totals.get(prev, {})
+        cur_cats = totals.get(cur, {})
+        changes: list[Change] = []
+        for cat in set(prev_cats) | set(cur_cats):
+            previous = prev_cats.get(cat, 0)
+            current = cur_cats.get(cat, 0)
+            delta = current - previous
+            ratio = None if previous == 0 else delta / previous
+            changes.append(
+                Change(
+                    category=cat,
+                    previous=previous,
+                    current=current,
+                    delta=delta,
+                    ratio=ratio,
+                    kind=_kind(previous, current, delta),
+                )
+            )
+        changes.sort(key=lambda c: (-abs(c.delta), c.category))
+        reports.append(MonthReport(month=cur, previous_month=prev, changes=changes))
+    return reports
