@@ -0,0 +1,192 @@
+"""Bank / card CSV import: CSV text (str) -> list[Expense].
+
+Depends only on kakeibo.core. Input is text, not a file path.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from datetime import date
+
+from kakeibo.core import CsvError, Expense
+
+_DATE_ALIASES = ("date", "日付", "利用日", "取引日", "ご利用日")
+_AMOUNT_ALIASES = ("amount", "金額", "利用金額", "ご利用金額")
+_WITHDRAW_ALIASES = ("出金額", "支払", "お支払い金額")
+_DEPOSIT_ALIASES = ("入金額", "預入", "お預かり金額")
+_MEMO_ALIASES = ("memo", "摘要", "メモ", "利用店名", "ご利用店名", "内容")
+_CATEGORY_ALIASES = ("category", "カテゴリ", "分類")
+_UNCATEGORIZED = "未分類"
+
+_SPACES = " \t　"
+_AMOUNT_BODY_RE = re.compile(r"[0-9]+|[0-9]{1,3}(?:,[0-9]{3})+")
+_TIME = r"(?:\s+(?:[01]?[0-9]|2[0-3]):[0-5][0-9](?::[0-5][0-9])?)?"
+_DATE_RES = (
+    re.compile(r"([0-9]{4})[/-]([0-9]{1,2})[/-]([0-9]{1,2})" + _TIME),
+    re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日" + _TIME),
+    re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})" + _TIME),
+)
+
+
+def _strip_currency(s: str) -> str:
+    if s.startswith("¥"):
+        return s[1:].strip(_SPACES)
+    if s[:3].upper() == "JPY":
+        return s[3:].strip(_SPACES)
+    return s
+
+
+def _parse_amount(raw: str, col: str) -> int:
+    """Parse one amount cell. Returns a signed integer (yen). Raises ValueError."""
+    if not raw.strip(_SPACES):
+        raise ValueError(f"{col}が空です: {raw!r}")
+    s = unicodedata.normalize("NFKC", raw).replace("−", "-").strip(_SPACES)
+    negatives = 0
+    if s.startswith("(") and s.endswith(")"):
+        negatives += 1
+        s = s[1:-1].strip(_SPACES)
+    s = _strip_currency(s)
+    if s[:1] in ("-", "△", "▲"):
+        negatives += 1
+        s = _strip_currency(s[1:].strip(_SPACES))
+    if s.endswith("円"):
+        s = s[:-1].strip(_SPACES)
+    if s.endswith("-"):
+        negatives += 1
+        s = s[:-1].strip(_SPACES)
+    if negatives > 1 or not _AMOUNT_BODY_RE.fullmatch(s):
+        raise ValueError(f"{col}の値が金額として不正です: {raw!r}")
+    value = int(s.replace(",", ""))
+    return -value if negatives else value
+
+
+def _parse_date(raw: str, col: str) -> date:
+    s = unicodedata.normalize("NFKC", raw).strip(_SPACES)
+    if not s:
+        raise ValueError(f"{col}が空です: {raw!r}")
+    for rx in _DATE_RES:
+        m = rx.fullmatch(s)
+        if m:
+            y, mo, d = (int(g) for g in m.groups())
+            try:
+                return date(y, mo, d)
+            except ValueError:
+                raise ValueError(f"{col}の日付が存在しません: {raw!r}") from None
+    raise ValueError(f"{col}の日付の形式が不正です: {raw!r}")
+
+
+def _amount_of(
+    row: list[str],
+    header: list[str],
+    amount_i: int | None,
+    out_i: int | None,
+    in_i: int | None,
+) -> tuple[int | None, list[str]]:
+    """Return (signed amount or None, error reasons) for one record."""
+    if amount_i is not None:
+        try:
+            return _parse_amount(row[amount_i], header[amount_i]), []
+        except ValueError as e:
+            return None, [str(e)]
+
+    out_raw = row[out_i] if out_i is not None else ""
+    in_raw = row[in_i] if in_i is not None else ""
+    has_out = out_i is not None and bool(out_raw.strip(_SPACES))
+    has_in = in_i is not None and bool(in_raw.strip(_SPACES))
+    if has_out and has_in:
+        return None, [f"出金額({out_raw!r})と入金額({in_raw!r})の両方に値があります"]
+    if not has_out and not has_in:
+        return None, [f"出金額({out_raw!r})と入金額({in_raw!r})がどちらも空です"]
+    try:
+        if out_i is not None and has_out:
+            return abs(_parse_amount(out_raw, header[out_i])), []
+        if in_i is not None:
+            return -abs(_parse_amount(in_raw, header[in_i])), []
+    except ValueError as e:
+        return None, [str(e)]
+    return None, []  # unreachable: one of the branches above always returns
+
+
+def _find(names: list[str], aliases: tuple[str, ...]) -> int | None:
+    for i, n in enumerate(names):
+        if n in aliases:
+            return i
+    return None
+
+
+def parse_bank_csv(text: str) -> list[Expense]:
+    """Parse a bank/card CSV. Raises CsvError listing every bad record's start line."""
+    text = text.removeprefix("﻿")
+    if not text.strip():
+        return []
+
+    first = next(line for line in text.splitlines() if line.strip())
+    delim = "\t" if "\t" in first else ","
+
+    # (start line, cells) for each non-empty record; csv handles quoted newlines and CRLF.
+    records: list[tuple[int, list[str]]] = []
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delim)
+    start = 1
+    for row in reader:
+        end = reader.line_num
+        if row:
+            records.append((start, row))
+        start = end + 1
+    if not records:
+        return []
+
+    header = [c.strip(_SPACES) for c in records[0][1]]
+    names = [c.lower() for c in header]
+    date_i = _find(names, _DATE_ALIASES)
+    amount_i = _find(names, _AMOUNT_ALIASES)
+    out_i = _find(names, _WITHDRAW_ALIASES)
+    in_i = _find(names, _DEPOSIT_ALIASES)
+    memo_i = _find(names, _MEMO_ALIASES)
+    cat_i = _find(names, _CATEGORY_ALIASES)
+
+    has_amount = amount_i is not None or out_i is not None or in_i is not None
+    if date_i is None or not has_amount:
+        missing = [
+            label
+            for label, ok in (("日付", date_i is not None), ("金額", has_amount))
+            if not ok
+        ]
+        raise CsvError([(1, f"必須列がありません: {', '.join(missing)}")])
+
+    out: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    for line, row in records[1:]:
+        if len(row) != len(header):
+            errors.append(
+                (
+                    line,
+                    (
+                        f"列数が違います(ヘッダーは {len(header)} 列、"
+                        f"この行は {len(row)} 列): {delim.join(row)!r}"
+                    ),
+                )
+            )
+            continue
+
+        reasons: list[str] = []
+        day: date | None = None
+        try:
+            day = _parse_date(row[date_i], header[date_i])
+        except ValueError as e:
+            reasons.append(str(e))
+        amount, amount_reasons = _amount_of(row, header, amount_i, out_i, in_i)
+        reasons.extend(amount_reasons)
+        if reasons or day is None or amount is None:
+            errors.extend((line, r) for r in reasons)
+            continue
+
+        category = row[cat_i].strip(_SPACES) if cat_i is not None else ""
+        memo = row[memo_i].strip(_SPACES) if memo_i is not None else ""
+        out.append(Expense(day, category or _UNCATEGORIZED, amount, memo))
+
+    if errors:
+        raise CsvError(errors)
+    return out
