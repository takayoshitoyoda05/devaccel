+"""定期支出の検出と次回予測(明細 `Expense` の純粋関数)。"""
+
+from __future__ import annotations
+
+import calendar
+import re
+import statistics
+import unicodedata
+from collections import Counter
+from dataclasses import dataclass
+from datetime import date
+from itertools import pairwise
+
+from kakeibo.core import Expense
+
+_DAY_GAP = 7  # 月内の日の差がこれ以内なら同じ系列とみなす (D2)
+_EPS = 1e-9  # 浮動小数の誤差吸収用
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str  # 正規化前のメモの最頻値
+    amount: int  # 直近の金額
+    months: int  # 異なる月の数
+    last_day: date
+    next_day: date
+
+
+Indexed = tuple[int, Expense]
+
+
+def _norm_memo(memo: str) -> str:
+    """D1: NFKC・小文字化・空白除去・末尾の数字と # の除去。"""
+    s = unicodedata.normalize("NFKC", memo).lower()
+    s = re.sub(r"\s+", "", s)
+    return re.sub(r"[0-9#]+$", "", s)
+
+
+def _check_args(min_months: object, tolerance: object) -> None:
+    if isinstance(min_months, bool) or not isinstance(min_months, int):
+        raise TypeError(f"min_months は int である必要があります: {min_months!r}")
+    if min_months < 2:
+        raise ValueError(f"min_months は 2 以上である必要があります: {min_months}")
+    if isinstance(tolerance, bool) or not isinstance(tolerance, (int, float)):
+        raise TypeError(f"tolerance は数値である必要があります: {tolerance!r}")
+    if not 0 <= tolerance < 1:
+        raise ValueError(f"tolerance は 0 以上 1 未満である必要があります: {tolerance}")
+
+
+def _near(amount: int, center: float, tolerance: float) -> bool:
+    return abs(amount - center) <= tolerance * center + _EPS
+
+
+def _day_groups(items: list[Indexed]) -> list[list[Indexed]]:
+    """D2: 月内の日の差が 7 日以内なら同じ群に束ねる。"""
+    groups: list[list[Indexed]] = []
+    for item in sorted(items, key=lambda p: p[1].day.day):
+        if groups and item[1].day.day - groups[-1][-1][1].day.day <= _DAY_GAP:
+            groups[-1].append(item)
+        else:
+            groups.append([item])
+    return groups
+
+
+def _amount_clusters(items: list[Indexed], tolerance: float) -> list[list[Indexed]]:
+    """D2: 系列の中央値の ±tolerance 以内を 1 系列にする。外れた明細は残して次の系列へ。"""
+    remaining = list(items)
+    out: list[list[Indexed]] = []
+    while remaining:
+        amounts = [e.amount for _, e in remaining]
+        center = statistics.median(amounts)
+        keep = [p for p in remaining if _near(p[1].amount, center, tolerance)]
+        if not keep:
+            # 中央値がどの明細にも近くない場合は、最頻の金額を中心にする
+            anchor = max(set(amounts), key=lambda a: (amounts.count(a), a))
+            keep = [p for p in remaining if _near(p[1].amount, anchor, tolerance)]
+        out.append(keep)
+        kept = {idx for idx, _ in keep}
+        remaining = [p for p in remaining if p[0] not in kept]
+    return out
+
+
+def _months_ok(months: list[int], min_months: int) -> bool:
+    """D3: 異なる月が min_months 以上。欠けは 1 か月だけ許し、間隔は 1 か月刻み(年払い除外)。"""
+    if len(months) < min_months:
+        return False
+    missing = 0
+    for a, b in pairwise(months):
+        gap = b - a
+        if gap == 2:
+            missing += 1
+        elif gap != 1:
+            return False
+    return missing <= 1
+
+
+def _to_recurring(
+    category: str, cluster: list[Indexed], min_months: int
+) -> Recurring | None:
+    members = sorted(cluster, key=lambda p: p[0])  # 入力順
+    # 月番号 = year * 12 + (month - 1)。同じ月の重複は 1 件として数える。
+    months = sorted({e.day.year * 12 + e.day.month - 1 for _, e in members})
+    if not _months_ok(months, min_months):
+        return None
+
+    # 最新日の明細。同日なら入力の後ろ側を採る。
+    last = max((e for _, e in members[::-1]), key=lambda e: e.day)
+
+    # D4: 月内の日の最頻値(同数なら大きい方)を、最後の月の翌月に当てはめる
+    day_counts = Counter(e.day.day for _, e in members)
+    base_day = max(day_counts, key=lambda d: (day_counts[d], d))
+    y, m0 = divmod(months[-1] + 1, 12)
+    m = m0 + 1
+    next_day = date(y, m, min(base_day, calendar.monthrange(y, m)[1]))
+
+    # R4: 正規化前のメモの最頻値(同数なら最初に出たもの)
+    memo_counts = Counter(e.memo for _, e in members)
+    memo = max(memo_counts, key=lambda k: memo_counts[k])
+
+    return Recurring(
+        category=category,
+        memo=memo,
+        amount=last.amount,
+        months=len(months),
+        last_day=last.day,
+        next_day=next_day,
+    )
+
+
+def find_recurring(
+    rows: list[Expense], *, min_months: int = 3, tolerance: float = 0.10
+) -> list[Recurring]:
+    """定期支出の系列を検出し、次回の予定日を返す。入力は変更しない。"""
+    _check_args(min_months, tolerance)
+
+    # D1: 系列キーは (カテゴリ, 正規化メモ)。負の金額(返金)は除外する (D2)。
+    buckets: dict[tuple[str, str], list[Indexed]] = {}
+    for i, e in enumerate(rows):
+        if e.amount < 0:
+            continue
+        buckets.setdefault((e.category, _norm_memo(e.memo)), []).append((i, e))
+
+    out: list[Recurring] = []
+    for (category, _), items in buckets.items():
+        for group in _day_groups(items):
+            for cluster in _amount_clusters(group, tolerance):
+                rec = _to_recurring(category, cluster, min_months)
+                if rec is not None:
+                    out.append(rec)
+
+    # R1: 月数の多い順、同数は金額の大きい順、さらにカテゴリ・メモの昇順
+    out.sort(key=lambda r: (-r.months, -r.amount, r.category, r.memo))
+    return out
