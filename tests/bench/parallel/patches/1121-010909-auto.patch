+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import parse_bank_csv
+from kakeibo.core import CsvError, Expense
+
+
+def _one(value: str, header: str = "日付,金額,摘要") -> list[Expense]:
+    """Single data row with the amount quoted, so commas inside it are not separators."""
+    return parse_bank_csv(f'{header}\n2026-01-05,"{value}",x\n')
+
+
+# --- 表の例 ---------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "text, expected",
+    [
+        pytest.param(
+            '利用日,ご利用店名,利用金額\n2026/1/5,ABC,"1,234円"\n',
+            [Expense(date(2026, 1, 5), "未分類", 1234, "ABC")],
+            id="E2-1",
+        ),
+        pytest.param(
+            "日付,出金額,入金額,摘要\n2026-01-05,,500,返金\n",
+            [Expense(date(2026, 1, 5), "未分類", -500, "返金")],
+            id="E2-2",
+        ),
+    ],
+)
+def test_table_examples(text: str, expected: list[Expense]) -> None:
+    assert parse_bank_csv(text) == expected
+
+
+def test_E2_3_reports_every_bad_line() -> None:
+    text = "日付,金額,摘要\n2026/1/5,100,a\n2026/2/30,100,b\n2026/1/6,abc,c\n"
+    with pytest.raises(CsvError) as exc:
+        parse_bank_csv(text)
+    assert [n for n, _ in exc.value.errors] == [3, 4]
+
+
+# --- R1 列名 ---------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "header, row",
+    [
+        ("  DATE , Amount , Memo ", "2026-01-05,100,x"),
+        ("ご利用日,ご利用金額,ご利用店名", "2026-01-05,100,x"),
+        ("取引日,金額,摘要,カテゴリ", "2026-01-05,100,x,食費"),
+    ],
+)
+def test_column_aliases_and_case(header: str, row: str) -> None:
+    rows = parse_bank_csv(f"{header}\n{row}\n")
+    assert len(rows) == 1
+    assert rows[0].amount == 100
+
+
+def test_category_column_is_used_and_defaults_to_uncategorized() -> None:
+    with_cat = parse_bank_csv("日付,金額,カテゴリ\n2026-01-05,100,食費\n")
+    assert with_cat[0].category == "食費"
+    without = parse_bank_csv("日付,金額\n2026-01-05,100\n")
+    assert without[0].category == "未分類"
+    assert without[0].memo == ""
+
+
+def test_missing_required_columns_is_whole_file_error() -> None:
+    with pytest.raises(CsvError) as exc:
+        parse_bank_csv("摘要,メモ\nx,y\n")
+    assert exc.value.errors[0][0] == 1
+    assert "必須列がありません" in exc.value.errors[0][1]
+
+
+# --- R2 金額の書き方 ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "value, expected",
+    [
+        pytest.param("1234", 1234, id="plain"),
+        pytest.param("1,234", 1234, id="comma"),
+        pytest.param("１，２３４", 1234, id="fullwidth"),
+        pytest.param("¥1,234", 1234, id="yen"),
+        pytest.param("￥1,234", 1234, id="fullwidth-yen"),
+        pytest.param("1,234円", 1234, id="en-suffix"),
+        pytest.param("JPY 1234", 1234, id="JPY-prefix"),
+        pytest.param("-300", -300, id="minus"),
+        pytest.param("−300", -300, id="unicode-minus"),
+        pytest.param("△500", -500, id="triangle"),
+        pytest.param("▲500", -500, id="black-triangle"),
+        pytest.param("(500)", -500, id="parens"),
+        pytest.param("500-", -500, id="trailing-minus"),
+        pytest.param("  1,234  ", 1234, id="surrounding-spaces"),
+        pytest.param("　1,234　", 1234, id="ideographic-spaces"),
+    ],
+)
+def test_amount_forms(value: str, expected: int) -> None:
+    assert _one(value)[0].amount == expected
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["12.5", "", "-", "abc", "(500", "--300", "(-300)"],
+    ids=[
+        "decimal",
+        "empty",
+        "minus-only",
+        "letters",
+        "unclosed-paren",
+        "double-minus",
+        "paren-and-minus",
+    ],
+)
+def test_bad_amounts_are_row_errors(value: str) -> None:
+    with pytest.raises(CsvError) as exc:
+        _one(value)
+    assert exc.value.errors[0][0] == 2
+    assert "金額" in exc.value.errors[0][1]
+    assert repr(value) in exc.value.errors[0][1]
+
+
+# --- R3 出金/入金 ------------------------------------------------------------
+
+
+def test_withdraw_column_is_positive() -> None:
+    rows = parse_bank_csv("日付,出金額,入金額,摘要\n2026-01-05,1200,,店\n")
+    assert rows[0].amount == 1200
+
+
+def test_both_empty_is_error() -> None:
+    with pytest.raises(CsvError) as exc:
+        parse_bank_csv("日付,出金額,入金額\n2026-01-05,,\n")
+    assert exc.value.errors[0][0] == 2
+
+
+def test_both_filled_is_error() -> None:
+    with pytest.raises(CsvError) as exc:
+        parse_bank_csv("日付,出金額,入金額\n2026-01-05,100,100\n")
+    assert exc.value.errors[0][0] == 2
+
+
+# --- R4 日付 ---------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "raw, expected",
+    [
+        pytest.param("2026-01-05", date(2026, 1, 5), id="iso"),
+        pytest.param("2026/1/5", date(2026, 1, 5), id="slash"),
+        pytest.param("2026/01/05", date(2026, 1, 5), id="slash-padded"),
+        pytest.param("20260105", date(2026, 1, 5), id="compact"),
+        pytest.param("2026年1月5日", date(2026, 1, 5), id="japanese"),
+        pytest.param("2026-01-05 12:34", date(2026, 1, 5), id="with-time"),
+    ],
+)
+def test_date_forms(raw: str, expected: date) -> None:
+    rows = parse_bank_csv(f"日付,金額\n{raw},100\n")
+    assert rows[0].day == expected
+
+
+@pytest.mark.parametrize("raw", ["2026/2/30", "abc", ""])
+def test_bad_dates_are_row_errors(raw: str) -> None:
+    with pytest.raises(CsvError) as exc:
+        parse_bank_csv(f"日付,金額\n{raw},100\n")
+    assert exc.value.errors[0][0] == 2
+
+
+# --- D5 区切り・行番号・空行 ---------------------------------------------------
+
+
+def test_bom_and_crlf() -> None:
+    text = "﻿日付,金額\r\n2026-01-05,100\r\n"
+    assert parse_bank_csv(text) == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+def test_tab_delimiter_detected_from_first_line() -> None:
+    text = "日付\t金額\t摘要\n2026-01-05\t1,234\tabc\n"
+    assert parse_bank_csv(text) == [Expense(date(2026, 1, 5), "未分類", 1234, "abc")]
+
+
+def test_quoted_newline_and_delimiter_inside_memo() -> None:
+    text = '日付,金額,摘要\n2026-01-05,100,"a,b\nc"\n2026-01-06,200,d\n'
+    rows = parse_bank_csv(text)
+    assert rows[0].memo == "a,b\nc"
+    assert rows[1].amount == 200
+
+
+def test_error_line_is_start_line_of_multiline_record() -> None:
+    text = '日付,金額,摘要\n2026-01-05,100,"a\nb"\n2026/2/30,100,c\n'
+    with pytest.raises(CsvError) as exc:
+        parse_bank_csv(text)
+    assert exc.value.errors[0][0] == 4
+
+
+def test_blank_lines_are_ignored() -> None:
+    text = "日付,金額\n\n2026-01-05,100\n\n"
+    assert len(parse_bank_csv(text)) == 1
+
+
+def test_empty_input_and_header_only_return_empty() -> None:
+    assert parse_bank_csv("") == []
+    assert parse_bank_csv("日付,金額\n") == []
+
+
+def test_one_bad_row_with_two_errors_reports_both() -> None:
+    with pytest.raises(CsvError) as exc:
+        parse_bank_csv("日付,金額\n2026/2/30,abc\n")
+    assert [n for n, _ in exc.value.errors] == [2, 2]
+
+
+# --- R6 列数 -----------------------------------------------------------------
+
+
+def test_unquoted_amount_with_comma_is_column_count_error() -> None:
+    with pytest.raises(CsvError) as exc:
+        parse_bank_csv("日付,摘要,金額\n2026-01-05,ABC,1,234円\n")
+    assert exc.value.errors[0][0] == 2
+    assert "列数" in exc.value.errors[0][1]
