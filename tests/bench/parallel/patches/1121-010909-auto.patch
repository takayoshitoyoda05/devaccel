+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring
+
+
+def E(day: str, amount: int, category: str = "通信", memo: str = "Netflix") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+# 例の表 (E1-1 〜 E1-3)
+E11_ROWS = [E("2026-01-31", 1200), E("2026-02-28", 1200), E("2026-03-31", 1200)]
+E12_ROWS = [
+    E("2026-01-05", 500),
+    E("2026-01-05", 500),
+    E("2026-02-05", 500),
+    E("2026-03-05", 500),
+]
+E13_ROWS = [E("2026-01-01", 1000), E("2026-02-01", 1000), E("2026-03-01", 1500)]
+
+
+@pytest.mark.parametrize(
+    ("rows", "expected"),
+    [
+        pytest.param(
+            E11_ROWS,
+            [
+                Recurring(
+                    category="通信",
+                    memo="Netflix",
+                    amount=1200,
+                    months=3,
+                    last_day=date(2026, 3, 31),
+                    next_day=date(2026, 4, 30),
+                )
+            ],
+            id="E1-1",
+        ),
+        pytest.param(
+            E12_ROWS,
+            [
+                Recurring(
+                    category="通信",
+                    memo="Netflix",
+                    amount=500,
+                    months=3,
+                    last_day=date(2026, 3, 5),
+                    next_day=date(2026, 4, 5),
+                )
+            ],
+            id="E1-2",
+        ),
+        pytest.param(E13_ROWS, [], id="E1-3"),
+    ],
+)
+def test_example_table(rows: list[Expense], expected: list[Recurring]) -> None:
+    assert find_recurring(rows) == expected
+
+
+# R1: 並び順
+def test_sorted_by_months_then_amount_then_category_memo() -> None:
+    rows = [
+        # 3 か月・金額 300
+        E("2026-01-10", 300, memo="A"),
+        E("2026-02-10", 300, memo="A"),
+        E("2026-03-10", 300, memo="A"),
+        # 3 か月・金額 900 (同数なら金額の大きい方が先)
+        E("2026-01-20", 900, memo="B"),
+        E("2026-02-20", 900, memo="B"),
+        E("2026-03-20", 900, memo="B"),
+        # 4 か月 (月数が多い方が先)
+        E("2026-01-25", 100, memo="C"),
+        E("2026-02-25", 100, memo="C"),
+        E("2026-03-25", 100, memo="C"),
+        E("2026-04-25", 100, memo="C"),
+    ]
+    got = [(r.memo, r.months, r.amount) for r in find_recurring(rows)]
+    assert got == [("C", 4, 100), ("B", 3, 900), ("A", 3, 300)]
+
+
+# R2: 空・1 件
+@pytest.mark.parametrize("rows", [[], [E("2026-01-01", 100)]], ids=["empty", "one-row"])
+def test_empty_or_single_row_returns_empty(rows: list[Expense]) -> None:
+    assert find_recurring(rows) == []
+
+
+# R3: 引数検証
+@pytest.mark.parametrize(
+    ("kwargs", "error"),
+    [
+        ({"min_months": 1}, ValueError),
+        ({"min_months": 0}, ValueError),
+        ({"min_months": 3.0}, TypeError),
+        ({"min_months": True}, TypeError),
+        ({"tolerance": -0.1}, ValueError),
+        ({"tolerance": 1.0}, ValueError),
+        ({"tolerance": "0.1"}, TypeError),
+        ({"tolerance": None}, TypeError),
+        ({"tolerance": True}, TypeError),
+    ],
+)
+def test_invalid_arguments(kwargs: dict[str, object], error: type[Exception]) -> None:
+    with pytest.raises(error):
+        find_recurring(E11_ROWS, **kwargs)  # type: ignore[arg-type]
+
+
+# R4: 正規化前のメモの最頻値
+def test_memo_is_most_frequent_original_text() -> None:
+    rows = [
+        E("2026-01-03", 980, memo="Netflix"),
+        E("2026-02-03", 980, memo="netflix #2"),
+        E("2026-03-03", 980, memo="Netflix"),
+    ]
+    (rec,) = find_recurring(rows)
+    assert rec.memo == "Netflix"
+
+
+# R5: 同カテゴリの別メモ・同額の系列は混ぜない
+def test_different_memos_are_not_mixed() -> None:
+    rows = []
+    for m in ("01", "02", "03"):
+        rows.append(E(f"2026-{m}-01", 80000, category="住居", memo="家賃"))
+        rows.append(E(f"2026-{m}-01", 80000, category="住居", memo="駐車場"))
+    got = sorted((r.memo, r.months) for r in find_recurring(rows))
+    assert got == [("家賃", 3), ("駐車場", 3)]
+
+
+# D1: 正規化(全角・大文字小文字・空白・末尾の数字)で同じ系列になる
+def test_memo_normalization_groups_variants() -> None:
+    rows = [
+        E("2026-01-03", 980, memo="ＮＥＴＦＬＩＸ"),
+        E("2026-02-03", 980, memo="netflix"),
+        E("2026-03-03", 980, memo="Net flix 3"),
+    ]
+    (rec,) = find_recurring(rows)
+    assert rec.months == 3
+
+
+# D2: 値上げは別系列。中央値から外れた明細は系列に入れない
+def test_price_increase_is_separate_series() -> None:
+    rows = [
+        E("2026-01-03", 1000),
+        E("2026-02-03", 1000),
+        E("2026-03-03", 1000),
+        E("2026-04-03", 1500),
+        E("2026-05-03", 1500),
+        E("2026-06-03", 1500),
+    ]
+    got = [(r.amount, r.months) for r in find_recurring(rows)]
+    assert got == [(1500, 3), (1000, 3)]
+
+
+# D2: 負の金額(返金)は系列から除外
+def test_negative_amounts_are_excluded() -> None:
+    rows = [
+        E("2026-01-03", 980),
+        E("2026-02-03", 980),
+        E("2026-03-03", 980),
+        E("2026-02-10", -980),
+    ]
+    got = find_recurring(rows)
+    assert [(r.amount, r.months) for r in got] == [(980, 3)]
+
+
+# D2: 月内の日が 7 日より離れた 2 系列は束ねない
+def test_far_apart_days_are_separate_series() -> None:
+    rows = [
+        E("2026-01-05", 500),
+        E("2026-02-05", 500),
+        E("2026-03-05", 500),
+        E("2026-01-20", 500),
+        E("2026-02-20", 500),
+        E("2026-03-20", 500),
+    ]
+    got = sorted((r.last_day, r.months) for r in find_recurring(rows))
+    assert got == [(date(2026, 3, 5), 3), (date(2026, 3, 20), 3)]
+
+
+# D3: 欠けは 1 か月まで許し、年払いは対象外
+@pytest.mark.parametrize(
+    ("months", "expected_months"),
+    [
+        ([1, 2, 4], 3),  # 欠け 1 回は許す
+        ([1, 2, 5], None),  # 欠け 2 か月は不可
+        ([1, 13, 25], None),  # 年払いは対象外
+    ],
+    ids=["one-gap-ok", "two-missing-ng", "yearly-ng"],
+)
+def test_missing_months_rule(months: list[int], expected_months: int | None) -> None:
+    rows = []
+    for mo in months:
+        y, m = divmod(mo - 1, 12)
+        rows.append(E(f"{2026 + y}-{m + 1:02d}-03", 700))
+    got = find_recurring(rows, min_months=3)
+    if expected_months is None:
+        assert got == []
+    else:
+        assert [r.months for r in got] == [expected_months]
+
+
+# D4: 次回予測は直近の金額・翌月の日(最頻値を月末に丸める)
+def test_next_day_uses_latest_amount_and_february_clamp() -> None:
+    rows = [
+        E("2026-11-30", 400),
+        E("2026-12-30", 405),
+        E("2027-01-30", 410),
+    ]
+    (rec,) = find_recurring(rows)
+    assert rec.amount == 410
+    assert rec.last_day == date(2027, 1, 30)
+    # 最頻の日 30 を翌月 (2 月) に当てはめ、2 月末 (28 日) に丸める
+    assert rec.next_day == date(2027, 2, 28)
diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..a769391
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,194 @@
+from datetime import date, datetime
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    all_of,
+    amount_between,
+    any_of,
+    between_dates,
+    category,
+    memo_contains,
+    negate,
+    search,
+)
+
+ROWS = [
+    Expense(date(2026, 11, 1), "food", 1200, "lunch"),
+    Expense(date(2026, 11, 5), "rent", 80000, ""),
+    Expense(date(2026, 12, 3), "subscription", 1000, "netflix 12月"),
+    Expense(date(2026, 12, 20), "food", 3000, "Dinner"),
+]
+
+
+def _one(amount: int = 1000, memo: str = "netflix 12月") -> Expense:
+    return Expense(date(2026, 12, 3), "subscription", amount, memo)
+
+
+# --- 例の表(ID 付き) ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "case_id, pred, expense, expected",
+    [
+        ("E3-1", amount_between(1000, 1000), _one(amount=1000), True),
+        ("E3-2", memo_contains("ＮＥＴＦＬＩＸ"), _one(memo="netflix 12月"), True),
+    ],
+    ids=["E3-1", "E3-2"],
+)
+def test_example_table_single_predicate(case_id, pred, expense, expected):
+    assert pred(expense) is expected
+
+
+def test_E3_3_any_of_empty_search_returns_empty_list():
+    assert search(ROWS, any_of()) == []
+
+
+# --- R1 category -------------------------------------------------------------
+
+
+def test_category_is_exact_match_not_partial():
+    assert [e.category for e in search(ROWS, category("foo"))] == []
+    assert len(search(ROWS, category("food"))) == 2
+
+
+def test_category_ignores_surrounding_whitespace_and_nfkc():
+    assert len(search(ROWS, category("  ｆｏｏｄ "))) == 2
+    assert len(search(ROWS, category("　food　"))) == 2
+
+
+def test_category_multiple_names_are_or():
+    assert len(search(ROWS, category("food", "rent"))) == 3
+
+
+def test_category_with_no_names_raises_value_error():
+    with pytest.raises(ValueError):
+        category()
+
+
+def test_category_non_str_name_raises_type_error():
+    with pytest.raises(TypeError):
+        category(1)  # type: ignore[arg-type]
+
+
+# --- R2 amount_between --------------------------------------------------------
+
+
+def test_amount_between_none_is_unbounded():
+    assert len(search(ROWS, amount_between())) == 4
+    assert len(search(ROWS, amount_between(low=2000))) == 2
+    assert len(search(ROWS, amount_between(high=1000))) == 1
+
+
+def test_amount_between_includes_both_ends():
+    assert amount_between(1000, 3000)(_one(amount=1000)) is True
+    assert amount_between(1000, 3000)(_one(amount=3000)) is True
+    assert amount_between(1000, 3000)(_one(amount=999)) is False
+    assert amount_between(1000, 3000)(_one(amount=3001)) is False
+
+
+@pytest.mark.parametrize("bad", [True, 1.0, "1000"])
+def test_amount_between_rejects_bool_float_and_str(bad):
+    with pytest.raises(TypeError):
+        amount_between(bad, None)  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        amount_between(None, bad)  # type: ignore[arg-type]
+
+
+def test_amount_between_low_greater_than_high_raises_value_error():
+    with pytest.raises(ValueError):
+        amount_between(2000, 1000)
+
+
+# --- R3 between_dates ----------------------------------------------------------
+
+
+def test_between_dates_includes_both_ends():
+    hits = search(ROWS, between_dates(date(2026, 11, 5), date(2026, 12, 3)))
+    assert [e.day for e in hits] == [date(2026, 11, 5), date(2026, 12, 3)]
+
+
+def test_between_dates_none_is_unbounded():
+    assert len(search(ROWS, between_dates())) == 4
+    assert len(search(ROWS, between_dates(start=date(2026, 12, 1)))) == 2
+    assert len(search(ROWS, between_dates(end=date(2026, 11, 30)))) == 2
+
+
+def test_between_dates_start_after_end_raises_value_error():
+    with pytest.raises(ValueError):
+        between_dates(date(2026, 12, 1), date(2026, 11, 1))
+
+
+def test_between_dates_rejects_datetime():
+    with pytest.raises(TypeError):
+        between_dates(datetime(2026, 11, 1), None)  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        between_dates(None, datetime(2026, 11, 1))  # type: ignore[arg-type]
+
+
+# --- R4 memo_contains ----------------------------------------------------------
+
+
+def test_memo_contains_is_partial_match():
+    assert len(search(ROWS, memo_contains("netf"))) == 1
+
+
+def test_memo_contains_ignores_case():
+    assert len(search(ROWS, memo_contains("DINNER"))) == 1
+
+
+def test_memo_contains_empty_text_matches_everything():
+    assert len(search(ROWS, memo_contains(""))) == 4
+
+
+def test_memo_contains_non_str_raises_type_error():
+    with pytest.raises(TypeError):
+        memo_contains(None)  # type: ignore[arg-type]
+
+
+# --- R5 / R6 / R7 combinators and search ---------------------------------------
+
+
+def test_all_of_empty_is_true_for_every_row():
+    assert search(ROWS, all_of()) == ROWS
+
+
+def test_all_of_requires_every_predicate():
+    p = all_of(category("food"), amount_between(high=2000))
+    assert [e.memo for e in search(ROWS, p)] == ["lunch"]
+
+
+def test_any_of_matches_if_any_predicate_matches():
+    p = any_of(category("rent"), memo_contains("dinner"))
+    assert len(search(ROWS, p)) == 2
+
+
+def test_negate_inverts_predicate():
+    assert len(search(ROWS, negate(category("food")))) == 2
+
+
+@pytest.mark.parametrize(
+    "call",
+    [
+        lambda: all_of(1),  # type: ignore[arg-type]
+        lambda: any_of(category("food"), "x"),  # type: ignore[arg-type]
+        lambda: negate(None),  # type: ignore[arg-type]
+    ],
+)
+def test_non_callable_predicate_raises_type_error(call):
+    with pytest.raises(TypeError):
+        call()
+
+
+def test_search_non_callable_predicate_raises_type_error():
+    with pytest.raises(TypeError):
+        search(ROWS, 5)  # type: ignore[arg-type]
+
+
+def test_search_keeps_order_and_returns_new_list_without_mutating_input():
+    original = list(ROWS)
+    result = search(ROWS, all_of())
+    assert result == original
+    assert result is not ROWS
+    assert ROWS == original
diff --git a/tests/test_trend.py b/tests/test_trend.py
new file mode 100644
index 0000000..c4fabed
--- /dev/null
+++ b/tests/test_trend.py
@@ -0,0 +1,136 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.trend import Change, MonthReport, month_over_month
+
+
+def E(d: str, cat: str, amount: int, memo: str = "") -> Expense:
+    return Expense(day=date.fromisoformat(d), category=cat, amount=amount, memo=memo)
+
+
+def _report(reports: list[MonthReport], month: str) -> MonthReport:
+    (r,) = [r for r in reports if r.month == month]
+    return r
+
+
+def test_E4_1_gone_then_new_across_empty_month() -> None:
+    # E4-1: 1 月に食費 1000、3 月に食費 500(2 月は明細なし)
+    rows = [E("2026-01-10", "食費", 1000), E("2026-03-10", "食費", 500)]
+    reports = month_over_month(rows)
+    assert [r.month for r in reports] == ["2026-02", "2026-03"]
+
+    feb = _report(reports, "2026-02")
+    assert feb.previous_month == "2026-01"
+    assert feb.changes == [
+        Change(
+            category="食費",
+            previous=1000,
+            current=0,
+            delta=-1000,
+            ratio=-1.0,
+            kind="gone",
+        )
+    ]
+
+    mar = _report(reports, "2026-03")
+    assert mar.previous_month == "2026-02"
+    assert mar.changes == [
+        Change(
+            category="食費", previous=0, current=500, delta=500, ratio=None, kind="new"
+        )
+    ]
+
+
+def test_E4_2_zero_previous_from_refund_offset_is_new_with_no_ratio() -> None:
+    # E4-2: 前月 0 円(返金で相殺)、今月 300
+    rows = [
+        E("2026-01-05", "食費", 500),
+        E("2026-01-06", "食費", -500),
+        E("2026-02-05", "食費", 300),
+    ]
+    feb = _report(month_over_month(rows), "2026-02")
+    (change,) = feb.changes
+    assert change.previous == 0
+    assert change.current == 300
+    assert change.ratio is None
+    assert change.kind == "new"
+
+
+def test_E4_3_january_previous_month_is_prior_december() -> None:
+    # E4-3: 12 月 → 1 月
+    rows = [E("2025-12-15", "食費", 100), E("2026-01-05", "食費", 200)]
+    reports = month_over_month(rows)
+    assert len(reports) == 1
+    assert reports[0].month == "2026-01"
+    assert reports[0].previous_month == "2025-12"
+
+
+def test_kinds_up_down_flat() -> None:
+    rows = [
+        E("2026-01-01", "a", 100),
+        E("2026-01-01", "b", 100),
+        E("2026-01-01", "c", 100),
+        E("2026-02-01", "a", 150),
+        E("2026-02-01", "b", 50),
+        E("2026-02-01", "c", 100),
+    ]
+    (report,) = month_over_month(rows)
+    by_cat = {c.category: c for c in report.changes}
+    assert by_cat["a"].kind == "up"
+    assert by_cat["a"].delta == 50
+    assert by_cat["a"].ratio == 0.5
+    assert by_cat["b"].kind == "down"
+    assert by_cat["b"].ratio == -0.5
+    assert by_cat["c"].kind == "flat"
+    assert by_cat["c"].delta == 0
+
+
+def test_changes_sorted_by_abs_delta_desc_then_category() -> None:
+    rows = [
+        E("2026-01-01", "z", 100),
+        E("2026-01-01", "y", 100),
+        E("2026-01-01", "x", 500),
+        E("2026-02-01", "z", 200),  # |delta| 100
+        E("2026-02-01", "y", 0),  # |delta| 100
+        E(
+            "2026-02-01", "x", 400
+        ),  # |delta| 100 -> tie with z,y; x wins on category order
+        E("2026-02-01", "w", 300),  # new, |delta| 300
+    ]
+    (report,) = month_over_month(rows)
+    assert [c.category for c in report.changes] == ["w", "x", "y", "z"]
+
+
+def test_gap_months_are_filled_and_previous_month_is_calendar_previous() -> None:
+    rows = [E("2026-01-01", "食費", 100), E("2026-04-01", "食費", 100)]
+    reports = month_over_month(rows)
+    assert [(r.month, r.previous_month) for r in reports] == [
+        ("2026-02", "2026-01"),
+        ("2026-03", "2026-02"),
+        ("2026-04", "2026-03"),
+    ]
+
+
+def test_refund_is_included_in_monthly_total() -> None:
+    rows = [E("2026-01-01", "食費", 1000), E("2026-02-01", "食費", -300)]
+    (report,) = month_over_month(rows)
+    (change,) = report.changes
+    assert change.current == -300
+    assert change.delta == -1300
+    assert change.kind == "down"
+
+
+def test_empty_and_single_month_return_empty_list() -> None:
+    assert month_over_month([]) == []
+    assert month_over_month([E("2026-01-01", "食費", 100)]) == []
+    assert (
+        month_over_month([E("2026-01-01", "食費", 100), E("2026-01-09", "食費", 5)])
+        == []
+    )
+
+
+def test_input_list_is_not_modified() -> None:
+    rows = [E("2026-01-01", "食費", 100), E("2026-02-01", "食費", 200)]
+    snapshot = list(rows)
+    month_over_month(rows)
+    assert rows == snapshot
