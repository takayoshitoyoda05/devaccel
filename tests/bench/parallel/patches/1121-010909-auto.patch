+++ b/src/kakeibo/search.py
@@ -0,0 +1,136 @@
+"""Composable predicates for searching Expense rows.
+
+A predicate is any callable ``Expense -> bool``. The builders below return
+predicates, and ``all_of`` / ``any_of`` / ``negate`` combine them.
+"""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable
+from datetime import date, datetime
+from typing import cast
+
+from kakeibo.core import Expense
+
+Predicate = Callable[[Expense], bool]
+
+
+def _nfkc(text: str) -> str:
+    return unicodedata.normalize("NFKC", text)
+
+
+def _fold(text: str) -> str:
+    """Normalize for case- and width-insensitive comparison (D6)."""
+    return _nfkc(text).casefold()
+
+
+def _optional_int(value: object, name: str) -> int | None:
+    if value is None:
+        return None
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{name} は int か None である必要があります: {value!r}")
+    return value
+
+
+def _require_predicate(value: object, name: str) -> Predicate:
+    if not callable(value):
+        raise TypeError(f"{name} は条件(呼び出せる値)である必要があります: {value!r}")
+    return cast(Predicate, value)
+
+
+def category(*names: str) -> Predicate:
+    """Match rows whose category equals any of ``names`` (exact, after NFKC/strip)."""
+    if not names:
+        raise ValueError("category には 1 つ以上の名前が必要です")
+    for name in names:
+        if not isinstance(name, str):
+            raise TypeError(f"category の名前は str である必要があります: {name!r}")
+    wanted = frozenset(_nfkc(name).strip() for name in names)
+
+    def pred(e: Expense) -> bool:
+        return _nfkc(e.category).strip() in wanted
+
+    return pred
+
+
+def amount_between(low: int | None = None, high: int | None = None) -> Predicate:
+    """Match rows with low <= amount <= high. ``None`` means unbounded."""
+    lo = _optional_int(low, "low")
+    hi = _optional_int(high, "high")
+    if lo is not None and hi is not None and lo > hi:
+        raise ValueError(f"low({lo}) は high({hi}) 以下である必要があります")
+
+    def pred(e: Expense) -> bool:
+        return (lo is None or e.amount >= lo) and (hi is None or e.amount <= hi)
+
+    return pred
+
+
+def memo_contains(text: str) -> Predicate:
+    """Match rows whose memo contains ``text`` (NFKC, case-insensitive)."""
+    if not isinstance(text, str):
+        raise TypeError(f"text は str である必要があります: {text!r}")
+    needle = _fold(text)
+
+    def pred(e: Expense) -> bool:
+        return needle in _fold(e.memo)
+
+    return pred
+
+
+def _optional_date(value: object, name: str) -> date | None:
+    if value is None:
+        return None
+    if isinstance(value, datetime) or not isinstance(value, date):
+        raise TypeError(f"{name} は date か None である必要があります: {value!r}")
+    return value
+
+
+def between_dates(start: date | None = None, end: date | None = None) -> Predicate:
+    """Match rows with start <= day <= end. ``None`` means unbounded."""
+    s = _optional_date(start, "start")
+    t = _optional_date(end, "end")
+    if s is not None and t is not None and s > t:
+        raise ValueError(f"start({s}) は end({t}) 以前である必要があります")
+
+    def pred(e: Expense) -> bool:
+        return (s is None or e.day >= s) and (t is None or e.day <= t)
+
+    return pred
+
+
+def all_of(*ps: Predicate) -> Predicate:
+    """True when every predicate is true. With no predicates, always True."""
+    checked = [_require_predicate(p, "all_of の引数") for p in ps]
+
+    def pred(e: Expense) -> bool:
+        return all(p(e) for p in checked)
+
+    return pred
+
+
+def any_of(*ps: Predicate) -> Predicate:
+    """True when any predicate is true. With no predicates, always False."""
+    checked = [_require_predicate(p, "any_of の引数") for p in ps]
+
+    def pred(e: Expense) -> bool:
+        return any(p(e) for p in checked)
+
+    return pred
+
+
+def negate(p: Predicate) -> Predicate:
+    """Invert a predicate."""
+    checked = _require_predicate(p, "negate の引数")
+
+    def pred(e: Expense) -> bool:
+        return not checked(e)
+
+    return pred
+
+
+def search(rows: list[Expense], p: Predicate) -> list[Expense]:
+    """Return a new list of the rows matching ``p``, in their original order."""
+    checked = _require_predicate(p, "search の条件")
+    return [e for e in rows if checked(e)]
