diff --git a/src/kakeibo/core.py b/src/kakeibo/core.py
index 8c3cbab..6eb28e4 100644
--- a/src/kakeibo/core.py
+++ b/src/kakeibo/core.py
@@ -133,3 +133,40 @@ def find_overruns(
             if cat in limits and actual > limits[cat]:
                 out.append((month, cat, actual - limits[cat], limits[cat], actual))
     return out
+
+
+@dataclass(frozen=True)
+class BudgetAlert:
+    month: str
+    category: str
+    limit: int
+    actual: int
+
+    @property
+    def over(self) -> bool:
+        return self.actual > self.limit
+
+    @property
+    def percent(self) -> int | None:
+        """actual / limit as a floored integer percent; None when limit is 0."""
+        return None if self.limit == 0 else self.actual * 100 // self.limit
+
+
+def find_budget_alerts(
+    totals: dict[str, dict[str, int]], budget: Budget
+) -> list[BudgetAlert]:
+    """Overruns (actual > limit) and cautions (actual >= 90% of limit, limit > 0).
+
+    Ordered like totals (months ascending, then category order within a month).
+    """
+    out: list[BudgetAlert] = []
+    for month, cats in totals.items():
+        limits = budget.for_month(month)
+        for cat, actual in cats.items():
+            if cat not in limits:
+                continue
+            limit = limits[cat]
+            # Integer comparison avoids float rounding at exactly 90%.
+            if actual > limit or (limit > 0 and actual * 10 >= limit * 9):
+                out.append(BudgetAlert(month, cat, limit, actual))
+    return out
