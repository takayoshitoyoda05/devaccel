diff --git a/src/kakeibo/core.py b/src/kakeibo/core.py
index 8c3cbab..f345304 100644
--- a/src/kakeibo/core.py
+++ b/src/kakeibo/core.py
@@ -122,14 +122,25 @@ def load_budget(path: Path) -> Budget:
     return Budget(default, months)
 
 
-def find_overruns(
+def find_budget_alerts(
     totals: dict[str, dict[str, int]], budget: Budget
-) -> list[tuple[str, str, int, int, int]]:
-    """(month, category, over, limit, actual) for actual > limit."""
-    out: list[tuple[str, str, int, int, int]] = []
+) -> list[tuple[str, str, str, int, int, int, int | None]]:
+    """(level, month, category, diff, limit, actual, pct).
+
+    level "警告": actual > limit, diff = 超過額.
+    level "注意": 90% <= actual/limit <= 100%, diff = 残額.
+    pct is actual*100 // limit, or None when limit is 0.
+    """
+    out: list[tuple[str, str, str, int, int, int, int | None]] = []
     for month, cats in totals.items():
         limits = budget.for_month(month)
         for cat, actual in cats.items():
-            if cat in limits and actual > limits[cat]:
-                out.append((month, cat, actual - limits[cat], limits[cat], actual))
+            if cat not in limits:
+                continue
+            limit = limits[cat]
+            pct = actual * 100 // limit if limit > 0 else None
+            if actual > limit:
+                out.append(("警告", month, cat, actual - limit, limit, actual, pct))
+            elif limit > 0 and actual * 10 >= limit * 9:
+                out.append(("注意", month, cat, limit - actual, limit, actual, pct))
     return out
