diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..bfa3ffb 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -188,3 +188,97 @@ def test_path_type(runner, cls, expect):
 
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
+
+
+CSV_TSV = click.Path(suffixes=(".csv", ".tsv"))
+
+
+@pytest.mark.parametrize(
+    "name", ["a.csv", "a.tsv", "A.CSV", "b.Tsv", "dir/x.csv", "a.b.csv"]
+)
+def test_suffixes_accepts(name):
+    assert CSV_TSV.convert(name, None, None) == name
+
+
+@pytest.mark.parametrize("name", ["a.txt", "csv", "a.csv.bak", ".csv.x", "a.csvx", ""])
+def test_suffixes_rejects(name):
+    with pytest.raises(click.BadParameter, match="must have one of these extensions"):
+        CSV_TSV.convert(name, None, None)
+
+
+def test_suffixes_message_lists_extensions():
+    with pytest.raises(click.BadParameter, match=r"\.csv, \.tsv"):
+        CSV_TSV.convert("a.txt", None, None)
+
+
+def test_suffixes_existing_file(tmp_path):
+    good = tmp_path / "x.CSV"
+    bad = tmp_path / "x.txt"
+    good.touch()
+    bad.touch()
+    type = click.Path(exists=True, suffixes=[".csv"])
+    assert type.convert(str(good), None, None) == str(good)
+
+    with pytest.raises(click.BadParameter, match="extensions"):
+        type.convert(str(bad), None, None)
+
+
+def test_suffixes_checked_before_existence(tmp_path):
+    type = click.Path(exists=True, suffixes=[".csv"])
+
+    with pytest.raises(click.BadParameter, match="extensions"):
+        type.convert(str(tmp_path / "missing.txt"), None, None)
+
+    with pytest.raises(click.BadParameter, match="does not exist"):
+        type.convert(str(tmp_path / "missing.csv"), None, None)
+
+
+def test_suffixes_skips_directory_and_dash(tmp_path):
+    d = tmp_path / "data.d"
+    d.mkdir()
+    type = click.Path(suffixes=[".csv"], allow_dash=True)
+    assert type.convert(str(d), None, None) == str(d)
+    assert type.convert("-", None, None) == "-"
+
+
+def test_suffixes_pathlib_and_bytes(tmp_path):
+    type = click.Path(suffixes=[".csv"], path_type=pathlib.Path)
+    assert type.convert(tmp_path / "a.CSV", None, None) == tmp_path / "a.CSV"
+
+    with pytest.raises(click.BadParameter):
+        type.convert(tmp_path / "a.txt", None, None)
+
+    assert click.Path(suffixes=[".csv"]).convert(b"a.csv", None, None) == b"a.csv"
+
+
+def test_suffixes_default_unchanged():
+    assert click.Path().convert("a.anything", None, None) == "a.anything"
+    assert click.Path().suffixes is None
+
+
+@pytest.mark.parametrize(
+    ("suffixes", "exc"),
+    [
+        (".csv", TypeError),
+        ([], ValueError),
+        ([".csv", ""], ValueError),
+        (["csv"], ValueError),
+        (["."], ValueError),
+        ([1], TypeError),
+    ],
+)
+def test_suffixes_invalid_arguments(suffixes, exc):
+    with pytest.raises(exc):
+        click.Path(suffixes=suffixes)
+
+
+def test_suffixes_in_command(runner):
+    @click.command()
+    @click.argument("f", type=CSV_TSV)
+    def cli(f):
+        click.echo(f)
+
+    assert runner.invoke(cli, ["A.TSV"]).output == "A.TSV\n"
+    result = runner.invoke(cli, ["a.txt"])
+    assert result.exit_code == 2
+    assert "must have one of these extensions: .csv, .tsv." in result.output
