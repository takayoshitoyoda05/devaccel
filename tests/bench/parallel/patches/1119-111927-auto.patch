+"""Tests for bank_import.parse_statement (spec table E2-1..E2-8, invariant P1)."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import ImportResult, parse_statement
+from kakeibo.core import Expense
+
+Check = Callable[[ImportResult], None]
+
+
+def _expect_exact(expenses: list[Expense]) -> Check:
+    def check(result: ImportResult) -> None:
+        assert result.expenses == expenses
+        assert result.errors == []
+
+    return check
+
+
+def _expect_amounts(amounts: list[int]) -> Check:
+    def check(result: ImportResult) -> None:
+        assert [e.amount for e in result.expenses] == amounts
+        assert result.errors == []
+
+    return check
+
+
+def _expect_one_error(line: int, column: str, expenses: list[Expense]) -> Check:
+    def check(result: ImportResult) -> None:
+        assert result.expenses == expenses
+        assert len(result.errors) == 1
+        err = result.errors[0]
+        assert (err.line, err.column) == (line, column)
+        assert err.reason
+
+    return check
+
+
+def _expect_header_error(column: str) -> Check:
+    def check(result: ImportResult) -> None:
+        assert result.expenses == []
+        assert len(result.errors) == 1
+        err = result.errors[0]
+        assert (err.line, err.column) == (1, column)
+        assert err.reason
+
+    return check
+
+
+# (ID, 入力テキスト, invert_sign, 期待の検査) — 設計書の例の表と 1 対 1
+EXAMPLES: list[tuple[str, str, bool, Check]] = [
+    (
+        "E2-1",
+        '日付,摘要,出金額,入金額\n2026/11/3,コンビニ,"1,200",\n',
+        False,
+        _expect_exact([Expense(date(2026, 11, 3), "未分類", 1200, "コンビニ")]),
+    ),
+    (
+        "E2-2",
+        '﻿date,amount\n2026-11-03,"¥1,200"\n',
+        False,
+        _expect_exact([Expense(date(2026, 11, 3), "未分類", 1200, "")]),
+    ),
+    (
+        "E2-3",
+        'date,amount\n2026-11-03,"(3,000)"\n2026-11-04,△500\n2026-11-05,￥１，２００\n',
+        False,
+        _expect_amounts([-3000, -500, 1200]),
+    ),
+    (
+        "E2-4",
+        "date,amount\n2026-11-03,12.5\n2026-11-04,1200\n",
+        False,
+        _expect_one_error(2, "金額", [Expense(date(2026, 11, 4), "未分類", 1200, "")]),
+    ),
+    (
+        "E2-5",
+        "date,amount\n2026/02/30,1200\n",
+        False,
+        _expect_one_error(2, "日付", []),
+    ),
+    (
+        "E2-6",
+        'date,amount,memo\n2026-11-03,100,"a,b\n改行"\n2026-11-04,abc,x\n',
+        False,
+        _expect_one_error(
+            4, "金額", [Expense(date(2026, 11, 3), "未分類", 100, "a,b\n改行")]
+        ),
+    ),
+    (
+        "E2-7",
+        "date,memo\n2026-11-03,x\n",
+        False,
+        _expect_header_error("金額"),
+    ),
+    (
+        "E2-7-empty",
+        "",
+        False,
+        _expect_header_error("日付"),
+    ),
+    (
+        "E2-8",
+        "date,amount\n2026-11-03,1200\n",
+        True,
+        _expect_exact([Expense(date(2026, 11, 3), "未分類", -1200, "")]),
+    ),
+]
+
+
+@pytest.mark.parametrize(
+    ("case_id", "text", "invert_sign", "check"),
+    EXAMPLES,
+    ids=[case[0] for case in EXAMPLES],
+)
+def test_spec_examples(
+    case_id: str, text: str, invert_sign: bool, check: Check
+) -> None:
+    check(parse_statement(text, invert_sign=invert_sign))
+
+
+def test_P1_outcomes_do_not_exceed_nonblank_body_lines() -> None:
+    text = "date,amount\n2026-11-03,100\n\n2026-11-04,abc\n2026-11-05\n2026-13-01,5\n"
+    result = parse_statement(text)
+    body_lines = 4  # 空行を除く本文の物理行数
+    assert len(result.expenses) + len(result.errors) <= body_lines
