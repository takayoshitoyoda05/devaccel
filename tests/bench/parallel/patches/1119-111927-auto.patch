+"""Month-over-month comparison of category totals."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"([0-9]{4})-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    pct: float | None
+    status: str  # "up" "down" "same" "new" "gone"
+
+
+def _parse_month(month: str) -> tuple[int, int]:
+    m = _MONTH_RE.fullmatch(month)
+    if m is None:
+        raise ValueError(f"month は YYYY-MM 形式である必要があります: {month!r}")
+    return int(m.group(1)), int(m.group(2))
+
+
+def _previous_month(year: int, mon: int) -> str:
+    if mon == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mon - 1:02d}"
+
+
+def _month_totals(rows: list[Expense], month: str) -> dict[str, int]:
+    """Category -> sum for rows in `month`. A category with rows is present even if its sum is 0."""
+    out: dict[str, int] = {}
+    for e in rows:
+        if e.day.strftime("%Y-%m") == month:
+            out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def month_over_month(rows: list[Expense], month: str) -> list[CategoryChange]:
+    year, mon = _parse_month(month)
+    prev_month = _previous_month(year, mon)
+    prev = _month_totals(rows, prev_month)
+    cur = _month_totals(rows, month)
+
+    changes: list[CategoryChange] = []
+    for cat in set(prev) | set(cur):
+        if cat not in prev:
+            status = "new"
+            previous = 0
+            current = cur[cat]
+            pct: float | None = None
+        elif cat not in cur:
+            status = "gone"
+            previous = prev[cat]
+            current = 0
+            pct = None if previous == 0 else (-previous) / abs(previous) * 100
+        else:
+            previous = prev[cat]
+            current = cur[cat]
+            pct = None if previous == 0 else (current - previous) / abs(previous) * 100
+            delta_now = current - previous
+            status = "up" if delta_now > 0 else "down" if delta_now < 0 else "same"
+        delta = current - previous
+        changes.append(CategoryChange(cat, previous, current, delta, pct, status))
+
+    changes.sort(key=lambda c: (-abs(c.delta), c.category))
+    return changes
+
+
+def format_changes(changes: list[CategoryChange]) -> str:
+    lines: list[str] = []
+    for c in changes:
+        pct = "-" if c.pct is None else f"{c.pct:+.1f}%"
+        lines.append(f"{c.category}\t{c.previous}→{c.current}\t{c.delta:+d}\t{pct}")
+    return "\n".join(lines)
