+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,88 @@
+"""Detect recurring expenses: same category, memo and amount every month."""
+
+from __future__ import annotations
+
+import calendar
+from collections import defaultdict
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int
+    count: int
+    last_day: date
+    next_day: date
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + (d.month - 1)
+
+
+def _next_day(latest_idx: int, max_day: int) -> date:
+    """Day `max_day` of the month after `latest_idx`, clamped to that month's end."""
+    year, month0 = divmod(latest_idx + 1, 12)
+    month = month0 + 1
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(max_day, last))
+
+
+def find_recurring(rows: list[Expense], min_occurrences: int = 3) -> list[Recurring]:
+    if min_occurrences < 2:
+        raise ValueError("min_occurrences は 2 以上である必要があります")
+
+    # R1: 返金(amount <= 0)は無視し、グループは (category, memo の strip 値)
+    groups: dict[tuple[str, str], list[Expense]] = defaultdict(list)
+    for e in rows:
+        if e.amount <= 0:
+            continue
+        groups[(e.category, e.memo.strip())].append(e)
+
+    found: list[Recurring] = []
+    for (category, memo), items in groups.items():
+        # R2: 同じ月に 2 件以上あるグループは対象外
+        by_month: dict[int, Expense] = {}
+        duplicated = False
+        for e in items:
+            idx = _month_index(e.day)
+            if idx in by_month:
+                duplicated = True
+                break
+            by_month[idx] = e
+        if duplicated:
+            continue
+
+        # R2: 最新月から遡って連続し、最新月と同額の最長列
+        latest = max(by_month)
+        amount = by_month[latest].amount
+        run: list[Expense] = []
+        idx = latest
+        while idx in by_month and by_month[idx].amount == amount:
+            run.append(by_month[idx])
+            idx -= 1
+
+        # R3: 列の長さが min_occurrences 以上なら検出
+        if len(run) < min_occurrences:
+            continue
+
+        # R4: next_day = 最新月の翌月、日は列中の最大の日を月末に丸める
+        max_day = max(e.day.day for e in run)
+        found.append(
+            Recurring(
+                category=category,
+                memo=memo,
+                amount=amount,
+                count=len(run),
+                last_day=by_month[latest].day,
+                next_day=_next_day(latest, max_day),
+            )
+        )
+
+    # R5: next_day 昇順、同じなら category、memo の昇順
+    found.sort(key=lambda r: (r.next_day, r.category, r.memo))
+    return found
