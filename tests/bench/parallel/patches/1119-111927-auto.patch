+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    all_of,
+    amount_between,
+    any_of,
+    between,
+    category,
+    memo_contains,
+    not_,
+    search,
+)
+
+
+def _e(day: date, cat: str, amount: int, memo: str = "") -> Expense:
+    return Expense(day=day, category=cat, amount=amount, memo=memo)
+
+
+ROWS = [
+    _e(date(2026, 1, 5), "食費", 1200, "昼ごはん"),
+    _e(date(2026, 1, 6), "交通", 300, "電車"),
+    _e(date(2026, 1, 7), "娯楽", 5000, "映画"),
+    _e(date(2026, 1, 8), "食費", 250, "コンビニ"),
+]
+
+
+# E3-1 R1 R2: category は名前のどれかと完全一致し、元の順で返す
+@pytest.mark.parametrize("case_id", ["E3-1"])
+def test_E3_1_category_any_of_names_keeps_order(case_id: str) -> None:
+    out = search(ROWS, category("食費", "交通"))
+    assert out == [ROWS[0], ROWS[1], ROWS[3]], case_id
+
+
+# E3-2 R2: 符号付きの値で両端を含む
+@pytest.mark.parametrize(
+    ("amount", "expected_in"),
+    [(-500, True), (0, True), (1, False)],
+    ids=["E3-2-a", "E3-2-b", "E3-2-c"],
+)
+def test_E3_2_amount_between_signed_inclusive(amount: int, expected_in: bool) -> None:
+    rows = [_e(date(2026, 1, 1), "x", amount)]
+    assert (search(rows, amount_between(-500, 0)) == rows) is expected_in
+
+
+# E3-3 R2: 片側無制限で境界 1000 を両方に含む
+@pytest.mark.parametrize(
+    "pred",
+    [amount_between(low=1000), amount_between(high=1000)],
+    ids=["E3-3-low", "E3-3-high"],
+)
+def test_E3_3_amount_between_one_side_open_includes_bound(pred) -> None:
+    rows = [_e(date(2026, 1, 1), "x", 1000)]
+    assert search(rows, pred) == rows
+
+
+# E3-4 R3: 全角半角(NFKC)・大文字小文字を区別せず部分一致
+def test_E3_4_memo_contains_nfkc_match() -> None:
+    rows = [_e(date(2026, 1, 1), "食費", 500, "Starbucks")]
+    assert search(rows, memo_contains("ｓｔａｒ")) == rows
+
+
+# E3-5 R4: 両端の日付を含む
+def test_E3_5_between_inclusive_both_ends() -> None:
+    rows = [
+        _e(date(2026, 10, 31), "x", 1),
+        _e(date(2026, 11, 1), "x", 2),
+        _e(date(2026, 11, 30), "x", 3),
+        _e(date(2026, 12, 1), "x", 4),
+    ]
+    out = search(rows, between(date(2026, 11, 1), date(2026, 11, 30)))
+    assert [e.amount for e in out] == [2, 3]
+
+
+# E3-6 R5: AND の中の OR
+def test_E3_6_all_of_containing_any_of() -> None:
+    pred = all_of(
+        category("食費"), any_of(memo_contains("昼"), amount_between(high=300))
+    )
+    out = search(ROWS, pred)
+    assert out == [ROWS[0], ROWS[3]]
+
+
+# E3-7 R5: 空の AND は真、空の OR は偽、not_ は反転
+@pytest.mark.parametrize(
+    ("pred", "expected"),
+    [
+        (all_of(), ROWS),
+        (any_of(), []),
+        (not_(category("食費")), [ROWS[1], ROWS[2]]),
+    ],
+    ids=["E3-7-all_of", "E3-7-any_of", "E3-7-not_"],
+)
+def test_E3_7_empty_connectives_and_not(pred, expected) -> None:
+    assert search(ROWS, pred) == expected
+
+
+# R1: 入力は変更しない
+def test_R1_input_not_mutated() -> None:
+    rows = list(ROWS)
+    search(rows, category("食費"))
+    assert rows == ROWS
+
+
+# R2: category を 1 つも渡さなければ常に偽
+def test_R2_category_without_names_matches_nothing() -> None:
+    assert search(ROWS, category()) == []
+
+
+# R2: low > high は ValueError
+def test_R2_amount_between_low_above_high_raises() -> None:
+    with pytest.raises(ValueError):
+        amount_between(100, 0)
+
+
+# R3: 空文字は全行に一致
+def test_R3_empty_memo_text_matches_all() -> None:
+    assert search(ROWS, memo_contains("")) == ROWS
+
+
+# R4: start > end は ValueError
+def test_R4_between_start_after_end_raises() -> None:
+    with pytest.raises(ValueError):
+        between(date(2026, 2, 1), date(2026, 1, 1))
+
+
+# R4: 片側無制限
+def test_R4_between_open_ended() -> None:
+    assert search(ROWS, between(start=date(2026, 1, 7))) == [ROWS[2], ROWS[3]]
+    assert search(ROWS, between(end=date(2026, 1, 6))) == [ROWS[0], ROWS[1]]
+
+
+# P1: 結果は入力の部分列(順序保持)
+def test_P1_result_is_subsequence() -> None:
+    out = search(ROWS, not_(category("娯楽")))
+    it = iter(ROWS)
+    assert all(any(r is x for x in it) for r in out)
+
+
+# P2: not_ との和は元の行数に等しい
+def test_P2_not_complement_sums_to_total() -> None:
+    p = category("食費")
+    assert len(search(ROWS, p)) + len(search(ROWS, not_(p))) == len(ROWS)
