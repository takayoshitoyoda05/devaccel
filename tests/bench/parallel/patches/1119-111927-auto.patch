+        ),
+        pytest.param(
+            _VIDEO_E1_3,
+            [
+                Recurring(
+                    category="動画",
+                    memo="video",
+                    amount=1500,
+                    count=3,
+                    last_day=date(2027, 1, 31),
+                    next_day=date(2027, 2, 28),
+                )
+            ],
+            id="E1-3",
+        ),
+        pytest.param(_RENT_E1_4, [], id="E1-4"),
+        pytest.param(_E1_5, [], id="E1-5"),
+        pytest.param(
+            _E1_6,
+            [
+                Recurring(
+                    category="家賃",
+                    memo="アパート",
+                    amount=80000,
+                    count=3,
+                    last_day=date(2026, 11, 25),
+                    next_day=date(2026, 12, 25),
+                )
+            ],
+            id="E1-6",
+        ),
+        pytest.param(_E1_7, [], id="E1-7"),
+    ],
+)
+def test_find_recurring_examples(
+    rows: list[Expense], expected: list[Recurring]
+) -> None:
+    assert find_recurring(rows) == expected
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+def test_min_occurrences_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring(_RENT_E1_1, min_occurrences=1)
+
+
+def test_min_occurrences_controls_detection() -> None:
+    # 2 か月だけの列は min_occurrences=2 なら検出、既定の 3 では対象外
+    rows = [
+        _e("2026-10-25", "家賃", 80000, "アパート"),
+        _e("2026-11-25", "家賃", 80000, "アパート"),
+    ]
+    assert find_recurring(rows) == []
+    assert [r.count for r in find_recurring(rows, min_occurrences=2)] == [2]
+
+
+def test_memo_is_stripped_for_grouping_and_output() -> None:
+    rows = [
+        _e("2026-09-25", "家賃", 80000, " アパート "),
+        _e("2026-10-25", "家賃", 80000, "アパート"),
+        _e("2026-11-25", "家賃", 80000, "アパート  "),
+    ]
+    result = find_recurring(rows)
+    assert [r.memo for r in result] == ["アパート"]
+    assert [r.count for r in result] == [3]
+
+
+def test_zero_and_negative_amounts_are_ignored() -> None:
+    rows = [
+        _e("2026-09-25", "家賃", 80000, "アパート"),
+        _e("2026-10-25", "家賃", 0, "アパート"),
+        _e("2026-10-26", "家賃", 80000, "アパート"),
+        _e("2026-11-25", "家賃", 80000, "アパート"),
+    ]
+    # 0 円の行は無視されるので 10 月は 1 件のみ(同月 2 件にはならない)
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].count == 3
+
+
+def test_results_sorted_by_next_day_then_category_then_memo() -> None:
+    rows = [
+        _e("2026-09-01", "通信", 4000, "b"),
+        _e("2026-10-01", "通信", 4000, "b"),
+        _e("2026-11-01", "通信", 4000, "b"),
+        _e("2026-09-01", "通信", 4000, "a"),
+        _e("2026-10-01", "通信", 4000, "a"),
+        _e("2026-11-01", "通信", 4000, "a"),
+        _e("2026-09-01", "保険", 2000, "x"),
+        _e("2026-10-01", "保険", 2000, "x"),
+        _e("2026-11-01", "保険", 2000, "x"),
+    ]
+    result = find_recurring(rows)
+    assert [(r.category, r.memo) for r in result] == [
+        ("保険", "x"),
+        ("通信", "a"),
+        ("通信", "b"),
+    ]
+
+
+@pytest.mark.parametrize(
+    "rows",
+    [pytest.param(_RENT_E1_1, id="P1-rent"), pytest.param(_VIDEO_E1_3, id="P1-video")],
+)
+def test_invariants_hold(rows: list[Expense]) -> None:
+    min_occ = 3
+    for r in find_recurring(rows, min_occurrences=min_occ):
+        assert r.count >= min_occ
+        assert r.next_day > r.last_day
