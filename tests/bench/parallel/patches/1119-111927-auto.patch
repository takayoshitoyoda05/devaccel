@@ -0,0 +1,66 @@
+"""Search expenses with composable predicates."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable
+from datetime import date
+
+from kakeibo.core import Expense
+
+Predicate = Callable[[Expense], bool]
+
+
+def search(rows: list[Expense], pred: Predicate) -> list[Expense]:
+    """Return the rows for which pred is true, in their original order."""
+    return [e for e in rows if pred(e)]
+
+
+def category(*names: str) -> Predicate:
+    wanted = frozenset(names)
+    return lambda e: e.category in wanted
+
+
+def amount_between(low: int | None = None, high: int | None = None) -> Predicate:
+    if low is not None and high is not None and low > high:
+        raise ValueError(f"low ({low}) は high ({high}) 以下である必要があります")
+
+    def pred(e: Expense) -> bool:
+        if low is not None and e.amount < low:
+            return False
+        return high is None or e.amount <= high
+
+    return pred
+
+
+def _normalize(text: str) -> str:
+    return unicodedata.normalize("NFKC", text).casefold()
+
+
+def memo_contains(text: str) -> Predicate:
+    needle = _normalize(text)
+    return lambda e: needle in _normalize(e.memo)
+
+
+def between(start: date | None = None, end: date | None = None) -> Predicate:
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"start ({start}) は end ({end}) 以前である必要があります")
+
+    def pred(e: Expense) -> bool:
+        if start is not None and e.day < start:
+            return False
+        return end is None or e.day <= end
+
+    return pred
+
+
+def all_of(*preds: Predicate) -> Predicate:
+    return lambda e: all(p(e) for p in preds)
+
+
+def any_of(*preds: Predicate) -> Predicate:
+    return lambda e: any(p(e) for p in preds)
+
+
+def not_(pred: Predicate) -> Predicate:
+    return lambda e: not pred(e)
