index 0000000..05cf51f
--- /dev/null
+++ b/tests/test_compare.py
@@ -0,0 +1,200 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.compare import CategoryChange, format_changes, month_over_month
+from kakeibo.core import Expense
+
+
+def e(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+def by_cat(changes: list[CategoryChange]) -> dict[str, CategoryChange]:
+    return {c.category: c for c in changes}
+
+
+# E4-1: 10月 食費 1000、11月 食費 1500 -> up, R2 R3
+def test_E4_1_up() -> None:
+    rows = [e("2026-10-05", "食費", 1000), e("2026-11-05", "食費", 1500)]
+    (c,) = month_over_month(rows, "2026-11")
+    assert c == CategoryChange("食費", 1000, 1500, 500, 50.0, "up")
+
+
+# E4-2: 10月 食費 1000、11月 食費 400 -> down, R2
+def test_E4_2_down() -> None:
+    rows = [e("2026-10-05", "食費", 1000), e("2026-11-05", "食費", 400)]
+    (c,) = month_over_month(rows, "2026-11")
+    assert c.delta == -600
+    assert c.pct == -60.0
+    assert c.status == "down"
+
+
+# E4-3: 10月 に交通のみ、11月 に食費のみ -> 食費 new(pct None)、交通 gone, R3
+def test_E4_3_new_and_gone() -> None:
+    rows = [e("2026-10-05", "交通", 300), e("2026-11-05", "食費", 800)]
+    got = by_cat(month_over_month(rows, "2026-11"))
+    assert got["食費"].status == "new"
+    assert got["食費"].pct is None
+    assert got["食費"].previous == 0
+    assert got["交通"].status == "gone"
+    assert got["交通"].current == 0
+
+
+# E4-4: 12月 と 1 月(翌年) の比較(month="2027-01") -> 前年 12 月と比べる, R1
+def test_E4_4_january_compares_previous_december() -> None:
+    rows = [e("2026-12-05", "食費", 2000), e("2027-01-05", "食費", 2500)]
+    (c,) = month_over_month(rows, "2027-01")
+    assert c.previous == 2000
+    assert c.current == 2500
+    assert c.status == "up"
+
+
+# E4-5: 食費 1000 と 1000 -> same, delta 0, R3
+def test_E4_5_same() -> None:
+    rows = [e("2026-10-05", "食費", 1000), e("2026-11-05", "食費", 1000)]
+    (c,) = month_over_month(rows, "2026-11")
+    assert c.status == "same"
+    assert c.delta == 0
+
+
+# E4-6: 10月 食費 1000 と 返金 -1000、11月 食費 300 -> previous 0, pct None, up(new ではない), R2 R3
+def test_E4_6_zero_previous_is_up_not_new() -> None:
+    rows = [
+        e("2026-10-05", "食費", 1000),
+        e("2026-10-06", "食費", -1000),
+        e("2026-11-05", "食費", 300),
+    ]
+    (c,) = month_over_month(rows, "2026-11")
+    assert c.previous == 0
+    assert c.current == 300
+    assert c.delta == 300
+    assert c.pct is None
+    assert c.status == "up"
+
+
+# E4-7: 変化が 500 / -500 / 100 の 3 カテゴリ -> 同点は category 昇順 → 100, R4
+def test_E4_7_order_by_abs_delta_then_category() -> None:
+    rows = [
+        e("2026-10-05", "B", 1000),
+        e("2026-11-05", "B", 1500),  # +500
+        e("2026-10-05", "A", 1000),
+        e("2026-11-05", "A", 500),  # -500
+        e("2026-10-05", "C", 1000),
+        e("2026-11-05", "C", 1100),  # +100
+    ]
+    cats = [c.category for c in month_over_month(rows, "2026-11")]
+    assert cats == ["A", "B", "C"]
+
+
+# E4-8: month="2026-13" -> ValueError, R1
+def test_E4_8_invalid_month_raises() -> None:
+    with pytest.raises(ValueError):
+        month_over_month([], "2026-13")
+
+
+# E4-1..E4-8 の ID を parametrize の ids にも載せ、不正な月形式を網羅する
+@pytest.mark.parametrize(
+    "bad",
+    ["2026-13", "2026-00", "2026-1", "26-11", "2026/11", "", "2026-11-01"],
+    ids=[
+        "E4-8",
+        "month-00",
+        "month-short",
+        "year-2digit",
+        "slash",
+        "empty",
+        "with-day",
+    ],
+)
+def test_invalid_month_formats_raise(bad: str) -> None:
+    with pytest.raises(ValueError):
+        month_over_month([], bad)
+
+
+def test_empty_when_neither_month_has_rows() -> None:
+    rows = [e("2026-09-05", "食費", 100)]
+    assert month_over_month(rows, "2026-11") == []
+
+
+# P1: 全結果で delta == current − previous / P2: new は previous == 0 かつ pct None
+@pytest.mark.parametrize(
+    "rows,month",
+    [
+        (
+            [
+                e("2026-10-05", "食費", 1000),
+                e("2026-11-05", "食費", 400),
+                e("2026-11-06", "交通", 90),
+            ],
+            "2026-11",
+        ),
+        (
+            [
+                e("2026-12-05", "食費", 10),
+                e("2027-01-05", "食費", -3),
+                e("2026-12-09", "娯楽", 7),
+            ],
+            "2027-01",
+        ),
+    ],
+    ids=["invariants-a", "invariants-b"],
+)
+def test_invariants_p1_p2(rows: list[Expense], month: str) -> None:
+    changes = month_over_month(rows, month)
+    for c in changes:
+        assert c.delta == c.current - c.previous
+        if c.status == "new":
+            assert c.previous == 0
+            assert c.pct is None
+
+
+def test_pct_is_not_rounded() -> None:
+    rows = [e("2026-10-05", "食費", 3), e("2026-11-05", "食費", 4)]
+    (c,) = month_over_month(rows, "2026-11")
+    assert c.pct == pytest.approx(100 / 3)
+
+
+def test_pct_uses_abs_previous_for_negative_base() -> None:
+    rows = [
+        e("2026-10-05", "食費", 1000),
+        e("2026-10-06", "食費", -1500),
+        e("2026-11-05", "食費", 0),
+    ]
+    # previous = -500, current 0 -> delta 500
+    (c,) = month_over_month(rows, "2026-11")
+    assert c.previous == -500
+    assert c.delta == 500
+    assert c.pct == pytest.approx(100.0)
+
+
+def test_format_changes_lines() -> None:
+    changes = [
+        CategoryChange("食費", 1000, 1500, 500, 50.0, "up"),
+        CategoryChange("交通", 300, 0, -300, -100.0, "gone"),
+        CategoryChange("娯楽", 0, 200, 200, None, "up"),
+    ]
+    lines = [
+        "食費\t1000→1500\t+500\t+50.0%",
+        "交通\t300→0\t-300\t-100.0%",
+        "娯楽\t0→200\t+200\t-",
+    ]
+    assert format_changes(changes) == "\n".join(lines)
+
+
+def test_format_changes_new_has_dash_pct_and_signed_zero_delta() -> None:
+    changes = [CategoryChange("食費", 0, 800, 800, None, "new")]
+    assert format_changes(changes) == "食費\t0→800\t+800\t-"
+    same = [CategoryChange("食費", 1000, 1000, 0, 0.0, "same")]
+    assert format_changes(same) == "食費\t1000→1000\t+0\t+0.0%"
+
+
+def test_format_changes_empty() -> None:
+    assert format_changes([]) == ""
+
+
+def test_format_changes_no_thousands_separator() -> None:
+    changes = [CategoryChange("家賃", 100000, 120000, 20000, 20.0, "up")]
+    assert format_changes(changes) == "家賃\t100000→120000\t+20000\t+20.0%"
