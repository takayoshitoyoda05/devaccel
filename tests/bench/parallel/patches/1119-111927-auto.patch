@@ -0,0 +1,212 @@
+"""Import bank / card statement CSV text into Expense records (pure functions)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+
+
+# canonical column name -> accepted header aliases (compared after NFKC/strip/lower)
+_ALIASES: dict[str, tuple[str, ...]] = {
+    "日付": ("date", "日付", "利用日", "取引日", "年月日"),
+    "金額": ("amount", "金額", "利用金額", "支払金額"),
+    "出金": ("出金", "出金額"),
+    "入金": ("入金", "入金額"),
+    "メモ": ("memo", "摘要", "内容", "利用店名", "備考"),
+    "カテゴリ": ("category", "カテゴリ", "分類"),
+}
+
+_DEFAULT_CATEGORY = "未分類"
+_AMOUNT_DROP = re.compile(r"[¥円,\s]")
+_DATE_PATTERNS = (
+    re.compile(r"([0-9]{4})-([0-9]{2})-([0-9]{2})"),
+    re.compile(r"([0-9]{4})/([0-9]{1,2})/([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日"),
+    re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})"),
+)
+
+
+class _BadRow(Exception):
+    def __init__(self, column: str, reason: str) -> None:
+        super().__init__(reason)
+        self.column = column
+        self.reason = reason
+
+
+@dataclass(frozen=True)
+class _Columns:
+    date: int | None
+    amount: int | None
+    withdrawal: int | None
+    deposit: int | None
+    memo: int | None
+    category: int | None
+
+
+def _norm(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip().lower()
+
+
+def _find(header: list[str], canonical: str) -> int | None:
+    names = {_norm(a) for a in _ALIASES[canonical]}
+    for i, cell in enumerate(header):
+        if cell in names:
+            return i
+    return None
+
+
+def _columns(header: list[str]) -> tuple[_Columns, list[str]]:
+    cols = _Columns(
+        date=_find(header, "日付"),
+        amount=_find(header, "金額"),
+        withdrawal=_find(header, "出金"),
+        deposit=_find(header, "入金"),
+        memo=_find(header, "メモ"),
+        category=_find(header, "カテゴリ"),
+    )
+    missing: list[str] = []
+    if cols.date is None:
+        missing.append("日付")
+    if cols.amount is None and cols.withdrawal is None and cols.deposit is None:
+        missing.append("金額")
+    return cols, missing
+
+
+def _parse_amount(raw: str) -> int:
+    s = _AMOUNT_DROP.sub("", unicodedata.normalize("NFKC", raw))
+    if s == "":
+        raise ValueError("金額が空です")
+    negative = False
+    if s.startswith("△"):
+        negative, s = True, s[1:]
+    elif s.startswith("(") and s.endswith(")"):
+        negative, s = True, s[1:-1]
+    elif s.startswith("-"):
+        negative, s = True, s[1:]
+    if not re.fullmatch(r"[0-9]+", s):
+        raise ValueError(f"金額が整数ではありません: {raw!r}")
+    value = int(s)
+    return -value if negative else value
+
+
+def _parse_date(raw: str) -> date:
+    s = unicodedata.normalize("NFKC", raw).strip()
+    for pattern in _DATE_PATTERNS:
+        m = pattern.fullmatch(s)
+        if m:
+            try:
+                return date(*(int(g) for g in m.groups()))
+            except ValueError:
+                break
+    raise ValueError(f"日付が不正です: {raw!r}")
+
+
+def _optional_amount(raw: str) -> int:
+    """出金/入金用: 空欄は 0。"""
+    if unicodedata.normalize("NFKC", raw).strip() == "":
+        return 0
+    return _parse_amount(raw)
+
+
+def _row_to_expense(
+    cells: list[str], head_len: int, cols: _Columns, invert_sign: bool
+) -> Expense:
+    if len(cells) != head_len:
+        raise _BadRow("行", "列の数が合いません")
+    assert cols.date is not None  # guaranteed by header check
+    try:
+        day = _parse_date(cells[cols.date])
+    except ValueError as e:
+        raise _BadRow("日付", str(e)) from None
+    try:
+        if cols.amount is not None:
+            value = _parse_amount(cells[cols.amount])
+        else:
+            out = (
+                _optional_amount(cells[cols.withdrawal])
+                if cols.withdrawal is not None
+                else 0
+            )
+            inn = (
+                _optional_amount(cells[cols.deposit]) if cols.deposit is not None else 0
+            )
+            value = out - inn
+    except ValueError as e:
+        column = "金額" if cols.amount is not None else _amount_column(cells, cols)
+        raise _BadRow(column, str(e)) from None
+    category = cells[cols.category].strip() if cols.category is not None else ""
+    memo = cells[cols.memo].strip() if cols.memo is not None else ""
+    return Expense(
+        day=day,
+        category=category or _DEFAULT_CATEGORY,
+        amount=-value if invert_sign else value,
+        memo=memo,
+    )
+
+
+def _amount_column(cells: list[str], cols: _Columns) -> str:
+    """出金/入金形式で失敗した列名を返す(出金を先に確認)。"""
+    if cols.withdrawal is not None:
+        try:
+            _optional_amount(cells[cols.withdrawal])
+        except ValueError:
+            return "出金"
+    return "入金"
+
+
+def parse_statement(text: str, invert_sign: bool = False) -> ImportResult:
+    """Parse statement CSV text. Bad rows are dropped and reported in errors."""
+    text = text.removeprefix("﻿")
+
+    # (physical line of row start, cells); blank rows are skipped
+    rows: list[tuple[int, list[str]]] = []
+    reader = csv.reader(io.StringIO(text, newline=""))
+    prev_end = 0
+    for cells in reader:
+        start = prev_end + 1
+        prev_end = reader.line_num
+        if all(c.strip() == "" for c in cells):
+            continue
+        rows.append((start, cells))
+
+    if not rows:
+        return ImportResult([], [RowError(1, "日付", "列が見つかりません")])
+
+    header_line, header_cells = rows[0]
+    header = [_norm(c) for c in header_cells]
+    cols, missing = _columns(header)
+    if missing:
+        return ImportResult(
+            [],
+            [RowError(header_line, column, "列が見つかりません") for column in missing],
+        )
+    if len(rows) == 1:
+        return ImportResult([], [RowError(header_line, "行", "本文がありません")])
+
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    for line, cells in rows[1:]:
+        try:
+            expenses.append(_row_to_expense(cells, len(header), cols, invert_sign))
+        except _BadRow as e:
+            errors.append(RowError(line, e.column, e.reason))
+    return ImportResult(expenses, errors)
