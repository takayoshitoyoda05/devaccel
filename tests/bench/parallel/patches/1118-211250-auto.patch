index 0000000..63d0429
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,227 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+HEADER = "利用日,分類,利用金額,利用店名"
+
+
+# --- parse_amount ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥1000", 1000),
+        ("-980円", -980),
+        ("1,,2", 12),  # カンマの位置は検査しない
+        ("5,", 5),
+        ("-0", 0),
+    ],
+)
+def test_parse_amount_accepts(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "   ",
+        "円",
+        "¥",
+        "-",
+        "12.5",
+        "1 200",
+        "5 円",
+        "--5",
+        "¥-5",
+        "¥¥5",
+        "5円円",
+        "円5",
+        ",5",
+        "１２３",
+        "¥１２３",
+    ],
+)
+def test_parse_amount_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+# --- parse_date -----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/1/5 ", date(2026, 1, 5)),
+        ("2026/12/31", date(2026, 12, 31)),
+        ("2026-1-5", date(2026, 1, 5)),
+    ],
+)
+def test_parse_date_accepts(text: str, expected: date) -> None:
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "2026/1-5",
+        "2026-1/5",
+        "26/1/5",
+        "2026/02/30",
+        "2026/13/1",
+        "2026/0/5",
+        "2026.1.5",
+        "2026/1/5/",
+        "2026/1",
+        "２０２６/1/5",
+        "2026/1/５",
+        "2026/1/5 10:00",
+    ],
+)
+def test_parse_date_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+# --- import_rows ----------------------------------------------------------
+
+
+def test_default_mapping_basic() -> None:
+    text = f'{HEADER}\n2026/1/5,食費,"1,200",スーパー\n'
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 1200, "スーパー")]
+    assert errors == []
+
+
+def test_default_mapping_is_used_when_none() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,100,a\n"
+    assert import_rows(text, None) == import_rows(text, DEFAULT_MAPPING)
+
+
+def test_quoted_comma_in_memo() -> None:
+    text = f'{HEADER}\n2026/1/5,食費,100,"A, B"\n'
+    rows, errors = import_rows(text)
+    assert rows[0].memo == "A, B"
+    assert errors == []
+
+
+def test_extra_columns_ignored() -> None:
+    text = "x,利用日,分類,利用金額,利用店名,y\nzz,2026/1/5,食費,100,a,qq\n"
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "a")]
+    assert errors == []
+
+
+def test_custom_mapping_without_memo_gives_empty_memo() -> None:
+    text = "日付,科目,額\n2026/1/5,食費,100\n"
+    mapping = {"date": "日付", "category": "科目", "amount": "額"}
+    rows, errors = import_rows(text, mapping)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "")]
+    assert errors == []
+
+
+def test_mapping_missing_required_key_raises() -> None:
+    text = "日付,科目,額\n"
+    with pytest.raises(ValueError):
+        import_rows(text, {"category": "科目", "amount": "額"})
+    with pytest.raises(ValueError):
+        import_rows(text, {"date": "日付", "amount": "額"})
+    with pytest.raises(ValueError):
+        import_rows(text, {"date": "日付", "category": "科目"})
+
+
+def test_mapping_column_missing_from_header_raises() -> None:
+    text = "日付,科目,額\n2026/1/5,食費,100\n"
+    with pytest.raises(ValueError):
+        import_rows(text, {"date": "日付", "category": "科目", "amount": "金額"})
+
+
+def test_memo_mapping_column_missing_from_header_raises() -> None:
+    text = "日付,科目,額\n2026/1/5,食費,100\n"
+    mapping = {"date": "日付", "category": "科目", "amount": "額", "memo": "店"}
+    with pytest.raises(ValueError):
+        import_rows(text, mapping)
+
+
+def test_category_map_applied_after_strip() -> None:
+    text = f"{HEADER}\n2026/1/5, 食費 ,100,a\n2026/1/6,交通費,200,b\n"
+    rows, _ = import_rows(text, category_map={"食費": "Food"})
+    assert [r.category for r in rows] == ["Food", "交通費"]
+
+
+def test_memo_is_stripped() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,100,  スーパー  \n"
+    rows, _ = import_rows(text)
+    assert rows[0].memo == "スーパー"
+
+
+def test_blank_and_whitespace_lines_skipped_but_counted() -> None:
+    text = f"{HEADER}\n\n   \n2026/x/5,食費,100,a\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(4, "date")]
+
+
+def test_errors_recorded_in_order_per_row() -> None:
+    text = f"{HEADER}\nbad,,xx,a\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "date"), (2, "amount"), (2, "category")]
+
+
+def test_only_bad_row_excluded_and_good_rows_kept_in_order() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,100,a\n2026/1/6,,200,b\n2026/1/7,交通費,300,c\n"
+    rows, errors = import_rows(text)
+    assert [r.memo for r in rows] == ["a", "c"]
+    assert errors == [(3, "category")]
+
+
+def test_whitespace_only_category_is_error() -> None:
+    text = f"{HEADER}\n2026/1/5,   ,100,a\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "category")]
+
+
+def test_empty_amount_is_error() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,,a\n"
+    _, errors = import_rows(text)
+    assert errors == [(2, "amount")]
+
+
+def test_short_row_missing_values_treated_as_empty() -> None:
+    text = f"{HEADER}\n2026/1/5\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "amount"), (2, "category")]
+
+
+def test_line_number_is_physical_line_across_multiline_field() -> None:
+    text = f'{HEADER}\n2026/1/5,食費,100,"line1\nline2"\n2026/x/1,食費,100,a\n'
+    rows, errors = import_rows(text)
+    assert len(rows) == 1
+    assert rows[0].memo == "line1\nline2"
+    assert errors == [(4, "date")]
+
+
+def test_header_only_returns_empty() -> None:
+    assert import_rows(f"{HEADER}\n") == ([], [])
+
+
+def test_empty_text_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows("")
