@@ -0,0 +1,70 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.dupes import find_duplicates
+
+A = Expense(date(2024, 1, 5), "food", 500, "lunch")
+B = Expense(date(2024, 1, 6), "food", 500, "lunch")
+
+
+def test_empty_list_has_no_duplicates() -> None:
+    assert find_duplicates([]) == []
+
+
+def test_single_row_has_no_duplicates() -> None:
+    assert find_duplicates([A]) == []
+
+
+def test_distinct_rows_have_no_duplicates() -> None:
+    assert find_duplicates([A, B]) == []
+
+
+def test_two_identical_rows() -> None:
+    assert find_duplicates([A, A]) == [(0, 1)]
+
+
+def test_three_identical_rows_lists_all_pairs_in_order() -> None:
+    assert find_duplicates([A, A, A]) == [(0, 1), (0, 2), (1, 2)]
+
+
+def test_non_adjacent_duplicates_use_input_indices() -> None:
+    assert find_duplicates([A, B, A]) == [(0, 2)]
+
+
+def test_interleaved_groups_sorted_by_first_then_second_index() -> None:
+    assert find_duplicates([A, B, A, B]) == [(0, 2), (1, 3)]
+
+
+def test_pairs_ordered_by_i_then_j_across_groups() -> None:
+    assert find_duplicates([A, A, B, A]) == [(0, 1), (0, 3), (1, 3)]
+
+
+def test_differing_day_is_not_duplicate() -> None:
+    other = Expense(date(2024, 1, 6), "food", 500, "lunch")
+    assert find_duplicates([A, other]) == []
+
+
+def test_differing_category_is_not_duplicate() -> None:
+    other = Expense(date(2024, 1, 5), "fun", 500, "lunch")
+    assert find_duplicates([A, other]) == []
+
+
+def test_differing_amount_is_not_duplicate() -> None:
+    other = Expense(date(2024, 1, 5), "food", 501, "lunch")
+    assert find_duplicates([A, other]) == []
+
+
+def test_differing_memo_is_not_duplicate() -> None:
+    other = Expense(date(2024, 1, 5), "food", 500, "dinner")
+    assert find_duplicates([A, other]) == []
+
+
+def test_empty_memo_differs_from_non_empty_memo() -> None:
+    no_memo = Expense(date(2024, 1, 5), "food", 500)
+    assert find_duplicates([A, no_memo]) == []
+
+
+def test_default_memo_matches_explicit_empty_memo() -> None:
+    no_memo = Expense(date(2024, 1, 5), "food", 500)
+    explicit = Expense(date(2024, 1, 5), "food", 500, "")
+    assert find_duplicates([no_memo, explicit]) == [(0, 1)]
diff --git a/tests/test_export.py b/tests/test_export.py
