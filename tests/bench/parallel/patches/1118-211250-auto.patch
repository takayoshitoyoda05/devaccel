diff --git a/src/kakeibo/bankimport.py b/src/kakeibo/bankimport.py
new file mode 100644
index 0000000..d502a15
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,120 @@
+"""Import bank-statement CSV exports as Expense records."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+_AMOUNT_RE = re.compile(r"(-?)[¥￥]?([0-9][0-9,]*)円?")
+_FIELDS = ("date", "category", "amount", "memo")
+
+
+def parse_amount(s: str) -> int:
+    """Parse a bank amount like ``￥1,234`` or ``980円`` into yen."""
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    sign, digits = m.groups()
+    value = int(digits.replace(",", ""))
+    return -value if sign else value
+
+
+def parse_date(s: str) -> date:
+    """Parse ``YYYY/M/D`` or ``YYYY-M-D``."""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    year, _sep, month, day = m.groups()
+    try:
+        return date(int(year), int(month), int(day))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def _cell(row: list[str], index: dict[str, int], field: str) -> str:
+    idx = index.get(field)
+    if idx is None or idx >= len(row):
+        return ""
+    return row[idx]
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Convert bank CSV text (header on line 1) into expenses.
+
+    Returns ``(expenses, errors)`` where errors are ``(line_number, field)``.
+    """
+    cols = DEFAULT_MAPPING if mapping is None else mapping
+    for key in ("date", "category", "amount"):
+        if key not in cols:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header = next(reader, None)
+    if header is None:
+        raise ValueError("ヘッダー行がありません")
+
+    index: dict[str, int] = {}
+    for field in _FIELDS:
+        if field not in cols:
+            continue
+        col = cols[field]
+        if col not in header:
+            raise ValueError(f"列 {col!r} がヘッダーにありません")
+        index[field] = header.index(col)
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    while True:
+        start = reader.line_num + 1
+        row = next(reader, None)
+        if row is None:
+            break
+        if row == [] or (len(row) == 1 and row[0].strip() == ""):
+            continue
+
+        row_errors: list[tuple[int, str]] = []
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(_cell(row, index, "date"))
+        except ValueError:
+            row_errors.append((start, "date"))
+        try:
+            amount = parse_amount(_cell(row, index, "amount"))
+        except ValueError:
+            row_errors.append((start, "amount"))
+        category = _cell(row, index, "category").strip()
+        if not category:
+            row_errors.append((start, "category"))
+
+        if row_errors or day is None or amount is None:
+            errors.extend(row_errors)
+            continue
+
+        if category_map:
+            category = category_map.get(category, category)
+        expenses.append(
+            Expense(
+                day=day,
+                category=category,
+                amount=amount,
+                memo=_cell(row, index, "memo").strip(),
+            )
+        )
+    return expenses, errors
