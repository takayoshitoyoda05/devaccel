+++ b/src/kakeibo/dupes.py
@@ -0,0 +1,25 @@
+"""Detect duplicate expense rows."""
+
+from __future__ import annotations
+
+from collections import defaultdict
+
+from kakeibo.core import Expense
+
+
+def find_duplicates(rows: list[Expense]) -> list[tuple[int, int]]:
+    """Return index pairs (i, j), i < j, of rows identical in every field.
+
+    Pairs are sorted by i ascending, then j ascending.
+    """
+    groups: dict[Expense, list[int]] = defaultdict(list)
+    for idx, row in enumerate(rows):
+        groups[row].append(idx)
+
+    pairs: list[tuple[int, int]] = []
+    for indices in groups.values():
+        for a in range(len(indices)):
+            for b in range(a + 1, len(indices)):
+                pairs.append((indices[a], indices[b]))
+    pairs.sort()
+    return pairs
