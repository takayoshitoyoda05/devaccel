+"""Tests for kakeibo.fmt.yen."""
+
+from __future__ import annotations
+
+import pytest
+
+from kakeibo.fmt import yen
+
+
+@pytest.mark.parametrize(
+    ("n", "expected"),
+    [
+        (1234567, "1,234,567円"),  # 複数の区切り
+        (0, "0円"),  # ゼロは区切りなし
+        (-1200, "-1,200円"),  # 負数は符号を先頭に
+        (1000, "1,000円"),  # ちょうど 4 桁
+        (999, "999円"),  # 区切りが入らない境界
+        (-999, "-999円"),  # 負数の境界
+        (100, "100円"),
+        (1, "1円"),
+        (-1, "-1円"),
+        (1000000, "1,000,000円"),  # 区切りがちょうど 2 つ
+    ],
+)
+def test_yen_formats(n: int, expected: str) -> None:
+    assert yen(n) == expected
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..ceb8ea8
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,231 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def e(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+# --- month_diff -----------------------------------------------------------
+
+
+def test_month_diff_basic_row_fields() -> None:
+    rows = [e("2026-01-05", "food", 1000), e("2026-02-05", "food", 1300)]
+    out = month_diff(rows, "2026-01", "2026-02")
+    assert out == [DiffRow("food", 1000, 1300, 300, 30.0, "up")]
+
+
+def test_month_diff_down_and_pct_rounding() -> None:
+    rows = [e("2026-01-05", "fun", 3000), e("2026-02-05", "fun", 1000)]
+    out = month_diff(rows, "2026-01", "2026-02")
+    assert out[0].delta == -2000
+    assert out[0].pct == -66.7
+    assert out[0].status == "down"
+
+
+def test_month_diff_same_when_delta_zero() -> None:
+    rows = [e("2026-01-05", "food", 500), e("2026-02-05", "food", 500)]
+    out = month_diff(rows, "2026-01", "2026-02")
+    assert out[0].delta == 0
+    assert out[0].status == "same"
+    assert out[0].pct == 0.0
+
+
+def test_month_diff_new_category_has_none_pct() -> None:
+    rows = [e("2026-02-05", "book", 800)]
+    out = month_diff(rows, "2026-01", "2026-02")
+    assert out == [DiffRow("book", 0, 800, 800, None, "new")]
+
+
+def test_month_diff_gone_category() -> None:
+    rows = [e("2026-01-05", "book", 800)]
+    out = month_diff(rows, "2026-01", "2026-02")
+    assert out == [DiffRow("book", 800, 0, -800, -100.0, "gone")]
+
+
+def test_month_diff_status_uses_presence_not_sum() -> None:
+    # prev has a 0-yen entry: present, so not "new", and prev sum is 0 -> pct None
+    rows = [e("2026-01-05", "misc", 0), e("2026-02-05", "misc", 200)]
+    out = month_diff(rows, "2026-01", "2026-02")
+    assert out[0].status == "up"
+    assert out[0].pct is None
+
+
+def test_month_diff_zero_sum_on_both_sides_is_same_when_present() -> None:
+    rows = [e("2026-01-05", "misc", 0), e("2026-02-05", "misc", 0)]
+    out = month_diff(rows, "2026-01", "2026-02")
+    assert out[0].status == "same"
+    assert out[0].pct is None
+
+
+def test_month_diff_ignores_other_months() -> None:
+    rows = [
+        e("2025-12-31", "food", 9999),
+        e("2026-01-05", "food", 100),
+        e("2026-03-01", "food", 7777),
+    ]
+    out = month_diff(rows, "2026-01", "2026-02")
+    assert out == [DiffRow("food", 100, 0, -100, -100.0, "gone")]
+
+
+def test_month_diff_excludes_categories_absent_from_both_months() -> None:
+    rows = [e("2026-03-01", "food", 100)]
+    assert month_diff(rows, "2026-01", "2026-02") == []
+
+
+def test_month_diff_sorted_by_abs_delta_then_category() -> None:
+    rows = [
+        e("2026-01-05", "b", 100),
+        e("2026-02-05", "b", 200),  # delta +100
+        e("2026-01-05", "a", 500),
+        e("2026-02-05", "a", 400),  # delta -100
+        e("2026-02-05", "c", 1000),  # delta +1000 (new)
+    ]
+    cats = [r.category for r in month_diff(rows, "2026-01", "2026-02")]
+    assert cats == ["c", "a", "b"]
+
+
+def test_month_diff_empty_rows() -> None:
+    assert month_diff([], "2026-01", "2026-02") == []
+
+
+@pytest.mark.parametrize(
+    "prev,curr",
+    [
+        ("2026-1", "2026-02"),
+        ("2026-01", "2026-2"),
+        ("2026-00", "2026-02"),
+        ("2026-13", "2026-02"),
+        ("202601", "2026-02"),
+        ("2026/01", "2026-02"),
+        ("", "2026-02"),
+        ("2026-01", "2026-1"),
+        ("2026-01-01", "2026-02"),
+    ],
+)
+def test_month_diff_invalid_month_raises(prev: str, curr: str) -> None:
+    with pytest.raises(ValueError):
+        month_diff([], prev, curr)
+
+
+# --- top_movers -----------------------------------------------------------
+
+
+def _row(cat: str, status: str) -> DiffRow:
+    return DiffRow(cat, 0, 0, 0, None, status)
+
+
+def test_top_movers_excludes_same_and_keeps_order() -> None:
+    diffs = [
+        _row("a", "up"),
+        _row("b", "same"),
+        _row("c", "down"),
+        _row("d", "new"),
+    ]
+    assert [r.category for r in top_movers(diffs)] == ["a", "c", "d"]
+
+
+def test_top_movers_default_n_is_three() -> None:
+    diffs = [_row(c, "up") for c in "abcde"]
+    assert [r.category for r in top_movers(diffs)] == ["a", "b", "c"]
+
+
+def test_top_movers_n_zero_is_empty() -> None:
+    assert top_movers([_row("a", "up")], n=0) == []
+
+
+def test_top_movers_n_larger_than_list() -> None:
+    assert [r.category for r in top_movers([_row("a", "up")], n=10)] == ["a"]
+
+
+def test_top_movers_negative_n_raises() -> None:
+    with pytest.raises(ValueError):
+        top_movers([], n=-1)
+
+
+# --- render_diff ----------------------------------------------------------
+
+
+def test_render_diff_format() -> None:
+    diffs = [
+        DiffRow("food", 1000, 1300, 300, 30.0, "up"),
+        DiffRow("fun", 3000, 1000, -2000, -66.7, "down"),
+        DiffRow("misc", 500, 500, 0, 0.0, "same"),
+        DiffRow("book", 0, 800, 800, None, "new"),
+        DiffRow("gone", 800, 0, -800, -100.0, "gone"),
+    ]
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "food\t1000\t1300\t+300\t+30.0%\n"
+        "fun\t3000\t1000\t-2000\t-66.7%\n"
+        "misc\t500\t500\t+0\t+0.0%\n"
+        "book\t0\t800\t+800\t-\n"
+        "gone\t800\t0\t-800\t-100.0%"
+    )
+
+
+def test_render_diff_no_trailing_newline() -> None:
+    out = render_diff([DiffRow("a", 1, 2, 1, 100.0, "up")])
+    assert not out.endswith("\n")
+    assert out.split("\n") == [
+        "category\tprev\tcurr\tdelta\tpct",
+        "a\t1\t2\t+1\t+100.0%",
+    ]
+
+
+def test_render_diff_empty_is_header_only() -> None:
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_render_diff_negative_zero_pct_is_plus_zero() -> None:
+    # prev negative and delta 0 gives -0.0 without normalisation
+    out = render_diff([DiffRow("a", -5, -5, 0, -0.0, "same")])
+    assert out.split("\n")[1] == "a\t-5\t-5\t+0\t+0.0%"
+
+
+# --- available_months -----------------------------------------------------
+
+
+def test_available_months_sorted_unique() -> None:
+    rows = [
+        e("2026-03-01", "x", 1),
+        e("2026-01-31", "x", 1),
+        e("2026-03-30", "y", 1),
+        e("2025-12-01", "x", 1),
+    ]
+    assert available_months(rows) == ["2025-12", "2026-01", "2026-03"]
+
+
+def test_available_months_empty() -> None:
+    assert available_months([]) == []
+
+
+# --- latest_diff ----------------------------------------------------------
+
+
+def test_latest_diff_uses_last_two_months() -> None:
+    rows = [
+        e("2026-01-05", "food", 100),
+        e("2026-02-05", "food", 200),
+        e("2026-03-05", "food", 150),
+    ]
+    out = latest_diff(rows)
+    assert out == [DiffRow("food", 200, 150, -50, -25.0, "down")]
+
+
+def test_latest_diff_fewer_than_two_months_raises() -> None:
+    with pytest.raises(ValueError):
+        latest_diff([e("2026-01-05", "food", 100)])
+    with pytest.raises(ValueError):
+        latest_diff([])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..6d582de
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,242 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def _e(category: str, memo: str = "", amount: int = 100, day: int = 1) -> Expense:
+    return Expense(day=date(2026, 1, day), category=category, amount=amount, memo=memo)
+
+
+# --- tokenize ---------------------------------------------------------------
+
+
+def test_tokenize_whitespace_only_gives_no_tokens() -> None:
+    assert tokenize("   \t ") == []
+
+
+def test_tokenize_splits_on_whitespace() -> None:
+    assert tokenize("a  b") == [("TERM", "a"), ("TERM", "b")]
+
+
+def test_tokenize_parens() -> None:
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+
+
+def test_tokenize_word_stops_at_paren() -> None:
+    assert tokenize("abc(def") == [
+        ("TERM", "abc"),
+        ("LPAREN", "("),
+        ("TERM", "def"),
+    ]
+
+
+def test_tokenize_quoted_keeps_spaces_and_parens() -> None:
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+
+
+def test_tokenize_quoted_keyword_is_term() -> None:
+    assert tokenize('"AND"') == [("TERM", "AND")]
+
+
+def test_tokenize_unclosed_quote_raises() -> None:
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_raises() -> None:
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_uppercase_operators() -> None:
+    assert tokenize("AND OR NOT") == [
+        ("AND", "AND"),
+        ("OR", "OR"),
+        ("NOT", "NOT"),
+    ]
+
+
+def test_tokenize_lowercase_operators_are_terms() -> None:
+    assert tokenize("and or not") == [
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_cat_prefix() -> None:
+    assert tokenize("cat:食費") == [("CAT", "食費")]
+
+
+def test_tokenize_cat_empty_value_raises() -> None:
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_tokenize_cat_prefix_is_case_sensitive() -> None:
+    assert tokenize("CAT:x") == [("TERM", "CAT:x")]
+
+
+# --- parsing / errors -------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(a",
+        "a)",
+        "a OR",
+        "OR a",
+        "a AND",
+        "AND a",
+        "a AND AND b",
+        "a AND OR b",
+        "NOT",
+        "a OR OR b",
+        ")(",
+    ],
+)
+def test_invalid_queries_raise(q: str) -> None:
+    with pytest.raises(QueryError):
+        filter_rows(q, [])
+
+
+# --- evaluation -------------------------------------------------------------
+
+
+def test_term_matches_memo_substring() -> None:
+    assert matches("ランチ", _e("食費", memo="ランチ代"))
+
+
+def test_term_matches_category_substring() -> None:
+    assert matches("食", _e("食費"))
+
+
+def test_term_is_case_insensitive() -> None:
+    assert matches("ABC", _e("x", memo="xabcx"))
+    assert matches("abc", _e("x", memo="XABCX"))
+
+
+def test_term_does_not_match_amount_or_date() -> None:
+    assert not matches("100", _e("食費", amount=100))
+    assert not matches("2026", _e("食費"))
+
+
+def test_term_no_match() -> None:
+    assert not matches("電車", _e("食費", memo="ランチ"))
+
+
+def test_empty_memo_does_not_match_term() -> None:
+    assert not matches("a", _e("食費", memo=""))
+
+
+def test_cat_requires_exact_category() -> None:
+    assert matches("cat:食費", _e("食費"))
+    assert not matches("cat:食", _e("食費"))
+    assert not matches("cat:食費", _e("食費2"))
+
+
+def test_cat_does_not_match_memo() -> None:
+    assert not matches("cat:ランチ", _e("食費", memo="ランチ"))
+
+
+def test_cat_is_case_insensitive() -> None:
+    assert matches("cat:FOOD", _e("food"))
+    assert matches("cat:food", _e("FOOD"))
+
+
+def test_implicit_and() -> None:
+    assert matches("食費 ランチ", _e("食費", memo="ランチ"))
+    assert not matches("食費 電車", _e("食費", memo="ランチ"))
+
+
+def test_explicit_and() -> None:
+    assert matches("食費 AND ランチ", _e("食費", memo="ランチ"))
+    assert not matches("食費 AND 電車", _e("食費", memo="ランチ"))
+
+
+def test_or() -> None:
+    assert matches("電車 OR ランチ", _e("食費", memo="ランチ"))
+    assert not matches("電車 OR バス", _e("食費", memo="ランチ"))
+
+
+def test_not() -> None:
+    assert matches("NOT 電車", _e("食費", memo="ランチ"))
+    assert not matches("NOT ランチ", _e("食費", memo="ランチ"))
+
+
+def test_double_not() -> None:
+    assert matches("NOT NOT ランチ", _e("食費", memo="ランチ"))
+
+
+def test_precedence_and_binds_tighter_than_or() -> None:
+    # a OR b c  ==  a OR (b AND c)
+    e = _e("x", memo="a")
+    assert matches("a OR b c", e)
+    # b OR (a AND c): memo "a" has no b and no c -> False
+    assert not matches("b OR a c", _e("x", memo="a"))
+    # memo "b" satisfies the left side of OR -> True
+    assert matches("b OR a c", _e("x", memo="b"))
+
+
+def test_precedence_not_binds_tighter_than_and() -> None:
+    # NOT a b == (NOT a) AND b
+    assert matches("NOT a b", _e("x", memo="b"))
+    assert not matches("NOT a b", _e("x", memo="ab"))
+
+
+def test_parentheses_override_precedence() -> None:
+    # (a OR b) c
+    assert not matches("(a OR b) c", _e("x", memo="a"))
+    assert matches("(a OR b) c", _e("x", memo="ac"))
+
+
+def test_not_applies_to_parenthesized_group() -> None:
+    assert matches("NOT (a OR b)", _e("x", memo="c"))
+    assert not matches("NOT (a OR b)", _e("x", memo="b"))
+
+
+def test_quoted_term_with_space() -> None:
+    assert matches('"ランチ 代"', _e("食費", memo="昼 ランチ 代 です"))
+    assert not matches('"ランチ 代"', _e("食費", memo="ランチ代"))
+
+
+def test_quoted_term_with_parens_is_literal() -> None:
+    assert matches('"(x)"', _e("食費", memo="a(x)b"))
+
+
+def test_quoted_keyword_is_term_not_operator() -> None:
+    assert matches('"OR"', _e("x", memo="ORANGE"))
+    assert not matches('"OR"', _e("x", memo="a"))
+
+
+# --- filter_rows ------------------------------------------------------------
+
+
+def test_filter_rows_keeps_input_order() -> None:
+    rows = [
+        _e("食費", memo="a", day=3),
+        _e("交通費", memo="a", day=1),
+        _e("食費", memo="b", day=2),
+    ]
+    out = filter_rows("a", rows)
+    assert [e.day.day for e in out] == [3, 1]
+
+
+def test_filter_rows_empty_input_valid_query() -> None:
+    assert filter_rows("食費", []) == []
+
+
+def test_filter_rows_empty_input_invalid_query_raises() -> None:
+    with pytest.raises(QueryError):
+        filter_rows("a AND", [])
+
+
+def test_filter_rows_no_match_returns_empty() -> None:
+    assert filter_rows("zzz", [_e("食費", memo="a")]) == []
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..98a1449
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,231 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def _e(
+    day: date, category: str = "通信", amount: int = 1000, memo: str = ""
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- add_month ---------------------------------------------------------------
+
+
+def test_add_month_same_day_next_month() -> None:
+    assert add_month(date(2026, 3, 15)) == date(2026, 4, 15)
+
+
+def test_add_month_wraps_year_from_december() -> None:
+    assert add_month(date(2026, 12, 15)) == date(2027, 1, 15)
+
+
+def test_add_month_dec31_to_jan31() -> None:
+    assert add_month(date(2026, 12, 31)) == date(2027, 1, 31)
+
+
+def test_add_month_clamps_to_end_of_non_leap_february() -> None:
+    assert add_month(date(2026, 1, 31)) == date(2026, 2, 28)
+
+
+def test_add_month_clamps_to_end_of_leap_february() -> None:
+    assert add_month(date(2024, 1, 31)) == date(2024, 2, 29)
+
+
+def test_add_month_feb29_to_march29() -> None:
+    assert add_month(date(2024, 2, 29)) == date(2024, 3, 29)
+
+
+def test_add_month_day30_clamps_only_when_needed() -> None:
+    assert add_month(date(2026, 3, 30)) == date(2026, 4, 30)
+    assert add_month(date(2026, 1, 30)) == date(2026, 2, 28)
+
+
+# --- find_recurring: argument validation -------------------------------------
+
+
+@pytest.mark.parametrize("min_count", [1, 0, -1])
+def test_min_count_below_two_raises(min_count: int) -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=min_count)
+
+
+def test_negative_tolerance_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_min_count_two_and_zero_tolerance_are_accepted() -> None:
+    assert find_recurring([], min_count=2, tolerance=0) == []
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+# --- find_recurring: basic detection -----------------------------------------
+
+
+def test_monthly_three_occurrences_detected() -> None:
+    rows = [_e(date(2026, 1, 10)), _e(date(2026, 2, 10)), _e(date(2026, 3, 10))]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="通信",
+            amount=1000,
+            days=(date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10)),
+            next_expected=date(2026, 4, 10),
+        )
+    ]
+
+
+def test_two_occurrences_not_enough_with_default_min_count() -> None:
+    rows = [_e(date(2026, 1, 10)), _e(date(2026, 2, 10))]
+    assert find_recurring(rows) == []
+
+
+def test_two_occurrences_enough_when_min_count_is_two() -> None:
+    rows = [_e(date(2026, 1, 10)), _e(date(2026, 2, 10))]
+    result = find_recurring(rows, min_count=2)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 10))
+
+
+def test_memo_is_ignored_for_grouping() -> None:
+    rows = [
+        _e(date(2026, 1, 10), memo="a"),
+        _e(date(2026, 2, 10), memo=""),
+        _e(date(2026, 3, 10), memo="c"),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_different_amount_same_category_is_separate_group() -> None:
+    rows = [
+        _e(date(2026, 1, 10), amount=1000),
+        _e(date(2026, 2, 10), amount=1000),
+        _e(date(2026, 3, 10), amount=1000),
+        _e(date(2026, 1, 20), amount=500),
+        _e(date(2026, 2, 20), amount=500),
+    ]
+    result = find_recurring(rows)
+    assert [(r.amount, len(r.days)) for r in result] == [(1000, 3)]
+
+
+def test_duplicate_days_counted_once() -> None:
+    # 同じ日の明細 2 件は 1 回として数えるので、unique 日付が 2 つだけなら該当しない
+    rows = [
+        _e(date(2026, 1, 10)),
+        _e(date(2026, 1, 10), memo="別件"),
+        _e(date(2026, 2, 10)),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_duplicate_days_do_not_appear_twice_in_days() -> None:
+    rows = [
+        _e(date(2026, 1, 10)),
+        _e(date(2026, 1, 10)),
+        _e(date(2026, 2, 10)),
+        _e(date(2026, 3, 10)),
+    ]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10))
+
+
+def test_unsorted_input_is_sorted_ascending_in_days() -> None:
+    rows = [_e(date(2026, 3, 10)), _e(date(2026, 1, 10)), _e(date(2026, 2, 10))]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10))
+
+
+def test_days_is_tuple_and_next_expected_uses_add_month_of_last() -> None:
+    rows = [_e(date(2026, 1, 31)), _e(date(2026, 2, 28)), _e(date(2026, 3, 31))]
+    result = find_recurring(rows)
+    assert isinstance(result[0].days, tuple)
+    assert result[0].next_expected == date(2026, 4, 30)
+
+
+# --- find_recurring: tolerance ----------------------------------------------
+
+
+def test_gap_within_tolerance_is_connected() -> None:
+    # 2026-02-15 の翌月は 2026-03-15。3/17 は 2 日ずれ。
+    rows = [_e(date(2026, 1, 15)), _e(date(2026, 2, 15)), _e(date(2026, 3, 17))]
+    assert len(find_recurring(rows, tolerance=2)) == 1
+
+
+def test_gap_beyond_tolerance_breaks_chain() -> None:
+    rows = [_e(date(2026, 1, 15)), _e(date(2026, 2, 15)), _e(date(2026, 3, 17))]
+    assert find_recurring(rows, tolerance=1) == []
+
+
+def test_tolerance_zero_requires_exact_month_step() -> None:
+    rows = [_e(date(2026, 1, 15)), _e(date(2026, 2, 15)), _e(date(2026, 3, 15))]
+    assert len(find_recurring(rows, tolerance=0)) == 1
+
+
+# --- find_recurring: run splitting ------------------------------------------
+
+
+def test_chain_break_splits_into_two_runs() -> None:
+    # 4 月が欠けている: 1-3 月と 5-7 月の 2 区間になる
+    rows = [
+        _e(date(2026, 1, 10)),
+        _e(date(2026, 2, 10)),
+        _e(date(2026, 3, 10)),
+        _e(date(2026, 5, 10)),
+        _e(date(2026, 6, 10)),
+        _e(date(2026, 7, 10)),
+    ]
+    result = find_recurring(rows)
+    assert result == [
+        Recurring(
+            "通信",
+            1000,
+            (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10)),
+            date(2026, 4, 10),
+        ),
+        Recurring(
+            "通信",
+            1000,
+            (date(2026, 5, 10), date(2026, 6, 10), date(2026, 7, 10)),
+            date(2026, 8, 10),
+        ),
+    ]
+
+
+def test_short_run_dropped_long_run_kept() -> None:
+    rows = [
+        _e(date(2026, 1, 10)),
+        _e(date(2026, 3, 10)),
+        _e(date(2026, 4, 10)),
+        _e(date(2026, 5, 10)),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 3, 10), date(2026, 4, 10), date(2026, 5, 10))
+
+
+# --- find_recurring: ordering ------------------------------------------------
+
+
+def test_results_sorted_by_category_then_amount_then_first_day() -> None:
+    rows: list[Expense] = []
+    for amount, cat in [(300, "食費"), (100, "食費"), (200, "通信")]:
+        for m in (1, 2, 3):
+            rows.append(_e(date(2026, m, 5), category=cat, amount=amount))
+    # 同じ (category, amount) で 2 区間目が後ろの日付から始まる例
+    for m in (6, 7, 8):
+        rows.append(_e(date(2026, m, 20), category="食費", amount=100))
+    result = [(r.category, r.amount, r.days[0]) for r in find_recurring(rows)]
+    assert result == [
+        ("通信", 200, date(2026, 1, 5)),
+        ("食費", 100, date(2026, 1, 5)),
+        ("食費", 100, date(2026, 6, 20)),
+        ("食費", 300, date(2026, 1, 5)),
+    ]
diff --git a/tests/test_split.py b/tests/test_split.py
new file mode 100644
