@@ -0,0 +1,71 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.streak import longest_no_spend_streak
+
+
+def _e(day: date, amount: int = 100) -> Expense:
+    return Expense(day=day, category="food", amount=amount, memo="")
+
+
+def test_no_rows_counts_whole_period() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 1), date(2026, 1, 10)) == 10
+
+
+def test_single_day_period_without_spend() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 5), date(2026, 1, 5)) == 1
+
+
+def test_single_day_period_with_spend() -> None:
+    rows = [_e(date(2026, 1, 5))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 5), date(2026, 1, 5)) == 0
+
+
+def test_spend_on_start_day() -> None:
+    rows = [_e(date(2026, 1, 1))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 4)) == 3
+
+
+def test_spend_on_end_day() -> None:
+    rows = [_e(date(2026, 1, 4))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 4)) == 3
+
+
+def test_spend_in_middle_splits_runs() -> None:
+    rows = [_e(date(2026, 1, 3))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 5)) == 2
+
+
+def test_longest_run_wins_over_later_shorter_run() -> None:
+    rows = [_e(date(2026, 1, 2)), _e(date(2026, 1, 6))]
+    # no-spend runs: day 1 (1 day), days 3-5 (3 days), day 7 (1 day)
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 7)) == 3
+
+
+def test_longest_run_at_beginning() -> None:
+    rows = [_e(date(2026, 1, 4))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 5)) == 3
+
+
+def test_multiple_records_on_same_day_count_once() -> None:
+    rows = [_e(date(2026, 1, 2), 100), _e(date(2026, 1, 2), 200)]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 3)) == 1
+
+
+def test_zero_amount_record_still_counts_as_spend() -> None:
+    rows = [_e(date(2026, 1, 2), 0)]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 3)) == 1
+
+
+def test_records_outside_period_are_ignored() -> None:
+    rows = [_e(date(2025, 12, 31)), _e(date(2026, 2, 1))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 3)) == 3
+
+
+def test_start_after_end_returns_zero() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 5), date(2026, 1, 1)) == 0
+
+
+def test_period_spans_month_boundary() -> None:
+    rows = [_e(date(2026, 1, 31))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 30), date(2026, 2, 2)) == 2
diff --git a/tests/test_topn.py b/tests/test_topn.py
new file mode 100644
index 0000000..47554d5
--- /dev/null
+++ b/tests/test_topn.py
@@ -0,0 +1,72 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.topn import top_expenses
+
+
+def _e(day: str, amount: int, category: str = "食費", memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+def test_orders_by_amount_descending() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 500), _e("2026-01-03", 300)]
+    assert [e.amount for e in top_expenses(rows, 3)] == [500, 300, 100]
+
+
+def test_returns_only_n_items() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 500), _e("2026-01-03", 300)]
+    assert [e.amount for e in top_expenses(rows, 2)] == [500, 300]
+
+
+def test_n_equal_to_length_returns_all() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 500)]
+    assert [e.amount for e in top_expenses(rows, 2)] == [500, 100]
+
+
+def test_n_greater_than_length_returns_all_sorted() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 500)]
+    assert [e.amount for e in top_expenses(rows, 10)] == [500, 100]
+
+
+def test_n_zero_returns_empty_list() -> None:
+    rows = [_e("2026-01-01", 100)]
+    assert top_expenses(rows, 0) == []
+
+
+def test_negative_n_returns_empty_list() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 500)]
+    assert top_expenses(rows, -1) == []
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert top_expenses([], 3) == []
+
+
+def test_same_amount_orders_by_earlier_date_first() -> None:
+    late = _e("2026-03-01", 500, memo="late")
+    early = _e("2026-01-01", 500, memo="early")
+    result = top_expenses([late, early], 2)
+    assert [e.memo for e in result] == ["early", "late"]
+
+
+def test_same_amount_and_date_keeps_input_order() -> None:
+    first = _e("2026-01-01", 500, category="食費", memo="first")
+    second = _e("2026-01-01", 500, category="日用品", memo="second")
+    result = top_expenses([first, second], 2)
+    assert [e.memo for e in result] == ["first", "second"]
+
+
+def test_amount_takes_precedence_over_date() -> None:
+    small_early = _e("2026-01-01", 100)
+    big_late = _e("2026-12-31", 900)
+    result = top_expenses([small_early, big_late], 1)
+    assert result == [big_late]
+
+
+def test_does_not_modify_input_list() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 500)]
+    snapshot = list(rows)
+    top_expenses(rows, 1)
+    assert rows == snapshot
diff --git a/tests/test_weekday.py b/tests/test_weekday.py
new file mode 100644
index 0000000..d7f25a7
--- /dev/null
+++ b/tests/test_weekday.py
@@ -0,0 +1,79 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.weekday import total_by_weekday
+
+
+def _e(day: date, amount: int, category: str = "food") -> Expense:
+    return Expense(day=day, category=category, amount=amount)
+
+
+def test_empty_rows_returns_empty_dict() -> None:
+    assert total_by_weekday([]) == {}
+
+
+def test_single_row_maps_to_its_weekday() -> None:
+    # 2026-11-16 は月曜日
+    assert total_by_weekday([_e(date(2026, 11, 16), 500)]) == {"Mon": 500}
+
+
+def test_same_weekday_across_weeks_is_summed() -> None:
+    rows = [_e(date(2026, 11, 16), 500), _e(date(2026, 11, 23), 300)]
+    assert total_by_weekday(rows) == {"Mon": 800}
+
+
+def test_multiple_rows_on_same_day_are_summed() -> None:
+    rows = [_e(date(2026, 11, 18), 100), _e(date(2026, 11, 18), 250)]
+    assert total_by_weekday(rows) == {"Wed": 350}
+
+
+def test_weekdays_without_rows_are_omitted() -> None:
+    rows = [_e(date(2026, 11, 16), 500), _e(date(2026, 11, 20), 200)]
+    result = total_by_weekday(rows)
+    assert set(result) == {"Mon", "Fri"}
+    assert "Tue" not in result
+
+
+def test_all_seven_weekdays_are_mapped_correctly() -> None:
+    # 2026-11-16 (Mon) .. 2026-11-22 (Sun)
+    rows = [_e(date(2026, 11, 16 + i), (i + 1) * 10) for i in range(7)]
+    assert total_by_weekday(rows) == {
+        "Mon": 10,
+        "Tue": 20,
+        "Wed": 30,
+        "Thu": 40,
+        "Fri": 50,
+        "Sat": 60,
+        "Sun": 70,
+    }
+
+
+def test_keys_are_in_monday_first_order_regardless_of_input_order() -> None:
+    rows = [
+        _e(date(2026, 11, 22), 1),  # Sun
+        _e(date(2026, 11, 18), 1),  # Wed
+        _e(date(2026, 11, 16), 1),  # Mon
+    ]
+    assert list(total_by_weekday(rows)) == ["Mon", "Wed", "Sun"]
+
+
+def test_category_is_ignored_for_totals() -> None:
+    rows = [_e(date(2026, 11, 16), 100, "food"), _e(date(2026, 11, 16), 200, "rent")]
+    assert total_by_weekday(rows) == {"Mon": 300}
+
+
+def test_zero_amount_rows_still_produce_their_weekday() -> None:
+    # 明細がある曜日は、合計が 0 でも含める
+    assert total_by_weekday([_e(date(2026, 11, 17), 0)]) == {"Tue": 0}
+
+
+def test_negative_amounts_are_summed_as_is() -> None:
+    rows = [_e(date(2026, 11, 16), 1000), _e(date(2026, 11, 23), -300)]
+    assert total_by_weekday(rows) == {"Mon": 700}
+
+
+def test_input_list_is_not_mutated() -> None:
+    rows = [_e(date(2026, 11, 22), 1), _e(date(2026, 11, 16), 2)]
+    snapshot = list(rows)
+    total_by_weekday(rows)
+    assert rows == snapshot
