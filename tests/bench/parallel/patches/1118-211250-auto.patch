@@ -0,0 +1,69 @@
+"""Tests for kakeibo.export.to_json."""
+
+from __future__ import annotations
+
+import json
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.export import to_json
+
+
+def test_empty_list_gives_empty_json_array() -> None:
+    assert to_json([]) == "[]"
+
+
+def test_single_row_has_expected_keys_in_order() -> None:
+    rows = [Expense(date(2024, 3, 5), "食費", 1200, "昼食")]
+    out = to_json(rows)
+    assert out == (
+        '[{"date": "2024-03-05", "category": "食費", "amount": 1200, "memo": "昼食"}]'
+    )
+
+
+def test_keys_are_ordered_date_category_amount_memo() -> None:
+    rows = [Expense(date(2024, 1, 2), "交通", 300, "bus")]
+    obj = json.loads(to_json(rows))
+    assert list(obj[0].keys()) == ["date", "category", "amount", "memo"]
+
+
+def test_preserves_input_order() -> None:
+    rows = [
+        Expense(date(2024, 5, 1), "b", 2),
+        Expense(date(2024, 1, 1), "a", 1),
+        Expense(date(2024, 3, 1), "c", 3),
+    ]
+    obj = json.loads(to_json(rows))
+    assert [o["date"] for o in obj] == ["2024-05-01", "2024-01-01", "2024-03-01"]
+
+
+def test_non_ascii_is_not_escaped() -> None:
+    rows = [Expense(date(2024, 1, 1), "食費", 100, "コンビニ")]
+    out = to_json(rows)
+    assert "食費" in out
+    assert "コンビニ" in out
+    assert "\\u" not in out
+
+
+def test_no_indentation_or_newlines() -> None:
+    rows = [Expense(date(2024, 1, 1), "食費", 100, "x")]
+    assert "\n" not in to_json(rows)
+
+
+def test_empty_memo_is_kept_as_empty_string() -> None:
+    rows = [Expense(date(2024, 1, 1), "食費", 100)]
+    obj = json.loads(to_json(rows))
+    assert obj[0]["memo"] == ""
+
+
+def test_date_is_zero_padded_iso() -> None:
+    rows = [Expense(date(2024, 1, 9), "食費", 0, "")]
+    obj = json.loads(to_json(rows))
+    assert obj[0]["date"] == "2024-01-09"
+
+
+def test_amount_is_integer_in_json() -> None:
+    rows = [Expense(date(2024, 1, 1), "食費", 1500, "")]
+    obj = json.loads(to_json(rows))
+    assert obj[0]["amount"] == 1500
+    assert isinstance(obj[0]["amount"], int)
