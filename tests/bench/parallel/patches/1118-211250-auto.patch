@@ -0,0 +1,17 @@
+"""Aggregate expenses by day of week."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+# 月曜始まりの順。
+_WEEKDAYS = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
+
+
+def total_by_weekday(rows: list[Expense]) -> dict[str, int]:
+    """{"Mon".."Sun": yen}. Weekdays with no rows are omitted; keys are Monday-first."""
+    sums: dict[str, int] = {}
+    for e in rows:
+        name = _WEEKDAYS[e.day.weekday()]
+        sums[name] = sums.get(name, 0) + e.amount
+    return {name: sums[name] for name in _WEEKDAYS if name in sums}
