+++ b/tests/test_stats.py
@@ -0,0 +1,67 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.stats import median_by_category
+
+
+def _e(category: str, amount: int) -> Expense:
+    return Expense(day=date(2026, 11, 1), category=category, amount=amount)
+
+
+def test_empty_rows_returns_empty_dict():
+    assert median_by_category([]) == {}
+
+
+def test_single_row_median_is_its_amount_as_float():
+    result = median_by_category([_e("food", 100)])
+    assert result == {"food": 100.0}
+    assert isinstance(result["food"], float)
+
+
+def test_odd_count_takes_middle_value_regardless_of_input_order():
+    rows = [_e("food", 300), _e("food", 100), _e("food", 200)]
+    assert median_by_category(rows) == {"food": 200.0}
+
+
+def test_even_count_averages_the_two_middle_values():
+    rows = [_e("food", 400), _e("food", 100), _e("food", 300), _e("food", 200)]
+    assert median_by_category(rows) == {"food": 250.0}
+
+
+def test_even_count_with_equal_middle_values():
+    rows = [_e("food", 100), _e("food", 200), _e("food", 200), _e("food", 900)]
+    assert median_by_category(rows) == {"food": 200.0}
+
+
+def test_duplicate_values_are_counted_each_time():
+    rows = [_e("food", 500), _e("food", 500), _e("food", 500)]
+    assert median_by_category(rows) == {"food": 500.0}
+
+
+def test_negative_amounts_are_medianed_like_any_other():
+    rows = [_e("refund", -300), _e("refund", -100), _e("refund", 200)]
+    assert median_by_category(rows) == {"refund": -100.0}
+
+
+def test_categories_are_medianed_independently():
+    rows = [
+        _e("food", 100),
+        _e("rent", 90000),
+        _e("food", 300),
+        _e("rent", 80000),
+        _e("food", 200),
+    ]
+    assert median_by_category(rows) == {"food": 200.0, "rent": 85000.0}
+
+
+def test_keys_are_sorted_by_category_name_ascending():
+    rows = [_e("transport", 10), _e("food", 20), _e("hobby", 30), _e("bills", 40)]
+    result = median_by_category(rows)
+    assert list(result) == ["bills", "food", "hobby", "transport"]
+
+
+def test_input_list_is_not_mutated():
+    rows = [_e("food", 300), _e("food", 100), _e("food", 200)]
+    snapshot = list(rows)
+    median_by_category(rows)
+    assert rows == snapshot
