--- /dev/null
+++ b/src/kakeibo/split.py
@@ -0,0 +1,15 @@
+"""Split an amount in yen evenly among people."""
+
+from __future__ import annotations
+
+
+def split_evenly(amount: int, people: int) -> list[int]:
+    """Split ``amount`` yen among ``people``.
+
+    The remainder is added 1 yen at a time starting from the first person,
+    so the shares always sum to ``amount``.
+    """
+    if people < 1:
+        raise ValueError(f"people は 1 以上である必要があります: {people}")
+    base, remainder = divmod(amount, people)
+    return [base + (1 if i < remainder else 0) for i in range(people)]
