+"""No-spend streak calculation."""
+
+from __future__ import annotations
+
+from datetime import date, timedelta
+
+from kakeibo.core import Expense
+
+
+def longest_no_spend_streak(rows: list[Expense], start: date, end: date) -> int:
+    """Longest run of consecutive days in [start, end] with no expense record.
+
+    Both ends are inclusive. Records outside the period are ignored. If
+    start is after end, the period is empty and the result is 0.
+    """
+    spent_days = {e.day for e in rows}
+    best = 0
+    current = 0
+    day = start
+    while day <= end:
+        if day in spent_days:
+            current = 0
+        else:
+            current += 1
+            best = max(best, current)
+        day += timedelta(days=1)
+    return best
diff --git a/src/kakeibo/topn.py b/src/kakeibo/topn.py
new file mode 100644
index 0000000..0c974f2
--- /dev/null
+++ b/src/kakeibo/topn.py
@@ -0,0 +1,17 @@
+"""Top-N expenses by amount."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def top_expenses(rows: list[Expense], n: int) -> list[Expense]:
+    """Return up to n expenses, largest amount first.
+
+    Ties on amount are broken by earlier date first; if both match, the
+    original input order is kept (sorted() is stable). n <= 0 returns [].
+    """
+    if n <= 0:
+        return []
+    ordered = sorted(rows, key=lambda e: (-e.amount, e.day))
+    return ordered[:n]
