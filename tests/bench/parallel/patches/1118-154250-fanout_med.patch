+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def E(
+    day: date, category: str = "rent", amount: int = 80000, memo: str = ""
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- add_month -------------------------------------------------------------
+
+
+def test_add_month_plain_day():
+    assert add_month(date(2026, 11, 15)) == date(2026, 12, 15)
+
+
+def test_add_month_year_rollover_dec_to_jan():
+    assert add_month(date(2026, 12, 15)) == date(2027, 1, 15)
+
+
+def test_add_month_dec_31_to_jan_31():
+    assert add_month(date(2026, 12, 31)) == date(2027, 1, 31)
+
+
+def test_add_month_clamps_to_end_of_short_month():
+    assert add_month(date(2026, 1, 31)) == date(2026, 2, 28)
+
+
+def test_add_month_clamps_to_leap_day():
+    assert add_month(date(2024, 1, 31)) == date(2024, 2, 29)
+
+
+def test_add_month_30th_in_february_clamps():
+    assert add_month(date(2026, 1, 30)) == date(2026, 2, 28)
+
+
+def test_add_month_30th_into_30_day_month_is_not_clamped():
+    assert add_month(date(2026, 3, 30)) == date(2026, 4, 30)
+
+
+# --- find_recurring: validation -------------------------------------------
+
+
+def test_min_count_below_two_is_rejected():
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+
+
+def test_negative_tolerance_is_rejected():
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_min_count_two_and_zero_tolerance_are_accepted():
+    rows = [E(date(2026, 1, 10)), E(date(2026, 2, 10))]
+    assert find_recurring(rows, min_count=2, tolerance=0) == [
+        Recurring(
+            "rent", 80000, (date(2026, 1, 10), date(2026, 2, 10)), date(2026, 3, 10)
+        )
+    ]
+
+
+# --- find_recurring: basic detection --------------------------------------
+
+
+def test_empty_input_returns_empty_list():
+    assert find_recurring([]) == []
+
+
+def test_three_monthly_payments_are_detected():
+    rows = [E(date(2026, 1, 10)), E(date(2026, 2, 10)), E(date(2026, 3, 10))]
+    assert find_recurring(rows) == [
+        Recurring(
+            "rent",
+            80000,
+            (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10)),
+            date(2026, 4, 10),
+        )
+    ]
+
+
+def test_below_min_count_is_not_reported():
+    rows = [E(date(2026, 1, 10)), E(date(2026, 2, 10))]
+    assert find_recurring(rows) == []
+
+
+def test_min_count_is_inclusive():
+    rows = [E(date(2026, 1, 10)), E(date(2026, 2, 10)), E(date(2026, 3, 10))]
+    assert len(find_recurring(rows, min_count=3)) == 1
+    assert find_recurring(rows, min_count=4) == []
+
+
+def test_memo_is_ignored_when_grouping():
+    rows = [
+        E(date(2026, 1, 10), memo="a"),
+        E(date(2026, 2, 10), memo="b"),
+        E(date(2026, 3, 10), memo=""),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert len(result[0].days) == 3
+
+
+def test_different_amount_forms_a_different_group():
+    rows = [
+        E(date(2026, 1, 10), amount=80000),
+        E(date(2026, 2, 10), amount=80000),
+        E(date(2026, 3, 10), amount=80001),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_different_category_forms_a_different_group():
+    rows = [
+        E(date(2026, 1, 10), category="rent"),
+        E(date(2026, 2, 10), category="gym"),
+        E(date(2026, 3, 10), category="rent"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_input_order_does_not_matter():
+    rows = [E(date(2026, 3, 10)), E(date(2026, 1, 10)), E(date(2026, 2, 10))]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10))
+
+
+def test_duplicate_dates_are_collapsed_and_do_not_count_toward_min_count():
+    rows = [
+        E(date(2026, 1, 10)),
+        E(date(2026, 1, 10), memo="dup"),
+        E(date(2026, 2, 10)),
+    ]
+    assert find_recurring(rows) == []
+    result = find_recurring(rows, min_count=2)
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 10))
+
+
+# --- find_recurring: tolerance and month-end ------------------------------
+
+
+def test_drift_within_tolerance_is_linked():
+    # Feb 13 is +3 from Feb 10; Mar 12 is -1 from Mar 13
+    rows = [E(date(2026, 1, 10)), E(date(2026, 2, 13)), E(date(2026, 3, 12))]
+    result = find_recurring(rows, tolerance=3)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 13), date(2026, 3, 12))
+
+
+def test_drift_exactly_at_tolerance_is_linked_both_directions():
+    # expected Feb 10; Feb 13 is +3, Feb 7 is -3
+    late = [E(date(2026, 1, 10)), E(date(2026, 2, 13)), E(date(2026, 3, 13))]
+    early = [E(date(2026, 1, 10)), E(date(2026, 2, 7)), E(date(2026, 3, 7))]
+    assert len(find_recurring(late, tolerance=3)) == 1
+    assert len(find_recurring(early, tolerance=3)) == 1
+
+
+def test_drift_beyond_tolerance_breaks_the_run():
+    rows = [E(date(2026, 1, 10)), E(date(2026, 2, 14)), E(date(2026, 3, 14))]
+    # Feb 14 is +4 from Feb 10, so the chain is broken: runs are [Jan 10] and [Feb 14, Mar 14]
+    assert find_recurring(rows, tolerance=3) == []
+    result = find_recurring(rows, min_count=2, tolerance=3)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 2, 14), date(2026, 3, 14))
+
+
+def test_gap_splits_into_separate_runs_each_reported_if_long_enough():
+    rows = [
+        E(date(2026, 1, 10)),
+        E(date(2026, 2, 10)),
+        E(date(2026, 3, 10)),
+        # gap in April and May
+        E(date(2026, 6, 10)),
+        E(date(2026, 7, 10)),
+        E(date(2026, 8, 10)),
+    ]
+    result = find_recurring(rows)
+    assert [r.days for r in result] == [
+        (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10)),
+        (date(2026, 6, 10), date(2026, 7, 10), date(2026, 8, 10)),
+    ]
+    assert [r.next_expected for r in result] == [date(2026, 4, 10), date(2026, 9, 10)]
+
+
+def test_short_run_after_gap_is_dropped_but_long_run_kept():
+    rows = [
+        E(date(2026, 1, 10)),
+        E(date(2026, 2, 10)),
+        E(date(2026, 3, 10)),
+        E(date(2026, 6, 10)),
+        E(date(2026, 7, 10)),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days[0] == date(2026, 1, 10)
+
+
+def test_month_end_clamp_keeps_chain_linked():
+    rows = [E(date(2026, 1, 31)), E(date(2026, 2, 28)), E(date(2026, 3, 28))]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 28)
+
+
+def test_year_boundary_is_linked():
+    rows = [E(date(2026, 11, 15)), E(date(2026, 12, 15)), E(date(2027, 1, 15))]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2027, 2, 15)
+
+
+def test_zero_tolerance_requires_exact_month_day():
+    rows = [E(date(2026, 1, 10)), E(date(2026, 2, 11)), E(date(2026, 3, 10))]
+    assert find_recurring(rows, tolerance=0) == []
+
+
+# --- find_recurring: ordering and output shape ----------------------------
+
+
+def test_result_is_a_recurring_with_expected_fields():
+    rows = [E(date(2026, 1, 10)), E(date(2026, 2, 10)), E(date(2026, 3, 10))]
+    (r,) = find_recurring(rows)
+    assert isinstance(r, Recurring)
+    assert r.category == "rent"
+    assert r.amount == 80000
+    assert isinstance(r.days, tuple)
+
+
+def test_results_sorted_by_category_then_amount_then_first_day():
+    rows: list[Expense] = []
+    # gym 1000, rent 80000 (two separate runs), water 500
+    for m in (1, 2, 3):
+        rows.append(E(date(2026, m, 5), category="water", amount=500))
+        rows.append(E(date(2026, m, 1), category="gym", amount=1000))
+        rows.append(E(date(2026, m, 20), category="rent", amount=80000))
+    # second rent run with same category/amount but later start: gap between runs
+    for m in (7, 8, 9):
+        rows.append(E(date(2026, m, 20), category="rent", amount=80000))
+    # a rent series with a smaller amount sorts before the larger one
+    for m in (1, 2, 3):
+        rows.append(E(date(2026, m, 25), category="rent", amount=5000))
+
+    result = find_recurring(rows)
+    keys = [(r.category, r.amount, r.days[0]) for r in result]
+    assert keys == [
+        ("gym", 1000, date(2026, 1, 1)),
+        ("rent", 5000, date(2026, 1, 25)),
+        ("rent", 80000, date(2026, 1, 20)),
+        ("rent", 80000, date(2026, 7, 20)),
+        ("water", 500, date(2026, 1, 5)),
+    ]
+
+
+def test_mismatched_day_rows_for_other_series_do_not_interfere():
+    rows = [
+        E(date(2026, 1, 10), category="a"),
+        E(date(2026, 1, 10), category="b"),
+        E(date(2026, 2, 10), category="a"),
+        E(date(2026, 2, 10), category="b"),
+        E(date(2026, 3, 10), category="a"),
+    ]
+    result = find_recurring(rows)
+    assert [r.category for r in result] == ["a"]
