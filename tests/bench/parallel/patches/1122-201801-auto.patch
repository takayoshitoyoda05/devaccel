diff --git a/tests/test_types/test_Choice.py b/tests/test_types/test_Choice.py
index c34f516..221ee18 100644
--- a/tests/test_types/test_Choice.py
+++ b/tests/test_types/test_Choice.py
@@ -1,7 +1,64 @@
+import enum
+
 import click
+from click.testing import CliRunner
 
 
 def test_choice_get_invalid_choice_message():
     choice = click.Choice(["a", "b", "c"])
     message = choice.get_invalid_choice_message("d", ctx=None)
     assert message == "'d' is not one of 'a', 'b', 'c'."
+
+
+def test_choice_suggests_single_close_match():
+    choice = click.Choice(["apple", "banana", "cherry"])
+    message = choice.get_invalid_choice_message("appel", ctx=None)
+    assert message.endswith("Did you mean 'apple'?")
+
+
+def test_choice_suggests_multiple_close_matches_sorted():
+    choice = click.Choice(["json", "jsonl", "yaml"])
+    message = choice.get_invalid_choice_message("jso", ctx=None)
+    assert message.endswith("(Did you mean one of: 'json', 'jsonl'?)")
+
+
+def test_choice_case_insensitive_suggestion_uses_normalized():
+    choice = click.Choice(["Apple", "Banana"], case_sensitive=False)
+    message = choice.get_invalid_choice_message("APPEL", ctx=None)
+    assert message.endswith("Did you mean 'apple'?")
+
+
+def test_choice_single_choice_with_suggestion():
+    choice = click.Choice(["apple"])
+    message = choice.get_invalid_choice_message("appel", ctx=None)
+    assert message == "'appel' is not 'apple'. Did you mean 'apple'?"
+
+
+def test_choice_non_str_value_and_empty_value():
+    choice = click.Choice(["a", "b"])
+    assert "Did you mean" not in choice.get_invalid_choice_message("", ctx=None)
+    assert "Did you mean" not in choice.get_invalid_choice_message(None, ctx=None)
+
+
+def test_choice_enum_suggestion():
+    class Color(enum.Enum):
+        RED = 1
+        GREEN = 2
+
+    choice = click.Choice(Color)
+    message = choice.get_invalid_choice_message("GREN", ctx=None)
+    assert message.endswith("Did you mean 'GREEN'?")
+
+
+def test_choice_cli_output_includes_suggestion():
+    @click.command()
+    @click.option("--method", type=click.Choice(["snake", "camel"]))
+    def cli(method):
+        pass
+
+    result = CliRunner().invoke(cli, ["--method=snak"])
+    assert result.exit_code == 2
+    assert (
+        "Invalid value for '--method': 'snak' is not one of 'snake', 'camel'. "
+        "Did you mean 'snake'?"
+    ) in result.output
