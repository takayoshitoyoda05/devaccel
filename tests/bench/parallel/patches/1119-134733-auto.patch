+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankcsv import ImportResult, RowError, import_bank_csv, parse_amount
+from kakeibo.core import Expense
+
+# --- 仕様の例表(E2-x) ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("case_id", "text", "expected"),
+    [
+        ("E2-1", "▲1，５００円", -1500),
+    ],
+    ids=["E2-1"],
+)
+def test_spec_examples_parse_amount(case_id: str, text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+def test_E2_2_bad_date_and_bad_amount_report_two_errors() -> None:
+    text = "日付,金額,摘要\n2026/2/30,abc,ランチ\n"
+    result = import_bank_csv(text)
+    assert result.expenses == []
+    assert [(e.line, e.column) for e in result.errors] == [(2, "日付"), (2, "金額")]
+
+
+def test_E2_3_deposit_only_row_is_skipped() -> None:
+    text = "日付,出金額,入金額\n2026-01-05,,1000\n"
+    result = import_bank_csv(text)
+    assert result.expenses == []
+    assert result.errors == []
+    assert result.skipped == 1
+
+
+# --- parse_amount (R3) ----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("1234", 1234),
+        ("1,234", 1234),
+        ("1，234", 1234),
+        ("１，２３４", 1234),
+        ("¥1,234", 1234),
+        ("￥1,234", 1234),
+        ("1,234円", 1234),
+        ("1234JPY", 1234),
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("  1,234　", 1234),
+        ("　-300　", -300),
+        ("-0", 0),
+    ],
+)
+def test_parse_amount_accepts(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize("text", ["", " ", "-", "—", "12.5", "abc", "1 234", "円"])
+def test_parse_amount_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+# --- 日付 (R4) -----------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026/01/05",
+        "2026.1.5",
+        "2026年1月5日",
+        "20260105",
+        "2026-01-05 12:34",
+    ],
+)
+def test_date_formats(text: str) -> None:
+    text_csv = f"日付,金額\n{text},100\n"
+    result = import_bank_csv(text_csv)
+    assert result.errors == []
+    assert result.expenses == [
+        Expense(day=date(2026, 1, 5), category="未分類", amount=100, memo="")
+    ]
+
+
+# --- R1 区切り・改行・BOM・行番号 ----------------------------------------------
+
+
+def test_bom_is_removed() -> None:
+    result = import_bank_csv("﻿日付,金額\n2026-01-05,100")
+    assert [e.amount for e in result.expenses] == [100]
+
+
+@pytest.mark.parametrize("newline", ["\r\n", "\n", "\r"])
+def test_newline_styles_and_error_line(newline: str) -> None:
+    text = newline.join(["日付,金額", "2026-01-05,100", "2026/2/30,200", ""])
+    result = import_bank_csv(text)
+    assert [e.line for e in result.errors] == [3]
+    assert [e.amount for e in result.expenses] == [100]
+
+
+def test_tab_delimiter_is_detected() -> None:
+    result = import_bank_csv("日付\t金額\t摘要\n2026-01-05\t1200\tランチ\n")
+    assert result.expenses == [
+        Expense(day=date(2026, 1, 5), category="未分類", amount=1200, memo="ランチ")
+    ]
+
+
+def test_quoted_newline_counts_record_start_line() -> None:
+    text = '日付,金額,摘要\n2026-01-05,100,"a\nb"\n2026/2/30,200,x\n'
+    result = import_bank_csv(text)
+    assert [e.line for e in result.errors] == [4]
+    assert result.expenses[0].memo == "a\nb"
+
+
+# --- R2 列名 --------------------------------------------------------------------
+
+
+def test_header_aliases_are_case_insensitive_and_trimmed() -> None:
+    result = import_bank_csv(" DATE , Amount ,Description\n2026-01-05,100,x\n")
+    assert result.expenses == [
+        Expense(day=date(2026, 1, 5), category="未分類", amount=100, memo="x")
+    ]
+
+
+def test_missing_date_column_raises_with_name() -> None:
+    with pytest.raises(ValueError, match="日付"):
+        import_bank_csv("金額\n100\n")
+
+
+def test_missing_amount_and_withdraw_columns_raise() -> None:
+    with pytest.raises(ValueError, match="金額"):
+        import_bank_csv("日付,摘要\n2026-01-05,x\n")
+
+
+def test_header_only_and_empty_input_return_empty_result() -> None:
+    assert import_bank_csv("") == ImportResult([], [], 0)
+    assert import_bank_csv("日付,金額\n") == ImportResult([], [], 0)
+
+
+# --- R5 出金・入金 --------------------------------------------------------------
+
+
+def test_withdrawal_column_gives_positive_amount() -> None:
+    result = import_bank_csv("日付,出金額,入金額\n2026-01-05,500,\n")
+    assert [e.amount for e in result.expenses] == [500]
+    assert result.skipped == 0
+
+
+def test_both_withdrawal_and_deposit_filled_is_error() -> None:
+    result = import_bank_csv("日付,出金額,入金額\n2026-01-05,500,300\n")
+    assert result.expenses == []
+    assert [e.column for e in result.errors] == ["出金額"]
+
+
+def test_both_withdrawal_and_deposit_empty_is_error() -> None:
+    result = import_bank_csv("日付,出金額,入金額\n2026-01-05,,\n")
+    assert result.expenses == []
+    assert result.skipped == 0
+    assert len(result.errors) == 1
+
+
+# --- R6 行の誤り・空行・既定カテゴリ ---------------------------------------------
+
+
+def test_good_rows_are_kept_when_another_row_is_bad() -> None:
+    text = "日付,金額\n2026-01-05,100\nxx,200\n2026-01-07,300\n"
+    result = import_bank_csv(text)
+    assert [e.amount for e in result.expenses] == [100, 300]
+    assert [(e.line, e.column) for e in result.errors] == [(3, "日付")]
+
+
+def test_fully_empty_lines_are_ignored_silently() -> None:
+    result = import_bank_csv("日付,金額\n\n2026-01-05,100\n\n")
+    assert len(result.expenses) == 1
+    assert result.errors == []
+    assert result.skipped == 0
+
+
+def test_too_few_columns_is_column_error() -> None:
+    result = import_bank_csv("日付,金額,摘要\n2026-01-05,100\n")
+    assert result.expenses == []
+    assert result.errors == [
+        RowError(
+            line=2, column="", value="2026-01-05,100", reason=result.errors[0].reason
+        )
+    ]
+
+
+def test_too_many_columns_is_column_error() -> None:
+    result = import_bank_csv("日付,金額\n2026-01-05,100,余分\n")
+    assert [(e.line, e.column) for e in result.errors] == [(2, "")]
+
+
+def test_empty_or_missing_category_uses_default() -> None:
+    result = import_bank_csv(
+        "日付,金額,カテゴリ\n2026-01-05,100,  \n", default_category="雑費"
+    )
+    assert result.expenses[0].category == "雑費"
+    result2 = import_bank_csv("日付,金額\n2026-01-05,100\n")
+    assert result2.expenses[0].category == "未分類"
+
+
+def test_memo_is_trimmed() -> None:
+    result = import_bank_csv("日付,金額,摘要\n2026-01-05,100,  ランチ \n")
+    assert result.expenses[0].memo == "ランチ"
diff --git a/tests/test_monthly_report.py b/tests/test_monthly_report.py
new file mode 100644
index 0000000..113bf3e
--- /dev/null
+++ b/tests/test_monthly_report.py
@@ -0,0 +1,136 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthly_report import compare_months, format_report
+
+
+def _e(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+@pytest.mark.parametrize(
+    ("expenses", "month", "expected"),
+    [
+        pytest.param(
+            [_e("2026-10-05", "食費", 1000), _e("2026-11-05", "食費", 1200)],
+            (2026, 11),
+            {"category": "食費", "delta": 200, "pct": 20.0, "status": "increase"},
+            id="E4-1",
+        ),
+        pytest.param(
+            [_e("2025-12-05", "食費", 1000)],
+            (2026, 1),
+            {"category": "食費", "delta": -1000, "pct": -100.0, "status": "gone"},
+            id="E4-2",
+        ),
+        pytest.param(
+            [_e("2026-10-05", "交通費", 500)],
+            (2026, 11),
+            {"category": "交通費", "delta": -500, "pct": -100.0, "status": "gone"},
+            id="E4-3",
+        ),
+    ],
+)
+def test_table_rows(expenses, month, expected):
+    report = compare_months(expenses, month)
+    d = report.deltas[0]
+    assert d.category == expected["category"]
+    assert d.delta == expected["delta"]
+    assert d.pct == expected["pct"]
+    assert d.status == expected["status"]
+
+
+def test_E4_2_previous_month_wraps_to_prior_year():
+    report = compare_months([], (2026, 1))
+    assert report.previous_month == (2025, 12)
+    assert report.current_month == (2026, 1)
+
+
+def test_R1_invalid_month_raises():
+    with pytest.raises(ValueError):
+        compare_months([], (2026, 13))
+    with pytest.raises(ValueError):
+        compare_months([], (2026, 0))
+
+
+def test_R2_new_category_has_no_pct_even_when_current_sum_is_zero():
+    report = compare_months([_e("2026-11-01", "雑費", 0)], (2026, 11))
+    d = report.deltas[0]
+    assert d.status == "new"
+    assert d.pct is None
+
+
+def test_R2_previous_zero_with_current_present_is_increase_without_pct():
+    report = compare_months(
+        [_e("2026-10-01", "雑費", 0), _e("2026-11-01", "雑費", 300)], (2026, 11)
+    )
+    d = report.deltas[0]
+    assert d.status == "increase"
+    assert d.pct is None
+
+
+def test_R2_same_has_zero_pct():
+    report = compare_months(
+        [_e("2026-10-01", "食費", 800), _e("2026-11-01", "食費", 800)], (2026, 11)
+    )
+    d = report.deltas[0]
+    assert d.status == "same"
+    assert d.delta == 0
+    assert d.pct == 0.0
+
+
+def test_D1_refunds_are_subtracted():
+    report = compare_months(
+        [
+            _e("2026-10-01", "食費", 1000),
+            _e("2026-11-01", "食費", 1500),
+            _e("2026-11-02", "食費", -500),
+        ],
+        (2026, 11),
+    )
+    assert report.deltas[0].current == 1000
+    assert report.current_total == 1000
+
+
+def test_R3_sorted_by_abs_delta_desc_then_category():
+    report = compare_months(
+        [
+            _e("2026-10-01", "b", 100),
+            _e("2026-10-01", "a", 100),
+            _e("2026-11-01", "c", 1000),
+            _e("2026-11-01", "b", 200),
+            _e("2026-11-01", "a", 0),
+        ],
+        (2026, 11),
+    )
+    assert [d.category for d in report.deltas] == ["c", "a", "b"]
+
+
+def test_R4_format_report_lines():
+    report = compare_months(
+        [
+            _e("2026-10-01", "食費", 1000),
+            _e("2026-11-01", "食費", 1200),
+            _e("2026-10-01", "交通費", 500),
+            _e("2026-11-01", "日用品", 300),
+            _e("2026-10-01", "通信費", 700),
+            _e("2026-11-01", "通信費", 700),
+        ],
+        (2026, 11),
+    )
+    text = format_report(report).splitlines()
+    assert text[0] == "2026-10 → 2026-11"
+    assert "食費  +200円 (+20.0%)  増加" in text
+    assert "交通費  -500円 (-100.0%)  終了" in text
+    assert "日用品  +300円  新規" in text
+    assert "通信費  ±0円  変化なし" in text
+    assert text[-1] == "合計  2,200円 → 2,200円  +0円"
+
+
+def test_R4_empty_report_does_not_raise():
+    text = format_report(compare_months([], (2026, 11)))
+    assert text.splitlines() == ["2026-10 → 2026-11", "合計  0円 → 0円  +0円"]
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..592fcc5
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,187 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, next_due
+
+
+def _e(d: date, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(day=d, category=category, amount=amount, memo=memo)
+
+
+def _pairs(results: list[Recurring]) -> list[tuple[Recurring, date]]:
+    return [(r, next_due(r)) for r in results]
+
+
+# 仕様の例の表(E1-1 … E1-3)。全行をここに写す。
+@pytest.mark.parametrize(
+    ("case_id", "expenses", "expected"),
+    [
+        pytest.param(
+            "E1-1",
+            [
+                _e(date(2026, 1, 31), "住居", 80000, "家賃"),
+                _e(date(2026, 2, 28), "住居", 80000, "家賃"),
+                _e(date(2026, 3, 31), "住居", 80000, "家賃"),
+            ],
+            [
+                (
+                    Recurring("住居", "家賃", 80000, 3, date(2026, 3, 31), 31),
+                    date(2026, 4, 30),
+                )
+            ],
+            id="E1-1",
+        ),
+        pytest.param(
+            "E1-2",
+            [_e(date(2026, m, 5), "住居", 80000, "家賃 A") for m in (1, 2, 3)]
+            + [_e(date(2026, m, 20), "住居", 80000, "家賃 B") for m in (1, 2, 3)],
+            [
+                (
+                    Recurring("住居", "家賃 a", 80000, 3, date(2026, 3, 5), 5),
+                    date(2026, 4, 5),
+                ),
+                (
+                    Recurring("住居", "家賃 b", 80000, 3, date(2026, 3, 20), 20),
+                    date(2026, 4, 20),
+                ),
+            ],
+            id="E1-2",
+        ),
+        pytest.param(
+            "E1-3",
+            [
+                _e(date(2026, 1, 10), "通信", 4000, "回線"),
+                _e(date(2026, 2, 10), "通信", 4000, "回線"),
+                _e(date(2026, 4, 10), "通信", 4000, "回線"),
+            ],
+            [],
+            id="E1-3",
+        ),
+    ],
+)
+def test_spec_examples(
+    case_id: str,
+    expenses: list[Expense],
+    expected: list[tuple[Recurring, date]],
+) -> None:
+    assert _pairs(find_recurring(expenses)) == expected
+
+
+def test_memo_normalization_merges_series() -> None:
+    # 末尾の数字・空白を除き、NFKC と小文字化で同一系列になる
+    expenses = [
+        _e(date(2026, 1, 1), "通信", 1000, "Netflix 2026"),
+        _e(date(2026, 2, 1), "通信", 1000, "ｎｅｔｆｌｉｘ"),
+        _e(date(2026, 3, 1), "通信", 1000, "  NETFLIX  #3 "),
+    ]
+    result = find_recurring(expenses)
+    assert [(r.memo, r.months) for r in result] == [("netflix", 3)]
+
+
+def test_empty_memo_series_is_category_only() -> None:
+    expenses = [_e(date(2026, m, 1), "保険", 2000) for m in (1, 2, 3)]
+    result = find_recurring(expenses)
+    assert [(r.category, r.memo) for r in result] == [("保険", "")]
+
+
+def test_refunds_and_zero_are_excluded() -> None:
+    expenses = [
+        _e(date(2026, 1, 1), "通信", 1000, "x"),
+        _e(date(2026, 2, 1), "通信", 1000, "x"),
+        _e(date(2026, 2, 2), "通信", -1000, "x"),
+        _e(date(2026, 3, 1), "通信", 0, "x"),
+        _e(date(2026, 3, 2), "通信", 1000, "x"),
+    ]
+    # 3 月は 1000 円の支出が 1 件あるので 3 か月連続
+    result = find_recurring(expenses)
+    assert [(r.months, r.amount) for r in result] == [(3, 1000)]
+
+
+def test_same_month_counts_latest_only() -> None:
+    expenses = [
+        _e(date(2026, 1, 5), "通信", 1000, "x"),
+        _e(date(2026, 1, 20), "通信", 1000, "x"),
+        _e(date(2026, 2, 5), "通信", 1000, "x"),
+        _e(date(2026, 3, 5), "通信", 1000, "x"),
+    ]
+    result = find_recurring(expenses)
+    assert [r.months for r in result] == [3]
+    assert result[0].last_date == date(2026, 3, 5)
+
+
+def test_within_10_percent_is_same_series() -> None:
+    # 1000 → 1100 は中央値の +10% まで: 同じ系列(6 か月, 直近 1100)
+    expenses = [_e(date(2026, m, 1), "通信", 1000, "x") for m in (1, 2, 3)] + [
+        _e(date(2026, m, 1), "通信", 1100, "x") for m in (4, 5, 6)
+    ]
+    result = find_recurring(expenses)
+    assert [(r.months, r.amount) for r in result] == [(6, 1100)]
+
+
+def test_over_10_percent_is_separate_series() -> None:
+    # 1000 → 1101 は +10% を超えるので別系列(それぞれ 3 か月)
+    expenses = [_e(date(2026, m, 1), "通信", 1000, "x") for m in (1, 2, 3)] + [
+        _e(date(2026, m, 1), "通信", 1101, "x") for m in (4, 5, 6)
+    ]
+    result = find_recurring(expenses)
+    assert [(r.months, r.amount) for r in result] == [(3, 1000), (3, 1101)]
+
+
+def test_longest_consecutive_run_only_within_gap() -> None:
+    # 1-3 月と 5-7 月は 4 月で切れる: それぞれ別系列
+    expenses = [_e(date(2026, m, 1), "通信", 1000, "x") for m in (1, 2, 3, 5, 6, 7)]
+    result = find_recurring(expenses)
+    assert [(r.months, r.last_date) for r in result] == [
+        (3, date(2026, 3, 1)),
+        (3, date(2026, 7, 1)),
+    ]
+
+
+def test_min_months_controls_threshold() -> None:
+    expenses = [_e(date(2026, m, 1), "通信", 1000, "x") for m in (1, 2)]
+    assert find_recurring(expenses, min_months=2)[0].months == 2
+    assert find_recurring(expenses, min_months=3) == []
+
+
+@pytest.mark.parametrize("min_months", [1, 0, -1])
+def test_min_months_below_two_raises(min_months: int) -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_months=min_months)
+
+
+def test_empty_input_returns_empty() -> None:
+    assert find_recurring([]) == []
+
+
+def test_result_sorted_by_last_date_category_memo() -> None:
+    expenses = (
+        [_e(date(2026, m, 1), "通信", 1000, "b") for m in (1, 2, 3)]
+        + [_e(date(2026, m, 1), "住居", 1000, "a") for m in (1, 2, 3)]
+        + [_e(date(2026, m, 1), "住居", 500, "c") for m in (1, 2, 3)]
+    )
+    result = find_recurring(expenses)
+    assert [(r.category, r.memo) for r in result] == [
+        ("住居", "a"),
+        ("住居", "c"),
+        ("通信", "b"),
+    ]
+
+
+@pytest.mark.parametrize(
+    ("last_date", "day", "expected"),
+    [
+        (date(2026, 12, 31), 31, date(2027, 1, 31)),
+        (date(2027, 1, 31), 31, date(2027, 2, 28)),
+        (date(2028, 1, 31), 31, date(2028, 2, 29)),
+        (date(2026, 3, 15), 31, date(2026, 4, 30)),
+    ],
+)
+def test_next_due_clamps_to_month_end(
+    last_date: date, day: int, expected: date
+) -> None:
+    r = Recurring("x", "y", 1, 3, last_date, day)
+    assert next_due(r) == expected
diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..34bc99c
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,180 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    all_of,
+    amount_between,
+    any_of,
+    between_dates,
+    category,
+    memo_contains,
+    not_,
+    parse_query,
+    search,
+)
+
+
+def _e(
+    day: date = date(2026, 1, 15),
+    cat: str = "食費",
+    amount: int = 100,
+    memo: str = "",
+) -> Expense:
+    return Expense(day=day, category=cat, amount=amount, memo=memo)
+
+
+# --- 例の表 (E3) ---------------------------------------------------------
+
+
+def test_E3_1_amount_between_same_bounds_includes_value() -> None:
+    # E3-1: amount_between(100, 100) で amount=100 → 真 (R2)
+    assert amount_between(100, 100)(_e(amount=100)) is True
+
+
+def test_E3_2_or_empty_is_always_false() -> None:
+    # E3-2: parse_query({"or": []}) → 常に偽 (R4)
+    pred = parse_query({"or": []})
+    assert pred(_e()) is False
+    assert pred(_e(amount=-500, memo="x")) is False
+
+
+def test_E3_3_unknown_key_raises() -> None:
+    # E3-3: parse_query({"colour": "x"}) → ValueError (R5)
+    with pytest.raises(ValueError):
+        parse_query({"colour": "x"})
+
+
+# --- 規則 R1〜R5 --------------------------------------------------------
+
+
+def test_category_empty_names_raises() -> None:
+    with pytest.raises(ValueError):
+        category()
+
+
+def test_category_matches_any_name_nfkc_case_insensitive() -> None:
+    pred = category("Food", "交通費")
+    assert pred(_e(cat="food")) is True
+    assert pred(_e(cat="ＦＯＯＤ")) is True  # full-width -> NFKC
+    assert pred(_e(cat="交通費")) is True
+    assert pred(_e(cat="食")) is False  # 完全一致のみ
+
+
+def test_amount_between_inclusive_and_unbounded() -> None:
+    assert amount_between(100, 200)(_e(amount=100)) is True
+    assert amount_between(100, 200)(_e(amount=200)) is True
+    assert amount_between(100, 200)(_e(amount=99)) is False
+    assert amount_between(low=100)(_e(amount=10**9)) is True
+    assert amount_between(high=100)(_e(amount=-50)) is True
+    assert amount_between()(_e(amount=0)) is True
+
+
+def test_amount_between_low_above_high_raises() -> None:
+    with pytest.raises(ValueError):
+        amount_between(200, 100)
+
+
+def test_between_dates_inclusive_and_unbounded() -> None:
+    pred = between_dates(date(2026, 1, 1), date(2026, 1, 31))
+    assert pred(_e(day=date(2026, 1, 1))) is True
+    assert pred(_e(day=date(2026, 1, 31))) is True
+    assert pred(_e(day=date(2025, 12, 31))) is False
+    assert pred(_e(day=date(2026, 2, 1))) is False
+    assert between_dates(start=date(2026, 1, 1))(_e(day=date(2030, 1, 1))) is True
+    assert between_dates(end=date(2026, 1, 1))(_e(day=date(2000, 1, 1))) is True
+
+
+def test_between_dates_start_after_end_raises() -> None:
+    with pytest.raises(ValueError):
+        between_dates(date(2026, 2, 1), date(2026, 1, 1))
+
+
+def test_memo_contains_partial_nfkc_case_insensitive() -> None:
+    assert memo_contains("ランチ")(_e(memo="今日のランチ代")) is True
+    assert memo_contains("lunch")(_e(memo="LUNCH")) is True
+    assert memo_contains("ｌｕｎｃｈ")(_e(memo="lunch")) is True
+    assert memo_contains("dinner")(_e(memo="lunch")) is False
+
+
+def test_memo_contains_empty_text_always_true() -> None:
+    assert memo_contains("")(_e(memo="")) is True
+    assert memo_contains("")(_e(memo="anything")) is True
+
+
+def test_all_of_empty_is_true_and_any_of_empty_is_false() -> None:
+    assert all_of()(_e()) is True
+    assert any_of()(_e()) is False
+
+
+def test_not_inverts() -> None:
+    assert not_(amount_between(0, 10))(_e(amount=5)) is False
+    assert not_(amount_between(0, 10))(_e(amount=50)) is True
+
+
+def test_search_keeps_order_and_returns_new_list() -> None:
+    rows = [_e(amount=3), _e(amount=1), _e(amount=3, memo="b"), _e(amount=2)]
+    pred = amount_between(3, 3)
+    result = search(rows, pred)
+    assert result == [rows[0], rows[2]]
+    assert result is not rows
+
+
+def test_parse_query_empty_dict_is_true() -> None:
+    assert parse_query({})(_e()) is True
+
+
+def test_parse_query_multiple_keys_are_anded() -> None:
+    pred = parse_query({"category": "食費", "min_amount": 500})
+    assert pred(_e(cat="食費", amount=500)) is True
+    assert pred(_e(cat="食費", amount=499)) is False
+    assert pred(_e(cat="交通費", amount=900)) is False
+
+
+def test_parse_query_category_list_and_dates_as_strings() -> None:
+    pred = parse_query(
+        {"category": ["食費", "交通費"], "start": "2026-01-01", "end": "2026-01-31"}
+    )
+    assert pred(_e(cat="交通費", day=date(2026, 1, 31))) is True
+    assert pred(_e(cat="交通費", day=date(2026, 2, 1))) is False
+    assert pred(_e(cat="娯楽", day=date(2026, 1, 10))) is False
+
+
+def test_parse_query_memo_max_amount_and_or_not() -> None:
+    pred = parse_query(
+        {
+            "max_amount": 1000,
+            "and": [{"memo": "ランチ"}],
+            "or": [{"category": "食費"}, {"category": "娯楽"}],
+            "not": {"memo": "NG"},
+        }
+    )
+    assert pred(_e(cat="食費", amount=800, memo="ランチ")) is True
+    assert pred(_e(cat="食費", amount=800, memo="ランチ NG")) is False
+    assert pred(_e(cat="食費", amount=1001, memo="ランチ")) is False
+    assert pred(_e(cat="交通費", amount=800, memo="ランチ")) is False
+
+
+@pytest.mark.parametrize(
+    "spec",
+    [
+        {"min_amount": "100"},
+        {"min_amount": True},
+        {"memo": 1},
+        {"category": 3},
+        {"category": ["食費", 1]},
+        {"start": 20260101},
+        {"start": "2026/01/01"},
+        {"and": {"memo": "x"}},
+        {"or": [1]},
+        {"not": [{"memo": "x"}]},
+        {"min_amount": 500, "max_amount": 100},
+        {"start": "2026-02-01", "end": "2026-01-01"},
+    ],
+)
+def test_parse_query_type_and_range_errors_raise(spec: dict[str, object]) -> None:
+    with pytest.raises(ValueError):
+        parse_query(spec)  # type: ignore[arg-type]
