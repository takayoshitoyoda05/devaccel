+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,120 @@
+"""Detect recurring expenses (subscriptions, rent) and predict the next due date.
+
+Pure functions only: depends on ``kakeibo.core.Expense`` and the standard library.
+"""
+
+from __future__ import annotations
+
+import calendar
+import re
+import statistics
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_TRAILING_RE = re.compile(r"[0-9#\- ]+$")
+_SPACES_RE = re.compile(r"\s+")
+# 同一金額とみなす範囲(中央値の ±10%)。比較は整数演算で行う: 10 * |x - m| <= m
+_TOLERANCE_PERCENT = 10
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str  # 正規化後のメモ(系列のキー)
+    amount: int  # 系列の直近の金額
+    months: int  # 系列に含まれる月数
+    last_date: date  # 系列の最後の日付
+    day: int  # 基準日(系列の日の中央値、偶数個なら小さいほう)
+
+
+def _normalize_memo(memo: str) -> str:
+    s = unicodedata.normalize("NFKC", memo).lower().strip()
+    s = _SPACES_RE.sub(" ", s)
+    return _TRAILING_RE.sub("", s).strip()
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month
+
+
+def _cluster_by_amount(items: list[Expense]) -> list[list[Expense]]:
+    """items は日付昇順。各クラスタの中央値の ±10% 以内なら同じ系列に入れる。"""
+    clusters: list[list[Expense]] = []
+    for e in items:
+        for cluster in clusters:
+            m = statistics.median([x.amount for x in cluster])
+            if _TOLERANCE_PERCENT * abs(e.amount - m) <= m:
+                cluster.append(e)
+                break
+        else:
+            clusters.append([e])
+    return clusters
+
+
+def _latest_per_month(items: list[Expense]) -> list[Expense]:
+    """items は日付昇順。同じ月は最も大きい日付の 1 件だけ残す。"""
+    latest: dict[tuple[int, int], Expense] = {}
+    for e in items:
+        latest[(e.day.year, e.day.month)] = e
+    return sorted(latest.values(), key=lambda e: e.day)
+
+
+def _consecutive_runs(entries: list[Expense]) -> list[list[Expense]]:
+    """entries は月が重複しない日付昇順。欠けた月を挟まない区間に分ける。"""
+    runs: list[list[Expense]] = []
+    for e in entries:
+        if runs and _month_index(e.day) == _month_index(runs[-1][-1].day) + 1:
+            runs[-1].append(e)
+        else:
+            runs.append([e])
+    return runs
+
+
+def _make(category: str, memo: str, run: list[Expense]) -> Recurring:
+    last = run[-1]
+    return Recurring(
+        category=category,
+        memo=memo,
+        amount=last.amount,
+        months=len(run),
+        last_date=last.day,
+        day=statistics.median_low([e.day.day for e in run]),
+    )
+
+
+def find_recurring(expenses: list[Expense], min_months: int = 3) -> list[Recurring]:
+    """(カテゴリ, 正規化メモ) ごとに、同額の月次支出が min_months か月以上連続する系列を返す。
+
+    返金(amount <= 0)は対象外。結果は last_date → category → memo の昇順。
+    """
+    if min_months < 2:
+        raise ValueError("min_months は 2 以上である必要があります")
+
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in expenses:
+        if e.amount <= 0:
+            continue
+        groups.setdefault((e.category, _normalize_memo(e.memo)), []).append(e)
+
+    out: list[Recurring] = []
+    for (category, memo), items in groups.items():
+        for cluster in _cluster_by_amount(sorted(items, key=lambda e: e.day)):
+            for run in _consecutive_runs(_latest_per_month(cluster)):
+                if len(run) >= min_months:
+                    out.append(_make(category, memo, run))
+
+    out.sort(key=lambda r: (r.last_date, r.category, r.memo))
+    return out
+
+
+def next_due(r: Recurring) -> date:
+    """last_date の翌月の day 日。その月に無ければ月末。"""
+    if r.last_date.month == 12:
+        year, month = r.last_date.year + 1, 1
+    else:
+        year, month = r.last_date.year, r.last_date.month + 1
+    last_day = calendar.monthrange(year, month)[1]
+    return date(year, month, min(r.day, last_day))
