@@ -0,0 +1,225 @@
+"""Import bank / credit-card CSV exports into Expense records.
+
+Depends only on ``kakeibo.core.Expense``. Pure functions; no file I/O.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int  # レコードの開始行(ヘッダーが 1)
+    column: str  # 問題の列名(元のヘッダー表記)。列数の誤りなら ""
+    value: str  # 元の値
+    reason: str  # 日本語の理由
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+    skipped: int  # 入金だけの行など意図的にスキップした行数
+
+
+_NEGATIVE_MARKS = ("△", "▲", "-")
+_DATE_PATTERNS = (
+    re.compile(r"([0-9]{4})-([0-9]{1,2})-([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})/([0-9]{1,2})/([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})\.([0-9]{1,2})\.([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日"),
+    re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})"),
+)
+
+_ALIASES: dict[str, tuple[str, ...]] = {
+    "date": ("日付", "利用日", "取引日", "ご利用日", "date"),
+    "amount": ("金額", "利用金額", "ご利用金額", "amount"),
+    "withdraw": ("出金額", "お支払金額", "支払金額", "出金"),
+    "deposit": ("入金額", "お預入金額", "預入金額", "入金"),
+    "memo": ("摘要", "メモ", "利用店名", "ご利用店名", "内容", "description", "memo"),
+    "category": ("カテゴリ", "category"),
+}
+
+
+def parse_amount(text: str) -> int:
+    """Parse a bank-style amount string into yen. Raises ValueError if invalid."""
+    s = unicodedata.normalize("NFKC", text).replace("−", "-").strip()
+    if s.upper().endswith("JPY"):
+        s = s[:-3].strip()
+    elif s.endswith("円"):
+        s = s[:-1].strip()
+    if s.startswith("¥"):
+        s = s[1:].strip()
+
+    negative = False
+    if s[:1] in _NEGATIVE_MARKS:
+        negative = True
+        s = s[1:]
+    elif s[-1:] == "-":
+        negative = True
+        s = s[:-1]
+    elif s.startswith("(") and s.endswith(")"):
+        negative = True
+        s = s[1:-1]
+
+    body = s.replace(",", "").strip()
+    if not re.fullmatch(r"[0-9]+", body):
+        raise ValueError(f"金額として解釈できません: {text!r}")
+    value = int(body)
+    return -value if negative else value
+
+
+def _parse_date(text: str) -> date:
+    head_parts = unicodedata.normalize("NFKC", text).split()
+    if not head_parts:
+        raise ValueError("日付が空です")
+    head = head_parts[0]  # 時刻が続く場合は日付部分だけ使う
+    for pattern in _DATE_PATTERNS:
+        m = pattern.fullmatch(head)
+        if m:
+            year, month, day = (int(g) for g in m.groups())
+            try:
+                return date(year, month, day)
+            except ValueError:
+                raise ValueError(f"存在しない日付です: {text!r}") from None
+    raise ValueError(f"日付として解釈できません: {text!r}")
+
+
+def _detect_delimiter(text: str) -> str:
+    first_line = re.split(r"\r\n|\r|\n", text, maxsplit=1)[0]
+    return "\t" if first_line.count("\t") > first_line.count(",") else ","
+
+
+def _find_column(header: list[str], key: str) -> int | None:
+    names = set(_ALIASES[key])
+    for i, cell in enumerate(header):
+        if cell.strip().lower() in names:
+            return i
+    return None
+
+
+def import_bank_csv(text: str, default_category: str = "未分類") -> ImportResult:
+    text = text.removeprefix("﻿")
+    delimiter = _detect_delimiter(text)
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delimiter)
+
+    # レコードの開始行を取るため、読む前の line_num + 1 を記録する。
+    records: list[tuple[int, list[str]]] = []
+    while True:
+        start = reader.line_num + 1
+        try:
+            row = next(reader)
+        except StopIteration:
+            break
+        if row:  # 完全な空行(csv は [] を返す)は無視する
+            records.append((start, row))
+
+    if len(records) <= 1:  # 空入力・ヘッダーだけは空の結果
+        return ImportResult([], [], 0)
+
+    header = records[0][1]
+    date_i = _find_column(header, "date")
+    amount_i = _find_column(header, "amount")
+    withdraw_i = _find_column(header, "withdraw")
+    deposit_i = _find_column(header, "deposit")
+    memo_i = _find_column(header, "memo")
+    category_i = _find_column(header, "category")
+    if date_i is None:
+        raise ValueError(
+            "日付の列がありません(日付・利用日・取引日・ご利用日・date のいずれか)"
+        )
+    if amount_i is None and withdraw_i is None:
+        raise ValueError(
+            "金額の列も出金の列もありません(金額・利用金額・ご利用金額・amount"
+            "・出金額・お支払金額・支払金額・出金 のいずれか)"
+        )
+
+    width = len(header)
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    skipped = 0
+    for start, row in records[1:]:
+        if len(row) != width:
+            errors.append(
+                RowError(
+                    start,
+                    "",
+                    delimiter.join(row),
+                    f"列数が合いません(ヘッダー {width} 列、この行 {len(row)} 列)",
+                )
+            )
+            continue
+
+        row_errors: list[RowError] = []
+        day: date | None = None
+        try:
+            day = _parse_date(row[date_i])
+        except ValueError as e:
+            row_errors.append(RowError(start, header[date_i], row[date_i], str(e)))
+
+        amount: int | None = None
+        skip = False
+        if amount_i is not None:
+            try:
+                amount = parse_amount(row[amount_i])
+            except ValueError as e:
+                row_errors.append(
+                    RowError(start, header[amount_i], row[amount_i], str(e))
+                )
+        else:
+            assert withdraw_i is not None
+            withdraw_text = row[withdraw_i]
+            deposit_text = row[deposit_i] if deposit_i is not None else ""
+            if withdraw_text.strip() and deposit_text.strip():
+                row_errors.append(
+                    RowError(
+                        start,
+                        header[withdraw_i],
+                        withdraw_text,
+                        "出金と入金の両方に値があります(どちらか一方にしてください)",
+                    )
+                )
+            elif withdraw_text.strip():
+                try:
+                    amount = parse_amount(withdraw_text)
+                except ValueError as e:
+                    row_errors.append(
+                        RowError(start, header[withdraw_i], withdraw_text, str(e))
+                    )
+            elif deposit_text.strip():
+                skip = True  # 入金だけの行はスキップ
+            else:
+                row_errors.append(
+                    RowError(
+                        start,
+                        header[withdraw_i],
+                        withdraw_text,
+                        "出金と入金がどちらも空です",
+                    )
+                )
+
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        if skip:
+            skipped += 1
+            continue
+
+        assert day is not None and amount is not None
+        category = row[category_i].strip() if category_i is not None else ""
+        memo = row[memo_i].strip() if memo_i is not None else ""
+        expenses.append(
+            Expense(
+                day=day, category=category or default_category, amount=amount, memo=memo
+            )
+        )
+
+    return ImportResult(expenses, errors, skipped)
