index 0000000..124b5c9
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,179 @@
+"""Conditional search over expenses (pure functions)."""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from collections.abc import Callable
+from datetime import date, datetime
+from typing import Any
+
+from kakeibo.core import Expense
+
+Predicate = Callable[[Expense], bool]
+
+_DATE_RE = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}")
+
+
+def _norm(text: str) -> str:
+    """NFKC normalization followed by case folding (case-insensitive comparison)."""
+    return unicodedata.normalize("NFKC", text).casefold()
+
+
+def category(*names: str) -> Predicate:
+    """Category equals one of ``names`` (NFKC, case-insensitive)."""
+    if not names:
+        raise ValueError("category には 1 つ以上の名前が必要です")
+    targets = frozenset(_norm(n) for n in names)
+
+    def pred(e: Expense) -> bool:
+        return _norm(e.category) in targets
+
+    return pred
+
+
+def amount_between(low: int | None = None, high: int | None = None) -> Predicate:
+    """low <= amount <= high. None means unbounded on that side."""
+    if low is not None and high is not None and low > high:
+        raise ValueError(f"下限 {low} が上限 {high} を超えています")
+
+    def pred(e: Expense) -> bool:
+        return (low is None or e.amount >= low) and (high is None or e.amount <= high)
+
+    return pred
+
+
+def memo_contains(text: str) -> Predicate:
+    """memo contains ``text`` (NFKC, case-insensitive). Empty text always matches."""
+    needle = _norm(text)
+
+    def pred(e: Expense) -> bool:
+        return needle in _norm(e.memo)
+
+    return pred
+
+
+def between_dates(start: date | None = None, end: date | None = None) -> Predicate:
+    """start <= day <= end (both inclusive). None means unbounded on that side."""
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"開始日 {start} が終了日 {end} を超えています")
+
+    def pred(e: Expense) -> bool:
+        return (start is None or e.day >= start) and (end is None or e.day <= end)
+
+    return pred
+
+
+def all_of(*preds: Predicate) -> Predicate:
+    """True when every predicate is true. all_of() is True."""
+
+    def pred(e: Expense) -> bool:
+        return all(p(e) for p in preds)
+
+    return pred
+
+
+def any_of(*preds: Predicate) -> Predicate:
+    """True when some predicate is true. any_of() is False."""
+
+    def pred(e: Expense) -> bool:
+        return any(p(e) for p in preds)
+
+    return pred
+
+
+def not_(pred_: Predicate) -> Predicate:
+    """Negation of a predicate."""
+
+    def pred(e: Expense) -> bool:
+        return not pred_(e)
+
+    return pred
+
+
+def search(expenses: list[Expense], pred: Predicate) -> list[Expense]:
+    """Expenses matching ``pred``, in original order, as a new list."""
+    return [e for e in expenses if pred(e)]
+
+
+def _check_int(key: str, value: object) -> int:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise ValueError(f"{key} は整数である必要があります: {value!r}")  # noqa: TRY004  # 仕様で ValueError
+    return value
+
+
+def _check_str(key: str, value: object) -> str:
+    if not isinstance(value, str):
+        raise ValueError(f"{key} は文字列である必要があります: {value!r}")  # noqa: TRY004  # 仕様で ValueError
+    return value
+
+
+def _check_date(key: str, value: object) -> date:
+    if isinstance(value, date) and not isinstance(value, datetime):
+        return value
+    if isinstance(value, str) and _DATE_RE.fullmatch(value):
+        return date.fromisoformat(value)  # raises ValueError on invalid dates
+    raise ValueError(
+        f"{key} は date または YYYY-MM-DD 文字列である必要があります: {value!r}"
+    )
+
+
+def _check_dict(key: str, value: object) -> dict[str, Any]:
+    if not isinstance(value, dict):
+        raise ValueError(f"{key} は辞書である必要があります: {value!r}")  # noqa: TRY004  # 仕様で ValueError
+    return value
+
+
+def _check_dict_list(key: str, value: object) -> list[Predicate]:
+    if not isinstance(value, list):
+        raise ValueError(f"{key} は辞書のリストである必要があります: {value!r}")  # noqa: TRY004  # 仕様で ValueError
+    return [_parse(_check_dict(key, item), key) for item in value]
+
+
+def _parse(spec: object, where: str) -> Predicate:
+    if not isinstance(spec, dict):
+        raise ValueError(f"{where} は辞書である必要があります: {spec!r}")  # noqa: TRY004  # 仕様で ValueError
+    preds: list[Predicate] = []
+    low: int | None = None
+    high: int | None = None
+    start: date | None = None
+    end: date | None = None
+    for key, value in spec.items():
+        if key == "category":
+            if isinstance(value, str):
+                names = [value]
+            elif isinstance(value, list) and all(isinstance(n, str) for n in value):
+                names = list(value)
+            else:
+                raise ValueError(
+                    f"category は文字列または文字列のリストである必要があります: {value!r}"
+                )
+            preds.append(category(*names))
+        elif key == "min_amount":
+            low = _check_int(key, value)
+        elif key == "max_amount":
+            high = _check_int(key, value)
+        elif key == "memo":
+            preds.append(memo_contains(_check_str(key, value)))
+        elif key == "start":
+            start = _check_date(key, value)
+        elif key == "end":
+            end = _check_date(key, value)
+        elif key == "and":
+            preds.append(all_of(*_check_dict_list(key, value)))
+        elif key == "or":
+            preds.append(any_of(*_check_dict_list(key, value)))
+        elif key == "not":
+            preds.append(not_(_parse(_check_dict(key, value), key)))
+        else:
+            raise ValueError(f"未知のキーです: {key!r}")
+    if low is not None or high is not None:
+        preds.append(amount_between(low, high))
+    if start is not None or end is not None:
+        preds.append(between_dates(start, end))
+    return all_of(*preds)
+
+
+def parse_query(spec: dict[str, Any]) -> Predicate:
+    """Build a predicate from a dict spec. Keys in one dict are ANDed; {} is True."""
+    return _parse(spec, "spec")
