@@ -0,0 +1,125 @@
+"""Month-over-month comparison of expenses by category."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_LABELS = {
+    "increase": "増加",
+    "decrease": "減少",
+    "same": "変化なし",
+    "new": "新規",
+    "gone": "終了",
+}
+
+
+@dataclass(frozen=True)
+class CategoryDelta:
+    category: str
+    previous: int
+    current: int
+    delta: int  # current - previous
+    pct: float | None  # delta / previous * 100, None if previous == 0
+    status: str  # "increase" | "decrease" | "same" | "new" | "gone"
+
+
+@dataclass(frozen=True)
+class MonthlyReport:
+    previous_month: tuple[int, int]
+    current_month: tuple[int, int]
+    deltas: list[CategoryDelta]
+    previous_total: int
+    current_total: int
+
+
+def _previous_month(month: tuple[int, int]) -> tuple[int, int]:
+    year, mon = month
+    if not 1 <= mon <= 12:
+        raise ValueError(f"月は 1〜12 である必要があります: {mon!r}")
+    if mon == 1:
+        return (year - 1, 12)
+    return (year, mon - 1)
+
+
+def _sums_in(expenses: list[Expense], month: tuple[int, int]) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for e in expenses:
+        if (e.day.year, e.day.month) == month:
+            out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def _status(previous: int | None, current: int | None) -> str:
+    if previous is None:
+        return "new"
+    if current is None:
+        return "gone"
+    delta = current - previous
+    if delta > 0:
+        return "increase"
+    if delta < 0:
+        return "decrease"
+    return "same"
+
+
+def compare_months(expenses: list[Expense], month: tuple[int, int]) -> MonthlyReport:
+    prev_month = _previous_month(month)
+    prev_sums = _sums_in(expenses, prev_month)
+    cur_sums = _sums_in(expenses, month)
+
+    deltas: list[CategoryDelta] = []
+    for category in set(prev_sums) | set(cur_sums):
+        previous = prev_sums.get(category)
+        current = cur_sums.get(category)
+        status = _status(previous, current)
+        prev_amount = previous or 0
+        cur_amount = current or 0
+        delta = cur_amount - prev_amount
+        if status == "same":
+            pct: float | None = 0.0
+        elif prev_amount == 0:
+            pct = None
+        else:
+            pct = delta / prev_amount * 100
+        deltas.append(
+            CategoryDelta(
+                category=category,
+                previous=prev_amount,
+                current=cur_amount,
+                delta=delta,
+                pct=pct,
+                status=status,
+            )
+        )
+    deltas.sort(key=lambda d: (-abs(d.delta), d.category))
+
+    return MonthlyReport(
+        previous_month=prev_month,
+        current_month=month,
+        deltas=deltas,
+        previous_total=sum(prev_sums.values()),
+        current_total=sum(cur_sums.values()),
+    )
+
+
+def _fmt_month(month: tuple[int, int]) -> str:
+    return f"{month[0]:04d}-{month[1]:02d}"
+
+
+def format_report(report: MonthlyReport) -> str:
+    lines = [
+        f"{_fmt_month(report.previous_month)} → {_fmt_month(report.current_month)}"
+    ]
+    for d in report.deltas:
+        amount = "±0円" if d.status == "same" else f"{d.delta:+,}円"
+        pct = ""
+        if d.status != "same" and d.pct is not None:
+            pct = f" ({d.pct:+.1f}%)"
+        lines.append(f"{d.category}  {amount}{pct}  {_LABELS[d.status]}")
+    total_delta = report.current_total - report.previous_total
+    lines.append(
+        f"合計  {report.previous_total:,}円 → {report.current_total:,}円  {total_delta:+,}円"
+    )
+    return "\n".join(lines)
