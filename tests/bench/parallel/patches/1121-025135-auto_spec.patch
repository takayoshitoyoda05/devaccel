index 0000000..26e024e
--- /dev/null
+++ b/src/kakeibo/series.py
@@ -0,0 +1,63 @@
+"""Group expenses into candidate series for recurring-payment detection (pure functions)."""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from collections.abc import Sequence
+
+from kakeibo.core import Expense
+
+# 末尾の「#12」「No.3」「3月」形だけを除去する。素の末尾数字(netflix2)は残す。
+_SUFFIX_RE = re.compile(r"(#\d+|no\.\d+|\d+月)$")
+_SPACE_RE = re.compile(r"\s+")
+
+
+def _normalize_memo(memo: str) -> str:
+    text = unicodedata.normalize("NFKC", memo).casefold()
+    text = _SPACE_RE.sub("", text)
+    return _SUFFIX_RE.sub("", text)
+
+
+def group_candidates(
+    expenses: Sequence[Expense], tolerance_pct: int = 10
+) -> list[list[Expense]]:
+    """Split expenses into candidate series by (category, normalized memo, amount drift).
+
+    Refunds and zero-yen rows (amount <= 0) are ignored. Each returned series is
+    sorted by date; series are ordered by (first date, category, normalized memo,
+    first amount). Single-item series are included.
+    """
+    if isinstance(tolerance_pct, bool) or not isinstance(tolerance_pct, int):
+        raise TypeError("tolerance_pct は int である必要があります")
+    if not 0 <= tolerance_pct <= 100:
+        raise ValueError("tolerance_pct は 0〜100 の範囲である必要があります")
+
+    items = list(expenses)
+    for e in items:
+        if not isinstance(e, Expense):
+            raise TypeError(f"Expense 以外が含まれています: {type(e).__name__}")
+
+    by_key: dict[tuple[str, str], list[Expense]] = {}
+    for e in items:
+        if e.amount <= 0:
+            continue
+        key = (e.category.strip(), _normalize_memo(e.memo))
+        by_key.setdefault(key, []).append(e)
+
+    series: list[tuple[tuple[str, str], list[Expense]]] = []
+    for key, rows in by_key.items():
+        rows.sort(key=lambda e: (e.day, e.amount))
+        current = [rows[0]]
+        for e in rows[1:]:
+            prev = current[-1].amount
+            # 差 <= 直前 amount * tolerance_pct / 100 を整数同士で判定する(端を含む)
+            if abs(e.amount - prev) * 100 <= prev * tolerance_pct:
+                current.append(e)
+            else:
+                series.append((key, current))
+                current = [e]
+        series.append((key, current))
+
+    series.sort(key=lambda s: (s[1][0].day, s[0][0], s[0][1], s[1][0].amount))
+    return [rows for _, rows in series]
