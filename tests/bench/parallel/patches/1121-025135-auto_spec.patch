@@ -0,0 +1,121 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.series import group_candidates
+
+
+def E(day: str, amount: int, category: str = "通信", memo: str = "Netflix") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+@pytest.mark.parametrize(
+    ("expenses", "expected"),
+    [
+        pytest.param(
+            [
+                E("2026-01-05", 1490, memo="Netflix"),
+                E("2026-02-05", 1490, memo="ＮＥＴＦＬＩＸ "),
+            ],
+            [
+                [
+                    E("2026-01-05", 1490, memo="Netflix"),
+                    E("2026-02-05", 1490, memo="ＮＥＴＦＬＩＸ "),
+                ]
+            ],
+            id="E2-1",
+        ),
+        pytest.param(
+            [E("2026-01-01", 1000), E("2026-02-01", 1100), E("2026-03-01", 1300)],
+            [[E("2026-01-01", 1000), E("2026-02-01", 1100)], [E("2026-03-01", 1300)]],
+            id="E2-2",
+        ),
+        pytest.param(
+            [E("2026-01-01", -500), E("2026-02-01", 0)],
+            [],
+            id="E2-3",
+        ),
+    ],
+)
+def test_spec_examples(expenses: list[Expense], expected: list[list[Expense]]) -> None:
+    assert group_candidates(expenses) == expected
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert group_candidates([]) == []
+
+
+def test_non_expense_item_raises_type_error() -> None:
+    with pytest.raises(TypeError):
+        group_candidates([E("2026-01-01", 100), "x"])  # type: ignore[list-item]
+
+
+@pytest.mark.parametrize("bad", [True, 10.0, "10"])
+def test_tolerance_must_be_int_not_bool_or_float(bad: object) -> None:
+    with pytest.raises(TypeError, match="tolerance_pct"):
+        group_candidates([], tolerance_pct=bad)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad", [-1, 101])
+def test_tolerance_out_of_range_raises_value_error(bad: int) -> None:
+    with pytest.raises(ValueError, match="tolerance_pct"):
+        group_candidates([], tolerance_pct=bad)
+
+
+def test_memo_trailing_number_forms_are_stripped_but_plain_digits_kept() -> None:
+    same = group_candidates(
+        [E("2026-01-01", 100, memo="Netflix#2"), E("2026-02-01", 100, memo="netflix")]
+    )
+    assert len(same) == 1
+    kept = group_candidates(
+        [E("2026-01-01", 100, memo="netflix2"), E("2026-02-01", 100, memo="netflix")]
+    )
+    assert len(kept) == 2
+
+
+def test_refund_and_zero_are_ignored_while_positive_rows_remain() -> None:
+    rows = [E("2026-01-01", -500), E("2026-01-02", 0), E("2026-01-03", 700)]
+    assert group_candidates(rows) == [[E("2026-01-03", 700)]]
+
+
+def test_drift_boundary_is_inclusive_at_tolerance() -> None:
+    # 1000 -> 1100 is exactly 10% (included); 1100 -> 1210 is exactly 10% of 1100 (included)
+    inside = group_candidates(
+        [E("2026-01-01", 1000), E("2026-02-01", 1100), E("2026-03-01", 1210)]
+    )
+    assert len(inside) == 1
+    # 1000 -> 1101 exceeds 10% (new series)
+    outside = group_candidates([E("2026-01-01", 1000), E("2026-02-01", 1101)])
+    assert len(outside) == 2
+
+
+def test_zero_tolerance_requires_exact_amount() -> None:
+    rows = [E("2026-01-01", 1000), E("2026-02-01", 1000), E("2026-03-01", 1001)]
+    result = group_candidates(rows, tolerance_pct=0)
+    # 先頭日の順: 1000 の 2 件(同額)が 1 系列、1001 は別系列
+    assert [len(s) for s in result] == [2, 1]
+
+
+def test_different_category_is_separate_series() -> None:
+    rows = [
+        E("2026-01-01", 500, category="食費", memo="x"),
+        E("2026-02-01", 500, category="通信", memo="x"),
+    ]
+    assert len(group_candidates(rows)) == 2
+
+
+def test_series_sorted_by_first_date_then_within_series_by_date() -> None:
+    rows = [
+        E("2026-03-01", 300, memo="B"),
+        E("2026-02-01", 105, memo="A"),
+        E("2026-01-01", 100, memo="A"),
+    ]
+    result = group_candidates(rows)
+    # A(100, 105) は 1 系列(日付昇順)、B は 3 月の 1 件。先頭日の昇順で並ぶ。
+    assert [[e.day for e in s] for s in result] == [
+        [date(2026, 1, 1), date(2026, 2, 1)],
+        [date(2026, 3, 1)],
+    ]
