@@ -0,0 +1,145 @@
+"""Tests for kakeibo.cadence (monthly detection and next due date)."""
+
+from __future__ import annotations
+
+from datetime import date, datetime
+
+import pytest
+
+from kakeibo.cadence import is_monthly, next_due
+
+# --- 仕様の例の表 (E1-*) ---------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("days", "expected"),
+    [
+        pytest.param(
+            [date(2026, 1, 31), date(2026, 2, 28), date(2026, 3, 31)],
+            date(2026, 4, 30),
+            id="E1-1",
+        ),
+        pytest.param(
+            [date(2025, 11, 5), date(2025, 12, 5)],
+            date(2026, 1, 5),
+            id="E1-2",
+        ),
+    ],
+)
+def test_next_due_examples(days: list[date], expected: date) -> None:
+    assert next_due(days) == expected
+
+
+@pytest.mark.parametrize(
+    ("days", "expected"),
+    [
+        pytest.param(
+            [date(2026, 1, 5), date(2026, 3, 5), date(2026, 4, 5)],
+            False,
+            id="E1-3",
+        ),
+    ],
+)
+def test_is_monthly_examples(days: list[date], expected: bool) -> None:
+    assert is_monthly(days) is expected
+
+
+# --- 端のケース (仕様文面から) ------------------------------------------------
+
+
+def test_is_monthly_accepts_unsorted_input() -> None:
+    assert is_monthly([date(2026, 3, 5), date(2026, 1, 5), date(2026, 2, 5)])
+
+
+def test_is_monthly_month_end_clamp() -> None:
+    # 最大日 31 を 2 月末 (28) にクランプして比較する
+    assert is_monthly([date(2026, 1, 31), date(2026, 2, 28), date(2026, 3, 31)])
+
+
+def test_is_monthly_jitter_boundary_inside() -> None:
+    # 2/8 は基準 2/5 から 3 日差 (jitter 3 以内)
+    assert is_monthly(
+        [date(2026, 1, 5), date(2026, 2, 8), date(2026, 3, 5)], jitter_days=3
+    )
+
+
+def test_is_monthly_jitter_boundary_outside() -> None:
+    # 2/9 は基準 2/5 から 4 日差 (jitter 3 を超える)
+    assert not is_monthly(
+        [date(2026, 1, 5), date(2026, 2, 9), date(2026, 3, 5)], jitter_days=3
+    )
+
+
+def test_is_monthly_false_when_fewer_than_min_count() -> None:
+    assert not is_monthly([date(2026, 1, 5), date(2026, 2, 5)])
+
+
+def test_is_monthly_false_for_same_month_twice() -> None:
+    assert not is_monthly(
+        [date(2026, 1, 5), date(2026, 1, 20), date(2026, 2, 5), date(2026, 3, 5)]
+    )
+
+
+def test_is_monthly_false_for_empty() -> None:
+    assert not is_monthly([])
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        pytest.param("2026-01-05", id="str"),
+        pytest.param(None, id="none"),
+        pytest.param(datetime(2026, 1, 5), id="datetime"),
+    ],
+)
+def test_is_monthly_rejects_non_date_items(bad: object) -> None:
+    days = [date(2026, 1, 5), bad, date(2026, 3, 5)]
+    with pytest.raises(TypeError):
+        is_monthly(days)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("min_count", [2, 0, -1])
+def test_is_monthly_min_count_below_three_is_value_error(min_count: int) -> None:
+    with pytest.raises(ValueError, match="min_count"):
+        is_monthly([date(2026, 1, 5)], min_count=min_count)
+
+
+def test_is_monthly_min_count_bool_is_type_error() -> None:
+    with pytest.raises(TypeError, match="min_count"):
+        is_monthly([date(2026, 1, 5)], min_count=True)  # type: ignore[arg-type]
+
+
+def test_is_monthly_negative_jitter_is_value_error() -> None:
+    with pytest.raises(ValueError, match="jitter_days"):
+        is_monthly([date(2026, 1, 5)], jitter_days=-1)
+
+
+def test_is_monthly_jitter_bool_is_type_error() -> None:
+    with pytest.raises(TypeError, match="jitter_days"):
+        is_monthly([date(2026, 1, 5)], jitter_days=False)  # type: ignore[arg-type]
+
+
+def test_next_due_requires_two_items() -> None:
+    with pytest.raises(ValueError):
+        next_due([date(2026, 1, 5)])
+
+
+def test_next_due_leap_day_series() -> None:
+    # 最大日 29 → 翌月 (3 月) の 29 日
+    assert next_due([date(2024, 1, 29), date(2024, 2, 29)]) == date(2024, 3, 29)
+
+
+def test_next_due_wraps_year() -> None:
+    assert next_due([date(2025, 10, 5), date(2025, 12, 5)]) == date(2026, 1, 5)
+
+
+def test_next_due_uses_last_day_for_duplicate_month() -> None:
+    # 同月重複でも例外にせず、最後の日の翌月で計算する
+    assert next_due([date(2026, 1, 5), date(2026, 2, 5), date(2026, 2, 5)]) == date(
+        2026, 3, 5
+    )
+
+
+def test_next_due_rejects_non_date_items() -> None:
+    with pytest.raises(TypeError):
+        next_due([date(2026, 1, 5), "2026-02-05"])  # type: ignore[list-item]
