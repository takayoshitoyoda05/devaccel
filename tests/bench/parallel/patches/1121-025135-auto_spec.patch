index 0000000..dd1b218
--- /dev/null
+++ b/src/kakeibo/cadence.py
@@ -0,0 +1,68 @@
+"""Monthly cadence detection and next due date for a series of dates.
+
+Pure functions only: no I/O, standard library only.
+"""
+
+from __future__ import annotations
+
+import calendar
+from collections.abc import Sequence
+from datetime import date, datetime
+from itertools import pairwise
+
+
+def _checked_sorted(days: Sequence[date]) -> list[date]:
+    out: list[date] = []
+    for d in days:
+        if not isinstance(d, date) or isinstance(d, datetime):
+            raise TypeError(f"date が必要です: {d!r}")
+        out.append(d)
+    return sorted(out)
+
+
+def _clamped(year: int, month: int, day: int) -> date:
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(day, last))
+
+
+def _is_int(value: object) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def is_monthly(days: Sequence[date], min_count: int = 3, jitter_days: int = 3) -> bool:
+    """True if the dates recur once per consecutive calendar month, within jitter."""
+    if not _is_int(min_count):
+        raise TypeError("min_count は int である必要があります")
+    if min_count < 3:
+        raise ValueError("min_count は 3 以上である必要があります")
+    if not _is_int(jitter_days):
+        raise TypeError("jitter_days は int である必要があります")
+    if jitter_days < 0:
+        raise ValueError("jitter_days は 0 以上である必要があります")
+
+    ordered = _checked_sorted(days)
+    if len(ordered) < min_count:
+        return False
+    for prev, cur in pairwise(ordered):
+        if (cur.year * 12 + cur.month) - (prev.year * 12 + prev.month) != 1:
+            return False
+    top = max(d.day for d in ordered)
+    for d in ordered:
+        reference = _clamped(d.year, d.month, top)
+        if abs((d - reference).days) > jitter_days:
+            return False
+    return True
+
+
+def next_due(days: Sequence[date]) -> date:
+    """Next expected date: month after the last date, day = max day clamped to that month."""
+    ordered = _checked_sorted(days)
+    if len(ordered) < 2:
+        raise ValueError("2 件以上の日付が必要です")
+    last = ordered[-1]
+    top = max(d.day for d in ordered)
+    if last.month == 12:
+        year, month = last.year + 1, 1
+    else:
+        year, month = last.year, last.month + 1
+    return _clamped(year, month, top)
