+def test_cli_legacy_csv_default_output_unchanged(tmp_path, monkeypatch, capsys):
+    text = "date,category,amount,memo\n2026-11-01,food,100,\n2026-11-02,rent,900,\n"
+    out = _run(tmp_path, monkeypatch, capsys, "--total", text=text)
+    assert out.out == "rent\t900\nfood\t100\nTOTAL\t1,000\n"
+    out = _run(tmp_path, monkeypatch, capsys, "--accounts", text=text)
+    assert out.out == f"2026-11\t{DEFAULT_ACCOUNT}\t1000\t0\t0\t-1000\n"
+
