@@ -0,0 +1,235 @@
+import sys
+from datetime import date
+
+import pytest
+
+from kakeibo import main
+from kakeibo.accounts import (
+    account_names,
+    balance_history,
+    filter_account,
+    monthly_account_report,
+)
+from kakeibo.core import (
+    DEFAULT_ACCOUNT,
+    CsvError,
+    load_csv,
+    monthly_totals,
+    total_by_category,
+)
+
+HEADER = "date,category,amount,memo,account,transfer_to\n"
+BODY = (
+    "2026-10-31,food,500,,cash,\n"
+    "2026-11-01,food,1200,lunch,card,\n"
+    "2026-11-01,,30000,withdraw,bank,cash\n"
+    "2026-11-02,rent,80000,,bank,\n"
+    "2026-11-03,food,800,coffee,cash,\n"
+    "2026-12-01,,5000,,cash,bank\n"
+)
+
+
+def _rows(tmp_path, text=HEADER + BODY):
+    p = tmp_path / "in.csv"
+    p.write_text(text, encoding="utf-8")
+    return load_csv(p)
+
+
+def test_legacy_csv_without_account_column(tmp_path):
+    rows = _rows(tmp_path, "date,category,amount,memo\n2026-11-01,food,100,\n")
+    assert rows[0].account == DEFAULT_ACCOUNT
+    assert not rows[0].is_transfer
+
+
+def test_blank_account_is_default_and_stripped(tmp_path):
+    rows = _rows(
+        tmp_path,
+        "date,category,amount,memo,account\n2026-11-01,a,1,,\n2026-11-01,a,1,, cash \n",
+    )
+    assert [r.account for r in rows] == [DEFAULT_ACCOUNT, "cash"]
+
+
+@pytest.mark.parametrize(
+    "line",
+    [
+        "2026-11-01,,0,,bank,cash",
+        "2026-11-01,,-5,,bank,cash",
+        "2026-11-01,,5,,bank,bank",
+    ],
+)
+def test_invalid_transfer_rejected(tmp_path, line):
+    with pytest.raises(CsvError) as ei:
+        _rows(tmp_path, HEADER + line + "\n")
+    assert ei.value.errors[0][0] == 2
+
+
+def test_transfer_not_counted_as_expense(tmp_path):
+    rows = _rows(tmp_path)
+    assert total_by_category(rows) == {"rent": 80000, "food": 2500}
+    assert "" not in total_by_category(rows)
+    assert list(monthly_totals(rows)) == ["2026-10", "2026-11"]  # 12月は振替のみ
+
+
+def test_balance_history(tmp_path):
+    rows = _rows(tmp_path)
+    h = balance_history(rows, {"bank": 100000})
+    assert h["bank"] == [
+        (date(2026, 11, 1), 70000),
+        (date(2026, 11, 2), -10000),
+        (date(2026, 12, 1), -5000),
+    ]
+    assert h["cash"] == [
+        (date(2026, 10, 31), -500),
+        (date(2026, 11, 1), 29500),
+        (date(2026, 11, 3), 28700),
+        (date(2026, 12, 1), 23700),
+    ]
+    assert h["card"] == [(date(2026, 11, 1), -1200)]
+
+
+def test_balance_history_same_day_single_point_and_refund():
+    from kakeibo.core import Expense
+
+    d = date(2026, 1, 1)
+    rows = [Expense(d, "x", 100, account="a"), Expense(d, "x", -30, account="a")]
+    assert balance_history(rows)["a"] == [(d, -70)]
+
+
+def test_monthly_account_report_carries_balance(tmp_path):
+    rows = _rows(tmp_path)
+    rep = {(r.month, r.account): r for r in monthly_account_report(rows)}
+    assert list(dict.fromkeys(r.month for r in monthly_account_report(rows))) == [
+        "2026-10",
+        "2026-11",
+        "2026-12",
+    ]
+    nov_card = rep[("2026-11", "card")]
+    assert (nov_card.expense, nov_card.balance) == (1200, -1200)
+    dec_card = rep[("2026-12", "card")]  # 動きなしでも繰り越し
+    assert (dec_card.expense, dec_card.balance) == (0, -1200)
+    nov_bank = rep[("2026-11", "bank")]
+    assert (nov_bank.expense, nov_bank.transfer_out, nov_bank.balance) == (
+        80000,
+        30000,
+        -110000,
+    )
+    assert rep[("2026-12", "bank")].transfer_in == 5000
+
+
+def test_account_names_sorted_includes_transfer_dest_and_opening(tmp_path):
+    rows = _rows(tmp_path)
+    assert account_names(rows, {"zzz": 1}) == ["bank", "card", "cash", "zzz"]
+
+
+def test_filter_account_includes_transfers(tmp_path):
+    rows = _rows(tmp_path)
+    assert len(filter_account(rows, "cash")) == 4
+    assert filter_account(rows, "nope") == []
+
+
+@pytest.mark.parametrize("bad", [True, 1.5, "100", None])
+def test_opening_type_checked(bad):
+    with pytest.raises(TypeError):
+        balance_history([], {"a": bad})  # type: ignore[dict-item]
+
+
+def test_empty_rows():
+    assert balance_history([]) == {}
+    assert monthly_account_report([]) == []
+
+
+# --- CLI ---
+
+
+def _run(tmp_path, monkeypatch, capsys, *args, text=HEADER + BODY):
+    p = tmp_path / "in.csv"
+    p.write_text(text, encoding="utf-8")
+    monkeypatch.setattr(sys, "argv", ["kakeibo", str(p), *args])
+    main()
+    return capsys.readouterr()
+
+
+def test_cli_account_filter_default(tmp_path, monkeypatch, capsys):
+    out = _run(tmp_path, monkeypatch, capsys, "--account", "cash", "--total")
+    assert out.out == "food\t1,300\nTOTAL\t1,300\n"
+
+
+def test_cli_account_filter_report(tmp_path, monkeypatch, capsys):
+    out = _run(tmp_path, monkeypatch, capsys, "--report", "--account", "bank")
+    assert out.out == "2026-11\trent\t80000\n"
+
+
+def test_cli_account_unknown(tmp_path, monkeypatch, capsys):
+    out = _run(tmp_path, monkeypatch, capsys, "--account", "nope")
+    assert out.out == ""
+    assert "nope" in out.err
+
+
+def test_cli_account_with_memo(tmp_path, monkeypatch, capsys):
+    out = _run(tmp_path, monkeypatch, capsys, "--account", "cash", "--memo", "coffee")
+    assert out.out == "food\t800\n"
+
+
+def test_cli_accounts_report(tmp_path, monkeypatch, capsys):
+    out = _run(tmp_path, monkeypatch, capsys, "--accounts", "--account", "card")
+    assert out.out.splitlines() == [
+        "2026-10\tcard\t0\t0\t0\t0",
+        "2026-11\tcard\t1200\t0\t0\t-1200",
+        "2026-12\tcard\t0\t0\t0\t-1200",
+    ]
+
+
+def test_cli_balance_with_opening(tmp_path, monkeypatch, capsys):
+    out = _run(
+        tmp_path, monkeypatch, capsys, "--balance", "--account", "bank",
+        "--opening", "bank=100000",
+    )  # fmt: skip
+    assert out.out.splitlines() == [
+        "2026-11-01\tbank\t70000",
+        "2026-11-02\tbank\t-10000",
+        "2026-12-01\tbank\t-5000",
+    ]
+
+
+def test_cli_balance_all_sorted(tmp_path, monkeypatch, capsys):
+    out = _run(tmp_path, monkeypatch, capsys, "--balance")
+    lines = out.out.splitlines()
+    assert lines[0] == "2026-10-31\tcash\t-500"
+    assert lines[1:3] == ["2026-11-01\tbank\t-30000", "2026-11-01\tcard\t-1200"]
+
+
+def test_cli_accounts_unknown_account(tmp_path, monkeypatch, capsys):
