+def test_cli_transfer_budget_not_counted(tmp_path, monkeypatch, capsys):
+    import json
+
+    b = tmp_path / "b.json"
+    b.write_text(json.dumps({"default": {"food": 1000}}), encoding="utf-8")
+    out = _run(tmp_path, monkeypatch, capsys, "--budget", str(b), "--account", "cash")
+    assert "2026-10" not in out.err  # 500 円は予算内
+    assert out.err == ""
