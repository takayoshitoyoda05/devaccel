+++ b/src/kakeibo/accounts.py
@@ -0,0 +1,113 @@
+"""口座別の残高推移・月次レポート。
+
+CSV は任意の列 `account`(口座名)と `transfer_to`(振替先)を持てる。
+
+D1: `account` 列が無い・空欄の行は口座 DEFAULT_ACCOUNT(「(未指定)」)。旧形式の CSV はそのまま読める。
+D2: 口座名は前後の空白を除くだけ。大文字小文字・全角半角は区別する。
+D3: `transfer_to` が空でない行は account -> transfer_to の振替。支出ではなくカテゴリ集計に入らない。
+D4: 振替の金額は正の整数のみ(0・負は CSV エラー)。振替元と振替先が同じ口座もエラー。
+D5: 残高 = 開始残高 + Σ(振替入 - 振替出 - 支出)。負の支出(返金)は残高を増やす。
+D6: 開始残高は `opening`(口座名 -> 円)で渡す。無い口座は 0。bool・int 以外は TypeError。
+D7: 残高推移は日付ごとの終値。1 日に複数の明細があっても 1 点で、動きのある日だけを日付昇順で出す。
+D8: 月次レポートはデータにある月だけ(欠けた月は飛ばす)。残高は月末時点で、動きの無い口座も繰り越して載せる。
+D9: 口座の並びは名前の昇順。振替先にだけ現れる口座・opening にだけある口座も載せる。
+D10: 口座で絞り込むときは、その口座が関わる行(支出は account 一致、振替は元・先のどちらか)を残す。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class AccountMonth:
+    month: str  # YYYY-MM
+    account: str
+    expense: int  # 当月の支出合計(返金は負)
+    transfer_in: int
+    transfer_out: int
+    balance: int  # 月末残高
+
+
+def _check_opening(opening: dict[str, int] | None) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for name, yen in (opening or {}).items():
+        if isinstance(yen, bool) or not isinstance(yen, int):
+            raise TypeError(f"開始残高は整数である必要があります: {name}={yen!r}")
+        out[name] = yen
+    return out
+
+
+def _deltas(e: Expense) -> list[tuple[str, int]]:
+    """残高の増減 [(口座, 円)]。"""
+    if e.is_transfer:
+        return [(e.account, -e.amount), (e.transfer_to, e.amount)]
+    return [(e.account, -e.amount)]
+
+
+def account_names(
+    rows: list[Expense], opening: dict[str, int] | None = None
+) -> list[str]:
+    names = set(_check_opening(opening))
+    for e in rows:
+        names.add(e.account)
+        if e.is_transfer:
+            names.add(e.transfer_to)
+    return sorted(names)
+
+
+def filter_account(rows: list[Expense], account: str) -> list[Expense]:
+    """口座 account が関わる行だけ(D10)。"""
+    return [e for e in rows if e.account == account or e.transfer_to == account]
+
+
+def balance_history(
+    rows: list[Expense], opening: dict[str, int] | None = None
+) -> dict[str, list[tuple[date, int]]]:
+    """{口座: [(日付, その日の終値残高)]}。日付昇順(D7)、口座は名前昇順(D9)。"""
+    bal = _check_opening(opening)
+    names = account_names(rows, opening)
+    hist: dict[str, list[tuple[date, int]]] = {n: [] for n in names}
+    touched: dict[str, int] = {}
+    ordered = sorted(rows, key=lambda e: e.day)  # 安定ソート: 同日は CSV の順
+    for i, e in enumerate(ordered):
+        for name, d in _deltas(e):
+            bal[name] = bal.get(name, 0) + d
+            touched[name] = bal[name]
+        if i + 1 == len(ordered) or ordered[i + 1].day != e.day:
+            for name, yen in touched.items():
+                hist[name].append((e.day, yen))
+            touched = {}
+    return hist
+
+
+def monthly_account_report(
+    rows: list[Expense], opening: dict[str, int] | None = None
+) -> list[AccountMonth]:
+    """月昇順・口座名昇順の月次レポート(D8)。"""
+    bal = _check_opening(opening)
+    names = account_names(rows, opening)
+    by_month: dict[str, list[Expense]] = {}
+    for e in rows:
+        by_month.setdefault(e.day.strftime("%Y-%m"), []).append(e)
+    out: list[AccountMonth] = []
+    for month in sorted(by_month):
+        spent = dict.fromkeys(names, 0)
+        t_in = dict.fromkeys(names, 0)
+        t_out = dict.fromkeys(names, 0)
+        for e in by_month[month]:
+            if e.is_transfer:
+                t_out[e.account] += e.amount
+                t_in[e.transfer_to] += e.amount
+            else:
+                spent[e.account] += e.amount
+            for name, d in _deltas(e):
+                bal[name] = bal.get(name, 0) + d
+        for n in names:
+            out.append(
+                AccountMonth(month, n, spent[n], t_in[n], t_out[n], bal.get(n, 0))
+            )
+    return out
