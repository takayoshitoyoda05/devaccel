diff --git a/tests/test_json.py b/tests/test_json.py
new file mode 100644
index 0000000..885abb9
--- /dev/null
+++ b/tests/test_json.py
@@ -0,0 +1,190 @@
+"""JSON export / import.
+
+D1: export は読み込んだ全行を書く(--memo などの絞り込み前)。集計表示は通常どおり。
+D2: JSON は {date, category, amount, memo} の配列。余分なキーは無視、memo は省略か null で ""。
+D3: amount は int のみ(12.5・"1200"・true は拒否)。負数は CSV と同じく受ける。
+D4: date は YYYY-MM-DD の文字列のみ。category は文字列で前後空白を除く。
+D5: 誤りは全項目分を [index].キー 付きで全部報告する。壊れた JSON は行・列つき。
+D6: 空配列は空の結果(エラーにしない)。最上位が配列以外・BOM 付きは扱いを固定。
+D7: CSV と JSON の同時指定・どちらも無指定は引数エラー(終了コード 2)。
+"""
+
+import json
+
+import pytest
+
+from kakeibo import main
+from kakeibo.core import JsonError, dump_json, load_csv, load_json
+
+CSV = "date,category,amount,memo\n2026-11-01,food,1200,昼\n2026-11-02,rent,80000,\n2026-11-03,food,-200,返金\n"
+
+
+def _run(monkeypatch, *argv):
+    monkeypatch.setattr("sys.argv", ["kakeibo", *map(str, argv)])
+    try:
+        main()
+    except SystemExit as e:
+        return e.code
+    return 0
+
+
+def _json(tmp_path, obj):
+    p = tmp_path / "in.json"
+    p.write_text(obj if isinstance(obj, str) else json.dumps(obj), encoding="utf-8")
+    return p
+
+
+def _good(**kw):
+    return {"date": "2026-11-01", "category": "food", "amount": 100, **kw}
+
+
+def test_round_trip(tmp_path):
+    src = tmp_path / "in.csv"
+    src.write_text(CSV, encoding="utf-8")
+    rows = load_csv(src)
+    out = tmp_path / "out.json"
+    dump_json(rows, out)
+    assert "昼" in out.read_text(encoding="utf-8")  # not escaped
+    assert load_json(out) == rows
+
+
+def test_cli_export_then_import_same_totals(tmp_path, monkeypatch, capsys):
+    src = tmp_path / "in.csv"
+    src.write_text(CSV, encoding="utf-8")
+    out = tmp_path / "out.json"
+    assert _run(monkeypatch, src, "--export-json", out, "--total") == 0
+    from_csv = capsys.readouterr().out
+    assert out.exists()
+    assert _run(monkeypatch, "--import-json", out, "--total") == 0
+    assert capsys.readouterr().out == from_csv
+    assert "TOTAL\t81,000" in from_csv
+
+
+def test_export_is_unfiltered(tmp_path, monkeypatch, capsys):
+    src = tmp_path / "in.csv"
+    src.write_text(CSV, encoding="utf-8")
+    out = tmp_path / "out.json"
+    _run(monkeypatch, src, "--memo", "昼", "--export-json", out)
+    capsys.readouterr()
+    assert len(json.loads(out.read_text(encoding="utf-8"))) == 3
+
+
+def test_import_works_with_report_and_memo(tmp_path, monkeypatch, capsys):
+    p = _json(tmp_path, [_good(memo="a"), _good(category="rent", amount=5, memo="b")])
+    assert _run(monkeypatch, "--import-json", p, "--report", "--memo", "a") == 0
+    assert capsys.readouterr().out == "2026-11\tfood\t100\n"
+
+
+def test_export_unwritable_path(tmp_path, monkeypatch, capsys):
+    src = tmp_path / "in.csv"
+    src.write_text(CSV, encoding="utf-8")
+    code = _run(monkeypatch, src, "--export-json", tmp_path / "nodir" / "o.json")
+    assert code == 2
+    assert "書き出せません" in capsys.readouterr().err
+
+
+def test_optional_memo_and_extra_keys(tmp_path):
+    p = _json(tmp_path, [_good(), _good(memo=None, extra=1), _good(category=" x ")])
+    rows = load_json(p)
+    assert [r.memo for r in rows] == ["", "", ""]
+    assert rows[2].category == "x"
+
+
+def test_empty_array_ok_and_bom(tmp_path):
+    assert load_json(_json(tmp_path, "[]")) == []
+    p = tmp_path / "bom.json"
+    p.write_bytes(b"\xef\xbb\xbf[]")
+    assert load_json(p) == []
+
+
+def test_broken_json_reports_position(tmp_path):
+    with pytest.raises(JsonError) as ei:
+        load_json(_json(tmp_path, '[\n  {"date": }\n]'))
+    msg = str(ei.value)
+    assert "不正な JSON" in msg and "line 2" in msg
+
+
+def test_missing_file(tmp_path):
+    with pytest.raises(JsonError, match="読めません"):
+        load_json(tmp_path / "nope.json")
+
+
+def test_invalid_utf8(tmp_path):
+    p = tmp_path / "bad.json"
+    p.write_bytes(b"[\xff]")
+    with pytest.raises(JsonError, match="不正な JSON"):
+        load_json(p)
+
+
+@pytest.mark.parametrize("top", ['{"a": 1}', '"x"', "1", "null"])
+def test_top_level_must_be_array(tmp_path, top):
+    with pytest.raises(JsonError, match="最上位は配列"):
+        load_json(_json(tmp_path, top))
+
+
+def test_missing_fields_named(tmp_path):
+    p = _json(tmp_path, [_good(), {"date": "2026-11-01"}])
+    with pytest.raises(JsonError) as ei:
+        load_json(p)
+    assert ei.value.errors == [
+        ("[1].category", "項目がありません"),
+        ("[1].amount", "項目がありません"),
+    ]
+
+
+@pytest.mark.parametrize(
+    ("key", "val"),
+    [
+        ("amount", 12.5),
+        ("amount", 1200.0),
+        ("amount", "1200"),
+        ("amount", True),
+        ("amount", None),
+        ("date", "2026-02-30"),
+        ("date", "2026/11/01"),
+        ("date", 20261101),
+        ("category", 5),
+        ("category", None),
+        ("memo", 3),
+    ],
+)
+def test_bad_value_types(tmp_path, key, val):
+    with pytest.raises(JsonError) as ei:
+        load_json(_json(tmp_path, [_good(**{key: val})]))
+    assert [w for w, _ in ei.value.errors] == [f"[0].{key}"]
+
+
+def test_non_object_item_and_all_errors_reported(tmp_path):
+    p = _json(tmp_path, [1, _good(amount="x"), _good(date="bad", memo=1)])
+    with pytest.raises(JsonError) as ei:
+        load_json(p)
+    assert [w for w, _ in ei.value.errors] == [
+        "[0]",
+        "[1].amount",
+        "[2].date",
+        "[2].memo",
+    ]
+
+
+def test_cli_error_output_and_exit_code(tmp_path, monkeypatch, capsys):
+    p = _json(
+        tmp_path, [_good(), {"date": "2026-11-01", "category": "a", "amount": "x"}]
+    )
+    assert _run(monkeypatch, "--import-json", p) == 1
+    cap = capsys.readouterr()
+    assert cap.out == ""
+    assert "[1].amount: 整数である必要があります: 'x'" in cap.err
+
+
+def test_cli_broken_json_exit_code(tmp_path, monkeypatch, capsys):
+    assert _run(monkeypatch, "--import-json", _json(tmp_path, "{")) == 1
+    assert "不正な JSON" in capsys.readouterr().err
+
+
+def test_cli_requires_exactly_one_source(tmp_path, monkeypatch, capsys):
+    p = _json(tmp_path, [])
+    src = tmp_path / "in.csv"
+    src.write_text(CSV, encoding="utf-8")
+    assert _run(monkeypatch) == 2
+    assert _run(monkeypatch, src, "--import-json", p) == 2
+    capsys.readouterr()
