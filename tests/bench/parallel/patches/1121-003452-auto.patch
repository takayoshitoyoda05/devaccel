+class JsonError(ValueError):
+    """Raised when an expense JSON is unreadable or invalid.
+
+    errors: list of (location, reason); location is e.g. "[2].amount" or "" for the file.
+    """
+
+    def __init__(self, errors: list[tuple[str, str]]) -> None:
+        super().__init__("; ".join(f"{w}: {why}" if w else why for w, why in errors))
+        self.errors = errors
+
+
+def dump_json(rows: list[Expense], path: Path) -> None:
+    """Write rows as a JSON array of {date, category, amount, memo} (UTF-8)."""
+    data = [
+        {
+            "date": e.day.isoformat(),
+            "category": e.category,
+            "amount": e.amount,
+            "memo": e.memo,
+        }
+        for e in rows
+    ]
+    path.write_text(
+        json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
+    )
+
+
+def _json_item(i: int, item: object) -> tuple[Expense | None, list[tuple[str, str]]]:
+    where = f"[{i}]"
+    if not isinstance(item, dict):
+        return None, [(where, "オブジェクトである必要があります")]
+    errs: list[tuple[str, str]] = []
+    for key in ("date", "category", "amount"):
+        if key not in item:
+            errs.append((f"{where}.{key}", "項目がありません"))
+    day = None
+    if "date" in item:
+        v = item["date"]
+        try:
+            day = date.fromisoformat(v) if isinstance(v, str) else None
+        except ValueError:
+            day = None
+        if day is None:
+            errs.append((f"{where}.date", f"日付が不正です(YYYY-MM-DD): {v!r}"))
+    category = None
+    if "category" in item:
+        v = item["category"]
+        if isinstance(v, str):
+            category = v.strip()
+        else:
+            errs.append((f"{where}.category", f"文字列である必要があります: {v!r}"))
+    amount = None
+    if "amount" in item:
+        v = item["amount"]
+        if isinstance(v, bool) or not isinstance(v, int):
+            errs.append((f"{where}.amount", f"整数である必要があります: {v!r}"))
+        else:
+            amount = v
+    memo = item.get("memo")
+    if memo is None:
+        memo = ""
+    elif not isinstance(memo, str):
+        errs.append((f"{where}.memo", f"文字列である必要があります: {memo!r}"))
+    if errs or day is None or category is None or amount is None:
+        return None, errs
+    return Expense(day=day, category=category, amount=amount, memo=memo), []
+
+
+def load_json(path: Path) -> list[Expense]:
+    """Read rows written by dump_json. Reports every bad item, not just the first."""
+    try:
+        data = json.loads(path.read_text(encoding="utf-8-sig"))
+    except OSError as e:
+        raise JsonError(
+            [("", f"JSON ファイルを読めません: {e.strerror}: {path}")]
+        ) from None
+    except ValueError as e:
+        raise JsonError([("", f"不正な JSON です: {e}")]) from None
+    if not isinstance(data, list):
+        raise JsonError([("", "最上位は配列である必要があります")])
+    rows: list[Expense] = []
+    errors: list[tuple[str, str]] = []
+    for i, item in enumerate(data):
+        row, errs = _json_item(i, item)
+        errors.extend(errs)
+        if row is not None:
+            rows.append(row)
+    if errors:
+        raise JsonError(errors)
+    return rows
+
