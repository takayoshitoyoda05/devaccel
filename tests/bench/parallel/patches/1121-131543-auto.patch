@@ -0,0 +1,199 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import parse_amount, parse_bank_csv, parse_date
+from kakeibo.core import CsvError, Expense
+
+
+@pytest.mark.parametrize(
+    "raw,want",
+    [
+        ("1234", 1234),
+        ("1,234", 1234),
+        ("１，２３４", 1234),
+        ("¥1,234", 1234),
+        ("￥1,234", 1234),
+        ("1,234円", 1234),
+        (" JPY 500 ", 500),
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("+500", 500),
+        ("0", 0),
+    ],
+)
+def test_parse_amount_ok(raw: str, want: int) -> None:
+    assert parse_amount(raw) == want
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "",
+        " ",
+        "-",
+        "—",
+        "12.5",
+        "1234.0",
+        "abc",
+        "1,23",
+        "12,34,567",
+        "(-300)",
+        "--3",
+        "1 2x",
+    ],
+)
+def test_parse_amount_bad(raw: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(raw)
+
+
+def test_parse_amount_type() -> None:
+    with pytest.raises(TypeError):
+        parse_amount(100)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize(
+    "raw,want",
+    [
+        ("2026-01-05", date(2026, 1, 5)),
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026.1.5", date(2026, 1, 5)),
+        ("2026年1月5日", date(2026, 1, 5)),
+        ("20260105", date(2026, 1, 5)),
+        ("２０２６／１／５", date(2026, 1, 5)),
+        ("令和8年1月5日", date(2026, 1, 5)),
+        ("R8.1.5", date(2026, 1, 5)),
+        ("令和元年5月1日", date(2019, 5, 1)),
+        ("2026/01/05 13:45", date(2026, 1, 5)),
+        ("2024/2/29", date(2024, 2, 29)),
+    ],
+)
+def test_parse_date_ok(raw: str, want: date) -> None:
+    assert parse_date(raw) == want
+
+
+@pytest.mark.parametrize(
+    "raw", ["", "2026/2/30", "2025/2/29", "2026/13/1", "hello", "2026-01"]
+)
+def test_parse_date_bad(raw: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(raw)
+
+
+def test_bank_style_two_columns_skips_deposits() -> None:
+    text = (
+        '取引日,摘要,出金額,入金額\n2026/1/5,スーパー,"1,200",\n2026/1/6,給与,,300000\n'
+    )
+    assert parse_bank_csv(text) == [
+        Expense(date(2026, 1, 5), "未分類", 1200, "スーパー")
+    ]
+
+
+def test_card_style_single_column_with_refund_and_category() -> None:
+    text = "利用日,ご利用店名,利用金額,費目\n2026/1/5,カフェ,¥500,食費\n2026/1/6,返品,△300,\n"
+    got = parse_bank_csv(text, default_category="その他")
+    assert got == [
+        Expense(date(2026, 1, 5), "食費", 500, "カフェ"),
+        Expense(date(2026, 1, 6), "その他", -300, "返品"),
+    ]
+
+
+def test_headers_case_space_and_bom() -> None:
+    text = "﻿ Date , AMOUNT \n2026-01-05,100\n"
+    assert parse_bank_csv(text) == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+def test_tab_delimited_and_crlf() -> None:
+    text = "日付\t金額\t摘要\r\n2026/1/5\t1,000\tA,B\r\n"
+    assert parse_bank_csv(text) == [Expense(date(2026, 1, 5), "未分類", 1000, "A,B")]
+
+
+def test_blank_lines_skipped_and_header_only() -> None:
+    assert parse_bank_csv("日付,金額\n\n,\n") == []
+
+
+def test_empty_input_is_error() -> None:
+    with pytest.raises(CsvError) as ei:
+        parse_bank_csv("")
+    assert ei.value.errors == [(1, "ヘッダー行がありません")]
+
+
+def test_missing_required_columns() -> None:
+    with pytest.raises(CsvError) as ei:
+        parse_bank_csv("摘要,金額\nx,1\n")
+    assert ei.value.errors == [(1, "日付の列がありません")]
+    with pytest.raises(CsvError) as ei:
+        parse_bank_csv("日付,摘要\n2026/1/1,x\n")
+    assert "金額の列" in ei.value.errors[0][1]
+    with pytest.raises(CsvError) as ei:
+        parse_bank_csv("日付,出金\n2026/1/1,1\n")
+    assert "金額の列" in ei.value.errors[0][1]
+
+
+def test_ambiguous_headers() -> None:
+    with pytest.raises(CsvError, match="複数"):
+        parse_bank_csv("日付,金額,利用金額\n2026/1/1,1,1\n")
+    with pytest.raises(CsvError, match="両方"):
+        parse_bank_csv("日付,金額,出金,入金\n2026/1/1,1,1,\n")
+
+
+def test_errors_report_line_column_and_value_all_of_them() -> None:
+    text = "日付,金額,摘要\n2026/2/30,abc,x\n2026/1/5,100,ok\n昨日,50,y\n"
+    with pytest.raises(CsvError) as ei:
+        parse_bank_csv(text)
+    errs = ei.value.errors
+    assert [n for n, _ in errs] == [2, 2, 4]
+    assert (
+        "「日付」" in errs[0][1]
+        and "'2026/2/30'" in errs[0][1]
+        and "存在しません" in errs[0][1]
+    )
+    assert "「金額」" in errs[1][1] and "'abc'" in errs[1][1]
+    assert "不正" in errs[2][1]
+
+
+def test_unquoted_comma_amount_is_column_count_error() -> None:
+    text = "日付,金額,摘要\n2026/1/5,1,234円,x\n"
+    with pytest.raises(CsvError) as ei:
+        parse_bank_csv(text)
+    ((line, why),) = ei.value.errors
+    assert line == 2 and "列数" in why and "期待 3, 実際 4" in why
+
+
+def test_short_row_is_column_count_error() -> None:
+    with pytest.raises(CsvError, match="列数"):
+        parse_bank_csv("日付,金額,摘要\n2026/1/5,100\n")
+
+
+def test_line_number_is_record_start_with_quoted_newline() -> None:
+    text = '日付,金額,摘要\n2026/1/5,100,"a\nb"\n2026/1/6,zzz,c\n'
+    with pytest.raises(CsvError) as ei:
+        parse_bank_csv(text)
+    assert [n for n, _ in ei.value.errors] == [4]
+    text2 = '日付,金額,摘要\n2026/1/5,xxx,"a\nb"\n'
+    with pytest.raises(CsvError) as ei2:
+        parse_bank_csv(text2)
+    assert [n for n, _ in ei2.value.errors] == [2]
+
+
+def test_two_column_both_or_neither_is_error() -> None:
+    text = "日付,出金,入金\n2026/1/5,100,200\n2026/1/6,,\n2026/1/7,-,-\n"
+    with pytest.raises(CsvError) as ei:
+        parse_bank_csv(text)
+    assert [n for n, _ in ei.value.errors] == [2, 3, 4]
+
+
+def test_arguments_validated() -> None:
+    with pytest.raises(TypeError):
+        parse_bank_csv(b"x")  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        parse_bank_csv(None)  # type: ignore[arg-type]
+    with pytest.raises(ValueError, match="default_category"):
+        parse_bank_csv("日付,金額\n", default_category="  ")
+    with pytest.raises(ValueError, match="default_category"):
+        parse_bank_csv("日付,金額\n", default_category=None)  # type: ignore[arg-type]
