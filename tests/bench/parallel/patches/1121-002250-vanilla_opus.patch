+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,166 @@
+"""Detect monthly recurring expenses (subscriptions, rent, ...) and predict the next one.
+
+Pure functions only: no I/O, no reliance on today's date unless ``as_of`` is given.
+
+Detection rules (per group of the same category + memo):
+
+* Grouping key is ``(category, memo)``; memo is compared after ``strip()`` and
+  ``casefold()``, so ``"Netflix"`` and ``" netflix "`` are the same payment.
+* Only positive amounts are considered (refunds etc. are ignored).
+* The *latest* run of consecutive calendar months is examined. A cancelled-then-
+  restarted subscription is therefore judged on its current run only.
+* Within that run there must be exactly one payment per month; a group that has
+  two or more payments in any month of the run (e.g. daily coffee) is not monthly.
+* The run must span at least ``min_months`` months.
+* Every amount in the run must be within ``amount_tolerance`` (relative) of the
+  run's median, so small price changes are tolerated but random spending is not.
+* Every payment day must be within ``day_tolerance`` days of the typical day
+  (clamped to the month's length, so "the 31st" matches Feb 28).
+
+Known limitation: a payment that drifts across a month boundary (e.g. billed on
+the 31st but posted on the 1st) shows up as a missing month plus a double month
+and breaks the run.
+"""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date, timedelta
+from statistics import median, median_low
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class RecurringExpense:
+    category: str
+    memo: str  # memo of the latest payment, stripped
+    amount: int  # latest amount (yen); the expected amount of the next payment
+    day: int  # typical day of month (31 for "end of month")
+    count: int  # number of consecutive monthly payments detected
+    first: date  # first payment of the run
+    last: date  # latest payment of the run
+    next_date: date  # predicted date of the next payment
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month - 1
+
+
+def _days_in(year: int, month: int) -> int:
+    return calendar.monthrange(year, month)[1]
+
+
+def _clamp_day(year: int, month: int, day: int) -> date:
+    return date(year, month, min(day, _days_in(year, month)))
+
+
+def _is_month_end(d: date) -> bool:
+    return d.day == _days_in(d.year, d.month)
+
+
+def _latest_run(payments: list[Expense]) -> list[Expense] | None:
+    """Latest consecutive-month run with one payment per month, else None.
+
+    ``payments`` must be sorted by date. Returns None when the latest run
+    contains a month with more than one payment.
+    """
+    by_month: dict[int, list[Expense]] = {}
+    for e in payments:
+        by_month.setdefault(_month_index(e.day), []).append(e)
+    months = sorted(by_month)
+    run = [months[-1]]
+    for m in reversed(months[:-1]):
+        if m != run[-1] - 1:
+            break
+        run.append(m)
+    run.reverse()
+    if any(len(by_month[m]) != 1 for m in run):
+        return None
+    return [by_month[m][0] for m in run]
+
+
+def _typical_day(run: list[Expense]) -> int:
+    # Billed "at month end" (every payment on its month's last day): use 31 so
+    # the prediction is clamped to the next month's last day (30th, 28th, ...).
+    if all(_is_month_end(e.day) for e in run):
+        return 31
+    return median_low(e.day.day for e in run)
+
+
+def _check_run(
+    run: list[Expense], *, amount_tolerance: float, day_tolerance: int
+) -> int | None:
+    """Typical day if the run looks like a monthly payment, else None."""
+    mid = median(e.amount for e in run)
+    if any(abs(e.amount - mid) > mid * amount_tolerance for e in run):
+        return None
+    day = _typical_day(run)
+    for e in run:
+        expected = _clamp_day(e.day.year, e.day.month, day)
+        if abs((e.day - expected).days) > day_tolerance:
+            return None
+    return day
+
+
+def _next_month(d: date) -> tuple[int, int]:
+    return (d.year + 1, 1) if d.month == 12 else (d.year, d.month + 1)
+
+
+def find_recurring(
+    rows: list[Expense],
+    *,
+    min_months: int = 3,
+    amount_tolerance: float = 0.1,
+    day_tolerance: int = 3,
+    as_of: date | None = None,
+) -> list[RecurringExpense]:
+    """Find monthly recurring expenses and predict their next payment date.
+
+    ``as_of``: if given, a pattern whose predicted next payment is already more
+    than ``day_tolerance`` days overdue on that date is treated as cancelled and
+    dropped. Payments after ``as_of`` are ignored.
+
+    Result is sorted by ``next_date``, then category and memo.
+    """
+    if min_months < 2:
+        raise ValueError("min_months は 2 以上である必要があります")
+    if amount_tolerance < 0 or day_tolerance < 0:
+        raise ValueError("許容幅は 0 以上である必要があります")
+
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        if e.amount <= 0 or (as_of is not None and e.day > as_of):
+            continue
+        groups.setdefault((e.category, e.memo.strip().casefold()), []).append(e)
+
+    out: list[RecurringExpense] = []
+    for payments in groups.values():
+        payments.sort(key=lambda e: e.day)
+        run = _latest_run(payments)
+        if run is None or len(run) < min_months:
+            continue
+        day = _check_run(
+            run, amount_tolerance=amount_tolerance, day_tolerance=day_tolerance
+        )
+        if day is None:
+            continue
+        last = run[-1]
+        next_date = _clamp_day(*_next_month(last.day), day)
+        if as_of is not None and as_of - next_date > timedelta(days=day_tolerance):
+            continue
+        out.append(
+            RecurringExpense(
+                category=last.category,
+                memo=last.memo.strip(),
+                amount=last.amount,
+                day=day,
+                count=len(run),
+                first=run[0].day,
+                last=last.day,
+                next_date=next_date,
+            )
+        )
+    out.sort(key=lambda r: (r.next_date, r.category, r.memo))
+    return out
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..8f23696
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,185 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import RecurringExpense, find_recurring
+
+
+def E(y, m, d, cat, amount, memo=""):
+    return Expense(date(y, m, d), cat, amount, memo)
+
+
+def test_detects_monthly_subscription_and_predicts_next():
+    rows = [
+        E(2026, 8, 5, "sub", 1490, "Netflix"),
+        E(2026, 9, 5, "sub", 1490, "Netflix"),
+        E(2026, 10, 5, "sub", 1490, "Netflix"),
+    ]
+    assert find_recurring(rows) == [
+        RecurringExpense(
+            category="sub",
+            memo="Netflix",
+            amount=1490,
+            day=5,
+            count=3,
+            first=date(2026, 8, 5),
+            last=date(2026, 10, 5),
+            next_date=date(2026, 11, 5),
+        )
+    ]
+
+
+def test_rent_with_empty_memo_and_year_rollover():
+    rows = [
+        E(2026, 10, 27, "rent", 80000),
+        E(2026, 11, 26, "rent", 80000),  # paid a day early (weekend etc.)
+        E(2026, 12, 27, "rent", 80000),
+    ]
+    [r] = find_recurring(rows)
+    assert (r.category, r.memo, r.day) == ("rent", "", 27)
+    assert r.next_date == date(2027, 1, 27)
+
+
+def test_too_few_months_is_not_recurring():
+    rows = [E(2026, 9, 5, "sub", 500, "x"), E(2026, 10, 5, "sub", 500, "x")]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_months=2)) == 1
+
+
+def test_multiple_payments_in_a_month_is_not_monthly():
+    rows = [E(2026, m, d, "food", 400, "coffee") for m in (9, 10, 11) for d in (3, 10)]
+    assert find_recurring(rows) == []
+
+
+def test_gap_breaks_run_and_only_latest_run_counts():
+    rows = [
+        E(2026, 3, 1, "sub", 980, "music"),
+        E(2026, 4, 1, "sub", 980, "music"),
+        E(2026, 5, 1, "sub", 980, "music"),
+        # June missing: cancelled, then restarted
+        E(2026, 8, 1, "sub", 980, "music"),
+        E(2026, 9, 1, "sub", 980, "music"),
+    ]
+    assert find_recurring(rows) == []
+    rows.append(E(2026, 10, 1, "sub", 980, "music"))
+    [r] = find_recurring(rows)
+    assert (r.count, r.first) == (3, date(2026, 8, 1))
+
+
+def test_duplicate_month_outside_latest_run_is_ignored():
+    rows = [
+        E(2026, 1, 1, "sub", 980, "music"),
+        E(2026, 1, 15, "sub", 980, "music"),
+        E(2026, 8, 1, "sub", 980, "music"),
+        E(2026, 9, 1, "sub", 980, "music"),
+        E(2026, 10, 1, "sub", 980, "music"),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_small_price_change_tolerated_and_latest_amount_used():
+    rows = [
+        E(2026, 8, 10, "sub", 1490, "video"),
+        E(2026, 9, 10, "sub", 1490, "video"),
+        E(2026, 10, 10, "sub", 1590, "video"),
+    ]
+    [r] = find_recurring(rows)
+    assert r.amount == 1590
+
+
+def test_irregular_amounts_rejected():
+    rows = [
+        E(2026, 8, 10, "food", 3000, "supermarket"),
+        E(2026, 9, 10, "food", 8000, "supermarket"),
+        E(2026, 10, 10, "food", 5000, "supermarket"),
+    ]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, amount_tolerance=1.0)) == 1
+
+
+def test_irregular_days_rejected():
+    rows = [
+        E(2026, 8, 2, "hobby", 1000, "climbing"),
+        E(2026, 9, 15, "hobby", 1000, "climbing"),
+        E(2026, 10, 28, "hobby", 1000, "climbing"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_memo_compared_case_and_space_insensitively():
+    rows = [
+        E(2026, 8, 5, "sub", 1490, "Netflix"),
+        E(2026, 9, 5, "sub", 1490, " netflix"),
+        E(2026, 10, 5, "sub", 1490, "NETFLIX "),
+    ]
+    [r] = find_recurring(rows)
+    assert r.memo == "NETFLIX"
+
+
+def test_different_memos_are_separate_groups():
+    rows = [E(2026, m, 5, "sub", 1000, "a") for m in (8, 9, 10)] + [
+        E(2026, m, 20, "sub", 1000, "b") for m in (9, 10)
+    ]
+    assert [r.memo for r in find_recurring(rows)] == ["a"]
+
+
+def test_month_end_billing_clamps_next_date():
+    rows = [
+        E(2026, 10, 31, "sub", 500, "cloud"),
+        E(2026, 11, 30, "sub", 500, "cloud"),
+        E(2026, 12, 31, "sub", 500, "cloud"),
+    ]
+    [r] = find_recurring(rows)
+    assert r.day == 31
+    assert r.next_date == date(2027, 1, 31)
+    rows = rows[1:] + [E(2027, 1, 31, "sub", 500, "cloud")]
+    assert find_recurring(rows)[0].next_date == date(2027, 2, 28)
+
+
+def test_day_31_matches_short_month():
+    rows = [
+        E(2027, 1, 30, "sub", 500, "x"),
+        E(2027, 2, 28, "sub", 500, "x"),
+        E(2027, 3, 30, "sub", 500, "x"),
+    ]
+    [r] = find_recurring(rows)
+    assert r.day == 30
+    assert r.next_date == date(2027, 4, 30)
+
+
+def test_non_positive_amounts_ignored():
+    rows = [E(2026, m, 5, "sub", -500, "refund") for m in (8, 9, 10)]
+    assert find_recurring(rows) == []
+
+
+def test_as_of_drops_stale_and_ignores_future_rows():
+    rows = [E(2026, m, 5, "sub", 1000, "x") for m in (6, 7, 8)]
+    # next expected 2026-09-05; still within tolerance on 09-08
+    assert len(find_recurring(rows, as_of=date(2026, 9, 8))) == 1
+    # well overdue -> considered cancelled
+    assert find_recurring(rows, as_of=date(2026, 11, 21)) == []
+    # rows after as_of are not used
+    assert find_recurring(rows, as_of=date(2026, 8, 1)) == []
+
+
+def test_sorted_by_next_date_then_category():
+    rows = (
+        [E(2026, m, 25, "rent", 80000) for m in (8, 9, 10)]
+        + [E(2026, m, 5, "sub", 1000, "b") for m in (8, 9, 10)]
+        + [E(2026, m, 5, "phone", 3000, "a") for m in (8, 9, 10)]
+    )
+    assert [r.category for r in find_recurring(rows)] == ["phone", "sub", "rent"]
+
+
+def test_empty_input():
+    assert find_recurring([]) == []
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [{"min_months": 1}, {"amount_tolerance": -0.1}, {"day_tolerance": -1}],
+)
+def test_invalid_parameters(kwargs):
+    with pytest.raises(ValueError):
+        find_recurring([], **kwargs)
