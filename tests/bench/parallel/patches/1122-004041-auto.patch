diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..31a5cdf 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -188,3 +188,78 @@ def test_path_type(runner, cls, expect):
 
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["a.csv", "a.tsv", "A.CSV", "dir/b.Tsv", "x.y.csv", ".csv"],
+)
+def test_path_suffixes_accepted(value):
+    path_type = click.Path(suffixes=(".csv", ".tsv"))
+    assert path_type.convert(value, None, None) == value
+
+
+@pytest.mark.parametrize("value", ["a.txt", "a", "a.csv.bak", "csv", "a.csv/", ""])
+def test_path_suffixes_rejected(value):
+    path_type = click.Path(suffixes=(".csv", ".tsv"))
+    with pytest.raises(click.BadParameter, match="must have one of the extensions"):
+        path_type.convert(value, None, None)
+
+
+def test_path_suffixes_normalized():
+    # Missing dot is added, case is ignored, a single string is one suffix.
+    assert click.Path(suffixes=("CSV", ".Tsv")).suffixes == (".csv", ".tsv")
+    assert click.Path(suffixes=".csv").suffixes == (".csv",)
+    assert click.Path().suffixes is None
+    assert click.Path(suffixes=["csv"]).convert("A.CSV", None, None) == "A.CSV"
+
+
+def test_path_suffixes_multipart():
+    path_type = click.Path(suffixes=".tar.gz")
+    assert path_type.convert("a.TAR.GZ", None, None) == "a.TAR.GZ"
+    with pytest.raises(click.BadParameter):
+        path_type.convert("a.gz", None, None)
+
+
+@pytest.mark.parametrize("suffixes", [(), [], ("",), (".",)])
+def test_path_suffixes_invalid_argument(suffixes):
+    with pytest.raises(ValueError, match="suffixes"):
+        click.Path(suffixes=suffixes)
+
+
+def test_path_suffixes_bytes_and_pathlike(tmp_path):
+    path_type = click.Path(suffixes=".csv")
+    assert path_type.convert(b"a.CSV", None, None) == b"a.CSV"
+    assert path_type.convert(tmp_path / "a.csv", None, None) == tmp_path / "a.csv"
+    with pytest.raises(click.BadParameter):
+        path_type.convert(tmp_path / "a.txt", None, None)
+
+
+def test_path_suffixes_checked_before_existence(tmp_path):
+    existing = tmp_path / "a.txt"
+    existing.write_text("")
+    path_type = click.Path(exists=True, suffixes=".csv")
+    # Wrong extension on an existing file fails on the extension.
+    with pytest.raises(click.BadParameter, match="extensions"):
+        path_type.convert(str(existing), None, None)
+    # Right extension but missing file still fails on existence.
+    with pytest.raises(click.BadParameter, match="does not exist"):
+        path_type.convert(str(tmp_path / "missing.csv"), None, None)
+
+
+def test_path_suffixes_allow_dash():
+    assert click.Path(suffixes=".csv", allow_dash=True).convert("-", None, None) == "-"
+    with pytest.raises(click.BadParameter):
+        click.Path(suffixes=".csv").convert("-", None, None)
+
+
+def test_path_suffixes_cli(runner):
+    @click.command()
+    @click.argument("src", type=click.Path(suffixes=(".csv", ".tsv")))
+    def cli(src):
+        click.echo(src)
+
+    assert runner.invoke(cli, ["DATA.TSV"]).output == "DATA.TSV\n"
+    result = runner.invoke(cli, ["data.json"])
+    assert result.exit_code == 2
+    assert "must have one of the extensions: .csv, .tsv." in result.output
