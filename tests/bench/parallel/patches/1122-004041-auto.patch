@@ -1049,6 +1049,15 @@ class Path(ParamType[_PathT_co, str | os.PathLike[str]], t.Generic[_PathT_co]):
     :param path_type: Convert the incoming path value to this type. If
         ``None``, keep Python's default, which is ``str``. Useful to
         convert to :class:`pathlib.Path`.
+    :param suffixes: Only accept values that end with one of these
+        extensions, for example ``(".csv", ".tsv")``. The comparison is
+        case-insensitive, a leading ``.`` is added if missing, and
+        multi-part extensions such as ``.tar.gz`` work. A single string
+        is treated as one extension. The check does not need the path to
+        exist, and a ``-`` accepted by ``allow_dash`` skips it.
+
+    .. versionchanged:: 8.6.0
+        Added the ``suffixes`` parameter.
 
     .. versionchanged:: 8.5.1
