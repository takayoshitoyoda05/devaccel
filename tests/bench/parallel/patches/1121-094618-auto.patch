+"""Month-over-month change per category (pure functions).
+
+決めた扱い:
+D1: 月は昇順。最初の月から最後の月の間でデータの無い月は空の月(全カテゴリ 0)として含める
+    (1 月 食費1000・3 月 食費500 → 2 月は 食費 removed、3 月は 食費 new)。12 月→1 月も連続。
+D2: 最初の月は空の月と比べる → 全カテゴリ new(previous=0, rate=None)。
+D3: status は increased / decreased / new / removed / unchanged。unchanged も changes に含める。
+D4: rate = delta / abs(previous)。1000→1500 は 0.5、removed は -1.0、new は None。
+D5: 月の合計が 0 円のカテゴリは「無い」ものとして扱う(0→500 は new、500→0 は removed)。
+D6: changes の並びは abs(delta) の降順、同点はカテゴリ名の昇順。
+D7: 同じ月・同じカテゴリの複数行は合計する。
+D8: 空のリスト → []。
+D9: 入力の並び順に依存しない。
+D10: 負の合計(返金超過)も「ある」ものとして扱う(-200→100 は delta=300, increased, rate=1.5)。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from kakeibo.core import Expense, monthly_totals
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    status: str  # increased | decreased | new | removed | unchanged
+    rate: float | None  # delta / abs(previous); None when previous == 0
+
+
+@dataclass(frozen=True)
+class MonthReport:
+    month: str  # "YYYY-MM"
+    changes: tuple[CategoryChange, ...]
+
+
+def _next_month(month: str) -> str:
+    y, m = int(month[:4]), int(month[5:7])
+    y, m = (y + 1, 1) if m == 12 else (y, m + 1)
+    return f"{y:04d}-{m:02d}"
+
+
+def _status(previous: int, current: int) -> str:
+    if previous == 0:
+        return "new"
+    if current == 0:
+        return "removed"
+    if current > previous:
+        return "increased"
+    if current < previous:
+        return "decreased"
+    return "unchanged"
+
+
+def _compare(prev: dict[str, int], cur: dict[str, int]) -> tuple[CategoryChange, ...]:
+    out: list[CategoryChange] = []
+    for cat in prev.keys() | cur.keys():
+        p, c = prev.get(cat, 0), cur.get(cat, 0)
+        delta = c - p
+        out.append(
+            CategoryChange(
+                category=cat,
+                previous=p,
+                current=c,
+                delta=delta,
+                status=_status(p, c),
+                rate=None if p == 0 else delta / abs(p),
+            )
+        )
+    out.sort(key=lambda ch: (-abs(ch.delta), ch.category))
+    return tuple(out)
+
+
+def month_over_month(rows: list[Expense]) -> list[MonthReport]:
+    totals = monthly_totals(rows)
+    if not totals:
+        return []
+    months = sorted(totals)
+    reports: list[MonthReport] = []
+    prev: dict[str, int] = {}
+    month = months[0]
+    while month <= months[-1]:
+        cur = {c: v for c, v in totals.get(month, {}).items() if v != 0}
+        reports.append(MonthReport(month, _compare(prev, cur)))
+        prev = cur
+        month = _next_month(month)
+    return reports
diff --git a/tests/test_trend.py b/tests/test_trend.py
new file mode 100644
index 0000000..3fb6213
--- /dev/null
+++ b/tests/test_trend.py
@@ -0,0 +1,236 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.trend import CategoryChange, MonthReport, month_over_month
+
+
+def _by_cat(report: MonthReport) -> dict[str, CategoryChange]:
+    return {c.category: c for c in report.changes}
+
+
+def test_d1_gap_month_is_empty_and_included():
+    """D1: 途中の無い月も空の月として含め、月は昇順。1月 食費1000 / 3月 食費500 -> 2月は removed。"""
+    rows = [
+        Expense(date(2026, 1, 5), "食費", 1000),
+        Expense(date(2026, 3, 10), "食費", 500),
+    ]
+    reports = month_over_month(rows)
+    assert [r.month for r in reports] == ["2026-01", "2026-02", "2026-03"]
+    assert reports[0].changes == (CategoryChange("食費", 0, 1000, 1000, "new", None),)
+    assert reports[1].changes == (
+        CategoryChange("食費", 1000, 0, -1000, "removed", -1.0),
+    )
+    assert reports[2].changes == (CategoryChange("食費", 0, 500, 500, "new", None),)
+
+
+def test_d1_year_boundary_is_continuous():
+    """D1: 12月 -> 翌年1月 は連続した月として比較される(100 -> 300 は increased, rate 2.0)。"""
+    rows = [
+        Expense(date(2025, 12, 31), "食費", 100),
+        Expense(date(2026, 1, 1), "食費", 300),
+    ]
+    reports = month_over_month(rows)
+    assert [r.month for r in reports] == ["2025-12", "2026-01"]
+    assert reports[1].changes == (
+        CategoryChange("食費", 100, 300, 200, "increased", 2.0),
+    )
+
+
+def test_d1_gap_across_year_boundary():
+    """D1: 年をまたぐ空の月(2025-12)も含まれ、そこでは removed になる。"""
+    rows = [
+        Expense(date(2025, 11, 3), "食費", 100),
+        Expense(date(2026, 1, 4), "食費", 100),
+    ]
+    reports = month_over_month(rows)
+    assert [r.month for r in reports] == ["2025-11", "2025-12", "2026-01"]
+    assert reports[1].changes == (
+        CategoryChange("食費", 100, 0, -100, "removed", -1.0),
+    )
+    assert reports[2].changes == (CategoryChange("食費", 0, 100, 100, "new", None),)
+
+
+def test_d2_first_month_all_new():
+    """D2: 最初の月は空の月と比べるので全カテゴリ new (previous=0, rate=None)。"""
+    rows = [
+        Expense(date(2026, 10, 3), "食費", 500),
+        Expense(date(2026, 10, 5), "家賃", 80000),
+    ]
+    reports = month_over_month(rows)
+    assert len(reports) == 1
+    assert reports[0].month == "2026-10"
+    # abs(delta) 降順: 家賃 80000 が先
+    assert reports[0].changes == (
+        CategoryChange("家賃", 0, 80000, 80000, "new", None),
+        CategoryChange("食費", 0, 500, 500, "new", None),
+    )
+
+
+def test_d3_statuses_and_unchanged_included():
+    """D3: increased / decreased / new / removed / unchanged のすべて。unchanged も changes に含む。"""
+    nov = [
+        Expense(date(2026, 11, 1), "食費", 1000),
+        Expense(date(2026, 11, 2), "交通", 500),
+        Expense(date(2026, 11, 3), "光熱", 300),
+        Expense(date(2026, 11, 4), "娯楽", 200),
+    ]
+    dec = [
+        Expense(date(2026, 12, 1), "食費", 1500),
+        Expense(date(2026, 12, 2), "交通", 200),
+        Expense(date(2026, 12, 3), "光熱", 300),
+        Expense(date(2026, 12, 4), "医療", 400),
+    ]
+    reports = month_over_month(nov + dec)
+    assert len(reports) == 2
+    dec_report = reports[1]
+    by = _by_cat(dec_report)
+
+    assert by["食費"].status == "increased"
+    assert by["食費"].delta == 500
+    assert by["食費"].rate == pytest.approx(0.5)
+
+    assert by["交通"].status == "decreased"
+    assert by["交通"].delta == -300
+    assert by["交通"].rate == pytest.approx(-0.6)
+
+    assert by["光熱"].status == "unchanged"
+    assert by["光熱"].delta == 0
+    assert by["光熱"].rate == pytest.approx(0.0)
+
+    assert by["医療"].status == "new"
+    assert by["医療"].previous == 0
+    assert by["医療"].rate is None
+
+    assert by["娯楽"].status == "removed"
+    assert by["娯楽"].current == 0
+    assert by["娯楽"].rate == pytest.approx(-1.0)
+
+    # abs(delta) 降順: 食費500, 医療400, 交通300, 娯楽200, 光熱0
+    assert [c.category for c in dec_report.changes] == [
+        "食費",
+        "医療",
+        "交通",
+        "娯楽",
+        "光熱",
+    ]
+
+
+def test_d4_rate_is_delta_over_abs_previous():
+    """D4: rate = delta / abs(previous)。1000->1500 は 0.5、1000->500 は -0.5。"""
+    up = month_over_month(
+        [
+            Expense(date(2026, 10, 1), "食費", 1000),
+            Expense(date(2026, 11, 1), "食費", 1500),
+        ]
+    )
+    assert up[1].changes == (CategoryChange("食費", 1000, 1500, 500, "increased", 0.5),)
+
+    down = month_over_month(
+        [
+            Expense(date(2026, 10, 1), "食費", 1000),
+            Expense(date(2026, 11, 1), "食費", 500),
+        ]
+    )
+    assert down[1].changes == (
+        CategoryChange("食費", 1000, 500, -500, "decreased", -0.5),
+    )
+
+
+def test_d5_zero_sum_category_is_absent_when_net_zero():
+    """D5: 月合計が 0 円の食費(+500 と -500 の相殺)は無いものとして扱い、changes に現れない。"""
+    rows = [
+        Expense(date(2026, 10, 1), "交通", 100),
+        Expense(date(2026, 11, 1), "食費", 500),
+        Expense(date(2026, 11, 2), "食費", -500),
+    ]
+    reports = month_over_month(rows)
+    assert [r.month for r in reports] == ["2026-10", "2026-11"]
+    assert reports[1].changes == (
+        CategoryChange("交通", 100, 0, -100, "removed", -1.0),
+    )
+
+
+def test_d5_zero_to_500_new_and_500_to_zero_removed():
+    """D5: 500->0(相殺で 0 円)は removed、0->200 は new として扱う。"""
+    rows = [
+        Expense(date(2026, 10, 1), "食費", 500),
+        Expense(date(2026, 11, 1), "食費", 300),
+        Expense(date(2026, 11, 2), "食費", -300),
+        Expense(date(2026, 12, 1), "食費", 200),
+    ]
+    reports = month_over_month(rows)
+    assert [r.month for r in reports] == ["2026-10", "2026-11", "2026-12"]
+    assert reports[1].changes == (
+        CategoryChange("食費", 500, 0, -500, "removed", -1.0),
+    )
+    assert reports[2].changes == (CategoryChange("食費", 0, 200, 200, "new", None),)
+
+
+def test_d6_ties_sorted_by_category_name():
+    """D6: abs(delta) が同点なら カテゴリ名の昇順。符号は並びに影響しない(bus -500 が先)。"""
+    rows = [
+        Expense(date(2026, 11, 1), "food", 1000),
+        Expense(date(2026, 11, 2), "bus", 500),
+        Expense(date(2026, 12, 1), "food", 1500),
+        Expense(date(2026, 12, 2), "zoo", 500),
+    ]
+    reports = month_over_month(rows)
+    assert reports[1].changes == (
+        CategoryChange("bus", 500, 0, -500, "removed", -1.0),
+        CategoryChange("food", 1000, 1500, 500, "increased", 0.5),
+        CategoryChange("zoo", 0, 500, 500, "new", None),
+    )
+
+
+def test_d7_same_month_same_category_rows_are_summed():
+    """D7: 同じ月・同じカテゴリの複数行は合計する(food 300 + 700 = 1000)。"""
+    rows = [
+        Expense(date(2026, 11, 1), "food", 300),
+        Expense(date(2026, 11, 15), "food", 700),
+        Expense(date(2026, 11, 2), "rent", 100),
+        Expense(date(2026, 12, 1), "food", 1000),
+    ]
+    reports = month_over_month(rows)
+    assert reports[0].changes == (
+        CategoryChange("food", 0, 1000, 1000, "new", None),
+        CategoryChange("rent", 0, 100, 100, "new", None),
+    )
+    assert reports[1].changes == (
+        CategoryChange("rent", 100, 0, -100, "removed", -1.0),
+        CategoryChange("food", 1000, 1000, 0, "unchanged", 0.0),
+    )
+
+
+def test_d8_empty_input_returns_empty_list():
+    """D8: 空のリスト -> []。"""
+    assert month_over_month([]) == []
+
+
+def test_d9_result_independent_of_input_order():
+    """D9: 入力の並び順(日付がばらばら)に依存しない。"""
+    base = [
+        Expense(date(2026, 11, 1), "食費", 1000),
+        Expense(date(2026, 11, 2), "交通", 500),
+        Expense(date(2026, 12, 1), "食費", 1500),
+        Expense(date(2026, 12, 2), "交通", 200),
+        Expense(date(2026, 12, 4), "医療", 400),
+    ]
+    expected = month_over_month(base)
+    assert month_over_month(list(reversed(base))) == expected
+    assert month_over_month(sorted(base, key=lambda e: e.category)) == expected
+    assert month_over_month([base[3], base[0], base[4], base[2], base[1]]) == expected
+
+
+def test_d10_negative_previous_is_treated_as_present():
+    """D10: 負の合計(返金超過)のカテゴリも「ある」扱い。-200 -> 100 は increased, rate 1.5。"""
+    rows = [
+        Expense(date(2026, 10, 1), "食費", -200),
+        Expense(date(2026, 11, 1), "食費", 100),
+    ]
+    reports = month_over_month(rows)
+    assert reports[0].changes == (CategoryChange("食費", 0, -200, -200, "new", None),)
+    assert reports[1].changes == (
+        CategoryChange("食費", -200, 100, 300, "increased", 1.5),
+    )
