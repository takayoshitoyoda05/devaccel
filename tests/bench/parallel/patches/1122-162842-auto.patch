diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..22939f7 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -188,3 +188,96 @@ def test_path_type(runner, cls, expect):
 
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
+
+
+@pytest.mark.parametrize("name", ["a.csv", "a.tsv", "A.CSV", "b.TsV", "x.y.csv"])
+def test_path_suffixes_accepts(name):
+    assert click.Path(suffixes=(".csv", ".tsv")).convert(name, None, None) == name
+
+
+@pytest.mark.parametrize("name", ["a.txt", "a", "csv", "a.csv.bak", "", "a.csv/"])
+def test_path_suffixes_rejects(name):
+    type = click.Path(suffixes=(".csv", ".tsv"))
+
+    with pytest.raises(click.BadParameter, match=r"must end with one of: \.csv, \.tsv"):
+        type.convert(name, None, None)
+
+
+def test_path_suffixes_forms():
+    # No leading dot, upper case, a single string, and a multi-part suffix.
+    assert click.Path(suffixes="CSV").convert("a.csv", None, None) == "a.csv"
+    assert click.Path(suffixes=["csv"]).suffixes == (".csv",)
+    # A name that only ends in the letters is not a match.
+    with pytest.raises(click.BadParameter):
+        click.Path(suffixes="csv").convert("acsv", None, None)
+    assert click.Path(suffixes=".tar.gz").convert("a.TAR.GZ", None, None) == "a.TAR.GZ"
+
+
+@pytest.mark.parametrize("suffixes", [None, (), []])
+def test_path_suffixes_unset_or_empty_accepts_anything(suffixes):
+    assert click.Path(suffixes=suffixes).convert("a.txt", None, None) == "a.txt"
+
+
+def test_path_suffixes_bytes_and_pathlike():
+    type = click.Path(suffixes=".csv")
+    assert type.convert(b"a.CSV", None, None) == b"a.CSV"
+    assert type.convert(pathlib.Path("a.csv"), None, None) == pathlib.Path("a.csv")
+
+    with pytest.raises(click.BadParameter):
+        type.convert(pathlib.Path("a.txt"), None, None)
+
+
+def test_path_suffixes_existing_file(tmp_path):
+    good = tmp_path / "a.CSV"
+    bad = tmp_path / "a.txt"
+    good.touch()
+    bad.touch()
+    type = click.Path(exists=True, suffixes=".csv")
+
+    assert type.convert(str(good), None, None) == str(good)
+
+    with pytest.raises(click.BadParameter, match="must end with"):
+        type.convert(str(bad), None, None)
+
+
+def test_path_suffixes_missing_file_without_exists(tmp_path):
+    type = click.Path(suffixes=".csv")
+    missing = tmp_path / "new.csv"
+
+    assert type.convert(str(missing), None, None) == str(missing)
+
+    with pytest.raises(click.BadParameter, match="must end with"):
+        type.convert(str(tmp_path / "new.txt"), None, None)
+
+
+def test_path_suffixes_skips_existing_directory(tmp_path):
+    directory = tmp_path / "data.d"
+    directory.mkdir()
+
+    assert click.Path(suffixes=".csv").convert(str(directory), None, None) == str(
+        directory
+    )
+
+
+def test_path_suffixes_allow_dash():
+    type = click.Path(allow_dash=True, suffixes=".csv")
+
+    assert type.convert("-", None, None) == "-"
+
+    with pytest.raises(click.BadParameter):
+        click.Path(suffixes=".csv").convert("-", None, None)
+
+
+def test_path_suffixes_through_command(runner):
+    @click.command()
+    @click.argument("src", type=click.Path(suffixes=(".csv", ".tsv")))
+    def cli(src):
+        click.echo(src)
+
+    ok = runner.invoke(cli, ["DATA.TSV"])
+    assert ok.exit_code == 0
+    assert ok.output == "DATA.TSV\n"
+
+    bad = runner.invoke(cli, ["data.json"])
+    assert bad.exit_code == 2
+    assert "must end with one of: .csv, .tsv" in bad.output
