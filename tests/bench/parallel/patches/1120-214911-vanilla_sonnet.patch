index 0000000..7462ac2
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,88 @@
+"""Detect monthly recurring expenses (rent, subscriptions) and predict the next one."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+from statistics import median
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str  # normalized memo ("" if the series has none)
+    amount: int  # latest amount (yen)
+    months: int  # length of the consecutive monthly run
+    last_date: date
+    next_date: date
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month - 1
+
+
+def _clamped(year: int, month: int, day: int) -> date:
+    return date(year, month, min(day, calendar.monthrange(year, month)[1]))
+
+
+def _next_month(d: date, day: int) -> date:
+    y, m = divmod(_month_index(d) + 1, 12)
+    return _clamped(y, m + 1, day)
+
+
+def detect_recurring(
+    rows: list[Expense],
+    *,
+    min_months: int = 3,
+    amount_tolerance: float = 0.1,
+    day_tolerance: int = 3,
+    as_of: date | None = None,
+) -> list[Recurring]:
+    """Find series with one charge per month for >= min_months consecutive months.
+
+    Series are keyed by (category, normalized memo). Amounts must stay within
+    amount_tolerance of the median and the day of month within day_tolerance
+    (month ends are clamped, so a 31st charge on Feb 28 still counts). Only the
+    most recent consecutive run counts. If as_of is given, series whose next
+    charge is already more than day_tolerance days overdue are dropped as ended.
+    Result is sorted by next_date, then category, then memo.
+    """
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        key = (e.category, " ".join(e.memo.split()).casefold())
+        groups.setdefault(key, []).append(e)
+
+    out: list[Recurring] = []
+    for (category, memo), items in groups.items():
+        items.sort(key=lambda e: e.day)
+        # trailing run of consecutive months
+        run = [items[-1]]
+        for e in reversed(items[:-1]):
+            gap = _month_index(run[0].day) - _month_index(e.day)
+            if gap == 0:
+                run = []  # two charges in one month: not a monthly series
+                break
+            if gap != 1:
+                break
+            run.insert(0, e)
+        if len(run) < min_months:
+            continue
+        amt_med = median(e.amount for e in run)
+        if any(abs(e.amount - amt_med) > abs(amt_med) * amount_tolerance for e in run):
+            continue
+        day = round(median(e.day.day for e in run))
+        if any(
+            abs(e.day.day - min(day, calendar.monthrange(e.day.year, e.day.month)[1]))
+            > day_tolerance
+            for e in run
+        ):
+            continue
+        last = run[-1]
+        nxt = _next_month(last.day, day)
+        if as_of is not None and (as_of - nxt).days > day_tolerance:
+            continue
+        out.append(Recurring(category, memo, last.amount, len(run), last.day, nxt))
+    return sorted(out, key=lambda r: (r.next_date, r.category, r.memo))
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..1a5ff0a
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,98 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.recurring import detect_recurring
+
+
+def _e(d, cat="sub", amount=1000, memo="netflix"):
+    return Expense(date.fromisoformat(d), cat, amount, memo)
+
+
+def test_basic_monthly():
+    rows = [_e("2026-08-15"), _e("2026-09-15"), _e("2026-10-15")]
+    [r] = detect_recurring(rows)
+    assert r.next_date == date(2026, 11, 15)
+    assert r.months == 3 and r.amount == 1000 and r.last_date == date(2026, 10, 15)
+
+
+def test_too_few_months():
+    assert detect_recurring([_e("2026-09-15"), _e("2026-10-15")]) == []
+
+
+def test_gap_breaks_run():
+    rows = [_e("2026-06-15"), _e("2026-07-15"), _e("2026-09-15"), _e("2026-10-15")]
+    assert detect_recurring(rows) == []
+
+
+def test_earlier_history_before_gap_ignored_but_recent_run_counts():
+    rows = [_e("2026-04-15")] + [_e(f"2026-{m:02d}-15") for m in (7, 8, 9)]
+    [r] = detect_recurring(rows)
+    assert r.months == 3
+
+
+def test_two_charges_in_one_month_not_recurring():
+    rows = [_e(d, "food", 500, "lunch") for d in ("2026-08-01", "2026-08-02")]
+    rows += [_e("2026-09-01", "food", 500, "lunch"), _e("2026-10-01", "food", 500, "lunch")]
+    assert detect_recurring(rows) == []
+
+
+def test_amount_variation_rejected():
+    rows = [
+        _e("2026-08-15", amount=1000),
+        _e("2026-09-15", amount=1000),
+        _e("2026-10-15", amount=2000),
+    ]
+    assert detect_recurring(rows) == []
+
+
+def test_small_amount_variation_ok_uses_latest():
+    rows = [
+        _e("2026-08-15", amount=1000),
+        _e("2026-09-15", amount=1050),
+        _e("2026-10-15", amount=1080),
+    ]
+    [r] = detect_recurring(rows)
+    assert r.amount == 1080
+
+
+def test_day_drift_rejected():
+    rows = [_e("2026-08-01"), _e("2026-09-15"), _e("2026-10-01")]
+    assert detect_recurring(rows) == []
+
+
+def test_month_end_clamp():
+    rows = [_e("2026-11-30"), _e("2026-12-31"), _e("2027-01-31")]
+    [r] = detect_recurring(rows)
+    assert r.next_date == date(2027, 2, 28)
+
+
+def test_year_rollover():
+    rows = [_e("2026-10-05"), _e("2026-11-05"), _e("2026-12-05")]
+    [r] = detect_recurring(rows)
+    assert r.next_date == date(2027, 1, 5)
+
+
+def test_memo_normalization_and_separate_series():
+    rows = []
+    for m in (8, 9, 10):
+        rows.append(_e(f"2026-{m:02d}-10", memo="Netflix " if m == 9 else "netflix"))
+        rows.append(_e(f"2026-{m:02d}-20", "rent", 80000, ""))
+    res = detect_recurring(rows)
+    assert [(r.category, r.next_date) for r in res] == [
+        ("sub", date(2026, 11, 10)),
+        ("rent", date(2026, 11, 20)),
+    ]
+
+
+def test_as_of_drops_ended_series():
+    rows = [_e("2026-06-15"), _e("2026-07-15"), _e("2026-08-15")]
+    assert detect_recurring(rows, as_of=date(2026, 11, 20)) == []
+    assert len(detect_recurring(rows, as_of=date(2026, 9, 16))) == 1
+
+
+def test_empty_and_input_not_mutated():
+    assert detect_recurring([]) == []
+    rows = [_e("2026-10-15"), _e("2026-09-15"), _e("2026-08-15")]
+    snapshot = list(rows)
+    assert len(detect_recurring(rows)) == 1
+    assert rows == snapshot
