@@ -0,0 +1,252 @@
+"""Import bank/card statement CSV text into Expense records (pure: takes a str, no I/O)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int  # 1 始まり。レコードの開始行(ヘッダーが 1)
+    column: str
+    value: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+    skipped: int
+
+
+_DATE_ALIASES = ("日付", "利用日", "取引日", "ご利用日", "date")
+_AMOUNT_ALIASES = ("金額", "利用金額", "ご利用金額", "amount")
+_WITHDRAW_ALIASES = ("出金", "出金額", "お支払い金額", "支払")
+_DEPOSIT_ALIASES = ("入金", "入金額", "お預かり金額", "預入")
+_MEMO_ALIASES = (
+    "摘要",
+    "メモ",
+    "利用店名",
+    "ご利用店名",
+    "内容",
+    "description",
+    "memo",
+)
+_CATEGORY_ALIASES = ("カテゴリ", "分類", "category")
+
+_NEWLINE_RE = re.compile(r"\r\n|\r|\n")
+
+_ISO_RE = re.compile(r"([0-9]{4})([-/.])([0-9]{1,2})\2([0-9]{1,2})")
+_JP_RE = re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日")
+_COMPACT_RE = re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})")
+_ERA_RE = re.compile(
+    r"(令和|R|r)([0-9]{1,2})[年/.\-]([0-9]{1,2})[月/.\-]([0-9]{1,2})日?"
+)
+_TIME_RE = re.compile(r"(?:\s+|T)[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?$")
+
+_CURRENCY_PREFIX_RE = re.compile(r"^(?:JPY|¥)\s*", re.IGNORECASE)
+_YEN_SUFFIX_RE = re.compile(r"\s*円$")
+_AMOUNT_BODY_RE = re.compile(r"(?:[0-9]{1,3}(?:,[0-9]{3})+|[0-9]+)(?:\.0+)?")
+
+
+@dataclass(frozen=True)
+class _Columns:
+    date: int
+    amount: int | None
+    withdraw: int | None
+    deposit: int | None
+    memo: int | None
+    category: int | None
+
+
+def _find(keys: list[str], aliases: tuple[str, ...]) -> int | None:
+    for i, k in enumerate(keys):
+        if k in aliases:
+            return i
+    return None
+
+
+def _resolve_columns(header: list[str]) -> _Columns:
+    keys = [h.strip().lower() for h in header]
+    date_i = _find(keys, _DATE_ALIASES)
+    amount_i = _find(keys, _AMOUNT_ALIASES)
+    withdraw_i = _find(keys, _WITHDRAW_ALIASES)
+    deposit_i = _find(keys, _DEPOSIT_ALIASES)
+    missing: list[str] = []
+    if date_i is None:
+        missing.append("日付")
+    if amount_i is None and withdraw_i is None and deposit_i is None:
+        missing.append("金額(または出金・入金)")
+    if missing or date_i is None:
+        raise ValueError("必須の列がありません: " + ", ".join(missing))
+    return _Columns(
+        date=date_i,
+        amount=amount_i,
+        withdraw=withdraw_i,
+        deposit=deposit_i,
+        memo=_find(keys, _MEMO_ALIASES),
+        category=_find(keys, _CATEGORY_ALIASES),
+    )
+
+
+def _parse_date(raw: str) -> date:
+    s = _TIME_RE.sub("", unicodedata.normalize("NFKC", raw).strip())
+    parts: tuple[int, int, int] | None = None
+    if m := _ISO_RE.fullmatch(s):
+        parts = (int(m[1]), int(m[3]), int(m[4]))
+    elif (m := _JP_RE.fullmatch(s)) or (m := _COMPACT_RE.fullmatch(s)):
+        parts = (int(m[1]), int(m[2]), int(m[3]))
+    elif m := _ERA_RE.fullmatch(s):
+        n = int(m[2])
+        if n >= 1:  # 令和元年 = 2019
+            parts = (2018 + n, int(m[3]), int(m[4]))
+    if parts is None:
+        raise ValueError("日付の形式が不正です")
+    try:
+        return date(*parts)
+    except ValueError:
+        raise ValueError("存在しない日付です") from None
+
+
+def _parse_amount(raw: str) -> int | None:
+    """円の整数に変換する。値なし(空欄・`-`・`—`)は None。形式が不正なら ValueError。"""
+    s = unicodedata.normalize("NFKC", raw).strip()
+    if s in ("", "-", "—"):
+        return None
+    s = _CURRENCY_PREFIX_RE.sub("", s).strip()
+    s = _YEN_SUFFIX_RE.sub("", s).strip()
+    neg = False
+    if s.startswith("(") and s.endswith(")"):
+        neg, s = True, s[1:-1].strip()
+    elif s[:1] in ("-", "−", "△", "▲"):
+        neg, s = True, s[1:].strip()
+    elif s.endswith("-"):
+        neg, s = True, s[:-1].strip()
+    if not _AMOUNT_BODY_RE.fullmatch(s):
+        raise ValueError("金額の形式が不正です")
+    value = int(s.split(".")[0].replace(",", ""))
+    return -value if neg else value
+
+
+def _convert(
+    line: int, row: list[str], cols: _Columns, header: list[str]
+) -> tuple[Expense | None, list[RowError]]:
+    """1 レコードを変換する。誤りは列ごとに全部集める。0 円は (None, [])。"""
+    errors: list[RowError] = []
+
+    def name(i: int | None) -> str:
+        return header[i].strip() if i is not None else ""
+
+    def cell(i: int | None) -> str:
+        return row[i] if i is not None else ""
+
+    day: date | None = None
+    raw_date = row[cols.date]
+    try:
+        day = _parse_date(raw_date)
+    except ValueError as e:
+        errors.append(RowError(line, name(cols.date), raw_date, str(e)))
+
+    amount: int | None = None
+    if cols.amount is not None:
+        raw = row[cols.amount]
+        try:
+            v = _parse_amount(raw)
+        except ValueError as e:
+            errors.append(RowError(line, name(cols.amount), raw, str(e)))
+        else:
+            if v is None:
+                errors.append(
+                    RowError(line, name(cols.amount), raw, "金額の値がありません")
+                )
+            else:
+                amount = v
+    else:
+        parsed: dict[str, int | None] = {}
+        bad = False
+        for label, idx in (("出金", cols.withdraw), ("入金", cols.deposit)):
+            raw = cell(idx)
+            try:
+                parsed[label] = _parse_amount(raw)
+            except ValueError as e:
+                bad = True
+                errors.append(RowError(line, name(idx), raw, str(e)))
+        if not bad:
+            w, d = parsed["出金"], parsed["入金"]
+            combo = f"{cell(cols.withdraw)}/{cell(cols.deposit)}"
+            if w is not None and d is not None:
+                errors.append(
+                    RowError(line, "出金/入金", combo, "出金と入金の両方に値があります")
+                )
+            elif w is not None:
+                amount = w
+            elif d is not None:
+                amount = -d  # 入金は返金として負の金額
+            else:
+                errors.append(
+                    RowError(
+                        line, "出金/入金", combo, "出金・入金のどちらにも値がありません"
+                    )
+                )
+
+    if errors:
+        return None, errors
+    if day is None or amount is None:  # 誤りが無ければ両方そろっている
+        return None, errors
+    if amount == 0:
+        return None, []
+    category = cell(cols.category).strip() if cols.category is not None else "未分類"
+    memo = cell(cols.memo).strip()
+    return Expense(day=day, category=category, amount=amount, memo=memo), []
+
+
+def import_statement(text: str) -> ImportResult:
+    if not isinstance(text, str):
+        raise TypeError(f"text は str である必要があります: {type(text).__name__}")
+    text = text.removeprefix("﻿")
+    if not text.strip():
+        return ImportResult(expenses=[], errors=[], skipped=0)
+
+    first_line = _NEWLINE_RE.split(text, maxsplit=1)[0]
+    delim = "\t" if "\t" in first_line else ","
+
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delim)
+    records: list[tuple[int, list[str]]] = []
+    prev = 0
+    for row in reader:
+        records.append((prev + 1, row))
+        prev = reader.line_num
+
+    header = records[0][1]
+    cols = _resolve_columns(header)
+
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    skipped = 0
+    for line, row in records[1:]:
+        if all(not c.strip() for c in row):
+            skipped += 1
+            continue
+        if len(row) != len(header):
+            errors.append(
+                RowError(
+                    line, "-", delim.join(row), f"列数が {len(row)}、期待 {len(header)}"
+                )
+            )
+            continue
+        expense, row_errors = _convert(line, row, cols, header)
+        if row_errors:
+            errors.extend(row_errors)
+        elif expense is None:
+            skipped += 1
+        else:
+            expenses.append(expense)
+    return ImportResult(expenses=expenses, errors=errors, skipped=skipped)
