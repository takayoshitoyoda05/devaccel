index 0000000..021d706
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,119 @@
+"""Search expenses with composable pure predicates."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable
+from datetime import date
+
+from kakeibo.core import Expense
+
+Query = Callable[[Expense], bool]
+
+
+def _check_bound(value: object, name: str) -> None:
+    if value is None:
+        return
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{name} は int か None である必要があります: {value!r}")
+
+
+def _normalize(text: str) -> str:
+    return unicodedata.normalize("NFKC", text).lower()
+
+
+def category(*names: str) -> Query:
+    """Match expenses whose category equals one of names (surrounding spaces ignored)."""
+    if not names:
+        raise ValueError("names は 1 つ以上必要です")
+    for n in names:
+        if not isinstance(n, str):
+            raise TypeError(f"names は str である必要があります: {n!r}")
+    wanted = frozenset(n.strip() for n in names)
+
+    def pred(e: Expense) -> bool:
+        return e.category in wanted
+
+    return pred
+
+
+def amount_between(lo: int | None, hi: int | None) -> Query:
+    """Match amounts in [lo, hi] (inclusive). None means unbounded on that side."""
+    _check_bound(lo, "lo")
+    _check_bound(hi, "hi")
+    if lo is not None and hi is not None and lo > hi:
+        raise ValueError(f"lo > hi です: lo={lo}, hi={hi}")
+
+    def pred(e: Expense) -> bool:
+        return (lo is None or e.amount >= lo) and (hi is None or e.amount <= hi)
+
+    return pred
+
+
+def memo_contains(text: str) -> Query:
+    """Match memos containing text (NFKC + lowercase on both sides)."""
+    if not isinstance(text, str):
+        raise TypeError(f"text は str である必要があります: {text!r}")
+    needle = _normalize(text)
+
+    def pred(e: Expense) -> bool:
+        return needle in _normalize(e.memo)
+
+    return pred
+
+
+def date_between(start: date | None, end: date | None) -> Query:
+    """Match days in [start, end] (inclusive). None means unbounded on that side."""
+    for value, name in ((start, "start"), (end, "end")):
+        if value is not None and not isinstance(value, date):
+            raise TypeError(f"{name} は date か None である必要があります: {value!r}")
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"start > end です: start={start}, end={end}")
+
+    def pred(e: Expense) -> bool:
+        return (start is None or e.day >= start) and (end is None or e.day <= end)
+
+    return pred
+
+
+def _check_queries(qs: tuple[Query, ...]) -> None:
+    for q in qs:
+        if not callable(q):
+            raise TypeError(f"query は callable である必要があります: {q!r}")
+
+
+def all_of(*qs: Query) -> Query:
+    """True when every query matches. With no queries, always True."""
+    _check_queries(qs)
+
+    def pred(e: Expense) -> bool:
+        return all(q(e) for q in qs)
+
+    return pred
+
+
+def any_of(*qs: Query) -> Query:
+    """True when any query matches. With no queries, always False."""
+    _check_queries(qs)
+
+    def pred(e: Expense) -> bool:
+        return any(q(e) for q in qs)
+
+    return pred
+
+
+def not_(q: Query) -> Query:
+    """Invert a query."""
+    _check_queries((q,))
+
+    def pred(e: Expense) -> bool:
+        return not q(e)
+
+    return pred
+
+
+def search(expenses: list[Expense], query: Query) -> list[Expense]:
+    """Return matching expenses in input order as a new list. Input is not modified."""
+    if not callable(query):
+        raise TypeError(f"query は callable である必要があります: {query!r}")
+    return [e for e in expenses if query(e)]
