@@ -0,0 +1,113 @@
+"""Detect recurring expenses (subscriptions, rent, etc.) from Expense records."""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+# 末尾の「 #12」「 12月」「 2026/11」などの番号・年月を除く(D2)
+_TRAILING_RE = re.compile(r"\s*(?:#\d+|\d{4}/\d{1,2}|\d{1,2}月)$")
+
+
+@dataclass(frozen=True)
+class Recurring:
+    memo: str
+    category: str
+    amount: int
+    months: list[tuple[int, int]]
+    days: list[date]
+
+
+def _normalize_memo(memo: str) -> str:
+    """D2: NFKC → 小文字化 → 空白を 1 つにして前後を除く → 末尾の番号・年月を除く。"""
+    s = unicodedata.normalize("NFKC", memo).lower()
+    s = re.sub(r"\s+", " ", s).strip()
+    while True:
+        t = _TRAILING_RE.sub("", s).rstrip()
+        if t == s:
+            return s
+        s = t
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month
+
+
+def _latest_interval(entries: list[Expense]) -> list[Expense]:
+    """entries は月の昇順で 1 月 1 件。最新の連続・金額が ±10 % 以内の区間を返す(R3, R4)。"""
+    latest = entries[-1]
+    run = [latest]
+    for prev in reversed(entries[:-1]):
+        head = run[0]
+        if _month_index(prev.day) != _month_index(head.day) - 1:
+            break  # 欠けた月で切る
+        if abs(prev.amount - latest.amount) * 10 > latest.amount:
+            break  # 最新金額の ±10 % を超えたら切る
+        run.insert(0, prev)
+    return run
+
+
+def find_recurring(expenses: list[Expense], min_months: int = 3) -> list[Recurring]:
+    if not isinstance(expenses, list):
+        raise TypeError("expenses は list である必要があります")
+    if isinstance(min_months, bool) or not isinstance(min_months, int):
+        raise TypeError("min_months は int である必要があります")
+    if min_months < 2:
+        raise ValueError(f"min_months は 2 以上である必要があります: {min_months}")
+
+    # (カテゴリ, 正規化メモ) → {(年, 月): その月で最も早い明細}
+    groups: dict[tuple[str, str], dict[tuple[int, int], Expense]] = {}
+    for e in expenses:
+        if not isinstance(e, Expense):
+            raise TypeError("expenses の要素は Expense である必要があります")
+        if isinstance(e.amount, bool) or not isinstance(e.amount, int):
+            raise TypeError("Expense.amount は int である必要があります")
+        if e.amount <= 0:  # 返金・0 円は対象外(D3, R2)
+            continue
+        memo_key = _normalize_memo(e.memo)
+        if not memo_key:  # R1
+            continue
+        ym = (e.day.year, e.day.month)
+        month_map = groups.setdefault((e.category, memo_key), {})
+        cur = month_map.get(ym)
+        if cur is None or e.day < cur.day:
+            month_map[ym] = e
+
+    out: list[Recurring] = []
+    for (category, _), month_map in groups.items():
+        entries = [month_map[ym] for ym in sorted(month_map)]
+        run = _latest_interval(entries)
+        if len(run) < min_months:
+            continue
+        latest = run[-1]
+        out.append(
+            Recurring(
+                memo=latest.memo,
+                category=category,
+                amount=latest.amount,
+                months=[(e.day.year, e.day.month) for e in run],
+                days=[e.day for e in run],
+            )
+        )
+
+    out.sort(key=lambda r: (next_due(r), -r.amount, r.memo))  # R7
+    return out
+
+
+def next_due(r: Recurring) -> date:
+    """R6: 最新の月の次の月。日は区間内の日の最大値を、その月の末日に丸める。"""
+    if not isinstance(r, Recurring):
+        raise TypeError("r は Recurring である必要があります")
+    year, month = r.months[-1]
+    if month == 12:
+        year, month = year + 1, 1
+    else:
+        month += 1
+    day = max(d.day for d in r.days)
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(day, last))
