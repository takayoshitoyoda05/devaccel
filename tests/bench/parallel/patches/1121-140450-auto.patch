+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.importer import ImportResult, RowError, import_statement
+
+
+# 仕様の例の表 (E1-*) をそのままテストにする
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param(
+            '利用日,ご利用店名,利用金額\n2026/1/5,ＡＢＣ,"1,234円"',
+            ImportResult(
+                expenses=[Expense(date(2026, 1, 5), "未分類", 1234, "ＡＢＣ")],
+                errors=[],
+                skipped=0,
+            ),
+            id="E1-1",
+        ),
+        pytest.param(
+            "日付\t出金\t入金\n2026-01-05\t\t3,000",
+            ImportResult(
+                expenses=[Expense(date(2026, 1, 5), "未分類", -3000, "")],
+                errors=[],
+                skipped=0,
+            ),
+            id="E1-2",
+        ),
+    ],
+)
+def test_example_table(text: str, expected: ImportResult) -> None:
+    assert import_statement(text) == expected
+
+
+def test_E1_3_date_and_amount_both_reported() -> None:
+    result = import_statement("date,amount\n2026-02-30,12.5")
+    assert result.expenses == []
+    assert result.skipped == 0
+    assert [(e.line, e.column) for e in result.errors] == [(2, "date"), (2, "amount")]
+
+
+# R1: 区切り・BOM・改行・引用符・行番号
+def test_bom_and_crlf_and_cr_line_endings() -> None:
+    for nl in ("\r\n", "\r", "\n"):
+        text = "﻿日付,金額" + nl + "2026-01-05,100" + nl + "2026-01-06,200"
+        result = import_statement(text)
+        assert [e.amount for e in result.expenses] == [100, 200], repr(nl)
+
+
+def test_quoted_newline_and_line_number_is_record_start() -> None:
+    text = '日付,金額,摘要\n2026-01-05,100,"a\nb"\n2026-01-06,x,y'
+    result = import_statement(text)
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "a\nb")]
+    assert result.errors == [
+        RowError(line=4, column="金額", value="x", reason=result.errors[0].reason)
+    ]
+
+
+def test_delimiter_detected_from_first_line() -> None:
+    result = import_statement("日付\t金額\n2026-01-05\t100")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+# R2: 列名の別名・前後空白・大文字小文字無視、カテゴリ・メモ
+def test_column_aliases_ignore_case_and_outer_spaces() -> None:
+    text = " DATE , Amount ,Category, 内容 \n2026-01-05,100,食費,  ランチ  "
+    result = import_statement(text)
+    assert result.expenses == [Expense(date(2026, 1, 5), "食費", 100, "ランチ")]
+
+
+# R3: 必須列・空の結果
+def test_missing_required_columns_raise_with_names() -> None:
+    with pytest.raises(ValueError, match="日付"):
+        import_statement("金額\n100")
+    with pytest.raises(ValueError, match="金額"):
+        import_statement("日付,メモ\n2026-01-05,x")
+
+
+@pytest.mark.parametrize("text", ["", "﻿", "  \n  "])
+def test_empty_text_gives_empty_result(text: str) -> None:
+    assert import_statement(text) == ImportResult([], [], 0)
+
+
+def test_header_only_gives_empty_result() -> None:
+    assert import_statement("日付,金額\n") == ImportResult([], [], 0)
+
+
+# R4: 日付の書式
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026.1.5",
+        "20260105",
+        "2026年1月5日",
+        "２０２６／１／５",
+        "2026-01-05 12:34",
+        "2026-01-05T12:34:56",
+        "R8.1.5",
+        "令和8年1月5日",
+    ],
+)
+def test_date_formats(raw: str) -> None:
+    result = import_statement(f"日付,金額\n{raw},100")
+    assert [e.day for e in result.expenses] == [date(2026, 1, 5)]
+
+
+def test_nonexistent_date_is_row_error() -> None:
+    result = import_statement("日付,金額\n2026-02-30,100")
+    assert result.expenses == []
+    assert [(e.line, e.column, e.value) for e in result.errors] == [
+        (2, "日付", "2026-02-30")
+    ]
+
+
+# R5: 金額の書式
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        ("1234", 1234),
+        ("1,234", 1234),
+        ("１，２３４", 1234),
+        ("¥1,234", 1234),
+        ("￥1,234", 1234),
+        ("1,234円", 1234),
+        ("JPY 1234", 1234),
+        ("　1,234　", 1234),
+        ("1234.0", 1234),
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+    ],
+)
+def test_amount_formats(raw: str, expected: int) -> None:
+    result = import_statement(f'日付,金額\n2026-01-05,"{raw}"')
+    assert [e.amount for e in result.expenses] == [expected]
+
+
+@pytest.mark.parametrize("raw", ["12.5", "abc", "1,23"])
+def test_invalid_amount_is_row_error(raw: str) -> None:
+    result = import_statement(f'日付,金額\n2026-01-05,"{raw}"')
+    assert result.expenses == []
+    assert [(e.column, e.value) for e in result.errors] == [("金額", raw)]
+
+
+@pytest.mark.parametrize("raw", ["", "-", "—"])
+def test_blank_amount_cell_is_no_value_error(raw: str) -> None:
+    result = import_statement(f"日付,金額\n2026-01-05,{raw}")
+    assert result.expenses == []
+    assert [e.column for e in result.errors] == ["金額"]
+
+
+# R6: 出金/入金 2 列
+def test_withdraw_only_is_positive() -> None:
+    result = import_statement("日付,出金,入金\n2026-01-05,1200,")
+    assert [e.amount for e in result.expenses] == [1200]
+
+
+def test_deposit_only_is_negative() -> None:
+    result = import_statement("日付,出金,入金\n2026-01-05,-,500")
+    assert [e.amount for e in result.expenses] == [-500]
+
+
+@pytest.mark.parametrize(
+    ("row", "reason_part"),
+    [
+        ("2026-01-05,100,200", "両方"),
+        ("2026-01-05,,", "どちらにも"),
+    ],
+)
+def test_both_or_neither_withdraw_deposit_is_error(row: str, reason_part: str) -> None:
+    result = import_statement(f"日付,出金,入金\n{row}")
+    assert result.expenses == []
+    assert [e.column for e in result.errors] == ["出金/入金"]
+    assert reason_part in result.errors[0].reason
+
+
+# R7: 0 円と空行は skipped
+def test_zero_and_blank_rows_are_skipped_not_errors() -> None:
+    text = "日付,金額\n2026-01-05,0\n\n2026-01-06,100\n,\n"
+    result = import_statement(text)
+    assert [e.amount for e in result.expenses] == [100]
+    assert result.errors == []
+    assert result.skipped == 3
+
+
+# R8: 列数の不一致
+def test_column_count_mismatch_is_row_error_without_repair() -> None:
+    result = import_statement("日付,金額,摘要\n2026-01-05,1,234円,x\n2026-01-06,300,y")
+    assert [e.amount for e in result.expenses] == [300]  # 4 列の行だけ落ちる
+    assert len(result.errors) == 1
+    err = result.errors[0]
+    assert (err.line, err.column) == (2, "-")
+    assert "列数が 4、期待 3" in err.reason
+
+
+def test_column_count_mismatch_does_not_stop_good_rows() -> None:
+    result = import_statement("日付,金額\n2026-01-05\n2026-01-06,300")
+    assert [e.amount for e in result.expenses] == [300]
+    assert [(e.line, e.column) for e in result.errors] == [(2, "-")]
+
+
+# R9: 1 行の誤りは列ごとに全部
+def test_multiple_errors_in_one_row_are_all_reported() -> None:
+    result = import_statement("日付,金額,摘要\n2026-02-30,12.5,x\n2026-01-06,300,y")
+    assert [(e.line, e.column) for e in result.errors] == [(2, "日付"), (2, "金額")]
+    assert [e.amount for e in result.expenses] == [300]
+
+
+# R10: 前後空白除去・入力の行順
+def test_memo_and_category_stripped_and_order_kept() -> None:
+    text = (
+        "日付,金額,カテゴリ,メモ\n2026-01-06, 200 , 食費 , b \n2026-01-05,100, 日用品,a"
+    )
+    result = import_statement(text)
+    assert result.expenses == [
+        Expense(date(2026, 1, 6), "食費", 200, "b"),
+        Expense(date(2026, 1, 5), "日用品", 100, "a"),
+    ]
+
+
+# D1: 型
+@pytest.mark.parametrize("bad", [None, 1, 1.5, True, b"date,amount"])
+def test_non_str_input_is_type_error(bad: object) -> None:
+    with pytest.raises(TypeError):
+        import_statement(bad)  # type: ignore[arg-type]
