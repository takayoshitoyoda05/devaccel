+++ b/tests/test_monthly_diff.py
@@ -0,0 +1,173 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthly_diff import CategoryDiff, compare_months, render_report
+
+
+def ex(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+# 例の表 E4-1〜E4-3 の全行
+EXAMPLES = [
+    pytest.param(
+        [ex("2026-01-05", "食費", 30000), ex("2026-02-05", "食費", 33000)],
+        (2026, 2),
+        [CategoryDiff("食費", 30000, 33000, 3000, 0.1, "増加")],
+        id="E4-1",
+    ),
+    pytest.param(
+        [ex("2026-01-10", "交通", 5000)],
+        (2026, 2),
+        [CategoryDiff("交通", 5000, 0, -5000, -1.0, "なくなった")],
+        id="E4-2",
+    ),
+    pytest.param(
+        [ex("2025-12-20", "食費", 1000), ex("2026-01-03", "食費", 9999)],
+        (2026, 1),
+        [CategoryDiff("食費", 1000, 9999, 8999, 8.999, "増加")],
+        id="E4-3",
+    ),
+]
+
+
+@pytest.mark.parametrize(("expenses", "month", "expected"), EXAMPLES)
+def test_examples(
+    expenses: list[Expense], month: tuple[int, int], expected: list[CategoryDiff]
+) -> None:
+    assert compare_months(expenses, month) == expected
+
+
+def test_E4_3_previous_month_is_previous_december() -> None:
+    # 2026-01 の前月は 2025-12 で、2025-12 の食費だけが previous になる
+    expenses = [ex("2025-12-31", "食費", 700), ex("2026-01-01", "食費", 800)]
+    [diff] = compare_months(expenses, (2026, 1))
+    assert diff.previous == 700
+    assert diff.current == 800
+
+
+@pytest.mark.parametrize(
+    "month",
+    [(2026, 0), (2026, 13), (2026, -1)],
+    ids=["zero", "thirteen", "negative"],
+)
+def test_month_out_of_range_is_value_error(month: tuple[int, int]) -> None:
+    with pytest.raises(ValueError, match="month"):
+        compare_months([], month)
+
+
+@pytest.mark.parametrize(
+    "month",
+    [(2026, True), (2026, 1.0), (2026, None), ("2026", 1), None, 202601],
+    ids=["bool-month", "float-month", "none-month", "str-year", "none", "int"],
+)
+def test_month_wrong_type_is_type_error(month: object) -> None:
+    with pytest.raises(TypeError):
+        compare_months([], month)  # type: ignore[arg-type]
+
+
+def test_both_months_empty_returns_empty_list() -> None:
+    # R5: 前月も今月も無ければ空リスト
+    assert compare_months([ex("2026-03-01", "食費", 100)], (2026, 1)) == []
+
+
+def test_previous_zero_gives_none_ratio_and_new_status() -> None:
+    # 前月に無く今月だけ → 新規、ratio は None(0 で割らない)
+    expenses = [ex("2026-02-01", "書籍", 1200)]
+    [diff] = compare_months(expenses, (2026, 2))
+    assert diff == CategoryDiff("書籍", 0, 1200, 1200, None, "新規")
+
+
+def test_previous_negative_gives_none_ratio() -> None:
+    # 前月が返金で純額マイナス → ratio は None(0 で割らない・負の基準にしない)
+    expenses = [ex("2026-01-01", "食費", -1000), ex("2026-02-01", "食費", 2000)]
+    [diff] = compare_months(expenses, (2026, 2))
+    assert diff.previous == -1000
+    assert diff.current == 2000
+    assert diff.delta == 3000
+    assert diff.ratio is None
+    assert diff.status == "増加"
+
+
+def test_refund_is_netted_into_current_total() -> None:
+    # D3: 返金は月比較の合計に純額で入る
+    expenses = [
+        ex("2026-01-01", "食費", 4000),
+        ex("2026-02-01", "食費", 5000),
+        ex("2026-02-10", "食費", -1000),
+    ]
+    [diff] = compare_months(expenses, (2026, 2))
+    assert diff.current == 4000
+    assert diff.delta == 0
+    assert diff.status == "変化なし"
+
+
+def test_decrease_status() -> None:
+    expenses = [ex("2026-01-01", "食費", 10000), ex("2026-02-01", "食費", 8000)]
+    [diff] = compare_months(expenses, (2026, 2))
+    assert diff.status == "減少"
+    assert diff.delta == -2000
+    assert diff.ratio == pytest.approx(-0.2)
+
+
+def test_unchanged_status() -> None:
+    expenses = [ex("2026-01-01", "食費", 10000), ex("2026-02-01", "食費", 10000)]
+    [diff] = compare_months(expenses, (2026, 2))
+    assert diff.status == "変化なし"
+    assert diff.delta == 0
+
+
+def test_category_with_zero_on_both_months_is_omitted() -> None:
+    # 両月とも純額 0 のカテゴリは出さない
+    expenses = [
+        ex("2026-01-01", "雑費", 100),
+        ex("2026-01-02", "雑費", -100),
+        ex("2026-02-01", "食費", 500),
+    ]
+    diffs = compare_months(expenses, (2026, 2))
+    assert [d.category for d in diffs] == ["食費"]
+
+
+def test_sort_by_abs_delta_desc_then_category_asc() -> None:
+    expenses = [
+        ex("2026-01-01", "B", 1000),
+        ex("2026-02-01", "B", 2000),  # delta +1000
+        ex("2026-01-01", "A", 5000),
+        ex("2026-02-01", "A", 4000),  # delta -1000
+        ex("2026-01-01", "C", 100),
+        ex("2026-02-01", "C", 3100),  # delta +3000
+    ]
+    diffs = compare_months(expenses, (2026, 2))
+    assert [d.category for d in diffs] == ["C", "A", "B"]
+
+
+def test_render_empty_is_no_data() -> None:
+    assert render_report([]) == "データなし"
+
+
+def test_render_line_format_with_ratio() -> None:
+    diff = CategoryDiff("食費", 30000, 33000, 3000, 0.125, "増加")
+    assert render_report([diff]) == "食費  30,000→33,000  +3,000 (+12.5%)"
+
+
+def test_render_line_format_negative_delta() -> None:
+    diff = CategoryDiff("交通", 5000, 0, -5000, -1.0, "なくなった")
+    assert render_report([diff]) == "交通  5,000→0  -5,000 (-100.0%)"
+
+
+def test_render_none_ratio_shows_dash() -> None:
+    diff = CategoryDiff("書籍", 0, 1200, 1200, None, "新規")
+    assert render_report([diff]) == "書籍  0→1,200  +1,200 (-)"
+
+
+def test_render_joins_lines_with_newline() -> None:
+    a = CategoryDiff("食費", 1000, 2000, 1000, 1.0, "増加")
+    b = CategoryDiff("交通", 500, 500, 0, 0.0, "変化なし")
+    assert render_report([a, b]).split("\n") == [
+        "食費  1,000→2,000  +1,000 (+100.0%)",
+        "交通  500→500  +0 (+0.0%)",
+    ]
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..c2165bd
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,197 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, next_due
+
+
+def ex(day: str, amount: int, memo: str = "Netflix", category: str = "通信") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+# --- 仕様の例の表 ---
+
+
+def test_E2_1_next_due_uses_max_day_and_clamps_to_month_end() -> None:
+    rows = [ex("2026-01-31", 1000), ex("2026-02-28", 1000), ex("2026-03-31", 1000)]
+    (r,) = find_recurring(rows)
+    assert next_due(r) == date(2026, 4, 30)
+
+
+def test_E2_2_amount_within_10_percent_is_same_series() -> None:
+    rows = [
+        ex("2026-01-05", 980),
+        ex("2026-02-05", 980),
+        ex("2026-03-05", 980),
+        ex("2026-04-05", 1000),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].amount == 1000
+    assert result[0].months == [(2026, 1), (2026, 2), (2026, 3), (2026, 4)]
+
+
+def test_E2_3_missing_month_breaks_series() -> None:
+    rows = [ex("2026-01-05", 1000), ex("2026-02-05", 1000), ex("2026-04-05", 1000)]
+    assert find_recurring(rows, min_months=3) == []
+
+
+# --- 規則のテスト ---
+
+
+def test_R1_empty_memo_is_ignored() -> None:
+    rows = [
+        ex("2026-01-05", 1000, memo=""),
+        ex("2026-02-05", 1000, memo=""),
+        ex("2026-03-05", 1000, memo=""),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_R2_refunds_and_zero_yen_are_excluded() -> None:
+    rows = [
+        ex("2026-01-05", 1000),
+        ex("2026-02-05", 1000),
+        ex("2026-03-05", 1000),
+        ex("2026-04-05", 0),
+        ex("2026-05-05", -1000),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.months == [(2026, 1), (2026, 2), (2026, 3)]
+
+
+def test_R2_same_month_duplicates_are_counted_once_with_earliest_day() -> None:
+    rows = [
+        ex("2026-01-20", 1000),
+        ex("2026-01-05", 1000),
+        ex("2026-02-05", 1000),
+    ]
+    assert find_recurring(rows) == []  # 2 か月しかないので 3 か月の規則を満たさない
+
+    rows.append(ex("2026-03-05", 1000))
+    (r,) = find_recurring(rows)
+    assert r.months == [(2026, 1), (2026, 2), (2026, 3)]
+    assert r.days == [date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)]
+
+
+def test_R3_min_months_two_accepts_two_consecutive_months() -> None:
+    rows = [ex("2026-01-05", 1000), ex("2026-02-05", 1000)]
+    (r,) = find_recurring(rows, min_months=2)
+    assert r.months == [(2026, 1), (2026, 2)]
+
+
+def test_R3_min_months_not_reached_gives_nothing() -> None:
+    rows = [ex("2026-01-05", 1000), ex("2026-02-05", 1000), ex("2026-03-05", 1000)]
+    assert find_recurring(rows, min_months=4) == []
+
+
+def test_R3_last_consecutive_run_is_judged() -> None:
+    rows = [
+        ex("2026-01-05", 1000),
+        ex("2026-02-05", 1000),
+        ex("2026-03-05", 1000),
+        ex("2026-05-05", 1000),
+        ex("2026-06-05", 1000),
+        ex("2026-07-05", 1000),
+        ex("2026-08-05", 1000),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.months == [(2026, 5), (2026, 6), (2026, 7), (2026, 8)]
+
+
+def test_R4_large_amount_change_starts_new_interval() -> None:
+    rows = [
+        ex("2026-01-05", 1000),
+        ex("2026-02-05", 1000),
+        ex("2026-03-05", 1000),
+        ex("2026-04-05", 1500),
+        ex("2026-05-05", 1500),
+        ex("2026-06-05", 1500),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.amount == 1500
+    assert r.months == [(2026, 4), (2026, 5), (2026, 6)]
+
+
+def test_R5_different_memo_is_separate_series() -> None:
+    rows: list[Expense] = []
+    for m in (1, 2, 3):
+        rows.append(ex(f"2026-{m:02d}-05", 1000, memo="Netflix"))
+        rows.append(ex(f"2026-{m:02d}-20", 1000, memo="Spotify"))
+    result = find_recurring(rows)
+    assert sorted(r.memo for r in result) == ["Netflix", "Spotify"]
+
+
+def test_R6_next_due_wraps_december_to_january() -> None:
+    rows = [ex("2026-10-31", 1000), ex("2026-11-30", 1000), ex("2026-12-31", 1000)]
+    (r,) = find_recurring(rows)
+    assert next_due(r) == date(2027, 1, 31)
+
+
+def test_R6_next_due_leap_year_february() -> None:
+    rows = [ex("2027-11-30", 1000), ex("2027-12-31", 1000), ex("2028-01-31", 1000)]
+    (r,) = find_recurring(rows)
+    assert next_due(r) == date(2028, 2, 29)
+
+
+def test_R6_next_due_non_leap_february_clamps_to_28() -> None:
+    rows = [ex("2025-12-31", 1000), ex("2026-01-31", 1000), ex("2026-02-28", 1000)]
+    (r,) = find_recurring(rows)
+    assert next_due(r) == date(2026, 3, 31)
+
+
+def test_R7_sorted_by_next_due_then_amount_desc_then_memo_asc() -> None:
+    rows: list[Expense] = []
+    for m in (1, 2, 3):
+        rows.append(ex(f"2026-{m:02d}-10", 1000, memo="A"))
+        rows.append(ex(f"2026-{m:02d}-10", 500, memo="B", category="通信"))
+        rows.append(ex(f"2026-{m:02d}-05", 2000, memo="C", category="保険"))
+        rows.append(ex(f"2026-{m:02d}-10", 1000, memo="D", category="保険"))
+    result = find_recurring(rows)
+    assert [r.memo for r in result] == ["C", "A", "D", "B"]
+
+
+def test_R7_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+def test_R7_single_item_is_not_a_series() -> None:
+    assert find_recurring([ex("2026-01-05", 1000)], min_months=2) == []
+
+
+def test_D2_memo_normalization_merges_numeric_suffixes_and_width() -> None:
+    rows = [
+        ex("2026-01-05", 1000, memo="Netflix #1"),
+        ex("2026-02-05", 1000, memo="ＮＥＴＦＬＩＸ 2月"),
+        ex("2026-03-05", 1000, memo="netflix  2026/03"),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.months == [(2026, 1), (2026, 2), (2026, 3)]
+
+
+def test_D1_wrong_types_raise_type_error() -> None:
+    with pytest.raises(TypeError):
+        find_recurring("not a list")  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        find_recurring([], min_months=True)
+    with pytest.raises(TypeError):
+        find_recurring([], min_months=2.0)  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        find_recurring([], min_months=None)  # type: ignore[arg-type]
+
+
+def test_D1_min_months_below_two_raises_value_error() -> None:
+    with pytest.raises(ValueError, match="min_months"):
+        find_recurring([], min_months=1)
+
+
+def test_next_due_returns_date_type() -> None:
+    r = Recurring(
+        memo="x", category="c", amount=1, months=[(2026, 1)], days=[date(2026, 1, 5)]
+    )
+    assert next_due(r) == date(2026, 2, 5)
diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..e6e3cba
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,157 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    all_of,
+    amount_between,
+    any_of,
+    category,
+    date_between,
+    memo_contains,
+    not_,
+    search,
+)
+
+D = date(2026, 11, 1)
+
+
+def ex(amount: int, cat: str = "food", memo: str = "", day: date = D) -> Expense:
+    return Expense(day=day, category=cat, amount=amount, memo=memo)
+
+
+# 仕様の例の表 (E3-*) をそのまま写す
+def test_E3_1_amount_between_includes_both_ends() -> None:
+    # E3-1: amount_between(1000, 1000) は 1000 円ちょうどを含む
+    rows = [ex(999), ex(1000), ex(1001)]
+    assert search(rows, amount_between(1000, 1000)) == [ex(1000)]
+
+
+def test_E3_2_any_of_empty_returns_nothing() -> None:
+    # E3-2: any_of() は何も返さない
+    rows = [ex(100), ex(200)]
+    assert search(rows, any_of()) == []
+
+
+def test_E3_3_memo_contains_fullwidth_matches_ascii_lower() -> None:
+    # E3-3: memo_contains("ＡＢＣ") とメモ "abc store" は一致
+    rows = [ex(100, memo="abc store")]
+    assert search(rows, memo_contains("ＡＢＣ")) == rows
+
+
+# 規則 R1〜R7 の端のケース
+@pytest.mark.parametrize(
+    "names,expected_cats",
+    [
+        (("food",), ["food"]),
+        (("  food ",), ["food"]),
+        (("food", "rent"), ["food", "rent"]),
+    ],
+    ids=["R1-exact", "R1-strip-spaces", "R1-any-of-names"],
+)
+def test_R1_category_matches_names_exactly(
+    names: tuple[str, ...], expected_cats: list[str]
+) -> None:
+    rows = [ex(1, "food"), ex(2, "rent"), ex(3, "food_extra"), ex(4, "Food")]
+    got = search(rows, category(*names))
+    assert got == [e for e in rows if e.category in expected_cats]
+
+
+def test_R1_category_without_names_raises() -> None:
+    with pytest.raises(ValueError):
+        category()
+
+
+def test_R2_amount_between_none_unbounded_both_sides() -> None:
+    rows = [ex(-500), ex(0), ex(10**9)]
+    assert search(rows, amount_between(None, None)) == rows
+
+
+@pytest.mark.parametrize(
+    "lo,hi,expected",
+    [
+        (None, 0, [-500, 0]),
+        (0, None, [0, 10**9]),
+        (-500, -500, [-500]),
+    ],
+    ids=["R2-hi-only", "R2-lo-only", "R2-negative-refund"],
+)
+def test_R2_R7_amount_between_one_side_and_negative(
+    lo: int | None, hi: int | None, expected: list[int]
+) -> None:
+    rows = [ex(-500), ex(0), ex(10**9)]
+    got = search(rows, amount_between(lo, hi))
+    assert [e.amount for e in got] == expected
+
+
+def test_R2_amount_between_lo_greater_than_hi_raises() -> None:
+    with pytest.raises(ValueError):
+        amount_between(2, 1)
+
+
+@pytest.mark.parametrize(
+    "lo,hi",
+    [(True, None), (None, False), (1.0, 2), (1, 2.5)],
+    ids=["R2-lo-bool", "R2-hi-bool", "R2-lo-float", "R2-hi-float"],
+)
+def test_R2_amount_between_bool_or_float_raises_type_error(
+    lo: object, hi: object
+) -> None:
+    with pytest.raises(TypeError):
+        amount_between(lo, hi)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize(
+    "text,memo,matches",
+    [
+        ("", "anything", True),
+        ("store", "abc STORE", True),
+        ("ＡＢＣ", "ABC", True),
+        ("xyz", "abc store", False),
+    ],
+    ids=["R3-empty-all", "R3-case-insensitive", "R3-nfkc", "R3-no-match"],
+)
+def test_R3_memo_contains(text: str, memo: str, matches: bool) -> None:
+    rows = [ex(1, memo=memo)]
+    assert (search(rows, memo_contains(text)) == rows) is matches
+
+
+def test_R4_date_between_inclusive_and_none_unbounded() -> None:
+    a, b, c = date(2026, 10, 31), date(2026, 11, 1), date(2026, 11, 30)
+    rows = [ex(1, day=a), ex(2, day=b), ex(3, day=c)]
+    assert search(rows, date_between(b, c)) == rows[1:]
+    assert search(rows, date_between(None, b)) == rows[:2]
+    assert search(rows, date_between(None, None)) == rows
+
+
+def test_R4_date_between_start_after_end_raises() -> None:
+    with pytest.raises(ValueError):
+        date_between(date(2026, 11, 2), date(2026, 11, 1))
+
+
+def test_R5_all_of_empty_is_true_and_not_inverts() -> None:
+    rows = [ex(1), ex(2)]
+    assert search(rows, all_of()) == rows
+    assert search(rows, not_(all_of())) == []
+    assert search(rows, not_(any_of())) == rows
+
+
+def test_R5_nested_combinators() -> None:
+    rows = [ex(100, "food"), ex(5000, "food"), ex(100, "rent")]
+    q = all_of(category("food"), not_(amount_between(1000, None)))
+    assert search(rows, q) == [ex(100, "food")]
+
+
+def test_R6_search_preserves_order_and_does_not_mutate() -> None:
+    rows = [ex(3), ex(1), ex(2)]
+    snapshot = list(rows)
+    got = search(rows, amount_between(None, None))
+    assert got == rows
+    assert got is not rows
+    assert rows == snapshot
+
+
+def test_R6_non_callable_query_raises_type_error() -> None:
+    with pytest.raises(TypeError):
+        search([ex(1)], "not callable")  # type: ignore[arg-type]
