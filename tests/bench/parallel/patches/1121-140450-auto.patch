+"""Compare per-category totals between a month and the previous month."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class CategoryDiff:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    ratio: float | None
+    status: str
+
+
+def _check_month(month: object) -> tuple[int, int]:
+    if not isinstance(month, tuple):
+        raise TypeError("month は (year, month) のタプルである必要があります")
+    if len(month) != 2:
+        raise ValueError(
+            f"month は (year, month) の 2 要素である必要があります: {month!r}"
+        )
+    year, mon = month
+    for v in (year, mon):
+        if isinstance(v, bool) or not isinstance(v, int):
+            raise TypeError(f"month の要素は整数である必要があります: {month!r}")
+    if not 1 <= mon <= 12:
+        raise ValueError(f"month の月は 1〜12 である必要があります: {mon}")
+    return year, mon
+
+
+def _totals(
+    expenses: list[Expense], ym: tuple[int, int]
+) -> tuple[dict[str, int], set[str]]:
+    """Net totals per category for one month, and the categories that have any row."""
+    totals: dict[str, int] = {}
+    seen: set[str] = set()
+    for e in expenses:
+        if (e.day.year, e.day.month) == ym:
+            totals[e.category] = totals.get(e.category, 0) + e.amount
+            seen.add(e.category)
+    return totals, seen
+
+
+def compare_months(
+    expenses: list[Expense], month: tuple[int, int]
+) -> list[CategoryDiff]:
+    year, mon = _check_month(month)
+    prev_ym = (year - 1, 12) if mon == 1 else (year, mon - 1)
+    prev_totals, prev_seen = _totals(expenses, prev_ym)
+    cur_totals, cur_seen = _totals(expenses, (year, mon))
+
+    diffs: list[CategoryDiff] = []
+    for cat in prev_seen | cur_seen:
+        previous = prev_totals.get(cat, 0)
+        current = cur_totals.get(cat, 0)
+        if previous == 0 and current == 0:
+            continue
+        delta = current - previous
+        ratio = None if previous <= 0 else delta / previous
+        if cat in cur_seen and cat not in prev_seen:
+            status = "新規"
+        elif cat in prev_seen and cat not in cur_seen:
+            status = "なくなった"
+        elif delta > 0:
+            status = "増加"
+        elif delta < 0:
+            status = "減少"
+        else:
+            status = "変化なし"
+        diffs.append(CategoryDiff(cat, previous, current, delta, ratio, status))
+
+    diffs.sort(key=lambda d: (-abs(d.delta), d.category))
+    return diffs
+
+
+def render_report(diffs: list[CategoryDiff]) -> str:
+    if not diffs:
+        return "データなし"
+    lines: list[str] = []
+    for d in diffs:
+        pct = "(-)" if d.ratio is None else f"({d.ratio * 100:+.1f}%)"
+        lines.append(f"{d.category}  {d.previous:,}→{d.current:,}  {d.delta:+,} {pct}")
+    return "\n".join(lines)
