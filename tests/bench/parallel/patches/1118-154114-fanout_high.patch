@@ -0,0 +1,257 @@
+import dataclasses
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def _e(day, category="rent", amount=80000, memo=""):
+    return Expense(day, category, amount, memo)
+
+
+# --- add_month -------------------------------------------------------------
+
+
+def test_add_month_plain():
+    assert add_month(date(2026, 11, 15)) == date(2026, 12, 15)
+
+
+def test_add_month_year_wrap():
+    assert add_month(date(2026, 12, 15)) == date(2027, 1, 15)
+
+
+def test_add_month_clamps_to_end_of_short_month():
+    assert add_month(date(2026, 1, 31)) == date(2026, 2, 28)
+
+
+def test_add_month_clamps_to_leap_february():
+    assert add_month(date(2024, 1, 31)) == date(2024, 2, 29)
+
+
+def test_add_month_clamps_30_day_month():
+    assert add_month(date(2026, 3, 31)) == date(2026, 4, 30)
+
+
+def test_add_month_year_wrap_without_clamp():
+    assert add_month(date(2027, 12, 31)) == date(2028, 1, 31)
+
+
+# --- find_recurring: basic detection ----------------------------------------
+
+
+def test_monthly_expense_detected_with_next_expected():
+    rows = [
+        _e(date(2026, 1, 15), memo="家賃 1月"),
+        _e(date(2026, 2, 15), memo="家賃 2月"),
+        _e(date(2026, 3, 15)),
+    ]
+    assert find_recurring(rows) == [
+        Recurring(
+            "rent",
+            80000,
+            (date(2026, 1, 15), date(2026, 2, 15), date(2026, 3, 15)),
+            date(2026, 4, 15),
+        )
+    ]
+
+
+def test_below_min_count_not_reported_unless_lowered():
+    rows = [_e(date(2026, 1, 15)), _e(date(2026, 2, 15))]
+    assert find_recurring(rows) == []
+    assert find_recurring(rows, min_count=2) == [
+        Recurring(
+            "rent",
+            80000,
+            (date(2026, 1, 15), date(2026, 2, 15)),
+            date(2026, 3, 15),
+        )
+    ]
+
+
+def test_same_day_duplicates_count_once():
+    rows = [
+        _e(date(2026, 1, 15)),
+        _e(date(2026, 1, 15), memo="二重"),
+        _e(date(2026, 2, 15)),
+    ]
+    assert find_recurring(rows) == []
+    assert find_recurring(rows, min_count=2) == [
+        Recurring(
+            "rent",
+            80000,
+            (date(2026, 1, 15), date(2026, 2, 15)),
+            date(2026, 3, 15),
+        )
+    ]
+
+
+def test_tolerance_boundary_late_side():
+    # add_month(2026-01-15) = 2026-02-15, so 2026-02-18 is 3 days late.
+    rows = [_e(date(2026, 1, 15)), _e(date(2026, 2, 18)), _e(date(2026, 3, 18))]
+    assert len(find_recurring(rows)) == 1
+    assert find_recurring(rows, tolerance=2) == []
+
+
+def test_tolerance_boundary_early_side():
+    # add_month(2026-01-15) = 2026-02-15, so 2026-02-12 is 3 days early.
+    rows = [_e(date(2026, 1, 15)), _e(date(2026, 2, 12)), _e(date(2026, 3, 12))]
+    assert len(find_recurring(rows)) == 1
+    assert find_recurring(rows, tolerance=2) == []
+
+
+def test_zero_tolerance_requires_exact_day():
+    rows = [_e(date(2026, 1, 15)), _e(date(2026, 2, 16)), _e(date(2026, 3, 16))]
+    assert find_recurring(rows, tolerance=0) == []
+    assert find_recurring(rows, tolerance=1) != []
+
+
+def test_gap_splits_into_separate_runs():
+    rows = [
+        _e(date(2026, 1, 15)),
+        _e(date(2026, 2, 15)),
+        _e(date(2026, 3, 15)),
+        _e(date(2026, 5, 15)),
+        _e(date(2026, 6, 15)),
+        _e(date(2026, 7, 15)),
+    ]
+    assert find_recurring(rows) == [
+        Recurring(
+            "rent",
+            80000,
+            (date(2026, 1, 15), date(2026, 2, 15), date(2026, 3, 15)),
+            date(2026, 4, 15),
+        ),
+        Recurring(
+            "rent",
+            80000,
+            (date(2026, 5, 15), date(2026, 6, 15), date(2026, 7, 15)),
+            date(2026, 8, 15),
+        ),
+    ]
+
+
+def test_short_run_between_gaps_is_dropped():
+    rows = [
+        _e(date(2026, 1, 15)),
+        _e(date(2026, 2, 15)),
+        _e(date(2026, 3, 15)),
+        _e(date(2026, 5, 15)),  # isolated: run of length 1
+        _e(date(2026, 7, 15)),
+        _e(date(2026, 8, 15)),
+        _e(date(2026, 9, 15)),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 15), date(2026, 7, 15)]
+
+
+def test_month_end_drift_uses_tolerance():
+    # 2026-02-28 -> 2026-03-31 is 3 days after add_month(02-28) = 03-28.
+    rows = [
+        _e(date(2026, 1, 31)),
+        _e(date(2026, 2, 28)),
+        _e(date(2026, 3, 31)),
+        _e(date(2026, 4, 30)),
+    ]
+    assert find_recurring(rows, min_count=4) == [
+        Recurring(
+            "rent",
+            80000,
+            (
+                date(2026, 1, 31),
+                date(2026, 2, 28),
+                date(2026, 3, 31),
+                date(2026, 4, 30),
+            ),
+            date(2026, 5, 30),
+        )
+    ]
+    assert find_recurring(rows, min_count=4, tolerance=2) == []
+
+
+# --- find_recurring: grouping and ordering -----------------------------------
+
+
+def test_groups_by_category_and_amount_ignoring_memo():
+    rows = []
+    for m in (1, 2, 3):
+        d = date(2026, m, 15)
+        rows.append(_e(d, "rent", 80000, memo=f"家賃{m}"))
+        rows.append(_e(d, "rent", 80001))
+        rows.append(_e(d, "food", 80000, memo="x"))
+    assert [(r.category, r.amount) for r in find_recurring(rows)] == [
+        ("food", 80000),
+        ("rent", 80000),
+        ("rent", 80001),
+    ]
+
+
+def test_output_sorted_by_category_amount_then_first_day():
+    rows = [
+        # shuffled on purpose
+        _e(date(2026, 9, 15), "rent", 80000),
+        _e(date(2026, 1, 20), "rent", 50000),
+        _e(date(2026, 3, 5), "food", 100),
+        _e(date(2026, 7, 15), "rent", 80000),
+        _e(date(2026, 2, 20), "rent", 50000),
+        _e(date(2026, 1, 5), "food", 100),
+        _e(date(2026, 8, 15), "rent", 80000),
+        _e(date(2026, 3, 20), "rent", 50000),
+        _e(date(2026, 1, 15), "rent", 80000),
+        _e(date(2026, 2, 5), "food", 100),
+        _e(date(2026, 2, 15), "rent", 80000),
+        _e(date(2026, 3, 15), "rent", 80000),
+    ]
+    result = find_recurring(rows)
+    assert [(r.category, r.amount, r.days[0]) for r in result] == [
+        ("food", 100, date(2026, 1, 5)),
+        ("rent", 50000, date(2026, 1, 20)),
+        ("rent", 80000, date(2026, 1, 15)),
+        ("rent", 80000, date(2026, 7, 15)),
+    ]
+    assert [r.next_expected for r in result] == [
+        date(2026, 4, 5),
+        date(2026, 4, 20),
+        date(2026, 4, 15),
+        date(2026, 10, 15),
+    ]
+
+
+# --- find_recurring: empty / invalid input ------------------------------------
+
+
+def test_empty_input_returns_empty_list():
+    assert find_recurring([]) == []
+
+
+def test_no_match_returns_empty_list():
+    rows = [_e(date(2026, 1, 1)), _e(date(2026, 4, 9)), _e(date(2026, 9, 30))]
+    assert find_recurring(rows) == []
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [{"min_count": 1}, {"min_count": 0}, {"min_count": -3}, {"tolerance": -1}],
+)
+def test_rejects_invalid_parameters(kwargs):
+    with pytest.raises(ValueError):
+        find_recurring([], **kwargs)
+
+
+# --- Recurring shape ------------------------------------------------------------
+
+
+def test_recurring_fields_and_frozen():
+    assert [f.name for f in dataclasses.fields(Recurring)] == [
+        "category",
+        "amount",
+        "days",
+        "next_expected",
+    ]
+    r = find_recurring(
+        [_e(date(2026, 1, 15)), _e(date(2026, 2, 15)), _e(date(2026, 3, 15))]
+    )[0]
+    assert isinstance(r.days, tuple)
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        r.amount = 1  # type: ignore[misc]
