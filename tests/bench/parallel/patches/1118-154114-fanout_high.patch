index 0000000..7ebccd9
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,96 @@
+"""Import bank statement CSVs (other-line format) into Expense records."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+# 任意の "-" → 任意の "¥"/"￥" → ASCII 数字で始まる数字とカンマの列 → 任意の "円"
+_AMOUNT_RE = re.compile(r"(-?)[¥￥]?([0-9][0-9,]*)円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    """Parse a bank amount such as "￥1,234" or "-300円" into yen."""
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    value = int(m.group(2).replace(",", ""))
+    return -value if m.group(1) else value
+
+
+def parse_date(s: str) -> date:
+    """Parse "YYYY/M/D" or "YYYY-M-D" (separator must not be mixed)."""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+
+
+def _cell(row: list[str], index: int) -> str:
+    return row[index] if index < len(row) else ""
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Read a CSV whose first line is a header.
+
+    Returns (valid expenses in input order, errors as (physical line, field)).
+    Rows with any error are left out of the expenses.
+    """
+    columns = DEFAULT_MAPPING if mapping is None else mapping
+    for key in ("date", "category", "amount"):
+        if key not in columns:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text))
+    header: list[str] = next(reader, [])
+    missing = [name for name in columns.values() if name not in header]
+    if missing:
+        raise ValueError(f"ヘッダーに列がありません: {', '.join(missing)}")
+    index = {field: header.index(name) for field, name in columns.items()}
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    prev_line = reader.line_num
+    for row in reader:
+        line = prev_line + 1
+        prev_line = reader.line_num
+        if row == [] or (len(row) == 1 and row[0].strip() == ""):
+            continue  # blank line: skipped, but still counted in line numbers
+
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(_cell(row, index["date"]))
+        except ValueError:
+            errors.append((line, "date"))
+        try:
+            amount = parse_amount(_cell(row, index["amount"]))
+        except ValueError:
+            errors.append((line, "amount"))
+        category = _cell(row, index["category"]).strip()
+        if not category:
+            errors.append((line, "category"))
+        if day is None or amount is None or not category:
+            continue
+
+        if category_map is not None:
+            category = category_map.get(category, category)
+        memo = _cell(row, index["memo"]).strip() if "memo" in index else ""
+        expenses.append(Expense(day=day, category=category, amount=amount, memo=memo))
+    return expenses, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
