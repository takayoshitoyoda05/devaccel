index 0000000..4f9f88f
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,218 @@
+from __future__ import annotations
+
+from dataclasses import FrozenInstanceError
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def e(day: str, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(date.fromisoformat(day), category, amount, memo)
+
+
+ROWS = [
+    e("2026-01-05", "food", 1000),
+    e("2026-01-20", "food", 500),
+    e("2026-01-10", "rent", 5000),
+    e("2026-01-11", "fun", 300),
+    e("2026-02-03", "food", 1200),
+    e("2026-02-09", "rent", 5000),
+    e("2026-02-12", "travel", 800),
+    e("2026-03-01", "food", 99),
+]
+
+
+def test_diffrow_fields_and_frozen() -> None:
+    row = DiffRow("food", 1, 2, 1, 100.0, "up")
+    assert (row.category, row.prev, row.curr, row.delta, row.pct, row.status) == (
+        "food",
+        1,
+        2,
+        1,
+        100.0,
+        "up",
+    )
+    with pytest.raises(FrozenInstanceError):
+        row.prev = 5  # type: ignore[misc]
+
+
+def test_month_diff_statuses_and_values() -> None:
+    rows = month_diff(ROWS, "2026-01", "2026-02")
+    by_cat = {r.category: r for r in rows}
+    assert by_cat["food"] == DiffRow("food", 1500, 1200, -300, -20.0, "down")
+    assert by_cat["rent"] == DiffRow("rent", 5000, 5000, 0, 0.0, "same")
+    assert by_cat["fun"] == DiffRow("fun", 300, 0, -300, -100.0, "gone")
+    assert by_cat["travel"] == DiffRow("travel", 0, 800, 800, None, "new")
+    # 2026-03 のみの明細は対象外、明細のないカテゴリも含まない
+    assert "fun" in by_cat and len(rows) == 4
+
+
+def test_month_diff_up_status() -> None:
+    rows = [e("2026-01-01", "a", 100), e("2026-02-01", "a", 150)]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    assert r == DiffRow("a", 100, 150, 50, 50.0, "up")
+
+
+def test_month_diff_status_by_presence_not_sum() -> None:
+    # prev の合計は 0 だが明細はある -> new にはならず、delta(=0) で same
+    rows = [
+        e("2026-01-01", "a", 100),
+        e("2026-01-02", "a", -100),
+        e("2026-02-01", "a", 0),
+    ]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    assert r == DiffRow("a", 0, 0, 0, None, "same")
+
+
+def test_month_diff_zero_total_in_curr_is_gone_only_without_items() -> None:
+    rows = [e("2026-01-01", "a", 100), e("2026-02-01", "a", -100)]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    # curr は明細あり(合計 -100) -> presence で gone にはならない
+    assert r == DiffRow("a", 100, -100, -200, -200.0, "down")
+
+
+def test_month_diff_new_with_zero_prev_total_pct_none() -> None:
+    rows = [e("2026-02-01", "a", 0)]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    assert r == DiffRow("a", 0, 0, 0, None, "new")
+
+
+def test_month_diff_pct_rounded_to_one_decimal() -> None:
+    rows = [e("2026-01-01", "a", 3), e("2026-02-01", "a", 4)]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    assert r.pct == round(1 / 3 * 100, 1) == 33.3
+
+
+def test_month_diff_same_month_twice() -> None:
+    rows = [e("2026-01-01", "a", 10)]
+    (r,) = month_diff(rows, "2026-01", "2026-01")
+    assert r == DiffRow("a", 10, 10, 0, 0.0, "same")
+
+
+def test_month_diff_empty_rows() -> None:
+    assert month_diff([], "2026-01", "2026-02") == []
+
+
+def test_month_diff_sort_order() -> None:
+    rows = [
+        e("2026-01-01", "b", 100),
+        e("2026-01-01", "a", 100),
+        e("2026-02-01", "c", 1000),  # delta +1000
+        e("2026-02-01", "b", 0),  # delta -100 (abs 100)
+        e("2026-02-01", "a", 0),  # delta -100 (abs 100)
+    ]
+    cats = [r.category for r in month_diff(rows, "2026-01", "2026-02")]
+    assert cats == ["c", "a", "b"]
+
+
+@pytest.mark.parametrize(
+    "prev,curr",
+    [
+        ("2026-1", "2026-02"),
+        ("2026-02", "2026-13"),
+        ("2026-00", "2026-02"),
+        ("202601", "2026-02"),
+        ("2026/01", "2026-02"),
+        ("2026-01", "2026-1"),
+        ("2026-01", "26-01"),
+        ("2026-01", ""),
+        ("2026-01 ", "2026-02"),
+    ],
+)
+def test_month_diff_invalid_month_raises(prev: str, curr: str) -> None:
+    with pytest.raises(ValueError):
+        month_diff(ROWS, prev, curr)
+
+
+def test_top_movers_excludes_same_and_keeps_order() -> None:
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    movers = top_movers(diffs, 10)
+    assert [r.category for r in movers] == ["travel", "food", "fun"]
+    assert all(r.status != "same" for r in movers)
+
+
+def test_top_movers_takes_first_n() -> None:
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    assert [r.category for r in top_movers(diffs)] == ["travel", "food", "fun"]
+    assert [r.category for r in top_movers(diffs, 1)] == ["travel"]
+
+
+def test_top_movers_zero_and_default() -> None:
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    assert top_movers(diffs, 0) == []
+    assert top_movers([], 3) == []
+
+
+def test_top_movers_negative_n_raises() -> None:
+    with pytest.raises(ValueError):
+        top_movers([], -1)
+
+
+def test_render_diff_format() -> None:
+    diffs = [
+        DiffRow("food", 1500, 1200, -300, -20.0, "down"),
+        DiffRow("rent", 5000, 5000, 0, 0.0, "same"),
+        DiffRow("travel", 0, 800, 800, None, "new"),
+        DiffRow("fun", 300, 0, -300, -100.0, "gone"),
+        DiffRow("up", 100, 120, 20, 20.0, "up"),
+    ]
+    text = render_diff(diffs)
+    assert text.split("\n") == [
+        "category\tprev\tcurr\tdelta\tpct",
+        "food\t1500\t1200\t-300\t-20.0%",
+        "rent\t5000\t5000\t+0\t+0.0%",
+        "travel\t0\t800\t+800\t-",
+        "fun\t300\t0\t-300\t-100.0%",
+        "up\t100\t120\t+20\t+20.0%",
+    ]
+    assert not text.endswith("\n")
+
+
+def test_render_diff_empty_is_header_only() -> None:
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_render_diff_negative_zero_pct_is_plus_zero() -> None:
+    # prev が負の 0 除算でない場合でも -0.0 にならないこと
+    diffs = [DiffRow("a", -5, -5, 0, -0.0, "same")]
+    assert render_diff(diffs).splitlines()[1] == "a\t-5\t-5\t+0\t+0.0%"
+
+
+def test_available_months_sorted_unique() -> None:
+    assert available_months(ROWS) == ["2026-01", "2026-02", "2026-03"]
+    assert available_months([]) == []
+    rows = [e("2025-12-31", "a", 1), e("2026-01-01", "a", 1), e("2025-12-01", "a", 1)]
+    assert available_months(rows) == ["2025-12", "2026-01"]
+
+
+def test_latest_diff_uses_last_two_months() -> None:
+    rows = ROWS
+    assert latest_diff(rows) == month_diff(rows, "2026-02", "2026-03")
+
+
+def test_latest_diff_two_months() -> None:
+    rows = [e("2026-01-01", "a", 1), e("2026-02-01", "a", 2)]
+    assert latest_diff(rows) == [DiffRow("a", 1, 2, 1, 100.0, "up")]
+
+
+@pytest.mark.parametrize(
+    "rows",
+    [
+        [],
+        [e("2026-01-01", "a", 1)],
+        [e("2026-01-01", "a", 1), e("2026-01-15", "b", 2)],
+    ],
+)
+def test_latest_diff_fewer_than_two_months_raises(rows: list[Expense]) -> None:
+    with pytest.raises(ValueError):
+        latest_diff(rows)
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..61a0acf
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,295 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+D = date(2026, 11, 1)
+LUNCH = Expense(D, "food", 1200, "lunch")
+RENT = Expense(D, "rent", 80000, "")
+COFFEE = Expense(D, "food", 800, "coffee")
+FOOD_IN_MEMO = Expense(D, "rent", 100, "food")
+ROWS = [LUNCH, RENT, COFFEE, FOOD_IN_MEMO]
+
+
+# --- tokenize ---
+
+
+def test_tokenize_empty_is_empty_list():
+    assert tokenize("") == []
+
+
+def test_tokenize_whitespace_only_is_empty_list():
+    assert tokenize(" \t  ") == []
+
+
+def test_tokenize_splits_on_any_whitespace():
+    assert tokenize(" a\tb \n c ") == [("TERM", "a"), ("TERM", "b"), ("TERM", "c")]
+
+
+def test_tokenize_parens():
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+
+
+def test_tokenize_parens_split_words_without_spaces():
+    assert tokenize("a(b)") == [
+        ("TERM", "a"),
+        ("LPAREN", "("),
+        ("TERM", "b"),
+        ("RPAREN", ")"),
+    ]
+
+
+def test_tokenize_quoted_keeps_spaces_and_parens():
+    assert tokenize('"lunch with (friends)"') == [("TERM", "lunch with (friends)")]
+
+
+def test_tokenize_quoted_has_no_escape():
+    # the quote closes at the first '"', backslash is kept literally
+    assert tokenize(r'"a\" b') == [("TERM", "a\\"), ("TERM", "b")]
+
+
+def test_tokenize_quoted_keyword_is_term():
+    assert tokenize('"AND"') == [("TERM", "AND")]
+
+
+def test_tokenize_quoted_cat_prefix_is_term():
+    assert tokenize('"cat:food"') == [("TERM", "cat:food")]
+
+
+def test_tokenize_unclosed_quote_raises():
+    with pytest.raises(QueryError):
+        tokenize('"lunch')
+
+
+def test_tokenize_empty_quote_raises():
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_uppercase_keywords():
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+
+
+def test_tokenize_lowercase_keywords_are_terms():
+    assert tokenize("and or not") == [
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_cat_prefix():
+    assert tokenize("cat:food") == [("CAT", "food")]
+
+
+def test_tokenize_cat_empty_value_raises():
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_tokenize_cat_prefix_is_case_sensitive():
+    assert tokenize("CAT:food") == [("TERM", "CAT:food")]
+
+
+# --- matches: term and cat ---
+
+
+def test_term_matches_memo_substring():
+    assert matches("lun", LUNCH)
+
+
+def test_term_matches_category_substring():
+    assert matches("foo", LUNCH)
+
+
+def test_term_no_match():
+    assert not matches("zzz", LUNCH)
+
+
+def test_term_empty_memo_matches_category_only():
+    assert matches("ren", RENT)
+    assert not matches("lunch", RENT)
+
+
+def test_term_is_case_insensitive():
+    assert matches("LUNCH", LUNCH)
+    assert matches("FoOd", LUNCH)
+
+
+def test_term_casefold_handles_sharp_s():
+    e = Expense(D, "x", 1, "STRASSE")
+    assert matches("straße", e)
+
+
+def test_cat_exact_match_on_category():
+    assert matches("cat:food", LUNCH)
+
+
+def test_cat_is_not_substring():
+    assert not matches("cat:foo", LUNCH)
+
+
+def test_cat_does_not_match_memo():
+    assert not matches("cat:food", FOOD_IN_MEMO)
+
+
+def test_cat_is_case_insensitive():
+    assert matches("cat:FOOD", LUNCH)
+
+
+def test_quoted_term_with_space_matches_memo():
+    assert matches('"lunch"', LUNCH)
+    assert not matches('"lunch time"', LUNCH)
+
+
+# --- matches: operators ---
+
+
+def test_implicit_and_requires_both():
+    assert matches("food lunch", LUNCH)
+    assert not matches("food coffee", LUNCH)
+
+
+def test_explicit_and_same_as_implicit():
+    assert matches("food AND lunch", LUNCH)
+    assert not matches("food AND coffee", LUNCH)
+
+
+def test_or():
+    assert matches("coffee OR lunch", LUNCH)
+    assert not matches("coffee OR rent", LUNCH)
+
+
+def test_and_binds_tighter_than_or():
+    # a OR (b AND c)
+    assert matches("lunch OR zzz AND yyy", LUNCH)
+    # (a OR b) AND c would be False here
+    assert not matches("zzz OR lunch AND yyy", LUNCH)
+
+
+def test_not():
+    assert matches("NOT coffee", LUNCH)
+    assert not matches("NOT lunch", LUNCH)
+
+
+def test_not_binds_tighter_than_and():
+    # (NOT coffee) AND food
+    assert matches("NOT coffee food", LUNCH)
+    assert not matches("NOT lunch food", LUNCH)
+
+
+def test_double_not():
+    assert matches("NOT NOT lunch", LUNCH)
+    assert not matches("NOT NOT coffee", LUNCH)
+
+
+def test_not_then_implicit_and():
+    assert matches("food NOT coffee", LUNCH)
+    assert not matches("food NOT lunch", LUNCH)
+
+
+def test_parens_override_precedence():
+    # (zzz OR lunch) AND food
+    assert matches("(zzz OR lunch) food", LUNCH)
+    assert not matches("(zzz OR lunch) rent", LUNCH)
+
+
+def test_not_with_parens():
+    assert not matches("NOT (lunch OR coffee)", LUNCH)
+    assert matches("NOT (coffee OR rent)", LUNCH)
+
+
+def test_nested_parens():
+    assert matches("((lunch))", LUNCH)
+
+
+def test_mixed_and_or_chain():
+    assert matches("rent AND zzz OR food AND lunch", LUNCH)
+    assert not matches("rent AND zzz OR food AND coffee", LUNCH)
+
+
+def test_cat_with_not():
+    assert matches("NOT cat:rent", LUNCH)
+    assert not matches("NOT cat:food", LUNCH)
+
+
+def test_lowercase_and_is_term_not_operator():
+    e = Expense(D, "food", 1, "and")
+    assert matches("food and", e)
+    assert not matches("food and", LUNCH)
+
+
+# --- grammar errors ---
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "(",
+        ")",
+        "()",
+        "a (",
+        "a )",
+        "(a))",
+        "AND",
+        "OR",
+        "NOT",
+        "a AND",
+        "a OR",
+        "OR a",
+        "a OR OR b",
+        "a AND AND b",
+        "a NOT",
+        "a ()",
+        "NOT )",
+        "cat:",
+        '"abc',
+        '""',
+    ],
+)
+def test_invalid_query_raises(q):
+    with pytest.raises(QueryError):
+        matches(q, LUNCH)
+
+
+# --- filter_rows ---
+
+
+def test_filter_rows_keeps_input_order():
+    assert filter_rows("food", ROWS) == [LUNCH, COFFEE, FOOD_IN_MEMO]
+
+
+def test_filter_rows_no_match_is_empty():
+    assert filter_rows("zzz", ROWS) == []
+
+
+def test_filter_rows_empty_input_valid_query():
+    assert filter_rows("food", []) == []
+
+
+def test_filter_rows_empty_input_invalid_query_raises():
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
+
+
+def test_filter_rows_invalid_query_raises_with_rows():
+    with pytest.raises(QueryError):
+        filter_rows("a OR", ROWS)
+
+
+def test_filter_rows_does_not_mutate_input():
+    rows = list(ROWS)
+    filter_rows("food", rows)
+    assert rows == ROWS
+
+
+def test_filter_rows_or():
+    assert filter_rows("cat:rent OR coffee", ROWS) == [RENT, COFFEE, FOOD_IN_MEMO]
+
+
+def test_filter_rows_not():
+    assert filter_rows("NOT cat:rent", ROWS) == [LUNCH, COFFEE]
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..2d53ec2
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,254 @@
+from __future__ import annotations
+
+from dataclasses import FrozenInstanceError
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def ex(
+    y: int, m: int, d: int, cat: str = "家賃", amount: int = 80000, memo: str = ""
+) -> Expense:
+    return Expense(day=date(y, m, d), category=cat, amount=amount, memo=memo)
+
+
+# --- add_month -------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("src", "expected"),
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),  # 非うるう年の末日へ丸める
+        (date(2024, 1, 31), date(2024, 2, 29)),  # うるう年の末日へ丸める
+        (date(2026, 12, 15), date(2027, 1, 15)),  # 年またぎ
+        (date(2026, 12, 31), date(2027, 1, 31)),  # 年またぎ + 末日
+        (date(2026, 3, 31), date(2026, 4, 30)),  # 30 日の月へ丸める
+        (date(2025, 2, 28), date(2025, 3, 28)),  # 2 月末から通常日
+        (date(2024, 2, 29), date(2024, 3, 29)),  # うるう日から通常日
+    ],
+)
+def test_add_month(src: date, expected: date) -> None:
+    assert add_month(src) == expected
+
+
+# --- argument validation ---------------------------------------------------
+
+
+def test_min_count_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+
+
+def test_negative_tolerance_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_zero_tolerance_is_allowed() -> None:
+    rows = [ex(2026, 1, 10), ex(2026, 2, 10), ex(2026, 3, 10)]
+    assert len(find_recurring(rows, tolerance=0)) == 1
+
+
+# --- basic detection -------------------------------------------------------
+
+
+def test_empty_input_returns_empty() -> None:
+    assert find_recurring([]) == []
+
+
+def test_monthly_series_is_detected() -> None:
+    rows = [ex(2026, 1, 10), ex(2026, 2, 10), ex(2026, 3, 10)]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="家賃",
+            amount=80000,
+            days=(date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10)),
+            next_expected=date(2026, 4, 10),
+        )
+    ]
+
+
+def test_days_is_a_tuple() -> None:
+    rows = [ex(2026, 1, 10), ex(2026, 2, 10), ex(2026, 3, 10)]
+    assert isinstance(find_recurring(rows)[0].days, tuple)
+
+
+def test_fewer_than_min_count_is_not_reported() -> None:
+    rows = [ex(2026, 1, 10), ex(2026, 2, 10)]
+    assert find_recurring(rows, min_count=3) == []
+
+
+def test_exactly_min_count_is_reported() -> None:
+    rows = [ex(2026, 1, 10), ex(2026, 2, 10)]
+    result = find_recurring(rows, min_count=2)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 10))
+
+
+def test_memo_is_ignored_for_grouping() -> None:
+    rows = [
+        ex(2026, 1, 10, memo="a"),
+        ex(2026, 2, 10, memo="b"),
+        ex(2026, 3, 10, memo=""),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_different_amounts_are_separate_groups() -> None:
+    rows = [
+        ex(2026, 1, 10, amount=1000),
+        ex(2026, 2, 10, amount=1000),
+        ex(2026, 3, 10, amount=2000),
+        ex(2026, 4, 10, amount=2000),
+    ]
+    # 各グループは 2 件ずつ。min_count=3 では該当なし。
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_count=2)) == 2
+
+
+def test_different_categories_are_separate_groups() -> None:
+    rows = [
+        ex(2026, 1, 10, cat="食費", amount=500),
+        ex(2026, 2, 10, cat="家賃", amount=500),
+        ex(2026, 3, 10, cat="食費", amount=500),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_duplicate_dates_are_counted_once() -> None:
+    rows = [
+        ex(2026, 1, 10),
+        ex(2026, 1, 10, memo="重複"),
+        ex(2026, 2, 10),
+    ]
+    # 日付は 2 種類だけなので min_count=3 では該当なし。
+    assert find_recurring(rows) == []
+    result = find_recurring(rows, min_count=2)
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 10))
+
+
+def test_input_order_does_not_matter() -> None:
+    rows = [ex(2026, 3, 10), ex(2026, 1, 10), ex(2026, 2, 10)]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10))
+
+
+# --- tolerance -------------------------------------------------------------
+
+
+def test_drift_within_tolerance_is_linked() -> None:
+    # 2/10 の期待日 → 2/12 は +2 日。tolerance=3 なので連続扱い。
+    rows = [ex(2026, 1, 10), ex(2026, 2, 12), ex(2026, 3, 10)]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_drift_exactly_at_tolerance_is_linked_early_side() -> None:
+    # 2/10 の期待日 → 2/7 は -3 日。境界値なので連続扱い。
+    rows = [ex(2026, 1, 10), ex(2026, 2, 7), ex(2026, 3, 10)]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 7), date(2026, 3, 10))
+
+
+def test_drift_beyond_tolerance_breaks_series() -> None:
+    # 2/10 → 2/14 は +4 日。tolerance=3 では切れる。
+    rows = [ex(2026, 1, 10), ex(2026, 2, 14), ex(2026, 3, 14), ex(2026, 4, 14)]
+    result = find_recurring(rows)
+    # 切れた後の 2/14, 3/14, 4/14 は 3 件なので 1 件だけ残る。
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 2, 14), date(2026, 3, 14), date(2026, 4, 14))
+
+
+def test_tolerance_parameter_is_respected() -> None:
+    rows = [ex(2026, 1, 10), ex(2026, 2, 14), ex(2026, 3, 14)]
+    assert find_recurring(rows, tolerance=3) == []
+    assert len(find_recurring(rows, tolerance=4)) == 1
+
+
+def test_link_uses_previous_date_not_previous_expected() -> None:
+    # 1/31 → 期待 2/28。2/28 → 期待 3/28。連鎖して 3 件とも連続扱い。
+    rows = [ex(2026, 1, 31), ex(2026, 2, 28), ex(2026, 3, 28)]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 28)
+
+
+# --- splitting into runs ---------------------------------------------------
+
+
+def test_gap_splits_into_two_series() -> None:
+    rows = [
+        ex(2026, 1, 10),
+        ex(2026, 2, 10),
+        ex(2026, 3, 10),
+        # 4 月・5 月なし
+        ex(2026, 6, 10),
+        ex(2026, 7, 10),
+        ex(2026, 8, 10),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 10), date(2026, 6, 10)]
+    assert result[0].next_expected == date(2026, 4, 10)
+    assert result[1].next_expected == date(2026, 9, 10)
+
+
+def test_short_run_is_dropped_while_other_run_kept() -> None:
+    rows = [
+        ex(2026, 1, 10),
+        ex(2026, 2, 10),  # 2 件だけの区間
+        ex(2026, 6, 10),
+        ex(2026, 7, 10),
+        ex(2026, 8, 10),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days[0] == date(2026, 6, 10)
+
+
+def test_next_expected_at_month_end_clamps() -> None:
+    rows = [ex(2025, 11, 30), ex(2025, 12, 30), ex(2026, 1, 30)]
+    result = find_recurring(rows)
+    assert result[0].next_expected == date(2026, 2, 28)
+
