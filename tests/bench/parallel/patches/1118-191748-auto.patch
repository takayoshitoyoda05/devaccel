+def test_recurring_is_frozen() -> None:
+    r = Recurring("家賃", 1, (date(2026, 1, 1),), date(2026, 2, 1))
+    with pytest.raises(FrozenInstanceError):
+        r.amount = 2  # type: ignore[misc]
