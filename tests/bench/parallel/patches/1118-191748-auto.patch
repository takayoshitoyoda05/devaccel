+# --- ordering --------------------------------------------------------------
+
+
+def test_results_sorted_by_category_amount_then_first_day() -> None:
+    rows = [
+        # 家賃 / 80000 (2 系列: 1 月開始と 6 月開始)
+        ex(2026, 1, 10, cat="家賃", amount=80000),
+        ex(2026, 2, 10, cat="家賃", amount=80000),
+        ex(2026, 3, 10, cat="家賃", amount=80000),
+        ex(2026, 6, 10, cat="家賃", amount=80000),
+        ex(2026, 7, 10, cat="家賃", amount=80000),
+        ex(2026, 8, 10, cat="家賃", amount=80000),
+        # 家賃 / 1000
+        ex(2026, 1, 5, cat="家賃", amount=1000),
+        ex(2026, 2, 5, cat="家賃", amount=1000),
+        ex(2026, 3, 5, cat="家賃", amount=1000),
+        # 通信 / 5000
+        ex(2026, 1, 1, cat="通信", amount=5000),
+        ex(2026, 2, 1, cat="通信", amount=5000),
+        ex(2026, 3, 1, cat="通信", amount=5000),
+    ]
+    result = find_recurring(rows)
+    keys = [(r.category, r.amount, r.days[0]) for r in result]
+    assert keys == [
+        ("家賃", 1000, date(2026, 1, 5)),
+        ("家賃", 80000, date(2026, 1, 10)),
+        ("家賃", 80000, date(2026, 6, 10)),
+        ("通信", 5000, date(2026, 1, 1)),
+    ]
+
