index 0000000..4268bda
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,114 @@
+"""Import bank-statement CSV text into Expense records (pure functions)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+# 任意の "-"、任意の "¥"/"￥"、ASCII 数字で始まる数字とカンマの列、任意の "円"
+_AMOUNT_RE = re.compile(r"(-?)[¥￥]?([0-9][0-9,]*)円?")
+# YYYY/M/D または YYYY-M-D(区切りは同じものを使う)
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    sign, digits = m.group(1), m.group(2)
+    value = int(digits.replace(",", ""))
+    return -value if sign else value
+
+
+def parse_date(s: str) -> date:
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    # date() は存在しない日付(2026/02/30 など)で ValueError を出す
+    return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Parse CSV text (header on line 1) into expenses and per-field errors.
+
+    Returns (valid expenses in input order, [(physical line number, field)]).
+    Rows with any error are excluded from the expenses.
+    """
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    records: list[tuple[int, list[str]]] = []
+    consumed = 0
+    for row in reader:
+        start = consumed + 1
+        consumed = reader.line_num
+        records.append((start, row))
+    if not records:
+        raise ValueError("ヘッダー行がありません")
+
+    header = records[0][1]
+    index: dict[str, int] = {}
+    for field, column in mapping.items():
+        if column not in header:
+            raise ValueError(f"列 {column!r} がヘッダーにありません")
+        index[field] = header.index(column)
+
+    def cell(row: list[str], field: str) -> str:
+        if field not in index:
+            return ""
+        i = index[field]
+        return row[i] if i < len(row) else ""
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    for line, row in records[1:]:
+        if row == []:  # 空行は読み飛ばす(行番号は数える)
+            continue
+        row_errors: list[tuple[int, str]] = []
+        day = None
+        amount = None
+        try:
+            day = parse_date(cell(row, "date"))
+        except ValueError:
+            row_errors.append((line, "date"))
+        try:
+            amount = parse_amount(cell(row, "amount"))
+        except ValueError:
+            row_errors.append((line, "amount"))
+        category = cell(row, "category").strip()
+        if category == "":
+            row_errors.append((line, "category"))
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        assert day is not None and amount is not None
+        if category_map and category in category_map:
+            category = category_map[category]
+        expenses.append(
+            Expense(
+                day=day,
+                category=category,
+                amount=amount,
+                memo=cell(row, "memo").strip(),
+            )
+        )
+    return expenses, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
new file mode 100644
index 0000000..21aea9a
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,99 @@
+"""Month-over-month comparison of expenses by category."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not isinstance(month, str) or not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def _month_of(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+
+    prev_totals: dict[str, int] = {}
+    curr_totals: dict[str, int] = {}
+    prev_seen: set[str] = set()
+    curr_seen: set[str] = set()
+    for e in rows:
+        m = _month_of(e)
+        if m == prev_month:
+            prev_totals[e.category] = prev_totals.get(e.category, 0) + e.amount
+            prev_seen.add(e.category)
+        if m == curr_month:
+            curr_totals[e.category] = curr_totals.get(e.category, 0) + e.amount
+            curr_seen.add(e.category)
+
+    out: list[DiffRow] = []
+    for cat in prev_seen | curr_seen:
+        prev = prev_totals.get(cat, 0)
+        curr = curr_totals.get(cat, 0)
+        delta = curr - prev
+        pct = None if prev == 0 else round(delta / prev * 100, 1) + 0.0  # -0.0 を避ける
+        if cat not in prev_seen:
+            status = "new"
+        elif cat not in curr_seen:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+
+    out.sort(key=lambda r: (-abs(r.delta), r.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [r for r in diffs if r.status != "same"][:n]
+
+
+def _signed(v: int) -> str:
+    return f"{v:+d}"
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for r in diffs:
+        pct = "-" if r.pct is None else f"{r.pct + 0.0:+.1f}%"
+        lines.append(
+            "\t".join([r.category, str(r.prev), str(r.curr), _signed(r.delta), pct])
+        )
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month_of(e) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には 2 か月以上の明細が必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..6cd44f0
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,192 @@
+"""Search query language for filtering Expense rows.
+
+Grammar (lowest precedence first):
+    or_expr  := and_expr ("OR" and_expr)*
+    and_expr := not_expr (["AND"] not_expr)*
+    not_expr := "NOT" not_expr | primary
+    primary  := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+
+class QueryError(ValueError):
+    """Raised when a search query is invalid."""
+
+
+_SPECIAL = frozenset('()"')
+_TERM_START = frozenset({"TERM", "CAT", "LPAREN", "NOT"})
+
+
+def _word_token(word: str) -> tuple[str, str]:
+    if word in ("AND", "OR", "NOT"):
+        return (word, word)
+    if word.startswith("cat:"):
+        value = word[len("cat:") :]
+        if not value:
+            raise QueryError("cat: の後ろに値がありません")
+        return ("CAT", value)
+    return ("TERM", word)
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    """Split a query into (kind, value) tokens."""
+    tokens: list[tuple[str, str]] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError(f"閉じられていない引用符があります: {q!r}")
+            body = q[i + 1 : end]
+            if not body:
+                raise QueryError("空の引用符は使えません")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            j = i
+            while j < n and not q[j].isspace() and q[j] not in _SPECIAL:
+                j += 1
+            tokens.append(_word_token(q[i:j]))
+            i = j
+    return tokens
+
+
+@dataclass(frozen=True)
+class _Term:
+    value: str
+
+
+@dataclass(frozen=True)
+class _Cat:
+    value: str
+
+
+@dataclass(frozen=True)
+class _Not:
+    operand: _Node
+
+
+@dataclass(frozen=True)
+class _And:
+    left: _Node
+    right: _Node
+
+
+@dataclass(frozen=True)
+class _Or:
+    left: _Node
+    right: _Node
+
+
+_Node = _Term | _Cat | _Not | _And | _Or
+
+
+class _Parser:
+    def __init__(self, tokens: list[tuple[str, str]]) -> None:
+        self._tokens = tokens
+        self._pos = 0
+
+    def _peek(self) -> str | None:
+        if self._pos < len(self._tokens):
+            return self._tokens[self._pos][0]
+        return None
+
+    def _next(self) -> tuple[str, str]:
+        tok = self._tokens[self._pos]
+        self._pos += 1
+        return tok
+
+    def parse(self) -> _Node:
+        if not self._tokens:
+            raise QueryError("検索式が空です")
+        node = self._or()
+        if self._pos != len(self._tokens):
+            raise QueryError(
+                f"余分なトークンがあります: {self._tokens[self._pos][1]!r}"
+            )
+        return node
+
+    def _or(self) -> _Node:
+        node = self._and()
+        while self._peek() == "OR":
+            self._next()
+            node = _Or(node, self._and())
+        return node
+
+    def _and(self) -> _Node:
+        node = self._not()
+        while True:
+            kind = self._peek()
+            if kind == "AND":
+                self._next()
+                node = _And(node, self._not())
+            elif kind in _TERM_START:
+                node = _And(node, self._not())
+            else:
+                return node
+
+    def _not(self) -> _Node:
+        if self._peek() == "NOT":
+            self._next()
+            return _Not(self._not())
+        return self._primary()
+
+    def _primary(self) -> _Node:
+        kind = self._peek()
+        if kind == "TERM":
+            return _Term(self._next()[1])
+        if kind == "CAT":
+            return _Cat(self._next()[1])
+        if kind == "LPAREN":
+            self._next()
+            node = self._or()
+            if self._peek() != "RPAREN":
+                raise QueryError("括弧が閉じられていません")
+            self._next()
+            return node
+        if kind is None:
+            raise QueryError("検索式が途中で終わっています")
+        raise QueryError(f"予期しないトークンです: {self._tokens[self._pos][1]!r}")
+
+
+def _compile(q: str) -> _Node:
+    return _Parser(tokenize(q)).parse()
+
+
+def _eval(node: _Node, e: Expense) -> bool:
+    if isinstance(node, _Term):
+        v = node.value.casefold()
+        return v in e.memo.casefold() or v in e.category.casefold()
+    if isinstance(node, _Cat):
+        return node.value.casefold() == e.category.casefold()
+    if isinstance(node, _Not):
+        return not _eval(node.operand, e)
+    if isinstance(node, _And):
+        return _eval(node.left, e) and _eval(node.right, e)
+    return _eval(node.left, e) or _eval(node.right, e)
+
+
+def matches(q: str, e: Expense) -> bool:
+    """Return True if the query matches the expense."""
+    return _eval(_compile(q), e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    """Return the rows matching the query, in input order."""
+    node = _compile(q)
+    return [e for e in rows if _eval(node, e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..559d883
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,70 @@
+"""Detect recurring expenses: same (category, amount) on a roughly monthly cadence."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+from itertools import pairwise
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day in the next month, clamped to that month's last day."""
+    if d.month == 12:
+        year, month = d.year + 1, 1
+    else:
+        year, month = d.year, d.month + 1
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+def _runs(days: list[date], tolerance: int) -> list[list[date]]:
+    """Split ascending, unique days into maximal runs of linked consecutive dates."""
+    if not days:
+        return []
+    runs: list[list[date]] = [[days[0]]]
+    for prev, cur in pairwise(days):
+        if abs((cur - add_month(prev)).days) <= tolerance:
+            runs[-1].append(cur)
+        else:
+            runs.append([cur])
+    return runs
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError(f"min_count は 2 以上である必要があります: {min_count}")
+    if tolerance < 0:
+        raise ValueError(f"tolerance は 0 以上である必要があります: {tolerance}")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    found: list[Recurring] = []
+    for (category, amount), dates in groups.items():
+        for run in _runs(sorted(dates), tolerance):
+            if len(run) >= min_count:
+                found.append(
+                    Recurring(
+                        category=category,
+                        amount=amount,
+                        days=tuple(run),
+                        next_expected=add_month(run[-1]),
+                    )
+                )
+
+    found.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return found
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..90f8c59
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,252 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+BANK_HEADER = "利用日,分類,利用金額,利用店名,カード\n"
+
+
+# --- parse_amount -----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("1,234", 1234),
+        ("-980円", -980),
+        ("¥1,2,3", 123),  # カンマの位置は検査しない
+        ("5,", 5),  # 数字で始まりカンマだけの続きは許容
+        ("00012", 12),
+        ("\t500\n", 500),
+    ],
+)
+def test_parse_amount_accepts(text, expected):
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "   ",
+        "円",
+        "12.5",
+        "1 200",
+        "--5",
+        "¥-5",
+        "１２３",
+        "-",
+        "¥",
+        "5¥",
+        "5 円",
+        "円円",
+        "¥¥1",
+        "+5",
+        ",5",
+        "-円5",
+    ],
+)
+def test_parse_amount_rejects(text):
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+# --- parse_date -------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        ("2026/1/05", date(2026, 1, 5)),
+        ("2026-12-31", date(2026, 12, 31)),
+        (" 2026/1/5 ", date(2026, 1, 5)),
+        ("2024/2/29", date(2024, 2, 29)),
+    ],
+)
+def test_parse_date_accepts(text, expected):
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "2026/1-5",
+        "2026-1/5",
+        "26/1/5",
+        "2026/02/30",
+        "2026/2/29",
+        "2026/13/1",
+        "2026/1/0",
+        "2026/1/",
+        "2026.1.5",
+        "２０２６/1/5",
+        "2026/1/5/",
+        "2026/001/5",
+        "20260/1/5",
+        "2026/1/123",
+    ],
+)
+def test_parse_date_rejects(text):
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+# --- import_rows ------------------------------------------------------------
+
+
+def test_default_mapping_constant():
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_basic_import_strips_and_ignores_extra_columns():
+    text = BANK_HEADER + ' 2026/1/5 , 食費 ,"￥1,200", セブン ,x\n'
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 1200, "セブン")]
+
+
+def test_quoted_comma_values_are_kept_whole():
+    text = BANK_HEADER + '2026/1/5,食費,"1,000","a,b",\n'
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 1000, "a,b")]
+
+
+def test_output_keeps_input_order():
+    text = (
+        BANK_HEADER
+        + "2026/1/9,住居,80000,\n"
+        + "2026/1/2,食費,300,\n"
+        + "2026/1/5,交通,-150,\n"
+    )
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert [r.day for r in rows] == [
+        date(2026, 1, 9),
+        date(2026, 1, 2),
+        date(2026, 1, 5),
+    ]
+    assert [r.amount for r in rows] == [80000, 300, -150]
+
+
+def test_all_errors_in_one_row_recorded_in_order_and_row_excluded():
+    text = BANK_HEADER + "bad,   ,12.5,メモ\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "date"), (2, "amount"), (2, "category")]
+
+
+def test_single_error_row_excluded_others_kept():
+    text = (
+        BANK_HEADER
+        + "2026/1/5,食費,100,ok\n2026/1/6,食費,abc,ng\n2026/1/7,食費,7,ok2\n"
+    )
+    rows, errors = import_rows(text)
+    assert errors == [(3, "amount")]
+    assert [r.memo for r in rows] == ["ok", "ok2"]
+
+
+def test_category_only_whitespace_is_error():
+    text = BANK_HEADER + "2026/1/5,  ,100,\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "category")]
+
+
+def test_blank_lines_skipped_but_counted_in_line_numbers():
+    text = BANK_HEADER + "\n2026/1/5,食費,100,\n\nbad,食費,100,\n"
+    rows, errors = import_rows(text)
+    assert [r.amount for r in rows] == [100]
+    assert errors == [(5, "date")]
+
+
+def test_multiline_quoted_field_line_number_is_start_line():
+    text = BANK_HEADER + '2026/1/5,食費,100,"改行\nあり"\n2026/1/6,食費,oops,\n'
+    rows, errors = import_rows(text)
+    assert [r.amount for r in rows] == [100]
+    assert errors == [(4, "amount")]
+
+
+def test_missing_trailing_columns_treated_as_empty():
+    text = BANK_HEADER + "2026/1/5,食費,100\n2026/1/6\n"
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "")]
+    assert errors == [(3, "amount"), (3, "category")]
+
+
+def test_memo_column_missing_from_data_gives_empty_memo():
+    text = BANK_HEADER + "2026/1/5,食費,100,\n"
+    rows, _ = import_rows(text)
+    assert rows[0].memo == ""
+
+
+def test_category_map_replaces_after_strip():
+    text = BANK_HEADER + "2026/1/5, 食費 ,100,\n2026/1/6,交通,200,\n"
+    rows, errors = import_rows(text, category_map={"食費": "Food"})
+    assert errors == []
+    assert [r.category for r in rows] == ["Food", "交通"]
+
+
+def test_category_map_is_not_applied_to_memo_or_unknown_keys():
+    text = BANK_HEADER + "2026/1/5,食費,100,食費\n"
+    rows, _ = import_rows(text, category_map={"外食": "Eating"})
+    assert rows[0].category == "食費"
+    assert rows[0].memo == "食費"
+
+
+def test_custom_mapping_without_memo():
+    text = "day,cat,yen\n2026-01-05,食費,100\n"
+    mapping = {"date": "day", "category": "cat", "amount": "yen"}
+    rows, errors = import_rows(text, mapping)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+def test_custom_mapping_with_memo():
+    text = "d,c,a,m\n2026/1/5,食費,100,店\n"
+    rows, _ = import_rows(
+        text, {"date": "d", "category": "c", "amount": "a", "memo": "m"}
+    )
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "店")]
+
+
+def test_empty_rows_only_returns_empty_lists():
+    rows, errors = import_rows(BANK_HEADER)
+    assert rows == []
+    assert errors == []
+
+
+@pytest.mark.parametrize("missing", ["date", "category", "amount"])
+def test_mapping_missing_required_key_raises(missing):
+    mapping = {k: v for k, v in DEFAULT_MAPPING.items() if k != missing}
+    with pytest.raises(ValueError):
+        import_rows(BANK_HEADER, mapping)
+
+
+def test_mapping_column_not_in_header_raises():
+    with pytest.raises(ValueError):
+        import_rows(BANK_HEADER, {**DEFAULT_MAPPING, "amount": "金額"})
+
+
+def test_mapping_memo_column_not_in_header_raises():
+    with pytest.raises(ValueError):
+        import_rows(BANK_HEADER, {**DEFAULT_MAPPING, "memo": "店名"})
+
+
+def test_empty_text_raises_value_error():
+    with pytest.raises(ValueError):
+        import_rows("")
