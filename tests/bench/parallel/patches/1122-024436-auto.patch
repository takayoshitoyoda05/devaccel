diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..97267fd 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -188,3 +188,110 @@ def test_path_type(runner, cls, expect):
 
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
+
+
+@pytest.mark.parametrize(
+    "name", ["a.csv", "a.TSV", "A.Csv", "dir/a.tsv", "a.b.csv", "a.csv.csv"]
+)
+def test_path_extensions_accepts(name):
+    assert click.Path(extensions=[".csv", ".tsv"]).convert(name, None, None) == name
+
+
+@pytest.mark.parametrize(
+    "name", ["a.txt", "a", "a.csv.bak", "csv", ".csv", "dir.csv/a", "a.csv/", "a."]
+)
+def test_path_extensions_rejects(name):
+    type = click.Path(extensions=[".csv", ".tsv"])
+
+    with pytest.raises(click.BadParameter, match=r"must have one of .*\.csv, \.tsv"):
+        type.convert(name, None, None)
+
+
+def test_path_extensions_normalized():
+    type = click.Path(extensions=["CSV", ".Tsv", "csv"])
+    assert type.extensions == (".csv", ".tsv")
+    type.convert("a.TSV", None, None)
+
+
+def test_path_extensions_multi_part():
+    type = click.Path(extensions=[".tar.gz"])
+    type.convert("a.tar.gz", None, None)
+
+    with pytest.raises(click.BadParameter):
+        type.convert("a.gz", None, None)
+
+
+def test_path_extensions_default_unchanged():
+    assert click.Path().extensions is None
+    assert click.Path().convert("a.anything", None, None) == "a.anything"
+
+
+@pytest.mark.parametrize("bad", [[], (), ["."], [""]])
+def test_path_extensions_invalid_value(bad):
+    with pytest.raises(ValueError, match="extensions"):
+        click.Path(extensions=bad)
+
+
+@pytest.mark.parametrize("bad", [".csv", b".csv"])
+def test_path_extensions_bare_string(bad):
+    with pytest.raises(TypeError, match="extensions"):
+        click.Path(extensions=bad)  # type: ignore[arg-type]
+
+
+def test_path_extensions_generator():
+    type = click.Path(extensions=(e for e in [".csv"]))
+    type.convert("a.csv", None, None)
+
+
+def test_path_extensions_existing_file(tmp_path):
+    good = tmp_path / "data.CSV"
+    bad = tmp_path / "data.txt"
+    good.write_text("")
+    bad.write_text("")
+    type = click.Path(exists=True, extensions=[".csv"])
+
+    assert type.convert(os.fspath(good), None, None) == os.fspath(good)
+
+    with pytest.raises(click.BadParameter, match="must have one of"):
+        type.convert(os.fspath(bad), None, None)
+
+
+def test_path_extensions_skips_directories(tmp_path):
+    directory = tmp_path / "data.txt"
+    directory.mkdir()
+    type = click.Path(exists=True, extensions=[".csv"])
+    assert type.convert(os.fspath(directory), None, None) == os.fspath(directory)
+
+
+def test_path_extensions_missing_file_checked_without_exists():
+    with pytest.raises(click.BadParameter, match="must have one of"):
+        click.Path(extensions=[".csv"]).convert("missing.txt", None, None)
+
+
+def test_path_extensions_allow_dash():
+    type = click.Path(allow_dash=True, extensions=[".csv"])
+    assert type.convert("-", None, None) == "-"
+
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions=[".csv"]).convert("-", None, None)
+
+
+def test_path_extensions_pathlike_and_bytes():
+    type = click.Path(extensions=[".csv"])
+    type.convert(pathlib.Path("a.CSV"), None, None)
+    type.convert(b"a.csv", None, None)
+
+    with pytest.raises(click.BadParameter):
+        type.convert(pathlib.Path("a.txt"), None, None)
+
+
+def test_path_extensions_cli(runner):
+    @click.command()
+    @click.argument("p", type=click.Path(extensions=[".csv", ".tsv"]))
+    def cli(p):
+        click.echo(p)
+
+    assert runner.invoke(cli, ["x.TSV"]).output == "x.TSV\n"
+    result = runner.invoke(cli, ["x.txt"])
+    assert result.exit_code == 2
+    assert "must have one of the extensions: .csv, .tsv." in result.output
