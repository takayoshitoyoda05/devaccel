+import pytest
+
+from kakeibo.core import format_yen
+
+
+@pytest.mark.parametrize(
+    ("amount", "expected"),
+    [
+        (1234567, "¥1,234,567"),
+        (0, "¥0"),
+        (5, "¥5"),
+        (999, "¥999"),
+        (1000, "¥1,000"),
+        (1000000, "¥1,000,000"),
+        (-500, "-¥500"),
+        (-1, "-¥1"),
+        (-1234567, "-¥1,234,567"),
+    ],
+)
+def test_format_yen(amount, expected):
+    assert format_yen(amount) == expected
