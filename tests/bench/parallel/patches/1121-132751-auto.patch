+"""Monthly per-category budget status (pure functions).
+
+Reuses `Budget` / `monthly_totals` from core; this module only classifies.
+
+D1: 予算の型は core.Budget を再利用する(月別の上書きは Budget.for_month に任せる)。
+D2: 状態は "over"(実績 > 上限)/ "warning"(上限の warn_percent % 以上で超過ではない)/ "ok"。
+    ちょうど上限は超過ではない(warning)。
+D3: warn_percent は 1〜100 の int(既定 80)。bool・float・str・None は TypeError、範囲外は ValueError。
+    100 なら「ちょうど上限」だけが warning になる。判定は整数演算(浮動小数の誤差なし)。
+D4: 上限 0 円: 実績 0 は ok、実績 > 0 は over(割り算をしない)。
+D5: 返金で実績が負でも ok(remaining は上限を超えて増える)。
+D6: 予算のあるカテゴリは、その月に支出が無くても actual=0・ok で出す。
+    予算の無いカテゴリは出さない。予算の無い月(totals に無い月)も出さない。
+D7: 並びは月の昇順 → 状態の重さ(over, warning, ok)→ カテゴリ名。
+D8: remaining = limit - actual(超過なら負)。
+D9: 空の totals は空リスト。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from kakeibo.core import Budget
+
+_SEVERITY = {"over": 0, "warning": 1, "ok": 2}
+
+
+@dataclass(frozen=True)
+class BudgetStatus:
+    month: str
+    category: str
+    limit: int
+    actual: int
+    status: str  # "over" | "warning" | "ok"
+
+    @property
+    def remaining(self) -> int:
+        return self.limit - self.actual
+
+
+def _check_percent(warn_percent: object) -> int:
+    if isinstance(warn_percent, bool) or not isinstance(warn_percent, int):
+        raise TypeError(f"warn_percent は int である必要があります: {warn_percent!r}")
+    if not 1 <= warn_percent <= 100:
+        raise ValueError(f"warn_percent は 1〜100 である必要があります: {warn_percent}")
+    return warn_percent
+
+
+def _classify(actual: int, limit: int, warn_percent: int) -> str:
+    if actual > limit:
+        return "over"
+    if limit > 0 and actual * 100 >= limit * warn_percent:
+        return "warning"
+    return "ok"
+
+
+def budget_status(
+    totals: dict[str, dict[str, int]], budget: Budget, warn_percent: int = 80
+) -> list[BudgetStatus]:
+    """Status of every budgeted category for every month in `totals`."""
+    pct = _check_percent(warn_percent)
+    out: list[BudgetStatus] = []
+    for month in sorted(totals):
+        spent = totals[month]
+        for cat, limit in budget.for_month(month).items():
+            actual = spent.get(cat, 0)
+            out.append(
+                BudgetStatus(month, cat, limit, actual, _classify(actual, limit, pct))
+            )
+    out.sort(key=lambda s: (s.month, _SEVERITY[s.status], s.category))
+    return out
+
+
+def budget_alerts(
+    totals: dict[str, dict[str, int]], budget: Budget, warn_percent: int = 80
+) -> list[BudgetStatus]:
+    """Only the "over" and "warning" entries of `budget_status`."""
+    return [s for s in budget_status(totals, budget, warn_percent) if s.status != "ok"]
diff --git a/tests/test_budget_status.py b/tests/test_budget_status.py
new file mode 100644
index 0000000..59a3037
--- /dev/null
+++ b/tests/test_budget_status.py
@@ -0,0 +1,104 @@
+import pytest
+
+from kakeibo.budget import BudgetStatus, budget_alerts, budget_status
+from kakeibo.core import Budget
+
+
+def _b(default=None, months=None):
+    return Budget(default or {}, months or {})
+
+
+def _st(totals, budget, **kw):
+    return {
+        (s.month, s.category): s.status for s in budget_status(totals, budget, **kw)
+    }
+
+
+def test_d2_over_warning_ok():
+    t = {"2026-11": {"food": 10001, "fun": 8000, "rent": 5000}}
+    b = _b({"food": 10000, "fun": 10000, "rent": 10000})
+    assert _st(t, b) == {
+        ("2026-11", "food"): "over",
+        ("2026-11", "fun"): "warning",
+        ("2026-11", "rent"): "ok",
+    }
+
+
+def test_d2_exact_limit_is_warning_not_over():
+    assert _st({"m": {"a": 100}}, _b({"a": 100})) == {("m", "a"): "warning"}
+
+
+def test_d2_exact_threshold_is_warning_and_just_below_ok():
+    assert _st({"m": {"a": 80}}, _b({"a": 100})) == {("m", "a"): "warning"}
+    assert _st({"m": {"a": 79}}, _b({"a": 100})) == {("m", "a"): "ok"}
+
+
+def test_d3_percent_100_only_exact_limit_warns():
+    b = _b({"a": 100})
+    assert _st({"m": {"a": 99}}, b, warn_percent=100) == {("m", "a"): "ok"}
+    assert _st({"m": {"a": 100}}, b, warn_percent=100) == {("m", "a"): "warning"}
+
+
+@pytest.mark.parametrize("bad", [True, 80.0, "80", None])
+def test_d3_percent_type_error(bad):
+    with pytest.raises(TypeError):
+        budget_status({}, _b(), warn_percent=bad)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad", [0, -1, 101])
+def test_d3_percent_range_error(bad):
+    with pytest.raises(ValueError, match="warn_percent"):
+        budget_status({}, _b(), warn_percent=bad)
+
+
+def test_d4_zero_limit():
+    t = {"m": {"a": 0, "b": 1}}
+    assert _st(t, _b({"a": 0, "b": 0})) == {("m", "a"): "ok", ("m", "b"): "over"}
+
+
+def test_d5_refund_is_ok():
+    (s,) = budget_status({"m": {"a": -300}}, _b({"a": 1000}))
+    assert s.status == "ok" and s.remaining == 1300
+
+
+def test_d6_budgeted_without_spending_and_unbudgeted_skipped():
+    got = budget_status({"m": {"other": 999999}}, _b({"a": 100}))
+    assert got == [BudgetStatus("m", "a", 100, 0, "ok")]
+
+
+def test_d6_months_come_from_totals_and_monthly_override_applies():
+    b = _b({"a": 100}, {"2026-12": {"a": 1000}})
+    t = {"2026-11": {"a": 150}, "2026-12": {"a": 150}}
+    assert _st(t, b) == {("2026-11", "a"): "over", ("2026-12", "a"): "ok"}
+
+
+def test_d7_order_month_then_severity_then_name():
+    t = {"2026-12": {"a": 1}, "2026-11": {"a": 5, "b": 10, "c": 9, "d": 10}}
+    b = _b({"a": 10, "b": 5, "c": 10, "d": 5})
+    order = [(s.month, s.category) for s in budget_status(t, b)]
+    assert order == [
+        ("2026-11", "b"),
+        ("2026-11", "d"),
+        ("2026-11", "c"),
+        ("2026-11", "a"),
+        ("2026-12", "a"),
+        ("2026-12", "b"),
+        ("2026-12", "c"),
+        ("2026-12", "d"),
+    ]
+
+
+def test_d8_remaining_negative_when_over():
+    (s,) = budget_status({"m": {"a": 130}}, _b({"a": 100}))
+    assert s.remaining == -30
+
+
+def test_d9_empty_totals():
+    assert budget_status({}, _b({"a": 1})) == []
+    assert budget_alerts({}, _b({"a": 1})) == []
+
+
+def test_alerts_exclude_ok():
+    t = {"m": {"a": 200, "b": 90, "c": 1}}
+    got = budget_alerts(t, _b({"a": 100, "b": 100, "c": 100}))
+    assert [(s.category, s.status) for s in got] == [("a", "over"), ("b", "warning")]
