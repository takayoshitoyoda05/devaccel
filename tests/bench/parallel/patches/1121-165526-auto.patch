index 8c3cbab..87a1f9e 100644
--- a/src/kakeibo/core.py
+++ b/src/kakeibo/core.py
@@ -122,6 +122,41 @@ def load_budget(path: Path) -> Budget:
     return Budget(default, months)
 
 
+def format_percent(actual: int, limit: int) -> str:
+    """予算に対する実績の割合。小数第 1 位まで切り捨て(例 "90.0%")。limit=0 は "-"。"""
+    if limit <= 0:
+        return "-"
+    tenths = actual * 1000 // limit
+    return f"{tenths // 10}.{tenths % 10}%"
+
+
+def find_warnings(
+    totals: dict[str, dict[str, int]], budget: Budget, threshold_pct: int = 90
+) -> list[tuple[str, str, str, int, int]]:
+    """(month, category, kind, limit, actual). kind は "over"(超過)か "near"(注意)。
+
+    D1: 実績 > 上限 は over。D2: 上限の threshold_pct% 以上(整数演算、端を含む)で
+    超過でなければ near(ちょうど 100% も near)。D3: 上限 0 は実績 > 0 のとき over、
+    実績 0 は警告なし(0 >= 0 で誤検知しない)。D4: 予算に無いカテゴリは対象外。
+    """
+    if isinstance(threshold_pct, bool) or not isinstance(threshold_pct, int):
+        raise TypeError("threshold_pct は整数である必要があります")
+    if not 0 < threshold_pct <= 100:
+        raise ValueError("threshold_pct は 1〜100 である必要があります")
+    out: list[tuple[str, str, str, int, int]] = []
+    for month, cats in totals.items():
+        limits = budget.for_month(month)
+        for cat, actual in cats.items():
+            if cat not in limits:
+                continue
+            limit = limits[cat]
+            if actual > limit:
+                out.append((month, cat, "over", limit, actual))
+            elif actual > 0 and actual * 100 >= limit * threshold_pct:
+                out.append((month, cat, "near", limit, actual))
+    return out
+
+
 def find_overruns(
