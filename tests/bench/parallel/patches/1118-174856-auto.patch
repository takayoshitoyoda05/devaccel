index 0000000..afc54e8
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,120 @@
+"""Import bank-statement CSV text into Expense records (pure functions)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+# 任意の "-", 任意の "¥" / "￥", ASCII 数字で始まる数字とカンマの列, 任意の "円"
+_AMOUNT_RE = re.compile(r"(-)?[¥￥]?([0-9][0-9,]*)円?")
+# YYYY[/-]M[/-]D。区切りは同じものに揃える。
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    """Parse a bank amount such as "￥1,234" or "-300円" into yen (int)."""
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    sign, digits = m.group(1), m.group(2)
+    value = int(digits.replace(",", ""))
+    return -value if sign else value
+
+
+def parse_date(s: str) -> date:
+    """Parse "YYYY/M/D" or "YYYY-M-D" into a date."""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    year, month, day = int(m.group(1)), int(m.group(3)), int(m.group(4))
+    try:
+        return date(year, month, day)
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Convert CSV text (first line = header) into expenses.
+
+    Returns (valid expenses in input order, [(line_number, field), ...]).
+    Line numbers are physical lines with the header as line 1.
+    """
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text))
+    header = next(reader, [])
+
+    cols: dict[str, int] = {}
+    for field in ("date", "category", "amount", "memo"):
+        if field not in mapping:
+            continue
+        column = mapping[field]
+        if column not in header:
+            raise ValueError(f"CSV に列 {column!r} がありません")
+        cols[field] = header.index(column)
+
+    def value(row: list[str], field: str) -> str:
+        idx = cols.get(field)
+        if idx is None or idx >= len(row):
+            return ""
+        return row[idx]
+
+    rows: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    for row in reader:
+        if not row or (len(row) == 1 and not row[0].strip()):
+            continue  # 空行は読み飛ばす(行番号は数える)
+        line = reader.line_num
+        bad = False
+
+        day: date | None = None
+        try:
+            day = parse_date(value(row, "date"))
+        except ValueError:
+            errors.append((line, "date"))
+            bad = True
+
+        amount: int | None = None
+        try:
+            amount = parse_amount(value(row, "amount"))
+        except ValueError:
+            errors.append((line, "amount"))
+            bad = True
+
+        category = value(row, "category").strip()
+        if not category:
+            errors.append((line, "category"))
+            bad = True
+
+        if bad or day is None or amount is None:
+            continue
+        if category_map is not None:
+            category = category_map.get(category, category)
+        rows.append(
+            Expense(
+                day=day,
+                category=category,
+                amount=amount,
+                memo=value(row, "memo").strip(),
+            )
+        )
+    return rows, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
