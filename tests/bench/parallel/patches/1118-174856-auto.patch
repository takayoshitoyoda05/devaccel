+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def _e(
+    day: date, category: str = "subscription", amount: int = 1000, memo: str = ""
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- add_month -----------------------------------------------------------
+
+
+def test_add_month_same_day():
+    assert add_month(date(2026, 3, 10)) == date(2026, 4, 10)
+
+
+def test_add_month_clamps_to_end_of_short_month():
+    assert add_month(date(2026, 1, 31)) == date(2026, 2, 28)
+
+
+def test_add_month_clamps_to_leap_february():
+    assert add_month(date(2024, 1, 31)) == date(2024, 2, 29)
+
+
+def test_add_month_clamps_30_day_month():
+    assert add_month(date(2026, 3, 31)) == date(2026, 4, 30)
+
+
+def test_add_month_leap_day_to_non_leap_march():
+    assert add_month(date(2024, 2, 29)) == date(2024, 3, 29)
+
+
+def test_add_month_wraps_year():
+    assert add_month(date(2026, 12, 15)) == date(2027, 1, 15)
+
+
+# --- find_recurring: argument validation ---------------------------------
+
+
+def test_min_count_below_two_raises():
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+
+
+def test_negative_tolerance_raises():
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_min_count_two_is_accepted():
+    rows = [_e(date(2026, 1, 1)), _e(date(2026, 2, 1))]
+    assert find_recurring(rows, min_count=2) == [
+        Recurring(
+            "subscription", 1000, (date(2026, 1, 1), date(2026, 2, 1)), date(2026, 3, 1)
+        )
+    ]
+
+
+# --- find_recurring: basic behaviour -------------------------------------
+
+
+def test_empty_input_returns_empty_list():
+    assert find_recurring([]) == []
+
+
+def test_monthly_series_detected_with_next_expected():
+    rows = [_e(date(2026, 1, 5)), _e(date(2026, 2, 5)), _e(date(2026, 3, 5))]
+    assert find_recurring(rows) == [
+        Recurring(
+            "subscription",
+            1000,
+            (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+            date(2026, 4, 5),
+        )
+    ]
+
+
+def test_series_shorter_than_min_count_is_ignored():
+    rows = [_e(date(2026, 1, 5)), _e(date(2026, 2, 5))]
+    assert find_recurring(rows, min_count=3) == []
+
+
+def test_series_exactly_min_count_is_detected():
+    rows = [_e(date(2026, 1, 5)), _e(date(2026, 2, 5)), _e(date(2026, 3, 5))]
+    assert len(find_recurring(rows, min_count=3)) == 1
+
+
+def test_memo_is_ignored_for_grouping():
+    rows = [
+        _e(date(2026, 1, 5), memo="a"),
+        _e(date(2026, 2, 5), memo="b"),
+        _e(date(2026, 3, 5), memo=""),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_different_amounts_are_separate_groups():
+    rows = [
+        _e(date(2026, 1, 5), amount=1000),
+        _e(date(2026, 2, 5), amount=1000),
+        _e(date(2026, 3, 5), amount=1000),
+        _e(date(2026, 1, 5), amount=500),
+        _e(date(2026, 2, 5), amount=500),
+    ]
+    result = find_recurring(rows)
+    assert [(r.amount, len(r.days)) for r in result] == [(1000, 3)]
+
+
+def test_different_categories_are_separate_groups():
+    rows = [
+        _e(date(2026, 1, 5), category="a"),
+        _e(date(2026, 2, 5), category="a"),
+        _e(date(2026, 3, 5), category="a"),
+        _e(date(2026, 1, 5), category="b"),
+        _e(date(2026, 2, 5), category="b"),
+    ]
+    result = find_recurring(rows)
+    assert [r.category for r in result] == ["a"]
+
+
+def test_same_day_duplicates_are_counted_once():
+    rows = [
+        _e(date(2026, 1, 5)),
+        _e(date(2026, 1, 5)),
+        _e(date(2026, 2, 5)),
+    ]
+    # Only two distinct dates, so below min_count=3.
+    assert find_recurring(rows) == []
+
+
+def test_unsorted_input_is_sorted_in_days():
+    rows = [_e(date(2026, 3, 5)), _e(date(2026, 1, 5)), _e(date(2026, 2, 5))]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+# --- find_recurring: tolerance and splitting -----------------------------
+
+
+def test_date_within_tolerance_is_connected():
+    # 2026-01-05 + 1 month = 2026-02-05; 2026-02-08 is 3 days later.
+    rows = [_e(date(2026, 1, 5)), _e(date(2026, 2, 8)), _e(date(2026, 3, 8))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+
+
+def test_date_beyond_tolerance_splits_series():
+    # 2026-02-09 is 4 days after 2026-02-05, so it breaks the run.
+    rows = [_e(date(2026, 1, 5)), _e(date(2026, 2, 9)), _e(date(2026, 3, 9))]
+    assert find_recurring(rows, tolerance=3) == []
+
+
+def test_date_early_beyond_tolerance_is_not_connected():
+    # 2026-02-01 is 4 days before 2026-02-05.
+    rows = [_e(date(2026, 1, 5)), _e(date(2026, 2, 1)), _e(date(2026, 3, 1))]
+    assert find_recurring(rows, tolerance=3) == []
+
+
+def test_tolerance_zero_requires_exact_match():
+    rows = [_e(date(2026, 1, 5)), _e(date(2026, 2, 6)), _e(date(2026, 3, 6))]
+    assert find_recurring(rows, tolerance=0) == []
+
+
+def test_gap_splits_into_two_runs_each_kept_if_long_enough():
+    rows = [
+        _e(date(2026, 1, 5)),
+        _e(date(2026, 2, 5)),
+        _e(date(2026, 3, 5)),
+        # break: skip April and May
+        _e(date(2026, 6, 5)),
+        _e(date(2026, 7, 5)),
+        _e(date(2026, 8, 5)),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 5), date(2026, 6, 5)]
+    assert result[0].next_expected == date(2026, 4, 5)
+    assert result[1].next_expected == date(2026, 9, 5)
+
+
+def test_short_run_after_split_is_dropped():
+    rows = [
+        _e(date(2026, 1, 5)),
+        _e(date(2026, 2, 5)),
+        _e(date(2026, 3, 5)),
+        _e(date(2026, 7, 5)),
+        _e(date(2026, 8, 5)),  # only 2 in this run
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days[0] == date(2026, 1, 5)
+
+
+def test_next_expected_uses_add_month_clamp():
+    rows = [_e(date(2026, 1, 31)), _e(date(2026, 2, 28)), _e(date(2026, 3, 31))]
+    result = find_recurring(rows, tolerance=3)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 30)
+
+
+# --- find_recurring: result ordering -------------------------------------
+
+
+def test_results_sorted_by_category_then_amount_then_first_day():
+    rows = []
+    for cat, amt in [("b", 100), ("a", 300), ("a", 200)]:
+        for m in (1, 2, 3):
+            rows.append(_e(date(2026, m, 5), category=cat, amount=amt))
+    # second run for ("a", 200) starting later
+    for m in (7, 8, 9):
+        rows.append(_e(date(2026, m, 5), category="a", amount=200))
+    result = find_recurring(rows)
+    keys = [(r.category, r.amount, r.days[0]) for r in result]
+    assert keys == [
+        ("a", 200, date(2026, 1, 5)),
+        ("a", 200, date(2026, 7, 5)),
+        ("a", 300, date(2026, 1, 5)),
+        ("b", 100, date(2026, 1, 5)),
+    ]
