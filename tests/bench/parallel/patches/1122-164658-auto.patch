diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..743647e 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -188,3 +188,135 @@ def test_path_type(runner, cls, expect):
 
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
+
+
+class TestExtensions:
+    @pytest.mark.parametrize(
+        "name", ["a.csv", "a.TSV", "dir/a.Csv", "a.b.csv", " .csv.tsv"]
+    )
+    def test_accepts(self, name):
+        type = click.Path(extensions=[".csv", ".tsv"])
+        assert type.convert(name, None, None) == name
+
+    @pytest.mark.parametrize(
+        "name", ["a.txt", "a", "a.csv.bak", ".csv", "csv", "a.csv/", "", "a.csvx"]
+    )
+    def test_rejects(self, name):
+        type = click.Path(extensions=[".csv", ".tsv"])
+
+        with pytest.raises(click.BadParameter, match=r"\.csv, \.tsv"):
+            type.convert(name, None, None)
+
+    def test_dot_optional_and_case_insensitive(self):
+        type = click.Path(extensions=["CSV", ".Tsv"])
+        assert type.extensions == (".csv", ".tsv")
+        assert type.convert("a.cSv", None, None) == "a.cSv"
+
+    def test_multi_part_extension(self):
+        type = click.Path(extensions=[".tar.gz"])
+        assert type.convert("a.TAR.GZ", None, None) == "a.TAR.GZ"
+
+        with pytest.raises(click.BadParameter):
+            type.convert("a.gz", None, None)
+
+    def test_default_accepts_anything(self):
+        assert click.Path().extensions is None
+        assert click.Path().convert("a.whatever", None, None) == "a.whatever"
+
+    def test_bytes_and_pathlike(self):
+        type = click.Path(extensions=[".csv"])
+        assert type.convert(b"a.csv", None, None) == b"a.csv"
+        assert type.convert(pathlib.Path("a.CSV"), None, None) == pathlib.Path("a.CSV")
+
+        with pytest.raises(click.BadParameter):
+            type.convert(b"a.txt", None, None)
+
+        with pytest.raises(click.BadParameter):
+            type.convert(pathlib.Path("a.txt"), None, None)
+
+    def test_directory_not_checked(self, tmp_path):
+        directory = tmp_path / "data"
+        directory.mkdir()
+        type = click.Path(extensions=[".csv"])
+        assert type.convert(os.fspath(directory), None, None) == os.fspath(directory)
+
+    def test_existing_file_checked(self, tmp_path):
+        good = tmp_path / "a.csv"
+        bad = tmp_path / "a.txt"
+        good.write_text("")
+        bad.write_text("")
+        type = click.Path(exists=True, extensions=[".csv"])
+        assert type.convert(os.fspath(good), None, None) == os.fspath(good)
+
+        with pytest.raises(click.BadParameter, match="extensions"):
+            type.convert(os.fspath(bad), None, None)
+
+    def test_missing_file_checked_without_exists(self, tmp_path):
+        type = click.Path(extensions=[".csv"])
+
+        with pytest.raises(click.BadParameter, match="extensions"):
+            type.convert(os.fspath(tmp_path / "missing.txt"), None, None)
+
+    def test_exists_error_comes_first(self, tmp_path):
+        type = click.Path(exists=True, extensions=[".csv"])
+
+        with pytest.raises(click.BadParameter, match="does not exist"):
+            type.convert(os.fspath(tmp_path / "missing.csv"), None, None)
+
+    def test_dash_not_checked(self):
+        type = click.Path(allow_dash=True, extensions=[".csv"])
+        assert type.convert("-", None, None) == "-"
+
+        with pytest.raises(click.BadParameter):
+            click.Path(extensions=[".csv"]).convert("-", None, None)
+
+    def test_resolve_path_checks_original_name(self, tmp_path):
+        target = tmp_path / "target.txt"
+        target.write_text("")
+        link = tmp_path / "link.csv"
+
+        try:
+            os.symlink(target, link)
+        except OSError:
+            pytest.skip("symlinks not supported")
+
+        type = click.Path(extensions=[".csv"])
+        assert type.convert(os.fspath(link), None, None) == os.fspath(link)
+
+    @pytest.mark.parametrize("value", [[], (), set()])
+    def test_empty_rejected(self, value):
+        with pytest.raises(ValueError, match="extensions"):
+            click.Path(extensions=value)
+
+    @pytest.mark.parametrize("value", ["", ".", "a/b", "."])
+    def test_invalid_extension_rejected(self, value):
+        with pytest.raises(ValueError, match="Invalid extension"):
+            click.Path(extensions=[value])
+
+    @pytest.mark.parametrize("value", [".csv", b".csv"])
+    def test_bare_string_rejected(self, value):
+        with pytest.raises(TypeError):
+            click.Path(extensions=value)
+
+    @pytest.mark.parametrize("value", [[1], [None], [b".csv"]])
+    def test_non_str_item_rejected(self, value):
+        with pytest.raises(TypeError):
+            click.Path(extensions=value)
+
+    def test_generator_accepted(self):
+        type = click.Path(extensions=(e for e in ["csv", "tsv"]))
+        assert type.extensions == (".csv", ".tsv")
+
+    def test_info_dict(self):
+        assert click.Path(extensions=["CSV"]).to_info_dict()["extensions"] == [".csv"]
+
+    def test_cli(self, runner):
+        @click.command()
+        @click.argument("f", type=click.Path(extensions=[".csv", ".tsv"]))
+        def cli(f):
+            click.echo(f)
+
+        assert runner.invoke(cli, ["x.TSV"]).output == "x.TSV\n"
+        result = runner.invoke(cli, ["x.json"])
+        assert result.exit_code == 2
+        assert "must have one of the extensions: .csv, .tsv." in result.output
