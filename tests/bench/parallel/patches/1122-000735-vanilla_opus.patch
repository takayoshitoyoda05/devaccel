     def get_invalid_choice_message(self, value: t.Any, ctx: Context | None) -> str:
         """Get the error message when the given choice is invalid.
 
+        If the value is close to one or more choices, a "Did you mean"
+        suggestion is appended.
+
         :param value: The invalid value.
 
+        .. versionchanged:: 8.6
+            Suggest close matches for the invalid value.
+
         .. versionadded:: 8.2
         """
-        choices_str = ", ".join(map(repr, self._normalized_mapping(ctx=ctx).values()))
-        return ngettext(
+        normalized_choices = list(self._normalized_mapping(ctx=ctx).values())
+        choices_str = ", ".join(map(repr, normalized_choices))
+        message = ngettext(
             "{value!r} is not {choice}.",
             "{value!r} is not one of {choices}.",
             len(self.choices),
         ).format(value=value, choice=choices_str, choices=choices_str)
 
+        from difflib import get_close_matches
+
+        possibilities = get_close_matches(
+            self.normalize_choice(choice=value, ctx=ctx), normalized_choices
+        )
+
+        if possibilities:
+            message = f"{message} {_format_possibilities(possibilities)}"
+
+        return message
+
     def __repr__(self) -> str:
         return _("Choice({choices})").format(choices=list(self.choices))
 
diff --git a/tests/test_types/test_Choice.py b/tests/test_types/test_Choice.py
index c34f516..bcb3afc 100644
--- a/tests/test_types/test_Choice.py
+++ b/tests/test_types/test_Choice.py
@@ -1,3 +1,7 @@
+import enum
+
+import pytest
+
 import click
 
 
@@ -5,3 +9,77 @@ def test_choice_get_invalid_choice_message():
     choice = click.Choice(["a", "b", "c"])
     message = choice.get_invalid_choice_message("d", ctx=None)
     assert message == "'d' is not one of 'a', 'b', 'c'."
+
+
+def test_choice_invalid_message_suggests_single_match():
+    choice = click.Choice(["apple", "banana", "cherry"])
+    message = choice.get_invalid_choice_message("banan", ctx=None)
+    assert message == (
+        "'banan' is not one of 'apple', 'banana', 'cherry'. Did you mean 'banana'?"
+    )
+
+
+def test_choice_invalid_message_suggests_multiple_matches():
+    choice = click.Choice(["build", "built", "deploy"])
+    message = choice.get_invalid_choice_message("buil", ctx=None)
+    assert message == (
+        "'buil' is not one of 'build', 'built', 'deploy'."
+        " (Did you mean one of: 'build', 'built'?)"
+    )
+
+
+def test_choice_invalid_message_single_choice_suggestion():
+    choice = click.Choice(["json"])
+    message = choice.get_invalid_choice_message("jsno", ctx=None)
+    assert message == "'jsno' is not 'json'. Did you mean 'json'?"
+
+
+@pytest.mark.parametrize(
+    ("case_sensitive", "value", "expected_suffix"),
+    [
+        # Case-insensitive matching compares casefolded values.
+        (False, "BANAN", " Did you mean 'banana'?"),
+        (True, "Banan", " Did you mean 'Banana'?"),
+    ],
+)
+def test_choice_invalid_message_suggestion_uses_normalized_value(
+    case_sensitive, value, expected_suffix
+):
+    choice = click.Choice(["Apple", "Banana"], case_sensitive=case_sensitive)
+    message = choice.get_invalid_choice_message(value, ctx=None)
+    assert message.endswith(expected_suffix)
+
+
+def test_choice_invalid_message_suggests_enum_member():
+    class Color(enum.Enum):
+        RED = 1
+        GREEN = 2
+
+    choice = click.Choice(Color)
+    message = choice.get_invalid_choice_message("GRENE", ctx=None)
+    assert message == "'GRENE' is not one of 'RED', 'GREEN'. Did you mean 'GREEN'?"
+
+
+def test_choice_invalid_value_cli_error_suggests(runner):
+    @click.command()
+    @click.option("--method", type=click.Choice(["foo", "bar", "baz"]))
+    def cli(method):
+        click.echo(method)
+
+    result = runner.invoke(cli, ["--method", "bax"])
+    assert result.exit_code == 2
+    assert (
+        "Invalid value for '--method': 'bax' is not one of 'foo', 'bar', 'baz'."
+        " (Did you mean one of: 'bar', 'baz'?)"
+    ) in result.output
+
+
+def test_choice_invalid_value_cli_error_no_suggestion(runner):
+    @click.command()
+    @click.option("--method", type=click.Choice(["foo", "bar", "baz"]))
+    def cli(method):
+        click.echo(method)
+
+    result = runner.invoke(cli, ["--method", "meh"])
+    assert result.exit_code == 2
+    assert "Did you mean" not in result.output
