--- /dev/null
+++ b/src/kakeibo/month_series.py
@@ -0,0 +1,67 @@
+"""月の系列を前月と組にする純粋関数。
+
+標準ライブラリのみ。`kakeibo.core` や他の件は import しない。
+"""
+
+import re
+
+_MONTH_RE = re.compile(r"([0-9]{4})-(0[1-9]|1[0-2])")
+
+
+def _parse(month: object) -> tuple[int, int]:
+    """`"YYYY-MM"` を (年, 月) に変換する。形式が違えば ValueError。"""
+    if not isinstance(month, str):
+        raise TypeError(f"month は str である必要があります: {month!r}")
+    m = _MONTH_RE.fullmatch(month)
+    if m is None:
+        raise ValueError(f"月の書き方が不正です(YYYY-MM のみ): {month!r}")
+    return int(m.group(1)), int(m.group(2))
+
+
+def _format(year: int, month: int) -> str:
+    return f"{year:04d}-{month:02d}"
+
+
+def previous_month(month: str) -> str:
+    """`"YYYY-MM"` の前月を `"YYYY-MM"` で返す。"""
+    year, mon = _parse(month)
+    if mon > 1:
+        return _format(year, mon - 1)
+    if year <= 1:
+        raise ValueError(f"前月が存在しません: {month!r}")
+    return _format(year - 1, 12)
+
+
+def _next_month(year: int, mon: int) -> tuple[int, int]:
+    if mon < 12:
+        return year, mon + 1
+    return year + 1, 1
+
+
+def month_pairs(
+    totals: dict[str, dict[str, int]],
+) -> list[tuple[str, dict[str, int], dict[str, int]]]:
+    """月別合計を `(月, 前月の dict, その月の dict)` の組にして月の昇順で返す。
+
+    最小の月は前月が無いので含めない。最小〜最大の間に無い月は `{}` として埋める。
+    入力は変更せず、返す dict はコピーにする。
+    """
+    if not isinstance(totals, dict):
+        raise TypeError(f"totals は dict である必要があります: {type(totals).__name__}")
+    parsed = {_parse(k): v for k, v in totals.items()}
+    if len(parsed) < 2:
+        return []
+
+    keys = sorted(parsed)
+    first, last = keys[0], keys[-1]
+
+    series: list[tuple[str, dict[str, int]]] = []
+    year, mon = first
+    while (year, mon) <= last:
+        data = parsed.get((year, mon), {})
+        series.append((_format(year, mon), dict(data)))
+        year, mon = _next_month(year, mon)
+
+    return [
+        (series[i][0], series[i - 1][1], series[i][1]) for i in range(1, len(series))
+    ]
diff --git a/tests/test_category_change.py b/tests/test_category_change.py
new file mode 100644
index 0000000..ef2522d
