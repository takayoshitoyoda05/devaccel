@@ -0,0 +1,28 @@
+# monthly-change
+目的: 月ごとのカテゴリ別支出の前月比(増えた・減った・新しく出てきた・なくなった)を出す純粋関数。 / やらないこと: CLI・既存ファイルの変更、CSV 読込、表示整形、件どうしの import。
+共通前提: 標準ライブラリのみ・既存ファイル不変・月別カテゴリ合計は既存の `kakeibo.core.monthly_totals`(`dict[str, dict[str, int]]`、`"YYYY-MM"` → `{category: yen}`)をそのまま使い、新しく作らない。件のコードは `kakeibo.core` も他の件も import しない(型は組み込みの dict・int・str のみ)。
+判断一覧:
+- D1 状態は有無で決める: 前月にキーが無く今月にある=`new`、前月にあり今月に無い=`gone`、両方にある=差が正で `increased`・負で `decreased`・0 で `unchanged`。金額 0 のキーも「ある」とみなす。
+- D2 `delta = cur - prev`(キーが無い側は 0)。負の金額(返金)も受ける。
+- D3 `pct` は前月が 0 以下またはキー無しなら `None`、それ以外は `(cur - prev) / prev * 100`(float、丸めない)。
+- D4 並びは `abs(delta)` の降順、同点はカテゴリ名の昇順。`unchanged` も結果に含める(絞るのは呼び出し側)。
+- D5 引数: dict 以外は `TypeError`、値が `bool`・`float`・`str`・`None` なら `TypeError`(引数名とカテゴリを文に入れる)。`int` なら負も 0 も受ける。
+- D6 月の系列: 途中の月がデータに無ければ空の月(カテゴリ無し)として埋める(1 月にあって 2 月に無ければ 2 月に `gone`)。最初の月は比べる相手が無いので前月比に含めない。
+
+1. `src/kakeibo/category_change.py` + `tests/test_category_change.py` — `@dataclass(frozen=True) class CategoryChange: category: str; prev: int; cur: int; delta: int; pct: float | None; status: str` と `def compare_categories(prev: dict[str, int], cur: dict[str, int]) -> list[CategoryChange]`
+規則: R1 受け付ける書き方: `{}`(空の月)・`{"食費": 0}`・`{"返金": -500}`。`prev`・`cur` は呼び出し側の dict を変更しない。 / R2 並びは `abs(delta)` 降順、同点はカテゴリ名昇順。 / R3 もし dict でない・値が int でない(bool 含む)なら `TypeError`。 / R4 キーが無い側の `prev`・`cur` は 0 として `CategoryChange` に入れる。`status` は `"new" "gone" "increased" "decreased" "unchanged"` のいずれか。
+例:
+| ID | 入力 | 出力 / 例外 | 規則 |
+| E1-1 | prev={"食費":100}, cur={} | [CategoryChange("食費",100,0,-100,-100.0,"gone")] | R4 |
+| E1-2 | prev={}, cur={"食費":0} | [CategoryChange("食費",0,0,0,None,"new")] | R4 |
+| E1-3 | prev={"a":1}, cur={"a":True} | TypeError | R3 |
+
+2. `src/kakeibo/month_series.py` + `tests/test_month_series.py` — `def previous_month(month: str) -> str` と `def month_pairs(totals: dict[str, dict[str, int]]) -> list[tuple[str, dict[str, int], dict[str, int]]]`
+規則: R1 受け付ける月の書き方: `"2026-01"` `"2026-12"` のみ(`"2026-1"`・`"2026/01"`・`"２０２６-０１"`・前後の空白は `ValueError`、月名を文に入れる)。 / R2 `previous_month("2026-01")` は `"2025-12"`。 / R3 `month_pairs` は `(month, 前月の dict, その月の dict)` を月の昇順で返し、最小の月は含めない。最小〜最大の間に無い月は `{}` として埋めて 1 か月ずつ並べる(D6)。入力の dict は変更しない(コピーを返す)。 / R4 空の入力・月が 1 つだけなら `[]`。dict でない・月が `str` でないなら `TypeError`。
+例:
+| ID | 入力 | 出力 / 例外 | 規則 |
+| E2-1 | {"2026-01":{"a":1},"2026-03":{"a":2}} | [("2026-02",{"a":1},{}),("2026-03",{},{"a":2})] | R3 |
+| E2-2 | previous_month("2026-1") | ValueError | R1 |
+| E2-3 | {"2026-01":{"a":1}} | [] | R4 |
+
+<!-- end -->
diff --git a/src/kakeibo/category_change.py b/src/kakeibo/category_change.py
new file mode 100644
index 0000000..0a17c06
--- /dev/null
+++ b/src/kakeibo/category_change.py
@@ -0,0 +1,62 @@
+"""前月比のカテゴリ別増減を求める純粋関数。"""
+
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    prev: int
+    cur: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(name: str, month: object) -> None:
+    if not isinstance(month, dict):
+        raise TypeError(f"{name} must be a dict, got {type(month).__name__}")
+    for category, amount in month.items():
+        if isinstance(amount, bool) or not isinstance(amount, int):
+            raise TypeError(
+                f"{name}[{category!r}] must be int, got {type(amount).__name__}"
+            )
+
+
+def compare_categories(
+    prev: dict[str, int], cur: dict[str, int]
+) -> list[CategoryChange]:
+    """前月 (prev) と今月 (cur) のカテゴリ別金額を比べる。
+
+    キーが無い側は 0 として扱う。状態はキーの有無と差の符号で決める。
+    結果は abs(delta) の降順、同点はカテゴリ名の昇順。
+    """
+    _check_month("prev", prev)
+    _check_month("cur", cur)
+
+    result: list[CategoryChange] = []
+    for category in set(prev) | set(cur):
+        in_prev = category in prev
+        in_cur = category in cur
+        p = prev.get(category, 0)
+        c = cur.get(category, 0)
+        delta = c - p
+
+        if in_prev and in_cur:
+            if delta > 0:
+                status = "increased"
+            elif delta < 0:
+                status = "decreased"
+            else:
+                status = "unchanged"
+        elif in_cur:
+            status = "new"
+        else:
+            status = "gone"
+
+        pct = None if (not in_prev or p <= 0) else delta / p * 100
+
+        result.append(CategoryChange(category, p, c, delta, pct, status))
+
+    result.sort(key=lambda item: (-abs(item.delta), item.category))
+    return result
diff --git a/src/kakeibo/month_series.py b/src/kakeibo/month_series.py
