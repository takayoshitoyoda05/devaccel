+from typing import Any
+
+import pytest
+
+from kakeibo.month_series import month_pairs, previous_month
+
+# --- 例の表 (E2-*) ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("totals", "expected"),
+    [
+        pytest.param(
+            {"2026-01": {"a": 1}, "2026-03": {"a": 2}},
+            [("2026-02", {"a": 1}, {}), ("2026-03", {}, {"a": 2})],
+            id="E2-1",
+        ),
+    ],
+)
+def test_e2_gap_filled_with_empty_month(totals, expected):
+    assert month_pairs(totals) == expected
+
+
+@pytest.mark.parametrize(
+    "month",
+    [pytest.param("2026-1", id="E2-2")],
+)
+def test_e2_non_padded_month_rejected(month):
+    with pytest.raises(ValueError):
+        previous_month(month)
+
+
+@pytest.mark.parametrize(
+    "totals",
+    [pytest.param({"2026-01": {"a": 1}}, id="E2-3")],
+)
+def test_e2_single_month_gives_empty(totals):
+    assert month_pairs(totals) == []
+
+
+# --- R1: 月の書き方 --------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "month",
+    [
+        pytest.param("2026/01", id="R1-slash"),
+        pytest.param("２０２６-０１", id="R1-fullwidth"),
+        pytest.param(" 2026-01", id="R1-leading-space"),
+        pytest.param("2026-01 ", id="R1-trailing-space"),
+        pytest.param("2026-01\n", id="R1-trailing-newline"),
+        pytest.param("2026-13", id="R1-month-13"),
+        pytest.param("2026-00", id="R1-month-00"),
+        pytest.param("", id="R1-empty"),
+    ],
+)
+def test_r1_invalid_month_format_rejected(month):
+    with pytest.raises(ValueError, match="不正"):
+        previous_month(month)
+
+
+def test_r1_error_message_contains_month():
+    with pytest.raises(ValueError, match="2026/01"):
+        previous_month("2026/01")
+
+
+@pytest.mark.parametrize(
+    "month",
+    [pytest.param(2026, id="R1-int")],
+)
+def test_r1_non_str_month_is_type_error(month):
+    with pytest.raises(TypeError):
+        previous_month(month)
+
+
+# --- R2: previous_month ----------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("month", "expected"),
+    [
+        pytest.param("2026-01", "2025-12", id="R2-year-boundary"),
+        pytest.param("2026-12", "2026-11", id="R2-december"),
+        pytest.param("2026-02", "2026-01", id="R2-normal"),
+        pytest.param("0002-01", "0001-12", id="R2-year-1"),
+    ],
+)
+def test_r2_previous_month(month, expected):
+    assert previous_month(month) == expected
+
+
+def test_r2_no_month_before_year_1():
+    with pytest.raises(ValueError):
+        previous_month("0001-01")
+
+
+# --- R3: month_pairs -------------------------------------------------------
+
+
+def test_r3_returns_copies_and_does_not_mutate_input():
+    totals = {"2026-01": {"a": 1}, "2026-02": {"a": 2}}
+    snapshot = {"2026-01": {"a": 1}, "2026-02": {"a": 2}}
+    pairs = month_pairs(totals)
+    assert totals == snapshot
+    assert pairs == [("2026-02", {"a": 1}, {"a": 2})]
+    pairs[0][1]["a"] = 999
+    pairs[0][2]["a"] = 999
+    assert totals == snapshot
+
+
+def test_r3_consecutive_months_in_ascending_order():
+    totals = {
+        "2026-11": {"x": 1},
+        "2026-12": {"x": 2},
+        "2027-01": {"x": 3},
+    }
+    assert month_pairs(totals) == [
+        ("2026-12", {"x": 1}, {"x": 2}),
+        ("2027-01", {"x": 2}, {"x": 3}),
+    ]
+
+
+def test_r3_input_order_does_not_matter():
+    totals = {"2026-03": {"a": 2}, "2026-01": {"a": 1}}
+    assert month_pairs(totals) == [
+        ("2026-02", {"a": 1}, {}),
+        ("2026-03", {}, {"a": 2}),
+    ]
+
+
+def test_r3_minimum_month_not_included_as_current():
+    pairs = month_pairs({"2026-05": {}, "2026-06": {}})
+    assert [m for m, _, _ in pairs] == ["2026-06"]
+
+
+def test_r3_gap_across_year_boundary():
+    totals = {"2025-11": {"a": 1}, "2026-02": {"a": 4}}
+    assert month_pairs(totals) == [
+        ("2025-12", {"a": 1}, {}),
+        ("2026-01", {}, {}),
+        ("2026-02", {}, {"a": 4}),
+    ]
+
+
+def test_r3_zero_and_negative_amounts_kept():
+    totals = {"2026-01": {"a": 0}, "2026-02": {"a": -5}}
+    assert month_pairs(totals) == [("2026-02", {"a": 0}, {"a": -5})]
+
+
+def test_r3_invalid_key_rejected():
+    with pytest.raises(ValueError):
+        month_pairs({"2026-1": {}, "2026-02": {}})
+
+
+# --- R4: 空・1 か月・型 ----------------------------------------------------
+
+
+def test_r4_empty_input_gives_empty_list():
+    assert month_pairs({}) == []
+
+
+def test_r4_single_month_with_empty_value_gives_empty_list():
+    assert month_pairs({"2026-01": {}}) == []
+
+
+@pytest.mark.parametrize(
+    "totals",
+    [
+        pytest.param([("2026-01", {})], id="R4-list"),
+        pytest.param(None, id="R4-none"),
+        pytest.param("2026-01", id="R4-str"),
+    ],
+)
+def test_r4_non_dict_is_type_error(totals):
+    with pytest.raises(TypeError):
+        month_pairs(totals)
+
+
+def test_r4_non_str_month_key_is_type_error():
+    bad: Any = {202601: {"a": 1}, 202602: {"a": 2}}
+    with pytest.raises(TypeError):
+        month_pairs(bad)
