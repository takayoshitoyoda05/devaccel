@@ -0,0 +1,142 @@
+import dataclasses
+
+import pytest
+
+from kakeibo.category_change import CategoryChange, compare_categories
+
+
+# 例の表 E1-*
+@pytest.mark.parametrize(
+    ("prev", "cur", "expected"),
+    [
+        pytest.param(
+            {"食費": 100},
+            {},
+            [CategoryChange("食費", 100, 0, -100, -100.0, "gone")],
+            id="E1-1",
+        ),
+        pytest.param(
+            {},
+            {"食費": 0},
+            [CategoryChange("食費", 0, 0, 0, None, "new")],
+            id="E1-2",
+        ),
+    ],
+)
+def test_example_table(prev, cur, expected):
+    assert compare_categories(prev, cur) == expected
+
+
+@pytest.mark.parametrize(
+    ("prev", "cur"),
+    [
+        pytest.param({"a": 1}, {"a": True}, id="E1-3"),
+    ],
+)
+def test_example_error_table(prev, cur):
+    with pytest.raises(TypeError):
+        compare_categories(prev, cur)
+
+
+# 端のケース(仕様の文面から)
+
+
+def test_empty_months_give_empty_list():
+    assert compare_categories({}, {}) == []
+
+
+def test_increased():
+    assert compare_categories({"食費": 100}, {"食費": 150}) == [
+        CategoryChange("食費", 100, 150, 50, 50.0, "increased")
+    ]
+
+
+def test_decreased():
+    assert compare_categories({"食費": 200}, {"食費": 150}) == [
+        CategoryChange("食費", 200, 150, -50, -25.0, "decreased")
+    ]
+
+
+def test_unchanged_is_included():
+    assert compare_categories({"食費": 100}, {"食費": 100}) == [
+        CategoryChange("食費", 100, 100, 0, 0.0, "unchanged")
+    ]
+
+
+def test_zero_on_both_sides_is_unchanged_not_new_or_gone():
+    assert compare_categories({"食費": 0}, {"食費": 0}) == [
+        CategoryChange("食費", 0, 0, 0, None, "unchanged")
+    ]
+
+
+def test_zero_prev_with_positive_cur_is_new_with_pct_none():
+    assert compare_categories({"食費": 0}, {"食費": 300}) == [
+        CategoryChange("食費", 0, 300, 300, None, "increased")
+    ]
+
+
+def test_negative_prev_pct_is_none():
+    assert compare_categories({"返金": -500}, {"返金": -200}) == [
+        CategoryChange("返金", -500, -200, 300, None, "increased")
+    ]
+
+
+def test_negative_amount_is_accepted():
+    assert compare_categories({}, {"返金": -500}) == [
+        CategoryChange("返金", 0, -500, -500, None, "new")
+    ]
+
+
+def test_pct_is_not_rounded():
+    result = compare_categories({"食費": 3}, {"食費": 4})
+    assert result[0].pct == pytest.approx(100 / 3)
+    assert result[0].pct != round(100 / 3)
+
+
+def test_sorted_by_abs_delta_desc_then_category_asc():
+    prev = {"b": 100, "a": 100, "c": 0, "d": 500}
+    cur = {"b": 200, "a": 0, "c": 100, "d": 500}
+    # |delta|: a=100, b=100, c=100, d=0 -> 同点はカテゴリ名昇順
+    result = compare_categories(prev, cur)
+    assert [c.category for c in result] == ["a", "b", "c", "d"]
+
+
+def test_sort_uses_absolute_delta():
+    prev = {"x": 1000, "y": 0}
+    cur = {"x": 0, "y": 150}
+    # |delta| x=1000, y=150
+    result = compare_categories(prev, cur)
+    assert [c.category for c in result] == ["x", "y"]
+
+
+def test_inputs_are_not_mutated():
+    prev = {"食費": 100}
+    cur = {"食費": 50, "交通": 10}
+    compare_categories(prev, cur)
+    assert prev == {"食費": 100}
+    assert cur == {"食費": 50, "交通": 10}
+
+
+def test_result_is_frozen_dataclass():
+    item = compare_categories({"食費": 1}, {"食費": 2})[0]
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        item.delta = 99  # type: ignore[misc]
+
+
+# エラー (R3 / D5)
+
+
+@pytest.mark.parametrize("bad", [None, [], 1.5, "x"])
+def test_non_dict_argument_raises_type_error(bad):
+    with pytest.raises(TypeError):
+        compare_categories(bad, {})  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        compare_categories({}, bad)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad", [1.0, "100", None, True, False])
+def test_non_int_value_raises_type_error(bad):
+    with pytest.raises(TypeError):
+        compare_categories({"食費": bad}, {})  # type: ignore[dict-item]
+    with pytest.raises(TypeError):
+        compare_categories({}, {"食費": bad})  # type: ignore[dict-item]
