@@ -0,0 +1,60 @@
+import json
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.export import to_json
+
+
+def test_to_json_exact_output_with_key_order():
+    rows = [Expense(date(2026, 11, 1), "食費", 1200, "ランチ")]
+    assert to_json(rows) == (
+        '[{"date": "2026-11-01", "category": "食費", "amount": 1200, "memo": "ランチ"}]'
+    )
+
+
+def test_to_json_empty_list_is_empty_array():
+    assert to_json([]) == "[]"
+
+
+def test_to_json_preserves_input_order():
+    rows = [
+        Expense(date(2026, 11, 3), "b", 3),
+        Expense(date(2026, 11, 1), "a", 1),
+        Expense(date(2026, 11, 2), "c", 2),
+    ]
+    parsed = json.loads(to_json(rows))
+    assert [r["date"] for r in parsed] == ["2026-11-03", "2026-11-01", "2026-11-02"]
+
+
+def test_to_json_does_not_escape_non_ascii():
+    rows = [Expense(date(2026, 11, 1), "交通費", 500, "電車")]
+    out = to_json(rows)
+    assert "交通費" in out
+    assert "\\u" not in out
+
+
+def test_to_json_empty_memo_is_empty_string_not_omitted():
+    rows = [Expense(date(2026, 11, 1), "食費", 100)]
+    parsed = json.loads(to_json(rows))
+    assert parsed == [
+        {"date": "2026-11-01", "category": "食費", "amount": 100, "memo": ""}
+    ]
+
+
+def test_to_json_amount_is_integer_and_date_is_zero_padded():
+    rows = [Expense(date(2026, 1, 5), "雑費", 7, "")]
+    parsed = json.loads(to_json(rows))
+    assert parsed[0]["amount"] == 7
+    assert isinstance(parsed[0]["amount"], int)
+    assert parsed[0]["date"] == "2026-01-05"
+
+
+def test_to_json_has_no_indentation():
+    rows = [Expense(date(2026, 11, 1), "食費", 100, "x")]
+    assert "\n" not in to_json(rows)
+
+
+def test_to_json_escapes_quotes_in_memo():
+    rows = [Expense(date(2026, 11, 1), "食費", 100, 'say "hi"')]
+    parsed = json.loads(to_json(rows))
+    assert parsed[0]["memo"] == 'say "hi"'
