@@ -0,0 +1,41 @@
+import pytest
+
+from kakeibo.split import split_evenly
+
+
+def test_exact_division_gives_equal_shares():
+    assert split_evenly(900, 3) == [300, 300, 300]
+
+
+def test_remainder_goes_one_yen_each_to_leading_people():
+    assert split_evenly(10, 3) == [4, 3, 3]
+
+
+def test_remainder_of_two_goes_to_first_two():
+    assert split_evenly(11, 4) == [3, 3, 3, 2]
+
+
+def test_amount_smaller_than_people_gives_ones_then_zeros():
+    assert split_evenly(2, 5) == [1, 1, 0, 0, 0]
+
+
+def test_zero_amount_gives_all_zeros():
+    assert split_evenly(0, 3) == [0, 0, 0]
+
+
+def test_one_person_gets_whole_amount():
+    assert split_evenly(1234, 1) == [1234]
+
+
+@pytest.mark.parametrize("amount", [0, 1, 7, 999, 1000, 12345])
+@pytest.mark.parametrize("people", [1, 2, 3, 7, 10])
+def test_sum_always_equals_amount_and_length_is_people(amount, people):
+    shares = split_evenly(amount, people)
+    assert len(shares) == people
+    assert sum(shares) == amount
+
+
+@pytest.mark.parametrize("people", [0, -1])
+def test_people_less_than_one_raises_value_error(people):
+    with pytest.raises(ValueError):
+        split_evenly(100, people)
