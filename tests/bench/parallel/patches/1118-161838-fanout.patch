index 0000000..1b6bb5d
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,158 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+@pytest.mark.parametrize(
+    "src, expected",
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2024, 1, 31), date(2024, 2, 29)),
+        (date(2026, 12, 15), date(2027, 1, 15)),
+        (date(2026, 12, 31), date(2027, 1, 31)),
+        (date(2026, 3, 31), date(2026, 4, 30)),
+        (date(2026, 11, 18), date(2026, 12, 18)),
+    ],
+)
+def test_add_month(src, expected):
+    assert add_month(src) == expected
+
+
+def _e(day, amount=1000, category="subscription", memo=""):
+    return Expense(date.fromisoformat(day), category, amount, memo)
+
+
+def test_rejects_bad_arguments():
+    rows = [_e("2026-01-01")]
+    with pytest.raises(ValueError):
+        find_recurring(rows, min_count=1)
+    with pytest.raises(ValueError):
+        find_recurring(rows, min_count=0)
+    with pytest.raises(ValueError):
+        find_recurring(rows, tolerance=-1)
+
+
+def test_empty_input_returns_empty():
+    assert find_recurring([]) == []
+
+
+def test_min_count_two_is_allowed():
+    rows = [_e("2026-01-05"), _e("2026-02-05")]
+    assert find_recurring(rows, min_count=2) == [
+        Recurring(
+            "subscription", 1000, (date(2026, 1, 5), date(2026, 2, 5)), date(2026, 3, 5)
+        )
+    ]
+    assert find_recurring(rows) == []  # default min_count=3
+
+
+def test_monthly_detects_with_next_expected():
+    rows = [_e("2026-01-10"), _e("2026-02-10"), _e("2026-03-10")]
+    assert find_recurring(rows) == [
+        Recurring(
+            "subscription",
+            1000,
+            (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10)),
+            date(2026, 4, 10),
+        )
+    ]
+
+
+def test_memo_is_ignored_for_grouping():
+    rows = [
+        _e("2026-01-10", memo="a"),
+        _e("2026-02-10", memo="b"),
+        _e("2026-03-10", memo=""),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].amount == 1000
+
+
+def test_different_amount_or_category_are_separate_groups():
+    rows = [
+        _e("2026-01-10", amount=1000),
+        _e("2026-02-10", amount=1000),
+        _e("2026-03-10", amount=2000),
+        _e("2026-01-10", amount=1000, category="other"),
+        _e("2026-02-10", amount=1000, category="other"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_duplicate_dates_count_once():
+    rows = [_e("2026-01-10"), _e("2026-01-10"), _e("2026-02-10")]
+    assert find_recurring(rows) == []
+
+
+def test_input_order_does_not_matter():
+    rows = [_e("2026-03-10"), _e("2026-01-10"), _e("2026-02-10")]
+    assert find_recurring(rows)[0].days == (
+        date(2026, 1, 10),
+        date(2026, 2, 10),
+        date(2026, 3, 10),
+    )
+
+
+def test_tolerance_boundary():
+    # expected next after 2026-01-10 is 2026-02-10
+    ok = [_e("2026-01-10"), _e("2026-02-13"), _e("2026-03-13")]  # off by +3 days
+    assert len(find_recurring(ok, tolerance=3)) == 1
+    too_far = [_e("2026-01-10"), _e("2026-02-14"), _e("2026-03-14")]  # off by +4 days
+    assert find_recurring(too_far, tolerance=3) == []
+    assert len(find_recurring(too_far, tolerance=4)) == 1
+
+
+def test_tolerance_zero_requires_exact_month_day():
+    rows = [_e("2026-01-10"), _e("2026-02-11"), _e("2026-03-11")]
+    assert find_recurring(rows, tolerance=0) == []
+
+
+def test_gap_splits_runs_and_short_runs_are_dropped():
+    # run A: 2 items (too short), gap, run B: 3 items (kept)
+    rows = [
+        _e("2026-01-10"),
+        _e("2026-02-10"),
+        _e("2026-06-10"),
+        _e("2026-07-10"),
+        _e("2026-08-10"),
+    ]
+    assert find_recurring(rows) == [
+        Recurring(
+            "subscription",
+            1000,
+            (date(2026, 6, 10), date(2026, 7, 10), date(2026, 8, 10)),
+            date(2026, 9, 10),
+        )
+    ]
+
+
+def test_gap_splits_into_two_reported_runs():
+    rows = [
+        _e("2026-01-10"),
+        _e("2026-02-10"),
+        _e("2026-03-10"),
+        _e("2026-08-10"),
+        _e("2026-09-10"),
+        _e("2026-10-10"),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 10), date(2026, 8, 10)]
+    assert result[0].next_expected == date(2026, 4, 10)
+    assert result[1].next_expected == date(2026, 11, 10)
+
+
+def test_result_sorted_by_category_amount_first_day():
+    rows = []
+    for cat, amt in [("b", 500), ("a", 900), ("a", 100)]:
+        for d in ("2026-01-10", "2026-02-10", "2026-03-10"):
+            rows.append(_e(d, amount=amt, category=cat))
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [
+        ("a", 100),
+        ("a", 900),
+        ("b", 500),
+    ]
diff --git a/tests/test_split.py b/tests/test_split.py
