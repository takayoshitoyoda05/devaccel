diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..1fbdcdb
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,149 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def E(y: int, m: int, cat: str, amount: int) -> Expense:
+    return Expense(date(y, m, 1), cat, amount)
+
+
+ROWS = [
+    E(2026, 10, "food", 1000),
+    E(2026, 10, "rent", 80000),
+    E(2026, 10, "fun", 500),
+    E(2026, 11, "food", 1300),
+    E(2026, 11, "rent", 80000),
+    E(2026, 11, "book", 700),
+    E(2026, 11, "misc", 0),  # 明細はあるが合計 0
+    E(2026, 9, "old", 100),  # 対象外の月
+]
+
+
+def test_month_diff_statuses_and_pct():
+    got = month_diff(ROWS, "2026-10", "2026-11")
+    assert got == [
+        DiffRow("book", 0, 700, 700, None, "new"),
+        DiffRow("fun", 500, 0, -500, -100.0, "gone"),
+        DiffRow("food", 1000, 1300, 300, 30.0, "up"),
+        DiffRow("misc", 0, 0, 0, None, "new"),
+        DiffRow("rent", 80000, 80000, 0, 0.0, "same"),
+    ]
+
+
+def test_sort_by_abs_delta_then_category():
+    rows = [
+        E(2026, 10, "b", 100),
+        E(2026, 11, "b", 200),  # +100
+        E(2026, 10, "a", 300),
+        E(2026, 11, "a", 0),  # -300
+        E(2026, 10, "c", 100),
+        E(2026, 11, "c", 0),  # -100
+    ]
+    cats = [d.category for d in month_diff(rows, "2026-10", "2026-11")]
+    assert cats == ["a", "b", "c"]
+
+
+def test_same_month_on_both_sides_is_all_same():
+    got = month_diff(ROWS, "2026-10", "2026-10")
+    assert [d.status for d in got] == ["same", "same", "same"]
+    assert all(d.delta == 0 for d in got)
+
+
+def test_empty_rows():
+    assert month_diff([], "2026-10", "2026-11") == []
+
+
+def test_zero_sum_prev_gives_none_pct_but_status_by_presence():
+    rows = [E(2026, 10, "x", 100), E(2026, 10, "x", -100), E(2026, 11, "x", 50)]
+    (d,) = month_diff(rows, "2026-10", "2026-11")
+    assert (d.prev, d.curr, d.delta, d.pct, d.status) == (0, 50, 50, None, "up")
+
+
+def test_zero_delta_with_negative_prev_is_plus_zero_pct():
+    rows = [E(2026, 10, "x", -200), E(2026, 11, "x", -200)]
+    (d,) = month_diff(rows, "2026-10", "2026-11")
+    assert d.status == "same"
+    assert d.pct == 0.0
+    assert render_diff([d]).split("\t")[-1] == "+0.0%"
+
+
+def test_month_format_rejected():
+    for bad in [
+        "2026-1",
+        "2026-13",
+        "2026-00",
+        "202611",
+        "2026/11",
+        " 2026-11",
+        "2026-11\n",
+        "２０２６-11",
+    ]:
+        with pytest.raises(ValueError):
+            month_diff(ROWS, bad, "2026-11")
+        with pytest.raises(ValueError):
+            month_diff(ROWS, "2026-10", bad)
+
+
+def test_top_movers_excludes_same_keeps_order_and_limits():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    assert [d.category for d in top_movers(diffs)] == ["book", "fun", "food"]
+    assert [d.category for d in top_movers(diffs, 1)] == ["book"]
+    assert top_movers(diffs, 0) == []
+    assert [d.category for d in top_movers(diffs, 10)] == [
+        "book",
+        "fun",
+        "food",
+        "misc",
+    ]
+    assert all(d.status != "same" for d in top_movers(diffs, 10))
+
+
+def test_top_movers_negative_n_rejected():
+    with pytest.raises(ValueError):
+        top_movers([], -1)
+
+
+def test_render_diff_format():
+    diffs = [
+        DiffRow("fun", 500, 0, -500, -100.0, "gone"),
+        DiffRow("book", 0, 700, 700, None, "new"),
+        DiffRow("rent", 80000, 80000, 0, 0.0, "same"),
+        DiffRow("food", 1000, 1200, 200, 20.0, "up"),
+    ]
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "fun\t500\t0\t-500\t-100.0%\n"
+        "book\t0\t700\t+700\t-\n"
+        "rent\t80000\t80000\t+0\t+0.0%\n"
+        "food\t1000\t1200\t+200\t+20.0%"
+    )
+
+
+def test_render_diff_empty_is_header_only_without_trailing_newline():
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_available_months_sorted_unique():
+    assert available_months(ROWS) == ["2026-09", "2026-10", "2026-11"]
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months():
+    assert latest_diff(ROWS) == month_diff(ROWS, "2026-10", "2026-11")
+
+
+def test_latest_diff_needs_two_months():
+    with pytest.raises(ValueError):
+        latest_diff([E(2026, 11, "food", 1)])
+    with pytest.raises(ValueError):
+        latest_diff([])
diff --git a/tests/test_query.py b/tests/test_query.py
