@@ -0,0 +1,82 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.weekday import total_by_weekday
+
+
+def _e(day: date, amount: int, category: str = "food") -> Expense:
+    return Expense(day=day, category=category, amount=amount)
+
+
+def test_empty_rows_returns_empty_dict() -> None:
+    assert total_by_weekday([]) == {}
+
+
+def test_single_row_gives_its_weekday_only() -> None:
+    # 2026-11-16 は月曜
+    assert total_by_weekday([_e(date(2026, 11, 16), 500)]) == {"Mon": 500}
+
+
+def test_weekday_names_for_each_day() -> None:
+    # 2026-11-16(月)〜 2026-11-22(日)
+    rows = [_e(date(2026, 11, 16 + i), 100 * (i + 1)) for i in range(7)]
+    assert total_by_weekday(rows) == {
+        "Mon": 100,
+        "Tue": 200,
+        "Wed": 300,
+        "Thu": 400,
+        "Fri": 500,
+        "Sat": 600,
+        "Sun": 700,
+    }
+
+
+def test_same_weekday_on_different_dates_is_summed() -> None:
+    rows = [
+        _e(date(2026, 11, 16), 300),  # 月
+        _e(date(2026, 11, 23), 200),  # 月
+        _e(date(2026, 11, 17), 50),  # 火
+    ]
+    assert total_by_weekday(rows) == {"Mon": 500, "Tue": 50}
+
+
+def test_multiple_rows_on_same_date_are_summed() -> None:
+    rows = [
+        _e(date(2026, 11, 18), 1000, "food"),
+        _e(date(2026, 11, 18), 250, "transport"),
+    ]
+    assert total_by_weekday(rows) == {"Wed": 1250}
+
+
+def test_weekdays_without_rows_are_omitted() -> None:
+    rows = [_e(date(2026, 11, 21), 900), _e(date(2026, 11, 16), 100)]  # 土・月
+    result = total_by_weekday(rows)
+    assert result == {"Mon": 100, "Sat": 900}
+    assert "Tue" not in result
+    assert "Sun" not in result
+
+
+def test_keys_are_in_monday_first_order_regardless_of_input_order() -> None:
+    rows = [
+        _e(date(2026, 11, 22), 7),  # 日
+        _e(date(2026, 11, 18), 3),  # 水
+        _e(date(2026, 11, 16), 1),  # 月
+        _e(date(2026, 11, 21), 6),  # 土
+    ]
+    result = total_by_weekday(rows)
+    assert list(result) == ["Mon", "Wed", "Sat", "Sun"]
+
+
+def test_zero_amount_row_still_creates_its_weekday_key() -> None:
+    # 明細がある曜日は金額が 0 でも含める
+    assert total_by_weekday([_e(date(2026, 11, 19), 0)]) == {"Thu": 0}
+
+
+def test_negative_amounts_are_summed_as_is() -> None:
+    rows = [_e(date(2026, 11, 16), 1000), _e(date(2026, 11, 23), -300)]
+    assert total_by_weekday(rows) == {"Mon": 700}
+
+
+def test_category_does_not_affect_grouping() -> None:
+    rows = [_e(date(2026, 11, 20), 100, "food"), _e(date(2026, 11, 20), 200, "rent")]
+    assert total_by_weekday(rows) == {"Fri": 300}
