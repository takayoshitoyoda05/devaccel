+++ b/src/kakeibo/weekday.py
@@ -0,0 +1,16 @@
+"""Aggregate expenses by day of week."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+_WEEKDAY_NAMES = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
+
+
+def total_by_weekday(rows: list[Expense]) -> dict[str, int]:
+    """{"Mon".."Sun": yen}; only weekdays with at least one row, Monday first."""
+    totals: dict[int, int] = {}
+    for e in rows:
+        idx = e.day.weekday()  # Mon=0 .. Sun=6
+        totals[idx] = totals.get(idx, 0) + e.amount
+    return {_WEEKDAY_NAMES[i]: totals[i] for i in sorted(totals)}
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..d5b3ecf
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,246 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+# --- parse_amount -----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥1200", 1200),
+        ("￥1,2,3", 123),  # カンマの位置は検査しない
+        ("-0", 0),
+        ("-1,000円", -1000),
+    ],
+)
+def test_parse_amount_accepts(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "   ",
+        "円",
+        "-",
+        "¥",
+        "12.5",
+        "1 200",
+        "--5",
+        "¥-5",
+        "-円",
+        "１２３",  # 全角数字
+        "¥円",
+        "5円円",
+        "5¥",
+        ",100",
+        "100 円",
+        "1000yen",
+    ],
+)
+def test_parse_amount_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+# --- parse_date -------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        ("2026/12/31", date(2026, 12, 31)),
+        (" 2026-1-5 ", date(2026, 1, 5)),
+        ("2024/02/29", date(2024, 2, 29)),  # うるう日
+    ],
+)
+def test_parse_date_accepts(text: str, expected: date) -> None:
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026/1-5",
+        "2026-1/5",
+        "26/1/5",
+        "2026/02/30",
+        "2025/02/29",
+        "2026/13/1",
+        "2026/1/0",
+        "2026/1/32",
+        "",
+        "2026",
+        "2026/1",
+        "2026/1/5/1",
+        "2026.1.5",
+        "２０２６/1/5",  # 全角数字
+        "2026/001/5",  # 月は 1〜2 桁
+        "20260105",
+    ],
+)
+def test_parse_date_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+# --- import_rows ------------------------------------------------------------
+
+HEADER = "利用日,分類,利用金額,利用店名"
+
+
+def test_default_mapping_values() -> None:
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_import_basic_rows_in_order() -> None:
+    text = f'{HEADER}\n2026/1/5,食費,"1,200",スーパーA\n2026-01-06,交通,￥300,駅\n'
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [
+        Expense(date(2026, 1, 5), "食費", 1200, "スーパーA"),
+        Expense(date(2026, 1, 6), "交通", 300, "駅"),
+    ]
+
+
+def test_quoted_comma_in_value() -> None:
+    text = f'{HEADER}\n2026/1/5,食費,100,"A, B店"\n'
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows[0].memo == "A, B店"
+
+
+def test_extra_columns_are_ignored() -> None:
+    text = "利用日,余分,分類,利用金額,利用店名,備考\n2026/1/5,x,食費,100,店,zzz\n"
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "店")]
+
+
+def test_strips_category_and_memo() -> None:
+    text = f"{HEADER}\n2026/1/5, 食費 ,100,  店  \n"
+    rows, _ = import_rows(text)
+    assert rows[0].category == "食費"
+    assert rows[0].memo == "店"
+
+
+def test_category_map_applies_after_strip() -> None:
+    text = f"{HEADER}\n2026/1/5, 食費 ,100,店\n2026/1/6,交通,200,駅\n"
+    rows, errors = import_rows(text, category_map={"食費": "Food", "交通": "Transit"})
+    assert errors == []
+    assert [e.category for e in rows] == ["Food", "Transit"]
+
+
+def test_category_map_missing_key_keeps_category() -> None:
+    text = f"{HEADER}\n2026/1/5,娯楽,100,店\n"
+    rows, _ = import_rows(text, category_map={"食費": "Food"})
+    assert rows[0].category == "娯楽"
+
+
+def test_empty_lines_skipped_but_counted() -> None:
+    text = f"{HEADER}\n\n2026/1/5,食費,100,店\n\n2026/1/x,食費,100,店\n"
+    rows, errors = import_rows(text)
+    assert [e.day for e in rows] == [date(2026, 1, 5)]  # 行 3 は有効
+    assert errors == [(5, "date")]  # 空行を数えるので不正行は物理行 5
+
+
+def test_error_line_numbers_are_physical() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,100,店\n2026/1/5,食費,abc,店\n"
+    rows, errors = import_rows(text)
+    assert [e.day for e in rows] == [date(2026, 1, 5)]
+    assert errors == [(3, "amount")]
+
+
+def test_multiple_errors_recorded_in_order_date_amount_category() -> None:
+    text = f"{HEADER}\nbad,  ,xx,店\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "date"), (2, "amount"), (2, "category")]
+
+
+def test_row_with_amount_and_category_errors() -> None:
+    text = f"{HEADER}\n2026/1/5,   ,12.5,店\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "amount"), (2, "category")]
+
+
+def test_row_with_error_excluded_others_kept() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,100,A\n2026/1/6,,100,B\n2026/1/7,食費,200,C\n"
+    rows, errors = import_rows(text)
+    assert [e.memo for e in rows] == ["A", "C"]
+    assert errors == [(3, "category")]
+
+
+def test_short_row_missing_values_treated_as_empty() -> None:
+    text = f"{HEADER}\n2026/1/5,食費\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "amount")]
+
+
+def test_short_row_missing_memo_gives_empty_memo() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,100\n"
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+def test_memo_optional_in_mapping() -> None:
+    mapping = {"date": "利用日", "category": "分類", "amount": "利用金額"}
+    text = f"{HEADER}\n2026/1/5,食費,100,店\n"
+    rows, errors = import_rows(text, mapping=mapping)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+def test_custom_mapping_column_names() -> None:
+    mapping = {"date": "D", "category": "C", "amount": "A", "memo": "M"}
+    text = "D,C,A,M\n2026/1/5,食費,100,店\n"
+    rows, errors = import_rows(text, mapping=mapping)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "店")]
+
+
+@pytest.mark.parametrize("missing_key", ["date", "category", "amount"])
+def test_mapping_missing_required_key_raises(missing_key: str) -> None:
+    mapping = dict(DEFAULT_MAPPING)
+    del mapping[missing_key]
+    with pytest.raises(ValueError):
+        import_rows(f"{HEADER}\n", mapping=mapping)
+
+
+def test_mapping_column_absent_from_header_raises() -> None:
+    text = "利用日,分類,利用店名\n2026/1/5,食費,店\n"
+    with pytest.raises(ValueError):
+        import_rows(text)
+
+
+def test_mapping_memo_column_absent_from_header_raises() -> None:
+    text = "利用日,分類,利用金額\n2026/1/5,食費,100\n"
+    with pytest.raises(ValueError):
+        import_rows(text)
+
+
+def test_default_mapping_used_when_none() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,100,店\n"
+    rows, _ = import_rows(text, mapping=None)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "店")]
