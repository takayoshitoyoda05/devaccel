@@ -0,0 +1,86 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.streak import longest_no_spend_streak
+
+
+def _e(day: date, amount: int = 100) -> Expense:
+    return Expense(day=day, category="food", amount=amount, memo="")
+
+
+D = date
+
+
+def test_no_rows_returns_full_range_length():
+    assert longest_no_spend_streak([], D(2026, 11, 1), D(2026, 11, 5)) == 5
+
+
+def test_single_day_range_without_spend_is_one():
+    assert longest_no_spend_streak([], D(2026, 11, 1), D(2026, 11, 1)) == 1
+
+
+def test_single_day_range_with_spend_is_zero():
+    rows = [_e(D(2026, 11, 1))]
+    assert longest_no_spend_streak(rows, D(2026, 11, 1), D(2026, 11, 1)) == 0
+
+
+def test_every_day_has_spend_returns_zero():
+    rows = [_e(D(2026, 11, d)) for d in range(1, 4)]
+    assert longest_no_spend_streak(rows, D(2026, 11, 1), D(2026, 11, 3)) == 0
+
+
+def test_spend_in_middle_splits_streak():
+    rows = [_e(D(2026, 11, 3))]
+    assert longest_no_spend_streak(rows, D(2026, 11, 1), D(2026, 11, 5)) == 2
+
+
+def test_longest_of_multiple_runs_is_returned():
+    # no-spend runs: 11/1-11/2 (2 days), 11/4-11/7 (4 days)
+    rows = [_e(D(2026, 11, 3)), _e(D(2026, 11, 8))]
+    assert longest_no_spend_streak(rows, D(2026, 11, 1), D(2026, 11, 8)) == 4
+
+
+def test_spend_on_start_day_excluded_from_streak():
+    rows = [_e(D(2026, 11, 1))]
+    assert longest_no_spend_streak(rows, D(2026, 11, 1), D(2026, 11, 4)) == 3
+
+
+def test_spend_on_end_day_excluded_from_streak():
+    rows = [_e(D(2026, 11, 4))]
+    assert longest_no_spend_streak(rows, D(2026, 11, 1), D(2026, 11, 4)) == 3
+
+
+def test_range_bounds_are_inclusive():
+    # 11/1 and 11/5 have no spend; 11/2-11/4 are spend days outside the streak.
+    rows = [_e(D(2026, 11, 2)), _e(D(2026, 11, 3)), _e(D(2026, 11, 4))]
+    assert longest_no_spend_streak(rows, D(2026, 11, 1), D(2026, 11, 5)) == 1
+
+
+def test_expenses_outside_range_are_ignored():
+    rows = [_e(D(2026, 10, 31)), _e(D(2026, 11, 6))]
+    assert longest_no_spend_streak(rows, D(2026, 11, 1), D(2026, 11, 5)) == 5
+
+
+def test_multiple_expenses_on_same_day_count_as_one_spend_day():
+    rows = [_e(D(2026, 11, 2), 100), _e(D(2026, 11, 2), 200)]
+    assert longest_no_spend_streak(rows, D(2026, 11, 1), D(2026, 11, 4)) == 2
+
+
+def test_zero_amount_expense_still_counts_as_spend_record():
+    rows = [_e(D(2026, 11, 2), 0)]
+    assert longest_no_spend_streak(rows, D(2026, 11, 1), D(2026, 11, 3)) == 1
+
+
+def test_unsorted_rows_give_same_result():
+    rows = [_e(D(2026, 11, 8)), _e(D(2026, 11, 3))]
+    assert longest_no_spend_streak(rows, D(2026, 11, 1), D(2026, 11, 8)) == 4
+
+
+def test_start_after_end_returns_zero():
+    assert longest_no_spend_streak([], D(2026, 11, 5), D(2026, 11, 1)) == 0
+
+
+def test_streak_crosses_month_boundary():
+    # no-spend run 11/30-12/2 crosses the month boundary
+    rows = [_e(D(2026, 11, 29)), _e(D(2026, 12, 3))]
+    assert longest_no_spend_streak(rows, D(2026, 11, 29), D(2026, 12, 3)) == 3
