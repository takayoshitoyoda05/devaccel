@@ -0,0 +1,11 @@
+"""Even splitting of a yen amount among people."""
+
+from __future__ import annotations
+
+
+def split_evenly(amount: int, people: int) -> list[int]:
+    """Split ``amount`` yen among ``people``; leftover yen go to the first people one each."""
+    if people < 1:
+        raise ValueError(f"people は 1 以上である必要があります: {people}")
+    base, remainder = divmod(amount, people)
+    return [base + (1 if i < remainder else 0) for i in range(people)]
diff --git a/src/kakeibo/stats.py b/src/kakeibo/stats.py
new file mode 100644
index 0000000..2dc4fb3
--- /dev/null
+++ b/src/kakeibo/stats.py
@@ -0,0 +1,25 @@
+"""Per-category statistics over expense rows."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def median_by_category(rows: list[Expense]) -> dict[str, float]:
+    """{category: median amount}; categories ascending by name.
+
+    For an even number of amounts the median is the mean of the two middle values.
+    """
+    by_cat: dict[str, list[int]] = {}
+    for e in rows:
+        by_cat.setdefault(e.category, []).append(e.amount)
+    out: dict[str, float] = {}
+    for cat in sorted(by_cat):
+        amounts = sorted(by_cat[cat])
+        n = len(amounts)
+        mid = n // 2
+        if n % 2:
+            out[cat] = float(amounts[mid])
+        else:
+            out[cat] = (amounts[mid - 1] + amounts[mid]) / 2
+    return out
