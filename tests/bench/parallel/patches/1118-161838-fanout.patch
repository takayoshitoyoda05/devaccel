+"""Export expense records to other formats."""
+
+from __future__ import annotations
+
+import json
+
+from kakeibo.core import Expense
+
+
+def to_json(rows: list[Expense]) -> str:
+    """Serialize expenses as a JSON array, in input order, without indentation."""
+    data = [
+        {
+            "date": e.day.isoformat(),
+            "category": e.category,
+            "amount": e.amount,
+            "memo": e.memo,
+        }
+        for e in rows
+    ]
+    return json.dumps(data, ensure_ascii=False)
