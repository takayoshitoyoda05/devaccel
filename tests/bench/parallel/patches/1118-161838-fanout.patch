@@ -0,0 +1,72 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.stats import median_by_category
+
+
+def _e(category: str, amount: int) -> Expense:
+    return Expense(date(2026, 11, 1), category, amount)
+
+
+def test_empty_returns_empty_dict():
+    assert median_by_category([]) == {}
+
+
+def test_single_row_median_is_its_amount_as_float():
+    result = median_by_category([_e("food", 1200)])
+    assert result == {"food": 1200.0}
+    assert isinstance(result["food"], float)
+
+
+def test_odd_count_takes_middle_value():
+    rows = [_e("food", 300), _e("food", 100), _e("food", 200)]
+    assert median_by_category(rows) == {"food": 200.0}
+
+
+def test_even_count_averages_two_middle_values():
+    rows = [_e("food", 100), _e("food", 300)]
+    assert median_by_category(rows) == {"food": 200.0}
+
+
+def test_even_count_with_four_values_uses_middle_two():
+    rows = [_e("food", 10), _e("food", 1000), _e("food", 20), _e("food", 30)]
+    # sorted: 10, 20, 30, 1000 -> (20 + 30) / 2
+    assert median_by_category(rows) == {"food": 25.0}
+
+
+def test_equal_values_give_that_value():
+    rows = [_e("food", 500), _e("food", 500), _e("food", 500)]
+    assert median_by_category(rows) == {"food": 500.0}
+
+
+def test_equal_middle_values_in_even_count():
+    rows = [_e("food", 100), _e("food", 400), _e("food", 400), _e("food", 900)]
+    assert median_by_category(rows) == {"food": 400.0}
+
+
+def test_input_order_does_not_matter():
+    a = [_e("food", 300), _e("food", 100), _e("food", 200), _e("food", 400)]
+    b = list(reversed(a))
+    assert median_by_category(a) == median_by_category(b) == {"food": 250.0}
+
+
+def test_each_category_computed_separately():
+    rows = [
+        _e("food", 100),
+        _e("rent", 80000),
+        _e("food", 300),
+        _e("rent", 80000),
+        _e("food", 200),
+    ]
+    assert median_by_category(rows) == {"food": 200.0, "rent": 80000.0}
+
+
+def test_keys_are_sorted_by_category_name_not_by_median():
+    rows = [_e("rent", 80000), _e("food", 100), _e("book", 5000)]
+    result = median_by_category(rows)
+    assert list(result) == ["book", "food", "rent"]
+
+
+def test_no_extra_categories_or_rows_are_added():
+    rows = [_e("food", 100), _e("food", 200)]
+    assert set(median_by_category(rows)) == {"food"}
