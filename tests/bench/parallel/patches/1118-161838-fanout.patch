@@ -0,0 +1,64 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.topn import top_expenses
+
+
+def _e(day: str, amount: int, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category="食費", amount=amount, memo=memo
+    )
+
+
+def test_returns_largest_amounts_first() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 500), _e("2026-01-03", 300)]
+    assert [e.amount for e in top_expenses(rows, 2)] == [500, 300]
+
+
+def test_amount_tie_is_broken_by_earlier_date() -> None:
+    rows = [_e("2026-01-05", 500), _e("2026-01-02", 500), _e("2026-01-03", 500)]
+    assert [e.day for e in top_expenses(rows, 3)] == [
+        date(2026, 1, 2),
+        date(2026, 1, 3),
+        date(2026, 1, 5),
+    ]
+
+
+def test_full_tie_keeps_input_order() -> None:
+    rows = [
+        _e("2026-01-02", 500, "a"),
+        _e("2026-01-02", 500, "b"),
+        _e("2026-01-02", 500, "c"),
+    ]
+    assert [e.memo for e in top_expenses(rows, 3)] == ["a", "b", "c"]
+
+
+def test_returns_exactly_n_when_more_rows_available() -> None:
+    rows = [_e("2026-01-0" + str(i), i * 10) for i in range(1, 6)]
+    assert len(top_expenses(rows, 3)) == 3
+
+
+def test_n_zero_returns_empty() -> None:
+    rows = [_e("2026-01-01", 100)]
+    assert top_expenses(rows, 0) == []
+
+
+def test_negative_n_returns_empty() -> None:
+    rows = [_e("2026-01-01", 100)]
+    assert top_expenses(rows, -1) == []
+
+
+def test_n_larger_than_rows_returns_all_sorted() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300)]
+    assert [e.amount for e in top_expenses(rows, 10)] == [300, 100]
+
+
+def test_empty_input_returns_empty() -> None:
+    assert top_expenses([], 3) == []
+
+
+def test_does_not_mutate_input() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300)]
+    snapshot = list(rows)
+    top_expenses(rows, 2)
+    assert rows == snapshot
diff --git a/tests/test_weekday.py b/tests/test_weekday.py
