diff --git a/src/kakeibo/bankimport.py b/src/kakeibo/bankimport.py
new file mode 100644
index 0000000..80eee61
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,118 @@
+"""Import expense rows from bank CSV exports."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"-?[¥￥]?[0-9][0-9,]*円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    """Parse a bank amount such as ``￥1,234`` or ``-300円`` into yen."""
+    text = s.strip()
+    if not _AMOUNT_RE.fullmatch(text):
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    digits = text.replace(",", "").replace("¥", "").replace("￥", "").replace("円", "")
+    return int(digits)
+
+
+def parse_date(s: str) -> date:
+    """Parse ``YYYY/M/D`` or ``YYYY-M-D`` (separator must not be mixed)."""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    year, month, day = int(m.group(1)), int(m.group(3)), int(m.group(4))
+    try:
+        return date(year, month, day)
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Read a CSV whose first line is a header.
+
+    Returns ``(expenses, errors)``. Errors are ``(physical_line_number, field)``
+    with the header on line 1. Rows with any error are left out of expenses.
+    """
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    try:
+        header = next(reader)
+    except StopIteration:
+        raise ValueError("ヘッダー行がありません") from None
+    index = {name: i for i, name in enumerate(header)}
+    cols: dict[str, int] = {}
+    for field, column in mapping.items():
+        if column not in index:
+            raise ValueError(f"列 {column} がヘッダーにありません")
+        cols[field] = index[column]
+
+    def cell(row: list[str], field: str) -> str:
+        if field not in cols:
+            return ""
+        i = cols[field]
+        return row[i] if i < len(row) else ""
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    while True:
+        line_no = reader.line_num + 1
+        try:
+            row = next(reader)
+        except StopIteration:
+            break
+        if not row or (len(row) == 1 and not row[0].strip()):
+            continue
+
+        raw_date = cell(row, "date")
+        raw_amount = cell(row, "amount")
+        category = cell(row, "category").strip()
+
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(raw_date)
+        except ValueError:
+            errors.append((line_no, "date"))
+        try:
+            amount = parse_amount(raw_amount)
+        except ValueError:
+            errors.append((line_no, "amount"))
+        if not category:
+            errors.append((line_no, "category"))
+
+        if day is None or amount is None or not category:
+            continue
+        if category_map is not None and category in category_map:
+            category = category_map[category]
+        expenses.append(
+            Expense(
+                day=day,
+                category=category,
+                amount=amount,
+                memo=cell(row, "memo").strip(),
+            )
+        )
+    return expenses, errors
