@@ -0,0 +1,66 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.dupes import find_duplicates
+
+A = Expense(date(2026, 1, 5), "食費", 1200, "lunch")
+
+
+def test_empty_list_has_no_duplicates() -> None:
+    assert find_duplicates([]) == []
+
+
+def test_single_row_has_no_duplicates() -> None:
+    assert find_duplicates([A]) == []
+
+
+def test_identical_pair_is_reported() -> None:
+    assert find_duplicates([A, A]) == [(0, 1)]
+
+
+def test_same_values_in_separate_objects_are_duplicates() -> None:
+    b = Expense(date(2026, 1, 5), "食費", 1200, "lunch")
+    assert find_duplicates([A, b]) == [(0, 1)]
+
+
+def test_empty_memo_matches_empty_memo() -> None:
+    x = Expense(date(2026, 2, 1), "交通費", 300)
+    y = Expense(date(2026, 2, 1), "交通費", 300, "")
+    assert find_duplicates([x, y]) == [(0, 1)]
+
+
+@pytest.mark.parametrize(
+    "other",
+    [
+        Expense(date(2026, 1, 6), "食費", 1200, "lunch"),  # day differs
+        Expense(date(2026, 1, 5), "交通費", 1200, "lunch"),  # category differs
+        Expense(date(2026, 1, 5), "食費", 1201, "lunch"),  # amount differs
+        Expense(date(2026, 1, 5), "食費", 1200, "dinner"),  # memo differs
+        Expense(date(2026, 1, 5), "食費", 1200, ""),  # memo empty vs non-empty
+    ],
+)
+def test_any_differing_field_is_not_a_duplicate(other: Expense) -> None:
+    assert find_duplicates([A, other]) == []
+
+
+def test_three_identical_rows_yield_all_pairs_in_order() -> None:
+    assert find_duplicates([A, A, A]) == [(0, 1), (0, 2), (1, 2)]
+
+
+def test_pairs_ordered_by_i_then_j_for_interleaved_duplicates() -> None:
+    B = Expense(date(2026, 3, 1), "日用品", 500, "")
+    assert find_duplicates([A, B, A, B]) == [(0, 2), (1, 3)]
+
+
+def test_only_i_less_than_j_and_no_self_pairs() -> None:
+    result = find_duplicates([A, A])
+    assert all(i < j for i, j in result)
+    assert (0, 0) not in result and (1, 1) not in result
+    assert (1, 0) not in result
+
+
+def test_non_adjacent_duplicates_are_found() -> None:
+    B = Expense(date(2026, 3, 1), "日用品", 500, "")
+    assert find_duplicates([A, B, B, A]) == [(0, 3), (1, 2)]
