index 0000000..1d9f37e
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,137 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+E1 = Expense(date(2026, 11, 1), "food", 1200, "ランチ 外食")
+E2 = Expense(date(2026, 11, 2), "rent", 80000, "")
+E3 = Expense(date(2026, 11, 3), "Transport", 300, "Bus")
+ROWS = [E1, E2, E3]
+
+
+def test_tokenize_whitespace_only_is_empty():
+    assert tokenize("   ") == []
+    assert tokenize("") == []
+
+
+def test_tokenize_parens_and_words():
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+    assert tokenize("a  b") == [("TERM", "a"), ("TERM", "b")]
+
+
+def test_tokenize_operators_only_uppercase():
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+    assert tokenize("and or not") == [
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_quoted_term_keeps_spaces_and_parens():
+    assert tokenize('"外食 (昼)"') == [("TERM", "外食 (昼)")]
+    assert tokenize('"AND"') == [("TERM", "AND")]
+
+
+def test_tokenize_quoted_cat_prefix_is_term():
+    assert tokenize('"cat:food"') == [("TERM", "cat:food")]
+
+
+def test_tokenize_cat():
+    assert tokenize("cat:food") == [("CAT", "food")]
+    assert tokenize("cat:a(b") == [("CAT", "a"), ("LPAREN", "("), ("TERM", "b")]
+
+
+def test_tokenize_unclosed_quote_is_error():
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_is_error():
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_empty_cat_is_error():
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(a",
+        "a)",
+        ")(",
+        "a AND",
+        "OR a",
+        "a OR",
+        "a OR OR b",
+        "NOT",
+        "a AND AND b",
+    ],
+)
+def test_bad_queries_raise(q):
+    with pytest.raises(QueryError):
+        filter_rows(q, ROWS)
+
+
+def test_bad_query_raises_even_with_no_rows():
+    with pytest.raises(QueryError):
+        filter_rows("a AND", [])
+
+
+def test_valid_query_with_no_rows_returns_empty():
+    assert filter_rows("food", []) == []
+
+
+def test_term_matches_memo_or_category_substring():
+    assert matches("ランチ", E1)
+    assert matches("ood", E1)
+    assert not matches("ランチ", E2)
+
+
+def test_term_casefold():
+    assert matches("transport", E3)
+    assert matches("BUS", E3)
+    # casefold("ß") == "ss"
+    assert matches("SS", Expense(date(2026, 1, 1), "x", 1, "ß"))
+
+
+def test_cat_exact_match_only():
+    assert matches("cat:food", E1)
+    assert matches("cat:FOOD", E1)
+    assert not matches("cat:foo", E1)
+    assert not matches("cat:ランチ", E1)  # memo は見ない
+
+
+def test_not_and_implicit_and():
+    assert filter_rows("NOT cat:food", ROWS) == [E2, E3]
+    assert filter_rows("bus transport", ROWS) == [E3]
+    assert filter_rows("bus food", ROWS) == []
+
+
+def test_or_and_precedence():
+    # a OR (b AND c)
+    assert filter_rows("cat:rent OR bus transport", ROWS) == [E2, E3]
+    # (NOT a) AND b
+    assert filter_rows("NOT food transport", ROWS) == [E3]
+    assert filter_rows("NOT NOT rent", ROWS) == [E2]
+
+
+def test_parens_override_precedence():
+    assert filter_rows("(cat:rent OR cat:food) ランチ", ROWS) == [E1]
+
+
+def test_filter_keeps_input_order():
+    assert filter_rows("cat:rent OR cat:food", [E2, E1]) == [E2, E1]
+    assert filter_rows("cat:rent OR cat:food", [E1, E2]) == [E1, E2]
+
+
+def test_no_match_returns_empty_list():
+    assert filter_rows("zzz", ROWS) == []
