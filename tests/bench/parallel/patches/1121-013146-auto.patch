+def test_zero_tolerance_requires_exact_day():
+    rows = [_e(date(2026, 1, 10)), _e(date(2026, 2, 10)), _e(date(2026, 3, 11))]
+    assert find_recurring(rows, min_count=2, tolerance=0) == [
