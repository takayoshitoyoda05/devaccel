+    rows = [_e(date(2026, 1, 10)), _e(date(2026, 2, 10)), _e(date(2026, 3, 13))]
+    assert len(find_recurring(rows, min_count=3, tolerance=3)) == 1
+    assert find_recurring(rows, min_count=3, tolerance=2) == []
+
