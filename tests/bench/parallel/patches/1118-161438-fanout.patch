+def test_gap_splits_runs_and_short_run_is_dropped() -> None:
+    rows = [
+        e(date(2026, 1, 10)),
+        e(date(2026, 2, 10)),
+        e(date(2026, 3, 10)),
+        e(date(2026, 6, 10)),
+        e(date(2026, 7, 10)),
