+def test_results_sorted_by_category_then_amount() -> None:
+    rows = []
+    for cat, amt in [("b", 500), ("a", 900), ("a", 300)]:
+        for m in (1, 2, 3):
+            rows.append(e(date(2026, m, 5), category=cat, amount=amt))
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [
+        ("a", 300),
+        ("a", 900),
+        ("b", 500),
+    ]
+
+
+def test_recurring_fields_order_and_frozen() -> None:
+    names = [f.name for f in dataclasses.fields(Recurring)]
+    assert names == ["category", "amount", "days", "next_expected"]
+    r = Recurring("x", 1, (date(2026, 1, 1),), date(2026, 2, 1))
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        r.amount = 2  # type: ignore[misc]
