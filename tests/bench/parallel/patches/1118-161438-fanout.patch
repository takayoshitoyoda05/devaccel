+def test_two_qualifying_runs_in_same_group_are_both_reported_in_order() -> None:
+    rows = [
+        e(date(2026, 1, 10)),
+        e(date(2026, 2, 10)),
+        e(date(2026, 3, 10)),
+        e(date(2026, 7, 10)),
+        e(date(2026, 8, 10)),
+        e(date(2026, 9, 10)),
+    ]
+    result = find_recurring(rows)
