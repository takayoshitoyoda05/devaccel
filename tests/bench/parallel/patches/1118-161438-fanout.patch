+def test_tolerance_boundary_inclusive() -> None:
+    # add_month(2026-01-10) = 2026-02-10; 2026-02-13 is 3 days off.
+    rows = [
+        e(date(2026, 1, 10)),
+        e(date(2026, 2, 13)),
+        e(date(2026, 3, 13)),
+    ]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+    assert find_recurring(rows, tolerance=2) == []
+
+
+def test_tolerance_applies_before_expected_date() -> None:
+    rows = [
+        e(date(2026, 1, 10)),
+        e(date(2026, 2, 7)),
+        e(date(2026, 3, 7)),
+    ]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+
+
+def test_chain_uses_actual_previous_date_not_clamped_one() -> None:
+    # add_month(2026-01-31) = 2026-02-28; 2026-02-28 -> 2026-03-28 expected,
+    # 2026-03-31 is 3 days off, so linked at tolerance 3 (chain continues).
+    rows = [
+        e(date(2026, 1, 31)),
+        e(date(2026, 2, 28)),
+        e(date(2026, 3, 31)),
+    ]
+    result = find_recurring(rows, tolerance=3)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 30)
+
+
+def test_next_expected_crosses_year_end() -> None:
+    rows = [
+        e(date(2026, 10, 15)),
+        e(date(2026, 11, 15)),
+        e(date(2026, 12, 15)),
+    ]
+    assert find_recurring(rows)[0].next_expected == date(2027, 1, 15)
+
