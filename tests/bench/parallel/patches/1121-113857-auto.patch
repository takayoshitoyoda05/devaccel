+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import import_bank_csv
+from kakeibo.core import CsvError, Expense
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param(
+            '利用日,ご利用店名,利用金額\n2026/1/5,ネット代,"1,200"',
+            [Expense(date(2026, 1, 5), "未分類", 1200, "ネット代")],
+            id="E2-1",
+        ),
+        pytest.param(
+            "日付,出金額,入金額\n2026-01-05,,500",
+            [Expense(date(2026, 1, 5), "未分類", -500, "")],
+            id="E2-3",
+        ),
+    ],
+)
+def test_examples(text: str, expected: list[Expense]) -> None:
+    assert import_bank_csv(text) == expected
+
+
+def test_E2_2_reports_every_bad_row() -> None:
+    text = "日付,金額\n2026-01-05,abc\nx,100"
+    with pytest.raises(CsvError) as info:
+        import_bank_csv(text)
+    assert [n for n, _ in info.value.errors] == [2, 3]
+
+
+def test_bom_and_crlf_are_accepted() -> None:
+    text = "﻿日付,金額\r\n2026/1/5,100\r\n"
+    assert import_bank_csv(text) == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+def test_tab_delimiter_is_detected() -> None:
+    text = "日付\t金額\t摘要\n2026-01-05\t300\tコンビニ"
+    assert import_bank_csv(text) == [
+        Expense(date(2026, 1, 5), "未分類", 300, "コンビニ")
+    ]
+
+
+def test_quoted_newline_keeps_record_start_line() -> None:
+    text = '日付,金額,摘要\n2026-01-05,abc,"a\nb"\n2026-01-06,x,y'
+    with pytest.raises(CsvError) as info:
+        import_bank_csv(text)
+    assert [n for n, _ in info.value.errors] == [2, 4]
+
+
+def test_quoted_newline_is_kept_in_memo() -> None:
+    text = '日付,金額,摘要\n2026-01-05,100,"a\nb"'
+    assert import_bank_csv(text) == [Expense(date(2026, 1, 5), "未分類", 100, "a\nb")]
+
+
+def test_header_aliases_ignore_case_and_spaces() -> None:
+    text = " Date , AMOUNT ,Memo\n2026-01-05,100,x"
+    assert import_bank_csv(text) == [Expense(date(2026, 1, 5), "未分類", 100, "x")]
+
+
+def test_category_column_and_default_category() -> None:
+    text = "日付,金額,カテゴリ\n2026-01-05,100,食費\n2026-01-06,200,"
+    assert import_bank_csv(text, default_category="雑費") == [
+        Expense(date(2026, 1, 5), "食費", 100, ""),
+        Expense(date(2026, 1, 6), "雑費", 200, ""),
+    ]
+
+
+def test_default_category_used_without_category_column() -> None:
+    text = "日付,金額\n2026-01-05,100"
+    assert import_bank_csv(text, default_category="雑費")[0].category == "雑費"
+
+
+@pytest.mark.parametrize("text", ["", "日付,金額\n", "日付,金額"])
+def test_empty_or_header_only_returns_empty(text: str) -> None:
+    assert import_bank_csv(text) == []
+
+
+def test_blank_lines_are_skipped() -> None:
+    text = "日付,金額\n\n2026-01-05,100\n\n2026-01-06,200\n"
+    assert [e.amount for e in import_bank_csv(text)] == [100, 200]
+
+
+def test_output_keeps_input_order() -> None:
+    text = "日付,金額\n2026-03-01,1\n2026-01-01,2\n2026-02-01,3"
+    assert [e.day for e in import_bank_csv(text)] == [
+        date(2026, 3, 1),
+        date(2026, 1, 1),
+        date(2026, 2, 1),
+    ]
+
+
+def test_withdrawal_minus_deposit() -> None:
+    text = "日付,出金額,入金額\n2026-01-05,1000,300"
+    assert import_bank_csv(text)[0].amount == 700
+
+
+def test_deposit_only_row_is_negative() -> None:
+    text = "日付,出金額,入金額\n2026-01-05,,250"
+    assert import_bank_csv(text)[0].amount == -250
+
+
+def test_negative_amount_column_is_kept() -> None:
+    text = "日付,金額\n2026-01-05,-500"
+    assert import_bank_csv(text)[0].amount == -500
+
+
+def test_both_withdrawal_and_deposit_empty_is_error() -> None:
+    text = "日付,出金額,入金額\n2026-01-05,,"
+    with pytest.raises(CsvError) as info:
+        import_bank_csv(text)
+    assert [n for n, _ in info.value.errors] == [2]
+
+
+def test_decimal_amount_is_rejected() -> None:
+    text = "日付,金額\n2026-01-05,12.5"
+    with pytest.raises(CsvError) as info:
+        import_bank_csv(text)
+    assert info.value.errors[0][0] == 2
+    assert "金額" in info.value.errors[0][1]
+
+
+def test_column_count_mismatch_is_error() -> None:
+    text = "日付,金額,摘要\n2026-01-05,100"
+    with pytest.raises(CsvError) as info:
+        import_bank_csv(text)
+    assert [n for n, _ in info.value.errors] == [2]
+
+
+def test_missing_date_column_is_header_error() -> None:
+    with pytest.raises(CsvError) as info:
+        import_bank_csv("金額,摘要\n100,x")
+    assert info.value.errors[0][0] == 1
+
+
+def test_missing_amount_and_withdrawal_deposit_is_header_error() -> None:
+    with pytest.raises(CsvError) as info:
+        import_bank_csv("日付,摘要\n2026-01-05,x")
+    assert info.value.errors[0][0] == 1
+
+
+def test_non_string_text_is_type_error() -> None:
+    with pytest.raises(TypeError, match="text"):
+        import_bank_csv(None)  # type: ignore[arg-type]
