+"""Parse amounts and dates from bank/card CSV values (pure functions)."""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from datetime import date
+
+_CURRENCY_TOKENS = ("¥", "円", "JPY")
+_DATE_PATTERNS = (
+    re.compile(r"([0-9]{4})-([0-9]{1,2})-([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})/([0-9]{1,2})/([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})\.([0-9]{1,2})\.([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})"),
+    re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日"),
+)
+_TRAILING_TIME = re.compile(r"\s+[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?")
+
+
+def parse_amount(s: str) -> int:
+    """Parse a yen amount such as '▲1,234円' into an int (negative for refunds)."""
+    if not isinstance(s, str):
+        raise TypeError(f"s は str である必要があります: {s!r}")
+    t = unicodedata.normalize("NFKC", s)
+    t = re.sub(r"\s+", "", t)
+    for token in _CURRENCY_TOKENS:
+        t = t.replace(token, "")
+    t = t.replace(",", "")
+
+    neg = False
+    if t[:1] in ("-", "−", "△", "▲"):
+        neg, t = True, t[1:]
+    elif t[:1] == "+":
+        t = t[1:]
+    elif t.startswith("(") and t.endswith(")"):
+        neg, t = True, t[1:-1]
+    elif t.endswith("-"):
+        neg, t = True, t[:-1]
+
+    if not re.fullmatch(r"[0-9]+", t):
+        raise ValueError(f"金額として解釈できません: {s!r}")
+    value = int(t)
+    return -value if neg else value
+
+
+def parse_date(s: str) -> date:
+    """Parse a date such as '2026/1/5' or '2026年1月5日' (trailing time is ignored)."""
+    if not isinstance(s, str):
+        raise TypeError(f"s は str である必要があります: {s!r}")
+    t = unicodedata.normalize("NFKC", s).strip()
+    t = _TRAILING_TIME.sub("", t, count=1)
+    for pattern in _DATE_PATTERNS:
+        m = pattern.fullmatch(t)
+        if m is None:
+            continue
+        year, month, day = (int(g) for g in m.groups())
+        try:
+            return date(year, month, day)
+        except ValueError:
+            raise ValueError(f"存在しない日付です: {s!r}") from None
+    raise ValueError(f"日付として解釈できません: {s!r}")
