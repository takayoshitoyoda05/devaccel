@@ -0,0 +1,96 @@
+"""Month-over-month comparison of expenses by category (pure functions)."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from itertools import pairwise
+
+from kakeibo.core import Expense, monthly_totals
+
+
+@dataclass(frozen=True)
+class CategoryDiff:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    rate: float | None  # None when previous == 0
+
+
+def _month_range(first: str, last: str) -> list[str]:
+    """Months from first to last (both inclusive) as YYYY-MM, ascending."""
+    y, m = int(first[:4]), int(first[5:])
+    end_y, end_m = int(last[:4]), int(last[5:])
+    out: list[str] = []
+    while (y, m) <= (end_y, end_m):
+        out.append(f"{y:04d}-{m:02d}")
+        y, m = (y + 1, 1) if m == 12 else (y, m + 1)
+    return out
+
+
+def month_over_month(rows: list[Expense]) -> dict[str, list[CategoryDiff]]:
+    """Compare each month with the previous one (missing months count as empty).
+
+    Keys are "YYYY-MM" from the month after the first data month to the last,
+    ascending. Each list is sorted by abs(delta) desc, then category asc.
+    """
+    if not isinstance(rows, list):
+        raise TypeError("rows は list[Expense] である必要があります")
+    for e in rows:
+        if not isinstance(e, Expense):
+            raise TypeError("rows の要素は Expense である必要があります")
+    totals = monthly_totals(rows)
+    if len(totals) < 2:
+        return {}
+    months = _month_range(min(totals), max(totals))
+    result: dict[str, list[CategoryDiff]] = {}
+    for prev_m, cur_m in pairwise(months):
+        prev = totals.get(prev_m, {})
+        cur = totals.get(cur_m, {})
+        diffs: list[CategoryDiff] = []
+        for cat in set(prev) | set(cur):
+            p = prev.get(cat, 0)
+            c = cur.get(cat, 0)
+            delta = c - p
+            rate = None if p == 0 else delta / p
+            diffs.append(CategoryDiff(cat, p, c, delta, rate))
+        diffs.sort(key=lambda d: (-abs(d.delta), d.category))
+        result[cur_m] = diffs
+    return result
+
+
+def _signed(n: int) -> str:
+    if n > 0:
+        return f"+{n}"
+    if n < 0:
+        return f"-{abs(n)}"
+    return "0"
+
+
+def _rate_text(d: CategoryDiff) -> str:
+    if d.rate is None:
+        return "新規"
+    if d.current == 0 and d.previous != 0:
+        return "なし"
+    pct = abs(d.rate) * 100
+    if d.rate > 0:
+        return f"+{pct:.1f}%"
+    if d.rate < 0:
+        return f"-{pct:.1f}%"
+    return f"{pct:.1f}%"
+
+
+def format_report(diffs: dict[str, list[CategoryDiff]]) -> str:
+    """Render the comparison as text. Empty input gives an empty string."""
+    if not isinstance(diffs, dict):
+        raise TypeError("diffs は dict[str, list[CategoryDiff]] である必要があります")
+    blocks: list[str] = []
+    for month, items in diffs.items():
+        lines = [month]
+        for d in items:
+            lines.append(
+                f"{d.category}  {d.previous}→{d.current} "
+                f"({_signed(d.delta)}, {_rate_text(d)})"
+            )
+        blocks.append("\n".join(lines))
+    return "\n\n".join(blocks)
