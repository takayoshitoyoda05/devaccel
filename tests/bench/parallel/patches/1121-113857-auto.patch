+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,108 @@
+"""Detect recurring expenses and predict their next date. Pure functions."""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from collections import Counter
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_TRAILING_RE = re.compile(r"[\d\W_]+$")
+_SPACE_RE = re.compile(r"\s+")
+
+
+@dataclass(frozen=True)
+class Recurring:
+    memo: str  # normalized memo
+    amount: int  # yen
+    category: str
+    months: tuple[str, ...]  # "YYYY-MM", ascending
+    next_date: date
+
+
+def _normalize_memo(memo: str) -> str:
+    s = unicodedata.normalize("NFKC", memo).lower()
+    s = _SPACE_RE.sub("", s)
+    return _TRAILING_RE.sub("", s)
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month - 1
+
+
+def _month_label(idx: int) -> str:
+    y, m0 = divmod(idx, 12)
+    return f"{y:04d}-{m0 + 1:02d}"
+
+
+def _next_date(days: list[int], last_idx: int) -> date:
+    # 最頻値(同数なら大きい方)を、翌月の末日で切り詰める
+    counts = Counter(days)
+    day = max(counts.items(), key=lambda kv: (kv[1], kv[0]))[0]
+    y, m0 = divmod(last_idx + 1, 12)
+    month = m0 + 1
+    return date(y, month, min(day, calendar.monthrange(y, month)[1]))
+
+
+def find_recurring(rows: list[Expense], min_months: int = 3) -> list[Recurring]:
+    if isinstance(min_months, bool) or not isinstance(min_months, int):
+        raise TypeError("min_months は int である必要があります")
+    if min_months < 2:
+        raise ValueError("min_months は 2 以上である必要があります")
+    if not isinstance(rows, list):
+        raise TypeError("rows は list[Expense] である必要があります")
+    for e in rows:
+        if not isinstance(e, Expense):
+            raise TypeError("rows の要素は Expense である必要があります")
+
+    # 返金(負の金額)は系列に混ぜず無視する
+    positive = [e for e in rows if e.amount >= 0]
+    if not positive:
+        return []
+    latest_idx = max(_month_index(e.day) for e in positive)
+
+    # (正規化メモ, 金額) -> {月index: その月で最も早い明細}
+    series: dict[tuple[str, int], dict[int, Expense]] = {}
+    # (正規化メモ, 金額) -> 系列の最後の明細
+    latest_detail: dict[tuple[str, int], Expense] = {}
+    for e in positive:
+        key = (_normalize_memo(e.memo), e.amount)
+        idx = _month_index(e.day)
+        by_month = series.setdefault(key, {})
+        cur = by_month.get(idx)
+        if cur is None or e.day < cur.day:
+            by_month[idx] = e
+        last = latest_detail.get(key)
+        if last is None or e.day >= last.day:
+            latest_detail[key] = e
+
+    out: list[Recurring] = []
+    for key, by_month in series.items():
+        last_idx = max(by_month)
+        # 現在も続いている系列だけを出す(最新月が全体の最新月と一致)
+        if last_idx != latest_idx:
+            continue
+        # 欠けた月で切り、最後の連続区間だけを数える
+        run = [last_idx]
+        while (run[-1] - 1) in by_month:
+            run.append(run[-1] - 1)
+        run.reverse()
+        if len(run) < min_months:
+            continue
+        memo, amount = key
+        out.append(
+            Recurring(
+                memo=memo,
+                amount=amount,
+                category=latest_detail[key].category,
+                months=tuple(_month_label(i) for i in run),
+                next_date=_next_date([by_month[i].day.day for i in run], last_idx),
+            )
+        )
+
+    out.sort(key=lambda r: (-r.amount, r.memo))
+    return out
