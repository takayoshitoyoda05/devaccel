@@ -0,0 +1,150 @@
+"""銀行・カード CSV の取り込み(純粋関数: 文字列を受けて Expense のリストを返す)。"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from datetime import date
+
+from kakeibo.core import CsvError, Expense
+
+# 正規化済みのヘッダー名(小文字・前後空白除去)から論理フィールドへ。
+_FIELD_ALIASES: dict[str, tuple[str, ...]] = {
+    "date": ("日付", "利用日", "取引日", "ご利用日", "date"),
+    "amount": ("金額", "利用金額", "ご利用金額", "amount"),
+    "withdrawal": ("出金額", "お支払金額", "支払", "withdrawal"),
+    "deposit": ("入金額", "お預かり金額", "預入", "deposit"),
+    "memo": ("摘要", "メモ", "利用店名", "ご利用店名", "内容", "description", "memo"),
+    "category": ("カテゴリ", "category"),
+}
+
+_DATE_RE = re.compile(r"(\d{4})[/.\-](\d{1,2})[/.\-](\d{1,2})")
+_YEN_RE = re.compile(r"[+-]?(?:\d{1,3}(?:,\d{3})+|\d+)")
+
+
+def _norm(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip()
+
+
+def _cell(rec: list[str], idx: int | None) -> str:
+    return "" if idx is None else rec[idx].strip()
+
+
+def _map_header(header: list[str], line: int) -> dict[str, int]:
+    keys = [_norm(c).lower() for c in header]
+    cols: dict[str, int] = {}
+    for field, aliases in _FIELD_ALIASES.items():
+        for i, k in enumerate(keys):
+            if k in aliases:
+                cols.setdefault(field, i)
+                break
+    if "date" not in cols:
+        raise CsvError([(line, "ヘッダー: 日付列がありません")])
+    if not any(f in cols for f in ("amount", "withdrawal", "deposit")):
+        raise CsvError([(line, "ヘッダー: 金額列も出金・入金列もありません")])
+    return cols
+
+
+def _parse_date(raw: str, errs: list[tuple[int, str]], line: int) -> date | None:
+    m = _DATE_RE.fullmatch(_norm(raw))
+    if m:
+        try:
+            return date(int(m[1]), int(m[2]), int(m[3]))
+        except ValueError:
+            pass
+    errs.append((line, f"日付: 日付が不正です {raw!r}"))
+    return None
+
+
+def _parse_yen(
+    label: str, raw: str, errs: list[tuple[int, str]], line: int
+) -> int | None:
+    s = _norm(raw)
+    if _YEN_RE.fullmatch(s):
+        return int(s.replace(",", ""))
+    errs.append((line, f"{label}: 金額が整数ではありません {raw!r}"))
+    return None
+
+
+def _parse_record(
+    rec: list[str], cols: dict[str, int], default_category: str, line: int
+) -> tuple[Expense | None, list[tuple[int, str]]]:
+    errs: list[tuple[int, str]] = []
+    day = _parse_date(_cell(rec, cols["date"]), errs, line)
+
+    amount: int | None
+    if "amount" in cols:
+        amount = _parse_yen("金額", _cell(rec, cols["amount"]), errs, line)
+    else:
+        w_raw = _cell(rec, cols.get("withdrawal"))
+        d_raw = _cell(rec, cols.get("deposit"))
+        if w_raw == "" and d_raw == "":
+            errs.append((line, "出金額: 出金・入金がともに空です ''"))
+            amount = None
+        else:
+            w = _parse_yen("出金額", w_raw, errs, line) if w_raw else 0
+            d = _parse_yen("入金額", d_raw, errs, line) if d_raw else 0
+            amount = None if w is None or d is None else w - d
+
+    if errs or day is None or amount is None:
+        return None, errs
+    category = _cell(rec, cols.get("category")) or default_category
+    return Expense(day, category, amount, _cell(rec, cols.get("memo"))), []
+
+
+def import_bank_csv(text: str, default_category: str = "未分類") -> list[Expense]:
+    """銀行・カード CSV の文字列を Expense のリストにする。
+
+    誤りがあれば全行分をまとめて CsvError で報告し、部分結果は返さない。
+    """
+    if not isinstance(text, str):
+        raise TypeError("text は str である必要があります")
+    if not isinstance(default_category, str):
+        raise TypeError("default_category は str である必要があります")
+    if not default_category.strip():
+        raise ValueError("default_category は空でない文字列である必要があります")
+
+    body = text.removeprefix("﻿")
+    first_line = body.split("\n", 1)[0]
+    delimiter = "\t" if first_line.count("\t") > first_line.count(",") else ","
+
+    reader = csv.reader(io.StringIO(body, newline=""), delimiter=delimiter)
+    header: list[str] | None = None
+    cols: dict[str, int] = {}
+    rows: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+
+    while True:
+        start = reader.line_num + 1
+        try:
+            rec = next(reader)
+        except StopIteration:
+            break
+        except csv.Error as e:
+            errors.append((start, f"CSV の形式が不正です: {e}"))
+            break
+        if all(c.strip() == "" for c in rec):
+            continue
+        if header is None:
+            header = rec
+            cols = _map_header(header, start)
+            continue
+        if len(rec) != len(header):
+            joined = ",".join(rec)
+            errors.append(
+                (
+                    start,
+                    f"列数: {len(header)} 列必要ですが {len(rec)} 列です {joined!r}",
+                )
+            )
+            continue
+        expense, errs = _parse_record(rec, cols, default_category, start)
+        errors.extend(errs)
+        if expense is not None:
+            rows.append(expense)
+
+    if errors:
+        raise CsvError(errors)
+    return rows
