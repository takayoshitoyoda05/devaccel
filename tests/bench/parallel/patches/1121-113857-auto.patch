new file mode 100644
index 0000000..7c85151
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,227 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import matches, search
+
+
+def ex(day: str, category: str = "食費", amount: int = 100, memo: str = "") -> Expense:
+    return Expense(date.fromisoformat(day), category, amount, memo)
+
+
+# 表の例 (E4-x)
+
+
+@pytest.mark.parametrize(
+    "cond, rows, expected",
+    [
+        pytest.param(
+            {"or": [{"category": "食費"}, {"memo": "ｎｅｔ"}]},
+            [
+                ex("2026-01-01", "食費", 500, "lunch"),
+                ex("2026-01-02", "雑貨", 800, "NET"),
+                ex("2026-01-03", "交通", 300, "bus"),
+            ],
+            [
+                ex("2026-01-01", "食費", 500, "lunch"),
+                ex("2026-01-02", "雑貨", 800, "NET"),
+            ],
+            id="E4-1",
+        ),
+        pytest.param(
+            {"min_amount": 1000, "max_amount": 1000},
+            [
+                ex("2026-01-01", amount=999),
+                ex("2026-01-02", amount=1000),
+                ex("2026-01-03", amount=1001),
+            ],
+            [ex("2026-01-02", amount=1000)],
+            id="E4-2",
+        ),
+    ],
+)
+def test_example_table(cond, rows, expected):
+    assert search(rows, cond) == expected
+
+
+def test_E4_3_unknown_key_raises_value_error():
+    with pytest.raises(ValueError, match="colour"):
+        search([], {"colour": "red"})
+
+
+# 葉の条件
+
+
+def test_category_list_matches_any():
+    rows = [
+        ex("2026-01-01", "食費"),
+        ex("2026-01-02", "交通"),
+        ex("2026-01-03", "雑貨"),
+    ]
+    assert search(rows, {"category": ["食費", "交通"]}) == rows[:2]
+
+
+def test_category_str_is_exact_match():
+    rows = [ex("2026-01-01", "食費"), ex("2026-01-02", "食費メモ")]
+    assert search(rows, {"category": "食費"}) == rows[:1]
+
+
+def test_memo_partial_case_insensitive_nfkc():
+    rows = [
+        ex("2026-01-01", memo="Netflix"),
+        ex("2026-01-02", memo="ＮＥＴ代"),
+        ex("2026-01-03", memo="x"),
+    ]
+    assert search(rows, {"memo": "net"}) == rows[:2]
+
+
+def test_empty_memo_condition_matches_all():
+    rows = [ex("2026-01-01", memo=""), ex("2026-01-02", memo="a")]
+    assert search(rows, {"memo": ""}) == rows
+
+
+def test_since_until_inclusive():
+    rows = [ex("2026-01-01"), ex("2026-01-15"), ex("2026-01-31"), ex("2026-02-01")]
+    cond = {"since": date(2026, 1, 15), "until": date(2026, 1, 31)}
+    assert search(rows, cond) == rows[1:3]
+
+
+def test_amount_bounds_inclusive():
+    rows = [
+        ex("2026-01-01", amount=-500),
+        ex("2026-01-02", amount=0),
+        ex("2026-01-03", amount=5),
+    ]
+    assert search(rows, {"min_amount": 0, "max_amount": 5}) == rows[1:]
+
+
+def test_multiple_leaves_in_one_dict_are_anded():
+    rows = [
+        ex("2026-01-01", "食費", 500),
+        ex("2026-01-02", "食費", 2000),
+        ex("2026-01-03", "交通", 500),
+    ]
+    assert search(rows, {"category": "食費", "max_amount": 1000}) == rows[:1]
+
+
+# 論理
+
+
+def test_and_nested_with_not():
+    rows = [
+        ex("2026-01-01", "食費"),
+        ex("2026-01-02", "交通"),
+        ex("2026-01-03", "食費", memo="x"),
+    ]
+    cond = {"and": [{"category": "食費"}, {"not": {"memo": "x"}}]}
+    assert search(rows, cond) == rows[:1]
+
+
+def test_logic_keys_mixed_with_leaves_are_anded():
+    rows = [
+        ex("2026-01-01", "食費", 500),
+        ex("2026-01-02", "食費", 2000),
+        ex("2026-01-03", "交通", 500),
+    ]
+    cond = {"category": "食費", "or": [{"max_amount": 100}, {"max_amount": 1000}]}
+    assert search(rows, cond) == rows[:1]
+
+
+def test_empty_and_is_true_and_empty_or_is_false():
+    rows = [ex("2026-01-01")]
+    assert search(rows, {"and": []}) == rows
+    assert search(rows, {"or": []}) == []
+
+
+def test_not_of_empty_is_false():
+    rows = [ex("2026-01-01")]
+    assert search(rows, {"not": {}}) == []
+
+
+# 全件・順序・非破壊
+
+
+def test_none_and_empty_dict_return_all():
+    rows = [ex("2026-01-01"), ex("2026-01-02")]
+    assert search(rows, None) == rows
+    assert search(rows, {}) == rows
+    assert search(rows) == rows
+
+
+def test_preserves_order_and_does_not_mutate_input():
+    rows = [
+        ex("2026-01-03", amount=1),
+        ex("2026-01-01", amount=2),
+        ex("2026-01-02", amount=3),
+    ]
+    snapshot = list(rows)
+    result = search(rows, {"min_amount": 1})
+    assert result == rows
+    assert rows == snapshot
+
+
+def test_matches_single_expense():
+    e = ex("2026-01-01", "食費", 500, "lunch")
+    assert matches(e, {"category": "食費"}) is True
+    assert matches(e, {"category": "交通"}) is False
+    assert matches(e, None) is True
+    assert matches(e, {}) is True
+
+
+# 検証 (R4)
+
+
+@pytest.mark.parametrize(
+    "cond, exc, word",
+    [
+        pytest.param(
+            {"min_amount": True}, TypeError, "min_amount", id="bool-min_amount"
+        ),
+        pytest.param(
+            {"max_amount": "1000"}, TypeError, "max_amount", id="str-max_amount"
+        ),
+        pytest.param({"memo": 1}, TypeError, "memo", id="int-memo"),
+        pytest.param({"category": 1}, TypeError, "category", id="int-category"),
+        pytest.param(
+            {"category": ["食費", 1]},
+            TypeError,
+            "category",
+            id="list-with-int-category",
+        ),
+        pytest.param({"since": "2026-01-01"}, TypeError, "since", id="str-since"),
+        pytest.param(
+            {"until": date(2026, 1, 1).isoformat()}, TypeError, "until", id="str-until"
+        ),
+        pytest.param({"and": {"memo": "x"}}, TypeError, "and", id="and-not-list"),
+        pytest.param({"not": [{"memo": "x"}]}, TypeError, "not", id="not-not-dict"),
+        pytest.param(
+            {"min_amount": 2, "max_amount": 1},
+            ValueError,
+            "min_amount",
+            id="min-gt-max",
+        ),
+        pytest.param(
+            {"since": date(2026, 2, 1), "until": date(2026, 1, 1)},
+            ValueError,
+            "since",
+            id="since-gt-until",
+        ),
+        pytest.param(
+            {"or": [{"colour": "red"}]}, ValueError, "colour", id="unknown-key-nested"
+        ),
+    ],
+)
+def test_invalid_condition_raises(cond, exc, word):
+    with pytest.raises(exc, match=word):
+        search([], cond)
+
+
+def test_invalid_condition_checked_on_matches():
+    with pytest.raises(ValueError, match="colour"):
+        matches(ex("2026-01-01"), {"colour": "red"})
+
+
+def test_non_dict_condition_raises_type_error():
+    with pytest.raises(TypeError):
+        search([ex("2026-01-01")], ["食費"])  # type: ignore[arg-type]
