diff --git a/tests/test_monthly_diff.py b/tests/test_monthly_diff.py
new file mode 100644
index 0000000..3912c56
--- /dev/null
+++ b/tests/test_monthly_diff.py
@@ -0,0 +1,118 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthly_diff import CategoryDiff, format_report, month_over_month
+
+
+def E(y: int, m: int, cat: str, amount: int) -> Expense:
+    return Expense(day=date(y, m, 5), category=cat, amount=amount)
+
+
+# --- 例の表 (ID 付き) ---------------------------------------------------------
+
+
+@pytest.mark.parametrize("case_id", ["E5-1"])
+def test_example_e5_1_gap_month_counts_as_empty(case_id: str) -> None:
+    # E5-1 | 1 月 食費 3000 / 3 月 食費 5000(2 月なし) | 2 月 delta -3000、3 月 delta +5000 | D6
+    rows = [E(2026, 1, "食費", 3000), E(2026, 3, "食費", 5000)]
+    result = month_over_month(rows)
+    assert list(result) == ["2026-02", "2026-03"]
+    assert result["2026-02"] == [CategoryDiff("食費", 3000, 0, -3000, -1.0)]
+    assert result["2026-03"] == [CategoryDiff("食費", 0, 5000, 5000, None)]
+
+
+@pytest.mark.parametrize("case_id", ["E5-2"])
+def test_example_e5_2_new_category(case_id: str) -> None:
+    # E5-2 | 前月に無いカテゴリ 800 円 | previous 0, rate None, 表示に `新規` | R2 R4
+    rows = [E(2026, 1, "食費", 1000), E(2026, 2, "食費", 1000), E(2026, 2, "娯楽", 800)]
+    result = month_over_month(rows)
+    diff = next(d for d in result["2026-02"] if d.category == "娯楽")
+    assert diff.previous == 0
+    assert diff.rate is None
+    assert "新規" in format_report(result)
+
+
+@pytest.mark.parametrize("case_id", ["E5-3"])
+def test_example_e5_3_rate_and_display(case_id: str) -> None:
+    # E5-3 | 前月 1000 → 当月 1500 | rate 0.5、表示 `+500, +50.0%` | R2 R4
+    rows = [E(2026, 1, "食費", 1000), E(2026, 2, "食費", 1500)]
+    result = month_over_month(rows)
+    diff = result["2026-02"][0]
+    assert diff.rate == 0.5
+    assert "+500, +50.0%" in format_report(result)
+
+
+# --- 追加の規則テスト ---------------------------------------------------------
+
+
+def test_empty_input_returns_empty_dict() -> None:
+    assert month_over_month([]) == {}  # R5
+
+
+def test_single_month_returns_empty_dict() -> None:
+    assert month_over_month([E(2026, 1, "食費", 1000)]) == {}  # R5
+
+
+def test_first_month_not_in_result() -> None:
+    rows = [E(2026, 1, "食費", 1000), E(2026, 2, "食費", 1000)]
+    assert list(month_over_month(rows)) == ["2026-02"]  # 最初の月は含めない
+
+
+def test_sorted_by_abs_delta_desc_then_category_asc() -> None:
+    rows = [
+        E(2026, 1, "b", 100),
+        E(2026, 1, "a", 100),
+        E(2026, 1, "c", 1000),
+        E(2026, 2, "a", 100),  # delta 0 も含める
+        E(2026, 2, "b", 0),  # delta -100
+        E(2026, 2, "c", 1100),  # delta +100
+        E(2026, 2, "d", 0),
+    ]
+    cats = [d.category for d in month_over_month(rows)["2026-02"]]
+    # b: -100, c: +100 (同点は昇順で b, c)、a: 0, d: 0 (同点は昇順で a, d)
+    assert cats == ["b", "c", "a", "d"]
+
+
+def test_zero_previous_and_current_rate_none_and_delta_zero() -> None:
+    rows = [E(2026, 1, "x", 0), E(2026, 2, "x", 0)]
+    diff = month_over_month(rows)["2026-02"][0]
+    assert diff == CategoryDiff("x", 0, 0, 0, None)
+
+
+def test_refund_negative_amount_summed_as_is() -> None:
+    rows = [E(2026, 1, "食費", 1000), E(2026, 2, "食費", -200)]
+    diff = month_over_month(rows)["2026-02"][0]
+    assert diff.current == -200
+    assert diff.delta == -1200
+
+
+def test_format_report_empty_returns_empty_string() -> None:
+    assert format_report({}) == ""
+
+
+def test_format_report_decrease_and_none_current_shows_nashi() -> None:
+    rows = [E(2026, 1, "食費", 3000), E(2026, 2, "食費", 0)]
+    text = format_report(month_over_month(rows))
+    assert "2026-02" in text
+    assert "なし" in text
+    assert "-3000" in text
+
+
+def test_format_report_increase_sign() -> None:
+    rows = [E(2026, 1, "食費", 1000), E(2026, 2, "食費", 1500)]
+    assert "食費  1000→1500 (+500, +50.0%)" in format_report(month_over_month(rows))
+
+
+@pytest.mark.parametrize("bad", [None, "rows", (E(2026, 1, "x", 1),)])
+def test_month_over_month_rejects_non_list(bad: object) -> None:
+    with pytest.raises(TypeError):
+        month_over_month(bad)  # type: ignore[arg-type]
+
+
+def test_format_report_rejects_non_dict() -> None:
+    with pytest.raises(TypeError):
+        format_report([])  # type: ignore[arg-type]
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..e9fbf52
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,210 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring
+
+
+def _e(d: date, memo: str, amount: int, category: str = "固定費") -> Expense:
+    return Expense(day=d, category=category, amount=amount, memo=memo)
+
+
+# 表の全行(E3-1 〜 E3-3)をそのまま写す
+@pytest.mark.parametrize(
+    ("rows", "expected"),
+    [
+        pytest.param(
+            [
+                _e(date(2026, 1, 31), "家賃", 80000, "住居"),
+                _e(date(2026, 2, 28), "家賃", 80000, "住居"),
+                _e(date(2026, 3, 31), "家賃", 80000, "住居"),
+            ],
+            [
+                Recurring(
+                    memo="家賃",
+                    amount=80000,
+                    category="住居",
+                    months=("2026-01", "2026-02", "2026-03"),
+                    next_date=date(2026, 4, 30),
+                )
+            ],
+            id="E3-1",
+        ),
+        pytest.param(
+            [
+                _e(date(2026, 1, 5), "Netflix 1", 1490, "娯楽"),
+                _e(date(2026, 2, 5), "Netflix 2", 1490, "娯楽"),
+                _e(date(2026, 3, 5), "netflix 3", 1490, "娯楽"),
+            ],
+            [
+                Recurring(
+                    memo="netflix",
+                    amount=1490,
+                    category="娯楽",
+                    months=("2026-01", "2026-02", "2026-03"),
+                    next_date=date(2026, 4, 5),
+                )
+            ],
+            id="E3-2",
+        ),
+        pytest.param(
+            [
+                _e(date(2026, 1, 10), "電気", 980),
+                _e(date(2026, 2, 10), "電気", 980),
+                _e(date(2026, 3, 10), "電気", 980),
+                _e(date(2026, 4, 10), "電気", 1080),
+                _e(date(2026, 5, 10), "電気", 1080),
+                _e(date(2026, 6, 10), "電気", 1080),
+            ],
+            [
+                Recurring(
+                    memo="電気",
+                    amount=1080,
+                    category="固定費",
+                    months=("2026-04", "2026-05", "2026-06"),
+                    next_date=date(2026, 7, 10),
+                )
+            ],
+            id="E3-3",
+        ),
+    ],
+)
+def test_spec_table(rows: list[Expense], expected: list[Recurring]) -> None:
+    assert find_recurring(rows) == expected
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+def test_refund_negative_amounts_are_ignored() -> None:
+    rows = [
+        _e(date(2026, 1, 1), "保険", 5000),
+        _e(date(2026, 2, 1), "保険", 5000),
+        _e(date(2026, 3, 1), "保険", 5000),
+        _e(date(2026, 3, 2), "保険", -5000),
+    ]
+    assert [r.memo for r in find_recurring(rows)] == ["保険"]
+    # 返金だけの系列は出ない
+    assert find_recurring([_e(date(2026, 1, 1), "返金", -100)]) == []
+
+
+def test_same_month_counts_only_earliest_detail() -> None:
+    rows = [
+        _e(date(2026, 1, 3), "水道", 2000),
+        _e(date(2026, 1, 20), "水道", 2000),
+        _e(date(2026, 2, 3), "水道", 2000),
+        _e(date(2026, 3, 3), "水道", 2000),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.months == ("2026-01", "2026-02", "2026-03")
+    assert r.next_date == date(2026, 4, 3)
+
+
+def test_run_broken_by_gap_counts_only_last_run() -> None:
+    # 1〜3 月、5〜7 月(4 月が欠け)。最後の区間だけを数える
+    rows = [_e(date(2026, m, 1), "ジム", 3000) for m in (1, 2, 3, 5, 6, 7)]
+    (r,) = find_recurring(rows)
+    assert r.months == ("2026-05", "2026-06", "2026-07")
+
+
+def test_series_ending_before_latest_month_is_dropped() -> None:
+    # 解約済みの系列(最新月まで続いていない)は出ない
+    rows = [
+        _e(date(2026, 1, 1), "旧サービス", 500),
+        _e(date(2026, 2, 1), "旧サービス", 500),
+        _e(date(2026, 3, 1), "旧サービス", 500),
+        _e(date(2026, 4, 1), "別の支出", 100),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_run_shorter_than_min_months_is_dropped() -> None:
+    rows = [_e(date(2026, 1, 1), "雑誌", 700), _e(date(2026, 2, 1), "雑誌", 700)]
+    assert find_recurring(rows) == []
+    (r,) = find_recurring(rows, min_months=2)
+    assert r.months == ("2026-01", "2026-02")
+
+
+def test_next_date_uses_most_frequent_day_with_ties_going_to_larger() -> None:
+    rows = [
+        _e(date(2026, 1, 10), "A", 100),
+        _e(date(2026, 2, 20), "A", 100),
+        _e(date(2026, 3, 10), "A", 100),
+        _e(date(2026, 4, 20), "A", 100),
+        _e(date(2026, 5, 15), "A", 100),
+    ]
+    # 10 と 20 が 2 回ずつ(15 は 1 回)→ 同数なので大きい 20
+    (r,) = find_recurring(rows)
+    assert r.next_date == date(2026, 6, 20)
+
+
+def test_next_date_clamped_to_february_end() -> None:
+    rows = [
+        _e(date(2025, 11, 30), "B", 100),
+        _e(date(2025, 12, 31), "B", 100),
+        _e(date(2026, 1, 31), "B", 100),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.next_date == date(2026, 2, 28)
+
+
+def test_next_date_leap_year_february() -> None:
+    rows = [
+        _e(date(2023, 11, 30), "C", 100),
+        _e(date(2023, 12, 31), "C", 100),
+        _e(date(2024, 1, 31), "C", 100),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.next_date == date(2024, 2, 29)
+
+
+def test_output_sorted_by_amount_desc_then_memo_asc() -> None:
+    rows: list[Expense] = []
+    for m in (1, 2, 3):
+        rows += [
+            _e(date(2026, m, 1), "b", 100),
+            _e(date(2026, m, 2), "a", 100),
+            _e(date(2026, m, 3), "z", 900),
+        ]
+    assert [(r.memo, r.amount) for r in find_recurring(rows)] == [
+        ("z", 900),
+        ("a", 100),
+        ("b", 100),
+    ]
+
+
+def test_memo_normalization_strips_spaces_digits_and_symbols() -> None:
+    rows = [
+        _e(date(2026, 1, 1), "ＮＥＴflix 01", 300),
+        _e(date(2026, 2, 1), "net flix!", 300),
+        _e(date(2026, 3, 1), "Net Flix 9", 300),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.memo == "netflix"
+
+
+def test_different_amount_starts_new_series() -> None:
+    rows = [
+        _e(date(2026, 1, 1), "D", 100),
+        _e(date(2026, 2, 1), "D", 100),
+        _e(date(2026, 3, 1), "D", 100),
+        _e(date(2026, 4, 1), "D", 120),
+        _e(date(2026, 5, 1), "D", 120),
+        _e(date(2026, 6, 1), "D", 120),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.amount == 120
+
+
+@pytest.mark.parametrize("bad", [True, False, 3.0, "3", None])
+def test_min_months_wrong_type_raises_type_error(bad: object) -> None:
+    with pytest.raises(TypeError):
+        find_recurring([], min_months=bad)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad", [1, 0, -3])
+def test_min_months_below_two_raises_value_error(bad: int) -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_months=bad)
