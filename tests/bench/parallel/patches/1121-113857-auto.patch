--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,107 @@
+"""Filter Expense rows with a dict-based condition language (pure functions)."""
+
+from __future__ import annotations
+
+import unicodedata
+from datetime import date, datetime
+from typing import Any
+
+from kakeibo.core import Expense
+
+_LOGIC_KEYS = frozenset({"and", "or", "not"})
+_LEAF_KEYS = frozenset(
+    {"category", "min_amount", "max_amount", "memo", "since", "until"}
+)
+_KNOWN_KEYS = _LOGIC_KEYS | _LEAF_KEYS
+
+
+def _norm(text: str) -> str:
+    return unicodedata.normalize("NFKC", text).casefold()
+
+
+def _check_cond(cond: object, where: str) -> None:
+    """Validate a condition tree. Raises TypeError / ValueError naming the key."""
+    if not isinstance(cond, dict):
+        raise TypeError(f"{where} は dict である必要があります: {type(cond).__name__}")
+    for key, value in cond.items():
+        if key not in _KNOWN_KEYS:
+            raise ValueError(f"未知のキーです: {key!r}")
+        if key in ("and", "or"):
+            if not isinstance(value, list):
+                raise TypeError(
+                    f"{key} は list である必要があります: {type(value).__name__}"
+                )
+            for sub in value:
+                _check_cond(sub, f"{key} の要素")
+        elif key == "not":
+            _check_cond(value, "not")
+        elif key == "category":
+            ok = isinstance(value, str) or (
+                isinstance(value, list) and all(isinstance(c, str) for c in value)
+            )
+            if not ok:
+                raise TypeError(
+                    f"category は str または list[str] である必要があります: {value!r}"
+                )
+        elif key in ("min_amount", "max_amount") and (
+            isinstance(value, bool) or not isinstance(value, int)
+        ):
+            raise TypeError(f"{key} は int である必要があります: {value!r}")
+        elif key == "memo" and not isinstance(value, str):
+            raise TypeError(f"memo は str である必要があります: {value!r}")
+        elif key in ("since", "until") and (
+            isinstance(value, datetime) or not isinstance(value, date)
+        ):
+            raise TypeError(f"{key} は date である必要があります: {value!r}")
+    if (
+        "min_amount" in cond
+        and "max_amount" in cond
+        and cond["min_amount"] > cond["max_amount"]
+    ):
+        raise ValueError("min_amount が max_amount より大きいです")
+    if "since" in cond and "until" in cond and cond["since"] > cond["until"]:
+        raise ValueError("since が until より後の日付です")
+
+
+def _match(e: Expense, cond: dict[str, Any]) -> bool:
+    """Evaluate an already-validated condition. All present keys are ANDed."""
+    if "and" in cond and not all(_match(e, c) for c in cond["and"]):
+        return False
+    if "or" in cond and not any(_match(e, c) for c in cond["or"]):
+        return False
+    if "not" in cond and _match(e, cond["not"]):
+        return False
+    if "category" in cond:
+        cat = cond["category"]
+        ok = e.category == cat if isinstance(cat, str) else e.category in cat
+        if not ok:
+            return False
+    if "min_amount" in cond and e.amount < cond["min_amount"]:
+        return False
+    if "max_amount" in cond and e.amount > cond["max_amount"]:
+        return False
+    if "memo" in cond and _norm(cond["memo"]) not in _norm(e.memo):
+        return False
+    if "since" in cond and e.day < cond["since"]:
+        return False
+    return not ("until" in cond and e.day > cond["until"])
+
+
+def matches(e: Expense, cond: dict | None) -> bool:
+    """Return True if one expense satisfies cond. None and {} match everything."""
+    if not isinstance(e, Expense):
+        raise TypeError(f"e は Expense である必要があります: {type(e).__name__}")
+    if cond is None:
+        return True
+    _check_cond(cond, "cond")
+    return _match(e, cond)
+
+
+def search(rows: list[Expense], cond: dict | None = None) -> list[Expense]:
+    """Return the expenses matching cond, in input order. Input is not modified."""
+    if not isinstance(rows, list):
+        raise TypeError(f"rows は list である必要があります: {type(rows).__name__}")
+    if cond is None:
+        return list(rows)
+    _check_cond(cond, "cond")  # validated even when rows is empty
+    return [e for e in rows if _match(e, cond)]
