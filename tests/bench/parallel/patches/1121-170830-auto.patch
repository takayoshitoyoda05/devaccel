diff --git a/src/kakeibo/core.py b/src/kakeibo/core.py
index 8c3cbab..43ade88 100644
--- a/src/kakeibo/core.py
+++ b/src/kakeibo/core.py
@@ -133,3 +133,44 @@ def find_overruns(
             if cat in limits and actual > limits[cat]:
                 out.append((month, cat, actual - limits[cat], limits[cat], actual))
     return out
+
+
+def usage_tenths(actual: int, limit: int) -> int | None:
+    """Usage ratio in tenths of a percent, floored (1150/1000 -> 1150). None if limit is 0."""
+    if limit == 0:
+        return None
+    return actual * 1000 // limit
+
+
+def find_budget_alerts(
+    totals: dict[str, dict[str, int]], budget: Budget, warn_pct: int = 90
+) -> list[tuple[str, str, str, int, int, int | None]]:
+    """(month, category, level, limit, actual, tenths) for categories at/over budget.
+
+    D1: level は "over"(actual > limit)か "caution"(actual >= limit の warn_pct %、
+        かつ超過でない)。ちょうど warn_pct % は注意に含める。ちょうど予算は注意(超過ではない)。
+    D2: 比較は整数演算(actual * 100 >= limit * warn_pct)。浮動小数点を使わない。
+    D3: 割合 tenths は 0.1% 単位の切り捨て(1001/1000 -> 1001 = 100.1%)。
+    D4: 予算 0 円で実績 > 0 は "over"、tenths は None(割合は出さない)。
+        予算 0 円で実績 0 は何も出さない。
+    D5: 負の実績(返金)は割合が小さくなるだけで、注意・超過にはならない。
+    """
+    if isinstance(warn_pct, bool) or not isinstance(warn_pct, int):
+        raise TypeError("warn_pct は整数である必要があります")
+    if not 0 < warn_pct <= 100:
+        raise ValueError("warn_pct は 1〜100 の整数である必要があります")
+    out: list[tuple[str, str, str, int, int, int | None]] = []
+    for month, cats in totals.items():
+        limits = budget.for_month(month)
+        for cat, actual in cats.items():
+            if cat not in limits:
+                continue
+            limit = limits[cat]
+            if actual > limit:
+                level = "over"
+            elif actual > 0 and actual * 100 >= limit * warn_pct:
+                level = "caution"
+            else:
+                continue
+            out.append((month, cat, level, limit, actual, usage_tenths(actual, limit)))
+    return out
