+def _alerts(totals, limits, **kw):
+    b = Budget(limits, {})
+    return find_budget_alerts(totals, b, **kw)
+
+
+def test_alerts_levels_and_boundary():
+    totals = {"2026-11": {"a": 1001, "b": 1000, "c": 900, "d": 899, "e": 0, "f": 5}}
+    limits = {k: 1000 for k in "abcde"}  # f は予算なし
+    assert _alerts(totals, limits) == [
+        ("2026-11", "a", "over", 1000, 1001, 1001),
+        ("2026-11", "b", "caution", 1000, 1000, 1000),
+        ("2026-11", "c", "caution", 1000, 900, 900),
+    ]
+
+
+def test_alerts_percent_floors():
+    assert _alerts({"m": {"b": 1999}}, {"b": 2000})[0][5] == 999  # 99.95% -> 99.9%
+
+
+def test_alerts_zero_limit():
+    totals = {"2026-11": {"a": 1, "b": 0}}
+    assert _alerts(totals, {"a": 0, "b": 0}) == [("2026-11", "a", "over", 0, 1, None)]
+
+
+def test_alerts_refund_is_not_alert():
+    assert _alerts({"m": {"a": -500}}, {"a": 1000}) == []
+
+
+@pytest.mark.parametrize("bad", [0, 101, -1])
+def test_alerts_warn_pct_range(bad):
+    with pytest.raises(ValueError):
+        _alerts({}, {}, warn_pct=bad)
+
+
+@pytest.mark.parametrize("bad", [True, 90.0, "90", None])
+def test_alerts_warn_pct_type(bad):
+    with pytest.raises(TypeError):
+        _alerts({}, {}, warn_pct=bad)
+
+
+def test_alerts_custom_threshold():
+    r = _alerts({"m": {"a": 800}}, {"a": 1000}, warn_pct=80)
+    assert r == [("m", "a", "caution", 1000, 800, 800)]
+
+
+def test_main_caution_line(tmp_path, monkeypatch, capsys):
+    b = _budget(tmp_path, {"default": {"food": 2200, "rent": 80000}})
+    assert _run(monkeypatch, _csv(tmp_path), "--budget", b) == 0
+    cap = capsys.readouterr()
+    # 2026-11 food 2000/2200 = 90.9% → 注意、rent 100% → 注意。10月 food 500 は対象外
+    assert cap.err == (
+        "注意: 2026-11 rent 予算 80,000円 / 実績 80,000円 (100.0%)\n"
+        "注意: 2026-11 food 予算 2,200円 / 実績 2,000円 (90.9%)\n"
+    )
+
+
+def test_main_below_threshold_silent(tmp_path, monkeypatch, capsys):
