+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, normalize_memo
+
+
+def _e(d: date, amount: int, category: str = "家賃", memo: str = "") -> Expense:
+    return Expense(day=d, category=category, amount=amount, memo=memo)
+
+
+# E1-1〜E1-3: 仕様の例の表
+_TABLE = [
+    (
+        [
+            _e(date(2026, 1, 25), 80000),
+            _e(date(2026, 2, 25), 80000),
+            _e(date(2026, 3, 25), 80000),
+        ],
+        [Recurring("家賃", "", 80000, 3, date(2026, 3, 25), date(2026, 4, 25))],
+    ),
+    (
+        [
+            _e(date(2026, 1, 31), 80000),
+            _e(date(2026, 2, 28), 80000),
+            _e(date(2026, 3, 31), 80000),
+        ],
+        [Recurring("家賃", "", 80000, 3, date(2026, 3, 31), date(2026, 4, 30))],
+    ),
+    (
+        [
+            _e(date(2026, 1, 5), 1490, "動画", "Netflix #1"),
+            _e(date(2026, 2, 5), 1490, "動画", "Netflix #2"),
+            _e(date(2026, 3, 5), 1490, "動画", "NETFLIX #3"),
+        ],
+        [Recurring("動画", "netflix", 1490, 3, date(2026, 3, 5), date(2026, 4, 5))],
+    ),
+]
+
+
+@pytest.mark.parametrize(
+    "rows,expected",
+    _TABLE,
+    ids=["E1-1", "E1-2", "E1-3"],
+)
+def test_spec_table(rows: list[Expense], expected: list[Recurring]) -> None:
+    assert find_recurring(rows) == expected
+
+
+def test_normalize_memo_strips_suffixes_and_case() -> None:
+    assert normalize_memo("Netflix #12") == "netflix"
+    assert normalize_memo("ＮＥＴＦＬＩＸ  No.3") == "netflix"
+    assert normalize_memo("  電気   代 ") == "電気 代"
+
+
+def test_sort_amount_desc_then_category_then_memo() -> None:
+    rows: list[Expense] = []
+    for m in (1, 2, 3):
+        d = date(2026, m, 1)
+        rows += [
+            _e(d, 500, "B", "x"),
+            _e(d, 500, "A", "y"),
+            _e(d, 500, "A", "x"),
+            _e(d, 900, "C", "z"),
+        ]
+    got = [(r.category, r.memo) for r in find_recurring(rows)]
+    assert got == [("C", "z"), ("A", "x"), ("A", "y"), ("B", "x")]
+
+
+def test_same_month_twice_counts_first_only() -> None:
+    rows = [
+        _e(date(2026, 1, 3), 1000),
+        _e(date(2026, 1, 20), 9999),
+        _e(date(2026, 2, 3), 1000),
+        _e(date(2026, 3, 3), 1000),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.months == 3
+    assert r.amount == 1000
+
+
+def test_only_last_consecutive_run_counts() -> None:
+    rows = [_e(date(2026, m, 1), 10000) for m in (1, 2)]
+    rows += [_e(date(2026, m, 1), 80000) for m in (4, 5, 6)]
+    (r,) = find_recurring(rows)
+    assert (r.amount, r.months) == (80000, 3)
+
+
+def test_amount_outside_tolerance_is_not_a_series() -> None:
+    rows = [
+        _e(date(2026, 1, 1), 1000),
+        _e(date(2026, 2, 1), 1000),
+        _e(date(2026, 3, 1), 1500),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_amount_at_tolerance_boundary_is_same_series() -> None:
+    rows = [
+        _e(date(2026, 1, 1), 1000),
+        _e(date(2026, 2, 1), 1100),
+    ]
+    (r,) = find_recurring(rows, min_months=2)
+    assert r.amount == 1000  # 偶数個の中央値は下の値
+    assert r.months == 2
+
+
+def test_negative_amounts_are_ignored_for_detection() -> None:
+    rows = [
+        _e(date(2026, 1, 25), 80000),
+        _e(date(2026, 1, 26), -5000),
+        _e(date(2026, 2, 25), 80000),
+        _e(date(2026, 3, 25), 80000),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.last_day == date(2026, 3, 25)
+    assert r.months == 3
+
+
+def test_missing_month_breaks_run_below_min() -> None:
+    rows = [_e(date(2026, m, 25), 80000) for m in (1, 3)]
+    rows.append(_e(date(2026, 4, 25), 80000))
+    assert find_recurring(rows) == []
+
+
+def test_min_months_is_respected() -> None:
+    rows = [_e(date(2026, m, 25), 80000) for m in (1, 2, 3)]
+    assert find_recurring(rows, min_months=4) == []
+    assert len(find_recurring(rows, min_months=2)) == 1
+
+
+def test_min_months_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_months=1)
+
+
+def test_next_day_rolls_over_year_end() -> None:
+    rows = [_e(date(2026, m, 25), 80000) for m in (10, 11, 12)]
+    (r,) = find_recurring(rows)
+    assert r.next_day == date(2027, 1, 25)
+
+
+def test_next_day_leap_february() -> None:
+    rows = [_e(date(2027, 11, 29), 80000), _e(date(2027, 12, 29), 80000)]
+    rows.append(_e(date(2028, 1, 29), 80000))
+    (r,) = find_recurring(rows)
+    assert r.next_day == date(2028, 2, 29)
