+++ b/src/kakeibo/search.py
@@ -0,0 +1,92 @@
+"""Expense search with a condition tree (And / Or / Not and leaf conditions)."""
+
+from __future__ import annotations
+
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def _norm(s: str) -> str:
+    """NFKC normalization followed by case folding."""
+    return unicodedata.normalize("NFKC", s).casefold()
+
+
+@dataclass(frozen=True)
+class Category:
+    name: str
+
+
+@dataclass(frozen=True)
+class AmountRange:
+    min: int | None = None
+    max: int | None = None
+
+
+@dataclass(frozen=True)
+class MemoContains:
+    text: str
+
+
+@dataclass(frozen=True)
+class DateRange:
+    start: date | None = None
+    end: date | None = None
+
+
+@dataclass(frozen=True, init=False)
+class And:
+    conds: tuple[Condition, ...]
+
+    def __init__(self, *conds: Condition) -> None:
+        object.__setattr__(self, "conds", tuple(conds))
+
+
+@dataclass(frozen=True, init=False)
+class Or:
+    conds: tuple[Condition, ...]
+
+    def __init__(self, *conds: Condition) -> None:
+        object.__setattr__(self, "conds", tuple(conds))
+
+
+@dataclass(frozen=True)
+class Not:
+    cond: Condition
+
+
+Condition = Category | AmountRange | MemoContains | DateRange | And | Or | Not
+
+
+def matches(e: Expense, cond: Condition) -> bool:
+    """Return True if expense ``e`` satisfies ``cond``."""
+    if isinstance(cond, Category):
+        return _norm(e.category.strip()) == _norm(cond.name.strip())
+    if isinstance(cond, AmountRange):
+        if cond.min is not None and cond.max is not None and cond.min > cond.max:
+            raise ValueError(f"min > max: {cond.min} > {cond.max}")
+        return (cond.min is None or e.amount >= cond.min) and (
+            cond.max is None or e.amount <= cond.max
+        )
+    if isinstance(cond, MemoContains):
+        return _norm(cond.text) in _norm(e.memo)
+    if isinstance(cond, DateRange):
+        if cond.start is not None and cond.end is not None and cond.start > cond.end:
+            raise ValueError(f"start > end: {cond.start} > {cond.end}")
+        return (cond.start is None or e.day >= cond.start) and (
+            cond.end is None or e.day <= cond.end
+        )
+    if isinstance(cond, And):
+        return all(matches(e, c) for c in cond.conds)
+    if isinstance(cond, Or):
+        return any(matches(e, c) for c in cond.conds)
+    if isinstance(cond, Not):
+        return not matches(e, cond.cond)
+    raise TypeError(f"条件ではありません: {cond!r}")
+
+
+def search(rows: list[Expense], cond: Condition) -> list[Expense]:
+    """Return the expenses matching ``cond``, in their original order."""
+    return [e for e in rows if matches(e, cond)]
