+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import ImportResult, RowError, import_bank_csv
+from kakeibo.core import Expense
+
+
+def _one(text: str) -> ImportResult:
+    return import_bank_csv(text)
+
+
+# 例の表 E2-1 / E2-2 / E2-3 (ID はテスト名と ids に明記)
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param(
+            '利用日,ご利用店名,利用金額\n2026/1/5,カフェ,"1,200円"',
+            ImportResult(
+                expenses=[Expense(date(2026, 1, 5), "未分類", 1200, "カフェ")],
+                errors=[],
+            ),
+            id="E2-1",
+        ),
+        pytest.param(
+            "日付,出金,入金\n2026-01-05,,3000",
+            ImportResult(
+                expenses=[Expense(date(2026, 1, 5), "未分類", -3000, "")],
+                errors=[],
+            ),
+            id="E2-2",
+        ),
+    ],
+)
+def test_example_table(text: str, expected: ImportResult) -> None:
+    assert _one(text) == expected
+
+
+def test_E2_3_invalid_date_and_amount_are_two_row_errors() -> None:
+    result = _one("日付,金額\n2026-02-30,abc")
+    assert result.expenses == []
+    assert result.errors == [
+        RowError(
+            line=2, column="日付", value="2026-02-30", reason="存在しない日付です"
+        ),
+        RowError(line=2, column="金額", value="abc", reason="金額が整数ではありません"),
+    ]
+
+
+# R3: 日付の書式
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026.1.5",
+        "20260105",
+        "2026年1月5日",
+        "２０２６－０１－０５",
+        "2026-01-05 12:30",
+    ],
+)
+def test_date_formats(raw: str) -> None:
+    result = _one(f"日付,金額\n{raw},100")
+    assert result.errors == []
+    assert result.expenses[0].day == date(2026, 1, 5)
+
+
+# R4: 金額の書式
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        ("1234", 1234),
+        ("1,234", 1234),
+        ("１，２３４", 1234),
+        ("¥1,234", 1234),
+        ("￥1,234", 1234),
+        ("1,234円", 1234),
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+    ],
+)
+def test_amount_formats(raw: str, expected: int) -> None:
+    result = _one(f'日付,金額\n2026-01-05,"{raw}"')
+    assert result.errors == []
+    assert result.expenses[0].amount == expected
+
+
+@pytest.mark.parametrize("raw", ["12.5", "", "-", "abc"])
+def test_invalid_amount_is_row_error(raw: str) -> None:
+    result = _one(f"日付,金額\n2026-01-05,{raw}")
+    assert result.expenses == []
+    assert len(result.errors) == 1
+    assert result.errors[0] == RowError(2, "金額", raw, result.errors[0].reason)
+
+
+# R5: 出金/入金
+def test_both_outflow_and_inflow_empty_is_row_error() -> None:
+    result = _one("日付,出金,入金\n2026-01-05,,")
+    assert result.expenses == []
+    assert [e.column for e in result.errors] == ["出金/入金"]
+
+
+def test_outflow_only_row_is_positive_expense() -> None:
+    result = _one("日付,出金,入金\n2026-01-05,500,")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 500, "")]
+
+
+# R1: ヘッダー別名・カテゴリ・メモ
+def test_alias_headers_are_case_and_space_insensitive() -> None:
+    text = " DATE , Amount ,Category, Description \n2026-01-05,700,食費,ランチ"
+    result = _one(text)
+    assert result.expenses == [Expense(date(2026, 1, 5), "食費", 700, "ランチ")]
+
+
+def test_category_empty_cell_uses_default() -> None:
+    result = import_bank_csv("日付,金額,分類\n2026-01-05,700,", default_category="雑費")
+    assert result.expenses[0].category == "雑費"
+
+
+# R2: BOM・タブ区切り・引用符内の改行・行番号・空行
+def test_bom_and_tab_delimiter() -> None:
+    text = "﻿日付\t金額\t摘要\n2026-01-05\t700\tカフェ"
+    result = _one(text)
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 700, "カフェ")]
+
+
+def test_quoted_newline_and_line_numbers_skip_blank_lines() -> None:
+    text = '日付,金額,摘要\n\n2026-01-05,100,"a\nb"\n\n2026-01-06,x,c'
+    result = _one(text)
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "a\nb")]
+    assert [e.line for e in result.errors] == [6]
+
+
+# R6: 1 行に誤りが複数ならすべて RowError、列数不足
+def test_multiple_errors_in_one_row_produce_no_expense() -> None:
+    result = _one("日付,金額\n2026-13-01,x")
+    assert result.expenses == []
+    assert [e.column for e in result.errors] == ["日付", "金額"]
+
+
+def test_too_few_columns_is_row_error_with_empty_column() -> None:
+    result = _one("日付,金額,摘要\n2026-01-05")
+    assert result.expenses == []
+    assert len(result.errors) == 1
+    assert result.errors[0].column == ""
+    assert "3" in result.errors[0].reason
+
+
+# R7: 必須列欠落・空入力・ヘッダーのみ
+def test_missing_date_column_raises_value_error() -> None:
+    with pytest.raises(ValueError, match="日付"):
+        import_bank_csv("金額,摘要\n100,a")
+
+
+def test_missing_amount_columns_raises_value_error() -> None:
+    with pytest.raises(ValueError, match="金額"):
+        import_bank_csv("日付,摘要\n2026-01-05,a")
+
+
+@pytest.mark.parametrize("text", ["", "  \n\n", "日付,金額", "日付,金額\n"])
+def test_empty_or_header_only_gives_empty_result(text: str) -> None:
+    assert _one(text) == ImportResult(expenses=[], errors=[])
