+"""Import bank statement CSV exports into Expense records (pure functions).
+
+Column roles are chosen by header alias. Structural problems (missing required
+columns) raise ValueError; per-row problems are collected as RowError.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str
+    value: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+
+
+_DATE_ALIASES = ("日付", "利用日", "取引日", "ご利用日", "date")
+_AMOUNT_ALIASES = ("金額", "利用金額", "ご利用金額", "amount")
+_OUT_ALIASES = ("出金", "出金額", "お支払金額", "支払")
+_IN_ALIASES = ("入金", "入金額", "預入")
+_MEMO_ALIASES = (
+    "摘要",
+    "メモ",
+    "利用店名",
+    "ご利用店名",
+    "内容",
+    "description",
+    "memo",
+)
+_CATEGORY_ALIASES = ("カテゴリ", "分類", "category")
+
+_DATE_PATTERNS = (
+    re.compile(r"([0-9]{4})[-/.]([0-9]{1,2})[-/.]([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})"),
+    re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日"),
+)
+_SIGN_CHARS = "-−△▲"
+
+
+class _CellError(Exception):
+    """A single cell could not be converted; the message is the reason."""
+
+
+@dataclass(frozen=True)
+class _Layout:
+    date: int
+    amount: int | None
+    out: int | None
+    inc: int | None
+    memo: int | None
+    category: int | None
+    width: int
+
+
+def _norm(raw: str) -> str:
+    return unicodedata.normalize("NFKC", raw).strip()
+
+
+def _find(header: list[str], aliases: tuple[str, ...]) -> int | None:
+    for i, name in enumerate(header):
+        if name in aliases:
+            return i
+    return None
+
+
+def _layout(header: list[str]) -> _Layout:
+    date_i = _find(header, _DATE_ALIASES)
+    amount_i = _find(header, _AMOUNT_ALIASES)
+    out_i = _find(header, _OUT_ALIASES)
+    in_i = _find(header, _IN_ALIASES)
+    missing: list[str] = []
+    if date_i is None:
+        missing.append("日付")
+    if amount_i is None and out_i is None and in_i is None:
+        missing.append("金額(または出金/入金)")
+    if missing or date_i is None:
+        raise ValueError("必須列がありません: " + ", ".join(missing))
+    return _Layout(
+        date=date_i,
+        amount=amount_i,
+        out=out_i,
+        inc=in_i,
+        memo=_find(header, _MEMO_ALIASES),
+        category=_find(header, _CATEGORY_ALIASES),
+        width=len(header),
+    )
+
+
+def _parse_date(raw: str) -> date:
+    parts = _norm(raw).split()
+    if not parts:
+        raise _CellError("日付が空です")
+    head = parts[0]  # drop a trailing time part such as "12:30"
+    for pattern in _DATE_PATTERNS:
+        m = pattern.fullmatch(head)
+        if m is not None:
+            y, mo, d = (int(g) for g in m.groups())
+            try:
+                return date(y, mo, d)
+            except ValueError:
+                raise _CellError("存在しない日付です") from None
+    raise _CellError("日付の書式が不正です")
+
+
+def _parse_yen(raw: str) -> int:
+    text = re.sub(r"[\s,]", "", _norm(raw)).replace("¥", "").replace("円", "")
+    if not text:
+        raise _CellError("金額が空です")
+    negative = False
+    if text[0] in _SIGN_CHARS:
+        negative = True
+        text = text[1:]
+    elif text[-1] == "-":
+        negative = True
+        text = text[:-1]
+    elif text.startswith("(") and text.endswith(")"):
+        negative = True
+        text = text[1:-1]
+    if not re.fullmatch(r"[0-9]+", text):
+        raise _CellError("金額が整数ではありません")
+    value = int(text)
+    return -value if negative else value
+
+
+def _is_blank(row: list[str]) -> bool:
+    return row == [] or (len(row) == 1 and not row[0].strip())
+
+
+def _convert(
+    row: list[str], lay: _Layout, line: int, default_category: str
+) -> tuple[Expense | None, list[RowError]]:
+    errors: list[RowError] = []
+
+    def fail(column: str, value: str, reason: str) -> None:
+        errors.append(RowError(line, column, value, reason))
+
+    day = None
+    raw_date = row[lay.date]
+    try:
+        day = _parse_date(raw_date)
+    except _CellError as e:
+        fail("日付", raw_date, str(e))
+
+    amount: int | None = None
+    if lay.amount is not None:
+        raw_amount = row[lay.amount]
+        try:
+            amount = _parse_yen(raw_amount)
+        except _CellError as e:
+            fail("金額", raw_amount, str(e))
+    else:
+        out_raw = _norm(row[lay.out]) if lay.out is not None else ""
+        in_raw = _norm(row[lay.inc]) if lay.inc is not None else ""
+        if out_raw and in_raw:
+            fail("出金/入金", f"{out_raw} / {in_raw}", "出金と入金の両方に値があります")
+        elif out_raw:
+            try:
+                amount = abs(_parse_yen(out_raw))
+            except _CellError as e:
+                fail("出金", out_raw, str(e))
+        elif in_raw:
+            try:
+                amount = -abs(_parse_yen(in_raw))
+            except _CellError as e:
+                fail("入金", in_raw, str(e))
+        else:
+            fail("出金/入金", "", "出金と入金がどちらも空です")
+
+    category = default_category
+    if lay.category is not None and row[lay.category].strip():
+        category = row[lay.category].strip()
+    memo = row[lay.memo].strip() if lay.memo is not None else ""
+
+    if errors or day is None or amount is None:
+        return None, errors
+    return Expense(day=day, category=category, amount=amount, memo=memo), errors
+
+
+def import_bank_csv(text: str, default_category: str = "未分類") -> ImportResult:
+    body = text.removeprefix("﻿")
+    header_line = next((ln for ln in body.splitlines() if ln.strip()), "")
+    delimiter = "\t" if "\t" in header_line else ","
+    reader = csv.reader(io.StringIO(body), delimiter=delimiter)
+
+    lay: _Layout | None = None
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    while True:
+        line = reader.line_num + 1  # the record starts after the last consumed line
+        try:
+            row = next(reader)
+        except StopIteration:
+            break
+        if _is_blank(row):
+            continue
+        if lay is None:
+            lay = _layout([cell.strip().lower() for cell in row])
+            continue
+        if len(row) < lay.width:
+            errors.append(
+                RowError(
+                    line,
+                    "",
+                    ",".join(row),
+                    f"列数が不足しています(ヘッダー {lay.width} 列、行 {len(row)} 列)",
+                )
+            )
+            continue
+        expense, row_errors = _convert(row, lay, line, default_category)
+        errors.extend(row_errors)
+        if expense is not None:
+            expenses.append(expense)
+    return ImportResult(expenses=expenses, errors=errors)
