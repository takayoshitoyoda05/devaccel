@@ -0,0 +1,98 @@
+"""Month-over-month comparison of expenses by category (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class Change:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _parse_month(month: str) -> date:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"month は YYYY-MM 形式である必要があります: {month!r}")
+    return date(int(month[:4]), int(month[5:7]), 1)
+
+
+def _previous_month(month: str) -> str:
+    first = _parse_month(month)
+    if first.month == 1:
+        return f"{first.year - 1:04d}-12"
+    return f"{first.year:04d}-{first.month - 1:02d}"
+
+
+def _sum_by_category(rows: list[Expense], month: str) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for e in rows:
+        if e.day.strftime("%Y-%m") == month:
+            out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def _status(previous: int, current: int, delta: int) -> str:
+    if previous == 0 and current > 0:
+        return "新規"
+    if previous > 0 and current == 0:
+        return "なし"
+    if delta > 0:
+        return "増"
+    if delta < 0:
+        return "減"
+    return "変化なし"
+
+
+def month_over_month(rows: list[Expense], month: str) -> list[Change]:
+    """Compare `month` (YYYY-MM) with the month before it, by category.
+
+    Refunds (negative amounts) are summed in. Categories absent from both
+    months are omitted. Sorted by abs(delta) descending, then category ascending.
+    """
+    prev_month = _previous_month(month)
+    this_totals = _sum_by_category(rows, month)
+    prev_totals = _sum_by_category(rows, prev_month)
+
+    changes: list[Change] = []
+    for cat in set(this_totals) | set(prev_totals):
+        previous = prev_totals.get(cat, 0)
+        current = this_totals.get(cat, 0)
+        delta = current - previous
+        pct = None if previous == 0 else round(delta / previous * 100, 1)
+        changes.append(
+            Change(
+                category=cat,
+                previous=previous,
+                current=current,
+                delta=delta,
+                pct=pct,
+                status=_status(previous, current, delta),
+            )
+        )
+    changes.sort(key=lambda c: (-abs(c.delta), c.category))
+    return changes
+
+
+def format_report(changes: list[Change]) -> str:
+    """One line per category: `カテゴリ: 前月→今月 (+N円, +x.x%) 増`.
+
+    The % part is omitted when pct is None. Empty input gives an empty string.
+    """
+    lines: list[str] = []
+    for c in changes:
+        detail = f"{c.delta:+d}円"
+        if c.pct is not None:
+            detail += f", {c.pct:+.1f}%"
+        lines.append(f"{c.category}: {c.previous}→{c.current} ({detail}) {c.status}")
+    return "\n".join(lines)
