@@ -0,0 +1,114 @@
+"""Detect recurring monthly expenses (pure functions, stdlib only)."""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+# 末尾の「#12」「No.3」「 2」などの連番を落とす
+_TAIL_RE = re.compile(r"\s*(?:#\s*\d+|no\.?\s*\d+|\d+)$")
+_SPACES_RE = re.compile(r"\s+")
+
+# 金額の許容幅(中央値の ±10%)
+_TOLERANCE_PERCENT = 10
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int
+    months: int
+    last_day: date
+    next_day: date
+
+
+def normalize_memo(memo: str) -> str:
+    """NFKC・小文字化・空白の畳み込み・末尾の連番除去。"""
+    s = unicodedata.normalize("NFKC", memo).lower()
+    s = _SPACES_RE.sub(" ", s).strip()
+    return _TAIL_RE.sub("", s).strip()
+
+
+def _lower_median(values: list[int]) -> int:
+    s = sorted(values)
+    return s[(len(s) - 1) // 2]
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month - 1
+
+
+def _last_run(by_month: dict[int, list[Expense]]) -> list[int]:
+    """欠けた月で区切った最後の連続区間(月インデックス)。"""
+    months = sorted(by_month)
+    run = [months[0]]
+    for m in months[1:]:
+        if m == run[-1] + 1:
+            run.append(m)
+        else:
+            run = [m]
+    return run
+
+
+def _next_day(last_day: date, day_of_month: int) -> date:
+    year, month = (last_day.year, last_day.month + 1)
+    if month > 12:
+        year, month = year + 1, 1
+    last_dom = calendar.monthrange(year, month)[1]
+    return date(year, month, min(day_of_month, last_dom))
+
+
+def _build(
+    category: str, memo: str, by_month: dict[int, list[Expense]], run: list[int]
+) -> Recurring | None:
+    firsts = [min(by_month[m], key=lambda e: e.day) for m in run]
+    amounts = [e.amount for e in firsts]
+    amount = _lower_median(amounts)
+    # 金額が中央値の ±10% を外れる月があれば、この連続区間は系列ではない
+    if any(abs(a - amount) * 100 > amount * _TOLERANCE_PERCENT for a in amounts):
+        return None
+    all_days = [e.day for m in run for e in by_month[m]]
+    last_day = max(all_days)
+    day_of_month = _lower_median([e.day.day for e in firsts])
+    return Recurring(
+        category=category,
+        memo=memo,
+        amount=amount,
+        months=len(run),
+        last_day=last_day,
+        next_day=_next_day(last_day, day_of_month),
+    )
+
+
+def find_recurring(rows: list[Expense], min_months: int = 3) -> list[Recurring]:
+    """毎月 1 回ずつ min_months か月以上続く、同額の支出を検出する。
+
+    返金・入金(amount < 0)は対象外。結果は金額の降順、次に category、memo の昇順。
+    """
+    if min_months < 2:
+        raise ValueError("min_months は 2 以上である必要があります")
+
+    groups: dict[tuple[str, str], dict[int, list[Expense]]] = {}
+    for e in rows:
+        if e.amount < 0:
+            continue
+        key = (e.category, normalize_memo(e.memo))
+        groups.setdefault(key, {}).setdefault(_month_index(e.day), []).append(e)
+
+    found: list[Recurring] = []
+    for (category, memo), by_month in groups.items():
+        run = _last_run(by_month)
+        if len(run) < min_months:
+            continue
+        rec = _build(category, memo, by_month, run)
+        if rec is not None:
+            found.append(rec)
+
+    found.sort(key=lambda r: (-r.amount, r.category, r.memo))
+    return found
