@@ -0,0 +1,156 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    AmountRange,
+    And,
+    Category,
+    DateRange,
+    MemoContains,
+    Not,
+    Or,
+    matches,
+    search,
+)
+
+FOOD = Expense(day=date(2024, 3, 10), category="食費", amount=1200, memo="ランチ")
+SUB = Expense(day=date(2024, 3, 15), category="Subscription", amount=5, memo="netflix")
+REFUND = Expense(day=date(2024, 4, 1), category="食費", amount=-300, memo="返金")
+ROWS = [FOOD, SUB, REFUND]
+
+
+# --- 例の表 (E3) -----------------------------------------------------------
+
+
+@pytest.mark.parametrize("eid", ["E3-1"])
+def test_e3_1_empty_or_is_false_for_all_rows(eid: str) -> None:
+    # E3-1: Or() -> 全明細で False (R1)
+    assert all(matches(e, Or()) is False for e in ROWS)
+
+
+@pytest.mark.parametrize("eid", ["E3-2"])
+def test_e3_2_memo_contains_fullwidth_matches_ascii_casefold(eid: str) -> None:
+    # E3-2: MemoContains("ＮＥＴ") が memo netflix -> True (R2)
+    assert matches(SUB, MemoContains("ＮＥＴ")) is True
+
+
+@pytest.mark.parametrize("eid", ["E3-3"])
+def test_e3_3_amount_range_min_gt_max_raises(eid: str) -> None:
+    # E3-3: AmountRange(min=5, max=1) -> ValueError (R3)
+    with pytest.raises(ValueError):
+        matches(FOOD, AmountRange(min=5, max=1))
+
+
+# --- 端のケース (仕様の文面から) ------------------------------------------
+
+
+def test_empty_and_is_true() -> None:
+    # R1
+    assert all(matches(e, And()) is True for e in ROWS)
+
+
+def test_nested_empty_combinations() -> None:
+    # R1: 入れ子の空の And / Or
+    assert matches(FOOD, And(Or(), And())) is False
+    assert matches(FOOD, Or(And(), Or())) is True
+
+
+def test_memo_contains_empty_string_is_always_true() -> None:
+    # R2: 空文字は常に真
+    assert all(matches(e, MemoContains("")) is True for e in ROWS)
+
+
+def test_memo_contains_casefold_partial() -> None:
+    # R2: 大文字小文字無視の部分一致
+    assert matches(SUB, MemoContains("FLIX")) is True
+    assert matches(SUB, MemoContains("hulu")) is False
+
+
+def test_category_exact_match_ignores_case_and_outer_space() -> None:
+    # R2: NFKC + 前後空白除去 + 大文字小文字無視の完全一致
+    assert matches(SUB, Category("  subscription ")) is True
+    assert matches(SUB, Category("subscript")) is False
+    assert matches(SUB, Category("Subscription X")) is False
+
+
+def test_category_nfkc_normalizes() -> None:
+    # R2: 全角英数字も一致
+    assert matches(SUB, Category("ＳＵＢＳＣＲＩＰＴＩＯＮ")) is True
+
+
+def test_amount_range_inclusive_both_ends() -> None:
+    # R3: 両端を含む
+    assert matches(FOOD, AmountRange(min=1200, max=1200)) is True
+    assert matches(FOOD, AmountRange(min=1201)) is False
+    assert matches(FOOD, AmountRange(max=1199)) is False
+
+
+def test_amount_range_none_is_unbounded() -> None:
+    # R3: None は無制限
+    assert matches(REFUND, AmountRange()) is True
+    assert matches(REFUND, AmountRange(max=0)) is True
+    assert matches(FOOD, AmountRange(min=0)) is True
+
+
+def test_amount_range_negative_refund() -> None:
+    # D1: 返金(負)も範囲に入る
+    assert matches(REFUND, AmountRange(max=-1)) is True
+    assert matches(REFUND, AmountRange(min=0)) is False
+
+
+def test_date_range_inclusive_both_ends() -> None:
+    # R3: 両端を含む
+    assert (
+        matches(FOOD, DateRange(start=date(2024, 3, 10), end=date(2024, 3, 10))) is True
+    )
+    assert matches(FOOD, DateRange(start=date(2024, 3, 11))) is False
+    assert matches(FOOD, DateRange(end=date(2024, 3, 9))) is False
+
+
+def test_date_range_none_is_unbounded() -> None:
+    # R3: None は無制限
+    assert matches(FOOD, DateRange()) is True
+
+
+def test_date_range_min_gt_max_raises_at_match_time() -> None:
+    # R3: start > end は matches 時に ValueError
+    cond = DateRange(start=date(2024, 5, 1), end=date(2024, 4, 1))
+    with pytest.raises(ValueError):
+        matches(FOOD, cond)
+
+
+def test_not_inverts() -> None:
+    assert matches(FOOD, Not(Category("食費"))) is False
+    assert matches(SUB, Not(Category("食費"))) is True
+
+
+def test_and_or_combination() -> None:
+    cond = Or(And(Category("食費"), AmountRange(min=1000)), MemoContains("netflix"))
+    assert [e for e in ROWS if matches(e, cond)] == [FOOD, SUB]
+
+
+def test_search_keeps_order_and_returns_new_list() -> None:
+    # R4: 元の並びを保ち、新しいリストを返す
+    result = search(ROWS, AmountRange(min=0))
+    assert result == [FOOD, SUB]
+    assert result is not ROWS
+
+
+def test_search_empty_rows_returns_empty_list() -> None:
+    assert search([], And()) == []
+
+
+def test_unknown_condition_type_raises_type_error() -> None:
+    # R5: 条件でない値は TypeError
+    with pytest.raises(TypeError):
+        matches(FOOD, "食費")  # type: ignore[arg-type]
+
+
+def test_unknown_condition_nested_raises_type_error() -> None:
+    # R5: 入れ子の中の未知の型も TypeError
+    with pytest.raises(TypeError):
+        matches(FOOD, And(Category("食費"), 42))  # type: ignore[arg-type]
