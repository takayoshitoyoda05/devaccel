+++ b/tests/test_mom_report.py
@@ -0,0 +1,135 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.mom_report import Change, format_report, month_over_month
+
+
+def E(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+def find(changes: list[Change], category: str) -> Change:
+    return next(c for c in changes if c.category == category)
+
+
+# E4-1: 食費 前月 1000 今月 1500 -> delta=500, pct=50.0, status=増 (R3)
+# E4-2: 前月に無く今月 800 の趣味 -> pct=None, status=新規 (R2)
+# E4-3: month="2026-13" -> ValueError (R1)
+
+
+def test_E4_1_increase_with_pct() -> None:
+    rows = [E("2026-03-05", "食費", 1000), E("2026-04-05", "食費", 1500)]
+    c = find(month_over_month(rows, "2026-04"), "食費")
+    assert c.delta == 500
+    assert c.pct == 50.0
+    assert c.status == "増"
+
+
+def test_E4_2_new_category_has_no_pct() -> None:
+    rows = [E("2026-04-10", "趣味", 800)]
+    c = find(month_over_month(rows, "2026-04"), "趣味")
+    assert c.pct is None
+    assert c.status == "新規"
+
+
+def test_E4_3_invalid_month_raises() -> None:
+    with pytest.raises(ValueError):
+        month_over_month([], "2026-13")
+
+
+@pytest.mark.parametrize(
+    "month",
+    ["2026-4", "2026/04", "26-04", "2026-00", "2026-04-01", ""],
+    ids=["no-zero-pad", "slash", "short-year", "month-00", "with-day", "empty"],
+)
+def test_R1_malformed_month_raises(month: str) -> None:
+    with pytest.raises(ValueError):
+        month_over_month([], month)
+
+
+def test_R1_january_compares_with_previous_december() -> None:
+    rows = [E("2025-12-20", "食費", 900), E("2026-01-03", "食費", 1200)]
+    c = find(month_over_month(rows, "2026-01"), "食費")
+    assert c.previous == 900
+    assert c.current == 1200
+    assert c.delta == 300
+
+
+def test_R2_status_decrease() -> None:
+    rows = [E("2026-03-01", "食費", 1000), E("2026-04-01", "食費", 400)]
+    c = find(month_over_month(rows, "2026-04"), "食費")
+    assert (c.delta, c.pct, c.status) == (-600, -60.0, "減")
+
+
+def test_R2_status_no_change() -> None:
+    rows = [E("2026-03-01", "食費", 1000), E("2026-04-01", "食費", 1000)]
+    c = find(month_over_month(rows, "2026-04"), "食費")
+    assert (c.delta, c.pct, c.status) == (0, 0.0, "変化なし")
+
+
+def test_R2_status_disappeared() -> None:
+    rows = [E("2026-03-01", "娯楽", 500)]
+    c = find(month_over_month(rows, "2026-04"), "娯楽")
+    assert (c.current, c.delta, c.pct, c.status) == (0, -500, -100.0, "なし")
+
+
+def test_R3_category_only_in_previous_month_is_included() -> None:
+    rows = [E("2026-03-01", "娯楽", 500)]
+    changes = month_over_month(rows, "2026-04")
+    assert [c.category for c in changes] == ["娯楽"]
+
+
+def test_R3_category_in_neither_month_is_excluded() -> None:
+    rows = [E("2026-01-01", "旧カテゴリ", 500), E("2026-04-01", "食費", 10)]
+    cats = [c.category for c in month_over_month(rows, "2026-04")]
+    assert "旧カテゴリ" not in cats
+    assert cats == ["食費"]
+
+
+def test_R3_refunds_are_summed_in() -> None:
+    rows = [
+        E("2026-03-01", "食費", 1000),
+        E("2026-04-01", "食費", 1500),
+        E("2026-04-02", "食費", -500),
+    ]
+    c = find(month_over_month(rows, "2026-04"), "食費")
+    assert c.current == 1000
+    assert c.delta == 0
+    assert c.status == "変化なし"
+
+
+def test_R4_sorted_by_abs_delta_then_category() -> None:
+    rows = [
+        E("2026-03-01", "B", 100),
+        E("2026-03-01", "A", 100),
+        E("2026-03-01", "C", 1000),
+        E("2026-04-01", "A", 200),  # delta +100
+        E("2026-04-01", "B", 0),  # delta -100 (tie with A)
+        E("2026-04-01", "C", 900),  # delta -100 (tie)
+        E("2026-04-01", "D", 500),  # delta +500 (largest)
+    ]
+    cats = [c.category for c in month_over_month(rows, "2026-04")]
+    assert cats == ["D", "A", "B", "C"]
+
+
+def test_R4_both_months_empty_gives_empty_list() -> None:
+    rows = [E("2026-01-01", "食費", 100)]
+    assert month_over_month(rows, "2026-04") == []
+
+
+def test_R5_format_line() -> None:
+    rows = [E("2026-03-01", "食費", 1000), E("2026-04-01", "食費", 1500)]
+    text = format_report(month_over_month(rows, "2026-04"))
+    assert text == "食費: 1000→1500 (+500円, +50.0%) 増"
+
+
+def test_R5_pct_omitted_when_none() -> None:
+    rows = [E("2026-04-10", "趣味", 800)]
+    text = format_report(month_over_month(rows, "2026-04"))
+    assert text == "趣味: 0→800 (+800円) 新規"
+
+
+def test_R5_empty_is_empty_string() -> None:
+    assert format_report([]) == ""
