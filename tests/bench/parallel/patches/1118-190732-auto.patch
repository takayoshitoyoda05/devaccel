new file mode 100644
index 0000000..bba7223
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,117 @@
+"""Import bank statement CSV text (他行 CSV) into Expense records."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"-?[¥￥]?[0-9][0-9,]*円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    """Parse a bank amount such as ``" ￥1,234 "`` or ``"-¥300"`` into yen."""
+    t = s.strip()
+    if not _AMOUNT_RE.fullmatch(t):
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    digits = re.sub(r"[¥￥円,]", "", t)
+    return int(digits)
+
+
+def parse_date(s: str) -> date:
+    """Parse ``YYYY/M/D`` or ``YYYY-M-D`` (separators must match)."""
+    t = s.strip()
+    m = _DATE_RE.fullmatch(t)
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    try:
+        return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Read CSV text (header on line 1) into expenses.
+
+    Returns ``(expenses, errors)`` where errors are ``(line_number, field)``.
+    Rows with any error are excluded from expenses. Blank lines are skipped
+    but still counted in line numbers.
+    """
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    try:
+        header = next(reader)
+    except StopIteration:
+        header = []
+    index = {name: i for i, name in enumerate(header)}
+    for column in mapping.values():
+        if column not in index:
+            raise ValueError(f"列 {column!r} がヘッダーにありません")
+
+    def cell(row: list[str], field: str) -> str:
+        if field not in mapping:
+            return ""
+        i = index[mapping[field]]
+        return row[i] if i < len(row) else ""
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    while True:
+        line_no = reader.line_num + 1
+        try:
+            row = next(reader)
+        except StopIteration:
+            break
+        if not row or (len(row) == 1 and not row[0].strip()):
+            continue
+
+        row_errors: list[tuple[int, str]] = []
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(cell(row, "date"))
+        except ValueError:
+            row_errors.append((line_no, "date"))
+        try:
+            amount = parse_amount(cell(row, "amount"))
+        except ValueError:
+            row_errors.append((line_no, "amount"))
+        category = cell(row, "category").strip()
+        if not category:
+            row_errors.append((line_no, "category"))
+
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        assert day is not None and amount is not None
+        if category_map and category in category_map:
+            category = category_map[category]
+        expenses.append(
+            Expense(
+                day=day,
+                category=category,
+                amount=amount,
+                memo=cell(row, "memo").strip(),
+            )
+        )
+    return expenses, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
new file mode 100644
index 0000000..b2f477d
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,102 @@
+"""Month-over-month comparison of expenses (pure functions, stdlib only)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not isinstance(month, str) or not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def _ym(day: date) -> str:
+    return f"{day.year:04d}-{day.month:02d}"
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+
+    prev_tot: dict[str, int] = {}
+    curr_tot: dict[str, int] = {}
+    prev_seen: set[str] = set()
+    curr_seen: set[str] = set()
+    for e in rows:
+        m = _ym(e.day)
+        if m == prev_month:
+            prev_tot[e.category] = prev_tot.get(e.category, 0) + e.amount
+            prev_seen.add(e.category)
+        if m == curr_month:
+            curr_tot[e.category] = curr_tot.get(e.category, 0) + e.amount
+            curr_seen.add(e.category)
+
+    out: list[DiffRow] = []
+    for cat in prev_seen | curr_seen:
+        prev = prev_tot.get(cat, 0)
+        curr = curr_tot.get(cat, 0)
+        delta = curr - prev
+        # "+ 0.0" normalizes a negative zero (e.g. a tiny negative delta rounding to 0).
+        pct = None if prev == 0 else round(delta / prev * 100, 1) + 0.0
+        if cat not in prev_seen:
+            status = "new"
+        elif cat not in curr_seen:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+
+    out.sort(key=lambda r: (-abs(r.delta), r.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [d for d in diffs if d.status != "same"][:n]
+
+
+def _fmt_pct(pct: float | None) -> str:
+    if pct is None:
+        return "-"
+    return f"{pct + 0.0:+.1f}%"
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for d in diffs:
+        lines.append(
+            f"{d.category}\t{d.prev}\t{d.curr}\t{d.delta:+d}\t{_fmt_pct(d.pct)}"
+        )
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_ym(e.day) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には明細のある月が 2 つ以上必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..391737f
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,149 @@
+"""Search query language: tokenize, parse, and evaluate against Expense rows."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from kakeibo.core import Expense
+
+
+class QueryError(ValueError):
+    """Raised when a search query is malformed."""
+
+
+Token = tuple[str, str]
+Node = tuple[Any, ...]
+
+_OPERATORS = ("AND", "OR", "NOT")
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    tokens: list[Token] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError("引用符が閉じられていません")
+            body = q[i + 1 : end]
+            if body == "":
+                raise QueryError("空の引用符は使えません")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            j = i
+            while j < n and not (q[j].isspace() or q[j] in '()"'):
+                j += 1
+            word = q[i:j]
+            i = j
+            if word in _OPERATORS:
+                tokens.append((word, word))
+            elif word.startswith("cat:"):
+                value = word[len("cat:") :]
+                if value == "":
+                    raise QueryError("cat: の後ろにカテゴリ名がありません")
+                tokens.append(("CAT", value))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self.toks = tokens
+        self.pos = 0
+
+    def _peek(self) -> str | None:
+        return self.toks[self.pos][0] if self.pos < len(self.toks) else None
+
+    def _take(self) -> Token:
+        tok = self.toks[self.pos]
+        self.pos += 1
+        return tok
+
+    def parse(self) -> Node:
+        if not self.toks:
+            raise QueryError("クエリが空です")
+        node = self._or_expr()
+        if self.pos != len(self.toks):
+            raise QueryError(f"余分なトークンがあります: {self.toks[self.pos][1]!r}")
+        return node
+
+    def _or_expr(self) -> Node:
+        node = self._and_expr()
+        while self._peek() == "OR":
+            self._take()
+            node = ("or", node, self._and_expr())
+        return node
+
+    def _and_expr(self) -> Node:
+        node = self._not_expr()
+        while True:
+            kind = self._peek()
+            if kind == "AND":
+                self._take()
+            elif kind not in ("TERM", "CAT", "NOT", "LPAREN"):
+                break
+            node = ("and", node, self._not_expr())
+        return node
+
+    def _not_expr(self) -> Node:
+        if self._peek() == "NOT":
+            self._take()
+            return ("not", self._not_expr())
+        return self._primary()
+
+    def _primary(self) -> Node:
+        kind = self._peek()
+        if kind == "TERM":
+            return ("term", self._take()[1])
+        if kind == "CAT":
+            return ("cat", self._take()[1])
+        if kind == "LPAREN":
+            self._take()
+            node = self._or_expr()
+            if self._peek() != "RPAREN":
+                raise QueryError("括弧が閉じられていません")
+            self._take()
+            return node
+        if kind is None:
+            raise QueryError("演算子の後ろに項がありません")
+        raise QueryError(f"項が必要です: {self.toks[self.pos][1]!r}")
+
+
+def _parse(q: str) -> Node:
+    return _Parser(tokenize(q)).parse()
+
+
+def _eval(node: Node, e: Expense) -> bool:
+    kind = node[0]
+    if kind == "or":
+        return _eval(node[1], e) or _eval(node[2], e)
+    if kind == "and":
+        return _eval(node[1], e) and _eval(node[2], e)
+    if kind == "not":
+        return not _eval(node[1], e)
+    if kind == "term":
+        value = node[1].casefold()
+        return value in e.memo.casefold() or value in e.category.casefold()
+    # kind == "cat"
+    return node[1].casefold() == e.category.casefold()
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _eval(_parse(q), e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    node = _parse(q)
+    return [e for e in rows if _eval(node, e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..50b2918
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,64 @@
+"""Detect recurring expenses (same category and amount, roughly monthly)."""
+
+from __future__ import annotations
+
+import calendar
+from collections import defaultdict
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day in the next month, clamped to that month's last day."""
+    year, month = (d.year + 1, 1) if d.month == 12 else (d.year, d.month + 1)
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def _runs(days: list[date], tolerance: int) -> list[list[date]]:
+    """Split sorted, unique days into maximal runs where neighbours are linked."""
+    runs: list[list[date]] = []
+    for d in days:
+        if runs and abs((d - add_month(runs[-1][-1])).days) <= tolerance:
+            runs[-1].append(d)
+        else:
+            runs.append([d])
+    return runs
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError("min_count は 2 以上である必要があります")
+    if tolerance < 0:
+        raise ValueError("tolerance は 0 以上である必要があります")
+
+    groups: dict[tuple[str, int], set[date]] = defaultdict(set)
+    for e in rows:
+        groups[(e.category, e.amount)].add(e.day)
+
+    out: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        for run in _runs(sorted(day_set), tolerance):
+            if len(run) >= min_count:
+                out.append(
+                    Recurring(
+                        category=category,
+                        amount=amount,
+                        days=tuple(run),
+                        next_expected=add_month(run[-1]),
+                    )
+                )
+    out.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return out
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..426e2b3
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,256 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+HEADER = "利用日,分類,利用金額,利用店名,備考"
+
+
+# --- parse_amount -----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("s", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("-0", 0),
+        ("¥1200", 1200),
+        ("￥1200", 1200),
+        ("1,2,3", 123),  # カンマの位置は検査しない
+        ("5,", 5),
+        ("-1,000円", -1000),
+        ("\t500\n", 500),
+    ],
+)
+def test_parse_amount_accepts(s: str, expected: int) -> None:
+    assert parse_amount(s) == expected
+
+
+@pytest.mark.parametrize(
+    "s",
+    [
+        "",
+        "   ",
+        "円",
+        "¥",
+        ",",
+        "-",
+        "12.5",
+        "1 200",
+        "--5",
+        "¥-5",
+        "￥-5",
+        "-¥-5",
+        "１２３",
+        "980 円",
+        "¥ 5",
+        "- 5",
+        "5円円",
+        "円5",
+        "5¥",
+        "abc",
+    ],
+)
+def test_parse_amount_rejects(s: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(s)
+
+
+# --- parse_date -------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("s", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        ("2026/1/05", date(2026, 1, 5)),
+        ("2026-1-5", date(2026, 1, 5)),
+        ("  2026/12/31  ", date(2026, 12, 31)),
+        ("2024/2/29", date(2024, 2, 29)),
+    ],
+)
+def test_parse_date_accepts(s: str, expected: date) -> None:
+    assert parse_date(s) == expected
+
+
+@pytest.mark.parametrize(
+    "s",
+    [
+        "",
+        "2026/1-5",
+        "2026-1/5",
+        "26/1/5",
+        "02026/1/5",
+        "2026/02/30",
+        "2023/2/29",
+        "2026/13/1",
+        "2026/0/5",
+        "2026/1/0",
+        "2026/1/",
+        "2026/1/5/",
+        "2026.1.5",
+        "２０２６/1/5",
+        "2026/1/５",
+        "2026/1/123",
+        "abc",
+    ],
+)
+def test_parse_date_rejects(s: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(s)
+
+
+# --- DEFAULT_MAPPING --------------------------------------------------------
+
+
+def test_default_mapping() -> None:
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+# --- import_rows ------------------------------------------------------------
+
+
+def test_import_rows_basic_with_default_mapping_ignores_extra_columns() -> None:
+    text = f'{HEADER}\n2026/1/5,食費,"1,200",スーパー A,x\n'
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 1200, "スーパー A")]
+
+
+def test_import_rows_quoted_comma_in_memo_and_strips() -> None:
+    text = f'{HEADER}\n2026-01-05, 食費 ,-300,"  店, 名  ",\n'
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", -300, "店, 名")]
+
+
+def test_import_rows_keeps_input_order() -> None:
+    text = f"{HEADER}\n2026/1/2,b,2,\n2026/1/1,a,1,\n"
+    rows, _ = import_rows(text)
+    assert [r.category for r in rows] == ["b", "a"]
+
+
+def test_import_rows_header_only_gives_empty() -> None:
+    assert import_rows(f"{HEADER}\n") == ([], [])
+
+
+def test_import_rows_blank_line_skipped_but_counted() -> None:
+    text = f"{HEADER}\n\n2026/1/5,食費,100,\n"
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert len(rows) == 1
+
+
+def test_import_rows_error_line_number_counts_blank_lines() -> None:
+    text = f"{HEADER}\n\n2026/1/5,食費,100,\nbad,食費,100,\n"
+    rows, errors = import_rows(text)
+    assert errors == [(4, "date")]
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+def test_import_rows_error_line_number_counts_multiline_quoted_record() -> None:
+    text = f'{HEADER}\n2026/1/5,食費,100,"a\nb"\nbad,食費,100,\n'
+    _, errors = import_rows(text)
+    assert errors == [(4, "date")]
+
+
+def test_import_rows_reports_each_bad_field_in_order_and_excludes_row() -> None:
+    text = f"{HEADER}\nbad,  ,xx,\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "date"), (2, "amount"), (2, "category")]
+
+
+def test_import_rows_single_error_per_row_kinds() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,abc,\n2026/1/6,,300,\nxx,食費,1,\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "amount"), (3, "category"), (4, "date")]
+
+
+def test_import_rows_valid_and_invalid_rows_mixed() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,100,A\n2026/1/6,食費,1.5,B\n2026/1/7,日用品,50,C\n"
+    rows, errors = import_rows(text)
+    assert errors == [(3, "amount")]
+    assert [r.memo for r in rows] == ["A", "C"]
+
+
+def test_import_rows_short_row_missing_values_are_empty() -> None:
+    text = f"{HEADER}\n2026/1/5\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "amount"), (2, "category")]
+
+
+def test_import_rows_short_row_missing_memo_gives_empty_memo() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,100\n"
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+def test_import_rows_category_map_replaces_after_strip() -> None:
+    text = f"{HEADER}\n2026/1/5, スーパー ,100,\n2026/1/6,交通,200,\n"
+    rows, errors = import_rows(text, category_map={"スーパー": "食費"})
+    assert errors == []
+    assert [r.category for r in rows] == ["食費", "交通"]
+
+
+def test_import_rows_category_map_not_applied_to_error_rows() -> None:
+    text = f"{HEADER}\n2026/1/5,スーパー,xx,\n"
+    rows, errors = import_rows(text, category_map={"スーパー": "食費"})
+    assert rows == []
+    assert errors == [(2, "amount")]
+
+
+def test_import_rows_custom_mapping() -> None:
+    text = "when,what,yen,where\n2026/1/5,食費,100,店\n"
+    mapping = {"date": "when", "category": "what", "amount": "yen", "memo": "where"}
+    rows, errors = import_rows(text, mapping)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "店")]
+
+
+def test_import_rows_mapping_without_memo_gives_empty_memo() -> None:
+    text = "d,c,a,m\n2026/1/5,食費,100,店\n"
+    mapping = {"date": "d", "category": "c", "amount": "a"}
+    rows, errors = import_rows(text, mapping)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+@pytest.mark.parametrize("missing", ["date", "category", "amount"])
+def test_import_rows_mapping_missing_required_key_raises(missing: str) -> None:
+    mapping = {k: v for k, v in DEFAULT_MAPPING.items() if k != missing}
+    with pytest.raises(ValueError):
+        import_rows(f"{HEADER}\n", mapping)
+
+
+def test_import_rows_mapping_column_not_in_header_raises() -> None:
+    text = "日付,分類,金額\n2026/1/5,食費,100\n"
+    with pytest.raises(ValueError):
+        import_rows(text)
+
+
+def test_import_rows_mapping_memo_column_not_in_header_raises() -> None:
+    text = "利用日,分類,利用金額\n2026/1/5,食費,100\n"
+    with pytest.raises(ValueError):
+        import_rows(text)
+
+
+def test_import_rows_empty_text_raises_when_columns_needed() -> None:
+    with pytest.raises(ValueError):
+        import_rows("")
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..9e532bf
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,313 @@
+from __future__ import annotations
+
+import dataclasses
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def e(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+# --- month_diff: month format ------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "bad", ["2026-1", "2026-13", "2026-00", "202601", "2026/01", "2026-01-01", ""]
+)
+def test_month_diff_rejects_bad_prev_month(bad: str) -> None:
+    with pytest.raises(ValueError):
+        month_diff([], bad, "2026-02")
+
+
+@pytest.mark.parametrize(
+    "bad", ["2026-1", "2026-13", "2026-00", "202601", "2026/01", "2026-01-01", ""]
+)
+def test_month_diff_rejects_bad_curr_month(bad: str) -> None:
+    with pytest.raises(ValueError):
+        month_diff([], "2026-01", bad)
+
+
+def test_month_diff_accepts_december() -> None:
+    rows = [e("2026-12-01", "food", 100)]
+    assert month_diff(rows, "2026-11", "2026-12") == [
+        DiffRow("food", 0, 100, 100, None, "new")
+    ]
+
+
+# --- month_diff: statuses and values ----------------------------------------
+
+
+def test_up() -> None:
+    rows = [e("2026-01-05", "food", 1000), e("2026-02-05", "food", 1300)]
+    assert month_diff(rows, "2026-01", "2026-02") == [
+        DiffRow("food", 1000, 1300, 300, 30.0, "up")
+    ]
+
+
+def test_down_pct_rounded_to_one_decimal() -> None:
+    rows = [e("2026-01-05", "food", 3000), e("2026-02-05", "food", 1000)]
+    assert month_diff(rows, "2026-01", "2026-02") == [
+        DiffRow("food", 3000, 1000, -2000, -66.7, "down")
+    ]
+
+
+def test_pct_rounding_of_repeating_decimal() -> None:
+    rows = [e("2026-01-05", "x", 3), e("2026-02-05", "x", 4)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row.pct == 33.3
+
+
+def test_gone_when_only_in_prev() -> None:
+    rows = [e("2026-01-05", "rent", 800)]
+    assert month_diff(rows, "2026-01", "2026-02") == [
+        DiffRow("rent", 800, 0, -800, -100.0, "gone")
+    ]
+
+
+def test_new_when_only_in_curr_has_no_pct() -> None:
+    rows = [e("2026-02-05", "rent", 800)]
+    assert month_diff(rows, "2026-01", "2026-02") == [
+        DiffRow("rent", 0, 800, 800, None, "new")
+    ]
+
+
+def test_same_when_equal_totals() -> None:
+    rows = [e("2026-01-05", "food", 500), e("2026-02-05", "food", 500)]
+    assert month_diff(rows, "2026-01", "2026-02") == [
+        DiffRow("food", 500, 500, 0, 0.0, "same")
+    ]
+
+
+def test_status_is_by_presence_not_total_zero_prev_with_amount() -> None:
+    # prev has a row, but its total is 0: present -> not "new"; pct None.
+    rows = [e("2026-01-05", "misc", 0), e("2026-02-05", "misc", 500)]
+    assert month_diff(rows, "2026-01", "2026-02") == [
+        DiffRow("misc", 0, 500, 500, None, "up")
+    ]
+
+
+def test_same_when_both_present_with_zero_totals() -> None:
+    rows = [e("2026-01-05", "misc", 0), e("2026-02-05", "misc", 0)]
+    assert month_diff(rows, "2026-01", "2026-02") == [
+        DiffRow("misc", 0, 0, 0, None, "same")
+    ]
+
+
+def test_zero_amount_row_only_in_prev_is_gone() -> None:
+    rows = [e("2026-01-05", "misc", 0)]
+    assert month_diff(rows, "2026-01", "2026-02") == [
+        DiffRow("misc", 0, 0, 0, None, "gone")
+    ]
+
+
+def test_totals_sum_multiple_rows_per_month() -> None:
+    rows = [
+        e("2026-01-01", "food", 100),
+        e("2026-01-31", "food", 200),
+        e("2026-02-10", "food", 50),
+    ]
+    assert month_diff(rows, "2026-01", "2026-02") == [
+        DiffRow("food", 300, 50, -250, -83.3, "down")
+    ]
+
+
+def test_other_months_are_ignored() -> None:
+    rows = [
+        e("2025-12-31", "food", 9999),
+        e("2026-01-05", "food", 100),
+        e("2026-02-05", "food", 100),
+        e("2026-03-05", "food", 9999),
+    ]
+    assert month_diff(rows, "2026-01", "2026-02") == [
+        DiffRow("food", 100, 100, 0, 0.0, "same")
+    ]
+
+
+def test_empty_rows_gives_empty_list() -> None:
+    assert month_diff([], "2026-01", "2026-02") == []
+
+
+def test_no_rows_in_either_month_gives_empty_list() -> None:
+    rows = [e("2026-05-05", "food", 100)]
+    assert month_diff(rows, "2026-01", "2026-02") == []
+
+
+def test_same_month_twice_all_same() -> None:
+    rows = [e("2026-01-05", "food", 100), e("2026-01-06", "rent", 50)]
+    result = month_diff(rows, "2026-01", "2026-01")
+    assert all(r.status == "same" and r.delta == 0 for r in result)
+    assert {r.category for r in result} == {"food", "rent"}
+
+
+def test_negative_tiny_delta_pct_is_not_negative_zero() -> None:
+    rows = [e("2026-01-05", "food", 10000), e("2026-02-05", "food", 9999)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row.pct == 0.0
+    assert str(row.pct) == "0.0"
+    assert row.status == "down"
+
+
+# --- month_diff: ordering ----------------------------------------------------
+
+
+def test_sorted_by_abs_delta_desc_then_category_asc() -> None:
+    rows = [
+        e("2026-01-05", "b", 100),
+        e("2026-02-05", "b", 200),  # +100
+        e("2026-01-05", "a", 500),
+        e("2026-02-05", "a", 400),  # -100
+        e("2026-02-05", "c", 1000),  # +1000
+        e("2026-01-05", "d", 50),
+        e("2026-02-05", "d", 50),  # 0
+    ]
+    cats = [r.category for r in month_diff(rows, "2026-01", "2026-02")]
+    assert cats == ["c", "a", "b", "d"]
+
+
+# --- top_movers ----------------------------------------------------------------
+
+
+def _row(cat: str, delta: int, status: str) -> DiffRow:
+    return DiffRow(cat, 0, delta, delta, None, status)
+
+
+def test_top_movers_excludes_same_and_keeps_order() -> None:
+    diffs = [
+        _row("a", 500, "up"),
+        _row("b", 0, "same"),
+        _row("c", -300, "down"),
+        _row("d", 100, "new"),
+    ]
+    assert top_movers(diffs) == [diffs[0], diffs[2], diffs[3]]
+
+
+def test_top_movers_default_n_is_three() -> None:
+    diffs = [_row(str(i), i + 1, "up") for i in range(5)]
+    assert top_movers(diffs) == diffs[:3]
+
+
+def test_top_movers_limits_to_n_after_excluding_same() -> None:
+    diffs = [
+        _row("a", 0, "same"),
+        _row("b", 1, "up"),
+        _row("c", 0, "same"),
+        _row("d", 2, "up"),
+    ]
+    assert top_movers(diffs, n=1) == [diffs[1]]
+
+
+def test_top_movers_n_zero_is_empty() -> None:
+    diffs = [_row("a", 1, "up")]
+    assert top_movers(diffs, n=0) == []
+
+
+def test_top_movers_n_larger_than_length() -> None:
+    diffs = [_row("a", 1, "up"), _row("b", -1, "down")]
+    assert top_movers(diffs, n=10) == diffs
+
+
+def test_top_movers_negative_n_raises() -> None:
+    with pytest.raises(ValueError):
+        top_movers([], n=-1)
+
+
+def test_top_movers_empty_input() -> None:
+    assert top_movers([]) == []
+
+
+# --- render_diff ---------------------------------------------------------------
+
+
+def test_render_header_and_rows() -> None:
+    diffs = [
+        DiffRow("food", 1000, 1300, 300, 30.0, "up"),
+        DiffRow("rent", 800, 0, -800, -100.0, "gone"),
+        DiffRow("misc", 0, 500, 500, None, "new"),
+        DiffRow("same", 5, 5, 0, 0.0, "same"),
+    ]
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "food\t1000\t1300\t+300\t+30.0%\n"
+        "rent\t800\t0\t-800\t-100.0%\n"
+        "misc\t0\t500\t+500\t-\n"
+        "same\t5\t5\t+0\t+0.0%"
+    )
+
+
+def test_render_empty_is_header_only_without_trailing_newline() -> None:
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_render_no_trailing_newline() -> None:
+    out = render_diff([DiffRow("food", 1, 2, 1, 100.0, "up")])
+    assert not out.endswith("\n")
+
+
+def test_render_negative_zero_pct_shows_plus_zero() -> None:
+    out = render_diff([DiffRow("food", 1, 1, 0, -0.0, "same")])
+    assert out.splitlines()[1].endswith("\t+0.0%")
+
+
+# --- available_months ----------------------------------------------------------
+
+
+def test_available_months_sorted_unique_across_year() -> None:
+    rows = [
+        e("2026-02-01", "a", 1),
+        e("2025-12-31", "a", 1),
+        e("2026-02-28", "b", 1),
+        e("2026-01-15", "a", 1),
+    ]
+    assert available_months(rows) == ["2025-12", "2026-01", "2026-02"]
+
+
+def test_available_months_empty() -> None:
+    assert available_months([]) == []
+
+
+# --- latest_diff ---------------------------------------------------------------
+
+
+def test_latest_diff_uses_last_two_months() -> None:
+    rows = [
+        e("2025-12-01", "food", 9999),
+        e("2026-01-01", "food", 100),
+        e("2026-02-01", "food", 400),
+    ]
+    assert latest_diff(rows) == [DiffRow("food", 100, 400, 300, 300.0, "up")]
+
+
+def test_latest_diff_with_one_month_raises() -> None:
+    with pytest.raises(ValueError):
+        latest_diff([e("2026-01-01", "food", 1), e("2026-01-02", "food", 2)])
+
+
+def test_latest_diff_with_no_rows_raises() -> None:
+    with pytest.raises(ValueError):
+        latest_diff([])
+
+
+# --- DiffRow -------------------------------------------------------------------
+
+
+def test_diffrow_field_order() -> None:
+    names = [f.name for f in dataclasses.fields(DiffRow)]
+    assert names == ["category", "prev", "curr", "delta", "pct", "status"]
+
+
+def test_diffrow_is_frozen() -> None:
+    row = DiffRow("food", 1, 2, 1, 100.0, "up")
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        row.delta = 5  # type: ignore[misc]
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..6c7dc75
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,217 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def _e(category: str, memo: str = "", amount: int = 100, day: int = 1) -> Expense:
+    return Expense(day=date(2026, 11, day), category=category, amount=amount, memo=memo)
+
+
+ROWS = [
+    _e("food", "lunch at Cafe", day=1),
+    _e("Transport", "bus pass", day=2),
+    _e("food", "dinner", day=3),
+    _e("books", "", day=4),
+]
+
+
+# --- tokenize ---------------------------------------------------------------
+
+
+def test_tokenize_whitespace_only_gives_no_tokens():
+    assert tokenize("   \t ") == []
+
+
+def test_tokenize_parens_are_their_own_tokens():
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+
+
+def test_tokenize_quoted_term_keeps_spaces_and_parens():
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+
+
+def test_tokenize_unclosed_quote_is_error():
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_is_error():
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_uppercase_operators_only():
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+    assert tokenize("and or not") == [
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_quoted_operator_is_term():
+    assert tokenize('"AND"') == [("TERM", "AND")]
+
+
+def test_tokenize_operator_prefix_is_term():
+    assert tokenize("NOTE") == [("TERM", "NOTE")]
+
+
+def test_tokenize_cat_prefix():
+    assert tokenize("cat:food") == [("CAT", "food")]
+
+
+def test_tokenize_cat_empty_value_is_error():
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_tokenize_cat_prefix_is_case_sensitive():
+    assert tokenize("CAT:food") == [("TERM", "CAT:food")]
+
+
+def test_tokenize_bare_word_stops_at_paren_and_quote():
+    assert tokenize("cat:a(b") == [("CAT", "a"), ("LPAREN", "("), ("TERM", "b")]
+
+
+# --- parsing (via tokenize + matches) --------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "a OR",
+        "OR a",
+        "AND a",
+        "a AND AND b",
+        "a AND OR b",
+        "NOT",
+        "(a",
+        "a)",
+        "(a))",
+        "a (b",
+    ],
+)
+def test_malformed_query_is_error(q):
+    with pytest.raises(QueryError):
+        matches(q, ROWS[0])
+
+
+def test_malformed_query_is_error_even_with_no_rows():
+    with pytest.raises(QueryError):
+        filter_rows("a OR", [])
+
+
+def test_valid_query_with_no_rows_is_empty():
+    assert filter_rows("food", []) == []
+
+
+# --- evaluation -------------------------------------------------------------
+
+
+def test_term_matches_memo_substring_case_insensitively():
+    assert matches("CAFE", ROWS[0])
+
+
+def test_term_matches_category_substring():
+    assert matches("ranspor", ROWS[1])
+
+
+def test_term_does_not_match_when_absent():
+    assert not matches("lunch", ROWS[1])
+
+
+def test_term_matches_when_memo_is_empty_only_via_category():
+    assert matches("book", ROWS[3])
+    assert not matches("x", ROWS[3])
+
+
+def test_cat_requires_exact_category_casefolded():
+    assert matches("cat:FOOD", ROWS[0])
+    assert not matches("cat:foo", ROWS[0])
+    assert not matches("cat:lunch", ROWS[0])
+
+
+def test_cat_does_not_match_memo():
+    assert not matches("cat:dinner", ROWS[2])
+
+
+def test_implicit_and_between_terms():
+    assert matches("food lunch", ROWS[0])
+    assert not matches("food bus", ROWS[0])
+
+
+def test_explicit_and_same_as_implicit():
+    assert matches("food AND lunch", ROWS[0])
+    assert not matches("food AND bus", ROWS[0])
+
+
+def test_or():
+    assert matches("bus OR lunch", ROWS[0])
+    assert not matches("bus OR dinner", ROWS[0])
+
+
+def test_not():
+    assert matches("NOT bus", ROWS[0])
+    assert not matches("NOT lunch", ROWS[0])
+
+
+def test_not_binds_tighter_than_and():
+    # (NOT bus) AND food
+    assert matches("NOT bus food", ROWS[0])
+    assert not matches("NOT food bus", ROWS[0])
+
+
+def test_and_binds_tighter_than_or():
+    # bus OR (lunch AND food) ; row 0 has lunch and food
+    assert matches("bus OR lunch food", ROWS[0])
+    # (food AND bus) OR books ; row 0 has neither
+    assert not matches("food bus OR books", ROWS[0])
+    assert matches("food bus OR books", ROWS[3])
+
+
+def test_parentheses_override_precedence():
+    assert not matches("(bus OR lunch) food", ROWS[1])
+    assert matches("(bus OR lunch) food", ROWS[0])
+
+
+def test_double_not():
+    assert matches("NOT NOT lunch", ROWS[0])
+
+
+def test_quoted_term_with_space():
+    assert matches('"lunch at"', ROWS[0])
+    assert not matches('"lunch at"', ROWS[2])
+
+
+def test_quoted_term_with_paren_is_literal():
+    assert not matches('"(a)"', ROWS[0])
+
+
+def test_lowercase_and_is_a_term_not_operator():
+    # "and" is a plain TERM: needs to be a substring of memo/category
+    assert not matches("food and lunch", ROWS[0])
+
+
+# --- filter_rows -------------------------------------------------------------
+
+
+def test_filter_rows_keeps_input_order():
+    out = filter_rows("food", ROWS)
+    assert [e.day for e in out] == [date(2026, 11, 1), date(2026, 11, 3)]
+
+
+def test_filter_rows_no_match_is_empty_list():
+    assert filter_rows("nothing-here", ROWS) == []
+
+
+def test_filter_rows_does_not_mutate_input():
+    rows = list(ROWS)
+    filter_rows("food", rows)
+    assert rows == ROWS
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..e601258
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,174 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def _e(
+    day: date, category: str = "rent", amount: int = 80000, memo: str = ""
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- add_month ---
+
+
+@pytest.mark.parametrize(
+    "src, expected",
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2024, 1, 31), date(2024, 2, 29)),
+        (date(2026, 12, 15), date(2027, 1, 15)),
+        (date(2026, 3, 31), date(2026, 4, 30)),
+        (date(2026, 11, 30), date(2026, 12, 30)),
+    ],
+)
+def test_add_month_clamps_and_wraps_year(src, expected):
+    assert add_month(src) == expected
+
+
+# --- find_recurring: validation ---
+
+
+def test_min_count_below_two_raises():
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+
+
+def test_negative_tolerance_raises():
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_empty_input_returns_empty():
+    assert find_recurring([]) == []
+
+
+# --- find_recurring: detection ---
+
+
