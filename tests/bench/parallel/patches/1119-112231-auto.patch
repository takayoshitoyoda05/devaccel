@@ -0,0 +1,65 @@
+"""Condition-based search over Expense records (pure functions)."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from datetime import date
+
+from kakeibo.core import Expense
+
+Predicate = Callable[[Expense], bool]
+
+
+def category_is(*names: str) -> Predicate:
+    """Exact match against any of the given category names. No names matches nothing."""
+    allowed = frozenset(names)
+    return lambda e: e.category in allowed
+
+
+def amount_between(lo: int | None = None, hi: int | None = None) -> Predicate:
+    """Inclusive amount range; None means unbounded."""
+    if lo is not None and hi is not None and lo > hi:
+        raise ValueError(f"lo > hi: {lo} > {hi}")
+
+    def pred(e: Expense) -> bool:
+        return (lo is None or e.amount >= lo) and (hi is None or e.amount <= hi)
+
+    return pred
+
+
+def memo_contains(text: str, ignore_case: bool = True) -> Predicate:
+    """Substring match on memo. Empty text matches everything."""
+    if ignore_case:
+        needle = text.casefold()
+        return lambda e: needle in e.memo.casefold()
+    return lambda e: text in e.memo
+
+
+def between_dates(start: date | None = None, end: date | None = None) -> Predicate:
+    """Inclusive date range; None means unbounded."""
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"start > end: {start} > {end}")
+
+    def pred(e: Expense) -> bool:
+        return (start is None or e.day >= start) and (end is None or e.day <= end)
+
+    return pred
+
+
+def all_of(*preds: Predicate) -> Predicate:
+    """True when every predicate matches. No predicates -> always True."""
+    return lambda e: all(p(e) for p in preds)
+
+
+def any_of(*preds: Predicate) -> Predicate:
+    """True when any predicate matches. No predicates -> always False."""
+    return lambda e: any(p(e) for p in preds)
+
+
+def not_(pred: Predicate) -> Predicate:
+    return lambda e: not pred(e)
+
+
+def search(rows: list[Expense], pred: Predicate) -> list[Expense]:
+    """Rows matching pred, in input order. Does not modify rows."""
+    return [e for e in rows if pred(e)]
