@@ -0,0 +1,170 @@
+"""Import bank / card CSV exports into Expense records (pure functions)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from collections.abc import Iterator
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[tuple[int, str]]  # (line_number, reason), 1-based, ascending
+    skipped: int  # deposit-only rows
+
+
+class ImportHeaderError(ValueError):
+    """Raised when required columns are missing from the header."""
+
+
+# Header aliases (already NFKC + lower-cased for comparison).
+_DATE_COLS = {"date", "日付", "取引日", "利用日", "ご利用日"}
+_AMOUNT_COLS = {"amount", "金額", "利用金額", "ご利用金額", "支払金額"}
+_MEMO_COLS = {"memo", "摘要", "内容", "利用店名", "ご利用店名", "備考"}
+_CATEGORY_COLS = {"category", "カテゴリ"}
+_WITHDRAW_COLS = {"出金", "出金額", "お支払金額"}
+_DEPOSIT_COLS = {"入金", "入金額", "お預入金額"}
+
+_DATE_PATTERNS = (
+    re.compile(r"([0-9]{4})-([0-9]{2})-([0-9]{2})"),
+    re.compile(r"([0-9]{4})/([0-9]{1,2})/([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日"),
+    re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})"),
+)
+
+_NEGATIVE_SIGNS = "-−▲△"
+
+
+def _norm_header(text: str) -> str:
+    return unicodedata.normalize("NFKC", text.strip()).strip().lower()
+
+
+def _delimiter(text: str) -> str:
+    first_line = text.split("\n", 1)[0]
+    return "\t" if "\t" in first_line and "," not in first_line else ","
+
+
+def _records(text: str, delimiter: str) -> Iterator[tuple[int, list[str]]]:
+    """Yield (start_line, row) for each non-blank CSV record."""
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delimiter)
+    while True:
+        start = reader.line_num + 1
+        try:
+            row = next(reader)
+        except StopIteration:
+            return
+        if row == [] or (len(row) == 1 and not row[0].strip()):
+            continue
+        yield start, row
+
+
+def _parse_date(raw: str) -> date | None:
+    s = raw.strip()
+    for pattern in _DATE_PATTERNS:
+        m = pattern.fullmatch(s)
+        if m:
+            try:
+                return date(*(int(g) for g in m.groups()))
+            except ValueError:
+                return None
+    return None
+
+
+def _parse_amount(raw: str) -> int | None:
+    s = re.sub(r"[\s¥円,]", "", unicodedata.normalize("NFKC", raw))
+    negative = bool(s) and s[0] in _NEGATIVE_SIGNS
+    if negative:
+        s = s[1:]
+    if not re.fullmatch(r"[0-9]+", s):
+        return None
+    value = int(s)
+    return -value if negative else value
+
+
+def import_bank_csv(
+    text: str, category: str = "未分類", withdrawals_negative: bool = False
+) -> ImportResult:
+    text = text.removeprefix("﻿")
+    records = _records(text, _delimiter(text))
+    try:
+        _, header = next(records)
+    except StopIteration:
+        raise ImportHeaderError("ヘッダがありません") from None
+
+    names = [_norm_header(c) for c in header]
+
+    def find(aliases: set[str]) -> int | None:
+        return next((i for i, n in enumerate(names) if n in aliases), None)
+
+    date_i = find(_DATE_COLS)
+    amount_i = find(_AMOUNT_COLS)
+    memo_i = find(_MEMO_COLS)
+    category_i = find(_CATEGORY_COLS)
+    withdraw_i = find(_WITHDRAW_COLS)
+    deposit_i = find(_DEPOSIT_COLS)
+
+    if date_i is None or (
+        amount_i is None and withdraw_i is None and deposit_i is None
+    ):
+        missing = []
+        if date_i is None:
+            missing.append("日付")
+        if amount_i is None and withdraw_i is None and deposit_i is None:
+            missing.append("金額(金額列、または出金/入金列)")
+        raise ImportHeaderError("必要な列がありません: " + ", ".join(missing))
+
+    width = len(header)
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    skipped = 0
+
+    for line, row in records:
+        if len(row) != width:
+            errors.append((line, f"列の数が合いません(期待 {width}, 実際 {len(row)})"))
+            continue
+
+        raw_date = row[date_i]
+        day = _parse_date(raw_date)
+        if day is None:
+            errors.append((line, f"日付が不正です: {raw_date!r}"))
+            continue
+
+        memo = row[memo_i].strip() if memo_i is not None else ""
+        cat = (row[category_i].strip() if category_i is not None else "") or category
+
+        if amount_i is not None:
+            raw_amount = row[amount_i]
+            value = _parse_amount(raw_amount)
+            if value is None:
+                errors.append((line, f"金額が不正です: {raw_amount!r}"))
+                continue
+            if withdrawals_negative:
+                value = -value
+            expenses.append(Expense(day, cat, value, memo))
+            continue
+
+        out_raw = row[withdraw_i].strip() if withdraw_i is not None else ""
+        in_raw = row[deposit_i].strip() if deposit_i is not None else ""
+        if out_raw:
+            value = _parse_amount(out_raw)
+            if value is None:
+                errors.append((line, f"金額が不正です: {out_raw!r}"))
+            else:
+                expenses.append(Expense(day, cat, value, memo))
+            continue
+        if in_raw:
+            if _parse_amount(in_raw) is None:
+                errors.append((line, f"金額が不正です: {in_raw!r}"))
+            else:
+                skipped += 1
+            continue
+        errors.append((line, "金額がありません"))
+
+    return ImportResult(expenses=expenses, errors=errors, skipped=skipped)
