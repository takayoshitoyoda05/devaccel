+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import ImportHeaderError, import_bank_csv
+from kakeibo.core import Expense
+
+CARD_HEADER = "日付,摘要,出金額,入金額\n"
+
+
+def test_E2_1_withdrawal_row_becomes_expense() -> None:
+    """E2-1: 出金額の "1,200" は 1200 円の支出になる(R2,R3,R4,R5)。"""
+    text = CARD_HEADER + '2026/11/03,コンビニ,"1,200",\n'
+    result = import_bank_csv(text)
+    assert result.expenses == [Expense(date(2026, 11, 3), "未分類", 1200, "コンビニ")]
+    assert result.errors == []
+    assert result.skipped == 0
+
+
+def test_E2_2_bom_and_fullwidth_amount_are_read() -> None:
+    """E2-2: BOM 付き・全角数字・円/カンマ入りの金額を読める(R1,R2,R4)。"""
+    text = "﻿ご利用日,ご利用店名,ご利用金額\n2026年11月3日,A店,¥１，２００円"
+    result = import_bank_csv(text)
+    assert len(result.expenses) == 1
+    assert result.expenses[0].amount == 1200
+    assert result.expenses[0].day == date(2026, 11, 3)
+    assert result.expenses[0].memo == "A店"
+    assert result.errors == []
+
+
+def test_E2_3_deposit_only_row_is_skipped() -> None:
+    """E2-3: 入金だけの行は skipped に数え、errors には入れない(R5)。"""
+    text = CARD_HEADER + "2026/11/04,給与,,300000"
+    result = import_bank_csv(text)
+    assert result.expenses == []
+    assert result.skipped == 1
+    assert result.errors == []
+
+
+def test_E2_4_bad_date_and_bad_amount_go_to_errors() -> None:
+    """E2-4: 不正な日付・金額は errors に行番号付きで集め、良い行は返す(R3,R4,R6)。"""
+    text = "date,amount\n2026-02-30,100\n2026-11-01,100.5\n2026-11-02,100"
+    result = import_bank_csv(text)
+    assert result.expenses == [Expense(date(2026, 11, 2), "未分類", 100, "")]
+    assert result.errors == [
+        (2, "日付が不正です: '2026-02-30'"),
+        (3, "金額が不正です: '100.5'"),
+    ]
+    assert result.skipped == 0
+    # P1: 良い行 + エラー行 + skipped = データ行数 3
+    assert len(result.expenses) + len(result.errors) + result.skipped == 3
+
+
+def test_E2_5_quoted_newline_is_one_value_and_line_numbers_follow() -> None:
+    """E2-5: 引用符内の改行は 1 つの値。次の行の行番号は 4 になる(R1,R6)。"""
+    text = 'date,amount,memo\n2026-11-01,100,"a,b\nc"\n2026-11-02,200,x'
+    result = import_bank_csv(text)
+    assert [e.memo for e in result.expenses] == ["a,b\nc", "x"]
+    assert result.errors == []
+
+    bad = 'date,amount,memo\n2026-11-01,100,"a,b\nc"\n2026-13-01,200,x'
+    bad_result = import_bank_csv(bad)
+    assert bad_result.errors == [(4, "日付が不正です: '2026-13-01'")]
+
+
+@pytest.mark.parametrize(
+    ("withdrawals_negative", "expected"),
+    [(True, 500), (False, -500)],
+    ids=["E2-6-withdrawals_negative=True", "E2-6-withdrawals_negative=False"],
+)
+def test_E2_6_sign_of_single_amount_column(
+    withdrawals_negative: bool, expected: int
+) -> None:
+    """E2-6: 単一の金額列の符号は withdrawals_negative で反転する(R4,R6)。"""
+    text = "date,amount\n2026-11-01,-500"
+    result = import_bank_csv(text, withdrawals_negative=withdrawals_negative)
+    assert result.expenses == [Expense(date(2026, 11, 1), "未分類", expected, "")]
+    assert result.errors == []
+
+
+@pytest.mark.parametrize(
+    "text",
+    ["date,memo\n2026-11-01,x", ""],
+    ids=["E2-7-no-amount-column", "E2-7-empty-string"],
+)
+def test_E2_7_missing_required_columns_raise_header_error(text: str) -> None:
+    """E2-7: 金額列が無い・空文字列はヘッダエラー(R5)。"""
+    with pytest.raises(ImportHeaderError):
+        import_bank_csv(text)
+
+
+def test_E2_8_wrong_column_count_goes_to_errors() -> None:
+    """E2-8: 列数がヘッダと違う行は errors に入る(R6)。"""
+    text = "date,amount\n2026-11-01\n2026-11-02,1,2"
+    result = import_bank_csv(text)
+    assert result.expenses == []
+    assert result.errors == [
+        (2, "列の数が合いません(期待 2, 実際 1)"),
+        (3, "列の数が合いません(期待 2, 実際 3)"),
+    ]
+    assert result.skipped == 0
+    # P1: エラー 2 行 = データ行数 2
+    assert len(result.expenses) + len(result.errors) + result.skipped == 2
