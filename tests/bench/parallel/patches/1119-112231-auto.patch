@@ -0,0 +1,115 @@
+"""Month-over-month comparison of category totals (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from typing import Literal
+
+from kakeibo.core import Expense, total_by_category
+
+Status = Literal["up", "down", "same", "new", "gone"]
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+_LABELS: dict[str, str] = {
+    "up": "増",
+    "down": "減",
+    "same": "変化なし",
+    "new": "新規",
+    "gone": "消滅",
+}
+
+
+@dataclass(frozen=True)
+class Change:
+    category: str
+    previous: int
+    current: int
+    diff: int
+    pct: float | None
+    status: Status
+
+
+def _check_month(value: str) -> None:
+    if not _MONTH_RE.fullmatch(value):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {value!r}")
+
+
+def _previous_month(month: str) -> str:
+    year, mon = int(month[:4]), int(month[5:])
+    if mon == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mon - 1:02d}"
+
+
+def _month_totals(rows: list[Expense], month: str) -> dict[str, int]:
+    return total_by_category(
+        [e for e in rows if f"{e.day.year:04d}-{e.day.month:02d}" == month]
+    )
+
+
+def _status(previous: int, current: int, diff: int) -> Status:
+    if previous == 0 and current != 0:
+        return "new"
+    if current == 0 and previous != 0:
+        return "gone"
+    if diff > 0:
+        return "up"
+    if diff < 0:
+        return "down"
+    return "same"
+
+
+def compare_months(
+    rows: list[Expense], month: str, previous: str | None = None
+) -> list[Change]:
+    """Compare category totals of `month` against `previous` (default: the month before)."""
+    _check_month(month)
+    if previous is None:
+        previous = _previous_month(month)
+    else:
+        _check_month(previous)
+
+    current_totals = _month_totals(rows, month)
+    if not current_totals:
+        return []
+    previous_totals = _month_totals(rows, previous)
+
+    changes: list[Change] = []
+    for category in set(current_totals) | set(previous_totals):
+        prev_amount = previous_totals.get(category, 0)
+        cur_amount = current_totals.get(category, 0)
+        diff = cur_amount - prev_amount
+        pct = round(diff / prev_amount * 100, 1) if prev_amount > 0 else None
+        changes.append(
+            Change(
+                category=category,
+                previous=prev_amount,
+                current=cur_amount,
+                diff=diff,
+                pct=pct,
+                status=_status(prev_amount, cur_amount, diff),
+            )
+        )
+    changes.sort(key=lambda c: (-abs(c.diff), c.category))
+    return changes
+
+
+def format_changes(changes: list[Change]) -> str:
+    lines: list[str] = []
+    for c in changes:
+        pct = "-" if c.pct is None else f"{c.pct:+.1f}%"
+        lines.append(
+            "\t".join(
+                [
+                    c.category,
+                    str(c.previous),
+                    str(c.current),
+                    f"{c.diff:+d}",
+                    pct,
+                    _LABELS[c.status],
+                ]
+            )
+        )
+    return "\n".join(lines)
