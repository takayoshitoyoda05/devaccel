@@ -0,0 +1,81 @@
+"""Detect recurring expenses and predict their next due date (pure functions)."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int  # yen
+    count: int  # size of the trailing run of consecutive months
+    last: date  # latest occurrence
+    next_due: date  # predicted next occurrence
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month
+
+
+def _next_due(last: date, day: int) -> date:
+    """Same day-of-month as ``day`` in the month after ``last``, clipped to month end."""
+    if last.month == 12:
+        year, month = last.year + 1, 1
+    else:
+        year, month = last.year, last.month + 1
+    last_day = calendar.monthrange(year, month)[1]
+    return date(year, month, min(day, last_day))
+
+
+def find_recurring(rows: list[Expense], min_count: int = 3) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError("min_count は 2 以上である必要があります")
+
+    # R1: group by (category, stripped memo, amount); refunds (amount <= 0) are dropped first.
+    groups: dict[tuple[str, str, int], list[Expense]] = {}
+    for e in rows:
+        if e.amount <= 0:
+            continue
+        groups.setdefault((e.category, e.memo.strip(), e.amount), []).append(e)
+
+    out: list[Recurring] = []
+    for (category, memo, amount), items in groups.items():
+        items.sort(key=lambda e: e.day)
+
+        # R2: two or more entries in the same calendar month disqualify the group.
+        months = [_month_index(e.day) for e in items]
+        if len(set(months)) != len(months):
+            continue
+
+        # R3: trailing run of consecutive calendar months, counted back from the latest.
+        run = [items[-1]]
+        for prev in reversed(items[:-1]):
+            if _month_index(run[-1].day) - _month_index(prev.day) != 1:
+                break
+            run.append(prev)
+        if len(run) < min_count:
+            continue
+
+        last = run[0].day
+        # R4: next month, day = max day in the run clipped to that month's end.
+        next_due = _next_due(last, max(e.day.day for e in run))
+        out.append(
+            Recurring(
+                category=category,
+                memo=memo,
+                amount=amount,
+                count=len(run),
+                last=last,
+                next_due=next_due,
+            )
+        )
+
+    # R5: next_due asc, then category, then memo.
+    out.sort(key=lambda r: (r.next_due, r.category, r.memo))
+    return out
