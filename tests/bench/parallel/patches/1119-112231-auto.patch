+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring
+
+
+def _e(
+    day: date, category: str = "housing", amount: int = 80000, memo: str = "家賃"
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+@pytest.mark.parametrize(
+    ("case_id", "rows", "expected"),
+    [
+        pytest.param(
+            "E1-1",
+            [
+                _e(date(2026, 8, 27)),
+                _e(date(2026, 9, 27)),
+                _e(date(2026, 10, 27)),
+            ],
+            [
+                Recurring(
+                    category="housing",
+                    memo="家賃",
+                    amount=80000,
+                    count=3,
+                    last=date(2026, 10, 27),
+                    next_due=date(2026, 11, 27),
+                )
+            ],
+            id="E1-1",
+        ),
+        pytest.param(
+            "E1-2",
+            [
+                _e(date(2025, 11, 15)),
+                _e(date(2025, 12, 15)),
+                _e(date(2026, 1, 15)),
+            ],
+            [
+                Recurring(
+                    category="housing",
+                    memo="家賃",
+                    amount=80000,
+                    count=3,
+                    last=date(2026, 1, 15),
+                    next_due=date(2026, 2, 15),
+                )
+            ],
+            id="E1-2",
+        ),
+        pytest.param(
+            "E1-3",
+            [
+                _e(date(2025, 11, 30)),
+                _e(date(2025, 12, 31)),
+                _e(date(2026, 1, 31)),
+            ],
+            [
+                Recurring(
+                    category="housing",
+                    memo="家賃",
+                    amount=80000,
+                    count=3,
+                    last=date(2026, 1, 31),
+                    next_due=date(2026, 2, 28),
+                )
+            ],
+            id="E1-3",
+        ),
+        pytest.param(
+            "E1-4",
+            [
+                _e(date(2023, 11, 30)),
+                _e(date(2023, 12, 31)),
+                _e(date(2024, 1, 31)),
+            ],
+            [
+                Recurring(
+                    category="housing",
+                    memo="家賃",
+                    amount=80000,
+                    count=3,
+                    last=date(2024, 1, 31),
+                    next_due=date(2024, 2, 29),
+                )
+            ],
+            id="E1-4",
+        ),
+        pytest.param(
+            "E1-5",
+            [
+                _e(date(2026, 8, 1)),
+                _e(date(2026, 10, 1)),
+                _e(date(2026, 11, 1)),
+            ],
+            [],
+            id="E1-5",
+        ),
+        pytest.param(
+            "E1-6",
+            [
+                _e(date(2026, 8, 1)),
+                _e(date(2026, 8, 20)),
+                _e(date(2026, 9, 1)),
+                _e(date(2026, 10, 1)),
+            ],
+            [],
+            id="E1-6",
+        ),
+        pytest.param(
+            "E1-7 金額が毎月違う",
+            [
+                _e(date(2026, 8, 1), amount=80000),
+                _e(date(2026, 9, 1), amount=81000),
+                _e(date(2026, 10, 1), amount=82000),
+            ],
+            [],
+            id="E1-7 金額が毎月違う",
+        ),
+        pytest.param("E1-7 空リスト", [], [], id="E1-7 空リスト"),
+        pytest.param(
+            "E1-7 返金(負)だけ",
+            [
+                _e(date(2026, 8, 1), amount=-80000),
+                _e(date(2026, 9, 1), amount=-80000),
+                _e(date(2026, 10, 1), amount=-80000),
+            ],
+            [],
+            id="E1-7 返金(負)だけ",
+        ),
+    ],
+)
+def test_recurring_examples(
+    case_id: str, rows: list[Expense], expected: list[Recurring]
+) -> None:
+    assert find_recurring(rows) == expected
+
+
+@pytest.mark.parametrize(
+    "min_count",
+    [pytest.param(1, id="E1-8 min_count=1")],
+)
+def test_min_count_below_two_raises(min_count: int) -> None:
+    with pytest.raises(ValueError):
+        find_recurring([_e(date(2026, 8, 1))], min_count=min_count)
+
+
+def test_P1_invariants_hold_for_all_results() -> None:
+    rows = [
+        _e(date(2026, 8, 27)),
+        _e(date(2026, 9, 27)),
+        _e(date(2026, 10, 27)),
+        _e(date(2026, 8, 1), category="food", amount=500, memo="パン"),
+        _e(date(2026, 9, 3), category="food", amount=500, memo="パン"),
+        _e(date(2026, 10, 2), category="food", amount=500, memo="パン"),
+        _e(date(2026, 10, 9), category="food", amount=500, memo="パン"),
+    ]
+    result = find_recurring(rows, min_count=2)
+    assert result
+    for r in result:
+        assert r.count >= 2
+        assert r.next_due > r.last
+
+
+def test_R5_ordering_by_next_due_then_category_then_memo() -> None:
+    rows = [
+        _e(date(2026, 8, 10), category="b", amount=100, memo="x"),
+        _e(date(2026, 9, 10), category="b", amount=100, memo="x"),
+        _e(date(2026, 10, 10), category="b", amount=100, memo="x"),
+        _e(date(2026, 8, 10), category="a", amount=100, memo="y"),
+        _e(date(2026, 9, 10), category="a", amount=100, memo="y"),
+        _e(date(2026, 10, 10), category="a", amount=100, memo="y"),
+        _e(date(2026, 8, 10), category="a", amount=200, memo="x"),
+        _e(date(2026, 9, 10), category="a", amount=200, memo="x"),
+        _e(date(2026, 10, 10), category="a", amount=200, memo="x"),
+    ]
+    result = find_recurring(rows)
+    assert [(r.category, r.memo) for r in result] == [
+        ("a", "x"),
+        ("a", "y"),
+        ("b", "x"),
+    ]
+
+
+def test_R1_memo_is_stripped_when_grouping() -> None:
+    rows = [
+        _e(date(2026, 8, 1), memo=" 家賃 "),
+        _e(date(2026, 9, 1), memo="家賃"),
