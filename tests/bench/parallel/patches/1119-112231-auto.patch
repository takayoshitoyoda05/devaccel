+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import (
+    all_of,
+    amount_between,
+    any_of,
+    between_dates,
+    category_is,
+    memo_contains,
+    not_,
+    search,
+)
+
+
+def _e(
+    day: date = date(2026, 11, 15),
+    category: str = "food",
+    amount: int = 500,
+    memo: str = "",
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# E3-1 (R1): amount_between(1000, 2000) は両端を含む
+@pytest.mark.parametrize(
+    ("amount", "expected"),
+    [(999, False), (1000, True), (2000, True), (2001, False)],
+    ids=["E3-1-a", "E3-1-b", "E3-1-c", "E3-1-d"],
+)
+def test_e3_1_amount_between_inclusive(amount: int, expected: bool) -> None:
+    assert amount_between(1000, 2000)(_e(amount=amount)) is expected
+
+
+# E3-2 (R1): amount_between(hi=0) は返金(負)と 0 に一致し、1 は一致しない
+@pytest.mark.parametrize(
+    ("amount", "expected"),
+    [(-300, True), (0, True), (1, False)],
+    ids=["E3-2-a", "E3-2-b", "E3-2-c"],
+)
+def test_e3_2_amount_between_open_lower(amount: int, expected: bool) -> None:
+    assert amount_between(hi=0)(_e(amount=amount)) is expected
+
+
+# E3-3 (R1): between_dates は両端を含む
+@pytest.mark.parametrize(
+    ("day", "expected"),
+    [
+        (date(2026, 10, 31), False),
+        (date(2026, 11, 1), True),
+        (date(2026, 11, 30), True),
+        (date(2026, 12, 1), False),
+    ],
+    ids=["E3-3-a", "E3-3-b", "E3-3-c", "E3-3-d"],
+)
+def test_e3_3_between_dates_inclusive(day: date, expected: bool) -> None:
+    pred = between_dates(date(2026, 11, 1), date(2026, 11, 30))
+    assert pred(_e(day=day)) is expected
+
+
+# E3-4 (R2): memo_contains は部分一致、ignore_case=False では大文字小文字を区別
+@pytest.mark.parametrize(
+    ("kwargs", "expected"),
+    [({}, True), ({"ignore_case": False}, False)],
+    ids=["E3-4-a", "E3-4-b"],
+)
+def test_e3_4_memo_contains_case(kwargs: dict[str, bool], expected: bool) -> None:
+    assert memo_contains("netflix", **kwargs)(_e(memo="NETFLIX 11月")) is expected
+
+
+# E3-5 (R3): category_is は完全一致(いずれか)、名前 0 個なら何にも一致しない
+@pytest.mark.parametrize(
+    ("category", "expected"),
+    [("food", True), ("rent", True), ("foo", False), ("transport", False)],
+    ids=["E3-5-a", "E3-5-b", "E3-5-c", "E3-5-d"],
+)
+def test_e3_5_category_is_any_exact(category: str, expected: bool) -> None:
+    assert category_is("food", "rent")(_e(category=category)) is expected
+
+
+@pytest.mark.parametrize(
+    "category", ["food", "rent", ""], ids=["E3-5-e", "E3-5-f", "E3-5-g"]
+)
+def test_e3_5_category_is_no_names_matches_nothing(category: str) -> None:
+    assert category_is()(_e(category=category)) is False
+
+
+# E3-6 (R4): all_of() は常に True、any_of() は常に False
+@pytest.mark.parametrize(
+    ("pred", "expected"),
+    [(all_of(), True), (any_of(), False)],
+    ids=["E3-6-a", "E3-6-b"],
+)
+def test_e3_6_empty_combinators(pred: object, expected: bool) -> None:
+    assert pred(_e()) is expected  # type: ignore[operator]
+
+
+# E3-7 (R4): food かつ(メモに「昼」 または 300 円以下)
+@pytest.mark.parametrize(
+    ("category", "amount", "memo", "expected"),
+    [
+        ("food", 500, "昼ごはん", True),
+        ("food", 200, "", True),
+        ("food", 500, "", False),
+        ("rent", 200, "昼", False),
+    ],
+    ids=["E3-7-a", "E3-7-b", "E3-7-c", "E3-7-d"],
+)
+def test_e3_7_nested_combinators(
+    category: str, amount: int, memo: str, expected: bool
+) -> None:
+    pred = all_of(
+        category_is("food"),
+        any_of(memo_contains("昼"), amount_between(hi=300)),
+    )
+    assert pred(_e(category=category, amount=amount, memo=memo)) is expected
+
+
+# E3-8 (R1): lo > hi・start > end は ValueError
+def test_e3_8_amount_between_reversed_raises() -> None:
+    with pytest.raises(ValueError):
+        amount_between(5, 1)
+
+
+def test_e3_8_between_dates_reversed_raises() -> None:
+    with pytest.raises(ValueError):
+        between_dates(date(2026, 12, 1), date(2026, 11, 1))
+
+
+# R1: None は無制限
+def test_r1_none_bounds_are_unbounded() -> None:
+    assert amount_between()(_e(amount=-(10**9))) is True
+    assert amount_between()(_e(amount=10**9)) is True
+    assert between_dates()(_e(day=date(1900, 1, 1))) is True
+
+
+# R2: 空文字列は全件に一致
+def test_r2_empty_memo_text_matches_all() -> None:
+    assert memo_contains("")(_e(memo="")) is True
+    assert memo_contains("")(_e(memo="なにか")) is True
+
+
+# R2: ignore_case=True は casefold で比べる
+def test_r2_casefold_comparison() -> None:
+    assert memo_contains("STRASSE")(_e(memo="straße")) is True
+
+
+# R4: not_ は否定
+def test_r4_not_negates() -> None:
+    assert not_(category_is("food"))(_e(category="food")) is False
+    assert not_(category_is("food"))(_e(category="rent")) is True
+
+
+# R5 / P1: search は入力の順序を保ち、入力を変更せず、結果は pred を満たす部分列
+def test_r5_search_preserves_order_and_input() -> None:
+    rows = [
+        _e(amount=100, memo="a"),
+        _e(amount=5000, memo="b"),
+        _e(amount=200, memo="c"),
+        _e(amount=300, memo="d"),
+    ]
+    snapshot = list(rows)
+    pred = amount_between(hi=300)
+    result = search(rows, pred)
+    assert result == [rows[0], rows[2], rows[3]]
+    assert rows == snapshot
+    assert all(pred(e) for e in result)
+    # 部分列であること
+    it = iter(rows)
+    assert all(any(x is e for x in it) for e in result)
+
+
+def test_r5_search_empty_input() -> None:
+    assert search([], all_of()) == []
