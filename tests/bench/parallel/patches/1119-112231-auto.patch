+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.compare import Change, compare_months, format_changes
+from kakeibo.core import Expense
+
+
+def _e(y: int, m: int, category: str, amount: int) -> Expense:
+    return Expense(day=date(y, m, 1), category=category, amount=amount, memo="")
+
+
+@pytest.mark.parametrize(
+    ("rows", "month", "previous", "expected"),
+    [
+        pytest.param(
+            [_e(2026, 10, "food", 1000), _e(2026, 11, "food", 1500)],
+            "2026-11",
+            "2026-10",
+            [Change("food", 1000, 1500, 500, 50.0, "up")],
+            id="E4-1",
+        ),
+        pytest.param(
+            [_e(2026, 10, "food", 1500), _e(2026, 11, "food", 1000)],
+            "2026-11",
+            "2026-10",
+            [Change("food", 1500, 1000, -500, -33.3, "down")],
+            id="E4-2",
+        ),
+        pytest.param(
+            [_e(2026, 11, "game", 800), _e(2026, 10, "gym", 2000)],
+            "2026-11",
+            "2026-10",
+            [
+                Change("gym", 2000, 0, -2000, -100.0, "gone"),
+                Change("game", 0, 800, 800, None, "new"),
+            ],
+            id="E4-3",
+        ),
+        pytest.param(
+            [_e(2025, 12, "food", 700), _e(2026, 1, "food", 900)],
+            "2026-01",
+            None,
+            [Change("food", 700, 900, 200, 28.6, "up")],
+            id="E4-4",
+        ),
+        pytest.param(
+            [_e(2026, 10, "food", 1000), _e(2026, 11, "food", 1000)],
+            "2026-11",
+            "2026-10",
+            [Change("food", 1000, 1000, 0, 0.0, "same")],
+            id="E4-5",
+        ),
+        pytest.param(
+            [_e(2026, 10, "refund", -500), _e(2026, 11, "refund", -800)],
+            "2026-11",
+            "2026-10",
+            [Change("refund", -500, -800, -300, None, "down")],
+            id="E4-6",
+        ),
+    ],
+)
+def test_compare_months_examples(
+    rows: list[Expense],
+    month: str,
+    previous: str | None,
+    expected: list[Change],
+) -> None:
+    assert compare_months(rows, month, previous) == expected
+
+
+@pytest.mark.parametrize(
+    ("month", "previous"),
+    [
+        pytest.param("2026-13", None, id="E4-7(month=2026-13)"),
+        pytest.param("2026-1", None, id="E4-7(month=2026-1)"),
+        pytest.param("2026-11", "2026-13", id="E4-7(previous=2026-13)"),
+        pytest.param("2026-11", "2026-1", id="E4-7(previous=2026-1)"),
+    ],
+)
+def test_invalid_month_raises_value_error(month: str, previous: str | None) -> None:
+    rows = [_e(2026, 11, "food", 100)]
+    with pytest.raises(ValueError):
+        compare_months(rows, month, previous)
+
+
+def test_E4_4_year_boundary_compares_with_previous_december() -> None:
+    rows = [
+        _e(2025, 11, "food", 5000),
+        _e(2025, 12, "food", 700),
+        _e(2026, 1, "food", 900),
+    ]
+    assert compare_months(rows, "2026-01") == [
+        Change("food", 700, 900, 200, 28.6, "up")
+    ]
+
+
+@pytest.mark.parametrize(
+    ("rows", "month", "previous", "expected"),
+    [
+        pytest.param(
+            [_e(2026, 10, "b", 100), _e(2026, 11, "a", 100)],
+            "2026-11",
+            "2026-10",
+            [
+                Change("a", 0, 100, 100, None, "new"),
+                Change("b", 100, 0, -100, -100.0, "gone"),
+            ],
+            id="R5-tie-abs-diff-category-asc",
+        ),
+        pytest.param(
+            [_e(2026, 10, "a", 100), _e(2026, 11, "a", 100), _e(2026, 11, "b", 100)],
+            "2026-11",
+            "2026-10",
+            [
+                Change("b", 0, 100, 100, None, "new"),
+                Change("a", 100, 100, 0, 0.0, "same"),
+            ],
+            id="R5-abs-diff-desc-over-category",
+        ),
+    ],
+)
+def test_order_is_abs_diff_desc_then_category_asc(
+    rows: list[Expense],
+    month: str,
+    previous: str | None,
+    expected: list[Change],
+) -> None:
+    assert compare_months(rows, month, previous) == expected
+
+
+def test_R5_no_rows_in_target_month_returns_empty() -> None:
+    rows = [_e(2026, 10, "food", 1000)]
+    assert compare_months(rows, "2026-11", "2026-10") == []
+
+
+def test_R5_empty_input_returns_empty() -> None:
+    assert compare_months([], "2026-11", "2026-10") == []
+
+
+def test_P1_diff_matches_and_sorted_by_abs_diff() -> None:
+    rows = [
+        _e(2026, 10, "a", 1000),
+        _e(2026, 11, "a", 1100),  # +100
+        _e(2026, 10, "b", 300),
+        _e(2026, 11, "b", 0),  # gone, -300
+        _e(2026, 11, "c", 5000),  # new, +5000
+        _e(2026, 10, "d", 2000),
+        _e(2026, 11, "d", 1990),  # -10
+    ]
+    result = compare_months(rows, "2026-11", "2026-10")
+    for ch in result:
+        assert ch.diff == ch.current - ch.previous
+    diffs = [abs(ch.diff) for ch in result]
+    assert diffs == sorted(diffs, reverse=True)
+    assert [ch.category for ch in result] == ["c", "b", "a", "d"]
+
+
+# --- format_changes ---
+
+
+@pytest.mark.parametrize(
+    ("change", "line"),
+    [
+        pytest.param(
+            Change("food", 1000, 1500, 500, 50.0, "up"),
+            "food\t1000\t1500\t+500\t+50.0%\t増",
+            id="E4-8",
+        ),
+        pytest.param(
+            Change("food", 1500, 1000, -500, -33.3, "down"),
+            "food\t1500\t1000\t-500\t-33.3%\t減",
+            id="R6-down",
+        ),
+        pytest.param(
+            Change("food", 1000, 1000, 0, 0.0, "same"),
+            "food\t1000\t1000\t+0\t+0.0%\t変化なし",
+            id="R6-same",
+        ),
+        pytest.param(
+            Change("game", 0, 800, 800, None, "new"),
+            "game\t0\t800\t+800\t-\t新規",
+            id="R6-new-pct-none",
+        ),
+        pytest.param(
+            Change("gym", 2000, 0, -2000, -100.0, "gone"),
+            "gym\t2000\t0\t-2000\t-100.0%\t消滅",
+            id="R6-gone",
+        ),
+    ],
+)
+def test_format_labels_and_fields(change: Change, line: str) -> None:
+    assert format_changes([change]) == line
+
+
+def test_R6_multiple_rows_joined_without_trailing_newline() -> None:
+    changes = [
+        Change("food", 1000, 1500, 500, 50.0, "up"),
+        Change("gym", 2000, 0, -2000, -100.0, "gone"),
+    ]
+    assert format_changes(changes) == (
+        "food\t1000\t1500\t+500\t+50.0%\t増\ngym\t2000\t0\t-2000\t-100.0%\t消滅"
+    )
+
+
+def test_R6_empty_list_returns_empty_string() -> None:
+    assert format_changes([]) == ""
