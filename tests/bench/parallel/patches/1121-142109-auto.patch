@@ -0,0 +1,202 @@
+"""Bank / card statement CSV import. Pure functions: takes text, returns expenses."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from datetime import date
+
+from kakeibo.core import CsvError, Expense
+
+UNCATEGORIZED = "未分類"
+
+_DATE_ALIASES = ("日付", "利用日", "取引日", "ご利用日", "date")
+_AMOUNT_ALIASES = ("金額", "利用金額", "ご利用金額", "amount")
+_WITHDRAW_ALIASES = ("出金", "出金額", "支払", "お支払金額")
+_DEPOSIT_ALIASES = ("入金", "入金額", "預入")
+_MEMO_ALIASES = (
+    "摘要",
+    "メモ",
+    "利用店名",
+    "ご利用店名",
+    "内容",
+    "description",
+    "memo",
+)
+_CATEGORY_ALIASES = ("カテゴリ", "分類", "category")
+
+_DATE_SEP_RE = re.compile(r"(?P<y>\d{4})(?P<s>[-/.])(?P<m>\d{1,2})(?P=s)(?P<d>\d{1,2})")
+_DATE_KANJI_RE = re.compile(r"(?P<y>\d{4})年(?P<m>\d{1,2})月(?P<d>\d{1,2})日")
+_TIME_SUFFIX_RE = re.compile(r"\s+\d{1,2}:\d{2}(?::\d{2})?$")
+_YEN_UNIT_RE = re.compile(r"¥|円|jpy", re.IGNORECASE)
+_SPACE_COMMA_RE = re.compile(r"[\s,]")
+_SIGN_PREFIXES = ("-", "−", "▲", "△")
+
+
+def _parse_date(raw: str) -> date:
+    s = unicodedata.normalize("NFKC", raw).strip()
+    s = _TIME_SUFFIX_RE.sub("", s)
+    m = _DATE_SEP_RE.fullmatch(s) or _DATE_KANJI_RE.fullmatch(s)
+    if m is None:
+        raise ValueError("日付の形式が不正")
+    try:
+        return date(int(m["y"]), int(m["m"]), int(m["d"]))
+    except ValueError:
+        raise ValueError("存在しない日付") from None
+
+
+def _parse_yen(raw: str) -> int | None:
+    """Return the yen amount, or None when the cell means 'no amount'."""
+    s = unicodedata.normalize("NFKC", raw)
+    s = _YEN_UNIT_RE.sub("", s)
+    s = _SPACE_COMMA_RE.sub("", s)
+    if s in ("", "-", "—"):
+        return None
+    negative = False
+    if s.startswith("(") and s.endswith(")"):
+        negative, s = True, s[1:-1]
+    elif s.endswith("-"):
+        negative, s = True, s[:-1]
+    elif s[:1] in _SIGN_PREFIXES:
+        negative, s = True, s[1:]
+    if "." in s:
+        raise ValueError("整数ではありません")
+    if not re.fullmatch(r"[0-9]+", s):
+        raise ValueError("数値ではありません")
+    value = int(s)
+    return -value if negative else value
+
+
+def _find(header: list[str], aliases: tuple[str, ...]) -> int | None:
+    norm = [h.strip().casefold() for h in header]
+    for alias in aliases:
+        key = alias.casefold()
+        if key in norm:
+            return norm.index(key)
+    return None
+
+
+def _read_yen(row: list[str], idx: int, col: str) -> tuple[int | None, str | None]:
+    raw = row[idx]
+    try:
+        return _parse_yen(raw), None
+    except ValueError as e:
+        return None, f"{col}: {e}: {raw}"
+
+
+def parse_statement(text: str) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Parse a bank/card CSV. Returns (valid expenses, [(line_number, reason)])."""
+    body = text.removeprefix("﻿")
+    if not body.strip():
+        return [], []
+    delimiter = "\t" if "\t" in body.split("\n", 1)[0] else ","
+    reader = csv.reader(io.StringIO(body, newline=""), delimiter=delimiter)
+
+    # (start line, cells) per non-blank record; start line is 1-based.
+    records: list[tuple[int, list[str]]] = []
+    start = 1
+    for row in reader:
+        end = reader.line_num
+        if not (len(row) == 0 or (len(row) == 1 and not row[0].strip())):
+            records.append((start, row))
+        start = end + 1
+    if not records:
+        return [], []
+
+    header_line, header = records[0]
+    date_i = _find(header, _DATE_ALIASES)
+    amount_i = _find(header, _AMOUNT_ALIASES)
+    wd_i = _find(header, _WITHDRAW_ALIASES)
+    dep_i = _find(header, _DEPOSIT_ALIASES)
+    memo_i = _find(header, _MEMO_ALIASES)
+    cat_i = _find(header, _CATEGORY_ALIASES)
+    if date_i is None:
+        return [], [(header_line, "列 日付 がありません")]
+    if amount_i is None and wd_i is None and dep_i is None:
+        return [], [(header_line, "列 金額 または 出金/入金 がありません")]
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    for line, row in records[1:]:
+        if len(row) != len(header):
+            errors.append(
+                (
+                    line,
+                    f"列数: 列数が違います (期待 {len(header)} 列, 実際 {len(row)} 列)",
+                )
+            )
+            continue
+
+        problems: list[str] = []
+        day: date | None = None
+        try:
+            day = _parse_date(row[date_i])
+        except ValueError as e:
+            problems.append(f"日付: {e}: {row[date_i]}")
+
+        amount: int | None = None
+        if amount_i is not None:
+            value, err = _read_yen(row, amount_i, "金額")
+            if err:
+                problems.append(err)
+            elif value is None:
+                problems.append(f"金額: 金額がありません: {row[amount_i]}")
+            else:
+                amount = value
+        else:
+            wd, wd_err = (
+                _read_yen(row, wd_i, "出金") if wd_i is not None else (None, None)
+            )
+            dep, dep_err = (
+                _read_yen(row, dep_i, "入金") if dep_i is not None else (None, None)
+            )
+            problems.extend(e for e in (wd_err, dep_err) if e)
+            if wd_err is None and dep_err is None:
+                if wd is not None and dep is not None:
+                    problems.append(
+                        f"出金/入金: 両方に値があります: 出金={row[wd_i]}, 入金={row[dep_i]}"  # type: ignore[index]
+                    )
+                elif wd is None and dep is None:
+                    if wd_i is not None and dep_i is not None:
+                        problems.append(
+                            f"出金/入金: 両方が空です: 出金={row[wd_i]}, 入金={row[dep_i]}"
+                        )
+                    else:
+                        idx = wd_i if wd_i is not None else dep_i
+                        label = "出金" if wd_i is not None else "入金"
+                        problems.append(f"{label}: 金額がありません: {row[idx]}")  # type: ignore[index]
+                elif wd is not None:
+                    if wd < 0:
+                        problems.append(f"出金: 負の値は指定できません: {row[wd_i]}")  # type: ignore[index]
+                    else:
+                        amount = wd
+                else:
+                    assert dep is not None
+                    if dep < 0:
+                        problems.append(f"入金: 負の値は指定できません: {row[dep_i]}")  # type: ignore[index]
+                    else:
+                        amount = -dep
+
+        if problems:
+            errors.extend((line, p) for p in problems)
+            continue
+        if day is None or amount is None:  # unreachable: no problems implies both set
+            continue
+        category = row[cat_i].strip() if cat_i is not None else ""
+        memo = row[memo_i].strip() if memo_i is not None else ""
+        expenses.append(
+            Expense(
+                day=day, category=category or UNCATEGORIZED, amount=amount, memo=memo
+            )
+        )
+    return expenses, errors
+
+
+def parse_statement_strict(text: str) -> list[Expense]:
+    """Like parse_statement, but raises CsvError if any row is invalid."""
+    expenses, errors = parse_statement(text)
+    if errors:
+        raise CsvError(errors)
+    return expenses
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..9bfdb4e
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,146 @@
+"""Detect recurring expenses (subscriptions, rent, utilities) from expense rows."""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from collections import Counter
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_WS_RE = re.compile(r"\s+")
+_TRAILING_NUM_RE = re.compile(r"#?\d+$")
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int
+    months: int
+    last_day: date
+    day_of_month: int
+
+
+def _nfkc_lower(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).lower()
+
+
+def _category_key(category: str) -> str:
+    return _nfkc_lower(category).strip()
+
+
+def _is_blank_memo(memo: str) -> bool:
+    return _WS_RE.sub("", _nfkc_lower(memo)) == ""
+
+
+def _memo_key(memo: str) -> str:
+    """Normalized memo with whitespace and trailing number / '#n' removed."""
+    norm = _WS_RE.sub("", _nfkc_lower(memo))
+    stripped = _TRAILING_NUM_RE.sub("", norm)
+    return stripped or norm
+
+
+def _check_args(min_months: object, amount_tolerance: object) -> None:
+    if isinstance(min_months, bool) or not isinstance(min_months, int):
+        raise TypeError(f"min_months は int である必要があります: {min_months!r}")
+    if min_months < 2:
+        raise ValueError(f"min_months は 2 以上である必要があります: {min_months}")
+    if isinstance(amount_tolerance, bool) or not isinstance(
+        amount_tolerance, (int, float)
+    ):
+        raise TypeError(
+            f"amount_tolerance は数値である必要があります: {amount_tolerance!r}"
+        )
+    if not 0.0 <= amount_tolerance < 1.0:
+        raise ValueError(
+            f"amount_tolerance は 0.0 以上 1.0 未満である必要があります: {amount_tolerance}"
+        )
+
+
+def _within(a: int, b: int, tol: float) -> bool:
+    return abs(a - b) <= tol * max(a, b)
+
+
+def _cluster_by_amount(rows: list[Expense], tol: float) -> list[list[Expense]]:
+    """Group rows whose amounts are within tolerance of the cluster's smallest amount."""
+    clusters: list[list[Expense]] = []
+    for e in sorted(rows, key=lambda e: (e.amount, e.day)):
+        if clusters and _within(e.amount, clusters[-1][0].amount, tol):
+            clusters[-1].append(e)
+        else:
+            clusters.append([e])
+    return clusters
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month
+
+
+def _series(rows: list[Expense], min_months: int) -> Recurring | None:
+    """rows are pre-sorted by (day, amount, memo, category)."""
+    first_of_month: dict[int, Expense] = {}
+    for e in rows:
+        first_of_month.setdefault(_month_index(e.day), e)
+    idxs = sorted(first_of_month)
+    if not idxs:
+        return None
+    # 最後の連続区間を採用する
+    start = len(idxs) - 1
+    while start > 0 and idxs[start - 1] == idxs[start] - 1:
+        start -= 1
+    run = idxs[start:]
+    if len(run) < min_months:
+        return None
+    run_set = set(run)
+    in_run = [e for e in rows if _month_index(e.day) in run_set]
+    latest = in_run[-1]
+    counts = Counter(first_of_month[i].day.day for i in run)
+    day_of_month = max(counts.items(), key=lambda kv: (kv[1], kv[0]))[0]
+    return Recurring(
+        category=latest.category,
+        memo=latest.memo,
+        amount=latest.amount,
+        months=len(run),
+        last_day=latest.day,
+        day_of_month=day_of_month,
+    )
+
+
+def find_recurring(
+    rows: list[Expense], min_months: int = 3, amount_tolerance: float = 0.0
+) -> list[Recurring]:
+    """Find expense series that recur in consecutive months (negative amounts ignored)."""
+    _check_args(min_months, amount_tolerance)
+    ordered = sorted(
+        (e for e in rows if e.amount >= 0),
+        key=lambda e: (e.day, e.amount, e.memo, e.category),
+    )
+    groups: dict[tuple[object, ...], list[Expense]] = {}
+    for e in ordered:
+        if _is_blank_memo(e.memo):
+            key: tuple[object, ...] = ("amount", _category_key(e.category), e.amount)
+        else:
+            key = ("memo", _memo_key(e.memo), _category_key(e.category))
+        groups.setdefault(key, []).append(e)
+
+    out: list[Recurring] = []
+    for group in groups.values():
+        for cluster in _cluster_by_amount(group, amount_tolerance):
+            cluster.sort(key=lambda e: (e.day, e.amount, e.memo, e.category))
+            r = _series(cluster, min_months)
+            if r is not None:
+                out.append(r)
+    out.sort(key=lambda r: (-r.amount, r.memo, r.category, r.last_day, r.months))
+    return out
+
+
+def predict_next(r: Recurring) -> date:
+    """Next occurrence: day_of_month in the month after last_day, clamped to month end."""
+    y, m = r.last_day.year, r.last_day.month
+    y, m = (y + 1, 1) if m == 12 else (y, m + 1)
+    last = calendar.monthrange(y, m)[1]
+    return date(y, m, min(r.day_of_month, last))
