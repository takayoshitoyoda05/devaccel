@@ -0,0 +1,160 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.compare import CategoryChange, format_report, month_over_month
+from kakeibo.core import Expense
+
+
+def _e(day: str, category: str, amount: int) -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=""
+    )
+
+
+# E4-1: 前月 食費 4000 → 当月 5000 => diff=1000, ratio=0.25, status=増 (R3,R4,R5)
+def test_E4_1_increase_has_diff_ratio_and_status() -> None:
+    rows = [_e("2026-04-10", "食費", 4000), _e("2026-05-03", "食費", 5000)]
+    changes = month_over_month(rows, "2026-05")
+    assert changes == [
+        CategoryChange(
+            category="食費",
+            previous=4000,
+            current=5000,
+            diff=1000,
+            ratio=0.25,
+            status="増",
+        )
+    ]
+
+
+# E4-2: 前月に交通費だけ、当月に何も無い => 交通費: status=なくなった, ratio=-1.0 (R4,R5)
+def test_E4_2_category_only_in_previous_month_is_gone() -> None:
+    rows = [_e("2026-04-10", "交通費", 1200)]
+    changes = month_over_month(rows, "2026-05")
+    assert len(changes) == 1
+    c = changes[0]
+    assert c.category == "交通費"
+    assert c.status == "なくなった"
+    assert c.ratio == -1.0
+
+
+# E4-3: "2026-13" => ValueError (R1)
+def test_E4_3_invalid_month_raises_value_error() -> None:
+    with pytest.raises(ValueError):
+        month_over_month([], "2026-13")
+
+
+# --- 以下は規則 R1〜R7 の端のケース(表に無い分) ---
+
+
+@pytest.mark.parametrize(
+    "bad", ["2026-00", "2026-5", "26-05", "2026/05", "", "2026-05-01"]
+)
+def test_R1_malformed_month_raises(bad: str) -> None:
+    with pytest.raises(ValueError):
+        month_over_month([], bad)
+
+
+def test_R1_january_compares_against_previous_december() -> None:
+    rows = [_e("2025-12-20", "食費", 3000), _e("2026-01-05", "食費", 2000)]
+    (c,) = month_over_month(rows, "2026-01")
+    assert (c.previous, c.current, c.diff, c.status) == (3000, 2000, -1000, "減")
+
+
+def test_R2_no_rows_at_all_returns_empty_list() -> None:
+    assert month_over_month([], "2026-05") == []
+
+
+def test_R2_no_current_month_rows_marks_all_as_gone() -> None:
+    rows = [_e("2026-04-01", "食費", 100), _e("2026-04-02", "光熱費", 200)]
+    changes = month_over_month(rows, "2026-05")
+    assert {c.category: c.status for c in changes} == {
+        "食費": "なくなった",
+        "光熱費": "なくなった",
+    }
+
+
+def test_R2_no_previous_month_rows_marks_all_as_new() -> None:
+    rows = [_e("2026-05-01", "食費", 100)]
+    (c,) = month_over_month(rows, "2026-05")
+    assert (c.status, c.ratio) == ("新規", None)
+
+
+def test_R3_union_includes_categories_from_both_months() -> None:
+    rows = [_e("2026-04-01", "A", 10), _e("2026-05-01", "B", 20)]
+    names = {c.category for c in month_over_month(rows, "2026-05")}
+    assert names == {"A", "B"}
+
+
+def test_R4_refund_offsetting_to_zero_is_no_change() -> None:
+    rows = [
+        _e("2026-04-01", "食費", 1000),
+        _e("2026-05-01", "食費", 500),
+        _e("2026-05-02", "食費", -500),
+    ]
+    (c,) = month_over_month(rows, "2026-05")
+    assert (c.previous, c.current, c.diff, c.status, c.ratio) == (
+        1000,
+        0,
+        -1000,
+        "なくなった",
+        -1.0,
+    )
+
+
+def test_R4_both_months_zero_is_no_change() -> None:
+    rows = [_e("2026-04-01", "食費", 0), _e("2026-05-01", "食費", 0)]
+    (c,) = month_over_month(rows, "2026-05")
+    assert (c.diff, c.status, c.ratio) == (0, "変化なし", None)
+
+
+def test_R5_negative_previous_gives_no_ratio() -> None:
+    rows = [_e("2026-04-01", "返金", -500), _e("2026-05-01", "返金", 0)]
+    (c,) = month_over_month(rows, "2026-05")
+    assert c.previous == -500
+    assert c.ratio is None
+
+
+def test_R6_sorted_by_abs_diff_desc_then_category() -> None:
+    rows = [
+        _e("2026-04-01", "い", 100),
+        _e("2026-04-01", "あ", 100),
+        _e("2026-05-01", "う", 1000),
+        _e("2026-05-01", "え", 300),
+    ]
+    names = [c.category for c in month_over_month(rows, "2026-05")]
+    # |diff| 降順: う=1000, え=300, あ/い=100(同点はカテゴリ昇順)
+    assert names == ["う", "え", "あ", "い"]
+
+
+def test_D5_categories_equal_after_nfkc_and_case_are_merged() -> None:
+    rows = [_e("2026-04-01", "Food", 100), _e("2026-05-01", "ｆｏｏｄ ", 150)]
+    changes = month_over_month(rows, "2026-05")
+    assert len(changes) == 1
+    assert (changes[0].previous, changes[0].current, changes[0].status) == (
+        100,
+        150,
+        "増",
+    )
+
+
+def test_R7_format_report_empty_is_empty_string() -> None:
+    assert format_report([]) == ""
+
+
+def test_R7_format_report_line_layout_and_signs() -> None:
+    changes = [
+        CategoryChange("食費", 4000, 5500, 1500, 0.375, "増"),
+        CategoryChange("光熱費", 1000, 700, -300, -0.3, "減"),
+        CategoryChange("雑費", 0, 0, 0, None, "変化なし"),
+        CategoryChange("新", 0, 2000, 2000, None, "新規"),
+    ]
+    assert format_report(changes).splitlines() == [
+        "食費  4,000 → 5,500  +1,500円 (+37.5%)  増",
+        "光熱費  1,000 → 700  -300円 (-30.0%)  減",
+        "雑費  0 → 0  +0円 (-)  変化なし",
+        "新  0 → 2,000  +2,000円 (-)  新規",
+    ]
