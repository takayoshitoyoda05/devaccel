new file mode 100644
index 0000000..adbb28c
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,135 @@
+"""Search expense records with composable, pure query predicates."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable
+from datetime import date
+
+from kakeibo.core import Expense
+
+Query = Callable[[Expense], bool]
+
+
+def _norm(text: str) -> str:
+    """D5: NFKC normalization, case-insensitive, surrounding whitespace ignored."""
+    return unicodedata.normalize("NFKC", text).casefold().strip()
+
+
+def _check_int(value: object, name: str) -> None:
+    if isinstance(value, bool) or not isinstance(value, int):
+        if value is None:
+            return
+        raise TypeError(f"{name} は整数である必要があります: {value!r}")
+
+
+def category(*names: str) -> Query:
+    """R1: match when the category equals any of the names (after normalization)."""
+    if not names:
+        raise ValueError("category には 1 つ以上のカテゴリ名が必要です")
+    for n in names:
+        if not isinstance(n, str):
+            raise TypeError(f"カテゴリ名は文字列である必要があります: {n!r}")
+    targets = frozenset(_norm(n) for n in names)
+
+    def pred(e: Expense) -> bool:
+        return _norm(e.category) in targets
+
+    return pred
+
+
+def amount_between(low: int | None = None, high: int | None = None) -> Query:
+    """R2/R7: inclusive range on the signed amount; None means unbounded."""
+    _check_int(low, "low")
+    _check_int(high, "high")
+    if low is not None and high is not None and low > high:
+        raise ValueError(f"low は high 以下である必要があります: {low} > {high}")
+
+    def pred(e: Expense) -> bool:
+        if low is not None and e.amount < low:
+            return False
+        return not (high is not None and e.amount > high)
+
+    return pred
+
+
+def memo_contains(text: str) -> Query:
+    """R3: normalized substring match on the memo."""
+    if not isinstance(text, str):
+        raise TypeError(f"text は文字列である必要があります: {text!r}")
+    needle = _norm(text)
+    if not needle:
+        raise ValueError("memo_contains に空の文字列は指定できません")
+
+    def pred(e: Expense) -> bool:
+        return needle in _norm(e.memo)
+
+    return pred
+
+
+def period(start: date | None = None, end: date | None = None) -> Query:
+    """R4: inclusive date range; None means unbounded."""
+    for name, v in (("start", start), ("end", end)):
+        if v is not None and not isinstance(v, date):
+            raise TypeError(f"{name} は date である必要があります: {v!r}")
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"start は end 以下である必要があります: {start} > {end}")
+
+    def pred(e: Expense) -> bool:
+        if start is not None and e.day < start:
+            return False
+        return not (end is not None and e.day > end)
+
+    return pred
+
+
+def _check_queries(qs: tuple[Query, ...]) -> None:
+    for q in qs:
+        if not callable(q):
+            raise TypeError(f"Query ではありません: {q!r}")
+
+
+def all_of(*qs: Query) -> Query:
+    """R5: AND of the queries; no queries means always true."""
+    _check_queries(qs)
+
+    def pred(e: Expense) -> bool:
+        return all(q(e) for q in qs)
+
+    return pred
+
+
+def any_of(*qs: Query) -> Query:
+    """R5: OR of the queries; no queries means always false."""
+    _check_queries(qs)
+
+    def pred(e: Expense) -> bool:
+        return any(q(e) for q in qs)
+
+    return pred
+
+
+def not_(q: Query) -> Query:
+    _check_queries((q,))
+
+    def pred(e: Expense) -> bool:
+        return not q(e)
+
+    return pred
+
+
+def search(rows: list[Expense], query: Query) -> list[Expense]:
+    """R6: keep input order, drop duplicate records, never mutate rows."""
+    if not callable(query):
+        raise TypeError(f"query は Query である必要があります: {query!r}")
+    out: list[Expense] = []
+    seen: set[Expense] = set()
+    for e in rows:
+        if e in seen:
+            continue
+        if query(e):
+            seen.add(e)
+            out.append(e)
+        else:
+            seen.add(e)
+    return out
