+++ b/tests/test_recurring.py
@@ -0,0 +1,195 @@
+"""Tests for recurring expense detection (kakeibo.recurring)."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, predict_next
+
+
+def ex(day: str, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+def rec(last_day: str, day_of_month: int) -> Recurring:
+    return Recurring(
+        category="x",
+        memo="x",
+        amount=1,
+        months=3,
+        last_day=date.fromisoformat(last_day),
+        day_of_month=day_of_month,
+    )
+
+
+# E1-1: 家賃は月末に払う。日の最頻値は 31、次回は 4/30 に丸める。
+def test_E1_1_month_end_rent_rounds_to_month_end() -> None:
+    rows = [
+        ex("2026-01-31", "住居", 80000, "家賃"),
+        ex("2026-02-28", "住居", 80000, "家賃"),
+        ex("2026-03-31", "住居", 80000, "家賃"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].day_of_month == 31
+    assert result[0].months == 3
+    assert predict_next(result[0]) == date(2026, 4, 30)
+
+
+# E1-2: 3 月が欠けると系列は切れ、最後の連続区間 (4 月の 1 か月) は 3 か月に届かない。
+def test_E1_2_gap_breaks_series_below_min_months() -> None:
+    rows = [
+        ex("2026-01-05", "娯楽", 1200, "動画サブスク"),
+        ex("2026-02-05", "娯楽", 1200, "動画サブスク"),
+        ex("2026-04-05", "娯楽", 1200, "動画サブスク"),
+    ]
+    assert find_recurring(rows, min_months=3) == []
+
+
+# E1-3: min_months は 2 以上。1 は ValueError。
+def test_E1_3_min_months_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_months=1)
+
+
+# --- 端のケース(仕様文面から) ---
+
+
+def test_r1_memo_key_ignores_case_width_whitespace_and_trailing_number() -> None:
+    rows = [
+        ex("2026-01-05", "娯楽", 1200, "Netflix #1"),
+        ex("2026-02-05", "娯楽", 1200, "ＮＥＴＦＬＩＸ 2"),
+        ex("2026-03-05", "娯楽", 1200, "netflix"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].months == 3
+
+
+def test_r1_empty_memo_keyed_by_category_and_amount() -> None:
+    same = [ex(f"2026-0{m}-10", "雑費", 500) for m in (1, 2, 3)]
+    assert len(find_recurring(same)) == 1
+    different_amounts = [
+        ex("2026-01-10", "雑費", 500),
+        ex("2026-02-10", "雑費", 600),
+        ex("2026-03-10", "雑費", 700),
+    ]
+    assert find_recurring(different_amounts) == []
+
+
+def test_r2_same_month_counts_once() -> None:
+    rows = [
+        ex("2026-01-05", "娯楽", 1200, "動画"),
+        ex("2026-01-20", "娯楽", 1200, "動画"),
+        ex("2026-02-05", "娯楽", 1200, "動画"),
+        ex("2026-03-05", "娯楽", 1200, "動画"),
+    ]
+    assert len(find_recurring(rows, min_months=3)) == 1
+    assert find_recurring(rows, min_months=4) == []
+
+
+def test_r2_last_continuous_run_is_adopted() -> None:
+    months = [1, 2, 3, 5, 6, 7, 8]
+    rows = [ex(f"2026-{m:02d}-05", "娯楽", 1200, "動画") for m in months]
+    result = find_recurring(rows, min_months=4)
+    assert len(result) == 1
+    assert result[0].months == 4
+    assert result[0].last_day == date(2026, 8, 5)
+    assert find_recurring(rows, min_months=5) == []
+
+
+def test_r3_amount_tolerance_merges_and_takes_latest_amount() -> None:
+    rows = [
+        ex("2026-01-05", "通信", 1000, "回線"),
+        ex("2026-02-05", "通信", 1040, "回線"),
+        ex("2026-03-05", "通信", 1020, "回線"),
+    ]
+    assert find_recurring(rows, amount_tolerance=0.0) == []
+    result = find_recurring(rows, amount_tolerance=0.05)
+    assert len(result) == 1
+    assert result[0].amount == 1020
+
+
+def test_r4_day_mode_tie_prefers_larger_day() -> None:
+    rows = [
+        ex("2026-01-05", "娯楽", 1200, "動画"),
+        ex("2026-02-10", "娯楽", 1200, "動画"),
+        ex("2026-03-05", "娯楽", 1200, "動画"),
+        ex("2026-04-10", "娯楽", 1200, "動画"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].day_of_month == 10
+
+
+def test_r5_predict_december_rolls_to_january() -> None:
+    assert predict_next(rec("2026-12-15", 15)) == date(2027, 1, 15)
+
+
+def test_r5_predict_clamps_to_leap_february() -> None:
+    assert predict_next(rec("2028-01-31", 31)) == date(2028, 2, 29)
+
+
+def test_r5_predict_clamps_to_non_leap_february() -> None:
+    assert predict_next(rec("2027-01-31", 31)) == date(2027, 2, 28)
+
+
+def test_r6_sorted_by_amount_desc_then_memo_asc() -> None:
+    rows: list[Expense] = []
+    for m in (1, 2, 3):
+        rows.append(ex(f"2026-0{m}-05", "娯楽", 300, "b"))
+        rows.append(ex(f"2026-0{m}-06", "娯楽", 300, "a"))
+        rows.append(ex(f"2026-0{m}-07", "娯楽", 100, "c"))
+    result = find_recurring(rows)
+    assert [(r.memo, r.amount) for r in result] == [("a", 300), ("b", 300), ("c", 100)]
+
+
+@pytest.mark.parametrize(
+    "min_months, tol, exc",
+    [
+        (True, 0.0, TypeError),
+        (2.0, 0.0, TypeError),
+        (None, 0.0, TypeError),
+        (3, None, TypeError),
+        (3, True, TypeError),
+        (3, 1.0, ValueError),
+        (3, -0.1, ValueError),
+        (0, 0.0, ValueError),
+    ],
+    ids=["bool", "float", "none", "tol-none", "tol-bool", "tol-one", "tol-neg", "zero"],
+)
+def test_r7_invalid_arguments(
+    min_months: object, tol: object, exc: type[Exception]
+) -> None:
+    with pytest.raises(exc):
+        find_recurring([], min_months=min_months, amount_tolerance=tol)  # type: ignore[arg-type]
+
+
+def test_d1_negative_amounts_are_ignored() -> None:
+    rows = [
+        ex("2026-01-05", "娯楽", -1200, "動画"),
+        ex("2026-02-05", "娯楽", -1200, "動画"),
+        ex("2026-03-05", "娯楽", -1200, "動画"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_d3_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+def test_d4_result_independent_of_input_order() -> None:
+    rows = [
+        ex("2026-01-05", "娯楽", 1200, "動画"),
+        ex("2026-02-05", "娯楽", 1200, "動画"),
+        ex("2026-03-05", "娯楽", 1200, "動画"),
+        ex("2026-01-07", "住居", 80000, "家賃"),
+        ex("2026-02-07", "住居", 80000, "家賃"),
+        ex("2026-03-07", "住居", 80000, "家賃"),
+    ]
+    assert find_recurring(rows) == find_recurring(list(reversed(rows)))
