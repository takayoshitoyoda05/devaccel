+from datetime import date
+
+import pytest
+
+from kakeibo.core import CsvError, Expense
+from kakeibo.importer import parse_statement, parse_statement_strict
+
+
+@pytest.mark.parametrize(
+    ("text", "expected_expenses", "expected_errors"),
+    [
+        pytest.param(
+            '利用日,ご利用店名,利用金額\n2026/1/5,ABC,"1,234円"\n',
+            [Expense(date(2026, 1, 5), "未分類", 1234, "ABC")],
+            [],
+            id="E2-1",
+        ),
+        pytest.param(
+            "日付,摘要,出金,入金\n2026/1/5,給与,,500\n",
+            [Expense(date(2026, 1, 5), "未分類", -500, "給与")],
+            [],
+            id="E2-2",
+        ),
+        pytest.param(
+            "日付,金額\n2026/2/30,12.5\n",
+            [],
+            [(2, "日付"), (2, "金額")],
+            id="E2-3",
+        ),
+    ],
+)
+def test_statement_table(
+    text: str,
+    expected_expenses: list[Expense],
+    expected_errors: list[tuple[int, str]],
+) -> None:
+    expenses, errors = parse_statement(text)
+    assert expenses == expected_expenses
+    assert [(n, reason.split(":")[0]) for n, reason in errors] == expected_errors
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param(
+            '利用日,ご利用店名,利用金額\n2026/1/5,ABC,"1,234円"\n',
+            [Expense(date(2026, 1, 5), "未分類", 1234, "ABC")],
+            id="E2-1",
+        ),
+        pytest.param(
+            "日付,摘要,出金,入金\n2026/1/5,給与,,500\n",
+            [Expense(date(2026, 1, 5), "未分類", -500, "給与")],
+            id="E2-2",
+        ),
+    ],
+)
+def test_strict_returns_expenses_when_valid(text: str, expected: list[Expense]) -> None:
+    assert parse_statement_strict(text) == expected
+
+
+def test_strict_raises_on_invalid_row_E2_3() -> None:
+    with pytest.raises(CsvError) as excinfo:
+        parse_statement_strict("日付,金額\n2026/2/30,12.5\n")
+    assert [n for n, _ in excinfo.value.errors] == [2, 2]
