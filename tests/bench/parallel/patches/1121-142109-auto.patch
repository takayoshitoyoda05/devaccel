+"""Month-over-month comparison of expenses by category (pure functions)."""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    diff: int
+    ratio: float | None
+    status: str
+
+
+def _previous_month(month: str) -> str:
+    year, mon = int(month[:4]), int(month[5:7])
+    if mon == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mon - 1:02d}"
+
+
+def _key(category: str) -> str:
+    """D5: NFKC・前後空白無視・大文字小文字無視で比較するためのキー。"""
+    return unicodedata.normalize("NFKC", category).strip().casefold()
+
+
+def _status(previous: int, current: int, diff: int) -> str:
+    if previous == 0 and current > 0:
+        return "新規"
+    if previous > 0 and current == 0:
+        return "なくなった"
+    if diff > 0:
+        return "増"
+    if diff < 0:
+        return "減"
+    return "変化なし"
+
+
+def month_over_month(rows: list[Expense], month: str) -> list[CategoryChange]:
+    """Compare `month` (YYYY-MM) with the previous month, per category.
+
+    Sorted by |diff| descending, then category ascending (D4).
+    Returns [] when neither month has any rows (D3).
+    """
+    if not isinstance(month, str) or not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"month は YYYY-MM 形式である必要があります: {month!r}")
+    prev_month = _previous_month(month)
+
+    sums: dict[str, dict[str, int]] = {prev_month: {}, month: {}}
+    names: dict[str, str] = {}
+    for e in rows:
+        m = e.day.strftime("%Y-%m")
+        if m not in sums:
+            continue
+        k = _key(e.category)
+        sums[m][k] = sums[m].get(k, 0) + e.amount
+        name = e.category.strip()
+        names[k] = min(names.get(k, name), name)
+
+    if not sums[prev_month] and not sums[month]:
+        return []
+
+    changes: list[CategoryChange] = []
+    for k in set(sums[prev_month]) | set(sums[month]):
+        previous = sums[prev_month].get(k, 0)
+        current = sums[month].get(k, 0)
+        diff = current - previous
+        ratio = diff / previous if previous > 0 else None
+        changes.append(
+            CategoryChange(
+                category=names[k],
+                previous=previous,
+                current=current,
+                diff=diff,
+                ratio=ratio,
+                status=_status(previous, current, diff),
+            )
+        )
+    changes.sort(key=lambda c: (-abs(c.diff), c.category))
+    return changes
+
+
+def format_report(changes: list[CategoryChange]) -> str:
+    """One line per category; empty input gives an empty string."""
+    lines: list[str] = []
+    for c in changes:
+        pct = "-" if c.ratio is None else f"{c.ratio * 100:+.1f}%"
+        lines.append(
+            f"{c.category}  {c.previous:,} → {c.current:,}  {c.diff:+,}円 ({pct})  {c.status}"
+        )
+    return "\n".join(lines)
