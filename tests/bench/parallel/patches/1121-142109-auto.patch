+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    all_of,
+    amount_between,
+    any_of,
+    category,
+    memo_contains,
+    not_,
+    period,
+    search,
+)
+
+ROWS = [
+    Expense(date(2026, 1, 5), "食費", 1200, "ＮＥＴＦＬＩＸ 契約"),
+    Expense(date(2026, 1, 20), "交通費", 500, "電車"),
+    Expense(date(2026, 2, 1), "食費", -500, "返金 スーパー"),
+    Expense(date(2026, 2, 14), "日用品", 3000, "Netflix ギフト"),
+]
+
+
+def _ids(rows: list[Expense]) -> list[str]:
+    return [r.memo for r in rows]
+
+
+# E3-1: all_of() は真、any_of() は偽
+@pytest.mark.parametrize(
+    ("query", "expected_count"),
+    [
+        (all_of(), len(ROWS)),  # E3-1
+        (any_of(), 0),  # E3-1
+    ],
+    ids=["E3-1-all_of", "E3-1-any_of"],
+)
+def test_E3_1_empty_all_of_any_of(query, expected_count):
+    assert len(search(ROWS, query)) == expected_count
+
+
+# E3-2: NFKC 正規化 + 大文字小文字無視で部分一致
+def test_E3_2_memo_contains_normalized_match():
+    result = search(ROWS, memo_contains("netflix"))  # E3-2
+    assert _ids(result) == ["ＮＥＴＦＬＩＸ 契約", "Netflix ギフト"]
+
+
+# E3-3: low > high は ValueError
+def test_E3_3_amount_between_low_greater_than_high():
+    with pytest.raises(ValueError):
+        amount_between(500, 100)  # E3-3
+
+
+# R1: category は完全一致(部分一致ではない)、D5 の比較、名前 0 個は ValueError
+def test_R1_category_exact_match_only():
+    assert _ids(search(ROWS, category("食"))) == []
+    assert len(search(ROWS, category("食費"))) == 2
+
+
+def test_R1_category_any_of_names_and_normalization():
+    result = search(ROWS, category(" 交通費 ", "ＮＩＣＨＩＢＩ"))
+    assert _ids(result) == ["電車"]
+
+
+def test_R1_category_requires_at_least_one_name():
+    with pytest.raises(ValueError):
+        category()
+
+
+# R2: 両端含む、両方 None は全件、int 以外は TypeError
+def test_R2_amount_between_inclusive_bounds():
+    assert _ids(search(ROWS, amount_between(500, 1200))) == [
+        "ＮＥＴＦＬＩＸ 契約",
+        "電車",
+    ]
+
+
+def test_R2_amount_between_both_none_matches_all():
+    assert len(search(ROWS, amount_between())) == len(ROWS)
+
+
+@pytest.mark.parametrize("bad", [True, 1.5])
+def test_R2_amount_between_rejects_bool_and_float(bad):
+    with pytest.raises(TypeError):
+        amount_between(bad, None)
+    with pytest.raises(TypeError):
+        amount_between(None, bad)
+
+
+# R3: 空文字は ValueError
+def test_R3_memo_contains_empty_raises():
+    with pytest.raises(ValueError):
+        memo_contains("")
+    with pytest.raises(ValueError):
+        memo_contains("   ")
+
+
+# R4: 両端含む、start > end は ValueError、両方 None は全件
+def test_R4_period_inclusive_bounds():
+    result = search(ROWS, period(date(2026, 1, 20), date(2026, 2, 1)))
+    assert _ids(result) == ["電車", "返金 スーパー"]
+
+
+def test_R4_period_both_none_matches_all():
+    assert len(search(ROWS, period())) == len(ROWS)
+
+
+def test_R4_period_start_after_end_raises():
+    with pytest.raises(ValueError):
+        period(date(2026, 2, 1), date(2026, 1, 1))
+
+
+# R5: 入れ子の all_of / any_of / not_
+def test_R5_nested_queries():
+    q = not_(
+        any_of(category("食費"), all_of(amount_between(0, None), memo_contains("電車")))
+    )
+    assert _ids(search(ROWS, q)) == ["Netflix ギフト"]
+
+
+# R6: 入力順・重複排除・元リストを変更しない、Query 以外は TypeError
+def test_R6_preserves_order_and_does_not_mutate():
+    rows = [ROWS[3], ROWS[0], ROWS[3]]
+    snapshot = list(rows)
+    result = search(rows, all_of())
+    assert result == [ROWS[3], ROWS[0]]
+    assert rows == snapshot
+
+
+def test_R6_non_query_raises_type_error():
+    with pytest.raises(TypeError):
+        search(ROWS, "食費")  # type: ignore[arg-type]
+
+
+# R7: 負の金額も金額範囲の対象
+def test_R7_negative_amount_in_range():
+    result = search(ROWS, amount_between(-1000, 0))
+    assert _ids(result) == ["返金 スーパー"]
+
+
+# D3: 空入力は空の結果
+def test_D3_empty_rows_returns_empty_list():
+    assert search([], all_of()) == []
