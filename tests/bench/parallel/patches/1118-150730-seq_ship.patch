diff --git a/src/kakeibo/bankimport.py b/src/kakeibo/bankimport.py
new file mode 100644
index 0000000..7b65d5a
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,91 @@
+"""Import CSVs exported by other banks / card issuers."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+_AMOUNT_RE = re.compile(r"(-?)[¥￥]?([0-9][0-9,]*)円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+DEFAULT_MAPPING = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+
+def parse_amount(s: str) -> int:
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    return int(m.group(1) + m.group(2).replace(",", ""))
+
+
+def parse_date(s: str) -> date:
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header = next(reader, None)
+    if header is None:
+        raise ValueError("ヘッダーがありません")
+    index: dict[str, int] = {}
+    for key, col in mapping.items():
+        if col not in header:
+            raise ValueError(f"列 {col!r} がヘッダーにありません")
+        index[key] = header.index(col)
+
+    def cell(row: list[str], key: str) -> str:
+        i = index.get(key)
+        return row[i] if i is not None and i < len(row) else ""
+
+    rows: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    while True:
+        start = reader.line_num + 1
+        row = next(reader, None)
+        if row is None:
+            break
+        if not row:
+            continue
+        bad: list[str] = []
+        day = None
+        amount = 0
+        try:
+            day = parse_date(cell(row, "date"))
+        except ValueError:
+            bad.append("date")
+        try:
+            amount = parse_amount(cell(row, "amount"))
+        except ValueError:
+            bad.append("amount")
+        category = cell(row, "category").strip()
+        if not category:
+            bad.append("category")
+        if bad:
+            errors.extend((start, f) for f in bad)
+            continue
+        if category_map:
+            category = category_map.get(category, category)
+        assert day is not None
+        rows.append(Expense(day, category, amount, cell(row, "memo").strip()))
+    return rows, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
