+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def E(d: date, cat: str = "家賃", amt: int = 1000, memo: str = "") -> Expense:
+    return Expense(d, cat, amt, memo)
+
+
+@pytest.mark.parametrize(
+    "src,dst",
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2024, 1, 31), date(2024, 2, 29)),
+        (date(2026, 12, 15), date(2027, 1, 15)),
+        (date(2026, 3, 31), date(2026, 4, 30)),
+    ],
+)
+def test_add_month(src: date, dst: date) -> None:
+    assert add_month(src) == dst
+
+
+def test_basic_run() -> None:
+    rows = [E(date(2026, 1, 5)), E(date(2026, 2, 6)), E(date(2026, 3, 4))]
+    assert find_recurring(rows) == [
+        Recurring(
+            "家賃",
+            1000,
+            (date(2026, 1, 5), date(2026, 2, 6), date(2026, 3, 4)),
+            date(2026, 4, 4),
+        )
+    ]
+
+
+def test_tolerance_boundary_and_break() -> None:
+    # Jan 5 -> expected Feb 5; Feb 8 is exactly 3 days off (ok), Feb 9 is not
+    ok = [E(date(2026, 1, 5)), E(date(2026, 2, 8)), E(date(2026, 3, 8))]
+    assert len(find_recurring(ok)) == 1
+    bad = [E(date(2026, 1, 5)), E(date(2026, 2, 9)), E(date(2026, 3, 9))]
+    assert find_recurring(bad) == []
+
+
+def test_split_into_runs_and_order() -> None:
+    rows = [E(date(2026, m, 1), "A", 5) for m in (1, 2, 3)]
+    rows += [E(date(2026, m, 1), "A", 5) for m in (6, 7, 8)]
+    rows += [E(date(2026, m, 1), "A", 2) for m in (1, 2, 3)]
+    got = find_recurring(rows)
+    assert [(r.amount, r.days[0]) for r in got] == [
+        (2, date(2026, 1, 1)),
+        (5, date(2026, 1, 1)),
+        (5, date(2026, 6, 1)),
+    ]
+
+
+def test_duplicates_memo_ignored_and_groups() -> None:
+    rows = [
+        E(date(2026, 1, 1), memo="a"),
+        E(date(2026, 1, 1), memo="b"),
+        E(date(2026, 2, 1)),
+        E(date(2026, 3, 1)),
+        E(date(2026, 3, 1), amt=999),
+    ]
+    got = find_recurring(rows)
+    assert len(got) == 1 and len(got[0].days) == 3
+
+
+def test_min_count_and_empty() -> None:
+    assert find_recurring([]) == []
+    rows = [E(date(2026, 1, 1)), E(date(2026, 2, 1))]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_count=2)) == 1
+
+
+def test_month_end_chain() -> None:
+    rows = [E(date(2026, 1, 31)), E(date(2026, 2, 28)), E(date(2026, 3, 28))]
+    assert len(find_recurring(rows, tolerance=0)) == 1
+    assert len(find_recurring(rows, tolerance=3)) == 1
+
+
+def test_invalid_args() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
