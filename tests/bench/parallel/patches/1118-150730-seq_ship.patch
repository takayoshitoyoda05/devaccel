index 0000000..b5a9886
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,81 @@
+"""Month-over-month category comparison."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _month_of(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    for m in (prev_month, curr_month):
+        if not _MONTH_RE.fullmatch(m):
+            raise ValueError(f"月の形式が不正です(YYYY-MM): {m!r}")
+    prev: dict[str, int] = {}
+    curr: dict[str, int] = {}
+    for e in rows:
+        m = _month_of(e)
+        if m == prev_month:
+            prev[e.category] = prev.get(e.category, 0) + e.amount
+        if m == curr_month:
+            curr[e.category] = curr.get(e.category, 0) + e.amount
+    out: list[DiffRow] = []
+    for cat in set(prev) | set(curr):
+        p, c = prev.get(cat, 0), curr.get(cat, 0)
+        delta = c - p
+        pct = round(delta / p * 100, 1) if p != 0 else None
+        if cat not in prev:
+            status = "new"
+        elif cat not in curr:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, p, c, delta, pct, status))
+    out.sort(key=lambda d: (-abs(d.delta), d.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError("n must be >= 0")
+    return [d for d in diffs if d.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for d in diffs:
+        pct = "-" if d.pct is None else f"{d.pct + 0.0:+.1f}%"
+        lines.append(f"{d.category}\t{d.prev}\t{d.curr}\t{d.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month_of(e) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("比較できる月が 2 つ未満です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..f59e64d
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,130 @@
+"""Tiny search query language for expenses."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+
+from kakeibo.core import Expense
+
+
+class QueryError(ValueError):
+    pass
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    out: list[tuple[str, str]] = []
+    i, n = 0, len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            out.append(("LPAREN", c))
+            i += 1
+        elif c == ")":
+            out.append(("RPAREN", c))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError("引用符が閉じていません")
+            if end == i + 1:
+                raise QueryError("引用の中身が空です")
+            out.append(("TERM", q[i + 1 : end]))
+            i = end + 1
+        else:
+            j = i
+            while j < n and not q[j].isspace() and q[j] not in '()"':
+                j += 1
+            word = q[i:j]
+            i = j
+            if word in ("AND", "OR", "NOT"):
+                out.append((word, word))
+            elif word.startswith("cat:"):
+                if len(word) == 4:
+                    raise QueryError("cat: の後ろが空です")
+                out.append(("CAT", word[4:]))
+            else:
+                out.append(("TERM", word))
+    return out
+
+
+Pred = Callable[[Expense], bool]
+
+
+class _Parser:
+    def __init__(self, tokens: list[tuple[str, str]]) -> None:
+        self.t = tokens
+        self.i = 0
+
+    def peek(self) -> str | None:
+        return self.t[self.i][0] if self.i < len(self.t) else None
+
+    def or_expr(self) -> Pred:
+        parts = [self.and_expr()]
+        while self.peek() == "OR":
+            self.i += 1
+            parts.append(self.and_expr())
+        return lambda e: any(p(e) for p in parts)
+
+    def and_expr(self) -> Pred:
+        parts = [self.not_expr()]
+        while True:
+            k = self.peek()
+            if k == "AND":
+                self.i += 1
+                parts.append(self.not_expr())
+            elif k in ("NOT", "TERM", "CAT", "LPAREN"):
+                parts.append(self.not_expr())
+            else:
+                break
+        return lambda e: all(p(e) for p in parts)
+
+    def not_expr(self) -> Pred:
+        if self.peek() == "NOT":
+            self.i += 1
+            inner = self.not_expr()
+            return lambda e: not inner(e)
+        return self.primary()
+
+    def primary(self) -> Pred:
+        k = self.peek()
+        if k == "TERM":
+            v = self.t[self.i][1].casefold()
+            self.i += 1
+            return lambda e: v in e.memo.casefold() or v in e.category.casefold()
+        if k == "CAT":
+            v = self.t[self.i][1].casefold()
+            self.i += 1
+            return lambda e: e.category.casefold() == v
+        if k == "LPAREN":
+            self.i += 1
+            inner = self.or_expr()
+            if self.peek() != "RPAREN":
+                raise QueryError("括弧が閉じていません")
+            self.i += 1
+            return inner
+        raise QueryError("項が必要です" if k is None else f"予期しない {k}")
+
+
+def _compile(q: str) -> Pred:
+    tokens = tokenize(q)
+    if not tokens:
+        raise QueryError("クエリが空です")
+    p = _Parser(tokens)
+    try:
+        pred = p.or_expr()
+    except RecursionError:
+        raise QueryError("クエリのネストが深すぎます") from None
+    if p.i != len(tokens):
+        raise QueryError(f"予期しない {tokens[p.i][0]}")
+    return pred
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _compile(q)(e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    pred = _compile(q)
+    return [e for e in rows if pred(e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..f48107d
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,53 @@
+"""Recurring (monthly) expense detection."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+from itertools import pairwise
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Same day next month, clamped to the last day of that month."""
+    year, month = (d.year + 1, 1) if d.month == 12 else (d.year, d.month + 1)
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError("min_count must be >= 2")
+    if tolerance < 0:
+        raise ValueError("tolerance must be >= 0")
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+    out: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        days = sorted(day_set)
+        run = [days[0]]
+        runs = [run]
+        for prev, cur in pairwise(days):
+            if abs((cur - add_month(prev)).days) <= tolerance:
+                run.append(cur)
+            else:
+                run = [cur]
+                runs.append(run)
+        for r in runs:
+            if len(r) >= min_count:
+                out.append(Recurring(category, amount, tuple(r), add_month(r[-1])))
+    out.sort(key=lambda x: (x.category, x.amount, x.days[0]))
+    return out
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..44fcde0
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,90 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+
+@pytest.mark.parametrize(
+    "s,v",
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥1,2,3円", 123),
+        ("-5", -5),
+    ],
+)
+def test_parse_amount_ok(s: str, v: int) -> None:
+    assert parse_amount(s) == v
+
+
+@pytest.mark.parametrize(
+    "s", ["", "円", "12.5", "1 200", "--5", "¥-5", "１２３", ",5", "¥", "5円円", "-"]
+)
+def test_parse_amount_bad(s: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(s)
+
+
+def test_parse_date() -> None:
+    assert parse_date(" 2026/1/5 ") == date(2026, 1, 5)
+    assert parse_date("2026-01-05") == date(2026, 1, 5)
+    assert parse_date("2024/2/29") == date(2024, 2, 29)
+
+
+@pytest.mark.parametrize(
+    "s",
+    ["2026/1-5", "26/1/5", "2026/02/30", "2026.1.5", "２０２６/1/5", "2026/1/005", ""],
+)
+def test_parse_date_bad(s: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(s)
+
+
+HEADER = "利用日,分類,利用金額,利用店名,余分\n"
+
+
+def test_import_basic_and_category_map() -> None:
+    text = HEADER + '2026/1/5, 食費 ,"¥1,200", スーパー ,x\n2026-01-06,交通,円,駅,y\n'
+    rows, errors = import_rows(text, category_map={"食費": "food"})
+    assert rows == [Expense(date(2026, 1, 5), "food", 1200, "スーパー")]
+    assert errors == [(3, "amount")]
+
+
+def test_errors_order_blank_lines_and_short_rows() -> None:
+    text = HEADER + "\nbad,  ,zz,m\n2026/1/1\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [
+        (3, "date"),
+        (3, "amount"),
+        (3, "category"),
+        (4, "amount"),
+        (4, "category"),
+    ]
+
+
+def test_quoted_multiline_physical_line_numbers() -> None:
+    text = HEADER + '2026/1/1,食費,100,"a\nb",\nbad,食費,100,m,\n'
+    rows, errors = import_rows(text)
+    assert [r.memo for r in rows] == ["a\nb"]
+    assert errors == [(4, "date")]
+
+
+def test_custom_mapping_without_memo() -> None:
+    m = {"date": "d", "category": "c", "amount": "a"}
+    rows, errors = import_rows("d,c,a\n2026/3/3,x,5\n", m)
+    assert rows == [Expense(date(2026, 3, 3), "x", 5, "")]
+    assert errors == []
+
+
+def test_mapping_errors() -> None:
+    with pytest.raises(ValueError):
+        import_rows(HEADER, {"date": "利用日", "category": "分類"})
+    with pytest.raises(ValueError):
+        import_rows("a,b\n", DEFAULT_MAPPING)
+    with pytest.raises(ValueError):
+        import_rows("")
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..a96033d
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,101 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def E(m: int, cat: str, amt: int, y: int = 2026) -> Expense:
+    return Expense(date(y, m, 10), cat, amt, "")
+
+
+ROWS = [
+    E(1, "food", 1000),
+    E(1, "food", 500),
+    E(2, "food", 1800),
+    E(1, "rent", 5000),
+    E(2, "rent", 5000),
+    E(1, "fun", 2000),
+    E(2, "new", 700),
+    E(3, "other", 1),
+]
+
+
+def test_month_diff() -> None:
+    got = month_diff(ROWS, "2026-01", "2026-02")
+    assert got == [
+        DiffRow("fun", 2000, 0, -2000, -100.0, "gone"),
+        DiffRow("new", 0, 700, 700, None, "new"),
+        DiffRow("food", 1500, 1800, 300, 20.0, "up"),
+        DiffRow("rent", 5000, 5000, 0, 0.0, "same"),
+    ]
+
+
+def test_status_by_presence_not_sum() -> None:
+    rows = [E(1, "a", 0), E(2, "a", 100), E(1, "b", 100), E(2, "b", -100)]
+    got = {d.category: d for d in month_diff(rows, "2026-01", "2026-02")}
+    assert got["a"].status == "up" and got["a"].pct is None
+    assert got["b"].status == "down" and got["b"].pct == -200.0
+
+
+def test_tie_order_by_category() -> None:
+    rows = [E(2, "b", 10), E(2, "a", 10)]
+    assert [d.category for d in month_diff(rows, "2026-01", "2026-02")] == ["a", "b"]
+
+
+@pytest.mark.parametrize("m", ["2026-1", "2026-13", "2026-00", "202601", "x"])
+def test_bad_month(m: str) -> None:
+    with pytest.raises(ValueError):
+        month_diff([], m, "2026-02")
+    with pytest.raises(ValueError):
+        month_diff([], "2026-01", m)
+
+
+def test_top_movers() -> None:
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    assert [d.category for d in top_movers(diffs)] == ["fun", "new", "food"]
+    assert [d.category for d in top_movers(diffs, 2)] == ["fun", "new"]
+    assert top_movers(diffs, 0) == []
+    with pytest.raises(ValueError):
+        top_movers(diffs, -1)
+
+
+def test_render() -> None:
+    out = render_diff(month_diff(ROWS, "2026-01", "2026-02"))
+    assert out == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "fun\t2000\t0\t-2000\t-100.0%\n"
+        "new\t0\t700\t+700\t-\n"
+        "food\t1500\t1800\t+300\t+20.0%\n"
+        "rent\t5000\t5000\t+0\t+0.0%"
+    )
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_render_negative_zero() -> None:
+    d = DiffRow("x", -5, -5, 0, -0.0, "same")
+    assert render_diff([d]).endswith("\t+0\t+0.0%")
+
+
+def test_months_and_latest() -> None:
+    assert available_months(ROWS + [E(1, "z", 1, y=2025)]) == [
+        "2025-01",
+        "2026-01",
+        "2026-02",
+        "2026-03",
+    ]
+    assert available_months([]) == []
+    got = latest_diff(ROWS)
+    assert {d.category for d in got} == {"other", "food", "rent", "new"}
+    with pytest.raises(ValueError):
+        latest_diff([E(1, "a", 1)])
+    with pytest.raises(ValueError):
+        latest_diff([])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..87c3c2d
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,94 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+ROWS = [
+    Expense(date(2026, 1, 1), "Food", 500, "Lunch at cafe"),
+    Expense(date(2026, 1, 2), "Transport", 200, "train (JR)"),
+    Expense(date(2026, 1, 3), "Food", 900, "dinner"),
+]
+
+
+def names(q: str) -> list[int]:
+    return [r.amount for r in filter_rows(q, ROWS)]
+
+
+def test_tokenize() -> None:
+    assert tokenize('a AND (b OR "c d") NOT cat:Food and') == [
+        ("TERM", "a"),
+        ("AND", "AND"),
+        ("LPAREN", "("),
+        ("TERM", "b"),
+        ("OR", "OR"),
+        ("TERM", "c d"),
+        ("RPAREN", ")"),
+        ("NOT", "NOT"),
+        ("CAT", "Food"),
+        ("TERM", "and"),
+    ]
+    assert tokenize('"AND"') == [("TERM", "AND")]
+    assert tokenize('"(x)"') == [("TERM", "(x)")]
+    assert tokenize("a(b") == [("TERM", "a"), ("LPAREN", "("), ("TERM", "b")]
+
+
+@pytest.mark.parametrize("q", ['"abc', '""', "cat:", "cat:  x"])
+def test_tokenize_errors(q: str) -> None:
+    with pytest.raises(QueryError):
+        tokenize(q)
+
+
+def test_eval_basics() -> None:
+    assert names("lunch") == [500]
+    assert names("cat:FOOD") == [500, 900]
+    assert names("cat:foo") == []
+    assert names("food dinner") == [900]
+    assert names("food AND dinner") == [900]
+    assert names("lunch OR train") == [500, 200]
+    assert names("NOT food") == [200]
+    assert names("NOT NOT food") == [500, 900]
+    assert names('"train (jr)"') == [200]
+
+
+def test_precedence() -> None:
+    # OR < AND: a OR b AND c == a OR (b AND c)
+    assert names("lunch OR food dinner") == [500, 900]
+    assert names("(lunch OR transport) food") == [500]
+    assert names("NOT lunch food") == [900]
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(a",
+        "a)",
+        "a AND",
+        "OR a",
+        "a OR",
+        "a AND OR b",
+        "NOT",
+        "a ( b",
+        ") a",
+    ],
+)
+def test_syntax_errors(q: str) -> None:
+    with pytest.raises(QueryError):
+        filter_rows(q, [])
+    with pytest.raises(QueryError):
+        matches(q, ROWS[0])
+
+
+def test_matches_and_error_type() -> None:
+    assert matches("cafe", ROWS[0])
+    assert not matches("cafe", ROWS[1])
+    assert issubclass(QueryError, ValueError)
+
+
+def test_deep_nesting_is_query_error() -> None:
+    with pytest.raises(QueryError):
+        filter_rows("(" * 5000 + "a" + ")" * 5000, [])
