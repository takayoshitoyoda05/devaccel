@@ -0,0 +1,207 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import (
+    CsvProfile,
+    import_bank_csv,
+    parse_amount,
+    parse_date,
+)
+from kakeibo.core import Expense
+
+CARD = CsvProfile(
+    date_col="利用日",
+    amount_col="利用金額",
+    category_col="区分",
+    memo_col="利用店名",
+)
+
+
+@pytest.mark.parametrize(
+    ("text", "yen"),
+    [
+        ("1200", 1200),
+        ("1,200", 1200),
+        ("¥1,200", 1200),
+        ("￥１，２００", 1200),
+        ("1200円", 1200),
+        (" 1,200 ", 1200),
+        ("-1,200", -1200),
+        ("▲1,200", -1200),
+        ("△1,200", -1200),
+        ("(1,200)", -1200),
+        ("+5", 5),
+        ("0", 0),
+    ],
+)
+def test_parse_amount_accepts_common_notations(text, yen):
+    assert parse_amount(text) == yen
+
+
+@pytest.mark.parametrize("text", ["", "   ", "1.5", "abc", "--1", "(1,200", "1,2,3.0"])
+def test_parse_amount_rejects_non_integers(text):
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026-11-01",
+        "2026/11/1",
+        "2026.11.1",
+        "20261101",
+        "2026年11月1日",
+        "２０２６/１１/０１",
+    ],
+)
+def test_parse_date_accepts_common_notations(text):
+    assert parse_date(text) == date(2026, 11, 1)
+
+
+def test_parse_date_values():
+    assert parse_date("2026/11/1") == date(2026, 11, 1)
+    assert parse_date("2026.1.5") == date(2026, 1, 5)
+    assert parse_date("２０２６年１１月０１日") == date(2026, 11, 1)
+
+
+@pytest.mark.parametrize("text", ["2026-02-30", "11/01/2026", "", "2026-13-01"])
+def test_parse_date_rejects_bad_dates(text):
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+def test_card_csv_negative_or_positive_expense_and_skips_refunds():
+    text = (
+        "利用日,利用金額,区分,利用店名\n"
+        '2026/11/01,"1,200",食費,ランチ\n'
+        "2026/11/02,-500,食費,返金\n"  # 負の値は返金扱い → skipped
+        "2026/11/03,800,,コーヒー\n"  # 区分が空 → default_category
+    )
+    result = import_bank_csv(text, CARD)
+    assert result.ok
+    assert result.expenses == [
+        Expense(date(2026, 11, 1), "食費", 1200, "ランチ"),
+        Expense(date(2026, 11, 3), "未分類", 800, "コーヒー"),
+    ]
+    assert result.skipped == [3]
+
+
+def test_negative_expense_style_and_bom_and_crlf():
+    profile = CsvProfile(date_col="Date", amount_col="Amount", expense_is_negative=True)
+    text = '﻿Date,Amount\r\n2026-11-01,"▲3,000"\r\n2026-11-02,1000\r\n'
+    result = import_bank_csv(text, profile)
+    assert result.ok
+    assert result.expenses == [Expense(date(2026, 11, 1), "未分類", 3000, "")]
+    assert result.skipped == [3]
+
+
+def test_unquoted_comma_in_amount_is_reported_not_silently_shifted():
+    profile = CsvProfile(date_col="Date", amount_col="Amount")
+    text = "Date,Amount\n2026-11-01,1,200\n2026-11-02,300\n"
+    result = import_bank_csv(text, profile)
+    assert [(e.line, e.column) for e in result.errors] == [(2, None)]
+    assert "引用符" in result.errors[0].reason
+    assert result.expenses == [Expense(date(2026, 11, 2), "未分類", 300, "")]
+
+
+def test_column_names_ignore_surrounding_spaces_and_full_width_space():
+    profile = CsvProfile(date_col="日付", amount_col="金額")
+    text = "日付 ,　金額\n2026-11-01, 300\n"
+    result = import_bank_csv(text, profile)
+    assert result.ok
+    assert result.expenses == [Expense(date(2026, 11, 1), "未分類", 300, "")]
+
+
+def test_errors_say_which_line_column_and_value():
+    text = (
+        "利用日,利用金額,区分,利用店名\n"
+        "2026-11-01,100,食費,ok\n"
+        "2026-02-30,100,食費,存在しない日\n"
+        "2026-11-02,abc,食費,金額が変\n"
+        "2026-11-03,,食費,金額なし\n"
+    )
+    result = import_bank_csv(text, CARD)
+    assert not result.ok
+    assert [(e.line, e.column, e.value) for e in result.errors] == [
+        (3, "利用日", "2026-02-30"),
+        (4, "利用金額", "abc"),
+        (5, "利用金額", ""),
+    ]
+    assert "存在しない日付" in result.errors[0].reason
+    assert "金額が整数ではありません" in result.errors[1].reason
+    assert str(result.errors[1]).startswith("4行目 [利用金額] 'abc': ")
+    # 不正行があっても正しい行は取り込まれる
+    assert result.expenses == [Expense(date(2026, 11, 1), "食費", 100, "ok")]
+
+
+def test_missing_required_column_is_reported_on_line_1_and_no_rows():
+    text = "日付,金額\n2026-11-01,100\n"
+    result = import_bank_csv(text, CARD)
+    assert result.expenses == []
+    assert [(e.line, e.column) for e in result.errors] == [
+        (1, "利用日"),
+        (1, "利用金額"),
+        (1, "区分"),
+        (1, "利用店名"),
+    ]
+
+
+def test_empty_input_is_an_error():
+    result = import_bank_csv("", CARD)
+    assert [e.line for e in result.errors] == [1]
+    assert not result.ok
+
+
+def test_blank_lines_are_ignored_and_not_counted():
+    text = "利用日,利用金額\n\n2026-11-01,100\n"
+    result = import_bank_csv(text, CsvProfile(date_col="利用日", amount_col="利用金額"))
+    assert result.ok
+    assert result.expenses == [Expense(date(2026, 11, 1), "未分類", 100, "")]
+    assert result.skipped == []
+
+
+def test_separate_withdrawal_and_deposit_columns():
+    profile = CsvProfile(
+        date_col="取引日",
+        withdrawal_col="出金",
+        deposit_col="入金",
+        memo_col="摘要",
+    )
+    text = (
+        "取引日,摘要,出金,入金\n"
+        '2026-11-01,スーパー,"2,980",\n'
+        "2026-11-02,給与,,300000\n"  # 入金のみ → skipped
+        "2026-11-03,両方,100,200\n"  # 両方に値 → error
+        "2026-11-04,空,,\n"  # 両方空 → error
+        "2026-11-05,マイナス,-5,\n"  # 出金欄が負 → error
+    )
+    result = import_bank_csv(text, profile)
+    assert result.expenses == [Expense(date(2026, 11, 1), "未分類", 2980, "スーパー")]
+    assert result.skipped == [3]
+    assert [e.line for e in result.errors] == [4, 5, 6]
+    assert result.errors[0].column == "出金"
+    assert "両方に値" in result.errors[0].reason
+    assert "出金も入金も空" in result.errors[1].reason
+    assert "1 以上" in result.errors[2].reason
+
+
+def test_invalid_profile_is_a_programming_error():
+    text = "利用日\n"
+    with pytest.raises(ValueError):
+        import_bank_csv(text, CsvProfile(date_col="利用日"))
+    with pytest.raises(ValueError):
+        import_bank_csv(
+            text, CsvProfile(date_col="利用日", amount_col="a", withdrawal_col="b")
+        )
+    with pytest.raises(ValueError):
+        import_bank_csv(
+            text, CsvProfile(date_col="利用日", amount_col="a", deposit_col="入金")
+        )
+
+
+def test_short_row_reports_missing_cells():
+    text = "利用日,利用金額,区分,利用店名\n2026-11-01\n"
+    result = import_bank_csv(text, CARD)
+    assert [(e.line, e.column) for e in result.errors] == [(2, "利用金額")]
