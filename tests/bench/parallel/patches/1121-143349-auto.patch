+from __future__ import annotations
+
+from datetime import date, datetime
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    And,
+    Cond,
+    Not,
+    Or,
+    all_of,
+    amount_between,
+    any_of,
+    between,
+    category,
+    memo_contains,
+    not_,
+    search,
+)
+
+R0 = Expense(date(2026, 11, 1), "食費", 1200, "スーパー ABC")
+R1 = Expense(date(2026, 11, 2), "食費", 300, "コンビニ")
+R2 = Expense(date(2026, 11, 3), "食費", 6000, "まとめ買い")
+R3 = Expense(date(2026, 11, 4), "交通費", 5000, "スーパー定期")
+R4 = Expense(date(2026, 11, 5), "食費", 100, "おやつ")
+R5 = Expense(date(2026, 11, 6), "食費", -800, "返金 スーパー")
+R6 = Expense(date(2026, 11, 7), "雑費", 50, "SUPER MARKET")
+ROWS = [R0, R1, R2, R3, R4, R5, R6]
+
+
+# 例の表(E3-*)
+@pytest.mark.parametrize(
+    ("query", "expected"),
+    [
+        pytest.param(any_of(), [], id="E3-1"),
+        pytest.param(
+            all_of(
+                category("食費"),
+                any_of(memo_contains("ｽｰﾊﾟｰ"), amount_between(5000, None)),
+            ),
+            [R0, R2, R5],
+            id="E3-2",
+        ),
+        pytest.param(amount_between(100, 100), [R4], id="E3-3"),
+    ],
+)
+def test_examples(query: object, expected: list[Expense]) -> None:
+    assert search(ROWS, query) == expected  # type: ignore[arg-type]
+
+
+# R1 category
+def test_category_ignores_case_width_and_surrounding_space() -> None:
+    assert search(ROWS, category("  ＦＯＯＤ ")) == []
+    rows = [Expense(date(2026, 1, 1), "Food", 1, "")]
+    assert search(rows, category("ｆｏｏｄ")) == rows
+    assert search(rows, category("　FOOD　")) == rows
+
+
+def test_category_matches_any_name() -> None:
+    assert search(ROWS, category("交通費", "雑費")) == [R3, R6]
+
+
+def test_category_without_names_is_value_error() -> None:
+    with pytest.raises(ValueError):
+        category()
+
+
+def test_category_non_str_is_type_error() -> None:
+    with pytest.raises(TypeError):
+        category(1)  # type: ignore[arg-type]
+
+
+# R2 amount_between
+def test_amount_between_none_is_unbounded() -> None:
+    assert search(ROWS, amount_between(None, None)) == ROWS
+    assert search(ROWS, amount_between(None, 100)) == [R4, R5, R6]
+    assert search(ROWS, amount_between(5000, None)) == [R2, R3]
+
+
+def test_amount_between_includes_both_ends() -> None:
+    assert search(ROWS, amount_between(300, 5000)) == [R0, R1, R3]
+
+
+def test_amount_between_accepts_negative_range_for_refunds() -> None:
+    assert search(ROWS, amount_between(-1000, -1)) == [R5]
+
+
+def test_amount_between_lo_greater_than_hi_is_value_error() -> None:
+    with pytest.raises(ValueError):
+        amount_between(10, 5)
+
+
+@pytest.mark.parametrize("bad", [True, False, 1.0])
+def test_amount_between_rejects_bool_and_float(bad: object) -> None:
+    with pytest.raises(TypeError):
+        amount_between(bad, None)  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        amount_between(None, bad)  # type: ignore[arg-type]
+
+
+# R3 memo_contains (D6)
+def test_memo_contains_empty_matches_everything() -> None:
+    assert search(ROWS, memo_contains("")) == ROWS
+
+
+def test_memo_contains_is_nfkc_and_case_insensitive() -> None:
+    assert search(ROWS, memo_contains("super")) == [R6]
+    assert search(ROWS, memo_contains("ｓｕｐｅｒ")) == [R6]
+    assert search(ROWS, memo_contains("ｽｰﾊﾟｰ")) == [R0, R3, R5]
+
+
+def test_memo_contains_non_str_is_type_error() -> None:
+    with pytest.raises(TypeError):
+        memo_contains(1)  # type: ignore[arg-type]
+
+
+# R4 between
+def test_between_includes_both_ends() -> None:
+    assert search(ROWS, between(date(2026, 11, 2), date(2026, 11, 4))) == [R1, R2, R3]
+
+
+def test_between_open_ends() -> None:
+    assert search(ROWS, between(date(2026, 11, 6), None)) == [R5, R6]
+    assert search(ROWS, between(None, date(2026, 11, 2))) == [R0, R1]
+
+
+def test_between_both_none_matches_everything() -> None:
+    assert search(ROWS, between(None, None)) == ROWS
+
+
+def test_between_start_after_end_is_value_error() -> None:
+    with pytest.raises(ValueError):
+        between(date(2026, 11, 5), date(2026, 11, 1))
+
+
+def test_between_rejects_non_date() -> None:
+    with pytest.raises(TypeError):
+        between("2026-11-01", None)  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        between(datetime(2026, 11, 1), None)  # type: ignore[arg-type]
+
+
+# R5 combinators
+def test_empty_all_of_is_true_and_empty_any_of_is_false() -> None:
+    assert search(ROWS, all_of()) == ROWS
+    assert search(ROWS, any_of()) == []
+
+
+def test_not_and_nesting() -> None:
+    assert search(ROWS, not_(category("食費"))) == [R3, R6]
+    assert search(ROWS, not_(not_(category("食費")))) == [R0, R1, R2, R4, R5]
+    nested = all_of(
+        category("食費"), not_(amount_between(0, None)), memo_contains("ス")
+    )
+    assert search(ROWS, nested) == [R5]
+
+
+def test_query_tree_types() -> None:
+    assert isinstance(all_of(), And)
+    assert isinstance(any_of(), Or)
+    assert isinstance(not_(all_of()), Not)
+    assert isinstance(category("食費"), Cond)
+
+
+def test_combinators_reject_non_query() -> None:
+    with pytest.raises(TypeError):
+        all_of("食費")  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        any_of(category("食費"), 1)  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        not_("食費")  # type: ignore[arg-type]
+
+
+# R6 order / duplicates / input type
+def test_result_keeps_input_order_and_duplicates() -> None:
+    rows = [R1, R0, R1]
+    assert search(rows, any_of(memo_contains(""))) == [R1, R0, R1]
+
+
+def test_search_rejects_non_query() -> None:
+    with pytest.raises(TypeError):
+        search(ROWS, "食費")  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        search(ROWS, category)  # type: ignore[arg-type]
