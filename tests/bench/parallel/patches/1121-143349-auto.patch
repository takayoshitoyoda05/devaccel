@@ -0,0 +1,108 @@
+"""Month-over-month comparison of expenses by category (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class Change:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    rate: float | None
+    status: str
+
+
+def _check_month(value: object, name: str) -> str:
+    if isinstance(value, bool) or not isinstance(value, str):
+        raise TypeError(f"{name} は str である必要があります")
+    if not _MONTH_RE.fullmatch(value):
+        raise ValueError(f"{name} は YYYY-MM 形式である必要があります: {value!r}")
+    return value
+
+
+def _prev_month(month: str) -> str:
+    year, mon = int(month[:4]), int(month[5:])
+    if mon == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mon - 1:02d}"
+
+
+def _totals(rows: list[Expense], month: str) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for e in rows:
+        if e.day.strftime("%Y-%m") == month:
+            out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def _status(previous: int, current: int, delta: int) -> str:
+    if previous == 0 and current != 0:
+        return "新規"
+    if previous != 0 and current == 0:
+        return "なくなった"
+    if delta > 0:
+        return "増"
+    if delta < 0:
+        return "減"
+    return "変化なし"
+
+
+def compare_months(
+    rows: list[Expense], month: str, previous: str | None = None
+) -> list[Change]:
+    """Compare category totals of `month` against `previous` (default: the calendar
+    month before `month`). Months with no rows count as all-zero."""
+    if isinstance(rows, bool) or not isinstance(rows, list):
+        raise TypeError("rows は list である必要があります")
+    _check_month(month, "month")
+    if previous is None:
+        previous = _prev_month(month)
+    else:
+        _check_month(previous, "previous")
+    if previous == month:
+        raise ValueError("previous と month は別の月である必要があります")
+
+    prev_totals = _totals(rows, previous)
+    cur_totals = _totals(rows, month)
+
+    changes: list[Change] = []
+    for cat in set(prev_totals) | set(cur_totals):
+        before = prev_totals.get(cat, 0)
+        after = cur_totals.get(cat, 0)
+        if before == 0 and after == 0:
+            continue
+        delta = after - before
+        rate = delta / before if before != 0 else None
+        changes.append(
+            Change(
+                category=cat,
+                previous=before,
+                current=after,
+                delta=delta,
+                rate=rate,
+                status=_status(before, after, delta),
+            )
+        )
+    changes.sort(key=lambda c: (-abs(c.delta), c.category))
+    return changes
+
+
+def format_report(changes: list[Change]) -> str:
+    """One line per category: `カテゴリ 前月→今月 (+増減円, +12.5%)`."""
+    if not changes:
+        return "変化なし"
+    lines: list[str] = []
+    for c in changes:
+        detail = f"{c.delta:+d}円"
+        if c.rate is not None:
+            detail += f", {c.rate * 100:+.1f}%"
+        lines.append(f"{c.category} {c.previous}→{c.current} ({detail})")
+    return "\n".join(lines)
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..f4a4e06
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,110 @@
+"""Detect recurring expenses (pure functions, standard library only)."""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from calendar import monthrange
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_TRAILING_RE = re.compile(r"[\d\W_]+$")
+_SPACE_RE = re.compile(r"\s+")
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int  # yen, median of the series
+    months: int
+    last_day: date
+    next_day: date
+
+
+def _normalize_memo(memo: str) -> str:
+    """NFKC, lowercase, collapse spaces, drop trailing digits/symbols (e.g. '#12', '2026/11')."""
+    s = unicodedata.normalize("NFKC", memo).lower().strip()
+    s = _SPACE_RE.sub(" ", s)
+    s = _TRAILING_RE.sub("", s)
+    return s.strip()
+
+
+def _median_low(values: list[int]) -> int:
+    s = sorted(values)
+    return s[(len(s) - 1) // 2]
+
+
+def _add_month(d: date) -> date:
+    """Same day-of-month in the next month; clamped to the month end."""
+    year = d.year + d.month // 12
+    month = d.month % 12 + 1
+    return date(year, month, min(d.day, monthrange(year, month)[1]))
+
+
+def _check_min_months(value: object) -> None:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"min_months は int である必要があります: {value!r}")
+    if value < 2:
+        raise ValueError(f"min_months は 2 以上である必要があります: {value}")
+
+
+def _split_runs(entries: list[tuple[int, Expense]]) -> list[list[tuple[int, Expense]]]:
+    """Split one (category, memo) group into contiguous-month runs with similar amounts.
+
+    entries: (month index, expense) ascending, one per month.
+    A run breaks on a missing month or an amount outside ±10 % of the run's median.
+    """
+    runs: list[list[tuple[int, Expense]]] = []
+    for idx, e in entries:
+        if runs:
+            cur = runs[-1]
+            med = _median_low([x.amount for _, x in cur])
+            if idx == cur[-1][0] + 1 and abs(e.amount - med) * 10 <= med:
+                cur.append((idx, e))
+                continue
+        runs.append([(idx, e)])
+    return runs
+
+
+def find_recurring(rows: list[Expense], min_months: int = 3) -> list[Recurring]:
+    _check_min_months(min_months)
+    for e in rows:
+        if not isinstance(e, Expense):
+            raise ValueError(f"Expense ではない要素があります: {e!r}")  # noqa: TRY004
+
+    # group key -> {month index: first expense of that month}
+    groups: dict[tuple[str, str], dict[int, Expense]] = {}
+    for e in sorted(rows, key=lambda x: x.day):  # stable: earliest day wins per month
+        if e.amount <= 0:  # 返金・入金(負)は無視
+            continue
+        key = (e.category, _normalize_memo(e.memo))
+        month_idx = e.day.year * 12 + e.day.month - 1
+        groups.setdefault(key, {}).setdefault(month_idx, e)
+
+    out: list[Recurring] = []
+    for (category, _norm), by_month in groups.items():
+        run = _split_runs(sorted(by_month.items()))[-1]  # most recent run
+        if len(run) < min_months:
+            continue
+        last = run[-1][1]
+        out.append(
+            Recurring(
+                category=category,
+                memo=last.memo,
+                amount=_median_low([x.amount for _, x in run]),
+                months=len(run),
+                last_day=last.day,
+                next_day=_add_month(last.day),
+            )
+        )
+    out.sort(key=lambda r: (r.next_day, -r.amount, r.category, r.memo))
+    return out
+
+
+def next_due(r: Recurring) -> date:
+    if not isinstance(r, Recurring):
+        raise ValueError(f"Recurring ではありません: {r!r}")  # noqa: TRY004
+    return _add_month(r.last_day)
