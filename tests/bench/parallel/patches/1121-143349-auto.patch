new file mode 100644
index 0000000..046e440
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,136 @@
+"""Filter expenses with composable, pure query conditions."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable
+from dataclasses import dataclass
+from datetime import date, datetime
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Cond:
+    """Leaf condition: a predicate on a single Expense."""
+
+    pred: Callable[[Expense], bool]
+
+
+@dataclass(frozen=True)
+class And:
+    items: tuple[Query, ...]
+
+
+@dataclass(frozen=True)
+class Or:
+    items: tuple[Query, ...]
+
+
+@dataclass(frozen=True)
+class Not:
+    item: Query
+
+
+Query = Cond | And | Or | Not
+
+_QUERY_TYPES = (Cond, And, Or, Not)
+
+
+def _check_query(q: object) -> None:
+    if not isinstance(q, _QUERY_TYPES):
+        raise TypeError(f"Query が必要です: {q!r}")
+
+
+def _check_int_or_none(x: object, name: str) -> None:
+    if x is None:
+        return
+    if isinstance(x, bool) or not isinstance(x, int):
+        raise TypeError(f"{name} は整数か None である必要があります: {x!r}")
+
+
+def _check_date_or_none(x: object, name: str) -> None:
+    if x is None:
+        return
+    if not isinstance(x, date) or isinstance(x, datetime):
+        raise TypeError(f"{name} は date か None である必要があります: {x!r}")
+
+
+def _category_key(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip().casefold()
+
+
+def _memo_key(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).casefold()
+
+
+def category(*names: str) -> Query:
+    if not names:
+        raise ValueError("カテゴリ名を 1 つ以上指定してください")
+    for n in names:
+        if not isinstance(n, str):
+            raise TypeError(f"カテゴリ名は str である必要があります: {n!r}")
+    keys = frozenset(_category_key(n) for n in names)
+    return Cond(lambda e: _category_key(e.category) in keys)
+
+
+def amount_between(lo: int | None, hi: int | None) -> Query:
+    _check_int_or_none(lo, "lo")
+    _check_int_or_none(hi, "hi")
+    if lo is not None and hi is not None and lo > hi:
+        raise ValueError(f"lo({lo}) > hi({hi})")
+    return Cond(
+        lambda e: (lo is None or e.amount >= lo) and (hi is None or e.amount <= hi)
+    )
+
+
+def memo_contains(text: str) -> Query:
+    if not isinstance(text, str):
+        raise TypeError(f"text は str である必要があります: {text!r}")
+    needle = _memo_key(text)
+    return Cond(lambda e: needle in _memo_key(e.memo))
+
+
+def between(start: date | None, end: date | None) -> Query:
+    _check_date_or_none(start, "start")
+    _check_date_or_none(end, "end")
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"start({start}) > end({end})")
+    return Cond(
+        lambda e: (start is None or e.day >= start) and (end is None or e.day <= end)
+    )
+
+
+def all_of(*qs: Query) -> Query:
+    for q in qs:
+        _check_query(q)
+    return And(tuple(qs))
+
+
+def any_of(*qs: Query) -> Query:
+    for q in qs:
+        _check_query(q)
+    return Or(tuple(qs))
+
+
+def not_(q: Query) -> Query:
+    _check_query(q)
+    return Not(q)
+
+
+def _matches(q: Query, e: Expense) -> bool:
+    if isinstance(q, Cond):
+        return q.pred(e)
+    if isinstance(q, And):
+        return all(_matches(i, e) for i in q.items)
+    if isinstance(q, Or):
+        return any(_matches(i, e) for i in q.items)
+    if isinstance(q, Not):
+        return not _matches(q.item, e)
+    raise TypeError(f"未知の Query です: {q!r}")
+
+
+def search(rows: list[Expense], query: Query) -> list[Expense]:
+    """Return the rows matching query, in input order (duplicates kept)."""
+    _check_query(query)
+    return [e for e in rows if _matches(query, e)]
