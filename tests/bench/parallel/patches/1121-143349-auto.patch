+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.compare import Change, compare_months, format_report
+from kakeibo.core import Expense
+
+
+def E(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+# --- 例の表 (E4-x) ---
+
+
+@pytest.mark.parametrize(
+    "case_id, rows, month, previous, expected",
+    [
+        pytest.param(
+            "E4-1",
+            [E("2026-01-10", "食費", 3000)],
+            "2026-02",
+            None,
+            [Change("食費", 3000, 0, -3000, -1.0, "なくなった")],
+            id="E4-1",
+        ),
+        pytest.param(
+            "E4-3",
+            [E("2026-02-05", "食費", 500)],
+            "2026-02",
+            None,
+            [Change("食費", 0, 500, 500, None, "新規")],
+            id="E4-3",
+        ),
+        pytest.param(
+            "E4-2",
+            [E("2025-12-03", "食費", 1000), E("2026-01-03", "食費", 1500)],
+            "2026-01",
+            None,
+            [Change("食費", 1000, 1500, 500, 0.5, "増")],
+            id="E4-2",
+        ),
+    ],
+)
+def test_example_table(case_id, rows, month, previous, expected):
+    assert compare_months(rows, month, previous) == expected
+
+
+# --- R1 月の形式 ---
+
+
+@pytest.mark.parametrize(
+    "bad", ["2026-1", "2026-13", "2026-00", "26-01", "2026/01", ""]
+)
+def test_R1_invalid_month_raises_value_error(bad):
+    with pytest.raises(ValueError):
+        compare_months([], bad)
+
+
+def test_R1_invalid_previous_raises_value_error():
+    with pytest.raises(ValueError):
+        compare_months([], "2026-02", "2026-1")
+
+
+def test_R1_january_previous_is_december_of_prior_year():
+    rows = [E("2025-12-31", "食費", 200), E("2026-01-01", "食費", 200)]
+    assert compare_months(rows, "2026-01") == [
+        Change("食費", 200, 200, 0, 0.0, "変化なし"),
+    ]
+
+
+# --- R2 status / 0 の扱い ---
+
+
+def test_R2_increase_and_decrease_status():
+    rows = [
+        E("2026-01-01", "食費", 1000),
+        E("2026-02-01", "食費", 1200),
+        E("2026-01-01", "交通費", 500),
+        E("2026-02-01", "交通費", 300),
+    ]
+    got = {c.category: c.status for c in compare_months(rows, "2026-02")}
+    assert got == {"食費": "増", "交通費": "減"}
+
+
+def test_R2_unchanged_status_when_both_nonzero_and_equal():
+    rows = [E("2026-01-01", "食費", 800), E("2026-02-01", "食費", 800)]
+    assert compare_months(rows, "2026-02")[0].status == "変化なし"
+
+
+def test_R2_category_zero_in_both_months_is_excluded():
+    rows = [E("2026-01-01", "食費", 100), E("2026-01-02", "食費", -100)]
+    assert compare_months(rows, "2026-02") == []
+
+
+def test_R2_negative_refund_counts_in_sum():
+    rows = [E("2026-01-01", "食費", 1000), E("2026-02-01", "食費", -400)]
+    assert compare_months(rows, "2026-02") == [
+        Change("食費", 1000, -400, -1400, -1.4, "減"),
+    ]
+
+
+# --- R3 rate ---
+
+
+def test_R3_rate_is_unrounded_fraction():
+    rows = [E("2026-01-01", "食費", 3), E("2026-02-01", "食費", 4)]
+    (c,) = compare_months(rows, "2026-02")
+    assert c.rate == pytest.approx(1 / 3)
+    assert c.rate == 1 / 3
+
+
+def test_R3_rate_none_when_previous_zero_no_division():
+    rows = [E("2026-02-01", "食費", 500)]
+    (c,) = compare_months(rows, "2026-02", "2026-01")
+    assert c.rate is None
+
+
+# --- R4 ordering ---
+
+
+def test_R4_sorted_by_abs_delta_desc_then_category_asc():
+    rows = [
+        E("2026-01-01", "B", 100),
+        E("2026-02-01", "B", 200),  # delta +100
+        E("2026-01-01", "A", 500),
+        E("2026-02-01", "A", 400),  # delta -100
+        E("2026-02-01", "C", 1000),  # delta +1000 (new)
+    ]
+    cats = [c.category for c in compare_months(rows, "2026-02")]
+    assert cats == ["C", "A", "B"]
+
+
+# --- R6 / 引数 ---
+
+
+def test_R6_empty_rows_returns_empty_list():
+    assert compare_months([], "2026-02") == []
+
+
+def test_R6_previous_equal_month_raises():
+    with pytest.raises(ValueError):
+        compare_months([], "2026-02", "2026-02")
+
+
+@pytest.mark.parametrize("bad", [True, 202602, None])
+def test_bool_and_non_str_month_raise_type_error(bad):
+    with pytest.raises(TypeError):
+        compare_months([], bad)  # type: ignore[arg-type]
+
+
+def test_bool_previous_raises_type_error():
+    with pytest.raises(TypeError):
+        compare_months([], "2026-02", True)  # type: ignore[arg-type]
+
+
+# --- R5 format_report ---
+
+
+def test_R5_report_line_with_rate():
+    changes = [Change("食費", 1000, 1125, 125, 0.125, "増")]
+    assert format_report(changes) == "食費 1000→1125 (+125円, +12.5%)"
+
+
+def test_R5_decrease_uses_minus_sign_and_rate_omitted_when_none():
+    changes = [
+        Change("食費", 3000, 0, -3000, -1.0, "なくなった"),
+        Change("外食", 0, 500, 500, None, "新規"),
+    ]
+    assert format_report(changes) == (
+        "食費 3000→0 (-3000円, -100.0%)\n外食 0→500 (+500円)"
+    )
+
+
+def test_R5_empty_changes_returns_no_change_text():
+    assert format_report([]) == "変化なし"
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..9d3bfd4
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,242 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, next_due
+
+
+def ex(y: int, m: int, d: int, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(date(y, m, d), category, amount, memo)
+
+
+# --- 例の表 (E1-1〜E1-3) ---
+
+
+@pytest.mark.parametrize(
+    ("case_id", "rows", "count", "next_day"),
+    [
+        (
+            "E1-1",
+            [
+                ex(2026, 1, 31, "住居", 80000, "家賃"),
+                ex(2026, 2, 28, "住居", 80000, "家賃"),
+                ex(2026, 3, 31, "住居", 80000, "家賃"),
+            ],
+            1,
+            date(2026, 4, 30),
+        ),
+        (
+            "E1-2",
+            [
+                ex(2026, 1, 5, "住居", 80000, "家賃A"),
+                ex(2026, 2, 5, "住居", 80000, "家賃A"),
+                ex(2026, 3, 5, "住居", 80000, "家賃A"),
+                ex(2026, 1, 20, "住居", 80000, "家賃B"),
+                ex(2026, 2, 20, "住居", 80000, "家賃B"),
+                ex(2026, 3, 20, "住居", 80000, "家賃B"),
+            ],
+            2,
+            None,
+        ),
+        (
+            "E1-3",
+            [
+                ex(2026, 1, 10, "通信", 3000, "ネット"),
+                ex(2026, 2, 10, "通信", 3000, "ネット"),
+                ex(2026, 4, 10, "通信", 3000, "ネット"),
+            ],
+            0,
+            None,
+        ),
+    ],
+    ids=["E1-1", "E1-2", "E1-3"],
+)
+def test_example_table(
+    case_id: str, rows: list[Expense], count: int, next_day: date | None
+) -> None:
+    result = find_recurring(rows)
+    assert len(result) == count
+    if next_day is not None:
+        assert result[0].next_day == next_day
+
+
+# --- 成立条件 (D4) ---
+
+
+def test_default_min_months_is_three() -> None:
+    rows = [ex(2026, m, 10, "通信", 3000, "ネット") for m in (1, 2)]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_months=2)) == 1
+
+
+def test_gap_uses_most_recent_run_only() -> None:
+    rows = [ex(2026, m, 10, "通信", 3000, "ネット") for m in (1, 2, 3, 5, 6, 7)]
+    (r,) = find_recurring(rows)
+    assert r.months == 3
+    assert r.last_day == date(2026, 7, 10)
+
+
+def test_latest_run_too_short_gives_nothing() -> None:
+    rows = [ex(2026, m, 10, "通信", 3000, "ネット") for m in (1, 2, 3, 5)]
+    assert find_recurring(rows) == []
+
+
+def test_same_month_twice_uses_first_entry() -> None:
+    rows = [
+        ex(2026, 1, 5, "住居", 80000, "家賃"),
+        ex(2026, 1, 20, "住居", 50000, "家賃"),
+        ex(2026, 2, 5, "住居", 80000, "家賃"),
+        ex(2026, 3, 5, "住居", 80000, "家賃"),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.months == 3
+    assert r.amount == 80000
+
+
+# --- 同一視 (D3) ---
+
+
+def test_memo_normalization_groups_variants() -> None:
+    rows = [
+        ex(2026, 1, 10, "通信", 3000, "Netflix #10"),
+        ex(2026, 2, 10, "通信", 3000, "netflix #11 "),
+        ex(2026, 3, 10, "通信", 3000, "ＮＥＴＦＬＩＸ　#12"),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.months == 3
+
+
+def test_different_category_is_separate_series() -> None:
+    rows = [
+        ex(2026, m, 10, c, 3000, "ネット") for c in ("通信", "娯楽") for m in (1, 2, 3)
+    ]
+    assert len(find_recurring(rows)) == 2
+
+
+def test_amount_within_ten_percent_is_same_series() -> None:
+    rows = [
+        ex(2026, 1, 10, "通信", 1000, "ネット"),
+        ex(2026, 2, 10, "通信", 1100, "ネット"),
+        ex(2026, 3, 10, "通信", 900, "ネット"),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.months == 3
+    assert r.amount == 1000
+
+
+def test_amount_jump_beyond_ten_percent_breaks_run() -> None:
+    rows = [
+        ex(2026, 1, 10, "通信", 1000, "ネット"),
+        ex(2026, 2, 10, "通信", 1000, "ネット"),
+        ex(2026, 3, 10, "通信", 1200, "ネット"),
+    ]
+    assert find_recurring(rows, min_months=2) == []
+
+
+def test_even_count_median_takes_lower_middle() -> None:
+    rows = [
+        ex(2026, 1, 10, "通信", 1000, "ネット"),
+        ex(2026, 2, 10, "通信", 1050, "ネット"),
+    ]
+    (r,) = find_recurring(rows, min_months=2)
+    assert r.amount == 1000
+
+
+# --- 金額の符号 (D1) と空入力 (R5) ---
+
+
+def test_empty_input() -> None:
+    assert find_recurring([]) == []
+
+
+def test_negative_amounts_are_ignored() -> None:
+    rows = [ex(2026, m, 10, "通信", 3000, "ネット") for m in (1, 2, 3)]
+    rows.append(ex(2026, 4, 10, "通信", -3000, "ネット"))
+    (r,) = find_recurring(rows)
+    assert r.months == 3
+    assert r.last_day == date(2026, 3, 10)
+
+
+def test_only_negative_amounts_gives_nothing() -> None:
+    rows = [ex(2026, m, 10, "通信", -3000, "返金") for m in (1, 2, 3)]
+    assert find_recurring(rows) == []
+
+
+# --- 次回日付 (R4) ---
+
+
+@pytest.mark.parametrize(
+    ("last", "expected"),
+    [
+        (date(2026, 12, 31), date(2027, 1, 31)),
+        (date(2026, 11, 30), date(2026, 12, 30)),
+        (date(2024, 1, 31), date(2024, 2, 29)),
+        (date(2025, 1, 31), date(2025, 2, 28)),
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2026, 3, 31), date(2026, 4, 30)),
+    ],
+)
+def test_next_due_month_arithmetic(last: date, expected: date) -> None:
+    r = Recurring("住居", "家賃", 80000, 3, last, date(1970, 1, 1))
+    assert next_due(r) == expected
+
+
+def test_year_rollover_in_find_recurring() -> None:
+    rows = [ex(2026, m, 15, "通信", 3000, "ネット") for m in (10, 11, 12)]
+    (r,) = find_recurring(rows)
+    assert r.next_day == date(2027, 1, 15)
+
+
+# --- 並び順 (R2) ---
+
+
+def test_sort_by_next_day_then_amount_desc_then_category_memo() -> None:
+    rows = [
+        ex(2026, 1, 20, "通信", 3000, "ネット"),
+        ex(2026, 2, 20, "通信", 3000, "ネット"),
+        ex(2026, 3, 20, "通信", 3000, "ネット"),
+        ex(2026, 1, 5, "娯楽", 500, "動画"),
+        ex(2026, 2, 5, "娯楽", 500, "動画"),
+        ex(2026, 3, 5, "娯楽", 500, "動画"),
+        ex(2026, 1, 5, "住居", 80000, "家賃"),
+        ex(2026, 2, 5, "住居", 80000, "家賃"),
+        ex(2026, 3, 5, "住居", 80000, "家賃"),
+    ]
+    result = find_recurring(rows)
+    assert [(r.category, r.next_day) for r in result] == [
+        ("住居", date(2026, 4, 5)),
+        ("娯楽", date(2026, 4, 5)),
+        ("通信", date(2026, 4, 20)),
+    ]
+
+
+def test_sort_same_next_day_by_amount_desc() -> None:
+    rows = []
+    for m in (1, 2, 3):
+        rows.append(ex(2026, m, 5, "娯楽", 500, "動画"))
+        rows.append(ex(2026, m, 5, "住居", 80000, "家賃"))
+    result = find_recurring(rows)
+    assert [r.category for r in result] == ["住居", "娯楽"]
+
+
+# --- 入力の検査 ---
+
+
+@pytest.mark.parametrize("bad", [True, False, 1.5, 3.0, "3"])
+def test_min_months_wrong_type_raises_type_error(bad: object) -> None:
+    with pytest.raises(TypeError, match="min_months"):
+        find_recurring([], min_months=bad)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad", [1, 0, -1])
+def test_min_months_below_two_raises_value_error(bad: int) -> None:
+    with pytest.raises(ValueError, match="min_months"):
+        find_recurring([], min_months=bad)
+
+
+def test_non_expense_element_raises_value_error() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([ex(2026, 1, 1, "住居", 1), "not an expense"])  # type: ignore[list-item]
