+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankcsv import parse_bank_csv
+from kakeibo.core import CsvError, Expense
+
+
+# E2-1: 単一金額列・全角英数・"1,234円" の引用
+def test_E2_1_single_amount_column() -> None:
+    text = '利用日,ご利用店名,利用金額\n2026/1/5,ＡＢＣ,"1,234円"\n'
+    assert parse_bank_csv(text) == [Expense(date(2026, 1, 5), "未分類", 1234, "ABC")]
+
+
+# E2-2: 出金/入金形式で入金だけの行はスキップ、他の行は返る
+def test_E2_2_deposit_only_row_is_skipped() -> None:
+    text = (
+        "日付,摘要,出金,入金\n"
+        "2026-01-05,スーパー,500,\n"
+        "2026-01-06,給与,,300000\n"
+        "2026-01-07,書店,200,\n"
+    )
+    assert parse_bank_csv(text) == [
+        Expense(date(2026, 1, 5), "未分類", 500, "スーパー"),
+        Expense(date(2026, 1, 7), "未分類", 200, "書店"),
+    ]
+
+
+# E2-3: 日付と小数の金額、どちらも同じ行番号で報告される
+def test_E2_3_all_errors_reported_with_line_number() -> None:
+    text = "日付,摘要,金額\n2026-01-05,A,100\n2026/2/30,B,12.5\n"
+    with pytest.raises(CsvError) as info:
+        parse_bank_csv(text)
+    errors = info.value.errors
+    assert [n for n, _ in errors] == [3, 3]
+    assert "日付" in errors[0][1] and "2026/2/30" in errors[0][1]
+    assert "金額" in errors[1][1] and "12.5" in errors[1][1]
+
+
+# R2: 金額の書き方
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        ("1234", 1234),
+        ("1,234", 1234),
+        ("1，２３４", 1234),
+        ("¥1,234", 1234),
+        ("￥1,234", 1234),
+        ("1,234円", 1234),
+        ("JPY 1234", 1234),
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+    ],
+)
+def test_amount_forms(raw: str, expected: int) -> None:
+    text = f'日付,金額\n2026-01-05,"{raw}"\n'
+    assert parse_bank_csv(text) == [Expense(date(2026, 1, 5), "未分類", expected, "")]
+
+
+@pytest.mark.parametrize("raw", ["12.5", "12.0", "", "-"])
+def test_amount_invalid_forms_are_row_errors(raw: str) -> None:
+    with pytest.raises(CsvError) as info:
+        parse_bank_csv(f'日付,金額\n2026-01-05,"{raw}"\n')
+    assert info.value.errors[0][0] == 2
+
+
+# R3: 日付の書き方
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026.1.5",
+        "2026年1月5日",
+        "20260105",
+        "2026-01-05 12:34:56",
+    ],
+)
+def test_date_forms(raw: str) -> None:
+    assert parse_bank_csv(f"日付,金額\n{raw},100\n") == [
+        Expense(date(2026, 1, 5), "未分類", 100, "")
+    ]
+
+
+@pytest.mark.parametrize("raw", ["2026/2/30", "令和8年1月5日"])
+def test_invalid_dates_are_row_errors(raw: str) -> None:
+    with pytest.raises(CsvError) as info:
+        parse_bank_csv(f"日付,金額\n{raw},100\n")
+    assert info.value.errors[0][0] == 2
+
+
+# R4: 列数の不足・過剰、空行は無視
+def test_column_count_mismatch_is_error() -> None:
+    with pytest.raises(CsvError) as info:
+        parse_bank_csv("日付,金額\n2026-01-05,100,余分\n2026-01-06\n")
+    assert [n for n, _ in info.value.errors] == [2, 3]
+
+
+def test_blank_lines_are_ignored() -> None:
+    text = "日付,金額\r\n\r\n2026-01-05,100\r\n\r\n"
+    assert parse_bank_csv(text) == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+# R5 / 空入力
+def test_missing_date_column_raises() -> None:
+    with pytest.raises(CsvError) as info:
+        parse_bank_csv("金額\n100\n")
+    assert info.value.errors[0][0] == 1
+
+
+def test_header_only_and_empty_return_empty_list() -> None:
+    assert parse_bank_csv("日付,金額\n") == []
+    assert parse_bank_csv("") == []
+
+
+def test_non_str_is_type_error() -> None:
+    with pytest.raises(TypeError):
+        parse_bank_csv(b"x")  # type: ignore[arg-type]
