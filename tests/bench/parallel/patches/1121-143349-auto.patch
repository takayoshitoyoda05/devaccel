@@ -0,0 +1,204 @@
+"""Bank / credit-card CSV import: text in, list[Expense] out (pure functions)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from datetime import date
+
+from kakeibo.core import CsvError, Expense
+
+_DATE_ALIASES = ("日付", "利用日", "取引日", "ご利用日", "date")
+_AMOUNT_ALIASES = ("金額", "利用金額", "ご利用金額", "amount")
+_WITHDRAW_ALIASES = ("出金", "出金額", "お支払金額", "支払")
+_DEPOSIT_ALIASES = ("入金", "入金額", "預入")
+_MEMO_ALIASES = (
+    "摘要",
+    "メモ",
+    "利用店名",
+    "ご利用店名",
+    "内容",
+    "description",
+    "memo",
+)
+_CATEGORY_ALIASES = ("カテゴリ", "category")
+_UNCATEGORIZED = "未分類"
+
+_DATE_PATTERNS = (
+    re.compile(r"([0-9]{4})[-/.]([0-9]{1,2})[-/.]([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日"),
+    re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})"),
+)
+# 日付の後ろに付く時刻(捨てる)。
+_TIME_TAIL = re.compile(
+    r"(?:[ T]+[0-9]{1,2}:[0-9]{2}(?::[0-9]{2}(?:\.[0-9]+)?)?"
+    r"|\s+[0-9]{1,2}時(?:[0-9]{1,2}分)?(?:[0-9]{1,2}秒)?)?"
+)
+
+
+def _nfkc(s: str) -> str:
+    return unicodedata.normalize("NFKC", s)
+
+
+def _key(s: str) -> str:
+    return _nfkc(s).strip().lower()
+
+
+def _is_blank(cells: list[str]) -> bool:
+    return len(cells) == 0 or (len(cells) == 1 and not cells[0].strip())
+
+
+def _find(keys: list[str], aliases: tuple[str, ...], role: str) -> int | None:
+    hits = [i for i, k in enumerate(keys) if k in aliases]
+    if len(hits) > 1:
+        raise ValueError(f"{role}に当たる列が複数あります: {hits}")
+    return hits[0] if hits else None
+
+
+def _parse_yen(raw: str) -> int:
+    """R2. Raises ValueError with a short reason on failure."""
+    s = _nfkc(raw).replace("−", "-")  # U+2212 MINUS SIGN is not changed by NFKC
+    s = re.sub(r"\s+", "", s)
+    s = re.sub(r"¥|円|JPY", "", s, flags=re.IGNORECASE)
+    s = s.replace(",", "")
+    if not s:
+        raise ValueError("金額が空欄です")
+    negative = False
+    if s[0] in "-△▲":
+        negative, s = True, s[1:]
+    elif s.startswith("(") and s.endswith(")"):
+        negative, s = True, s[1:-1]
+    elif s.endswith("-"):
+        negative, s = True, s[:-1]
+    if not re.fullmatch(r"[0-9]+", s):
+        raise ValueError("円の整数ではありません")
+    value = int(s)
+    return -value if negative else value
+
+
+def _parse_day(raw: str) -> date:
+    """R3. Raises ValueError with a short reason on failure."""
+    s = _nfkc(raw).strip()
+    for pat in _DATE_PATTERNS:
+        m = pat.match(s)
+        if m and _TIME_TAIL.fullmatch(s, m.end()):
+            try:
+                return date(int(m.group(1)), int(m.group(2)), int(m.group(3)))
+            except ValueError:
+                raise ValueError("存在しない日付です") from None
+    raise ValueError("日付の形式ではありません")
+
+
+def _bad(
+    line: int, label: str, header: list[str], idx: int, raw: str, why: str
+) -> tuple[int, str]:
+    return (line, f"{label}列 {header[idx]!r} が不正です: {raw!r}({why})")
+
+
+def parse_bank_csv(text: str) -> list[Expense]:
+    if not isinstance(text, str):
+        raise TypeError("text は str である必要があります")
+    text = text.removeprefix("﻿")
+    head = re.split(r"\r\n|\r|\n", text, maxsplit=1)[0]
+    delimiter = "\t" if "\t" in head else ","
+
+    records: list[tuple[int, list[str]]] = []
+    start = 1
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delimiter)
+    try:
+        for cells in reader:
+            if not _is_blank(cells):
+                records.append((start, cells))
+            start = reader.line_num + 1
+    except csv.Error as e:
+        raise CsvError([(start, f"CSV として読めません: {e}")]) from None
+    if not records:
+        return []
+
+    _, header = records[0]
+    keys = [_key(c) for c in header]
+    date_i = _find(keys, _DATE_ALIASES, "日付")
+    amount_i = _find(keys, _AMOUNT_ALIASES, "金額")
+    withdraw_i = _find(keys, _WITHDRAW_ALIASES, "出金")
+    deposit_i = _find(keys, _DEPOSIT_ALIASES, "入金")
+    memo_i = _find(keys, _MEMO_ALIASES, "メモ")
+    category_i = _find(keys, _CATEGORY_ALIASES, "カテゴリ")
+
+    missing: list[str] = []
+    if date_i is None:
+        missing.append("日付")
+    if amount_i is None and withdraw_i is None:
+        missing.append("金額・出金")
+    if missing:
+        raise CsvError(
+            [(1, f"{'・'.join(missing)}列がありません(ヘッダー: {header!r})")]
+        )
+
+    # 金額列があれば単一金額列の形式。無ければ出金/入金の 2 列形式。
+    amount_col: int | None = amount_i
+    withdraw_col: int | None = withdraw_i
+
+    out: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    for line, cells in records[1:]:
+        if len(cells) != len(header):
+            errors.append(
+                (
+                    line,
+                    f"列数が合いません: ヘッダー {len(header)} 列, 行 {len(cells)} 列",
+                )
+            )
+            continue
+
+        day: date | None = None
+        if date_i is not None:
+            try:
+                day = _parse_day(cells[date_i])
+            except ValueError as e:
+                errors.append(_bad(line, "日付", header, date_i, cells[date_i], str(e)))
+
+        amount: int | None = None
+        skip = False
+        if amount_col is not None:
+            raw = cells[amount_col]
+            try:
+                amount = _parse_yen(raw)
+            except ValueError as e:
+                errors.append(_bad(line, "金額", header, amount_col, raw, str(e)))
+        elif withdraw_col is not None:
+            raw = cells[withdraw_col]
+            deposit = cells[deposit_i] if deposit_i is not None else ""
+            if raw.strip() == "" and deposit.strip() != "":
+                # D5: 入金だけの行はスキップ。入金列の値だけは検査する。
+                skip = True
+                if deposit_i is not None:
+                    try:
+                        _parse_yen(deposit)
+                    except ValueError as e:
+                        errors.append(
+                            _bad(line, "入金", header, deposit_i, deposit, str(e))
+                        )
+            else:
+                try:
+                    amount = _parse_yen(raw)
+                except ValueError as e:
+                    errors.append(_bad(line, "出金", header, withdraw_col, raw, str(e)))
+
+        if day is None or amount is None or skip:
+            continue
+        memo = _nfkc(cells[memo_i]).strip() if memo_i is not None else ""
+        category = _nfkc(cells[category_i]).strip() if category_i is not None else ""
+        out.append(
+            Expense(
+                day=day,
+                category=category or _UNCATEGORIZED,
+                amount=amount,
+                memo=memo,
+            )
+        )
+
+    if errors:
+        raise CsvError(errors)
+    return out
