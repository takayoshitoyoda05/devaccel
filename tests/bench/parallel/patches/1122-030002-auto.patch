diff --git a/tests/test_types/test_Choice.py b/tests/test_types/test_Choice.py
index c34f516..781783c 100644
--- a/tests/test_types/test_Choice.py
+++ b/tests/test_types/test_Choice.py
@@ -1,7 +1,54 @@
+import pytest
+
 import click
+from click.testing import CliRunner
 
 
 def test_choice_get_invalid_choice_message():
     choice = click.Choice(["a", "b", "c"])
     message = choice.get_invalid_choice_message("d", ctx=None)
     assert message == "'d' is not one of 'a', 'b', 'c'."
+
+
+@pytest.mark.parametrize(
+    ("value", "suggestion"),
+    [
+        ("pause", "Did you mean 'push'?"),
+        ("decline", "(Did you mean one of: 'declare', 'refine'?)"),
+    ],
+)
+def test_choice_invalid_choice_suggests_close_matches(value, suggestion):
+    choice = click.Choice(["push", "pull", "declare", "refine", "status"])
+    message = choice.get_invalid_choice_message(value, ctx=None)
+    assert message.endswith(suggestion)
+
+
+def test_choice_invalid_choice_no_suggestion_when_far():
+    choice = click.Choice(["foo", "bar", "baz"])
+    message = choice.get_invalid_choice_message("meh", ctx=None)
+    assert "Did you mean" not in message
+
+
+def test_choice_invalid_choice_suggestion_is_case_insensitive():
+    choice = click.Choice(["Apple", "Banana"], case_sensitive=False)
+    message = choice.get_invalid_choice_message("Appel", ctx=None)
+    assert message.endswith("Did you mean 'apple'?")
+
+
+def test_choice_invalid_choice_suggestion_non_string_value():
+    choice = click.Choice(["10", "20"])
+    message = choice.get_invalid_choice_message(101, ctx=None)
+    assert message.endswith("Did you mean '10'?")
+
+
+def test_choice_invalid_choice_suggestion_cli():
+    @click.command()
+    @click.option("--mode", type=click.Choice(["release", "debug"]))
+    def cli(mode):
+        pass
+
+    result = CliRunner().invoke(cli, ["--mode", "releas"])
+    assert result.exit_code == 2
+    assert "'releas' is not one of 'release', 'debug'. Did you mean 'release'?" in (
+        result.output
+    )
