+def test_gap_exactly_at_tolerance_is_connected():
+    # Expected 2026-02-10; actual 2026-02-13 is 3 days off (== tolerance).
+    rows = [
+        _e(date(2026, 1, 10)),
+        _e(date(2026, 2, 13)),
+        _e(date(2026, 3, 13)),
+    ]
+    assert len(find_recurring(rows)) == 1
