+
+def test_break_splits_into_separate_recurring_entries():
+    # Two runs of three, separated by a gap larger than tolerance.
+    rows = [
+        _e(date(2026, 1, 10)),
+        _e(date(2026, 2, 10)),
+        _e(date(2026, 3, 10)),
+        # 2026-04 missing; next is 2026-06 (far from expected 2026-04-10)
+        _e(date(2026, 6, 10)),
+        _e(date(2026, 7, 10)),
+        _e(date(2026, 8, 10)),
+    ]
+    results = find_recurring(rows)
+    assert [r.days[0] for r in results] == [date(2026, 1, 10), date(2026, 6, 10)]
+    assert results[0].days == (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10))
+    assert results[1].days == (date(2026, 6, 10), date(2026, 7, 10), date(2026, 8, 10))
