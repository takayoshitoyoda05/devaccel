+
+def test_results_sorted_by_category_then_amount_then_first_day():
+    rows = []
+    specs = [
+        ("b", 500, date(2026, 1, 1)),
+        ("a", 900, date(2026, 1, 2)),
+        ("a", 300, date(2026, 1, 3)),
+    ]
+    for cat, amt, start in specs:
+        for k in range(3):
+            y, m = start.year, start.month + k
+            rows.append(_e(date(y, m, start.day), category=cat, amount=amt))
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [
+        ("a", 300),
+        ("a", 900),
+        ("b", 500),
+    ]
+
+
+def test_results_same_group_sorted_by_first_day():
+    rows = [
+        _e(date(2026, 7, 10)),
+        _e(date(2026, 8, 10)),
+        _e(date(2026, 9, 10)),
+        _e(date(2026, 1, 5)),
+        _e(date(2026, 2, 5)),
+        _e(date(2026, 3, 5)),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 5), date(2026, 7, 10)]
