index 0000000..aa759e7
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,91 @@
+"""Import CSV exports from other banks / card issuers."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"(-?)[¥￥]?([0-9][0-9,]*)円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額が不正です: {s!r}")
+    return int(m.group(1) + m.group(2).replace(",", ""))
+
+
+def parse_date(s: str) -> date:
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付が不正です: {s!r}")
+    return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    mp = DEFAULT_MAPPING if mapping is None else mapping
+    for key in ("date", "category", "amount"):
+        if key not in mp:
+            raise ValueError(f"mapping に {key} がありません")
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header = next(reader, None)
+    if header is None:
+        raise ValueError("ヘッダーがありません")
+    idx: dict[str, int] = {}
+    for field, col in mp.items():
+        if field not in ("date", "category", "amount", "memo"):
+            continue
+        if col not in header:
+            raise ValueError(f"列 {col} がヘッダーにありません")
+        idx[field] = header.index(col)
+    cmap = category_map or {}
+    rows: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    prev = reader.line_num
+    for rec in reader:
+        lineno = prev + 1
+        prev = reader.line_num
+        if not rec:
+            continue
+
+        def get(field: str, rec: list[str] = rec) -> str:
+            i = idx.get(field)
+            if i is None or i >= len(rec):
+                return ""
+            return rec[i]
+
+        bad: list[str] = []
+        day = None
+        amount = 0
+        try:
+            day = parse_date(get("date"))
+        except ValueError:
+            bad.append("date")
+        try:
+            amount = parse_amount(get("amount"))
+        except ValueError:
+            bad.append("amount")
+        cat = get("category").strip()
+        if not cat:
+            bad.append("category")
+        if bad or day is None:
+            errors.extend((lineno, f) for f in bad)
+            continue
+        rows.append(Expense(day, cmap.get(cat, cat), amount, get("memo").strip()))
+    return rows, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
new file mode 100644
