index 0000000..a170135
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,232 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def _e(day: date, category: str = "subscription", amount: int = 1000, memo: str = ""):
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- add_month ---------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("given", "expected"),
+    [
+        (date(2026, 1, 15), date(2026, 2, 15)),
+        (date(2026, 1, 31), date(2026, 2, 28)),  # 翌月末日に丸める
+        (date(2024, 1, 31), date(2024, 2, 29)),  # うるう年の 2 月
+        (date(2026, 12, 15), date(2027, 1, 15)),  # 年またぎ
+        (date(2026, 12, 31), date(2027, 1, 31)),  # 年またぎ・末日はそのまま
+        (date(2026, 3, 31), date(2026, 4, 30)),  # 30 日までの月へ丸める
+    ],
+)
+def test_add_month(given, expected):
+    assert add_month(given) == expected
+
+
+# --- find_recurring: 引数の検証 ----------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("kwargs", "message_part"),
+    [
+        ({"min_count": 1}, "min_count"),
+        ({"min_count": 0}, "min_count"),
+        ({"tolerance": -1}, "tolerance"),
+    ],
+)
+def test_invalid_arguments_raise_value_error(kwargs, message_part):
+    with pytest.raises(ValueError):
+        find_recurring([], **kwargs)
+
+
+# --- find_recurring: 基本 ------------------------------------------------------
+
+
+def test_empty_input_returns_empty_list():
+    assert find_recurring([]) == []
+
+
+def test_monthly_series_is_detected_with_next_expected():
+    rows = [_e(date(2026, 1, 5)), _e(date(2026, 2, 5)), _e(date(2026, 3, 5))]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="subscription",
+            amount=1000,
+            days=(date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+            next_expected=date(2026, 4, 5),
+        )
+    ]
+
+
+def test_fewer_than_min_count_is_not_recurring():
+    rows = [_e(date(2026, 1, 5)), _e(date(2026, 2, 5))]
+    assert find_recurring(rows) == []
+
+
+def test_exactly_min_count_is_recurring():
+    rows = [_e(date(2026, 1, 5)), _e(date(2026, 2, 5)), _e(date(2026, 3, 5))]
+    assert len(find_recurring(rows, min_count=3)) == 1
+
+
+def test_min_count_two_detects_pairs():
+    rows = [_e(date(2026, 1, 5)), _e(date(2026, 2, 5))]
+    result = find_recurring(rows, min_count=2)
+    assert [r.days for r in result] == [(date(2026, 1, 5), date(2026, 2, 5))]
+
+
+def test_memo_is_ignored_when_grouping():
+    rows = [
+        _e(date(2026, 1, 5), memo="a"),
+        _e(date(2026, 2, 5), memo="b"),
+        _e(date(2026, 3, 5), memo=""),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_different_amounts_are_grouped_separately():
+    rows = [
+        _e(date(2026, 1, 5), amount=1000),
+        _e(date(2026, 2, 5), amount=1000),
+        _e(date(2026, 3, 5), amount=2000),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_different_categories_are_grouped_separately():
+    rows = [
+        _e(date(2026, 1, 5), category="a"),
+        _e(date(2026, 2, 5), category="b"),
+        _e(date(2026, 3, 5), category="a"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_duplicate_dates_are_collapsed():
+    rows = [
+        _e(date(2026, 1, 5)),
+        _e(date(2026, 1, 5)),
+        _e(date(2026, 2, 5)),
+        _e(date(2026, 3, 5)),
+    ]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_unordered_input_yields_ascending_days():
+    rows = [_e(date(2026, 3, 5)), _e(date(2026, 1, 5)), _e(date(2026, 2, 5))]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+# --- find_recurring: 許容誤差 --------------------------------------------------
+
+
+def test_tolerance_boundary_connects_when_equal():
+    # 2026-01-05 の翌月予定は 2026-02-05。+3 日ずれても tolerance=3 ならつながる
+    rows = [_e(date(2026, 1, 5)), _e(date(2026, 2, 8)), _e(date(2026, 3, 8))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+
+
+def test_tolerance_boundary_splits_when_exceeded():
+    # +4 日ずれは tolerance=3 を超えるのでつながらない
+    rows = [_e(date(2026, 1, 5)), _e(date(2026, 2, 9)), _e(date(2026, 3, 9))]
+    assert find_recurring(rows, tolerance=3) == []
+
+
+def test_early_drift_within_tolerance_connects():
+    rows = [_e(date(2026, 1, 5)), _e(date(2026, 2, 2)), _e(date(2026, 3, 2))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+
+
+def test_zero_tolerance_requires_exact_day():
+    rows = [_e(date(2026, 1, 5)), _e(date(2026, 2, 6)), _e(date(2026, 3, 6))]
+    assert find_recurring(rows, tolerance=0) == []
+
+
+def test_month_end_expectation_uses_clamped_day():
+    # 1/31 の翌月予定は 2/28。2/28 はつながる
+    rows = [_e(date(2026, 1, 31)), _e(date(2026, 2, 28)), _e(date(2026, 3, 28))]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 28)
+
+
+# --- find_recurring: 区間の分割 -------------------------------------------------
+
+
+def test_gap_splits_run_and_short_piece_is_dropped():
+    # 1〜3 月は連続、6 月は切れている。6 月単独は min_count=3 未満
+    rows = [
+        _e(date(2026, 1, 5)),
+        _e(date(2026, 2, 5)),
+        _e(date(2026, 3, 5)),
+        _e(date(2026, 6, 5)),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_two_long_runs_produce_two_results():
+    rows = [
+        _e(date(2026, 1, 5)),
+        _e(date(2026, 2, 5)),
+        _e(date(2026, 3, 5)),
+        _e(date(2026, 7, 10)),
+        _e(date(2026, 8, 10)),
+        _e(date(2026, 9, 10)),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 5), date(2026, 7, 10)]
+    assert result[1].next_expected == date(2026, 10, 10)
+
+
+def test_run_is_split_not_merged_when_middle_breaks():
+    # 連続性は隣どうしで判定する。1→2 はつながり、2→5 で切れる
+    rows = [
+        _e(date(2026, 1, 5)),
+        _e(date(2026, 2, 5)),
+        _e(date(2026, 4, 5)),
+        _e(date(2026, 5, 5)),
+    ]
+    assert find_recurring(rows) == []
+
+
+# --- find_recurring: 結果の並び順 -----------------------------------------------
