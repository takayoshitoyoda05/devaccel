index 0000000..0db0c15
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,263 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+ROWS = [
+    Expense(date(2026, 1, 5), "food", 1200, "lunch with Ann"),
+    Expense(date(2026, 1, 6), "transport", 300, "bus"),
+    Expense(date(2026, 1, 7), "Food", 800, "dinner"),
+    Expense(date(2026, 1, 8), "rent", 90000, ""),
+    Expense(date(2026, 1, 9), "books", 2000, "bus pass guide"),
+]
+
+
+# --- tokenize ---------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("q", "expected"),
+    [
+        ("", []),
+        ("   \t ", []),
+        ("(", [("LPAREN", "(")]),
+        (")", [("RPAREN", ")")]),
+        ("a b", [("TERM", "a"), ("TERM", "b")]),
+        ('"hello world"', [("TERM", "hello world")]),
+        ('"(x)"', [("TERM", "(x)")]),
+        ('"a and b"', [("TERM", "a and b")]),
+        ("AND", [("AND", "AND")]),
+        ("OR", [("OR", "OR")]),
+        ("NOT", [("NOT", "NOT")]),
+        ("and", [("TERM", "and")]),
+        ("or", [("TERM", "or")]),
+        ("not", [("TERM", "not")]),
+        ("And", [("TERM", "And")]),
+        ("cat:food", [("CAT", "food")]),
+        ("cat:AND", [("CAT", "AND")]),
+        ("(a)", [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]),
+        ('x"y z"', [("TERM", "x"), ("TERM", "y z")]),
+        ("a-b_c", [("TERM", "a-b_c")]),
+        ("cat:", None),  # cat: の後ろが空
+        ('"abc', None),  # 閉じていない引用
+        ('""', None),  # 空の引用
+        ('"   "', [("TERM", "   ")]),  # 空白だけの引用は中身が空ではない
+    ],
+)
+def test_tokenize(q: str, expected: list[tuple[str, str]] | None) -> None:
+    if expected is None:
+        with pytest.raises(QueryError):
+            tokenize(q)
+    else:
+        assert tokenize(q) == expected
+
+
+# --- parsing errors (文法に合わない) -----------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "()",
+        "(",
+        ")",
+        "a)",
+        "(a",
+        "((a)",
+        "a OR",
+        "OR a",
+        "AND",
+        "a AND",
+        "AND a",
+        "a AND AND b",
+        "a OR OR b",
+        "NOT",
+        "a NOT",
+        "NOT )",
+        "a ( ",
+        "a (OR b)",
+        "a OR (AND)",
+    ],
+)
+def test_invalid_queries_raise(q: str) -> None:
+    with pytest.raises(QueryError):
+        matches(q, ROWS[0])
+    with pytest.raises(QueryError):
+        filter_rows(q, ROWS)
+
+
+def test_empty_query_raises_even_with_no_rows() -> None:
+    with pytest.raises(QueryError):
+        filter_rows("", [])
+
+
+def test_invalid_query_raises_even_with_no_rows() -> None:
+    with pytest.raises(QueryError):
+        filter_rows("a AND", [])
+
+
+def test_query_error_is_value_error() -> None:
+    assert issubclass(QueryError, ValueError)
+
+
+# --- evaluation -------------------------------------------------------------
+
+
+def test_term_matches_memo_substring() -> None:
+    assert [e.memo for e in filter_rows("lunch", ROWS)] == ["lunch with Ann"]
+
+
+def test_term_matches_category_substring() -> None:
+    cats = [e.category for e in filter_rows("ood", ROWS)]
+    assert cats == ["food", "Food"]
+
+
+def test_term_is_case_insensitive() -> None:
+    assert len(filter_rows("LUNCH", ROWS)) == 1
+    assert len(filter_rows("food", ROWS)) == 2  # "food" と "Food"
+
+
+def test_term_casefold_handles_sharp_s() -> None:
+    e = Expense(date(2026, 1, 1), "x", 1, "straße")
+    assert matches("STRASSE", e)
+
+
+def test_term_does_not_match_amount_or_date() -> None:
+    assert not matches("1200", ROWS[0])
+    assert not matches("2026", ROWS[0])
+
+
+def test_term_empty_memo_only_matches_category() -> None:
+    assert matches("rent", ROWS[3])
+    assert not matches("x", ROWS[3])
+
+
+def test_cat_requires_exact_category_match() -> None:
+    assert [e.category for e in filter_rows("cat:food", ROWS)] == ["food", "Food"]
+    assert filter_rows("cat:foo", ROWS) == []
+    assert filter_rows("cat:ood", ROWS) == []
+
+
+def test_cat_does_not_match_memo() -> None:
+    assert filter_rows("cat:lunch", ROWS) == []
+    assert filter_rows("cat:bus", ROWS) == []
+
+
+def test_cat_is_case_insensitive() -> None:
+    assert len(filter_rows("cat:FOOD", ROWS)) == 2
+
+
+def test_cat_value_stops_at_space() -> None:
+    e = Expense(date(2026, 1, 1), "eating out", 1, "")
+    assert matches("cat:eating out", e) is False  # 空白で切れ、CAT eating AND TERM out
+    assert matches("cat:eating", e) is False
+    assert matches("out", e)
+
+
+def test_cat_value_stops_at_quote() -> None:
+    with pytest.raises(QueryError):  # cat: の後ろが空になる
+        filter_rows('cat:"eating out"', ROWS)
+
+
+def test_implicit_and_between_terms() -> None:
+    assert [e.memo for e in filter_rows("bus pass", ROWS)] == ["bus pass guide"]
+
+
+def test_explicit_and() -> None:
+    assert [e.memo for e in filter_rows("bus AND pass", ROWS)] == ["bus pass guide"]
+
+
+def test_or() -> None:
+    got = [e.memo for e in filter_rows("lunch OR dinner", ROWS)]
+    assert got == ["lunch with Ann", "dinner"]
+
+
+def test_not() -> None:
+    got = [e.memo for e in filter_rows("bus NOT pass", ROWS)]
+    assert got == ["bus"]
+
+
+def test_not_binds_tighter_than_and() -> None:
+    # (NOT bus) AND food
+    got = filter_rows("NOT bus food", ROWS)
+    assert [e.memo for e in got] == ["lunch with Ann", "dinner"]
+
+
+def test_and_binds_tighter_than_or() -> None:
+    # lunch OR (dinner AND food)
+    got = filter_rows("lunch OR dinner food", ROWS)
+    assert [e.memo for e in got] == ["lunch with Ann", "dinner"]
+    # (lunch AND rent) OR bus -> bus を含む 2 件 (AND 側は 0 件)
+    got2 = filter_rows("lunch rent OR bus", ROWS)
+    assert [e.memo for e in got2] == ["bus", "bus pass guide"]
+
+
+def test_or_is_lower_than_and_regardless_of_order() -> None:
+    # a OR b AND c == a OR (b AND c)
+    got = filter_rows("rent OR bus pass", ROWS)
+    assert [e.memo for e in got] == ["", "bus pass guide"]
+
+
+def test_parentheses_override_precedence() -> None:
+    # (lunch OR bus) food -> lunch(food) のみ (bus は transport)
+    got = filter_rows("(lunch OR bus) food", ROWS)
+    assert [e.memo for e in got] == ["lunch with Ann"]
+
+
+def test_nested_not_and_double_not() -> None:
+    assert filter_rows("NOT NOT rent", ROWS) == [ROWS[3]]
+    assert len(filter_rows("NOT (food OR transport)", ROWS)) == 2
+
+
+def test_not_with_parentheses() -> None:
+    got = filter_rows("NOT (bus OR lunch OR dinner)", ROWS)
+    assert [e.category for e in got] == ["rent"]
+
+
+def test_quoted_term_with_spaces_and_parens() -> None:
+    e = Expense(date(2026, 1, 1), "misc", 1, "a (b) c")
+    assert matches('"a (b) c"', e)
+    assert matches('"(b)"', e)
+    assert not matches('"(c"', e)
+
+
+def test_quoted_operator_words_are_terms() -> None:
+    e = Expense(date(2026, 1, 1), "misc", 1, "rock AND roll")
+    assert matches('"AND"', e)
+    assert matches('"rock AND roll"', e)
+
+
+def test_lowercase_operators_are_terms() -> None:
+    e = Expense(date(2026, 1, 1), "misc", 1, "a and b or not")
+    assert matches("and", e)
+    assert matches("or", e)
+    assert matches("not", e)
+
+
+def test_matches_single_row() -> None:
+    assert matches("cat:food OR rent", ROWS[3]) is True
+    assert matches("cat:food", ROWS[1]) is False
+
+
+# --- filter_rows ------------------------------------------------------------
+
+
+def test_filter_rows_keeps_input_order() -> None:
+    got = filter_rows("food OR bus", ROWS)
+    assert got == [ROWS[0], ROWS[1], ROWS[2], ROWS[4]]
+
+
+def test_filter_rows_empty_input() -> None:
+    assert filter_rows("food", []) == []
+
+
+def test_filter_rows_no_match() -> None:
+    assert filter_rows("zzz", ROWS) == []
+
+
+def test_filter_rows_returns_new_list() -> None:
+    out = filter_rows("food OR rent OR bus OR books", ROWS)
+    assert out == ROWS
+    assert out is not ROWS
