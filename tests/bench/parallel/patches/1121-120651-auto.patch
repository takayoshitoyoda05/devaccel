--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,91 @@
+"""Month-over-month category diff report (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not isinstance(month, str) or not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def _month_data(rows: list[Expense], month: str) -> tuple[dict[str, int], set[str]]:
+    """Return ({category: total}, {categories that have at least one row}) for a month."""
+    totals: dict[str, int] = {}
+    cats: set[str] = set()
+    for e in rows:
+        if e.day.strftime("%Y-%m") != month:
+            continue
+        cats.add(e.category)
+        totals[e.category] = totals.get(e.category, 0) + e.amount
+    return totals, cats
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+    prev_totals, prev_cats = _month_data(rows, prev_month)
+    curr_totals, curr_cats = _month_data(rows, curr_month)
+
+    out: list[DiffRow] = []
+    for cat in prev_cats | curr_cats:
+        prev = prev_totals.get(cat, 0)
+        curr = curr_totals.get(cat, 0)
+        delta = curr - prev
+        # +0.0 normalizes -0.0 (e.g. 0 / negative prev) to 0.0
+        pct = None if prev == 0 else round(delta / prev * 100, 1) + 0.0
+        if cat not in prev_cats:
+            status = "new"
+        elif cat not in curr_cats:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+
+    out.sort(key=lambda d: (-abs(d.delta), d.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [d for d in diffs if d.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for d in diffs:
+        pct = "-" if d.pct is None else f"{d.pct:+.1f}%"
+        lines.append(f"{d.category}\t{d.prev}\t{d.curr}\t{d.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({e.day.strftime("%Y-%m") for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には月が 2 つ以上必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..336f5c7
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,187 @@
+"""Search query language for expense rows: tokenizer, parser and evaluator.
+
+Grammar (lowest precedence first: OR < AND < NOT)::
+
+    or_expr   := and_expr ("OR" and_expr)*
+    and_expr  := not_expr (["AND"] not_expr)*
+    not_expr  := "NOT" not_expr | primary
+    primary   := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+
+class QueryError(ValueError):
+    """Raised when a search query is invalid."""
+
+
+Token = tuple[str, str]
+
+
+def tokenize(q: str) -> list[Token]:
+    """Split a query into (kind, value) tokens."""
+    tokens: list[Token] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError("閉じていない引用符があります")
+            content = q[i + 1 : end]
+            if content == "":
+                raise QueryError("空の引用符は使えません")
+            tokens.append(("TERM", content))
+            i = end + 1
+        else:
+            j = i
+            while j < n and not (q[j].isspace() or q[j] in '()"'):
+                j += 1
+            word = q[i:j]
+            i = j
+            if word in ("AND", "OR", "NOT"):
+                tokens.append((word, word))
+            elif word.startswith("cat:"):
+                value = word[len("cat:") :]
+                if value == "":
+                    raise QueryError("cat: の後ろに値がありません")
+                tokens.append(("CAT", value))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+@dataclass(frozen=True)
+class _Term:
+    value: str
+
+
+@dataclass(frozen=True)
+class _Cat:
+    value: str
+
+
+@dataclass(frozen=True)
+class _Not:
+    operand: _Node
+
+
+@dataclass(frozen=True)
+class _And:
+    left: _Node
+    right: _Node
+
+
+@dataclass(frozen=True)
+class _Or:
+    left: _Node
+    right: _Node
+
+
+_Node = _Term | _Cat | _Not | _And | _Or
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self._tokens = tokens
+        self._pos = 0
+
+    def parse(self) -> _Node:
+        node = self._or()
+        if self._pos != len(self._tokens):
+            raise QueryError("余分なトークンがあります")
+        return node
+
+    def _peek(self) -> str | None:
+        if self._pos < len(self._tokens):
+            return self._tokens[self._pos][0]
+        return None
+
+    def _advance(self) -> Token:
+        tok = self._tokens[self._pos]
+        self._pos += 1
+        return tok
+
+    def _or(self) -> _Node:
+        node = self._and()
+        while self._peek() == "OR":
+            self._advance()
+            node = _Or(node, self._and())
+        return node
+
+    def _and(self) -> _Node:
+        node = self._not()
+        while True:
+            kind = self._peek()
+            if kind == "AND":
+                self._advance()
+                node = _And(node, self._not())
+            elif kind in ("TERM", "CAT", "NOT", "LPAREN"):
+                node = _And(node, self._not())
+            else:
+                return node
+
+    def _not(self) -> _Node:
+        if self._peek() == "NOT":
+            self._advance()
+            return _Not(self._not())
+        return self._primary()
+
+    def _primary(self) -> _Node:
+        kind = self._peek()
+        if kind == "TERM":
+            return _Term(self._advance()[1])
+        if kind == "CAT":
+            return _Cat(self._advance()[1])
+        if kind == "LPAREN":
+            self._advance()
+            node = self._or()
+            if self._peek() != "RPAREN":
+                raise QueryError("括弧が閉じていません")
+            self._advance()
+            return node
+        raise QueryError("項がありません")
+
+
+def _parse(q: str) -> _Node:
+    tokens = tokenize(q)
+    if not tokens:
+        raise QueryError("クエリが空です")
+    return _Parser(tokens).parse()
+
+
+def _eval(node: _Node, e: Expense) -> bool:
+    if isinstance(node, _Term):
+        v = node.value.casefold()
+        return v in e.memo.casefold() or v in e.category.casefold()
+    if isinstance(node, _Cat):
+        return node.value.casefold() == e.category.casefold()
+    if isinstance(node, _Not):
+        return not _eval(node.operand, e)
+    if isinstance(node, _And):
+        return _eval(node.left, e) and _eval(node.right, e)
+    return _eval(node.left, e) or _eval(node.right, e)
+
+
+def matches(q: str, e: Expense) -> bool:
+    """Return True if the expense satisfies the query."""
+    return _eval(_parse(q), e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    """Return the expenses that satisfy the query, in input order."""
+    node = _parse(q)
+    return [e for e in rows if _eval(node, e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..72ecc62
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,68 @@
+"""Detect recurring expenses (same category and amount, roughly monthly)."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day in the next month, clamped to that month's last day."""
+    year, month = (d.year, d.month + 1) if d.month < 12 else (d.year + 1, 1)
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def _runs(days: list[date], min_count: int, tolerance: int) -> list[list[date]]:
+    """Split ascending, unique dates into maximal chains where each step is monthly."""
+    runs: list[list[date]] = []
+    current: list[date] = []
+    for d in days:
+        if current and abs((d - add_month(current[-1])).days) <= tolerance:
+            current.append(d)
+            continue
+        if len(current) >= min_count:
+            runs.append(current)
+        current = [d]
+    if len(current) >= min_count:
+        runs.append(current)
+    return runs
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError("min_count は 2 以上である必要があります")
+    if tolerance < 0:
+        raise ValueError("tolerance は 0 以上である必要があります")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    result: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        for run in _runs(sorted(day_set), min_count, tolerance):
+            result.append(
+                Recurring(
+                    category=category,
+                    amount=amount,
+                    days=tuple(run),
+                    next_expected=add_month(run[-1]),
+                )
+            )
+
+    result.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return result
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..6120d28
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,94 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+
+@pytest.mark.parametrize(
+    ("s", "want"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("-¥1,0円", -10),
+        ("1,,2", 12),
+    ],
+)
+def test_amount_ok(s: str, want: int) -> None:
+    assert parse_amount(s) == want
+
+
+@pytest.mark.parametrize(
+    "s",
+    ["", "円", "12.5", "1 200", "--5", "¥-5", "１２３", ",5", "¥", "-", "¥¥5", "5円円"],
+)
+def test_amount_bad(s: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(s)
+
+
+@pytest.mark.parametrize(
+    ("s", "want"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        (" 2026-01-05 ", date(2026, 1, 5)),
+        ("2026/12/31", date(2026, 12, 31)),
+    ],
+)
+def test_date_ok(s: str, want: date) -> None:
+    assert parse_date(s) == want
+
+
+@pytest.mark.parametrize(
+    "s",
+    ["2026/1-5", "26/1/5", "2026/02/30", "2026.1.5", "２０２６/1/5", "2026/001/5", ""],
+)
+def test_date_bad(s: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(s)
+
+
+HEADER = "利用日,分類,利用金額,利用店名\n"
+
+
+def test_import_basic() -> None:
+    text = HEADER + '2026/1/5,食費,"¥1,200", 店 \n\n2026-01-06, 交通 ,300円,"a,b"\n'
+    rows, errs = import_rows(text, category_map={"交通": "交通費"})
+    assert rows == [
+        Expense(date(2026, 1, 5), "食費", 1200, "店"),
+        Expense(date(2026, 1, 6), "交通費", 300, "a,b"),
+    ]
+    assert errs == []
+
+
+def test_import_errors_and_line_numbers() -> None:
+    text = HEADER + "x,  ,abc,m\n\n2026/1/5,食費\n2026/1/5,食費,10,m\n"
+    rows, errs = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 10, "m")]
+    assert errs == [(2, "date"), (2, "amount"), (2, "category"), (4, "amount")]
+
+
+def test_import_multiline_quoted() -> None:
+    text = HEADER + '2026/1/5,食費,10,"a\nb"\n2026/1/6,食費,x,\n'
+    rows, errs = import_rows(text)
+    assert len(rows) == 1
+    assert errs == [(4, "amount")]
+
+
+def test_import_mapping() -> None:
+    text = "d,c,a,zzz\n2026/1/5,食費,10,x\n"
+    rows, errs = import_rows(text, {"date": "d", "category": "c", "amount": "a"})
+    assert rows == [Expense(date(2026, 1, 5), "食費", 10, "")]
+    assert errs == []
+
+
+def test_import_mapping_errors() -> None:
+    with pytest.raises(ValueError):
+        import_rows(HEADER, {"date": "利用日", "amount": "利用金額"})
+    with pytest.raises(ValueError):
+        import_rows(HEADER, {"date": "x", "category": "分類", "amount": "利用金額"})
+    with pytest.raises(ValueError):
+        import_rows("")
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..ba5d7bf
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,211 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def e(day: str, cat: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=cat, amount=amount)
+
+
+ROWS = [
+    e("2026-01-05", "food", 1000),
+    e("2026-01-20", "food", 500),
+    e("2026-01-10", "rent", 5000),
+    e("2026-01-11", "fun", 300),
+    e("2026-02-03", "food", 1800),
+    e("2026-02-09", "rent", 5000),
+    e("2026-02-12", "tax", 0),
+    e("2026-02-13", "fun", 0),
+]
+
+
+def by_cat(diffs: list[DiffRow]) -> dict[str, DiffRow]:
+    return {d.category: d for d in diffs}
+
+
+# --- month_diff ---------------------------------------------------------
+
+
+def test_month_diff_values_and_status():
+    d = by_cat(month_diff(ROWS, "2026-01", "2026-02"))
+    assert d["food"] == DiffRow("food", 1500, 1800, 300, 20.0, "up")
+    assert d["rent"] == DiffRow("rent", 5000, 5000, 0, 0.0, "same")
+    assert d["fun"] == DiffRow("fun", 300, 0, -300, -100.0, "down")
+    assert d["tax"] == DiffRow("tax", 0, 0, 0, None, "new")
+
+
+def test_month_diff_status_uses_row_presence_not_total():
+    # tax exists only in curr with amount 0 -> "new", not "same"
+    rows = [e("2026-02-01", "tax", 0)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row.status == "new"
+
+
+def test_month_diff_gone():
+    rows = [e("2026-01-01", "x", 700)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row == DiffRow("x", 700, 0, -700, -100.0, "gone")
+
+
+def test_month_diff_new_with_nonzero():
+    rows = [e("2026-02-01", "x", 700)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row == DiffRow("x", 0, 700, 700, None, "new")
+
+
+def test_month_diff_same_nonzero_amount():
+    rows = [e("2026-01-01", "x", 700), e("2026-02-01", "x", 700)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row.status == "same"
+    assert row.pct == 0.0
+
+
+def test_month_diff_pct_none_when_prev_zero_but_row_exists():
+    rows = [e("2026-01-01", "x", 0), e("2026-02-01", "x", 100)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row.pct is None
+    assert row.status == "up"
+
+
+def test_month_diff_pct_rounded_to_one_decimal():
+    rows = [e("2026-01-01", "x", 3), e("2026-02-01", "x", 4)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row.pct == 33.3
+
+
+def test_month_diff_pct_negative_prev_has_no_negative_zero():
+    rows = [e("2026-01-01", "x", -5), e("2026-02-01", "x", -5)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row.delta == 0
+    assert str(row.pct) == "0.0"
+
+
+def test_month_diff_empty_rows():
+    assert month_diff([], "2026-01", "2026-02") == []
+
+
+def test_month_diff_ignores_other_months():
+    rows = [e("2025-12-31", "x", 999), e("2026-03-01", "x", 999)]
+    assert month_diff(rows, "2026-01", "2026-02") == []
+
+
+def test_month_diff_sort_by_abs_delta_then_category():
+    rows = [
+        e("2026-01-01", "b", 100),
+        e("2026-02-01", "b", 0),  # delta -100
+        e("2026-01-01", "a", 100),
+        e("2026-02-01", "a", 200),  # delta +100
+        e("2026-02-01", "c", 500),  # delta +500
+    ]
+    cats = [d.category for d in month_diff(rows, "2026-01", "2026-02")]
+    assert cats == ["c", "a", "b"]
+
+
+@pytest.mark.parametrize(
+    "bad",
+    ["2026-1", "2026-13", "2026-00", "202601", "26-01", "2026-01-01", "", "2026/01"],
+)
+def test_month_diff_rejects_bad_month_format(bad):
+    with pytest.raises(ValueError):
+        month_diff(ROWS, bad, "2026-02")
+    with pytest.raises(ValueError):
+        month_diff(ROWS, "2026-01", bad)
+
+
+# --- top_movers ---------------------------------------------------------
+
+
+def test_top_movers_excludes_same_and_keeps_order():
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    cats = [d.category for d in top_movers(diffs, n=10)]
+    assert cats == ["food", "fun", "tax"]
+    assert "rent" not in cats
+
+
+def test_top_movers_default_n_is_3():
+    rows = [e("2026-02-01", f"c{i}", 100 * (i + 1)) for i in range(5)]
+    diffs = month_diff(rows, "2026-01", "2026-02")
+    assert len(top_movers(diffs)) == 3
+
+
+def test_top_movers_n_zero_and_larger_than_list():
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    assert top_movers(diffs, n=0) == []
+    assert len(top_movers(diffs, n=100)) == 3
+
+
+def test_top_movers_negative_n_raises():
+    with pytest.raises(ValueError):
+        top_movers([], n=-1)
+
+
+def test_top_movers_all_same_is_empty():
+    rows = [e("2026-01-01", "x", 1), e("2026-02-01", "x", 1)]
+    assert top_movers(month_diff(rows, "2026-01", "2026-02")) == []
+
+
+# --- render_diff --------------------------------------------------------
+
+
+def test_render_diff_format():
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    text = render_diff(diffs)
+    assert text.split("\n") == [
+        "category\tprev\tcurr\tdelta\tpct",
+        "food\t1500\t1800\t+300\t+20.0%",
+        "fun\t300\t0\t-300\t-100.0%",
+        "rent\t5000\t5000\t+0\t+0.0%",
+        "tax\t0\t0\t+0\t-",
+    ]
+
+
+def test_render_diff_no_trailing_newline():
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    assert not render_diff(diffs).endswith("\n")
+
+
+def test_render_diff_empty_is_header_only():
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_render_diff_zero_delta_is_plus_zero_and_pct_sign():
+    row = DiffRow("x", 0, 0, 0, 0.0, "same")
+    assert render_diff([row]).split("\n")[1] == "x\t0\t0\t+0\t+0.0%"
+
+
+# --- available_months / latest_diff -------------------------------------
+
+
+def test_available_months_sorted_unique():
+    rows = [e("2026-03-01", "x", 1), e("2026-01-01", "x", 1), e("2026-01-31", "y", 1)]
+    assert available_months(rows) == ["2026-01", "2026-03"]
+
+
+def test_available_months_empty():
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months():
+    rows = ROWS + [e("2026-03-01", "food", 900)]
+    diffs = by_cat(latest_diff(rows))
+    assert diffs["food"] == DiffRow("food", 1800, 900, -900, -50.0, "down")
+    # rent exists only in Feb (the prev month here), so it is "gone" in Mar;
+    # Jan-only data is not used at all.
+    assert diffs["rent"] == DiffRow("rent", 5000, 0, -5000, -100.0, "gone")
+
+
+def test_latest_diff_needs_two_months():
+    with pytest.raises(ValueError):
+        latest_diff([])
+    with pytest.raises(ValueError):
+        latest_diff([e("2026-01-01", "x", 1), e("2026-01-02", "x", 1)])
