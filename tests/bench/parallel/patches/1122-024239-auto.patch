diff --git a/tests/test_types/test_Path_extensions.py b/tests/test_types/test_Path_extensions.py
new file mode 100644
index 0000000..35e3588
--- /dev/null
+++ b/tests/test_types/test_Path_extensions.py
@@ -0,0 +1,118 @@
+import os
+import pathlib
+
+import pytest
+
+import click
+
+
+@pytest.mark.parametrize(
+    "name",
+    ["a.csv", "a.tsv", "A.CSV", "a.Tsv", "dir.d/a.csv", "x.y.csv"],
+)
+def test_path_extensions_accepts(name):
+    type = click.Path(extensions=[".csv", ".tsv"])
+    assert type.convert(name, None, None) == name
+
+
+@pytest.mark.parametrize("name", ["a.txt", "a", "csv", "a.csv.bak", ".csv", "a.csv/b"])
+def test_path_extensions_rejects(name):
+    type = click.Path(extensions=[".csv", ".tsv"])
+
+    with pytest.raises(click.BadParameter, match="must have one of these extensions"):
+        type.convert(name, None, None)
+
+
+def test_path_extensions_message_lists_extensions():
+    with pytest.raises(click.BadParameter, match=r"\.csv, \.tsv"):
+        click.Path(extensions=["CSV", "tsv"]).convert("a.txt", None, None)
+
+
+@pytest.mark.parametrize("extensions", ["csv", ".csv", ["csv"], {"CSV"}, ("..csv",)])
+def test_path_extensions_spelling(extensions):
+    type = click.Path(extensions=extensions)
+    assert type.convert("a.Csv", None, None) == "a.Csv"
+
+    with pytest.raises(click.BadParameter):
+        type.convert("a.tsv", None, None)
+
+
+def test_path_extensions_multi_part():
+    type = click.Path(extensions=[".tar.gz"])
+    assert type.convert("a.TAR.GZ", None, None) == "a.TAR.GZ"
+
+    with pytest.raises(click.BadParameter):
+        type.convert("a.gz", None, None)
+
+
+@pytest.mark.parametrize("extensions", [[], (), "", [""], ["."], ["csv", ""]])
+def test_path_extensions_invalid(extensions):
+    with pytest.raises(ValueError, match="extensions"):
+        click.Path(extensions=extensions)
+
+
+def test_path_extensions_default_unchanged():
+    assert click.Path().extensions is None
+    assert click.Path().convert("a.anything", None, None) == "a.anything"
+
+
+def test_path_extensions_existing_file(tmp_path):
+    good = tmp_path / "a.CSV"
+    bad = tmp_path / "a.txt"
+    good.write_text("")
+    bad.write_text("")
+    type = click.Path(exists=True, extensions=[".csv"])
+
+    assert type.convert(os.fspath(good), None, None) == os.fspath(good)
+
+    with pytest.raises(click.BadParameter, match="must have one of these extensions"):
+        type.convert(os.fspath(bad), None, None)
+
+
+def test_path_extensions_missing_file_with_exists(tmp_path):
+    type = click.Path(exists=True, extensions=[".csv"])
+
+    # Existence is reported first, as before.
+    with pytest.raises(click.BadParameter, match="does not exist"):
+        type.convert(os.fspath(tmp_path / "missing.csv"), None, None)
+
+
+def test_path_extensions_skips_directory(tmp_path):
+    d = tmp_path / "data.d"
+    d.mkdir()
+    type = click.Path(exists=True, extensions=[".csv"])
+    assert type.convert(os.fspath(d), None, None) == os.fspath(d)
+
+
+def test_path_extensions_dash():
+    type = click.Path(allow_dash=True, extensions=[".csv"])
+    assert type.convert("-", None, None) == "-"
+
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions=[".csv"]).convert("-", None, None)
+
+
+@pytest.mark.parametrize(
+    "value", [b"a.CSV", pathlib.Path("a.csv"), pathlib.PurePosixPath("x/a.csv")]
+)
+def test_path_extensions_bytes_and_pathlike(value):
+    assert click.Path(extensions=[".csv"]).convert(value, None, None) == value
+
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions=[".tsv"]).convert(value, None, None)
+
+
+def test_path_extensions_cli(runner):
+    cli = click.Command(
+        "cli",
+        params=[click.Argument(["p"], type=click.Path(extensions=["csv", "tsv"]))],
+        callback=lambda p: click.echo(p),
+    )
+
+    result = runner.invoke(cli, ["data.TSV"])
+    assert result.exit_code == 0
+    assert result.output == "data.TSV\n"
+
+    result = runner.invoke(cli, ["data.json"])
+    assert result.exit_code == 2
+    assert "must have one of these extensions: .csv, .tsv." in result.output
