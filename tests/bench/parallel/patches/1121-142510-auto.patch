+from datetime import date
+
+import pytest
+
+from kakeibo.bankcsv import parse_statement
+from kakeibo.core import CsvError, Expense
+
+
+def test_E2_1_aliases_and_quoted_yen_amount_use_default_category() -> None:
+    """E2-1: 利用日/ご利用店名/利用金額 の別名、"1,234円"、カテゴリ列なしは既定値。"""
+    text = '利用日,ご利用店名,利用金額\n2026/1/5,スーパー,"1,234円"\n'
+    assert parse_statement(text) == [
+        Expense(date(2026, 1, 5), "未分類", 1234, "スーパー")
+    ]
+
+
+def test_E2_2_deposit_only_row_is_skipped_in_withdraw_deposit_form() -> None:
+    """E2-2: 出金/入金形式で入金のみの行はスキップ(出金のある行は残る)。"""
+    text = "日付,出金,入金,摘要\n2026-01-05,,1000,給与\n2026-01-06,500,,スーパー\n"
+    assert parse_statement(text) == [
+        Expense(date(2026, 1, 6), "未分類", 500, "スーパー")
+    ]
+
+
+def test_E2_3_row_with_bad_date_and_amount_is_one_error_naming_both_columns() -> None:
+    """E2-3: 日付と金額が両方不正な 1 行は errors が 1 件で、両方の列名を含む。"""
+    text = "利用日,ご利用店名,利用金額\n2026/13/45,スーパー,abc\n"
+    with pytest.raises(CsvError) as info:
+        parse_statement(text)
+    assert len(info.value.errors) == 1
+    line, reason = info.value.errors[0]
+    assert line == 2
+    assert "利用日" in reason
+    assert "利用金額" in reason
+    assert "; " in reason
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        ("1234", 1234),
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("¥1,234", 1234),
+        ("￥１，２３４", 1234),
+        ("1,234円", 1234),
+        ("1234JPY", 1234),
+        ("0", 0),
+    ],
+    ids=[
+        "plain",
+        "minus",
+        "u2212",
+        "sankaku",
+        "shikaku",
+        "paren",
+        "trailing-minus",
+        "yen",
+        "fullwidth",
+        "en-suffix",
+        "jpy-suffix",
+        "zero",
+    ],
+)
+def test_R4_amount_forms(raw: str, expected: int) -> None:
+    text = f'日付,金額\n2026-01-05,"{raw}"\n'
+    assert parse_statement(text)[0].amount == expected
+
+
+@pytest.mark.parametrize("raw", ["12.5", "+5", "1,23", "abc", "-", ""])
+def test_R4_invalid_or_empty_amount_in_single_column_is_error(raw: str) -> None:
+    text = f'日付,金額\n2026-01-05,"{raw}"\n'
+    with pytest.raises(CsvError):
+        parse_statement(text)
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        ("2026-01-05", date(2026, 1, 5)),
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026.1.5", date(2026, 1, 5)),
+        ("20260105", date(2026, 1, 5)),
+        ("2026年1月5日", date(2026, 1, 5)),
+        ("2026-01-05 12:30", date(2026, 1, 5)),
+    ],
+    ids=["dash", "slash", "dot", "compact", "kanji", "with-time"],
+)
+def test_R5_date_forms(raw: str, expected: date) -> None:
+    text = f"日付,金額\n{raw},100\n"
+    assert parse_statement(text)[0].day == expected
+
+
+@pytest.mark.parametrize(
+    "raw", ["2026-02-30", "令和8年1月5日", "2026-13-01", "2026-01-05 abc"]
+)
+def test_R5_invalid_dates_are_row_errors(raw: str) -> None:
+    text = f"日付,金額\n{raw},100\n"
+    with pytest.raises(CsvError) as info:
+        parse_statement(text)
+    assert info.value.errors[0][0] == 2
+
+
+def test_R1_bom_tab_delimiter_and_crlf_cr_newlines() -> None:
+    text = "﻿日付\t金額\t摘要\r\n2026-01-05\t100\tA\r2026-01-06\t-200\tB"
+    assert parse_statement(text) == [
+        Expense(date(2026, 1, 5), "未分類", 100, "A"),
+        Expense(date(2026, 1, 6), "未分類", -200, "B"),
+    ]
+
+
+def test_R1_quoted_newline_keeps_memo_and_error_line_is_record_start() -> None:
+    ok = '日付,金額,摘要\n2026-01-05,100,"a,\nb"\n'
+    assert parse_statement(ok) == [Expense(date(2026, 1, 5), "未分類", 100, "a,\nb")]
+    text = '日付,金額,摘要\n2026-01-05,100,"a,\nb"\n2026-01-06,abc,y\n'
+    with pytest.raises(CsvError) as info:
+        parse_statement(text)
+    assert info.value.errors[0][0] == 4
+
+
+def test_R2_header_aliases_ignore_case_width_and_surrounding_spaces() -> None:
+    text = " ＤＡＴＥ , Amount ,Memo,Category\n2026-01-05,100,A,食費\n"
+    assert parse_statement(text) == [Expense(date(2026, 1, 5), "食費", 100, "A")]
+
+
+def test_R3_missing_date_column_is_value_error_naming_it() -> None:
+    with pytest.raises(ValueError, match="日付"):
+        parse_statement("金額,摘要\n100,A\n")
+
+
+def test_R3_amount_and_withdraw_together_is_value_error() -> None:
+    with pytest.raises(ValueError, match="金額"):
+        parse_statement("日付,金額,出金,入金\n2026-01-05,100,100,\n")
+
+
+def test_R3_withdraw_without_deposit_is_value_error_naming_deposit() -> None:
+    with pytest.raises(ValueError, match="入金"):
+        parse_statement("日付,出金\n2026-01-05,100\n")
+
+
+def test_R3_withdraw_zero_with_deposit_is_skipped() -> None:
+    text = "日付,出金,入金\n2026-01-05,0,500\n"
+    assert parse_statement(text) == []
+
+
+def test_R3_both_withdraw_and_deposit_empty_is_error() -> None:
+    with pytest.raises(CsvError):
+        parse_statement("日付,出金,入金\n2026-01-05,,\n")
+
+
+def test_R6_every_bad_row_is_reported_together() -> None:
+    text = "日付,金額\nx,1\n2026-01-05,y\n"
+    with pytest.raises(CsvError) as info:
+        parse_statement(text)
+    assert [line for line, _ in info.value.errors] == [2, 3]
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "日付,金額,摘要\n2026-01-05,100\n",
+        "日付,金額\n2026-01-05,100,extra\n",
+    ],
+    ids=["short", "long"],
+)
+def test_R6_wrong_column_count_is_row_error(text: str) -> None:
+    with pytest.raises(CsvError) as info:
+        parse_statement(text)
+    assert "列数" in info.value.errors[0][1]
+
+
+def test_R6_blank_lines_ignored_and_header_only_or_empty_is_empty_list() -> None:
+    assert parse_statement("日付,金額\n\n2026-01-05,100\n\n") == [
+        Expense(date(2026, 1, 5), "未分類", 100, "")
+    ]
+    assert parse_statement("日付,金額\n") == []
+    assert parse_statement("") == []
+
+
+def test_R7_non_str_text_is_type_error() -> None:
+    with pytest.raises(TypeError):
+        parse_statement(123)  # type: ignore[arg-type]
