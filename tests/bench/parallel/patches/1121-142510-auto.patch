@@ -0,0 +1,257 @@
+"""Parse bank/card statement CSV text into Expense records (pure function, no I/O)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import CsvError, Expense
+
+_DATE_ALIASES = frozenset({"日付", "利用日", "取引日", "ご利用日", "date"})
+_AMOUNT_ALIASES = frozenset({"金額", "利用金額", "ご利用金額", "amount"})
+_WITHDRAW_ALIASES = frozenset({"出金", "出金額", "支払", "お支払金額"})
+_DEPOSIT_ALIASES = frozenset({"入金", "入金額", "預入", "お預り金額"})
+_MEMO_ALIASES = frozenset(
+    {"摘要", "メモ", "利用店名", "ご利用店名", "内容", "description", "memo"}
+)
+_CATEGORY_ALIASES = frozenset({"カテゴリ", "category"})
+
+_LINE_BREAK = re.compile(r"\r\n|\r|\n")
+_DATE_SEP = re.compile(r"([0-9]{4})([-/.])([0-9]{1,2})\2([0-9]{1,2})")
+_DATE_KANJI = re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日")
+_DATE_COMPACT = re.compile(r"[0-9]{8}")
+_TIME = re.compile(r"[0-9]{1,2}:[0-9]{2}(:[0-9]{2})?")
+_AMOUNT_BODY = re.compile(r"[0-9]{1,3}(,[0-9]{3})+|[0-9]+")
+_EMPTY_AMOUNT = frozenset({"", "-", "—"})
+
+
+def _nfkc(s: str) -> str:
+    return unicodedata.normalize("NFKC", s)
+
+
+def _alias(s: str) -> str:
+    return _nfkc(s).strip().lower()
+
+
+@dataclass(frozen=True)
+class _Columns:
+    date_col: int
+    amount: int | None
+    withdraw: int | None
+    deposit: int | None
+    category: int | None
+    memo: int | None
+
+
+def _resolve(header: list[str]) -> _Columns:
+    norm = [_alias(h) for h in header]
+
+    def find(aliases: frozenset[str], role: str) -> int | None:
+        hits = [i for i, h in enumerate(norm) if h in aliases]
+        if len(hits) > 1:
+            names = ", ".join(header[i] for i in hits)
+            raise ValueError(f"{role}列が複数あります: {names}")
+        return hits[0] if hits else None
+
+    date_col = find(_DATE_ALIASES, "日付")
+    amount = find(_AMOUNT_ALIASES, "金額")
+    withdraw = find(_WITHDRAW_ALIASES, "出金")
+    deposit = find(_DEPOSIT_ALIASES, "入金")
+    category = find(_CATEGORY_ALIASES, "カテゴリ")
+    memo = find(_MEMO_ALIASES, "メモ")
+    if date_col is None:
+        raise ValueError(
+            "日付列がありません(日付・利用日・取引日・ご利用日・date のいずれか)"
+        )
+    if amount is None:
+        missing = [n for n, i in (("出金", withdraw), ("入金", deposit)) if i is None]
+        if missing:
+            raise ValueError(
+                "金額列がありません(金額、または出金と入金の両方が必要です。"
+                f"不足: {', '.join(missing)})"
+            )
+    elif withdraw is not None or deposit is not None:
+        raise ValueError(
+            "金額列と出金・入金列が同時にあります。どちらか一方にしてください"
+        )
+    return _Columns(date_col, amount, withdraw, deposit, category, memo)
+
+
+def _delimiter(text: str) -> str:
+    first = next((ln for ln in _LINE_BREAK.split(text) if ln.strip()), "")
+    return "\t" if first.count("\t") > first.count(",") else ","
+
+
+def _records(text: str) -> list[tuple[int, list[str]]]:
+    """(record start line, cells). Line numbers are 1-based physical lines."""
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=_delimiter(text))
+    out: list[tuple[int, list[str]]] = []
+    start = 1
+    try:
+        for row in reader:
+            out.append((start, row))
+            start = reader.line_num + 1
+    except csv.Error as e:
+        raise ValueError(f"CSV として読めません: {e}") from None
+    return out
+
+
+def _is_blank(row: list[str]) -> bool:
+    return all(not c.strip() for c in row)
+
+
+def _cell(row: list[str], i: int | None) -> str:
+    if i is None or i >= len(row):
+        return ""
+    return row[i]
+
+
+def _parse_date(raw: str) -> date:
+    parts = _nfkc(raw).split()
+    if not parts:
+        raise ValueError("空です")
+    if len(parts) > 2 or (len(parts) == 2 and not _TIME.fullmatch(parts[1])):
+        raise ValueError("日付の形式ではありません")
+    s = parts[0]
+    if (m := _DATE_SEP.fullmatch(s)) is not None:
+        y, mo, d = m.group(1), m.group(3), m.group(4)
+    elif (m := _DATE_KANJI.fullmatch(s)) is not None:
+        y, mo, d = m.group(1), m.group(2), m.group(3)
+    elif _DATE_COMPACT.fullmatch(s):
+        y, mo, d = s[:4], s[4:6], s[6:]
+    else:
+        raise ValueError("日付の形式ではありません")
+    try:
+        return date(int(y), int(mo), int(d))
+    except ValueError:
+        raise ValueError("存在しない日付です") from None
+
+
+def _strip_currency(s: str) -> str:
+    s = s.strip()
+    if s.startswith("¥"):
+        s = s[1:].strip()
+    if s.endswith("円"):
+        s = s[:-1].strip()
+    elif s.endswith("JPY"):
+        s = s[:-3].strip()
+    return s
+
+
+def _parse_amount(raw: str) -> int | None:
+    """Return yen (negative = refund), or None when the cell means 'no amount'."""
+    s = _nfkc(raw).replace("−", "-").strip()
+    if s in _EMPTY_AMOUNT:
+        return None
+    s = _strip_currency(s)
+    neg = False
+    if s[:1] in ("△", "▲"):
+        neg, s = True, s[1:]
+    elif s.startswith("(") and s.endswith(")"):
+        neg, s = True, s[1:-1]
+    elif s.startswith("-"):
+        neg, s = True, s[1:]
+    elif s.endswith("-"):
+        neg, s = True, s[:-1]
+    s = _strip_currency(s)
+    if not _AMOUNT_BODY.fullmatch(s):
+        raise ValueError("金額の形式ではありません")
+    value = int(s.replace(",", ""))
+    return -value if neg else value
+
+
+def _problem(col: str, raw: str, why: str) -> str:
+    return f"{col}({raw!r}): {why}"
+
+
+def _row(
+    row: list[str], cols: _Columns, header: list[str], default_category: str
+) -> tuple[list[str], Expense | None]:
+    """(problems, expense). Checks every cell of the row before giving up."""
+    problems: list[str] = []
+    if len(row) != len(header):
+        problems.append(f"列数が不正です(ヘッダー {len(header)} 列、行 {len(row)} 列)")
+
+    day: date | None = None
+    raw = _cell(row, cols.date_col)
+    try:
+        day = _parse_date(raw)
+    except ValueError as e:
+        problems.append(_problem(header[cols.date_col], raw, str(e)))
+
+    amount: int | None = None
+    skip = False
+    if cols.amount is not None:
+        raw = _cell(row, cols.amount)
+        try:
+            amount = _parse_amount(raw)
+        except ValueError as e:
+            problems.append(_problem(header[cols.amount], raw, str(e)))
+        else:
+            if amount is None:
+                problems.append(_problem(header[cols.amount], raw, "金額がありません"))
+    elif cols.withdraw is not None and cols.deposit is not None:
+        w_name, d_name = header[cols.withdraw], header[cols.deposit]
+        w_raw, d_raw = _cell(row, cols.withdraw), _cell(row, cols.deposit)
+        w: int | None = None
+        d: int | None = None
+        ok = True
+        try:
+            w = _parse_amount(w_raw)
+        except ValueError as e:
+            problems.append(_problem(w_name, w_raw, str(e)))
+            ok = False
+        try:
+            d = _parse_amount(d_raw)
+        except ValueError as e:
+            problems.append(_problem(d_name, d_raw, str(e)))
+            ok = False
+        if ok:
+            if w is None and d is None:
+                problems.append(f"{w_name}と{d_name}が両方空です")
+            elif d is not None and (w is None or w == 0):
+                skip = True  # 入金のみ: 支出ではない
+            else:
+                amount = w
+
+    category = _cell(row, cols.category).strip() or default_category
+    memo = _cell(row, cols.memo).strip()
+    if problems:
+        return problems, None
+    if skip or day is None or amount is None:
+        return [], None
+    return [], Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+def parse_statement(text: str, default_category: str = "未分類") -> list[Expense]:
+    """Parse a bank/card statement CSV string. Raises CsvError listing every bad row."""
+    if not isinstance(text, str):
+        raise TypeError(f"text は str である必要があります: {type(text).__name__}")
+    if not isinstance(default_category, str):
+        raise TypeError(
+            f"default_category は str である必要があります: {type(default_category).__name__}"
+        )
+    text = text.removeprefix("﻿")
+    if not text.strip():
+        return []
+    body = [(ln, row) for ln, row in _records(text) if not _is_blank(row)]
+    if not body:
+        return []
+    header = [c.strip() for c in body[0][1]]
+    cols = _resolve(header)
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    for line, row in body[1:]:
+        problems, expense = _row(row, cols, header, default_category)
+        if problems:
+            errors.append((line, "; ".join(problems)))
+        elif expense is not None:
+            expenses.append(expense)
+    if errors:
+        raise CsvError(errors)
+    return expenses
