new file mode 100644
index 0000000..f6f1fc2
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,126 @@
+"""Search Expense rows with composable predicate queries (pure functions)."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable
+from datetime import date, datetime
+
+from kakeibo.core import Expense
+
+Query = Callable[[Expense], bool]
+
+
+def _check_queries(qs: tuple[object, ...], name: str) -> None:
+    for i, q in enumerate(qs):
+        if not callable(q):
+            raise TypeError(
+                f"{name} の引数 {i} は callable である必要があります: {q!r}"
+            )
+
+
+def _check_int_bound(value: object, label: str) -> None:
+    if value is None:
+        return
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{label} は int か None である必要があります: {value!r}")
+
+
+def _check_date_bound(value: object, label: str) -> None:
+    if value is None:
+        return
+    if isinstance(value, datetime) or not isinstance(value, date):
+        raise TypeError(f"{label} は date か None である必要があります: {value!r}")
+
+
+def _normalize_text(text: str) -> str:
+    return unicodedata.normalize("NFKC", text).casefold()
+
+
+def category(*names: str) -> Query:
+    """カテゴリが names のいずれかに完全一致する(strip 後、OR)。"""
+    if not names:
+        raise ValueError("category には少なくとも 1 つの名前が必要です")
+    for n in names:
+        if not isinstance(n, str):
+            raise TypeError(f"category の名前は str である必要があります: {n!r}")
+    targets = frozenset(n.strip() for n in names)
+
+    def q(e: Expense) -> bool:
+        return e.category in targets
+
+    return q
+
+
+def amount_range(min: int | None = None, max: int | None = None) -> Query:
+    """min <= amount <= max(両端を含む)。None は無制限。"""
+    _check_int_bound(min, "min")
+    _check_int_bound(max, "max")
+    if min is not None and max is not None and min > max:
+        raise ValueError(f"min ({min}) は max ({max}) 以下である必要があります")
+
+    def q(e: Expense) -> bool:
+        return (min is None or e.amount >= min) and (max is None or e.amount <= max)
+
+    return q
+
+
+def memo_contains(text: str) -> Query:
+    """memo が text を部分一致で含む(NFKC・大文字小文字無視)。空文字は全件一致。"""
+    if not isinstance(text, str):
+        raise TypeError(f"memo_contains の引数は str である必要があります: {text!r}")
+    needle = _normalize_text(text)
+
+    def q(e: Expense) -> bool:
+        return needle in _normalize_text(e.memo)
+
+    return q
+
+
+def between(start: date | None = None, end: date | None = None) -> Query:
+    """start <= day <= end(両端を含む)。None は無制限。"""
+    _check_date_bound(start, "start")
+    _check_date_bound(end, "end")
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"start ({start}) は end ({end}) 以前である必要があります")
+
+    def q(e: Expense) -> bool:
+        return (start is None or e.day >= start) and (end is None or e.day <= end)
+
+    return q
+
+
+def all_of(*qs: Query) -> Query:
+    """全てを満たす。引数ゼロなら常に真。"""
+    _check_queries(qs, "all_of")
+
+    def q(e: Expense) -> bool:
+        return all(sub(e) for sub in qs)
+
+    return q
+
+
+def any_of(*qs: Query) -> Query:
+    """いずれかを満たす。引数ゼロなら常に偽。"""
+    _check_queries(qs, "any_of")
+
+    def q(e: Expense) -> bool:
+        return any(sub(e) for sub in qs)
+
+    return q
+
+
+def not_(query: Query) -> Query:
+    """query の否定。"""
+    _check_queries((query,), "not_")
+
+    def q(e: Expense) -> bool:
+        return not query(e)
+
+    return q
+
+
+def search(rows: list[Expense], query: Query) -> list[Expense]:
+    """query を満たす行を元の並びのまま返す。rows は変更しない。"""
+    _check_queries((query,), "search")
+    return [e for e in rows if query(e)]
