@@ -0,0 +1,127 @@
+"""Detect recurring monthly expenses (pure functions, no I/O)."""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from calendar import monthrange
+from collections import Counter
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int
+    count: int
+    day_of_month: int
+    last_seen: date
+    next_expected: date
+
+
+_TRAILING_RE = re.compile(r"\s*(?:#\d+|\d+)$")
+
+
+def _memo_key(memo: str) -> str:
+    """D3: NFKC, lowercase, collapse whitespace, drop trailing digits / #12."""
+    s = unicodedata.normalize("NFKC", memo).lower()
+    s = " ".join(s.split())
+    return _TRAILING_RE.sub("", s).strip()
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + (d.month - 1)
+
+
+def _next_month_day(last: date, day_of_month: int) -> date:
+    """D4: same day_of_month in the month after `last`, clipped to month end."""
+    year = last.year + (1 if last.month == 12 else 0)
+    month = last.month % 12 + 1
+    return date(year, month, min(day_of_month, monthrange(year, month)[1]))
+
+
+def _amount_clusters(members: list[Expense], tolerance: float) -> list[list[Expense]]:
+    """R1: group amounts around the mode (most frequent, then smaller) within tolerance."""
+    counts: Counter[int] = Counter(e.amount for e in members)
+    order = sorted(counts, key=lambda a: (-counts[a], a))
+    assigned: set[int] = set()
+    clusters: list[list[Expense]] = []
+    for mode in order:
+        if mode in assigned:
+            continue
+        close = {
+            a for a in order if a not in assigned and abs(a - mode) <= tolerance * mode
+        }
+        assigned |= close
+        clusters.append([e for e in members if e.amount in close])
+    return clusters
+
+
+def _series(category: str, rows: list[Expense], min_months: int) -> Recurring | None:
+    """R2/R3: build a series from one amount cluster, or None if it is not recurring."""
+    months = Counter(_month_index(e.day) for e in rows)
+    if any(n > 1 for n in months.values()):
+        return None  # two in one month: not monthly, the series does not hold
+    idxs = sorted(months)
+    start = len(idxs) - 1
+    while start > 0 and idxs[start] - idxs[start - 1] == 1:
+        start -= 1
+    run = set(idxs[start:])
+    if len(run) < min_months:
+        return None
+    series = sorted(
+        (e for e in rows if _month_index(e.day) in run), key=lambda e: e.day
+    )
+    days = sorted(e.day.day for e in series)
+    day_of_month = days[(len(days) - 1) // 2]
+    last = series[-1]
+    return Recurring(
+        category=category,
+        memo=last.memo,
+        amount=last.amount,
+        count=len(series),
+        day_of_month=day_of_month,
+        last_seen=last.day,
+        next_expected=_next_month_day(last.day, day_of_month),
+    )
+
+
+def find_recurring(
+    rows: list[Expense], min_months: int = 3, tolerance: float = 0.0
+) -> list[Recurring]:
+    if not isinstance(rows, list):
+        raise TypeError("rows は list である必要があります")
+    if isinstance(min_months, bool) or not isinstance(min_months, int):
+        raise TypeError("min_months は int である必要があります")
+    if min_months < 2:
+        raise ValueError(f"min_months は 2 以上である必要があります: {min_months}")
+    if isinstance(tolerance, bool) or not isinstance(tolerance, (int, float)):
+        raise TypeError("tolerance は数値である必要があります")
+    if not 0 <= tolerance <= 1:
+        raise ValueError(f"tolerance は 0〜1 である必要があります: {tolerance}")
+    for i, e in enumerate(rows):
+        if not isinstance(e, Expense):
+            raise TypeError(f"rows[{i}] は Expense である必要があります")
+        if isinstance(e.amount, bool) or not isinstance(e.amount, int):
+            raise TypeError(f"rows[{i}].amount は int である必要があります")
+
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        if e.amount < 0:  # D1: refunds never join a series
+            continue
+        key = (e.category.strip(), _memo_key(e.memo))
+        groups.setdefault(key, []).append(e)
+
+    out: list[Recurring] = []
+    for (category, _), members in groups.items():
+        for cluster in _amount_clusters(members, tolerance):
+            found = _series(category, cluster, min_months)
+            if found is not None:
+                out.append(found)
+    # R4
+    out.sort(key=lambda r: (r.next_expected, r.category, r.memo))
+    return out
