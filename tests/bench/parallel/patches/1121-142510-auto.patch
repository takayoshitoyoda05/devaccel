@@ -0,0 +1,139 @@
+"""Tests for kakeibo.monthreport.compare_months."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthreport import Change, compare_months
+
+
+def _e(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+def _by_cat(changes: list[Change]) -> dict[str, Change]:
+    return {c.category: c for c in changes}
+
+
+def test_E4_1_new_category_has_no_pct() -> None:
+    # E4-1: 食費 前月 0 / 今月 3000 -> 新規, pct None (R3, R4)
+    rows = [_e("2026-05-03", "食費", 3000)]
+    c = _by_cat(compare_months(rows, "2026-05", "2026-04"))["食費"]
+    assert (c.previous, c.current, c.delta) == (0, 3000, 3000)
+    assert c.status == "新規"
+    assert c.pct is None
+
+
+def test_E4_2_previous_defaults_to_calendar_prior_month() -> None:
+    # E4-2: month="2026-01"、previous 省略 -> 前月は 2025-12 と比べる (R1)
+    rows = [
+        _e("2025-12-10", "食費", 1000),
+        _e("2026-01-10", "食費", 1500),
+    ]
+    c = _by_cat(compare_months(rows, "2026-01"))["食費"]
+    assert c.previous == 1000
+    assert c.current == 1500
+    assert c.delta == 500
+    assert c.status == "増"
+    assert c.pct == pytest.approx(50.0)
+
+
+def test_E4_3_category_only_in_previous_is_gone() -> None:
+    # E4-3: 前月だけにあるカテゴリ -> current=0, なくなった, pct -100.0 (R3, R4)
+    rows = [_e("2026-04-02", "娯楽", 800)]
+    c = _by_cat(compare_months(rows, "2026-05", "2026-04"))["娯楽"]
+    assert c.current == 0
+    assert c.delta == -800
+    assert c.status == "なくなった"
+    assert c.pct == -100.0
+
+
+def test_both_months_empty_returns_empty_list() -> None:
+    assert compare_months([], "2026-05", "2026-04") == []
+
+
+def test_missing_month_counts_as_zero_not_error() -> None:
+    rows = [_e("2026-04-02", "食費", 500)]
+    c = _by_cat(compare_months(rows, "2026-05", "2026-04"))["食費"]
+    assert c.current == 0
+
+
+def test_same_value_is_no_change_with_zero_delta() -> None:
+    rows = [_e("2026-04-02", "食費", 500), _e("2026-05-02", "食費", 500)]
+    c = _by_cat(compare_months(rows, "2026-05", "2026-04"))["食費"]
+    assert c.delta == 0
+    assert c.status == "変化なし"
+    assert c.pct == 0.0
+
+
+def test_decrease_has_decrease_status() -> None:
+    rows = [_e("2026-04-02", "食費", 500), _e("2026-05-02", "食費", 200)]
+    c = _by_cat(compare_months(rows, "2026-05", "2026-04"))["食費"]
+    assert c.delta == -300
+    assert c.status == "減"
+    assert c.pct == pytest.approx(-60.0)
+
+
+def test_pct_is_not_rounded() -> None:
+    rows = [_e("2026-04-02", "食費", 3), _e("2026-05-02", "食費", 4)]
+    c = _by_cat(compare_months(rows, "2026-05", "2026-04"))["食費"]
+    assert c.pct == pytest.approx(100 / 3)
+
+
+def test_refunds_are_netted_in_amounts() -> None:
+    rows = [
+        _e("2026-05-01", "食費", 1000),
+        _e("2026-05-02", "食費", -300),
+    ]
+    c = _by_cat(compare_months(rows, "2026-05", "2026-04"))["食費"]
+    assert c.current == 700
+
+
+def test_union_of_categories_sorted_by_abs_delta_then_name() -> None:
+    rows = [
+        _e("2026-04-01", "A", 100),  # delta -100
+        _e("2026-05-01", "B", 300),  # delta +300
+        _e("2026-05-01", "C", 100),  # delta +100
+        _e("2026-04-01", "D", 500),  # delta -500
+    ]
+    got = compare_months(rows, "2026-05", "2026-04")
+    assert [c.category for c in got] == ["D", "B", "A", "C"]
+
+
+def test_january_default_previous_is_prior_december_of_prior_year() -> None:
+    rows = [_e("2025-12-01", "食費", 10)]
+    c = _by_cat(compare_months(rows, "2026-01"))["食費"]
+    assert c.previous == 10
+    assert c.status == "なくなった"
+
+
+@pytest.mark.parametrize(
+    "bad", ["2026-13", "2026-00", "2026-1", "202601", "2026/01", "26-01"]
+)
+def test_invalid_month_format_raises_value_error(bad: str) -> None:
+    with pytest.raises(ValueError):
+        compare_months([], bad)
+
+
+@pytest.mark.parametrize("bad", ["2026-13", "2026/04"])
+def test_invalid_previous_raises_value_error(bad: str) -> None:
+    with pytest.raises(ValueError):
+        compare_months([], "2026-05", bad)
+
+
+def test_previous_equal_to_month_raises_value_error() -> None:
+    with pytest.raises(ValueError):
+        compare_months([], "2026-05", "2026-05")
+
+
+def test_rows_not_list_raises_type_error() -> None:
+    with pytest.raises(TypeError):
+        compare_months((), "2026-05")  # type: ignore[arg-type]
+
+
+def test_month_not_str_raises_type_error() -> None:
+    with pytest.raises(TypeError):
+        compare_months([], 202605)  # type: ignore[arg-type]
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..071962c
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,185 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring
+
+
+def ex(day: str, amount: int, category: str = "家賃", memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+@pytest.mark.parametrize(
+    ("rows", "min_months", "expected"),
+    [
+        pytest.param(
+            [
+                ex("2026-10-05", 80000, memo="家賃"),
+                ex("2026-11-05", 80000, memo="家賃"),
+                ex("2026-12-05", 80000, memo="家賃"),
+            ],
+            3,
+            [
+                Recurring(
+                    category="家賃",
+                    memo="家賃",
+                    amount=80000,
+                    count=3,
+                    day_of_month=5,
+                    last_seen=date(2026, 12, 5),
+                    next_expected=date(2027, 1, 5),
+                )
+            ],
+            id="E1-1",
+        ),
+        pytest.param(
+            [
+                ex("2026-01-31", 1200, category="通信", memo="ネット"),
+                ex("2026-02-28", 1200, category="通信", memo="ネット"),
+                ex("2026-03-31", 1200, category="通信", memo="ネット"),
+            ],
+            3,
+            [
+                Recurring(
+                    category="通信",
+                    memo="ネット",
+                    amount=1200,
+                    count=3,
+                    day_of_month=31,
+                    last_seen=date(2026, 3, 31),
+                    next_expected=date(2026, 4, 30),
+                )
+            ],
+            id="E1-2",
+        ),
+        pytest.param(
+            [
+                ex("2026-01-10", 500, category="保険", memo="生命"),
+                ex("2026-02-10", 500, category="保険", memo="生命"),
+                ex("2026-04-10", 500, category="保険", memo="生命"),
+            ],
+            3,
+            [],
+            id="E1-3",
+        ),
+    ],
+)
+def test_example_table(
+    rows: list[Expense], min_months: int, expected: list[Recurring]
+) -> None:
+    assert find_recurring(rows, min_months=min_months) == expected
+
+
+def test_e1_2_leap_year_clips_to_feb_29() -> None:
+    rows = [ex("2028-01-31", 100), ex("2028-02-29", 100), ex("2028-03-31", 100)]
+    (r,) = find_recurring(rows)
+    assert r.next_expected == date(2028, 4, 30)
+    rows = [ex("2027-11-30", 100), ex("2027-12-31", 100), ex("2028-01-31", 100)]
+    (r,) = find_recurring(rows)
+    assert r.next_expected == date(2028, 2, 29)
+
+
+def test_r1_tolerance_groups_close_amounts() -> None:
+    rows = [ex("2026-01-05", 1000), ex("2026-02-05", 1040), ex("2026-03-05", 1000)]
+    assert find_recurring(rows, tolerance=0.0) == []
+    (r,) = find_recurring(rows, tolerance=0.05)
+    assert r.amount == 1000
+    assert r.count == 3
+
+
+def test_r1_price_increase_is_a_separate_series() -> None:
+    rows = [
+        ex("2026-01-05", 1000),
+        ex("2026-02-05", 1000),
+        ex("2026-03-05", 1000),
+        ex("2026-04-05", 2000),
+        ex("2026-05-05", 2000),
+        ex("2026-06-05", 2000),
+    ]
+    result = find_recurring(rows)
+    assert [(r.amount, r.count) for r in result] == [(1000, 3), (2000, 3)]
+
+
+def test_r2_same_month_twice_excludes_series() -> None:
+    rows = [
+        ex("2026-01-05", 1000),
+        ex("2026-02-05", 1000),
+        ex("2026-02-20", 1000),
+        ex("2026-03-05", 1000),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_r2_only_last_contiguous_run_counts() -> None:
+    rows = [
+        ex("2026-01-05", 1000),
+        ex("2026-02-05", 1000),
+        ex("2026-03-05", 1000),
+        ex("2026-05-05", 1000),
+        ex("2026-06-05", 1000),
+    ]
+    assert find_recurring(rows, min_months=3) == []
+    (r,) = find_recurring(rows, min_months=2)
+    assert r.count == 2
+    assert r.last_seen == date(2026, 6, 5)
+
+
+def test_r5_refunds_are_ignored() -> None:
+    rows = [
+        ex("2026-01-05", 1000),
+        ex("2026-02-05", 1000),
+        ex("2026-03-05", 1000),
+        ex("2026-03-06", -1000),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.count == 3
+
+
+def test_d3_memo_normalization_groups_same_series() -> None:
+    rows = [
+        ex("2026-01-05", 1000, memo="ＮＥＴ #1"),
+        ex("2026-02-05", 1000, memo="net  2"),
+        ex("2026-03-05", 1000, memo="Net"),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.count == 3
+
+
+def test_r4_sorted_by_next_expected_then_category() -> None:
+    rows = [
+        ex("2026-01-20", 1, category="B"),
+        ex("2026-02-20", 1, category="B"),
+        ex("2026-03-20", 1, category="B"),
+        ex("2026-01-10", 1, category="A"),
+        ex("2026-02-10", 1, category="A"),
+        ex("2026-03-10", 1, category="A"),
+    ]
+    assert [r.category for r in find_recurring(rows)] == ["A", "B"]
+
+
+def test_r6_empty_input() -> None:
+    assert find_recurring([]) == []
+
+
+@pytest.mark.parametrize("tolerance", [-0.1, 1.5, float("nan")])
+def test_r6_tolerance_out_of_range(tolerance: float) -> None:
+    with pytest.raises(ValueError, match="tolerance"):
+        find_recurring([], tolerance=tolerance)
+
+
+def test_r6_min_months_below_two() -> None:
+    with pytest.raises(ValueError, match="min_months"):
+        find_recurring([], min_months=1)
+
+
+def test_r6_rows_must_be_list() -> None:
+    with pytest.raises(TypeError, match="rows"):
+        find_recurring(())  # type: ignore[arg-type]
+
+
+def test_d2_bool_tolerance_is_rejected() -> None:
+    with pytest.raises(TypeError, match="tolerance"):
+        find_recurring([], tolerance=True)  # type: ignore[arg-type]
diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..eed8078
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,134 @@
+from datetime import date, datetime
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    all_of,
+    amount_range,
+    any_of,
+    between,
+    category,
+    memo_contains,
+    not_,
+    search,
+)
+
+ROWS = [
+    Expense(date(2026, 1, 5), "食費", 1000, "ランチ"),
+    Expense(date(2026, 1, 31), "日用品", -300, "返金 Coffee"),
+    Expense(date(2026, 2, 28), "食費", 2500, "Dinner #2"),
+    Expense(date(2026, 3, 1), "交通費", 0, ""),
+]
+
+
+# 仕様の例の表 (E3-1 〜 E3-3) をそのままテストにする。
+@pytest.mark.parametrize(
+    ("case_id", "query", "expected"),
+    [
+        # E3-1: amount_range(1000, 1000) で 1000 円の行 -> 一致 (R1)
+        ("E3-1", amount_range(1000, 1000), [ROWS[0]]),
+        # E3-2: all_of() は全件、any_of() は 0 件 (R4)
+        ("E3-2", all_of(), ROWS),
+        ("E3-2", any_of(), []),
+    ],
+    ids=["E3-1", "E3-2-all_of", "E3-2-any_of"],
+)
+def test_spec_examples(case_id: str, query, expected: list[Expense]) -> None:
+    assert search(ROWS, query) == expected
+
+
+def test_E3_3_between_reversed_range_raises() -> None:
+    # E3-3: between(date(2026,2,1), date(2026,1,1)) -> ValueError (R1)
+    with pytest.raises(ValueError):
+        between(date(2026, 2, 1), date(2026, 1, 1))
+
+
+# --- R1: 範囲は両端を含む、None は無制限、下限 > 上限は ValueError ---
+def test_amount_range_includes_negative_refund() -> None:
+    assert search(ROWS, amount_range(-300, -300)) == [ROWS[1]]
+
+
+def test_amount_range_open_ends() -> None:
+    assert search(ROWS, amount_range(min=1000)) == [ROWS[0], ROWS[2]]
+    assert search(ROWS, amount_range(max=0)) == [ROWS[1], ROWS[3]]
+
+
+def test_amount_range_reversed_raises() -> None:
+    with pytest.raises(ValueError):
+        amount_range(10, 5)
+
+
+def test_between_inclusive_and_open() -> None:
+    assert search(ROWS, between(date(2026, 1, 31), date(2026, 2, 28))) == [
+        ROWS[1],
+        ROWS[2],
+    ]
+    assert search(ROWS, between(end=date(2026, 1, 5))) == [ROWS[0]]
+    assert search(ROWS, between(start=date(2026, 3, 1))) == [ROWS[3]]
+
+
+# --- R2: category は完全一致 (strip 後)、複数名は OR、引数ゼロは ValueError ---
+def test_category_exact_match_and_or() -> None:
+    assert search(ROWS, category("食費")) == [ROWS[0], ROWS[2]]
+    assert search(ROWS, category(" 交通費 ", "日用品")) == [ROWS[1], ROWS[3]]
+    assert search(ROWS, category("食")) == []
+
+
+def test_category_no_names_raises() -> None:
+    with pytest.raises(ValueError):
+        category()
+
+
+# --- R3 / D5: memo_contains は NFKC・大文字小文字無視の部分一致、空文字は全件 ---
+def test_memo_contains_case_insensitive_and_nfkc() -> None:
+    assert search(ROWS, memo_contains("coffee")) == [ROWS[1]]
+    assert search(ROWS, memo_contains("ＤＩＮＮＥＲ")) == [ROWS[2]]
+    assert search(ROWS, memo_contains("ラン")) == [ROWS[0]]
+
+
+def test_memo_contains_empty_matches_all() -> None:
+    assert search(ROWS, memo_contains("")) == ROWS
+
+
+# --- R4: 入れ子・not_ ---
+def test_nested_composition() -> None:
+    q = all_of(category("食費"), not_(amount_range(min=2000)))
+    assert search(ROWS, q) == [ROWS[0]]
+    q2 = any_of(memo_contains("返金"), amount_range(min=2000))
+    assert search(ROWS, q2) == [ROWS[1], ROWS[2]]
+
+
+# --- R5: 元の並びを保ち、元のリストを変更しない ---
+def test_search_keeps_order_and_does_not_mutate() -> None:
+    rows = list(ROWS)
+    snapshot = list(rows)
+    result = search(rows, all_of())
+    assert result == snapshot
+    assert result is not rows
+    assert rows == snapshot
+
+
+# --- R6: 型違いは TypeError ---
+@pytest.mark.parametrize(
+    "make",
+    [
+        lambda: amount_range(True, None),
+        lambda: amount_range(None, 1.5),  # type: ignore[arg-type]
+        lambda: between(date(2026, 1, 1), "2026-02-01"),  # type: ignore[arg-type]
+        lambda: between(datetime(2026, 1, 1), None),
+        lambda: category(1),  # type: ignore[arg-type]
+        lambda: memo_contains(None),  # type: ignore[arg-type]
+        lambda: all_of(1),  # type: ignore[arg-type]
+        lambda: any_of("x"),  # type: ignore[arg-type]
+        lambda: not_(None),  # type: ignore[arg-type]
+    ],
+)
+def test_type_errors(make) -> None:
+    with pytest.raises(TypeError):
+        make()
+
+
+def test_search_rejects_non_callable_query() -> None:
+    with pytest.raises(TypeError):
+        search(ROWS, "not a query")  # type: ignore[arg-type]
