@@ -0,0 +1,98 @@
+"""Month-over-month comparison of expenses per category (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"([0-9]{4})-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class Change:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _parse_month(value: object, name: str) -> tuple[int, int]:
+    if not isinstance(value, str):
+        raise TypeError(f"{name} は str である必要があります: {type(value).__name__}")
+    m = _MONTH_RE.fullmatch(value)
+    if m is None:
+        raise ValueError(f"{name} は YYYY-MM 形式である必要があります: {value!r}")
+    return int(m.group(1)), int(m.group(2))
+
+
+def _prior_month(year: int, month: int) -> tuple[int, int]:
+    if month > 1:
+        return year, month - 1
+    if year == 0:
+        raise ValueError("0000-01 の前月は求められません")
+    return year - 1, 12
+
+
+def _totals(rows: list[Expense], year: int, month: int) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for e in rows:
+        if e.day.year == year and e.day.month == month:
+            out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def _status(previous: int, current: int, delta: int) -> str:
+    if previous == 0 and current > 0:
+        return "新規"
+    if previous > 0 and current == 0:
+        return "なくなった"
+    if delta > 0:
+        return "増"
+    if delta < 0:
+        return "減"
+    return "変化なし"
+
+
+def compare_months(
+    rows: list[Expense], month: str, previous: str | None = None
+) -> list[Change]:
+    """Compare category totals of `month` against `previous` (default: prior calendar month).
+
+    Refunds (negative amounts) are netted in. Result is sorted by abs(delta) desc,
+    then category asc.
+    """
+    if not isinstance(rows, list):
+        raise TypeError(f"rows は list である必要があります: {type(rows).__name__}")
+    cur_y, cur_m = _parse_month(month, "month")
+    if previous is None:
+        prev_y, prev_m = _prior_month(cur_y, cur_m)
+    else:
+        prev_y, prev_m = _parse_month(previous, "previous")
+        if (prev_y, prev_m) == (cur_y, cur_m):
+            raise ValueError(f"previous と month に同じ月は指定できません: {month!r}")
+
+    cur_totals = _totals(rows, cur_y, cur_m)
+    prev_totals = _totals(rows, prev_y, prev_m)
+
+    changes: list[Change] = []
+    for cat in set(cur_totals) | set(prev_totals):
+        prev_amt = prev_totals.get(cat, 0)
+        cur_amt = cur_totals.get(cat, 0)
+        delta = cur_amt - prev_amt
+        pct = None if prev_amt == 0 else delta / prev_amt * 100
+        changes.append(
+            Change(
+                category=cat,
+                previous=prev_amt,
+                current=cur_amt,
+                delta=delta,
+                pct=pct,
+                status=_status(prev_amt, cur_amt, delta),
+            )
+        )
+    changes.sort(key=lambda c: (-abs(c.delta), c.category))
+    return changes
