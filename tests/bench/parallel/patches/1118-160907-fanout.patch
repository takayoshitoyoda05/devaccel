index 0000000..f921401
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,118 @@
+"""Import bank-statement CSV text into Expense records (standard library only)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"(-?)[¥￥]?([0-9][0-9,]*)円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    """Parse a yen amount such as ' ￥1,234 ', '-¥300' or '980円' into an int."""
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    sign, digits = m.groups()
+    value = int(digits.replace(",", ""))
+    return -value if sign else value
+
+
+def parse_date(s: str) -> date:
+    """Parse 'YYYY/M/D' or 'YYYY-M-D' (separators must match, zero padding optional)."""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    year, _sep, month, day = m.groups()
+    try:
+        return date(int(year), int(month), int(day))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def _cell(row: list[str], index: dict[str, int], column: str) -> str:
+    """Value of the named column in row; missing trailing cells are ''."""
+    pos = index[column]
+    return row[pos] if pos < len(row) else ""
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Read CSV text (header on line 1) into expenses.
+
+    Returns (valid expenses in input order, [(physical line number, field), ...]).
+    Rows with any error are excluded from the expenses.
+    """
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    try:
+        header = next(reader)
+    except StopIteration:
+        raise ValueError("ヘッダー行がありません") from None
+    index = {name: i for i, name in enumerate(header)}
+    for field, column in mapping.items():
+        if column not in index:
+            raise ValueError(f"列 {column!r} がヘッダーにありません({field})")
+
+    category_map = category_map or {}
+    rows: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    line = reader.line_num  # physical line number of the header's last line
+    while True:
+        start = line + 1
+        try:
+            row = next(reader)
+        except StopIteration:
+            break
+        line = reader.line_num
+        if not row or (len(row) == 1 and not row[0].strip()):
+            continue  # blank line: skipped, but counted above
+
+        row_errors: list[tuple[int, str]] = []
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(_cell(row, index, mapping["date"]))
+        except ValueError:
+            row_errors.append((start, "date"))
+        try:
+            amount = parse_amount(_cell(row, index, mapping["amount"]))
+        except ValueError:
+            row_errors.append((start, "amount"))
+        category = _cell(row, index, mapping["category"]).strip()
+        if not category:
+            row_errors.append((start, "category"))
+
+        if row_errors or day is None or amount is None:
+            errors.extend(row_errors)
+            continue
+        memo = _cell(row, index, mapping["memo"]).strip() if "memo" in mapping else ""
+        rows.append(
+            Expense(
+                day=day,
+                category=category_map.get(category, category),
+                amount=amount,
+                memo=memo,
+            )
+        )
+    return rows, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
