+"""Budget alerts: pure functions that flag categories over / nearing budget."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Literal
+
+from kakeibo.core import Budget
+
+Status = Literal["over", "near"]
+
+DEFAULT_NEAR_PERCENT = 80
+
+
+@dataclass(frozen=True)
+class BudgetAlert:
+    month: str
+    category: str
+    status: Status
+    limit: int
+    actual: int
+
+    @property
+    def remaining(self) -> int:
+        """Yen left (negative when over)."""
+        return self.limit - self.actual
+
+    @property
+    def percent(self) -> int | None:
+        """Used percentage, rounded down; None when the limit is 0."""
+        return self.actual * 100 // self.limit if self.limit else None
+
+
+def evaluate_budget(
+    totals: dict[str, dict[str, int]],
+    budget: Budget,
+    near_percent: int = DEFAULT_NEAR_PERCENT,
+) -> list[BudgetAlert]:
+    """Return alerts for every (month, category) with a budget.
+
+    "over": actual > limit. "near": near_percent% <= used <= 100% of limit
+    (exactly at the limit is "near", not "over"). Categories without a budget
+    and spending of 0 are never flagged. Output is ordered by month, then
+    over before near, then by overshoot descending.
+    """
+    if not 0 < near_percent <= 100:
+        raise ValueError("near_percent は 1〜100 の整数である必要があります")
+    alerts: list[BudgetAlert] = []
+    for month in sorted(totals):
+        limits = budget.for_month(month)
+        for cat, actual in totals[month].items():
+            if cat not in limits or actual <= 0:
+                continue
+            limit = limits[cat]
+            if actual > limit:
+                alerts.append(BudgetAlert(month, cat, "over", limit, actual))
+            elif actual * 100 >= limit * near_percent:
+                alerts.append(BudgetAlert(month, cat, "near", limit, actual))
+    alerts.sort(
+        key=lambda a: (a.month, a.status != "over", -(a.actual - a.limit), a.category)
+    )
+    return alerts
+
+
+def format_alert(a: BudgetAlert) -> str:
+    if a.status == "over":
+        return (
+            f"警告: {a.month} {a.category} {-a.remaining:,}円超過 "
+            f"(予算 {a.limit:,} / 実績 {a.actual:,})"
+        )
+    return (
+        f"注意: {a.month} {a.category} 予算の{a.percent}%を使用、残り{a.remaining:,}円 "
+        f"(予算 {a.limit:,} / 実績 {a.actual:,})"
+    )
diff --git a/tests/test_alerts.py b/tests/test_alerts.py
new file mode 100644
