--- /dev/null
+++ b/tests/test_alerts.py
@@ -0,0 +1,75 @@
+import pytest
+
+from kakeibo.alerts import BudgetAlert, evaluate_budget, format_alert
+from kakeibo.core import Budget
+
+B = Budget(default={"food": 1000, "rent": 80000, "zero": 0}, months={})
+
+
+def _food(yen: int) -> dict[str, dict[str, int]]:
+    return {"2026-11": {"food": yen}}
+
+
+def test_over_near_ok():
+    totals = {"2026-11": {"food": 1150, "rent": 64000, "misc": 5000}}
+    assert evaluate_budget(totals, B) == [
+        BudgetAlert("2026-11", "food", "over", 1000, 1150),
+        BudgetAlert("2026-11", "rent", "near", 80000, 64000),
+    ]
+
+
+def test_boundaries():
+    assert evaluate_budget(_food(799), B) == []
+    assert [a.status for a in evaluate_budget(_food(800), B)] == ["near"]
+    assert [a.status for a in evaluate_budget(_food(1000), B)] == ["near"]
+    assert [a.status for a in evaluate_budget(_food(1001), B)] == ["over"]
+
+
+def test_zero_budget():
+    assert evaluate_budget({"2026-11": {"zero": 0}}, B) == []
+    (a,) = evaluate_budget({"2026-11": {"zero": 1}}, B)
+    assert a.status == "over" and a.percent is None
+
+
+def test_month_override_and_ordering():
+    b = Budget({"food": 1000}, {"2026-11": {"food": 5000}})
+    totals = {
+        "2026-11": {"food": 4500, "rent": 1},
+        "2026-10": {"food": 900, "x": 1},
+    }
+    got = evaluate_budget(totals, b)
+    assert [(a.month, a.status) for a in got] == [
+        ("2026-10", "near"),
+        ("2026-11", "near"),
+    ]
+
+
+def test_over_sorted_before_near_within_month():
+    b = Budget({"a": 100, "b": 100, "c": 100}, {})
+    got = evaluate_budget({"2026-11": {"a": 90, "b": 150, "c": 200}}, b)
+    assert [(a.category, a.status) for a in got] == [
+        ("c", "over"),
+        ("b", "over"),
+        ("a", "near"),
+    ]
+
+
+def test_custom_threshold():
+    assert evaluate_budget(_food(500), B) == []
+    assert len(evaluate_budget(_food(500), B, near_percent=50)) == 1
+
+
+@pytest.mark.parametrize("p", [0, -1, 101])
+def test_bad_threshold(p):
+    with pytest.raises(ValueError):
+        evaluate_budget({}, B, near_percent=p)
+
+
+def test_format():
+    over = BudgetAlert("2026-11", "food", "over", 1000, 1150)
+    near = BudgetAlert("2026-11", "food", "near", 1000, 850)
+    assert format_alert(over) == "警告: 2026-11 food 150円超過 (予算 1,000 / 実績 1,150)"
+    assert format_alert(near) == (
+        "注意: 2026-11 food 予算の85%を使用、残り150円 (予算 1,000 / 実績 850)"
+    )
+    assert over.remaining == -150 and near.percent == 85
