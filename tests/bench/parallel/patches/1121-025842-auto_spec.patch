+"""Monthly per-category totals (gap months included as empty)."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def _next_month(year: int, month: int) -> tuple[int, int]:
+    return (year + 1, 1) if month == 12 else (year, month + 1)
+
+
+def monthly_category_totals(rows: list[Expense]) -> dict[str, dict[str, int]]:
+    """{"YYYY-MM": {category: yen}} from the earliest to the latest month.
+
+    Months with no rows map to {}. Months ascend; categories within a month are
+    ordered by amount descending, then by name ascending. Refunds (negative
+    amounts) are summed as ints. `rows` is not modified.
+    """
+    if not rows:
+        return {}
+
+    sums: dict[str, dict[str, int]] = {}
+    for i, row in enumerate(rows):
+        if not isinstance(row, Expense):
+            raise TypeError(
+                f"rows[{i}] は Expense である必要があります: {type(row).__name__}"
+            )
+        if isinstance(row.amount, bool) or not isinstance(row.amount, int):
+            raise TypeError(
+                f"rows[{i}].amount は int である必要があります: {type(row.amount).__name__}"
+            )
+        key = row.day.strftime("%Y-%m")
+        month = sums.setdefault(key, {})
+        month[row.category] = month.get(row.category, 0) + row.amount
+
+    first = min(row.day for row in rows)
+    last = max(row.day for row in rows)
+    year, month_no = first.year, first.month
+    out: dict[str, dict[str, int]] = {}
+    while (year, month_no) <= (last.year, last.month):
+        key = f"{year:04d}-{month_no:02d}"
+        cats = sums.get(key, {})
+        out[key] = dict(sorted(cats.items(), key=lambda kv: (-kv[1], kv[0])))
+        year, month_no = _next_month(year, month_no)
+    return out
