@@ -0,0 +1,120 @@
+import copy
+
+import pytest
+
+from kakeibo.mom import CategoryChange, month_over_month
+
+
+@pytest.mark.parametrize(
+    ("totals", "expected"),
+    [
+        pytest.param(
+            {
+                "2026-01": {"食費": 300, "家賃": 500},
+                "2026-02": {"食費": 100, "趣味": 40},
+            },
+            {
+                "2026-02": [
+                    CategoryChange("家賃", "gone", 500, 0, -500, None),
+                    CategoryChange("食費", "decreased", 300, 100, -200, -200 / 300),
+                    CategoryChange("趣味", "new", 0, 40, 40, None),
+                ]
+            },
+            id="E2-1",
+        ),
+        pytest.param(
+            {"2026-01": {"食費": 300}, "2026-03": {"食費": 300}},
+            {"2026-03": [CategoryChange("食費", "new", 0, 300, 300, None)]},
+            id="E2-2",
+        ),
+        pytest.param(
+            {"2026-01": {"食費": 0}, "2026-02": {"食費": 0}},
+            {"2026-02": []},
+            id="E2-3",
+        ),
+    ],
+)
+def test_spec_examples(totals, expected):
+    assert month_over_month(totals) == expected
+
+
+def test_empty_and_single_month_give_empty_dict():
+    assert month_over_month({}) == {}
+    assert month_over_month({"2026-01": {"食費": 300}}) == {}
+
+
+def test_year_boundary_uses_previous_calendar_month():
+    totals = {"2025-12": {"食費": 100}, "2026-01": {"食費": 150}}
+    assert month_over_month(totals) == {
+        "2026-01": [CategoryChange("食費", "increased", 100, 150, 50, 0.5)]
+    }
+
+
+def test_missing_month_counts_as_empty():
+    totals = {
+        "2026-01": {"食費": 300},
+        "2026-02": {"食費": 300},
+        "2026-04": {"食費": 50},
+    }
+    result = month_over_month(totals)
+    assert list(result) == ["2026-02", "2026-04"]
+    assert result["2026-04"] == [CategoryChange("食費", "new", 0, 50, 50, None)]
+
+
+def test_unchanged_amounts_are_omitted():
+    totals = {
+        "2026-01": {"食費": 300, "家賃": 500},
+        "2026-02": {"食費": 300, "家賃": 500},
+    }
+    assert month_over_month(totals) == {"2026-02": []}
+
+
+def test_negative_amounts_are_compared_as_int():
+    totals = {"2026-01": {"食費": 0}, "2026-02": {"食費": -50}}
+    assert month_over_month(totals) == {
+        "2026-02": [CategoryChange("食費", "new", 0, -50, -50, None)]
+    }
+
+
+def test_ratio_is_none_when_previous_not_positive():
+    totals = {"2026-01": {"食費": -100}, "2026-02": {"食費": 50}}
+    assert month_over_month(totals) == {
+        "2026-02": [CategoryChange("食費", "increased", -100, 50, 150, None)]
+    }
+
+
+def test_ratio_is_not_rounded():
+    totals = {"2026-01": {"食費": 3}, "2026-02": {"食費": 4}}
+    (change,) = month_over_month(totals)["2026-02"]
+    assert change.ratio == 1 / 3
+
+
+def test_sort_by_abs_delta_then_category_name():
+    totals = {
+        "2026-01": {"b": 100, "a": 100, "c": 500},
+        "2026-02": {"b": 0, "a": 200, "c": 0},
+    }
+    names = [c.category for c in month_over_month(totals)["2026-02"]]
+    # |delta|: c=500, a=100, b=100 -> ties broken by name
+    assert names == ["c", "a", "b"]
+
+
+def test_input_is_not_mutated():
+    totals = {"2026-01": {"食費": 300}, "2026-02": {"食費": 100, "趣味": 40}}
+    original = copy.deepcopy(totals)
+    month_over_month(totals)
+    assert totals == original
+
+
+@pytest.mark.parametrize(
+    "bad", [True, False, 1.5, "100"], ids=["true", "false", "float", "str"]
+)
+def test_non_int_amount_raises_type_error(bad):
+    with pytest.raises(TypeError):
+        month_over_month({"2026-01": {"食費": bad}, "2026-02": {"食費": 1}})
+
+
+@pytest.mark.parametrize("bad", ["2026-1", "2026-13", "2026-00", "2026/01", "26-01"])
+def test_invalid_month_key_raises_value_error(bad):
+    with pytest.raises(ValueError):
+        month_over_month({"2026-01": {"食費": 1}, bad: {"食費": 1}})
