+"""Month-over-month category changes (pure functions, standard library only)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    kind: str  # "increased" | "decreased" | "new" | "gone"
+    previous: int
+    current: int
+    delta: int
+    ratio: float | None
+
+
+def _check(totals: dict[str, dict[str, int]]) -> None:
+    for month, cats in totals.items():
+        if not isinstance(month, str) or not _MONTH_RE.fullmatch(month):
+            raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+        for cat, yen in cats.items():
+            if isinstance(yen, bool) or not isinstance(yen, int):
+                raise TypeError(
+                    f"金額は int である必要があります: {month}.{cat} = {yen!r}"
+                )
+
+
+def _previous_month(month: str) -> str:
+    year, mon = int(month[:4]), int(month[5:])
+    if mon == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mon - 1:02d}"
+
+
+def _kind(previous: int, current: int) -> str | None:
+    if previous == 0 and current == 0:
+        return None
+    if previous == 0:
+        return "new"
+    if current == 0:
+        return "gone"
+    if current == previous:
+        return None
+    return "increased" if current > previous else "decreased"
+
+
+def month_over_month(
+    totals: dict[str, dict[str, int]],
+) -> dict[str, list[CategoryChange]]:
+    """Compare each month (except the earliest) with its calendar-previous month.
+
+    A month missing from ``totals`` counts as empty. Result keys are ascending;
+    within a month, changes are sorted by |delta| descending, then category name.
+    """
+    _check(totals)
+    months = sorted(totals)
+    if len(months) <= 1:
+        return {}
+
+    result: dict[str, list[CategoryChange]] = {}
+    for month in months[1:]:
+        current_cats = totals[month]
+        previous_cats = totals.get(_previous_month(month), {})
+        changes: list[CategoryChange] = []
+        for category in set(current_cats) | set(previous_cats):
+            previous = previous_cats.get(category, 0)
+            current = current_cats.get(category, 0)
+            kind = _kind(previous, current)
+            if kind is None:
+                continue
+            delta = current - previous
+            ratio = (
+                delta / previous
+                if kind in ("increased", "decreased") and previous > 0
+                else None
+            )
+            changes.append(
+                CategoryChange(category, kind, previous, current, delta, ratio)
+            )
+        changes.sort(key=lambda c: (-abs(c.delta), c.category))
+        result[month] = changes
+    return result
