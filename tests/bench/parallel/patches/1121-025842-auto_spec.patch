@@ -0,0 +1,94 @@
+from __future__ import annotations
+
+import copy
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthly import monthly_category_totals
+
+
+def ex(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+@pytest.mark.parametrize(
+    ("rows", "expected"),
+    [
+        pytest.param(
+            [ex("2026-01-05", "食費", 300), ex("2026-03-02", "食費", 100)],
+            {"2026-01": {"食費": 300}, "2026-02": {}, "2026-03": {"食費": 100}},
+            id="E1-1",
+        ),
+        pytest.param(
+            [ex("2025-12-31", "食費", 100), ex("2026-01-01", "食費", -30)],
+            {"2025-12": {"食費": 100}, "2026-01": {"食費": -30}},
+            id="E1-2",
+        ),
+        pytest.param(
+            [ex("2026-01-03", "食費", 500), ex("2026-01-04", "交通", 500)],
+            {"2026-01": {"交通": 500, "食費": 500}},
+            id="E1-3",
+        ),
+    ],
+)
+def test_examples(rows: list[Expense], expected: dict[str, dict[str, int]]) -> None:
+    assert monthly_category_totals(rows) == expected
+
+
+def test_empty_rows_returns_empty_dict() -> None:
+    assert monthly_category_totals([]) == {}
+
+
+def test_same_month_and_category_are_summed() -> None:
+    rows = [ex("2026-01-01", "食費", 100), ex("2026-01-20", "食費", 250)]
+    assert monthly_category_totals(rows) == {"2026-01": {"食費": 350}}
+
+
+def test_refund_is_summed_and_zero_total_category_kept() -> None:
+    rows = [ex("2026-01-01", "食費", 500), ex("2026-01-02", "食費", -500)]
+    assert monthly_category_totals(rows) == {"2026-01": {"食費": 0}}
+
+
+def test_categories_sorted_by_amount_desc_then_name_asc() -> None:
+    rows = [
+        ex("2026-01-01", "娯楽", 100),
+        ex("2026-01-01", "衣服", 100),
+        ex("2026-01-01", "食費", 900),
+    ]
+    result = monthly_category_totals(rows)
+    # 同額の 娯楽 / 衣服 はカテゴリ名の昇順(コードポイント順: 娯 U+5A2F < 衣 U+8863)
+    assert list(result["2026-01"]) == ["食費", "娯楽", "衣服"]
+
+
+def test_months_are_in_ascending_order_regardless_of_input_order() -> None:
+    rows = [ex("2026-03-01", "食費", 1), ex("2026-01-01", "食費", 2)]
+    assert list(monthly_category_totals(rows)) == ["2026-01", "2026-02", "2026-03"]
+
+
+def test_single_month_has_no_gap_fill() -> None:
+    assert monthly_category_totals([ex("2026-07-15", "食費", 10)]) == {
+        "2026-07": {"食費": 10}
+    }
+
+
+def test_rows_not_mutated() -> None:
+    rows = [ex("2026-03-02", "食費", 100), ex("2026-01-05", "食費", 300)]
+    before = copy.deepcopy(rows)
+    monthly_category_totals(rows)
+    assert rows == before
+
+
+def test_non_expense_element_raises_type_error_with_index() -> None:
+    rows: list[object] = [ex("2026-01-01", "食費", 1), {"amount": 1}]
+    with pytest.raises(TypeError, match="1"):
+        monthly_category_totals(rows)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad", [True, False, 1.0, "100"])
+def test_non_int_amount_raises_type_error_with_index(bad: object) -> None:
+    bad_row = Expense(day=date(2026, 1, 1), category="食費", amount=bad)  # type: ignore[arg-type]
+    rows = [ex("2026-01-01", "食費", 1), bad_row]
+    with pytest.raises(TypeError, match="1"):
+        monthly_category_totals(rows)
