diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..307a138 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -188,3 +188,92 @@ def test_path_type(runner, cls, expect):
 
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
+
+
+@pytest.mark.parametrize("name", ["a.csv", "a.TSV", "dir/A.Csv", "a.b.csv", ".csv"])
+@pytest.mark.parametrize(
+    "extensions", [[".csv", ".tsv"], ["csv", "TSV"], ("CSV", ".tsv")]
+)
+def test_path_extensions_accepted(name, extensions):
+    assert click.Path(extensions=extensions).convert(name, None, None) == name
+
+
+@pytest.mark.parametrize("name", ["a.txt", "a", "a.csv.bak", "csv", "a.csvx", "a."])
+def test_path_extensions_rejected(name):
+    with pytest.raises(click.BadParameter, match="must have one of the extensions"):
+        click.Path(extensions=[".csv", ".tsv"]).convert(name, None, None)
+
+
+def test_path_extensions_message():
+    with pytest.raises(click.BadParameter, match=r"\.csv, \.tsv\."):
+        click.Path(extensions=["CSV", "tsv"]).convert("a.txt", None, None)
+
+
+def test_path_extensions_single_string_and_multi_dot():
+    t = click.Path(extensions=".tar.gz")
+    assert t.convert("x.TAR.GZ", None, None) == "x.TAR.GZ"
+    with pytest.raises(click.BadParameter):
+        t.convert("x.gz", None, None)
+    # a bare string is one extension, not a collection of characters
+    assert click.Path(extensions="csv").convert("a.csv", None, None) == "a.csv"
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions="csv").convert("a.c", None, None)
+
+
+@pytest.mark.parametrize("bad", [[], (), "", [""], ["."], [".csv", ""]])
+def test_path_extensions_invalid_argument(bad):
+    with pytest.raises(ValueError, match="extensions"):
+        click.Path(extensions=bad)
+
+
+def test_path_extensions_default_unchanged():
+    assert click.Path().extensions is None
+    assert click.Path().convert("a.anything", None, None) == "a.anything"
+
+
+def test_path_extensions_existing_file_and_dir(tmp_path):
+    good = tmp_path / "a.CSV"
+    bad = tmp_path / "a.txt"
+    good.touch()
+    bad.touch()
+    d = tmp_path / "data.txt"
+    d.mkdir()
+    t = click.Path(exists=True, extensions=[".csv"])
+    assert t.convert(str(good), None, None) == str(good)
+    with pytest.raises(click.BadParameter, match="must have one of"):
+        t.convert(str(bad), None, None)
+    # directories are not checked
+    assert t.convert(str(d), None, None) == str(d)
+    # a missing file reports "does not exist" before the extension
+    with pytest.raises(click.BadParameter, match="does not exist"):
+        t.convert(str(tmp_path / "missing.txt"), None, None)
+
+
+def test_path_extensions_nonexistent_checked_and_dash_skipped():
+    t = click.Path(allow_dash=True, extensions=[".csv"])
+    assert t.convert("-", None, None) == "-"
+    with pytest.raises(click.BadParameter):
+        t.convert("new.txt", None, None)
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions=[".csv"]).convert("-", None, None)
+
+
+def test_path_extensions_types():
+    t = click.Path(extensions=[".csv"], path_type=pathlib.Path)
+    assert t.convert("a.CSV", None, None) == pathlib.Path("a.CSV")
+    assert click.Path(extensions=[".csv"]).convert(b"a.csv", None, None) == b"a.csv"
+    assert click.Path(extensions=[".csv"]).convert(pathlib.Path("a.csv"), None, None)
+    with pytest.raises(click.BadParameter):
+        t.convert("a.txt", None, None)
+
+
+def test_path_extensions_cli(runner):
+    @click.command()
+    @click.argument("p", type=click.Path(extensions=[".csv", ".tsv"]))
+    def cli(p):
+        click.echo(p)
+
+    assert runner.invoke(cli, ["x.TSV"]).output == "x.TSV\n"
+    result = runner.invoke(cli, ["x.json"])
+    assert result.exit_code == 2
+    assert "must have one of the extensions .csv, .tsv." in result.output
