     assert expect in exc_info.value.message
+
+
+@pytest.mark.parametrize(
+    ("type", "expect"),
+    [
+        (click.IntRange(min=1), "x>=1"),
+        (click.IntRange(min=1, min_open=True), "x>1"),
+        (click.IntRange(max=5), "x<=5"),
+        (click.IntRange(max=5, max_open=True), "x<5"),
+        (click.FloatRange(min=0.5), "x>=0.5"),
+        (click.FloatRange(min=0.5, min_open=True), "x>0.5"),
+        (click.FloatRange(max=1.5), "x<=1.5"),
+        (click.FloatRange(max=1.5, max_open=True), "x<1.5"),
+    ],
+)
+def test_range_help_text(type, expect):
+    @click.command()
+    @click.option("--n", type=type)
+    def cli(n):
+        pass
+
+    from click.testing import CliRunner
+
+    result = CliRunner().invoke(cli, ["--help"])
+    assert f"[{expect}]" in result.output
