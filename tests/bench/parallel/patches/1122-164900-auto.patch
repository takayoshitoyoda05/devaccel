diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..d300485 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -188,3 +188,91 @@ def test_path_type(runner, cls, expect):
 
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
+
+
+@pytest.mark.parametrize(
+    "name", ["a.csv", "a.tsv", "A.CSV", "a.Tsv", "dir.x/a.csv", "a.b.csv"]
+)
+@pytest.mark.parametrize("exists", [False, True])
+def test_extensions_accept(tmp_path, monkeypatch, name, exists):
+    monkeypatch.chdir(tmp_path)
+    path = tmp_path / name
+    if exists:
+        path.parent.mkdir(exist_ok=True)
+        path.touch()
+    t_ = click.Path(exists=exists, extensions=[".csv", ".tsv"])
+    assert t_.convert(os.fspath(path), None, None) == os.fspath(path)
+
+
+@pytest.mark.parametrize("name", ["a.txt", "a", "a.csv.bak", "csv", ".csv", "a.csv."])
+@pytest.mark.parametrize("exists", [False, True])
+def test_extensions_reject(tmp_path, name, exists):
+    path = tmp_path / name
+    if exists:
+        path.touch()
+    t_ = click.Path(exists=exists, extensions=[".csv", ".tsv"])
+    with pytest.raises(click.BadParameter, match=r"must have one of the extensions"):
+        t_.convert(os.fspath(path), None, None)
+
+
+def test_extensions_message(tmp_path):
+    t_ = click.Path(extensions=["CSV", ".Tsv"])
+    with pytest.raises(click.BadParameter, match=r"\.csv, \.tsv\."):
+        t_.convert(str(tmp_path / "a.txt"), None, None)
+
+
+def test_extensions_spelling(tmp_path):
+    """Leading dot optional, single string allowed, multi-part allowed."""
+    assert click.Path(extensions="csv").convert("a.CSV", None, None) == "a.CSV"
+    assert click.Path(extensions=".csv").convert("a.csv", None, None) == "a.csv"
+    assert click.Path(extensions=["tar.gz"]).convert("a.TAR.GZ", None, None)
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions=".tar.gz").convert("a.gz", None, None)
+    assert click.Path(extensions=iter(["csv"])).extensions == (".csv",)
+
+
+@pytest.mark.parametrize("bad", [[], (), "", [""], ["."], ["csv", ""]])
+def test_extensions_invalid(bad):
+    with pytest.raises(ValueError, match="extensions"):
+        click.Path(extensions=bad)
+
+
+def test_extensions_default_unchanged(tmp_path):
+    assert click.Path().extensions is None
+    assert click.Path().convert("a.anything", None, None) == "a.anything"
+
+
+def test_extensions_directory_and_dash(tmp_path):
+    d = tmp_path / "data.txt"
+    d.mkdir()
+    assert click.Path(extensions="csv").convert(str(d), None, None) == str(d)
+    assert click.Path(extensions="csv", allow_dash=True).convert("-", None, None)
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions="csv").convert("-", None, None)
+
+
+def test_extensions_bytes_and_pathlike():
+    t_ = click.Path(extensions="csv", path_type=pathlib.Path)
+    assert t_.convert(pathlib.Path("A.CSV"), None, None) == pathlib.Path("A.CSV")
+    assert click.Path(extensions="csv").convert(b"a.CSV", None, None) == b"a.CSV"
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions="csv").convert(b"a.txt", None, None)
+
+
+def test_extensions_info_dict():
+    assert click.Path(extensions=["CSV", ".tsv"]).to_info_dict()["extensions"] == [
+        ".csv",
+        ".tsv",
+    ]
+
+
+def test_extensions_cli(runner, tmp_path):
+    @click.command()
+    @click.option("--f", type=click.Path(extensions=[".csv", ".tsv"]))
+    def cli(f):
+        click.echo(f)
+
+    assert runner.invoke(cli, ["--f", "X.TSV"]).output == "X.TSV\n"
+    r = runner.invoke(cli, ["--f", "x.json"])
+    assert r.exit_code == 2
+    assert "must have one of the extensions: .csv, .tsv." in r.output
