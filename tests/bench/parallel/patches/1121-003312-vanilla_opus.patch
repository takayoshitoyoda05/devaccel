@@ -0,0 +1,121 @@
+"""Month-over-month comparison of category spending (pure functions).
+
+前月 = 暦の前月。データに無い月は支出 0(カテゴリなし)として扱う。
+カテゴリの「ある/なし」は集計に名前が現れるかで判定する(合計 0 円でも「ある」)。
+"""
+
+from __future__ import annotations
+
+import re
+from collections.abc import Mapping
+from dataclasses import dataclass
+from enum import StrEnum
+
+from kakeibo.core import Expense, monthly_totals
+
+
+class Status(StrEnum):
+    INCREASED = "increased"  # 増えた
+    DECREASED = "decreased"  # 減った
+    UNCHANGED = "unchanged"  # 変わらない
+    NEW = "new"  # 新しく出てきた
+    GONE = "gone"  # なくなった
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    status: Status
+    previous: int | None  # 前月の円。前月に無ければ None
+    current: int | None  # 当月の円。当月に無ければ None
+
+    @property
+    def diff(self) -> int:
+        """当月 - 前月(無い側は 0 とみなす)。"""
+        return (self.current or 0) - (self.previous or 0)
+
+
+@dataclass(frozen=True)
+class MonthlyReport:
+    month: str  # "YYYY-MM"
+    totals: dict[str, int]  # 当月のカテゴリ別支出(金額降順)
+    previous_month: str | None  # 比較対象。データ最初の月は None
+    changes: list[CategoryChange] | None  # 前月比。データ最初の月は None
+
+
+_MONTH_RE = re.compile(r"([0-9]{4})-(0[1-9]|1[0-2])")
+
+
+def _parse_month(month: str) -> tuple[int, int]:
+    mo = _MONTH_RE.fullmatch(month)
+    if mo is None:
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+    return int(mo[1]), int(mo[2])
+
+
+def _fmt(y: int, m: int) -> str:
+    return f"{y:04d}-{m:02d}"
+
+
+def previous_month(month: str) -> str:
+    """前月を返す。例: 2026-01 -> 2025-12。"""
+    y, m = _parse_month(month)
+    return _fmt(y - 1, 12) if m == 1 else _fmt(y, m - 1)
+
+
+def next_month(month: str) -> str:
+    """翌月を返す。例: 2025-12 -> 2026-01。"""
+    y, m = _parse_month(month)
+    return _fmt(y + 1, 1) if m == 12 else _fmt(y, m + 1)
+
+
+def compare(
+    previous: Mapping[str, int], current: Mapping[str, int]
+) -> list[CategoryChange]:
+    """カテゴリごとの前月比。差額の絶対値が大きい順、同じならカテゴリ名昇順。"""
+    out: list[CategoryChange] = []
+    for cat in previous.keys() | current.keys():
+        prev = previous.get(cat)
+        curr = current.get(cat)
+        if prev is None:
+            status = Status.NEW
+        elif curr is None:
+            status = Status.GONE
+        elif curr > prev:
+            status = Status.INCREASED
+        elif curr < prev:
+            status = Status.DECREASED
+        else:
+            status = Status.UNCHANGED
+        out.append(CategoryChange(cat, status, prev, curr))
+    out.sort(key=lambda c: (-abs(c.diff), c.category))
+    return out
+
+
+def month_over_month(totals: Mapping[str, Mapping[str, int]]) -> list[MonthlyReport]:
+    """{"YYYY-MM": {category: yen}} から月ごとのレポートを作る。
+
+    データの最初の月から最後の月まで、暦の月を1つずつ並べる(途中の
+    データが無い月も totals={} として含める)。最初の月は比較なし。
+    """
+    if not totals:
+        return []
+    months = sorted(totals)
+    for m in months:
+        _parse_month(m)
+    reports: list[MonthlyReport] = []
+    month, last = months[0], months[-1]
+    prev: str | None = None
+    while True:
+        curr_totals = dict(sorted(totals.get(month, {}).items(), key=lambda kv: -kv[1]))
+        changes = None if prev is None else compare(totals.get(prev, {}), curr_totals)
+        reports.append(MonthlyReport(month, curr_totals, prev, changes))
+        if month == last:
+            break
+        prev, month = month, next_month(month)
+    return reports
+
+
+def month_over_month_from_rows(rows: list[Expense]) -> list[MonthlyReport]:
+    """明細から直接 month_over_month を作る。"""
+    return month_over_month(monthly_totals(rows))
diff --git a/tests/test_compare.py b/tests/test_compare.py
new file mode 100644
index 0000000..be81357
--- /dev/null
+++ b/tests/test_compare.py
@@ -0,0 +1,146 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.compare import (
+    CategoryChange,
+    Status,
+    compare,
+    month_over_month,
+    month_over_month_from_rows,
+    next_month,
+    previous_month,
+)
+from kakeibo.core import Expense
+
+
+def _by_cat(changes):
+    return {c.category: c for c in changes}
+
+
+def test_compare_all_statuses():
+    prev = {"food": 1000, "rent": 80000, "hobby": 500, "gift": 3000}
+    curr = {"food": 1500, "rent": 80000, "hobby": 200, "travel": 9000}
+    got = _by_cat(compare(prev, curr))
+    assert got["food"] == CategoryChange("food", Status.INCREASED, 1000, 1500)
+    assert got["hobby"] == CategoryChange("hobby", Status.DECREASED, 500, 200)
+    assert got["rent"] == CategoryChange("rent", Status.UNCHANGED, 80000, 80000)
+    assert got["travel"] == CategoryChange("travel", Status.NEW, None, 9000)
+    assert got["gift"] == CategoryChange("gift", Status.GONE, 3000, None)
+
+
+def test_diff_treats_missing_side_as_zero():
+    got = _by_cat(compare({"a": 100, "b": 300}, {"a": 250, "c": 40}))
+    assert got["a"].diff == 150
+    assert got["b"].diff == -300
+    assert got["c"].diff == 40
+
+
+def test_compare_order_by_abs_diff_then_name():
+    prev = {"a": 100, "b": 500, "z": 10}
+    curr = {"a": 200, "b": 400, "y": 1000}
+    # |diff|: y=1000, a=100, b=100, z=10
+    assert [c.category for c in compare(prev, curr)] == ["y", "a", "b", "z"]
+
+
+def test_compare_zero_yen_category_still_present():
+    got = _by_cat(compare({"refund": 0}, {"refund": 100}))
+    assert got["refund"].status is Status.INCREASED
+
+
+def test_compare_empty():
+    assert compare({}, {}) == []
+
+
+@pytest.mark.parametrize(
+    ("month", "prev", "nxt"),
+    [
+        ("2026-11", "2026-10", "2026-12"),
+        ("2026-01", "2025-12", "2026-02"),
+        ("2025-12", "2025-11", "2026-01"),
+    ],
+)
+def test_month_arithmetic(month, prev, nxt):
+    assert previous_month(month) == prev
+    assert next_month(month) == nxt
+
+
+@pytest.mark.parametrize("bad", ["2026-13", "2026-00", "2026-1", "26-01", "x", ""])
+def test_month_arithmetic_rejects_bad_format(bad):
+    with pytest.raises(ValueError):
+        previous_month(bad)
+
+
+def test_month_over_month_empty():
+    assert month_over_month({}) == []
+
+
+def test_month_over_month_first_month_has_no_comparison():
+    (r,) = month_over_month({"2026-11": {"food": 100}})
+    assert r.month == "2026-11"
+    assert r.totals == {"food": 100}
+    assert r.previous_month is None
+    assert r.changes is None
+
+
+def test_month_over_month_consecutive_months():
+    reports = month_over_month(
+        {
+            "2026-10": {"food": 1000, "gift": 500},
+            "2026-11": {"food": 1200, "travel": 3000},
+        }
+    )
+    assert [r.month for r in reports] == ["2026-10", "2026-11"]
+    nov = reports[1]
+    assert nov.previous_month == "2026-10"
+    assert nov.totals == {"travel": 3000, "food": 1200}
+    assert nov.changes is not None
+    got = _by_cat(nov.changes)
+    assert got["food"].status is Status.INCREASED
+    assert got["travel"].status is Status.NEW
+    assert got["gift"].status is Status.GONE
+
+
+def test_month_over_month_fills_gap_months_and_crosses_year():
+    reports = month_over_month({"2025-12": {"food": 100}, "2026-02": {"food": 300}})
+    assert [r.month for r in reports] == ["2025-12", "2026-01", "2026-02"]
+    jan, feb = reports[1], reports[2]
+    assert jan.totals == {}
+    assert jan.previous_month == "2025-12"
+    assert jan.changes == [CategoryChange("food", Status.GONE, 100, None)]
+    # 前月 = 暦の前月(データのある直近の月ではない)
+    assert feb.previous_month == "2026-01"
+    assert feb.changes == [CategoryChange("food", Status.NEW, None, 300)]
+
+
+def test_month_over_month_totals_sorted_by_amount_desc():
+    (r,) = month_over_month({"2026-11": {"a": 1, "b": 3, "c": 2}})
+    assert list(r.totals) == ["b", "c", "a"]
+
+
+def test_month_over_month_does_not_mutate_input():
+    totals = {"2026-10": {"a": 1}, "2026-11": {"a": 2}}
+    month_over_month(totals)
+    assert totals == {"2026-10": {"a": 1}, "2026-11": {"a": 2}}
+
+
+def test_month_over_month_rejects_bad_month_key():
+    with pytest.raises(ValueError):
+        month_over_month({"2026/11": {"a": 1}})
+
+
+def test_month_over_month_from_rows():
+    rows = [
+        Expense(date(2026, 10, 5), "food", 800),
+        Expense(date(2026, 10, 20), "food", 200),
+        Expense(date(2026, 11, 1), "food", 900),
+        Expense(date(2026, 11, 2), "rent", 80000),
+    ]
+    reports = month_over_month_from_rows(rows)
+    assert [r.month for r in reports] == ["2026-10", "2026-11"]
+    assert reports[0].totals == {"food": 1000}
+    assert reports[1].totals == {"rent": 80000, "food": 900}
+    assert reports[1].changes == [
+        CategoryChange("rent", Status.NEW, None, 80000),
+        CategoryChange("food", Status.DECREASED, 1000, 900),
+    ]
