+"""Import an external statement CSV (given as text) into Expense records.
+
+Pure function: no file I/O. Row problems are collected and raised together as
+CsvError; a missing required column raises ValueError.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from datetime import date
+
+from kakeibo.core import CsvError, Expense
+
+_UNCATEGORIZED = "未分類"
+
+# role -> header aliases (compared after _norm_name)
+_ALIASES: dict[str, tuple[str, ...]] = {
+    "date": ("date", "日付", "利用日", "取引日", "ご利用日", "年月日"),
+    "amount": ("amount", "金額", "利用金額", "ご利用金額", "支払金額"),
+    "withdraw": ("出金", "出金額", "お支払金額", "支払"),
+    "deposit": ("入金", "入金額", "預入"),
+    "memo": (
+        "memo",
+        "description",
+        "摘要",
+        "メモ",
+        "利用店名",
+        "ご利用店名",
+        "内容",
+        "お取引内容",
+    ),
+    "category": ("category", "カテゴリ", "分類"),
+}
+_ROLE_LABEL = {
+    "date": "日付",
+    "amount": "金額",
+    "withdraw": "出金",
+    "deposit": "入金",
+    "memo": "摘要",
+    "category": "カテゴリ",
+}
+
+
+def _norm_name(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).lower().strip()
+
+
+_NAME_TO_ROLE: dict[str, str] = {
+    _norm_name(alias): role for role, aliases in _ALIASES.items() for alias in aliases
+}
+
+_DATE_PATTERNS = (
+    re.compile(
+        r"(?P<y>[0-9]{4})(?P<sep>[-/.])(?P<m>[0-9]{1,2})(?P=sep)(?P<d>[0-9]{1,2})"
+    ),
+    re.compile(r"(?P<y>[0-9]{4})年(?P<m>[0-9]{1,2})月(?P<d>[0-9]{1,2})日"),
+    re.compile(r"(?P<y>[0-9]{4})(?P<m>[0-9]{2})(?P<d>[0-9]{2})"),
+)
+_TIME_RE = re.compile(r"[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?")
+_SIGNS = ("-", "−", "△", "▲")
+
+
+def _detect_delimiter(text: str) -> str:
+    first = re.split(r"\r\n|\r|\n", text, maxsplit=1)[0]
+    return "\t" if first.count("\t") > first.count(",") else ","
+
+
+def _resolve_columns(header: list[str]) -> dict[str, int | None]:
+    found: dict[str, list[int]] = {role: [] for role in _ALIASES}
+    for i, cell in enumerate(header):
+        role = _NAME_TO_ROLE.get(_norm_name(cell))
+        if role is not None:
+            found[role].append(i)
+    for role, idxs in found.items():
+        if len(idxs) > 1:
+            raise ValueError(
+                f"{_ROLE_LABEL[role]} に当たる列が複数あります(見出し: {header})"
+            )
+    return {role: (idxs[0] if idxs else None) for role, idxs in found.items()}
+
+
+def _parse_date(raw: str) -> date:
+    s = unicodedata.normalize("NFKC", raw).strip()
+    parts = s.split(None, 1)
+    body = parts[0] if parts else ""
+    if len(parts) == 2 and not _TIME_RE.fullmatch(parts[1].strip()):
+        raise ValueError(f"日付が不正です: {raw!r}")
+    for pat in _DATE_PATTERNS:
+        m = pat.fullmatch(body)
+        if m is not None:
+            try:
+                return date(int(m["y"]), int(m["m"]), int(m["d"]))
+            except ValueError:
+                break
+    raise ValueError(f"日付が不正です: {raw!r}")
+
+
+def _parse_amount(raw: str, label: str) -> int:
+    t = unicodedata.normalize("NFKC", raw)
+    t = re.sub(r"JPY|¥|￥|円", "", t, flags=re.IGNORECASE)
+    t = re.sub(r"\s+", "", t.replace(",", ""))
+    neg = False
+    if t.startswith("(") and t.endswith(")"):
+        neg, t = True, t[1:-1]
+    elif t[:1] in _SIGNS:
+        neg, t = True, t[1:]
+    elif t.endswith("-"):
+        neg, t = True, t[:-1]
+    if not re.fullmatch(r"[0-9]+", t):
+        raise ValueError(f"{label}が不正です: {raw!r}")
+    value = int(t)
+    return -value if neg else value
+
+
+def _is_blank(row: list[str]) -> bool:
+    return all(not cell.strip() for cell in row)
+
+
+def import_statement(text: str) -> list[Expense]:
+    """Parse statement CSV text into Expense records (input order)."""
+    if not isinstance(text, str):
+        raise TypeError(f"text は str である必要があります: {type(text).__name__}")
+    text = text.removeprefix("﻿")
+    if not text.strip():
+        return []
+
+    reader = csv.reader(
+        io.StringIO(text, newline=""), delimiter=_detect_delimiter(text)
+    )
+    records: list[tuple[int, list[str]]] = []
+    prev_end = 0
+    for row in reader:
+        start = prev_end + 1
+        prev_end = reader.line_num
+        if not _is_blank(row):
+            records.append((start, row))
+    if not records:
+        return []
+
+    _, header = records[0]
+    cols = _resolve_columns(header)
+    if cols["date"] is None:
+        raise ValueError(f"必須列 日付 がありません(見出し: {header})")
+    has_amount = cols["amount"] is not None
+    has_split = cols["withdraw"] is not None or cols["deposit"] is not None
+    if has_amount and not has_split:
+        mode = "amount"
+    elif (
+        cols["withdraw"] is not None and cols["deposit"] is not None and not has_amount
+    ):
+        mode = "split"
+    else:
+        raise ValueError(
+            "金額の列が不正です(金額 1 列、または出金と入金の 2 列のどちらか)"
+            f"(見出し: {header})"
+        )
+
+    n = len(header)
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    for start, row in records[1:]:
+        if len(row) != n:
+            errors.append((start, f"列数が不正です: 期待 {n} 実際 {len(row)}"))
+            continue
+
+        reasons: list[str] = []
+        day: date | None = None
+        amount: int | None = None
+        skip = False
+
+        try:
+            day = _parse_date(row[cols["date"]])  # type: ignore[index]
+        except ValueError as e:
+            reasons.append(str(e))
+
+        if mode == "amount":
+            try:
+                amount = _parse_amount(row[cols["amount"]], "金額")  # type: ignore[index]
+            except ValueError as e:
+                reasons.append(str(e))
+        else:
+            w_raw = row[cols["withdraw"]]  # type: ignore[index]
+            d_raw = row[cols["deposit"]]  # type: ignore[index]
+            w_empty = not w_raw.strip()
+            d_empty = not d_raw.strip()
+            if w_empty and d_empty:
+                reasons.append("出金と入金が両方空です")
+            elif w_empty:
+                skip = True  # 入金のみの行は取り込まない
+            elif not d_empty:
+                reasons.append(
+                    f"出金と入金が両方あります: 出金 {w_raw!r}, 入金 {d_raw!r}"
+                )
+            else:
+                try:
+                    amount = _parse_amount(w_raw, "出金")
+                except ValueError as e:
+                    reasons.append(str(e))
+
+        if reasons:
+            errors.append((start, "; ".join(reasons)))
+            continue
+        if skip:
+            continue
+
+        cat_idx = cols["category"]
+        category = (
+            row[cat_idx].strip() if cat_idx is not None else ""
+        ) or _UNCATEGORIZED
+        memo_idx = cols["memo"]
+        memo = (
+            unicodedata.normalize("NFKC", row[memo_idx]).strip()
+            if memo_idx is not None
+            else ""
+        )
+        assert day is not None and amount is not None
+        expenses.append(Expense(day=day, category=category, amount=amount, memo=memo))
+
+    if errors:
+        raise CsvError(errors)
+    return expenses
