new file mode 100644
index 0000000..326faf4
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,112 @@
+"""Conditional search over Expense rows (pure functions)."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable
+from datetime import date, datetime
+
+from kakeibo.core import Expense
+
+Predicate = Callable[[Expense], bool]
+
+_LOGIC_KEYS = ("and", "or", "not")
+_LEAF_KEYS = ("category", "amount_min", "amount_max", "memo", "date_from", "date_to")
+
+
+def _norm(s: str) -> str:
+    """D4: NFKC 正規化 + 大文字小文字を区別しない + 前後空白除去。"""
+    return unicodedata.normalize("NFKC", s).casefold().strip()
+
+
+def _str(v: object, key: str) -> str:
+    if not isinstance(v, str):
+        raise ValueError(f"{key} は文字列である必要があります: {v!r}")  # noqa: TRY004  # R3: 型違いは ValueError
+    return v
+
+
+def _int(v: object, key: str) -> int:
+    if isinstance(v, bool) or not isinstance(v, int):
+        raise ValueError(f"{key} は整数である必要があります: {v!r}")  # noqa: TRY004  # R3: 型違いは ValueError
+    return v
+
+
+def _date(v: object, key: str) -> date:
+    if not isinstance(v, date) or isinstance(v, datetime):
+        raise ValueError(f"{key} は date である必要があります: {v!r}")  # noqa: TRY004  # R3: 型違いは ValueError
+    return v
+
+
+def make_filter(spec: dict) -> Predicate:
+    """条件 spec を検証し、Expense を受けて真偽を返す述語を返す。"""
+    if not isinstance(spec, dict):
+        raise ValueError(f"spec は dict である必要があります: {type(spec).__name__}")  # noqa: TRY004  # R3
+    logic = [k for k in _LOGIC_KEYS if k in spec]
+    if logic:
+        if len(spec) != 1:
+            raise ValueError(f"and/or/not は他のキーと混ぜられません: {sorted(spec)}")
+        return _logic(logic[0], spec[logic[0]])
+    return _leaves(spec)
+
+
+def _logic(op: str, value: object) -> Predicate:
+    if op == "not":
+        if not isinstance(value, dict):
+            raise ValueError("not の値は dict である必要があります")
+        inner = make_filter(value)
+        return lambda e: not inner(e)
+    if not isinstance(value, list):
+        raise ValueError(f"{op} の値は list である必要があります: {value!r}")  # noqa: TRY004  # R3
+    subs = [make_filter(s) for s in value]
+    if op == "and":
+        return lambda e: all(p(e) for p in subs)
+    return lambda e: any(p(e) for p in subs)
+
+
+def _leaves(spec: dict) -> Predicate:
+    for key in spec:
+        if key not in _LEAF_KEYS:
+            raise ValueError(f"未知のキーです: {key!r}")
+
+    checks: list[Predicate] = []
+
+    if "category" in spec:
+        cats = spec["category"]
+        if isinstance(cats, list):
+            if not cats:
+                raise ValueError("category の空リストは使えません")
+            names = {_norm(_str(c, "category")) for c in cats}
+        else:
+            names = {_norm(_str(cats, "category"))}
+        checks.append(lambda e: _norm(e.category) in names)
+
+    lo = _int(spec["amount_min"], "amount_min") if "amount_min" in spec else None
+    hi = _int(spec["amount_max"], "amount_max") if "amount_max" in spec else None
+    if lo is not None and hi is not None and lo > hi:
+        raise ValueError(f"amount_min ({lo}) > amount_max ({hi})")
+    if lo is not None:
+        checks.append(lambda e: e.amount >= lo)
+    if hi is not None:
+        checks.append(lambda e: e.amount <= hi)
+
+    if "memo" in spec:
+        needle = _norm(_str(spec["memo"], "memo"))
+        if needle:
+            checks.append(lambda e: needle in _norm(e.memo))
+
+    d_from = _date(spec["date_from"], "date_from") if "date_from" in spec else None
+    d_to = _date(spec["date_to"], "date_to") if "date_to" in spec else None
+    if d_from is not None and d_to is not None and d_from > d_to:
+        raise ValueError(f"date_from ({d_from}) > date_to ({d_to})")
+    if d_from is not None:
+        checks.append(lambda e: e.day >= d_from)
+    if d_to is not None:
+        checks.append(lambda e: e.day <= d_to)
+
+    return lambda e: all(c(e) for c in checks)
+
+
+def search(rows: list[Expense], spec: dict) -> list[Expense]:
+    """spec に合う行を入力の順序のまま新しい list で返す。"""
+    pred = make_filter(spec)
+    return [e for e in rows if pred(e)]
