@@ -0,0 +1,172 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import make_filter, search
+
+ROWS = [
+    Expense(date(2026, 1, 5), "食費", 1000, "ランチ"),
+    Expense(date(2026, 1, 6), "食費", 999, "コンビニ"),
+    Expense(date(2026, 1, 7), "食費", 1001, "スーパー"),
+    Expense(date(2026, 2, 1), "交通費", 1000, "電車"),
+    Expense(date(2026, 2, 2), "Food", 500, "Coffee shop"),
+]
+
+
+# --- 例の表 (E3) -----------------------------------------------------------
+
+
+def test_E3_1_amount_range_includes_both_ends() -> None:
+    """E3-1: 食費で金額 1000 は amount_min=amount_max=1000 に含まれる(端を含む)。"""
+    spec = {"category": "食費", "amount_min": 1000, "amount_max": 1000}
+    assert search(ROWS, spec) == [ROWS[0]]
+
+
+def test_E3_2_empty_or_matches_nothing() -> None:
+    """E3-2: 空の or はどれも通らない。"""
+    assert search(ROWS, {"or": []}) == []
+
+
+def test_E3_3_unknown_key_raises_with_key_name() -> None:
+    """E3-3: 未知のキー cat は ValueError(キー名 cat を含む)。"""
+    with pytest.raises(ValueError, match="cat"):
+        make_filter({"cat": "食費"})
+
+
+# --- R1 葉の条件 ------------------------------------------------------------
+
+
+def test_leaf_keys_are_anded() -> None:
+    spec = {"category": "食費", "amount_max": 1000, "memo": "コンビニ"}
+    assert search(ROWS, spec) == [ROWS[1]]
+
+
+def test_category_list_is_or() -> None:
+    assert search(ROWS, {"category": ["交通費", "Food"]}) == [ROWS[3], ROWS[4]]
+
+
+def test_empty_category_list_raises() -> None:
+    with pytest.raises(ValueError, match="category"):
+        make_filter({"category": []})
+
+
+def test_category_match_ignores_case_width_and_surrounding_space() -> None:
+    """D4: NFKC 正規化・大文字小文字無視・前後空白除去。"""
+    assert search(ROWS, {"category": " ｆｏｏｄ "}) == [ROWS[4]]
+
+
+def test_memo_is_partial_match() -> None:
+    assert search(ROWS, {"memo": "ンビニ"}) == [ROWS[1]]
+
+
+def test_empty_memo_is_always_true() -> None:
+    assert search(ROWS, {"memo": ""}) == ROWS
+
+
+def test_amount_min_only() -> None:
+    assert search(ROWS, {"amount_min": 1000}) == [ROWS[0], ROWS[2], ROWS[3]]
+
+
+def test_date_range_includes_both_ends() -> None:
+    spec = {"date_from": date(2026, 1, 6), "date_to": date(2026, 2, 1)}
+    assert search(ROWS, spec) == [ROWS[1], ROWS[2], ROWS[3]]
+
+
+def test_reversed_amount_range_raises() -> None:
+    with pytest.raises(ValueError, match="amount"):
+        make_filter({"amount_min": 2, "amount_max": 1})
+
+
+def test_reversed_date_range_raises() -> None:
+    with pytest.raises(ValueError, match="date"):
+        make_filter({"date_from": date(2026, 2, 1), "date_to": date(2026, 1, 1)})
+
+
+@pytest.mark.parametrize(
+    "spec",
+    [
+        {"amount_min": True},
+        {"amount_max": 1.5},
+        {"amount_min": "1000"},
+        {"category": 1},
+        {"memo": None},
+        {"date_from": "2026-01-01"},
+        {"date_to": 20260101},
+    ],
+)
+def test_wrong_value_types_raise(spec: dict) -> None:
+    with pytest.raises(ValueError):
+        make_filter(spec)
+
+
+# --- R2 論理 ----------------------------------------------------------------
+
+
+def test_and_list() -> None:
+    spec = {"and": [{"category": "食費"}, {"amount_min": 1001}]}
+    assert search(ROWS, spec) == [ROWS[2]]
+
+
+def test_or_list() -> None:
+    spec = {"or": [{"category": "交通費"}, {"memo": "Coffee"}]}
+    assert search(ROWS, spec) == [ROWS[3], ROWS[4]]
+
+
+def test_not() -> None:
+    assert search(ROWS, {"not": {"category": "食費"}}) == [ROWS[3], ROWS[4]]
+
+
+def test_nested_logic() -> None:
+    spec = {
+        "or": [
+            {"and": [{"category": "食費"}, {"not": {"amount_max": 999}}]},
+            {"memo": "電車"},
+        ]
+    }
+    assert search(ROWS, spec) == [ROWS[0], ROWS[2], ROWS[3]]
+
+
+def test_empty_and_is_true() -> None:
+    assert search(ROWS, {"and": []}) == ROWS
+
+
+def test_logic_key_mixed_with_other_keys_raises() -> None:
+    with pytest.raises(ValueError):
+        make_filter({"and": [], "category": "食費"})
+
+
+def test_two_logic_keys_in_one_dict_raises() -> None:
+    with pytest.raises(ValueError):
+        make_filter({"and": [], "or": []})
+
+
+def test_and_value_must_be_list() -> None:
+    with pytest.raises(ValueError, match="and"):
+        make_filter({"and": {"category": "食費"}})
+
+
+def test_unknown_key_nested_raises_with_key_name() -> None:
+    with pytest.raises(ValueError, match="bogus"):
+        make_filter({"or": [{"category": "食費"}, {"bogus": 1}]})
+
+
+# --- R3 / R4 ----------------------------------------------------------------
+
+
+def test_empty_spec_matches_all() -> None:
+    assert search(ROWS, {}) == ROWS
+
+
+def test_empty_rows_still_validates_spec() -> None:
+    assert search([], {"category": "食費"}) == []
+    with pytest.raises(ValueError, match="cat"):
+        search([], {"cat": "食費"})
+
+
+def test_search_preserves_order_and_does_not_mutate_input() -> None:
+    before = list(ROWS)
+    result = search(ROWS, {"amount_min": 0})
+    assert result == ROWS
+    assert result is not ROWS
+    assert ROWS == before
