--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,135 @@
+"""Detect recurring expenses (subscriptions, rent, ...) from Expense rows."""
+
+from __future__ import annotations
+
+import calendar
+import json
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    key: str
+    category: str
+    memo: str
+    amount: int
+    months: int
+    last: date
+    next_expected: date
+
+
+# 末尾の数字・`#` 番号・空白を取り除く(R1)。
+_TRAILING_RE = re.compile(r"(?:[\s#]*\d+|[\s#]+)[\s#]*$")
+
+
+def _norm(text: str) -> str:
+    """D4: NFKC 正規化 + 前後空白除去 + 大文字小文字を区別しない。"""
+    return unicodedata.normalize("NFKC", text).strip().casefold()
+
+
+def _memo_key(memo: str) -> str:
+    s = _norm(memo)
+    while True:
+        t = _TRAILING_RE.sub("", s, count=1)
+        if t == s:
+            return s
+        s = t
+
+
+def _check_int(name: str, value: object) -> int:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{name} は整数である必要があります: {value!r}")
+    return value
+
+
+def _lower_median(xs: list[int]) -> int:
+    s = sorted(xs)
+    return s[(len(s) - 1) // 2]
+
+
+def _latest_segment(
+    run: list[int], amounts: dict[int, int], tolerance_pct: int
+) -> list[int]:
+    """run(連続月の並び)を中央値基準で区切り、最後の月を含む区間を返す。"""
+    med = _lower_median([amounts[m] for m in run])
+    inlier = [abs(amounts[m] - med) * 100 <= tolerance_pct * med for m in run]
+    i = len(run) - 1
+    if inlier[i]:
+        while i > 0 and inlier[i - 1]:
+            i -= 1
+    return run[i:]
+
+
+def find_recurring(
+    rows: list[Expense], min_months: int = 3, tolerance_pct: int = 10
+) -> list[Recurring]:
+    min_months = _check_int("min_months", min_months)
+    if min_months < 2:
+        raise ValueError(f"min_months は 2 以上である必要があります: {min_months}")
+    tolerance_pct = _check_int("tolerance_pct", tolerance_pct)
+    if not 0 <= tolerance_pct <= 100:
+        raise ValueError(
+            f"tolerance_pct は 0 以上 100 以下である必要があります: {tolerance_pct}"
+        )
+    if rows is None:
+        raise TypeError("rows は list[Expense] である必要があります")
+
+    # R1・R2: 系列ごとにまとめる(返金・0 円は除く)
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        _check_int("amount", e.amount)
+        if e.amount <= 0:
+            continue
+        key = (_norm(e.category), _memo_key(e.memo))
+        groups.setdefault(key, []).append(e)
+
+    out: list[Recurring] = []
+    for (cat_n, memo_n), items in groups.items():
+        # R3: 同じ月は日付が最も遅い 1 件だけ使う
+        per_month: dict[int, Expense] = {}
+        for e in items:
+            m = e.day.year * 12 + e.day.month - 1
+            cur = per_month.get(m)
+            if cur is None or e.day > cur.day:
+                per_month[m] = e
+        months = sorted(per_month)
+
+        # R4: 直近の連続した月の区間
+        start = len(months) - 1
+        while start > 0 and months[start - 1] == months[start] - 1:
+            start -= 1
+        run = months[start:]
+
+        # R5: 中央値から tolerance_pct % 以内の区間のうち、直近のものを使う
+        amounts = {m: per_month[m].amount for m in run}
+        seg = _latest_segment(run, amounts, tolerance_pct)
+        if len(seg) < min_months:
+            continue
+
+        last_rec = per_month[seg[-1]]
+        last = last_rec.day
+        # R6: 基準日 = 区間の各月の「日」の最大値、翌月に置き月末で丸める(D5)
+        base_day = max(per_month[m].day.day for m in seg)
+        y, mo = (last.year + 1, 1) if last.month == 12 else (last.year, last.month + 1)
+        next_day = min(base_day, calendar.monthrange(y, mo)[1])
+
+        out.append(
+            Recurring(
+                key=json.dumps([cat_n, memo_n], ensure_ascii=False),
+                category=last_rec.category,
+                memo=last_rec.memo,
+                amount=last_rec.amount,
+                months=len(seg),
+                last=last,
+                next_expected=date(y, mo, next_day),
+            )
+        )
+
+    # R7: 金額降順、同点は key 昇順
+    out.sort(key=lambda r: (-r.amount, r.key))
+    return out
