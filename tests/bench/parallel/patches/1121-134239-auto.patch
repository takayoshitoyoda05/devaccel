@@ -0,0 +1,52 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import find_recurring
+
+
+def _netflix() -> list[Expense]:
+    return [
+        Expense(date(2026, 1, 31), "通信", 1490, "NETFLIX"),
+        Expense(date(2026, 2, 28), "通信", 1490, "NETFLIX"),
+        Expense(date(2026, 3, 31), "通信", 1490, "NETFLIX"),
+    ]
+
+
+def _rent_then_drop() -> list[Expense]:
+    return [
+        Expense(date(2026, 1, 5), "住居", 80000, "家賃"),
+        Expense(date(2026, 2, 5), "住居", 80000, "家賃"),
+        Expense(date(2026, 3, 5), "住居", 80000, "家賃"),
+        Expense(date(2026, 4, 5), "住居", 60000, "家賃"),
+    ]
+
+
+@pytest.mark.parametrize(
+    ("rows", "min_months", "expected"),
+    [
+        # E2-1: 1/31・2/28・3/31 → 翌月 4 月は末日 30 日に丸める(R6, D5)
+        pytest.param(
+            _netflix(),
+            3,
+            [("NETFLIX", 3, date(2026, 4, 30))],
+            id="E2-1",
+        ),
+        # E2-2: 1〜3 月 80000 のあと 4 月 60000 → 直近の区間は 1 か月のみ → 出力なし(R5, R4)
+        pytest.param(_rent_then_drop(), 3, [], id="E2-2"),
+        # E2-3: min_months=1 は ValueError(min_months)(R4)
+        pytest.param([], 1, ValueError, id="E2-3"),
+    ],
+)
+def test_spec_table(
+    rows: list[Expense],
+    min_months: int,
+    expected: list[tuple[str, int, date]] | type[ValueError],
+) -> None:
+    if expected is ValueError:
+        with pytest.raises(ValueError, match="min_months"):
+            find_recurring(rows, min_months=min_months)
+        return
+    result = find_recurring(rows, min_months=min_months)
+    assert [(r.memo, r.months, r.next_expected) for r in result] == expected
