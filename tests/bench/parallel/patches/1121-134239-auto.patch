+from datetime import date
+
+import pytest
+
+from kakeibo.compare import CategoryChange, compare_months, format_report
+from kakeibo.core import Expense
+
+
+def _e(y: int, m: int, cat: str, amount: int) -> Expense:
+    return Expense(day=date(y, m, 1), category=cat, amount=amount)
+
+
+ROWS = [
+    _e(2026, 1, "食費", 60000),
+    _e(2026, 2, "食費", 75000),
+    _e(2026, 1, "交通費", 3000),
+]
+
+
+# 例の表 (E4-*) をそのままテストにする。
+@pytest.mark.parametrize(
+    ("case_id", "call", "expected"),
+    [
+        (
+            "E4-1",
+            lambda: compare_months(ROWS, "2026-02"),
+            {"category": "食費", "diff": 15000, "pct": 25.0, "status": "増"},
+        ),
+        (
+            "E4-2",
+            lambda: compare_months(ROWS, "2026-02"),
+            {"category": "交通費", "pct": -100.0, "status": "なくなった"},
+        ),
+    ],
+    ids=["E4-1", "E4-2"],
+)
+def test_example_table(case_id, call, expected):
+    changes = {c.category: c for c in call()}
+    c = changes[expected["category"]]
+    for key in ("diff", "pct", "status"):
+        if key in expected:
+            assert getattr(c, key) == expected[key], case_id
+
+
+@pytest.mark.parametrize("case_id", ["E4-3"])
+def test_example_table_bad_month_format(case_id):
+    with pytest.raises(ValueError):
+        compare_months(ROWS, "2026-1")
+
+
+# --- 規則の端のケース ---
+
+
+def test_R1_previous_none_uses_previous_calendar_month():
+    rows = [_e(2025, 12, "食費", 1000), _e(2026, 1, "食費", 2000)]
+    (c,) = compare_months(rows, "2026-01")
+    assert (c.previous, c.current, c.diff) == (1000, 2000, 1000)
+
+
+def test_R1_explicit_previous_is_validated():
+    with pytest.raises(ValueError):
+        compare_months(ROWS, "2026-02", "2026-13")
+
+
+def test_R1_same_month_raises_value_error():
+    with pytest.raises(ValueError):
+        compare_months(ROWS, "2026-02", "2026-02")
+
+
+def test_R2_month_missing_from_data_compares_as_zero():
+    (c,) = compare_months(ROWS, "2026-03", "2026-02")
+    assert (c.category, c.previous, c.current) == ("食費", 75000, 0)
+    assert c.status == "なくなった"
+
+
+def test_R2_refund_is_subtracted():
+    rows = [_e(2026, 1, "食費", 5000), _e(2026, 2, "食費", -2000)]
+    (c,) = compare_months(rows, "2026-02")
+    assert (c.previous, c.current, c.diff) == (5000, -2000, -7000)
+
+
+def test_R2_category_absent_in_both_months_is_not_listed():
+    rows = [_e(2026, 1, "食費", 100)]
+    assert [c.category for c in compare_months(rows, "2026-02", "2025-12")] == []
+
+
+def test_R3_previous_zero_gives_no_pct():
+    rows = [_e(2026, 2, "雑費", 500)]
+    (c,) = compare_months(rows, "2026-02", "2026-01")
+    assert c.pct is None
+    assert c.status == "新規"
+
+
+def test_R3_previous_negative_gives_no_pct():
+    rows = [_e(2026, 1, "食費", -500), _e(2026, 2, "食費", 100)]
+    (c,) = compare_months(rows, "2026-02")
+    assert c.pct is None
+    assert c.diff == 600
+
+
+def test_R4_no_change():
+    rows = [_e(2026, 1, "食費", 100), _e(2026, 2, "食費", 100)]
+    (c,) = compare_months(rows, "2026-02")
+    assert (c.diff, c.pct, c.status) == (0, 0.0, "変化なし")
+
+
+def test_R4_decrease():
+    rows = [_e(2026, 1, "食費", 100), _e(2026, 2, "食費", 40)]
+    (c,) = compare_months(rows, "2026-02")
+    assert (c.diff, c.pct, c.status) == (-60, -60.0, "減")
+
+
+def test_R3_pct_rounded_to_one_decimal():
+    rows = [_e(2026, 1, "食費", 3), _e(2026, 2, "食費", 4)]
+    (c,) = compare_months(rows, "2026-02")
+    assert c.pct == 33.3
+
+
+def test_R5_sorted_by_abs_diff_then_category():
+    rows = [
+        _e(2026, 1, "B", 100),
+        _e(2026, 2, "B", 200),  # diff +100
+        _e(2026, 1, "A", 100),
+        _e(2026, 2, "A", 0),  # diff -100
+        _e(2026, 2, "C", 500),  # diff +500
+    ]
+    assert [c.category for c in compare_months(rows, "2026-02", "2026-01")] == [
+        "C",
+        "A",
+        "B",
+    ]
+
+
+def test_R5_empty_rows_returns_empty_list():
+    assert compare_months([], "2026-02") == []
+
+
+@pytest.mark.parametrize("bad", [True, 1.0, "100", None])
+def test_non_integer_amount_raises_type_error(bad):
+    rows = [Expense(day=date(2026, 1, 1), category="食費", amount=bad)]  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        compare_months(rows, "2026-02", "2026-01")
+
+
+def test_month_must_be_str():
+    with pytest.raises(TypeError):
+        compare_months(ROWS, 202602)  # type: ignore[arg-type]
+
+
+# --- format_report ---
+
+
+def test_R6_format_line_with_pct():
+    c = CategoryChange("食費", 60000, 75000, 15000, 25.0, "増")
+    assert format_report([c]) == "食費  60,000円 → 75,000円  +15,000円 (+25.0%) 増"
+
+
+def test_R6_pct_none_omits_parentheses():
+    c = CategoryChange("雑費", 0, 500, 500, None, "新規")
+    assert format_report([c]) == "雑費  0円 → 500円  +500円 新規"
+
+
+def test_R6_negative_diff_and_zero_sign():
+    down = CategoryChange("食費", 100, 40, -60, -60.0, "減")
+    same = CategoryChange("交通費", 50, 50, 0, 0.0, "変化なし")
+    assert format_report([down, same]) == (
+        "食費  100円 → 40円  -60円 (-60.0%) 減\n"
+        "交通費  50円 → 50円  +0円 (+0.0%) 変化なし"
+    )
+
+
+def test_R6_empty_report():
+    assert format_report([]) == "変化なし(比較できる支出がありません)"
diff --git a/tests/test_importer.py b/tests/test_importer.py
new file mode 100644
index 0000000..a29b12a
--- /dev/null
+++ b/tests/test_importer.py
@@ -0,0 +1,258 @@
+"""Tests for kakeibo.importer.import_statement."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import CsvError, Expense
+from kakeibo.importer import import_statement
+
+# --- 例の表(E1-1 〜 E1-3)---------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param(
+            '利用日,利用店名,利用金額\n2026/1/5,ＮＥＴＦＬＩＸ,"1,490円"',
+            [Expense(date(2026, 1, 5), "未分類", 1490, "NETFLIX")],
+            id="E1-1",
+        ),
+        pytest.param(
+            "日付,摘要,出金,入金\n2026-01-05,給与,,300000",
+            [],
+            id="E1-2",
+        ),
+    ],
+)
+def test_examples_return_expected(text: str, expected: list[Expense]) -> None:
+    assert import_statement(text) == expected
+
+
+def test_E1_3_reports_all_errors_of_row() -> None:
+    with pytest.raises(CsvError) as exc:
+        import_statement("date,amount\n2026-02-30,abc")
+    assert exc.value.errors == [
+        (2, "日付が不正です: '2026-02-30'; 金額が不正です: 'abc'")
+    ]
+
+
+# --- R1 区切り・BOM・改行・行番号 ------------------------------------------
+
+
+def test_tab_delimiter_is_detected_from_first_line() -> None:
+    text = "日付\t金額\n2026-01-05\t1200"
+    assert import_statement(text) == [Expense(date(2026, 1, 5), "未分類", 1200)]
+
+
+def test_bom_is_removed() -> None:
+    text = "﻿日付,金額\n2026-01-05,100"
+    assert import_statement(text) == [Expense(date(2026, 1, 5), "未分類", 100)]
+
+
+@pytest.mark.parametrize("newline", ["\n", "\r\n", "\r"], ids=["LF", "CRLF", "CR"])
+def test_all_newline_styles(newline: str) -> None:
+    text = newline.join(["日付,金額", "2026-01-05,100", "2026-01-06,200"])
+    assert import_statement(text) == [
+        Expense(date(2026, 1, 5), "未分類", 100),
+        Expense(date(2026, 1, 6), "未分類", 200),
+    ]
+
+
+def test_quoted_newline_is_one_cell_and_error_line_is_record_start() -> None:
+    text = '日付,金額,摘要\n2026-01-05,100,"x\ny"\n2026-02-30,1,z'
+    assert import_statement('日付,金額,摘要\n2026-01-05,100,"x\ny"') == [
+        Expense(date(2026, 1, 5), "未分類", 100, "x\ny")
+    ]
+    with pytest.raises(CsvError) as exc:
+        import_statement(text)
+    assert exc.value.errors == [(4, "日付が不正です: '2026-02-30'")]
+
+
+# --- R3 金額 ---------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        pytest.param("-300", -300, id="ascii-minus"),
+        pytest.param("−300", -300, id="u2212-minus"),
+        pytest.param("△500", -500, id="triangle"),
+        pytest.param("▲500", -500, id="black-triangle"),
+        pytest.param("(500)", -500, id="parentheses"),
+        pytest.param("500-", -500, id="trailing-minus"),
+        pytest.param("¥1,000", 1000, id="yen-sign"),
+        pytest.param("￥1,000", 1000, id="fullwidth-yen"),
+        pytest.param("1,000 JPY", 1000, id="jpy-with-space"),
+        pytest.param("１，０００円", 1000, id="fullwidth-digits-comma-yen"),
+    ],
+)
+def test_amount_forms(raw: str, expected: int) -> None:
+    text = f'日付,金額\n2026-01-05,"{raw}"'
+    assert import_statement(text) == [Expense(date(2026, 1, 5), "未分類", expected)]
+
+
+@pytest.mark.parametrize(
+    "raw",
+    ["12.5", "", "-", "abc", "(500", "--300", "1000-円X"],
+    ids=[
+        "decimal",
+        "empty",
+        "minus-only",
+        "letters",
+        "unclosed",
+        "double-sign",
+        "junk",
+    ],
+)
+def test_invalid_amount_is_row_error(raw: str) -> None:
+    text = f'日付,金額\n2026-01-05,"{raw}"'
+    with pytest.raises(CsvError) as exc:
+        import_statement(text)
+    assert exc.value.errors == [(2, f"金額が不正です: {raw!r}")]
+
+
+def test_negative_amount_in_single_column_is_refund() -> None:
+    text = "金額,日付\n-1200,2026-01-05"
+    assert import_statement(text) == [Expense(date(2026, 1, 5), "未分類", -1200)]
+
+
+# --- R2 列名・既定値 -------------------------------------------------------
+
+
+def test_header_names_are_normalized() -> None:
+    text = " DATE , ＡＭＯＵＮＴ , Category \n2026-01-05,300,食費"
+    assert import_statement(text) == [Expense(date(2026, 1, 5), "食費", 300)]
+
+
+def test_empty_category_becomes_uncategorized() -> None:
+    text = "分類,日付,金額\n  ,2026-01-05,300"
+    assert import_statement(text) == [Expense(date(2026, 1, 5), "未分類", 300)]
+
+
+def test_memo_is_nfkc_and_stripped() -> None:
+    text = "日付,金額,摘要\n2026-01-05,300,ＮＥＴＦＬＩＸ "
+    assert import_statement(text)[0].memo == "NETFLIX"
+
+
+def test_missing_memo_column_gives_empty_memo() -> None:
+    text = "日付,金額\n2026-01-05,300"
+    assert import_statement(text)[0].memo == ""
+
+
+# --- R4 出金・入金 ---------------------------------------------------------
+
+
+def test_withdrawal_column_is_positive_expense() -> None:
+    text = "日付,摘要,出金,入金\n2026-01-05,店,300,"
+    assert import_statement(text) == [Expense(date(2026, 1, 5), "未分類", 300, "店")]
+
+
+def test_both_withdrawal_and_deposit_filled_is_row_error() -> None:
+    text = "日付,出金,入金\n2026-01-05,300,100"
+    with pytest.raises(CsvError) as exc:
+        import_statement(text)
+    assert exc.value.errors[0][0] == 2
+
+
+def test_both_withdrawal_and_deposit_empty_is_row_error() -> None:
+    text = "日付,出金,入金\n2026-01-05,,"
+    with pytest.raises(CsvError) as exc:
+        import_statement(text)
+    assert exc.value.errors[0][0] == 2
+
+
+def test_amount_and_withdrawal_together_is_value_error() -> None:
+    with pytest.raises(ValueError):
+        import_statement("日付,金額,出金,入金\n2026-01-05,1,1,")
+
+
+# --- R5 日付 ---------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026.1.5",
+        "2026年1月5日",
+        "20260105",
+        "2026-01-05 10:30",
+        "2026/1/5 9:05:00",
+    ],
+)
+def test_date_forms(raw: str) -> None:
+    text = f"日付,金額\n{raw},100"
+    assert import_statement(text)[0].day == date(2026, 1, 5)
+
+
+@pytest.mark.parametrize(
+    "raw",
+    ["2026-02-30", "2026年13月1日", "令和8年1月5日", "2026-01-05 夜"],
+)
+def test_invalid_date_is_row_error(raw: str) -> None:
+    text = f"日付,金額\n{raw},100"
+    with pytest.raises(CsvError) as exc:
+        import_statement(text)
+    assert exc.value.errors == [(2, f"日付が不正です: {raw!r}")]
+
+
+# --- R6 空行・列数・必須列・空入力 ----------------------------------------
+
+
+def test_blank_lines_are_ignored() -> None:
+    text = "\n日付,金額\n\n2026-01-05,100\n\n"
+    assert import_statement(text) == [Expense(date(2026, 1, 5), "未分類", 100)]
+
+
+def test_column_count_mismatch_is_row_error() -> None:
+    text = "日付,金額\n2026-01-05,1,234"
+    with pytest.raises(CsvError) as exc:
+        import_statement(text)
+    assert exc.value.errors == [(2, "列数が不正です: 期待 2 実際 3")]
+
+
+def test_unquoted_yen_with_comma_splits_into_column_error() -> None:
+    text = "日付,金額\n2026-01-05,1,234円"
+    with pytest.raises(CsvError) as exc:
+        import_statement(text)
+    assert exc.value.errors == [(2, "列数が不正です: 期待 2 実際 3")]
+
+
+def test_errors_are_reported_in_input_order() -> None:
+    text = "日付,金額\n2026-02-30,1\n2026-01-05,100\n2026-01-06,x"
+    with pytest.raises(CsvError) as exc:
+        import_statement(text)
+    assert [n for n, _ in exc.value.errors] == [2, 4]
+
+
+def test_valid_rows_keep_input_order() -> None:
+    text = "日付,金額\n2026-01-09,3\n2026-01-01,1\n2026-01-05,2"
+    assert [e.amount for e in import_statement(text)] == [3, 1, 2]
+
+
+@pytest.mark.parametrize(
+    "text",
+    ["", "日付,金額", "日付,金額\n"],
+    ids=["empty", "header-only", "header-newline"],
+)
+def test_empty_or_header_only_returns_empty_list(text: str) -> None:
+    assert import_statement(text) == []
+
+
+def test_missing_date_column_is_value_error_with_header() -> None:
+    with pytest.raises(ValueError, match="日付"):
+        import_statement("金額,摘要\n100,x")
+
+
+def test_missing_amount_column_is_value_error_with_header() -> None:
+    with pytest.raises(ValueError, match="金額"):
+        import_statement("日付,摘要\n2026-01-05,x")
+
+
+def test_non_string_input_is_type_error() -> None:
+    with pytest.raises(TypeError):
+        import_statement(None)  # type: ignore[arg-type]
