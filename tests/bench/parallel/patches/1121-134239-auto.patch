+"""Month-over-month comparison of expenses by category (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    diff: int
+    pct: float | None
+    status: str
+
+
+def _check_month(value: object, name: str) -> str:
+    if not isinstance(value, str):
+        raise TypeError(f"{name} は文字列である必要があります")
+    if not _MONTH_RE.fullmatch(value):
+        raise ValueError(f"{name} は YYYY-MM の形式である必要があります: {value!r}")
+    return value
+
+
+def _prev_month(month: str) -> str:
+    year, mon = int(month[:4]), int(month[5:])
+    if mon == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mon - 1:02d}"
+
+
+def _month_totals(rows: list[Expense], month: str) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for e in rows:
+        if e.day.strftime("%Y-%m") == month:
+            out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def compare_months(
+    rows: list[Expense], month: str, previous: str | None = None
+) -> list[CategoryChange]:
+    _check_month(month, "month")
+    if previous is None:
+        previous = _prev_month(month)
+    else:
+        _check_month(previous, "previous")
+    if previous == month:
+        raise ValueError(f"month と previous が同じです: {month!r}")
+
+    for e in rows:
+        if isinstance(e.amount, bool) or not isinstance(e.amount, int):
+            raise TypeError(f"金額は整数である必要があります: {e.amount!r}")
+
+    cur_totals = _month_totals(rows, month)
+    prev_totals = _month_totals(rows, previous)
+
+    changes: list[CategoryChange] = []
+    for cat in set(cur_totals) | set(prev_totals):
+        cur = cur_totals.get(cat, 0)
+        prev = prev_totals.get(cat, 0)
+        diff = cur - prev
+        pct = round(diff / prev * 100, 1) if prev > 0 else None
+        if prev == 0 and cur > 0:
+            status = "新規"
+        elif prev > 0 and cur == 0:
+            status = "なくなった"
+        elif diff > 0:
+            status = "増"
+        elif diff < 0:
+            status = "減"
+        else:
+            status = "変化なし"
+        changes.append(CategoryChange(cat, prev, cur, diff, pct, status))
+
+    changes.sort(key=lambda c: (-abs(c.diff), c.category))
+    return changes
+
+
+def format_report(changes: list[CategoryChange]) -> str:
+    if not changes:
+        return "変化なし(比較できる支出がありません)"
+    lines: list[str] = []
+    for c in changes:
+        line = f"{c.category}  {c.previous:,}円 → {c.current:,}円  {c.diff:+,}円"
+        if c.pct is not None:
+            line += f" ({c.pct:+.1f}%)"
+        line += f" {c.status}"
+        lines.append(line)
+    return "\n".join(lines)
