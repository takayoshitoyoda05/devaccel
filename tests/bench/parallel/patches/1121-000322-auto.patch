@@ -0,0 +1,162 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import (
+    ImportFormatError,
+    import_bank_csv,
+    parse_amount,
+    parse_date,
+)
+from kakeibo.core import Expense
+
+
+@pytest.mark.parametrize(
+    "raw,want",
+    [
+        ("1234", 1234),
+        ("1,234", 1234),
+        ("¥1,234", 1234),
+        ("￥１，２３４", 1234),
+        ("1,234円", 1234),
+        ("JPY 500", 500),
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("0", 0),
+        (" 　700　 ", 700),
+    ],
+)
+def test_parse_amount_ok(raw: str, want: int) -> None:
+    assert parse_amount(raw) == want
+
+
+@pytest.mark.parametrize("raw", ["", "  ", "-", "—", "12.5", "abc", "1,2x", "¥"])
+def test_parse_amount_bad(raw: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(raw)
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026/1/5",
+        "2026-01-05",
+        "2026.1.5",
+        "20260105",
+        "2026年1月5日",
+        "２０２６／１／５",
+        "2026-01-05 12:34:56",
+        "2026/01/05T09:00",
+    ],
+)
+def test_parse_date_ok(raw: str) -> None:
+    assert parse_date(raw) == date(2026, 1, 5)
+
+
+@pytest.mark.parametrize(
+    "raw", ["", "2026/2/30", "令和8年1月5日", "26/1/5", "2026-01-05 x"]
+)
+def test_parse_date_bad(raw: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(raw)
+
+
+def test_card_style_columns() -> None:
+    text = (
+        '利用日,ご利用店名,利用金額\n2026/1/5,コンビニ,"1,234"\n2026/1/6,カフェ,500円\n'
+    )
+    r = import_bank_csv(text)
+    assert r.errors == []
+    assert r.expenses == [
+        Expense(date(2026, 1, 5), "未分類", 1234, "コンビニ"),
+        Expense(date(2026, 1, 6), "未分類", 500, "カフェ"),
+    ]
+
+
+def test_header_aliases_case_and_spaces() -> None:
+    r = import_bank_csv(" Date , Amount ,Category, Memo\n2026-01-05,100,食費,x\n")
+    assert r.expenses == [Expense(date(2026, 1, 5), "食費", 100, "x")]
+
+
+def test_bom_crlf_and_tab() -> None:
+    r = import_bank_csv("﻿日付\t摘要\t金額\r\n2026/1/5\tA\t100\r\n")
+    assert r.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "A")]
+
+
+def test_out_in_columns_skip_income() -> None:
+    text = "取引日,摘要,出金額,入金額\n2026/1/5,家賃,80000,\n2026/1/25,給与,,300000\n"
+    r = import_bank_csv(text)
+    assert r.errors == []
+    assert r.skipped == 1
+    assert [e.amount for e in r.expenses] == [80000]
+
+
+def test_out_in_both_or_neither_is_error() -> None:
+    text = "日付,出金,入金\n2026/1/5,100,200\n2026/1/6,,\n"
+    r = import_bank_csv(text)
+    assert r.expenses == []
+    assert [e.line for e in r.errors] == [2, 3]
+
+
+def test_refund_kept_negative() -> None:
+    r = import_bank_csv("日付,金額\n2026/1/5,△500\n")
+    assert r.expenses[0].amount == -500
+
+
+def test_row_errors_report_line_column_value_and_all_errors() -> None:
+    text = "日付,金額,メモ\n2026/1/5,100,ok\n2026/2/30,12.5,bad\n\n2026/1/7,abc,x\n"
+    r = import_bank_csv(text)
+    assert len(r.expenses) == 1  # 良い行は取り込む
+    got = [(e.line, e.column, e.value) for e in r.errors]
+    assert got == [(3, "日付", "2026/2/30"), (3, "金額", "12.5"), (5, "金額", "abc")]
+    assert "3行目" in str(r.errors[0]) and "日付" in str(r.errors[0])
+
+
+def test_unquoted_thousands_separator_reports_column_count() -> None:
+    r = import_bank_csv("日付,金額,メモ\n2026/1/5,1,234円,x\n")
+    assert r.expenses == []
+    assert len(r.errors) == 1
+    assert r.errors[0].line == 2
+    assert "列数" in r.errors[0].reason
+
+
+def test_too_few_columns() -> None:
+    r = import_bank_csv("日付,金額,メモ\n2026/1/5,100\n")
+    assert [e.line for e in r.errors] == [2]
+
+
+def test_quoted_newline_line_numbers_use_record_start() -> None:
+    text = '日付,金額,メモ\n2026/1/5,100,"a\nb"\n2026/13/1,100,x\n'
+    r = import_bank_csv(text)
+    assert len(r.expenses) == 1 and r.expenses[0].memo == "a\nb"
+    assert r.errors[0].line == 4
+
+
+def test_header_only_is_empty_result() -> None:
+    r = import_bank_csv("日付,金額\n")
+    assert (r.expenses, r.errors, r.skipped) == ([], [], 0)
+
+
+@pytest.mark.parametrize("text", ["", "\n  \n", "﻿"])
+def test_empty_input_is_format_error(text: str) -> None:
+    with pytest.raises(ImportFormatError):
+        import_bank_csv(text)
+
+
+@pytest.mark.parametrize(
+    "header",
+    [
+        "金額,メモ",  # 日付なし
+        "日付,メモ",  # 金額なし
+        "日付,出金額",  # 入金なし
+        "日付,金額,利用金額",  # 同じ項目が重複
+        "日付,金額,出金,入金",  # 両形式が混在
+    ],
+)
+def test_bad_header_is_format_error(header: str) -> None:
+    with pytest.raises(ImportFormatError):
+        import_bank_csv(header + "\n")
