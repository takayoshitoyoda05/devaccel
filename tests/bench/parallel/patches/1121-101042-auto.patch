+++ b/tests/test_statement.py
@@ -0,0 +1,161 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import CsvError, Expense
+from kakeibo.statement import parse_amount, parse_date, parse_statement
+
+
+@pytest.mark.parametrize(
+    "raw,want",
+    [
+        ("1234", 1234),
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("¥1,234", 1234),
+        ("￥1，234", 1234),
+        ("1,234円", 1234),
+        ("JPY 1234", 1234),
+        ("１，２３４", 1234),
+        (" 1 234 ", 1234),
+        ("0", 0),
+    ],
+)
+def test_amount_ok(raw, want):
+    assert parse_amount(raw) == want
+
+
+@pytest.mark.parametrize("raw", ["", "-", "—", "12.5", "12.0", "abc", "1-2", "()"])
+def test_amount_bad(raw):
+    with pytest.raises(ValueError):
+        parse_amount(raw)
+
+
+def test_amount_type():
+    with pytest.raises(TypeError):
+        parse_amount(None)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize(
+    "raw,want",
+    [
+        ("2026-01-05", date(2026, 1, 5)),
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026.1.5", date(2026, 1, 5)),
+        ("20260105", date(2026, 1, 5)),
+        ("2026年1月5日", date(2026, 1, 5)),
+        ("令和8年1月5日", date(2026, 1, 5)),
+        ("R8.1.5", date(2026, 1, 5)),
+        ("令和元年5月1日", date(2019, 5, 1)),
+        ("2026/01/05 12:34", date(2026, 1, 5)),
+        ("２０２６／１／５".replace("／", "/"), date(2026, 1, 5)),
+    ],
+)
+def test_date_ok(raw, want):
+    assert parse_date(raw) == want
+
+
+@pytest.mark.parametrize(
+    "raw", ["", "2026/02/30", "2026-13-01", "hello", "2026/1/5 xx"]
+)
+def test_date_bad(raw):
+    with pytest.raises(ValueError):
+        parse_date(raw)
+
+
+def test_bank_single_amount_aliases():
+    text = (
+        '﻿利用日,ご利用店名,利用金額\n2026/1/5,コンビニ,"1,234円"\n2026/1/6,返金,△500\n'
+    )
+    assert parse_statement(text) == [
+        Expense(date(2026, 1, 5), "未分類", 1234, "コンビニ"),
+        Expense(date(2026, 1, 6), "未分類", -500, "返金"),
+    ]
+
+
+def test_header_case_space_and_category():
+    text = " Date , CATEGORY ,Amount,Description\n2026-01-05, 食費 ,300,x\n"
+    assert parse_statement(text) == [Expense(date(2026, 1, 5), "食費", 300, "x")]
+
+
+def test_split_columns_skip_deposit():
+    text = '取引日,摘要,出金額,入金額\n2026/1/5,家賃,"80,000",\n2026/1/6,給与,,300000\n'
+    assert parse_statement(text) == [Expense(date(2026, 1, 5), "未分類", 80000, "家賃")]
+
+
+def test_split_both_filled_and_both_empty():
+    text = "日付,出金,入金\n2026/1/5,100,200\n2026/1/6,,\n"
+    with pytest.raises(CsvError) as ei:
+        parse_statement(text)
+    assert [n for n, _ in ei.value.errors] == [2, 3]
+    assert "両方" in ei.value.errors[0][1]
+
+
+def test_tab_delimited():
+    text = "日付\t金額\t摘要\n2026/1/5\t100\ta,b\n"
+    assert parse_statement(text) == [Expense(date(2026, 1, 5), "未分類", 100, "a,b")]
+
+
+def test_crlf_blank_lines_and_header_only():
+    assert parse_statement("日付,金額\r\n\r\n2026/1/5,100\r\n\r\n")[0].amount == 100
+    assert parse_statement("日付,金額\n") == []
+    assert parse_statement("") == []
+    assert parse_statement("﻿  \n") == []
+
+
+def test_all_errors_reported_with_line_column_value():
+    text = "日付,金額,メモ\n2026/2/30,12.5,x\n2026/1/5,100,ok\nbad,abc,y\n"
+    with pytest.raises(CsvError) as ei:
+        parse_statement(text)
+    errs = ei.value.errors
+    assert [n for n, _ in errs] == [2, 2, 4, 4]
+    assert "日付" in errs[0][1] and "'2026/2/30'" in errs[0][1]
+    assert "金額" in errs[1][1] and "'12.5'" in errs[1][1]
+    assert "'abc'" in errs[3][1]
+
+
+def test_unquoted_separator_is_column_count_error():
+    text = "日付,金額,メモ\n2026/1/5,1,234円,x\n"
+    with pytest.raises(CsvError) as ei:
+        parse_statement(text)
+    assert ei.value.errors[0][0] == 2
+    assert "列数" in ei.value.errors[0][1]
+
+
+def test_short_row_error():
+    with pytest.raises(CsvError) as ei:
+        parse_statement("日付,金額,メモ\n2026/1/5,100\n")
+    assert "列数" in ei.value.errors[0][1]
+
+
+def test_line_number_after_quoted_newline():
+    text = '日付,金額,メモ\n2026/1/5,100,"a\nb"\nbad,1,x\n'
+    with pytest.raises(CsvError) as ei:
+        parse_statement(text)
+    assert ei.value.errors == [(4, "列 日付: 日付として読めません: 'bad'")]
+
+
+def test_missing_required_columns():
+    with pytest.raises(CsvError) as ei:
+        parse_statement("メモ,金額\nx,1\n")
+    assert ei.value.errors[0][0] == 1 and "日付" in ei.value.errors[0][1]
+    with pytest.raises(CsvError) as ei:
+        parse_statement("日付,メモ\n2026/1/5,x\n")
+    assert "金額" in ei.value.errors[0][1]
+    with pytest.raises(CsvError) as ei:
+        parse_statement("日付,入金額\n2026/1/5,1\n")
+    assert "出金" in ei.value.errors[0][1]
+
+
+def test_empty_single_amount_is_error():
+    with pytest.raises(CsvError):
+        parse_statement("日付,金額\n2026/1/5,\n")
+
+
+def test_text_type():
+    with pytest.raises(TypeError):
+        parse_statement(b"x")  # type: ignore[arg-type]
