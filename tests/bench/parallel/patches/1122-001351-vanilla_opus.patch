diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..1931a39 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -188,3 +188,115 @@ def test_path_type(runner, cls, expect):
 
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
+
+
+@pytest.mark.parametrize(
+    "filename",
+    ["data.csv", "data.tsv", "DATA.CSV", "Data.Tsv", "dir.v1/data.csv"],
+)
+def test_path_extensions_allowed(filename):
+    path_type = click.Path(extensions=[".csv", ".tsv"])
+    assert path_type.convert(filename, None, None) == filename
+
+
+@pytest.mark.parametrize(
+    "filename",
+    ["data.txt", "data.csv.bak", "datacsv", "data", ".csv", "data.csv/", "csv.d/x"],
+)
+def test_path_extensions_rejected(filename):
+    path_type = click.Path(extensions=[".csv", ".tsv"])
+
+    with pytest.raises(
+        click.BadParameter, match=r"does not have an allowed extension \(\.csv, \.tsv\)"
+    ):
+        path_type.convert(filename, None, None)
+
+
+def test_path_extensions_normalized():
+    path_type = click.Path(extensions=["CSV", ".Tsv", "csv", ".tar.gz"])
+    assert path_type.extensions == (".csv", ".tsv", ".tar.gz")
+    assert path_type.convert("archive.TAR.GZ", None, None) == "archive.TAR.GZ"
+
+    with pytest.raises(click.BadParameter):
+        path_type.convert("archive.gz", None, None)
+
+
+def test_path_extensions_single_string():
+    path_type = click.Path(extensions=".csv")
+    assert path_type.extensions == (".csv",)
+
+
+@pytest.mark.parametrize("extensions", [[], [""], ["."], ["..csv"]])
+def test_path_extensions_invalid(extensions):
+    with pytest.raises(ValueError):
+        click.Path(extensions=extensions)
+
+
+def test_path_extensions_invalid_type():
+    with pytest.raises(TypeError):
+        click.Path(extensions=[1])  # type: ignore[list-item]
+
+
+def test_path_extensions_none_accepts_anything():
+    assert click.Path().convert("data.whatever", None, None) == "data.whatever"
+
+
+def test_path_extensions_existing_file(tmp_path):
+    good = tmp_path / "data.CSV"
+    bad = tmp_path / "data.txt"
+    good.touch()
+    bad.touch()
+    path_type = click.Path(exists=True, extensions=[".csv"])
+
+    assert path_type.convert(os.fspath(good), None, None) == os.fspath(good)
+
+    with pytest.raises(click.BadParameter, match="does not have an allowed extension"):
+        path_type.convert(os.fspath(bad), None, None)
+
+
+def test_path_extensions_skip_existing_directory(tmp_path):
+    path_type = click.Path(exists=True, extensions=[".csv"])
+    assert path_type.convert(os.fspath(tmp_path), None, None) == os.fspath(tmp_path)
+
+
+def test_path_extensions_dash():
+    path_type = click.Path(allow_dash=True, extensions=[".csv"])
+    assert path_type.convert("-", None, None) == "-"
+
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions=[".csv"]).convert("-", None, None)
+
+
+@pytest.mark.parametrize(
+    ("value", "cls"),
+    [
+        (b"data.CSV", bytes),
+        (pathlib.Path("data.CSV"), pathlib.Path),
+    ],
+)
+def test_path_extensions_non_str_values(value, cls):
+    path_type = click.Path(extensions=[".csv"], path_type=cls)
+    assert path_type.convert(value, None, None) == value
+
+
+def test_path_extensions_cli(runner):
+    @click.command()
+    @click.argument("src", type=click.Path(extensions=[".csv", ".tsv"]))
+    def cli(src):
+        click.echo(src)
+
+    result = runner.invoke(cli, ["in.TSV"])
+    assert result.exit_code == 0
+    assert result.output == "in.TSV\n"
+
+    result = runner.invoke(cli, ["in.json"])
+    assert result.exit_code == 2
+    assert (
+        "Invalid value for 'SRC': Path 'in.json' does not have an allowed"
+        " extension (.csv, .tsv)." in result.output
+    )
+
+
+def test_path_extensions_info_dict():
+    info = click.Path(extensions=["CSV", ".tsv"]).to_info_dict()
+    assert info["extensions"] == [".csv", ".tsv"]
