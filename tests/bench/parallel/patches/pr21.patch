+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,89 @@
+"""Import CSVs exported by other banks / card issuers."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"(-?)[¥￥]?([0-9][0-9,]*)円?", re.ASCII)
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})", re.ASCII)
+
+
+def parse_amount(s: str) -> int:
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"invalid amount: {s!r}")
+    value = int(m.group(2).replace(",", ""))
+    return -value if m.group(1) else value
+
+
+def parse_date(s: str) -> date:
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"invalid date: {s!r}")
+    return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    mp = DEFAULT_MAPPING if mapping is None else mapping
+    for key in ("date", "category", "amount"):
+        if key not in mp:
+            raise ValueError(f"mapping に {key} がありません")
+    cmap = category_map or {}
+
+    reader = csv.reader(io.StringIO(text))
+    try:
+        header = next(reader)
+    except StopIteration:
+        raise ValueError("ヘッダーがありません") from None
+    index: dict[str, int] = {}
+    for field, col in mp.items():
+        if col not in header:
+            raise ValueError(f"列 {col} がヘッダーにありません")
+        index[field] = header.index(col)
+
+    def get(row: list[str], field: str) -> str:
+        i = index.get(field)
+        return row[i] if i is not None and i < len(row) else ""
+
+    rows: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    prev_end = reader.line_num
+    for row in reader:
+        lineno = prev_end + 1  # physical line where this record starts
+        prev_end = reader.line_num
+        if not row:
+            continue
+        day = amount = None
+        row_errors: list[tuple[int, str]] = []
+        try:
+            day = parse_date(get(row, "date"))
+        except ValueError:
+            row_errors.append((lineno, "date"))
+        try:
+            amount = parse_amount(get(row, "amount"))
+        except ValueError:
+            row_errors.append((lineno, "amount"))
+        cat = get(row, "category").strip()
+        if not cat:
+            row_errors.append((lineno, "category"))
+        if row_errors or day is None or amount is None:
+            errors.extend(row_errors)
+            continue
+        rows.append(Expense(day, cmap.get(cat, cat), amount, get(row, "memo").strip()))
+    return rows, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
