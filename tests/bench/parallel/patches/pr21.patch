+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def E(d, cat="rent", amt=1000, memo=""):
+    return Expense(d, cat, amt, memo)
+
+
+@pytest.mark.parametrize(
+    "src,dst",
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2024, 1, 31), date(2024, 2, 29)),
+        (date(2026, 12, 15), date(2027, 1, 15)),
+        (date(2026, 3, 31), date(2026, 4, 30)),
+    ],
+)
+def test_add_month(src, dst):
+    assert add_month(src) == dst
+
+
+def test_basic():
+    rows = [E(date(2026, 1, 5)), E(date(2026, 2, 5)), E(date(2026, 3, 6))]
+    assert find_recurring(rows) == [
+        Recurring(
+            "rent",
+            1000,
+            (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 6)),
+            date(2026, 4, 6),
+        )
+    ]
+
+
+def test_invalid_args():
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_empty_and_too_short():
+    assert find_recurring([]) == []
+    assert find_recurring([E(date(2026, 1, 5)), E(date(2026, 2, 5))]) == []
+
+
+def test_tolerance_boundary():
+    rows = [E(date(2026, 1, 5)), E(date(2026, 2, 8)), E(date(2026, 3, 11))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+    assert find_recurring(rows, tolerance=2) == []
+
+
+def test_duplicates_and_memo_ignored():
+    rows = [
+        E(date(2026, 1, 5), memo="a"),
+        E(date(2026, 1, 5), memo="b"),
+        E(date(2026, 2, 5)),
+        E(date(2026, 3, 5)),
+    ]
+    (r,) = find_recurring(rows)
+    assert len(r.days) == 3
+
+
+def test_break_splits_runs_and_sorting():
+    a = [date(2026, 1, 1), date(2026, 2, 1), date(2026, 3, 1)]
+    b = [date(2026, 8, 1), date(2026, 9, 1), date(2026, 10, 1)]
+    rows = (
+        [E(d) for d in reversed(b + a)]
+        + [E(d, "a", 5) for d in a]
+        + [E(d, "rent", 500) for d in a]
+    )
+    res = find_recurring(rows)
+    assert [(r.category, r.amount, r.days[0]) for r in res] == [
+        ("a", 5, a[0]),
+        ("rent", 500, a[0]),
+        ("rent", 1000, a[0]),
+        ("rent", 1000, b[0]),
+    ]
+    assert res[2].next_expected == date(2026, 4, 1)
+
+
+def test_month_end_chain():
+    rows = [E(date(2026, 1, 31)), E(date(2026, 2, 28)), E(date(2026, 3, 28))]
+    (r,) = find_recurring(rows, tolerance=0)
+    assert r.next_expected == date(2026, 4, 28)
