+++ b/tests/test_query.py
@@ -0,0 +1,113 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def E(cat, memo=""):
+    return Expense(date(2026, 1, 1), cat, 100, memo)
+
+
+def test_tokenize_basic():
+    assert tokenize('a (b) "c d" AND OR NOT and cat:Food') == [
+        ("TERM", "a"),
+        ("LPAREN", "("),
+        ("TERM", "b"),
+        ("RPAREN", ")"),
+        ("TERM", "c d"),
+        ("AND", "AND"),
+        ("OR", "OR"),
+        ("NOT", "NOT"),
+        ("TERM", "and"),
+        ("CAT", "Food"),
+    ]
+
+
+def test_tokenize_quote_with_parens_and_adjacent():
+    assert tokenize('"a (b)"x') == [("TERM", "a (b)"), ("TERM", "x")]
+    assert tokenize("a(b)") == [
+        ("TERM", "a"),
+        ("LPAREN", "("),
+        ("TERM", "b"),
+        ("RPAREN", ")"),
+    ]
+    assert tokenize("   ") == []
+    assert tokenize("ANDROID NOTE cat:x:y") == [
+        ("TERM", "ANDROID"),
+        ("TERM", "NOTE"),
+        ("CAT", "x:y"),
+    ]
+
+
+@pytest.mark.parametrize("q", ['"abc', '""', "cat:", "x cat:", 'cat:"a"'])
+def test_tokenize_errors(q):
+    with pytest.raises(QueryError):
+        tokenize(q)
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(a",
+        "a)",
+        "a OR",
+        "OR a",
+        "a AND",
+        "AND a",
+        "NOT",
+        "a NOT",
+        "a OR OR b",
+        "(a OR)",
+        "a AND AND b",
+        ") a",
+        "a ( b",
+    ],
+)
+def test_syntax_errors(q):
+    with pytest.raises(QueryError):
+        matches(q, E("x"))
+
+
+def test_term_and_cat():
+    e = E("Food", "Lunch at Cafe")
+    assert matches("lunch", e)
+    assert matches("FOOD", e)
+    assert matches("cat:food", e)
+    assert not matches("cat:foo", e)
+    assert not matches("cat:Lunch", e)
+    assert matches('"at caf"', e)
+
+
+def test_precedence():
+    e = E("food", "lunch")
+    # a b OR c  ==  (a AND b) OR c
+    assert matches("zzz lunch OR food", e)
+    assert not matches("zzz AND lunch", e)
+    assert matches("food lunch", e)
+    assert matches("food AND lunch", e)
+    # NOT binds tighter than AND
+    assert matches("NOT zzz AND food", e)
+    assert not matches("NOT food AND lunch", e)
+    assert matches("NOT NOT food", e)
+    assert not matches("NOT (food OR zzz)", e)
+    assert matches("(zzz OR food) AND lunch", e)
+    assert matches("food NOT zzz", e)
+    assert matches("food (zzz OR lunch)", e)
+
+
+def test_filter_rows_order_and_invalid_on_empty():
+    rows = [E("a", "x1"), E("b", "y"), E("a", "x2")]
+    assert filter_rows("cat:a", rows) == [rows[0], rows[2]]
+    assert filter_rows("zzz", rows) == []
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
+
+
+def test_deep_nesting_is_query_error():
+    with pytest.raises(QueryError):
+        matches("(" * 5000 + "a" + ")" * 5000, E("a"))
