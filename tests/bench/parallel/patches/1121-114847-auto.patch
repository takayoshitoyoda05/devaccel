+"""Detect recurring monthly expenses (pure functions, stdlib only).
+
+D1: 返金・負の金額(および 0 円)は定期支出の系列に混ぜない。検出の対象から除外する。
+D2: 月の繰り返しの基準日は系列内の最大の日(日の数字)。次回は最後の月の翌月で、
+    その月の末日に丸める(31・31・28 の次は 3/31、2 月なら 2/28 か閏年 2/29)。
+D3: 同一系列 = 同じカテゴリ + 正規化したメモ(NFKC・casefold・空白を 1 つに・
+    末尾の数字や `#12` や `No.3` を除去)+ 金額が系列の中央値の ±amount_tolerance
+    (既定 5 %)以内。同じ月に 2 件ある系列は毎月ではないので検出しない
+    (5 日と 20 日の同額 2 本は検出しない)。
+"""
+
+from __future__ import annotations
+
+import calendar
+import re
+import statistics
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int
+    months: int
+    last_date: date
+    next_date: date
+
+
+_TRAILING_RE = re.compile(r"\s*(?:#\s*\d+|no\.\s*\d+|\d+)$")
+
+
+def _normalize_memo(memo: str) -> str:
+    s = " ".join(unicodedata.normalize("NFKC", memo).casefold().split())
+    while True:
+        t = _TRAILING_RE.sub("", s).strip()
+        if t == s:
+            return s
+        s = t
+
+
+def _month_index(day: date) -> int:
+    return day.year * 12 + day.month - 1
+
+
+def _detect(
+    category: str, items: list[Expense], min_count: int, tolerance: float
+) -> Recurring | None:
+    median = statistics.median(e.amount for e in items)
+    members = [e for e in items if abs(e.amount - median) <= tolerance * median]
+    by_month: dict[int, Expense] = {}
+    for e in members:
+        key = _month_index(e.day)
+        if key in by_month:
+            return None  # D3: 同じ月に 2 件あれば毎月ではない
+        by_month[key] = e
+    if not by_month:
+        return None
+    keys = sorted(by_month)
+    run = [keys[-1]]  # R1: 欠けた月があれば、最新の連続した並びだけを見る
+    for k in reversed(keys[:-1]):
+        if k != run[0] - 1:
+            break
+        run.insert(0, k)
+    if len(run) < min_count:
+        return None
+    latest = by_month[run[-1]]
+    base = max(by_month[k].day.day for k in run)  # D2
+    next_year, next_month0 = divmod(run[-1] + 1, 12)
+    month_days = calendar.monthrange(next_year, next_month0 + 1)[1]
+    return Recurring(
+        category=category,
+        memo=latest.memo,  # R2: 最新の元の文字列
+        amount=latest.amount,  # R2: 最新の金額
+        months=len(run),
+        last_date=latest.day,
+        next_date=date(next_year, next_month0 + 1, min(base, month_days)),
+    )
+
+
+def find_recurring(
+    rows: list[Expense], *, min_count: int = 3, amount_tolerance: float = 0.05
+) -> list[Recurring]:
+    """Return recurring monthly series, sorted by (next_date, category, memo)."""
+    if isinstance(min_count, bool) or not isinstance(min_count, int):
+        raise TypeError(f"min_count は int である必要があります: {min_count!r}")
+    if min_count < 2:
+        raise ValueError(f"min_count は 2 以上である必要があります: {min_count}")
+    if isinstance(amount_tolerance, bool) or not isinstance(
+        amount_tolerance, (int, float)
+    ):
+        raise TypeError(
+            f"amount_tolerance は数値である必要があります: {amount_tolerance!r}"
+        )
+    if not 0 <= amount_tolerance < 1:
+        raise ValueError(
+            f"amount_tolerance は 0 以上 1 未満である必要があります: {amount_tolerance}"
+        )
+    for i, e in enumerate(rows):
+        if not isinstance(e, Expense):
+            raise TypeError(f"rows[{i}] は Expense である必要があります: {e!r}")
+        if isinstance(e.amount, bool) or not isinstance(e.amount, int):
+            raise TypeError(
+                f"rows[{i}].amount は int である必要があります: {e.amount!r}"
+            )
+
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        if e.amount <= 0:  # D1: 返金・負の金額(0 円も)は系列に混ぜない
+            continue
+        groups.setdefault((e.category, _normalize_memo(e.memo)), []).append(e)
+
+    found: list[Recurring] = []
+    for items in groups.values():
+        rec = _detect(items[0].category, items, min_count, amount_tolerance)
+        if rec is not None:
+            found.append(rec)
+    found.sort(key=lambda r: (r.next_date, r.category, r.memo))
+    return found
