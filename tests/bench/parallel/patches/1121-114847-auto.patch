+++ b/tests/test_statement.py
@@ -0,0 +1,175 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import CsvError, Expense
+from kakeibo.statement import load_statement, parse_amount, parse_date, parse_statement
+
+
+@pytest.mark.parametrize(
+    ("s", "want"),
+    [
+        ("△1,500", -1500),
+        ("1234", 1234),
+        ("1,234", 1234),
+        ("1，２３４", 1234),
+        ("¥1,234", 1234),
+        ("￥1,234", 1234),
+        ("1,234円", 1234),
+        ("JPY 1234", 1234),
+        ("　1 234　", 1234),
+        ("12.0", 12),
+        ("12.00", 12),
+        ("-300", -300),
+        ("−300", -300),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("0", 0),
+    ],
+    ids=[
+        "E2-1",
+        "a1",
+        "a2",
+        "a3",
+        "a4",
+        "a5",
+        "a6",
+        "a7",
+        "a8",
+        "a9",
+        "a10",
+        "n1",
+        "n2",
+        "n3",
+        "n4",
+        "n5",
+        "zero",
+    ],
+)
+def test_parse_amount(s: str, want: int) -> None:
+    assert parse_amount(s) == want
+
+
+@pytest.mark.parametrize("s", ["12.5", "", "abc", "1,23"])
+def test_parse_amount_bad(s: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(s)
+
+
+@pytest.mark.parametrize("v", [1, None, b"1"])
+def test_parse_amount_type(v: object) -> None:
+    with pytest.raises(TypeError):
+        parse_amount(v)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize(
+    "s",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026.1.5",
+        "20260105",
+        "2026年1月5日",
+        "令和8年1月5日",
+        "R8.1.5",
+        "2026-01-05 10:30",
+        "2026/1/5 10:30:15",
+    ],
+    ids=["d1", "d2", "d3", "d4", "d5", "E2-2", "d7", "t1", "t2"],
+)
+def test_parse_date(s: str) -> None:
+    assert parse_date(s) == date(2026, 1, 5)
+
+
+def test_heisei() -> None:
+    assert parse_date("平成30年4月1日") == date(2018, 4, 1)
+
+
+@pytest.mark.parametrize("s", ["2026/2/30", "2026-1/5", "x", ""])
+def test_parse_date_bad(s: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(s)
+
+
+def test_row_errors_collected() -> None:
+    r = parse_statement("日付,金額\n2026/2/30,abc\n2026-01-05,100\n")
+    assert [(e.line, e.column) for e in r.errors] == [(2, "日付"), (2, "金額")]
+    assert r.errors[0].value == "2026/2/30"
+    assert len(r.expenses) == 1
+
+
+E2_3 = "E2-3"
+
+
+def test_E2_3_ids_present() -> None:
+    r = parse_statement("日付,金額\n2026/2/30,abc\n")
+    assert len(r.errors) == 2, E2_3
+
+
+def test_basic_bom_crlf_quotes() -> None:
+    t = '﻿利用日,ご利用金額,ご利用店名\r\n2026/1/5,"1,234円","a,\nb"\r\n\r\n2026/1/6,5,c\r\n'
+    r = parse_statement(t)
+    assert r.errors == []
+    assert r.expenses == [
+        Expense(date(2026, 1, 5), "未分類", 1234, "a,\nb"),
+        Expense(date(2026, 1, 6), "未分類", 5, "c"),
+    ]
+
+
+def test_line_numbers_after_multiline() -> None:
+    t = '日付,金額,メモ\n2026-01-05,100,"a\nb"\nbad,1,x\n'
+    assert parse_statement(t).errors[0].line == 4
+
+
+def test_tab() -> None:
+    r = parse_statement("日付\t金額\tカテゴリ\n2026-01-05\t1,000\t食費\n")
+    assert r.expenses == [Expense(date(2026, 1, 5), "食費", 1000, "")]
+
+
+@pytest.mark.parametrize("t", ["", "   \n", "日付,金額\n", "日付,金額\n\n\n"])
+def test_empty(t: str) -> None:
+    r = parse_statement(t)
+    assert (r.expenses, r.errors, r.skipped) == ([], [], 0)
+
+
+def test_column_count() -> None:
+    r = parse_statement("日付,金額\n2026-01-05,1,234円\n2026-01-05\n")
+    assert [e.reason for e in r.errors] == ["列数が多すぎます", "列数が少なすぎます"]
+    assert r.expenses == []
+
+
+def test_empty_amount_and_zero() -> None:
+    r = parse_statement("日付,金額\n2026-01-05,\n2026-01-06,0\n")
+    assert r.errors[0].column == "金額"
+    assert r.expenses[0].amount == 0
+
+
+def test_two_columns() -> None:
+    t = "日付,出金,入金\n2026-01-05,100,\n2026-01-06,,200\n2026-01-07,1,2\n"
+    r = parse_statement(t)
+    assert [e.amount for e in r.expenses] == [100]
+    assert r.skipped == 1
+    assert len(r.errors) == 1 and r.errors[0].line == 4
+
+
+def test_missing_required() -> None:
+    with pytest.raises(CsvError) as ei:
+        parse_statement("a,b\n1,2\n")
+    assert ei.value.errors[0][0] == 1
+    with pytest.raises(CsvError):
+        parse_statement("日付,メモ\n2026-01-05,x\n")
