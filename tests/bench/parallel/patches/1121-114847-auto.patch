+++ b/tests/test_monthly_diff.py
@@ -0,0 +1,161 @@
+"""Tests for kakeibo.monthly_diff (前月比レポート)."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthly_diff import (
+    CategoryChange,
+    MonthDiff,
+    compare_months,
+    format_report,
+)
+
+
+def _e(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+# 表 E4-1 / E4-2 / E4-3 の各行を ID 付きで写す。
+
+
+def test_E4_1_up_with_pct() -> None:
+    """E4-1: 前月 食費 30000、今月 食費 35000 -> delta=5000, pct=16.7, status="up" (R1 R2)"""
+    rows = [_e("2026-01-10", "食費", 30000), _e("2026-02-10", "食費", 35000)]
+    diff = compare_months(rows, "2026-02")
+    assert diff.changes == [
+        CategoryChange(
+            category="食費",
+            previous=30000,
+            current=35000,
+            delta=5000,
+            pct=16.7,
+            status="up",
+        )
+    ]
+
+
+def test_E4_2_gone_uses_calendar_previous_month() -> None:
+    """E4-2: 1 月にだけ交通費がある入力で "2026-02" を比較 -> 交通費は gone、前月は "2026-01" (D6)"""
+    rows = [_e("2026-01-05", "交通費", 3000), _e("2026-02-05", "食費", 1000)]
+    diff = compare_months(rows, "2026-02")
+    assert diff.previous_month == "2026-01"
+    by_cat = {c.category: c for c in diff.changes}
+    assert by_cat["交通費"].status == "gone"
+    assert by_cat["交通費"].current == 0
+    assert by_cat["食費"].status == "new"
+
+
+@pytest.mark.parametrize("month", ["2026-1"], ids=["E4-3"])
+def test_E4_3_invalid_month_raises_value_error(month: str) -> None:
+    """E4-3: "2026-1" -> ValueError (引数)"""
+    with pytest.raises(ValueError, match="month"):
+        compare_months([], month)
+
+
+# 規則 R1-R6 と判断 D1 / D6 の追加テスト。
+
+
+def test_R1_status_values() -> None:
+    rows = [
+        _e("2026-01-01", "down", 2000),
+        _e("2026-02-01", "down", 1000),
+        _e("2026-01-01", "same", 500),
+        _e("2026-02-01", "same", 500),
+        _e("2026-01-01", "gone", 700),
+        _e("2026-02-01", "new", 900),
+    ]
+    by_cat = {c.category: c.status for c in compare_months(rows, "2026-02").changes}
+    assert by_cat == {"down": "down", "same": "same", "gone": "gone", "new": "new"}
+
+
+def test_R2_pct_none_when_previous_zero() -> None:
+    rows = [_e("2026-02-01", "食費", 1000)]
+    (change,) = compare_months(rows, "2026-02").changes
+    assert change.pct is None
+    assert change.status == "new"
+
+
+def test_R3_sorted_by_abs_delta_desc_then_name_asc_and_excludes_absent() -> None:
+    rows = [
+        _e("2026-01-01", "b", 1000),
+        _e("2026-02-01", "b", 2000),  # delta +1000
+        _e("2026-01-01", "a", 3000),
+        _e("2026-02-01", "a", 2000),  # delta -1000 (同点 -> 名前昇順で a が先)
+        _e("2026-02-01", "c", 5000),  # delta +5000
+        _e("2025-06-01", "x", 9999),  # どちらの月にも無い
+    ]
+    names = [c.category for c in compare_months(rows, "2026-02").changes]
+    assert names == ["c", "a", "b"]
+
+
+def test_R5_january_compares_with_previous_december() -> None:
+    rows = [_e("2025-12-01", "食費", 4000), _e("2026-01-01", "食費", 6000)]
+    diff = compare_months(rows, "2026-01")
+    assert diff.previous_month == "2025-12"
+    assert diff.changes[0].delta == 2000
+    assert diff.changes[0].pct == 50.0
+
+
+def test_R6_empty_input_has_no_changes() -> None:
+    diff = compare_months([], "2026-02")
+    assert diff == MonthDiff(
+        month="2026-02",
+        previous_month="2026-01",
+        changes=[],
+        total_previous=0,
+        total_current=0,
+    )
+
+
+def test_D1_refunds_are_included_in_comparison() -> None:
+    """D1: 返金(負の金額)は前月比に混ぜて合計・比較する。"""
+    rows = [
+        _e("2026-01-01", "食費", 10000),
+        _e("2026-02-01", "食費", 8000),
+        _e("2026-02-02", "食費", -3000),
+    ]
+    diff = compare_months(rows, "2026-02")
+    assert diff.total_current == 5000
+    (change,) = diff.changes
+    assert change.current == 5000
+    assert change.delta == -5000
+    assert change.status == "down"
+
+
+def test_TypeError_for_non_str_month() -> None:
+    with pytest.raises(TypeError, match="month"):
+        compare_months([], 202602)  # type: ignore[arg-type]
+
+
+def test_TypeError_for_non_int_amount() -> None:
+    rows = [_e("2026-02-01", "食費", 1000)]
+    bad = Expense(day=date(2026, 2, 2), category="食費", amount=True)
+    with pytest.raises(TypeError, match="amount"):
+        compare_months([*rows, bad], "2026-02")
+
+
+def test_format_report_lines() -> None:
+    rows = [
+        _e("2026-01-01", "食費", 30000),
+        _e("2026-02-01", "食費", 35000),
+        _e("2026-01-01", "交通費", 3000),
+        _e("2026-02-01", "通信費", 2000),
+    ]
+    text = format_report(compare_months(rows, "2026-02"))
+    assert text.splitlines() == [
+        "食費: 30,000円 → 35,000円 (+5,000円, +16.7%)",
+        "交通費: 3,000円 → 0円 (なくなった)",
+        "通信費: 0円 → 2,000円 (新規)",
+        "合計: 33,000円 → 37,000円 (+4,000円, +12.1%)",
+    ]
+
+
+def test_format_report_no_changes() -> None:
+    rows = [_e("2026-01-01", "食費", 0), _e("2026-02-01", "食費", 0)]
+    text = format_report(compare_months(rows, "2026-02"))
+    assert text.splitlines()[0] == "変化なし"
+    assert text.splitlines()[-1].startswith("合計:")
