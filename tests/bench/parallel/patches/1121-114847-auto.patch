+def test_load_cp932(tmp_path) -> None:  # type: ignore[no-untyped-def]
+    p = tmp_path / "a.csv"
+    p.write_bytes("日付,金額,摘要\n2026-01-05,100,コンビニ\n".encode("cp932"))
+    assert load_statement(p).expenses[0].memo == "コンビニ"
