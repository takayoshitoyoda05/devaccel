index 0000000..af20c35
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,273 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring
+
+
+def _series(category: str, memo: str, amount: int, days: list[str]) -> list[Expense]:
+    return [
+        Expense(day=date.fromisoformat(d), category=category, amount=amount, memo=memo)
+        for d in days
+    ]
+
+
+def _rent(days: list[str]) -> list[Expense]:
+    return _series("家賃", "家賃", 80000, days)
+
+
+def _subs(days: list[str], amount: int = 980) -> list[Expense]:
+    return _series("サブスク", "Netflix", amount, days)
+
+
+# 例の表 E1-1 / E1-2 / E1-3 (ID はテストの ids に書く)
+@pytest.mark.parametrize(
+    ("rows", "expected"),
+    [
+        pytest.param(
+            _rent(["2026-01-31", "2026-02-28", "2026-03-31"]),
+            [
+                Recurring(
+                    category="家賃",
+                    memo="家賃",
+                    amount=80000,
+                    months=3,
+                    last_date=date(2026, 3, 31),
+                    next_date=date(2026, 4, 30),
+                )
+            ],
+            id="E1-1",
+        ),
+        pytest.param(
+            _subs(["2026-01-10", "2026-02-10", "2026-04-10"]),
+            [],
+            id="E1-2",
+        ),
+        pytest.param(
+            _subs(["2026-01-05", "2026-02-05", "2026-03-05"])
+            + _series("サブスク", "Netflix", -980, ["2026-04-05"]),
+            [
+                Recurring(
+                    category="サブスク",
+                    memo="Netflix",
+                    amount=980,
+                    months=3,
+                    last_date=date(2026, 3, 5),
+                    next_date=date(2026, 4, 5),
+                )
+            ],
+            id="E1-3",
+        ),
+    ],
+)
+def test_example_table(rows: list[Expense], expected: list[Recurring]) -> None:
+    assert find_recurring(rows) == expected
+
+
+# D2: 次回は最後の月の翌月、基準日(系列内の最大の日)を末尾に丸める
+@pytest.mark.parametrize(
+    ("days", "next_date"),
+    [
+        pytest.param(
+            ["2025-12-31", "2026-01-31", "2026-02-28"],
+            date(2026, 3, 31),
+            id="31-31-28-then-31",
+        ),
+        pytest.param(
+            ["2025-11-30", "2025-12-31", "2026-01-31"],
+            date(2026, 2, 28),
+            id="next-feb-28",
+        ),
+        pytest.param(
+            ["2027-11-30", "2027-12-31", "2028-01-31"],
+            date(2028, 2, 29),
+            id="next-feb-leap",
+        ),
+    ],
+)
+def test_next_date_rounds_to_month_end(days: list[str], next_date: date) -> None:
+    (rec,) = find_recurring(_rent(days))
+    assert rec.next_date == next_date
+
+
+# R1: 欠けた月があれば最新の連続した並びだけを見る
+def test_only_latest_contiguous_run_counts() -> None:
+    rows = _subs(["2026-01-10", "2026-02-10", "2026-03-10", "2026-04-10", "2026-06-10"])
+    assert find_recurring(rows) == []
+
+
+def test_latest_run_detected_after_gap() -> None:
+    rows = _subs(
+        [
+            "2026-01-10",
+            "2026-02-10",
+            "2026-03-10",
+            "2026-05-10",
+            "2026-06-10",
+            "2026-07-10",
+        ]
+    )
+    (rec,) = find_recurring(rows)
+    assert rec.months == 3
+    assert rec.last_date == date(2026, 7, 10)
+    assert rec.next_date == date(2026, 8, 10)
+
+
+def test_min_count_two_detects_two_months() -> None:
+    rows = _subs(["2026-01-10", "2026-02-10"])
+    assert find_recurring(rows) == []
+    (rec,) = find_recurring(rows, min_count=2)
+    assert rec.months == 2
+
+
+# D1: 返金・負の金額・0 円は系列に混ぜない
+def test_zero_amount_not_a_series() -> None:
+    assert (
+        find_recurring(_subs(["2026-01-10", "2026-02-10", "2026-03-10"], amount=0))
+        == []
+    )
+
+
+# D3: 正規化したメモで同一系列を判定し、メモは最新の元の文字列を返す
+@pytest.mark.parametrize(
+    ("memos", "latest"),
+    [
+        pytest.param(
+            ["Netflix #1", "netflix #2", "ＮＥＴＦＬＩＸ #3"],
+            "ＮＥＴＦＬＩＸ #3",
+            id="hash-number",
+        ),
+        pytest.param(["Gym 12", "gym 13", "GYM 14"], "GYM 14", id="trailing-number"),
+        pytest.param(["Club No.1", "club no.2", "CLUB No.3"], "CLUB No.3", id="no-dot"),
+        pytest.param(
+            ["Spotify  Premium", " spotify premium ", "SPOTIFY\tPREMIUM"],
+            "SPOTIFY\tPREMIUM",
+            id="whitespace",
+        ),
+    ],
+)
+def test_memo_normalization_groups_series(memos: list[str], latest: str) -> None:
+    rows: list[Expense] = []
+    for memo, d in zip(memos, ["2026-01-10", "2026-02-10", "2026-03-10"], strict=True):
+        rows += _series("サブスク", memo, 980, [d])
+    (rec,) = find_recurring(rows)
+    assert rec.memo == latest
+    assert rec.months == 3
+
+
+def test_different_category_is_not_same_series() -> None:
+    rows = (
+        _series("A", "Netflix", 980, ["2026-01-10"])
+        + _series("B", "Netflix", 980, ["2026-02-10"])
+        + _series("A", "Netflix", 980, ["2026-03-10"])
+    )
+    assert find_recurring(rows) == []
+
+
+def test_different_memo_is_not_same_series() -> None:
+    rows = (
+        _subs(["2026-01-10"])
+        + _series("サブスク", "Hulu", 980, ["2026-02-10"])
+        + _subs(["2026-03-10"])
+    )
+    assert find_recurring(rows) == []
+
+
+# D3: 同じ月に 2 件ある系列は毎月ではないので検出しない
+def test_two_per_month_is_not_recurring() -> None:
+    rows = _subs(
+        [
+            "2026-01-05",
+            "2026-01-20",
+            "2026-02-05",
+            "2026-02-20",
+            "2026-03-05",
+            "2026-03-20",
+        ]
+    )
+    assert find_recurring(rows) == []
+
+
+# D3: 金額は中央値の ±tolerance 以内(境界を含む)
+def test_amount_tolerance_is_inclusive() -> None:
+    rows = _subs(["2026-01-10", "2026-02-10", "2026-03-10"], amount=1000)
+    rows[2] = Expense(
+        day=date(2026, 3, 10), category="サブスク", amount=1050, memo="Netflix"
+    )
+    (rec,) = find_recurring(rows)
+    assert rec.amount == 1050
+
+
+def test_amount_outside_tolerance_breaks_run() -> None:
+    rows = _subs(["2026-01-10", "2026-02-10", "2026-03-10"], amount=1000)
+    rows[2] = Expense(
+        day=date(2026, 3, 10), category="サブスク", amount=1060, memo="Netflix"
+    )
+    assert find_recurring(rows) == []
+    (rec,) = find_recurring(rows, amount_tolerance=0.1)
+    assert rec.amount == 1060
+
+
+def test_zero_tolerance_requires_exact_amount() -> None:
+    rows = _subs(["2026-01-10", "2026-02-10", "2026-03-10"], amount=980)
+    (rec,) = find_recurring(rows, amount_tolerance=0)
+    assert rec.months == 3
+
+
+# R3: 並びは next_date 昇順、同点は category、memo
+def test_sorted_by_next_date() -> None:
+    late = _series("A", "late", 500, ["2026-01-31", "2026-02-28", "2026-03-31"])
+    early = _series("A", "early", 500, ["2026-01-15", "2026-02-15", "2026-03-15"])
+    got = find_recurring(late + early)
+    assert [r.memo for r in got] == ["early", "late"]
+
+
+def test_ties_sorted_by_category_then_memo() -> None:
+    rows = (
+        _series("b", "x", 500, ["2026-01-15", "2026-02-15", "2026-03-15"])
+        + _series("a", "z", 500, ["2026-01-15", "2026-02-15", "2026-03-15"])
+        + _series("a", "y", 500, ["2026-01-15", "2026-02-15", "2026-03-15"])
+    )
+    got = find_recurring(rows)
+    assert [(r.category, r.memo) for r in got] == [("a", "y"), ("a", "z"), ("b", "x")]
+
+
+# R4: 空の入力は空リスト、不正な引数は例外
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+@pytest.mark.parametrize("min_count", [1, 0, -1], ids=["one", "zero", "negative"])
+def test_min_count_below_two_is_value_error(min_count: int) -> None:
+    with pytest.raises(ValueError, match="min_count"):
+        find_recurring([], min_count=min_count)
+
+
+@pytest.mark.parametrize(
+    "tolerance", [-0.01, 1.0, 1.5], ids=["negative", "one", "over"]
+)
+def test_tolerance_out_of_range_is_value_error(tolerance: float) -> None:
+    with pytest.raises(ValueError, match="amount_tolerance"):
+        find_recurring([], amount_tolerance=tolerance)
+
+
+@pytest.mark.parametrize("min_count", [True, 3.0], ids=["bool", "float"])
+def test_min_count_wrong_type_is_type_error(min_count: object) -> None:
+    with pytest.raises(TypeError, match="min_count"):
+        find_recurring([], min_count=min_count)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("tolerance", [True, "0.05"], ids=["bool", "str"])
+def test_tolerance_wrong_type_is_type_error(tolerance: object) -> None:
+    with pytest.raises(TypeError, match="amount_tolerance"):
+        find_recurring([], amount_tolerance=tolerance)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("amount", [True, 980.0], ids=["bool", "float"])
+def test_non_int_amount_is_type_error(amount: object) -> None:
+    row = Expense(day=date(2026, 1, 10), category="サブスク", amount=amount, memo="x")  # type: ignore[arg-type]
+    with pytest.raises(TypeError, match="amount"):
+        find_recurring([row])
diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..c55b303
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,194 @@
+from datetime import date, datetime
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    all_of,
+    amount_between,
+    any_of,
+    category_is,
+    date_between,
+    memo_contains,
+    not_,
+    search,
+)
+
+
+def ex(
+    day: date = date(2026, 1, 1),
+    category: str = "食費",
+    amount: int = 500,
+    memo: str = "",
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# 例の表 E3-1 〜 E3-3 をそのまま写す
+@pytest.mark.parametrize(
+    ("pred", "row", "expected"),
+    [
+        pytest.param(amount_between(1000, 1000), ex(amount=1000), True, id="E3-1"),
+        pytest.param(memo_contains("ｽﾀﾊﾞ"), ex(memo="スタバ 渋谷"), True, id="E3-2"),
+        pytest.param(any_of(), ex(), False, id="E3-3"),
+    ],
+)
+def test_spec_table(pred, row, expected):
+    assert pred(row) is expected
+
+
+# R1: 順序を保ち、元のリストを変えない
+def test_search_keeps_order_and_does_not_mutate_input():
+    rows = [ex(amount=300), ex(amount=100), ex(amount=200)]
+    snapshot = list(rows)
+    out = search(rows, amount_between(100, 300))
+    assert [e.amount for e in out] == [300, 100, 200]
+    assert rows == snapshot
+    assert out is not rows
+
+
+# R2: カテゴリは複数名のどれか、前後の空白は無視
+def test_category_is_matches_any_name_and_ignores_outer_spaces():
+    pred = category_is("食費", " 外食 ")
+    assert pred(ex(category="食費"))
+    assert pred(ex(category="外食"))
+    assert not pred(ex(category="食"))
+
+
+def test_category_is_is_exact_not_partial():
+    assert not category_is("食")(ex(category="食費"))
+
+
+def test_category_is_without_names_is_value_error():
+    with pytest.raises(ValueError):
+        category_is()
+
+
+def test_category_is_non_str_name_is_type_error():
+    with pytest.raises(TypeError):
+        category_is("食費", 1)  # type: ignore[arg-type]
+
+
+# R3: None は無制限、low > high は ValueError
+def test_amount_between_none_sides_are_unbounded():
+    assert amount_between(low=500)(ex(amount=10_000))
+    assert not amount_between(low=500)(ex(amount=499))
+    assert amount_between(high=500)(ex(amount=0))
+    assert not amount_between(high=500)(ex(amount=501))
+    assert amount_between()(ex(amount=-1))
+
+
+def test_amount_between_low_above_high_is_value_error():
+    with pytest.raises(ValueError):
+        amount_between(1001, 1000)
+
+
+@pytest.mark.parametrize("bad", [True, 1.0, "100"])
+def test_amount_between_non_int_is_type_error(bad):
+    with pytest.raises(TypeError):
+        amount_between(bad, None)  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        amount_between(None, bad)  # type: ignore[arg-type]
+
+
+def test_date_between_none_sides_are_unbounded():
+    assert date_between(start=date(2026, 2, 1))(ex(day=date(2030, 1, 1)))
+    assert not date_between(start=date(2026, 2, 1))(ex(day=date(2026, 1, 31)))
+    assert date_between(end=date(2026, 2, 1))(ex(day=date(1990, 1, 1)))
+    assert not date_between(end=date(2026, 2, 1))(ex(day=date(2026, 2, 2)))
+
+
+def test_date_between_start_after_end_is_value_error():
+    with pytest.raises(ValueError):
+        date_between(date(2026, 2, 2), date(2026, 2, 1))
+
+
+def test_date_between_datetime_is_type_error():
+    with pytest.raises(TypeError):
+        date_between(datetime(2026, 1, 1), None)
+    with pytest.raises(TypeError):
+        date_between(None, datetime(2026, 1, 1))
+
+
+# D7: 両端を含む
+def test_amount_and_date_ranges_include_both_ends():
+    assert amount_between(100, 200)(ex(amount=100))
+    assert amount_between(100, 200)(ex(amount=200))
+    d = date(2026, 3, 1)
+    assert date_between(d, d)(ex(day=d))
+
+
+# D7: メモは部分一致、NFKC + casefold、空文字は全件一致
+def test_memo_contains_is_partial_and_case_insensitive_after_nfkc():
+    assert memo_contains("渋谷")(ex(memo="スタバ 渋谷店"))
+    assert memo_contains("abc")(ex(memo="ＡＢＣ駅"))
+    assert not memo_contains("新宿")(ex(memo="スタバ 渋谷"))
+
+
+def test_memo_contains_empty_matches_everything():
+    assert memo_contains("")(ex(memo=""))
+    assert memo_contains("")(ex(memo="なんでも"))
+
+
+def test_memo_contains_non_str_is_type_error():
+    with pytest.raises(TypeError):
+        memo_contains(1)  # type: ignore[arg-type]
+
+
+# D7: all_of() は真、any_of() は偽
+def test_all_of_empty_is_true_and_any_of_empty_is_false():
+    assert all_of()(ex())
+    assert not any_of()(ex())
+
+
+# R4: 短絡評価、入れ子
+def test_all_of_short_circuits():
+    calls: list[str] = []
+
+    def false_pred(e: Expense) -> bool:
+        calls.append("first")
+        return False
+
+    def boom(e: Expense) -> bool:
+        calls.append("second")
+        raise AssertionError("should not be called")
+
+    assert not all_of(false_pred, boom)(ex())
+    assert calls == ["first"]
+
+
+def test_any_of_short_circuits():
+    calls: list[str] = []
+
+    def true_pred(e: Expense) -> bool:
+        calls.append("first")
+        return True
+
+    def boom(e: Expense) -> bool:
+        raise AssertionError("should not be called")
+
+    assert any_of(true_pred, boom)(ex())
+    assert calls == ["first"]
+
+
+def test_nested_combinators():
+    pred = all_of(
+        category_is("食費", "外食"),
+        any_of(memo_contains("スタバ"), amount_between(high=100)),
+        not_(date_between(end=date(2025, 12, 31))),
+    )
+    assert pred(ex(category="外食", memo="スタバ", day=date(2026, 1, 1)))
+    assert pred(ex(category="食費", amount=50, day=date(2026, 1, 1)))
+    assert not pred(ex(category="食費", amount=50, day=date(2025, 6, 1)))
+    assert not pred(ex(category="交通", memo="スタバ", day=date(2026, 1, 1)))
+
+
+def test_not_negates():
+    assert not_(memo_contains("x"))(ex(memo="abc"))
+    assert not not_(memo_contains("x"))(ex(memo="x"))
+
+
+# R5: pred が呼べないなら TypeError
+def test_search_non_callable_pred_is_type_error():
+    with pytest.raises(TypeError):
+        search([ex()], "not callable")  # type: ignore[arg-type]
