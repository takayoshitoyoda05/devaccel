index 0000000..e2916b3
--- /dev/null
+++ b/src/kakeibo/statement.py
@@ -0,0 +1,208 @@
+"""銀行/カード明細 CSV の取り込み(純粋関数)。
+
+D4: 金額 1 列なら正が支出、負(-300 −300 △500 ▲500 (500) 500-)は返金で負の amount。
+    2 列(出金/入金)なら出金のみ=支出、入金のみ=skipped に数える、両方=エラー。
+D5: 行の誤りは例外にせず RowError に全部集める。必須列が無い時だけ CsvError([(1, 理由)])。
+    カテゴリ列が無い/空なら「未分類」。
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+from pathlib import Path
+
+from kakeibo.core import CsvError, Expense
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str
+    value: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class StatementResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+    skipped: int
+
+
+_ALIASES = {
+    "date": ("日付", "利用日", "取引日", "ご利用日", "date"),
+    "amount": ("金額", "利用金額", "ご利用金額", "amount"),
+    "out": ("出金額", "出金", "お支払金額", "支払"),
+    "in": ("入金額", "入金", "預入"),
+    "memo": ("摘要", "メモ", "利用店名", "ご利用店名", "内容", "description", "memo"),
+    "category": ("カテゴリ", "分類", "category"),
+}
+
+
+def _norm_name(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip().casefold()
+
+
+_NAME_TO_KEY = {_norm_name(a): k for k, v in _ALIASES.items() for a in v}
+
+_NEG_PREFIX = "-−△▲"
+_DIGITS = re.compile(r"[0-9]+(,[0-9]{3})*(\.0+)?")
+
+
+def parse_amount(s: str) -> int:
+    if not isinstance(s, str):
+        raise TypeError(f"s は str である必要があります: {type(s).__name__}")
+    t = "".join(unicodedata.normalize("NFKC", s).split())
+    neg = False
+    if t and t[0] in _NEG_PREFIX:
+        neg, t = True, t[1:]
+    elif len(t) >= 2 and t[0] == "(" and t[-1] == ")":
+        neg, t = True, t[1:-1]
+    elif t.endswith(("-", "−")):
+        neg, t = True, t[:-1]
+    if t.startswith("¥"):
+        t = t[1:]
+    elif t.upper().startswith("JPY"):
+        t = t[3:]
+    t = t.removesuffix("円")
+    if not _DIGITS.fullmatch(t):
+        raise ValueError(f"金額として読めません: {s!r}")
+    n = int(t.split(".")[0].replace(",", ""))
+    return -n if neg else n
+
+
+_TIME = re.compile(r"[ T]+[0-9]{1,2}:[0-9]{2}(:[0-9]{2})?$")
+_ERAS = {"令和": 2018, "r": 2018, "平成": 1988, "h": 1988}
+_RE_SEP = re.compile(r"([0-9]{4})([-/.])([0-9]{1,2})\2([0-9]{1,2})")
+_RE_COMPACT = re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})")
+_RE_KANJI = re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日?")
+_RE_ERA = re.compile(
+    r"(令和|平成|r|h)([0-9]{1,2}|元)[年.]([0-9]{1,2})[月.]([0-9]{1,2})日?"
+)
+
+
+def parse_date(s: str) -> date:
+    if not isinstance(s, str):
+        raise TypeError(f"s は str である必要があります: {type(s).__name__}")
+    t = unicodedata.normalize("NFKC", s).strip()
+    t = _TIME.sub("", t).strip().casefold()
+    try:
+        for rx in (_RE_SEP, _RE_COMPACT, _RE_KANJI):
+            m = rx.fullmatch(t)
+            if m:
+                g = m.groups()
+                if rx is _RE_SEP:
+                    g = (g[0], g[2], g[3])
+                return date(int(g[0]), int(g[1]), int(g[2]))
+        m = _RE_ERA.fullmatch(t)
+        if m:
+            y = 1 if m.group(2) == "元" else int(m.group(2))
+            return date(_ERAS[m.group(1)] + y, int(m.group(3)), int(m.group(4)))
+    except ValueError:
+        pass
+    raise ValueError(f"日付として読めません: {s!r}")
+
+
+def _read_records(text: str) -> list[tuple[int, list[str]]]:
+    first = next((ln for ln in text.splitlines() if ln.strip()), "")
+    delim = "\t" if first.count("\t") > first.count(",") else ","
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delim)
+    out: list[tuple[int, list[str]]] = []
+    prev = 0
+    for rec in reader:
+        start = prev + 1
+        prev = reader.line_num
+        if any(c.strip() for c in rec):
+            out.append((start, rec))
+    return out
+
+
+def parse_statement(text: str) -> StatementResult:
+    if not isinstance(text, str):
+        raise TypeError(f"text は str である必要があります: {type(text).__name__}")
+    text = text.lstrip("﻿")
+    records = _read_records(text)
+    if not records:
+        return StatementResult([], [], 0)
+    _, header = records[0]
+    idx: dict[str, int] = {}
+    for i, h in enumerate(header):
+        k = _NAME_TO_KEY.get(_norm_name(h))
+        if k and k not in idx:
+            idx[k] = i
+    if "date" not in idx:
+        raise CsvError([(1, "日付の列が見つかりません")])
+    two = "amount" not in idx
+    if two and "out" not in idx and "in" not in idx:
+        raise CsvError([(1, "金額の列が見つかりません")])
+    width = len(header)
+
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    skipped = 0
+
+    def cell(row: list[str], key: str) -> str:
+        return row[idx[key]] if key in idx else ""
+
+    for line, row in records[1:]:
+        if len(row) != width:
+            why = "列数が多すぎます" if len(row) > width else "列数が少なすぎます"
+            errors.append(RowError(line, "", ",".join(row), why))
+            continue
+        row_errs: list[RowError] = []
+        day: date | None = None
+        amount: int | None = None
+        dv = cell(row, "date")
+        try:
+            day = parse_date(dv)
+        except ValueError as e:
+            row_errs.append(RowError(line, "日付", dv, str(e)))
+        if not two:
+            av = cell(row, "amount")
+            if not av.strip():
+                row_errs.append(RowError(line, "金額", av, "金額が空です"))
+            else:
+                try:
+                    amount = parse_amount(av)
+                except ValueError as e:
+                    row_errs.append(RowError(line, "金額", av, str(e)))
+        else:
+            ov, iv = cell(row, "out"), cell(row, "in")
+            o, i = ov.strip(), iv.strip()
+            if o and i:
+                row_errs.append(
+                    RowError(line, "出金額", ov, "出金と入金の両方が入力されています")
+                )
+            elif i:
+                skipped += 1
+                if row_errs:
+                    errors.extend(row_errs)
+                    skipped -= 1
+                continue
+            elif not o:
+                row_errs.append(RowError(line, "金額", ov, "金額が空です"))
+            else:
+                try:
+                    amount = parse_amount(ov)
+                except ValueError as e:
+                    row_errs.append(RowError(line, "出金額", ov, str(e)))
+        if row_errs or day is None or amount is None:
+            errors.extend(row_errs)
+            continue
+        cat = cell(row, "category").strip() or "未分類"
+        expenses.append(Expense(day, cat, amount, cell(row, "memo").strip()))
+    return StatementResult(expenses, errors, skipped)
+
+
+def load_statement(path: Path) -> StatementResult:
+    data = path.read_bytes()
+    try:
+        text = data.decode("utf-8-sig")
+    except UnicodeDecodeError:
+        text = data.decode("cp932")
+    return parse_statement(text)
