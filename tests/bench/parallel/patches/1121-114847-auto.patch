+"""Predicates and search over Expense rows (pure functions, stdlib only).
+
+D7: 検索の範囲(金額・期間)は両端を含む。メモの一致は部分一致で NFKC + casefold。
+    空文字の memo_contains("") は全件一致。all_of() は真、any_of() は偽。
+R1: search は元の並びを保ち、元のリストを変更しない。
+R2: category_is は複数名のどれかに完全一致(前後の空白は無視)。名前が 0 個なら ValueError。
+R3: amount_between と date_between は None の側を無制限とする。low > high・start > end は ValueError。
+    bool・int でない金額は TypeError。date_between で datetime を渡すと TypeError。
+R4: all_of・any_of は短絡評価し、入れ子にできる。
+R5: search の pred が呼び出せないなら TypeError。
+"""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable
+from datetime import date, datetime
+
+from kakeibo.core import Expense
+
+Predicate = Callable[[Expense], bool]
+
+
+def _normalize(text: str) -> str:
+    return unicodedata.normalize("NFKC", text).casefold()
+
+
+def _check_yen(value: object, name: str) -> int | None:
+    if value is None:
+        return None
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{name} は int である必要があります: {type(value).__name__}")
+    return value
+
+
+def _check_day(value: object, name: str) -> date | None:
+    if value is None:
+        return None
+    if isinstance(value, datetime) or not isinstance(value, date):
+        raise TypeError(f"{name} は date である必要があります: {type(value).__name__}")
+    return value
+
+
+def category_is(*names: str) -> Predicate:
+    if not names:
+        raise ValueError("category_is には名前を 1 つ以上渡してください")
+    for n in names:
+        if not isinstance(n, str):
+            raise TypeError(f"category_is の名前は str である必要があります: {n!r}")
+    wanted = frozenset(n.strip() for n in names)
+
+    def pred(e: Expense) -> bool:
+        return e.category.strip() in wanted
+
+    return pred
+
+
+def amount_between(low: int | None = None, high: int | None = None) -> Predicate:
+    lo = _check_yen(low, "low")
+    hi = _check_yen(high, "high")
+    if lo is not None and hi is not None and lo > hi:
+        raise ValueError(f"low ({lo}) > high ({hi}) です")
+
+    def pred(e: Expense) -> bool:
+        return (lo is None or e.amount >= lo) and (hi is None or e.amount <= hi)
+
+    return pred
+
+
+def memo_contains(text: str) -> Predicate:
+    if not isinstance(text, str):
+        raise TypeError(f"text は str である必要があります: {type(text).__name__}")
+    needle = _normalize(text)
+
+    def pred(e: Expense) -> bool:
+        return needle in _normalize(e.memo)
+
+    return pred
+
+
+def date_between(start: date | None = None, end: date | None = None) -> Predicate:
+    s = _check_day(start, "start")
+    t = _check_day(end, "end")
+    if s is not None and t is not None and s > t:
+        raise ValueError(f"start ({s}) > end ({t}) です")
+
+    def pred(e: Expense) -> bool:
+        return (s is None or e.day >= s) and (t is None or e.day <= t)
+
+    return pred
+
+
+def all_of(*preds: Predicate) -> Predicate:
+    def pred(e: Expense) -> bool:
+        return all(p(e) for p in preds)
+
+    return pred
+
+
+def any_of(*preds: Predicate) -> Predicate:
+    def pred(e: Expense) -> bool:
+        return any(p(e) for p in preds)
+
+    return pred
+
+
+def not_(pred: Predicate) -> Predicate:
+    def negated(e: Expense) -> bool:
+        return not pred(e)
+
+    return negated
+
+
+def search(rows: list[Expense], pred: Predicate) -> list[Expense]:
+    if not callable(pred):
+        raise TypeError(
+            f"search の pred は呼び出せる必要があります: {type(pred).__name__}"
+        )
+    return [e for e in rows if pred(e)]
