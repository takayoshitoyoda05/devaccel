@@ -0,0 +1,145 @@
+"""前月比レポート(純粋関数のみ、標準ライブラリのみ)。
+
+判断:
+- D1: 返金(負の金額)は前月比に混ぜ、そのまま合計・比較する。
+- D6: 「前の月」は暦の前月。データに無い月は空の月として全カテゴリ 0 と比べる。
+  増減率は前月が 0 のとき None。
+
+規則:
+- R1: status は "up" / "down" / "new"(前月に無く今月にある) / "gone"(前月にあり今月に無い) / "same"。
+- R2: pct は delta / previous * 100 を小数第 1 位に丸める(previous == 0 なら None)。
+- R3: changes は abs(delta) の降順、同点はカテゴリ名の昇順。両月のどちらにも無いカテゴリは含めない。
+- R4: format_report は増減のあるカテゴリを 1 行ずつ出し、最後に合計行を付ける。
+  増減が無ければ「変化なし」。
+- R5: 前月は monthly_totals を使って求める(1 月の前月は前年 12 月)。
+- R6: 空の入力でも例外にせず changes は空。
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense, monthly_totals
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+@dataclass(frozen=True)
+class MonthDiff:
+    month: str
+    previous_month: str
+    changes: list[CategoryChange]
+    total_previous: int
+    total_current: int
+
+
+def _previous_month(month: str) -> str:
+    year, mon = int(month[:4]), int(month[5:])
+    if mon == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mon - 1:02d}"
+
+
+def _pct(delta: int, previous: int) -> float | None:
+    if previous == 0:
+        return None
+    return round(delta / previous * 100, 1)
+
+
+def _status(in_prev: bool, in_cur: bool, delta: int) -> str:
+    if not in_prev and in_cur:
+        return "new"
+    if in_prev and not in_cur:
+        return "gone"
+    if delta > 0:
+        return "up"
+    if delta < 0:
+        return "down"
+    return "same"
+
+
+def compare_months(rows: list[Expense], month: str) -> MonthDiff:
+    """month(YYYY-MM)と暦の前月のカテゴリ別合計を比べる。"""
+    if not isinstance(month, str):
+        raise TypeError(f"month は str である必要があります: {type(month).__name__}")
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"month は YYYY-MM 形式で指定してください: {month!r}")
+    for i, e in enumerate(rows):
+        if isinstance(e.amount, bool) or not isinstance(e.amount, int):
+            raise TypeError(
+                f"rows[{i}].amount は int である必要があります: {e.amount!r}"
+            )
+
+    prev_month = _previous_month(month)
+    totals = monthly_totals(rows)
+    prev = totals.get(prev_month, {})
+    cur = totals.get(month, {})
+
+    changes: list[CategoryChange] = []
+    for cat in set(prev) | set(cur):
+        p = prev.get(cat, 0)
+        c = cur.get(cat, 0)
+        delta = c - p
+        changes.append(
+            CategoryChange(
+                category=cat,
+                previous=p,
+                current=c,
+                delta=delta,
+                pct=_pct(delta, p),
+                status=_status(cat in prev, cat in cur, delta),
+            )
+        )
+    changes.sort(key=lambda ch: (-abs(ch.delta), ch.category))
+
+    return MonthDiff(
+        month=month,
+        previous_month=prev_month,
+        changes=changes,
+        total_previous=sum(prev.values()),
+        total_current=sum(cur.values()),
+    )
+
+
+def _signed_yen(n: int) -> str:
+    return f"{n:+,}円"
+
+
+def _pct_part(pct: float | None) -> str:
+    return "" if pct is None else f", {pct:+.1f}%"
+
+
+def format_report(diff: MonthDiff) -> str:
+    """日本語の前月比レポート。増減の無いカテゴリ(same)は表示しない。"""
+    lines: list[str] = []
+    for ch in diff.changes:
+        if ch.status == "same":
+            continue
+        base = f"{ch.category}: {ch.previous:,}円 → {ch.current:,}円"
+        if ch.status == "new":
+            lines.append(f"{base} (新規)")
+        elif ch.status == "gone":
+            lines.append(f"{base} (なくなった)")
+        else:
+            lines.append(f"{base} ({_signed_yen(ch.delta)}{_pct_part(ch.pct)})")
+    if not lines:
+        lines.append("変化なし")
+
+    total_delta = diff.total_current - diff.total_previous
+    total_pct = _pct(total_delta, diff.total_previous)
+    lines.append(
+        f"合計: {diff.total_previous:,}円 → {diff.total_current:,}円 "
+        f"({_signed_yen(total_delta)}{_pct_part(total_pct)})"
+    )
+    return "\n".join(lines)
