+++ b/tests/test_bankimport.py
@@ -0,0 +1,100 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import parse_bank_csv
+
+
+def test_card_csv_with_aliases_and_bom():
+    text = '﻿利用日,ご利用店名,利用金額\r\n2026/1/5,"A, B店","1,200円"\r\n2026年1月6日,C,¥300\r\n'
+    r = parse_bank_csv(text)
+    assert r.errors == []
+    assert [(e.day, e.memo, e.amount, e.category) for e in r.expenses] == [
+        (date(2026, 1, 5), "A, B店", 1200, "未分類"),
+        (date(2026, 1, 6), "C", 300, "未分類"),
+    ]
+
+
+@pytest.mark.parametrize(
+    "raw,want",
+    [
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("１，２３４", 1234),
+        ("JPY 1,000", 1000),
+        ("￥７００", 700),
+    ],
+)
+def test_amount_styles(raw, want):
+    r = parse_bank_csv(f'date,amount\n2026-01-01,"{raw}"\n')
+    assert r.errors == [] and r.expenses[0].amount == want
+
+
+@pytest.mark.parametrize("raw", ["", "-", "—", "12.5", "abc", "0"])
+def test_bad_amounts_reported(raw):
+    r = parse_bank_csv(f'date,amount\n2026-01-01,"{raw}"\n')
+    assert r.expenses == []
+    assert len(r.errors) == 1
+    e = r.errors[0]
+    assert (e.line, e.column, e.value) == (2, "amount", raw)
+
+
+def test_all_errors_in_row_reported_and_good_rows_kept():
+    text = "date,amount\n2026/2/30,abc\n2026-01-02,100\n"
+    r = parse_bank_csv(text)
+    assert [e.column for e in r.errors] == ["date", "amount"]
+    assert all(e.line == 2 for e in r.errors)
+    assert r.expenses[0].amount == 100
+
+
+def test_split_columns():
+    text = "取引日\t摘要\t出金額\t入金額\n2026-01-01\tコンビニ\t1,000\t\n2026-01-02\t返金\t\t5,000\n2026-01-03\tx\t1\t2\n"
+    r = parse_bank_csv(text)
+    assert [e.amount for e in r.expenses] == [1000, -5000]
+    assert len(r.errors) == 1 and r.errors[0].line == 4
+
+
+def test_amount_column_wins_over_split():
+    r = parse_bank_csv("date,amount,出金\n2026-01-01,500,900\n")
+    assert r.expenses[0].amount == 500
+
+
+def test_category_column_and_case_insensitive_header():
+    r = parse_bank_csv(" Date ,CATEGORY, Amount ,Memo\n2026-01-01,food,100,x\n")
+    assert r.expenses[0].category == "food" and r.expenses[0].memo == "x"
+
+
+def test_date_with_time_and_bad_forms():
+    r = parse_bank_csv(
+        "date,amount\n2026-01-01 12:30,100\n2026.1.2,200\n01/02/2026,300\n"
+    )
+    assert [e.day for e in r.expenses] == [date(2026, 1, 1), date(2026, 1, 2)]
+    assert r.errors[0].line == 4 and r.errors[0].column == "date"
+
+
+def test_line_number_is_record_start_with_multiline_quote():
+    text = 'date,amount,memo\n2026-01-01,100,"a\nb"\n2026-01-02,x,y\n'
+    r = parse_bank_csv(text)
+    assert r.expenses[0].memo == "a\nb"
+    assert r.errors[0].line == 4
+
+
+def test_short_long_and_blank_rows():
+    text = "date,amount,memo\n\n2026-01-01\n2026-01-02,1,m,extra\n"
+    r = parse_bank_csv(text)
+    assert r.expenses == []
+    assert (r.errors[0].line, r.errors[0].column) == (3, "amount")
+    assert (r.errors[1].line, r.errors[1].column) == (4, "(行全体)")
+
+
+def test_empty_header_only_and_missing_columns():
+    assert parse_bank_csv("").expenses == []
+    assert parse_bank_csv("date,amount\n").errors == []
+    with pytest.raises(ValueError, match="日付"):
+        parse_bank_csv("amount\n1\n")
+    with pytest.raises(ValueError, match="金額"):
+        parse_bank_csv("date,memo\n2026-01-01,x\n")
diff --git a/tests/test_monthly_diff.py b/tests/test_monthly_diff.py
new file mode 100644
index 0000000..6730bff
--- /dev/null
+++ b/tests/test_monthly_diff.py
@@ -0,0 +1,62 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthly_diff import compare_months, format_diff_report
+
+DATA = [
+    Expense(date(2025, 12, 5), "food", 1000),
+    Expense(date(2025, 12, 6), "gone", 400),
+    Expense(date(2026, 1, 5), "food", 1500),
+    Expense(date(2026, 1, 9), "food", 500),
+    Expense(date(2026, 1, 9), "new", 300),
+    Expense(date(2026, 1, 9), "food", -999),  # refund ignored
+    Expense(date(2026, 2, 1), "other", 9999),  # other month ignored
+]
+
+
+def test_default_prev_wraps_year_and_values():
+    d = {x.category: x for x in compare_months(DATA, "2026-01")}
+    assert (d["food"].prev, d["food"].current, d["food"].delta) == (1000, 2000, 1000)
+    assert d["food"].pct == 100.0 and d["food"].trend == "up"
+    assert (
+        d["gone"].current == 0 and d["gone"].trend == "down" and d["gone"].pct == -100.0
+    )
+    assert d["new"].prev == 0 and d["new"].pct is None and d["new"].trend == "up"
+    assert "other" not in d
+
+
+def test_ordering_abs_delta_then_name():
+    assert [x.category for x in compare_months(DATA, "2026-01")] == [
+        "food",
+        "gone",
+        "new",
+    ]
+
+
+def test_explicit_prev_and_same():
+    xs = [Expense(date(2026, 3, 1), "a", 100), Expense(date(2026, 1, 1), "a", 100)]
+    (d,) = compare_months(xs, "2026-03", "2026-01")
+    assert d.trend == "same" and d.delta == 0 and d.pct == 0.0
+
+
+def test_rounding():
+    xs = [Expense(date(2026, 1, 1), "a", 3), Expense(date(2026, 2, 1), "a", 4)]
+    assert compare_months(xs, "2026-02")[0].pct == 33.3
+
+
+def test_empty_and_invalid():
+    assert compare_months([], "2026-01") == []
+    for bad in ("2026-13", "2026-1", "202601", "x"):
+        with pytest.raises(ValueError):
+            compare_months(DATA, bad)
+    with pytest.raises(ValueError):
+        compare_months(DATA, "2026-01", "bad")
+
+
+def test_report_format():
+    text = format_diff_report(compare_months(DATA, "2026-01"))
+    assert text.splitlines()[0] == "food  1000→2000  +1000円 (+100.0%)"
+    assert text.splitlines()[2] == "new  0→300  +300円 (新規)"
+    assert format_diff_report([]) == "変化なし"
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..0b22391
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,101 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, normalize_memo, predict_next
+
+
+def _e(d: str, amount: int, memo: str = "", cat: str = "sub") -> Expense:
+    return Expense(date.fromisoformat(d), cat, amount, memo)
+
+
+def test_basic_series_and_prediction():
+    xs = [_e(f"2026-0{m}-05", 980, "Netflix") for m in (1, 2, 3)]
+    (r,) = find_recurring(xs)
+    assert r.months == ("2026-01", "2026-02", "2026-03")
+    assert r.typical_day == 5
+    assert predict_next(r) == date(2026, 4, 5)
+
+
+def test_month_end_clamps():
+    r = Recurring("c", "m", 1, ("a",), 31, date(2026, 1, 31))
+    assert predict_next(r) == date(2026, 2, 28)
+    r = Recurring("c", "m", 1, ("a",), 31, date(2024, 1, 31))
+    assert predict_next(r) == date(2024, 2, 29)
+    r = Recurring("c", "m", 1, ("a",), 31, date(2026, 3, 31))
+    assert predict_next(r) == date(2026, 4, 30)
+
+
+def test_december_rolls_to_january():
+    r = Recurring("c", "m", 1, ("a",), 15, date(2026, 12, 15))
+    assert predict_next(r) == date(2027, 1, 15)
+
+
+def test_price_change_is_separate_series():
+    xs = [_e(f"2026-0{m}-01", 80000, "rent", "home") for m in (1, 2, 3)]
+    xs.append(_e("2026-04-01", 82000, "rent", "home"))
+    found = find_recurring(xs)
+    assert [r.amount for r in found] == [80000]
+    assert found[0].months == ("2026-01", "2026-02", "2026-03")
+
+
+def test_same_category_amount_different_memo_split():
+    xs = []
+    for m in (1, 2, 3):
+        xs.append(_e(f"2026-0{m}-05", 500, "alpha"))
+        xs.append(_e(f"2026-0{m}-20", 500, "beta"))
+    found = find_recurring(xs)
+    assert [r.memo_key for r in found] == ["alpha", "beta"]
+    assert [r.typical_day for r in found] == [5, 20]
+
+
+def test_gap_months_allowed_and_same_month_counts_once():
+    xs = [
+        _e("2026-01-05", 100, "x"),
+        _e("2026-03-05", 100, "x"),
+        _e("2026-06-05", 100, "x"),
+    ]
+    assert len(find_recurring(xs)) == 1
+    twice = [
+        _e("2026-01-05", 100, "x"),
+        _e("2026-01-25", 100, "x"),
+        _e("2026-02-05", 100, "x"),
+    ]
+    assert find_recurring(twice) == []
+
+
+def test_refunds_ignored():
+    xs = [_e(f"2026-0{m}-05", -100, "x") for m in (1, 2, 3)]
+    assert find_recurring(xs) == []
+
+
+def test_memo_normalization_merges_trailing_numbers():
+    assert normalize_memo("ＮＥＴＦＬＩＸ  #12") == "netflix"
+    xs = [
+        _e("2026-01-05", 100, "Gym 1"),
+        _e("2026-02-05", 100, "gym(2)"),
+        _e("2026-03-05", 100, "GYM 3"),
+    ]
+    assert len(find_recurring(xs)) == 1
+
+
+def test_ordering():
+    xs = []
+    for m in (1, 2, 3):
+        xs.append(_e(f"2026-0{m}-01", 100, "b"))
+        xs.append(_e(f"2026-0{m}-01", 100, "a"))
+        xs.append(_e(f"2026-0{m}-01", 900, "z"))
+    assert [(r.amount, r.memo_key) for r in find_recurring(xs)] == [
+        (900, "z"),
+        (100, "a"),
+        (100, "b"),
+    ]
+
+
+def test_min_months_validation_and_empty():
+    with pytest.raises(ValueError):
+        find_recurring([], min_months=1)
+    assert find_recurring([]) == []
+    xs = [_e("2026-01-05", 1, "x"), _e("2026-02-05", 1, "x")]
+    assert len(find_recurring(xs, min_months=2)) == 1
diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..5e7ea8f
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,80 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    all_of,
+    amount_between,
+    any_of,
+    category,
+    date_between,
+    memo_contains,
+    not_,
+    search,
+)
+
+DATA = [
+    Expense(date(2026, 11, 1), "food", 1200, "Lunch"),
+    Expense(date(2026, 11, 2), "rent", 80000, ""),
+    Expense(date(2026, 11, 3), "food", 800, "coffee"),
+    Expense(date(2026, 11, 4), "fun", -500, "NETFLIX 返金"),
+]
+
+
+def _cats(q):
+    return [e.category for e in search(DATA, q)]
+
+
+def test_empty_all_any():
+    assert search(DATA, all_of()) == DATA
+    assert search(DATA, any_of()) == []
+
+
+def test_category_exact_and_multiple():
+    assert _cats(category("food")) == ["food", "food"]
+    assert _cats(category("food", "rent")) == ["food", "rent", "food"]
+    assert _cats(category("foo")) == []
+    with pytest.raises(ValueError):
+        category()
+
+
+def test_amount_range_inclusive_and_open():
+    assert [e.amount for e in search(DATA, amount_between(800, 1200))] == [1200, 800]
+    assert [e.amount for e in search(DATA, amount_between(None, 0))] == [-500]
+    assert len(search(DATA, amount_between(None, None))) == 4
+    with pytest.raises(ValueError):
+        amount_between(500, 100)
+
+
+def test_date_range_inclusive():
+    q = date_between(date(2026, 11, 2), date(2026, 11, 3))
+    assert _cats(q) == ["rent", "food"]
+    assert len(search(DATA, date_between(start=date(2026, 11, 4)))) == 1
+    with pytest.raises(ValueError):
+        date_between(date(2026, 11, 3), date(2026, 11, 1))
+
+
+def test_memo_contains_normalizes():
+    assert _cats(memo_contains("ｌｕｎｃｈ")) == ["food"]
+    assert _cats(memo_contains("netflix")) == ["fun"]
+    assert len(search(DATA, memo_contains(""))) == 4
+
+
+def test_combinators_and_nesting():
+    q = all_of(
+        category("food"), any_of(amount_between(1000, None), memo_contains("coffee"))
+    )
+    assert len(search(DATA, q)) == 2
+    assert _cats(not_(category("food"))) == ["rent", "fun"]
+    q2 = any_of(
+        category("rent"), all_of(category("food"), not_(memo_contains("lunch")))
+    )
+    assert _cats(q2) == ["rent", "food"]
+
+
+def test_order_preserved_and_input_untouched():
+    snapshot = list(DATA)
+    out = search(DATA, all_of())
+    assert out == snapshot and out is not DATA
+    assert DATA == snapshot
