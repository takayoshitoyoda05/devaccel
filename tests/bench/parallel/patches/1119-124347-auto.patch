index 0000000..b25f80c
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,66 @@
+"""Composable filters over expenses."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Query:
+    predicate: Callable[[Expense], bool]
+
+    def matches(self, e: Expense) -> bool:
+        return self.predicate(e)
+
+
+def category(*names: str) -> Query:
+    if not names:
+        raise ValueError("category には 1 つ以上の名前が必要です")
+    wanted = frozenset(n.strip() for n in names)
+    return Query(lambda e: e.category.strip() in wanted)
+
+
+def amount_between(lo: int | None = None, hi: int | None = None) -> Query:
+    if lo is not None and hi is not None and lo > hi:
+        raise ValueError(f"下限が上限より大きいです: {lo} > {hi}")
+    return Query(
+        lambda e: (lo is None or e.amount >= lo) and (hi is None or e.amount <= hi)
+    )
+
+
+def date_between(start: date | None = None, end: date | None = None) -> Query:
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"開始が終了より後です: {start} > {end}")
+    return Query(
+        lambda e: (start is None or e.day >= start) and (end is None or e.day <= end)
+    )
+
+
+def _fold(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).lower()
+
+
+def memo_contains(text: str) -> Query:
+    needle = _fold(text)
+    return Query(lambda e: needle in _fold(e.memo))
+
+
+def all_of(*qs: Query) -> Query:
+    return Query(lambda e: all(q.matches(e) for q in qs))
+
+
+def any_of(*qs: Query) -> Query:
+    return Query(lambda e: any(q.matches(e) for q in qs))
+
+
+def not_(q: Query) -> Query:
+    return Query(lambda e: not q.matches(e))
+
+
+def search(expenses: list[Expense], query: Query) -> list[Expense]:
+    return [e for e in expenses if query.matches(e)]
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
