@@ -0,0 +1,65 @@
+"""Detect monthly recurring expenses and predict the next occurrence."""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+from statistics import median
+
+from kakeibo.core import Expense
+
+_TRAILING = re.compile(r"(?:#\d+|\(\d+\)|\d+)+$")
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo_key: str
+    amount: int
+    months: tuple[str, ...]
+    typical_day: int
+    last_date: date
+
+
+def normalize_memo(memo: str) -> str:
+    s = unicodedata.normalize("NFKC", memo).lower()
+    s = "".join(s.split())
+    return _TRAILING.sub("", s)
+
+
+def find_recurring(expenses: list[Expense], min_months: int = 3) -> list[Recurring]:
+    if min_months < 2:
+        raise ValueError(f"min_months は 2 以上にしてください: {min_months}")
+    groups: dict[tuple[str, str, int], list[Expense]] = {}
+    for e in expenses:
+        if e.amount <= 0:
+            continue
+        key = (e.category, normalize_memo(e.memo), e.amount)
+        groups.setdefault(key, []).append(e)
+    found: list[Recurring] = []
+    for (category, memo_key, amount), items in groups.items():
+        months = sorted({f"{e.day.year:04d}-{e.day.month:02d}" for e in items})
+        if len(months) < min_months:
+            continue
+        found.append(
+            Recurring(
+                category=category,
+                memo_key=memo_key,
+                amount=amount,
+                months=tuple(months),
+                typical_day=int(median(e.day.day for e in items)),
+                last_date=max(e.day for e in items),
+            )
+        )
+    found.sort(key=lambda r: (-r.amount, r.memo_key, r.category))
+    return found
+
+
+def predict_next(r: Recurring) -> date:
+    y, m = r.last_date.year, r.last_date.month + 1
+    if m > 12:
+        y, m = y + 1, 1
+    return date(y, m, min(r.typical_day, calendar.monthrange(y, m)[1]))
