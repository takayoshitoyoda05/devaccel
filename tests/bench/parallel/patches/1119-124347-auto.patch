@@ -0,0 +1,207 @@
+"""Import bank / credit-card CSV text with varied headers and amount styles."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass, field
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str
+    value: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense] = field(default_factory=list)
+    errors: list[RowError] = field(default_factory=list)
+
+
+_ALIASES: dict[str, tuple[str, ...]] = {
+    "date": ("日付", "利用日", "取引日", "ご利用日", "date"),
+    "amount": ("金額", "利用金額", "ご利用金額", "amount"),
+    "out": ("出金", "出金額", "お支払金額", "支払"),
+    "in": ("入金", "入金額", "預入"),
+    "memo": ("摘要", "メモ", "利用店名", "ご利用店名", "内容", "description", "memo"),
+    "category": ("カテゴリ", "費目", "category"),
+}
+
+_DATE_RE = re.compile(r"(\d{4})[-/.年](\d{1,2})[-/.月](\d{1,2})日?")
+_STRIP = re.compile(r"[¥￥,\s]|円|JPY", re.IGNORECASE)
+_MINUS = "-−"
+
+
+def _norm_header(h: str) -> str:
+    return unicodedata.normalize("NFKC", h).strip().lower()
+
+
+def _find_columns(header: list[str]) -> dict[str, int]:
+    normed = {_norm_header(h): i for i, h in enumerate(header)}
+    cols: dict[str, int] = {}
+    for key, names in _ALIASES.items():
+        for n in names:
+            i = normed.get(_norm_header(n))
+            if i is not None:
+                cols[key] = i
+                break
+    return cols
+
+
+def _parse_amount(raw: str) -> int:
+    """Parse to a signed int (negative = refund). Raise ValueError on bad input."""
+    s = unicodedata.normalize("NFKC", raw)
+    s = s.replace("−", "-").replace("△", "-").replace("▲", "-")
+    s = _STRIP.sub("", s)
+    neg = False
+    if len(s) >= 2 and s.startswith("(") and s.endswith(")"):
+        neg, s = True, s[1:-1]
+    elif s.endswith("-"):
+        neg, s = True, s[:-1]
+    elif s.startswith("-"):
+        neg, s = True, s[1:]
+    if not s.isascii() or not s.isdigit():
+        raise ValueError("金額を整数として読めません")
+    n = int(s)
+    if n == 0:
+        raise ValueError("金額が 0 です")
+    return -n if neg else n
+
+
+def _parse_date(raw: str) -> date:
+    s = unicodedata.normalize("NFKC", raw).strip()
+    m = _DATE_RE.match(s)
+    rest = s[m.end() :] if m else ""
+    if not m or (rest and not rest[0].isspace() and rest[0] != "T"):
+        raise ValueError("日付の書式が不正です")
+    try:
+        return date(int(m.group(1)), int(m.group(2)), int(m.group(3)))
+    except ValueError:
+        raise ValueError("存在しない日付です") from None
+
+
+def _detect_delimiter(text: str) -> str:
+    first = text.split("\n", 1)[0]
+    return "\t" if first.count("\t") > first.count(",") else ","
+
+
+def parse_bank_csv(text: str) -> ImportResult:
+    text = text.lstrip("﻿")
+    if not text.strip():
+        return ImportResult()
+    reader = csv.reader(
+        io.StringIO(text, newline=None), delimiter=_detect_delimiter(text)
+    )
+    header: list[str] | None = None
+    cols: dict[str, int] = {}
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    prev_line = 0
+    for row in reader:
+        start = prev_line + 1
+        prev_line = reader.line_num
+        if header is None:
+            header = row
+            cols = _find_columns(row)
+            missing = []
+            if "date" not in cols:
+                missing.append("日付")
+            if "amount" not in cols and "out" not in cols:
+                missing.append("金額(または出金)")
+            if missing:
+                raise ValueError(f"必須列がありません: {', '.join(missing)}")
+            continue
+        if not any(c.strip() for c in row):
+            continue
+        if len(row) > len(header):
+            errors.append(
+                RowError(start, "(行全体)", ",".join(row), "列数が多すぎます")
+            )
+            continue
+        e = _parse_record(row, cols, header, start, errors)
+        if e is not None:
+            expenses.append(e)
+    return ImportResult(expenses, errors)
+
+
+def _parse_record(
+    row: list[str],
+    cols: dict[str, int],
+    header: list[str],
+    line: int,
+    errors: list[RowError],
+) -> Expense | None:
+    n_err = len(errors)
+
+    def cell(key: str) -> str | None:
+        i = cols.get(key)
+        if i is None:
+            return None
+        if i >= len(row):
+            errors.append(RowError(line, header[i], "", "列が不足しています"))
+            return None
+        return row[i]
+
+    day: date | None = None
+    raw_date = cell("date")
+    if raw_date is not None:
+        try:
+            day = _parse_date(raw_date)
+        except ValueError as ex:
+            errors.append(RowError(line, header[cols["date"]], raw_date, str(ex)))
+
+    amount: int | None = None
+    if "amount" in cols:
+        raw = cell("amount")
+        if raw is not None:
+            try:
+                amount = _parse_amount(raw)
+            except ValueError as ex:
+                errors.append(RowError(line, header[cols["amount"]], raw, str(ex)))
+    else:
+        amount = _parse_split_amount(row, cols, header, line, errors)
+
+    if len(errors) > n_err or day is None or amount is None:
+        return None
+    memo = (cell("memo") or "") if "memo" in cols else ""
+    cat = ((cell("category") or "").strip() if "category" in cols else "") or "未分類"
+    return Expense(day=day, category=cat, amount=amount, memo=memo.strip())
+
+
+def _parse_split_amount(
+    row: list[str],
+    cols: dict[str, int],
+    header: list[str],
+    line: int,
+    errors: list[RowError],
+) -> int | None:
+    def get(key: str) -> str:
+        i = cols.get(key)
+        return row[i].strip() if i is not None and i < len(row) else ""
+
+    out_raw, in_raw = get("out"), get("in")
+    if out_raw and in_raw:
+        errors.append(
+            RowError(
+                line, "(出金/入金)", f"{out_raw}/{in_raw}", "出金と入金が両方あります"
+            )
+        )
+        return None
+    if not out_raw and not in_raw:
+        errors.append(RowError(line, header[cols["out"]], "", "金額が空です"))
+        return None
+    key, raw = ("out", out_raw) if out_raw else ("in", in_raw)
+    try:
+        n = _parse_amount(raw)
+    except ValueError as ex:
+        errors.append(RowError(line, header[cols[key]], raw, str(ex)))
+        return None
+    return n if key == "out" else -n
