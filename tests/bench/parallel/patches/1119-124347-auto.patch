@@ -0,0 +1,73 @@
+"""Month-over-month comparison per category."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH = re.compile(r"(\d{4})-(\d{2})")
+
+
+@dataclass(frozen=True)
+class CategoryDiff:
+    category: str
+    prev: int
+    current: int
+    delta: int
+    pct: float | None
+    trend: str  # "up" | "down" | "same"
+
+
+def _parse_month(s: str) -> tuple[int, int]:
+    m = _MONTH.fullmatch(s)
+    if not m or not 1 <= int(m.group(2)) <= 12:
+        raise ValueError(f"月は YYYY-MM で指定してください: {s!r}")
+    return int(m.group(1)), int(m.group(2))
+
+
+def _totals(expenses: list[Expense], ym: tuple[int, int]) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for e in expenses:
+        if e.amount > 0 and (e.day.year, e.day.month) == ym:
+            out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def compare_months(
+    expenses: list[Expense], month: str, prev: str | None = None
+) -> list[CategoryDiff]:
+    y, m = _parse_month(month)
+    if prev is None:
+        py, pm = (y - 1, 12) if m == 1 else (y, m - 1)
+    else:
+        py, pm = _parse_month(prev)
+    cur = _totals(expenses, (y, m))
+    old = _totals(expenses, (py, pm))
+    diffs: list[CategoryDiff] = []
+    for cat in cur.keys() | old.keys():
+        p, c = old.get(cat, 0), cur.get(cat, 0)
+        d = c - p
+        diffs.append(
+            CategoryDiff(
+                category=cat,
+                prev=p,
+                current=c,
+                delta=d,
+                pct=round(d / p * 100, 1) if p else None,
+                trend="up" if d > 0 else "down" if d < 0 else "same",
+            )
+        )
+    diffs.sort(key=lambda x: (-abs(x.delta), x.category))
+    return diffs
+
+
+def format_diff_report(diffs: list[CategoryDiff]) -> str:
+    if not diffs:
+        return "変化なし"
+    lines = []
+    for d in diffs:
+        pct = "(新規)" if d.pct is None else f"({d.pct:+.1f}%)"
+        lines.append(f"{d.category}  {d.prev}→{d.current}  {d.delta:+d}円 {pct}")
+    return "\n".join(lines)
