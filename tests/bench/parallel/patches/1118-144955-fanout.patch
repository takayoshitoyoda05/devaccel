new file mode 100644
index 0000000..5c550b4
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,119 @@
+"""Import bank-statement CSV text into Expense records."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"-?[¥￥]?[0-9][0-9,]*円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    """Parse a yen amount such as ``" ￥1,234,567 "`` or ``"-¥300"`` into an int."""
+    text = s.strip()
+    if not _AMOUNT_RE.fullmatch(text):
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    digits = text.replace("¥", "").replace("￥", "").replace("円", "").replace(",", "")
+    return int(digits)
+
+
+def parse_date(s: str) -> date:
+    """Parse ``YYYY/M/D`` or ``YYYY-M-D`` (separator must not be mixed)."""
+    text = s.strip()
+    m = _DATE_RE.fullmatch(text)
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    try:
+        return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def _cell(row: list[str], index: dict[str, int], field: str) -> str:
+    """Value of ``field`` in ``row``; missing column or short row gives ""."""
+    i = index.get(field)
+    if i is None or i >= len(row):
+        return ""
+    return row[i]
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Read CSV text (header on line 1) into expenses.
+
+    Returns ``(expenses, errors)`` where each error is ``(line_number, field)``
+    and line numbers are physical lines in ``text`` (header is line 1).
+    Rows with any error are excluded from the expenses.
+    """
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    try:
+        header = next(reader)
+    except StopIteration:
+        raise ValueError("ヘッダー行がありません") from None
+
+    index: dict[str, int] = {}
+    for field, column in mapping.items():
+        if column not in header:
+            raise ValueError(f"列 {column!r} がヘッダーにありません")
+        index[field] = header.index(column)
+
+    cmap = category_map or {}
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    while True:
+        line_no = reader.line_num + 1
+        try:
+            row = next(reader)
+        except StopIteration:
+            break
+        if not row:
+            continue  # blank line: skipped, but still counted in line numbers
+
+        row_errors: list[tuple[int, str]] = []
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(_cell(row, index, "date"))
+        except ValueError:
+            row_errors.append((line_no, "date"))
+        try:
+            amount = parse_amount(_cell(row, index, "amount"))
+        except ValueError:
+            row_errors.append((line_no, "amount"))
+        category = _cell(row, index, "category").strip()
+        if not category:
+            row_errors.append((line_no, "category"))
+
+        if row_errors or day is None or amount is None:
+            errors.extend(row_errors)
+            continue
+        expenses.append(
+            Expense(
+                day=day,
+                category=cmap.get(category, category),
+                amount=amount,
+                memo=_cell(row, index, "memo").strip(),
+            )
+        )
+    return expenses, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
