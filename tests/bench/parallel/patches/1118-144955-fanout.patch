index 0000000..f0ea62d
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,85 @@
+"""Month-over-month comparison of category totals."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not isinstance(month, str) or not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+
+    prev_totals: dict[str, int] = {}
+    curr_totals: dict[str, int] = {}
+    for e in rows:
+        m = e.day.strftime("%Y-%m")
+        if m == prev_month:
+            prev_totals[e.category] = prev_totals.get(e.category, 0) + e.amount
+        elif m == curr_month:
+            curr_totals[e.category] = curr_totals.get(e.category, 0) + e.amount
+
+    diffs: list[DiffRow] = []
+    for cat in set(prev_totals) | set(curr_totals):
+        prev = prev_totals.get(cat, 0)
+        curr = curr_totals.get(cat, 0)
+        delta = curr - prev
+        pct = None if prev == 0 else round(delta / prev * 100, 1)
+        if cat not in prev_totals:
+            status = "new"
+        elif cat not in curr_totals:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        diffs.append(DiffRow(cat, prev, curr, delta, pct, status))
+
+    diffs.sort(key=lambda d: (-abs(d.delta), d.category))
+    return diffs
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [d for d in diffs if d.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for d in diffs:
+        pct = "-" if d.pct is None else f"{d.pct + 0.0:+.1f}%"
+        lines.append(f"{d.category}\t{d.prev}\t{d.curr}\t{d.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({e.day.strftime("%Y-%m") for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には 2 か月以上の明細が必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..891563f
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,170 @@
+"""Search query language for expenses.
+
+Grammar (lowest precedence first)::
+
+    or_expr  := and_expr ("OR" and_expr)*
+    and_expr := not_expr (["AND"] not_expr)*
+    not_expr := "NOT" not_expr | primary
+    primary  := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+
+from kakeibo.core import Expense
+
+Token = tuple[str, str]
+Predicate = Callable[[Expense], bool]
+
+
+class QueryError(ValueError):
+    """Raised when a query cannot be tokenized or parsed."""
+
+
+_OPERATORS = {"AND", "OR", "NOT"}
+
+
+def _is_word_char(c: str) -> bool:
+    return not (c.isspace() or c in '()"')
+
+
+def tokenize(q: str) -> list[Token]:
+    tokens: list[Token] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end < 0:
+                raise QueryError("閉じていない引用符があります")
+            body = q[i + 1 : end]
+            if not body:
+                raise QueryError("空の引用符は使えません")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            start = i
+            while i < n and _is_word_char(q[i]):
+                i += 1
+            word = q[start:i]
+            if word in _OPERATORS:
+                tokens.append((word, word))
+            elif word.startswith("cat:"):
+                value = word[len("cat:") :]
+                if not value:
+                    raise QueryError("cat: の後ろに値がありません")
+                tokens.append(("CAT", value))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self.tokens = tokens
+        self.pos = 0
+
+    def _peek_kind(self) -> str | None:
+        return self.tokens[self.pos][0] if self.pos < len(self.tokens) else None
+
+    def _next(self) -> Token:
+        if self.pos >= len(self.tokens):
+            raise QueryError("クエリが途中で終わっています")
+        tok = self.tokens[self.pos]
+        self.pos += 1
+        return tok
+
+    def parse(self) -> Predicate:
+        if not self.tokens:
+            raise QueryError("クエリが空です")
+        pred = self._or()
+        if self.pos != len(self.tokens):
+            raise QueryError(f"予期しない記号があります: {self.tokens[self.pos][1]!r}")
+        return pred
+
+    def _or(self) -> Predicate:
+        left = self._and()
+        while self._peek_kind() == "OR":
+            self._next()
+            right = self._and()
+            left = _either(left, right)
+        return left
+
+    def _and(self) -> Predicate:
+        left = self._not()
+        while True:
+            kind = self._peek_kind()
+            if kind == "AND":
+                self._next()
+                right = self._not()  # 後ろに項が無ければ ここで QueryError
+            elif kind in ("NOT", "TERM", "CAT", "LPAREN"):
+                right = self._not()
+            else:
+                break
+            left = _both(left, right)
+        return left
+
+    def _not(self) -> Predicate:
+        if self._peek_kind() == "NOT":
+            self._next()
+            inner = self._not()
+            return lambda e: not inner(e)
+        return self._primary()
+
+    def _primary(self) -> Predicate:
+        kind = self._peek_kind()
+        if kind == "TERM":
+            return _term(self._next()[1])
+        if kind == "CAT":
+            return _cat(self._next()[1])
+        if kind == "LPAREN":
+            self._next()
+            inner = self._or()
+            if self._peek_kind() != "RPAREN":
+                raise QueryError("対応する ')' がありません")
+            self._next()
+            return inner
+        if kind is None:
+            raise QueryError("項が必要です")
+        raise QueryError(f"項が必要な位置に {self.tokens[self.pos][1]!r} があります")
+
+
+def _either(a: Predicate, b: Predicate) -> Predicate:
+    return lambda e: a(e) or b(e)
+
+
+def _both(a: Predicate, b: Predicate) -> Predicate:
+    return lambda e: a(e) and b(e)
+
+
+def _term(value: str) -> Predicate:
+    needle = value.casefold()
+    return lambda e: needle in e.memo.casefold() or needle in e.category.casefold()
+
+
+def _cat(value: str) -> Predicate:
+    wanted = value.casefold()
+    return lambda e: e.category.casefold() == wanted
+
+
+def _compile(q: str) -> Predicate:
+    return _Parser(tokenize(q)).parse()
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _compile(q)(e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    pred = _compile(q)
+    return [e for e in rows if pred(e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..417a1d5
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,69 @@
+"""Detect recurring expenses (same category and amount on a roughly monthly cadence)."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day in the next month, clamped to that month's last day."""
+    year, month = (d.year, d.month + 1) if d.month < 12 else (d.year + 1, 1)
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def _runs(days: list[date], tolerance: int) -> list[list[date]]:
+    """Split sorted, unique dates into maximal runs whose neighbours are monthly-connected."""
+    runs: list[list[date]] = []
+    for d in days:
+        if runs and abs((d - add_month(runs[-1][-1])).days) <= tolerance:
+            runs[-1].append(d)
+        else:
+            runs.append([d])
+    return runs
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    """Find (category, amount) series that recur monthly, at least ``min_count`` times.
+
+    Consecutive dates ``d_i, d_{i+1}`` are linked when ``d_{i+1}`` lies within
+    ``tolerance`` days of ``add_month(d_i)``. Memo is ignored.
+    """
+    if min_count < 2:
+        raise ValueError(f"min_count は 2 以上である必要があります: {min_count}")
+    if tolerance < 0:
+        raise ValueError(f"tolerance は 0 以上である必要があります: {tolerance}")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    found: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        for run in _runs(sorted(day_set), tolerance):
+            if len(run) >= min_count:
+                found.append(
+                    Recurring(
+                        category=category,
+                        amount=amount,
+                        days=tuple(run),
+                        next_expected=add_month(run[-1]),
+                    )
+                )
+
+    found.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return found
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..69fb19c
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,154 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥5", 5),
+        ("-5", -5),
+        ("1,000", 1000),
+        ("-￥2,500円", -2500),
+    ],
+)
+def test_parse_amount_accepts(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    ["", "円", "12.5", "1 200", "--5", "¥-5", "１２３", ",100", "abc", "¥", "5円円"],
+)
+def test_parse_amount_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/12/31 ", date(2026, 12, 31)),
+        ("2026-1-5", date(2026, 1, 5)),
+    ],
+)
+def test_parse_date_accepts(text: str, expected: date) -> None:
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026/1-5",
+        "26/1/5",
+        "2026/02/30",
+        "2026.1.5",
+        "2026/13/1",
+        "２０２６/1/5",
+        "",
+        "2026/1/5/1",
+    ],
+)
+def test_parse_date_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+def test_default_mapping_values() -> None:
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_import_rows_basic_and_quoted_comma() -> None:
+    text = (
+        "利用日,分類,利用金額,利用店名,備考\n"
+        '2026/1/5,食費,"1,200","スーパー, 本店" ,x\n'
+        "2026-01-06, 交通費 ,300,\n"
+    )
+    expenses, errors = import_rows(text)
+    assert errors == []
+    assert expenses == [
+        Expense(date(2026, 1, 5), "食費", 1200, "スーパー, 本店"),
+        Expense(date(2026, 1, 6), "交通費", 300, ""),
+    ]
+
+
+def test_import_rows_errors_and_line_numbers() -> None:
+    text = (
+        "利用日,分類,利用金額,利用店名\n"
+        "2026/1/5,食費,100,ok\n"
+        "\n"
+        "2026/02/30,,abc,ng\n"
+        "2026/1/7,  ,￥50,\n"
+        "2026/1/8,\n"
+    )
+    expenses, errors = import_rows(text)
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "ok")]
+    assert errors == [
+        (4, "date"),
+        (4, "amount"),
+        (4, "category"),
+        (5, "category"),
+        (6, "amount"),
+        (6, "category"),
+    ]
+
+
+def test_import_rows_multiline_quoted_field_counts_physical_lines() -> None:
+    text = '利用日,分類,利用金額,利用店名\n2026/1/5,食費,100,"a\nb"\n2026/1/x,食費,1,\n'
+    expenses, errors = import_rows(text)
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "a\nb")]
+    assert errors == [(4, "date")]
+
+
+def test_import_rows_category_map_and_custom_mapping() -> None:
+    text = "day,cat,amt,shop,extra\n2026/3/1, Food ,10,shop,zzz\n"
+    mapping = {"date": "day", "category": "cat", "amount": "amt", "memo": "shop"}
+    expenses, errors = import_rows(text, mapping=mapping, category_map={"Food": "食費"})
+    assert errors == []
+    assert expenses == [Expense(date(2026, 3, 1), "食費", 10, "shop")]
+
+
+def test_import_rows_memo_optional_in_mapping() -> None:
+    text = "d,c,a\n2026/3/1,食費,10\n"
+    mapping = {"date": "d", "category": "c", "amount": "a"}
+    expenses, errors = import_rows(text, mapping=mapping)
+    assert errors == []
+    assert expenses == [Expense(date(2026, 3, 1), "食費", 10, "")]
+
+
+def test_import_rows_missing_mapping_key_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows("d,c,a\n", mapping={"date": "d", "category": "c"})
+
+
+def test_import_rows_missing_header_column_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows("利用日,分類\n2026/1/5,食費\n")
+
+
+def test_import_rows_missing_cells_are_empty() -> None:
+    text = "利用日,分類,利用金額,利用店名\n2026/1/5,食費\n"
+    expenses, errors = import_rows(text)
+    assert expenses == []
+    assert errors == [(2, "amount")]
+
+
+def test_import_rows_empty_text_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows("")
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..6c4e5b1
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,151 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def E(day: str, cat: str, amount: int) -> Expense:
+    return Expense(date.fromisoformat(day), cat, amount, "")
+
+
+ROWS = [
+    E("2026-10-05", "food", 1000),
+    E("2026-10-20", "food", 500),
+    E("2026-10-10", "rent", 5000),
+    E("2026-10-11", "fun", 2000),
+    E("2026-11-02", "food", 1800),
+    E("2026-11-03", "rent", 5000),
+    E("2026-11-04", "cafe", 300),
+    E("2026-11-05", "fun", 0),
+]
+
+
+def _by_cat(diffs):
+    return {d.category: d for d in diffs}
+
+
+def test_month_diff_statuses_and_values():
+    d = _by_cat(month_diff(ROWS, "2026-10", "2026-11"))
+    assert d["food"] == DiffRow("food", 1500, 1800, 300, 20.0, "up")
+    assert d["rent"] == DiffRow("rent", 5000, 5000, 0, 0.0, "same")
+    assert d["cafe"] == DiffRow("cafe", 0, 300, 300, None, "new")
+    # fun has a 0-yen row in 2026-11, so it is "down" (presence-based), not "gone"
+    assert d["fun"] == DiffRow("fun", 2000, 0, -2000, -100.0, "down")
+
+
+def test_status_uses_row_presence_not_sum():
+    rows = [E("2026-10-01", "x", 0), E("2026-11-01", "x", 0)]
+    (row,) = month_diff(rows, "2026-10", "2026-11")
+    assert row.status == "same"
+    assert row.pct is None
+
+
+def test_down_status():
+    rows = [E("2026-10-01", "x", 1000), E("2026-11-01", "x", 400)]
+    (row,) = month_diff(rows, "2026-10", "2026-11")
+    assert row == DiffRow("x", 1000, 400, -600, -60.0, "down")
+
+
+def test_sorted_by_abs_delta_then_category():
+    rows = [
+        E("2026-10-01", "b", 100),
+        E("2026-11-01", "b", 200),  # delta +100
+        E("2026-10-01", "a", 300),
+        E("2026-11-01", "a", 200),  # delta -100
+        E("2026-11-01", "c", 500),  # delta +500
+    ]
+    cats = [d.category for d in month_diff(rows, "2026-10", "2026-11")]
+    assert cats == ["c", "a", "b"]
+
+
+def test_month_diff_with_no_rows_in_either_month():
+    assert month_diff(ROWS, "2025-01", "2025-02") == []
+
+
+@pytest.mark.parametrize(
+    "bad", ["2026-1", "2026-13", "2026-00", "202611", "2026/11", ""]
+)
+def test_month_diff_rejects_bad_month(bad):
+    with pytest.raises(ValueError):
+        month_diff(ROWS, bad, "2026-11")
+    with pytest.raises(ValueError):
+        month_diff(ROWS, "2026-10", bad)
+
+
+def test_top_movers_skips_same_and_keeps_order():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    cats = [d.category for d in top_movers(diffs, 2)]
+    # |delta|: fun 2000, cafe 300, food 300 (tie -> category asc)
+    assert cats == ["fun", "cafe"]
+    assert [d.category for d in top_movers(diffs)] == ["fun", "cafe", "food"]
+    assert all(d.status != "same" for d in top_movers(diffs, 100))
+
+
+def test_top_movers_rejects_negative_n():
+    with pytest.raises(ValueError):
+        top_movers([], -1)
+
+
+def test_top_movers_zero_n():
+    assert top_movers(month_diff(ROWS, "2026-10", "2026-11"), 0) == []
+
+
+def test_render_diff_format():
+    diffs = [
+        DiffRow("food", 1500, 1800, 300, 20.0, "up"),
+        DiffRow("fun", 2000, 0, -2000, -100.0, "gone"),
+        DiffRow("cafe", 0, 300, 300, None, "new"),
+        DiffRow("rent", 5000, 5000, 0, 0.0, "same"),
+    ]
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "food\t1500\t1800\t+300\t+20.0%\n"
+        "fun\t2000\t0\t-2000\t-100.0%\n"
+        "cafe\t0\t300\t+300\t-\n"
+        "rent\t5000\t5000\t+0\t+0.0%"
+    )
+
+
+def test_render_diff_header_only_and_no_trailing_newline():
+    out = render_diff([])
+    assert out == "category\tprev\tcurr\tdelta\tpct"
+    assert not out.endswith("\n")
+
+
+def test_render_diff_negative_zero_pct_is_plus_zero():
+    diffs = [DiffRow("x", 1, 1, 0, -0.0, "same")]
+    assert render_diff(diffs).splitlines()[1].endswith("\t+0.0%")
+
+
+def test_available_months_sorted_unique():
+    rows = [E("2026-11-01", "a", 1), E("2026-09-30", "a", 1), E("2026-11-09", "a", 1)]
+    assert available_months(rows) == ["2026-09", "2026-11"]
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months():
+    rows = ROWS + [E("2026-12-01", "food", 2000)]
+    d = _by_cat(latest_diff(rows))
+    assert d["food"] == DiffRow(
+        "food", 1800, 2000, 200, round(200 / 1800 * 100, 1), "up"
+    )
+    assert d["rent"].status == "gone"
+    assert (
+        d["fun"].status == "gone"
+    )  # fun has a row in 2026-11 (amount 0), none in 2026-12
+
+
+def test_latest_diff_needs_two_months():
+    with pytest.raises(ValueError):
+        latest_diff([E("2026-11-01", "a", 1), E("2026-11-02", "a", 1)])
+    with pytest.raises(ValueError):
+        latest_diff([])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..9acc8b6
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,149 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+ROWS = [
+    Expense(date(2026, 11, 1), "food", 1200, "ランチ 外食"),
+    Expense(date(2026, 11, 2), "rent", 80000, ""),
+    Expense(date(2026, 11, 3), "Food", 800, "Coffee"),
+    Expense(date(2026, 11, 4), "transport", 300, "train (JR)"),
+]
+
+
+def _memos(q):
+    return [e.memo or e.category for e in filter_rows(q, ROWS)]
+
+
+# --- tokenize ---
+
+
+def test_tokenize_basic():
+    assert tokenize("  food  (a)  ") == [
+        ("TERM", "food"),
+        ("LPAREN", "("),
+        ("TERM", "a"),
+        ("RPAREN", ")"),
+    ]
+
+
+def test_tokenize_operators_are_uppercase_only():
+    assert tokenize("AND OR NOT and or not") == [
+        ("AND", "AND"),
+        ("OR", "OR"),
+        ("NOT", "NOT"),
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_quoted_term_keeps_spaces_and_parens():
+    assert tokenize('"a b (c)" x') == [("TERM", "a b (c)"), ("TERM", "x")]
+
+
+def test_tokenize_cat():
+    assert tokenize("cat:food") == [("CAT", "food")]
+
+
+@pytest.mark.parametrize("q", ['"abc', '""', "cat:", "cat: x"])
+def test_tokenize_rejects_bad(q):
+    with pytest.raises(QueryError):
+        tokenize(q)
+
+
+# --- evaluation ---
+
+
+def test_term_matches_memo_or_category_case_insensitively():
+    assert _memos("coffee") == ["Coffee"]
+    assert _memos("FOOD") == ["ランチ 外食", "Coffee"]  # category "food"/"Food"
+    assert _memos("jr") == ["train (JR)"]
+
+
+def test_cat_matches_category_exactly():
+    assert _memos("cat:food") == ["ランチ 外食", "Coffee"]
+    assert _memos("cat:foo") == []
+    assert _memos("cat:RENT") == ["rent"]
+
+
+def test_quoted_term_is_substring():
+    assert _memos('"(JR"') == ["train (JR)"]
+
+
+def test_and_implicit_and_explicit():
+    assert _memos("food coffee") == ["Coffee"]
+    assert _memos("food AND coffee") == ["Coffee"]
+    assert _memos("food AND rent") == []
+
+
+def test_or_and_not():
+    assert _memos("rent OR transport") == ["rent", "train (JR)"]
+    assert _memos("cat:food NOT coffee") == ["ランチ 外食"]
+    assert _memos("NOT cat:food") == ["rent", "train (JR)"]
+
+
+def test_precedence_or_lowest_then_and_then_not():
+    # a OR b AND c == a OR (b AND c)
+    assert _memos("rent OR transport AND JR") == ["rent", "train (JR)"]
+    # NOT binds tighter than AND: NOT rent AND JR -> (NOT rent) AND JR
+    assert _memos("NOT rent AND JR") == ["train (JR)"]
+    assert _memos("NOT NOT rent") == ["rent"]
+
+
+def test_parentheses_override_precedence():
+    assert _memos("(rent OR transport) AND JR") == ["train (JR)"]
+    assert _memos("((food))") == ["ランチ 外食", "Coffee"]
+
+
+def test_matches_single_row():
+    e = ROWS[0]
+    assert matches("ランチ", e)
+    assert not matches("rent", e)
+
+
+def test_filter_keeps_input_order():
+    rows = [ROWS[3], ROWS[0], ROWS[2]]
+    assert [e.amount for e in filter_rows("food OR transport", rows)] == [
+        300,
+        1200,
+        800,
+    ]
+
+
+def test_empty_rows_still_validates_query():
+    assert filter_rows("cat:food", []) == []
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
+
+
+# --- errors ---
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(a",
+        "a)",
+        "a OR",
+        "OR a",
+        "a AND",
+        "NOT",
+        "a AND OR b",
+        "NOT )",
+        "a ( b",
+        '"unterminated',
+        "cat:",
+        "a )(",
+    ],
+)
+def test_invalid_queries_raise(q):
+    with pytest.raises(QueryError):
+        filter_rows(q, ROWS)
+    with pytest.raises(QueryError):
+        matches(q, ROWS[0])
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..5e7e758
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,178 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def ex(day: str, category: str = "通信", amount: int = 1000, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+# --- add_month ---------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("src", "expected"),
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2024, 1, 31), date(2024, 2, 29)),
+        (date(2026, 12, 15), date(2027, 1, 15)),
+        (date(2026, 3, 30), date(2026, 4, 30)),
+        (date(2026, 11, 1), date(2026, 12, 1)),
+    ],
+)
+def test_add_month_clamps_to_month_end(src: date, expected: date) -> None:
+    assert add_month(src) == expected
+
+
+# --- find_recurring: basics ---------------------------------------------------
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+def test_monthly_series_is_detected() -> None:
+    rows = [ex("2026-01-05"), ex("2026-02-05"), ex("2026-03-05")]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="通信",
+            amount=1000,
+            days=(date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+            next_expected=date(2026, 4, 5),
+        )
+    ]
+
+
+def test_below_min_count_is_ignored() -> None:
+    rows = [ex("2026-01-05"), ex("2026-02-05")]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_count=2)) == 1
+
+
+def test_memo_is_ignored_when_grouping() -> None:
+    rows = [
+        ex("2026-01-05", memo="a"),
+        ex("2026-02-05", memo="b"),
+        ex("2026-03-05", memo=""),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_different_amount_or_category_are_separate_groups() -> None:
+    rows = [
+        ex("2026-01-05", amount=1000),
+        ex("2026-02-05", amount=1000),
+        ex("2026-03-05", amount=1001),
+        ex("2026-04-05", amount=1001),
+        ex("2026-05-05", amount=1001),
+        ex("2026-01-06", category="食費", amount=1000),
+        ex("2026-02-06", category="食費", amount=1000),
+        ex("2026-03-06", category="食費", amount=1000),
+    ]
+    result = find_recurring(rows)
+    assert [(r.category, r.amount, len(r.days)) for r in result] == [
+        ("通信", 1001, 3),
+        ("食費", 1000, 3),
+    ]
+    # 1000 円の通信は 2 件しかないので除外される
+    assert all(not (r.category == "通信" and r.amount == 1000) for r in result)
+
+
+def test_duplicate_dates_are_collapsed() -> None:
+    rows = [
+        ex("2026-01-05"),
+        ex("2026-01-05", memo="dup"),
+        ex("2026-02-05"),
+        ex("2026-03-05"),
+    ]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+# --- tolerance and month-end ---------------------------------------------------
+
+
+def test_tolerance_links_near_dates() -> None:
+    rows = [ex("2026-01-05"), ex("2026-02-08"), ex("2026-03-02")]
+    # 2026-02-05 expected; 02-08 is +3 (ok), 03-08 expected vs 03-02 is -6 -> breaks
+    assert find_recurring(rows) == []
+    rows2 = [ex("2026-01-05"), ex("2026-02-08"), ex("2026-03-10")]
+    assert len(find_recurring(rows2)) == 1
+
+
+def test_tolerance_zero_requires_exact_day() -> None:
+    rows = [ex("2026-01-05"), ex("2026-02-06"), ex("2026-03-05")]
+    assert find_recurring(rows, tolerance=0) == []
+    assert len(find_recurring(rows, tolerance=1)) == 1
+
+
+def test_month_end_series_links_via_clamping() -> None:
+    rows = [ex("2026-01-31"), ex("2026-02-28"), ex("2026-03-31")]
+    # 02-28 -> add_month = 03-28, so 03-31 is 3 days off: linked at default tolerance only
+    assert find_recurring(rows, tolerance=2) == []
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 30)
+
+
+def test_gap_splits_runs_and_short_run_is_dropped() -> None:
+    # Jan-Mar connected, then a gap, then Jun-Jul (too short).
+    rows = [
+        ex("2026-01-05"),
+        ex("2026-02-05"),
+        ex("2026-03-05"),
+        ex("2026-06-05"),
+        ex("2026-07-05"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_gap_splits_into_two_qualifying_runs() -> None:
+    rows = [ex(f"2026-{m:02d}-05") for m in (1, 2, 3, 5, 6, 7)]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 5), date(2026, 5, 5)]
+    assert [r.next_expected for r in result] == [date(2026, 4, 5), date(2026, 8, 5)]
+
+
+# --- ordering -----------------------------------------------------------------
+
+
+def test_results_sorted_by_category_amount_then_first_day() -> None:
+    rows: list[Expense] = []
+    for cat, amt in [("食費", 500), ("通信", 2000), ("通信", 1000)]:
+        for m in (1, 2, 3):
+            rows.append(ex(f"2026-{m:02d}-10", category=cat, amount=amt))
+    # second, later series for same (category, amount)
+    for m in (7, 8, 9):
+        rows.append(ex(f"2026-{m:02d}-20", category="通信", amount=1000))
+    result = find_recurring(rows, tolerance=10)
+    assert [(r.category, r.amount, r.days[0]) for r in result] == [
+        ("通信", 1000, date(2026, 1, 10)),
+        ("通信", 1000, date(2026, 7, 20)),
+        ("通信", 2000, date(2026, 1, 10)),
+        ("食費", 500, date(2026, 1, 10)),
+    ]
+
+
+# --- validation ---------------------------------------------------------------
+
+
+def test_min_count_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+
+
+def test_negative_tolerance_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
