index 0000000..d89331b
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,86 @@
+"""Month-over-month comparison per category."""
+
+from __future__ import annotations
+
+import re
+from collections import defaultdict
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])", re.ASCII)
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(m: str) -> None:
+    if not _MONTH_RE.fullmatch(m):
+        raise ValueError(f"invalid month: {m!r}")
+
+
+def _month(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+    prev: dict[str, int] = defaultdict(int)
+    curr: dict[str, int] = defaultdict(int)
+    for e in rows:
+        m = _month(e)
+        if m == prev_month:
+            prev[e.category] += e.amount
+        if m == curr_month:
+            curr[e.category] += e.amount
+    out: list[DiffRow] = []
+    for cat in set(prev) | set(curr):
+        p, c = prev.get(cat, 0), curr.get(cat, 0)
+        delta = c - p
+        pct = round(delta / p * 100, 1) if p != 0 else None
+        if cat not in prev:
+            status = "new"
+        elif cat not in curr:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, p, c, delta, pct, status))
+    out.sort(key=lambda r: (-abs(r.delta), r.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError("n must be >= 0")
+    return [d for d in diffs if d.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for d in diffs:
+        pct = "-" if d.pct is None else f"{d.pct:+.1f}%"
+        lines.append(f"{d.category}\t{d.prev}\t{d.curr}\t{d.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month(e) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("need at least two months")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..65f8cdf
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,131 @@
+"""Tiny search query language over expenses."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from kakeibo.core import Expense
+
+
+class QueryError(ValueError):
+    pass
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    toks: list[tuple[str, str]] = []
+    i, n = 0, len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            toks.append(("LPAREN", c))
+            i += 1
+        elif c == ")":
+            toks.append(("RPAREN", c))
+            i += 1
+        elif c == '"':
+            j = q.find('"', i + 1)
+            if j == -1 or j == i + 1:
+                raise QueryError("bad quoted term")
+            toks.append(("TERM", q[i + 1 : j]))
+            i = j + 1
+        else:
+            j = i
+            while j < n and not q[j].isspace() and q[j] not in '()"':
+                j += 1
+            w = q[i:j]
+            i = j
+            if w in ("AND", "OR", "NOT"):
+                toks.append((w, w))
+            elif w.startswith("cat:"):
+                if len(w) == 4:
+                    raise QueryError("empty cat:")
+                toks.append(("CAT", w[4:]))
+            else:
+                toks.append(("TERM", w))
+    return toks
+
+
+Node = tuple[Any, ...]
+
+
+class _Parser:
+    def __init__(self, toks: list[tuple[str, str]]) -> None:
+        self.toks = toks
+        self.pos = 0
+
+    def peek(self) -> str | None:
+        return self.toks[self.pos][0] if self.pos < len(self.toks) else None
+
+    def or_expr(self) -> Node:
+        node = self.and_expr()
+        while self.peek() == "OR":
+            self.pos += 1
+            node = ("OR", node, self.and_expr())
+        return node
+
+    def and_expr(self) -> Node:
+        node = self.not_expr()
+        while True:
+            k = self.peek()
+            if k == "AND":
+                self.pos += 1
+            elif k not in ("TERM", "CAT", "LPAREN", "NOT"):
+                return node
+            node = ("AND", node, self.not_expr())
+
+    def not_expr(self) -> Node:
+        if self.peek() == "NOT":
+            self.pos += 1
+            return ("NOT", self.not_expr())
+        return self.primary()
+
+    def primary(self) -> Node:
+        k = self.peek()
+        if k in ("TERM", "CAT"):
+            tok = self.toks[self.pos]
+            self.pos += 1
+            return tok
+        if k == "LPAREN":
+            self.pos += 1
+            node = self.or_expr()
+            if self.peek() != "RPAREN":
+                raise QueryError("missing )")
+            self.pos += 1
+            return node
+        raise QueryError(f"unexpected {k or 'end of query'}")
+
+
+def _parse(q: str) -> Node:
+    toks = tokenize(q)
+    if not toks:
+        raise QueryError("empty query")
+    p = _Parser(toks)
+    node = p.or_expr()
+    if p.pos != len(toks):
+        raise QueryError("unexpected trailing token")
+    return node
+
+
+def _eval(node: Node, e: Expense) -> bool:
+    kind = node[0]
+    if kind == "TERM":
+        v = node[1].casefold()
+        return v in e.memo.casefold() or v in e.category.casefold()
+    if kind == "CAT":
+        return node[1].casefold() == e.category.casefold()
+    if kind == "AND":
+        return _eval(node[1], e) and _eval(node[2], e)
+    if kind == "OR":
+        return _eval(node[1], e) or _eval(node[2], e)
+    return not _eval(node[1], e)
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _eval(_parse(q), e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    node = _parse(q)
+    return [e for e in rows if _eval(node, e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..d364a1d
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,48 @@
+"""Detect recurring (monthly) expenses."""
+
+from __future__ import annotations
+
+import calendar
+from collections import defaultdict
+from dataclasses import dataclass
+from datetime import date
+from itertools import pairwise
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    y, m = (d.year + 1, 1) if d.month == 12 else (d.year, d.month + 1)
+    return date(y, m, min(d.day, calendar.monthrange(y, m)[1]))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2 or tolerance < 0:
+        raise ValueError("min_count must be >= 2 and tolerance >= 0")
+    groups: dict[tuple[str, int], set[date]] = defaultdict(set)
+    for r in rows:
+        groups[(r.category, r.amount)].add(r.day)
+    out: list[Recurring] = []
+    for (cat, amt), dayset in groups.items():
+        days = sorted(dayset)
+        runs: list[list[date]] = [[days[0]]]
+        for prev, cur in pairwise(days):
+            if abs((cur - add_month(prev)).days) <= tolerance:
+                runs[-1].append(cur)
+            else:
+                runs.append([cur])
+        for run in runs:
+            if len(run) >= min_count:
+                out.append(Recurring(cat, amt, tuple(run), add_month(run[-1])))
+    out.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return out
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..5ba5243
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,101 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+
+@pytest.mark.parametrize(
+    "s,n",
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥1,0円", 10),
+    ],
+)
+def test_parse_amount_ok(s, n):
+    assert parse_amount(s) == n
+
+
+@pytest.mark.parametrize(
+    "s", ["", "円", "12.5", "1 200", "--5", "¥-5", "１２３", ",5", "¥", "5円円"]
+)
+def test_parse_amount_bad(s):
+    with pytest.raises(ValueError):
+        parse_amount(s)
+
+
+@pytest.mark.parametrize(
+    "s,d",
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        (" 2026-01-05 ", date(2026, 1, 5)),
+        ("2024/02/29", date(2024, 2, 29)),
+    ],
+)
+def test_parse_date_ok(s, d):
+    assert parse_date(s) == d
+
+
+@pytest.mark.parametrize(
+    "s",
+    [
+        "2026/1-5",
+        "26/1/5",
+        "2026/02/30",
+        "2026年1月5日",
+        "２０２６/1/5",
+        "2026/001/5",
+        "",
+    ],
+)
+def test_parse_date_bad(s):
+    with pytest.raises(ValueError):
+        parse_date(s)
+
+
+HEADER = "利用日,分類,利用金額,利用店名,extra\n"
+
+
+def test_import_basic():
+    text = (
+        HEADER
+        + '2026/1/5,食費,"¥1,200", スーパー ,x\n'
+        + "\n"
+        + "2026/1/6,交通,300円,駅,y\n"
+    )
+    rows, errs = import_rows(text, category_map={"食費": "food"})
+    assert errs == []
+    assert rows == [
+        Expense(date(2026, 1, 5), "food", 1200, "スーパー"),
+        Expense(date(2026, 1, 6), "交通", 300, "駅"),
+    ]
+
+
+def test_import_errors_and_line_numbers():
+    text = HEADER + "bad,,x,m,\n\n2026/1/5,食費,100\n2026/13/1,a,1,\n"
+    rows, errs = import_rows(text)
+    assert errs == [(2, "date"), (2, "amount"), (2, "category"), (5, "date")]
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+def test_import_quoted_multiline_line_numbers():
+    text = HEADER + '2026/1/5,a,1,"x\ny",\n2026/1/6,,1,m,\n'
+    _, errs = import_rows(text)
+    assert errs == [(4, "category")]
+
+
+def test_import_mapping():
+    text = "d,c,a\n2026-1-1,x,5\n"
+    m = {"date": "d", "category": "c", "amount": "a"}
+    assert import_rows(text, m)[0] == [Expense(date(2026, 1, 1), "x", 5, "")]
+    with pytest.raises(ValueError):
+        import_rows(text, {"date": "d", "category": "c"})
+    with pytest.raises(ValueError):
+        import_rows(text, {**m, "memo": "nope"})
+    with pytest.raises(ValueError):
+        import_rows(text)  # default mapping absent from header
+    assert DEFAULT_MAPPING["amount"] == "利用金額"
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..21f1071
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,88 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+ROWS = [
+    Expense(date(2026, 1, 3), "food", 1000),
+    Expense(date(2026, 1, 9), "food", 500),
+    Expense(date(2026, 2, 1), "food", 1800),
+    Expense(date(2026, 1, 5), "rent", 5000),
+    Expense(date(2026, 2, 5), "rent", 5000),
+    Expense(date(2026, 1, 7), "gym", 2000),
+    Expense(date(2026, 2, 7), "fun", 700),
+    Expense(date(2026, 1, 8), "zero", 0),
+    Expense(date(2026, 2, 8), "zero", 100),
+    Expense(date(2026, 3, 1), "other", 1),
+]
+
+
+def test_month_diff():
+    d = month_diff(ROWS, "2026-01", "2026-02")
+    assert d == [
+        DiffRow("gym", 2000, 0, -2000, -100.0, "gone"),
+        DiffRow("fun", 0, 700, 700, None, "new"),
+        DiffRow("food", 1500, 1800, 300, 20.0, "up"),
+        DiffRow("zero", 0, 100, 100, None, "up"),
+        DiffRow("rent", 5000, 5000, 0, 0.0, "same"),
+    ]
+
+
+def test_status_by_presence_not_total():
+    rows = [
+        Expense(date(2026, 1, 1), "a", 100),
+        Expense(date(2026, 1, 2), "a", -100),
+        Expense(date(2026, 2, 1), "a", 50),
+    ]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    assert (r.prev, r.status, r.pct) == (0, "up", None)
+
+
+def test_invalid_months():
+    for bad in ["2026-1", "2026-13", "2026/01", "202601", "2026-00", "２０２６-01"]:
+        with pytest.raises(ValueError):
+            month_diff([], bad, "2026-01")
+        with pytest.raises(ValueError):
+            month_diff([], "2026-01", bad)
+    assert month_diff([], "2026-01", "2026-02") == []
+
+
+def test_top_movers():
+    d = month_diff(ROWS, "2026-01", "2026-02")
+    assert top_movers(d, 2) == d[:2]
+    assert top_movers(d) == d[:3]
+    assert top_movers(d, 10) == d[:4]
+    assert top_movers(d, 0) == []
+    with pytest.raises(ValueError):
+        top_movers(d, -1)
+
+
+def test_render():
+    d = month_diff(ROWS, "2026-01", "2026-02")
+    assert render_diff(d) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "gym\t2000\t0\t-2000\t-100.0%\n"
+        "fun\t0\t700\t+700\t-\n"
+        "food\t1500\t1800\t+300\t+20.0%\n"
+        "zero\t0\t100\t+100\t-\n"
+        "rent\t5000\t5000\t+0\t+0.0%"
+    )
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_months_and_latest():
+    assert available_months(ROWS) == ["2026-01", "2026-02", "2026-03"]
+    assert available_months([]) == []
+    d = latest_diff(ROWS)
+    assert d == month_diff(ROWS, "2026-02", "2026-03")
+    with pytest.raises(ValueError):
+        latest_diff(ROWS[:1])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..51050f9
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,84 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+E1 = Expense(date(2026, 1, 1), "Food", 500, "Lunch at Cafe (west)")
+E2 = Expense(date(2026, 1, 2), "Transport", 200, "train")
+E3 = Expense(date(2026, 1, 3), "Food", 900, "dinner")
+
+
+def test_tokenize():
+    assert tokenize('a AND (b) "x y" cat:Food and NOT OR') == [
+        ("TERM", "a"),
+        ("AND", "AND"),
+        ("LPAREN", "("),
+        ("TERM", "b"),
+        ("RPAREN", ")"),
+        ("TERM", "x y"),
+        ("CAT", "Food"),
+        ("TERM", "and"),
+        ("NOT", "NOT"),
+        ("OR", "OR"),
+    ]
+    assert tokenize('"a(b)"') == [("TERM", "a(b)")]
+    assert tokenize("a(b") == [("TERM", "a"), ("LPAREN", "("), ("TERM", "b")]
+
+
+@pytest.mark.parametrize("q", ['"abc', '""', "cat:"])
+def test_tokenize_errors(q):
+    with pytest.raises(QueryError):
+        tokenize(q)
+
+
+def test_matching():
+    assert matches("lunch", E1)
+    assert matches("FOOD", E1)
+    assert matches('"cafe (west)"', E1)
+    assert matches("cat:food", E1)
+    assert not matches("cat:foo", E1)
+    assert matches("lunch cafe", E1)  # implicit AND
+    assert not matches("lunch train", E1)
+    assert matches("lunch OR train", E2)
+    assert matches("NOT lunch", E2)
+    assert matches("NOT NOT lunch", E1)
+
+
+def test_precedence():
+    # OR < AND: a OR b AND c == a OR (b AND c)
+    assert matches("train OR lunch cafe", E2)
+    assert not matches("(train OR lunch) cafe", E2)
+    assert matches("NOT lunch AND cat:food", E3)
+    assert not matches("NOT (lunch AND cat:food)", E1)
+    assert matches("lunch AND cafe AND cat:food", E1)
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(a",
+        "a)",
+        "a AND",
+        "OR a",
+        "a OR",
+        "NOT",
+        "a AND OR b",
+        "(",
+        ")",
+    ],
+)
+def test_syntax_errors(q):
+    with pytest.raises(QueryError):
+        matches(q, E1)
+
+
+def test_filter_rows():
+    assert filter_rows("cat:food", [E1, E2, E3]) == [E1, E3]
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
+    assert issubclass(QueryError, ValueError)
