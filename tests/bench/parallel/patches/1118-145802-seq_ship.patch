+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+@pytest.mark.parametrize(
+    "src,dst",
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2024, 1, 31), date(2024, 2, 29)),
+        (date(2026, 12, 15), date(2027, 1, 15)),
+        (date(2026, 3, 31), date(2026, 4, 30)),
+    ],
+)
+def test_add_month(src, dst):
+    assert add_month(src) == dst
+
+
+def e(d, cat="rent", amt=1000, memo=""):
+    return Expense(d, cat, amt, memo)
+
+
+def test_basic_run():
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 6)), e(date(2026, 3, 4), memo="x")]
+    assert find_recurring(rows) == [
+        Recurring(
+            "rent",
+            1000,
+            (date(2026, 1, 5), date(2026, 2, 6), date(2026, 3, 4)),
+            date(2026, 4, 4),
+        )
+    ]
+
+
+def test_too_short_and_empty():
+    assert find_recurring([]) == []
+    assert find_recurring([e(date(2026, 1, 5)), e(date(2026, 2, 5))]) == []
+    assert find_recurring([e(date(2026, 1, 5)), e(date(2026, 2, 5))], min_count=2)
+
+
+def test_tolerance_boundary():
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 8)), e(date(2026, 3, 8))]
+    assert len(find_recurring(rows)) == 1
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 9)), e(date(2026, 3, 9))]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, tolerance=4)) == 1
+
+
+def test_duplicates_and_groups_and_split():
+    rows = [e(date(2026, 1, 5)), e(date(2026, 1, 5)), e(date(2026, 2, 5))]
+    assert find_recurring(rows) == []
+    rows = [e(date(2026, m, 1)) for m in (1, 2, 3, 5, 6, 7)]
+    res = find_recurring(rows)
+    assert [r.days[0] for r in res] == [date(2026, 1, 1), date(2026, 5, 1)]
+    rows = [e(date(2026, m, 1), cat="b", amt=5) for m in (1, 2, 3)]
+    rows += [e(date(2026, m, 1), cat="a", amt=9) for m in (1, 2, 3)]
+    rows += [e(date(2026, m, 1), cat="a", amt=2) for m in (1, 2, 3)]
+    assert [(r.category, r.amount) for r in find_recurring(rows)] == [
+        ("a", 2),
+        ("a", 9),
+        ("b", 5),
+    ]
+
+
+def test_invalid_args():
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
