new file mode 100644
index 0000000..c01c2c6
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,95 @@
+"""Import CSV exports from other banks / card issuers."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"(-?)[¥￥]?([0-9][0-9,]*)円?", re.ASCII)
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})", re.ASCII)
+
+
+def parse_amount(s: str) -> int:
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if not m:
+        raise ValueError(f"invalid amount: {s!r}")
+    n = int(m.group(2).replace(",", ""))
+    return -n if m.group(1) else n
+
+
+def parse_date(s: str) -> date:
+    m = _DATE_RE.fullmatch(s.strip())
+    if not m:
+        raise ValueError(f"invalid date: {s!r}")
+    return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping lacks {key}")
+    reader = csv.reader(io.StringIO(text, newline=""))
+    try:
+        header = next(reader)
+    except StopIteration:
+        raise ValueError("empty input") from None
+    idx: dict[str, int] = {}
+    for key in ("date", "category", "amount", "memo"):
+        if key not in mapping:
+            continue
+        col = mapping[key]
+        if col not in header:
+            raise ValueError(f"column not in header: {col!r}")
+        idx[key] = header.index(col)
+
+    def get(row: list[str], key: str) -> str:
+        i = idx.get(key)
+        return row[i] if i is not None and i < len(row) else ""
+
+    rows: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    prev_line = reader.line_num
+    for row in reader:
+        lineno = prev_line + 1  # physical line where this record starts
+        prev_line = reader.line_num
+        if not row:
+            continue
+        day: date | None = None
+        amount: int | None = None
+        bad = False
+        try:
+            day = parse_date(get(row, "date"))
+        except ValueError:
+            errors.append((lineno, "date"))
+            bad = True
+        try:
+            amount = parse_amount(get(row, "amount"))
+        except ValueError:
+            errors.append((lineno, "amount"))
+            bad = True
+        cat = get(row, "category").strip()
+        if not cat:
+            errors.append((lineno, "category"))
+            bad = True
+        if bad or day is None or amount is None:
+            continue
+        cat = (category_map or {}).get(cat, cat)
+        rows.append(Expense(day, cat, amount, get(row, "memo").strip()))
+    return rows, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
