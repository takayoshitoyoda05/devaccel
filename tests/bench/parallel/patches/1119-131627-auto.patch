+from datetime import date
+
+import pytest
+
+from kakeibo.bankcsv import RowError, parse_bank_csv
+from kakeibo.core import Expense
+
+# --- 例の表 (E1-*) ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param(
+            '利用日,ご利用店名,利用金額\n2026/1/5,ＡＢＣ,"１，２３４円"',
+            ([Expense(date(2026, 1, 5), "", 1234, "ABC")], []),
+            id="E1-1",
+        ),
+        pytest.param(
+            "日付,摘要,出金額,入金額\n2026-01-05,給与,,300000",
+            ([], []),
+            id="E1-2",
+        ),
+        pytest.param(
+            "日付,金額\n2026-02-30,abc",
+            (
+                [],
+                [
+                    RowError(2, "日付", "2026-02-30", "存在しない日付です"),
+                    RowError(2, "金額", "abc", "数字ではありません"),
+                ],
+            ),
+            id="E1-3",
+        ),
+    ],
+)
+def test_example_table(text, expected):
+    assert parse_bank_csv(text) == expected
+
+
+# --- 端のケース (仕様文面から) ----------------------------------------------
+
+
+def test_empty_input_and_header_only():
+    assert parse_bank_csv("") == ([], [])
+    assert parse_bank_csv("日付,金額\n") == ([], [])
+
+
+def test_bom_and_crlf_and_cr_newlines():
+    base = "日付,金額\n2026-01-01,100\n2026-01-02,200\n"
+    expected = [
+        Expense(date(2026, 1, 1), "", 100, ""),
+        Expense(date(2026, 1, 2), "", 200, ""),
+    ]
+    assert parse_bank_csv("﻿" + base) == (expected, [])
+    assert parse_bank_csv(base.replace("\n", "\r\n")) == (expected, [])
+    assert parse_bank_csv(base.replace("\n", "\r")) == (expected, [])
+
+
+def test_tab_delimiter_is_autodetected():
+    text = "日付\t摘要\t金額\n2026-01-01\t店\t300"
+    assert parse_bank_csv(text) == ([Expense(date(2026, 1, 1), "", 300, "店")], [])
+
+
+def test_quoted_delimiter_and_newline_stay_inside_value():
+    text = '日付,摘要,金額\n2026-01-01,"A,B\nC",300'
+    expenses, errors = parse_bank_csv(text)
+    assert errors == []
+    assert expenses == [Expense(date(2026, 1, 1), "", 300, "A,B\nC")]
+
+
+def test_header_aliases_are_case_and_space_insensitive():
+    text = " Date , AMOUNT ,Category,Memo\n2026-01-01,50,食費,パン"
+    assert parse_bank_csv(text) == (
+        [Expense(date(2026, 1, 1), "食費", 50, "パン")],
+        [],
+    )
+
+
+def test_missing_date_column_raises():
+    with pytest.raises(ValueError, match="必須列がありません: 日付"):
+        parse_bank_csv("金額\n100")
+
+
+def test_missing_amount_and_withdraw_columns_raises():
+    with pytest.raises(ValueError, match="必須列がありません"):
+        parse_bank_csv("日付,摘要\n2026-01-01,x")
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026.1.5",
+        "2026年1月5日",
+        "2026-01-05T10:20:30",
+        "2026-01-05 9:05",
+    ],
+)
+def test_date_forms_and_time_suffix_are_accepted(raw):
+    expenses, errors = parse_bank_csv(f"日付,金額\n{raw},1")
+    assert errors == []
+    assert expenses[0].day == date(2026, 1, 5)
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        ("¥1,000", 1000),
+        ("1000円", 1000),
+        ("JPY 1000", 1000),
+        ("-1000", -1000),
+        ("−1000", -1000),
+        ("△1000", -1000),
+        ("▲1000", -1000),
+        ("(1000)", -1000),
+        ("1000-", -1000),
+        ("１０００", 1000),
+    ],
+)
+def test_amount_forms(raw, expected):
+    expenses, errors = parse_bank_csv(f'日付,金額\n2026-01-01,"{raw}"')
+    assert errors == []
+    assert expenses[0].amount == expected
+
+
+def test_negative_single_amount_is_kept_as_refund():
+    expenses, _ = parse_bank_csv("日付,金額\n2026-01-01,-500")
+    assert expenses[0].amount == -500
+
+
+@pytest.mark.parametrize("raw", ["12.5", "abc", "1-000"])
+def test_invalid_amount_is_row_error(raw):
+    expenses, errors = parse_bank_csv(f"日付,金額\n2026-01-01,{raw}")
+    assert expenses == []
+    assert [e.column for e in errors] == ["金額"]
+
+
+@pytest.mark.parametrize("raw", ["0", "", "-"])
+def test_single_column_zero_or_empty_is_row_error(raw):
+    expenses, errors = parse_bank_csv(f"日付,金額\n2026-01-01,{raw}")
+    assert expenses == []
+    assert errors == [RowError(2, "金額", raw, errors[0].reason)]
+
+
+def test_two_column_withdraw_and_deposit_both_filled_is_row_error():
+    text = "日付,出金額,入金額\n2026-01-01,100,200"
+    expenses, errors = parse_bank_csv(text)
+    assert expenses == []
+    assert [e.column for e in errors] == ["出金額"]
+
+
+def test_two_column_withdraw_is_expense_and_zero_is_absent():
+    text = "日付,出金額,入金額\n2026-01-01,800,0\n2026-01-02,0,500\n2026-01-03,-,-"
+    expenses, errors = parse_bank_csv(text)
+    assert errors == []
+    assert expenses == [Expense(date(2026, 1, 1), "", 800, "")]
+
+
+def test_blank_rows_are_skipped_silently():
+    text = "日付,金額\n\n2026-01-01,100\n,\n"
+    assert parse_bank_csv(text) == ([Expense(date(2026, 1, 1), "", 100, "")], [])
+
+
+def test_column_count_mismatch_reports_row_with_start_line():
+    text = '日付,摘要,金額\n2026-01-01,"A\nB",100\n2026-01-02,x'
+    expenses, errors = parse_bank_csv(text)
+    assert expenses == [Expense(date(2026, 1, 1), "", 100, "A\nB")]
+    assert len(errors) == 1
+    assert errors[0].line == 4
+    assert errors[0].column == ""
+    assert "3" in errors[0].reason and "2" in errors[0].reason
+
+
+def test_bad_date_and_bad_amount_both_reported_without_expense():
+    expenses, errors = parse_bank_csv("日付,金額\n2026-13-01,abc")
+    assert expenses == []
+    assert [(e.column, e.value) for e in errors] == [
+        ("日付", "2026-13-01"),
+        ("金額", "abc"),
+    ]
+
+
+def test_line_numbers_count_physical_lines_for_multiline_records():
+    text = '日付,摘要,金額\n2026-01-01,"A\nB",100\n2026-99-99,x,1'
+    _, errors = parse_bank_csv(text)
+    assert errors[0].line == 4
