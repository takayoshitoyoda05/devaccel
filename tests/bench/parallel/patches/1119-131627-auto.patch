new file mode 100644
index 0000000..e907e0f
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,114 @@
+"""固定費の検出と次回予定日の予測(純粋関数のみ)。"""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from collections import Counter
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_NUMBER_SUFFIX = re.compile(r"\s#?\d+$")
+_MONTH_SUFFIX = re.compile(r"(?:\s*\d{4}年)?\s*\d{1,2}月分?$")
+
+
+@dataclass(frozen=True)
+class Recurring:
+    memo: str  # 正規化済みメモ
+    category: str
+    amount: int  # 最新の金額(円)
+    months: int  # 連なりの月数
+    last_date: date  # 最新の日付
+    next_date: date  # 次回予定日
+
+
+def normalize_memo(memo: str) -> str:
+    """NFKC・小文字化・空白の整理のあと、末尾の連番と月表記を除去する。"""
+    s = unicodedata.normalize("NFKC", memo).lower()
+    s = re.sub(r"\s+", " ", s).strip()
+    while True:
+        prev = s
+        for pat in (_NUMBER_SUFFIX, _MONTH_SUFFIX):
+            m = pat.search(s)
+            if m:
+                s = s[: m.start()].rstrip()
+        if s == prev:
+            return s
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month - 1
+
+
+def _near(amount: int, ref: int) -> bool:
+    """ref の ±10% 以内か(整数演算のまま判定する)。"""
+    return abs(amount - ref) * 10 <= ref
+
+
+def _latest_run(rows: list[Expense]) -> list[Expense] | None:
+    """同じキー内の行から、3 か月以上続く最も新しい連なりを返す。"""
+    best: list[Expense] | None = None
+    run: list[Expense] = []
+    for r in sorted(rows, key=lambda e: e.day):
+        if not run:
+            run = [r]
+            continue
+        if not _near(r.amount, run[-1].amount):
+            continue  # 系列から外れた行は無視
+        last_idx = _month_index(run[-1].day)
+        idx = _month_index(r.day)
+        if idx == last_idx:
+            continue  # 同じ月の 2 件目以降は数えない
+        if idx == last_idx + 1:
+            run.append(r)
+            continue
+        if len(run) >= 3:
+            best = run
+        run = [r]
+    if len(run) >= 3:
+        best = run
+    return best
+
+
+def _next_date(run: list[Expense]) -> date:
+    last = run[-1].day
+    if last.month == 12:
+        y, m = last.year + 1, 1
+    else:
+        y, m = last.year, last.month + 1
+    counts = Counter(e.day.day for e in run)
+    day = max(counts, key=lambda d: (counts[d], d))
+    return date(y, m, min(day, calendar.monthrange(y, m)[1]))
+
+
+def find_recurring(rows: list[Expense]) -> list[Recurring]:
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        if e.amount < 0:
+            continue  # 返金・入金は系列に入れない
+        memo = normalize_memo(e.memo)
+        if not memo:
+            continue
+        groups.setdefault((memo, e.category), []).append(e)
+
+    out: list[Recurring] = []
+    for (memo, category), group in groups.items():
+        run = _latest_run(group)
+        if run is None:
+            continue
+        last = run[-1]
+        out.append(
+            Recurring(
+                memo=memo,
+                category=category,
+                amount=last.amount,
+                months=len(run),
+                last_date=last.day,
+                next_date=_next_date(run),
+            )
+        )
+    out.sort(key=lambda r: (r.next_date, -r.amount, r.memo))
+    return out
