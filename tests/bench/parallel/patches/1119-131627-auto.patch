@@ -0,0 +1,185 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, normalize_memo
+
+
+def _e(day: date, memo: str, amount: int, category: str = "住居") -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+@pytest.mark.parametrize(
+    ("rows", "expected"),
+    [
+        pytest.param(
+            [
+                _e(date(2026, 1, 5), "家賃", 80000),
+                _e(date(2026, 2, 5), "家賃", 80000),
+                _e(date(2026, 3, 5), "家賃", 80000),
+            ],
+            [
+                Recurring(
+                    memo="家賃",
+                    category="住居",
+                    amount=80000,
+                    months=3,
+                    last_date=date(2026, 3, 5),
+                    next_date=date(2026, 4, 5),
+                )
+            ],
+            id="E2-1",
+        ),
+        pytest.param(
+            [
+                _e(date(2026, 1, 31), "Netflix", 1490, "サブスク"),
+                _e(date(2026, 2, 28), "Netflix", 1490, "サブスク"),
+                _e(date(2026, 3, 31), "Netflix", 1490, "サブスク"),
+            ],
+            [
+                Recurring(
+                    memo="netflix",
+                    category="サブスク",
+                    amount=1490,
+                    months=3,
+                    last_date=date(2026, 3, 31),
+                    next_date=date(2026, 4, 30),
+                )
+            ],
+            id="E2-2",
+        ),
+        pytest.param(
+            [
+                _e(date(2026, 1, 10), "ジム", 5000, "健康"),
+                _e(date(2026, 2, 10), "ジム", 5000, "健康"),
+                _e(date(2026, 4, 10), "ジム", 5000, "健康"),
+                _e(date(2026, 5, 10), "ジム", 5000, "健康"),
+            ],
+            [],
+            id="E2-3",
+        ),
+    ],
+)
+def test_spec_examples(rows: list[Expense], expected: list[Recurring]) -> None:
+    assert find_recurring(rows) == expected
+
+
+# 以下は規則の補足テスト(表にない端のケース)
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+def test_normalize_memo_removes_suffixes_and_normalizes() -> None:
+    assert normalize_memo("  家賃　#12 ") == "家賃"
+    assert normalize_memo("電気 12") == "電気"
+    assert normalize_memo("保険 2026年1月分") == "保険"
+    assert normalize_memo("ＮＥＴＦＬＩＸ   Plan") == "netflix plan"
+
+
+def test_blank_memo_is_not_a_series() -> None:
+    rows = [_e(date(2026, m, 1), "  ", 100) for m in (1, 2, 3)]
+    assert find_recurring(rows) == []
+
+
+def test_negative_amounts_are_excluded() -> None:
+    rows = [
+        _e(date(2026, 1, 5), "家賃", 80000),
+        _e(date(2026, 2, 5), "家賃", -80000),
+        _e(date(2026, 3, 5), "家賃", 80000),
+        _e(date(2026, 4, 5), "家賃", 80000),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_outlier_amount_is_ignored_without_creating_series() -> None:
+    rows = [
+        _e(date(2026, 1, 5), "電話", 5000),
+        _e(date(2026, 1, 20), "電話", 9000),  # 外れた行は無視される
+        _e(date(2026, 2, 5), "電話", 5000),
+        _e(date(2026, 3, 5), "電話", 5100),
+        _e(date(2026, 4, 5), "電話", 5000),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].months == 4
+    assert result[0].amount == 5000
+    assert result[0].last_date == date(2026, 4, 5)
+
+
+def test_same_month_counts_first_date_only() -> None:
+    rows = [
+        _e(date(2026, 1, 5), "水道", 3000),
+        _e(date(2026, 1, 20), "水道", 3000),
+        _e(date(2026, 2, 5), "水道", 3000),
+        _e(date(2026, 3, 5), "水道", 3000),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].months == 3
+
+
+def test_most_recent_run_of_three_or_more_months_is_used() -> None:
+    rows = [
+        _e(date(2026, 1, 5), "家賃", 80000),
+        _e(date(2026, 2, 5), "家賃", 80000),
+        _e(date(2026, 3, 5), "家賃", 80000),
+        _e(date(2026, 5, 5), "家賃", 80000),
+        _e(date(2026, 6, 5), "家賃", 80000),
+        _e(date(2026, 7, 5), "家賃", 80000),
+        _e(date(2026, 8, 5), "家賃", 80000),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].months == 4
+    assert result[0].last_date == date(2026, 8, 5)
+    assert result[0].next_date == date(2026, 9, 5)
+
+
+def test_next_date_rolls_over_year_end() -> None:
+    rows = [
+        _e(date(2025, 11, 15), "保険", 2000),
+        _e(date(2025, 12, 15), "保険", 2000),
+        _e(date(2026, 1, 15), "保険", 2000),
+    ]
+    assert find_recurring(rows)[0].next_date == date(2026, 2, 15)
+
+
+def test_next_date_mode_ties_prefer_larger_day() -> None:
+    rows = [
+        _e(date(2026, 1, 10), "通信", 4000),
+        _e(date(2026, 2, 20), "通信", 4000),
+        _e(date(2026, 3, 10), "通信", 4000),
+        _e(date(2026, 4, 20), "通信", 4000),
+    ]
+    # 日の最頻は 10 と 20 の同数 → 大きい方の 20 → 5 月 20 日
+    assert find_recurring(rows)[0].next_date == date(2026, 5, 20)
+
+
+def test_result_is_sorted_by_next_date_then_amount_desc_then_memo() -> None:
+    rows = [
+        _e(date(2026, 1, 5), "b", 100),
+        _e(date(2026, 2, 5), "b", 100),
+        _e(date(2026, 3, 5), "b", 100),
+        _e(date(2026, 1, 5), "a", 100),
+        _e(date(2026, 2, 5), "a", 100),
+        _e(date(2026, 3, 5), "a", 100),
+        _e(date(2026, 1, 5), "c", 900, "x"),
+        _e(date(2026, 2, 5), "c", 900, "x"),
+        _e(date(2026, 3, 5), "c", 900, "x"),
+    ]
+    result = find_recurring(rows)
+    assert [r.memo for r in result] == ["c", "a", "b"]
+
+
+def test_input_is_not_mutated() -> None:
+    rows = [
+        _e(date(2026, 3, 5), "家賃", 80000),
+        _e(date(2026, 1, 5), "家賃", 80000),
+        _e(date(2026, 2, 5), "家賃", 80000),
+    ]
+    snapshot = list(rows)
+    find_recurring(rows)
+    assert rows == snapshot
