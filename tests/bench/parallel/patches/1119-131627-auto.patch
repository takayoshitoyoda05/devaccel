--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,182 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    amount_between,
+    and_,
+    category,
+    date_between,
+    memo_contains,
+    not_,
+    or_,
+    search,
+)
+
+ROWS = [
+    Expense(date(2026, 1, 5), "食費", 1000, "ランチ"),
+    Expense(date(2026, 2, 10), "交通費", 500, "Suica"),
+    Expense(date(2026, 3, 1), "食費", 3000, "Dinner with Ｔｅａｍ"),
+    Expense(date(2026, 3, 31), "日用品", -200, "返金"),
+]
+
+
+def test_E3_1_and_empty_is_all_and_or_empty_is_none() -> None:
+    assert search(ROWS, and_()) == ROWS
+    assert search(ROWS, or_()) == []
+
+
+def test_E3_2_amount_between_same_bounds_keeps_exact_match() -> None:
+    assert search(ROWS, amount_between(1000, 1000)) == [ROWS[0]]
+
+
+def test_E3_3_amount_between_lo_gt_hi_raises_value_error() -> None:
+    with pytest.raises(ValueError):
+        amount_between(5, 1)
+
+
+# R1: category — NFKC, strip, case-insensitive full match
+@pytest.mark.parametrize("name", ["食費", " 食費 ", "　食費　"])
+def test_R1_category_matches_after_nfkc_and_strip(name: str) -> None:
+    assert search(ROWS, category(name)) == [ROWS[0], ROWS[2]]
+
+
+def test_R1_category_is_case_insensitive() -> None:
+    rows = [Expense(date(2026, 1, 1), "Food", 10, "")]
+    assert search(rows, category("FOOD")) == rows
+
+
+def test_R1_category_is_full_match_not_partial() -> None:
+    assert search(ROWS, category("食")) == []
+
+
+def test_R1_category_nfkc_fullwidth_latin_matches() -> None:
+    rows = [Expense(date(2026, 1, 1), "ＡＢＣ", 10, "")]
+    assert search(rows, category("abc")) == rows
+
+
+# R1 / D5: memo_contains — NFKC, case-insensitive partial match
+def test_R1_memo_contains_partial_and_nfkc() -> None:
+    assert search(ROWS, memo_contains("team")) == [ROWS[2]]
+
+
+def test_R1_memo_contains_empty_matches_all() -> None:
+    assert search(ROWS, memo_contains("")) == ROWS
+
+
+def test_R1_memo_contains_no_match() -> None:
+    assert search(ROWS, memo_contains("無い")) == []
+
+
+# R2: amount_between — both ends inclusive, None unbounded per side
+def test_R2_amount_between_inclusive_range() -> None:
+    assert search(ROWS, amount_between(500, 1000)) == [ROWS[0], ROWS[1]]
+
+
+def test_R2_amount_between_lo_only() -> None:
+    assert search(ROWS, amount_between(1000, None)) == [ROWS[0], ROWS[2]]
+
+
+def test_R2_amount_between_hi_only() -> None:
+    assert search(ROWS, amount_between(None, 0)) == [ROWS[3]]
+
+
+def test_R2_amount_between_both_none_is_all() -> None:
+    assert search(ROWS, amount_between(None, None)) == ROWS
+
+
+@pytest.mark.parametrize(
+    "lo,hi",
+    [("1", 2), (1, "2"), (True, 2), (1, False), (1.0, 2)],
+)
+def test_R2_amount_between_wrong_type_raises_type_error(lo: object, hi: object) -> None:
+    with pytest.raises(TypeError):
+        amount_between(lo, hi)  # type: ignore[arg-type]
+
+
+# R2: date_between — both ends inclusive, None unbounded per side
+def test_R2_date_between_inclusive_range() -> None:
+    assert search(ROWS, date_between(date(2026, 2, 10), date(2026, 3, 1))) == [
+        ROWS[1],
+        ROWS[2],
+    ]
+
+
+def test_R2_date_between_start_only() -> None:
+    assert search(ROWS, date_between(date(2026, 3, 1), None)) == [ROWS[2], ROWS[3]]
+
+
+def test_R2_date_between_end_only() -> None:
+    assert search(ROWS, date_between(None, date(2026, 1, 5))) == [ROWS[0]]
+
+
+def test_R2_date_between_start_gt_end_raises_value_error() -> None:
+    with pytest.raises(ValueError):
+        date_between(date(2026, 3, 1), date(2026, 1, 1))
+
+
+def test_R2_date_between_wrong_type_raises_type_error() -> None:
+    with pytest.raises(TypeError):
+        date_between("2026-01-01", None)  # type: ignore[arg-type]
+
+
+# R3: combinators
+def test_R3_and_all_must_match() -> None:
+    cond = and_(category("食費"), amount_between(2000, None))
+    assert search(ROWS, cond) == [ROWS[2]]
+
+
+def test_R3_or_any_matches() -> None:
+    cond = or_(category("交通費"), memo_contains("返金"))
+    assert search(ROWS, cond) == [ROWS[1], ROWS[3]]
+
+
+def test_R3_not_inverts() -> None:
+    assert search(ROWS, not_(category("食費"))) == [ROWS[1], ROWS[3]]
+
+
+def test_R3_nested_combinators() -> None:
+    cond = not_(or_(category("食費"), amount_between(None, 0)))
+    assert search(ROWS, cond) == [ROWS[1]]
+
+
+def test_R3_and_short_circuits_left_to_right() -> None:
+    calls: list[str] = []
+
+    def first(e: Expense) -> bool:
+        calls.append("first")
+        return False
+
+    def second(e: Expense) -> bool:
+        calls.append("second")
+        return True
+
+    assert search(ROWS[:1], and_(first, second)) == []
+    assert calls == ["first"]
+
+
+def test_R3_or_short_circuits_left_to_right() -> None:
+    calls: list[str] = []
+
+    def first(e: Expense) -> bool:
+        calls.append("first")
+        return True
+
+    def second(e: Expense) -> bool:
+        calls.append("second")
+        return False
+
+    assert search(ROWS[:1], or_(first, second)) == ROWS[:1]
+    assert calls == ["first"]
+
+
+# R4: order kept, new list returned, input unchanged
+def test_R4_keeps_input_order_and_returns_new_list() -> None:
+    original = list(ROWS)
+    result = search(ROWS, and_())
+    assert result == ROWS
+    assert result is not ROWS
+    assert ROWS == original
