@@ -0,0 +1,224 @@
+"""Import bank / credit-card CSV exports into Expense records (pure functions)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from collections.abc import Iterator
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int  # physical line where the record starts (header = 1)
+    column: str  # original header name; "" when the whole row is bad
+    value: str
+    reason: str
+
+
+_DATE_ALIASES = ("date", "日付", "利用日", "取引日", "ご利用日")
+_AMOUNT_ALIASES = ("amount", "金額", "利用金額", "ご利用金額")
+_WITHDRAW_ALIASES = ("出金額", "出金", "支払", "お支払金額")
+_DEPOSIT_ALIASES = ("入金額", "入金", "預入")
+_MEMO_ALIASES = ("memo", "摘要", "メモ", "利用店名", "ご利用店名", "description")
+_CATEGORY_ALIASES = ("category", "カテゴリ", "分類")
+
+_DATE_RE = re.compile(
+    r"(\d{4})(?:([-/.])(\d{1,2})\2(\d{1,2})|年(\d{1,2})月(\d{1,2})日)"
+    r"(?:(?:T|\s+)\d{1,2}:\d{2}(?::\d{2})?)?"
+)
+_NEGATIVE_PREFIXES = ("-", "−", "△", "▲")
+
+
+def _nfkc(s: str) -> str:
+    return unicodedata.normalize("NFKC", s)
+
+
+def _norm_name(s: str) -> str:
+    return _nfkc(s).strip().lower()
+
+
+def _parse_date(raw: str) -> date:
+    s = _nfkc(raw).strip()
+    m = _DATE_RE.fullmatch(s)
+    if m is None:
+        raise ValueError("日付の形式が不正です")
+    if m.group(2) is not None:
+        year, month, day = m.group(1), m.group(3), m.group(4)
+    else:
+        year, month, day = m.group(1), m.group(5), m.group(6)
+    try:
+        return date(int(year), int(month), int(day))
+    except ValueError:
+        raise ValueError("存在しない日付です") from None
+
+
+def _parse_amount(raw: str) -> int | None:
+    """Signed yen. None means 'empty' (空欄 or a lone '-')."""
+    s = _nfkc(raw)
+    s = re.sub(r"\s+", "", s)
+    s = re.sub(r"JPY", "", s, flags=re.IGNORECASE)
+    s = s.replace("¥", "").replace("円", "").replace(",", "")
+    if s in ("", "-", "−"):
+        return None
+    negative = False
+    if s.startswith(_NEGATIVE_PREFIXES):
+        negative = True
+        s = s[1:]
+    elif s.startswith("(") and s.endswith(")"):
+        negative = True
+        s = s[1:-1]
+    elif s.endswith("-"):
+        negative = True
+        s = s[:-1]
+    if re.fullmatch(r"[0-9]+", s) is None:
+        if re.fullmatch(r"[0-9]+\.[0-9]*|\.[0-9]+", s):
+            raise ValueError("小数は使えません")
+        raise ValueError("数字ではありません")
+    value = int(s)
+    return -value if negative else value
+
+
+def _records(text: str, delimiter: str) -> Iterator[tuple[int, list[str]]]:
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delimiter)
+    prev = 0
+    for row in reader:
+        start = prev + 1
+        prev = reader.line_num
+        yield start, row
+
+
+def _find(header: list[str], aliases: tuple[str, ...]) -> int | None:
+    wanted = {_norm_name(a) for a in aliases}
+    for i, name in enumerate(header):
+        if _norm_name(name) in wanted:
+            return i
+    return None
+
+
+def parse_bank_csv(text: str) -> tuple[list[Expense], list[RowError]]:
+    text = text.removeprefix("﻿")
+    first_line = re.split(r"\r\n|\r|\n", text, maxsplit=1)[0]
+    delimiter = "\t" if first_line.count("\t") > first_line.count(",") else ","
+
+    records = [
+        (n, row) for n, row in _records(text, delimiter) if any(c.strip() for c in row)
+    ]
+    if not records:
+        return [], []
+
+    _, header = records[0]
+    body = records[1:]
+    width = len(header)
+
+    date_i = _find(header, _DATE_ALIASES)
+    amount_i = _find(header, _AMOUNT_ALIASES)
+    withdraw_i = _find(header, _WITHDRAW_ALIASES)
+    deposit_i = _find(header, _DEPOSIT_ALIASES)
+    memo_i = _find(header, _MEMO_ALIASES)
+    category_i = _find(header, _CATEGORY_ALIASES)
+
+    if date_i is None:
+        raise ValueError("必須列がありません: 日付")
+    if withdraw_i is None and amount_i is None:
+        raise ValueError("必須列がありません: 金額・出金")
+
+    def cell(row: list[str], i: int | None) -> str:
+        return "" if i is None else row[i]
+
+    def col_name(i: int | None) -> str:
+        return "" if i is None else header[i]
+
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+
+    for line, row in body:
+        if len(row) != width:
+            errors.append(
+                RowError(
+                    line,
+                    "",
+                    ",".join(row),
+                    f"列数が不正です: 期待 {width} 列, 実際 {len(row)} 列",
+                )
+            )
+            continue
+
+        row_errors: list[RowError] = []
+        day: date | None = None
+        raw_date = row[date_i]
+        try:
+            day = _parse_date(raw_date)
+        except ValueError as e:
+            row_errors.append(RowError(line, col_name(date_i), raw_date, str(e)))
+
+        amount: int | None = None
+        skip = False
+        if withdraw_i is not None:
+            # 2-column form: 出金 / 入金. Zero and empty both mean "no value here".
+            w_raw = row[withdraw_i]
+            d_raw = cell(row, deposit_i)
+            w: int | None = None
+            d: int | None = None
+            try:
+                w = _parse_amount(w_raw)
+            except ValueError as e:
+                row_errors.append(RowError(line, col_name(withdraw_i), w_raw, str(e)))
+            if deposit_i is not None:
+                try:
+                    d = _parse_amount(d_raw)
+                except ValueError as e:
+                    row_errors.append(
+                        RowError(line, col_name(deposit_i), d_raw, str(e))
+                    )
+            if not row_errors:
+                w_present = w not in (None, 0)
+                d_present = d not in (None, 0)
+                if w_present and d_present:
+                    row_errors.append(
+                        RowError(
+                            line,
+                            col_name(withdraw_i),
+                            w_raw,
+                            "出金と入金の両方に値があります",
+                        )
+                    )
+                elif w_present:
+                    amount = w
+                else:
+                    skip = True  # deposit only, or both empty (D1)
+        else:
+            assert amount_i is not None
+            a_raw = row[amount_i]
+            try:
+                a = _parse_amount(a_raw)
+            except ValueError as e:
+                row_errors.append(RowError(line, col_name(amount_i), a_raw, str(e)))
+            else:
+                if a is None:
+                    row_errors.append(
+                        RowError(line, col_name(amount_i), a_raw, "金額が空です")
+                    )
+                elif a == 0:
+                    row_errors.append(
+                        RowError(line, col_name(amount_i), a_raw, "金額が 0 です")
+                    )
+                else:
+                    amount = a
+
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        if skip or day is None or amount is None:
+            continue
+
+        memo = _nfkc(cell(row, memo_i)).strip()
+        category = _nfkc(cell(row, category_i)).strip()
+        expenses.append(Expense(day=day, category=category, amount=amount, memo=memo))
+
+    return expenses, errors
