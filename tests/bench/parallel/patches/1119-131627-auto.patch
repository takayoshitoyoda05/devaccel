+"""Month-over-month comparison per category (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryDiff:
+    category: str
+    previous: int
+    current: int
+    diff: int
+    pct: float | None
+
+
+def _parse_month(month: str) -> tuple[int, int]:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"month は YYYY-MM 形式で指定してください: {month!r}")
+    y, m = month.split("-")
+    return int(y), int(m)
+
+
+def _previous(year: int, mm: int) -> tuple[int, int]:
+    if mm == 1:
+        return year - 1, 12
+    return year, mm - 1
+
+
+def compare_months(rows: list[Expense], month: str) -> list[CategoryDiff]:
+    year, mm = _parse_month(month)
+    prev_year, prev_mm = _previous(year, mm)
+
+    previous_totals: dict[str, int] = {}
+    current_totals: dict[str, int] = {}
+    for e in rows:
+        if (e.day.year, e.day.month) == (year, mm):
+            current_totals[e.category] = current_totals.get(e.category, 0) + e.amount
+        elif (e.day.year, e.day.month) == (prev_year, prev_mm):
+            previous_totals[e.category] = previous_totals.get(e.category, 0) + e.amount
+
+    out: list[CategoryDiff] = []
+    for cat in set(previous_totals) | set(current_totals):
+        prev = previous_totals.get(cat, 0)
+        cur = current_totals.get(cat, 0)
+        if prev == 0 and cur == 0:
+            continue
+        diff = cur - prev
+        # + 0.0 turns a negative zero into 0.0
+        pct = None if prev == 0 else round(diff / prev * 100, 1) + 0.0
+        out.append(CategoryDiff(cat, prev, cur, diff, pct))
+
+    out.sort(key=lambda d: (-abs(d.diff), d.category))
+    return out
+
+
+def _signed_int(n: int) -> str:
+    if n > 0:
+        return f"+{n}"
+    if n < 0:
+        return str(n)
+    return "±0"
+
+
+def _pct_text(d: CategoryDiff) -> str:
+    if d.pct is None:
+        return "新規" if d.previous == 0 and d.current > 0 else "-"
+    if d.pct > 0:
+        return f"+{d.pct:.1f}%"
+    if d.pct < 0:
+        return f"{d.pct:.1f}%"
+    return "±0.0%"
+
+
+def format_report(diffs: list[CategoryDiff]) -> str:
+    if not diffs:
+        return "差分なし"
+    lines = [
+        f"{d.category}: {d.previous}→{d.current} ({_signed_int(d.diff)}, {_pct_text(d)})"
+        for d in diffs
+    ]
+    return "\n".join(lines)
