+++ b/src/kakeibo/search.py
@@ -0,0 +1,100 @@
+"""Condition-based search over expenses (pure functions)."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable
+from datetime import date
+
+from kakeibo.core import Expense
+
+Cond = Callable[[Expense], bool]
+
+
+def _norm(text: str) -> str:
+    return unicodedata.normalize("NFKC", text).casefold()
+
+
+def search(rows: list[Expense], cond: Cond) -> list[Expense]:
+    """Return the rows matching cond, in input order, as a new list."""
+    return [e for e in rows if cond(e)]
+
+
+def category(name: str) -> Cond:
+    """NFKC・前後空白除去後の完全一致(大文字小文字は区別しない)。"""
+    target = _norm(name).strip()
+
+    def cond(e: Expense) -> bool:
+        return _norm(e.category).strip() == target
+
+    return cond
+
+
+def memo_contains(text: str) -> Cond:
+    """NFKC・大文字小文字無視の部分一致。空文字は全件に一致。"""
+    needle = _norm(text)
+
+    def cond(e: Expense) -> bool:
+        return needle in _norm(e.memo)
+
+    return cond
+
+
+def _is_int(x: object) -> bool:
+    return isinstance(x, int) and not isinstance(x, bool)
+
+
+def amount_between(lo: int | None, hi: int | None) -> Cond:
+    """lo 以上 hi 以下(両端含む)。None はその側が無制限。"""
+    if lo is not None and not _is_int(lo):
+        raise TypeError(f"lo は int か None である必要があります: {lo!r}")
+    if hi is not None and not _is_int(hi):
+        raise TypeError(f"hi は int か None である必要があります: {hi!r}")
+    if lo is not None and hi is not None and lo > hi:
+        raise ValueError(f"lo ({lo}) が hi ({hi}) より大きいです")
+
+    def cond(e: Expense) -> bool:
+        return (lo is None or e.amount >= lo) and (hi is None or e.amount <= hi)
+
+    return cond
+
+
+def date_between(start: date | None, end: date | None) -> Cond:
+    """start 以上 end 以下(両端含む)。None はその側が無制限。"""
+    for name, v in (("start", start), ("end", end)):
+        if v is not None and not isinstance(v, date):
+            raise TypeError(f"{name} は date か None である必要があります: {v!r}")
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"start ({start}) が end ({end}) より後です")
+
+    def cond(e: Expense) -> bool:
+        return (start is None or e.day >= start) and (end is None or e.day <= end)
+
+    return cond
+
+
+def and_(*conds: Cond) -> Cond:
+    """全て真なら真。条件が空なら真。左から短絡評価。"""
+
+    def cond(e: Expense) -> bool:
+        return all(c(e) for c in conds)
+
+    return cond
+
+
+def or_(*conds: Cond) -> Cond:
+    """どれか真なら真。条件が空なら偽。左から短絡評価。"""
+
+    def cond(e: Expense) -> bool:
+        return any(c(e) for c in conds)
+
+    return cond
+
+
+def not_(c: Cond) -> Cond:
+    """条件を反転する。"""
+
+    def cond(e: Expense) -> bool:
+        return not c(e)
+
+    return cond
