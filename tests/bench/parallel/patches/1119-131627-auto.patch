@@ -0,0 +1,185 @@
+"""Tests for kakeibo.monthdiff (month-over-month comparison)."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import CategoryDiff, compare_months, format_report
+
+
+def _e(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+# --- 例の表 (E4-*) ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("rows", "month", "expected"),
+    [
+        pytest.param(
+            [_e("2026-01-10", "食費", 30000), _e("2026-02-05", "食費", 33000)],
+            "2026-02",
+            [CategoryDiff("食費", 30000, 33000, 3000, 10.0)],
+            id="E4-1",
+        ),
+        pytest.param(
+            [_e("2026-01-03", "交通費", 5000)],
+            "2026-02",
+            [CategoryDiff("交通費", 5000, 0, -5000, -100.0)],
+            id="E4-2",
+        ),
+        pytest.param(
+            [_e("2026-02-01", "趣味", 2000)],
+            "2026-02",
+            [CategoryDiff("趣味", 0, 2000, 2000, None)],
+            id="E4-3",
+        ),
+    ],
+)
+def test_compare_months_examples(
+    rows: list[Expense], month: str, expected: list[CategoryDiff]
+) -> None:
+    assert compare_months(rows, month) == expected
+
+
+@pytest.mark.parametrize(
+    ("diff", "expected_line"),
+    [
+        pytest.param(
+            CategoryDiff("食費", 30000, 33000, 3000, 10.0),
+            "食費: 30000→33000 (+3000, +10.0%)",
+            id="E4-1",
+        ),
+        pytest.param(
+            CategoryDiff("交通費", 5000, 0, -5000, -100.0),
+            "交通費: 5000→0 (-5000, -100.0%)",
+            id="E4-2",
+        ),
+        pytest.param(
+            CategoryDiff("趣味", 0, 2000, 2000, None),
+            "趣味: 0→2000 (+2000, 新規)",
+            id="E4-3",
+        ),
+    ],
+)
+def test_format_report_examples(diff: CategoryDiff, expected_line: str) -> None:
+    assert format_report([diff]) == expected_line
+
+
+# --- R1: month 形式 -------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "month", ["2026-13", "2026/01", "2026-1", "26-01", "", "2026-00"]
+)
+def test_invalid_month_raises(month: str) -> None:
+    with pytest.raises(ValueError):
+        compare_months([], month)
+
+
+def test_january_compares_with_previous_december() -> None:
+    rows = [_e("2025-12-20", "食費", 1000), _e("2026-01-05", "食費", 1500)]
+    assert compare_months(rows, "2026-01") == [
+        CategoryDiff("食費", 1000, 1500, 500, 50.0)
+    ]
+
+
+# --- R2: 集計・含める範囲・丸め -------------------------------------------
+
+
+def test_refund_is_summed_into_month_total() -> None:
+    rows = [
+        _e("2026-01-01", "食費", 1000),
+        _e("2026-02-01", "食費", 300),
+        _e("2026-02-02", "食費", -100),
+    ]
+    assert compare_months(rows, "2026-02") == [
+        CategoryDiff("食費", 1000, 200, -800, -80.0)
+    ]
+
+
+def test_category_with_both_months_zero_is_excluded() -> None:
+    rows = [_e("2026-02-01", "雑費", 100), _e("2026-02-02", "雑費", -100)]
+    assert compare_months(rows, "2026-02") == []
+
+
+def test_pct_is_rounded_to_one_decimal() -> None:
+    rows = [_e("2026-01-01", "食費", 3), _e("2026-02-01", "食費", 4)]
+    # 1 / 3 * 100 = 33.333... -> 33.3
+    assert compare_months(rows, "2026-02") == [CategoryDiff("食費", 3, 4, 1, 33.3)]
+
+
+def test_pct_none_when_previous_is_zero() -> None:
+    rows = [_e("2026-02-01", "趣味", 2000)]
+    [d] = compare_months(rows, "2026-02")
+    assert d.pct is None
+
+
+def test_no_rows_in_either_month_returns_empty() -> None:
+    rows = [_e("2025-06-01", "食費", 1000)]
+    assert compare_months(rows, "2026-02") == []
+
+
+def test_empty_input_returns_empty() -> None:
+    assert compare_months([], "2026-02") == []
+
+
+# --- R3: 並び・入力不変 ---------------------------------------------------
+
+
+def test_sorted_by_abs_diff_desc_then_category_asc() -> None:
+    rows = [
+        _e("2026-01-01", "A", 1000),
+        _e("2026-02-01", "A", 1100),  # diff 100
+        _e("2026-01-01", "C", 1000),
+        _e("2026-02-01", "C", 1500),  # diff 500
+        _e("2026-01-01", "B", 1000),
+        _e("2026-02-01", "B", 500),  # diff -500
+    ]
+    cats = [d.category for d in compare_months(rows, "2026-02")]
+    assert cats == ["B", "C", "A"]
+
+
+def test_input_is_not_modified() -> None:
+    rows = [_e("2026-01-01", "食費", 1000), _e("2026-02-01", "食費", 2000)]
+    before = list(rows)
+    compare_months(rows, "2026-02")
+    assert rows == before
+
+
+# --- R4: format_report ----------------------------------------------------
+
+
+def test_format_report_empty_says_no_diff() -> None:
+    assert format_report([]) == "差分なし"
+
+
+def test_format_report_zero_diff_uses_plus_minus() -> None:
+    line = format_report([CategoryDiff("食費", 1000, 1000, 0, 0.0)])
+    assert line == "食費: 1000→1000 (±0, ±0.0%)"
+
+
+def test_format_report_decrease_has_minus_sign() -> None:
+    line = format_report([CategoryDiff("食費", 2000, 1000, -1000, -50.0)])
+    assert line == "食費: 2000→1000 (-1000, -50.0%)"
+
+
+def test_format_report_refund_only_with_no_previous_uses_dash() -> None:
+    # 前月 0・当月 < 0 は「新規」ではなく "-"
+    line = format_report([CategoryDiff("食費", 0, -500, -500, None)])
+    assert line == "食費: 0→-500 (-500, -)"
+
+
+def test_format_report_one_line_per_category() -> None:
+    diffs = [
+        CategoryDiff("食費", 30000, 33000, 3000, 10.0),
+        CategoryDiff("交通費", 5000, 0, -5000, -100.0),
+    ]
+    assert format_report(diffs).split("\n") == [
+        "食費: 30000→33000 (+3000, +10.0%)",
+        "交通費: 5000→0 (-5000, -100.0%)",
+    ]
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
