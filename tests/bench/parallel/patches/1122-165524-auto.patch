diff --git a/tests/test_types/test_Choice.py b/tests/test_types/test_Choice.py
index c34f516..9302bfe 100644
--- a/tests/test_types/test_Choice.py
+++ b/tests/test_types/test_Choice.py
@@ -5,3 +5,38 @@ def test_choice_get_invalid_choice_message():
     choice = click.Choice(["a", "b", "c"])
     message = choice.get_invalid_choice_message("d", ctx=None)
     assert message == "'d' is not one of 'a', 'b', 'c'."
+
+
+def test_choice_invalid_message_suggests_one_close_match():
+    choice = click.Choice(["push", "pull", "commit"])
+    message = choice.get_invalid_choice_message("comit", ctx=None)
+    assert message.endswith("Did you mean 'commit'?")
+
+
+def test_choice_invalid_message_suggests_several_close_matches():
+    choice = click.Choice(["declare", "refine", "push"])
+    message = choice.get_invalid_choice_message("decline", ctx=None)
+    assert message.endswith("(Did you mean one of: 'declare', 'refine'?)")
+
+
+def test_choice_invalid_message_no_suggestion_when_nothing_is_close():
+    choice = click.Choice(["push", "pull"])
+    message = choice.get_invalid_choice_message("zzzz", ctx=None)
+    assert "Did you mean" not in message
+
+
+def test_choice_invalid_message_suggests_normalized_choice():
+    choice = click.Choice(["Commit", "Push"], case_sensitive=False)
+    message = choice.get_invalid_choice_message("COMIT", ctx=None)
+    assert message.endswith("Did you mean 'commit'?")
+
+
+def test_choice_invalid_value_cli_error_has_suggestion(runner):
+    @click.command()
+    @click.option("--mode", type=click.Choice(["push", "pull", "commit"]))
+    def cli(mode):
+        pass
+
+    result = runner.invoke(cli, ["--mode", "comit"])
+    assert result.exit_code == 2
+    assert "Did you mean 'commit'?" in result.output
