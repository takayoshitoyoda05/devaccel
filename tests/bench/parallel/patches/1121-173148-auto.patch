+from datetime import date
+
+import pytest
+
+from kakeibo.core import CsvError, Expense, load_csv, monthly_totals
+
+HEADER = "date,category,amount,memo\n"
+
+
+def _write(tmp_path, body, header=HEADER):
+    p = tmp_path / "in.csv"
+    p.write_bytes((header + body).encode("utf-8"))
+    return p
+
+
+# --- load_csv ---
+
+
+def test_load_csv_empty_file_and_header_only(tmp_path):
+    p = tmp_path / "empty.csv"
+    p.write_bytes(b"")
+    assert load_csv(p) == []
+    assert load_csv(_write(tmp_path, "")) == []
+
+
+def test_load_csv_skips_blank_lines_and_keeps_line_numbers(tmp_path):
+    p = _write(tmp_path, "2026-11-01,food,100,\n\nbad,food,1,\n")
+    with pytest.raises(CsvError) as ei:
+        load_csv(p)
+    assert [n for n, _ in ei.value.errors] == [4]
+
+
+def test_load_csv_crlf(tmp_path):
+    p = _write(tmp_path, "2026-11-01,food,100,memo\r\n", HEADER.replace("\n", "\r\n"))
+    assert load_csv(p) == [Expense(date(2026, 11, 1), "food", 100, "memo")]
+
+
+def test_load_csv_quoted_multiline_memo_and_following_error_line(tmp_path):
+    p = _write(tmp_path, '2026-11-01,food,100,"a\nb"\nbad,food,1,\n')
+    with pytest.raises(CsvError) as ei:
+        load_csv(p)
+    assert [n for n, _ in ei.value.errors] == [4]
+    ok = _write(tmp_path, '2026-11-01,food,100,"a, ""b""\nc"\n')
+    assert load_csv(ok)[0].memo == 'a, "b"\nc'
+
+
+def test_load_csv_strips_category_whitespace_but_not_memo(tmp_path):
+    p = _write(tmp_path, "2026-11-01,  food ,100, memo \n")
+    (e,) = load_csv(p)
+    assert e.category == "food"
+    assert e.memo == " memo "
+
+
+def test_load_csv_missing_memo_column_value_defaults_empty(tmp_path):
+    (e,) = load_csv(_write(tmp_path, "2026-11-01,food,100\n"))
+    assert e.memo == ""
+
+
+def test_load_csv_extra_fields_are_ignored(tmp_path):
+    (e,) = load_csv(_write(tmp_path, "2026-11-01,food,100,m,extra,more\n"))
+    assert (e.amount, e.memo) == (100, "m")
+
+
+def test_load_csv_header_without_amount_column_errors_every_row(tmp_path):
+    p = _write(
+        tmp_path, "2026-11-01,food,m\n2026-11-02,food,m\n", "date,category,memo\n"
+    )
+    with pytest.raises(CsvError) as ei:
+        load_csv(p)
+    assert [n for n, _ in ei.value.errors] == [2, 3]
+    assert all("amount" in why for _, why in ei.value.errors)
+
+
+@pytest.mark.parametrize("amount", ["-500", "0", " 100 ", "+7"])
+def test_load_csv_integer_amount_forms_accepted(tmp_path, amount):
+    (e,) = load_csv(_write(tmp_path, f"2026-11-01,food,{amount},\n"))
+    assert e.amount == int(amount)
+
+
+@pytest.mark.parametrize("amount", ["1.5", "1,200", "", "1e3", "1_0x", "abc"])
+def test_load_csv_non_integer_amount_rejected(tmp_path, amount):
+    body = f'2026-11-01,food,"{amount}",\n'
+    with pytest.raises(CsvError) as ei:
+        load_csv(_write(tmp_path, body))
+    assert ei.value.errors[0][0] == 2
+
+
+@pytest.mark.parametrize(
+    "day", ["2026-02-30", "2026-13-01", "2026-1-1", "2026/11/01", "", "11-01"]
+)
+def test_load_csv_invalid_dates_rejected(tmp_path, day):
+    with pytest.raises(CsvError):
+        load_csv(_write(tmp_path, f"{day},food,100,\n"))
+
+
+def test_load_csv_leap_day(tmp_path):
+    (e,) = load_csv(_write(tmp_path, "2028-02-29,food,100,\n"))
+    assert e.day == date(2028, 2, 29)
+
+
+def test_load_csv_good_rows_not_returned_when_any_row_bad(tmp_path):
+    p = _write(tmp_path, "2026-11-01,food,100,\nbad,food,1,\n")
+    with pytest.raises(CsvError):
+        load_csv(p)
+
+
+def test_csv_error_message_lists_all_errors(tmp_path):
+    p = _write(tmp_path, "bad,food,1,\n2026-11-01,food,x,\n")
+    with pytest.raises(CsvError) as ei:
+        load_csv(p)
+    msg = str(ei.value)
+    assert msg.startswith("2: ") and "; 3: " in msg
+
+
+# --- monthly_totals ---
+
+
+def test_monthly_totals_empty():
+    assert monthly_totals([]) == {}
+
+
+def test_monthly_totals_sorts_across_year_boundary():
+    rows = [
+        Expense(date(2026, 1, 5), "a", 1),
+        Expense(date(2025, 12, 31), "a", 1),
+        Expense(date(2025, 2, 1), "a", 1),
+    ]
+    assert list(monthly_totals(rows)) == ["2025-02", "2025-12", "2026-01"]
+
+
+def test_monthly_totals_month_boundaries_and_leap_day():
+    rows = [
+        Expense(date(2028, 2, 29), "a", 1),
+        Expense(date(2028, 3, 1), "a", 10),
+        Expense(date(2028, 1, 31), "a", 100),
+    ]
+    assert monthly_totals(rows) == {
+        "2028-01": {"a": 100},
+        "2028-02": {"a": 1},
+        "2028-03": {"a": 10},
+    }
+
+
+def test_monthly_totals_negative_and_zero_totals_kept():
+    rows = [
+        Expense(date(2026, 11, 1), "food", 500),
+        Expense(date(2026, 11, 2), "food", -500),
+        Expense(date(2026, 11, 3), "refund", -300),
+        Expense(date(2026, 11, 4), "rent", 100),
+    ]
+    out = monthly_totals(rows)["2026-11"]
+    assert out == {"rent": 100, "food": 0, "refund": -300}
+    assert list(out) == ["rent", "food", "refund"]
+
+
+def test_monthly_totals_ties_keep_first_seen_order():
+    rows = [
+        Expense(date(2026, 11, 1), "b", 100),
+        Expense(date(2026, 11, 2), "a", 100),
+    ]
+    assert list(monthly_totals(rows)["2026-11"]) == ["b", "a"]
+
+
+def test_monthly_totals_same_category_separate_per_month():
+    rows = [
+        Expense(date(2026, 10, 1), "food", 1),
+        Expense(date(2026, 11, 1), "food", 2),
+    ]
+    assert monthly_totals(rows) == {"2026-10": {"food": 1}, "2026-11": {"food": 2}}
+
+
+def test_monthly_totals_does_not_mutate_input():
+    rows = [
+        Expense(date(2026, 11, 2), "b", 1),
+        Expense(date(2026, 10, 1), "a", 2),
+    ]
+    snapshot = list(rows)
+    monthly_totals(rows)
+    assert rows == snapshot
