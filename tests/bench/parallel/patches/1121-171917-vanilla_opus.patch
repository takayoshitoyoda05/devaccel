 HEADER = "date,category,amount,memo\n"
 
@@ -63,3 +69,230 @@ def test_total_flag_appends_total_row(tmp_path, capsys, monkeypatch):
     monkeypatch.setattr(sys, "argv", ["kakeibo", str(csv), "--total"])
     main()
     assert capsys.readouterr().out.splitlines()[-1] == "TOTAL\t2,000"
+
+
+# --- load_csv: edge cases ---------------------------------------------------
+
+
+def test_load_csv_empty_file_returns_empty_list(tmp_path):
+    p = tmp_path / "empty.csv"
+    p.write_text("", encoding="utf-8")
+    assert load_csv(p) == []
+
+
+def test_load_csv_header_only_returns_empty_list(tmp_path):
+    assert load_csv(_write(tmp_path, "")) == []
+
+
+def test_load_csv_parses_fields(tmp_path):
+    p = _write(tmp_path, "2026-11-01,food,1200,lunch\n")
+    assert load_csv(p) == [Expense(date(2026, 11, 1), "food", 1200, "lunch")]
+
+
+def test_load_csv_accepts_crlf_line_endings(tmp_path):
+    p = tmp_path / "crlf.csv"
+    p.write_bytes(b"date,category,amount,memo\r\n2026-11-01,food,100,x\r\n")
+    assert load_csv(p) == [Expense(date(2026, 11, 1), "food", 100, "x")]
+
+
+def test_load_csv_skips_blank_lines_and_keeps_physical_line_numbers(tmp_path):
+    p = _write(tmp_path, "\n2026-11-01,food,100,\n\nbad,food,1,\n")
+    with pytest.raises(CsvError) as ei:
+        load_csv(p)
+    assert [line for line, _ in ei.value.errors] == [5]
+
+
+def test_load_csv_quoted_memo_with_comma_and_newline(tmp_path):
+    p = _write(tmp_path, '2026-11-01,food,100,"a, b"\n2026-11-02,food,200,"x\ny"\n')
+    assert [e.memo for e in load_csv(p)] == ["a, b", "x\ny"]
+
+
+def test_load_csv_line_numbers_after_multiline_record(tmp_path):
+    p = _write(tmp_path, '2026-11-01,food,100,"x\ny"\nbad,food,1,\n')
+    with pytest.raises(CsvError) as ei:
+        load_csv(p)
+    assert [line for line, _ in ei.value.errors] == [4]
+
+
+@pytest.mark.xfail(
+    strict=True,
+    reason="不具合: 複数行レコードのエラー行番号が開始行ではなく終了行になる",
+)
+def test_load_csv_bad_multiline_record_reports_start_line(tmp_path):
+    p = _write(tmp_path, 'bad,food,100,"x\ny"\n')
+    with pytest.raises(CsvError) as ei:
+        load_csv(p)
+    assert [line for line, _ in ei.value.errors] == [2]
+
+
+def test_load_csv_memo_column_is_optional(tmp_path):
+    p = tmp_path / "nomemo.csv"
+    p.write_text("date,category,amount\n2026-11-01,food,100\n", encoding="utf-8")
+    assert load_csv(p) == [Expense(date(2026, 11, 1), "food", 100, "")]
+
+
+def test_load_csv_columns_matched_by_name_not_position(tmp_path):
+    p = tmp_path / "reordered.csv"
+    p.write_text("amount,memo,category,date\n100,m,food,2026-11-01\n", encoding="utf-8")
+    assert load_csv(p) == [Expense(date(2026, 11, 1), "food", 100, "m")]
+
+
+def test_load_csv_extra_trailing_fields_are_ignored(tmp_path):
+    p = _write(tmp_path, "2026-11-01,food,100,m,extra\n")
+    assert load_csv(p) == [Expense(date(2026, 11, 1), "food", 100, "m")]
+
+
+def test_load_csv_missing_header_column_reports_every_row(tmp_path):
+    p = tmp_path / "noamount.csv"
+    p.write_text("date,category\n2026-11-01,food\n2026-11-02,rent\n", encoding="utf-8")
+    with pytest.raises(CsvError) as ei:
+        load_csv(p)
+    assert ei.value.errors == [
+        (2, "列 amount がありません"),
+        (3, "列 amount がありません"),
+    ]
+
+
+def test_load_csv_strips_category_and_amount_but_keeps_memo(tmp_path):
+    p = _write(tmp_path, "2026-11-01, food , 100 , hi \n")
+    assert load_csv(p) == [Expense(date(2026, 11, 1), "food", 100, " hi ")]
+
+
+def test_load_csv_accepts_negative_amount(tmp_path):
+    p = _write(tmp_path, "2026-11-01,refund,-300,\n")
+    assert load_csv(p)[0].amount == -300
+
+
+@pytest.mark.parametrize("amount", ["", "100.0", "1,000", "1e3"])
+def test_load_csv_rejects_non_integer_amount(tmp_path, amount):
+    p = _write(tmp_path, '2026-11-01,food,"' + amount + '",\n')
+    with pytest.raises(CsvError) as ei:
+        load_csv(p)
+    assert ei.value.errors == [(2, f"金額が整数ではありません: {amount!r}")]
+
+
+@pytest.mark.parametrize(
+    "day", ["", "2026-02-30", "2026-13-01", "2026/11/01", " 2026-11-01"]
+)
+def test_load_csv_rejects_invalid_date(tmp_path, day):
+    p = _write(tmp_path, '"' + day + '",food,100,\n')
+    with pytest.raises(CsvError) as ei:
+        load_csv(p)
+    assert ei.value.errors == [(2, f"日付が不正です: {day!r}")]
+
+
+def test_load_csv_accepts_leap_day(tmp_path):
+    p = _write(tmp_path, "2028-02-29,food,100,\n")
+    assert load_csv(p)[0].day == date(2028, 2, 29)
+
+
+def test_load_csv_row_with_multiple_problems_reports_first_only(tmp_path):
+    p = _write(tmp_path, "bad,food,abc,\n")
+    with pytest.raises(CsvError) as ei:
+        load_csv(p)
+    assert ei.value.errors == [(2, "日付が不正です: 'bad'")]
+
+
+def test_csv_error_message_joins_all_errors(tmp_path):
+    p = _write(tmp_path, "bad,food,1,\n2026-11-01,food,x,\n")
+    with pytest.raises(CsvError) as ei:
+        load_csv(p)
+    assert str(ei.value) == "2: 日付が不正です: 'bad'; 3: 金額が整数ではありません: 'x'"
+
+
+@pytest.mark.xfail(
+    strict=True,
+    reason="不具合: BOM 付き UTF-8 (Excel 出力) で先頭列名が '\\ufeffdate' になり全行エラー",
+)
+def test_load_csv_accepts_utf8_bom(tmp_path):
+    p = tmp_path / "bom.csv"
+    p.write_bytes((HEADER + "2026-11-01,food,100,\n").encode("utf-8-sig"))
+    assert load_csv(p) == [Expense(date(2026, 11, 1), "food", 100, "")]
+
+
+# --- monthly_totals: edge cases ---------------------------------------------
+
+
+def test_monthly_totals_empty():
+    assert monthly_totals([]) == {}
+
+
+def test_monthly_totals_orders_months_across_year_boundary():
+    rows = [
+        Expense(date(2026, 1, 1), "food", 1),
+        Expense(date(2025, 12, 31), "food", 2),
+        Expense(date(2025, 2, 1), "food", 3),
+    ]
+    assert list(monthly_totals(rows)) == ["2025-02", "2025-12", "2026-01"]
+
+
+def test_monthly_totals_same_month_different_years_are_separate():
+    rows = [
+        Expense(date(2025, 11, 1), "food", 1),
+        Expense(date(2026, 11, 1), "food", 2),
+    ]
+    assert monthly_totals(rows) == {"2025-11": {"food": 1}, "2026-11": {"food": 2}}
+
+
+def test_monthly_totals_month_boundaries():
+    rows = [
+        Expense(date(2026, 10, 31), "food", 1),
+        Expense(date(2026, 11, 1), "food", 10),
+        Expense(date(2026, 11, 30), "food", 100),
+        Expense(date(2026, 12, 1), "food", 1000),
+    ]
+    assert monthly_totals(rows) == {
+        "2026-10": {"food": 1},
+        "2026-11": {"food": 110},
+        "2026-12": {"food": 1000},
+    }
+
+
+def test_monthly_totals_ties_keep_first_seen_order():
+    rows = [
+        Expense(date(2026, 11, 1), "b", 5),
+        Expense(date(2026, 11, 2), "a", 5),
+    ]
+    assert list(monthly_totals(rows)["2026-11"]) == ["b", "a"]
+
+
+def test_monthly_totals_category_order_is_per_month():
+    rows = [
+        Expense(date(2026, 10, 1), "food", 100),
+        Expense(date(2026, 10, 2), "rent", 50),
+        Expense(date(2026, 11, 1), "food", 50),
+        Expense(date(2026, 11, 2), "rent", 100),
+    ]
+    totals = monthly_totals(rows)
+    assert list(totals["2026-10"]) == ["food", "rent"]
+    assert list(totals["2026-11"]) == ["rent", "food"]
+
+
+def test_monthly_totals_zero_and_negative_amounts():
+    rows = [
+        Expense(date(2026, 11, 1), "food", 100),
+        Expense(date(2026, 11, 2), "food", -100),
+        Expense(date(2026, 11, 3), "refund", -5),
+        Expense(date(2026, 11, 4), "misc", 1),
+    ]
+    totals = monthly_totals(rows)["2026-11"]
+    assert totals == {"misc": 1, "food": 0, "refund": -5}
+    assert list(totals) == ["misc", "food", "refund"]
+
+
+def test_monthly_totals_categories_are_case_sensitive():
+    rows = [
+        Expense(date(2026, 11, 1), "food", 1),
+        Expense(date(2026, 11, 2), "Food", 2),
+    ]
+    assert monthly_totals(rows) == {"2026-11": {"Food": 2, "food": 1}}
+
+
+def test_monthly_totals_does_not_mutate_input():
+    rows = [
+        Expense(date(2026, 11, 2), "food", 1),
+        Expense(date(2026, 10, 1), "rent", 2),
+    ]
+    snapshot = list(rows)
+    monthly_totals(rows)
+    assert rows == snapshot
