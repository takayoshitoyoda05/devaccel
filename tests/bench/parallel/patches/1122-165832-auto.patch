diff --git a/tests/test_types/test_IntRange.py b/tests/test_types/test_IntRange.py
index 7950a23..0a41bbe 100644
--- a/tests/test_types/test_IntRange.py
+++ b/tests/test_types/test_IntRange.py
@@ -36,3 +36,31 @@ def test_range_fail(type, value, expect):
         type.convert(value, None, None)
 
     assert expect in exc_info.value.message
+
+
+@pytest.mark.parametrize(
+    ("type", "expect"),
+    [
+        (click.IntRange(min=1), "x>=1"),
+        (click.IntRange(min=1, min_open=True), "x>1"),
+        (click.IntRange(max=5), "x<=5"),
+        (click.IntRange(max=5, max_open=True), "x<5"),
+        (click.IntRange(1, 5), "1<=x<=5"),
+        (click.FloatRange(min=1), "x>=1"),
+        (click.FloatRange(min=1, min_open=True), "x>1"),
+        (click.FloatRange(max=1.5), "x<=1.5"),
+        (click.FloatRange(max=1.5, max_open=True), "x<1.5"),
+    ],
+)
+def test_range_describe(type, expect):
+    assert type._describe_range() == expect
+
+
+def test_range_option_help():
+    @click.command()
+    @click.option("-n", type=click.IntRange(min=1), help="count")
+    def cli(n):
+        pass
+
+    result = click.testing.CliRunner().invoke(cli, ["--help"])
+    assert "x>=1" in result.output
