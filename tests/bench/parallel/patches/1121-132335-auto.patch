+"""Budget status: which categories are over budget or close to it (pure functions).
+
+Reuses ``Budget`` (limits per category, with per-month overrides) and the
+``monthly_totals`` shape from ``core``; nothing is loaded or printed here.
+
+Decisions:
+D1: Limits come from ``Budget.for_month(month)``; the Budget type is not duplicated.
+D2: Status is "over" when actual > limit, "warning" when actual >= limit * warn_percent / 100
+    (reaching the limit exactly is "warning", not "over"), otherwise "ok".
+D3: ``warn_percent`` is an int in 1..100. bool / float / str / None -> TypeError;
+    0, negatives and values above 100 -> ValueError. Integer arithmetic only (no float error).
+D4: A limit of 0 is allowed: any spending > 0 is "over"; actual 0 with limit 0 is "ok".
+D5: Categories with a limit but no spending that month are reported as actual 0 ("ok").
+    Categories with spending but no limit are not reported (no budget to compare to).
+D6: Negative totals (refunds exceeding spending) are "ok"; ``remaining`` may exceed the limit.
+D7: Only months present in ``totals`` are evaluated; missing months are skipped, not filled.
+D8: Order: month ascending, then status (over, warning, ok), then ``remaining`` ascending
+    (largest overage first), then category name.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Literal
+
+from kakeibo.core import Budget
+
+Status = Literal["over", "warning", "ok"]
+
+_SEVERITY: dict[str, int] = {"over": 0, "warning": 1, "ok": 2}
+
+
+@dataclass(frozen=True)
+class BudgetStatus:
+    month: str
+    category: str
+    limit: int
+    actual: int
+    status: Status
+
+    @property
+    def remaining(self) -> int:
+        """limit - actual; negative when over budget."""
+        return self.limit - self.actual
+
+
+def _check_percent(warn_percent: object) -> int:
+    if isinstance(warn_percent, bool) or not isinstance(warn_percent, int):
+        raise TypeError(f"warn_percent は int である必要があります: {warn_percent!r}")
+    if not 1 <= warn_percent <= 100:
+        raise ValueError(
+            f"warn_percent は 1〜100 である必要があります: {warn_percent!r}"
+        )
+    return warn_percent
+
+
+def classify(actual: int, limit: int, warn_percent: int = 80) -> Status:
+    """Status of one category's spending against its limit (see D2-D6)."""
+    pct = _check_percent(warn_percent)
+    if actual > limit:
+        return "over"
+    if actual > 0 and actual * 100 >= limit * pct:
+        return "warning"
+    return "ok"
+
+
+def budget_statuses(
+    totals: dict[str, dict[str, int]], budget: Budget, warn_percent: int = 80
+) -> list[BudgetStatus]:
+    """Status for every budgeted category in every month of ``totals``."""
+    pct = _check_percent(warn_percent)
+    out: list[BudgetStatus] = []
+    for month, cats in totals.items():
+        for cat, limit in budget.for_month(month).items():
+            actual = cats.get(cat, 0)
+            out.append(
+                BudgetStatus(month, cat, limit, actual, classify(actual, limit, pct))
+            )
+    out.sort(key=lambda s: (s.month, _SEVERITY[s.status], s.remaining, s.category))
+    return out
+
+
+def alerts(
+    totals: dict[str, dict[str, int]], budget: Budget, warn_percent: int = 80
+) -> list[BudgetStatus]:
+    """Only the "over" and "warning" entries of ``budget_statuses``."""
+    return [
+        s for s in budget_statuses(totals, budget, warn_percent) if s.status != "ok"
+    ]
diff --git a/tests/test_budget_status.py b/tests/test_budget_status.py
new file mode 100644
index 0000000..c27b709
--- /dev/null
+++ b/tests/test_budget_status.py
@@ -0,0 +1,73 @@
+import pytest
+
+from kakeibo.budget import BudgetStatus, alerts, budget_statuses, classify
+from kakeibo.core import Budget
+
+B = Budget(default={"food": 1000, "fun": 500}, months={"2026-02": {"food": 2000}})
+
+
+def test_classify_boundaries():
+    assert classify(799, 1000) == "ok"
+    assert classify(800, 1000) == "warning"
+    assert classify(1000, 1000) == "warning"  # exactly at limit is not over
+    assert classify(1001, 1000) == "over"
+
+
+def test_classify_custom_percent():
+    assert classify(500, 1000, 50) == "warning"
+    assert classify(1000, 1000, 100) == "warning"
+    assert classify(999, 1000, 100) == "ok"
+
+
+def test_zero_limit_and_negative_actual():
+    assert classify(0, 0) == "ok"
+    assert classify(1, 0) == "over"
+    assert classify(-300, 1000) == "ok"
+
+
+@pytest.mark.parametrize("bad", [True, 80.0, "80", None])
+def test_percent_type_error(bad):
+    with pytest.raises(TypeError, match="warn_percent"):
+        classify(1, 1000, bad)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad", [0, -1, 101])
+def test_percent_value_error(bad):
+    with pytest.raises(ValueError, match="warn_percent"):
+        classify(1, 1000, bad)
+    with pytest.raises(ValueError, match="warn_percent"):
+        budget_statuses({}, B, bad)
+
+
+def test_unspent_category_is_ok_and_unbudgeted_is_skipped():
+    res = budget_statuses({"2026-01": {"food": 100, "rent": 90000}}, B)
+    assert [(s.category, s.actual, s.status) for s in res] == [
+        ("fun", 0, "ok"),  # remaining 500 < food's 900
+        ("food", 100, "ok"),
+    ]
+
+
+def test_month_override_and_order():
+    totals = {
+        "2026-02": {"food": 1900, "fun": 600},
+        "2026-01": {"food": 1200, "fun": 400},
+    }
+    res = budget_statuses(totals, B)
+    assert [(s.month, s.category, s.status) for s in res] == [
+        ("2026-01", "food", "over"),
+        ("2026-01", "fun", "warning"),
+        ("2026-02", "fun", "over"),
+        ("2026-02", "food", "warning"),  # limit 2000 from the month override
+    ]
+
+
+def test_missing_months_not_filled():
+    assert budget_statuses({}, B) == []
+    months = {s.month for s in budget_statuses({"2026-01": {}, "2026-03": {}}, B)}
+    assert months == {"2026-01", "2026-03"}
+
+
+def test_alerts_and_remaining():
+    res = alerts({"2026-01": {"food": 1200, "fun": 100}}, B)
+    assert res == [BudgetStatus("2026-01", "food", 1000, 1200, "over")]
+    assert res[0].remaining == -200
