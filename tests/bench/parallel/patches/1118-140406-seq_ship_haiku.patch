diff --git a/src/kakeibo/bankimport.py b/src/kakeibo/bankimport.py
new file mode 100644
index 0000000..b60f036
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,113 @@
+"""他行の CSV を取り込む(標準ライブラリのみ)。"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"(-?)[¥￥]?([0-9][0-9,]*)円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    """`-¥1,234円` のような表記を整数にする。形式が違えば ValueError。"""
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    value = int(m.group(2).replace(",", ""))
+    return -value if m.group(1) else value
+
+
+def parse_date(s: str) -> date:
+    """`YYYY/M/D` または `YYYY-M-D` を date にする。それ以外は ValueError。"""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """1 行目がヘッダーの CSV 文字列を明細に変換する。
+
+    戻り値は (取り込めた明細, [(行番号, フィールド名), ...])。
+    """
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    try:
+        header = next(reader)
+    except StopIteration:
+        raise ValueError("ヘッダー行がありません") from None
+    header_line = reader.line_num
+
+    index: dict[str, int] = {}
+    for field, column in mapping.items():
+        if column not in header:
+            raise ValueError(f"列 {column!r} がヘッダーにありません")
+        index[field] = header.index(column)
+
+    rows: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    prev_end = header_line
+    for record in reader:
+        start = prev_end + 1
+        prev_end = reader.line_num
+        if all(not f.strip() for f in record):
+            continue  # 空行(空白だけの行を含む)は読み飛ばす
+
+        row_errors: list[tuple[int, str]] = []
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(_field(record, index, "date"))
+        except ValueError:
+            row_errors.append((start, "date"))
+        try:
+            amount = parse_amount(_field(record, index, "amount"))
+        except ValueError:
+            row_errors.append((start, "amount"))
+        category = _field(record, index, "category").strip()
+        if category == "":
+            row_errors.append((start, "category"))
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        if category_map is not None and category in category_map:
+            category = category_map[category]
+        assert day is not None and amount is not None
+        rows.append(
+            Expense(
+                day=day,
+                category=category,
+                amount=amount,
+                memo=_field(record, index, "memo").strip(),
+            )
+        )
+    return rows, errors
+
+
+def _field(record: list[str], index: dict[str, int], field: str) -> str:
+    """列が無い・足りない場合は空文字列を返す。"""
+    if field not in index:
+        return ""
+    i = index[field]
+    return record[i] if i < len(record) else ""
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
new file mode 100644
index 0000000..18eb3ed
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,91 @@
+"""前月比レポート(標準ライブラリのみ)。"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def _month_of(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+
+    prev_by_cat: dict[str, list[int]] = {}
+    curr_by_cat: dict[str, list[int]] = {}
+    for e in rows:
+        m = _month_of(e)
+        if m == prev_month:
+            prev_by_cat.setdefault(e.category, []).append(e.amount)
+        elif m == curr_month:
+            curr_by_cat.setdefault(e.category, []).append(e.amount)
+
+    out: list[DiffRow] = []
+    for cat in set(prev_by_cat) | set(curr_by_cat):
+        prev_items = prev_by_cat.get(cat, [])
+        curr_items = curr_by_cat.get(cat, [])
+        prev = sum(prev_items)
+        curr = sum(curr_items)
+        delta = curr - prev
+        pct = None if prev == 0 else round(delta / prev * 100, 1)
+        if not prev_items:
+            status = "new"
+        elif not curr_items:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+
+    out.sort(key=lambda r: (-abs(r.delta), r.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError("n は 0 以上である必要があります")
+    return [d for d in diffs if d.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for d in diffs:
+        pct = "-" if d.pct is None else f"{d.pct + 0.0:+.1f}%"  # +0.0 で -0.0 を避ける
+        lines.append(f"{d.category}\t{d.prev}\t{d.curr}\t{d.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month_of(e) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には明細のある月が 2 つ以上必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..1f9fc70
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,173 @@
+"""検索クエリ(標準ライブラリのみ)。
+
+文法(優先順位は低い順に OR < AND < NOT):
+    or_expr  := and_expr ("OR" and_expr)*
+    and_expr := not_expr (["AND"] not_expr)*
+    not_expr := "NOT" not_expr | primary
+    primary  := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+
+from kakeibo.core import Expense
+
+
+class QueryError(ValueError):
+    """検索クエリが不正なとき。"""
+
+
+Token = tuple[str, str]
+Pred = Callable[[Expense], bool]
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    tokens: list[Token] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError("閉じていない引用符があります")
+            body = q[i + 1 : end]
+            if body == "":
+                raise QueryError("空の引用符は使えません")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            j = i
+            while j < n and not q[j].isspace() and q[j] not in '()"':
+                j += 1
+            word = q[i:j]
+            i = j
+            if word == "AND":
+                tokens.append(("AND", "AND"))
+            elif word == "OR":
+                tokens.append(("OR", "OR"))
+            elif word == "NOT":
+                tokens.append(("NOT", "NOT"))
+            elif word.startswith("cat:"):
+                value = word[len("cat:") :]
+                if value == "":
+                    raise QueryError("cat: の後ろに値がありません")
+                tokens.append(("CAT", value))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self.tokens = tokens
+        self.pos = 0
+
+    def _peek(self) -> str | None:
+        return self.tokens[self.pos][0] if self.pos < len(self.tokens) else None
+
+    def _take(self) -> Token:
+        tok = self.tokens[self.pos]
+        self.pos += 1
+        return tok
+
+    def parse(self) -> Pred:
+        if not self.tokens:
+            raise QueryError("検索条件がありません")
+        pred = self._or_expr()
+        if self.pos != len(self.tokens):
+            raise QueryError("構文が不正です")
+        return pred
+
+    def _or_expr(self) -> Pred:
+        pred = self._and_expr()
+        while self._peek() == "OR":
+            self._take()
+            right = self._and_expr()
+            pred = _or(pred, right)
+        return pred
+
+    def _and_expr(self) -> Pred:
+        pred = self._not_expr()
+        while True:
+            kind = self._peek()
+            if kind == "AND":
+                self._take()
+                pred = _and(pred, self._not_expr())
+            elif kind in ("NOT", "TERM", "CAT", "LPAREN"):
+                pred = _and(pred, self._not_expr())
+            else:
+                return pred
+
+    def _not_expr(self) -> Pred:
+        if self._peek() == "NOT":
+            self._take()
+            return _not(self._not_expr())
+        return self._primary()
+
+    def _primary(self) -> Pred:
+        kind = self._peek()
+        if kind == "TERM":
+            return _term(self._take()[1])
+        if kind == "CAT":
+            return _cat(self._take()[1])
+        if kind == "LPAREN":
+            self._take()
+            pred = self._or_expr()
+            if self._peek() != "RPAREN":
+                raise QueryError("括弧が閉じていません")
+            self._take()
+            return pred
+        raise QueryError("項がありません")
+
+
+def _term(value: str) -> Pred:
+    needle = value.casefold()
+
+    def pred(e: Expense) -> bool:
+        return needle in e.memo.casefold() or needle in e.category.casefold()
+
+    return pred
+
+
+def _cat(value: str) -> Pred:
+    target = value.casefold()
+
+    def pred(e: Expense) -> bool:
+        return e.category.casefold() == target
+
+    return pred
+
+
+def _not(p: Pred) -> Pred:
+    return lambda e: not p(e)
+
+
+def _and(a: Pred, b: Pred) -> Pred:
+    return lambda e: a(e) and b(e)
+
+
+def _or(a: Pred, b: Pred) -> Pred:
+    return lambda e: a(e) or b(e)
+
+
+def _compile(q: str) -> Pred:
+    return _Parser(tokenize(q)).parse()
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _compile(q)(e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    pred = _compile(q)
+    return [e for e in rows if pred(e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..782ed63
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,71 @@
+"""定期支出の検出(標準ライブラリのみ)。"""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """翌月の同じ日を返す。翌月に同じ日が無ければ翌月の末日。"""
+    if d.month == 12:
+        year, month = d.year + 1, 1
+    else:
+        year, month = d.year, d.month + 1
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    """(category, amount) ごとに毎月ほぼ同じ日に現れる明細を定期支出として返す。"""
+    if min_count < 2:
+        raise ValueError("min_count は 2 以上である必要があります")
+    if tolerance < 0:
+        raise ValueError("tolerance は 0 以上である必要があります")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    result: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        days = sorted(day_set)
+        runs: list[list[date]] = []
+        current: list[date] = []
+        for d in days:
+            if current and not _connected(current[-1], d, tolerance):
+                runs.append(current)
+                current = []
+            current.append(d)
+        if current:
+            runs.append(current)
+        for run in runs:
+            if len(run) >= min_count:
+                result.append(
+                    Recurring(
+                        category=category,
+                        amount=amount,
+                        days=tuple(run),
+                        next_expected=add_month(run[-1]),
+                    )
+                )
+
+    result.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return result
+
+
+def _connected(prev: date, nxt: date, tolerance: int) -> bool:
+    return abs((nxt - add_month(prev)).days) <= tolerance
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..8ae097f
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,131 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+
+@pytest.mark.parametrize(
+    "s, expected",
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥5", 5),
+        ("1,000", 1000),
+    ],
+)
+def test_parse_amount_accepts(s, expected):
+    assert parse_amount(s) == expected
+
+
+@pytest.mark.parametrize(
+    "s",
+    ["", "円", "12.5", "1 200", "--5", "¥-5", "１２３", ",", "-", "5円円"],
+)
+def test_parse_amount_rejects(s):
+    with pytest.raises(ValueError):
+        parse_amount(s)
+
+
+@pytest.mark.parametrize(
+    "s, expected",
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/12/31 ", date(2026, 12, 31)),
+    ],
+)
+def test_parse_date_accepts(s, expected):
+    assert parse_date(s) == expected
+
+
+@pytest.mark.parametrize(
+    "s",
+    ["2026/1-5", "26/1/5", "2026/02/30", "2026.1.5", "2026/13/1", "", "abc"],
+)
+def test_parse_date_rejects(s):
+    with pytest.raises(ValueError):
+        parse_date(s)
+
+
+BANK_CSV = (
+    "利用日,分類,利用金額,利用店名,備考\n"
+    '2026/11/1,食費,"1,200","ランチ, 本店",x\n'
+    "2026-11-02,交通,-300,駅,\n"
+)
+
+
+def test_default_mapping_imports_rows():
+    rows, errors = import_rows(BANK_CSV)
+    assert errors == []
+    assert rows == [
+        Expense(date(2026, 11, 1), "食費", 1200, "ランチ, 本店"),
+        Expense(date(2026, 11, 2), "交通", -300, "駅"),
+    ]
+
+
+def test_category_map_replaces_category():
+    rows, _ = import_rows(BANK_CSV, category_map={"食費": "food"})
+    assert [r.category for r in rows] == ["food", "交通"]
+
+
+def test_custom_mapping_and_missing_memo():
+    text = "d,c,a\n2026-01-01, food ,100\n"
+    rows, errors = import_rows(
+        text, mapping={"date": "d", "category": "c", "amount": "a"}
+    )
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 1), "food", 100, "")]
+
+
+def test_error_fields_collected_in_order_per_row():
+    text = "利用日,分類,利用金額,利用店名\nbad,,xyz,m\n2026/1/2,food,10,m\n"
+    rows, errors = import_rows(text)
+    assert errors == [(2, "date"), (2, "amount"), (2, "category")]
+    assert rows == [Expense(date(2026, 1, 2), "food", 10, "m")]
+
+
+def test_missing_trailing_columns_are_empty_strings():
+    text = "利用日,分類,利用金額,利用店名\n2026/1/2,food\n"
+    rows, errors = import_rows(text)
+    assert errors == [(2, "amount")]
+    assert rows == []
+
+
+def test_blank_lines_counted_but_skipped():
+    text = "利用日,分類,利用金額\n\n2026/1/2,food,10\n\n2026/1/3,bad,xx\n"
+    mapping = {"date": "利用日", "category": "分類", "amount": "利用金額"}
+    rows, errors = import_rows(text, mapping=mapping)
+    assert [r.day for r in rows] == [date(2026, 1, 2)]
+    assert errors == [(5, "amount")]
+
+
+def test_physical_line_number_with_quoted_newline():
+    text = (
+        '利用日,分類,利用金額,利用店名\n2026/1/2,food,10,"a\nb"\n2026/1/x,food,10,m\n'
+    )
+    rows, errors = import_rows(text)
+    assert [r.memo for r in rows] == ["a\nb"]
+    assert errors == [(4, "date")]
+
+
+def test_mapping_column_missing_from_header_raises():
+    with pytest.raises(ValueError):
+        import_rows("利用日,分類\n2026/1/1,food\n")
+
+
+def test_mapping_missing_required_key_raises():
+    with pytest.raises(ValueError):
+        import_rows(BANK_CSV, mapping={"date": "利用日", "amount": "利用金額"})
+
+
+def test_default_mapping_constant():
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..c2b0ee2
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,125 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def E(d: str, cat: str, amount: int) -> Expense:
+    return Expense(date.fromisoformat(d), cat, amount, "")
+
+
+ROWS = [
+    E("2026-01-05", "food", 1000),
+    E("2026-01-20", "food", 500),
+    E("2026-01-10", "rent", 80000),
+    E("2026-01-11", "fun", 300),
+    E("2026-02-03", "food", 1800),
+    E("2026-02-10", "rent", 80000),
+    E("2026-02-11", "travel", 0),
+    E("2026-02-12", "gift", 2000),
+]
+
+
+def test_month_diff_statuses_and_pct():
+    got = {d.category: d for d in month_diff(ROWS, "2026-01", "2026-02")}
+    assert got["food"] == DiffRow("food", 1500, 1800, 300, 20.0, "up")
+    assert got["rent"] == DiffRow("rent", 80000, 80000, 0, 0.0, "same")
+    assert got["fun"] == DiffRow("fun", 300, 0, -300, -100.0, "gone")
+    assert got["gift"] == DiffRow("gift", 0, 2000, 2000, None, "new")
+    assert got["travel"].status == "new"
+    assert got["travel"].pct is None
+
+
+def test_same_is_decided_by_presence_not_total():
+    rows = [E("2026-01-01", "x", 0), E("2026-02-01", "x", 0)]
+    [d] = month_diff(rows, "2026-01", "2026-02")
+    assert d.status == "same"
+
+
+def test_down_status():
+    rows = [E("2026-01-01", "x", 200), E("2026-02-01", "x", 100)]
+    [d] = month_diff(rows, "2026-01", "2026-02")
+    assert (d.delta, d.pct, d.status) == (-100, -50.0, "down")
+
+
+def test_order_by_abs_delta_then_category():
+    rows = [
+        E("2026-01-01", "b", 100),
+        E("2026-02-01", "b", 200),  # delta 100
+        E("2026-01-01", "a", 500),
+        E("2026-02-01", "a", 400),  # delta -100
+        E("2026-02-01", "c", 900),  # delta 900
+    ]
+    assert [d.category for d in month_diff(rows, "2026-01", "2026-02")] == [
+        "c",
+        "a",
+        "b",
+    ]
+
+
+def test_invalid_month_raises():
+    for bad in ("2026-1", "2026/01", "2026-13", "2026-00"):
+        with pytest.raises(ValueError):
+            month_diff(ROWS, bad, "2026-02")
+
+
+def test_top_movers_skips_same_and_limits():
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    cats = [d.category for d in top_movers(diffs, n=3)]
+    assert cats == ["gift", "food", "fun"]
+    assert all(d.status != "same" for d in top_movers(diffs, n=99))
+    assert top_movers(diffs, n=0) == []
+    with pytest.raises(ValueError):
+        top_movers(diffs, n=-1)
+
+
+def test_render_diff_format():
+    diffs = [
+        DiffRow("food", 1500, 1800, 300, 20.0, "up"),
+        DiffRow("fun", 300, 0, -300, -100.0, "gone"),
+        DiffRow("rent", 80000, 80000, 0, 0.0, "same"),
+        DiffRow("gift", 0, 2000, 2000, None, "new"),
+    ]
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "food\t1500\t1800\t+300\t+20.0%\n"
+        "fun\t300\t0\t-300\t-100.0%\n"
+        "rent\t80000\t80000\t+0\t+0.0%\n"
+        "gift\t0\t2000\t+2000\t-"
+    )
+
+
+def test_render_diff_empty_is_header_only():
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_render_diff_negative_zero_pct_shows_plus():
+    d = DiffRow("x", 10000, 9999, -1, -0.0, "down")
+    assert render_diff([d]).endswith("\t-1\t+0.0%")
+
+
+def test_available_months_sorted_unique():
+    assert available_months(ROWS) == ["2026-01", "2026-02"]
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months():
+    rows = ROWS + [E("2026-03-01", "food", 10)]
+    assert {d.category for d in latest_diff(rows)} == {"food", "rent", "gift", "travel"}
+    assert latest_diff(rows)[0].category == "rent"  # 最大の変動(-80000)
+
+
+def test_latest_diff_needs_two_months():
+    with pytest.raises(ValueError):
+        latest_diff([E("2026-01-01", "x", 1)])
+    with pytest.raises(ValueError):
+        latest_diff([])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..2973ed4
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,102 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+ROWS = [
+    Expense(date(2026, 1, 1), "food", 1200, "Lunch at Cafe"),
+    Expense(date(2026, 1, 2), "rent", 80000, ""),
+    Expense(date(2026, 1, 3), "Food", 800, "coffee"),
+    Expense(date(2026, 1, 4), "transport", 300, "lunch pass"),
+]
+
+
+def test_tokenize_basic_kinds():
+    assert tokenize('a (b) "c d" AND OR NOT cat:food and') == [
+        ("TERM", "a"),
+        ("LPAREN", "("),
+        ("TERM", "b"),
+        ("RPAREN", ")"),
+        ("TERM", "c d"),
+        ("AND", "AND"),
+        ("OR", "OR"),
+        ("NOT", "NOT"),
+        ("CAT", "food"),
+        ("TERM", "and"),
+    ]
+
+
+def test_tokenize_whitespace_only_is_empty():
+    assert tokenize("  \t ") == []
+
+
+@pytest.mark.parametrize("q", ['"abc', '""', "cat:"])
+def test_tokenize_errors(q):
+    with pytest.raises(QueryError):
+        tokenize(q)
+
+
+def test_term_is_substring_of_memo_or_category_casefolded():
+    assert [e.memo for e in filter_rows("LUNCH", ROWS)] == [
+        "Lunch at Cafe",
+        "lunch pass",
+    ]
+    assert [e.category for e in filter_rows("ood", ROWS)] == ["food", "Food"]
+
+
+def test_cat_is_exact_casefolded_match():
+    assert [e.amount for e in filter_rows("cat:food", ROWS)] == [1200, 800]
+    assert filter_rows("cat:foo", ROWS) == []
+
+
+def test_implicit_and_and_explicit_and():
+    assert [e.amount for e in filter_rows("cat:food coffee", ROWS)] == [800]
+    assert [e.amount for e in filter_rows("cat:food AND coffee", ROWS)] == [800]
+
+
+def test_or_and_precedence_with_not():
+    # NOT binds tighter than AND, AND tighter than OR
+    assert [e.amount for e in filter_rows("rent OR coffee", ROWS)] == [80000, 800]
+    assert [e.amount for e in filter_rows("NOT cat:food lunch", ROWS)] == [300]
+    assert [e.amount for e in filter_rows("cat:food OR rent coffee", ROWS)] == [
+        1200,
+        800,
+    ]
+
+
+def test_parentheses_override_precedence():
+    assert [e.amount for e in filter_rows("(cat:food OR rent) coffee", ROWS)] == [800]
+
+
+def test_not_chain_and_quoted_term_with_spaces():
+    assert [e.amount for e in filter_rows("NOT NOT rent", ROWS)] == [80000]
+    assert [e.amount for e in filter_rows('"lunch pass"', ROWS)] == [300]
+
+
+def test_matches_single_row():
+    assert matches("cat:transport", ROWS[3]) is True
+    assert matches("cat:transport", ROWS[0]) is False
+
+
+def test_filter_keeps_input_order():
+    assert [e.amount for e in filter_rows("cat:food OR transport", ROWS)] == [
+        1200,
+        800,
+        300,
+    ]
+
+
+@pytest.mark.parametrize(
+    "q",
+    ["", "   ", "()", "(a", "a)", "a OR", "AND a", "NOT", "a (b", "a ) b", '"x" )'],
+)
+def test_grammar_errors(q):
+    with pytest.raises(QueryError):
+        filter_rows(q, ROWS)
+
+
+def test_invalid_query_raises_even_with_no_rows():
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..38cf868
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,101 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import add_month, find_recurring
+
+
+def E(d: str, cat: str = "subs", amount: int = 980, memo: str = "") -> Expense:
+    return Expense(date.fromisoformat(d), cat, amount, memo)
+
+
+def test_add_month_plain():
+    assert add_month(date(2026, 11, 5)) == date(2026, 12, 5)
+
+
+def test_add_month_clamps_to_end_of_month():
+    assert add_month(date(2026, 1, 31)) == date(2026, 2, 28)
+    assert add_month(date(2024, 1, 31)) == date(2024, 2, 29)
+
+
+def test_add_month_wraps_year():
+    assert add_month(date(2026, 12, 15)) == date(2027, 1, 15)
+
+
+def test_find_recurring_monthly_with_tolerance():
+    rows = [E("2026-01-10"), E("2026-02-12"), E("2026-03-09"), E("2026-04-10")]
+    [r] = find_recurring(rows)
+    assert r.category == "subs"
+    assert r.amount == 980
+    assert r.days == (
+        date(2026, 1, 10),
+        date(2026, 2, 12),
+        date(2026, 3, 9),
+        date(2026, 4, 10),
+    )
+    assert r.next_expected == date(2026, 5, 10)
+
+
+def test_find_recurring_splits_on_gap():
+    rows = [
+        E("2026-01-10"),
+        E("2026-02-10"),
+        E("2026-03-10"),
+        E("2026-06-10"),
+        E("2026-07-10"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert len(result[0].days) == 3
+    assert result[0].next_expected == date(2026, 4, 10)
+
+
+def test_find_recurring_below_min_count_is_empty():
+    assert find_recurring([E("2026-01-10"), E("2026-02-10")]) == []
+
+
+def test_find_recurring_ignores_memo_and_duplicate_days():
+    rows = [
+        E("2026-01-10", memo="a"),
+        E("2026-01-10", memo="b"),
+        E("2026-02-10", memo="c"),
+        E("2026-03-10"),
+    ]
+    [r] = find_recurring(rows)
+    assert r.days == (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10))
+
+
+def test_find_recurring_groups_by_category_and_amount():
+    rows = [
+        E("2026-01-10", amount=980),
+        E("2026-02-10", amount=980),
+        E("2026-03-10", amount=980),
+        E("2026-01-05", amount=500),
+        E("2026-02-05", amount=500),
+        E("2026-03-05", amount=500),
+    ]
+    result = find_recurring(rows)
+    assert [(r.amount, r.days[0]) for r in result] == [
+        (500, date(2026, 1, 5)),
+        (980, date(2026, 1, 10)),
+    ]
+
+
+def test_find_recurring_sorted_by_category_amount_first_day():
+    rows = []
+    for cat in ("b", "a"):
+        for day in ("2026-01-01", "2026-02-01", "2026-03-01"):
+            rows.append(E(day, cat=cat, amount=100))
+    assert [r.category for r in find_recurring(rows)] == ["a", "b"]
+
+
+def test_find_recurring_rejects_bad_params():
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_find_recurring_empty_input():
+    assert find_recurring([]) == []
