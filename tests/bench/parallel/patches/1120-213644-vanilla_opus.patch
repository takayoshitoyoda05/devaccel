+def test_header_beyond_search_rows():
+    text = "x\n" * 3 + "日付,金額\n2026-11-01,1\n"
+    with pytest.raises(HeaderError):
+        import_statement(text, replace(GENERIC, header_search_rows=3))
+    assert import_statement(text, replace(GENERIC, header_search_rows=4)).ok
+
+
+def test_empty_text():
+    with pytest.raises(HeaderError):
+        import_statement("")
