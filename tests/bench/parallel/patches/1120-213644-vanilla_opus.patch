+def test_header_not_found():
+    with pytest.raises(HeaderError) as ei:
+        import_statement("foo,bar\n1,2\n")
+    assert any("日付" in m for m in ei.value.missing)
+    assert any("金額" in m for m in ei.value.missing)
+    assert ei.value.first_row == ["foo", "bar"]
+
