+def test_custom_profile_negative_sign_and_category():
+    profile = ImportProfile(
+        name="mybank",
+        date_columns=("Posted",),
+        amount_columns=("Value",),
+        memo_columns=("Payee",),
+        category_columns=("Cat",),
+        date_formats=("%m/%d/%Y",),
+        expense_sign="negative",
+        default_category="misc",
+    )
+    text = (
+        "Posted,Payee,Value,Cat\n"
+        "11/01/2026,Shop,-1500,food\n"
+        "11/02/2026,Salary,300000,\n"
+        "11/03/2026,Bus,-220,\n"
+    )
+    r = import_statement(text, profile)
+    assert r.expenses == (
+        Expense(date(2026, 11, 1), "food", 1500, "Shop"),
+        Expense(date(2026, 11, 3), "misc", 220, "Bus"),
+    )
+    assert [s.line for s in r.skipped] == [3]
