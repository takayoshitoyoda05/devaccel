+def test_cp932_bytes_end_to_end():
+    raw = "日付,内容,金額\n2026/11/01,スーパー,\\1,980\n".encode("cp932")
+    # 引用符なしのカンマ入り金額は列ずれになる → 列数エラーとして報告される
+    r = import_statement(decode_csv_bytes(raw))
+    assert [e.line for e in r.errors] == [2]
+    raw = '日付,内容,金額\n2026/11/01,スーパー,"\\1,980"\n'.encode("cp932")
+    r = import_statement(decode_csv_bytes(raw))
+    assert r.expenses == (Expense(date(2026, 11, 1), "未分類", 1980, "スーパー"),)
