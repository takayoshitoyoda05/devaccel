@@ -0,0 +1,97 @@
+"""Month-over-month category comparison (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    rate: float | None
+    status: str
+
+
+def _parse_month(month: str) -> tuple[int, int]:
+    match = _MONTH_RE.fullmatch(str(month))
+    if match is None:
+        raise ValueError(f"month は YYYY-MM 形式である必要があります: {month!r}")
+    return int(month[:4]), int(month[5:])
+
+
+def _prev_month(year: int, mon: int) -> str:
+    if mon == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mon - 1:02d}"
+
+
+def _totals(rows: list[Expense], month: str) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for e in rows:
+        if type(e.amount) is not int:  # rejects bool too
+            raise ValueError(f"amount は整数である必要があります: {e.amount!r}")
+        if f"{e.day.year:04d}-{e.day.month:02d}" == month:
+            out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def _status(previous: int, current: int, delta: int) -> str:
+    if previous == 0 and current > 0:
+        return "新規"
+    if current == 0 and previous > 0:
+        return "なし"
+    if delta > 0:
+        return "増加"
+    if delta < 0:
+        return "減少"
+    return "変化なし"
+
+
+def compare_months(rows: list[Expense], month: str) -> list[CategoryChange]:
+    year, mon = _parse_month(month)
+    prev = _prev_month(year, mon)
+    prev_totals = _totals(rows, prev)
+    cur_totals = _totals(rows, month)
+
+    changes: list[CategoryChange] = []
+    for cat in set(prev_totals) | set(cur_totals):
+        previous = prev_totals.get(cat, 0)
+        current = cur_totals.get(cat, 0)
+        if previous == 0 and current == 0:
+            continue
+        delta = current - previous
+        rate = None if previous == 0 else delta / previous
+        changes.append(
+            CategoryChange(
+                category=cat,
+                previous=previous,
+                current=current,
+                delta=delta,
+                rate=rate,
+                status=_status(previous, current, delta),
+            )
+        )
+    changes.sort(key=lambda c: (-abs(c.delta), c.category))
+    return changes
+
+
+def format_report(changes: list[CategoryChange], month: str) -> str:
+    _parse_month(month)
+    lines = [f"{month} 前月比"]
+    if not changes:
+        lines.append("変化なし")
+        return "\n".join(lines)
+    for c in changes:
+        pct = "-" if c.rate is None else f"{c.rate * 100:+.1f}%"
+        lines.append(
+            f"{c.category} {c.previous:,}→{c.current:,} ({c.delta:+,} 円, {pct})"
+        )
+    return "\n".join(lines)
