+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import ImportResult, RowError, import_bank_csv
+from kakeibo.core import Expense
+
+# --- 仕様の例の表 (E2-*) ---
+
+
+@pytest.mark.parametrize(
+    ("text", "expected_expenses", "expected_errors"),
+    [
+        pytest.param(
+            '利用日,ご利用店名,利用金額\n2026/1/5,ABC,"1,234円"\n',
+            [Expense(date(2026, 1, 5), "未分類", 1234, "ABC")],
+            [],
+            id="E2-1",
+        ),
+        pytest.param(
+            "日付,出金額,入金額\n2026-01-05,,1000\n",
+            [],
+            [],
+            id="E2-2",
+        ),
+    ],
+)
+def test_spec_examples(
+    text: str, expected_expenses: list[Expense], expected_errors: list[RowError]
+) -> None:
+    result = import_bank_csv(text)
+    assert result == ImportResult(expenses=expected_expenses, errors=expected_errors)
+
+
+def test_E2_3_two_errors_on_same_line() -> None:
+    """E2-3: 日付も金額も不正な行は RowError が 2 件、同じ line。"""
+    result = import_bank_csv("日付,金額\nxx,abc\n")
+    assert result.expenses == []
+    assert [(e.line, e.column, e.value) for e in result.errors] == [
+        (2, "日付", "xx"),
+        (2, "金額", "abc"),
+    ]
+
+
+# --- 規則に沿った端のケース ---
+
+
+@pytest.mark.parametrize(
+    ("raw", "amount"),
+    [
+        pytest.param("-300", -300, id="R4-minus"),
+        pytest.param("−300", -300, id="R4-unicode-minus"),
+        pytest.param("△500", -500, id="R4-triangle"),
+        pytest.param("▲500", -500, id="R4-black-triangle"),
+        pytest.param("(500)", -500, id="R4-parens"),
+        pytest.param("500-", -500, id="R4-trailing-minus"),
+        pytest.param("￥1,000", 1000, id="R4-fullwidth-yen"),
+        pytest.param("1,000 JPY", 1000, id="R4-jpy"),
+    ],
+)
+def test_amount_forms(raw: str, amount: int) -> None:
+    result = import_bank_csv(f'日付,金額\n2026-01-05,"{raw}"\n')
+    assert result.errors == []
+    assert [e.amount for e in result.expenses] == [amount]
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        pytest.param("1.5", id="R4-decimal"),
+        pytest.param("", id="R4-empty"),
+        pytest.param("-", id="R4-dash-only"),
+        pytest.param("abc", id="R4-not-number"),
+    ],
+)
+def test_amount_invalid_is_row_error(raw: str) -> None:
+    result = import_bank_csv(f'日付,金額\n2026-01-05,"{raw}"\n')
+    assert result.expenses == []
+    assert [(e.line, e.column, e.value) for e in result.errors] == [(2, "金額", raw)]
+
+
+@pytest.mark.parametrize(
+    ("raw", "day"),
+    [
+        pytest.param("2026-01-05", date(2026, 1, 5), id="R3-dash"),
+        pytest.param("2026/1/5", date(2026, 1, 5), id="R3-slash"),
+        pytest.param("2026.1.5", date(2026, 1, 5), id="R3-dot"),
+        pytest.param("2026年1月5日", date(2026, 1, 5), id="R3-kanji"),
+        pytest.param("２０２６／１／５", date(2026, 1, 5), id="R3-fullwidth"),
+        pytest.param("2026/1/5 12:34", date(2026, 1, 5), id="R3-time-dropped"),
+    ],
+)
+def test_date_forms(raw: str, day: date) -> None:
+    result = import_bank_csv(f"日付,金額\n{raw},100\n")
+    assert result.errors == []
+    assert [e.day for e in result.expenses] == [day]
+
+
+def test_nonexistent_date_is_error() -> None:
+    result = import_bank_csv("日付,金額\n2026/2/30,100\n")
+    assert result.expenses == []
+    assert [(e.line, e.column) for e in result.errors] == [(2, "日付")]
+
+
+def test_bom_crlf_and_tab_delimiter() -> None:
+    text = "﻿日付\t金額\r\n2026-01-05\t100\r\n"
+    result = import_bank_csv(text)
+    assert result.errors == []
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+def test_split_columns_withdrawal_positive_deposit_skipped_and_invalid_reported() -> (
+    None
+):
+    text = "日付,出金額,入金額\n2026-01-05,300,\n2026-01-06,,500\n2026-01-07,300,500\n"
+    result = import_bank_csv(text)
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 300, "")]
+    assert [(e.line, e.column) for e in result.errors] == [(4, "入金額")]
+
+
+def test_single_amount_negative_kept_as_refund() -> None:
+    result = import_bank_csv("日付,金額\n2026-01-05,-300\n")
+    assert [e.amount for e in result.expenses] == [-300]
+
+
+def test_category_and_memo_columns() -> None:
+    text = "日付,金額,摘要,分類\n2026-01-05,100,コンビニ,食費\n2026-01-06,200,,\n"
+    result = import_bank_csv(text, default_category="雑費")
+    assert result.expenses == [
+        Expense(date(2026, 1, 5), "食費", 100, "コンビニ"),
+        Expense(date(2026, 1, 6), "雑費", 200, ""),
+    ]
+
+
+def test_error_line_number_is_record_start_after_multiline_field() -> None:
+    text = '日付,摘要,金額\n2026-01-05,"a\nb",100\n2026/13/01,x,200\n'
+    result = import_bank_csv(text)
+    assert [(e.line, e.column) for e in result.errors] == [(4, "日付")]
+
+
+def test_column_count_mismatch_is_row_error() -> None:
+    result = import_bank_csv("日付,金額\n2026-01-05\n")
+    assert result.expenses == []
+    assert [(e.line, e.column) for e in result.errors] == [(2, "(行)")]
+
+
+def test_blank_lines_skipped() -> None:
+    result = import_bank_csv("日付,金額\n\n2026-01-05,100\n\n")
+    assert [e.amount for e in result.expenses] == [100]
+    assert result.errors == []
+
+
+def test_header_only_gives_empty_result() -> None:
+    assert import_bank_csv("日付,金額\n") == ImportResult(expenses=[], errors=[])
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        pytest.param("", id="empty"),
+        pytest.param("日付,摘要\n2026-01-05,x\n", id="no-amount-column"),
+        pytest.param("金額,摘要\n100,x\n", id="no-date-column"),
+        pytest.param("日付,出金額\n2026-01-05,100\n", id="withdrawal-without-deposit"),
+    ],
+)
+def test_missing_header_or_columns_raise(text: str) -> None:
+    with pytest.raises(ValueError):
+        import_bank_csv(text)
+
+
+def test_non_string_text_raises() -> None:
+    with pytest.raises(ValueError, match="text"):
+        import_bank_csv(None)  # type: ignore[arg-type]
diff --git a/tests/test_month_report.py b/tests/test_month_report.py
new file mode 100644
index 0000000..ce9c4a0
--- /dev/null
+++ b/tests/test_month_report.py
@@ -0,0 +1,179 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.month_report import CategoryChange, compare_months, format_report
+
+
+def _e(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+def _find(changes: list[CategoryChange], category: str) -> CategoryChange:
+    return next(c for c in changes if c.category == category)
+
+
+# E4-1: 2026-02 の食費 12000、前月 10000
+def test_E4_1_increase_rate_and_status() -> None:
+    rows = [_e("2026-01-15", "食費", 10000), _e("2026-02-03", "食費", 12000)]
+    c = _find(compare_months(rows, "2026-02"), "食費")
+    assert c.previous == 10000
+    assert c.current == 12000
+    assert c.delta == 2000
+    assert c.rate == pytest.approx(0.2)
+    assert c.status == "増加"
+
+
+# E4-2: 前月のみ交通費 3000
+def test_E4_2_only_in_previous_is_disappeared() -> None:
+    rows = [_e("2026-01-10", "交通費", 3000)]
+    c = _find(compare_months(rows, "2026-02"), "交通費")
+    assert c.current == 0
+    assert c.delta == -3000
+    assert c.status == "なし"
+
+
+# E4-3: month=2026-13 は ValueError
+def test_E4_3_invalid_month_raises() -> None:
+    with pytest.raises(ValueError):
+        compare_months([], "2026-13")
+
+
+@pytest.mark.parametrize(
+    "bad", ["2026-1", "2026/02", "26-02", "2026-00", "", "2026-02-01"]
+)
+def test_R1_month_must_be_yyyy_mm(bad: str) -> None:
+    with pytest.raises(ValueError):
+        compare_months([], bad)
+
+
+def test_R1_january_compares_with_previous_december() -> None:
+    rows = [_e("2025-12-20", "食費", 8000), _e("2026-01-05", "食費", 4000)]
+    c = _find(compare_months(rows, "2026-01"), "食費")
+    assert c.previous == 8000
+    assert c.current == 4000
+    assert c.status == "減少"
+
+
+def test_D5_missing_previous_month_is_treated_as_empty() -> None:
+    rows = [_e("2026-03-01", "食費", 500)]
+    changes = compare_months(rows, "2026-03")
+    c = _find(changes, "食費")
+    assert c.previous == 0
+    assert c.rate is None
+    assert c.status == "新規"
+
+
+def test_R2_amounts_are_net_of_refunds() -> None:
+    rows = [
+        _e("2026-01-01", "食費", 10000),
+        _e("2026-01-02", "食費", -2000),
+        _e("2026-02-01", "食費", 5000),
+    ]
+    c = _find(compare_months(rows, "2026-02"), "食費")
+    assert c.previous == 8000
+    assert c.current == 5000
+    assert c.delta == -3000
+
+
+def test_R2_rate_is_none_when_previous_is_zero() -> None:
+    rows = [_e("2026-02-01", "娯楽", 1000)]
+    c = _find(compare_months(rows, "2026-02"), "娯楽")
+    assert c.rate is None
+
+
+def test_R3_unchanged_status() -> None:
+    rows = [_e("2026-01-01", "食費", 900), _e("2026-02-01", "食費", 900)]
+    c = _find(compare_months(rows, "2026-02"), "食費")
+    assert c.delta == 0
+    assert c.rate == 0.0
+    assert c.status == "変化なし"
+
+
+def test_R3_decrease_status() -> None:
+    rows = [_e("2026-01-01", "食費", 900), _e("2026-02-01", "食費", 300)]
+    c = _find(compare_months(rows, "2026-02"), "食費")
+    assert c.status == "減少"
+    assert c.rate == pytest.approx(-2 / 3)
+
+
+def test_R3_new_takes_priority_over_increase() -> None:
+    rows = [_e("2026-02-01", "医療", 700)]
+    c = _find(compare_months(rows, "2026-02"), "医療")
+    assert c.status == "新規"
+
+
+def test_R3_gone_takes_priority_over_decrease() -> None:
+    rows = [_e("2026-01-01", "医療", 700)]
+    c = _find(compare_months(rows, "2026-02"), "医療")
+    assert c.status == "なし"
+
+
+def test_R3_zero_in_both_months_is_omitted() -> None:
+    rows = [_e("2026-01-01", "食費", 0), _e("2026-02-01", "交通費", 100)]
+    cats = [c.category for c in compare_months(rows, "2026-02")]
+    assert "食費" not in cats
+    assert "交通費" in cats
+
+
+def test_R4_sorted_by_abs_delta_then_category() -> None:
+    rows = [
+        _e("2026-01-01", "B", 1000),
+        _e("2026-01-01", "A", 1000),
+        _e("2026-02-01", "B", 1000),  # delta 0
+        _e("2026-02-01", "A", 1000),  # delta 0
+        _e("2026-01-01", "C", 5000),
+        _e("2026-02-01", "C", 1000),  # delta -4000
+        _e("2026-02-01", "D", 2000),  # delta +2000 (new)
+    ]
+    order = [c.category for c in compare_months(rows, "2026-02")]
+    assert order == ["C", "D", "A", "B"]
+
+
+def test_R4_includes_categories_from_either_month() -> None:
+    rows = [_e("2026-01-01", "X", 100), _e("2026-02-01", "Y", 100)]
+    cats = {c.category for c in compare_months(rows, "2026-02")}
+    assert cats == {"X", "Y"}
+
+
+def test_R6_empty_rows_returns_empty_list() -> None:
+    assert compare_months([], "2026-02") == []
+
+
+def test_rows_outside_the_two_months_are_ignored() -> None:
+    rows = [_e("2025-11-01", "食費", 999), _e("2026-03-01", "食費", 999)]
+    assert compare_months(rows, "2026-02") == []
+
+
+def test_bool_amount_is_rejected() -> None:
+    bad = Expense(day=date(2026, 2, 1), category="食費", amount=True)  # type: ignore[arg-type]
+    with pytest.raises(ValueError):
+        compare_months([bad], "2026-02")
+
+
+def test_format_report_lines() -> None:
+    changes = [
+        CategoryChange("食費", 10000, 12000, 2000, 0.2, "増加"),
+        CategoryChange("交通費", 3000, 0, -3000, -1.0, "なし"),
+        CategoryChange("娯楽", 0, 1500, 1500, None, "新規"),
+    ]
+    text = format_report(changes, "2026-02")
+    assert text.split("\n") == [
+        "2026-02 前月比",
+        "食費 10,000→12,000 (+2,000 円, +20.0%)",
+        "交通費 3,000→0 (-3,000 円, -100.0%)",
+        "娯楽 0→1,500 (+1,500 円, -)",
+    ]
+
+
+def test_format_report_empty_changes() -> None:
+    assert format_report([], "2026-02") == "2026-02 前月比\n変化なし"
+
+
+def test_CategoryChange_is_frozen() -> None:
+    c = CategoryChange("食費", 1, 2, 1, 1.0, "増加")
+    with pytest.raises(AttributeError):
+        c.delta = 5  # type: ignore[misc]
