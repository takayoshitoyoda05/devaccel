new file mode 100644
index 0000000..387f155
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,117 @@
+"""Filter expenses with a JSON-like query (pure functions, stdlib only)."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable
+from datetime import date, datetime
+from typing import Any
+
+from kakeibo.core import Expense
+
+# JSON 風の入れ子辞書。葉は 1 キーの辞書、結合は and / or / not。
+Query = dict
+
+_Pred = Callable[[Expense], bool]
+
+
+def search(rows: list[Expense], query: Query) -> list[Expense]:
+    """Return the rows matching ``query``, in input order (same objects)."""
+    pred = _compile(query)  # 不正な条件は行数に関係なく ValueError
+    return [e for e in rows if pred(e)]
+
+
+def _compile(query: Any) -> _Pred:
+    if not isinstance(query, dict):
+        raise ValueError(f"query は辞書である必要があります: {query!r}")  # noqa: TRY004  # 仕様: 型違いも ValueError
+    _check_bounds(query)
+    preds = [_compile_key(key, value) for key, value in query.items()]
+
+    def pred(e: Expense) -> bool:
+        return all(p(e) for p in preds)
+
+    return pred
+
+
+def _check_bounds(query: dict[Any, Any]) -> None:
+    # D4: 同じ辞書内の下限 > 上限は不正
+    if "min_amount" in query and "max_amount" in query:
+        lo, hi = query["min_amount"], query["max_amount"]
+        if _is_int(lo) and _is_int(hi) and lo > hi:
+            raise ValueError(f"min_amount ({lo}) が max_amount ({hi}) より大きい")
+    if "since" in query and "until" in query:
+        lo, hi = query["since"], query["until"]
+        if _is_day(lo) and _is_day(hi) and lo > hi:
+            raise ValueError(f"since ({lo}) が until ({hi}) より後")
+
+
+def _is_int(v: object) -> bool:
+    return isinstance(v, int) and not isinstance(v, bool)
+
+
+def _is_day(v: object) -> bool:
+    return isinstance(v, date) and not isinstance(v, datetime)
+
+
+def _norm(text: str) -> str:
+    return unicodedata.normalize("NFKC", text).lower()
+
+
+def _compile_key(key: Any, value: Any) -> _Pred:
+    if key == "category":
+        return _category(value)
+    if key == "min_amount":
+        if not _is_int(value):
+            raise ValueError(f"min_amount は整数である必要があります: {value!r}")
+        return lambda e: e.amount >= value
+    if key == "max_amount":
+        if not _is_int(value):
+            raise ValueError(f"max_amount は整数である必要があります: {value!r}")
+        return lambda e: e.amount <= value
+    if key == "memo":
+        if not isinstance(value, str):
+            raise ValueError(f"memo は文字列である必要があります: {value!r}")
+        needle = _norm(value)
+        return lambda e: needle in _norm(e.memo)
+    if key == "since":
+        if not _is_day(value):
+            raise ValueError(f"since は date である必要があります: {value!r}")
+        return lambda e: e.day >= value
+    if key == "until":
+        if not _is_day(value):
+            raise ValueError(f"until は date である必要があります: {value!r}")
+        return lambda e: e.day <= value
+    if key == "and":
+        preds = _sub_queries("and", value)
+        return lambda e: all(p(e) for p in preds)
+    if key == "or":
+        preds = _sub_queries("or", value)
+        return lambda e: any(p(e) for p in preds)
+    if key == "not":
+        if not isinstance(value, dict):
+            raise ValueError(f"not は辞書である必要があります: {value!r}")
+        inner = _compile(value)
+        return lambda e: not inner(e)
+    raise ValueError(f"未知のキーです: {key!r}")
+
+
+def _category(value: Any) -> _Pred:
+    if isinstance(value, str):
+        return lambda e: e.category == value
+    if isinstance(value, list):
+        if not all(isinstance(c, str) for c in value):
+            raise ValueError(f"category のリストは文字列のみ: {value!r}")
+        names = list(value)
+        return lambda e: e.category in names
+    raise ValueError(
+        f"category は文字列かその文字列リストである必要があります: {value!r}"
+    )
+
+
+def _sub_queries(key: str, value: Any) -> list[_Pred]:
+    if not isinstance(value, list):
+        raise ValueError(f"{key} はリストである必要があります: {value!r}")  # noqa: TRY004
+    for q in value:
+        if not isinstance(q, dict):
+            raise ValueError(f"{key} の要素は辞書である必要があります: {q!r}")  # noqa: TRY004
+    return [_compile(q) for q in value]
