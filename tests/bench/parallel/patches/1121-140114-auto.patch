index 0000000..479cfd0
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,108 @@
+"""Recurring-expense detection over Expense rows (pure functions, stdlib only)."""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from collections import Counter
+from dataclasses import dataclass
+from datetime import date
+from fractions import Fraction
+from itertools import pairwise
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int
+    day_of_month: int
+    months: int
+    next_date: date
+
+
+_SPACE_RE = re.compile(r"\s+")
+_TRAILING_NUM_RE = re.compile(r"#?[0-9]+$")
+
+
+def _normalize_memo(memo: str) -> str:
+    """D2: NFKC, lowercase, drop whitespace, drop a trailing number or #number."""
+    s = unicodedata.normalize("NFKC", memo).lower()
+    s = _SPACE_RE.sub("", s)
+    return _TRAILING_NUM_RE.sub("", s)
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month - 1
+
+
+def _median(values: list[int]) -> Fraction:
+    s = sorted(values)
+    n = len(s)
+    if n % 2:
+        return Fraction(s[n // 2])
+    return Fraction(s[n // 2 - 1] + s[n // 2], 2)
+
+
+def find_recurring(rows: list[Expense], min_months: int = 3) -> list[Recurring]:
+    if isinstance(min_months, bool) or not isinstance(min_months, int):
+        # Spec requires ValueError (not TypeError) for bool/non-int arguments.
+        raise ValueError(f"min_months は int である必要があります: {min_months!r}")  # noqa: TRY004
+    if min_months < 2:
+        raise ValueError(f"min_months は 2 以上である必要があります: {min_months!r}")
+
+    # D1: amount <= 0 rows are not expenses and are ignored here.
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        if e.amount <= 0:
+            continue
+        groups.setdefault((e.category, _normalize_memo(e.memo)), []).append(e)
+
+    out: list[Recurring] = []
+    for (category, _key), members in groups.items():
+        # R1: keep only rows within ±10% of the series median.
+        med = _median([e.amount for e in members])
+        kept = [e for e in members if abs(e.amount - med) <= med / 10]
+
+        # R2: one representative per month, the earliest-dated row.
+        by_month: dict[int, Expense] = {}
+        for e in sorted(kept, key=lambda e: e.day):
+            by_month.setdefault(_month_index(e.day), e)
+        if len(by_month) < min_months:
+            continue
+
+        # R3: adjacent occurrence months must all be exactly one month apart.
+        months = sorted(by_month)
+        if any(b - a != 1 for a, b in pairwise(months)):
+            continue
+
+        reps = [by_month[m] for m in months]
+        last = reps[-1]
+
+        # D3: base day = most frequent day-of-month (ties -> larger day).
+        counts = Counter(e.day.day for e in reps)
+        best = max(counts.values())
+        base_day = max(d for d, c in counts.items() if c == best)
+
+        # R4: next occurrence is in the month after the last one, clamped.
+        next_idx = months[-1] + 1
+        year, month = next_idx // 12, next_idx % 12 + 1
+        day = min(base_day, calendar.monthrange(year, month)[1])
+
+        out.append(
+            Recurring(
+                category=category,
+                memo=last.memo,
+                amount=last.amount,
+                day_of_month=base_day,
+                months=len(months),
+                next_date=date(year, month, day),
+            )
+        )
+
+    # R5: order by next_date, then category, then memo.
+    out.sort(key=lambda r: (r.next_date, r.category, r.memo))
+    return out
