@@ -0,0 +1,241 @@
+"""Import bank statement CSV text into Expense records (pure function, stdlib only)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str
+    value: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+
+
+# 論理フィールド -> 受け付ける列名(小文字化して比較する)
+_FIELD_ALIASES: dict[str, tuple[str, ...]] = {
+    "date": ("date", "日付", "利用日", "取引日", "ご利用日", "年月日"),
+    "amount": ("amount", "金額", "利用金額", "ご利用金額"),
+    "withdrawal": ("出金額", "出金", "お支払金額", "支払金額"),
+    "deposit": ("入金額", "入金", "預入金額", "お預り金額"),
+    "memo": ("memo", "摘要", "メモ", "利用店名", "ご利用店名", "内容", "description"),
+    "category": ("category", "カテゴリ", "分類"),
+}
+_LOOKUP: dict[str, str] = {
+    alias.lower(): field
+    for field, aliases in _FIELD_ALIASES.items()
+    for alias in aliases
+}
+
+_DATE_PATTERNS: tuple[re.Pattern[str], ...] = (
+    re.compile(r"([0-9]{4})-([0-9]{2})-([0-9]{2})"),
+    re.compile(r"([0-9]{4})/([0-9]{1,2})/([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})\.([0-9]{1,2})\.([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日"),
+)
+
+# (パターン, 符号) — 括弧・△▲・末尾マイナスは負数
+_AMOUNT_PATTERNS: tuple[tuple[re.Pattern[str], int], ...] = (
+    (re.compile(r"\(([0-9]+)\)"), -1),
+    (re.compile(r"[△▲]([0-9]+)"), -1),
+    (re.compile(r"[-−]([0-9]+)"), -1),
+    (re.compile(r"([0-9]+)-"), -1),
+    (re.compile(r"([0-9]+)"), 1),
+)
+
+
+def _parse_date(raw: str) -> date | str:
+    """Return the date, or the Japanese reason it is invalid."""
+    s = unicodedata.normalize("NFKC", raw).strip()
+    if not s:
+        return "日付が空です"
+    token = s.split()[0]  # 時刻(空白以降)は捨てる
+    for pat in _DATE_PATTERNS:
+        m = pat.fullmatch(token)
+        if m:
+            y, mo, d = (int(g) for g in m.groups())
+            try:
+                return date(y, mo, d)
+            except ValueError:
+                return "存在しない日付です"
+    return "日付の形式が不正です"
+
+
+def _parse_amount(raw: str) -> int | str:
+    """Return the signed yen amount, or the Japanese reason it is invalid."""
+    s = unicodedata.normalize("NFKC", raw)
+    s = re.sub(r"¥|円|JPY", "", s)
+    s = re.sub(r"[\s,]", "", s)
+    if not s:
+        return "金額が空です"
+    for pat, sign in _AMOUNT_PATTERNS:
+        m = pat.fullmatch(s)
+        if m:
+            return sign * int(m.group(1))
+    if "." in s:
+        return "小数は扱えません"
+    return "金額が数値ではありません"
+
+
+def _detect_delimiter(body: str) -> str:
+    first_line = body.split("\n", 1)[0]
+    return "\t" if first_line.count("\t") > first_line.count(",") else ","
+
+
+def _split_amount(
+    record: list[str], fields: dict[str, int], header: list[str], line: int
+) -> tuple[int | None, bool, list[tuple[int, RowError]]]:
+    """出金/入金の 2 列から金額を決める。戻り値: (金額, スキップか, 誤り[(列位置, RowError)])。"""
+    wi = fields["withdrawal"]
+    di = fields["deposit"]
+    w_raw = record[wi]
+    d_raw = record[di]
+    w_has = bool(w_raw.strip())
+    d_has = bool(d_raw.strip())
+    if w_has and d_has:
+        return (
+            None,
+            False,
+            [
+                (
+                    di,
+                    RowError(
+                        line, header[di], d_raw, "出金額と入金額の両方に金額があります"
+                    ),
+                )
+            ],
+        )
+    if w_has:
+        r = _parse_amount(w_raw)
+        if isinstance(r, str):
+            return None, False, [(wi, RowError(line, header[wi], w_raw, r))]
+        return r, False, []
+    if d_has:
+        r = _parse_amount(d_raw)
+        if isinstance(r, str):
+            return None, False, [(di, RowError(line, header[di], d_raw, r))]
+        return None, True, []  # 入金のみの行はスキップ(誤りではない)
+    return (
+        None,
+        False,
+        [(wi, RowError(line, header[wi], w_raw, "出金額と入金額がどちらも空です"))],
+    )
+
+
+def import_bank_csv(text: str, default_category: str = "未分類") -> ImportResult:
+    # 仕様: 不正な引数は TypeError ではなく ValueError にする
+    if not isinstance(text, str):
+        raise ValueError("text は文字列である必要があります")  # noqa: TRY004
+    if not isinstance(default_category, str) or not default_category.strip():
+        raise ValueError("default_category は空でない文字列である必要があります")
+
+    body = text.removeprefix("﻿")
+    delim = _detect_delimiter(body)
+    reader = csv.reader(io.StringIO(body, newline=""), delimiter=delim)
+
+    try:
+        header = next(reader, None)
+    except csv.Error as e:
+        raise ValueError(f"ヘッダー行を読めません: {e}") from None
+    if header is None or all(not c.strip() for c in header):
+        raise ValueError("ヘッダー行がありません")
+
+    fields: dict[str, int] = {}
+    for idx, cell in enumerate(header):
+        field = _LOOKUP.get(cell.strip().lower())
+        if field is None:
+            continue
+        if field in fields:
+            raise ValueError(f"列 {cell.strip()!r} が重複しています")
+        fields[field] = idx
+
+    if "date" not in fields:
+        raise ValueError("日付列がありません(date / 日付 / 利用日 など)")
+    if "amount" in fields:
+        amount_mode = "single"
+    elif "withdrawal" in fields and "deposit" in fields:
+        amount_mode = "split"
+    else:
+        raise ValueError(
+            "金額列がありません(金額 / 利用金額 など、または 出金額 と 入金額 の両方)"
+        )
+
+    ncols = len(header)
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    while True:
+        start = reader.line_num + 1
+        try:
+            record = next(reader)
+        except StopIteration:
+            break
+        except csv.Error as e:
+            raise ValueError(f"CSV を読めません(行 {start}): {e}") from None
+        if all(not c.strip() for c in record):
+            continue  # 空行
+        if len(record) != ncols:
+            errors.append(
+                RowError(
+                    start,
+                    "(行)",
+                    delim.join(record),
+                    f"列数が合いません(ヘッダー {ncols} 列、この行 {len(record)} 列)",
+                )
+            )
+            continue
+
+        row_errs: list[tuple[int, RowError]] = []
+        day_idx = fields["date"]
+        day = _parse_date(record[day_idx])
+        if isinstance(day, str):
+            row_errs.append(
+                (day_idx, RowError(start, header[day_idx], record[day_idx], day))
+            )
+
+        amount: int | None = None
+        skip = False
+        if amount_mode == "single":
+            ai = fields["amount"]
+            r = _parse_amount(record[ai])
+            if isinstance(r, str):
+                row_errs.append((ai, RowError(start, header[ai], record[ai], r)))
+            else:
+                amount = r
+        else:
+            amount, skip, split_errs = _split_amount(record, fields, header, start)
+            row_errs.extend(split_errs)
+
+        if row_errs:
+            errors.extend(err for _, err in sorted(row_errs, key=lambda t: t[0]))
+            continue
+        if skip or isinstance(day, str) or amount is None:
+            continue
+
+        cat_idx = fields.get("category")
+        category = record[cat_idx].strip() if cat_idx is not None else ""
+        memo_idx = fields.get("memo")
+        memo = record[memo_idx].strip() if memo_idx is not None else ""
+        expenses.append(
+            Expense(
+                day=day,
+                category=category or default_category,
+                amount=amount,
+                memo=memo,
+            )
+        )
+
+    return ImportResult(expenses=expenses, errors=errors)
