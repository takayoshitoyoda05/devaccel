@@ -0,0 +1,191 @@
+from __future__ import annotations
+
+from datetime import date, datetime
+from typing import Any
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import search
+
+
+def _e(day: str, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+ROWS = [
+    _e("2026-01-05", "食費", 1200, "ランチ"),  # 0
+    _e("2026-01-10", "日用品", 800, "ｱﾏｿﾞﾝ"),  # 1
+    _e("2026-01-12", "日用品", 900, "Amazon"),  # 2
+    _e("2026-02-01", "食費", 500, "コンビニ"),  # 3
+    _e("2026-02-28", "交通費", 300, ""),  # 4
+    _e("2026-03-01", "食費", 499, "ＡＢＣ"),  # 5 (全角英字)
+]
+
+
+# E3-1: 表の例 (or / category / memo NFKC)
+def test_E3_1_or_category_or_memo() -> None:
+    q = {"or": [{"category": "食費"}, {"memo": "ｱﾏｿﾞﾝ"}]}
+    assert search(ROWS, q) == [ROWS[0], ROWS[1], ROWS[3], ROWS[5]]
+
+
+# E3-2: 表の例 (両端含む金額範囲)
+def test_E3_2_amount_range_inclusive_both_ends() -> None:
+    rows = [
+        _e("2026-01-01", "a", 499),
+        _e("2026-01-01", "b", 500),
+        _e("2026-01-01", "c", 501),
+    ]
+    assert search(rows, {"min_amount": 500, "max_amount": 500}) == [rows[1]]
+
+
+# E3-3: 表の例 (未知のキー)
+def test_E3_3_unknown_key_raises() -> None:
+    with pytest.raises(ValueError, match="colour"):
+        search(ROWS, {"colour": "red"})
+
+
+# R1: category はリストのどれか(完全一致)
+def test_R1_category_list_matches_any() -> None:
+    assert search(ROWS, {"category": ["交通費", "日用品"]}) == [
+        ROWS[1],
+        ROWS[2],
+        ROWS[4],
+    ]
+
+
+# R1: category の空リストは何にも一致しない(空の or と同じ扱い)
+def test_R1_category_empty_list_matches_nothing() -> None:
+    assert search(ROWS, {"category": []}) == []
+
+
+# R1: category は完全一致(部分一致はしない)
+def test_R1_category_is_exact_not_partial() -> None:
+    assert search(ROWS, {"category": "食"}) == []
+
+
+# R1: memo の空文字は常に真
+def test_R1_memo_empty_string_matches_all() -> None:
+    assert search(ROWS, {"memo": ""}) == ROWS
+
+
+# R1/D2系: memo は NFKC・小文字化後の部分一致
+def test_R1_memo_case_and_width_insensitive() -> None:
+    assert search(ROWS, {"memo": "AMAZON"}) == [ROWS[2]]
+    assert search(ROWS, {"memo": "abc"}) == [ROWS[5]]
+
+
+# R1: memo の部分一致
+def test_R1_memo_partial_match() -> None:
+    assert search(ROWS, {"memo": "ンビ"}) == [ROWS[3]]
+
+
+# D4: since / until は両端含む
+def test_D4_since_until_inclusive() -> None:
+    q = {"since": date(2026, 1, 10), "until": date(2026, 2, 1)}
+    assert search(ROWS, q) == [ROWS[1], ROWS[2], ROWS[3]]
+
+
+# D4: 単独の since / until も両端含む
+def test_D4_since_alone_and_until_alone_inclusive() -> None:
+    assert search(ROWS, {"since": date(2026, 2, 28)}) == [ROWS[4], ROWS[5]]
+    assert search(ROWS, {"until": date(2026, 1, 5)}) == [ROWS[0]]
+
+
+# R2: 空の and は真
+def test_R2_empty_and_is_true() -> None:
+    assert search(ROWS, {"and": []}) == ROWS
+
+
+# R2: 空の or は偽
+def test_R2_empty_or_is_false() -> None:
+    assert search(ROWS, {"or": []}) == []
+
+
+# R2: not は反転
+def test_R2_not_inverts() -> None:
+    assert search(ROWS, {"not": {"category": "食費"}}) == [ROWS[1], ROWS[2], ROWS[4]]
+
+
+# R2: 入れ子の結合
+def test_R2_nested_combinators() -> None:
+    q = {
+        "and": [
+            {"not": {"or": [{"category": "食費"}, {"memo": "amazon"}]}},
+            {"min_amount": 300},
+        ]
+    }
+    # 食費でも memo=amazon でもない行のうち 300 円以上: ｱﾏｿﾞﾝ(800) と 交通費(300)
+    assert search(ROWS, q) == [ROWS[1], ROWS[4]]
+
+
+# R3: 1 つの辞書の複数キーは AND
+def test_R3_multiple_keys_in_one_dict_are_and() -> None:
+    assert search(ROWS, {"category": "食費", "min_amount": 1000}) == [ROWS[0]]
+
+
+# R4: 入力順を保ち、元の行を同一オブジェクトで返す
+def test_R4_keeps_order_and_identity() -> None:
+    result = search(ROWS, {"category": ["交通費", "食費"]})
+    assert result == [ROWS[0], ROWS[3], ROWS[4], ROWS[5]]
+    assert all(a is b for a, b in zip(result, [ROWS[0], ROWS[3], ROWS[4], ROWS[5]]))
+
+
+# R6: 空の rows は []
+def test_R6_empty_rows_returns_empty() -> None:
+    assert search([], {"min_amount": 1}) == []
+
+
+# R6: 空の辞書は全件真
+def test_R6_empty_query_matches_all() -> None:
+    assert search(ROWS, {}) == ROWS
+
+
+# R6: 空の rows でも不正な条件は ValueError
+def test_R6_invalid_query_raises_even_with_empty_rows() -> None:
+    with pytest.raises(ValueError, match="colour"):
+        search([], {"colour": "red"})
+
+
+# D4: 下限 > 上限は ValueError
+@pytest.mark.parametrize(
+    "query",
+    [
+        pytest.param({"min_amount": 501, "max_amount": 500}, id="D4-amount"),
+        pytest.param(
+            {"since": date(2026, 2, 1), "until": date(2026, 1, 31)}, id="D4-period"
+        ),
+    ],
+)
+def test_D4_lower_bound_above_upper_bound_raises(query: Any) -> None:
+    with pytest.raises(ValueError):
+        search(ROWS, query)
+
+
+# R5: 型違い・不正な構造は ValueError
+@pytest.mark.parametrize(
+    ("query", "key"),
+    [
+        pytest.param({"min_amount": True}, "min_amount", id="R5-bool-min"),
+        pytest.param({"max_amount": False}, "max_amount", id="R5-bool-max"),
+        pytest.param({"min_amount": "500"}, "min_amount", id="R5-str-amount"),
+        pytest.param({"since": "2026-01-01"}, "since", id="R5-since-str"),
+        pytest.param({"until": datetime(2026, 1, 1)}, "until", id="R5-until-datetime"),
+        pytest.param({"and": {"category": "食費"}}, "and", id="R5-and-not-list"),
+        pytest.param({"or": "食費"}, "or", id="R5-or-not-list"),
+        pytest.param({"and": [{"colour": "red"}]}, "colour", id="R5-unknown-nested"),
+        pytest.param({"category": 1}, "category", id="R5-category-int"),
+        pytest.param(
+            {"category": ["食費", 1]}, "category", id="R5-category-list-nonstr"
+        ),
+        pytest.param({"memo": 1}, "memo", id="R5-memo-int"),
+        pytest.param({"not": "食費"}, "not", id="R5-not-non-dict"),
+        pytest.param({"and": ["食費"]}, "and", id="R5-and-element-non-dict"),
+        pytest.param([], "query", id="R5-top-level-list"),
+    ],
+)
+def test_R5_invalid_input_raises(query: Any, key: str) -> None:
+    with pytest.raises(ValueError, match=key):
+        search(ROWS, query)
