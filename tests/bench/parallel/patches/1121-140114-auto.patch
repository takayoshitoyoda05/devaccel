+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring
+
+
+def _e(day: str, category: str, amount: int, memo: str) -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+@pytest.mark.parametrize(
+    ("rows", "expected"),
+    [
+        pytest.param(
+            [
+                _e("2026-01-25", "住居", 80000, "家賃"),
+                _e("2026-02-25", "住居", 80000, "家賃"),
+                _e("2026-03-25", "住居", 80000, "家賃"),
+            ],
+            [Recurring("住居", "家賃", 80000, 25, 3, date(2026, 4, 25))],
+            id="E1-1",
+        ),
+        pytest.param(
+            [
+                _e("2026-01-31", "通信", 1000, "回線"),
+                _e("2026-02-28", "通信", 1000, "回線"),
+                _e("2026-03-31", "通信", 1000, "回線"),
+            ],
+            [Recurring("通信", "回線", 1000, 31, 3, date(2026, 4, 30))],
+            id="E1-2",
+        ),
+        pytest.param(
+            [
+                _e("2026-01-05", "娯楽", 500, "動画"),
+                _e("2026-02-05", "娯楽", 500, "動画"),
+                _e("2026-04-05", "娯楽", 500, "動画"),
+            ],
+            [],
+            id="E1-3",
+        ),
+    ],
+)
+def test_find_recurring_examples(
+    rows: list[Expense], expected: list[Recurring]
+) -> None:
+    assert find_recurring(rows) == expected
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+@pytest.mark.parametrize("min_months", [1, 0, -1, True, False, "3", 2.0])
+def test_invalid_min_months_raises(min_months: object) -> None:
+    with pytest.raises(ValueError, match="min_months"):
+        find_recurring([], min_months=min_months)  # type: ignore[arg-type]
