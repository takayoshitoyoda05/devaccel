diff --git a/tests/test_types/test_Choice.py b/tests/test_types/test_Choice.py
index c34f516..c8c3717 100644
--- a/tests/test_types/test_Choice.py
+++ b/tests/test_types/test_Choice.py
@@ -1,3 +1,7 @@
+import enum
+
+import pytest
+
 import click
 
 
@@ -5,3 +9,75 @@ def test_choice_get_invalid_choice_message():
     choice = click.Choice(["a", "b", "c"])
     message = choice.get_invalid_choice_message("d", ctx=None)
     assert message == "'d' is not one of 'a', 'b', 'c'."
+
+
+def test_invalid_choice_suggests_one_close_match():
+    choice = click.Choice(["push", "pull", "commit"])
+    message = choice.get_invalid_choice_message("pus", ctx=None)
+    assert message.endswith("Did you mean 'push'?")
+
+
+def test_invalid_choice_suggests_several_close_matches():
+    choice = click.Choice(["declare", "refine", "push"])
+    message = choice.get_invalid_choice_message("decline", ctx=None)
+    assert message.endswith("(Did you mean one of: 'declare', 'refine'?)")
+
+
+def test_invalid_choice_no_suggestion_when_far():
+    choice = click.Choice(["push", "pull"])
+    message = choice.get_invalid_choice_message("zzzzzz", ctx=None)
+    assert "Did you mean" not in message
+
+
+def test_invalid_choice_single_choice_wording_with_suggestion():
+    choice = click.Choice(["push"])
+    message = choice.get_invalid_choice_message("pusj", ctx=None)
+    assert message == "'pusj' is not 'push'. Did you mean 'push'?"
+
+
+def test_invalid_choice_suggestion_case_insensitive():
+    choice = click.Choice(["Push", "Pull"], case_sensitive=False)
+    message = choice.get_invalid_choice_message("PUS", ctx=None)
+    assert message.endswith("Did you mean 'push'?")
+
+
+def test_invalid_choice_suggestion_uses_token_normalize_func():
+    choice = click.Choice(["push"])
+    ctx = click.Context(
+        click.Command("x"), token_normalize_func=lambda s: s.replace("_", "")
+    )
+    message = choice.get_invalid_choice_message("pus_x", ctx=ctx)
+    assert message.endswith("Did you mean 'push'?")
+
+
+def test_invalid_choice_suggestion_enum_and_non_str_value():
+    class Color(enum.Enum):
+        RED = 1
+        BLUE = 2
+
+    choice = click.Choice(Color)
+    assert choice.get_invalid_choice_message("RDE", ctx=None).endswith(
+        "Did you mean 'RED'?"
+    )
+    # A non-string value is stringified, not a TypeError.
+    assert "Did you mean" not in choice.get_invalid_choice_message(5, ctx=None)
+
+
+def test_invalid_choice_suggestion_empty_value():
+    choice = click.Choice(["a", "b"])
+    message = choice.get_invalid_choice_message("", ctx=None)
+    assert "Did you mean" not in message
+
+
+@pytest.mark.parametrize("value", ["pus", "PUS"])
+def test_invalid_choice_suggestion_through_command(runner, value):
+    @click.command()
+    @click.option("--action", type=click.Choice(["push", "pull"], case_sensitive=False))
+    def cli(action):
+        pass
+
+    result = runner.invoke(cli, ["--action", value])
+    assert result.exit_code == 2
+    assert f"{value!r} is not one of 'push', 'pull'. Did you mean 'push'?" in (
+        result.output
+    )
