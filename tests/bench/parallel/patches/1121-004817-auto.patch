+"""月ごとのカテゴリ別支出と前月比(純粋関数のみ)。
+
+決めた扱い:
+D1: 月別・カテゴリ別の集計は core.monthly_totals を再利用する(Expense も core のもの)。
+D2: データに無い月は「空の月」として扱う。1 月にあって 2 月に無いカテゴリは、
+    2 月(空の月)の行で「なくなった」になる。最初の月から最後の月まで暦の月を全部並べる。
+D3: 最初の月は空の月と比べる(全カテゴリが「新しく出てきた」)。
+D4: 区分は存在で決める。前月に無く今月にある=new、前月にあり今月に無い=removed、
+    両方にあり金額が増=increased、減=decreased、同じ=unchanged。
+    (合計が 0 円でも、その月に支出行があれば「ある」とみなす。)
+D5: 増減率(%)は前月が 0 円なら None(0 での割り算をしない)。
+    それ以外は delta / abs(前月) * 100。removed は -100.0。
+D6: 並びは月の昇順。月の中は |増減額| の降順、同点はカテゴリ名の昇順。unchanged も含める。
+D7: 空の入力は空のリスト。1 か月だけなら 1 件(D3 に従う)。
+D8: 負の金額(返金)はそのまま合算する(拒否しない・別扱いしない)。
+D9: 同じ月・同じカテゴリの複数行は合算する(monthly_totals の挙動)。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Literal
+
+from kakeibo.core import Expense, monthly_totals
+
+Status = Literal["new", "removed", "increased", "decreased", "unchanged"]
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int  # 前月の金額(無ければ 0)
+    current: int  # 今月の金額(無ければ 0)
+    delta: int  # current - previous
+    pct: float | None  # 増減率(%)。前月 0 円なら None
+    status: Status
+
+
+@dataclass(frozen=True)
+class MonthReport:
+    month: str  # "YYYY-MM"
+    total: int
+    changes: list[CategoryChange]
+
+
+def _next_month(month: str) -> str:
+    y, m = int(month[:4]), int(month[5:7])
+    y, m = (y + 1, 1) if m == 12 else (y, m + 1)
+    return f"{y:04d}-{m:02d}"
+
+
+def _month_range(first: str, last: str) -> list[str]:
+    out = [first]
+    while out[-1] != last:
+        out.append(_next_month(out[-1]))
+    return out
+
+
+def compare_months(
+    previous: dict[str, int], current: dict[str, int]
+) -> list[CategoryChange]:
+    """2 か月分の {カテゴリ: 円} を比べる。"""
+    out: list[CategoryChange] = []
+    for cat in previous.keys() | current.keys():
+        prev = previous.get(cat, 0)
+        cur = current.get(cat, 0)
+        status: Status
+        if cat not in previous:
+            status = "new"
+        elif cat not in current:
+            status = "removed"
+        elif cur > prev:
+            status = "increased"
+        elif cur < prev:
+            status = "decreased"
+        else:
+            status = "unchanged"
+        delta = cur - prev
+        pct = None if prev == 0 else delta / abs(prev) * 100
+        out.append(CategoryChange(cat, prev, cur, delta, pct, status))
+    out.sort(key=lambda c: (-abs(c.delta), c.category))
+    return out
+
+
+def monthly_report(rows: list[Expense]) -> list[MonthReport]:
+    """月ごとのカテゴリ別支出と前月比。月は昇順、欠けた月は空の月として並べる。"""
+    totals = monthly_totals(rows)
+    if not totals:
+        return []
+    months = sorted(totals)
+    reports: list[MonthReport] = []
+    prev: dict[str, int] = {}
+    for m in _month_range(months[0], months[-1]):
+        cur = totals.get(m, {})
+        reports.append(MonthReport(m, sum(cur.values()), compare_months(prev, cur)))
+        prev = cur
+    return reports
diff --git a/tests/test_monthly_diff.py b/tests/test_monthly_diff.py
new file mode 100644
index 0000000..4f8ae6b
--- /dev/null
+++ b/tests/test_monthly_diff.py
@@ -0,0 +1,87 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.monthly_diff import compare_months, monthly_report
+
+
+def e(d: str, cat: str, amount: int) -> Expense:
+    return Expense(date.fromisoformat(d), cat, amount)
+
+
+def by_cat(changes):
+    return {c.category: c for c in changes}
+
+
+def test_empty_input():  # D7
+    assert monthly_report([]) == []
+
+
+def test_first_month_all_new():  # D3
+    [r] = monthly_report([e("2026-01-05", "食費", 3000), e("2026-01-09", "食費", 500)])
+    assert r.month == "2026-01"
+    assert r.total == 3500
+    [c] = r.changes
+    assert (c.status, c.previous, c.current, c.delta, c.pct) == (
+        "new",
+        0,
+        3500,
+        3500,
+        None,
+    )
+
+
+def test_all_statuses():  # D4, D5
+    rows = [
+        e("2026-01-01", "食費", 1000),
+        e("2026-01-01", "交通", 2000),
+        e("2026-01-01", "趣味", 500),
+        e("2026-01-01", "家賃", 7000),
+        e("2026-02-01", "食費", 1500),
+        e("2026-02-01", "交通", 1000),
+        e("2026-02-01", "家賃", 7000),
+        e("2026-02-01", "衣服", 4000),
+    ]
+    feb = by_cat(monthly_report(rows)[1].changes)
+    assert feb["食費"].status == "increased" and feb["食費"].pct == 50.0
+    assert feb["交通"].status == "decreased" and feb["交通"].pct == -50.0
+    assert feb["趣味"].status == "removed" and feb["趣味"].pct == -100.0
+    assert feb["家賃"].status == "unchanged" and feb["家賃"].delta == 0
+    assert feb["衣服"].status == "new" and feb["衣服"].pct is None
+
+
+def test_gap_month_is_empty():  # D2
+    rows = [e("2026-01-10", "食費", 1000), e("2026-03-10", "食費", 1200)]
+    reports = monthly_report(rows)
+    assert [r.month for r in reports] == ["2026-01", "2026-02", "2026-03"]
+    assert reports[1].total == 0
+    assert reports[1].changes[0].status == "removed"
+    assert reports[2].changes[0].status == "new"
+
+
+def test_year_boundary():  # D2
+    rows = [e("2025-12-31", "食費", 100), e("2026-01-01", "食費", 200)]
+    assert [r.month for r in monthly_report(rows)] == ["2025-12", "2026-01"]
+
+
+def test_unsorted_input_sorted_months():  # D6
+    rows = [e("2026-02-01", "食費", 200), e("2026-01-01", "食費", 100)]
+    assert [r.month for r in monthly_report(rows)] == ["2026-01", "2026-02"]
+
+
+def test_order_by_abs_delta_then_name():  # D6
+    prev = {"a": 100, "b": 100, "c": 100}
+    cur = {"a": 50, "b": 150, "c": 100, "d": 10}
+    assert [c.category for c in compare_months(prev, cur)] == ["a", "b", "d", "c"]
+
+
+def test_refund_negative_amount():  # D8
+    rows = [e("2026-01-01", "食費", 1000), e("2026-02-01", "食費", -200)]
+    c = monthly_report(rows)[1].changes[0]
+    assert (c.current, c.delta, c.status) == (-200, -1200, "decreased")
+    assert c.pct == -120.0
+
+
+def test_zero_total_still_present():  # D4
+    rows = [e("2026-01-01", "食費", 100), e("2026-02-01", "食費", 0)]
+    c = monthly_report(rows)[1].changes[0]
+    assert c.status == "decreased" and c.pct == -100.0
