+"""Month-over-month comparison of category totals (pure functions, no I/O).
+
+Input is the shape produced by ``core.monthly_totals``: ``{"YYYY-MM": {category: yen}}``.
+
+Rules:
+- 前月 is the calendar previous month. A month is compared only when that previous
+  month has records in the input; otherwise it gets no comparison at all (it is
+  omitted from the result), so a gap in the ledger never shows up as "all new".
+- A category is reported only when it is new (present now, absent before),
+  removed (present before, absent now), or its amount changed. Categories with the
+  same amount in both months are not reported.
+- Changes are sorted by absolute delta descending, then by category name ascending.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Literal
+
+Status = Literal["new", "removed", "increased", "decreased"]
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    status: Status
+    previous: int  # yen in the previous month; 0 when the category was absent
+    current: int  # yen in the current month; 0 when the category is absent
+
+    @property
+    def delta(self) -> int:
+        return self.current - self.previous
+
+
+def compare_months(
+    previous: dict[str, int], current: dict[str, int]
+) -> list[CategoryChange]:
+    """Changes from ``previous`` to ``current`` for one pair of months."""
+    out: list[CategoryChange] = []
+    for cat in previous.keys() | current.keys():
+        before = previous.get(cat)
+        after = current.get(cat)
+        if before is None and after is not None:
+            out.append(CategoryChange(cat, "new", 0, after))
+        elif before is not None and after is None:
+            out.append(CategoryChange(cat, "removed", before, 0))
+        elif before is not None and after is not None and before != after:
+            status: Status = "increased" if after > before else "decreased"
+            out.append(CategoryChange(cat, status, before, after))
+    out.sort(key=lambda c: (-abs(c.delta), c.category))
+    return out
+
+
+def _previous_month(month: str) -> str:
+    year, mon = (int(x) for x in month.split("-"))
+    if mon == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mon - 1:02d}"
+
+
+def month_over_month(
+    totals: dict[str, dict[str, int]],
+) -> dict[str, list[CategoryChange]]:
+    """Per-month changes against the calendar previous month.
+
+    The result keys are the months that have a comparable previous month in
+    ``totals``, in ascending order. The first month of the data and any month
+    whose previous month has no records are not included.
+    """
+    out: dict[str, list[CategoryChange]] = {}
+    for month in sorted(totals):
+        prev = _previous_month(month)
+        if prev in totals:
+            out[month] = compare_months(totals[prev], totals[month])
+    return out
diff --git a/tests/test_compare.py b/tests/test_compare.py
new file mode 100644
index 0000000..1808ec0
--- /dev/null
+++ b/tests/test_compare.py
@@ -0,0 +1,99 @@
+from datetime import date
+
+from kakeibo.compare import CategoryChange, compare_months, month_over_month
+from kakeibo.core import Expense, monthly_totals
+
+
+def test_new_and_removed_categories():
+    changes = compare_months({"food": 1000}, {"travel": 5000})
+    assert changes == [
+        CategoryChange("travel", "new", 0, 5000),
+        CategoryChange("food", "removed", 1000, 0),
+    ]
+
+
+def test_increased_and_decreased_with_delta():
+    changes = compare_months(
+        {"food": 1000, "rent": 80000}, {"food": 1500, "rent": 70000}
+    )
+    by_cat = {c.category: c for c in changes}
+    assert by_cat["food"].status == "increased"
+    assert by_cat["food"].delta == 500
+    assert by_cat["rent"].status == "decreased"
+    assert by_cat["rent"].delta == -10000
+
+
+def test_unchanged_category_is_not_reported():
+    assert compare_months({"food": 1000}, {"food": 1000}) == []
+
+
+def test_sorted_by_absolute_delta_then_name():
+    changes = compare_months(
+        {"a": 100, "b": 300, "c": 0},
+        {"a": 200, "b": 0, "d": 100},
+    )
+    # b: decreased by 300; a: increased by 100; d: new, delta 100; c: removed, delta 0
+    assert [c.category for c in changes] == ["b", "a", "d", "c"]
+
+
+def test_removed_category_with_zero_amount_still_reported():
+    changes = compare_months({"misc": 0}, {})
+    assert changes == [CategoryChange("misc", "removed", 0, 0)]
+
+
+def test_empty_months():
+    assert compare_months({}, {}) == []
+    assert compare_months({}, {"food": 10}) == [CategoryChange("food", "new", 0, 10)]
+
+
+def test_month_over_month_pairs_adjacent_months():
+    totals = {
+        "2026-10": {"food": 1000, "rent": 80000},
+        "2026-11": {"food": 1200, "travel": 3000},
+    }
+    result = month_over_month(totals)
+    assert list(result) == ["2026-11"]
+    assert {c.category: c.status for c in result["2026-11"]} == {
+        "rent": "removed",
+        "travel": "new",
+        "food": "increased",
+    }
+
+
+def test_first_month_has_no_comparison():
+    totals = {"2026-10": {"food": 1000}}
+    assert month_over_month(totals) == {}
+
+
+def test_year_boundary_uses_previous_december():
+    totals = {
+        "2025-12": {"food": 1000},
+        "2026-01": {"food": 500},
+    }
+    result = month_over_month(totals)
+    assert list(result) == ["2026-01"]
+    assert result["2026-01"] == [CategoryChange("food", "decreased", 1000, 500)]
+
+
+def test_gap_month_is_not_compared_as_all_new():
+    # 2026-10 has no records, so 2026-11 has no previous month to compare with.
+    totals = {
+        "2026-09": {"food": 1000},
+        "2026-11": {"food": 1000, "rent": 80000},
+    }
+    result = month_over_month(totals)
+    assert result == {}
+
+
+def test_end_to_end_from_expenses():
+    rows = [
+        Expense(date(2026, 10, 1), "food", 1000),
+        Expense(date(2026, 10, 2), "rent", 80000),
+        Expense(date(2026, 11, 1), "food", 1500),
+        Expense(date(2026, 11, 3), "food", 300),
+    ]
+    result = month_over_month(monthly_totals(rows))
+    assert result["2026-11"] == [
+        CategoryChange("rent", "removed", 80000, 0),
+        CategoryChange("food", "increased", 1000, 1800),
+    ]
