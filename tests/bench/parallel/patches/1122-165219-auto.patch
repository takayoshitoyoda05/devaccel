@@ -1,7 +1,58 @@
+import enum
+
+import pytest
+
 import click
+from click.testing import CliRunner
 
 
 def test_choice_get_invalid_choice_message():
     choice = click.Choice(["a", "b", "c"])
     message = choice.get_invalid_choice_message("d", ctx=None)
     assert message == "'d' is not one of 'a', 'b', 'c'."
+
+
+@pytest.mark.parametrize(
+    ("choices", "value", "suggestion"),
+    [
+        (["json", "yaml", "toml"], "jsno", "Did you mean 'json'?"),
+        (["json", "jsonl", "yaml"], "jsn", "(Did you mean one of: 'json', 'jsonl'?)"),
+        (["a", "b", "c"], "d", None),
+        (["json"], "xml", None),
+    ],
+)
+def test_invalid_choice_suggestion(choices, value, suggestion):
+    message = click.Choice(choices).get_invalid_choice_message(value, ctx=None)
+    if suggestion is None:
+        assert "Did you mean" not in message
+    else:
+        assert message.endswith(f" {suggestion}")
+
+
+def test_invalid_choice_suggestion_case_insensitive():
+    choice = click.Choice(["Json", "Yaml"], case_sensitive=False)
+    message = choice.get_invalid_choice_message("JSNO", ctx=None)
+    assert message.endswith("Did you mean 'json'?")
+
+
+def test_invalid_choice_suggestion_enum_and_non_str():
+    class Fmt(enum.Enum):
+        JSON = 1
+
+    assert "Did you mean 'JSON'?" in click.Choice(Fmt).get_invalid_choice_message(
+        "JSOM", ctx=None
+    )
+    assert "Did you mean '10'?" in click.Choice([10, 20]).get_invalid_choice_message(
+        100, ctx=None
+    )
+
+
+def test_invalid_choice_suggestion_cli():
+    @click.command()
+    @click.option("--fmt", type=click.Choice(["json", "yaml"]))
+    def cli(fmt):
+        pass
+
+    result = CliRunner().invoke(cli, ["--fmt", "jsno"])
+    assert result.exit_code == 2
+    assert "'jsno' is not one of 'json', 'yaml'. Did you mean 'json'?" in result.output
