+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,88 @@
+"""Detect recurring expenses (monthly subscriptions, rent, etc.). Pure functions."""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from collections import defaultdict
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_WS = re.compile(r"\s+")
+_TRAILING_NUMBER = re.compile(r"(?:\s*#\d+|\s+\d+|-\d+)$")
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo_key: str
+    amount: int  # latest amount in the series
+    day_of_month: int  # max day within the series
+    last_date: date  # latest date in the series
+    occurrences: int  # series length
+
+
+def memo_key(memo: str) -> str:
+    """Normalize a memo: NFKC, casefold, collapse spaces, drop trailing number."""
+    s = unicodedata.normalize("NFKC", memo).casefold().strip()
+    s = _WS.sub(" ", s)
+    return _TRAILING_NUMBER.sub("", s).strip()
+
+
+def _prev_month(ym: tuple[int, int]) -> tuple[int, int]:
+    y, m = ym
+    return (y - 1, 12) if m == 1 else (y, m - 1)
+
+
+def find_recurring(rows: list[Expense], *, min_occurrences: int = 3) -> list[Recurring]:
+    if min_occurrences < 2:
+        raise ValueError("min_occurrences は 2 以上である必要があります")
+
+    groups: dict[tuple[str, str], list[Expense]] = defaultdict(list)
+    for e in rows:
+        if e.amount <= 0:
+            continue
+        groups[(e.category.strip(), memo_key(e.memo))].append(e)
+
+    out: list[Recurring] = []
+    for (category, key), entries in groups.items():
+        entries.sort(key=lambda e: e.day)
+        months = [(e.day.year, e.day.month) for e in entries]
+        if len(set(months)) != len(months):
+            continue  # 同じ月に 2 件以上 → 定期ではない
+        by_month = dict(zip(months, entries))
+
+        latest = entries[-1]
+        series: list[Expense] = []
+        ym: tuple[int, int] | None = months[-1]
+        while ym is not None and ym in by_month:
+            e = by_month[ym]
+            if abs(e.amount - latest.amount) * 10 > latest.amount:
+                break  # ±10% を超えた
+            series.append(e)
+            ym = _prev_month(ym)
+
+        if len(series) >= min_occurrences:
+            out.append(
+                Recurring(
+                    category=category,
+                    memo_key=key,
+                    amount=latest.amount,
+                    day_of_month=max(e.day.day for e in series),
+                    last_date=latest.day,
+                    occurrences=len(series),
+                )
+            )
+
+    out.sort(key=lambda r: (-r.amount, r.category, r.memo_key))
+    return out
+
+
+def next_due(r: Recurring) -> date:
+    y, m = r.last_date.year, r.last_date.month
+    y, m = (y + 1, 1) if m == 12 else (y, m + 1)
+    last_day = calendar.monthrange(y, m)[1]
+    return date(y, m, min(r.day_of_month, last_day))
