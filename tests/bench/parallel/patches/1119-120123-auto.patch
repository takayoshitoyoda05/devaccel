+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    AmountBetween,
+    And,
+    Category,
+    DateBetween,
+    MemoContains,
+    Not,
+    Or,
+    matches,
+    search,
+)
+
+
+def ex(
+    amount: int = 500,
+    category: str = "食費",
+    memo: str = "",
+    day: date = date(2026, 1, 15),
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- 例の表 (E3-*) ---
+
+
+@pytest.mark.parametrize(
+    "amounts, expected",
+    [
+        pytest.param([999, 1000, 1001], [1000], id="E3-1"),
+    ],
+)
+def test_E3_1_amount_between_equal_bounds(
+    amounts: list[int], expected: list[int]
+) -> None:
+    rows = [ex(amount=a) for a in amounts]
+    got = [e.amount for e in search(rows, AmountBetween(1000, 1000))]
+    assert got == expected
+
+
+@pytest.mark.parametrize(
+    "cond, expected_count",
+    [
+        pytest.param(And(()), 3, id="E3-2-and"),
+        pytest.param(Or(()), 0, id="E3-2-or"),
+    ],
+)
+def test_E3_2_empty_and_or(cond: And | Or, expected_count: int) -> None:
+    rows = [ex(), ex(), ex()]
+    assert len(search(rows, cond)) == expected_count
+
+
+@pytest.mark.parametrize(
+    "memo, text",
+    [
+        pytest.param("NETFLIX 2026", "ｎｅｔｆｌｉｘ", id="E3-3"),
+    ],
+)
+def test_E3_3_memo_nfkc_casefold(memo: str, text: str) -> None:
+    assert matches(ex(memo=memo), MemoContains(text))
+
+
+# --- 規則ごとの端のケース ---
+
+
+def test_R1_category_exact_match_case_sensitive_and_stripped() -> None:
+    assert matches(ex(category="食費"), Category(("食費",)))
+    assert matches(ex(category="  食費 "), Category(("食費",)))
+    assert not matches(ex(category="食費"), Category(("外食",)))
+    assert not matches(ex(category="Food"), Category(("food",)))
+    assert matches(ex(category="Food"), Category(("外食", "Food")))
+
+
+def test_R1_empty_names_raises() -> None:
+    with pytest.raises(ValueError):
+        Category(())
+
+
+@pytest.mark.parametrize(
+    "amount, expected",
+    [(999, False), (1000, True), (1500, True), (2000, True), (2001, False)],
+)
+def test_R2_amount_bounds_inclusive(amount: int, expected: bool) -> None:
+    assert matches(ex(amount=amount), AmountBetween(1000, 2000)) is expected
+
+
+def test_R2_open_bounds_and_both_none() -> None:
+    assert matches(ex(amount=-5), AmountBetween(None, 0))
+    assert not matches(ex(amount=1), AmountBetween(None, 0))
+    assert matches(ex(amount=10**9), AmountBetween(0, None))
+    assert matches(ex(amount=-(10**9)), AmountBetween(None, None))
+
+
+def test_R2_amount_min_greater_than_max_raises() -> None:
+    with pytest.raises(ValueError):
+        AmountBetween(1001, 1000)
+
+
+@pytest.mark.parametrize(
+    "day, expected",
+    [
+        (date(2026, 1, 1), True),
+        (date(2026, 1, 31), True),
+        (date(2025, 12, 31), False),
+        (date(2026, 2, 1), False),
+    ],
+)
+def test_R2_date_bounds_inclusive(day: date, expected: bool) -> None:
+    cond = DateBetween(date(2026, 1, 1), date(2026, 1, 31))
+    assert matches(ex(day=day), cond) is expected
+
+
+def test_R2_date_both_none_matches_all() -> None:
+    assert matches(ex(day=date(1999, 5, 5)), DateBetween())
+
+
+def test_R2_date_start_after_end_raises() -> None:
+    with pytest.raises(ValueError):
+        DateBetween(date(2026, 2, 1), date(2026, 1, 1))
+
+
+def test_R3_memo_partial_match() -> None:
+    assert matches(ex(memo="Netflix 2026年1月"), MemoContains("flix"))
+    assert not matches(ex(memo="Spotify"), MemoContains("netflix"))
+
+
+def test_R3_empty_text_raises() -> None:
+    with pytest.raises(ValueError):
+        MemoContains("")
+
+
+def test_R4_and_requires_all_or_requires_any() -> None:
+    e = ex(amount=500, category="食費")
+    yes = Category(("食費",))
+    no = AmountBetween(1000, None)
+    assert not matches(e, And((yes, no)))
+    assert matches(e, Or((yes, no)))
+    assert matches(e, And((yes, Not(no))))
+
+
+def test_R4_not_inverts() -> None:
+    e = ex(amount=500)
+    assert matches(e, Not(AmountBetween(1000, None)))
+    assert not matches(e, Not(AmountBetween(0, None)))
+
+
+def test_R4_nested_deep() -> None:
+    e = ex(amount=500, category="食費", memo="lunch")
+    cond = Not(
+        Or(
+            (
+                And((Category(("外食",)), MemoContains("lunch"))),
+                Not(And((AmountBetween(0, 1000), MemoContains("lunch")))),
+            )
+        )
+    )
+    # 内側: Or(False, Not(True)) = False -> Not(False) = True
+    assert matches(e, cond)
+
+
+def test_R5_search_keeps_order_and_duplicates_and_does_not_mutate() -> None:
+    a = ex(amount=100, memo="a")
+    b = ex(amount=200, memo="b")
+    rows = [b, a, b, a]
+    snapshot = list(rows)
+    got = search(rows, AmountBetween(0, None))
+    assert got == [b, a, b, a]
+    assert rows == snapshot
+
+
+def test_R5_search_returns_new_list() -> None:
+    rows = [ex()]
+    got = search(rows, And(()))
+    assert got == rows
+    assert got is not rows
+
+
+def test_R6_non_condition_raises_type_error() -> None:
+    with pytest.raises(TypeError):
+        matches(ex(), "食費")  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        matches(ex(), And((123,)))  # type: ignore[arg-type]
