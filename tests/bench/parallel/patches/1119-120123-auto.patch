@@ -0,0 +1,136 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthly_diff import CategoryChange, compare_months, format_report
+
+
+def _e(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+# E4-1: 前月 食費 30000、今月 食費 33000 -> increased
+# E4-2: 前月 交通 5000、今月に交通なし -> gone
+# E4-3: "2026-13" -> ValueError
+
+
+@pytest.mark.parametrize(
+    ("rows", "month", "expected"),
+    [
+        pytest.param(
+            [_e("2025-12-05", "食費", 30000), _e("2026-01-05", "食費", 33000)],
+            "2026-01",
+            [CategoryChange("食費", 30000, 33000, 3000, 10.0, "increased")],
+            id="E4-1",
+        ),
+        pytest.param(
+            [_e("2025-12-05", "交通", 5000), _e("2026-01-05", "食費", 100)],
+            "2026-01",
+            [
+                CategoryChange("交通", 5000, 0, -5000, -100.0, "gone"),
+                CategoryChange("食費", 0, 100, 100, None, "new"),
+            ],
+            id="E4-2",
+        ),
+    ],
+)
+def test_compare_months_examples(
+    rows: list[Expense], month: str, expected: list[CategoryChange]
+) -> None:
+    assert compare_months(rows, month) == expected
+
+
+def test_E4_3_invalid_month_raises() -> None:
+    with pytest.raises(ValueError):
+        compare_months([], "2026-13")
+
+
+@pytest.mark.parametrize("bad", ["2026-1", "26-01", "2026/01", "2026-00", ""])
+def test_invalid_month_format_raises(bad: str) -> None:
+    with pytest.raises(ValueError):
+        compare_months([], bad)
+
+
+def test_previous_month_wraps_year() -> None:
+    rows = [_e("2025-12-01", "食費", 1000), _e("2026-01-01", "食費", 1000)]
+    [c] = compare_months(rows, "2026-01")
+    assert c.previous == 1000
+    assert c.status == "unchanged"
+
+
+def test_both_months_empty_returns_empty() -> None:
+    assert compare_months([], "2026-01") == []
+
+
+def test_zero_both_sides_category_omitted() -> None:
+    rows = [_e("2025-12-01", "食費", 0), _e("2026-01-01", "食費", 0)]
+    assert compare_months(rows, "2026-01") == []
+
+
+def test_decreased_status_and_pct() -> None:
+    rows = [_e("2025-12-01", "食費", 40000), _e("2026-01-01", "食費", 30000)]
+    [c] = compare_months(rows, "2026-01")
+    assert c.delta == -10000
+    assert c.pct == -25.0
+    assert c.status == "decreased"
+
+
+def test_unchanged_status() -> None:
+    rows = [_e("2025-12-01", "食費", 500), _e("2026-01-01", "食費", 500)]
+    [c] = compare_months(rows, "2026-01")
+    assert c.delta == 0
+    assert c.status == "unchanged"
+
+
+def test_sorted_by_abs_delta_desc_then_category_asc() -> None:
+    rows = [
+        _e("2025-12-01", "b", 1000),
+        _e("2026-01-01", "b", 1000 + 500),  # |delta| 500
+        _e("2025-12-01", "a", 1000),
+        _e("2026-01-01", "a", 1000 - 500),  # |delta| 500, tie -> "a" first
+        _e("2026-01-01", "c", 2000),  # new, |delta| 2000
+    ]
+    assert [c.category for c in compare_months(rows, "2026-01")] == ["c", "a", "b"]
+
+
+def test_other_months_are_ignored() -> None:
+    rows = [
+        _e("2025-11-01", "食費", 999),
+        _e("2025-12-01", "食費", 100),
+        _e("2026-01-01", "食費", 200),
+        _e("2026-02-01", "食費", 5000),
+    ]
+    [c] = compare_months(rows, "2026-01")
+    assert (c.previous, c.current) == (100, 200)
+
+
+def test_format_report_with_changes() -> None:
+    changes = [
+        CategoryChange("食費", 30000, 33000, 3000, 10.0, "increased"),
+        CategoryChange("食費2", 0, 100, 100, None, "new"),
+    ]
+    assert format_report("2026-01", changes) == (
+        "2026-01 の前月比\n"
+        "食費: 30000円 → 33000円 (+3000円, +10.0%)\n"
+        "食費2: 0円 → 100円 (新規, +100円)"
+    )
+
+
+def test_format_report_negative_delta() -> None:
+    changes = [CategoryChange("交通", 5000, 0, -5000, -100.0, "gone")]
+    assert format_report("2026-01", changes).splitlines()[1] == (
+        "交通: 5000円 → 0円 (-5000円, -100.0%)"
+    )
+
+
+def test_format_report_empty() -> None:
+    assert format_report("2026-01", []) == "2026-01 の前月比\n変化なし"
+
+
+def test_category_change_is_frozen() -> None:
+    c = CategoryChange("食費", 0, 1, 1, None, "new")
+    with pytest.raises(AttributeError):
+        c.delta = 5  # type: ignore[misc]
