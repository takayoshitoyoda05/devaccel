@@ -0,0 +1,226 @@
+"""Bank CSV import: parse statement text into expenses. Pure (no file I/O)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+from typing import Any
+
+from kakeibo.core import Expense
+
+
+class ImportFormatError(ValueError):
+    """Raised when the header is missing or lacks a required column."""
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str
+    value: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+    skipped: list[int]
+
+
+def _norm(name: str) -> str:
+    return name.strip().casefold()
+
+
+def _aliases(*names: str) -> frozenset[str]:
+    return frozenset(_norm(n) for n in names)
+
+
+_DATE_ALIASES = _aliases("date", "日付", "利用日", "取引日", "ご利用日")
+_AMOUNT_ALIASES = _aliases(
+    "amount",
+    "金額",
+    "利用金額",
+    "ご利用金額",
+    "出金額",
+    "出金",
+    "支払金額",
+    "お支払金額",
+)
+_DEPOSIT_ALIASES = _aliases("入金額", "入金", "預入", "預入金額")
+_MEMO_ALIASES = _aliases(
+    "memo", "摘要", "メモ", "利用店名", "ご利用店名", "内容", "description"
+)
+_CATEGORY_ALIASES = _aliases("category", "カテゴリ", "分類", "費目")
+
+_NEWLINE_RE = re.compile(r"\r\n|\n|\r")
+
+_DATE_RE = re.compile(
+    r"(?:(?P<y1>[0-9]{4})(?P<s>[-/.])(?P<m1>[0-9]{1,2})(?P=s)(?P<d1>[0-9]{1,2})"
+    r"|(?P<y2>[0-9]{4})年(?P<m2>[0-9]{1,2})月(?P<d2>[0-9]{1,2})日"
+    r"|(?P<y3>[0-9]{4})(?P<m3>[0-9]{2})(?P<d3>[0-9]{2}))"
+    r"(?:[ \t]+.*|T.*)?",
+    re.DOTALL,
+)
+
+_AMOUNT_JUNK_RE = re.compile(r"JPY|¥|円|,|\s", re.IGNORECASE)
+_DIGITS_RE = re.compile(r"[0-9]+")
+
+
+def _delimiter(text: str) -> str:
+    first_line = _NEWLINE_RE.split(text, maxsplit=1)[0]
+    return "\t" if "\t" in first_line else ","
+
+
+def _records(reader: Any) -> list[tuple[int, list[str]]]:
+    """Non-blank records as (start line, cells). Start line is 1-based.
+
+    reader は csv.reader(...)(line_num を持つ)。
+    """
+    out: list[tuple[int, list[str]]] = []
+    while True:
+        start = reader.line_num + 1
+        try:
+            row = next(reader)
+        except StopIteration:
+            return out
+        if row == [] or (len(row) == 1 and row[0].strip() == ""):
+            continue
+        out.append((start, row))
+
+
+def _find(keys: list[str], aliases: frozenset[str]) -> int | None:
+    for i, key in enumerate(keys):
+        if key in aliases:
+            return i
+    return None
+
+
+def _parse_date(raw: str) -> tuple[date | None, str | None]:
+    s = unicodedata.normalize("NFKC", raw).strip()
+    if s == "":
+        return None, "空欄"
+    m = _DATE_RE.fullmatch(s)
+    if m is None:
+        return None, "日付の形式が不正"
+    parts: tuple[int, int, int] | None = None
+    for ys, ms, ds in (("y1", "m1", "d1"), ("y2", "m2", "d2"), ("y3", "m3", "d3")):
+        if m.group(ys) is not None:
+            parts = (int(m.group(ys)), int(m.group(ms)), int(m.group(ds)))
+            break
+    if parts is None:
+        return None, "日付の形式が不正"
+    try:
+        return date(*parts), None
+    except ValueError:
+        return None, "存在しない日付"
+
+
+def _parse_amount(raw: str) -> tuple[int | None, str | None]:
+    if raw.strip() == "":
+        return None, "空欄"
+    s = unicodedata.normalize("NFKC", raw).replace("−", "-")
+    s = _AMOUNT_JUNK_RE.sub("", s)
+    negative = False
+    if s[:1] in ("-", "△", "▲"):
+        negative = True
+        s = s[1:]
+    elif s.endswith("-"):
+        negative = True
+        s = s[:-1]
+    elif s.startswith("(") and s.endswith(")"):
+        negative = True
+        s = s[1:-1]
+    if _DIGITS_RE.fullmatch(s) is None:
+        return None, "金額の形式が不正"
+    value = int(s)
+    return (-value if negative else value), None
+
+
+def import_csv(text: str) -> ImportResult:
+    text = text.removeprefix("﻿")
+    delim = _delimiter(text)
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delim)
+    records = _records(reader)
+    if not records:
+        return ImportResult([], [], [])
+
+    _, header = records[0]
+    names = [c.strip() for c in header]
+    keys = [_norm(c) for c in names]
+    date_i = _find(keys, _DATE_ALIASES)
+    amount_i = _find(keys, _AMOUNT_ALIASES)
+    if date_i is None or amount_i is None:
+        missing = [
+            label
+            for label, idx in (("日付", date_i), ("金額", amount_i))
+            if idx is None
+        ]
+        raise ImportFormatError(f"必須列がありません: {', '.join(missing)}")
+    deposit_i = _find(keys, _DEPOSIT_ALIASES)
+    memo_i = _find(keys, _MEMO_ALIASES)
+    category_i = _find(keys, _CATEGORY_ALIASES)
+
+    width = len(header)
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    skipped: list[int] = []
+    for line, row in records[1:]:
+        if len(row) != width:
+            errors.append(
+                RowError(
+                    line,
+                    "",
+                    delim.join(row),
+                    f"列数が一致しません: 期待 {width} 列、実際 {len(row)} 列",
+                )
+            )
+            continue
+
+        found: list[tuple[int, RowError]] = []
+        day, reason = _parse_date(row[date_i])
+        if reason is not None or day is None:
+            found.append(
+                (
+                    date_i,
+                    RowError(line, names[date_i], row[date_i], reason or "空欄"),
+                )
+            )
+
+        deposit_only = (
+            deposit_i is not None
+            and row[amount_i].strip() == ""
+            and row[deposit_i].strip() != ""
+        )
+        amount: int | None = None
+        if not deposit_only:
+            amount, reason = _parse_amount(row[amount_i])
+            if reason is not None or amount is None:
+                found.append(
+                    (
+                        amount_i,
+                        RowError(
+                            line, names[amount_i], row[amount_i], reason or "空欄"
+                        ),
+                    )
+                )
+
+        if found:
+            errors.extend(err for _, err in sorted(found, key=lambda p: p[0]))
+        elif deposit_only:
+            skipped.append(line)
+        else:
+            assert day is not None and amount is not None
+            category = row[category_i].strip() if category_i is not None else "未分類"
+            memo = (
+                unicodedata.normalize("NFKC", row[memo_i]).strip()
+                if memo_i is not None
+                else ""
+            )
+            expenses.append(Expense(day, category, amount, memo))
+
+    return ImportResult(expenses, errors, skipped)
