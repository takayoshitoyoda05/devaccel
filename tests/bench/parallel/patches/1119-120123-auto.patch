@@ -0,0 +1,83 @@
+"""Month-over-month comparison of expenses by category (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense, monthly_totals
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _previous_month(month: str) -> str:
+    year, mon = int(month[:4]), int(month[5:])
+    if mon == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mon - 1:02d}"
+
+
+def _status(previous: int, current: int, delta: int) -> str:
+    if previous == 0 and current != 0:
+        return "new"
+    if current == 0 and previous != 0:
+        return "gone"
+    if delta > 0:
+        return "increased"
+    if delta < 0:
+        return "decreased"
+    return "unchanged"
+
+
+def compare_months(rows: list[Expense], month: str) -> list[CategoryChange]:
+    """Compare `month` (YYYY-MM) with the calendar month before it."""
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+    prev_month = _previous_month(month)
+    totals = monthly_totals(rows)
+    prev_cats = totals.get(prev_month, {})
+    cur_cats = totals.get(month, {})
+
+    changes: list[CategoryChange] = []
+    for category in set(prev_cats) | set(cur_cats):
+        previous = prev_cats.get(category, 0)
+        current = cur_cats.get(category, 0)
+        if previous == 0 and current == 0:
+            continue
+        delta = current - previous
+        pct = None if previous == 0 else round(delta / previous * 100, 1)
+        changes.append(
+            CategoryChange(
+                category=category,
+                previous=previous,
+                current=current,
+                delta=delta,
+                pct=pct,
+                status=_status(previous, current, delta),
+            )
+        )
+    changes.sort(key=lambda c: (-abs(c.delta), c.category))
+    return changes
+
+
+def format_report(month: str, changes: list[CategoryChange]) -> str:
+    lines = [f"{month} の前月比"]
+    if not changes:
+        lines.append("変化なし")
+    for c in changes:
+        head = f"{c.category}: {c.previous}円 → {c.current}円"
+        if c.pct is None:
+            lines.append(f"{head} (新規, {c.delta:+d}円)")
+        else:
+            lines.append(f"{head} ({c.delta:+d}円, {c.pct:+.1f}%)")
+    return "\n".join(lines)
