+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, memo_key, next_due
+
+
+def _e(
+    y: int,
+    m: int,
+    d: int,
+    amount: int,
+    memo: str = "netflix",
+    category: str = "サブスク",
+) -> Expense:
