+++ b/src/kakeibo/search.py
@@ -0,0 +1,96 @@
+"""Expense search with a composable condition tree (pure functions)."""
+
+from __future__ import annotations
+
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def _norm(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).casefold()
+
+
+@dataclass(frozen=True)
+class Category:
+    names: tuple[str, ...]
+
+    def __post_init__(self) -> None:
+        if not self.names:
+            raise ValueError("Category.names は 1 つ以上必要です")
+
+
+@dataclass(frozen=True)
+class AmountBetween:
+    min: int | None = None
+    max: int | None = None
+
+    def __post_init__(self) -> None:
+        if self.min is not None and self.max is not None and self.min > self.max:
+            raise ValueError("AmountBetween: 下限が上限より大きいです")
+
+
+@dataclass(frozen=True)
+class MemoContains:
+    text: str
+
+    def __post_init__(self) -> None:
+        if self.text == "":
+            raise ValueError("MemoContains.text は空文字にできません")
+
+
+@dataclass(frozen=True)
+class DateBetween:
+    start: date | None = None
+    end: date | None = None
+
+    def __post_init__(self) -> None:
+        if self.start is not None and self.end is not None and self.start > self.end:
+            raise ValueError("DateBetween: 開始日が終了日より後です")
+
+
+@dataclass(frozen=True)
+class And:
+    conds: tuple[Condition, ...]
+
+
+@dataclass(frozen=True)
+class Or:
+    conds: tuple[Condition, ...]
+
+
+@dataclass(frozen=True)
+class Not:
+    cond: Condition
+
+
+Condition = Category | AmountBetween | MemoContains | DateBetween | And | Or | Not
+
+
+def matches(e: Expense, cond: Condition) -> bool:
+    if isinstance(cond, Category):
+        cat = e.category.strip()
+        return any(cat == name.strip() for name in cond.names)
+    if isinstance(cond, AmountBetween):
+        return (cond.min is None or e.amount >= cond.min) and (
+            cond.max is None or e.amount <= cond.max
+        )
+    if isinstance(cond, MemoContains):
+        return _norm(cond.text) in _norm(e.memo)
+    if isinstance(cond, DateBetween):
+        return (cond.start is None or e.day >= cond.start) and (
+            cond.end is None or e.day <= cond.end
+        )
+    if isinstance(cond, And):
+        return all(matches(e, c) for c in cond.conds)
+    if isinstance(cond, Or):
+        return any(matches(e, c) for c in cond.conds)
+    if isinstance(cond, Not):
+        return not matches(e, cond.cond)
+    raise TypeError(f"Condition ではありません: {cond!r}")
+
+
+def search(rows: list[Expense], cond: Condition) -> list[Expense]:
+    return [e for e in rows if matches(e, cond)]
