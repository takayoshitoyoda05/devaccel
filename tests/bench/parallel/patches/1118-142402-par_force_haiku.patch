+++ b/src/kakeibo/topn.py
@@ -0,0 +1,18 @@
+"""Top-N expenses by amount."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def top_expenses(rows: list[Expense], n: int) -> list[Expense]:
+    """Return up to n expenses, largest amount first.
+
+    Ties are broken by earlier date first; equal date and amount keep input order.
+    Returns [] when n <= 0.
+    """
+    if n <= 0:
+        return []
+    # sorted() is stable, so full ties keep their input order.
+    ordered = sorted(rows, key=lambda e: (-e.amount, e.day))
+    return ordered[:n]
