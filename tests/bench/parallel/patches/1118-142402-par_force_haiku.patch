@@ -0,0 +1,16 @@
+"""Totals grouped by day of the week."""
+
+from __future__ import annotations
+
+from .core import Expense
+
+WEEKDAYS = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
+
+
+def total_by_weekday(rows: list[Expense]) -> dict[str, int]:
+    """{"Mon".."Sun": yen}, Monday-first order; weekdays without expenses are omitted."""
+    sums: dict[str, int] = {}
+    for e in rows:
+        name = WEEKDAYS[e.day.weekday()]
+        sums[name] = sums.get(name, 0) + e.amount
+    return {name: sums[name] for name in WEEKDAYS if name in sums}
