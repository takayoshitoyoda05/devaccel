+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.weekday import total_by_weekday
+
+
+def _e(day: date, amount: int) -> Expense:
+    return Expense(day=day, category="food", amount=amount)
+
+
+def test_empty_rows_returns_empty_dict() -> None:
+    assert total_by_weekday([]) == {}
+
+
+def test_sums_same_weekday_across_dates() -> None:
+    # 2026-11-16 is a Monday, 2026-11-23 is a Monday
+    rows = [_e(date(2026, 11, 16), 100), _e(date(2026, 11, 23), 250)]
+    assert total_by_weekday(rows) == {"Mon": 350}
+
+
+def test_omits_weekdays_without_expenses() -> None:
+    rows = [_e(date(2026, 11, 18), 500)]  # Wednesday
+    assert total_by_weekday(rows) == {"Wed": 500}
+
+
+def test_keys_are_in_monday_first_order() -> None:
+    rows = [
+        _e(date(2026, 11, 22), 1),  # Sun
+        _e(date(2026, 11, 18), 2),  # Wed
+        _e(date(2026, 11, 16), 3),  # Mon
+        _e(date(2026, 11, 20), 4),  # Fri
+    ]
+    result = total_by_weekday(rows)
+    assert list(result) == ["Mon", "Wed", "Fri", "Sun"]
+    assert result == {"Mon": 3, "Wed": 2, "Fri": 4, "Sun": 1}
+
+
+def test_all_seven_weekdays() -> None:
+    # 2026-11-16 (Mon) through 2026-11-22 (Sun)
+    rows = [_e(date(2026, 11, 16 + i), 10 * (i + 1)) for i in range(7)]
+    result = total_by_weekday(rows)
+    assert list(result) == ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
+    assert list(result.values()) == [10, 20, 30, 40, 50, 60, 70]
