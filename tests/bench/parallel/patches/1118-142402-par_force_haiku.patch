+import pytest
+
+from kakeibo.split import split_evenly
+
+
+def test_even_split() -> None:
+    assert split_evenly(3000, 3) == [1000, 1000, 1000]
+
+
+def test_remainder_goes_to_first_people() -> None:
+    assert split_evenly(10, 3) == [4, 3, 3]
+
+
+def test_one_person_gets_everything() -> None:
+    assert split_evenly(1234, 1) == [1234]
+
+
+def test_amount_smaller_than_people() -> None:
+    assert split_evenly(2, 5) == [1, 1, 0, 0, 0]
+
+
+def test_zero_amount() -> None:
+    assert split_evenly(0, 4) == [0, 0, 0, 0]
+
+
+@pytest.mark.parametrize("amount,people", [(1, 1), (7, 2), (99999, 7), (0, 3), (5, 13)])
+def test_sum_matches_amount(amount: int, people: int) -> None:
+    parts = split_evenly(amount, people)
+    assert sum(parts) == amount
+    assert len(parts) == people
+    assert max(parts) - min(parts) <= 1
+
+
+@pytest.mark.parametrize("people", [0, -1])
+def test_people_below_one_raises(people: int) -> None:
+    with pytest.raises(ValueError):
+        split_evenly(1000, people)
