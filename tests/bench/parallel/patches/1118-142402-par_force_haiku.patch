@@ -0,0 +1,55 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.topn import top_expenses
+
+
+def _e(day: str, amount: int, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category="food", amount=amount, memo=memo
+    )
+
+
+def test_returns_largest_first_limited_to_n() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 500), _e("2026-01-03", 300)]
+    assert [e.amount for e in top_expenses(rows, 2)] == [500, 300]
+
+
+def test_ties_broken_by_earlier_date() -> None:
+    rows = [_e("2026-02-01", 200), _e("2026-01-15", 200), _e("2026-03-01", 200)]
+    assert [e.day for e in top_expenses(rows, 3)] == [
+        date(2026, 1, 15),
+        date(2026, 2, 1),
+        date(2026, 3, 1),
+    ]
+
+
+def test_full_ties_keep_input_order() -> None:
+    rows = [
+        _e("2026-01-01", 100, "a"),
+        _e("2026-01-01", 100, "b"),
+        _e("2026-01-01", 100, "c"),
+    ]
+    assert [e.memo for e in top_expenses(rows, 3)] == ["a", "b", "c"]
+
+
+def test_n_zero_or_negative_returns_empty() -> None:
+    rows = [_e("2026-01-01", 100)]
+    assert top_expenses(rows, 0) == []
+    assert top_expenses(rows, -1) == []
+
+
+def test_n_larger_than_rows_returns_all_sorted() -> None:
+    rows = [_e("2026-01-02", 50), _e("2026-01-01", 80)]
+    assert [e.amount for e in top_expenses(rows, 10)] == [80, 50]
+
+
+def test_empty_input() -> None:
+    assert top_expenses([], 3) == []
+
+
+def test_does_not_mutate_input() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 500)]
+    snapshot = list(rows)
+    top_expenses(rows, 2)
+    assert rows == snapshot
