+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.streak import longest_no_spend_streak
+
+
+def _e(day: date) -> Expense:
+    return Expense(day=day, category="食費", amount=100)
+
+
+def test_no_rows_whole_period_is_streak() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 1), date(2026, 1, 5)) == 5
+
+
+def test_single_day_period_without_spend() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 1), date(2026, 1, 1)) == 1
+
+
+def test_single_day_period_with_spend() -> None:
+    rows = [_e(date(2026, 1, 1))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 1)) == 0
+
+
+def test_longest_gap_between_spends() -> None:
+    rows = [_e(date(2026, 1, 2)), _e(date(2026, 1, 3)), _e(date(2026, 1, 7))]
+    # 1/1 の 1 日, 1/4〜1/6 の 3 日, 1/8 の 1 日 -> 最長は 3
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 8)) == 3
+
+
+def test_both_ends_inclusive_at_start() -> None:
+    rows = [_e(date(2026, 1, 3))]
+    # 1/1, 1/2 が空き -> 2
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 5)) == 2
+
+
+def test_both_ends_inclusive_at_end() -> None:
+    rows = [_e(date(2026, 1, 3))]
+    # 1/4, 1/5 が空き -> 2
+    assert longest_no_spend_streak(rows, date(2026, 1, 3), date(2026, 1, 5)) == 2
+
+
+def test_spends_outside_period_are_ignored() -> None:
+    rows = [_e(date(2025, 12, 31)), _e(date(2026, 2, 1))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 3)) == 3
+
+
+def test_multiple_expenses_same_day_count_as_one_spend_day() -> None:
+    rows = [_e(date(2026, 1, 2)), _e(date(2026, 1, 2))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 3)) == 1
+
+
+def test_start_after_end_returns_zero() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 5), date(2026, 1, 1)) == 0
+
+
+def test_streak_crosses_month_boundary() -> None:
+    rows = [_e(date(2026, 1, 30))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 25), date(2026, 2, 5)) == 6
diff --git a/tests/test_topn.py b/tests/test_topn.py
