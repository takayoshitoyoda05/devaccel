@@ -0,0 +1,49 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.dupes import find_duplicates
+
+
+def _e(day: int, cat: str, amount: int, memo: str = "") -> Expense:
+    return Expense(date(2026, 1, day), cat, amount, memo)
+
+
+def test_empty_and_no_duplicates() -> None:
+    assert find_duplicates([]) == []
+    assert find_duplicates([_e(1, "food", 100), _e(2, "food", 100)]) == []
+
+
+def test_single_pair() -> None:
+    rows = [_e(1, "food", 100, "a"), _e(1, "food", 100, "a")]
+    assert find_duplicates(rows) == [(0, 1)]
+
+
+def test_differs_in_any_field_is_not_duplicate() -> None:
+    base = _e(1, "food", 100, "a")
+    others = [
+        _e(2, "food", 100, "a"),
+        _e(1, "rent", 100, "a"),
+        _e(1, "food", 200, "a"),
+        _e(1, "food", 100, "b"),
+    ]
+    assert find_duplicates([base, *others]) == []
+
+
+def test_group_of_three_yields_all_pairs_in_order() -> None:
+    rows = [_e(1, "food", 100), _e(3, "x", 5), _e(1, "food", 100), _e(1, "food", 100)]
+    assert find_duplicates(rows) == [(0, 2), (0, 3), (2, 3)]
+
+
+def test_interleaved_groups_sorted_by_i_then_j() -> None:
+    a = _e(1, "food", 100)
+    b = _e(2, "rent", 900)
+    rows = [a, b, b, a, b]
+    assert find_duplicates(rows) == [(0, 3), (1, 2), (1, 4), (2, 4)]
+
+
+def test_memo_default_compared() -> None:
+    rows = [
+        Expense(date(2026, 1, 1), "food", 100),
+        Expense(date(2026, 1, 1), "food", 100, ""),
+    ]
+    assert find_duplicates(rows) == [(0, 1)]
