+import json
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.export import to_json
+
+
+def test_empty_list_gives_empty_array() -> None:
+    assert to_json([]) == "[]"
+
+
+def test_single_row_format_and_key_order() -> None:
+    rows = [Expense(date(2024, 3, 5), "食費", 1200, "ランチ")]
+    assert to_json(rows) == (
+        '[{"date": "2024-03-05", "category": "食費", "amount": 1200, "memo": "ランチ"}]'
+    )
+
+
+def test_keeps_input_order() -> None:
+    rows = [
+        Expense(date(2024, 1, 2), "交通費", 300),
+        Expense(date(2024, 1, 1), "食費", 800, "朝"),
+    ]
+    parsed = json.loads(to_json(rows))
+    assert [r["date"] for r in parsed] == ["2024-01-02", "2024-01-01"]
+    assert list(parsed[0].keys()) == ["date", "category", "amount", "memo"]
+
+
+def test_non_ascii_not_escaped() -> None:
+    out = to_json([Expense(date(2024, 1, 1), "娯楽", 500, "映画")])
+    assert "娯楽" in out
+    assert "\\u" not in out
+
+
+def test_empty_memo_kept_as_empty_string() -> None:
+    parsed = json.loads(to_json([Expense(date(2024, 1, 1), "食費", 100)]))
+    assert parsed[0]["memo"] == ""
+
+
+def test_amount_is_integer() -> None:
+    parsed = json.loads(to_json([Expense(date(2024, 1, 1), "食費", 1500)]))
+    assert parsed[0]["amount"] == 1500
+    assert isinstance(parsed[0]["amount"], int)
