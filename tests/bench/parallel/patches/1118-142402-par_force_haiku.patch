+"""JSON export of expense rows."""
+
+from __future__ import annotations
+
+import json
+
+from kakeibo.core import Expense
+
+
+def to_json(rows: list[Expense]) -> str:
+    """Serialize rows to a compact JSON array, keeping input order and key order."""
+    data = [
+        {
+            "date": e.day.isoformat(),
+            "category": e.category,
+            "amount": e.amount,
+            "memo": e.memo,
+        }
+        for e in rows
+    ]
+    return json.dumps(data, ensure_ascii=False, indent=None)
