diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..7439a4d 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -188,3 +188,110 @@ def test_path_type(runner, cls, expect):
 
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["a.csv", "a.TSV", "dir/A.Csv", "a.b.csv", pathlib.Path("x.tsv"), b"y.csv"],
+)
+def test_path_extensions_accepted(value):
+    type = click.Path(extensions=[".csv", ".tsv"])
+    assert type.convert(value, None, None) == value
+
+
+@pytest.mark.parametrize("value", ["a.txt", "a", "csv", "a.csv.bak", "a.csvx", ".txt"])
+def test_path_extensions_rejected(value):
+    type = click.Path(extensions=[".csv", ".tsv"])
+
+    with pytest.raises(click.BadParameter, match="must have one of these extensions"):
+        type.convert(value, None, None)
+
+
+def test_path_extensions_error_message():
+    type = click.Path(extensions=[".CSV", "tsv"])
+
+    with pytest.raises(click.BadParameter, match=r"\.csv, \.tsv\."):
+        type.convert("a.txt", None, None)
+
+
+def test_path_extensions_multi_part():
+    type = click.Path(extensions=[".tar.gz"])
+    assert type.convert("a.TAR.GZ", None, None) == "a.TAR.GZ"
+
+    with pytest.raises(click.BadParameter):
+        type.convert("a.gz", None, None)
+
+
+def test_path_extensions_checked_for_existing_file(tmp_path):
+    bad = tmp_path / "a.txt"
+    bad.touch()
+    good = tmp_path / "a.CSV"
+    good.touch()
+    type = click.Path(exists=True, extensions=[".csv"])
+
+    with pytest.raises(click.BadParameter, match="must have one of these"):
+        type.convert(os.fspath(bad), None, None)
+
+    assert type.convert(os.fspath(good), None, None) == os.fspath(good)
+
+
+def test_path_extensions_missing_file_still_checked(tmp_path):
+    type = click.Path(extensions=[".csv"])
+
+    with pytest.raises(click.BadParameter, match="must have one of these"):
+        type.convert(os.fspath(tmp_path / "missing.txt"), None, None)
+
+
+def test_path_extensions_exists_error_comes_first(tmp_path):
+    type = click.Path(exists=True, extensions=[".csv"])
+
+    with pytest.raises(click.BadParameter, match="does not exist"):
+        type.convert(os.fspath(tmp_path / "missing.txt"), None, None)
+
+
+def test_path_extensions_skips_directory(tmp_path):
+    d = tmp_path / "data.txt"
+    d.mkdir()
+    type = click.Path(extensions=[".csv"])
+    assert type.convert(os.fspath(d), None, None) == os.fspath(d)
+
+
+def test_path_extensions_skips_dash():
+    type = click.Path(allow_dash=True, extensions=[".csv"])
+    assert type.convert("-", None, None) == "-"
+
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions=[".csv"]).convert("-", None, None)
+
+
+def test_path_extensions_default_unchanged():
+    assert click.Path().convert("a.anything", None, None) == "a.anything"
+
+
+def test_path_extensions_invalid_arguments():
+    with pytest.raises(ValueError, match="extensions"):
+        click.Path(extensions=[])
+
+    with pytest.raises(ValueError, match="extensions"):
+        click.Path(extensions=[""])
+
+    with pytest.raises(ValueError, match="extensions"):
+        click.Path(extensions=["."])
+
+    with pytest.raises(TypeError, match="extensions"):
+        click.Path(extensions=".csv")  # type: ignore[arg-type]
+
+
+def test_path_extensions_cli(runner):
+    @click.command()
+    @click.argument("p", type=click.Path(extensions=[".csv", ".tsv"]))
+    def cli(p):
+        click.echo(p)
+
+    ok = runner.invoke(cli, ["data.TSV"])
+    assert ok.exit_code == 0
+    assert ok.output == "data.TSV\n"
+
+    bad = runner.invoke(cli, ["data.json"])
+    assert bad.exit_code == 2
+    assert "must have one of these extensions: .csv, .tsv." in bad.output
