@@ -0,0 +1,128 @@
+import re
+
+import pytest
+
+from kakeibo._mom_months import fill_months, previous_month
+
+
+@pytest.mark.parametrize(
+    ("month", "expected"),
+    [
+        pytest.param("2026-01", "2025-12", id="E10-1"),
+    ],
+)
+def test_previous_month_examples(month: str, expected: str) -> None:
+    assert previous_month(month) == expected
+
+
+@pytest.mark.parametrize(
+    ("totals", "expected_keys"),
+    [
+        pytest.param(
+            {"2026-01": {"a": 1}, "2026-03": {"a": 2}},
+            ["2026-01", "2026-02", "2026-03"],
+            id="E10-2",
+        ),
+    ],
+)
+def test_fill_months_examples(totals: dict, expected_keys: list[str]) -> None:
+    result = fill_months(totals)
+    assert list(result) == expected_keys
+    assert result["2026-02"] == {}
+    assert result["2026-01"] == {"a": 1}
+    assert result["2026-03"] == {"a": 2}
+
+
+@pytest.mark.parametrize(
+    ("month", "exc"),
+    [
+        pytest.param("2026-13", ValueError, id="E10-3"),
+    ],
+)
+def test_previous_month_invalid_examples(month: str, exc: type[Exception]) -> None:
+    with pytest.raises(exc):
+        previous_month(month)
+
+
+# --- 端のケース(仕様文面より) ---
+
+
+def test_previous_month_wraps_year_boundary() -> None:
+    assert previous_month("2026-12") == "2026-11"
+
+
+def test_previous_month_0001_01_is_error() -> None:
+    with pytest.raises(ValueError, match="0001-01"):
+        previous_month("0001-01")
+
+
+def test_previous_month_0002_01_gives_0001_12() -> None:
+    assert previous_month("0002-01") == "0001-12"
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        "2026-1",
+        "2026/01",
+        "２０２６-01",
+        "0000-01",
+        "2026-00",
+        "26-01",
+        " 2026-01",
+        "2026-01 ",
+    ],
+)
+def test_previous_month_rejects_malformed(bad: str) -> None:
+    with pytest.raises(ValueError, match=re.escape(repr(bad))):
+        previous_month(bad)
+
+
+def test_previous_month_rejects_non_str() -> None:
+    with pytest.raises(TypeError):
+        previous_month(202601)  # type: ignore[arg-type]
+
+
+def test_fill_months_empty_returns_empty() -> None:
+    assert fill_months({}) == {}
+
+
+def test_fill_months_single_month_unchanged() -> None:
+    assert fill_months({"2026-05": {"a": 3}}) == {"2026-05": {"a": 3}}
+
+
+def test_fill_months_crosses_year_boundary() -> None:
+    result = fill_months({"2025-11": {}, "2026-02": {"x": 1}})
+    assert list(result) == ["2025-11", "2025-12", "2026-01", "2026-02"]
+    assert result["2025-12"] == {}
+    assert result["2026-01"] == {}
+
+
+def test_fill_months_sorts_unordered_input() -> None:
+    result = fill_months({"2026-03": {"a": 2}, "2026-01": {"a": 1}})
+    assert list(result) == ["2026-01", "2026-02", "2026-03"]
+
+
+def test_fill_months_does_not_mutate_input() -> None:
+    inner = {"a": 1}
+    totals = {"2026-01": inner, "2026-03": {"b": 2}}
+    result = fill_months(totals)
+    assert totals == {"2026-01": {"a": 1}, "2026-03": {"b": 2}}
+    assert result["2026-01"] is not inner
+    result["2026-01"]["a"] = 99
+    assert inner == {"a": 1}
+
+
+def test_fill_months_rejects_non_dict_totals() -> None:
+    with pytest.raises(TypeError):
+        fill_months([("2026-01", {})])  # type: ignore[arg-type]
+
+
+def test_fill_months_rejects_non_dict_value() -> None:
+    with pytest.raises(TypeError):
+        fill_months({"2026-01": [1]})  # type: ignore[dict-item]
+
+
+def test_fill_months_rejects_invalid_key() -> None:
+    with pytest.raises(ValueError, match="2026-13"):
+        fill_months({"2026-13": {}})
diff --git a/tests/test__query_leaf.py b/tests/test__query_leaf.py
new file mode 100644
index 0000000..a9120bf
--- /dev/null
+++ b/tests/test__query_leaf.py
@@ -0,0 +1,159 @@
+from datetime import date, datetime
+
+import pytest
+
+from kakeibo._query_leaf import match_leaf
+from kakeibo.core import Expense
+
+
+def _e(
+    day: date = date(2026, 1, 5),
+    category: str = "食費",
+    amount: int = 500,
+    memo: str = "",
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# 仕様の例の表(E7-*)を全行写す
+@pytest.mark.parametrize(
+    ("e", "leaf", "expected"),
+    [
+        pytest.param(
+            _e(amount=500), {"amount_min": 500, "amount_max": 500}, True, id="E7-1"
+        ),
+        pytest.param(
+            _e(memo="ＮＥＴＦＬＩＸ 月額"),
+            {"memo_contains": "netflix"},
+            True,
+            id="E7-2",
+        ),
+    ],
+)
+def test_spec_examples(e: Expense, leaf: dict[str, object], expected: bool) -> None:
+    assert match_leaf(e, leaf) is expected
+
+
+def test_E7_3_unknown_key_is_value_error() -> None:
+    with pytest.raises(ValueError, match="amount_mni"):
+        match_leaf(_e(), {"amount_mni": 1})
+
+
+# 追加の端のケース(R1〜R5)
+@pytest.mark.parametrize(
+    ("leaf", "expected"),
+    [
+        ({"category": "食費"}, True),
+        ({"category": "  食費  "}, True),
+        ({"category": "交通"}, False),
+        ({"category": ["交通", "食費"]}, True),
+        ({"category": ["交通", "娯楽"]}, False),
+        ({"amount_min": 500}, True),
+        ({"amount_min": 501}, False),
+        ({"amount_max": 500}, True),
+        ({"amount_max": 499}, False),
+        ({"amount_min": 400, "amount_max": 600}, True),
+        ({"memo_contains": ""}, True),
+        ({"memo_contains": "ＭＥＭＯ"}, True),
+        ({"memo_contains": "xyz"}, False),
+        ({"date_from": date(2026, 1, 5)}, True),
+        ({"date_from": date(2026, 1, 6)}, False),
+        ({"date_to": date(2026, 1, 5)}, True),
+        ({"date_to": date(2026, 1, 4)}, False),
+        ({"date_from": date(2026, 1, 5), "date_to": date(2026, 1, 5)}, True),
+        ({"category": "食費", "amount_min": 1000}, False),
+        ({"category": "食費", "amount_min": 500, "date_to": date(2026, 12, 31)}, True),
+    ],
+)
+def test_single_and_combined_keys(leaf: dict[str, object], expected: bool) -> None:
+    e = _e(memo="memo")
+    assert match_leaf(e, leaf) is expected
+
+
+def test_category_is_exact_not_partial() -> None:
+    assert match_leaf(_e(category="食費"), {"category": "食"}) is False
+
+
+def test_memo_nfkc_and_casefold_partial_match() -> None:
+    assert (
+        match_leaf(_e(memo="Ｓｐｏｔｉｆｙ Premium"), {"memo_contains": "PREMIUM"})
+        is True
+    )
+
+
+def test_range_is_inclusive_on_both_ends() -> None:
+    e = _e(day=date(2026, 3, 31), amount=1000)
+    assert match_leaf(e, {"amount_min": 1000, "amount_max": 1000}) is True
+    assert (
+        match_leaf(e, {"date_from": date(2026, 3, 31), "date_to": date(2026, 3, 31)})
+        is True
+    )
+
+
+def test_empty_leaf_is_value_error() -> None:
+    with pytest.raises(ValueError):
+        match_leaf(_e(), {})
+
+
+def test_amount_min_greater_than_max_is_value_error() -> None:
+    with pytest.raises(ValueError):
+        match_leaf(_e(), {"amount_min": 10, "amount_max": 5})
+
+
+def test_date_from_after_date_to_is_value_error() -> None:
+    with pytest.raises(ValueError):
+        match_leaf(_e(), {"date_from": date(2026, 2, 1), "date_to": date(2026, 1, 1)})
+
+
+def test_empty_category_list_is_value_error() -> None:
+    with pytest.raises(ValueError):
+        match_leaf(_e(), {"category": []})
+
+
+def test_empty_category_string_is_value_error() -> None:
+    with pytest.raises(ValueError):
+        match_leaf(_e(), {"category": "  "})
+
+
+def test_validation_does_not_short_circuit() -> None:
+    # 先に偽が決まる条件があっても、後ろの不正キーは検出される
+    with pytest.raises(ValueError, match="bogus"):
+        match_leaf(_e(category="交通"), {"category": "食費", "bogus": 1})
+
+
+def test_bad_key_is_named_in_message() -> None:
+    with pytest.raises(ValueError, match="foo_bar"):
+        match_leaf(_e(), {"foo_bar": 1, "category": "食費"})
+
+
+@pytest.mark.parametrize(
+    "leaf",
+    [
+        {"amount_min": True},
+        {"amount_max": 1.5},
+        {"amount_min": "500"},
+        {"memo_contains": 1},
+        {"category": 1},
+        {"category": [1]},
+        {"date_from": datetime(2026, 1, 1)},
+        {"date_to": "2026-01-01"},
+    ],
+)
+def test_wrong_types_are_type_error(leaf: dict[str, object]) -> None:
+    with pytest.raises(TypeError):
+        match_leaf(_e(), leaf)
+
+
+def test_leaf_not_dict_is_type_error() -> None:
+    with pytest.raises(TypeError):
+        match_leaf(_e(), [("category", "食費")])  # type: ignore[arg-type]
+
+
+def test_expense_not_expense_is_type_error() -> None:
+    with pytest.raises(TypeError):
+        match_leaf({"day": date(2026, 1, 1)}, {"category": "食費"})  # type: ignore[arg-type]
+
+
+def test_type_error_checked_even_when_result_is_already_false() -> None:
+    with pytest.raises(TypeError):
+        match_leaf(_e(category="交通"), {"category": "食費", "amount_min": "x"})
diff --git a/tests/test__query_tree.py b/tests/test__query_tree.py
new file mode 100644
