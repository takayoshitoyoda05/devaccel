+++ b/src/kakeibo/_import_header.py
@@ -0,0 +1,82 @@
+"""Map bank/card CSV header names to the roles used by the importer."""
+
+from __future__ import annotations
+
+import unicodedata
+
+_ALIASES: dict[str, tuple[str, ...]] = {
+    "date": ("日付", "利用日", "ご利用日", "取引日", "年月日", "date"),
+    "amount": ("金額", "利用金額", "ご利用金額", "amount"),
+    "withdrawal": (
+        "出金",
+        "出金額",
+        "支払",
+        "支払金額",
+        "お支払金額",
+        "お引出し",
+        "withdrawal",
+    ),
+    "deposit": ("入金", "入金額", "預入", "預入金額", "お預入れ", "deposit"),
+    "memo": (
+        "摘要",
+        "メモ",
+        "利用店名",
+        "ご利用店名",
+        "利用先",
+        "内容",
+        "取引内容",
+        "備考",
+        "description",
+        "memo",
+    ),
+    "category": ("カテゴリ", "カテゴリー", "費目", "分類", "category"),
+}
+
+
+def _normalize(name: str) -> str:
+    text = unicodedata.normalize("NFKC", name).casefold()
+    return "".join(ch for ch in text if not ch.isspace())
+
+
+_ROLE_OF: dict[str, str] = {
+    _normalize(alias): role for role, aliases in _ALIASES.items() for alias in aliases
+}
+
+
+def map_header(header: list[str]) -> dict[str, int]:
+    """Return {role: column index (0-based)} for the recognised header columns.
+
+    Columns that match no alias are ignored. Raises TypeError for non-list or
+    non-str input, and ValueError for duplicate, conflicting or missing roles.
+    """
+    if not isinstance(header, list):
+        raise TypeError(f"header must be a list, not {type(header).__name__}")
+    for i, name in enumerate(header):
+        if not isinstance(name, str):
+            raise TypeError(f"header[{i}] must be str, not {type(name).__name__}")
+
+    found: dict[str, list[int]] = {}
+    for i, name in enumerate(header):
+        if i == 0:
+            name = name.lstrip("﻿")
+        role = _ROLE_OF.get(_normalize(name))
+        if role is not None:
+            found.setdefault(role, []).append(i)
+
+    duplicated = [role for role, idx in found.items() if len(idx) > 1]
+    if duplicated:
+        raise ValueError(f"同じ役割の列が複数あります: {', '.join(duplicated)}")
+    if "amount" in found and "withdrawal" in found:
+        raise ValueError("amount と withdrawal は同時に指定できません")
+    if "deposit" in found and "withdrawal" not in found:
+        raise ValueError("deposit があるときは withdrawal が必要です")
+
+    missing: list[str] = []
+    if "date" not in found:
+        missing.append("date")
+    if "amount" not in found and "withdrawal" not in found:
+        missing.append("amount か withdrawal")
+    if missing:
+        raise ValueError(f"必須列がありません: {', '.join(missing)}")
+
+    return {role: idx[0] for role, idx in found.items()}
diff --git a/src/kakeibo/_import_split.py b/src/kakeibo/_import_split.py
new file mode 100644
index 0000000..7e7f48c
--- /dev/null
+++ b/src/kakeibo/_import_split.py
@@ -0,0 +1,65 @@
+"""CSV の文字列をレコード(開始行, セルの list)に分ける純粋関数。"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+
+_BOM = "﻿"
+_LINE_BREAK = re.compile(r"\r\n|\r|\n")
+
+
+def _detect_delimiter(text: str) -> str:
+    """最初の空でない物理行で、タブとカンマの数を比べて区切りを決める。"""
+    for line in _LINE_BREAK.split(text):
+        if line.strip():
+            return "\t" if line.count("\t") > line.count(",") else ","
+    return ","
+
+
+def split_records(
+    text: str, delimiter: str | None = None
+) -> list[tuple[int, list[str]]]:
+    """CSV 文字列をレコードに分ける。
+
+    戻り値は [(レコードの開始物理行(1 始まり), セルの list)]。ヘッダー行も含む。
+    セルは前後の空白を除く。全セルが空のレコード(空行)は含めない。
+    """
+    if not isinstance(text, str):
+        raise TypeError(f"text は str で指定してください: {type(text).__name__}")
+    if delimiter is not None and (
+        not isinstance(delimiter, str) or len(delimiter) != 1
+    ):
+        raise TypeError(
+            f"delimiter は 1 文字の str か None で指定してください: {delimiter!r}"
+        )
+
+    if delimiter is not None and delimiter in ('"', "\r", "\n"):
+        raise ValueError(f"delimiter に引用符・改行は使えません: {delimiter!r}")
+
+    text = text.removeprefix(_BOM)
+
+    sep = delimiter if delimiter is not None else _detect_delimiter(text)
+    stream = io.StringIO(text, newline="")
+    try:
+        reader = csv.reader(
+            stream, delimiter=sep, quotechar='"', doublequote=True, strict=True
+        )
+    except csv.Error as e:
+        raise ValueError(f"delimiter が不正です: {sep!r}") from e
+
+    records: list[tuple[int, list[str]]] = []
+    while True:
+        start = reader.line_num + 1
+        try:
+            row = next(reader)
+        except StopIteration:
+            break
+        except csv.Error as e:
+            raise ValueError(f"CSV を解析できません(開始行 {start}): {e}") from e
+        cells = [cell.strip() for cell in row]
+        if not any(cells):
+            continue
+        records.append((start, cells))
+    return records
