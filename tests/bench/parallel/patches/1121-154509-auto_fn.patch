+import re
+from datetime import date
+
+import pytest
+
+from kakeibo._import_date import parse_date
+
+
+@pytest.mark.parametrize(
+    "s, expected",
+    [
+        ("２０２６／１／５", date(2026, 1, 5)),  # E4-1
+        ("令和元年5月1日", date(2019, 5, 1)),  # E4-2
+    ],
+    ids=["E4-1", "E4-2"],
+)
+def test_example_table(s, expected):
+    assert parse_date(s) == expected
+
+
+@pytest.mark.parametrize("s", ["2026-02-30", "2025-02-29"], ids=["E4-3", "E4-3b"])
+def test_example_table_invalid_date(s):
+    with pytest.raises(ValueError, match="存在しない日付"):
+        parse_date(s)
+
+
+@pytest.mark.parametrize(
+    "s, expected",
+    [
+        ("2026-01-05", date(2026, 1, 5)),
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026.01.05", date(2026, 1, 5)),
+        ("20260105", date(2026, 1, 5)),
+        ("2026年1月5日", date(2026, 1, 5)),
+        ("  2026-01-05  ", date(2026, 1, 5)),
+        ("令和8年1月5日", date(2026, 1, 5)),
+        ("平成30年4月1日", date(2018, 4, 1)),
+        ("令和元年5月1日", date(2019, 5, 1)),
+        ("R8.1.5", date(2026, 1, 5)),
+        ("r8/1/5", date(2026, 1, 5)),
+        ("H30-4-1", date(2018, 4, 1)),
+        ("2026-01-05 12:30:00", date(2026, 1, 5)),
+        ("2026-01-05 12:30", date(2026, 1, 5)),
+        ("2026-01-05T12:30:00", date(2026, 1, 5)),
+        ("2026-01-05 25:00", date(2026, 1, 5)),
+        ("2024-02-29", date(2024, 2, 29)),
+    ],
+)
+def test_accepted_forms(s, expected):
+    assert parse_date(s) == expected
+
+
+@pytest.mark.parametrize(
+    "s",
+    [
+        "2026-1/5",  # 区切りの混在
+        "26/1/5",  # 2 桁の西暦
+        "2026-01",  # 年月だけ
+        "",
+        "   ",
+        "昭和64年1月7日",  # 昭和は受け付けない
+        "S64.1.7",
+        "令和0年1月1日",
+        "R0.1.1",
+        "2026-01-05 12:30 extra",
+        "2026-01-05x",
+        "abc",
+    ],
+)
+def test_rejected_forms(s):
+    with pytest.raises(ValueError, match=re.escape(repr(s))):
+        parse_date(s)
+
+
+@pytest.mark.parametrize("bad", [None, date(2026, 1, 5), 20260105, True])
+def test_non_str_raises_type_error(bad):
+    with pytest.raises(TypeError, match="s"):
+        parse_date(bad)
