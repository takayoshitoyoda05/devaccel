+        "category": 1,
+        "date": 2,
+        "amount": 3,
+    }
+
+
+def test_duplicate_role_is_error() -> None:
+    with pytest.raises(ValueError):
+        map_header(["日付", "金額", "利用金額"])
+
+
+def test_deposit_without_withdrawal_is_error() -> None:
+    with pytest.raises(ValueError):
+        map_header(["日付", "金額", "入金"])
+
+
+def test_missing_date_is_error_and_names_role() -> None:
+    with pytest.raises(ValueError, match="date"):
+        map_header(["金額", "摘要"])
+
+
+def test_missing_amount_or_withdrawal_is_error() -> None:
