+import pytest
+
+from kakeibo._import_header import map_header
+
+
+@pytest.mark.parametrize(
+    ("header", "expected"),
+    [
+        pytest.param(
+            ["利用日", "ご利用店名", "ご利用金額"],
+            {"date": 0, "memo": 1, "amount": 2},
+            id="E5-1",
+        ),
+        pytest.param(
+            ["日付", "摘要", "出金額", "入金額", "残高"],
+            {"date": 0, "memo": 1, "withdrawal": 2, "deposit": 3},
+            id="E5-2",
+        ),
+    ],
+)
+def test_example_rows(header: list[str], expected: dict[str, int]) -> None:
+    assert map_header(header) == expected
+
+
+@pytest.mark.parametrize(
+    "header",
+    [pytest.param(["日付", "金額", "出金"], id="E5-3")],
+)
+def test_amount_and_withdrawal_conflict(header: list[str]) -> None:
+    with pytest.raises(ValueError):
+        map_header(header)
+
+
+def test_normalizes_fullwidth_spaces_case_and_width() -> None:
+    assert map_header(["Ｄａｔｅ", " 摘　要 ", "ＡＭＯＵＮＴ"]) == {
+        "date": 0,
+        "memo": 1,
+        "amount": 2,
+    }
+
+
+def test_strips_leading_bom() -> None:
