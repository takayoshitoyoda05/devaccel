@@ -0,0 +1,112 @@
+"""固定費(毎月の固定支出)の系列を見つける純粋関数。"""
+
+from __future__ import annotations
+
+import math
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_WS = re.compile(r"\s+")
+_TAIL_NO = re.compile(r"[#＃]?\d+$")
+_TAIL_MONTH = re.compile(r"\d{1,2}月分$")
+
+
+@dataclass(frozen=True)
+class RecurringSeries:
+    category: str
+    memo: str
+    amount: int
+    days: tuple[date, ...]
+
+
+def normalize_memo(memo: str) -> str:
+    if not isinstance(memo, str):
+        raise TypeError("memo must be str")
+    s = unicodedata.normalize("NFKC", memo).casefold().strip()
+    s = _WS.sub(" ", s)
+    s = _TAIL_NO.sub("", s).strip()
+    s = _TAIL_MONTH.sub("", s).strip()
+    return s
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month - 1
+
+
+def find_monthly_series(
+    rows: list[Expense], min_months: int = 3, tolerance_pct: float = 0
+) -> list[RecurringSeries]:
+    if not isinstance(rows, list):
+        raise TypeError("rows must be list")
+    if isinstance(min_months, bool) or not isinstance(min_months, int):
+        raise TypeError("min_months must be int")
+    if min_months < 2:
+        raise ValueError("min_months must be >= 2")
+    if isinstance(tolerance_pct, bool) or not isinstance(tolerance_pct, (int, float)):
+        raise TypeError("tolerance_pct must be int or float")
+    if math.isnan(tolerance_pct) or not 0 <= tolerance_pct <= 100:
+        raise ValueError("tolerance_pct must be within 0..100")
+
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for r in rows:
+        if not isinstance(r, Expense):
+            raise TypeError("rows must contain Expense")
+        if (
+            not isinstance(r.day, date)
+            or not isinstance(r.category, str)
+            or not isinstance(r.memo, str)
+            or isinstance(r.amount, bool)
+            or not isinstance(r.amount, int)
+        ):
+            raise TypeError("rows contain an Expense with invalid fields")
+        if r.amount <= 0:
+            continue
+        key = (r.category.strip(), normalize_memo(r.memo))
+        groups.setdefault(key, []).append(r)
+
+    result: list[RecurringSeries] = []
+    for (category, memo), items in groups.items():
+        items = sorted(items, key=lambda e: e.amount)
+        clusters: list[list[Expense]] = []
+        base = 0.0
+        for e in items:
+            if clusters and e.amount <= base * (1 + tolerance_pct / 100):
+                clusters[-1].append(e)
+            else:
+                clusters.append([e])
+                base = float(e.amount)
+        for cl in clusters:
+            cl = sorted(cl, key=lambda e: e.day)
+            by_month: dict[int, Expense] = {}
+            for e in cl:
+                by_month.setdefault(_month_index(e.day), e)
+            months = sorted(by_month)
+            runs: list[list[int]] = []
+            for m in months:
+                if runs and runs[-1][-1] == m - 1:
+                    runs[-1].append(m)
+                else:
+                    runs.append([m])
+            best: list[int] | None = None
+            for run in runs:
+                if len(run) < min_months:
+                    continue
+                if best is None or len(run) >= len(best):
+                    best = run
+            if best is None:
+                continue
+            picked = [by_month[m] for m in best]
+            result.append(
+                RecurringSeries(
+                    category=category,
+                    memo=memo,
+                    amount=picked[-1].amount,
+                    days=tuple(e.day for e in picked),
+                )
+            )
+    result.sort(key=lambda s: (-s.amount, s.category, s.memo))
+    return result
