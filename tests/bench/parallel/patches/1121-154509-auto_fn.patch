+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.statement import import_statement
+
+
+def test_card_csv_with_aliases_and_bom():
+    text = '﻿利用日,ご利用店名,ご利用金額\n2026/1/5,"カフェ, 渋谷","1,200円"\n令和8年1月6日,書店,▲500\n'
+    r = import_statement(text)
+    assert r.issues == []
+    assert r.expenses == [
+        Expense(date(2026, 1, 5), "未分類", 1200, "カフェ, 渋谷"),
+        Expense(date(2026, 1, 6), "未分類", -500, "書店"),
+    ]
+
+
+def test_bank_csv_split_columns_skips_deposits():
+    text = "日付\t摘要\t出金額\t入金額\n2026-01-05\t家賃\t80,000\t\n2026-01-25\t給与\t\t300,000\n"
+    r = import_statement(text)
+    assert r.expenses == [Expense(date(2026, 1, 5), "未分類", 80000, "家賃")]
+    assert r.skipped == 1 and r.issues == []
+
+
+def test_bad_rows_report_line_column_value():
+    text = "date,amount,memo\n2026-01-05,100,a\n2026-02-30,abc,b\n2026-01-07,1,2,3\n2026-01-08\n"
+    r = import_statement(text)
+    assert len(r.expenses) == 1
+    got = [(i.line, i.column) for i in r.issues]
+    assert got == [(3, "date"), (3, "amount"), (4, ""), (5, "")]
+    assert r.issues[0].value == "2026-02-30" and r.issues[1].value == "abc"
+    assert "列が多すぎます" in r.issues[2].reason
+    assert "列が足りません" in r.issues[3].reason
+
+
+def test_quoted_newline_uses_start_line():
+    text = 'date,amount,memo\n2026-01-05,100,"a\nb"\n2026-01-06,x,c\n'
+    r = import_statement(text)
+    assert [(i.line, i.column) for i in r.issues] == [(4, "amount")]
+
+
+def test_empty_and_header_only():
+    assert import_statement("").expenses == []
+    assert import_statement("date,amount\n").expenses == []
+
+
+def test_unusable_header_raises():
+    with pytest.raises(ValueError):
+        import_statement("foo,bar\n1,2\n")
