@@ -0,0 +1,39 @@
+"""AND / OR / NOT の木を評価する純粋関数。"""
+
+from collections.abc import Callable
+
+_OPERATORS = ("and", "or", "not")
+
+
+def evaluate(node: dict, leaf: Callable[[dict], bool]) -> bool:
+    """AND/OR/NOT の木を評価する。
+
+    `and` `or` `not` のどれか 1 つだけをキーに持つ dict は演算子ノード、
+    それ以外の dict は葉として `leaf(node)` の結果を返す。
+    短絡せず、全部の子を評価する。
+    """
+    if not isinstance(node, dict):
+        raise TypeError(f"node must be a dict, got {type(node).__name__}")
+
+    op_keys = [key for key in _OPERATORS if key in node]
+    if len(op_keys) >= 2:
+        raise ValueError(f"node has several operators: {sorted(op_keys)}")
+    if not op_keys:
+        return leaf(node)
+
+    op = op_keys[0]
+    if len(node) != 1:
+        raise ValueError(f"operator {op!r} must not be mixed with other keys")
+
+    value = node[op]
+    if op == "not":
+        if not isinstance(value, dict):
+            raise TypeError("'not' value must be a dict")
+        return not evaluate(value, leaf)
+
+    if not isinstance(value, list):
+        raise TypeError(f"{op!r} value must be a list")
+    results = [evaluate(child, leaf) for child in value]
+    if op == "and":
+        return all(results)
+    return any(results)
