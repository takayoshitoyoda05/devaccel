@@ -0,0 +1,68 @@
+"""次回予定日の計算(純粋関数・標準ライブラリのみ)。"""
+
+from __future__ import annotations
+
+import calendar
+from collections import Counter
+from datetime import date, datetime
+
+
+def _check_int(name: str, value: object) -> int:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{name} は int である必要があります: {value!r}")
+    return value
+
+
+def _check_date(name: str, value: object) -> date:
+    if isinstance(value, datetime) or not isinstance(value, date):
+        raise TypeError(f"{name} は date である必要があります: {value!r}")
+    return value
+
+
+def add_months(d: date, n: int, day: int | None = None) -> date:
+    """d の n か月後を返す。日は day(省略時は d.day)を月末に切り詰める。"""
+    _check_date("d", d)
+    _check_int("n", n)
+    if day is not None:
+        _check_int("day", day)
+        if not 1 <= day <= 31:
+            raise ValueError(f"day は 1〜31 の必要があります: {day!r}")
+    total = d.year * 12 + (d.month - 1) + n
+    year, month0 = divmod(total, 12)
+    month = month0 + 1
+    last = calendar.monthrange(year, month)[1]
+    wanted = d.day if day is None else day
+    return date(year, month, min(wanted, last))
+
+
+def _mode_day(days: list[date]) -> int:
+    """最頻の日。同数なら、その日が最新に現れた日付の日を優先する。"""
+    counts: Counter[int] = Counter(x.day for x in days)
+    latest: dict[int, date] = {}
+    for x in days:
+        if x.day not in latest or x > latest[x.day]:
+            latest[x.day] = x
+    return max(counts, key=lambda k: (counts[k], latest[k]))
+
+
+def next_due(days: list[date], after: date | None = None) -> date:
+    """days から次回予定日を返す。after があれば、それより後になるまで進める。"""
+    if not isinstance(days, (list, tuple)):
+        raise TypeError(f"days は list である必要があります: {days!r}")
+    if len(days) == 0:
+        raise ValueError("days が空です")
+    for x in days:
+        _check_date("days の要素", x)
+    if after is not None:
+        _check_date("after", after)
+
+    seq = list(days)
+    base = max(seq)
+    day = _mode_day(seq)
+    k = 1
+    cand = add_months(base, k, day)
+    if after is not None:
+        while cand <= after:
+            k += 1
+            cand = add_months(base, k, day)
+    return cand
diff --git a/src/kakeibo/_recur_series.py b/src/kakeibo/_recur_series.py
