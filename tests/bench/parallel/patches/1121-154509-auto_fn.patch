+++ b/tests/test__import_split.py
@@ -0,0 +1,104 @@
+import pytest
+
+from kakeibo._import_split import split_records
+
+
+@pytest.mark.parametrize(
+    ("text", "delimiter", "expected"),
+    [
+        # E6-1: BOM を除き、タブ区切りを自動判定する(R2 R3)
+        pytest.param(
+            "﻿日付\t金額\n2026-1-5\t100\n",
+            None,
+            [(1, ["日付", "金額"]), (2, ["2026-1-5", "100"])],
+            id="E6-1",
+        ),
+        # E6-2: 引用符内の改行はレコードの一部、空行は除外、行番号は物理行どおり(R4 R5)
+        pytest.param(
+            'a,b\n\n"x\ny",1\nz,2\n',
+            None,
+            [(1, ["a", "b"]), (3, ["x\ny", "1"]), (5, ["z", "2"])],
+            id="E6-2",
+        ),
+    ],
+)
+def test_example_table(text, delimiter, expected):
+    assert split_records(text, delimiter) == expected
+
+
+def test_E6_3_unclosed_quote_raises_with_start_line():
+    # E6-3: 引用符が閉じないまま終わる(R6)。開始行は 1
+    with pytest.raises(ValueError, match="開始行 1"):
+        split_records('a,"b\n')
+
+
+# --- 表に無い規則の確認 ---
+
+
+def test_R1_header_is_included_as_first_record():
+    assert split_records("h1,h2\nv1,v2") == [(1, ["h1", "h2"]), (2, ["v1", "v2"])]
+
+
+@pytest.mark.parametrize(
+    "text",
+    ["a,b\r\nc,d\r\n", "a,b\rc,d\r", "a,b\nc,d\n"],
+    ids=["crlf", "cr", "lf"],
+)
+def test_R2_all_newline_styles(text):
+    assert split_records(text) == [(1, ["a", "b"]), (2, ["c", "d"])]
+
+
+def test_R3_explicit_delimiter_overrides_detection():
+    # タブが多くてもカンマ指定ならカンマで分ける
+    assert split_records("a\tb,c\n", ",") == [(1, ["a\tb", "c"])]
+
+
+def test_R3_comma_when_commas_outnumber_tabs():
+    assert split_records("a,b,c\td\n") == [(1, ["a", "b", "c\td"])]
+
+
+def test_R3_default_comma_when_no_nonblank_line():
+    assert split_records("\n\n  \n") == []
+
+
+def test_R4_doubled_quote_is_single_quote_char():
+    assert split_records('"say ""hi""",x\n') == [(1, ['say "hi"', "x"])]
+
+
+def test_R4_record_after_multiline_cell_uses_physical_line():
+    text = '"a\nb\nc",1\n2,3\n'
+    assert split_records(text) == [(1, ["a\nb\nc", "1"]), (4, ["2", "3"])]
+
+
+def test_R5_full_width_spaces_are_stripped():
+    assert split_records("　a　,　b　\n") == [(1, ["a", "b"])]
+
+
+def test_R5_all_empty_cells_record_is_skipped_but_line_numbers_continue():
+    assert split_records(",,\n\na,b\n") == [(3, ["a", "b"])]
+
+
+def test_R6_empty_input_returns_empty_list():
+    assert split_records("") == []
+
+
+def test_R6_unclosed_quote_error_reports_record_start_line():
+    with pytest.raises(ValueError, match="開始行 3"):
+        split_records('a,b\nc,d\n"x,y\n')
+
+
+def test_R7_text_must_be_str():
+    with pytest.raises(TypeError, match="text"):
+        split_records(b"a,b\n")  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad", [1, b",", ",,", ""])
+def test_R7_delimiter_must_be_one_char_str(bad):
+    with pytest.raises(TypeError, match="delimiter"):
+        split_records("a,b\n", bad)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad", ["\n", "\r", '"'], ids=["lf", "cr", "quote"])
+def test_R7_delimiter_cannot_be_newline_or_quote(bad):
+    with pytest.raises(ValueError, match="delimiter"):
+        split_records("a\nb\n", bad)
