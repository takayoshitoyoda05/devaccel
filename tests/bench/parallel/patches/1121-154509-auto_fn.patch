+++ b/tests/test__recur_next.py
@@ -0,0 +1,139 @@
+from datetime import date, datetime
+
+import pytest
+
+from kakeibo._recur_next import add_months, next_due
+
+
+# E2-1 / E2-2 / E2-3 は仕様の例の表から写した。
+@pytest.mark.parametrize(
+    ("call", "expected"),
+    [
+        pytest.param(
+            lambda: add_months(date(2026, 1, 31), 1),
+            date(2026, 2, 28),
+            id="E2-1",
+        ),
+        pytest.param(
+            lambda: next_due([date(2026, 1, 31), date(2026, 2, 28), date(2026, 3, 31)]),
+            date(2026, 4, 30),
+            id="E2-2",
+        ),
+        pytest.param(
+            lambda: next_due(
+                [date(2026, 2, 5), date(2026, 3, 5)], after=date(2026, 6, 10)
+            ),
+            date(2026, 7, 5),
+            id="E2-3",
+        ),
+    ],
+)
+def test_spec_examples(call, expected):
+    assert call() == expected
+
+
+# R1 add_months
+@pytest.mark.parametrize(
+    ("d", "n", "day", "expected"),
+    [
+        (date(2026, 11, 15), -11, None, date(2025, 12, 15)),  # 負・年またぎ
+        (date(2026, 12, 1), 1, None, date(2027, 1, 1)),  # 12 月→1 月
+        (date(2026, 1, 10), 0, None, date(2026, 1, 10)),  # n=0
+        (date(2026, 1, 10), 2, 31, date(2026, 3, 31)),  # day 指定
+        (date(2024, 2, 10), 1, 31, date(2024, 3, 31)),  # day 指定で月末に切詰めなし
+        (date(2026, 1, 10), 1, 31, date(2026, 2, 28)),  # day で 2 月末に切詰め
+        (date(2024, 1, 31), 1, None, date(2024, 2, 29)),  # うるう年の 2 月末
+    ],
+)
+def test_add_months_values(d, n, day, expected):
+    assert add_months(d, n, day) == expected
+
+
+@pytest.mark.parametrize("day", [0, 32, -1])
+def test_add_months_day_out_of_range(day):
+    with pytest.raises(ValueError, match="day"):
+        add_months(date(2026, 1, 1), 1, day)
+
+
+@pytest.mark.parametrize("n", [1.0, "1", None, True])
+def test_add_months_n_not_int(n):
+    with pytest.raises(TypeError, match="n"):
+        add_months(date(2026, 1, 1), n)
+
+
+def test_add_months_day_bool_is_type_error():
+    with pytest.raises(TypeError, match="day"):
+        add_months(date(2026, 1, 1), 1, True)
+
+
+# R2 / D4 next_due: 最頻の日、同数なら最新に現れた日
+@pytest.mark.parametrize(
+    ("days", "expected"),
+    [
+        # 未整列・重複があっても最頻の日(5)を使う
+        (
+            [date(2026, 3, 5), date(2026, 1, 5), date(2026, 2, 5), date(2026, 2, 5)],
+            date(2026, 4, 5),
+        ),
+        # 同数(1 件ずつ)なら最新の日付の日(20)
+        ([date(2026, 1, 10), date(2026, 2, 20)], date(2026, 3, 20)),
+        # 同数 2 件ずつ: 最新に現れたのは 3/15 の日 15
+        (
+            [
+                date(2026, 1, 10),
+                date(2026, 1, 10),
+                date(2026, 2, 15),
+                date(2026, 3, 15),
+            ],
+            date(2026, 4, 15),
+        ),
+        # 基準は最大の日付の翌月(未整列でも)
+        ([date(2026, 5, 1), date(2025, 12, 1)], date(2026, 6, 1)),
+        # 1 件だけ
+        ([date(2026, 2, 28)], date(2026, 3, 28)),
+    ],
+)
+def test_next_due_mode_day(days, expected):
+    assert next_due(days) == expected
+
+
+# R3 after: after より後(>)になるまで 1 か月ずつ進める
+@pytest.mark.parametrize(
+    ("after", "expected"),
+    [
+        (date(2026, 3, 4), date(2026, 4, 5)),  # 最初の候補(4/5)より前
+        (date(2026, 4, 5), date(2026, 5, 5)),  # 等しいなら進める(>)
+        (date(2026, 4, 6), date(2026, 5, 5)),
+    ],
+)
+def test_next_due_after_is_strict(after, expected):
+    assert next_due([date(2026, 2, 5), date(2026, 3, 5)], after=after) == expected
+
+
+def test_next_due_after_clips_month_end():
+    days = [date(2026, 1, 31), date(2026, 2, 28), date(2026, 3, 31)]
+    assert next_due(days, after=date(2026, 4, 30)) == date(2026, 5, 31)
+
+
+# R4 エラー
+def test_next_due_empty_is_value_error():
+    with pytest.raises(ValueError):
+        next_due([])
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        [datetime(2026, 1, 5)],
+        [date(2026, 1, 5), "2026-02-05"],
+        [date(2026, 1, 5), None],
+    ],
+)
+def test_next_due_non_date_element_is_type_error(bad):
+    with pytest.raises(TypeError):
+        next_due(bad)
+
+
+def test_next_due_after_datetime_is_type_error():
+    with pytest.raises(TypeError, match="after"):
+        next_due([date(2026, 1, 5)], after=datetime(2026, 2, 1))
