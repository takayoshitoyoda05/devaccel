+from kakeibo.monthly_change import format_changes, month_over_month
+
+
+def test_changes_vs_previous_month():
+    totals = {
+        "2026-01": {"food": 1000, "rent": 80000},
+        "2026-02": {"food": 1500, "rent": 80000, "fun": 300},
+    }
+    got = month_over_month(totals)
+    assert list(got) == ["2026-02"]  # 最初の月は比べる相手が無い
+    assert [(c.category, c.status, c.delta) for c in got["2026-02"]] == [
+        ("food", "up", 500),
+        ("fun", "new", 300),
+        ("rent", "same", 0),
+    ]
+
+
+def test_missing_month_is_empty_month():
+    totals = {"2026-01": {"food": 1000}, "2026-03": {"food": 400}}
+    got = month_over_month(totals)
+    assert list(got) == ["2026-02", "2026-03"]
+    assert [c.status for c in got["2026-02"]] == ["gone"]
+    assert [c.status for c in got["2026-03"]] == ["new"]
+
+
+def test_empty_and_single_month():
+    assert month_over_month({}) == {}
+    assert month_over_month({"2026-01": {"a": 1}}) == {}
+
+
+def test_format_changes():
+    totals = {"2026-01": {"food": 1000}, "2026-02": {"food": 1500}}
+    text = format_changes("2026-02", month_over_month(totals)["2026-02"])
+    assert text == "2026-02 (前月比)\n  ↑ food: 1,000 -> 1,500 (+500円) (+50.0%)"
