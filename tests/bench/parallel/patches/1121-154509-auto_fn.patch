@@ -0,0 +1,79 @@
+from datetime import date
+
+import pytest
+
+from kakeibo._recur_series import RecurringSeries, find_monthly_series, normalize_memo
+from kakeibo.core import Expense
+
+
+def _rent(months: list[int], amount: int = 80000) -> list[Expense]:
+    return [Expense(date(2025, m, 5), "food", amount, "家賃") for m in months]
+
+
+@pytest.mark.parametrize(
+    ("memo", "expected"),
+    [
+        ("　Netflix　 #12 ", "netflix"),
+        ("家賃 3月分", "家賃"),
+        ("A   B", "a b"),
+        ("netflix＃7", "netflix"),
+    ],
+    ids=["E1-1", "R1-month", "R1-space", "R1-fullwidth-hash"],
+)
+def test_normalize_memo(memo: str, expected: str) -> None:
+    assert normalize_memo(memo) == expected
+
+
+def test_normalize_memo_none() -> None:
+    with pytest.raises(TypeError, match="memo"):
+        normalize_memo(None)  # type: ignore[arg-type]
+
+
+def test_e1_2() -> None:
+    res = find_monthly_series(_rent([1, 2, 3]), min_months=3)
+    assert len(res) == 1
+    assert isinstance(res[0], RecurringSeries)
+    assert len(res[0].days) == 3
+    assert res[0].amount == 80000
+
+
+def test_e1_3() -> None:
+    res = find_monthly_series(_rent([1, 2, 4, 5, 6]), min_months=3)
+    assert len(res) == 1
+    assert res[0].days == tuple(date(2025, m, 5) for m in (4, 5, 6))
+
+
+def test_refund_ignored_and_empty() -> None:
+    assert find_monthly_series([]) == []
+    assert find_monthly_series(_rent([1, 2, 3], amount=-80000)) == []
+
+
+def test_tolerance_and_order() -> None:
+    rows = [Expense(date(2025, m, 1), "a", 1000 + m, "x") for m in (1, 2, 3)] + _rent(
+        [1, 2, 3]
+    )
+    assert [s.amount for s in find_monthly_series(rows)] == [80000]
+    res = find_monthly_series(rows, tolerance_pct=1)
+    assert [s.amount for s in res] == [80000, 1003]
+
+
+def test_duplicate_month_uses_first() -> None:
+    rows = _rent([1, 2, 3]) + [Expense(date(2025, 2, 20), "food", 80000, "家賃")]
+    res = find_monthly_series(rows)
+    assert res[0].days[1] == date(2025, 2, 5)
+
+
+@pytest.mark.parametrize(
+    ("kwargs", "exc"),
+    [
+        ({"min_months": True}, TypeError),
+        ({"min_months": 1}, ValueError),
+        ({"tolerance_pct": True}, TypeError),
+        ({"tolerance_pct": float("nan")}, ValueError),
+        ({"tolerance_pct": 101}, ValueError),
+        ({"tolerance_pct": -1}, ValueError),
+    ],
+)
+def test_bad_args(kwargs: dict[str, object], exc: type[Exception]) -> None:
+    with pytest.raises(exc, match=next(iter(kwargs))):
+        find_monthly_series([], **kwargs)  # type: ignore[arg-type]
