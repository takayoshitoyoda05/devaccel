@@ -0,0 +1,47 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import search
+
+ROWS = [
+    Expense(date(2026, 1, 5), "food", 900, "ランチ"),
+    Expense(date(2026, 1, 20), "food", 3000, "ＮＥＴＦＬＩＸ"),
+    Expense(date(2026, 2, 1), "rent", 80000, "家賃"),
+    Expense(date(2026, 2, 10), "fun", 1500, "映画"),
+]
+
+
+def test_single_conditions_inclusive():
+    assert search(ROWS, {"category": "food"}) == ROWS[:2]
+    assert search(ROWS, {"amount_min": 1500, "amount_max": 3000}) == [ROWS[1], ROWS[3]]
+    assert (
+        search(ROWS, {"date_from": date(2026, 1, 20), "date_to": date(2026, 2, 1)})
+        == ROWS[1:3]
+    )
+    assert search(ROWS, {"memo_contains": "netflix"}) == [ROWS[1]]
+
+
+def test_and_or_not():
+    q = {
+        "or": [
+            {"category": "rent"},
+            {"and": [{"category": "food"}, {"not": {"amount_min": 1000}}]},
+        ]
+    }
+    assert search(ROWS, q) == [ROWS[0], ROWS[2]]
+
+
+def test_empty_and_or():
+    assert search(ROWS, {"and": []}) == ROWS
+    assert search(ROWS, {"or": []}) == []
+
+
+def test_invalid_query_raises_even_with_no_rows():
+    with pytest.raises(ValueError):
+        search([], {"and": [{"category": "food"}, {"amount_mni": 1}]})
+    with pytest.raises(ValueError):
+        search(ROWS, {})
+    with pytest.raises(TypeError):
+        search(ROWS, {"amount_min": True})
