+"""前月と比べたカテゴリごとの増減レポート。
+
+D1: 最初の月は比べる前月が無いので結果に含めない。
+D2: 途中で欠けた月は空の月として比べる(前月にあって無い月は gone になる)。
+"""
+
+from __future__ import annotations
+
+from kakeibo._mom_diff import CategoryChange, diff_categories
+from kakeibo._mom_months import fill_months, previous_month
+
+_MARK = {"up": "↑", "down": "↓", "same": "=", "new": "+新規", "gone": "-消滅"}
+
+
+def month_over_month(
+    totals: dict[str, dict[str, int]],
+) -> dict[str, list[CategoryChange]]:
+    """{month: 前月との差}。totals は core.monthly_totals の形。月の昇順。"""
+    filled = fill_months(totals)
+    return {
+        month: diff_categories(filled.get(previous_month(month), {}), cats)
+        for month, cats in filled.items()
+        if previous_month(month) in filled
+    }
+
+
+def format_changes(month: str, changes: list[CategoryChange]) -> str:
+    lines = [f"{month} (前月比)"]
+    for c in changes:
+        pct = "" if c.pct is None else f" ({c.pct:+.1f}%)"
+        lines.append(
+            f"  {_MARK[c.status]} {c.category}: {c.prev:,} -> {c.cur:,} ({c.delta:+,}円){pct}"
+        )
+    return "\n".join(lines)
