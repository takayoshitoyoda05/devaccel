+++ b/tests/test__mom_diff.py
@@ -0,0 +1,90 @@
+"""Tests for kakeibo._mom_diff (カテゴリごとの前月との差)."""
+
+from __future__ import annotations
+
+import pytest
+
+from kakeibo._mom_diff import CategoryChange, diff_categories
+
+
+def test_E9_1_up_new_same_order() -> None:
+    # E9-1: R1 R2 R3
+    prev = {"food": 1000, "rent": 80000}
+    cur = {"food": 1500, "rent": 80000, "fun": 300}
+    result = diff_categories(prev, cur)
+    assert result == [
+        CategoryChange("food", 1000, 1500, 500, 50.0, "up"),
+        CategoryChange("fun", 0, 300, 300, None, "new"),
+        CategoryChange("rent", 80000, 80000, 0, 0.0, "same"),
+    ]
+
+
+def test_E9_2_gone() -> None:
+    # E9-2: R2
+    result = diff_categories({"food": 1000}, {})
+    assert result == [CategoryChange("food", 1000, 0, -1000, -100.0, "gone")]
+
+
+def test_E9_3_bool_is_type_error() -> None:
+    # E9-3: R4
+    with pytest.raises(TypeError):
+        diff_categories({"a": True}, {})
+
+
+def test_both_empty_returns_empty_list() -> None:
+    # R3
+    assert diff_categories({}, {}) == []
+
+
+def test_down_status_and_pct() -> None:
+    # R2 delta < 0 -> down、pct は丸めない
+    result = diff_categories({"food": 3000}, {"food": 1000})
+    assert result == [
+        CategoryChange("food", 3000, 1000, -2000, -2000 / 3000 * 100, "down")
+    ]
+
+
+def test_both_zero_is_same_with_pct_none() -> None:
+    # R2: 両方 0 は same、prev == 0 なので pct は None
+    result = diff_categories({"a": 0}, {"a": 0})
+    assert result == [CategoryChange("a", 0, 0, 0, None, "same")]
+
+
+def test_sort_by_abs_delta_then_category() -> None:
+    # R3: abs(delta) 降順、同じ abs なら category 昇順
+    result = diff_categories({"b": 100, "a": 500}, {"b": 0, "a": 0, "c": 100})
+    assert [c.category for c in result] == ["a", "b", "c"]
+    result2 = diff_categories({"x": 0, "y": 0}, {"y": 50, "x": -50})
+    assert [c.category for c in result2] == ["x", "y"]
+
+
+def test_negative_amounts_allowed() -> None:
+    # R4: 金額は負も可
+    result = diff_categories({"refund": -500}, {"refund": -200})
+    assert result == [CategoryChange("refund", -500, -200, 300, 300 / 500 * 100, "up")]
+
+
+def test_inputs_not_mutated() -> None:
+    # R4: 入力 dict は変更しない
+    prev = {"food": 1000}
+    cur = {"rent": 5}
+    diff_categories(prev, cur)
+    assert prev == {"food": 1000}
+    assert cur == {"rent": 5}
+
+
+@pytest.mark.parametrize(
+    ("prev", "cur"),
+    [
+        (["food"], {}),  # dict でない
+        ({}, None),  # dict でない
+        ({1: 100}, {}),  # キーが str でない
+        ({"food": 1.5}, {}),  # int でない
+        ({}, {"food": "100"}),  # int でない
+    ],
+    ids=["prev-list", "cur-none", "prev-int-key", "prev-float", "cur-str"],
+)
+def test_type_errors(prev: object, cur: object) -> None:
+    # R4
+    with pytest.raises(TypeError):
+        diff_categories(prev, cur)  # type: ignore[arg-type]
