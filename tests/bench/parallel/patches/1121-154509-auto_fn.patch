new file mode 100644
index 0000000..65da27c
--- /dev/null
+++ b/src/kakeibo/_import_amount.py
@@ -0,0 +1,59 @@
+"""金額の文字列を円の整数にする(取り込み部品)。"""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+
+# R2: 先頭の符号 / 通貨記号 / 数字(桁区切り付き) / 小数部(全部 0) / 末尾の通貨記号 / 末尾の "-"
+_PATTERN = re.compile(
+    r"""
+    ^
+    (?P<lead>[-−▲△+])?
+    \s*
+    (?:(?P<cur_pre>¥|JPY)\s*)?
+    (?P<num>[0-9]{1,3}(?:,[0-9]{3})+|[0-9]+)
+    (?:\.0+)?
+    \s*
+    (?:(?P<cur_suf>円|JPY)\s*)?
+    (?P<trail>-)?
+    $
+    """,
+    re.VERBOSE | re.IGNORECASE,
+)
+
+_NEG_LEAD = {"-", "−", "▲", "△"}
+
+
+def parse_amount(s: str) -> int:
+    """金額の文字列を円の整数にする。規則にない入力は ValueError。"""
+    if not isinstance(s, str):
+        raise TypeError(f"s は str が必要: {type(s).__name__}")
+
+    text = unicodedata.normalize("NFKC", s).strip()
+
+    negative_paren = False
+    if text.startswith("(") and text.endswith(")"):
+        negative_paren = True
+        text = text[1:-1].strip()
+
+    m = _PATTERN.match(text)
+    if m is None:
+        raise ValueError(f"金額として解釈できない: {s!r}")
+
+    if m.group("cur_pre") and m.group("cur_suf"):
+        raise ValueError(f"通貨記号が二重: {s!r}")
+
+    signs = [
+        negative_paren,
+        m.group("lead") is not None,
+        m.group("trail") is not None,
+    ]
+    if sum(signs) > 1:
+        raise ValueError(f"符号が二重: {s!r}")
+
+    value = int(m.group("num").replace(",", ""))
+    negative = (
+        negative_paren or m.group("trail") is not None or (m.group("lead") in _NEG_LEAD)
+    )
+    return -value if negative else value
diff --git a/src/kakeibo/_import_date.py b/src/kakeibo/_import_date.py
new file mode 100644
index 0000000..2d3b573
--- /dev/null
+++ b/src/kakeibo/_import_date.py
@@ -0,0 +1,59 @@
+"""取り込み用: 日付の文字列を date にする(純粋関数)。"""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from datetime import date
+
+_SEP_DATE = re.compile(r"([0-9]{4})([-/.])([0-9]{1,2})\2([0-9]{1,2})")
+_COMPACT = re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})")
+_KANJI = re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日")
+_WAREKI_KANJI = re.compile(r"(令和|平成)(元|[0-9]{1,2})年([0-9]{1,2})月([0-9]{1,2})日")
+_WAREKI_ABBR = re.compile(r"([RrHh])([0-9]{1,2})([-/.])([0-9]{1,2})\3([0-9]{1,2})")
+_TIME_SUFFIX = re.compile(r"(.*?)(?:[ T][0-9]{2}:[0-9]{2}(?::[0-9]{2})?)?")
+
+# 元年の西暦 - 1 (令和元年 = 2019 年)
+_ERA_BASE = {"令和": 2018, "平成": 1988, "R": 2018, "H": 1988}
+
+
+def _gengo_year(era: str, token: str, original: str) -> int:
+    n = 1 if token == "元" else int(token)
+    if n < 1:
+        raise ValueError(f"年号の年が不正です: {original!r}")
+    return _ERA_BASE[era] + n
+
+
+def _ymd(body: str, original: str) -> tuple[int, int, int] | None:
+    """時刻を除いた本体を (年, 月, 日) にする。規則にない書式なら None。"""
+    if m := _SEP_DATE.fullmatch(body):
+        return int(m[1]), int(m[3]), int(m[4])
+    if m := _COMPACT.fullmatch(body):
+        return int(m[1]), int(m[2]), int(m[3])
+    if m := _KANJI.fullmatch(body):
+        return int(m[1]), int(m[2]), int(m[3])
+    if m := _WAREKI_KANJI.fullmatch(body):
+        return _gengo_year(m[1], m[2], original), int(m[3]), int(m[4])
+    if m := _WAREKI_ABBR.fullmatch(body):
+        return _gengo_year(m[1].upper(), m[2], original), int(m[4]), int(m[5])
+    return None
+
+
+def parse_date(s: str) -> date:
+    """日付の文字列を date にする。時刻が後ろにあれば読み捨てる。
+
+    受け付ける書式は R2 / R3 / R4 の通り。規則にない入力・存在しない日付は ValueError。
+    """
+    if not isinstance(s, str):
+        raise TypeError(f"s は str が必要です: {type(s).__name__}")
+    text = unicodedata.normalize("NFKC", s).strip()
+    m = _TIME_SUFFIX.fullmatch(text)
+    assert m is not None  # 任意の文字列に必ず一致する
+    parts = _ymd(m[1], s)
+    if parts is None:
+        raise ValueError(f"日付の書式ではありません: {s!r}")
+    y, mo, d = parts
+    try:
+        return date(y, mo, d)
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
