+"""明細の絞り込み。条件は dict の木:
+
+    {"and": [{"category": "food"}, {"not": {"memo_contains": "コンビニ"}}]}
+    葉のキー: category / amount_min / amount_max / memo_contains / date_from / date_to
+
+D1: 条件は行を見る前に 1 度検査する(空の明細でも不正な条件は ValueError / TypeError)。
+D2: 条件が空の dict は ValueError(「全部」は {"and": []} と書く)。
+"""
+
+from __future__ import annotations
+
+from datetime import date
+
+from kakeibo._query_leaf import match_leaf
+from kakeibo._query_tree import evaluate
+from kakeibo.core import Expense
+
+_PROBE = Expense(date(2000, 1, 1), "", 0, "")
+
+
+def matches(e: Expense, query: dict) -> bool:
+    return evaluate(query, lambda leaf: match_leaf(e, leaf))
+
+
+def search(rows: list[Expense], query: dict) -> list[Expense]:
+    """query に合う明細を元の順序のまま返す。"""
+    matches(_PROBE, query)  # 構文・型の検査(評価は短絡しない)
+    return [e for e in rows if matches(e, query)]
diff --git a/src/kakeibo/statement.py b/src/kakeibo/statement.py
new file mode 100644
index 0000000..3b4c643
--- /dev/null
+++ b/src/kakeibo/statement.py
@@ -0,0 +1,99 @@
+"""銀行・カード会社の CSV を Expense に取り込む(ファイルは読まず、文字列を受け取る)。
+
+D1: ヘッダーが使えない(必須列が無い・列が重複)ときは全体を読めないので ValueError。
+D2: 行ごとの誤りは止めずに集め、1 行の複数の誤りはすべて RowIssue にする。
+D3: 入金だけの行(出金/入金の 2 列形式)は誤りではなくスキップ。
+D4: カテゴリ列が無ければ「未分類」。単一の金額列の負数は返金として負のまま取り込む。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+
+from kakeibo._import_amount import parse_amount
+from kakeibo._import_date import parse_date
+from kakeibo._import_header import map_header
+from kakeibo._import_split import split_records
+from kakeibo.core import Expense
+
+UNCATEGORIZED = "未分類"
+
+
+@dataclass(frozen=True)
+class RowIssue:
+    line: int
+    column: str  # 役割名(date / amount / withdrawal / memo など)
+    value: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class StatementResult:
+    expenses: list[Expense] = field(default_factory=list)
+    issues: list[RowIssue] = field(default_factory=list)
+    skipped: int = 0  # 入金だけでスキップした行数
+
+
+def import_statement(text: str, delimiter: str | None = None) -> StatementResult:
+    records = split_records(text, delimiter)
+    if not records:
+        return StatementResult()
+    _, header = records[0]
+    cols = map_header(header)
+    width = len(header)
+    expenses: list[Expense] = []
+    issues: list[RowIssue] = []
+    skipped = 0
+
+    for line, cells in records[1:]:
+        if len(cells) != width:
+            why = (
+                "列が足りません"
+                if len(cells) < width
+                else ("列が多すぎます(引用されていない区切りの可能性)")
+            )
+            issues.append(
+                RowIssue(line, "", f"{len(cells)} 列", f"{why}(期待 {width} 列)")
+            )
+            continue
+
+        def cell(role: str, row: list[str] = cells) -> str:
+            return row[cols[role]] if role in cols else ""
+
+        problems: list[RowIssue] = []
+        day = None
+        try:
+            day = parse_date(cell("date"))
+        except (ValueError, TypeError) as e:
+            problems.append(RowIssue(line, "date", cell("date"), str(e)))
+
+        amount: int | None = None
+        if "amount" in cols:
+            try:
+                amount = parse_amount(cell("amount"))
+            except (ValueError, TypeError) as e:
+                problems.append(RowIssue(line, "amount", cell("amount"), str(e)))
+        else:
+            out_s, in_s = cell("withdrawal"), cell("deposit")
+            if out_s:
+                try:
+                    amount = parse_amount(out_s)
+                except (ValueError, TypeError) as e:
+                    problems.append(RowIssue(line, "withdrawal", out_s, str(e)))
+            elif in_s:
+                if not problems:
+                    skipped += 1
+                    continue
+            else:
+                problems.append(
+                    RowIssue(line, "withdrawal", "", "出金額も入金額も空です")
+                )
+
+        if problems:
+            issues.extend(problems)
+            continue
+        assert day is not None and amount is not None
+        expenses.append(
+            Expense(day, cell("category") or UNCATEGORIZED, amount, cell("memo"))
+        )
+    return StatementResult(expenses, issues, skipped)
