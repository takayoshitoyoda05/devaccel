@@ -0,0 +1,130 @@
+import pytest
+
+from kakeibo._query_tree import evaluate
+
+
+def leaf_value(node: dict) -> bool:
+    return node["v"]
+
+
+@pytest.mark.parametrize(
+    ("node", "expected"),
+    [
+        pytest.param({"and": []}, True, id="E8-1"),
+        pytest.param({"or": []}, False, id="E8-1b"),
+    ],
+)
+def test_empty_and_or(node, expected):
+    assert evaluate(node, leaf_value) is expected
+
+
+@pytest.mark.parametrize(
+    ("node", "expected"),
+    [
+        pytest.param(
+            {"not": {"or": [{"v": True}, {"v": False}]}},
+            False,
+            id="E8-2",
+        ),
+    ],
+)
+def test_not_of_or(node, expected):
+    assert evaluate(node, leaf_value) is expected
+
+
+@pytest.mark.parametrize(
+    "node",
+    [
+        pytest.param({"and": [], "or": []}, id="E8-3"),
+    ],
+)
+def test_two_operator_keys_is_value_error(node):
+    with pytest.raises(ValueError):
+        evaluate(node, leaf_value)
+
+
+def test_leaf_dict_returns_leaf_result():
+    assert evaluate({"v": True}, leaf_value) is True
+    assert evaluate({"v": False}, leaf_value) is False
+
+
+def test_no_short_circuit_and():
+    seen = []
+
+    def leaf(node):
+        seen.append(node["id"])
+        return False
+
+    node = {"and": [{"id": 1, "v": False}, {"id": 2, "v": True}]}
+    assert evaluate(node, leaf) is False
+    assert seen == [1, 2]
+
+
+def test_no_short_circuit_or_reports_invalid_child():
+    def leaf(node):
+        if "bad" in node:
+            raise ValueError("bad leaf")
+        return True
+
+    node = {"or": [{"v": True}, {"bad": 1}]}
+    with pytest.raises(ValueError, match="bad leaf"):
+        evaluate(node, leaf)
+
+
+def test_nested_tree():
+    node = {"and": [{"or": [{"v": False}, {"v": True}]}, {"not": {"v": False}}]}
+    assert evaluate(node, leaf_value) is True
+
+
+def test_leaf_exception_propagates():
+    def leaf(node):
+        raise KeyError("boom")
+
+    with pytest.raises(KeyError):
+        evaluate({"v": 1}, leaf)
+
+
+@pytest.mark.parametrize("node", [["and"], "x", None, 1])
+def test_non_dict_node_is_type_error(node):
+    with pytest.raises(TypeError):
+        evaluate(node, leaf_value)
+
+
+@pytest.mark.parametrize(
+    "node",
+    [
+        {"and": {"v": True}},
+        {"or": "x"},
+        {"or": None},
+    ],
+)
+def test_and_or_value_must_be_list(node):
+    with pytest.raises(TypeError):
+        evaluate(node, leaf_value)
+
+
+@pytest.mark.parametrize(
+    "node",
+    [
+        {"not": [{"v": True}]},
+        {"not": True},
+        {"not": "x"},
+    ],
+)
+def test_not_value_must_be_dict(node):
+    with pytest.raises(TypeError):
+        evaluate(node, leaf_value)
+
+
+@pytest.mark.parametrize(
+    "node",
+    [
+        {"and": [], "not": {"v": True}},
+        {"or": [], "not": {"v": True}},
+        {"and": [], "extra": 1},
+        {"not": {"v": True}, "extra": 1},
+    ],
+)
+def test_operator_mixed_with_other_keys_is_value_error(node):
+    with pytest.raises(ValueError):
+        evaluate(node, leaf_value)
