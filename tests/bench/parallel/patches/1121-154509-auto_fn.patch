@@ -0,0 +1,36 @@
+"""毎月の固定支出を明細から見つけ、次回予定日を付ける。"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo._recur_next import next_due
+from kakeibo._recur_series import find_monthly_series
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class RecurringExpense:
+    category: str
+    memo: str
+    amount: int
+    days: tuple[date, ...]
+    next_due: date
+
+
+def find_recurring(
+    rows: list[Expense],
+    min_months: int = 3,
+    tolerance_pct: float = 0,
+    after: date | None = None,
+) -> list[RecurringExpense]:
+    """固定費の系列ごとに次回予定日(after より後)を付けて返す。並びは系列の並び。"""
+    out: list[RecurringExpense] = []
+    for s in find_monthly_series(rows, min_months, tolerance_pct):
+        out.append(
+            RecurringExpense(
+                s.category, s.memo, s.amount, s.days, next_due(list(s.days), after)
+            )
+        )
+    return out
