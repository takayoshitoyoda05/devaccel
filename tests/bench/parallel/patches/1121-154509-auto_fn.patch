index 0000000..8b83700
--- /dev/null
+++ b/src/kakeibo/_mom_diff.py
@@ -0,0 +1,55 @@
+"""カテゴリごとの前月との差(純粋関数)。"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    prev: int
+    cur: int
+    delta: int  # cur - prev
+    pct: float | None  # delta / abs(prev) * 100(丸めない)。prev == 0 なら None
+    status: str  # "up" | "down" | "same" | "new" | "gone"
+
+
+def _check_amounts(name: str, data: object) -> None:
+    if not isinstance(data, dict):
+        raise TypeError(f"{name} は dict である必要があります: {type(data).__name__}")
+    for key, value in data.items():
+        if not isinstance(key, str):
+            raise TypeError(f"{name} のキーは str である必要があります: {key!r}")
+        if isinstance(value, bool) or not isinstance(value, int):
+            raise TypeError(f"{name}[{key!r}] は int である必要があります: {value!r}")
+
+
+def diff_categories(prev: dict[str, int], cur: dict[str, int]) -> list[CategoryChange]:
+    """前月 (prev) と今月 (cur) のカテゴリ別金額の差を返す。
+
+    片方に無いカテゴリは 0 円として扱う。並びは abs(delta) 降順、同じなら category 昇順。
+    """
+    _check_amounts("prev", prev)
+    _check_amounts("cur", cur)
+
+    changes: list[CategoryChange] = []
+    for category in prev.keys() | cur.keys():
+        p = prev.get(category, 0)
+        c = cur.get(category, 0)
+        delta = c - p
+        pct = None if p == 0 else delta / abs(p) * 100
+        if p == 0 and c != 0:
+            status = "new"
+        elif c == 0 and p != 0:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        changes.append(CategoryChange(category, p, c, delta, pct, status))
+
+    changes.sort(key=lambda ch: (-abs(ch.delta), ch.category))
+    return changes
diff --git a/src/kakeibo/_mom_months.py b/src/kakeibo/_mom_months.py
new file mode 100644
index 0000000..9177955
--- /dev/null
+++ b/src/kakeibo/_mom_months.py
@@ -0,0 +1,64 @@
+"""Month arithmetic and gap filling for monthly totals (pure functions)."""
+
+from __future__ import annotations
+
+import re
+
+_MONTH_RE = re.compile(r"([0-9]{4})-(0[1-9]|1[0-2])")
+
+
+def _parse_month(month: object, where: str = "month") -> tuple[int, int]:
+    if not isinstance(month, str):
+        raise TypeError(f"{where} は str である必要があります: {type(month).__name__}")
+    m = _MONTH_RE.fullmatch(month)
+    if m is None or int(m.group(1)) < 1:
+        raise ValueError(
+            f"{where} は YYYY-MM 形式(0001-01 〜 9999-12)である必要があります: {month!r}"
+        )
+    return int(m.group(1)), int(m.group(2))
+
+
+def _format_month(year: int, month: int) -> str:
+    return f"{year:04d}-{month:02d}"
+
+
+def previous_month(month: str) -> str:
+    """Return the month before ``month`` (``2026-01`` -> ``2025-12``)."""
+    year, mon = _parse_month(month)
+    if mon == 1:
+        if year == 1:
+            raise ValueError(f"month に前の月がありません: {month!r}")
+        return _format_month(year - 1, 12)
+    return _format_month(year, mon - 1)
+
+
+def fill_months(totals: dict[str, dict[str, int]]) -> dict[str, dict[str, int]]:
+    """Fill gap months between the min and max month with empty ``{}`` entries.
+
+    Returns a new dict in ascending month order. Inner dicts are shallow copies.
+    """
+    if not isinstance(totals, dict):
+        raise TypeError(f"totals は dict である必要があります: {type(totals).__name__}")
+    for month, cats in totals.items():
+        _parse_month(month, where="totals のキー")
+        if not isinstance(cats, dict):
+            raise TypeError(
+                f"totals[{month!r}] は dict である必要があります: {type(cats).__name__}"
+            )
+    if not totals:
+        return {}
+
+    keys = sorted(totals, key=lambda m: _parse_month(m, where="totals のキー"))
+    start = _parse_month(keys[0], where="totals のキー")
+    end = _parse_month(keys[-1], where="totals のキー")
+
+    out: dict[str, dict[str, int]] = {}
+    year, mon = start
+    while (year, mon) <= end:
+        key = _format_month(year, mon)
+        out[key] = dict(totals[key]) if key in totals else {}
+        mon += 1
+        if mon == 13:
+            mon = 1
+            year += 1
+    return out
diff --git a/src/kakeibo/_query_leaf.py b/src/kakeibo/_query_leaf.py
new file mode 100644
index 0000000..ee6209d
--- /dev/null
+++ b/src/kakeibo/_query_leaf.py
@@ -0,0 +1,106 @@
+"""明細 1 件が検索条件の葉(leaf)に合うかを判定する純粋関数。"""
+
+from __future__ import annotations
+
+import unicodedata
+from datetime import date, datetime
+
+from kakeibo.core import Expense
+
+_KEYS = frozenset(
+    {"category", "amount_min", "amount_max", "memo_contains", "date_from", "date_to"}
+)
+
+
+def _norm(text: str) -> str:
+    return unicodedata.normalize("NFKC", text).casefold()
+
+
+def _category_names(value: object) -> frozenset[str]:
+    if isinstance(value, str):
+        if not value.strip():
+            raise ValueError("category が空の文字列です")
+        return frozenset({value.strip()})
+    if isinstance(value, list):
+        if not value:
+            raise ValueError("category が空の list です")
+        names: set[str] = set()
+        for item in value:
+            if not isinstance(item, str):
+                raise TypeError("category の要素は str である必要があります")
+            if not item.strip():
+                raise ValueError("category の要素が空です")
+            names.add(item.strip())
+        return frozenset(names)
+    raise TypeError("category は str または list[str] である必要があります")
+
+
+def _int_bound(value: object, key: str) -> int:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{key} は int である必要があります")
+    return value
+
+
+def _day_bound(value: object, key: str) -> date:
+    if isinstance(value, datetime) or not isinstance(value, date):
+        raise TypeError(f"{key} は date である必要があります(datetime 不可)")
+    return value
+
+
+def match_leaf(e: Expense, leaf: dict[str, object]) -> bool:
+    """明細 e が条件 leaf の全キーを満たすなら True。
+
+    検査はすべてのキーに対して行い、真偽の決定前に打ち切らない。
+    """
+    if not isinstance(e, Expense):
+        raise TypeError("e は Expense である必要があります")
+    if not isinstance(leaf, dict):
+        raise TypeError("leaf は dict である必要があります")
+    if not leaf:
+        raise ValueError("leaf が空です")
+    unknown = [str(k) for k in leaf if k not in _KEYS]
+    if unknown:
+        raise ValueError(f"未知のキーです: {', '.join(unknown)}")
+
+    cat_names: frozenset[str] | None = None
+    amount_lo: int | None = None
+    amount_hi: int | None = None
+    needle: str | None = None
+    day_from: date | None = None
+    day_to: date | None = None
+
+    if "category" in leaf:
+        cat_names = _category_names(leaf["category"])
+    if "amount_min" in leaf:
+        amount_lo = _int_bound(leaf["amount_min"], "amount_min")
+    if "amount_max" in leaf:
+        amount_hi = _int_bound(leaf["amount_max"], "amount_max")
+    if "memo_contains" in leaf:
+        raw = leaf["memo_contains"]
+        if not isinstance(raw, str):
+            raise TypeError("memo_contains は str である必要があります")
+        needle = _norm(raw)
+    if "date_from" in leaf:
+        day_from = _day_bound(leaf["date_from"], "date_from")
+    if "date_to" in leaf:
+        day_to = _day_bound(leaf["date_to"], "date_to")
+
+    if amount_lo is not None and amount_hi is not None and amount_lo > amount_hi:
+        raise ValueError("amount_min が amount_max より大きいです")
+    if day_from is not None and day_to is not None and day_from > day_to:
+        raise ValueError("date_from が date_to より後です")
+
+    results: list[bool] = []
+    if cat_names is not None:
+        results.append(e.category.strip() in cat_names)
+    if amount_lo is not None:
+        results.append(e.amount >= amount_lo)
+    if amount_hi is not None:
+        results.append(e.amount <= amount_hi)
+    if needle is not None:
+        results.append(needle in _norm(e.memo))
+    if day_from is not None:
+        results.append(e.day >= day_from)
+    if day_to is not None:
+        results.append(e.day <= day_to)
+    return all(results)
