@@ -0,0 +1,35 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.recurring import find_recurring
+
+
+def _e(m: int, d: int, memo: str, amount: int, cat: str = "固定費") -> Expense:
+    return Expense(date(2026, m, d), cat, amount, memo)
+
+
+def test_rent_and_subscription_with_next_due():
+    rows = [_e(m, 25, "家賃", 80000, "住居") for m in (1, 2, 3)]
+    rows += [_e(m, 5, f"Netflix #{m}", 1490, "娯楽") for m in (1, 2, 3)]
+    rows.append(_e(2, 10, "ランチ", 900, "食費"))
+    got = find_recurring(rows)
+    assert [(r.memo, r.amount, r.next_due) for r in got] == [
+        ("家賃", 80000, date(2026, 4, 25)),
+        ("netflix", 1490, date(2026, 4, 5)),
+    ]
+
+
+def test_after_pushes_next_due_forward():
+    rows = [_e(m, 5, "ジム", 7000) for m in (1, 2, 3)]
+    (r,) = find_recurring(rows, after=date(2026, 6, 10))
+    assert r.next_due == date(2026, 7, 5)
+
+
+def test_month_end_clamped():
+    rows = [_e(1, 31, "保険", 3000), _e(2, 28, "保険", 3000), _e(3, 31, "保険", 3000)]
+    (r,) = find_recurring(rows)
+    assert r.next_due == date(2026, 4, 30)
+
+
+def test_not_recurring_returns_empty():
+    assert find_recurring([_e(1, 5, "単発", 500), _e(3, 5, "単発", 500)]) == []
