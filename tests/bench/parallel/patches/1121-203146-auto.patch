diff --git a/src/kakeibo/core.py b/src/kakeibo/core.py
index 8c3cbab..e8231fe 100644
--- a/src/kakeibo/core.py
+++ b/src/kakeibo/core.py
@@ -122,14 +122,40 @@ def load_budget(path: Path) -> Budget:
     return Budget(default, months)
 
 
-def find_overruns(
+NEAR_LIMIT_PERCENT = 90
+
+
+def usage_percent(actual: int, limit: int) -> int | None:
+    """actual / limit in whole percent (rounded down); None when limit is 0."""
+    if limit == 0:
+        return None
+    return actual * 100 // limit
+
+
+def find_budget_alerts(
     totals: dict[str, dict[str, int]], budget: Budget
 ) -> list[tuple[str, str, int, int, int]]:
-    """(month, category, over, limit, actual) for actual > limit."""
+    """(month, category, over, limit, actual) in month/category order.
+
+    over > 0 is an overrun; over == 0 is a near-limit notice
+    (actual >= NEAR_LIMIT_PERCENT% of a positive limit, not over it).
+    """
     out: list[tuple[str, str, int, int, int]] = []
     for month, cats in totals.items():
         limits = budget.for_month(month)
         for cat, actual in cats.items():
-            if cat in limits and actual > limits[cat]:
-                out.append((month, cat, actual - limits[cat], limits[cat], actual))
+            if cat not in limits:
+                continue
+            limit = limits[cat]
+            if actual > limit:
+                out.append((month, cat, actual - limit, limit, actual))
+            elif limit > 0 and actual * 100 >= limit * NEAR_LIMIT_PERCENT:
+                out.append((month, cat, 0, limit, actual))
     return out
+
+
+def find_overruns(
+    totals: dict[str, dict[str, int]], budget: Budget
+) -> list[tuple[str, str, int, int, int]]:
+    """(month, category, over, limit, actual) for actual > limit."""
+    return [a for a in find_budget_alerts(totals, budget) if a[2] > 0]
