@@ -0,0 +1,172 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import CsvError, Expense
+from kakeibo.importer import parse_amount, parse_statement
+
+
+@pytest.mark.parametrize(
+    ("raw", "want"),
+    [
+        ("1234", 1234),
+        ("1,234", 1234),
+        ("１，２３４", 1234),
+        ("¥1,234", 1234),
+        ("￥1234", 1234),
+        ("1,234円", 1234),
+        ("JPY 500", 500),
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("¥-300", -300),
+        ("1234.0", 1234),
+        ("1234.00", 1234),
+        ("0", 0),
+        ("　700　", 700),
+    ],
+)
+def test_parse_amount_accepts(raw: str, want: int) -> None:
+    assert parse_amount(raw) == want
+
+
+@pytest.mark.parametrize("raw", ["", "-", "abc", "12.5", "1 2x", "--5", "()"])
+def test_parse_amount_rejects(raw: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(raw)
+
+
+@pytest.mark.parametrize("raw", [None, 5, 1.5, True])
+def test_parse_amount_type_error(raw: object) -> None:
+    with pytest.raises(TypeError):
+        parse_amount(raw)  # type: ignore[arg-type]
+
+
+def test_single_amount_column_and_aliases() -> None:
+    text = 'ご利用日,ご利用店名,ご利用金額\n2026/1/5,コンビニ,"1,234"\n2026/01/06,スーパー,500円\n'
+    assert parse_statement(text) == [
+        Expense(date(2026, 1, 5), "未分類", 1234, "コンビニ"),
+        Expense(date(2026, 1, 6), "未分類", 500, "スーパー"),
+    ]
+
+
+def test_header_case_space_and_fullwidth() -> None:
+    text = " Date , Amount ,Description\n2026-01-05,100,x\n"
+    assert parse_statement(text) == [Expense(date(2026, 1, 5), "未分類", 100, "x")]
+
+
+def test_refund_kept_negative() -> None:
+    text = "日付,金額\n2026-01-05,△500\n"
+    assert parse_statement(text)[0].amount == -500
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026.1.5",
+        "2026年1月5日",
+        "20260105",
+        "２０２６/１/５",
+        "2026/01/05 12:30",
+        "2026-01-05T12:30:00",
+        "2026-01/05",
+    ],
+)
+def test_date_formats(raw: str) -> None:
+    assert parse_statement(f"日付,金額\n{raw},1\n")[0].day == date(2026, 1, 5)
+
+
+def test_leap_day_ok_and_nonexistent_date_error() -> None:
+    assert parse_statement("日付,金額\n2024-02-29,1\n")[0].day == date(2024, 2, 29)
+    with pytest.raises(CsvError) as ei:
+        parse_statement("日付,金額\n2026-02-30,1\n")
+    assert ei.value.errors == [(2, "日付: 存在しない日付です: '2026-02-30'")]
+
+
+def test_withdrawal_deposit_skips_income() -> None:
+    text = (
+        "取引日,摘要,出金額,入金額\n2026/01/05,家賃,80000,\n2026/01/25,給与,,300000\n"
+    )
+    assert parse_statement(text) == [Expense(date(2026, 1, 5), "未分類", 80000, "家賃")]
+
+
+def test_withdrawal_deposit_errors() -> None:
+    text = "日付,出金額,入金額\n2026-01-05,1,2\n2026-01-06,,\n2026-01-07,,abc\n"
+    with pytest.raises(CsvError) as ei:
+        parse_statement(text)
+    assert [n for n, _ in ei.value.errors] == [2, 3, 4]
+    assert "両方" in ei.value.errors[0][1]
+    assert "空" in ei.value.errors[1][1]
+    assert "入金額" in ei.value.errors[2][1] and "'abc'" in ei.value.errors[2][1]
+
+
+def test_all_errors_reported_with_line_column_value() -> None:
+    text = "日付,金額\n2026-01-05,100\nxx,yy\n2026-01-07,-\n"
+    with pytest.raises(CsvError) as ei:
+        parse_statement(text)
+    errs = ei.value.errors
+    assert [n for n, _ in errs] == [3, 4]
+    assert "日付" in errs[0][1] and "'xx'" in errs[0][1]
+    assert "金額" in errs[0][1] and "'yy'" in errs[0][1]
+    assert "空" in errs[1][1]
+
+
+def test_unquoted_comma_is_column_count_error() -> None:
+    with pytest.raises(CsvError) as ei:
+        parse_statement("日付,金額\n2026-01-05,1,234円\n")
+    assert ei.value.errors[0][0] == 2
+    assert "列数" in ei.value.errors[0][1]
+
+
+def test_line_number_with_quoted_newline() -> None:
+    text = '日付,メモ,金額\n2026-01-05,"a\nb",1\nbad,x,1\n'
+    with pytest.raises(CsvError) as ei:
+        parse_statement(text)
+    assert [n for n, _ in ei.value.errors] == [4]
+
+
+def test_missing_required_columns() -> None:
+    with pytest.raises(CsvError) as ei:
+        parse_statement("店,メモ\nx,y\n")
+    assert ei.value.errors[0][0] == 1
+    assert "日付" in ei.value.errors[0][1] and "金額" in ei.value.errors[0][1]
+
+
+def test_duplicate_column_is_header_error() -> None:
+    with pytest.raises(CsvError) as ei:
+        parse_statement("日付,利用日,金額\n2026-01-05,2026-01-05,1\n")
+    assert ei.value.errors[0][0] == 1
+
+
+def test_bom_tab_blank_lines() -> None:
+    text = "﻿日付\t金額\n\n2026-01-05\t100\n\n"
+    assert parse_statement(text) == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+def test_crlf() -> None:
+    assert len(parse_statement("日付,金額\r\n2026-01-05,1\r\n2026-01-06,2\r\n")) == 2
+
+
+@pytest.mark.parametrize("text", ["", "\n\n", "日付,金額\n", "﻿日付,金額"])
+def test_empty_and_header_only(text: str) -> None:
+    assert parse_statement(text) == []
+
+
+def test_category_default_and_column() -> None:
+    text = "日付,金額,カテゴリ\n2026-01-05,1,食費\n2026-01-06,2,\n"
+    got = parse_statement(text, category="カード")
+    assert [e.category for e in got] == ["食費", "カード"]
+
+
+def test_argument_validation() -> None:
+    with pytest.raises(TypeError):
+        parse_statement(b"x")  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        parse_statement("日付,金額\n", category=None)  # type: ignore[arg-type]
+    with pytest.raises(ValueError, match="category"):
+        parse_statement("日付,金額\n", category="  ")
