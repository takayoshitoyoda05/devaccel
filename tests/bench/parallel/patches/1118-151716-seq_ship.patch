new file mode 100644
index 0000000..1f8924b
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,116 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def _e(m, cat, amount, d=1, y=2026):
+    return Expense(date(y, m, d), cat, amount)
+
+
+ROWS = [
+    _e(10, "food", 1000),
+    _e(10, "food", 1000, 5),
+    _e(11, "food", 2400),
+    _e(10, "rent", 80000),
+    _e(11, "rent", 80000),
+    _e(10, "game", 500),
+    _e(11, "new", 300),
+    _e(11, "zero", 0),
+    _e(10, "zero", 0),
+    _e(9, "old", 999),
+]
+
+
+def test_month_diff():
+    out = month_diff(ROWS, "2026-10", "2026-11")
+    assert out == [
+        DiffRow("game", 500, 0, -500, -100.0, "gone"),
+        DiffRow("food", 2000, 2400, 400, 20.0, "up"),
+        DiffRow("new", 0, 300, 300, None, "new"),
+        DiffRow("rent", 80000, 80000, 0, 0.0, "same"),
+        DiffRow("zero", 0, 0, 0, None, "same"),
+    ]
+
+
+def test_sort_abs_delta_then_category():
+    rows = [_e(11, "b", 100), _e(11, "a", 100), _e(11, "c", 200)]
+    out = month_diff(rows, "2026-10", "2026-11")
+    assert [d.category for d in out] == ["c", "a", "b"]
+
+
+def test_status_by_presence_not_total():
+    rows = [_e(10, "a", 0), _e(11, "b", 0)]
+    out = {d.category: d.status for d in month_diff(rows, "2026-10", "2026-11")}
+    assert out == {"a": "gone", "b": "new"}
+
+
+def test_down_and_rounding():
+    rows = [_e(10, "a", 3), _e(11, "a", 2)]
+    (d,) = month_diff(rows, "2026-10", "2026-11")
+    assert (d.delta, d.pct, d.status) == (-1, -33.3, "down")
+
+
+@pytest.mark.parametrize(
+    "bad", ["2026-1", "2026-13", "2026-00", "26-10", "2026/10", "2026-10 "]
+)
+def test_bad_month(bad):
+    with pytest.raises(ValueError):
+        month_diff([], bad, "2026-11")
+    with pytest.raises(ValueError):
+        month_diff([], "2026-10", bad)
+
+
+def test_empty_and_unrelated():
+    assert month_diff([], "2026-10", "2026-11") == []
+    assert month_diff([_e(1, "a", 5)], "2026-10", "2026-11") == []
+
+
+def test_top_movers():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    assert [d.category for d in top_movers(diffs)] == ["game", "food", "new"]
+    assert [d.category for d in top_movers(diffs, 1)] == ["game"]
+    assert top_movers(diffs, 0) == []
+    assert len(top_movers(diffs, 99)) == 3
+    with pytest.raises(ValueError):
+        top_movers(diffs, -1)
+
+
+def test_render_diff():
+    diffs = [
+        DiffRow("a", 1000, 3000, 2000, 200.0, "up"),
+        DiffRow("b", 2000, 0, -2000, -100.0, "gone"),
+        DiffRow("c", 0, 300, 300, None, "new"),
+        DiffRow("d", 5, 5, 0, 0.0, "same"),
+    ]
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "a\t1000\t3000\t+2000\t+200.0%\n"
+        "b\t2000\t0\t-2000\t-100.0%\n"
+        "c\t0\t300\t+300\t-\n"
+        "d\t5\t5\t+0\t+0.0%"
+    )
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_available_and_latest():
+    assert available_months([]) == []
+    assert available_months(ROWS) == ["2026-09", "2026-10", "2026-11"]
+    rows = [_e(12, "a", 1, y=2025), _e(1, "a", 3, y=2026), _e(1, "a", 4, 9, 2026)]
+    assert available_months(rows) == ["2025-12", "2026-01"]
+    (d,) = latest_diff(rows)
+    assert (d.prev, d.curr, d.status) == (1, 7, "up")
+    assert next(x.category for x in latest_diff(ROWS)) == "game"  # Oct vs Nov
+    with pytest.raises(ValueError):
+        latest_diff([_e(1, "a", 1)])
+    with pytest.raises(ValueError):
+        latest_diff([])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..2f62e54
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,114 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def _e(cat, memo=""):
+    return Expense(date(2026, 1, 1), cat, 100, memo)
+
+
+def test_tokenize():
+    assert tokenize('a AND (b OR "c d") NOT cat:Food and') == [
+        ("TERM", "a"),
+        ("AND", "AND"),
+        ("LPAREN", "("),
+        ("TERM", "b"),
+        ("OR", "OR"),
+        ("TERM", "c d"),
+        ("RPAREN", ")"),
+        ("NOT", "NOT"),
+        ("CAT", "Food"),
+        ("TERM", "and"),
+    ]
+    assert tokenize("  ") == []
+    assert tokenize('"AND" "(x)"') == [("TERM", "AND"), ("TERM", "(x)")]
+    assert tokenize("a(b)") == [
+        ("TERM", "a"),
+        ("LPAREN", "("),
+        ("TERM", "b"),
+        ("RPAREN", ")"),
+    ]
+    assert tokenize("xcat:y") == [("TERM", "xcat:y")]
+    assert tokenize("ANDROID") == [("TERM", "ANDROID")]
+
+
+@pytest.mark.parametrize("q", ['"abc', '""', "cat:", 'cat:"x"', 'a "'])
+def test_tokenize_errors(q):
+    with pytest.raises(QueryError):
+        tokenize(q)
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "  ",
+        "()",
+        "(a",
+        "a)",
+        "a AND",
+        "AND a",
+        "a OR",
+        "OR a",
+        "NOT",
+        "a AND OR b",
+        "a OR OR b",
+        "(a))",
+        ")(",
+        "NOT)",
+    ],
+)
+def test_syntax_errors(q):
+    with pytest.raises(QueryError):
+        matches(q, _e("x"))
+    with pytest.raises(QueryError):
+        filter_rows(q, [])
+
+
+def test_term_matches_memo_or_category_casefold():
+    assert matches("coffee", _e("food", "Morning COFFEE"))
+    assert matches("FOO", _e("food"))
+    assert not matches("tea", _e("food", "coffee"))
+    assert matches('"ing cof"', _e("x", "Morning Coffee"))
+
+
+def test_cat_exact():
+    assert matches("cat:FOOD", _e("food"))
+    assert not matches("cat:foo", _e("food"))
+    assert not matches("cat:food", _e("foodie"))
+
+
+def test_precedence_and_implicit_and():
+    e = _e("food", "lunch")
+    assert matches("food lunch", e)
+    assert matches("food AND lunch", e)
+    assert not matches("food dinner", e)
+    # AND binds tighter than OR
+    assert matches("dinner food OR lunch", e)  # (dinner AND food) OR lunch
+    assert not matches("dinner (food OR lunch)", e)
+    # NOT binds tighter than AND
+    assert matches("NOT dinner food", e)
+    assert not matches("NOT food lunch", e)
+    assert matches("NOT NOT food", e)
+    assert not matches("NOT (food OR lunch)", e)
+    assert matches("a OR b OR food", e)
+
+
+def test_filter_rows_order_and_invalid_with_empty():
+    rows = [_e("a", "x"), _e("b", "y"), _e("a", "z")]
+    assert filter_rows("cat:a", rows) == [rows[0], rows[2]]
+    assert filter_rows("NOT cat:a", rows) == [rows[1]]
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
+
+
+def test_query_error_is_value_error():
+    assert issubclass(QueryError, ValueError)
+
+
+def test_deep_nesting_is_query_error():
+    with pytest.raises(QueryError):
+        matches("(" * 5000 + "a" + ")" * 5000, _e("a"))
