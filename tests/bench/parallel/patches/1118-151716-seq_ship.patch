+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.weekday import total_by_weekday
+
+
+def test_empty():
+    assert total_by_weekday([]) == {}
+
+
+def test_totals_and_order():
+    # 2026-11-02 is a Monday
+    rows = [
+        Expense(date(2026, 11, 8), "a", 5),  # Sun
+        Expense(date(2026, 11, 2), "a", 100),  # Mon
+        Expense(date(2026, 11, 9), "b", 50),  # Mon
+        Expense(date(2026, 11, 4), "a", 7),  # Wed
+    ]
+    out = total_by_weekday(rows)
+    assert out == {"Mon": 150, "Wed": 7, "Sun": 5}
+    assert list(out) == ["Mon", "Wed", "Sun"]
