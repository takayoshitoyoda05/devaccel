@@ -0,0 +1,162 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import (
+    DEFAULT_MAPPING,
+    import_rows,
+    parse_amount,
+    parse_date,
+)
+from kakeibo.core import Expense
+
+
+@pytest.mark.parametrize(
+    ("s", "want"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥1,0円", 10),
+        ("-12,3,4", -1234),
+        ("\t42\n", 42),
+    ],
+)
+def test_parse_amount_ok(s, want):
+    assert parse_amount(s) == want
+
+
+@pytest.mark.parametrize(
+    "s",
+    [
+        "",
+        "  ",
+        "円",
+        "12.5",
+        "1 200",
+        "--5",
+        "¥-5",
+        "１２３",
+        "-",
+        ",1",
+        "¥",
+        "1円円",
+        "¥¥1",
+        "円1",
+        "+5",
+    ],
+)
+def test_parse_amount_bad(s):
+    with pytest.raises(ValueError):
+        parse_amount(s)
+
+
+@pytest.mark.parametrize(
+    ("s", "want"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/12/31 ", date(2026, 12, 31)),
+        ("2024/2/29", date(2024, 2, 29)),
+    ],
+)
+def test_parse_date_ok(s, want):
+    assert parse_date(s) == want
+
+
+@pytest.mark.parametrize(
+    "s",
+    [
+        "2026/1-5",
+        "26/1/5",
+        "2026/02/30",
+        "2026/13/1",
+        "2026/1/005",
+        "２０２６/1/1",
+        "2026/1",
+        "20260105",
+        "",
+        "0000/1/1",
+        "2026/1/5/",
+    ],
+)
+def test_parse_date_bad(s):
+    with pytest.raises(ValueError):
+        parse_date(s)
+
+
+HEADER = "利用日,分類,利用金額,利用店名,余分\n"
+
+
+def test_import_basic():
+    text = (
+        HEADER
+        + '2026/1/5,食費,"¥1,200","カフェ, 渋谷",x\n2026-01-06,交通,-300円,  電車 ,\n'
+    )
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [
+        Expense(date(2026, 1, 5), "食費", 1200, "カフェ, 渋谷"),
+        Expense(date(2026, 1, 6), "交通", -300, "電車"),
+    ]
+
+
+def test_import_errors_line_numbers_and_order():
+    text = (
+        HEADER
+        + "2026/1/5,食費,100,a,\n"  # line 2 ok
+        + "\n"  # line 3 blank
+        + "bad,  ,xx,m,\n"  # line 4: all three
+        + "2026/1/7,食費\n"  # line 5: amount missing
+        + '2026/1/8,"a\nb",5,m,\n'  # lines 6-7 ok (multi-line category)
+        + "2026/1/9,食費,1,m,\n"  # line 8 ok
+        + "2026/2/30,食費,5,m,\n"  # line 9: date
+    )
+    rows, errors = import_rows(text)
+    assert errors == [
+        (4, "date"),
+        (4, "amount"),
+        (4, "category"),
+        (5, "amount"),
+        (9, "date"),
+    ]
+    assert [r.day.day for r in rows] == [5, 8, 9]
+
+
+def test_missing_cells_are_empty():
+    rows, errors = import_rows("利用日,分類,利用金額,利用店名\n2026/1/1,食費,5\n")
+    assert errors == []
+    assert rows[0].memo == ""
+
+
+def test_mapping_and_category_map_and_optional_memo():
+    text = "d,c,a\n2026/1/1, food ,100\n2026/1/2,other,7\n"
+    rows, errors = import_rows(
+        text,
+        {"date": "d", "category": "c", "amount": "a"},
+        {"food": "食費"},
+    )
+    assert errors == []
+    assert rows == [
+        Expense(date(2026, 1, 1), "食費", 100, ""),
+        Expense(date(2026, 1, 2), "other", 7, ""),
+    ]
+
+
+def test_mapping_errors():
+    with pytest.raises(ValueError):
+        import_rows("d,c\n", {"date": "d", "category": "c"})
+    with pytest.raises(ValueError):
+        import_rows("d,c,a\n", {"date": "d", "category": "c", "amount": "zzz"})
+    with pytest.raises(ValueError):
+        import_rows(
+            "d,c,a\n", {"date": "d", "category": "c", "amount": "a", "memo": "m"}
+        )
+    with pytest.raises(ValueError):
+        import_rows("", None)
+
+
+def test_default_mapping_and_empty_body():
+    assert set(DEFAULT_MAPPING) == {"date", "category", "amount", "memo"}
+    assert import_rows(HEADER) == ([], [])
