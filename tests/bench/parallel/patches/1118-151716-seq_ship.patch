@@ -0,0 +1,100 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+@pytest.mark.parametrize(
+    ("d", "want"),
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2024, 1, 31), date(2024, 2, 29)),
+        (date(2026, 12, 15), date(2027, 1, 15)),
+        (date(2026, 3, 31), date(2026, 4, 30)),
+        (date(2026, 5, 10), date(2026, 6, 10)),
+    ],
+)
+def test_add_month(d, want):
+    assert add_month(d) == want
+
+
+def _e(y, m, d, cat="rent", amount=1000, memo=""):
+    return Expense(date(y, m, d), cat, amount, memo)
+
+
+def test_basic_monthly():
+    rows = [_e(2026, 1, 25), _e(2026, 2, 25), _e(2026, 3, 26)]
+    assert find_recurring(rows) == [
+        Recurring(
+            "rent",
+            1000,
+            (date(2026, 1, 25), date(2026, 2, 25), date(2026, 3, 26)),
+            date(2026, 4, 26),
+        )
+    ]
+
+
+def test_validation():
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+    assert find_recurring([]) == []
+
+
+def test_min_count_and_tolerance_boundary():
+    rows = [_e(2026, 1, 10), _e(2026, 2, 13)]  # exactly 3 days off
+    assert find_recurring(rows, min_count=2)
+    assert find_recurring(rows, min_count=2, tolerance=2) == []
+    assert find_recurring(rows, min_count=3) == []
+
+
+def test_memo_ignored_and_duplicates_collapsed():
+    rows = [
+        _e(2026, 1, 5, memo="a"),
+        _e(2026, 1, 5, memo="b"),
+        _e(2026, 2, 5),
+        _e(2026, 3, 5),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_groups_by_amount_and_sorting():
+    rows = []
+    for m in (1, 2, 3):
+        rows += [_e(2026, m, 1, "z", 500), _e(2026, m, 1, "a", 900)]
+        rows.append(_e(2026, m, 1, "a", 100))
+    out = find_recurring(rows)
+    assert [(r.category, r.amount) for r in out] == [("a", 100), ("a", 900), ("z", 500)]
+
+
+def test_split_into_multiple_runs():
+    rows = [
+        _e(2025, 1, 1),
+        _e(2025, 2, 1),
+        _e(2025, 3, 1),
+        # gap
+        _e(2025, 8, 1),
+        _e(2025, 9, 1),
+        _e(2025, 10, 1),
+        _e(2025, 11, 1),
+    ]
+    out = find_recurring(rows)
+    assert [len(r.days) for r in out] == [3, 4]
+    assert out[0].next_expected == date(2025, 4, 1)
+    assert out[1].next_expected == date(2025, 12, 1)
+    assert find_recurring(rows, min_count=4)[0].days[0] == date(2025, 8, 1)
+
+
+def test_month_end_chain():
+    rows = [_e(2026, 1, 31), _e(2026, 2, 28), _e(2026, 3, 28)]
+    (r,) = find_recurring(rows)
+    assert r.next_expected == date(2026, 4, 28)
+
+
+def test_weekly_not_monthly():
+    rows = [_e(2026, 1, 1), _e(2026, 1, 8), _e(2026, 1, 15)]
+    assert find_recurring(rows) == []
