@@ -0,0 +1,18 @@
+"""No-spend streaks."""
+
+from __future__ import annotations
+
+from datetime import date, timedelta
+
+from kakeibo.core import Expense
+
+
+def longest_no_spend_streak(rows: list[Expense], start: date, end: date) -> int:
+    spent = {e.day for e in rows}
+    best = cur = 0
+    d = start
+    while d <= end:
+        cur = 0 if d in spent else cur + 1
+        best = max(best, cur)
+        d += timedelta(days=1)
+    return best
