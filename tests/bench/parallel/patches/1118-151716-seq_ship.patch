+"""Totals by weekday."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+_NAMES = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
+
+
+def total_by_weekday(rows: list[Expense]) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for e in rows:
+        name = _NAMES[e.day.weekday()]
+        out[name] = out.get(name, 0) + e.amount
+    return {n: out[n] for n in _NAMES if n in out}
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
