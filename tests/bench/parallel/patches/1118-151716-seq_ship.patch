+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.streak import longest_no_spend_streak
+
+
+def _e(d: int) -> Expense:
+    return Expense(date(2026, 1, d), "c", 1)
+
+
+def test_no_rows_whole_period():
+    assert longest_no_spend_streak([], date(2026, 1, 1), date(2026, 1, 10)) == 10
+
+
+def test_single_day_period():
+    assert longest_no_spend_streak([], date(2026, 1, 1), date(2026, 1, 1)) == 1
+    assert longest_no_spend_streak([_e(1)], date(2026, 1, 1), date(2026, 1, 1)) == 0
+
+
+def test_inclusive_ends_and_gaps():
+    rows = [_e(1), _e(5), _e(6), _e(10)]
+    # free: 2-4 (3 days), 7-9 (3 days)
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 10)) == 3
+    # window starting on a free day, ending on a free day
+    assert longest_no_spend_streak(rows, date(2026, 1, 2), date(2026, 1, 9)) == 3
+
+
+def test_rows_outside_ignored_and_empty_range():
+    assert longest_no_spend_streak([_e(1)], date(2026, 1, 2), date(2026, 1, 4)) == 3
+    assert longest_no_spend_streak([], date(2026, 1, 5), date(2026, 1, 1)) == 0
+
+
+def test_across_month_end():
+    rows = [Expense(date(2026, 2, 3), "c", 1)]
+    assert longest_no_spend_streak(rows, date(2026, 1, 25), date(2026, 2, 5)) == 9
