index 0000000..2017288
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,85 @@
+"""Month-over-month comparison report."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(m: str) -> None:
+    if not _MONTH_RE.fullmatch(m):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {m!r}")
+
+
+def _month_of(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+    prev: dict[str, int] = {}
+    curr: dict[str, int] = {}
+    for e in rows:
+        m = _month_of(e)
+        if m == prev_month:
+            prev[e.category] = prev.get(e.category, 0) + e.amount
+        if m == curr_month:
+            curr[e.category] = curr.get(e.category, 0) + e.amount
+    out: list[DiffRow] = []
+    for cat in set(prev) | set(curr):
+        p, c = prev.get(cat, 0), curr.get(cat, 0)
+        delta = c - p
+        pct = None if p == 0 else round(delta / p * 100, 1)
+        if cat not in prev:
+            status = "new"
+        elif cat not in curr:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, p, c, delta, pct, status))
+    out.sort(key=lambda d: (-abs(d.delta), d.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError("n は 0 以上である必要があります")
+    return [d for d in diffs if d.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for d in diffs:
+        pct = "-" if d.pct is None else f"{d.pct:+.1f}%"
+        lines.append(f"{d.category}\t{d.prev}\t{d.curr}\t{d.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month_of(e) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("比較できる月が 2 つ未満です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..f035d0d
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,136 @@
+"""Tiny search-query language over expenses."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+
+from kakeibo.core import Expense
+
+
+class QueryError(ValueError):
+    pass
+
+
+Token = tuple[str, str]
+_Pred = Callable[[Expense], bool]
+_STOP = '()"'
+
+
+def tokenize(q: str) -> list[Token]:
+    out: list[Token] = []
+    i, n = 0, len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            out.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            out.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            j = q.find('"', i + 1)
+            if j == -1:
+                raise QueryError("引用符が閉じていません")
+            if j == i + 1:
+                raise QueryError("引用の中身が空です")
+            out.append(("TERM", q[i + 1 : j]))
+            i = j + 1
+        else:
+            j = i
+            while j < n and not q[j].isspace() and q[j] not in _STOP:
+                j += 1
+            word = q[i:j]
+            i = j
+            if word in ("AND", "OR", "NOT"):
+                out.append((word, word))
+            elif word.startswith("cat:"):
+                if len(word) == 4:
+                    raise QueryError("cat: の後ろが空です")
+                out.append(("CAT", word[4:]))
+            else:
+                out.append(("TERM", word))
+    return out
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self.t = tokens
+        self.pos = 0
+
+    def peek(self) -> str | None:
+        return self.t[self.pos][0] if self.pos < len(self.t) else None
+
+    def parse(self) -> _Pred:
+        if not self.t:
+            raise QueryError("クエリが空です")
+        p = self.or_expr()
+        if self.peek() is not None:
+            raise QueryError(f"予期しないトークン: {self.t[self.pos][1]!r}")
+        return p
+
+    def or_expr(self) -> _Pred:
+        parts = [self.and_expr()]
+        while self.peek() == "OR":
+            self.pos += 1
+            parts.append(self.and_expr())
+        return lambda e: any(p(e) for p in parts)
+
+    def and_expr(self) -> _Pred:
+        parts = [self.not_expr()]
+        while True:
+            k = self.peek()
+            if k == "AND":
+                self.pos += 1
+            elif k not in ("NOT", "TERM", "CAT", "LPAREN"):
+                break
+            parts.append(self.not_expr())
+        return lambda e: all(p(e) for p in parts)
+
+    def not_expr(self) -> _Pred:
+        if self.peek() == "NOT":
+            self.pos += 1
+            inner = self.not_expr()
+            return lambda e: not inner(e)
+        return self.primary()
+
+    def primary(self) -> _Pred:
+        k = self.peek()
+        if k is None:
+            raise QueryError("項が足りません")
+        value = self.t[self.pos][1]
+        if k == "TERM":
+            self.pos += 1
+            needle = value.casefold()
+            return lambda e: (
+                needle in e.memo.casefold() or needle in e.category.casefold()
+            )
+        if k == "CAT":
+            self.pos += 1
+            want = value.casefold()
+            return lambda e: e.category.casefold() == want
+        if k == "LPAREN":
+            self.pos += 1
+            inner = self.or_expr()
+            if self.peek() != "RPAREN":
+                raise QueryError("括弧が閉じていません")
+            self.pos += 1
+            return inner
+        raise QueryError(f"予期しないトークン: {value!r}")
+
+
+def _compile(q: str) -> _Pred:
+    try:
+        return _Parser(tokenize(q)).parse()
+    except RecursionError:
+        raise QueryError("クエリが深すぎます") from None
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _compile(q)(e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    pred = _compile(q)
+    return [e for e in rows if pred(e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..255b08d
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,53 @@
+"""Recurring (monthly) expense detection."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+from itertools import pairwise
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    year, month = (d.year + 1, 1) if d.month == 12 else (d.year, d.month + 1)
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError("min_count は 2 以上である必要があります")
+    if tolerance < 0:
+        raise ValueError("tolerance は 0 以上である必要があります")
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+    out: list[Recurring] = []
+    for (category, amount), dayset in groups.items():
+        days = sorted(dayset)
+        run = [days[0]]
+        runs: list[list[date]] = []
+        for prev, cur in pairwise(days):
+            if abs((cur - add_month(prev)).days) <= tolerance:
+                run.append(cur)
+            else:
+                runs.append(run)
+                run = [cur]
+        runs.append(run)
+        for r in runs:
+            if len(r) >= min_count:
+                out.append(Recurring(category, amount, tuple(r), add_month(r[-1])))
+    out.sort(key=lambda x: (x.category, x.amount, x.days[0]))
+    return out
