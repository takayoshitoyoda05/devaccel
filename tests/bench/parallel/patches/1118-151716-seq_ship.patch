diff --git a/src/kakeibo/bankimport.py b/src/kakeibo/bankimport.py
new file mode 100644
index 0000000..76da91a
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,89 @@
+"""Import CSVs exported by other banks / card issuers."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+_AMOUNT_RE = re.compile(r"-?[¥￥]?[0-9][0-9,]*円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+DEFAULT_MAPPING = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+
+def parse_amount(s: str) -> int:
+    t = s.strip()
+    if not _AMOUNT_RE.fullmatch(t):
+        raise ValueError(f"金額が不正です: {s!r}")
+    neg = t.startswith("-")
+    digits = "".join(c for c in t if c in "0123456789")
+    return -int(digits) if neg else int(digits)
+
+
+def parse_date(s: str) -> date:
+    m = _DATE_RE.fullmatch(s.strip())
+    if not m:
+        raise ValueError(f"日付が不正です: {s!r}")
+    return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header = next(reader, [])
+    idx: dict[str, int] = {}
+    for field, col in mapping.items():
+        if col not in header:
+            raise ValueError(f"列 {col!r} がヘッダーにありません")
+        idx[field] = header.index(col)
+
+    def cell(rec: list[str], field: str) -> str:
+        i = idx.get(field)
+        return rec[i] if i is not None and i < len(rec) else ""
+
+    rows: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    prev_line = reader.line_num
+    for rec in reader:
+        lineno = prev_line + 1
+        prev_line = reader.line_num
+        if not rec:
+            continue
+        bad: list[str] = []
+        day = amount = None
+        try:
+            day = parse_date(cell(rec, "date"))
+        except ValueError:
+            bad.append("date")
+        try:
+            amount = parse_amount(cell(rec, "amount"))
+        except ValueError:
+            bad.append("amount")
+        category = cell(rec, "category").strip()
+        if not category:
+            bad.append("category")
+        if bad:
+            errors.extend((lineno, f) for f in bad)
+            continue
+        assert day is not None and amount is not None
+        if category_map:
+            category = category_map.get(category, category)
+        rows.append(Expense(day, category, amount, cell(rec, "memo").strip()))
+    return rows, errors
