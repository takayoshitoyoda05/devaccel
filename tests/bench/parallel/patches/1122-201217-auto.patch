diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..2f8eef9 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -188,3 +188,79 @@ def test_path_type(runner, cls, expect):
 
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
+
+
+@pytest.mark.parametrize("name", ["a.csv", "a.TSV", "dir/A.Csv", "a.b.csv", ".csv"])
+@pytest.mark.parametrize(
+    "extensions", [[".csv", ".tsv"], ["csv", "TSV"], ("CSV", ".tsv")]
+)
+def test_path_extensions_accepted(name, extensions):
+    assert click.Path(extensions=extensions).convert(name, None, None) == name
+
+
+@pytest.mark.parametrize("name", ["a.txt", "a", "csv", "a.csv.bak", "a.csvx", "a."])
+def test_path_extensions_rejected(name):
+    with pytest.raises(click.BadParameter, match="extensions: .csv, .tsv"):
+        click.Path(extensions=[".csv", ".tsv"]).convert(name, None, None)
+
+
+def test_path_extensions_multi_part():
+    path = click.Path(extensions=[".tar.gz"])
+    assert path.convert("a.TAR.GZ", None, None) == "a.TAR.GZ"
+    with pytest.raises(click.BadParameter):
+        path.convert("a.gz", None, None)
+
+
+def test_path_extensions_existing_file(tmp_path):
+    good = tmp_path / "a.CSV"
+    bad = tmp_path / "a.txt"
+    good.write_text("")
+    bad.write_text("")
+    path = click.Path(exists=True, extensions=[".csv"])
+    assert path.convert(os.fspath(good), None, None) == os.fspath(good)
+    with pytest.raises(click.BadParameter, match="extensions"):
+        path.convert(os.fspath(bad), None, None)
+
+
+def test_path_extensions_skips_directory_and_dash(tmp_path):
+    folder = tmp_path / "data.txt"
+    folder.mkdir()
+    path = click.Path(extensions=[".csv"], allow_dash=True)
+    assert path.convert(os.fspath(folder), None, None) == os.fspath(folder)
+    assert path.convert("-", None, None) == "-"
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions=[".csv"]).convert("-", None, None)
+
+
+def test_path_extensions_bytes_and_pathlike():
+    path = click.Path(extensions=[".csv"])
+    assert path.convert(b"a.CSV", None, None) == b"a.CSV"
+    assert path.convert(pathlib.Path("a.csv"), None, None) == pathlib.Path("a.csv")
+    with pytest.raises(click.BadParameter):
+        path.convert(pathlib.Path("a.txt"), None, None)
+
+
+def test_path_extensions_default_unrestricted():
+    assert click.Path().extensions is None
+    assert click.Path().convert("a.anything", None, None) == "a.anything"
+
+
+@pytest.mark.parametrize(
+    ("extensions", "error"),
+    [(".csv", TypeError), ([], ValueError), ([""], ValueError), (["."], ValueError)],
+)
+def test_path_extensions_invalid_argument(extensions, error):
+    with pytest.raises(error):
+        click.Path(extensions=extensions)
+
+
+def test_path_extensions_through_cli(runner):
+    @click.command()
+    @click.option("--file", type=click.Path(extensions=[".csv", ".tsv"]))
+    def cli(file):
+        click.echo(file)
+
+    assert runner.invoke(cli, ["--file", "x.TSV"]).output == "x.TSV\n"
+    result = runner.invoke(cli, ["--file", "x.txt"])
+    assert result.exit_code == 2
+    assert "must have one of the extensions: .csv, .tsv" in result.output
