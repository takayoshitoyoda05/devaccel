diff --git a/src/kakeibo/core.py b/src/kakeibo/core.py
index 8c3cbab..1a16043 100644
--- a/src/kakeibo/core.py
+++ b/src/kakeibo/core.py
@@ -122,6 +122,32 @@ def load_budget(path: Path) -> Budget:
     return Budget(default, months)
 
 
+def budget_percent(actual: int, limit: int) -> int | None:
+    """Percent of budget used, rounded down; None when limit is 0 (undefined)."""
+    if limit == 0:
+        return None
+    return actual * 100 // limit
+
+
+def find_notices(
+    totals: dict[str, dict[str, int]], budget: Budget
+) -> list[tuple[str, str, int, int]]:
+    """(month, category, limit, actual) for 90% <= actual/limit <= 100%.
+
+    D1: 100% ちょうどは超過ではないので注意に含める。
+    D2: 予算 0 は割合が定義できないため注意の対象外(実績 > 0 なら超過側で警告)。
+    D3: 判定は整数演算 actual*10 >= limit*9(89.99% を 90% に丸めない)。
+    """
+    out: list[tuple[str, str, int, int]] = []
+    for month, cats in totals.items():
+        limits = budget.for_month(month)
+        for cat, actual in cats.items():
+            limit = limits.get(cat)
+            if limit and actual <= limit and actual * 10 >= limit * 9:
+                out.append((month, cat, limit, actual))
+    return out
+
+
 def find_overruns(
     totals: dict[str, dict[str, int]], budget: Budget
 ) -> list[tuple[str, str, int, int, int]]:
