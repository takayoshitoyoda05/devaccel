diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..aa53c7c 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -188,3 +188,106 @@ def test_path_type(runner, cls, expect):
 
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
+
+
+def _convert_ext(value, **kwargs):
+    return click.Path(extensions=(".csv", ".tsv"), **kwargs).convert(value, None, None)
+
+
+@pytest.mark.parametrize("name", ["a.csv", "a.TSV", "dir/A.Csv", "a.b.csv"])
+def test_extensions_accepted(name):
+    assert _convert_ext(name) == name
+
+
+@pytest.mark.parametrize("name", ["a.txt", "a", "a.csv.bak", ".csv", "csv", ""])
+def test_extensions_rejected(name):
+    with pytest.raises(click.BadParameter, match="must have one of these extensions"):
+        _convert_ext(name)
+
+
+def test_extensions_message_lists_extensions():
+    with pytest.raises(click.BadParameter, match=r"\.csv, \.tsv"):
+        _convert_ext("a.txt")
+
+
+def test_extensions_dot_optional_and_case_insensitive():
+    t = click.Path(extensions=["CSV", ".Tsv"])
+    assert t.extensions == (".csv", ".tsv")
+    assert t.convert("a.csv", None, None) == "a.csv"
+
+
+def test_extensions_single_string():
+    t = click.Path(extensions=".csv")
+    assert t.convert("a.CSV", None, None) == "a.CSV"
+    with pytest.raises(click.BadParameter):
+        t.convert("a.tsv", None, None)
+
+
+def test_extensions_multi_dot_extension():
+    t = click.Path(extensions=".tar.gz")
+    assert t.convert("a.tar.gz", None, None) == "a.tar.gz"
+    with pytest.raises(click.BadParameter):
+        t.convert("a.gz", None, None)
+
+
+@pytest.mark.parametrize("value", [[], (), "", ".", [""]])
+def test_extensions_empty_is_value_error(value):
+    with pytest.raises(ValueError, match="extensions"):
+        click.Path(extensions=value)
+
+
+def test_extensions_default_unchanged():
+    assert click.Path().extensions is None
+    assert click.Path().convert("a.anything", None, None) == "a.anything"
+
+
+def test_extensions_bytes_and_pathlib():
+    assert _convert_ext(b"a.CSV") == b"a.CSV"
+    p = pathlib.Path("a.tsv")
+    assert _convert_ext(p) == p
+    with pytest.raises(click.BadParameter):
+        _convert_ext(b"a.txt")
+
+
+def test_extensions_existing_file(tmp_path):
+    good = tmp_path / "x.CSV"
+    good.touch()
+    bad = tmp_path / "x.txt"
+    bad.touch()
+    assert _convert_ext(str(good), exists=True) == str(good)
+    with pytest.raises(click.BadParameter, match="extensions"):
+        _convert_ext(str(bad), exists=True)
+
+
+def test_extensions_directory_not_checked(tmp_path):
+    d = tmp_path / "folder.txt"
+    d.mkdir()
+    assert _convert_ext(str(d), exists=True) == str(d)
+
+
+def test_extensions_dash_not_checked():
+    assert _convert_ext("-", allow_dash=True) == "-"
+    with pytest.raises(click.BadParameter):
+        _convert_ext("-")
+
+
+def test_extensions_nonexistent_still_checked(tmp_path):
+    with pytest.raises(click.BadParameter, match="extensions"):
+        _convert_ext(str(tmp_path / "out.txt"))
+
+
+def test_extensions_missing_file_with_exists_reports_missing(tmp_path):
+    with pytest.raises(click.BadParameter, match="does not exist"):
+        _convert_ext(str(tmp_path / "nope.csv"), exists=True)
+
+
+def test_extensions_in_command(runner):
+    @click.command()
+    @click.argument("f", type=click.Path(extensions=[".csv", ".tsv"]))
+    def cli(f):
+        click.echo(f)
+
+    assert runner.invoke(cli, ["a.CSV"]).output == "a.CSV\n"
+    result = runner.invoke(cli, ["a.txt"])
+    assert result.exit_code == 2
+    assert "must have one of these extensions: .csv, .tsv." in result.output
