@@ -0,0 +1,59 @@
+"""日付列が「毎月」出ているかを判定する純粋関数。"""
+
+from __future__ import annotations
+
+import calendar
+from collections import Counter
+from datetime import date, datetime
+from itertools import pairwise
+
+
+def is_monthly(days: list[date], *, min_count: int = 3) -> bool:
+    """日付列が毎月の支払いとみなせるなら True を返す。
+
+    - 並びは不問。同じ月に 2 件あれば False。
+    - 連続する月の差は 1 か 2。差 2 は全体で 1 回まで。
+    - 基準日は最頻の「日」（同数なら大きい日）。月末は丸める。
+      各日付は基準日から ±3 日以内であること。
+    """
+    if not isinstance(days, list):
+        raise TypeError("days must be a list of datetime.date")
+    for d in days:
+        if isinstance(d, datetime) or not isinstance(d, date):
+            raise TypeError("days must contain only datetime.date elements")
+    if isinstance(min_count, bool) or not isinstance(min_count, int):
+        raise TypeError("min_count must be an int")
+    if min_count < 2:
+        raise ValueError("min_count must be 2 or more")
+
+    if len(days) < min_count:
+        return False
+
+    ordered = sorted(days)
+
+    month_index = [d.year * 12 + d.month for d in ordered]
+    if len(set(month_index)) != len(month_index):
+        return False
+
+    skipped = 0
+    for prev, cur in pairwise(month_index):
+        gap = cur - prev
+        if gap == 1:
+            continue
+        if gap == 2:
+            skipped += 1
+            if skipped > 1:
+                return False
+            continue
+        return False
+
+    counts = Counter(d.day for d in ordered)
+    base = max(counts, key=lambda day: (counts[day], day))
+
+    for d in ordered:
+        last_day = calendar.monthrange(d.year, d.month)[1]
+        anchor = date(d.year, d.month, min(base, last_day))
+        if abs((d - anchor).days) > 3:
+            return False
+
+    return True
