@@ -0,0 +1,48 @@
+"""次回の予定日を求める純粋関数。標準ライブラリのみ。"""
+
+from collections import Counter
+from datetime import date, datetime
+
+
+def _add_month(year: int, month: int) -> tuple[int, int]:
+    """(year, month) の翌月を返す。12 月の次は翌年 1 月。"""
+    if month == 12:
+        return year + 1, 1
+    return year, month + 1
+
+
+def _days_in_month(year: int, month: int) -> int:
+    """その月の日数(閏年の 2 月は 29 日)。"""
+    if month == 2:
+        leap = year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)
+        return 29 if leap else 28
+    if month in (4, 6, 9, 11):
+        return 30
+    return 31
+
+
+def _base_day(days: list[date]) -> int:
+    """日付列の「日」の最頻値。同数なら大きい日。"""
+    counts = Counter(d.day for d in days)
+    return max(counts, key=lambda day: (counts[day], day))
+
+
+def next_due(days: list[date]) -> date:
+    """日付列から次回の予定日を返す。
+
+    基準日は「日」の最頻値(同数なら大きい日)。最後(最大)の日付の月の翌月の、
+    基準日の日を返す。その月に基準日が無ければ月末に丸める。
+    """
+    if not isinstance(days, list):
+        raise TypeError("days は list である必要があります")
+    if not days:
+        raise ValueError("days は空でない list である必要があります")
+    for d in days:
+        if isinstance(d, datetime) or not isinstance(d, date):
+            raise TypeError("days の要素は datetime.date である必要があります")
+
+    base = _base_day(days)
+    last = max(days)
+    year, month = _add_month(last.year, last.month)
+    day = min(base, _days_in_month(year, month))
+    return date(year, month, day)
