+from __future__ import annotations
+
+from datetime import date, datetime
+
+import pytest
+
+from kakeibo.recurring_cadence import is_monthly
+
+
+# E2: 例の表
+@pytest.mark.parametrize(
+    ("days", "expected"),
+    [
+        pytest.param(
+            [date(2026, 1, 31), date(2026, 2, 28), date(2026, 3, 31)],
+            True,
+            id="E2-1",
+        ),
+        pytest.param(
+            [date(2026, 1, 5), date(2026, 3, 5), date(2026, 4, 5)],
+            True,
+            id="E2-2",
+        ),
+        pytest.param(
+            [date(2026, 1, 5), date(2026, 3, 5), date(2026, 5, 5)],
+            False,
+            id="E2-3a",
+        ),
+        pytest.param(
+            [date(2026, 1, 5), date(2026, 2, 5), date(2026, 2, 20)],
+            False,
+            id="E2-3b",
+        ),
+    ],
+)
+def test_example_table(days: list[date], expected: bool) -> None:
+    assert is_monthly(days) is expected
+
+
+# R1: 並びは不問、重複は同じ月に 2 件
+def test_order_does_not_matter() -> None:
+    days = [date(2026, 4, 5), date(2026, 1, 5), date(2026, 3, 5)]
+    assert is_monthly(days) is True
+
+
+def test_same_month_twice_is_false() -> None:
+    days = [date(2026, 1, 5), date(2026, 2, 5), date(2026, 2, 5)]
+    assert is_monthly(days) is False
+
+
+# R2: 件数
+def test_fewer_than_min_count_is_false() -> None:
+    assert is_monthly([date(2026, 1, 5), date(2026, 2, 5)]) is False
+
+
+def test_min_count_custom() -> None:
+    days = [date(2026, 1, 5), date(2026, 2, 5)]
+    assert is_monthly(days, min_count=2) is True
+
+
+def test_empty_list_is_false() -> None:
+    assert is_monthly([]) is False
+
+
+def test_gap_of_three_months_is_false() -> None:
+    days = [date(2026, 1, 5), date(2026, 2, 5), date(2026, 5, 5)]
+    assert is_monthly(days) is False
+
+
+def test_one_gap_of_two_allowed_with_three_items() -> None:
+    days = [date(2026, 1, 5), date(2026, 2, 5), date(2026, 4, 5)]
+    assert is_monthly(days) is True
+
+
+# R3: 基準日は最頻の「日」、同数なら大きい日
+def test_mode_tie_picks_larger_day() -> None:
+    # 日: 5, 20, 5, 20 -> 同数なので基準日 20。5 日は ±3 日外なので False
+    days = [
+        date(2026, 1, 5),
+        date(2026, 2, 20),
+        date(2026, 3, 5),
+        date(2026, 4, 20),
+    ]
+    assert is_monthly(days) is False
+
+
+def test_outlier_beyond_three_days_is_false() -> None:
+    days = [date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 9)]
+    assert is_monthly(days) is False
+
+
+def test_within_three_days_is_true() -> None:
+    # 基準日は 5（最頻）。3 月の 8 日は 3 日ずれなので許容
+    days = [date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 8)]
+    assert is_monthly(days) is True
+
+
+# R4: 型検査
+def test_datetime_element_raises_type_error() -> None:
+    days = [datetime(2026, 1, 5), datetime(2026, 2, 5), datetime(2026, 3, 5)]
+    with pytest.raises(TypeError):
+        is_monthly(days)  # type: ignore[arg-type]
+
+
+def test_non_date_element_raises_type_error() -> None:
+    with pytest.raises(TypeError):
+        is_monthly([date(2026, 1, 5), "2026-02-05", date(2026, 3, 5)])  # type: ignore[list-item]
+
+
+def test_tuple_raises_type_error() -> None:
+    days = (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+    with pytest.raises(TypeError):
+        is_monthly(days)  # type: ignore[arg-type]
+
+
+def test_bool_min_count_raises_type_error() -> None:
+    with pytest.raises(TypeError):
+        is_monthly([date(2026, 1, 5)], min_count=True)  # type: ignore[arg-type]
+
+
+def test_float_min_count_raises_type_error() -> None:
+    with pytest.raises(TypeError):
+        is_monthly([date(2026, 1, 5)], min_count=3.0)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad", [1, 0, -1])
+def test_min_count_below_two_raises_value_error(bad: int) -> None:
+    with pytest.raises(ValueError, match="min_count"):
+        is_monthly([date(2026, 1, 5)], min_count=bad)
