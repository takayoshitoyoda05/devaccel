@@ -0,0 +1,197 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring_group import group_series
+
+
+def _e(day: str, amount: int, memo: str = "", category: str = "食費") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+# E1-1: 表記ゆれ(全角・大小・空白・番号)は同じ系列。金額 1490 → 1500 も同じ系列
+def test_E1_1_memo_variants_form_one_series() -> None:
+    rows = [
+        _e("2026-01-05", 1490, "Netflix"),
+        _e("2026-02-05", 1490, "ＮＥＴＦＬＩＸ #2"),
+        _e("2026-03-05", 1500, "netflix 3"),
+    ]
+    result = group_series(rows)
+    assert len(result) == 1
+    assert [e.day for e in result[0]] == [
+        date(2026, 1, 5),
+        date(2026, 2, 5),
+        date(2026, 3, 5),
+    ]
+
+
+# E1-2: 同じ月に 2 件ある同額の系列は 5 日と 20 日に分かれる
+def test_E1_2_same_month_pair_splits_into_two_series() -> None:
+    rows = [_e(f"2026-0{m}-{d:02d}", 1000, "Gym") for m in (1, 2, 3) for d in (5, 20)]
+    result = group_series(rows)
+    assert len(result) == 2
+    assert all(len(s) == 3 for s in result)
+    assert [e.day.day for e in result[0]] == [5, 5, 5]
+    assert [e.day.day for e in result[1]] == [20, 20, 20]
+
+
+# E1-3: 返金(負の金額)は捨てる。min_count=1 は ValueError
+def test_E1_3_refunds_are_dropped() -> None:
+    rows = [_e(f"2026-0{m}-01", -80000, "家賃", "住居") for m in (1, 2, 3)]
+    assert group_series(rows) == []
+    with pytest.raises(ValueError, match="min_count"):
+        group_series(rows, min_count=1)
+
+
+# R1: 受け付ける表記の揺れ(spec の例を全部)
+@pytest.mark.parametrize(
+    "memos",
+    [
+        ["Netflix", "ＮＥＴＦＬＩＸ", "netflix #12"],
+        ["Net flix", "Netflix 3", "NETFLIX"],
+        ["Netflix　", "netflix No.3", "Ｎｅｔ　flix"],
+    ],
+    ids=["basic", "spaces-and-numbers", "fullwidth-space-and-No"],
+)
+def test_R1_memo_variants_share_key(memos: list[str]) -> None:
+    rows = [_e(f"2026-0{m}-05", 1000, memo) for m, memo in zip((1, 2, 3), memos)]
+    result = group_series(rows)
+    assert len(result) == 1
+    assert len(result[0]) == 3
+
+
+def test_R1_category_is_stripped_for_key() -> None:
+    rows = [
+        _e("2026-01-05", 1000, "Gym", " 食費 "),
+        _e("2026-02-05", 1000, "Gym", "食費"),
+        _e("2026-03-05", 1000, "Gym", "食費"),
+    ]
+    assert len(group_series(rows)) == 1
+
+
+def test_R1_different_category_is_different_series() -> None:
+    rows = [
+        _e("2026-01-05", 1000, "Gym", "食費"),
+        _e("2026-02-05", 1000, "Gym", "雑費"),
+        _e("2026-03-05", 1000, "Gym", "食費"),
+    ]
+    assert group_series(rows) == []
+
+
+def test_R1_empty_memo_uses_category_only() -> None:
+    rows = [
+        _e("2026-01-05", 1000, ""),
+        _e("2026-02-05", 1000, "  "),
+        _e("2026-03-05", 1000),
+    ]
+    result = group_series(rows)
+    assert len(result) == 1
+    assert len(result[0]) == 3
+
+
+# D3: ±30 % は両端を含む。それを超えると別系列
+def test_D3_thirty_percent_boundary_is_inclusive() -> None:
+    rows = [
+        _e("2026-01-05", 1000),
+        _e("2026-02-05", 1300),
+        _e("2026-03-05", 1690),
+    ]
+    result = group_series(rows)
+    assert len(result) == 1
+    assert [e.amount for e in result[0]] == [1000, 1300, 1690]
+
+
+def test_D3_over_thirty_percent_starts_new_series() -> None:
+    rows = [
+        _e("2026-01-05", 1000),
+        _e("2026-02-05", 1301),
+        _e("2026-03-05", 1301),
+    ]
+    result = group_series(rows, min_count=2)
+    assert len(result) == 1
+    assert [e.amount for e in result[0]] == [1301, 1301]
+    assert [e.day for e in result[0]] == [date(2026, 2, 5), date(2026, 3, 5)]
+
+
+def test_D3_price_change_is_same_series() -> None:
+    rows = [
+        _e("2026-01-05", 1000),
+        _e("2026-02-05", 1000),
+        _e("2026-03-05", 1200),
+        _e("2026-04-05", 1200),
+    ]
+    result = group_series(rows)
+    assert len(result) == 1
+    assert len(result[0]) == 4
+
+
+# D2: 0 円も捨てる
+def test_D2_zero_amount_is_dropped() -> None:
+    rows = [
+        _e("2026-01-05", 0, "Gym"),
+        _e("2026-02-05", 0, "Gym"),
+        _e("2026-03-05", 0, "Gym"),
+    ]
+    assert group_series(rows) == []
+
+
+# R2/R4: 件数の下限
+def test_R3_series_shorter_than_min_count_is_not_returned() -> None:
+    rows = [_e("2026-01-05", 1000), _e("2026-02-05", 1000)]
+    assert group_series(rows) == []
+    assert len(group_series(rows, min_count=2)) == 1
+
+
+def test_R4_empty_rows_returns_empty_list() -> None:
+    assert group_series([]) == []
+
+
+# R3: 系列内は日付昇順、系列どうしは先頭の日付昇順
+def test_R3_output_is_sorted_and_input_order_does_not_matter() -> None:
+    a = [_e(f"2026-0{m}-20", 500, "B") for m in (1, 2, 3)]
+    b = [_e(f"2026-0{m}-05", 1000, "A") for m in (1, 2, 3)]
+    rows = list(reversed(a + b))
+    snapshot = list(rows)
+    result = group_series(rows)
+    assert [s[0].memo for s in result] == ["A", "B"]
+    assert [e.day for e in result[0]] == sorted(e.day for e in result[0])
+    assert rows == snapshot
+
+
+def test_R3_does_not_mutate_rows() -> None:
+    rows = [
+        _e("2026-03-05", 1000, "Gym"),
+        _e("2026-01-05", 1000, "Gym"),
+        _e("2026-02-05", 1000, "Gym"),
+    ]
+    snapshot = list(rows)
+    group_series(rows)
+    assert rows == snapshot
+
+
+# R4: 型と引数の検査
+def test_R4_rows_must_be_list() -> None:
+    with pytest.raises(TypeError):
+        group_series(())  # type: ignore[arg-type]
+
+
+def test_R4_elements_must_be_expense() -> None:
+    with pytest.raises(TypeError):
+        group_series([{"day": "2026-01-05"}])  # type: ignore[list-item]
+
+
+@pytest.mark.parametrize("bad", [True, "3", 3.0, None])
+def test_R4_min_count_must_be_int(bad: object) -> None:
+    with pytest.raises(TypeError):
+        group_series([], min_count=bad)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad", [1, 0, -1])
+def test_R4_min_count_below_two_is_value_error(bad: int) -> None:
+    with pytest.raises(ValueError, match="min_count"):
+        group_series([], min_count=bad)
