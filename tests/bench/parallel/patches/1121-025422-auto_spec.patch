+from datetime import date, datetime
+
+import pytest
+
+from kakeibo.recurring_next import next_due
+
+
+@pytest.mark.parametrize(
+    ("days", "expected"),
+    [
+        # E3-1: 基準日 31 → 12/31 の翌月 1 月は 31 日
+        pytest.param(
+            [date(2026, 10, 31), date(2026, 11, 30), date(2026, 12, 31)],
+            date(2027, 1, 31),
+            id="E3-1",
+        ),
+        # E3-2: 閏年の 2 月を含む系列 → 3 月の翌月 4 月は 30 日に丸める
+        pytest.param(
+            [date(2024, 1, 31), date(2024, 2, 29), date(2024, 3, 31)],
+            date(2024, 4, 30),
+            id="E3-2a",
+        ),
+        # E3-2: 平年の 2 月を含む系列 → 4 月は 30 日に丸める
+        pytest.param(
+            [date(2026, 1, 31), date(2026, 2, 28), date(2026, 3, 31)],
+            date(2026, 4, 30),
+            id="E3-2b",
+        ),
+    ],
+)
+def test_next_due_examples(days, expected):
+    assert next_due(days) == expected
+
+
+def test_E3_3_empty_list_raises_value_error():
+    # E3-3: 空の list は ValueError
+    with pytest.raises(ValueError):
+        next_due([])
+
+
+def test_order_does_not_matter():
+    days = [date(2026, 12, 31), date(2026, 10, 31), date(2026, 11, 30)]
+    assert next_due(days) == date(2027, 1, 31)
+
+
+def test_duplicates_are_allowed():
+    days = [date(2026, 10, 15), date(2026, 10, 15), date(2026, 11, 15)]
+    assert next_due(days) == date(2026, 12, 15)
+
+
+def test_base_day_is_mode_of_day_of_month():
+    # 日の最頻値 15 (3 回) → 翌月 1 月の 15 日
+    days = [
+        date(2026, 10, 15),
+        date(2026, 11, 15),
+        date(2026, 12, 15),
+        date(2026, 12, 1),
+    ]
+    assert next_due(days) == date(2027, 1, 15)
+
+
+def test_tie_in_mode_takes_larger_day():
+    # 日の 5 と 20 が同数 → 大きい 20 を基準日
+    days = [
+        date(2026, 10, 5),
+        date(2026, 11, 20),
+        date(2026, 12, 5),
+        date(2026, 12, 20),
+    ]
+    assert next_due(days) == date(2027, 1, 20)
+
+
+def test_next_is_month_after_latest_date_even_with_gap():
+    # 最後の日付の月 (2026-12) の翌月 → 2027-01
+    days = [date(2026, 9, 10), date(2026, 10, 10), date(2026, 12, 10)]
+    assert next_due(days) == date(2027, 1, 10)
+
+
+def test_single_date_uses_its_day():
+    assert next_due([date(2026, 2, 3)]) == date(2026, 3, 3)
+
+
+def test_month_end_clamp_on_non_leap_february():
+    # 基準日 31 → 最後の月の翌月が 2 月 (平年) → 28 日
+    days = [date(2026, 12, 31)]
+    assert next_due(days) == date(2027, 1, 31)
+    assert next_due([date(2027, 1, 31)]) == date(2027, 2, 28)
+
+
+def test_month_end_clamp_on_leap_february():
+    # 2028 は閏年 → 基準日 31 の翌月 2 月は 29 日
+    assert next_due([date(2027, 12, 31), date(2028, 1, 31)]) == date(2028, 2, 29)
+
+
+def test_december_rolls_over_to_january_next_year():
+    assert next_due([date(2026, 12, 5)]) == date(2027, 1, 5)
+
+
+@pytest.mark.parametrize("bad", ["2026-01-01", 20260101, None, (date(2026, 1, 1),)])
+def test_non_list_raises_type_error(bad):
+    with pytest.raises(TypeError):
+        next_due(bad)
+
+
+@pytest.mark.parametrize(
+    "bad_item",
+    [datetime(2026, 1, 1, 9, 0), "2026-01-01", 20260101, None],
+)
+def test_non_date_element_raises_type_error(bad_item):
+    with pytest.raises(TypeError):
+        next_due([date(2026, 1, 1), bad_item])
