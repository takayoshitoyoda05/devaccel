+"""Group expenses into candidate recurring series (same category and memo)."""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+
+from kakeibo.core import Expense
+
+# 末尾の番号: "#12" "No.3" "3" (正規化後は空白が無い前提)
+_TRAILING_NUMBER_RE = re.compile(r"(?:#|no\.?)?\d+$")
+
+
+def _is_int(value: object) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _memo_key(memo: str) -> str:
+    """D1: NFKC -> casefold -> 空白をすべて除去 -> 末尾の番号を除去。"""
+    text = unicodedata.normalize("NFKC", memo).casefold()
+    text = "".join(ch for ch in text if not ch.isspace())
+    return _TRAILING_NUMBER_RE.sub("", text)
+
+
+def group_series(rows: list[Expense], *, min_count: int = 3) -> list[list[Expense]]:
+    """Return series of expenses that look like the same recurring payment.
+
+    - Rows with ``amount <= 0`` are ignored (D2).
+    - Within a key (category, normalized memo), a row joins the first existing
+      series whose last amount is within ±30 % of it and whose last row is in a
+      different month; otherwise it starts a new series (D3).
+    - Only series with at least ``min_count`` rows are returned (R3).
+    """
+    if not isinstance(rows, list):
+        raise TypeError("rows は list である必要があります")
+    for e in rows:
+        if not isinstance(e, Expense):
+            raise TypeError(f"Expense 以外の要素があります: {type(e).__name__}")
+    if not _is_int(min_count):
+        raise TypeError("min_count は int である必要があります")
+    if min_count < 2:
+        raise ValueError(f"min_count は 2 以上である必要があります: {min_count}")
+
+    # sorted() is stable: same-day rows keep their input order. rows itself is not changed.
+    ordered = sorted((e for e in rows if e.amount > 0), key=lambda e: e.day)
+
+    groups: dict[tuple[str, str], list[list[Expense]]] = {}
+    for e in ordered:
+        key = (e.category.strip(), _memo_key(e.memo))
+        series_list = groups.setdefault(key, [])
+        for series in series_list:
+            last = series[-1]
+            if (last.day.year, last.day.month) == (e.day.year, e.day.month):
+                continue
+            # last.amount * 0.7 <= e.amount <= last.amount * 1.3, in integers
+            if 7 * last.amount <= 10 * e.amount <= 13 * last.amount:
+                series.append(e)
+                break
+        else:
+            series_list.append([e])
+
+    found: list[tuple[object, str, str, list[Expense]]] = []
+    for (category, memo_key), series_list in groups.items():
+        for series in series_list:
+            if len(series) >= min_count:
+                found.append((series[0].day, category, memo_key, series))
+
+    found.sort(key=lambda t: t[:3])
+    return [series for *_, series in found]
