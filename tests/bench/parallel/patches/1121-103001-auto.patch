+"""月ごとのカテゴリ別支出と前月比(純粋関数)。
+
+決めた扱い:
+D1: 型・集計は既存の `Expense` / `monthly_totals` を再利用し、二重に持たない。
+D2: 月は最初の月から最後の月まで連続で並べる。データに無い月は空の月
+    (全カテゴリ無し)として扱うので、1 月にあって 2 月に無いカテゴリは 2 月に
+    「なくなった」(GONE)になり、3 月に再び出れば「新しく出てきた」(NEW)になる。
+D3: 最初の月の比較相手は空の月。最初の月のカテゴリはすべて NEW。
+D4: 状態はカテゴリの有無で決める。前月に無く今月にある=NEW、前月にあり今月に無い=GONE、
+    両方にあり金額が増=UP・減=DOWN・同じ=SAME。合計が 0 円でも「ある」とみなす。
+D5: 増減率(pct)は前月金額が 0 のとき None(0 での割り算をしない)。
+    それ以外は (今月-前月)/前月*100 の float。GONE は -100.0。前月が負(返金超過)でも
+    式どおり計算する。
+D6: 負の金額(返金)はそのまま合算する。丸めない・拒否しない。
+D7: 並び順は、今月にあるカテゴリを金額の降順(同額はカテゴリ名の昇順)、
+    その後ろに GONE を前月金額の降順(同額は名前の昇順)。
+D8: 空の入力は空のリスト。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from enum import Enum
+
+from kakeibo.core import Expense, monthly_totals
+
+
+class Change(Enum):
+    NEW = "new"
+    GONE = "gone"
+    UP = "up"
+    DOWN = "down"
+    SAME = "same"
+
+
+@dataclass(frozen=True)
+class CategoryDelta:
+    category: str
+    current: int  # 今月の金額(GONE は 0)
+    previous: int  # 前月の金額(NEW は 0)
+    diff: int  # current - previous
+    pct: float | None  # 前月 0 なら None
+    change: Change
+
+
+@dataclass(frozen=True)
+class MonthReport:
+    month: str  # "YYYY-MM"
+    totals: dict[str, int]  # 今月のカテゴリ別合計(金額降順)
+    deltas: list[CategoryDelta]  # 前月比
+
+
+def _next_month(month: str) -> str:
+    y, m = int(month[:4]), int(month[5:7])
+    y, m = (y + 1, 1) if m == 12 else (y, m + 1)
+    return f"{y:04d}-{m:02d}"
+
+
+def _delta(cat: str, cur: dict[str, int], prev: dict[str, int]) -> CategoryDelta:
+    in_cur, in_prev = cat in cur, cat in prev
+    c, p = cur.get(cat, 0), prev.get(cat, 0)
+    if not in_prev:
+        change = Change.NEW
+    elif not in_cur:
+        change = Change.GONE
+    elif c > p:
+        change = Change.UP
+    elif c < p:
+        change = Change.DOWN
+    else:
+        change = Change.SAME
+    pct = None if p == 0 else (c - p) / p * 100
+    return CategoryDelta(cat, c, p, c - p, pct, change)
+
+
+def monthly_report(rows: list[Expense]) -> list[MonthReport]:
+    """月ごと(古い順・欠けた月は空で補う)のカテゴリ別支出と前月比。"""
+    totals = monthly_totals(rows)
+    if not totals:
+        return []
+    months = sorted(totals)
+    out: list[MonthReport] = []
+    prev: dict[str, int] = {}
+    month = months[0]
+    while month <= months[-1]:
+        cur = totals.get(month, {})
+        present = sorted(cur, key=lambda c: (-cur[c], c))
+        gone = sorted((c for c in prev if c not in cur), key=lambda c: (-prev[c], c))
+        deltas = [_delta(c, cur, prev) for c in present + gone]
+        out.append(
+            MonthReport(
+                month, dict(sorted(cur.items(), key=lambda kv: (-kv[1], kv[0]))), deltas
+            )
+        )
+        prev = cur
+        month = _next_month(month)
+    return out
diff --git a/tests/test_monthly.py b/tests/test_monthly.py
new file mode 100644
index 0000000..5203d3b
--- /dev/null
+++ b/tests/test_monthly.py
@@ -0,0 +1,98 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.monthly import Change, monthly_report
+
+
+def e(d: str, cat: str, amount: int) -> Expense:
+    return Expense(date.fromisoformat(d), cat, amount)
+
+
+def by_cat(report, month):
+    r = next(r for r in report if r.month == month)
+    return {d.category: d for d in r.deltas}
+
+
+def test_empty():
+    assert monthly_report([]) == []
+
+
+def test_first_month_all_new():
+    rep = monthly_report([e("2026-01-05", "食費", 1000), e("2026-01-06", "食費", 500)])
+    assert len(rep) == 1
+    assert rep[0].totals == {"食費": 1500}
+    d = rep[0].deltas[0]
+    assert (d.change, d.current, d.previous, d.diff, d.pct) == (
+        Change.NEW,
+        1500,
+        0,
+        1500,
+        None,
+    )
+
+
+def test_up_down_same_new_gone():
+    rows = [
+        e("2026-01-01", "食費", 1000),
+        e("2026-01-01", "交通", 2000),
+        e("2026-01-01", "趣味", 500),
+        e("2026-01-01", "家賃", 700),
+        e("2026-02-01", "食費", 1500),
+        e("2026-02-01", "交通", 1000),
+        e("2026-02-01", "家賃", 700),
+        e("2026-02-01", "医療", 300),
+    ]
+    d = by_cat(monthly_report(rows), "2026-02")
+    assert (
+        d["食費"].change is Change.UP
+        and d["食費"].diff == 500
+        and d["食費"].pct == 50.0
+    )
+    assert d["交通"].change is Change.DOWN and d["交通"].pct == -50.0
+    assert d["家賃"].change is Change.SAME and d["家賃"].pct == 0.0
+    assert d["医療"].change is Change.NEW and d["医療"].pct is None
+    assert d["趣味"].change is Change.GONE
+    assert (d["趣味"].current, d["趣味"].previous, d["趣味"].pct) == (0, 500, -100.0)
+
+
+def test_gap_month_is_empty_and_everything_gone_then_new():
+    rows = [e("2026-01-10", "食費", 100), e("2026-03-10", "食費", 100)]
+    rep = monthly_report(rows)
+    assert [r.month for r in rep] == ["2026-01", "2026-02", "2026-03"]
+    assert rep[1].totals == {}
+    assert by_cat(rep, "2026-02")["食費"].change is Change.GONE
+    assert by_cat(rep, "2026-03")["食費"].change is Change.NEW
+
+
+def test_year_boundary_and_order_independent_of_input():
+    rows = [e("2027-01-01", "a", 1), e("2026-12-31", "a", 2)]
+    rep = monthly_report(rows)
+    assert [r.month for r in rep] == ["2026-12", "2027-01"]
+    assert by_cat(rep, "2027-01")["a"].change is Change.DOWN
+
+
+def test_ordering_current_desc_then_name_then_gone_last():
+    rows = [
+        e("2026-01-01", "z", 50),
+        e("2026-01-01", "old", 999),
+        e("2026-02-01", "b", 10),
+        e("2026-02-01", "a", 10),
+        e("2026-02-01", "z", 50),
+    ]
+    rep = monthly_report(rows)
+    assert [d.category for d in rep[1].deltas] == ["z", "a", "b", "old"]
+    assert list(rep[1].totals) == ["z", "a", "b"]
+
+
+def test_refund_summed_and_zero_total_category_counts_as_present():
+    rows = [
+        e("2026-01-01", "服", 1000),
+        e("2026-02-01", "服", 1000),
+        e("2026-02-02", "服", -1000),
+        e("2026-03-01", "服", 200),
+    ]
+    rep = monthly_report(rows)
+    feb = by_cat(rep, "2026-02")["服"]
+    assert feb.current == 0 and feb.change is Change.DOWN and feb.pct == -100.0
+    mar = by_cat(rep, "2026-03")["服"]
+    assert mar.previous == 0 and mar.change is Change.UP and mar.pct is None
