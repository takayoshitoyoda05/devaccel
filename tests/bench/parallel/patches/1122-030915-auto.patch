+@pytest.mark.parametrize(
+    ("type", "expect"),
+    [
+        (click.IntRange(min=1), "x>=1"),
+        (click.IntRange(min=1, min_open=True), "x>1"),
+        (click.FloatRange(min=1.5), "x>=1.5"),
+        (click.FloatRange(min=1.5, min_open=True), "x>1.5"),
+        (click.FloatRange(1.5, 2.5), "1.5<=x<=2.5"),
+        (click.FloatRange(max=2.5), "x<=2.5"),
+        (click.FloatRange(max=2.5, max_open=True), "x<2.5"),
+    ],
+)
+def test_range_help_text_open_closed(type, expect):
+    """A one-sided bound shows ``>=`` unless the bound is open."""
+    assert type._describe_range() == expect
+
