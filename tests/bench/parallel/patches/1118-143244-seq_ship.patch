+"""Export expenses."""
+
+from __future__ import annotations
+
+import json
+
+from kakeibo.core import Expense
+
+
+def to_json(rows: list[Expense]) -> str:
+    return json.dumps(
+        [
+            {
+                "date": e.day.isoformat(),
+                "category": e.category,
+                "amount": e.amount,
+                "memo": e.memo,
+            }
+            for e in rows
+        ],
+        ensure_ascii=False,
+    )
