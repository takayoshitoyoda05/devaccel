+import pytest
+
+from kakeibo.split import split_evenly
+
+
+def test_even() -> None:
+    assert split_evenly(900, 3) == [300, 300, 300]
+
+
+def test_remainder_to_front() -> None:
+    assert split_evenly(1000, 3) == [334, 333, 333]
+    assert split_evenly(2, 5) == [1, 1, 0, 0, 0]
+
+
+def test_sum_and_edge() -> None:
+    assert split_evenly(0, 4) == [0, 0, 0, 0]
+    assert split_evenly(777, 1) == [777]
+    assert sum(split_evenly(12345, 7)) == 12345
+
+
+def test_invalid_people() -> None:
+    with pytest.raises(ValueError):
+        split_evenly(100, 0)
+    with pytest.raises(ValueError):
+        split_evenly(100, -2)
