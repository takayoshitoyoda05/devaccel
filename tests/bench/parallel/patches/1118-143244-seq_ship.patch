--- /dev/null
+++ b/tests/test_topn.py
@@ -0,0 +1,25 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.topn import top_expenses
+
+
+def test_nonpositive_and_empty() -> None:
+    rows = [Expense(date(2026, 1, 1), "a", 1)]
+    assert top_expenses(rows, 0) == []
+    assert top_expenses(rows, -1) == []
+    assert top_expenses([], 3) == []
+
+
+def test_order_and_ties() -> None:
+    a = Expense(date(2026, 1, 5), "a", 100)
+    b = Expense(date(2026, 1, 2), "b", 100)
+    c = Expense(date(2026, 1, 2), "c", 100)
+    d = Expense(date(2026, 1, 1), "d", 500)
+    e = Expense(date(2026, 1, 1), "e", 1)
+    assert top_expenses([a, b, c, d, e], 4) == [d, b, c, a]
+
+
+def test_n_larger_than_len() -> None:
+    rows = [Expense(date(2026, 1, 1), "a", 1), Expense(date(2026, 1, 1), "b", 2)]
+    assert len(top_expenses(rows, 10)) == 2
