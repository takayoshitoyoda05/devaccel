+"""Duplicate detection."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def find_duplicates(rows: list[Expense]) -> list[tuple[int, int]]:
+    seen: dict[tuple[object, ...], list[int]] = {}
+    out: list[tuple[int, int]] = []
+    for j, e in enumerate(rows):
+        key = (e.day, e.category, e.amount, e.memo)
+        for i in seen.setdefault(key, []):
+            out.append((i, j))
+        seen[key].append(j)
+    return sorted(out)
