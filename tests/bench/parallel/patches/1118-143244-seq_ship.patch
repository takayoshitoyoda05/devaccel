+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.stats import median_by_category
+
+
+def _e(cat: str, amount: int) -> Expense:
+    return Expense(date(2026, 1, 1), cat, amount)
+
+
+def test_empty() -> None:
+    assert median_by_category([]) == {}
+
+
+def test_odd_and_even() -> None:
+    rows = [_e("food", 300), _e("food", 100), _e("food", 200), _e("a", 10), _e("a", 15)]
+    out = median_by_category(rows)
+    assert out == {"a": 12.5, "food": 200.0}
+    assert list(out) == ["a", "food"]
+
+
+def test_single() -> None:
+    assert median_by_category([_e("x", 7)]) == {"x": 7.0}
