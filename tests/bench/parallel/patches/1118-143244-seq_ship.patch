@@ -0,0 +1,15 @@
+"""Totals by weekday."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+_NAMES = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
+
+
+def total_by_weekday(rows: list[Expense]) -> dict[str, int]:
+    totals: dict[int, int] = {}
+    for e in rows:
+        w = e.day.weekday()
+        totals[w] = totals.get(w, 0) + e.amount
+    return {_NAMES[w]: totals[w] for w in sorted(totals)}
