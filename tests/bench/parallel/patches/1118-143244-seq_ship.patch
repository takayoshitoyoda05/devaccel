+++ b/tests/test_dupes.py
@@ -0,0 +1,29 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.dupes import find_duplicates
+
+D = date(2026, 1, 1)
+
+
+def test_none() -> None:
+    assert find_duplicates([]) == []
+    assert find_duplicates([Expense(D, "a", 1), Expense(D, "a", 2)]) == []
+
+
+def test_pair() -> None:
+    rows = [Expense(D, "a", 1), Expense(D, "b", 1), Expense(D, "a", 1)]
+    assert find_duplicates(rows) == [(0, 2)]
+
+
+def test_triple_sorted() -> None:
+    x = Expense(D, "a", 1)
+    y = Expense(D, "b", 2)
+    assert find_duplicates([x, y, x, y, x]) == [(0, 2), (0, 4), (1, 3), (2, 4)]
+
+
+def test_memo_and_day_differ() -> None:
+    assert find_duplicates([Expense(D, "a", 1, "m"), Expense(D, "a", 1, "n")]) == []
+    assert (
+        find_duplicates([Expense(D, "a", 1), Expense(date(2026, 1, 2), "a", 1)]) == []
+    )
