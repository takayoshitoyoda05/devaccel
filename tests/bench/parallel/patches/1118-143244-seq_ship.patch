@@ -0,0 +1,20 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.weekday import total_by_weekday
+
+
+def test_empty() -> None:
+    assert total_by_weekday([]) == {}
+
+
+def test_totals_and_order() -> None:
+    rows = [
+        Expense(date(2026, 11, 15), "a", 5),  # Sun
+        Expense(date(2026, 11, 16), "a", 100),  # Mon
+        Expense(date(2026, 11, 23), "b", 20),  # Mon
+        Expense(date(2026, 11, 18), "a", 3),  # Wed
+    ]
+    out = total_by_weekday(rows)
+    assert out == {"Mon": 120, "Wed": 3, "Sun": 5}
+    assert list(out) == ["Mon", "Wed", "Sun"]
