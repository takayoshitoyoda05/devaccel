+import json
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.export import to_json
+
+
+def test_empty() -> None:
+    assert to_json([]) == "[]"
+
+
+def test_exact_output_order_and_unicode() -> None:
+    rows = [
+        Expense(date(2026, 3, 5), "食費", 800, "昼"),
+        Expense(date(2026, 3, 1), "交通", 200),
+    ]
+    assert to_json(rows) == (
+        '[{"date": "2026-03-05", "category": "食費", "amount": 800, "memo": "昼"}, '
+        '{"date": "2026-03-01", "category": "交通", "amount": 200, "memo": ""}]'
+    )
+
+
+def test_roundtrip() -> None:
+    rows = [Expense(date(2026, 1, 2), 'a"b', 1, "x\ny")]
+    assert json.loads(to_json(rows))[0]["category"] == 'a"b'
