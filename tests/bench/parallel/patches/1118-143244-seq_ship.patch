@@ -0,0 +1,30 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.streak import longest_no_spend_streak
+
+
+def _e(d: int) -> Expense:
+    return Expense(date(2026, 1, d), "a", 1)
+
+
+def test_no_rows() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 1), date(2026, 1, 10)) == 10
+
+
+def test_gaps() -> None:
+    rows = [_e(3), _e(4), _e(9)]
+    # free: 1-2 (2), 5-8 (4), 10 (1)
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 10)) == 4
+
+
+def test_inclusive_bounds_and_outside_rows() -> None:
+    rows = [_e(1), _e(10), _e(20)]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 10)) == 8
+    assert longest_no_spend_streak(rows, date(2026, 1, 5), date(2026, 1, 9)) == 5
+
+
+def test_all_spent_and_reversed() -> None:
+    rows = [_e(1), _e(2)]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 2)) == 0
+    assert longest_no_spend_streak([], date(2026, 1, 5), date(2026, 1, 1)) == 0
diff --git a/tests/test_topn.py b/tests/test_topn.py
new file mode 100644
