index 0000000..37f5866
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,84 @@
+"""前月比レポート。"""
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(?:0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not isinstance(month, str) or _MONTH_RE.fullmatch(month) is None:
+        raise ValueError(f"invalid month: {month!r}")
+
+
+def _month_of(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+    prev_totals: dict[str, int] = {}
+    curr_totals: dict[str, int] = {}
+    for e in rows:
+        m = _month_of(e)
+        if m == prev_month:
+            prev_totals[e.category] = prev_totals.get(e.category, 0) + e.amount
+        if m == curr_month:
+            curr_totals[e.category] = curr_totals.get(e.category, 0) + e.amount
+    result: list[DiffRow] = []
+    for cat in set(prev_totals) | set(curr_totals):
+        prev = prev_totals.get(cat, 0)
+        curr = curr_totals.get(cat, 0)
+        delta = curr - prev
+        pct = None if prev == 0 else round(delta / prev * 100, 1)
+        if cat not in prev_totals:
+            status = "new"
+        elif cat not in curr_totals:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        result.append(DiffRow(cat, prev, curr, delta, pct, status))
+    result.sort(key=lambda r: (-abs(r.delta), r.category))
+    return result
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError("n must be >= 0")
+    return [d for d in diffs if d.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for d in diffs:
+        pct = "-" if d.pct is None else f"{d.pct + 0.0:+.1f}%"
+        lines.append(f"{d.category}\t{d.prev}\t{d.curr}\t{d.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month_of(e) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("need at least two months")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..a18cc60
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,138 @@
+"""検索クエリの字句解析・構文解析・評価。"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+
+from kakeibo.core import Expense
+
+
+class QueryError(ValueError):
+    pass
+
+
+_Pred = Callable[[Expense], bool]
+_STOP = set(' \t\r\n\f\v()"')
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    tokens: list[tuple[str, str]] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError("unclosed quote")
+            body = q[i + 1 : end]
+            if body == "":
+                raise QueryError("empty quote")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            j = i
+            while j < n and not (q[j].isspace() or q[j] in '()"'):
+                j += 1
+            word = q[i:j]
+            i = j
+            if word in ("AND", "OR", "NOT"):
+                tokens.append((word, word))
+            elif word.startswith("cat:"):
+                rest = word[4:]
+                if rest == "":
+                    raise QueryError("empty category")
+                tokens.append(("CAT", rest))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+class _Parser:
+    def __init__(self, tokens: list[tuple[str, str]]) -> None:
+        self.t = tokens
+        self.p = 0
+
+    def peek(self) -> str | None:
+        return self.t[self.p][0] if self.p < len(self.t) else None
+
+    def parse(self) -> _Pred:
+        if not self.t:
+            raise QueryError("empty query")
+        node = self.or_expr()
+        if self.p != len(self.t):
+            raise QueryError("unexpected token")
+        return node
+
+    def or_expr(self) -> _Pred:
+        parts = [self.and_expr()]
+        while self.peek() == "OR":
+            self.p += 1
+            parts.append(self.and_expr())
+        if len(parts) == 1:
+            return parts[0]
+        return lambda e: any(f(e) for f in parts)
+
+    def and_expr(self) -> _Pred:
+        parts = [self.not_expr()]
+        while True:
+            k = self.peek()
+            if k == "AND":
+                self.p += 1
+                parts.append(self.not_expr())
+            elif k in ("TERM", "CAT", "LPAREN", "NOT"):
+                parts.append(self.not_expr())
+            else:
+                break
+        if len(parts) == 1:
+            return parts[0]
+        return lambda e: all(f(e) for f in parts)
+
+    def not_expr(self) -> _Pred:
+        if self.peek() == "NOT":
+            self.p += 1
+            inner = self.not_expr()
+            return lambda e: not inner(e)
+        return self.primary()
+
+    def primary(self) -> _Pred:
+        k = self.peek()
+        if k is None:
+            raise QueryError("unexpected end")
+        if k == "TERM":
+            v = self.t[self.p][1].casefold()
+            self.p += 1
+            return lambda e: v in e.memo.casefold() or v in e.category.casefold()
+        if k == "CAT":
+            v = self.t[self.p][1].casefold()
+            self.p += 1
+            return lambda e: v == e.category.casefold()
+        if k == "LPAREN":
+            self.p += 1
+            node = self.or_expr()
+            if self.peek() != "RPAREN":
+                raise QueryError("missing )")
+            self.p += 1
+            return node
+        raise QueryError(f"unexpected {k}")
+
+
+def _compile(q: str) -> _Pred:
+    return _Parser(tokenize(q)).parse()
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _compile(q)(e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    pred = _compile(q)
+    return [r for r in rows if pred(r)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..cf5e4cc
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,58 @@
+"""定期支出の検出。"""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+from itertools import pairwise
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """翌月の同じ日。なければ翌月の末日。"""
+    year = d.year + (1 if d.month == 12 else 0)
+    month = 1 if d.month == 12 else d.month + 1
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError("min_count must be >= 2")
+    if tolerance < 0:
+        raise ValueError("tolerance must be >= 0")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for r in rows:
+        groups.setdefault((r.category, r.amount), set()).add(r.day)
+
+    result: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        days = sorted(day_set)
+        run = [days[0]]
+        runs = [run]
+        for prev, cur in pairwise(days):
+            if abs((cur - add_month(prev)).days) <= tolerance:
+                run.append(cur)
+            else:
+                run = [cur]
+                runs.append(run)
+        for run in runs:
+            if len(run) >= min_count:
+                result.append(
+                    Recurring(category, amount, tuple(run), add_month(run[-1]))
+                )
+    result.sort(key=lambda x: (x.category, x.amount, x.days[0]))
+    return result
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..787c040
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,114 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+HEAD = "利用日,分類,利用金額,利用店名\n"
+
+
+@pytest.mark.parametrize(
+    "s,v",
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥1,2,3円", 123),
+        ("-5", -5),
+    ],
+)
+def test_parse_amount_ok(s, v):
+    assert parse_amount(s) == v
+
+
+@pytest.mark.parametrize(
+    "s",
+    ["", "円", "12.5", "1 200", "--5", "¥-5", "１２３", ",1", "¥", "-", "5円円", "¥¥5"],
+)
+def test_parse_amount_bad(s):
+    with pytest.raises(ValueError):
+        parse_amount(s)
+
+
+def test_parse_date_ok():
+    assert parse_date(" 2026/1/5 ") == date(2026, 1, 5)
+    assert parse_date("2026-01-05") == date(2026, 1, 5)
+
+
+@pytest.mark.parametrize(
+    "s",
+    [
+        "2026/1-5",
+        "26/1/5",
+        "2026/02/30",
+        "2026.1.5",
+        "",
+        "2026/1/005",
+        "２０２６/1/5",
+        "0000/1/1",
+    ],
+)
+def test_parse_date_bad(s):
+    with pytest.raises(ValueError):
+        parse_date(s)
+
+
+def test_default_mapping():
+    assert DEFAULT_MAPPING["amount"] == "利用金額"
+
+
+def test_import_basic_and_category_map():
+    text = HEAD + '2026/1/5, 食費 ,"¥1,200", コンビニ \n2026-02-03,交通,300円,\n'
+    exp, err = import_rows(text, category_map={"食費": "food"})
+    assert err == []
+    assert exp == [
+        Expense(date(2026, 1, 5), "food", 1200, "コンビニ"),
+        Expense(date(2026, 2, 3), "交通", 300, ""),
+    ]
+
+
+def test_import_errors_order_blank_and_short():
+    text = HEAD + "bad,,x,m\n\n2026/1/1,食費\n2026/1/1,食費,100,ok\n"
+    exp, err = import_rows(text)
+    assert err == [(2, "date"), (2, "amount"), (2, "category"), (4, "amount")]
+    assert exp == [Expense(date(2026, 1, 1), "食費", 100, "ok")]
+
+
+def test_import_custom_mapping_without_memo_and_extra_columns():
+    text = "d,c,a,zzz\n2026/1/1,x,5,junk\n"
+    m = {"date": "d", "category": "c", "amount": "a"}
+    exp, err = import_rows(text, m)
+    assert exp == [Expense(date(2026, 1, 1), "x", 5, "")]
+    assert err == []
+
+
+def test_import_mapping_errors():
+    with pytest.raises(ValueError):
+        import_rows(HEAD, {"date": "利用日", "category": "分類"})
+    with pytest.raises(ValueError):
+        import_rows(HEAD, {"date": "利用日", "category": "分類", "amount": "nope"})
+    with pytest.raises(ValueError):
+        import_rows(
+            HEAD,
+            {
+                "date": "利用日",
+                "category": "分類",
+                "amount": "利用金額",
+                "memo": "nope",
+            },
+        )
+
+
+def test_import_physical_line_numbers_with_multiline_quote():
+    text = HEAD + '2026/1/1,食費,100,"a\nb"\nx,食費,100,m\n'
+    exp, err = import_rows(text)
+    assert len(exp) == 1
+    assert exp[0].memo == "a\nb"
+    assert err == [(4, "date")]
+
+
+def test_import_empty_text():
+    with pytest.raises(ValueError):
+        import_rows("")
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..f6a74c2
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,141 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def e(d: str, cat: str, amt: int) -> Expense:
+    return Expense(date.fromisoformat(d), cat, amt, "")
+
+
+ROWS = [
+    e("2024-01-05", "food", 1000),
+    e("2024-01-20", "food", 1000),
+    e("2024-01-10", "rent", 5000),
+    e("2024-01-11", "fun", 2000),
+    e("2024-02-02", "food", 2300),
+    e("2024-02-03", "rent", 5000),
+    e("2024-02-04", "gym", 700),
+]
+
+
+def by_cat(diffs):
+    return {d.category: d for d in diffs}
+
+
+def test_basic_and_statuses():
+    d = by_cat(month_diff(ROWS, "2024-01", "2024-02"))
+    assert d["food"] == DiffRow("food", 2000, 2300, 300, 15.0, "up")
+    assert d["rent"] == DiffRow("rent", 5000, 5000, 0, 0.0, "same")
+    assert d["fun"] == DiffRow("fun", 2000, 0, -2000, -100.0, "gone")
+    assert d["gym"] == DiffRow("gym", 0, 700, 700, None, "new")
+
+
+def test_down():
+    d = by_cat(month_diff(ROWS, "2024-02", "2024-01"))
+    assert d["food"].status == "down"
+    assert d["gym"].status == "gone"
+    assert d["fun"].status == "new"
+
+
+def test_order():
+    cats = [d.category for d in month_diff(ROWS, "2024-01", "2024-02")]
+    assert cats == ["fun", "gym", "food", "rent"]
+
+
+def test_order_tie_by_category():
+    rows = [e("2024-01-01", "b", 100), e("2024-01-02", "a", 100)]
+    assert [d.category for d in month_diff(rows, "2024-01", "2024-02")] == ["a", "b"]
+
+
+def test_status_by_presence_not_total():
+    rows = [e("2024-01-01", "x", 0), e("2024-02-01", "x", 0)]
+    assert month_diff(rows, "2024-01", "2024-02")[0].status == "same"
+    rows = [e("2024-02-01", "x", 0)]
+    assert month_diff(rows, "2024-01", "2024-02")[0].status == "new"
+    rows = [e("2024-01-01", "x", 0)]
+    assert month_diff(rows, "2024-01", "2024-02")[0].status == "gone"
+
+
+def test_prev_zero_total_with_rows_pct_none():
+    rows = [e("2024-01-01", "x", 0), e("2024-02-01", "x", 50)]
+    d = month_diff(rows, "2024-01", "2024-02")[0]
+    assert d.pct is None
+    assert d.status == "up"
+
+
+def test_empty_and_other_months_ignored():
+    assert month_diff([], "2024-01", "2024-02") == []
+    assert month_diff([e("2023-01-01", "x", 1)], "2024-01", "2024-02") == []
+
+
+def test_year_distinguished():
+    rows = [e("2023-02-01", "x", 1), e("2024-02-01", "x", 5)]
+    d = month_diff(rows, "2023-02", "2024-02")
+    assert d[0].delta == 4
+
+
+@pytest.mark.parametrize(
+    "bad",
+    ["2024-1", "2024-13", "2024-00", "202401", "24-01", "2024-01-01", "", "2024-011"],
+)
+def test_bad_month(bad):
+    with pytest.raises(ValueError):
+        month_diff(ROWS, bad, "2024-02")
+    with pytest.raises(ValueError):
+        month_diff(ROWS, "2024-01", bad)
+
+
+def test_top_movers():
+    diffs = month_diff(ROWS, "2024-01", "2024-02")
+    assert [d.category for d in top_movers(diffs)] == ["fun", "gym", "food"]
+    assert [d.category for d in top_movers(diffs, 2)] == ["fun", "gym"]
+    assert top_movers(diffs, 0) == []
+    assert len(top_movers(diffs, 10)) == 3
+    with pytest.raises(ValueError):
+        top_movers(diffs, -1)
+
+
+def test_render():
+    diffs = month_diff(ROWS, "2024-01", "2024-02")
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "fun\t2000\t0\t-2000\t-100.0%\n"
+        "gym\t0\t700\t+700\t-\n"
+        "food\t2000\t2300\t+300\t+15.0%\n"
+        "rent\t5000\t5000\t+0\t+0.0%"
+    )
+
+
+def test_render_empty():
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_available_months():
+    assert available_months([]) == []
+    assert available_months(ROWS) == ["2024-01", "2024-02"]
+    rows = [e("2024-03-01", "a", 1), e("2023-12-31", "a", 1), e("2024-03-09", "a", 1)]
+    assert available_months(rows) == ["2023-12", "2024-03"]
+
+
+def test_latest_diff():
+    rows = ROWS + [e("2024-03-01", "food", 100)]
+    d = latest_diff(rows)
+    assert by_cat(d)["food"] == DiffRow("food", 2300, 100, -2200, -95.7, "down")
+    assert by_cat(d)["rent"].status == "gone"
+
+
+def test_latest_diff_too_few():
+    with pytest.raises(ValueError):
+        latest_diff([])
+    with pytest.raises(ValueError):
+        latest_diff([e("2024-01-01", "a", 1), e("2024-01-02", "a", 1)])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..5d896b6
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,173 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def ex(category="food", memo="lunch", amount=100):
+    return Expense(date(2024, 1, 1), category, amount, memo)
+
+
+def test_tokenize_basic():
+    assert tokenize('  ( a ) "x y" ') == [
+        ("LPAREN", "("),
+        ("TERM", "a"),
+        ("RPAREN", ")"),
+        ("TERM", "x y"),
+    ]
+
+
+def test_tokenize_empty():
+    assert tokenize("") == []
+    assert tokenize("   ") == []
+
+
+def test_tokenize_keywords():
+    assert tokenize("AND OR NOT and or not") == [
+        ("AND", "AND"),
+        ("OR", "OR"),
+        ("NOT", "NOT"),
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_cat():
+    assert tokenize("cat:food") == [("CAT", "food")]
+    assert tokenize("Cat:food") == [("TERM", "Cat:food")]
+
+
+def test_tokenize_word_stops_at_paren_and_quote():
+    assert tokenize('a(b)c"d"') == [
+        ("TERM", "a"),
+        ("LPAREN", "("),
+        ("TERM", "b"),
+        ("RPAREN", ")"),
+        ("TERM", "c"),
+        ("TERM", "d"),
+    ]
+
+
+def test_tokenize_quote_with_parens():
+    assert tokenize('"a (b) AND"') == [("TERM", "a (b) AND")]
+
+
+@pytest.mark.parametrize("q", ['"abc', '""', "cat:", 'cat:"x"'])
+def test_tokenize_errors(q):
+    with pytest.raises(QueryError):
+        tokenize(q)
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "  ",
+        "()",
+        "(a",
+        "a)",
+        "a AND",
+        "OR a",
+        "a OR",
+        "NOT",
+        "a OR OR b",
+        "(a))",
+        "a AND OR b",
+    ],
+)
+def test_grammar_errors(q):
+    with pytest.raises(QueryError):
+        matches(q, ex())
+
+
+def test_query_error_is_value_error():
+    assert issubclass(QueryError, ValueError)
+
+
+def test_term_memo_or_category_casefold():
+    e = ex(category="Food", memo="Big LUNCH")
+    assert matches("lunch", e)
+    assert matches("FOO", e)
+    assert not matches("dinner", e)
+
+
+def test_cat_exact():
+    e = ex(category="Food")
+    assert matches("cat:food", e)
+    assert matches("cat:FOOD", e)
+    assert not matches("cat:foo", e)
+
+
+def test_cat_not_memo():
+    assert not matches("cat:lunch", ex(category="food", memo="lunch"))
+
+
+def test_quoted_term_with_space():
+    assert matches('"big lunch"', ex(memo="a big lunch"))
+    assert not matches('"big  lunch"', ex(memo="a big lunch"))
+
+
+def test_implicit_and():
+    e = ex(category="food", memo="lunch")
+    assert matches("food lunch", e)
+    assert not matches("food dinner", e)
+    assert matches("food AND lunch", e)
+
+
+def test_or():
+    e = ex(memo="lunch")
+    assert matches("dinner OR lunch", e)
+    assert not matches("dinner OR tea", e)
+
+
+def test_not():
+    e = ex(memo="lunch")
+    assert matches("NOT dinner", e)
+    assert not matches("NOT lunch", e)
+    assert matches("NOT NOT lunch", e)
+
+
+def test_precedence():
+    e = ex(category="food", memo="lunch")
+    # a OR (b AND c): true because a matches
+    assert matches("lunch OR x y", e)
+    # (a OR b) AND c would be false; correct parse is true
+    assert matches("lunch OR zzz zzz", e)
+    # NOT binds tighter than AND
+    assert matches("NOT zzz lunch", e)
+    assert not matches("NOT (zzz lunch)", ex(memo="zzz lunch"))
+
+
+def test_parens():
+    e = ex(category="food", memo="lunch")
+    assert matches("(zzz OR lunch) food", e)
+    assert not matches("(zzz OR yyy) food", e)
+
+
+def test_implicit_and_with_not_and_paren():
+    e = ex(category="food", memo="lunch")
+    assert matches("food NOT zzz", e)
+    assert matches("food (lunch)", e)
+
+
+def test_lowercase_keywords_are_terms():
+    assert matches("and", ex(memo="band"))
+
+
+def test_filter_rows_order_preserved():
+    rows = [ex(memo="b"), ex(memo="a"), ex(memo="ab"), ex(memo="c")]
+    assert [r.memo for r in filter_rows("a OR b", rows)] == ["b", "a", "ab"]
+
+
+def test_filter_rows_no_match():
+    assert filter_rows("zzz", [ex()]) == []
+
+
+def test_filter_rows_invalid_query_empty_rows():
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
+    with pytest.raises(QueryError):
+        filter_rows("", [])
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..4624ba3
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,96 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def e(d: date, cat: str = "rent", amount: int = 1000, memo: str = "") -> Expense:
+    return Expense(d, cat, amount, memo)
+
+
+def test_add_month_cases():
+    assert add_month(date(2026, 1, 31)) == date(2026, 2, 28)
+    assert add_month(date(2024, 1, 31)) == date(2024, 2, 29)
+    assert add_month(date(2026, 12, 15)) == date(2027, 1, 15)
+    assert add_month(date(2026, 3, 31)) == date(2026, 4, 30)
+
+
+def test_invalid_args():
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_empty():
+    assert find_recurring([]) == []
+
+
+def test_basic_and_memo_ignored():
+    rows = [
+        e(date(2026, 1, 5), memo="a"),
+        e(date(2026, 2, 5), memo="b"),
+        e(date(2026, 3, 5)),
+    ]
+    assert find_recurring(rows) == [
+        Recurring(
+            "rent",
+            1000,
+            (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+            date(2026, 4, 5),
+        )
+    ]
+
+
+def test_below_min_count():
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 5))]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_count=2)) == 1
+
+
+def test_duplicate_dates_removed():
+    rows = [e(date(2026, 1, 5)), e(date(2026, 1, 5)), e(date(2026, 2, 5))]
+    assert find_recurring(rows) == []
+    r = find_recurring(rows, min_count=2)
+    assert r[0].days == (date(2026, 1, 5), date(2026, 2, 5))
+
+
+def test_tolerance_boundary():
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 8)), e(date(2026, 3, 11))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+    assert find_recurring(rows, tolerance=2) == []
+
+
+def test_split_into_runs():
+    rows = [
+        e(date(2026, 1, 5)),
+        e(date(2026, 2, 5)),
+        e(date(2026, 3, 5)),
+        e(date(2026, 6, 5)),
+        e(date(2026, 7, 5)),
+        e(date(2026, 8, 5)),
+    ]
+    r = find_recurring(rows)
+    assert [x.days[0] for x in r] == [date(2026, 1, 5), date(2026, 6, 5)]
+    assert r[1].next_expected == date(2026, 9, 5)
+
+
+def test_different_amount_or_category_separate():
+    rows = [e(date(2026, m, 5), amount=1000 if m != 2 else 1100) for m in (1, 2, 3)]
+    assert find_recurring(rows) == []
+
+
+def test_sorted_output():
+    rows = []
+    for cat, amt in [("b", 1), ("a", 2), ("a", 1)]:
+        rows += [e(date(2026, m, 1), cat, amt) for m in (1, 2, 3)]
+    r = find_recurring(rows)
+    assert [(x.category, x.amount) for x in r] == [("a", 1), ("a", 2), ("b", 1)]
+
+
+def test_month_end_chain():
+    rows = [e(date(2026, 1, 31)), e(date(2026, 2, 28)), e(date(2026, 3, 31))]
+    r = find_recurring(rows)
+    assert r[0].next_expected == date(2026, 4, 30)
