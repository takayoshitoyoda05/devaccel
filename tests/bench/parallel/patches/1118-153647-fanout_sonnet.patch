index 0000000..1cdf9b4
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,88 @@
+"""他行 CSV の取り込み。"""
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"(-?)[¥￥]?([0-9][0-9,]*)円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"invalid amount: {s!r}")
+    value = int(m.group(2).replace(",", ""))
+    return -value if m.group(1) else value
+
+
+def parse_date(s: str) -> date:
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"invalid date: {s!r}")
+    return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping missing key: {key}")
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header = next(reader, None)
+    if header is None:
+        raise ValueError("missing header")
+    index: dict[str, int] = {}
+    for field, col in mapping.items():
+        if col not in header:
+            raise ValueError(f"column not found: {col}")
+        index[field] = header.index(col)
+
+    def get(row: list[str], field: str) -> str:
+        i = index.get(field)
+        if i is None or i >= len(row):
+            return ""
+        return row[i]
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    prev = reader.line_num
+    for row in reader:
+        lineno = prev + 1
+        prev = reader.line_num
+        if not row:
+            continue
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(get(row, "date"))
+        except ValueError:
+            errors.append((lineno, "date"))
+        try:
+            amount = parse_amount(get(row, "amount"))
+        except ValueError:
+            errors.append((lineno, "amount"))
+        category = get(row, "category").strip()
+        if not category:
+            errors.append((lineno, "category"))
+        if day is None or amount is None or not category:
+            continue
+        if category_map:
+            category = category_map.get(category, category)
+        expenses.append(Expense(day, category, amount, get(row, "memo").strip()))
+    return expenses, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
