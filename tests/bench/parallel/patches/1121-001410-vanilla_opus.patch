+def test_errors_report_line_column_value_and_reason_and_continue():
+    text = (
+        "利用日,利用店名,利用金額\n"
+        "2026/11/01,A,100\n"
+        "2026/13/01,B,100\n"
+        "2026/11/03,C,12.5\n"
+        "2026/11/04,D\n"
+        "合計,,300\n"
+        "2026/11/05,E,abc\n"
+        "2026/11/06,F,600\n"
+    )
+    r = import_statement(text, CARD)
+    assert not r.ok
+    assert [e.amount for e in r.expenses] == [100, 600]
+    assert r.errors == [
+        RowError(3, "利用日", "2026/13/01", "日付として読めません"),
+        RowError(4, "利用金額", "12.5", "円未満の端数があります"),
+        RowError(5, "利用金額", None, "列が足りません(2列しかありません)"),
+        RowError(6, "利用日", "合計", "日付として読めません"),
+        RowError(7, "利用金額", "abc", "金額として読めません"),
+    ]
+    assert str(r.errors[0]) == "3行目 列「利用日」: 日付として読めません: '2026/13/01'"
+    assert str(r.errors[2]) == "5行目 列「利用金額」: 列が足りません(2列しかありません)"
+
+
+def test_error_column_name_is_as_written_in_file():
+    r = import_statement(" ご利用日 ,ご利用金額\n2026/11/01,x\n", CARD)
+    assert r.errors == [RowError(2, "ご利用金額", "x", "金額として読めません")]
