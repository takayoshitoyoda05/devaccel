+def test_bank_errors_both_sides_or_neither():
+    text = "取引日,出金,入金\n2026/11/01,100,200\n2026/11/02,,\n2026/11/03,,1.5\n"
+    r = import_statement(text, BANK)
+    assert r.expenses == []
