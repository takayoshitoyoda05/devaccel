+def test_missing_header_is_reported():
+    r = import_statement("年月,店,円\n2026/11,A,100\n", CARD)
+    assert r.expenses == []
+    assert len(r.errors) == 1
+    err = r.errors[0]
+    assert err.line == 1
+    assert err.value == "年月,店,円"
+    assert "ヘッダ行が見つかりません" in err.reason
+    assert "利用日" in err.reason and "利用金額" in err.reason
