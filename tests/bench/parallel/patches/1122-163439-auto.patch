diff --git a/CHANGES.md b/CHANGES.md
index 3efb850..45b9cfc 100644
--- a/CHANGES.md
+++ b/CHANGES.md
@@ -2,6 +2,8 @@
 
 Unreleased
 
+- The error for an invalid {class}`Choice` value suggests the closest choices
+  with `Did you mean ...?`, like it does for unknown options and commands.
 - Drop support for Python 3.10. {pr}`3920` {pr}`3921`
 - A parameter name that is not a valid Python identifier, or that is a Python
   keyword, is deprecated and raises `TypeError` in Click 9.0. {pr}`3866`
diff --git a/src/click/types.py b/src/click/types.py
index 5d11e9f..0cfedb9 100644
--- a/src/click/types.py
+++ b/src/click/types.py
@@ -460,17 +460,33 @@ class Choice(ParamType[_ValueT_co], t.Generic[_ValueT_co]):
     def get_invalid_choice_message(self, value: t.Any, ctx: Context | None) -> str:
         """Get the error message when the given choice is invalid.
 
+        If the value is close to one or more of the choices, the message ends
+        with a "Did you mean ...?" suggestion.
+
         :param value: The invalid value.
 
         .. versionadded:: 8.2
         """
-        choices_str = ", ".join(map(repr, self._normalized_mapping(ctx=ctx).values()))
-        return ngettext(
+        normalized = list(self._normalized_mapping(ctx=ctx).values())
+        choices_str = ", ".join(map(repr, normalized))
+        message = ngettext(
             "{value!r} is not {choice}.",
             "{value!r} is not one of {choices}.",
             len(self.choices),
         ).format(value=value, choice=choices_str, choices=choices_str)
 
+        from difflib import get_close_matches
+
+        from .exceptions import _format_possibilities
+
+        normed_value = self.normalize_choice(choice=value, ctx=ctx)
+        possibilities = get_close_matches(normed_value, normalized)
+
+        if possibilities:
+            message = f"{message} {_format_possibilities(possibilities)}"
+
+        return message
+
     def __repr__(self) -> str:
         return _("Choice({choices})").format(choices=list(self.choices))
 
diff --git a/tests/test_types/test_Choice.py b/tests/test_types/test_Choice.py
index c34f516..d742d3e 100644
--- a/tests/test_types/test_Choice.py
+++ b/tests/test_types/test_Choice.py
@@ -1,3 +1,7 @@
+import enum
+
+import pytest
+
 import click
 
 
@@ -5,3 +9,90 @@ def test_choice_get_invalid_choice_message():
     choice = click.Choice(["a", "b", "c"])
     message = choice.get_invalid_choice_message("d", ctx=None)
     assert message == "'d' is not one of 'a', 'b', 'c'."
+
+
+def test_choice_invalid_message_suggests_one_close_choice():
+    choice = click.Choice(["push", "pull", "merge"])
+    message = choice.get_invalid_choice_message("pus", ctx=None)
+    assert message == (
+        "'pus' is not one of 'push', 'pull', 'merge'. Did you mean 'push'?"
+    )
+
+
+def test_choice_invalid_message_suggests_several_close_choices():
+    choice = click.Choice(["declare", "refine", "push"])
+    message = choice.get_invalid_choice_message("decline", ctx=None)
+    assert message.endswith("(Did you mean one of: 'declare', 'refine'?)")
+
+
+def test_choice_invalid_message_no_suggestion_when_far():
+    choice = click.Choice(["foo", "bar", "baz"])
+    message = choice.get_invalid_choice_message("meh", ctx=None)
+    assert "Did you mean" not in message
+
+
+def test_choice_invalid_message_single_choice():
+    choice = click.Choice(["json"])
+    message = choice.get_invalid_choice_message("jsno", ctx=None)
+    assert message == "'jsno' is not 'json'. Did you mean 'json'?"
+
+
+def test_choice_invalid_message_case_insensitive():
+    choice = click.Choice(["Red", "Green"], case_sensitive=False)
+    message = choice.get_invalid_choice_message("gren", ctx=None)
+    assert message.endswith("Did you mean 'green'?")
+
+
+def test_choice_invalid_message_enum():
+    class Color(enum.Enum):
+        RED = 1
+        GREEN = 2
+
+    choice = click.Choice(Color)
+    message = choice.get_invalid_choice_message("GREN", ctx=None)
+    assert message.endswith("Did you mean 'GREEN'?")
+
+
+def test_choice_invalid_message_non_str_value():
+    choice = click.Choice(["100", "200"])
+    message = choice.get_invalid_choice_message(101, ctx=None)
+    assert message.endswith("Did you mean '100'?")
+
+
+def test_choice_invalid_message_empty_value():
+    choice = click.Choice(["a", "b"])
+    message = choice.get_invalid_choice_message("", ctx=None)
+    assert "Did you mean" not in message
+
+
+def test_choice_invalid_message_token_normalize_func():
+    choice = click.Choice(["fast", "slow"])
+    ctx = click.Context(click.Command("cli"), token_normalize_func=str.lower)
+    message = choice.get_invalid_choice_message("FAAST", ctx=ctx)
+    assert message.endswith("Did you mean 'fast'?")
+
+
+def test_choice_cli_error_output(runner):
+    @click.command()
+    @click.option("--method", type=click.Choice(["push", "pull"]))
+    def cli(method):
+        click.echo(method)
+
+    result = runner.invoke(cli, ["--method=pus"])
+    assert result.exit_code == 2
+    assert (
+        "Invalid value for '--method': 'pus' is not one of 'push', 'pull'."
+        " Did you mean 'push'?"
+    ) in result.output
+
+
+@pytest.mark.parametrize("value", ["meh", "zzzz"])
+def test_choice_cli_error_output_no_suggestion(runner, value):
+    @click.command()
+    @click.argument("method", type=click.Choice(["push", "pull"]))
+    def cli(method):
+        click.echo(method)
+
+    result = runner.invoke(cli, [value])
+    assert result.exit_code == 2
+    assert "Did you mean" not in result.output
