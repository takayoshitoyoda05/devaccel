@@ -0,0 +1,239 @@
+import json
+from datetime import date
+
+import pytest
+
+from kakeibo import main
+from kakeibo.core import Expense, JsonError, export_json, load_csv, load_json
+
+HEADER = "date,category,amount,memo\n"
+BODY = (
+    "2026-10-31,food,500,\n"
+    "2026-11-01,food,1200,lunch\n"
+    "2026-11-02,rent,80000,\n"
+    "2026-11-03,food,800,coffee\n"
+)
+
+
+def _csv(tmp_path, body=BODY):
+    p = tmp_path / "in.csv"
+    p.write_text(HEADER + body, encoding="utf-8")
+    return p
+
+
+def _json(tmp_path, obj):
+    p = tmp_path / "in.json"
+    p.write_text(obj if isinstance(obj, str) else json.dumps(obj), encoding="utf-8")
+    return p
+
+
+def _run(monkeypatch, capsys, *argv):
+    monkeypatch.setattr("sys.argv", ["kakeibo", *map(str, argv)])
+    try:
+        main()
+        code = 0
+    except SystemExit as e:
+        code = e.code
+    cap = capsys.readouterr()
+    return code, cap.out, cap.err
+
+
+def _errors(path):
+    with pytest.raises(JsonError) as ei:
+        load_json(path)
+    return ei.value.errors
+
+
+# --- export / round trip -------------------------------------------------
+
+
+def test_export_writes_all_fields(tmp_path):
+    out = tmp_path / "out.json"
+    export_json([Expense(date(2026, 11, 1), "食費", 1200, "昼食")], out)
+    text = out.read_text(encoding="utf-8")
+    assert "食費" in text  # not \u-escaped
+    assert json.loads(text) == {
+        "expenses": [
+            {"date": "2026-11-01", "category": "食費", "amount": 1200, "memo": "昼食"}
+        ]
+    }
+
+
+def test_round_trip_preserves_rows(tmp_path):
+    rows = load_csv(_csv(tmp_path))
+    out = tmp_path / "out.json"
+    export_json(rows, out)
+    assert load_json(out) == rows
+
+
+def test_export_unwritable_path(tmp_path):
+    with pytest.raises(JsonError) as ei:
+        export_json([], tmp_path / "no-such-dir" / "out.json")
+    assert "書き込めません" in ei.value.errors[0][1]
+
+
+def test_cli_export_then_import_gives_same_output(tmp_path, monkeypatch, capsys):
+    out_json = tmp_path / "out.json"
+    for extra in ([], ["--report"], ["--total", "--format", "csv"]):
+        code, from_csv, err = _run(
+            monkeypatch, capsys, _csv(tmp_path), "--export", out_json, *extra
+        )
+        assert (code, err) == (0, "")
+        code, from_json, err = _run(monkeypatch, capsys, "--import", out_json, *extra)
+        assert (code, err) == (0, "")
+        assert from_json == from_csv
+
+
+def test_cli_export_ignores_memo_filter(tmp_path, monkeypatch, capsys):
+    out_json = tmp_path / "out.json"
+    code, out, _ = _run(
+        monkeypatch, capsys, _csv(tmp_path), "--memo", "coffee", "--export", out_json
+    )
+    assert code == 0
+    assert out == "food\t800\n"
+    assert len(load_json(out_json)) == 4
+
+
+def test_cli_import_with_budget(tmp_path, monkeypatch, capsys):
+    out_json = tmp_path / "out.json"
+    export_json(load_csv(_csv(tmp_path)), out_json)
+    b = tmp_path / "b.json"
+    b.write_text(json.dumps({"default": {"food": 1500}}), encoding="utf-8")
+    code, _, err = _run(monkeypatch, capsys, "--import", out_json, "--budget", b)
+    assert code == 0
+    assert "2026-11 food 500円超過" in err
+
+
+def test_cli_export_failure_exits_1_without_output(tmp_path, monkeypatch, capsys):
+    code, out, err = _run(
+        monkeypatch, capsys, _csv(tmp_path), "--export", tmp_path / "nope" / "o.json"
+    )
+    assert code == 1
+    assert out == ""
+    assert "書き込めません" in err
+
+
+def test_cli_bad_csv_does_not_export(tmp_path, monkeypatch, capsys):
+    out_json = tmp_path / "out.json"
+    code, _, _ = _run(
+        monkeypatch, capsys, _csv(tmp_path, "bad,food,1,\n"), "--export", out_json
+    )
+    assert code == 1
+    assert not out_json.exists()
+
+
+# --- import: argument handling --------------------------------------------
+
+
+@pytest.mark.parametrize("both", [True, False])
+def test_cli_requires_exactly_one_input(tmp_path, monkeypatch, capsys, both):
+    argv = (
+        [_csv(tmp_path), "--import", _json(tmp_path, {"expenses": []})] if both else []
+    )
+    code, out, err = _run(monkeypatch, capsys, *argv)
+    assert code == 2
+    assert out == ""
+    assert "どちらか一方" in err
+
+
+def test_import_memo_optional_and_null(tmp_path):
+    p = _json(
+        tmp_path,
+        {
+            "expenses": [
+                {"date": "2026-11-01", "category": " food ", "amount": 100},
+                {"date": "2026-11-02", "category": "food", "amount": 50, "memo": None},
+            ]
+        },
+    )
+    assert load_json(p) == [
+        Expense(date(2026, 11, 1), "food", 100),
+        Expense(date(2026, 11, 2), "food", 50),
+    ]
+
+
+# --- import: error reporting ----------------------------------------------
+
+
+def test_import_syntax_error_reports_line_and_column(tmp_path):
+    p = _json(tmp_path, '{"expenses": [\n  {"date": "2026-11-01",}\n]}')
+    [(where, why)] = _errors(p)
+    assert "2 行" in where
+    assert "列" in where
+    assert "不正な JSON" in why
+
+
+def test_import_missing_file(tmp_path):
+    [(where, why)] = _errors(tmp_path / "missing.json")
+    assert where.endswith("missing.json")
+    assert "読めません" in why
+
+
+def test_import_not_utf8(tmp_path):
+    p = tmp_path / "in.json"
+    p.write_bytes(b'{"expenses": ["\xff"]}')
+    [(_, why)] = _errors(p)
+    assert "UTF-8" in why
+
+
+@pytest.mark.parametrize(
+    ("obj", "where", "fragment"),
+    [
+        ([], "(最上位)", "オブジェクト"),
+        ({}, "expenses", "項目がありません"),
+        ({"expenses": {}}, "expenses", "配列"),
+    ],
+)
+def test_import_bad_structure(tmp_path, obj, where, fragment):
+    [(w, why)] = _errors(_json(tmp_path, obj))
+    assert w == where
+    assert fragment in why
+
+
+def test_import_reports_every_bad_field_with_path(tmp_path):
+    p = _json(
+        tmp_path,
+        {
+            "expenses": [
+                {"date": "2026-11-01", "category": "food", "amount": 100},
+                {"category": "food"},
+                "not an object",
+                {"date": "2026-13-01", "category": 5, "amount": 1.5, "memo": 3},
+                {"date": 20261101, "category": "food", "amount": True},
+                {"date": "2026-11-01", "category": "food", "amount": "100"},
+            ]
+        },
+    )
+    errors = _errors(p)
+    assert [w for w, _ in errors] == [
+        "expenses[1].date",
+        "expenses[1].amount",
+        "expenses[2]",
+        "expenses[3].date",
+        "expenses[3].category",
+        "expenses[3].amount",
+        "expenses[3].memo",
+        "expenses[4].date",
+        "expenses[4].amount",
+        "expenses[5].amount",
+    ]
+    reasons = dict(errors)
+    assert reasons["expenses[1].date"] == "項目がありません"
+    assert "'2026-13-01'" in reasons["expenses[3].date"]
+    assert "1.5" in reasons["expenses[3].amount"]
+
+
+def test_cli_import_errors_to_stderr_exit_1(tmp_path, monkeypatch, capsys):
+    p = _json(tmp_path, {"expenses": [{"date": "2026-11-01", "category": "food"}]})
+    code, out, err = _run(monkeypatch, capsys, "--import", p)
+    assert code == 1
+    assert out == ""
+    assert err == "expenses[0].amount: 項目がありません\n"
+
+
+def test_cli_import_syntax_error_exit_1(tmp_path, monkeypatch, capsys):
+    code, out, err = _run(monkeypatch, capsys, "--import", _json(tmp_path, "{"))
+    assert code == 1
+    assert out == ""
+    assert "不正な JSON" in err
+    assert "Traceback" not in err
