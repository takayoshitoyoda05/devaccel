+class JsonError(ValueError):
+    """Raised when an expenses JSON is unreadable or invalid.
+
+    errors: list of (location, reason). location is a JSON path such as
+    ``expenses[2].amount``, ``line 3 column 5`` for syntax errors, or the file path.
+    """
+
+    def __init__(self, errors: list[tuple[str, str]]) -> None:
+        super().__init__("; ".join(f"{where}: {why}" for where, why in errors))
+        self.errors = errors
+
+
+def expenses_to_json(rows: list[Expense]) -> str:
+    """Serialize rows as ``{"expenses": [...]}`` (readable by load_json)."""
+    data = {
+        "expenses": [
+            {
+                "date": e.day.isoformat(),
+                "category": e.category,
+                "amount": e.amount,
+                "memo": e.memo,
+            }
+            for e in rows
+        ]
+    }
+    return json.dumps(data, ensure_ascii=False, indent=2) + "\n"
+
+
+def export_json(rows: list[Expense], path: Path) -> None:
+    try:
+        path.write_text(expenses_to_json(rows), encoding="utf-8")
+    except OSError as e:
+        raise JsonError([(str(path), f"書き込めません: {e.strerror}")]) from None
+
+
+def _parse_record(
+    obj: object, where: str
+) -> tuple[Expense | None, list[tuple[str, str]]]:
+    """Validate one JSON record; returns (expense, []) or (None, errors)."""
+    if not isinstance(obj, dict):
+        return None, [(where, "オブジェクトである必要があります")]
+    errors: list[tuple[str, str]] = []
+
+    def bad(key: str, reason: str) -> None:
+        errors.append((f"{where}.{key}", reason))
+
+    day: date | None = None
+    category: str | None = None
+    amount: int | None = None
+    memo = ""
+    for key in ("date", "category", "amount"):
+        if key not in obj:
+            bad(key, "項目がありません")
+    if "date" in obj:
+        v = obj["date"]
+        if not isinstance(v, str):
+            bad("date", f"日付は文字列(YYYY-MM-DD)である必要があります: {v!r}")
+        else:
+            try:
+                day = date.fromisoformat(v)
+            except ValueError:
+                bad("date", f"日付が不正です: {v!r}")
+    if "category" in obj:
+        v = obj["category"]
+        if not isinstance(v, str):
+            bad("category", f"カテゴリは文字列である必要があります: {v!r}")
+        else:
+            category = v.strip()
+    if "amount" in obj:
+        v = obj["amount"]
+        if isinstance(v, bool) or not isinstance(v, int):
+            bad("amount", f"金額が整数ではありません: {v!r}")
+        else:
+            amount = v
+    if obj.get("memo") is not None:
+        v = obj["memo"]
+        if not isinstance(v, str):
+            bad("memo", f"メモは文字列である必要があります: {v!r}")
+        else:
+            memo = v
+    if errors or day is None or category is None or amount is None:
+        return None, errors
+    return Expense(day=day, category=category, amount=amount, memo=memo), []
+
+
+def load_json(path: Path) -> list[Expense]:
+    """Load ``{"expenses": [{"date", "category", "amount", "memo"?}, ...]}``.
+
+    All invalid records are reported at once via JsonError.
+    """
+    try:
+        text = path.read_text(encoding="utf-8")
+    except OSError as e:
+        raise JsonError([(str(path), f"読めません: {e.strerror}")]) from None
+    except UnicodeDecodeError:
+        raise JsonError([(str(path), "UTF-8 として読めません")]) from None
+    try:
+        data = json.loads(text)
+    except json.JSONDecodeError as e:
+        raise JsonError(
+            [(f"{path}: {e.lineno} 行 {e.colno} 列", f"不正な JSON です: {e.msg}")]
+        ) from None
+    if not isinstance(data, dict):
+        raise JsonError(
+            [("(最上位)", 'オブジェクト {"expenses": [...]} である必要があります')]
+        )
+    if "expenses" not in data:
+        raise JsonError([("expenses", "項目がありません")])
+    records = data["expenses"]
+    if not isinstance(records, list):
+        raise JsonError([("expenses", "配列である必要があります")])
+    rows: list[Expense] = []
+    errors: list[tuple[str, str]] = []
+    for i, obj in enumerate(records):
+        expense, errs = _parse_record(obj, f"expenses[{i}]")
+        if expense is not None:
+            rows.append(expense)
+        errors.extend(errs)
+    if errors:
+        raise JsonError(errors)
+    return rows
+
