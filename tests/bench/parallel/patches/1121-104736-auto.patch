index 0000000..07b58a9
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,109 @@
+"""Detect recurring expenses (定期支出) from Expense rows."""
+
+from __future__ import annotations
+
+import calendar
+import math
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+from statistics import median_low
+
+from kakeibo.core import Expense
+
+# 末尾の番号: "#12" / "No.3" / " 3" (前に空白が要るもの)
+_TRAILING_NUMBER = re.compile(r"(?:\s*#\s*\d+|\s+no\.?\s*\d+|\s+\d+)$")
+_SPACES = re.compile(r"\s+")
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str  # 系列の最後の行の原文
+    amount: int  # 系列の金額の中央値(偶数個なら下側)
+    months: list[str]  # "YYYY-MM" 昇順
+    day: int  # 系列の日の下側中央値
+    next_date: date
+
+
+def _normalize_memo(memo: str) -> str:
+    text = _SPACES.sub(" ", unicodedata.normalize("NFKC", memo).lower()).strip()
+    return _TRAILING_NUMBER.sub("", text).strip()
+
+
+def _check_args(min_count: object, tolerance: object) -> None:
+    if isinstance(min_count, bool) or not isinstance(min_count, int):
+        raise TypeError("min_count は int である必要があります")
+    if min_count < 2:
+        raise ValueError("min_count は 2 以上である必要があります")
+    if isinstance(tolerance, bool) or not isinstance(tolerance, (int, float)):
+        raise TypeError("tolerance は int か float である必要があります")
+    if math.isnan(tolerance) or not 0 <= tolerance < 1:
+        raise ValueError("tolerance は 0 以上 1 未満である必要があります")
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month - 1
+
+
+def _ym(d: date) -> str:
+    return f"{d.year:04d}-{d.month:02d}"
+
+
+def _next_date(last: date, day: int) -> date:
+    year = last.year + last.month // 12
+    month = last.month % 12 + 1
+    last_day = calendar.monthrange(year, month)[1]
+    return date(year, month, min(day, last_day))
+
+
+def _series(items: list[Expense], tolerance: float) -> list[Expense]:
+    """items は 1 グループ(カテゴリ+正規化メモ)で月は重複しない。直近の連続した系列を返す。"""
+    ordered = sorted(items, key=lambda e: e.day)
+    base = median_low([e.amount for e in ordered])
+    run: list[Expense] = []
+    for e in ordered:
+        if abs(e.amount - base) > tolerance * base:
+            run = []  # 金額が外れた月は系列を切る
+            continue
+        if run and _month_index(e.day) != _month_index(run[-1].day) + 1:
+            run = []  # 欠けた月で切る(古い側は捨てる)
+        run.append(e)
+    return run
+
+
+def find_recurring(
+    rows: list[Expense], *, min_count: int = 3, tolerance: float = 0.1
+) -> list[Recurring]:
+    _check_args(min_count, tolerance)
+
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        if e.amount <= 0:
+            continue
+        groups.setdefault((e.category, _normalize_memo(e.memo)), []).append(e)
+
+    found: list[Recurring] = []
+    for (category, _), items in groups.items():
+        months = [_month_index(e.day) for e in items]
+        if len(set(months)) != len(months):
+            continue  # 同じ月に 2 件以上あるグループは定期としない
+        run = _series(items, tolerance)
+        if len(run) < min_count:
+            continue
+        last = run[-1]
+        day = median_low([e.day.day for e in run])
+        found.append(
+            Recurring(
+                category=category,
+                memo=last.memo,
+                amount=median_low([e.amount for e in run]),
+                months=[_ym(e.day) for e in run],
+                day=day,
+                next_date=_next_date(last.day, day),
+            )
+        )
+
+    found.sort(key=lambda r: (-r.amount, r.category, r.memo))
+    return found
