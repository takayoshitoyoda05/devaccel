@@ -0,0 +1,214 @@
+"""Bank / card CSV import. Bad cells are reported per row; good rows are kept."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import CsvError, Expense
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str
+    value: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+
+
+_DATE_ALIASES = ("date", "日付", "利用日", "ご利用日", "取引日", "年月日")
+_AMOUNT_ALIASES = ("amount", "金額", "利用金額", "ご利用金額", "支払金額")
+_WITHDRAW_ALIASES = ("出金額", "出金", "支払", "お支払金額")
+_DEPOSIT_ALIASES = ("入金額", "入金", "預入")
+_MEMO_ALIASES = (
+    "memo",
+    "description",
+    "摘要",
+    "メモ",
+    "利用店名",
+    "ご利用店名",
+    "内容",
+)
+_CATEGORY_ALIASES = ("category", "カテゴリ", "区分")
+_UNCATEGORIZED = "未分類"
+_WHOLE_ROW = "(行全体)"
+
+_ISO_RE = re.compile(
+    r"([0-9]{4})([-/.])([0-9]{1,2})\2([0-9]{1,2})(?:(?:\s+|T)[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?)?"
+)
+_JP_RE = re.compile(
+    r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日(?:\s+[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?)?"
+)
+_COMPACT_RE = re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})")
+_YEN_MARK_RE = re.compile(r"¥|円|JPY", re.IGNORECASE)
+_SPACE_COMMA_RE = re.compile(r"[\s,]")
+
+
+def _find(header: list[str], aliases: tuple[str, ...]) -> int | None:
+    for i, name in enumerate(header):
+        if unicodedata.normalize("NFKC", name).strip().lower() in aliases:
+            return i
+    return None
+
+
+def _cell(row: list[str], i: int | None) -> str:
+    return "" if i is None else row[i]
+
+
+def _parse_date(raw: str) -> date | str:
+    """Return the date, or the Japanese reason it is invalid."""
+    s = unicodedata.normalize("NFKC", raw).strip()
+    if not s:
+        return "日付が空です"
+    m = _ISO_RE.fullmatch(s)
+    if m is not None:
+        year, month, day = m.group(1), m.group(3), m.group(4)
+    else:
+        m = _JP_RE.fullmatch(s) or _COMPACT_RE.fullmatch(s)
+        if m is None:
+            return "日付の形式が不正です"
+        year, month, day = m.group(1), m.group(2), m.group(3)
+    try:
+        return date(int(year), int(month), int(day))
+    except ValueError:
+        return "存在しない日付です"
+
+
+def _parse_yen(raw: str) -> int | str:
+    """Return the signed yen amount, or the Japanese reason it is invalid."""
+    s = _YEN_MARK_RE.sub("", unicodedata.normalize("NFKC", raw))
+    s = _SPACE_COMMA_RE.sub("", s)
+    if not s:
+        return "金額が空です"
+    negative = False
+    if s[0] in "-−△▲":
+        negative, s = True, s[1:]
+    elif s.startswith("(") and s.endswith(")"):
+        negative, s = True, s[1:-1]
+    elif s.endswith("-"):
+        negative, s = True, s[:-1]
+    if not re.fullmatch(r"[0-9]+", s):
+        return "金額が整数として読めません"
+    value = int(s)
+    return -value if negative else value
+
+
+def parse_bank_csv(text: str) -> ImportResult:
+    text = text.removeprefix("﻿")
+    if not text.strip():
+        raise CsvError([(1, "入力が空です")])
+
+    first_line = re.split(r"\r\n|\r|\n", text, maxsplit=1)[0]
+    delim = "\t" if first_line.count("\t") > first_line.count(",") else ","
+
+    # (start line, cells) for each non-blank record; start line is 1-based.
+    records: list[tuple[int, list[str]]] = []
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delim)
+    prev_end = 0
+    for row in reader:
+        start = prev_end + 1
+        prev_end = reader.line_num
+        if not row or (len(row) == 1 and not row[0].strip()):
+            continue
+        records.append((start, row))
+    if not records:
+        raise CsvError([(1, "入力が空です")])
+
+    _, header = records[0]
+    date_i = _find(header, _DATE_ALIASES)
+    if date_i is None:
+        raise CsvError([(1, "日付列がありません")])
+    amount_i = _find(header, _AMOUNT_ALIASES)
+    withdraw_i = _find(header, _WITHDRAW_ALIASES)
+    deposit_i = _find(header, _DEPOSIT_ALIASES)
+    if amount_i is None and withdraw_i is None and deposit_i is None:
+        raise CsvError([(1, "金額列(金額・出金額・入金額)がありません")])
+    memo_i = _find(header, _MEMO_ALIASES)
+    category_i = _find(header, _CATEGORY_ALIASES)
+
+    body = records[1:]
+    if not body:
+        raise CsvError([(1, "データ行がありません")])
+
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    for line, row in body:
+        if len(row) != len(header):
+            reason = f"列数が違います(ヘッダー {len(header)} 列、この行 {len(row)} 列)"
+            errors.append(RowError(line, _WHOLE_ROW, delim.join(row), reason))
+            continue
+
+        row_errors: list[RowError] = []
+        day: date | None = None
+        yen: int | None = None
+
+        parsed_day = _parse_date(row[date_i])
+        if isinstance(parsed_day, str):
+            row_errors.append(RowError(line, header[date_i], row[date_i], parsed_day))
+        else:
+            day = parsed_day
+
+        if amount_i is not None:
+            parsed_yen = _parse_yen(row[amount_i])
+            if isinstance(parsed_yen, str):
+                row_errors.append(
+                    RowError(line, header[amount_i], row[amount_i], parsed_yen)
+                )
+            else:
+                yen = parsed_yen
+        else:
+            withdraw = _cell(row, withdraw_i)
+            deposit = _cell(row, deposit_i)
+            if withdraw.strip() and deposit.strip():
+                for i, value in ((withdraw_i, withdraw), (deposit_i, deposit)):
+                    if i is not None:
+                        row_errors.append(
+                            RowError(
+                                line, header[i], value, "出金と入金の両方に値があります"
+                            )
+                        )
+            elif withdraw.strip():
+                assert withdraw_i is not None
+                parsed_yen = _parse_yen(withdraw)
+                if isinstance(parsed_yen, str):
+                    row_errors.append(
+                        RowError(line, header[withdraw_i], withdraw, parsed_yen)
+                    )
+                else:
+                    yen = parsed_yen
+            elif deposit.strip():
+                # 入金だけの行は出金ではないので取り込まない。値の形式だけ確かめる。
+                assert deposit_i is not None
+                parsed_deposit = _parse_yen(deposit)
+                if isinstance(parsed_deposit, str):
+                    row_errors.append(
+                        RowError(line, header[deposit_i], deposit, parsed_deposit)
+                    )
+            else:
+                col_i = withdraw_i if withdraw_i is not None else deposit_i
+                assert col_i is not None
+                row_errors.append(RowError(line, header[col_i], "", "金額が空です"))
+
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        if day is None or yen is None:
+            continue
+        category = (
+            _cell(row, category_i).strip() if category_i is not None else _UNCATEGORIZED
+        )
+        expenses.append(
+            Expense(day=day, category=category, amount=yen, memo=_cell(row, memo_i))
+        )
+
+    return ImportResult(expenses=expenses, errors=errors)
diff --git a/src/kakeibo/monthly_diff.py b/src/kakeibo/monthly_diff.py
