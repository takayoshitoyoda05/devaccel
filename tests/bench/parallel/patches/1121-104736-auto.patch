index 0000000..9f08ac7
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,137 @@
+from __future__ import annotations
+
+import math
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring
+
+
+def _e(d: date, category: str, amount: int, memo: str) -> Expense:
+    return Expense(day=d, category=category, amount=amount, memo=memo)
+
+
+@pytest.mark.parametrize(
+    "rows, expected",
+    [
+        pytest.param(
+            [
+                _e(date(2026, 1, 31), "住居", 80000, "家賃"),
+                _e(date(2026, 2, 28), "住居", 80000, "家賃"),
+                _e(date(2026, 3, 31), "住居", 80000, "家賃"),
+            ],
+            [
+                Recurring(
+                    category="住居",
+                    memo="家賃",
+                    amount=80000,
+                    months=["2026-01", "2026-02", "2026-03"],
+                    day=31,
+                    next_date=date(2026, 4, 30),
+                )
+            ],
+            id="E2-1",
+        ),
+        pytest.param(
+            [
+                _e(date(2026, 1, 10), "娯楽", 1490, "Netflix"),
+                _e(date(2026, 2, 10), "娯楽", 1490, "Netflix"),
+                _e(date(2026, 3, 10), "娯楽", 1490, "Netflix"),
+                _e(date(2026, 5, 10), "娯楽", 1490, "Netflix"),
+            ],
+            [],
+            id="E2-2",
+        ),
+        pytest.param(
+            [
+                _e(date(2026, 1, 15), "通信", 980, "Spotify #1"),
+                _e(date(2026, 2, 15), "通信", 980, "spotify #2"),
+                _e(date(2026, 3, 15), "通信", 980, "SPOTIFY 3"),
+            ],
+            [
+                Recurring(
+                    category="通信",
+                    memo="SPOTIFY 3",
+                    amount=980,
+                    months=["2026-01", "2026-02", "2026-03"],
+                    day=15,
+                    next_date=date(2026, 4, 15),
+                )
+            ],
+            id="E2-3",
+        ),
+    ],
+)
+def test_examples(rows: list[Expense], expected: list[Recurring]) -> None:
+    assert find_recurring(rows) == expected
+
+
+def test_output_sorted_by_amount_desc_then_category_then_memo() -> None:
+    rows = []
+    for m in (1, 2, 3):
+        d = date(2026, m, 5)
+        rows += [
+            _e(d, "b", 500, "x"),
+            _e(d, "a", 500, "y"),
+            _e(d, "z", 900, "w"),
+        ]
+    got = [(r.category, r.amount) for r in find_recurring(rows)]
+    assert got == [("z", 900), ("a", 500), ("b", 500)]
+
+
+def test_same_month_twice_excludes_group() -> None:
+    rows = [
+        _e(date(2026, 1, 5), "食費", 300, "パン"),
+        _e(date(2026, 1, 20), "食費", 300, "パン"),
+        _e(date(2026, 2, 5), "食費", 300, "パン"),
+        _e(date(2026, 3, 5), "食費", 300, "パン"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_amount_outside_tolerance_breaks_series() -> None:
+    rows = [
+        _e(date(2026, 1, 5), "食費", 1000, "水"),
+        _e(date(2026, 2, 5), "食費", 1000, "水"),
+        _e(date(2026, 3, 5), "食費", 1200, "水"),
+        _e(date(2026, 4, 5), "食費", 1200, "水"),
+        _e(date(2026, 5, 5), "食費", 1200, "水"),
+    ]
+    # 系列の中央値は 1200 側で、1 月・2 月は切れる。直近の 3 か月が系列になる。
+    result = find_recurring(rows)
+    assert [r.months for r in result] == [["2026-03", "2026-04", "2026-05"]]
+    assert result[0].amount == 1200
+
+
+def test_nonpositive_amounts_are_ignored() -> None:
+    rows = [
+        _e(date(2026, 1, 5), "食費", 0, "返金"),
+        _e(date(2026, 2, 5), "食費", -500, "返金"),
+        _e(date(2026, 3, 5), "食費", 500, "返金"),
+    ]
+    assert find_recurring(rows) == []
+
+
+@pytest.mark.parametrize(
+    "kwargs, exc, word",
+    [
+        pytest.param({"min_count": 1}, ValueError, "min_count", id="min_count-small"),
+        pytest.param({"min_count": True}, TypeError, "min_count", id="min_count-bool"),
+        pytest.param({"tolerance": 1.0}, ValueError, "tolerance", id="tolerance-one"),
+        pytest.param(
+            {"tolerance": math.nan}, ValueError, "tolerance", id="tolerance-nan"
+        ),
+        pytest.param({"tolerance": "0.1"}, TypeError, "tolerance", id="tolerance-str"),
+    ],
+)
+def test_invalid_arguments(
+    kwargs: dict[str, object], exc: type[Exception], word: str
+) -> None:
+    with pytest.raises(exc, match=word):
+        find_recurring([], **kwargs)  # type: ignore[arg-type]
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
