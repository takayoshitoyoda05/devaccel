+from __future__ import annotations
+
+import pytest
+
+from kakeibo.monthly_diff import (
+    CategoryDiff,
+    MonthDiff,
+    format_report,
+    month_over_month,
+)
+
+
+@pytest.mark.parametrize(
+    ("totals", "expected"),
+    [
+        pytest.param(
+            {"2026-01": {"食費": 100}, "2026-03": {"食費": 150}},
+            [
+                MonthDiff(
+                    month="2026-02",
+                    prev_month="2026-01",
+                    rows=[CategoryDiff("食費", 100, 0, -100, -100.0, "gone")],
+                ),
+                MonthDiff(
+                    month="2026-03",
+                    prev_month="2026-02",
+                    rows=[CategoryDiff("食費", 0, 150, 150, None, "new")],
+                ),
+            ],
+            id="E4-1",
+        ),
+        pytest.param(
+            {"2026-01": {"食費": 1000}, "2026-02": {"食費": 1500}},
+            [
+                MonthDiff(
+                    month="2026-02",
+                    prev_month="2026-01",
+                    rows=[CategoryDiff("食費", 1000, 1500, 500, 50.0, "up")],
+                ),
+            ],
+            id="E4-2",
+        ),
+        pytest.param({"2026-13": {}}, ValueError, id="E4-3"),
+    ],
+)
+def test_spec_table(totals: dict[str, dict[str, int]], expected: object) -> None:
+    if expected is ValueError:
+        with pytest.raises(ValueError):
+            month_over_month(totals)
+    else:
+        assert month_over_month(totals) == expected
+
+
+def test_empty_and_single_month_give_empty_list() -> None:
+    assert month_over_month({}) == []
+    assert month_over_month({"2026-01": {"食費": 100}}) == []
+
+
+def test_year_boundary_is_ascending_and_fills_gap() -> None:
+    diffs = month_over_month({"2025-12": {"食費": 10}, "2026-01": {"食費": 10}})
+    assert [d.month for d in diffs] == ["2026-01"]
+    assert diffs[0].prev_month == "2025-12"
+    assert diffs[0].rows == [CategoryDiff("食費", 10, 10, 0, 0.0, "same")]
+
+
+def test_rows_sorted_by_abs_delta_then_category() -> None:
+    diffs = month_over_month(
+        {
+            "2026-01": {"住居": 100, "交通": 100, "食費": 100},
+            "2026-02": {"住居": 90, "交通": 110, "食費": 100},
+        }
+    )
+    assert [r.category for r in diffs[0].rows] == ["交通", "住居", "食費"]
+
+
+def test_zero_on_both_sides_is_omitted() -> None:
+    diffs = month_over_month(
+        {"2026-01": {"食費": 0}, "2026-02": {"食費": 0, "娯楽": 5}}
+    )
+    assert [r.category for r in diffs[0].rows] == ["娯楽"]
+
+
+def test_invalid_month_key_is_rejected() -> None:
+    with pytest.raises(ValueError, match="2026-00"):
+        month_over_month({"2026-00": {}, "2026-01": {}})
+
+
+def test_format_report_empty_is_empty_string() -> None:
+    assert format_report([]) == ""
+
+
+def test_format_report_lines() -> None:
+    diffs = month_over_month(
+        {
+            "2026-01": {"食費": 1000, "娯楽": 300},
+            "2026-02": {"食費": 1500, "娯楽": 0, "住居": 0},
+        }
+    )
+    assert format_report(diffs) == (
+        "2026-02(前月 2026-01 比)\n"
+        "  食費: 1000 → 1500 (+500, +50.0%)\n"
+        "  娯楽: 300 → 0 (-300, 消滅)"
+    )
