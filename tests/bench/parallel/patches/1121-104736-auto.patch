new file mode 100644
index 0000000..cb22177
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,123 @@
+"""Condition search over Expense rows. Pure: no I/O.
+
+A condition is a dict. Several keys in one dict are ANDed; ``{}`` is true.
+Leaf keys: category, amount_min, amount_max, memo_contains, date_from, date_to.
+Combinators: and (list), or (list), not (one dict).
+"""
+
+from __future__ import annotations
+
+import unicodedata
+from datetime import date, datetime
+from typing import cast
+
+from kakeibo.core import Expense
+
+_LEAF_STR = ("category", "memo_contains")
+_LEAF_INT = ("amount_min", "amount_max")
+_LEAF_DATE = ("date_from", "date_to")
+_LIST_KEYS = ("and", "or")
+_KNOWN = frozenset({"and", "or", "not", *_LEAF_STR, *_LEAF_INT, *_LEAF_DATE})
+
+
+def _fold(s: str) -> str:
+    """NFKC + case-insensitive form used for string comparison."""
+    return unicodedata.normalize("NFKC", s).casefold()
+
+
+def _fold_compact(s: str) -> str:
+    """_fold, then drop all whitespace (used for category)."""
+    return "".join(_fold(s).split())
+
+
+def _check_cond(cond: object) -> None:
+    """Validate a top-level condition. A non-dict is a type error."""
+    if not isinstance(cond, dict):
+        raise TypeError(f"条件は dict である必要があります: {cond!r}")
+    _check_items(cast(dict[str, object], cond))
+
+
+def _check_node(node: object) -> None:
+    """Validate a nested condition. A non-dict is a structural error."""
+    if not isinstance(node, dict):
+        # Nested structure errors are ValueError by spec (R3), not TypeError.
+        raise ValueError(f"条件は dict である必要があります: {node!r}")  # noqa: TRY004
+    _check_items(cast(dict[str, object], node))
+
+
+def _check_items(cond: dict[str, object]) -> None:
+    for key, value in cond.items():
+        if key not in _KNOWN:
+            raise ValueError(f"未知の条件キーです: {key!r}")
+        if key in _LIST_KEYS:
+            if not isinstance(value, list):
+                raise ValueError(f"{key} はリストである必要があります")
+            for sub in cast(list[object], value):
+                _check_node(sub)
+        elif key == "not":
+            _check_node(value)
+        else:
+            _check_leaf(key, value)
+    lo = cond.get("amount_min")
+    hi = cond.get("amount_max")
+    if isinstance(lo, int) and isinstance(hi, int) and lo > hi:
+        raise ValueError(f"amount_min ({lo}) > amount_max ({hi})")
+    d_from = cond.get("date_from")
+    d_to = cond.get("date_to")
+    if isinstance(d_from, date) and isinstance(d_to, date) and d_from > d_to:
+        raise ValueError(f"date_from ({d_from}) > date_to ({d_to})")
+
+
+def _check_leaf(key: str, value: object) -> None:
+    if key in _LEAF_STR:
+        if not isinstance(value, str):
+            raise TypeError(f"{key} は str である必要があります: {value!r}")
+    elif key in _LEAF_INT:
+        if isinstance(value, bool) or not isinstance(value, int):
+            raise TypeError(f"{key} は int である必要があります: {value!r}")
+    elif not isinstance(value, date) or isinstance(value, datetime):
+        raise TypeError(f"{key} は date である必要があります: {value!r}")
+
+
+def _eval_leaf(e: Expense, key: str, value: object) -> bool:
+    if key == "category":
+        return _fold_compact(e.category) == _fold_compact(cast(str, value))
+    if key == "memo_contains":
+        return _fold(cast(str, value)) in _fold(e.memo)
+    if key == "amount_min":
+        return e.amount >= cast(int, value)
+    if key == "amount_max":
+        return e.amount <= cast(int, value)
+    if key == "date_from":
+        return e.day >= cast(date, value)
+    return e.day <= cast(date, value)  # date_to
+
+
+def _eval(e: Expense, cond: dict[str, object]) -> bool:
+    for key, value in cond.items():
+        if key == "and":
+            subs = cast(list[object], value)
+            if not all(_eval(e, cast(dict[str, object], c)) for c in subs):
+                return False
+        elif key == "or":
+            subs = cast(list[object], value)
+            if not any(_eval(e, cast(dict[str, object], c)) for c in subs):
+                return False
+        elif key == "not":
+            if _eval(e, cast(dict[str, object], value)):
+                return False
+        elif not _eval_leaf(e, key, value):
+            return False
+    return True
+
+
+def matches(e: Expense, cond: dict[str, object]) -> bool:
+    """True if ``e`` satisfies ``cond``. The condition is validated on every call."""
+    _check_cond(cond)
+    return _eval(e, cond)
+
+
+def search(rows: list[Expense], cond: dict[str, object]) -> list[Expense]:
+    """Rows satisfying ``cond``, in their original order. Validates even when rows is empty."""
+    _check_cond(cond)
+    return [e for e in rows if _eval(e, cond)]
diff --git a/tests/test_bank_import.py b/tests/test_bank_import.py
