+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import RowError, parse_bank_csv
+from kakeibo.core import CsvError, Expense
+
+
+def test_e1_1_alias_headers_and_yen_amount_keep_memo_raw() -> None:
+    """E1-1: 利用日/利用店名/利用金額 の別名、"1,200円"、メモは原文のまま。"""
+    text = '利用日,利用店名,利用金額\n2026/1/5,ＡＢＣ,"1,200円"\n'
+    result = parse_bank_csv(text)
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 1200, "ＡＢＣ")]
+    assert result.errors == []
+
+
+def test_e1_2_deposit_only_row_skipped_and_withdrawal_kept() -> None:
+    """E1-2: 入金だけの行は取り込まず、出金の行は取り込む(誤りではない)。"""
+    text = "日付,出金額,入金額\n2026-01-05,,5000\n2026-01-06,300,\n"
+    result = parse_bank_csv(text)
+    assert result.expenses == [Expense(date(2026, 1, 6), "未分類", 300, "")]
+    assert result.errors == []
+
+
+def test_e1_3_bad_date_and_amount_both_reported_on_same_line() -> None:
+    """E1-3: 存在しない日付と整数でない金額は、列ごとに 2 件の誤り。"""
+    result = parse_bank_csv("date,amount\n2026-02-30,abc\n")
+    assert result.expenses == []
+    assert [(e.line, e.column) for e in result.errors] == [(2, "date"), (2, "amount")]
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        ("2026-01-05", date(2026, 1, 5)),
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026.1.5", date(2026, 1, 5)),
+        ("20260105", date(2026, 1, 5)),
+        ("2026年1月5日", date(2026, 1, 5)),
+        ("2026-01-05 12:34", date(2026, 1, 5)),
+        ("2026-01-05T12:34:56", date(2026, 1, 5)),
+        ("２０２６－０１－０５", date(2026, 1, 5)),
+    ],
+)
+def test_date_forms_accepted(raw: str, expected: date) -> None:
+    result = parse_bank_csv(f"date,amount\n{raw},100\n")
+    assert result.expenses == [Expense(expected, "未分類", 100, "")]
+
+
+@pytest.mark.parametrize(
+    ("raw", "reason_part"),
+    [
+        ("2026-02-30", "存在しない"),
+        ("R8.1.5", "形式"),
+        ("", "空"),
+    ],
+)
+def test_invalid_date_reported_on_date_column(raw: str, reason_part: str) -> None:
+    result = parse_bank_csv(f"date,amount\n{raw},100\n")
+    assert result.expenses == []
+    assert len(result.errors) == 1
+    err = result.errors[0]
+    assert (err.line, err.column, err.value) == (2, "date", raw)
+    assert reason_part in err.reason
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        ("¥1,200", 1200),
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("0", 0),
+    ],
+)
+def test_amount_forms_accepted(raw: str, expected: int) -> None:
+    result = parse_bank_csv(f'date,amount\n2026-01-05,"{raw}"\n')
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", expected, "")]
+
+
+@pytest.mark.parametrize("raw", ["12.5", "abc", ""])
+def test_invalid_amount_reported_on_amount_column(raw: str) -> None:
+    result = parse_bank_csv(f"date,amount\n2026-01-05,{raw}\n")
+    assert result.expenses == []
+    assert [(e.line, e.column, e.value) for e in result.errors] == [(2, "amount", raw)]
+
+
+def test_tab_delimiter_and_bom_are_detected() -> None:
+    text = "﻿日付\t摘要\t金額\r\n2026-01-05\tカフェ\t450\r\n"
+    result = parse_bank_csv(text)
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 450, "カフェ")]
+
+
+def test_quoted_newline_counts_one_record_and_blank_lines_skipped() -> None:
+    text = 'date,memo,amount\n\n2026-01-05,"a\nb",100\r2026-01-06,x,abc\n'
+    result = parse_bank_csv(text)
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "a\nb")]
+    assert [(e.line, e.column, e.value) for e in result.errors] == [
+        (5, "amount", "abc")
+    ]
+    assert isinstance(result.errors[0], RowError)
+
+
+def test_wrong_column_count_reported_as_whole_row() -> None:
+    result = parse_bank_csv("date,amount\n2026-01-05,1,200\n")
+    assert [(e.line, e.column) for e in result.errors] == [(2, "(行全体)")]
+
+
+def test_both_withdrawal_and_deposit_filled_is_error_on_both_columns() -> None:
+    result = parse_bank_csv("date,出金,入金\n2026-01-05,300,300\n")
+    assert [(e.column) for e in result.errors] == ["出金", "入金"]
+    assert result.expenses == []
+
+
+def test_category_column_used_when_present() -> None:
+    result = parse_bank_csv("日付,金額,区分\n2026-01-05,100,食費\n")
+    assert result.expenses == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "  \n\n",
+        "date,amount\n",
+        "amount,memo\n2026-01-05,x\n",
+        "date,memo\n2026-01-05,x\n",
+    ],
+    ids=["empty", "blank", "header-only", "no-date-column", "no-amount-column"],
+)
+def test_header_problems_raise_csv_error(text: str) -> None:
+    with pytest.raises(CsvError):
+        parse_bank_csv(text)
