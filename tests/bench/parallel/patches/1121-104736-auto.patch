+from __future__ import annotations
+
+from datetime import date, datetime
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import matches, search
+
+ROWS = [
+    Expense(date(2024, 1, 5), "食費", 1200, "lunch"),
+    Expense(date(2024, 1, 10), "交通費", 10000, "SUB-1"),
+    Expense(date(2024, 2, 1), "娯楽", 500, ""),
+    Expense(date(2024, 2, 15), "食費", 15000, "dinner"),
+]
+
+
+# E3-1: or of a category and an amount threshold
+def test_E3_1_or_category_or_amount_min() -> None:
+    cond: dict[str, object] = {"or": [{"category": "食費"}, {"amount_min": 10000}]}
+    assert search(ROWS, cond) == [ROWS[0], ROWS[1], ROWS[3]]
+
+
+# E3-2: NFKC-normalised, case-insensitive substring match
+def test_E3_2_memo_contains_is_nfkc_and_case_insensitive() -> None:
+    assert (
+        matches(
+            Expense(date(2024, 1, 1), "食費", 1, "SUB-1"), {"memo_contains": "ｓｕｂ"}
+        )
+        is True
+    )
+
+
+# E3-3: unknown key is reported by name
+def test_E3_3_unknown_key_raises_with_name() -> None:
+    with pytest.raises(ValueError, match="categry"):
+        matches(ROWS[0], {"categry": "食費"})
+
+
+@pytest.mark.parametrize(
+    "cond, expected",
+    [
+        ({}, True),
+        ({"and": []}, True),
+        ({"or": []}, False),
+    ],
+    ids=["empty-dict", "empty-and", "empty-or"],
+)
+def test_empty_conditions(cond: dict[str, object], expected: bool) -> None:
+    assert matches(ROWS[0], cond) is expected
+
+
+def test_ranges_include_both_ends() -> None:
+    assert search(ROWS, {"amount_min": 500, "amount_max": 1200}) == [ROWS[0], ROWS[2]]
+    assert search(
+        ROWS, {"date_from": date(2024, 1, 5), "date_to": date(2024, 1, 10)}
+    ) == [
+        ROWS[0],
+        ROWS[1],
+    ]
+
+
+def test_empty_memo_matches_everything() -> None:
+    assert search(ROWS, {"memo_contains": ""}) == ROWS
+
+
+def test_category_ignores_whitespace_width_and_case() -> None:
+    rows = [Expense(date(2024, 1, 1), "Food", 1, "")]
+    assert search(rows, {"category": " ｆ o o d "}) == rows
+
+
+def test_not_inverts() -> None:
+    assert search(ROWS, {"not": {"category": "食費"}}) == [ROWS[1], ROWS[2]]
+
+
+def test_search_keeps_order_and_does_not_mutate_input() -> None:
+    rows = list(ROWS)
+    result = search(rows, {"category": "食費"})
+    assert result == [ROWS[0], ROWS[3]]
+    assert rows == ROWS
+
+
+@pytest.mark.parametrize(
+    "cond, exc",
+    [
+        ({"amount_min": 5, "amount_max": 1}, ValueError),
+        ({"date_from": date(2024, 2, 1), "date_to": date(2024, 1, 1)}, ValueError),
+        ({"and": {}}, ValueError),
+        ({"not": []}, ValueError),
+        ({"category": 1}, TypeError),
+        ({"amount_min": True}, TypeError),
+        ({"date_from": datetime(2024, 1, 1)}, TypeError),
+    ],
+    ids=[
+        "amount-range",
+        "date-range",
+        "and-not-list",
+        "not-not-dict",
+        "category-type",
+        "bool-amount",
+        "datetime-date",
+    ],
+)
+def test_invalid_conditions_raise(
+    cond: dict[str, object], exc: type[Exception]
+) -> None:
+    with pytest.raises(exc):
+        matches(ROWS[0], cond)
+    with pytest.raises(exc):
+        search([], cond)
