@@ -0,0 +1,100 @@
+"""Month-over-month differences per category."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from itertools import pairwise
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryDiff:
+    category: str
+    prev: int
+    cur: int
+    delta: int
+    pct: float | None
+    status: str  # up / down / new / gone / same
+
+
+@dataclass(frozen=True)
+class MonthDiff:
+    month: str
+    prev_month: str
+    rows: list[CategoryDiff]
+
+
+def _next_month(month: str) -> str:
+    year, mon = int(month[:4]), int(month[5:])
+    if mon == 12:
+        return f"{year + 1:04d}-01"
+    return f"{year:04d}-{mon + 1:02d}"
+
+
+def _category_diff(category: str, prev: int, cur: int) -> CategoryDiff:
+    delta = cur - prev
+    pct = None if prev == 0 else delta / abs(prev) * 100
+    if prev == 0 and cur != 0:
+        status = "new"
+    elif prev != 0 and cur == 0:
+        status = "gone"
+    elif delta > 0:
+        status = "up"
+    elif delta < 0:
+        status = "down"
+    else:
+        status = "same"
+    return CategoryDiff(category, prev, cur, delta, pct, status)
+
+
+def month_over_month(totals: dict[str, dict[str, int]]) -> list[MonthDiff]:
+    """Compare each month with the previous one, filling missing months with zeros."""
+    for key in totals:
+        if not _MONTH_RE.fullmatch(key):
+            raise ValueError(f"月の形式が不正です(YYYY-MM): {key!r}")
+    if len(totals) < 2:
+        return []
+
+    months: list[str] = []
+    month = min(totals)
+    last = max(totals)
+    while True:
+        months.append(month)
+        if month == last:
+            break
+        month = _next_month(month)
+
+    out: list[MonthDiff] = []
+    for prev_month, month in pairwise(months):
+        prev_cats = totals.get(prev_month, {})
+        cur_cats = totals.get(month, {})
+        rows = [
+            _category_diff(cat, prev_cats.get(cat, 0), cur_cats.get(cat, 0))
+            for cat in set(prev_cats) | set(cur_cats)
+            if prev_cats.get(cat, 0) != 0 or cur_cats.get(cat, 0) != 0
+        ]
+        rows.sort(key=lambda r: (-abs(r.delta), r.category))
+        out.append(MonthDiff(month=month, prev_month=prev_month, rows=rows))
+    return out
+
+
+def _format_row(row: CategoryDiff) -> str:
+    if row.status == "gone":
+        rate = "消滅"
+    elif row.status == "same":
+        rate = "変化なし"
+    elif row.pct is None:
+        rate = "新規"
+    else:
+        rate = f"{row.pct:+.1f}%"
+    return f"  {row.category}: {row.prev} → {row.cur} ({row.delta:+d}, {rate})"
+
+
+def format_report(diffs: list[MonthDiff]) -> str:
+    lines: list[str] = []
+    for md in diffs:
+        lines.append(f"{md.month}(前月 {md.prev_month} 比)")
+        lines.extend(_format_row(row) for row in md.rows)
+    return "\n".join(lines)
