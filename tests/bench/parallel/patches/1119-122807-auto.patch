@@ -0,0 +1,166 @@
+"""Import bank / card CSV text into Expense rows (pure; takes text, not a path)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_DATE_ALIASES = ("date", "日付", "利用日", "取引日", "年月日")
+_AMOUNT_ALIASES = ("amount", "金額", "利用金額", "出金額", "支払金額")
+_MEMO_ALIASES = ("memo", "摘要", "メモ", "利用店名", "ご利用店名", "description")
+_CATEGORY_ALIASES = ("category", "カテゴリ", "分類")
+_DEPOSIT_ALIASES = ("入金額", "預入金額", "預入")
+
+_TIME_RE = re.compile(r"\s+[0-9]{1,2}:[0-9]{2}(:[0-9]{2})?$")
+_DATE_RES = (
+    re.compile(r"([0-9]{4})[-/.]([0-9]{1,2})[-/.]([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})"),
+    re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日"),
+)
+_NUM_RE = re.compile(r"[0-9]{1,3}(?:,[0-9]{3})+|[0-9]+")
+_NEG_PREFIXES = ("-", "−", "△", "▲")
+
+
+@dataclass(frozen=True)
+class ImportError_:
+    line: int
+    column: str
+    value: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    rows: list[Expense]
+    errors: list[ImportError_]
+
+
+def _detect_delimiter(text: str) -> str:
+    first = text.split("\n", 1)[0]
+    return "\t" if first.count("\t") > first.count(",") else ","
+
+
+def _records(text: str, delimiter: str) -> list[tuple[int, list[str]]]:
+    """(start line, cells) for each CSV record; line numbers are physical lines."""
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delimiter)
+    out: list[tuple[int, list[str]]] = []
+    prev_end = 0
+    for cells in reader:
+        out.append((prev_end + 1, cells))
+        prev_end = reader.line_num
+    return out
+
+
+def _find(names: list[str], aliases: tuple[str, ...]) -> int | None:
+    for i, name in enumerate(names):
+        if name.strip().lower() in aliases:
+            return i
+    return None
+
+
+def _parse_date(raw: str) -> date | None:
+    s = unicodedata.normalize("NFKC", raw).strip()
+    s = _TIME_RE.sub("", s)
+    for pattern in _DATE_RES:
+        m = pattern.fullmatch(s)
+        if m:
+            try:
+                return date(*(int(g) for g in m.groups()))
+            except ValueError:
+                return None
+    return None
+
+
+def _strip_currency(s: str) -> str:
+    s = s.strip()
+    if s.startswith("¥"):
+        return s[1:].strip()
+    if s[:3].upper() == "JPY":
+        return s[3:].strip()
+    return s
+
+
+def _parse_amount(raw: str) -> int | None:
+    s = unicodedata.normalize("NFKC", raw).strip()
+    negative = False
+    if s.startswith("(") and s.endswith(")"):
+        negative = True
+        s = s[1:-1].strip()
+    s = _strip_currency(s)
+    if s.startswith(_NEG_PREFIXES):
+        negative = True
+        s = s[1:].strip()
+    elif s.endswith("-"):
+        negative = True
+        s = s[:-1].strip()
+    s = _strip_currency(s)
+    if s.endswith("円"):
+        s = s[:-1].strip()
+    if not _NUM_RE.fullmatch(s):
+        return None
+    value = int(s.replace(",", ""))
+    return -value if negative else value
+
+
+def parse_bank_csv(text: str, default_category: str = "未分類") -> ImportResult:
+    text = text.removeprefix("﻿")
+    records = [
+        (line, cells)
+        for line, cells in _records(text, _detect_delimiter(text))
+        if any(c.strip() for c in cells)
+    ]
+    if not records:
+        return ImportResult([], [])
+
+    header_line, header = records[0]
+    names = [h.strip() for h in header]
+    date_i = _find(names, _DATE_ALIASES)
+    amount_i = _find(names, _AMOUNT_ALIASES)
+    memo_i = _find(names, _MEMO_ALIASES)
+    category_i = _find(names, _CATEGORY_ALIASES)
+    deposit_i = _find(names, _DEPOSIT_ALIASES)
+
+    missing: list[ImportError_] = []
+    if date_i is None:
+        missing.append(ImportError_(header_line, "日付", "", "日付列がありません"))
+    if amount_i is None:
+        missing.append(ImportError_(header_line, "金額", "", "金額列がありません"))
+    if missing:
+        return ImportResult([], missing)
+
+    assert date_i is not None and amount_i is not None
+    rows: list[Expense] = []
+    errors: list[ImportError_] = []
+    for line, cells in records[1:]:
+        if len(cells) != len(names):
+            errors.append(ImportError_(line, "", ",".join(cells), "列数が一致しません"))
+            continue
+        raw_amount = cells[amount_i].strip()
+        if deposit_i is not None and not raw_amount and cells[deposit_i].strip():
+            continue  # deposit-only row
+
+        day = _parse_date(cells[date_i])
+        amount = _parse_amount(cells[amount_i])
+        if day is None:
+            errors.append(
+                ImportError_(
+                    line, names[date_i], cells[date_i].strip(), "日付が不正です"
+                )
+            )
+        if amount is None:
+            errors.append(
+                ImportError_(line, names[amount_i], raw_amount, "金額が不正です")
+            )
+        if day is None or amount is None:
+            continue
+
+        category = cells[category_i].strip() if category_i is not None else ""
+        memo = cells[memo_i].strip() if memo_i is not None else ""
+        rows.append(Expense(day, category or default_category, amount, memo))
+    return ImportResult(rows, errors)
