@@ -0,0 +1,73 @@
+"""Month-over-month comparison of expenses by category (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryDiff:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    rate: float | None
+    trend: str
+
+
+def _previous_month(month: str) -> str:
+    year, mon = int(month[:4]), int(month[5:7])
+    if mon == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mon - 1:02d}"
+
+
+def _totals(rows: list[Expense], month: str) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for e in rows:
+        if e.day.strftime("%Y-%m") == month:
+            out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def month_over_month(rows: list[Expense], month: str) -> list[CategoryDiff]:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+    prev_month = _previous_month(month)
+    prev = _totals(rows, prev_month)
+    cur = _totals(rows, month)
+
+    diffs: list[CategoryDiff] = []
+    for cat in set(prev) | set(cur):
+        p = prev.get(cat, 0)
+        c = cur.get(cat, 0)
+        if p == 0 and c == 0:
+            continue
+        delta = c - p
+        rate = None if p == 0 else delta / p
+        trend = "増" if delta > 0 else "減" if delta < 0 else "横ばい"
+        diffs.append(CategoryDiff(cat, p, c, delta, rate, trend))
+
+    diffs.sort(key=lambda d: (-abs(d.delta), d.category))
+    return diffs
+
+
+def format_report(diffs: list[CategoryDiff]) -> str:
+    if not diffs:
+        return "差分なし"
+    lines: list[str] = []
+    for d in diffs:
+        change = f"{d.delta:+,}円"
+        if d.rate is None:
+            detail = f"{change}, 新規"
+        else:
+            detail = f"{change}, {d.rate * 100:+.1f}%"
+        lines.append(
+            f"{d.category}: {d.previous:,} → {d.current:,} ({detail}) {d.trend}"
+        )
+    return "\n".join(lines)
