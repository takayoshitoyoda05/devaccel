+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthly_diff import CategoryDiff, month_over_month
+
+
+def _e(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+@pytest.mark.parametrize(
+    ("rows", "month", "expected"),
+    [
+        pytest.param(
+            [
+                _e("2026-01-10", "食費", 10000),
+                _e("2026-02-10", "食費", 12500),
+            ],
+            "2026-02",
+            [CategoryDiff("食費", 10000, 12500, 2500, 0.25, "増")],
+            id="E4-1",
+        ),
+        pytest.param(
+            [_e("2026-02-03", "交通費", 3000)],
+            "2026-02",
+            [CategoryDiff("交通費", 0, 3000, 3000, None, "増")],
+            id="E4-2",
+        ),
+    ],
+)
+def test_month_over_month_examples(
+    rows: list[Expense], month: str, expected: list[CategoryDiff]
+) -> None:
+    assert month_over_month(rows, month) == expected
+
+
+@pytest.mark.parametrize("month", ["2026-13"], ids=["E4-3"])
+def test_invalid_month_raises(month: str) -> None:
+    with pytest.raises(ValueError):
+        month_over_month([], month)
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
