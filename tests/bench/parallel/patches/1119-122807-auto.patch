+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import ImportError_, ImportResult, parse_bank_csv
+from kakeibo.core import Expense
+
+
+def _brief(r: ImportResult) -> tuple[list[Expense], list[tuple[int, str, str]]]:
+    return r.rows, [(e.line, e.column, e.value) for e in r.errors]
+
+
+# 例の表 E2-1 .. E2-3
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param(
+            '利用日,ご利用店名,利用金額\n2026/1/5,ABC,"1,234円"\n',
+            ([Expense(date(2026, 1, 5), "未分類", 1234, "ABC")], []),
+            id="E2-1",
+        ),
+        pytest.param(
+            "日付,金額\n2026-02-30,△500\n",
+            ([], [(2, "日付", "2026-02-30")]),
+            id="E2-2",
+        ),
+        pytest.param(
+            "日付,出金額,入金額\n2026-01-05,,50000\n",
+            ([], []),
+            id="E2-3",
+        ),
+    ],
+)
+def test_spec_examples(text: str, expected: tuple) -> None:
+    assert _brief(parse_bank_csv(text)) == expected
+
+
+# R1: 区切り・BOM・CRLF・引用符内の区切りと改行・開始行
+def test_R1_tab_delimiter_chosen_when_more_tabs_in_first_line() -> None:
+    r = parse_bank_csv("日付\t金額\t摘要\n2026-01-05\t100\ta,b\n")
+    assert r.rows == [Expense(date(2026, 1, 5), "未分類", 100, "a,b")]
+
+
+def test_R1_bom_and_crlf() -> None:
+    r = parse_bank_csv("﻿日付,金額\r\n2026-01-05,100\r\n")
+    assert r.rows == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+def test_R1_quoted_newline_and_line_numbers_are_record_start() -> None:
+    text = '日付,金額,摘要\n2026-01-05,100,"x\ny"\n2026-02-30,200,z\n'
+    r = parse_bank_csv(text)
+    assert r.rows == [Expense(date(2026, 1, 5), "未分類", 100, "x\ny")]
+    assert [(e.line, e.column) for e in r.errors] == [(4, "日付")]
+
+
+# R2: 列名の照合・カテゴリ・既定カテゴリ
+def test_R2_header_is_trimmed_and_lowercased() -> None:
+    r = parse_bank_csv(" Date , AMOUNT \n2026-01-05,100\n")
+    assert r.rows == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+def test_R2_category_column_is_used_and_default_applies_when_missing() -> None:
+    r = parse_bank_csv("日付,金額,分類\n2026-01-05,100,食費\n")
+    assert r.rows[0].category == "食費"
+    r2 = parse_bank_csv("日付,金額\n2026-01-05,100\n", default_category="雑費")
+    assert r2.rows[0].category == "雑費"
+
+
+def test_R2_deposit_only_row_is_skipped_without_error() -> None:
+    r = parse_bank_csv("日付,出金額,預入\n2026-01-05,,50000\n")
+    assert _brief(r) == ([], [])
+
+
+# R3: 金額の書き方
+@pytest.mark.parametrize(
+    ("raw", "value"),
+    [
+        pytest.param("1234", 1234, id="plain"),
+        pytest.param("1,234", 1234, id="comma"),
+        pytest.param("1，234", 1234, id="fullwidth-comma"),
+        pytest.param("１，２３４", 1234, id="fullwidth-digits"),
+        pytest.param("¥1,234", 1234, id="yen"),
+        pytest.param("￥1,234", 1234, id="fullwidth-yen"),
+        pytest.param("1,234円", 1234, id="yen-suffix"),
+        pytest.param("JPY 1234", 1234, id="jpy-prefix"),
+        pytest.param("-300", -300, id="minus"),
+        pytest.param("−300", -300, id="unicode-minus"),
+        pytest.param("△500", -500, id="triangle"),
+        pytest.param("▲500", -500, id="black-triangle"),
+        pytest.param("(500)", -500, id="parens"),
+        pytest.param("500-", -500, id="trailing-minus"),
+        pytest.param(" 　1234　 ", 1234, id="surrounding-spaces"),
+    ],
+)
+def test_R3_accepted_amount_forms(raw: str, value: int) -> None:
+    r = parse_bank_csv(f'日付,金額\n2026-01-05,"{raw}"\n')
+    assert r.rows == [Expense(date(2026, 1, 5), "未分類", value, "")]
+    assert r.errors == []
+
+
+@pytest.mark.parametrize(
+    "raw",
+    ["12.5", "", "-", "—", "1,23", "abc"],
+    ids=["decimal", "empty", "minus-only", "em-dash", "bad-grouping", "text"],
+)
+def test_R3_rejected_amount_forms(raw: str) -> None:
+    r = parse_bank_csv(f'日付,金額\n2026-01-05,"{raw}"\n')
+    assert r.rows == []
+    assert [(e.line, e.column, e.value) for e in r.errors] == [(2, "金額", raw)]
+
+
+# R4: 日付の書き方
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026.1.5",
+        "2026年1月5日",
+        "20260105",
+        "2026-01-05 12:34",
+    ],
+    ids=["dash", "slash", "dot", "kanji", "compact", "with-time"],
+)
+def test_R4_accepted_date_forms(raw: str) -> None:
+    r = parse_bank_csv(f"日付,金額\n{raw},100\n")
+    assert r.rows == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+@pytest.mark.parametrize(
+    "raw",
+    ["2026-02-30", "令和8年1月5日", "2026-13-01", "abc"],
+    ids=["nonexistent", "wareki", "bad-month", "text"],
+)
+def test_R4_rejected_dates(raw: str) -> None:
+    r = parse_bank_csv(f"日付,金額\n{raw},100\n")
+    assert r.rows == []
+    assert [(e.line, e.column, e.value) for e in r.errors] == [(2, "日付", raw)]
+
+
+def test_R4_leap_day_is_valid() -> None:
+    r = parse_bank_csv("日付,金額\n2024-02-29,100\n")
+    assert r.rows[0].day == date(2024, 2, 29)
+
+
+# R5: 必須列の欠落・空入力
+@pytest.mark.parametrize(
+    ("header", "missing"),
+    [
+        ("金額,摘要", "日付"),
+        ("日付,摘要", "金額"),
+    ],
+    ids=["no-date", "no-amount"],
+)
+def test_R5_missing_required_column(header: str, missing: str) -> None:
+    r = parse_bank_csv(f"{header}\n2026-01-05,x\n")
+    assert _brief(r) == ([], [(1, missing, "")])
+
+
+@pytest.mark.parametrize(
+    "text",
+    ["", "日付,金額\n", "日付,金額"],
+    ids=["empty", "header-only", "header-no-newline"],
+)
+def test_R5_empty_or_header_only(text: str) -> None:
+    assert _brief(parse_bank_csv(text)) == ([], [])
+
+
+# R6: 列数・空行・複数誤り・並び順
+def test_R6_wrong_column_count_is_error_and_good_rows_kept() -> None:
+    text = "日付,金額\n2026-01-05,100,extra\n2026-01-06,200\n2026-01-07\n"
+    r = parse_bank_csv(text)
+    assert r.rows == [Expense(date(2026, 1, 6), "未分類", 200, "")]
+    assert [e.line for e in r.errors] == [2, 4]
+
+
+def test_R6_blank_rows_are_skipped() -> None:
+    text = "日付,金額\n\n2026-01-05,100\n   \n,\n"
+    r = parse_bank_csv(text)
+    assert r.rows == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+    assert r.errors == []
+
+
+def test_R6_both_date_and_amount_invalid_gives_two_errors_in_order() -> None:
+    text = "日付,金額\n2026-02-30,abc\n2026-01-05,12.5\n"
+    r = parse_bank_csv(text)
+    assert r.rows == []
+    assert _brief(r)[1] == [
+        (2, "日付", "2026-02-30"),
+        (2, "金額", "abc"),
+        (3, "金額", "12.5"),
+    ]
+    assert isinstance(r.errors[0], ImportError_)
