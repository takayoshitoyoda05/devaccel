+++ b/src/kakeibo/search.py
@@ -0,0 +1,118 @@
+"""Filter expenses with a dict-based spec (pure functions, no I/O)."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable
+from datetime import date
+
+from kakeibo.core import Expense
+
+_Pred = Callable[[Expense], bool]
+
+_PLAIN_KEYS = {
+    "category",
+    "min_amount",
+    "max_amount",
+    "memo_contains",
+    "date_from",
+    "date_to",
+}
+_COMBINE_KEYS = {"and", "or", "not"}
+
+
+def _is_int(v: object) -> bool:
+    return isinstance(v, int) and not isinstance(v, bool)
+
+
+def _norm(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).lower()
+
+
+def _always(_: Expense) -> bool:
+    return True
+
+
+def _invalid(msg: str) -> ValueError:
+    return ValueError(msg)
+
+
+def _compile_list(value: object, key: str, mode: str) -> _Pred:
+    if not isinstance(value, list):
+        raise _invalid(f"{key} はリストである必要があります")
+    preds = [build_filter(s) for s in value]  # type: ignore[arg-type]
+    if mode == "and":
+        return lambda e: all(p(e) for p in preds)
+    return lambda e: any(p(e) for p in preds)
+
+
+def _compile_plain(key: str, value: object) -> _Pred:
+    if key == "category":
+        if isinstance(value, str):
+            return lambda e: e.category == value
+        if isinstance(value, list) and all(isinstance(c, str) for c in value):
+            cats = set(value)
+            return lambda e: e.category in cats
+        raise ValueError("category は str か str のリストである必要があります")
+    if key in ("min_amount", "max_amount"):
+        if not _is_int(value):
+            raise ValueError(f"{key} は int である必要があります")
+        if key == "min_amount":
+            lo = value
+            return lambda e: e.amount >= lo  # type: ignore[operator]
+        hi = value
+        return lambda e: e.amount <= hi  # type: ignore[operator]
+    if key == "memo_contains":
+        if not isinstance(value, str):
+            raise ValueError("memo_contains は str である必要があります")
+        if value == "":
+            return _always
+        needle = _norm(value)
+        return lambda e: needle in _norm(e.memo)
+    if key in ("date_from", "date_to"):
+        if not isinstance(value, date) or type(value) is not date:
+            raise ValueError(f"{key} は date である必要があります")
+        if key == "date_from":
+            start = value
+            return lambda e: e.day >= start
+        end = value
+        return lambda e: e.day <= end
+    raise ValueError(f"未知のキーです: {key!r}")  # pragma: no cover
+
+
+def build_filter(spec: dict[str, object]) -> Callable[[Expense], bool]:
+    """spec を検証し、明細を受け取って真偽を返す述語を作る。不正なら ValueError。"""
+    if not isinstance(spec, dict):
+        raise _invalid("spec は dict である必要があります")
+    unknown = set(spec) - _PLAIN_KEYS - _COMBINE_KEYS
+    if unknown:
+        raise ValueError(f"未知のキーです: {sorted(unknown)!r}")
+
+    if "min_amount" in spec and "max_amount" in spec:
+        lo, hi = spec["min_amount"], spec["max_amount"]
+        if _is_int(lo) and _is_int(hi) and lo > hi:  # type: ignore[operator]
+            raise ValueError("min_amount が max_amount より大きいです")
+    if "date_from" in spec and "date_to" in spec:
+        df, dt = spec["date_from"], spec["date_to"]
+        if isinstance(df, date) and isinstance(dt, date) and df > dt:
+            raise ValueError("date_from が date_to より後です")
+
+    preds: list[_Pred] = []
+    for key, value in spec.items():
+        if key in _PLAIN_KEYS:
+            preds.append(_compile_plain(key, value))
+        elif key in ("and", "or"):
+            preds.append(_compile_list(value, key, key))
+        else:  # "not"
+            if not isinstance(value, dict):
+                raise ValueError("not は spec(dict) である必要があります")
+            inner = build_filter(value)
+            preds.append(lambda e, _p=inner: not _p(e))
+
+    return lambda e: all(p(e) for p in preds)
+
+
+def search(rows: list[Expense], spec: dict[str, object]) -> list[Expense]:
+    """spec に合う明細を入力順のまま返す。"""
+    pred = build_filter(spec)
+    return [e for e in rows if pred(e)]
