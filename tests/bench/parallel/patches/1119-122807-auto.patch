index 0000000..4dc7d38
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,192 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring
+
+JAN_MAR = [(2026, 1), (2026, 2), (2026, 3)]
+
+
+def monthly(
+    category: str,
+    memo: str,
+    amount: int,
+    months: list[tuple[int, int]],
+    day: int = 25,
+) -> list[Expense]:
+    return [Expense(date(y, m, day), category, amount, memo) for y, m in months]
+
+
+# 例の表 E1-1 / E1-2 / E1-3 (ID はテスト ID として残す)
+SPEC_CASES = [
+    pytest.param(
+        monthly("住居", "家賃", 80000, JAN_MAR),
+        [Recurring("住居", "家賃", 80000, 3, date(2026, 4, 25))],
+        id="E1-1",
+    ),
+    pytest.param(
+        [
+            Expense(date(2026, 1, 31), "娯楽", 1490, "動画"),
+            Expense(date(2026, 2, 28), "娯楽", 1490, "動画"),
+            Expense(date(2026, 3, 31), "娯楽", 1490, "動画"),
+        ],
+        [Recurring("娯楽", "動画", 1490, 3, date(2026, 4, 30))],
+        id="E1-2",
+    ),
+    pytest.param(
+        monthly("娯楽", "動画", 1490, [(2026, 1), (2026, 2)]),
+        [],
+        id="E1-3",
+    ),
+]
+
+
+@pytest.mark.parametrize(("rows", "expected"), SPEC_CASES)
+def test_spec_examples(rows: list[Expense], expected: list[Recurring]) -> None:
+    assert find_recurring(rows) == expected
+
+
+# R2: amount desc, then category, then memo asc
+def test_sort_order_amount_category_memo() -> None:
+    rows = (
+        monthly("住居", "家賃", 80000, JAN_MAR)
+        + monthly("B", "z", 1000, JAN_MAR)
+        + monthly("A", "y", 1000, JAN_MAR)
+        + monthly("A", "x", 1000, JAN_MAR)
+    )
+    got = [(r.category, r.memo) for r in find_recurring(rows)]
+    assert got == [("住居", "家賃"), ("A", "x"), ("A", "y"), ("B", "z")]
+
+
+# R3: empty input and no-match input give an empty list
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+def test_no_match_returns_empty_list() -> None:
+    rows = [Expense(date(2026, 1, 1), "食費", 500, "パン")]
+    assert find_recurring(rows) == []
+
+
+# R3: result does not depend on input order
+def test_input_order_does_not_matter() -> None:
+    rows = monthly("住居", "家賃", 80000, JAN_MAR) + monthly("A", "x", 900, JAN_MAR)
+    assert find_recurring(rows) == find_recurring(list(reversed(rows)))
+
+
+# R1: memo is the original memo of the last row of the series
+def test_memo_is_original_memo_of_last_row() -> None:
+    rows = [
+        Expense(date(2026, 1, 5), "通信", 980, "サブスク"),
+        Expense(date(2026, 2, 5), "通信", 980, "サブスク 2"),
+        Expense(date(2026, 3, 5), "通信", 980, "ｻﾌﾞｽｸ １"),
+    ]
+    [got] = find_recurring(rows)
+    assert got.memo == "ｻﾌﾞｽｸ １"
+    assert got.months == 3
+
+
+# R4 / D1: NFKC and trailing digits are normalized into one series
+def test_normalized_memo_forms_one_series() -> None:
+    rows = [
+        Expense(date(2026, 1, 5), "通信", 980, "ｻﾌﾞｽｸ １"),
+        Expense(date(2026, 2, 5), "通信", 980, "サブスク 2"),
+        Expense(date(2026, 3, 5), "通信", 980, "サブスク"),
+    ]
+    got = find_recurring(rows)
+    assert len(got) == 1
+    assert got[0].months == 3
+
+
+# D1: amount outside ±10% of the median is excluded from the series
+def test_outlier_amount_is_excluded() -> None:
+    rows = monthly("住居", "家賃", 80000, JAN_MAR) + [
+        Expense(date(2026, 2, 3), "住居", 100000, "家賃")
+    ]
+    got = find_recurring(rows)
+    assert got == [Recurring("住居", "家賃", 80000, 3, date(2026, 4, 25))]
+
+
+# D1: amount within ±10% of the median stays in the series
+def test_amount_within_tolerance_is_kept() -> None:
+    rows = [
+        Expense(date(2026, 1, 25), "住居", 80000, "家賃"),
+        Expense(date(2026, 2, 25), "住居", 88000, "家賃"),
+        Expense(date(2026, 3, 25), "住居", 72000, "家賃"),
+    ]
+    got = find_recurring(rows)
+    assert len(got) == 1
+    assert got[0].months == 3
+    assert got[0].amount == 80000
+
+
+# D2: a month with two rows ends a run; only the last continuous run counts
+def test_double_month_breaks_run_and_last_run_is_used() -> None:
+    rows = (
+        [Expense(date(2026, 1, 25), "住居", 80000, "家賃")]
+        + [
+            Expense(date(2026, 2, 10), "住居", 80000, "家賃"),
+            Expense(date(2026, 2, 25), "住居", 80000, "家賃"),
+        ]
+        + monthly("住居", "家賃", 80000, [(2026, 3), (2026, 4), (2026, 5)])
+    )
+    got = find_recurring(rows)
+    assert got == [Recurring("住居", "家賃", 80000, 3, date(2026, 6, 25))]
+
+
+# D2: a missing month ends the run
+def test_missing_month_breaks_run() -> None:
+    rows = monthly("住居", "家賃", 80000, [(2026, 1), (2026, 2), (2026, 4), (2026, 5)])
+    assert find_recurring(rows) == []
+
+
+def test_missing_month_then_long_run_uses_last_run() -> None:
+    rows = monthly(
+        "住居", "家賃", 80000, [(2026, 1), (2026, 2), (2026, 4), (2026, 5), (2026, 6)]
+    )
+    got = find_recurring(rows)
+    assert got == [Recurring("住居", "家賃", 80000, 3, date(2026, 7, 25))]
+
+
+# D2: amount <= 0 rows are ignored (they neither count nor break a run)
+def test_non_positive_amounts_are_ignored() -> None:
+    rows = monthly("住居", "家賃", 80000, JAN_MAR) + [
+        Expense(date(2026, 2, 3), "住居", -80000, "家賃"),
+        Expense(date(2026, 4, 25), "住居", 0, "家賃"),
+    ]
+    got = find_recurring(rows)
+    assert got == [Recurring("住居", "家賃", 80000, 3, date(2026, 4, 25))]
+
+
+# D3: clamp to the end of the next month (leap day)
+def test_next_date_clamps_to_leap_day() -> None:
+    rows = [
+        Expense(date(2023, 11, 30), "光熱", 1000, "電気"),
+        Expense(date(2023, 12, 31), "光熱", 1000, "電気"),
+        Expense(date(2024, 1, 31), "光熱", 1000, "電気"),
+    ]
+    got = find_recurring(rows)
+    assert got == [Recurring("光熱", "電気", 1000, 3, date(2024, 2, 29))]
+
+
+# D3: December rolls over to January of next year
+def test_next_date_rolls_over_year() -> None:
+    rows = monthly("住居", "家賃", 80000, [(2025, 10), (2025, 11), (2025, 12)])
+    got = find_recurring(rows)
+    assert got == [Recurring("住居", "家賃", 80000, 3, date(2026, 1, 25))]
+
+
+# R1: amount is the median; even count takes the smaller middle value
+def test_amount_is_median_lower_for_even_count() -> None:
+    rows = [
+        Expense(date(2026, 1, 25), "通信", 950, "回線"),
+        Expense(date(2026, 2, 25), "通信", 1000, "回線"),
+        Expense(date(2026, 3, 25), "通信", 1000, "回線"),
+        Expense(date(2026, 4, 25), "通信", 950, "回線"),
+    ]
+    [got] = find_recurring(rows)
+    assert got.amount == 950
+    assert got.months == 4
