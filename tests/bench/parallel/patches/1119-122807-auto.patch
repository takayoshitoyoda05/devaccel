+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import build_filter, search
+
+ROWS = [
+    Expense(date(2024, 1, 5), "食費", 800, "Lunch"),
+    Expense(date(2024, 1, 10), "交通", 1000, "電車"),
+    Expense(date(2024, 2, 1), "住居", 80000, "家賃"),
+    Expense(date(2024, 2, 29), "食費", 1000, "スーパー"),
+    Expense(date(2024, 3, 15), "娯楽", 12000, "ｶﾗｵｹ"),
+]
+
+
+def _memos(spec: dict[str, object]) -> list[str]:
+    return [e.memo for e in search(ROWS, spec)]
+
+
+# --- 表の全行(E3-1 〜 E3-3) ---
+
+
+@pytest.mark.parametrize(
+    ("spec", "expected"),
+    [
+        # E3-1: どちらかを満たす明細 (食費 or 1万円以上)
+        pytest.param(
+            {"or": [{"category": "食費"}, {"min_amount": 10000}]},
+            ["Lunch", "家賃", "スーパー", "ｶﾗｵｹ"],
+            id="E3-1",
+        ),
+        # E3-2: 金額がちょうど 1000 の明細
+        pytest.param(
+            {"min_amount": 1000, "max_amount": 1000},
+            ["電車", "スーパー"],
+            id="E3-2",
+        ),
+    ],
+)
+def test_table_rows_match(spec: dict[str, object], expected: list[str]) -> None:
+    assert _memos(spec) == expected
+
+
+def test_E3_3_min_greater_than_max_raises() -> None:
+    # E3-3
+    with pytest.raises(ValueError):
+        build_filter({"min_amount": 5, "max_amount": 1})
+
+
+# --- R1 キーごとの振る舞い ---
+
+
+def test_category_exact_match_str() -> None:
+    assert _memos({"category": "食費"}) == ["Lunch", "スーパー"]
+
+
+def test_category_list_means_any() -> None:
+    assert _memos({"category": ["交通", "住居"]}) == ["電車", "家賃"]
+
+
+def test_category_is_exact_not_partial() -> None:
+    assert _memos({"category": "食"}) == []
+
+
+def test_category_empty_list_matches_nothing() -> None:
+    assert _memos({"category": []}) == []
+
+
+def test_min_amount_inclusive() -> None:
+    assert _memos({"min_amount": 1000}) == ["電車", "家賃", "スーパー", "ｶﾗｵｹ"]
+
+
+def test_max_amount_inclusive() -> None:
+    assert _memos({"max_amount": 800}) == ["Lunch"]
+
+
+def test_memo_contains_is_nfkc_and_case_insensitive() -> None:
+    # 全角 "ｶﾗｵｹ" は NFKC で "カラオケ"; 大文字 "LUNCH" も一致
+    assert _memos({"memo_contains": "カラオケ"}) == ["ｶﾗｵｹ"]
+    assert _memos({"memo_contains": "LUNCH"}) == ["Lunch"]
+
+
+def test_memo_contains_partial_match() -> None:
+    assert _memos({"memo_contains": "ー"}) == ["スーパー"]
+
+
+def test_memo_contains_empty_string_always_true() -> None:
+    assert _memos({"memo_contains": ""}) == [e.memo for e in ROWS]
+
+
+def test_date_from_inclusive() -> None:
+    assert _memos({"date_from": date(2024, 2, 29)}) == ["スーパー", "ｶﾗｵｹ"]
+
+
+def test_date_to_inclusive() -> None:
+    assert _memos({"date_to": date(2024, 1, 10)}) == ["Lunch", "電車"]
+
+
+def test_date_range_inclusive_both_ends() -> None:
+    assert _memos({"date_from": date(2024, 1, 10), "date_to": date(2024, 2, 1)}) == [
+        "電車",
+        "家賃",
+    ]
+
+
+def test_multiple_keys_are_anded() -> None:
+    assert _memos({"category": "食費", "min_amount": 1000}) == ["スーパー"]
+
+
+# --- R2 組み合わせ ---
+
+
+def test_not_inverts() -> None:
+    assert _memos({"not": {"category": "食費"}}) == ["電車", "家賃", "ｶﾗｵｹ"]
+
+
+def test_nested_and_or_not() -> None:
+    spec: dict[str, object] = {
+        "and": [
+            {"or": [{"category": "食費"}, {"category": "交通"}]},
+            {"not": {"max_amount": 800}},
+        ]
+    }
+    assert _memos(spec) == ["電車", "スーパー"]
+
+
+def test_and_or_mixed_with_plain_keys_are_anded() -> None:
+    spec = {
+        "category": "食費",
+        "or": [{"min_amount": 1000}, {"memo_contains": "lunch"}],
+    }
+    assert _memos(spec) == ["Lunch", "スーパー"]
+
+
+def test_empty_and_is_true() -> None:
+    assert _memos({"and": []}) == [e.memo for e in ROWS]
+
+
+def test_empty_or_is_false() -> None:
+    assert _memos({"or": []}) == []
+
+
+# --- R3 空 spec・順序 ---
+
+
+def test_empty_spec_returns_all() -> None:
+    assert search(ROWS, {}) == ROWS
+
+
+def test_result_keeps_input_order() -> None:
+    rows = list(reversed(ROWS))
+    assert search(rows, {"category": "食費"}) == [rows[1], rows[4]]
+    assert [e.memo for e in search(rows, {"category": "食費"})] == ["スーパー", "Lunch"]
+
+
+def test_search_empty_rows_returns_empty() -> None:
+    assert search([], {"category": "食費"}) == []
+
+
+def test_build_filter_returns_callable() -> None:
+    f = build_filter({"min_amount": 1000})
+    assert f(ROWS[1]) is True
+    assert f(ROWS[0]) is False
+
+
+# --- R4 ValueError (rows が空でも build 時点で検出) ---
+
+
+@pytest.mark.parametrize(
+    "spec",
+    [
+        {"unknown": 1},
+        {"category": 1},
+        {"category": ["食費", 1]},
+        {"min_amount": True},
+        {"max_amount": "1000"},
+        {"min_amount": 5, "max_amount": 1},
+        {"date_from": date(2024, 2, 1), "date_to": date(2024, 1, 1)},
+        {"and": {"category": "食費"}},
+        {"or": "食費"},
+        {"date_from": "2024-01-01"},
+        {"memo_contains": 1},
+        {"not": {"unknown": 1}},
+        {"and": [{"min_amount": 5, "max_amount": 1}]},
+    ],
+    ids=[
+        "unknown-key",
+        "category-int",
+        "category-list-with-int",
+        "min-amount-bool",
+        "max-amount-str",
+        "min-greater-than-max",
+        "date-from-greater-than-to",
+        "and-not-list",
+        "or-not-list",
+        "date-str",
+        "memo-not-str",
+        "nested-unknown-key",
+        "nested-min-greater-than-max",
+    ],
+)
+def test_invalid_spec_raises_at_build_time(spec: dict[str, object]) -> None:
+    with pytest.raises(ValueError):
+        build_filter(spec)
+
+
+def test_invalid_spec_raises_even_with_empty_rows() -> None:
+    with pytest.raises(ValueError):
+        search([], {"min_amount": 5, "max_amount": 1})
