@@ -0,0 +1,116 @@
+"""Detect recurring expenses (monthly series) and predict their next date.
+
+Pure functions: no file I/O, no side effects.
+"""
+
+from __future__ import annotations
+
+import calendar
+import unicodedata
+from collections import defaultdict
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+MIN_MONTHS = 3  # D2: a series needs at least this many consecutive months
+TOLERANCE_PERCENT = 10  # D1: amount within ±10% of the median is the same series
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str  # original memo of the last row in the series
+    amount: int  # median amount of the series (yen)
+    months: int  # length of the last continuous run of months
+    next_date: date
+
+
+def _normalize_memo(memo: str) -> str:
+    """D1: NFKC, lowercase, drop all whitespace, drop trailing digits and '#'."""
+    s = unicodedata.normalize("NFKC", memo).lower()
+    s = "".join(s.split())
+    return s.rstrip("0123456789#")
+
+
+def _lower_median(values: list[int]) -> int:
+    """Median; for an even count, the smaller of the two middle values."""
+    s = sorted(values)
+    return s[(len(s) - 1) // 2]
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + (d.month - 1)
+
+
+def _last_run(members: list[Expense]) -> list[Expense]:
+    """D2: rows of the last continuous run of months, each with exactly one row.
+
+    A month with 2+ rows, or a missing month, ends the current run.
+    """
+    by_month: dict[int, list[Expense]] = defaultdict(list)
+    for e in members:
+        by_month[_month_index(e.day)].append(e)
+
+    segments: list[list[Expense]] = []
+    current: list[Expense] = []
+    prev: int | None = None
+    for idx in sorted(by_month):
+        rows = by_month[idx]
+        if len(rows) != 1:
+            if current:
+                segments.append(current)
+            current, prev = [], None
+            continue
+        if prev is not None and idx != prev + 1:
+            if current:
+                segments.append(current)
+            current = []
+        current.append(rows[0])
+        prev = idx
+    if current:
+        segments.append(current)
+    return segments[-1] if segments else []
+
+
+def _next_date(last: Expense, run: list[Expense]) -> date:
+    """D3: next month, day = median day of the run, clamped to that month's end."""
+    idx = _month_index(last.day) + 1
+    year, month0 = divmod(idx, 12)
+    month = month0 + 1
+    day = _lower_median([e.day.day for e in run])
+    last_day = calendar.monthrange(year, month)[1]
+    return date(year, month, min(day, last_day))
+
+
+def find_recurring(rows: list[Expense]) -> list[Recurring]:
+    """Return recurring expenses sorted by amount desc, then category, then memo asc."""
+    groups: dict[tuple[str, str], list[Expense]] = defaultdict(list)
+    for e in rows:
+        if e.amount <= 0:  # D2: non-positive amounts are ignored
+            continue
+        groups[(e.category, _normalize_memo(e.memo))].append(e)
+
+    out: list[Recurring] = []
+    for (category, _key), items in groups.items():
+        ref = _lower_median([e.amount for e in items])
+        # D1: keep rows within ±TOLERANCE_PERCENT% of the reference median (integer math)
+        members = [
+            e for e in items if abs(e.amount - ref) * 100 <= ref * TOLERANCE_PERCENT
+        ]
+        run = _last_run(members)
+        if len(run) < MIN_MONTHS:
+            continue
+        last = run[-1]
+        out.append(
+            Recurring(
+                category=category,
+                memo=last.memo,
+                amount=_lower_median([e.amount for e in run]),
+                months=len(run),
+                next_date=_next_date(last, run),
+            )
+        )
+
+    out.sort(key=lambda r: (-r.amount, r.category, r.memo))
+    return out
