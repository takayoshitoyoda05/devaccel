--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,82 @@
+"""Month-over-month category diff report."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(m: str) -> None:
+    if not isinstance(m, str) or not _MONTH_RE.fullmatch(m):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {m!r}")
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+    prev: dict[str, int] = {}
+    curr: dict[str, int] = {}
+    for e in rows:
+        m = e.day.strftime("%Y-%m")
+        if m == prev_month:
+            prev[e.category] = prev.get(e.category, 0) + e.amount
+        if m == curr_month:
+            curr[e.category] = curr.get(e.category, 0) + e.amount
+    out: list[DiffRow] = []
+    for cat in set(prev) | set(curr):
+        p = prev.get(cat, 0)
+        c = curr.get(cat, 0)
+        delta = c - p
+        pct = None if p == 0 else round(delta / p * 100, 1)
+        if cat not in prev:
+            status = "new"
+        elif cat not in curr:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, p, c, delta, pct, status))
+    out.sort(key=lambda r: (-abs(r.delta), r.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError("n は 0 以上である必要があります")
+    return [d for d in diffs if d.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for d in diffs:
+        pct = "-" if d.pct is None else f"{d.pct + 0.0:+.1f}%"
+        lines.append(f"{d.category}\t{d.prev}\t{d.curr}\t{d.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({e.day.strftime("%Y-%m") for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("比較できる月が 2 つ未満です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..f15c088
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,184 @@
+"""Search query language for expense rows.
+
+Grammar (lowest to highest precedence: OR < AND < NOT):
+
+    or_expr   := and_expr ("OR" and_expr)*
+    and_expr  := not_expr (["AND"] not_expr)*
+    not_expr  := "NOT" not_expr | primary
+    primary   := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+Token = tuple[str, str]
+
+_SPECIAL = frozenset('()"')
+
+
+class QueryError(ValueError):
+    """Raised when a search query is malformed."""
+
+
+@dataclass(frozen=True)
+class Term:
+    text: str
+
+
+@dataclass(frozen=True)
+class Cat:
+    name: str
+
+
+@dataclass(frozen=True)
+class Not:
+    operand: Node
+
+
+@dataclass(frozen=True)
+class And:
+    left: Node
+    right: Node
+
+
+@dataclass(frozen=True)
+class Or:
+    left: Node
+    right: Node
+
+
+Node = Term | Cat | Not | And | Or
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    tokens: list[Token] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError(f"閉じていない引用符があります: {q[i:]!r}")
+            body = q[i + 1 : end]
+            if body == "":
+                raise QueryError("空の引用符は使えません")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            j = i
+            while j < n and not q[j].isspace() and q[j] not in _SPECIAL:
+                j += 1
+            word = q[i:j]
+            i = j
+            if word in ("AND", "OR", "NOT"):
+                tokens.append((word, word))
+            elif word.startswith("cat:"):
+                value = word[len("cat:") :]
+                if value == "":
+                    raise QueryError("cat: の後ろにカテゴリ名がありません")
+                tokens.append(("CAT", value))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self.tokens = tokens
+        self.pos = 0
+
+    def _peek(self) -> str | None:
+        return self.tokens[self.pos][0] if self.pos < len(self.tokens) else None
+
+    def _take(self) -> Token:
+        tok = self.tokens[self.pos]
+        self.pos += 1
+        return tok
+
+    def parse(self) -> Node:
+        if not self.tokens:
+            raise QueryError("検索条件が空です")
+        node = self._or_expr()
+        if self.pos != len(self.tokens):
+            raise QueryError(
+                f"解釈できない位置があります: {self.tokens[self.pos][1]!r}"
+            )
+        return node
+
+    def _or_expr(self) -> Node:
+        left = self._and_expr()
+        while self._peek() == "OR":
+            self._take()
+            left = Or(left, self._and_expr())
+        return left
+
+    def _and_expr(self) -> Node:
+        left = self._not_expr()
+        while self._peek() in ("AND", "NOT", "TERM", "CAT", "LPAREN"):
+            if self._peek() == "AND":
+                self._take()
+            left = And(left, self._not_expr())
+        return left
+
+    def _not_expr(self) -> Node:
+        if self._peek() == "NOT":
+            self._take()
+            return Not(self._not_expr())
+        return self._primary()
+
+    def _primary(self) -> Node:
+        kind = self._peek()
+        if kind == "TERM":
+            return Term(self._take()[1])
+        if kind == "CAT":
+            return Cat(self._take()[1])
+        if kind == "LPAREN":
+            self._take()
+            node = self._or_expr()
+            if self._peek() != "RPAREN":
+                raise QueryError("括弧が閉じていません")
+            self._take()
+            return node
+        if kind is None:
+            raise QueryError("演算子の後ろに項がありません")
+        raise QueryError(f"項が必要な位置に {self.tokens[self.pos][1]!r} があります")
+
+
+def _parse(q: str) -> Node:
+    return _Parser(tokenize(q)).parse()
+
+
+def _eval(node: Node, e: Expense) -> bool:
+    match node:
+        case Term(text):
+            needle = text.casefold()
+            return needle in e.memo.casefold() or needle in e.category.casefold()
+        case Cat(name):
+            return name.casefold() == e.category.casefold()
+        case Not(operand):
+            return not _eval(operand, e)
+        case And(left, right):
+            return _eval(left, e) and _eval(right, e)
+        case Or(left, right):
+            return _eval(left, e) or _eval(right, e)
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _eval(_parse(q), e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    node = _parse(q)
+    return [r for r in rows if _eval(node, r)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..1b9fc84
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,64 @@
+"""Detect recurring monthly expenses (same category and amount, roughly monthly)."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day in the next month, clamped to that month's last day."""
+    year, month = d.year, d.month + 1
+    if month > 12:
+        year, month = year + 1, 1
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def _runs(days: list[date], tolerance: int) -> list[list[date]]:
+    """Split sorted, unique dates into maximal runs where neighbours are linked."""
+    runs: list[list[date]] = []
+    for d in days:
+        if runs and abs((d - add_month(runs[-1][-1])).days) <= tolerance:
+            runs[-1].append(d)
+        else:
+            runs.append([d])
+    return runs
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError(f"min_count は 2 以上である必要があります: {min_count}")
+    if tolerance < 0:
+        raise ValueError(f"tolerance は 0 以上である必要があります: {tolerance}")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    out: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        for run in _runs(sorted(day_set), tolerance):
+            if len(run) >= min_count:
+                out.append(
+                    Recurring(
+                        category=category,
+                        amount=amount,
+                        days=tuple(run),
+                        next_expected=add_month(run[-1]),
+                    )
+                )
+    return sorted(out, key=lambda r: (r.category, r.amount, r.days[0]))
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..16da5f3
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,117 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+
+@pytest.mark.parametrize(
+    "s,want",
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥1,2,3円", 123),
+        ("-5", -5),
+    ],
+)
+def test_amount_ok(s: str, want: int) -> None:
+    assert parse_amount(s) == want
+
+
+@pytest.mark.parametrize(
+    "s", ["", "円", "12.5", "1 200", "--5", "¥-5", "１２３", ",5", "¥", "5円円", "¥¥5"]
+)
+def test_amount_bad(s: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(s)
+
+
+@pytest.mark.parametrize(
+    "s,want",
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        (" 2026-01-05 ", date(2026, 1, 5)),
+        ("2026/12/31", date(2026, 12, 31)),
+    ],
+)
+def test_date_ok(s: str, want: date) -> None:
+    assert parse_date(s) == want
+
+
+@pytest.mark.parametrize(
+    "s",
+    [
+        "2026/1-5",
+        "26/1/5",
+        "2026/02/30",
+        "2026年1月5日",
+        "２０２６/1/5",
+        "2026/001/5",
+        "",
+    ],
+)
+def test_date_bad(s: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(s)
+
+
+HEADER = "利用日,分類,利用金額,利用店名,余分\n"
+
+
+def test_import_basic() -> None:
+    text = HEADER + '2026/1/5,食費,"¥1,200", 店 ,x\n'
+    rows, errs = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 1200, "店")]
+    assert errs == []
+
+
+def test_import_category_map_and_strip() -> None:
+    text = HEADER + "2026/1/5, 飲食 ,100,a,\n"
+    rows, _ = import_rows(text, category_map={"飲食": "食費"})
+    assert rows[0].category == "食費"
+
+
+def test_errors_order_lines_blank() -> None:
+    text = HEADER + "\n" + "bad,  ,xx,m,\n" + "2026/1/5,食費,10,m,\n" + "2026/1/6\n"
+    rows, errs = import_rows(text)
+    assert errs == [
+        (3, "date"),
+        (3, "amount"),
+        (3, "category"),
+        (5, "amount"),
+        (5, "category"),
+    ]
+    assert [r.amount for r in rows] == [10]
+
+
+def test_good_rows_kept_in_order() -> None:
+    text = HEADER + "2026/1/5,a,1,,\nbad,a,1,,\n2026/1/4,b,2,,\n"
+    rows, errs = import_rows(text)
+    assert [r.category for r in rows] == ["a", "b"]
+    assert errs == [(3, "date")]
+
+
+def test_multiline_quoted_line_numbers() -> None:
+    text = HEADER + '2026/1/5,a,1,"x\ny",\nbad,a,1,,\n'
+    rows, errs = import_rows(text)
+    assert len(rows) == 1 and rows[0].memo == "x\ny"
+    assert errs == [(4, "date")]
+
+
+def test_custom_mapping_memo_optional() -> None:
+    text = "d,c,a\n2026/1/5,x,3\n"
+    rows, errs = import_rows(text, {"date": "d", "category": "c", "amount": "a"})
+    assert rows == [Expense(date(2026, 1, 5), "x", 3, "")]
+    assert errs == []
+
+
+def test_mapping_errors() -> None:
+    with pytest.raises(ValueError):
+        import_rows(HEADER, {"date": "利用日", "amount": "利用金額"})
+    with pytest.raises(ValueError):
+        import_rows("a,b\n1,2\n")
+    with pytest.raises(ValueError):
+        import_rows(HEADER, {**DEFAULT_MAPPING, "memo": "無い"})
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..d88dd47
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,137 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def e(d: str, cat: str, amount: int) -> Expense:
+    return Expense(date.fromisoformat(d), cat, amount)
+
+
+ROWS = [
+    e("2024-01-05", "food", 1000),
+    e("2024-01-20", "food", 1000),
+    e("2024-01-10", "rent", 5000),
+    e("2024-01-11", "gym", 2000),
+    e("2024-02-03", "food", 2300),
+    e("2024-02-10", "rent", 5000),
+    e("2024-02-11", "book", 700),
+]
+
+
+@pytest.mark.parametrize(
+    "bad",
+    ["2024-1", "2024-13", "2024-00", "24-01", "2024/01", "", "2024-01-01", " 2024-01"],
+)
+def test_bad_month(bad: str) -> None:
+    with pytest.raises(ValueError):
+        month_diff(ROWS, bad, "2024-02")
+    with pytest.raises(ValueError):
+        month_diff(ROWS, "2024-01", bad)
+
+
+def test_month_diff_exact() -> None:
+    got = month_diff(ROWS, "2024-01", "2024-02")
+    assert got == [
+        DiffRow("gym", 2000, 0, -2000, -100.0, "gone"),
+        DiffRow("book", 0, 700, 700, None, "new"),
+        DiffRow("food", 2000, 2300, 300, 15.0, "up"),
+        DiffRow("rent", 5000, 5000, 0, 0.0, "same"),
+    ]
+
+
+def test_tie_sorted_by_category() -> None:
+    rows = [e("2024-01-01", "b", 100), e("2024-02-01", "a", 100)]
+    got = month_diff(rows, "2024-01", "2024-02")
+    assert [r.category for r in got] == ["a", "b"]
+
+
+def test_status_by_presence_not_total() -> None:
+    rows = [
+        e("2024-01-01", "x", 0),
+        e("2024-02-01", "x", 500),
+        e("2024-01-02", "y", 300),
+        e("2024-01-03", "y", -300),
+        e("2024-02-02", "z", 0),
+    ]
+    got = {r.category: r for r in month_diff(rows, "2024-01", "2024-02")}
+    assert got["x"].status == "up"
+    assert got["x"].pct is None
+    assert got["y"].status == "gone"
+    assert got["z"].status == "new"
+    assert got["z"].delta == 0
+
+
+def test_present_both_zero_delta_is_same() -> None:
+    rows = [e("2024-01-01", "x", 0), e("2024-02-01", "x", 0)]
+    assert month_diff(rows, "2024-01", "2024-02")[0].status == "same"
+
+
+def test_down_and_rounding() -> None:
+    rows = [e("2024-01-01", "x", 3), e("2024-02-01", "x", 1)]
+    r = month_diff(rows, "2024-01", "2024-02")[0]
+    assert (r.status, r.delta, r.pct) == ("down", -2, -66.7)
+
+
+def test_empty() -> None:
+    assert month_diff([], "2024-01", "2024-02") == []
+
+
+def test_top_movers() -> None:
+    diffs = month_diff(ROWS, "2024-01", "2024-02")
+    assert [r.category for r in top_movers(diffs)] == ["gym", "book", "food"]
+    assert [r.category for r in top_movers(diffs, 2)] == ["gym", "book"]
+    assert top_movers(diffs, 0) == []
+    assert len(top_movers(diffs, 10)) == 3
+    with pytest.raises(ValueError):
+        top_movers(diffs, -1)
+
+
+def test_top_movers_skips_same_in_middle() -> None:
+    d = [
+        DiffRow("a", 1, 2, 1, 100.0, "up"),
+        DiffRow("b", 1, 1, 0, 0.0, "same"),
+        DiffRow("c", 1, 0, -1, -100.0, "down"),
+    ]
+    assert [r.category for r in top_movers(d, 2)] == ["a", "c"]
+
+
+def test_render() -> None:
+    diffs = month_diff(ROWS, "2024-01", "2024-02")
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "gym\t2000\t0\t-2000\t-100.0%\n"
+        "book\t0\t700\t+700\t-\n"
+        "food\t2000\t2300\t+300\t+15.0%\n"
+        "rent\t5000\t5000\t+0\t+0.0%"
+    )
+
+
+def test_render_empty_and_negative_zero_pct() -> None:
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+    d = [DiffRow("a", 100000, 99999, -1, -0.0, "down")]
+    assert render_diff(d).endswith("-1\t+0.0%")
+
+
+def test_available_months() -> None:
+    rows = [e("2024-03-01", "a", 1), e("2023-12-31", "a", 1), e("2024-03-09", "b", 1)]
+    assert available_months(rows) == ["2023-12", "2024-03"]
+    assert available_months([]) == []
+
+
+def test_latest_diff() -> None:
+    rows = [e("2024-03-01", "a", 1)] + ROWS
+    assert latest_diff(rows) == month_diff(rows, "2024-02", "2024-03")
+    with pytest.raises(ValueError):
+        latest_diff([e("2024-01-01", "a", 1)])
+    with pytest.raises(ValueError):
+        latest_diff([])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..2d53fc9
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,233 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def _e(category: str, memo: str = "", amount: int = 100) -> Expense:
+    return Expense(day=date(2026, 11, 1), category=category, amount=amount, memo=memo)
+
+
+# --- tokenize ---------------------------------------------------------------
+
+
+def test_tokenize_whitespace_only_gives_no_tokens():
+    assert tokenize("   \t ") == []
+
+
+def test_tokenize_splits_on_whitespace_and_parens():
+    assert tokenize("(a)b") == [
+        ("LPAREN", "("),
+        ("TERM", "a"),
+        ("RPAREN", ")"),
+        ("TERM", "b"),
+    ]
+
+
+def test_tokenize_quote_keeps_spaces_and_parens_inside():
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+
+
+def test_tokenize_quote_has_no_escape():
+    assert tokenize('"a\\"') == [("TERM", "a\\")]
+
+
+def test_tokenize_unclosed_quote_is_error():
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_is_error():
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_only_uppercase_words_are_operators():
+    assert tokenize("AND OR NOT") == [
+        ("AND", "AND"),
+        ("OR", "OR"),
+        ("NOT", "NOT"),
+    ]
+
+
+def test_tokenize_lowercase_operator_words_are_terms():
+    assert tokenize("and or not") == [
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_quoted_operator_is_a_term():
+    assert tokenize('"AND"') == [("TERM", "AND")]
+
+
+def test_tokenize_cat_prefix_gives_cat_token_with_rest_of_word():
+    assert tokenize("cat:Food") == [("CAT", "Food")]
+
+
+def test_tokenize_cat_followed_by_quote_has_empty_value_and_is_error():
+    # 語 "cat:" は引用の直前で切れ、値が空になるのでエラー。
+    with pytest.raises(QueryError):
+        tokenize('cat:"x y"')
+
+
+def test_tokenize_empty_cat_value_is_error():
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_tokenize_cat_prefix_is_case_sensitive():
+    assert tokenize("CAT:food") == [("TERM", "CAT:food")]
+
+
+def test_tokenize_cat_only_counts_at_word_start():
+    assert tokenize("xcat:food") == [("TERM", "xcat:food")]
+
+
+# --- parsing / errors -------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(a",
+        "a)",
+        "(a))",
+        "AND a",
+        "a AND",
+        "a OR",
+        "OR a",
+        "a AND OR b",
+        "NOT",
+        "NOT )",
+        "a OR ()",
+    ],
+)
+def test_malformed_queries_raise(q):
+    with pytest.raises(QueryError):
+        matches(q, _e("food"))
+
+
+def test_malformed_query_raises_even_with_no_rows():
+    with pytest.raises(QueryError):
+        filter_rows("a AND", [])
+
+
+def test_valid_query_with_no_rows_gives_empty_list():
+    assert filter_rows("a", []) == []
+
+
+# --- precedence and implicit AND -------------------------------------------
+
+
+def test_and_binds_tighter_than_or():
+    # a OR (b AND c)
+    assert matches("a OR b c", _e("x", memo="a"))
+    assert matches("a OR b c", _e("x", memo="b c"))
+    assert not matches("a OR b c", _e("x", memo="b"))
+
+
+def test_not_binds_tighter_than_and():
+    # (NOT a) AND b
+    assert matches("NOT a b", _e("x", memo="b"))
+    assert not matches("NOT a b", _e("x", memo="a b"))
+
+
+def test_explicit_and_same_as_implicit():
+    e = _e("food", memo="lunch")
+    assert matches("food AND lunch", e) == matches("food lunch", e)
+    assert matches("food AND nope", e) is False
+
+
+def test_implicit_and_before_not():
+    # a AND (NOT b)
+    assert matches("a NOT b", _e("x", memo="a"))
+    assert not matches("a NOT b", _e("x", memo="a b"))
+
+
+def test_parens_override_precedence():
+    # (a OR b) AND c
+    assert not matches("(a OR b) c", _e("x", memo="a"))
+    assert matches("(a OR b) c", _e("x", memo="a c"))
+
+
+def test_double_not():
+    assert matches("NOT NOT a", _e("x", memo="a"))
+    assert not matches("NOT NOT a", _e("x", memo="b"))
+
+
+def test_lowercase_and_is_term_not_operator():
+    e = _e("x", memo="and")
+    assert matches("a and b", _e("x", memo="a and b"))
+    assert not matches("a and b", e)
+
+
+# --- evaluation -------------------------------------------------------------
+
+
+def test_term_matches_memo_substring():
+    assert matches("lun", _e("food", memo="lunch"))
+
+
+def test_term_matches_category_substring():
+    assert matches("foo", _e("food", memo=""))
+
+
+def test_term_is_case_insensitive():
+    assert matches("LUNCH", _e("food", memo="lunch"))
+    assert matches("lunch", _e("FOOD", memo="Lunch"))
+
+
+def test_term_casefold_handles_non_ascii_case_folding():
+    # "ß".casefold() == "ss"
+    assert matches("STRASSE", _e("x", memo="straße"))
+
+
+def test_cat_requires_exact_category_match():
+    assert matches("cat:food", _e("food"))
+    assert not matches("cat:foo", _e("food"))
+    assert not matches("cat:food", _e("fast food"))
+
+
+def test_cat_is_case_insensitive():
+    assert matches("cat:FOOD", _e("food"))
+
+
+def test_cat_does_not_match_memo():
+    assert not matches("cat:lunch", _e("food", memo="lunch"))
+
+
+def test_term_quoted_cat_prefix_is_plain_term():
+    assert matches('"cat:food"', _e("x", memo="cat:food"))
+    assert not matches('"cat:food"', _e("food"))
+
+
+def test_empty_memo_does_not_match_nonempty_term():
+    assert not matches("lunch", _e("food", memo=""))
+
+
+def test_filter_rows_keeps_input_order():
+    rows = [
+        _e("food", memo="a", amount=1),
+        _e("rent", memo="b", amount=2),
+        _e("food", memo="c", amount=3),
+    ]
+    out = filter_rows("cat:food", rows)
+    assert [r.amount for r in out] == [1, 3]
+
+
+def test_filter_rows_no_match_is_empty_list():
+    assert filter_rows("zzz", [_e("food")]) == []
+
+
+def test_filter_rows_does_not_mutate_input():
+    rows = [_e("food"), _e("rent")]
+    before = list(rows)
+    filter_rows("food", rows)
+    assert rows == before
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..7c401a8
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,233 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def e(day: date, category: str = "通信", amount: int = 3000, memo: str = "") -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# add_month
+
+
+def test_add_month_simple() -> None:
+    assert add_month(date(2026, 3, 10)) == date(2026, 4, 10)
+
+
+def test_add_month_clamps_to_end_of_short_month() -> None:
+    assert add_month(date(2026, 1, 31)) == date(2026, 2, 28)
+
+
+def test_add_month_clamps_to_leap_february() -> None:
+    assert add_month(date(2024, 1, 31)) == date(2024, 2, 29)
+
+
+def test_add_month_rolls_over_year() -> None:
+    assert add_month(date(2026, 12, 15)) == date(2027, 1, 15)
+
+
+def test_add_month_30_day_month_clamp() -> None:
+    assert add_month(date(2026, 3, 31)) == date(2026, 4, 30)
+
+
+# find_recurring: validation
+
+
+@pytest.mark.parametrize("min_count", [1, 0, -1])
+def test_min_count_below_two_raises(min_count: int) -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=min_count)
+
+
+def test_negative_tolerance_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_zero_tolerance_is_allowed() -> None:
+    assert find_recurring([], tolerance=0) == []
+
+
+# find_recurring: basic behaviour
+
+
+def test_empty_input_returns_empty() -> None:
+    assert find_recurring([]) == []
+
+
+def test_three_monthly_payments_detected() -> None:
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 5)), e(date(2026, 3, 5))]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="通信",
+            amount=3000,
+            days=(date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+            next_expected=date(2026, 4, 5),
+        )
+    ]
+
+
+def test_two_payments_below_default_min_count_ignored() -> None:
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 5))]
+    assert find_recurring(rows) == []
+
+
+def test_two_payments_detected_when_min_count_two() -> None:
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 5))]
+    result = find_recurring(rows, min_count=2)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 3, 5)
+
+
+def test_memo_is_ignored_when_grouping() -> None:
+    rows = [
+        e(date(2026, 1, 5), memo="a"),
+        e(date(2026, 2, 5), memo="b"),
+        e(date(2026, 3, 5), memo=""),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_different_amount_is_separate_group() -> None:
+    rows = [
+        e(date(2026, 1, 5), amount=3000),
+        e(date(2026, 2, 5), amount=3001),
+        e(date(2026, 3, 5), amount=3000),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_different_category_is_separate_group() -> None:
+    rows = [
+        e(date(2026, 1, 5), category="A"),
+        e(date(2026, 2, 5), category="B"),
+        e(date(2026, 3, 5), category="A"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_duplicate_dates_are_collapsed() -> None:
+    rows = [
+        e(date(2026, 1, 5)),
+        e(date(2026, 1, 5)),
+        e(date(2026, 2, 5)),
+        e(date(2026, 3, 5)),
+    ]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_input_order_does_not_matter() -> None:
+    rows = [e(date(2026, 3, 5)), e(date(2026, 1, 5)), e(date(2026, 2, 5))]
+    result = find_recurring(rows)
+    assert result[0].days[0] == date(2026, 1, 5)
+    assert result[0].days[-1] == date(2026, 3, 5)
+
+
+# find_recurring: tolerance and clamping
+
+
+def test_drift_within_tolerance_is_linked() -> None:
+    # 2026-01-05 -> expected 02-05; actual 02-08 is +3 days, within tolerance 3
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 8)), e(date(2026, 3, 5))]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_drift_beyond_tolerance_splits_run() -> None:
+    # 02-09 is +4 days from expected 02-05, so the run breaks: no run of 3
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 9)), e(date(2026, 3, 9))]
+    assert find_recurring(rows) == []
+
+
+def test_early_drift_within_tolerance_is_linked() -> None:
+    # 02-02 is -3 days from expected 02-05; still linked
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 2)), e(date(2026, 3, 2))]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_zero_tolerance_requires_exact_day() -> None:
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 6)), e(date(2026, 3, 6))]
+    assert find_recurring(rows, tolerance=0) == []
+
+
+def test_month_end_clamping_links_run() -> None:
+    # Jan 31 -> Feb 28 (clamped), Mar 31 linked from Feb 28? add_month(Feb 28)=Mar 28,
+    # Mar 31 is +3 days: linked with default tolerance.
+    rows = [e(date(2026, 1, 31)), e(date(2026, 2, 28)), e(date(2026, 3, 31))]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 30)
+
+
+def test_run_split_yields_two_recurring_entries() -> None:
+    # Gap in the middle: first run Jan-Mar, second run Aug-Oct, same group.
+    rows = [
+        e(date(2026, 1, 5)),
+        e(date(2026, 2, 5)),
+        e(date(2026, 3, 5)),
+        e(date(2026, 8, 5)),
+        e(date(2026, 9, 5)),
+        e(date(2026, 10, 5)),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 5), date(2026, 8, 5)]
+    assert all(len(r.days) == 3 for r in result)
+
+
+def test_run_shorter_than_min_is_dropped_but_others_kept() -> None:
+    rows = [
+        e(date(2026, 1, 5)),
+        e(date(2026, 2, 5)),
+        e(date(2026, 8, 5)),
+        e(date(2026, 9, 5)),
+        e(date(2026, 10, 5)),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days[0] == date(2026, 8, 5)
+
+
+def test_min_count_threshold_is_inclusive() -> None:
+    rows = [
+        e(date(2026, 1, 5)),
+        e(date(2026, 2, 5)),
+        e(date(2026, 3, 5)),
+        e(date(2026, 4, 5)),
+    ]
+    assert len(find_recurring(rows, min_count=4)) == 1
+    assert find_recurring(rows, min_count=5) == []
+
+
+# find_recurring: ordering
+
+
+def test_results_sorted_by_category_then_amount_then_first_day() -> None:
+    rows = [
+        e(date(2026, 1, 5), category="B", amount=100),
+        e(date(2026, 2, 5), category="B", amount=100),
+        e(date(2026, 3, 5), category="B", amount=100),
+        e(date(2026, 1, 9), category="A", amount=500),
+        e(date(2026, 2, 9), category="A", amount=500),
+        e(date(2026, 3, 9), category="A", amount=500),
+        e(date(2026, 1, 1), category="A", amount=200),
+        e(date(2026, 2, 1), category="A", amount=200),
+        e(date(2026, 3, 1), category="A", amount=200),
+    ]
+    keys = [(r.category, r.amount) for r in find_recurring(rows)]
+    assert keys == [("A", 200), ("A", 500), ("B", 100)]
+
+
+def test_same_group_runs_ordered_by_first_day() -> None:
+    rows = [
+        e(date(2026, 8, 5)),
+        e(date(2026, 9, 5)),
+        e(date(2026, 10, 5)),
+        e(date(2026, 1, 5)),
+        e(date(2026, 2, 5)),
+        e(date(2026, 3, 5)),
+    ]
+    firsts = [r.days[0] for r in find_recurring(rows)]
+    assert firsts == [date(2026, 1, 5), date(2026, 8, 5)]
