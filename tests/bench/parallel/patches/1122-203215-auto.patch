     def get_invalid_choice_message(self, value: t.Any, ctx: Context | None) -> str:
         """Get the error message when the given choice is invalid.
 
+        If the value is close to one or more choices, the message ends with a
+        "Did you mean ...?" suggestion.
+
         :param value: The invalid value.
 
+        .. versionchanged:: 8.6.0 Suggest close choices.
+
         .. versionadded:: 8.2
         """
-        choices_str = ", ".join(map(repr, self._normalized_mapping(ctx=ctx).values()))
-        return ngettext(
+        normalized = list(self._normalized_mapping(ctx=ctx).values())
+        choices_str = ", ".join(map(repr, normalized))
+        message = ngettext(
             "{value!r} is not {choice}.",
             "{value!r} is not one of {choices}.",
             len(self.choices),
         ).format(value=value, choice=choices_str, choices=choices_str)
 
+        from difflib import get_close_matches
+
+        normed_value = self.normalize_choice(choice=value, ctx=ctx)
+        possibilities = get_close_matches(normed_value, normalized)
+
+        if possibilities:
+            message = f"{message} {_format_possibilities(possibilities)}"
+
+        return message
+
     def __repr__(self) -> str:
         return _("Choice({choices})").format(choices=list(self.choices))
 
diff --git a/tests/test_types/test_Choice.py b/tests/test_types/test_Choice.py
index c34f516..09d9adb 100644
--- a/tests/test_types/test_Choice.py
+++ b/tests/test_types/test_Choice.py
@@ -1,3 +1,5 @@
+import enum
+
 import click
 
 
@@ -5,3 +7,69 @@ def test_choice_get_invalid_choice_message():
     choice = click.Choice(["a", "b", "c"])
     message = choice.get_invalid_choice_message("d", ctx=None)
     assert message == "'d' is not one of 'a', 'b', 'c'."
+
+
+def test_choice_suggests_single_close_match():
+    choice = click.Choice(["apple", "banana", "cherry"])
+    message = choice.get_invalid_choice_message("aple", ctx=None)
+    assert message == (
+        "'aple' is not one of 'apple', 'banana', 'cherry'. Did you mean 'apple'?"
+    )
+
+
+def test_choice_suggests_multiple_close_matches():
+    choice = click.Choice(["bound", "count", "bounty"])
+    message = choice.get_invalid_choice_message("bount", ctx=None)
+    assert message.endswith("(Did you mean one of: 'bound', 'bounty', 'count'?)")
+
+
+def test_choice_no_suggestion_when_nothing_is_close():
+    choice = click.Choice(["apple", "banana"])
+    message = choice.get_invalid_choice_message("zzz", ctx=None)
+    assert "Did you mean" not in message
+
+
+def test_choice_single_choice_uses_singular_message():
+    choice = click.Choice(["apple"])
+    message = choice.get_invalid_choice_message("aple", ctx=None)
+    assert message == "'aple' is not 'apple'. Did you mean 'apple'?"
+
+
+def test_choice_suggestion_is_case_insensitive_by_default():
+    choice = click.Choice(["Apple", "Banana"], case_sensitive=False)
+    message = choice.get_invalid_choice_message("APLE", ctx=None)
+    assert message.endswith("Did you mean 'apple'?")
+
+
+def test_choice_suggestion_case_sensitive():
+    choice = click.Choice(["Apple", "Banana"], case_sensitive=True)
+    message = choice.get_invalid_choice_message("Aple", ctx=None)
+    assert message.endswith("Did you mean 'Apple'?")
+
+
+def test_choice_suggestion_non_string_value():
+    choice = click.Choice(["10", "20"])
+    message = choice.get_invalid_choice_message(101, ctx=None)
+    assert message.endswith("Did you mean '10'?")
+
+
+def test_choice_suggestion_enum():
+    class Color(enum.Enum):
+        RED = 1
+        GREEN = 2
+
+    choice = click.Choice(Color)
+    message = choice.get_invalid_choice_message("GREN", ctx=None)
+    assert message.endswith("Did you mean 'GREEN'?")
+
+
+def test_choice_suggestion_in_cli_error(runner):
+    @click.command()
+    @click.option("--fruit", type=click.Choice(["apple", "banana"]))
+    def cli(fruit):
+        pass
+
+    result = runner.invoke(cli, ["--fruit", "banan"])
+    assert result.exit_code == 2
+    assert "Invalid value for '--fruit': 'banan' is not one of" in result.output
+    assert "Did you mean 'banana'?" in result.output
