index 0000000..af48d2d
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,111 @@
+"""Import bank statement CSV text into Expense records (pure functions)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"-?[¥￥]?[0-9][0-9,]*円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    """Parse '-¥1,234円'-style amounts into int yen. Raises ValueError otherwise."""
+    text = s.strip()
+    if not _AMOUNT_RE.fullmatch(text):
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    digits = text.replace("¥", "").replace("￥", "").replace("円", "").replace(",", "")
+    return int(digits)
+
+
+def parse_date(s: str) -> date:
+    """Parse 'YYYY/M/D' or 'YYYY-M-D' (same separator). Raises ValueError otherwise."""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    year, _, month, day = m.groups()
+    return date(int(year), int(month), int(day))  # raises ValueError if nonexistent
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Convert CSV text (header on line 1) to (expenses, errors).
+
+    errors are (physical line number, field name) with field in
+    {"date", "amount", "category"}. Rows with any error are excluded.
+    """
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    try:
+        header = next(reader)
+    except StopIteration:
+        raise ValueError("ヘッダー行がありません") from None
+
+    index: dict[str, int] = {}
+    for field, column in mapping.items():
+        if column not in header:
+            raise ValueError(f"列 {column!r} がヘッダーにありません")
+        index[field] = header.index(column)
+    has_memo = "memo" in index
+
+    def cell(row: list[str], field: str) -> str:
+        i = index.get(field)
+        if i is None or i >= len(row):
+            return ""
+        return row[i]
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    while True:
+        line_no = reader.line_num + 1  # physical line where the next record starts
+        try:
+            row = next(reader)
+        except StopIteration:
+            break
+        if not any(c.strip() for c in row):
+            continue  # blank line: skipped, but still counted in line numbers
+
+        row_errors: list[tuple[int, str]] = []
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(cell(row, "date"))
+        except ValueError:
+            row_errors.append((line_no, "date"))
+        try:
+            amount = parse_amount(cell(row, "amount"))
+        except ValueError:
+            row_errors.append((line_no, "amount"))
+        category = cell(row, "category").strip()
+        if not category:
+            row_errors.append((line_no, "category"))
+
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        assert day is not None and amount is not None
+        if category_map and category in category_map:
+            category = category_map[category]
+        memo = cell(row, "memo").strip() if has_memo else ""
+        expenses.append(Expense(day=day, category=category, amount=amount, memo=memo))
+
+    return expenses, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
