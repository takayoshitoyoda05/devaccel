@@ -0,0 +1,271 @@
+"""Import bank / card statement CSV text into Expense records.
+
+Pure function: takes the CSV text, returns the rows that parsed cleanly plus
+a list of per-row errors. Never raises for bad data and never touches files.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_UNCATEGORIZED = "未分類"
+
+_ALIASES: dict[str, tuple[str, ...]] = {
+    "date": ("date", "日付", "利用日", "取引日", "ご利用日", "年月日"),
+    "amount": ("amount", "金額", "利用金額", "ご利用金額", "支払金額"),
+    "withdraw": ("出金", "出金額", "お支払い金額", "支払"),
+    "deposit": ("入金", "入金額", "預入"),
+    "memo": ("memo", "description", "摘要", "メモ", "利用店名", "ご利用店名", "内容"),
+    "category": ("category", "カテゴリ", "分類", "費目"),
+}
+
+_DATE_PATTERNS = (
+    re.compile(
+        r"(?P<y>[0-9]{4})(?P<sep>[-/.])(?P<m>[0-9]{1,2})(?P=sep)(?P<d>[0-9]{1,2})"
+    ),
+    re.compile(r"(?P<y>[0-9]{4})(?P<m>[0-9]{2})(?P<d>[0-9]{2})"),
+    re.compile(r"(?P<y>[0-9]{4})年(?P<m>[0-9]{1,2})月(?P<d>[0-9]{1,2})日"),
+)
+_TIME_SUFFIX = re.compile(
+    r" [0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?|T[0-9]{1,2}:[0-9]{2}:[0-9]{2}"
+)
+_POSITIVE = re.compile(r"[0-9]+")
+_NEGATIVE = re.compile(r"[-−△▲]([0-9]+)|\(([0-9]+)\)|([0-9]+)-")
+_CURRENCY = re.compile(r"¥|￥|円|JPY", re.IGNORECASE)
+_BLANK_MARKERS = frozenset({"", "-", "—"})
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str
+    value: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+    skipped: int
+
+
+def _key(name: str) -> str:
+    return unicodedata.normalize("NFKC", name).strip().casefold()
+
+
+_KEY_TO_ROLE = {
+    _key(alias): role for role, aliases in _ALIASES.items() for alias in aliases
+}
+
+
+def _normalize_money(raw: str) -> str:
+    """NFKC, then drop currency marks, thousands separators and all whitespace."""
+    s = unicodedata.normalize("NFKC", raw)
+    s = _CURRENCY.sub("", s).replace(",", "")
+    return re.sub(r"\s", "", s)
+
+
+def _is_blank_money(raw: str) -> bool:
+    return _normalize_money(raw) in _BLANK_MARKERS
+
+
+def _parse_date(raw: str) -> date:
+    s = unicodedata.normalize("NFKC", raw).strip()
+    s = _TIME_SUFFIX.sub("", s)
+    for pattern in _DATE_PATTERNS:
+        m = pattern.fullmatch(s)
+        if m:
+            try:
+                return date(int(m.group("y")), int(m.group("m")), int(m.group("d")))
+            except ValueError:
+                raise ValueError("存在しない日付です") from None
+    raise ValueError("日付の形式が不正です")
+
+
+def _parse_money(raw: str) -> int:
+    s = _normalize_money(raw)
+    if _POSITIVE.fullmatch(s):
+        return int(s)
+    m = _NEGATIVE.fullmatch(s)
+    if m:
+        digits = next(g for g in m.groups() if g is not None)
+        return -int(digits)
+    raise ValueError("金額が整数ではありません")
+
+
+def _detect_delimiter(text: str) -> str:
+    first_line = re.split(r"\r\n|\r|\n", text, maxsplit=1)[0]
+    return "\t" if first_line.count("\t") > first_line.count(",") else ","
+
+
+def _read_records(
+    text: str, delimiter: str
+) -> tuple[list[tuple[int, list[str]]], RowError | None]:
+    """(start_line, row) per CSV record. A CSV syntax error stops reading."""
+    records: list[tuple[int, list[str]]] = []
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delimiter)
+    prev_line = 0
+    try:
+        for row in reader:
+            records.append((prev_line + 1, row))
+            prev_line = reader.line_num
+    except csv.Error as e:
+        return records, RowError(
+            prev_line + 1, "(行)", "", f"CSV として読めません: {e}"
+        )
+    return records, None
+
+
+def _is_blank_row(row: list[str]) -> bool:
+    return all(cell.strip() == "" for cell in row)
+
+
+def _cell(row: list[str], columns: dict[str, int], role: str) -> str | None:
+    """Value of the role's column, or None if the column or the cell is absent."""
+    idx = columns.get(role)
+    if idx is None or idx >= len(row):
+        return None
+    return row[idx]
+
+
+def import_statement(text: str) -> ImportResult:
+    text = text.removeprefix("﻿")
+    if not text.strip():
+        return ImportResult([], [], 0)
+
+    delimiter = _detect_delimiter(text)
+    records, read_error = _read_records(text, delimiter)
+    errors: list[RowError] = [read_error] if read_error else []
+
+    # ヘッダーは最初の空でない行。その前の空行は数えない。
+    header: list[str] | None = None
+    body: list[tuple[int, list[str]]] = []
+    for line, row in records:
+        if header is None:
+            if not _is_blank_row(row):
+                header = row
+        else:
+            body.append((line, row))
+
+    if header is None or not body:
+        return ImportResult([], errors, 0)
+
+    # 列の役割 -> ヘッダー上の位置(同じ役割が複数あれば先頭を使う)
+    columns: dict[str, int] = {}
+    for idx, name in enumerate(header):
+        role = _KEY_TO_ROLE.get(_key(name))
+        if role is not None and role not in columns:
+            columns[role] = idx
+
+    header_errors: list[RowError] = []
+    if "date" not in columns:
+        header_errors.append(RowError(1, "日付", "", "日付列がありません"))
+    if not {"amount", "withdraw", "deposit"} & columns.keys():
+        header_errors.append(
+            RowError(1, "金額", "", "金額または出金/入金の列がありません")
+        )
+    if header_errors:
+        return ImportResult([], errors + header_errors, 0)
+
+    def header_name(role: str) -> str:
+        return header[columns[role]].strip()
+
+    expenses: list[Expense] = []
+    skipped = 0
+    for line, row in body:
+        if _is_blank_row(row):
+            skipped += 1
+            continue
+
+        row_errors: list[RowError] = []
+
+        # 列数(R7)
+        for idx, name in enumerate(header):
+            if idx >= len(row):
+                row_errors.append(RowError(line, name.strip(), "", "列がありません"))
+        if len(row) > len(header):
+            extra = row[len(header) :]
+            row_errors.append(
+                RowError(
+                    line, "(列数)", delimiter.join(extra), "列数がヘッダーより多いです"
+                )
+            )
+
+        # 金額(R4, R5, D1)。出金/入金の両方が空の行は誤りではなく skipped。
+        amount: int | None = None
+        if "amount" in columns:
+            raw = _cell(row, columns, "amount")
+            if raw is not None:
+                if _is_blank_money(raw):
+                    row_errors.append(
+                        RowError(line, header_name("amount"), raw, "金額がありません")
+                    )
+                else:
+                    try:
+                        amount = _parse_money(raw)
+                    except ValueError as e:
+                        row_errors.append(
+                            RowError(line, header_name("amount"), raw, str(e))
+                        )
+        else:
+            w_raw = _cell(row, columns, "withdraw") or ""
+            d_raw = _cell(row, columns, "deposit") or ""
+            w_blank = _is_blank_money(w_raw)
+            d_blank = _is_blank_money(d_raw)
+            if w_blank and d_blank:
+                if not row_errors:
+                    skipped += 1
+                    continue
+            elif not w_blank and not d_blank:
+                row_errors.append(RowError(line, "出金/入金", "", "両方に値があります"))
+            elif not w_blank:
+                try:
+                    amount = _parse_money(w_raw)
+                except ValueError as e:
+                    row_errors.append(
+                        RowError(line, header_name("withdraw"), w_raw, str(e))
+                    )
+            else:
+                try:
+                    amount = -abs(_parse_money(d_raw))
+                except ValueError as e:
+                    row_errors.append(
+                        RowError(line, header_name("deposit"), d_raw, str(e))
+                    )
+
+        # 日付(R3)
+        day: date | None = None
+        date_raw = _cell(row, columns, "date")
+        if date_raw is not None:
+            if date_raw.strip() == "":
+                row_errors.append(
+                    RowError(line, header_name("date"), date_raw, "日付がありません")
+                )
+            else:
+                try:
+                    day = _parse_date(date_raw)
+                except ValueError as e:
+                    row_errors.append(
+                        RowError(line, header_name("date"), date_raw, str(e))
+                    )
+
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        if day is None or amount is None:
+            # 列が無い行は上の列数エラーで既に弾かれている。
+            continue
+
+        category = (_cell(row, columns, "category") or "").strip() or _UNCATEGORIZED
+        memo = (_cell(row, columns, "memo") or "").strip()
+        expenses.append(Expense(day=day, category=category, amount=amount, memo=memo))
+
+    return ImportResult(expenses, errors, skipped)
