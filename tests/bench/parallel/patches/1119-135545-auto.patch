+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthly_diff import CategoryDiff, compare_months
+
+
+def _e(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+# E4-1: 食費 前月 0 円・今月 3000 円 -> delta=3000, ratio=None, trend="up"
+def test_E4_1_prev_zero_gives_none_ratio() -> None:
+    rows = [_e("2026-03-05", "食費", 3000)]
+    [d] = compare_months(rows, "2026-03", "2026-02")
+    assert d == CategoryDiff(
+        category="食費",
+        prev_total=0,
+        total=3000,
+        delta=3000,
+        ratio=None,
+        trend="up",
+    )
+
+
+# E4-2: month="2026-01", prev=None -> 比較先は 2025-12
+def test_E4_2_prev_none_uses_previous_month_across_year() -> None:
+    rows = [
+        _e("2025-12-10", "食費", 1000),
+        _e("2026-01-10", "食費", 2500),
+    ]
+    [d] = compare_months(rows, "2026-01")
+    assert d.prev_total == 1000
+    assert d.total == 2500
+    assert d.delta == 1500
+    assert d.ratio == 1.5
+
+
+# E4-3: 同額のカテゴリ -> trend="same"
+def test_E4_3_equal_amounts_are_same() -> None:
+    rows = [
+        _e("2026-02-01", "食費", 1000),
+        _e("2026-03-01", "食費", 1000),
+    ]
+    [d] = compare_months(rows, "2026-03", "2026-02")
+    assert d.delta == 0
+    assert d.trend == "same"
+    assert d.ratio == 0.0
+
+
+@pytest.mark.parametrize(
+    "month",
+    ["2026-1", "2026-13", "2026-00", "26-01", "2026/01", "", "2026-01-01"],
+    ids=[
+        "short-month",
+        "month13",
+        "month00",
+        "short-year",
+        "slash",
+        "empty",
+        "with-day",
+    ],
+)
+def test_invalid_month_raises(month: str) -> None:
+    with pytest.raises(ValueError):
+        compare_months([], month)
+
+
+def test_invalid_prev_raises() -> None:
+    with pytest.raises(ValueError):
+        compare_months([], "2026-03", "bad")
+
+
+def test_no_rows_returns_empty_list() -> None:
+    assert compare_months([], "2026-03", "2026-02") == []
+
+
+def test_categories_only_in_one_month_are_included() -> None:
+    rows = [
+        _e("2026-02-01", "交通", 400),
+        _e("2026-03-01", "医療", 900),
+    ]
+    result = compare_months(rows, "2026-03", "2026-02")
+    by_cat = {d.category: d for d in result}
+    assert set(by_cat) == {"交通", "医療"}
+    assert by_cat["交通"].total == 0
+    assert by_cat["交通"].delta == -400
+    assert by_cat["交通"].ratio == -1.0
+    assert by_cat["交通"].trend == "down"
+    assert by_cat["医療"].prev_total == 0
+    assert by_cat["医療"].ratio is None
+    assert by_cat["医療"].trend == "up"
+
+
+def test_refunds_are_netted_into_total() -> None:
+    rows = [
+        _e("2026-02-01", "食費", 1000),
+        _e("2026-03-01", "食費", 1500),
+        _e("2026-03-02", "食費", -500),
+    ]
+    [d] = compare_months(rows, "2026-03", "2026-02")
+    assert d.total == 1000
+    assert d.delta == 0
+    assert d.trend == "same"
+
+
+def test_sorted_by_abs_delta_desc_then_category_asc() -> None:
+    rows = [
+        _e("2026-02-01", "A", 1000),
+        _e("2026-03-01", "A", 1000),  # delta 0
+        _e("2026-03-01", "B", 300),  # delta 300
+        _e("2026-03-01", "C", -300),  # delta -300
+        _e("2026-03-01", "D", 2000),  # delta 2000
+    ]
+    result = compare_months(rows, "2026-03", "2026-02")
+    assert [d.category for d in result] == ["D", "B", "C", "A"]
+
+
+def test_same_month_comparison_is_all_same() -> None:
+    rows = [_e("2026-03-01", "食費", 700)]
+    [d] = compare_months(rows, "2026-03", "2026-03")
+    assert d.delta == 0
+    assert d.trend == "same"
