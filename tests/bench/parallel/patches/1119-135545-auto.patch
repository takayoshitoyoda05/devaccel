+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import find_recurring
+
+
+def e(d: str, category: str, amount: int, memo: str) -> Expense:
+    return Expense(
+        day=date.fromisoformat(d), category=category, amount=amount, memo=memo
+    )
+
+
+def test_E2_1_rent_next_date_clamped_to_month_end() -> None:
+    """E2-1: 家賃 1/31 2/28 3/31 -> next_date 2026-04-30 (R4)."""
+    rows = [
+        e("2026-01-31", "住居", 80000, "家賃"),
+        e("2026-02-28", "住居", 80000, "家賃"),
+        e("2026-03-31", "住居", 80000, "家賃"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_date == date(2026, 4, 30)
+    assert result[0].amount == 80000
+    assert result[0].dates == (date(2026, 1, 31), date(2026, 2, 28), date(2026, 3, 31))
+
+
+def test_E2_2_price_change_splits_series_below_min_count() -> None:
+    """E2-2: 配信 980/980/1080 -> [] with min_count=3 (R2)."""
+    rows = [
+        e("2026-01-05", "通信", 980, "配信"),
+        e("2026-02-05", "通信", 980, "配信"),
+        e("2026-03-05", "通信", 1080, "配信"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_E2_3_memo_suffix_normalized_into_one_series() -> None:
+    """E2-3: memo "ジム 1月分" "ジム 2月分" "ジム 3月分" -> 1 series (R1)."""
+    rows = [
+        e("2026-01-10", "健康", 5000, "ジム 1月分"),
+        e("2026-02-10", "健康", 5000, "ジム 2月分"),
+        e("2026-03-10", "健康", 5000, "ジム 3月分"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_date == date(2026, 4, 10)
+
+
+@pytest.mark.parametrize(
+    "rows, expected_count",
+    [
+        pytest.param(
+            [
+                e("2026-01-01", "a", 100, "x"),
+                e("2026-02-01", "a", 100, "x"),
+                e("2026-03-01", "a", 100, "x"),
+            ],
+            1,
+            id="R3-consecutive",
+        ),
+        pytest.param(
+            [
+                e("2026-01-01", "a", 100, "x"),
+                e("2026-03-01", "a", 100, "x"),
+                e("2026-04-01", "a", 100, "x"),
+            ],
+            1,
+            id="R3-one-gap-allowed",
+        ),
+        pytest.param(
+            [
+                e("2026-01-01", "a", 100, "x"),
+                e("2026-03-01", "a", 100, "x"),
+                e("2026-05-01", "a", 100, "x"),
+            ],
+            0,
+            id="R3-two-gaps-rejected",
+        ),
+        pytest.param(
+            [
+                e("2026-01-01", "a", 100, "x"),
+                e("2026-01-20", "a", 100, "x"),
+                e("2026-02-01", "a", 100, "x"),
+            ],
+            0,
+            id="R3-same-month-counts-once",
+        ),
+        pytest.param(
+            [
+                e("2026-01-01", "a", 0, "x"),
+                e("2026-02-01", "a", 100, "x"),
+                e("2026-03-01", "a", 100, "x"),
+            ],
+            0,
+            id="R2-zero-ignored",
+        ),
+        pytest.param(
+            [
+                e("2026-01-01", "a", -100, "x"),
+                e("2026-02-01", "a", 100, "x"),
+                e("2026-03-01", "a", 100, "x"),
+            ],
+            0,
+            id="R2-refund-ignored",
+        ),
+        pytest.param(
+            [
+                e("2026-01-01", "a", 1000, "x"),
+                e("2026-02-01", "a", 1100, "x"),
+                e("2026-03-01", "a", 1000, "x"),
+            ],
+            1,
+            id="D3-within-10-percent",
+        ),
+        pytest.param(
+            [
+                e("2026-01-01", "a", 1000, "x"),
+                e("2026-02-01", "a", 1101, "x"),
+                e("2026-03-01", "a", 1000, "x"),
+            ],
+            0,
+            id="D3-outside-10-percent-split",
+        ),
+    ],
+)
+def test_repeat_rules(rows: list[Expense], expected_count: int) -> None:
+    assert len(find_recurring(rows)) == expected_count
+
+
+def test_min_count_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+def test_results_sorted_by_next_date_then_amount_desc() -> None:
+    rows = [
+        e("2026-01-15", "b", 300, "y"),
+        e("2026-02-15", "b", 300, "y"),
+        e("2026-03-15", "b", 300, "y"),
+        e("2026-01-15", "a", 500, "x"),
+        e("2026-02-15", "a", 500, "x"),
+        e("2026-03-15", "a", 500, "x"),
+        e("2026-01-01", "c", 900, "z"),
+        e("2026-02-01", "c", 900, "z"),
+        e("2026-03-01", "c", 900, "z"),
+    ]
+    result = find_recurring(rows)
+    assert [(r.category, r.next_date) for r in result] == [
+        ("c", date(2026, 4, 1)),
+        ("a", date(2026, 4, 15)),
+        ("b", date(2026, 4, 15)),
+    ]
+
+
+def test_input_not_mutated() -> None:
+    rows = [
+        e("2026-01-01", "a", 100, "x"),
+        e("2026-02-01", "a", 100, "x"),
+        e("2026-03-01", "a", 100, "x"),
+    ]
+    snapshot = list(rows)
+    find_recurring(rows)
+    assert rows == snapshot
