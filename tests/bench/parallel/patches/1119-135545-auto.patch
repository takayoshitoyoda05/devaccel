+++ b/src/kakeibo/search.py
@@ -0,0 +1,63 @@
+"""Conditional search over Expense rows. Pure functions; inputs are never modified."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable
+from datetime import date
+
+from kakeibo.core import Expense
+
+Condition = Callable[[Expense], bool]
+
+
+def search(rows: list[Expense], cond: Condition) -> list[Expense]:
+    """Return the rows matching cond, in input order, as a new list."""
+    return [e for e in rows if cond(e)]
+
+
+def category(*names: str) -> Condition:
+    """Exact category match (surrounding whitespace ignored); multiple names are OR."""
+    if not names:
+        raise ValueError("category には 1 つ以上の名前が必要です")
+    wanted = frozenset(n.strip() for n in names)
+    return lambda e: e.category.strip() in wanted
+
+
+def _normalize(text: str) -> str:
+    return unicodedata.normalize("NFKC", text).lower()
+
+
+def memo_contains(text: str) -> Condition:
+    """Substring match after NFKC normalization and lowercasing. Empty text matches all."""
+    needle = _normalize(text)
+    return lambda e: needle in _normalize(e.memo)
+
+
+def amount_between(lo: int | None = None, hi: int | None = None) -> Condition:
+    """lo <= amount <= hi (inclusive). None means unbounded on that side."""
+    if lo is not None and hi is not None and lo > hi:
+        raise ValueError(f"金額の範囲が不正です: lo={lo} > hi={hi}")
+    return lambda e: (lo is None or e.amount >= lo) and (hi is None or e.amount <= hi)
+
+
+def between_dates(start: date | None = None, end: date | None = None) -> Condition:
+    """start <= day <= end (inclusive). None means unbounded on that side."""
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"期間の範囲が不正です: start={start} > end={end}")
+    return lambda e: (start is None or e.day >= start) and (end is None or e.day <= end)
+
+
+def all_of(*conds: Condition) -> Condition:
+    """AND of conditions. With no conditions, matches everything."""
+    return lambda e: all(c(e) for c in conds)
+
+
+def any_of(*conds: Condition) -> Condition:
+    """OR of conditions. With no conditions, matches nothing."""
+    return lambda e: any(c(e) for c in conds)
+
+
+def not_(cond: Condition) -> Condition:
+    """Negation of a condition."""
+    return lambda e: not cond(e)
