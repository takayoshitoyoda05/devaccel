@@ -0,0 +1,211 @@
+"""Tests for kakeibo.search."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    all_of,
+    amount_between,
+    any_of,
+    between_dates,
+    category,
+    memo_contains,
+    not_,
+    search,
+)
+
+
+def _e(
+    day: str = "2026-01-15",
+    cat: str = "食費",
+    amount: int = 100,
+    memo: str = "",
+) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=cat, amount=amount, memo=memo)
+
+
+# --- 例の表 (E3-*) ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("make_cond", "row", "expected"),
+    [
+        pytest.param(
+            lambda: memo_contains("ｎｅｔ"), _e(memo="NETFLIX"), True, id="E3-1"
+        ),
+        pytest.param(lambda: amount_between(100, 100), _e(amount=100), True, id="E3-2"),
+        pytest.param(lambda: any_of(), _e(), False, id="E3-3"),
+    ],
+)
+def test_example_table(make_cond, row: Expense, expected: bool) -> None:
+    cond = make_cond()
+    assert cond(row) is expected
+    assert search([row], cond) == ([row] if expected else [])
+
+
+# --- R1 category ----------------------------------------------------------
+
+
+def test_category_matches_exact_name() -> None:
+    assert category("食費")(_e(cat="食費"))
+
+
+def test_category_is_not_substring_match() -> None:
+    assert not category("食")(_e(cat="食費"))
+
+
+def test_category_ignores_surrounding_whitespace() -> None:
+    assert category("  食費 ")(_e(cat="食費"))
+
+
+def test_category_multiple_names_is_or() -> None:
+    cond = category("食費", "日用品")
+    assert cond(_e(cat="日用品"))
+    assert cond(_e(cat="食費"))
+    assert not cond(_e(cat="交通費"))
+
+
+def test_category_without_names_raises() -> None:
+    with pytest.raises(ValueError):
+        category()
+
+
+# --- R2 memo_contains -----------------------------------------------------
+
+
+def test_memo_contains_empty_matches_everything() -> None:
+    cond = memo_contains("")
+    assert cond(_e(memo=""))
+    assert cond(_e(memo="anything"))
+
+
+def test_memo_contains_is_case_insensitive() -> None:
+    assert memo_contains("netflix")(_e(memo="NetFlix plan"))
+
+
+def test_memo_contains_is_partial_match() -> None:
+    assert memo_contains("flix")(_e(memo="NETFLIX"))
+    assert not memo_contains("hulu")(_e(memo="NETFLIX"))
+
+
+def test_memo_contains_nfkc_normalizes_both_sides() -> None:
+    assert memo_contains("ＮＥＴ")(_e(memo="net"))
+    assert memo_contains("net")(_e(memo="ＮＥＴ"))
+
+
+# --- R3 amount_between / between_dates -----------------------------------
+
+
+def test_amount_between_is_inclusive_on_both_ends() -> None:
+    cond = amount_between(100, 200)
+    assert cond(_e(amount=100))
+    assert cond(_e(amount=200))
+    assert not cond(_e(amount=99))
+    assert not cond(_e(amount=201))
+
+
+def test_amount_between_open_lower_bound() -> None:
+    cond = amount_between(None, 500)
+    assert cond(_e(amount=-(10**9)))
+    assert cond(_e(amount=500))
+    assert not cond(_e(amount=501))
+
+
+def test_amount_between_open_upper_bound() -> None:
+    cond = amount_between(500, None)
+    assert cond(_e(amount=500))
+    assert not cond(_e(amount=499))
+    assert cond(_e(amount=10**9))
+
+
+def test_amount_between_both_open_matches_all() -> None:
+    cond = amount_between()
+    assert cond(_e(amount=-1))
+    assert cond(_e(amount=0))
+
+
+def test_amount_between_lo_greater_than_hi_raises() -> None:
+    with pytest.raises(ValueError):
+        amount_between(200, 100)
+
+
+def test_between_dates_is_inclusive_on_both_ends() -> None:
+    cond = between_dates(date(2026, 1, 1), date(2026, 1, 31))
+    assert cond(_e(day="2026-01-01"))
+    assert cond(_e(day="2026-01-31"))
+    assert not cond(_e(day="2025-12-31"))
+    assert not cond(_e(day="2026-02-01"))
+
+
+def test_between_dates_open_sides() -> None:
+    assert between_dates(start=date(2026, 1, 1))(_e(day="2030-01-01"))
+    assert not between_dates(start=date(2026, 1, 1))(_e(day="2025-12-31"))
+    assert between_dates(end=date(2026, 1, 1))(_e(day="1999-01-01"))
+    assert not between_dates(end=date(2026, 1, 1))(_e(day="2026-01-02"))
+
+
+def test_between_dates_start_after_end_raises() -> None:
+    with pytest.raises(ValueError):
+        between_dates(date(2026, 2, 1), date(2026, 1, 1))
+
+
+# --- R4 combinators -------------------------------------------------------
+
+
+def test_all_of_empty_matches_everything() -> None:
+    assert all_of()(_e())
+
+
+def test_all_of_requires_every_condition() -> None:
+    cond = all_of(category("食費"), amount_between(100, None))
+    assert cond(_e(cat="食費", amount=100))
+    assert not cond(_e(cat="食費", amount=99))
+    assert not cond(_e(cat="交通費", amount=100))
+
+
+def test_any_of_matches_when_one_condition_matches() -> None:
+    cond = any_of(category("食費"), memo_contains("電車"))
+    assert cond(_e(cat="食費"))
+    assert cond(_e(cat="交通費", memo="電車"))
+    assert not cond(_e(cat="交通費", memo="バス"))
+
+
+def test_not_inverts_condition() -> None:
+    cond = not_(category("食費"))
+    assert not cond(_e(cat="食費"))
+    assert cond(_e(cat="交通費"))
+
+
+def test_nested_combinators() -> None:
+    cond = all_of(
+        any_of(category("食費"), category("日用品")), not_(amount_between(1000, None))
+    )
+    assert cond(_e(cat="日用品", amount=999))
+    assert not cond(_e(cat="日用品", amount=1000))
+    assert not cond(_e(cat="交通費", amount=10))
+
+
+# --- R5 search ------------------------------------------------------------
+
+
+def test_search_preserves_input_order() -> None:
+    rows = [_e(amount=3), _e(amount=1), _e(amount=2)]
+    out = search(rows, amount_between(None, None))
+    assert [e.amount for e in out] == [3, 1, 2]
+
+
+def test_search_returns_new_list_and_leaves_input_unchanged() -> None:
+    rows = [_e(amount=1), _e(amount=2)]
+    snapshot = list(rows)
+    out = search(rows, amount_between(2, None))
+    assert out is not rows
+    assert out == [rows[1]]
+    assert rows == snapshot
+
+
+def test_search_empty_input_returns_empty() -> None:
+    assert search([], all_of()) == []
