+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import ImportResult, import_statement
+from kakeibo.core import Expense
+
+
+def _locs(errors: list) -> list[tuple[int, str, str]]:
+    return [(e.line, e.column, e.value) for e in errors]
+
+
+# 例の表 E1 の全行(ID はテストに直接書く)
+@pytest.mark.parametrize(
+    ("text", "expenses", "errors", "skipped"),
+    [
+        pytest.param(
+            '利用日,ご利用店名,利用金額\n2026/1/5,カフェ,"1,234円"',
+            [Expense(date(2026, 1, 5), "未分類", 1234, "カフェ")],
+            [],
+            0,
+            id="E1-1",
+        ),
+        pytest.param(
+            "日付,出金,入金\n2026-01-05,,５００",
+            [Expense(date(2026, 1, 5), "未分類", -500, "")],
+            [],
+            0,
+            id="E1-2",
+        ),
+        pytest.param(
+            "date,amount\n2026-02-30,100\n2026-01-01,12.5",
+            [],
+            [(2, "date", "2026-02-30"), (3, "amount", "12.5")],
+            0,
+            id="E1-3",
+        ),
+    ],
+)
+def test_spec_examples(
+    text: str,
+    expenses: list[Expense],
+    errors: list[tuple[int, str, str]],
+    skipped: int,
+) -> None:
+    result = import_statement(text)
+    assert isinstance(result, ImportResult)
+    assert result.expenses == expenses
+    assert _locs(result.errors) == errors
+    assert result.skipped == skipped
+
+
+# D1: 符号表記はすべて負(返金)として受け、拒否しない
+@pytest.mark.parametrize(
+    "raw",
+    ["-300", "−300", "△500", "▲500", "(500)", "500-"],
+    ids=["hyphen", "minus-sign", "triangle", "black-triangle", "parens", "trailing"],
+)
+def test_sign_notations_are_negative(raw: str) -> None:
+    text = f"日付,金額\n2026-01-05,{raw}"
+    result = import_statement(text)
+    assert result.errors == []
+    assert [e.amount for e in result.expenses] == [-300 if "300" in raw else -500]
+
+
+# R6: 必須列が無ければ errors に 1 件返し、expenses は空
+def test_missing_required_columns_reported_on_line_1() -> None:
+    result = import_statement("メモ,カテゴリ\nカフェ,食費")
+    assert result.expenses == []
+    assert _locs(result.errors) == [(1, "日付", ""), (1, "金額", "")]
+
+
+# R6: 空入力・ヘッダーのみは空の結果
+@pytest.mark.parametrize("text", ["", "日付,金額\n"], ids=["empty", "header-only"])
+def test_empty_or_header_only_returns_empty_result(text: str) -> None:
+    assert import_statement(text) == ImportResult([], [], 0)
