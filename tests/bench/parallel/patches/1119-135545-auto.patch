@@ -0,0 +1,71 @@
+"""Month-over-month comparison per category. Pure functions; inputs are not mutated."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryDiff:
+    category: str
+    prev_total: int
+    total: int
+    delta: int
+    ratio: float | None
+    trend: str  # "up" | "down" | "same"
+
+
+def _check_month(month: str) -> tuple[int, int]:
+    if not isinstance(month, str) or not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+    return int(month[:4]), int(month[5:])
+
+
+def _previous_month(month: str) -> str:
+    year, mon = _check_month(month)
+    if mon == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mon - 1:02d}"
+
+
+def _totals(rows: list[Expense], month: str) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for e in rows:
+        if e.day.strftime("%Y-%m") == month:
+            out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def compare_months(
+    rows: list[Expense], month: str, prev: str | None = None
+) -> list[CategoryDiff]:
+    _check_month(month)
+    if prev is None:
+        prev = _previous_month(month)
+    else:
+        _check_month(prev)
+
+    cur = _totals(rows, month)
+    before = _totals(rows, prev)
+
+    result: list[CategoryDiff] = []
+    for cat in set(cur) | set(before):
+        prev_total = before.get(cat, 0)
+        total = cur.get(cat, 0)
+        delta = total - prev_total
+        ratio = delta / prev_total if prev_total > 0 else None
+        if delta > 0:
+            trend = "up"
+        elif delta < 0:
+            trend = "down"
+        else:
+            trend = "same"
+        result.append(CategoryDiff(cat, prev_total, total, delta, ratio, trend))
+
+    result.sort(key=lambda d: (-abs(d.delta), d.category))
+    return result
