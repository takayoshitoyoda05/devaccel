+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,104 @@
+"""Detect recurring (fixed) expenses and predict the next occurrence.
+
+Pure functions: the input list is never modified.
+"""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from calendar import monthrange
+from collections import Counter
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+# 末尾の番号・年月(例: "#3" "2026-01" "1月分" "2026年1月分")
+_TRAILING_RE = re.compile(
+    r"(#\d+|\d{4}[-/]\d{1,2}|\d{4}年\d{1,2}月分?|\d{1,2}月分?|\d+)$"
+)
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int
+    dates: tuple[date, ...]
+    next_date: date
+
+
+def _normalize_memo(memo: str) -> str:
+    s = unicodedata.normalize("NFKC", memo).lower()
+    s = re.sub(r"\s+", "", s)
+    while True:
+        stripped = _TRAILING_RE.sub("", s)
+        if stripped == s:
+            return s
+        s = stripped
+
+
+def _mode(amounts: list[int]) -> int:
+    """最頻値。同数なら大きい方。"""
+    counts = Counter(amounts)
+    return max(counts.items(), key=lambda kv: (kv[1], kv[0]))[0]
+
+
+def _cluster(items: list[Expense]) -> list[list[Expense]]:
+    """金額が最頻値の ±10% 以内なら同じ系列にまとめる(D3)。"""
+    remaining = sorted(items, key=lambda e: (e.day, e.amount, e.memo))
+    out: list[list[Expense]] = []
+    while remaining:
+        m = _mode([e.amount for e in remaining])
+        near = [e for e in remaining if abs(e.amount - m) * 10 <= m]
+        remaining = [e for e in remaining if abs(e.amount - m) * 10 > m]
+        out.append(near)
+    return out
+
+
+def find_recurring(rows: list[Expense], min_count: int = 3) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError("min_count は 2 以上である必要があります")
+
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        if e.amount <= 0:  # R2: 返金・0 円は無視
+            continue
+        groups.setdefault((e.category, _normalize_memo(e.memo)), []).append(e)
+
+    results: list[Recurring] = []
+    for (category, _key), items in groups.items():
+        for cluster in _cluster(items):
+            # R3: 同じ月は最も早い日だけ数える
+            by_month: dict[int, Expense] = {}
+            for e in sorted(cluster, key=lambda e: (e.day, e.amount, e.memo)):
+                by_month.setdefault(e.day.year * 12 + e.day.month - 1, e)
+            months = sorted(by_month)
+            if len(months) < min_count:
+                continue
+            span = months[-1] - months[0] + 1
+            if span - len(months) > 1:  # 欠けた月は 1 つまで許す
+                continue
+
+            dates = tuple(by_month[m].day for m in months)
+            days = sorted(d.day for d in dates)
+            median_day = days[(len(days) - 1) // 2]  # R4/D4: 下側の中央値
+
+            next_idx = months[-1] + 1
+            ny, nm = divmod(next_idx, 12)
+            nm += 1
+            next_date = date(ny, nm, min(median_day, monthrange(ny, nm)[1]))
+
+            results.append(
+                Recurring(
+                    category=category,
+                    memo=min(cluster, key=lambda e: (e.day, e.amount, e.memo)).memo,
+                    amount=_mode([e.amount for e in cluster]),
+                    dates=dates,
+                    next_date=next_date,
+                )
+            )
+
+    results.sort(key=lambda r: (r.next_date, -r.amount, r.category, r.memo))
+    return results
