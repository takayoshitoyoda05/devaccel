@@ -1049,6 +1049,14 @@ class Path(ParamType[_PathT_co, str | os.PathLike[str]], t.Generic[_PathT_co]):
     :param path_type: Convert the incoming path value to this type. If
         ``None``, keep Python's default, which is ``str``. Useful to
         convert to :class:`pathlib.Path`.
+    :param extensions: Only accept values whose name ends with one of
+        these extensions, compared case-insensitively. A leading dot is
+        optional, and multi-part extensions such as ``.tar.gz`` work. The
+        check does not require the path to exist. A single dash allowed by
+        ``allow_dash`` is not checked.
+
+    .. versionchanged:: 8.6
+        Added the ``extensions`` parameter.
 
     .. versionchanged:: 8.5.1
         Reveal the actual type of the value as converted from raw input.
@@ -1086,6 +1094,7 @@ class Path(ParamType[_PathT_co, str | os.PathLike[str]], t.Generic[_PathT_co]):
         allow_dash: bool = False,
         path_type: type[_PathT_co] | None = None,
         executable: bool = False,
+        extensions: cabc.Iterable[str] | None = None,
     ) -> None:
         self.exists = exists
         self.file_okay = file_okay
@@ -1096,6 +1105,23 @@ class Path(ParamType[_PathT_co, str | os.PathLike[str]], t.Generic[_PathT_co]):
         self.resolve_path = resolve_path
         self.allow_dash = allow_dash
         self.type: type[_PathT_co] | None = path_type
+        self.extensions: tuple[str, ...] | None = None
+
+        if extensions is not None:
+            if isinstance(extensions, str):
+                extensions = [extensions]
+
+            normalized = []
+
+            for ext in extensions:
+                ext = ext.casefold()
+
+                if not ext.lstrip("."):
+                    raise ValueError("An extension must not be empty.")
+
+                normalized.append(ext if ext.startswith(".") else f".{ext}")
+
+            self.extensions = tuple(normalized)
 
         if self.file_okay and not self.dir_okay:
             self.name = _("file")
