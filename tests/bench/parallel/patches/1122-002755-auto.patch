diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..56783af 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -188,3 +188,118 @@ def test_path_type(runner, cls, expect):
 
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["a.csv", "a.tsv", "A.CSV", "dir/a.Tsv", "a.b.csv", ".csv"],
+)
+def test_path_extensions_accepted(value):
+    type = click.Path(extensions=[".csv", ".tsv"])
+    assert type.convert(value, None, None) == value
+
+
+@pytest.mark.parametrize("value", ["a.txt", "csv", "a.csv.bak", "a", "a.csvx", ""])
+def test_path_extensions_rejected(value):
+    type = click.Path(extensions=[".csv", ".tsv"])
+
+    with pytest.raises(click.BadParameter, match="must have one of the extensions"):
+        type.convert(value, None, None)
+
+
+def test_path_extensions_message_lists_normalized():
+    type = click.Path(extensions=["CSV", ".TSV"])
+
+    with pytest.raises(click.BadParameter, match=r"\.csv, \.tsv"):
+        type.convert("a.txt", None, None)
+
+
+def test_path_extensions_leading_dot_optional_and_case_insensitive():
+    type = click.Path(extensions=["CSV"])
+    assert type.convert("x.csv", None, None) == "x.csv"
+    assert type.convert("x.CsV", None, None) == "x.CsV"
+
+
+def test_path_extensions_single_string():
+    type = click.Path(extensions="csv")
+    assert type.convert("x.csv", None, None) == "x.csv"
+
+    with pytest.raises(click.BadParameter):
+        type.convert("x.tsv", None, None)
+
+
+def test_path_extensions_multi_part():
+    type = click.Path(extensions=[".tar.gz"])
+    assert type.convert("a.TAR.GZ", None, None) == "a.TAR.GZ"
+
+    with pytest.raises(click.BadParameter):
+        type.convert("a.gz", None, None)
+
+
+@pytest.mark.parametrize("bad", [[""], ["."], [".csv", ""]])
+def test_path_extensions_empty_rejected(bad):
+    with pytest.raises(ValueError, match="empty"):
+        click.Path(extensions=bad)
+
+
+def test_path_extensions_empty_collection_rejects_everything():
+    type = click.Path(extensions=[])
+
+    with pytest.raises(click.BadParameter):
+        type.convert("a.csv", None, None)
+
+
+def test_path_extensions_none_accepts_anything():
+    assert click.Path().convert("a.whatever", None, None) == "a.whatever"
+
+
+def test_path_extensions_checked_even_if_missing_and_exists_true(tmp_path):
+    missing = tmp_path / "nope.txt"
+
+    with pytest.raises(click.BadParameter, match="extensions"):
+        click.Path(extensions=["csv"]).convert(str(missing), None, None)
+
+    # The missing-file error is still reported for an allowed extension.
+    with pytest.raises(click.BadParameter, match="does not exist"):
+        click.Path(exists=True, extensions=["csv"]).convert(
+            str(tmp_path / "nope.csv"), None, None
+        )
+
+
+def test_path_extensions_existing_file(tmp_path):
+    f = tmp_path / "data.CSV"
+    f.write_text("x")
+    type = click.Path(exists=True, extensions=["csv", "tsv"])
+    assert type.convert(str(f), None, None) == str(f)
+
+
+def test_path_extensions_dash_not_checked():
+    type = click.Path(allow_dash=True, extensions=["csv"])
+    assert type.convert("-", None, None) == "-"
+
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions=["csv"]).convert("-", None, None)
+
+
+def test_path_extensions_bytes_and_pathlike():
+    type = click.Path(extensions=["csv"])
+    assert type.convert(b"a.CSV", None, None) == b"a.CSV"  # type: ignore[arg-type]
+    assert type.convert(pathlib.Path("a.csv"), None, None) == pathlib.Path("a.csv")
+
+    with pytest.raises(click.BadParameter):
+        type.convert(pathlib.Path("a.txt"), None, None)
+
+
+def test_path_extensions_through_option(runner):
+    @click.command()
+    @click.option("--f", type=click.Path(extensions=["csv", "tsv"]))
+    def cli(f):
+        click.echo(f)
+
+    ok = runner.invoke(cli, ["--f", "a.TSV"])
+    assert ok.exit_code == 0
+    assert ok.output == "a.TSV\n"
+
+    bad = runner.invoke(cli, ["--f", "a.txt"])
+    assert bad.exit_code == 2
+    assert "must have one of the extensions: .csv, .tsv." in bad.output
