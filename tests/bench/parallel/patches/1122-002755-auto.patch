         if not is_dash:
+            if self.extensions is not None and not os.fsdecode(
+                value
+            ).casefold().endswith(self.extensions):
+                self.fail(
+                    _(
+                        "{name} {filename!r} must have one of the extensions:"
+                        " {extensions}."
+                    ).format(
+                        name=self.name.title(),
+                        filename=format_filename(value),
