index 0000000..c44a4af
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,152 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def _e(day, category, amount):
+    return Expense(day, category, amount, "")
+
+
+ROWS = [
+    _e(date(2026, 10, 3), "食費", 1000),
+    _e(date(2026, 10, 20), "食費", 1000),
+    _e(date(2026, 11, 5), "食費", 2400),
+    _e(date(2026, 10, 9), "交通", 500),
+    _e(date(2026, 10, 11), "交通", 500),
+    _e(date(2026, 11, 12), "交通", 500),  # 同額で件数も同じ → same
+    _e(date(2026, 10, 15), "娯楽", 3000),  # 11 月に無い → gone
+    _e(date(2026, 11, 16), "医療", 700),  # 10 月に無い → new
+    _e(date(2026, 11, 17), "ゼロ", 0),  # 10 月の合計 0 にする前段
+    _e(date(2026, 10, 18), "ゼロ", 0),
+]
+
+
+def _by_cat(diffs):
+    return {d.category: d for d in diffs}
+
+
+def test_month_diff_values_and_statuses():
+    diffs = _by_cat(month_diff(ROWS, "2026-10", "2026-11"))
+    assert diffs["食費"] == DiffRow("食費", 2000, 2400, 400, 20.0, "up")
+    assert diffs["交通"] == DiffRow("交通", 1000, 500, -500, -50.0, "down")
+    assert diffs["娯楽"] == DiffRow("娯楽", 3000, 0, -3000, -100.0, "gone")
+    assert diffs["医療"] == DiffRow("医療", 0, 700, 700, None, "new")
+
+
+def test_same_status_uses_record_presence_and_zero_delta():
+    rows = [_e(date(2026, 10, 1), "a", 500), _e(date(2026, 11, 1), "a", 500)]
+    (d,) = month_diff(rows, "2026-10", "2026-11")
+    assert d == DiffRow("a", 500, 500, 0, 0.0, "same")
+
+
+def test_zero_total_with_records_is_not_new_or_gone():
+    diffs = _by_cat(month_diff(ROWS, "2026-10", "2026-11"))
+    # 「ゼロ」は 10 月・11 月とも明細があり合計 0 → same。pct は prev == 0 なので None
+    assert diffs["ゼロ"] == DiffRow("ゼロ", 0, 0, 0, None, "same")
+
+
+def test_order_by_abs_delta_desc_then_category():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    assert [d.category for d in diffs] == ["娯楽", "医療", "交通", "食費", "ゼロ"]
+
+
+def test_ties_broken_by_category_name():
+    rows = [_e(date(2026, 10, 1), "b", 100), _e(date(2026, 10, 1), "a", 200)]
+    rows += [_e(date(2026, 11, 1), "b", 300), _e(date(2026, 11, 1), "a", 0)]
+    # b: +200, a: -200 → 同じ abs(delta) なので category 昇順
+    assert [d.category for d in month_diff(rows, "2026-10", "2026-11")] == ["a", "b"]
+
+
+def test_pct_rounding_to_one_decimal():
+    rows = [_e(date(2026, 10, 1), "x", 300), _e(date(2026, 11, 1), "x", 400)]
+    (d,) = month_diff(rows, "2026-10", "2026-11")
+    assert d.pct == 33.3
+
+
+def test_negative_prev_zero_delta_has_no_negative_zero_pct():
+    rows = [_e(date(2026, 10, 1), "x", -500), _e(date(2026, 11, 1), "x", -500)]
+    (d,) = month_diff(rows, "2026-10", "2026-11")
+    assert d.pct == 0.0
+    assert str(d.pct) == "0.0"
+
+
+@pytest.mark.parametrize(
+    ("prev", "curr"),
+    [
+        ("2026-1", "2026-11"),
+        ("2026-13", "2026-11"),
+        ("2026-00", "2026-11"),
+        ("26-10", "2026-11"),
+        ("2026-10", "2026/11"),
+    ],
+)
+def test_invalid_month_format_raises(prev, curr):
+    with pytest.raises(ValueError):
+        month_diff(ROWS, prev, curr)
+
+
+def test_top_movers_skips_same_and_keeps_order():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    top = top_movers(diffs, n=2)
+    assert [d.category for d in top] == ["娯楽", "医療"]
+    assert all(d.status != "same" for d in top_movers(diffs, n=100))
+    assert len(top_movers(diffs, n=100)) == 4
+
+
+def test_top_movers_negative_n_raises():
+    with pytest.raises(ValueError):
+        top_movers([], n=-1)
+
+
+def test_render_diff_format():
+    diffs = [
+        DiffRow("食費", 2000, 2400, 400, 20.0, "up"),
+        DiffRow("交通", 1000, 500, -500, -50.0, "down"),
+        DiffRow("娯楽", 3000, 0, -3000, -100.0, "gone"),
+        DiffRow("医療", 0, 700, 700, None, "new"),
+        DiffRow("同", 100, 100, 0, 0.0, "same"),
+    ]
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "食費\t2000\t2400\t+400\t+20.0%\n"
+        "交通\t1000\t500\t-500\t-50.0%\n"
+        "娯楽\t3000\t0\t-3000\t-100.0%\n"
+        "医療\t0\t700\t+700\t-\n"
+        "同\t100\t100\t+0\t+0.0%"
+    )
+
+
+def test_render_diff_header_only_when_empty_and_no_trailing_newline():
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_available_months_sorted_unique():
+    rows = [
+        _e(date(2026, 11, 1), "a", 1),
+        _e(date(2026, 9, 30), "a", 1),
+        _e(date(2026, 11, 2), "a", 1),
+    ]
+    assert available_months(rows) == ["2026-09", "2026-11"]
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months():
+    diffs = latest_diff(ROWS)
+    assert diffs == month_diff(ROWS, "2026-10", "2026-11")
+
+
+def test_latest_diff_needs_two_months():
+    with pytest.raises(ValueError):
+        latest_diff([_e(date(2026, 10, 1), "a", 1)])
+    with pytest.raises(ValueError):
+        latest_diff([])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..502598d
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,127 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+E1 = Expense(date(2026, 11, 1), "食費", 1200, "コンビニ ABC")
+E2 = Expense(date(2026, 11, 2), "交通", 300, "電車 Suica")
+E3 = Expense(date(2026, 11, 3), "Food", 800, "Lunch")
+ROWS = [E1, E2, E3]
+
+
+def test_tokenize_basic_kinds():
+    assert tokenize("a (b) c") == [
+        ("TERM", "a"),
+        ("LPAREN", "("),
+        ("TERM", "b"),
+        ("RPAREN", ")"),
+        ("TERM", "c"),
+    ]
+
+
+def test_tokenize_operators_and_cat():
+    assert tokenize("a AND b OR NOT cat:食費") == [
+        ("TERM", "a"),
+        ("AND", "AND"),
+        ("TERM", "b"),
+        ("OR", "OR"),
+        ("NOT", "NOT"),
+        ("CAT", "食費"),
+    ]
+
+
+def test_tokenize_lowercase_and_is_term():
+    assert tokenize("x and y") == [("TERM", "x"), ("TERM", "and"), ("TERM", "y")]
+
+
+def test_tokenize_quoted_keeps_spaces_and_parens():
+    assert tokenize('"a b (c)" x') == [("TERM", "a b (c)"), ("TERM", "x")]
+
+
+def test_tokenize_quoted_operator_word_is_term():
+    assert tokenize('"AND"') == [("TERM", "AND")]
+
+
+@pytest.mark.parametrize("q", ['"abc', '""', "cat:", 'a "b'])
+def test_tokenize_errors(q):
+    with pytest.raises(QueryError):
+        tokenize(q)
+
+
+def test_term_matches_memo_or_category_case_insensitively():
+    assert matches("コンビニ", E1)
+    assert matches("食", E1)  # category の部分一致
+    assert matches("suica", E2)
+    assert matches("FOOD", E3)
+    assert not matches("suica", E1)
+
+
+def test_cat_is_exact_match_casefolded():
+    assert matches("cat:food", E3)
+    assert not matches("cat:foo", E3)
+    assert not matches("cat:食", E1)
+
+
+def test_quoted_term_with_space():
+    assert matches('"コンビニ ABC"', E1)
+    assert not matches('"コンビニABC"', E1)
+
+
+def test_and_implicit_and_explicit():
+    assert filter_rows("食費 コンビニ", ROWS) == [E1]
+    assert filter_rows("食費 AND コンビニ", ROWS) == [E1]
+    assert filter_rows("食費 AND 電車", ROWS) == []
+
+
+def test_or_and_precedence_and_over_or():
+    # a OR b c  ==  a OR (b AND c)
+    assert filter_rows("cat:交通 OR cat:食費 コンビニ", ROWS) == [E1, E2]
+    assert filter_rows("cat:交通 OR cat:食費 AND Lunch", ROWS) == [E2]
+    assert filter_rows("(cat:交通 OR cat:食費) AND Lunch", ROWS) == []
+
+
+def test_not_binds_tighter_than_and():
+    assert filter_rows("NOT cat:食費 Suica", ROWS) == [E2]
+    assert filter_rows("NOT (cat:食費 OR cat:交通)", ROWS) == [E3]
+
+
+def test_double_not():
+    assert filter_rows("NOT NOT cat:食費", ROWS) == [E1]
+
+
+def test_parentheses_grouping():
+    assert filter_rows("(food OR 電車) AND NOT lunch", ROWS) == [E2]
+
+
+def test_filter_preserves_input_order():
+    assert filter_rows("cat:food OR cat:食費", [E3, E1]) == [E3, E1]
+
+
+def test_empty_rows_still_validates_query():
+    assert filter_rows("cat:食費", []) == []
+    with pytest.raises(QueryError):
+        filter_rows("a AND", [])
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "a AND",
+        "OR a",
+        "a OR",
+        "(a",
+        "a)",
+        "NOT",
+        "(a))",
+        "a ()",
+        "a (b c",
+    ],
+)
+def test_grammar_errors(q):
+    with pytest.raises(QueryError):
+        matches(q, E1)
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..3d4911e
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,125 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def _e(day, category="通信", amount=1000, memo=""):
+    return Expense(day, category, amount, memo)
+
+
+@pytest.mark.parametrize(
+    ("src", "expected"),
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2024, 1, 31), date(2024, 2, 29)),
+        (date(2026, 12, 15), date(2027, 1, 15)),
+        (date(2026, 11, 30), date(2026, 12, 30)),
+        (date(2026, 3, 31), date(2026, 4, 30)),
+    ],
+)
+def test_add_month_clamps_to_end_of_month(src, expected):
+    assert add_month(src) == expected
+
+
+def test_add_month_leap_year_december_boundary():
+    assert add_month(date(2027, 12, 31)) == date(2028, 1, 31)
+
+
+def test_monthly_payments_are_detected_with_next_expected():
+    rows = [_e(date(2026, 9, 5)), _e(date(2026, 10, 5)), _e(date(2026, 11, 5))]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="通信",
+            amount=1000,
+            days=(date(2026, 9, 5), date(2026, 10, 5), date(2026, 11, 5)),
+            next_expected=date(2026, 12, 5),
+        )
+    ]
+
+
+def test_drift_within_tolerance_stays_connected():
+    # 10/8 は 9/5 の翌月 10/5 から 3 日ずれ(許容内)。11/8 は 10/8 の翌月ちょうど。
+    rows = [_e(date(2026, 9, 5)), _e(date(2026, 10, 8)), _e(date(2026, 11, 8))]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 9, 5), date(2026, 10, 8), date(2026, 11, 8))
+    assert result[0].next_expected == date(2026, 12, 8)
+
+
+def test_drift_beyond_tolerance_breaks_the_run():
+    # 11/4 は 10/8 の翌月 11/8 から 4 日ずれ(許容外)なので連続が切れる
+    rows = [_e(date(2026, 9, 5)), _e(date(2026, 10, 8)), _e(date(2026, 11, 4))]
+    assert find_recurring(rows) == []
+
+
+def test_break_splits_runs_and_only_long_enough_run_counts():
+    rows = [
+        _e(date(2026, 1, 10)),
+        _e(date(2026, 2, 10)),
+        _e(date(2026, 3, 10)),
+        _e(date(2026, 6, 10)),  # 連続が切れる
+        _e(date(2026, 7, 10)),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10))
+    assert result[0].next_expected == date(2026, 4, 10)
+
+
+def test_duplicate_days_are_collapsed():
+    rows = [
+        _e(date(2026, 1, 10), memo="a"),
+        _e(date(2026, 1, 10), memo="b"),
+        _e(date(2026, 2, 10)),
+        _e(date(2026, 3, 10)),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10))
+
+
+def test_groups_by_category_and_amount_ignoring_memo():
+    rows = [
+        _e(date(2026, 1, 10), amount=1000, memo="x"),
+        _e(date(2026, 2, 10), amount=1000, memo="y"),
+        _e(date(2026, 3, 10), amount=1000, memo="z"),
+        _e(date(2026, 1, 10), amount=500),  # 金額が違うので別グループ
+        _e(date(2026, 2, 10), amount=500),
+    ]
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [("通信", 1000)]
+
+
+def test_min_count_threshold():
+    rows = [_e(date(2026, 1, 10)), _e(date(2026, 2, 10))]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_count=2)) == 1
+
+
+def test_result_is_sorted_by_category_amount_first_day():
+    rows = []
+    for cat, amt in [("水道", 500), ("通信", 1000), ("水道", 200)]:
+        rows += [
+            _e(date(2026, 1, 1), cat, amt),
+            _e(date(2026, 2, 1), cat, amt),
+            _e(date(2026, 3, 1), cat, amt),
+        ]
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [
+        ("水道", 200),
+        ("水道", 500),
+        ("通信", 1000),
+    ]
+
+
+def test_empty_input_returns_empty():
+    assert find_recurring([]) == []
+
+
+@pytest.mark.parametrize(("min_count", "tolerance"), [(1, 3), (0, 3), (3, -1)])
+def test_invalid_parameters_raise(min_count, tolerance):
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=min_count, tolerance=tolerance)
