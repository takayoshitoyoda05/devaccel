index 0000000..313bd90
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,108 @@
+"""他行 CSV(銀行・カード明細)を Expense の列に取り込む。"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"(-)?[¥￥]?([0-9][0-9,]*)(円)?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    """`-¥1,234円` のような表記を整数にする。カンマの位置は検査しない。"""
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    sign, digits, _ = m.groups()
+    value = int(digits.replace(",", ""))
+    return -value if sign else value
+
+
+def parse_date(s: str) -> date:
+    """`YYYY/M/D` または `YYYY-M-D` を date にする。"""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    year, _, month, day = m.groups()
+    try:
+        return date(int(year), int(month), int(day))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def _cell(record: list[str], index: dict[str, int], field: str) -> str:
+    """列が足りない行の欠けた値は空文字列とする。"""
+    i = index[field]
+    return record[i] if i < len(record) else ""
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """1 行目がヘッダーの CSV 文字列を明細に変換する。
+
+    戻り値は (取り込めた明細, [(行番号, フィールド名), ...])。
+    行番号は text 上の物理行番号(ヘッダーが 1)。
+    """
+    cols = DEFAULT_MAPPING if mapping is None else mapping
+    for key in ("date", "category", "amount"):
+        if key not in cols:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header = next(reader, [])
+    index: dict[str, int] = {}
+    for field, column in cols.items():
+        if column not in header:
+            raise ValueError(f"列 {column!r} がヘッダーにありません")
+        index[field] = header.index(column)
+
+    rows: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    while True:
+        # csv は複数行にまたがるフィールドを読むので、レコードの開始行を先に求める。
+        start = reader.line_num + 1
+        record = next(reader, None)
+        if record is None:
+            break
+        if not record or (len(record) == 1 and not record[0].strip()):
+            continue  # 空行は読み飛ばす(行番号は数える)
+
+        row_errors: list[tuple[int, str]] = []
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(_cell(record, index, "date"))
+        except ValueError:
+            row_errors.append((start, "date"))
+        try:
+            amount = parse_amount(_cell(record, index, "amount"))
+        except ValueError:
+            row_errors.append((start, "amount"))
+        category = _cell(record, index, "category").strip()
+        if not category:
+            row_errors.append((start, "category"))
+
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        assert day is not None and amount is not None  # 誤りが無ければ両方そろっている
+        if category_map is not None and category in category_map:
+            category = category_map[category]
+        memo = _cell(record, index, "memo").strip() if "memo" in index else ""
+        rows.append(Expense(day=day, category=category, amount=amount, memo=memo))
+    return rows, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
new file mode 100644
index 0000000..f36fe44
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,95 @@
+"""前月比レポート。月ごとのカテゴリ合計を比べる。"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _month_key(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def _check_month(m: str) -> None:
+    if not _MONTH_RE.fullmatch(m):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {m!r}")
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+
+    prev_rows = [e for e in rows if _month_key(e) == prev_month]
+    curr_rows = [e for e in rows if _month_key(e) == curr_month]
+
+    def totals(items: list[Expense]) -> dict[str, tuple[int, int]]:
+        """{category: (合計, 明細件数)}"""
+        out: dict[str, tuple[int, int]] = {}
+        for e in items:
+            total, count = out.get(e.category, (0, 0))
+            out[e.category] = (total + e.amount, count + 1)
+        return out
+
+    prev_t = totals(prev_rows)
+    curr_t = totals(curr_rows)
+
+    diffs: list[DiffRow] = []
+    for category in set(prev_t) | set(curr_t):
+        prev, prev_n = prev_t.get(category, (0, 0))
+        curr, curr_n = curr_t.get(category, (0, 0))
+        delta = curr - prev
+        # -0.0 を 0.0 に正規化する(prev が負で delta が 0 のときに出る)
+        pct = round(delta / prev * 100, 1) + 0.0 if prev != 0 else None
+        if prev_n == 0:
+            status = "new"
+        elif curr_n == 0:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        diffs.append(DiffRow(category, prev, curr, delta, pct, status))
+
+    diffs.sort(key=lambda d: (-abs(d.delta), d.category))
+    return diffs
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [d for d in diffs if d.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for d in diffs:
+        pct = "-" if d.pct is None else f"{d.pct:+.1f}%"
+        lines.append(f"{d.category}\t{d.prev}\t{d.curr}\t{d.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month_key(e) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には 2 か月以上の明細が必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..4d6a647
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,185 @@
+"""検索クエリ(AND / OR / NOT / 括弧 / cat: / 引用)の字句解析・構文解析・評価。"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+
+class QueryError(ValueError):
+    """検索クエリが不正なとき。"""
+
+
+Token = tuple[str, str]
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    tokens: list[Token] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError("閉じていない引用符があります")
+            content = q[i + 1 : end]
+            if content == "":
+                raise QueryError("空の引用は検索語になりません")
+            tokens.append(("TERM", content))
+            i = end + 1
+        else:
+            start = i
+            while i < n and not (q[i].isspace() or q[i] in '()"'):
+                i += 1
+            word = q[start:i]
+            if word in ("AND", "OR", "NOT"):
+                tokens.append((word, word))
+            elif word.startswith("cat:"):
+                value = word[len("cat:") :]
+                if value == "":
+                    raise QueryError("cat: の後に分類名がありません")
+                tokens.append(("CAT", value))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+@dataclass(frozen=True)
+class _Term:
+    text: str
+
+
+@dataclass(frozen=True)
+class _Cat:
+    name: str
+
+
+@dataclass(frozen=True)
+class _Not:
+    operand: _Node
+
+
+@dataclass(frozen=True)
+class _And:
+    left: _Node
+    right: _Node
+
+
+@dataclass(frozen=True)
+class _Or:
+    left: _Node
+    right: _Node
+
+
+_Node = _Term | _Cat | _Not | _And | _Or
+
+
+class _Parser:
+    """文法:
+    or_expr  := and_expr ("OR" and_expr)*
+    and_expr := not_expr (["AND"] not_expr)*
+    not_expr := "NOT" not_expr | primary
+    primary  := TERM | CAT | "(" or_expr ")"
+    """
+
+    _NOT_START = ("NOT", "TERM", "CAT", "LPAREN")
+
+    def __init__(self, tokens: list[Token]) -> None:
+        self.tokens = tokens
+        self.pos = 0
+
+    def _peek(self) -> str | None:
+        return self.tokens[self.pos][0] if self.pos < len(self.tokens) else None
+
+    def _take(self) -> Token:
+        tok = self.tokens[self.pos]
+        self.pos += 1
+        return tok
+
+    def parse(self) -> _Node:
+        if not self.tokens:
+            raise QueryError("検索式が空です")
+        node = self._or()
+        if self.pos != len(self.tokens):
+            raise QueryError(
+                f"検索式の解釈できない位置があります: {self.tokens[self.pos][1]!r}"
+            )
+        return node
+
+    def _or(self) -> _Node:
+        node = self._and()
+        while self._peek() == "OR":
+            self._take()
+            node = _Or(node, self._and())
+        return node
+
+    def _and(self) -> _Node:
+        node = self._not()
+        while True:
+            kind = self._peek()
+            if kind == "AND":
+                self._take()
+                node = _And(node, self._not())
+            elif kind in self._NOT_START:
+                node = _And(node, self._not())
+            else:
+                return node
+
+    def _not(self) -> _Node:
+        if self._peek() == "NOT":
+            self._take()
+            return _Not(self._not())
+        return self._primary()
+
+    def _primary(self) -> _Node:
+        kind = self._peek()
+        if kind == "TERM":
+            return _Term(self._take()[1])
+        if kind == "CAT":
+            return _Cat(self._take()[1])
+        if kind == "LPAREN":
+            self._take()
+            node = self._or()
+            if self._peek() != "RPAREN":
+                raise QueryError("閉じ括弧 ')' がありません")
+            self._take()
+            return node
+        if kind is None:
+            raise QueryError("演算子の後に項がありません")
+        raise QueryError(f"項が必要な位置に {self.tokens[self.pos][1]!r} があります")
+
+
+def _parse(q: str) -> _Node:
+    return _Parser(tokenize(q)).parse()
+
+
+def _eval(node: _Node, e: Expense) -> bool:
+    if isinstance(node, _Term):
+        needle = node.text.casefold()
+        return needle in e.memo.casefold() or needle in e.category.casefold()
+    if isinstance(node, _Cat):
+        return node.name.casefold() == e.category.casefold()
+    if isinstance(node, _Not):
+        return not _eval(node.operand, e)
+    if isinstance(node, _And):
+        return _eval(node.left, e) and _eval(node.right, e)
+    return _eval(node.left, e) or _eval(node.right, e)
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _eval(_parse(q), e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    node = _parse(q)  # rows が空でも不正なクエリは検出する
+    return [e for e in rows if _eval(node, e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..e0f38d4
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,63 @@
+"""Detect recurring expenses (同じ分類・金額が毎月ほぼ同じ日に現れるもの)."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """翌月の同じ日。翌月にその日が無ければ翌月の末日。"""
+    year, month = (d.year, d.month + 1) if d.month < 12 else (d.year + 1, 1)
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def _runs(days: list[date], tolerance: int) -> list[list[date]]:
+    """昇順・重複なしの日付列を、隣どうしがつながっている極大区間に分ける。"""
+    runs: list[list[date]] = []
+    for d in days:
+        if runs and abs((d - add_month(runs[-1][-1])).days) <= tolerance:
+            runs[-1].append(d)
+        else:
+            runs.append([d])
+    return runs
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError(f"min_count は 2 以上である必要があります: {min_count}")
+    if tolerance < 0:
+        raise ValueError(f"tolerance は 0 以上である必要があります: {tolerance}")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    found: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        for run in _runs(sorted(day_set), tolerance):
+            if len(run) >= min_count:
+                found.append(
+                    Recurring(
+                        category=category,
+                        amount=amount,
+                        days=tuple(run),
+                        next_expected=add_month(run[-1]),
+                    )
+                )
+    found.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return found
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..a62285a
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,167 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+HEADER = "利用日,分類,利用金額,利用店名,カード番号\n"
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥1200", 1200),
+        ("-1,000円", -1000),
+        ("1,2", 12),  # カンマの位置は検査しない
+    ],
+)
+def test_parse_amount_accepts(text, expected):
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "円",
+        "12.5",
+        "1 200",
+        "--5",
+        "¥-5",
+        "１２３",
+        "円980",
+        "-",
+        ",",
+        "1円円",
+        "-円",
+    ],
+)
+def test_parse_amount_rejects(text):
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/11/30 ", date(2026, 11, 30)),
+        ("2026-1-5", date(2026, 1, 5)),
+        ("2024/02/29", date(2024, 2, 29)),
+    ],
+)
+def test_parse_date_accepts(text, expected):
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026/1-5",
+        "26/1/5",
+        "2026/02/30",
+        "2026.1.5",
+        "",
+        "2026/13/1",
+        "２０２６/1/5",
+        "2026/1/5/1",
+    ],
+)
+def test_parse_date_rejects(text):
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+def test_import_default_mapping_success_and_memo():
+    text = HEADER + '2026/11/01,食費,"1,200円",コンビニ A,1234\n'
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 11, 1), "食費", 1200, "コンビニ A")]
+
+
+def test_import_keeps_input_order_and_skips_blank_lines_but_counts_them():
+    text = HEADER + "2026/11/01,食費,100,a\n\n2026/11/02,交通,200,b\n"
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert [r.category for r in rows] == ["食費", "交通"]
+
+
+def test_error_line_numbers_count_blank_lines():
+    text = HEADER + "\n2026/11/01,食費,abc,a\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(3, "amount")]
+
+
+def test_multiple_errors_in_one_row_recorded_in_order():
+    text = HEADER + "bad, ,xyz,\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "date"), (2, "amount"), (2, "category")]
+
+
+def test_quoted_newline_counts_physical_lines():
+    text = HEADER + '2026/11/01,"食\n費",100,a\n2026/11/02,x,bad,b\n'
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 11, 1), "食\n費", 100, "a")]
+    assert errors == [(4, "amount")]
+
+
+def test_short_row_missing_values_are_empty_and_reported():
+    text = HEADER + "2026/11/01\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "amount"), (2, "category")]
+
+
+def test_mapping_without_memo_key_gives_empty_memo():
+    text = "利用日,分類,利用金額\n2026/11/01,食費,100\n"
+    mapping = {"date": "利用日", "category": "分類", "amount": "利用金額"}
+    rows, errors = import_rows(text, mapping=mapping)
+    assert errors == []
+    assert rows == [Expense(date(2026, 11, 1), "食費", 100, "")]
+
+
+def test_category_is_stripped_and_mapped():
+    text = HEADER + "2026/11/01,  食料品 ,100,a\n"
+    rows, errors = import_rows(text, category_map={"食料品": "食費"})
+    assert errors == []
+    assert rows[0].category == "食費"
+
+
+def test_memo_is_stripped_and_extra_columns_ignored():
+    text = HEADER + "2026/11/01,食費,100,  店  ,zzz\n"
+    rows, _ = import_rows(text)
+    assert rows[0].memo == "店"
+
+
+def test_custom_mapping_and_missing_memo_key():
+    text = "day,kind,yen\n2026/11/01,食費,100\n"
+    mapping = {"date": "day", "category": "kind", "amount": "yen"}
+    rows, errors = import_rows(text, mapping=mapping)
+    assert errors == []
+    assert rows == [Expense(date(2026, 11, 1), "食費", 100, "")]
+
+
+@pytest.mark.parametrize("key", ["date", "category", "amount"])
+def test_mapping_missing_required_key_raises(key):
+    mapping = {k: v for k, v in DEFAULT_MAPPING.items() if k != key}
+    with pytest.raises(ValueError):
+        import_rows(HEADER, mapping=mapping)
+
+
+def test_mapping_column_absent_from_header_raises():
+    with pytest.raises(ValueError):
+        import_rows("利用日,分類\n2026/11/01,食費\n")
+
+
+def test_memo_column_mapped_but_absent_from_header_raises():
+    mapping = {**DEFAULT_MAPPING, "memo": "無い列"}
+    with pytest.raises(ValueError):
+        import_rows(HEADER, mapping=mapping)
