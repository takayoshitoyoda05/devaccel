index 0000000..d115329
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,189 @@
+"""Search query language for expenses.
+
+Grammar (lowest precedence first):
+    or_expr   := and_expr ("OR" and_expr)*
+    and_expr  := not_expr (["AND"] not_expr)*
+    not_expr  := "NOT" not_expr | primary
+    primary   := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from .core import Expense
+
+
+class QueryError(ValueError):
+    """Raised when a search query cannot be tokenized or parsed."""
+
+
+Token = tuple[str, str]
+
+_SPACES = " \t\r\n\f\v"
+_OPERATORS = {"AND": "AND", "OR": "OR", "NOT": "NOT"}
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    tokens: list[Token] = []
+    i, n = 0, len(q)
+    while i < n:
+        c = q[i]
+        if c in _SPACES:
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError("引用符が閉じられていません")
+            body = q[i + 1 : end]
+            if body == "":
+                raise QueryError("空の引用は検索語になりません")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            start = i
+            while i < n and q[i] not in _SPACES and q[i] not in '()"':
+                i += 1
+            word = q[start:i]
+            if word in _OPERATORS:
+                tokens.append((_OPERATORS[word], word))
+            elif word.startswith("cat:"):
+                cat = word[len("cat:") :]
+                if cat == "":
+                    raise QueryError("cat: の後ろに値がありません")
+                tokens.append(("CAT", cat))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+@dataclass(frozen=True)
+class _Term:
+    value: str
+
+
+@dataclass(frozen=True)
+class _Cat:
+    value: str
+
+
+@dataclass(frozen=True)
+class _Not:
+    operand: _Node
+
+
+@dataclass(frozen=True)
+class _And:
+    left: _Node
+    right: _Node
+
+
+@dataclass(frozen=True)
+class _Or:
+    left: _Node
+    right: _Node
+
+
+_Node = _Term | _Cat | _Not | _And | _Or
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self._tokens = tokens
+        self._pos = 0
+
+    def _peek(self) -> str | None:
+        return self._tokens[self._pos][0] if self._pos < len(self._tokens) else None
+
+    def _next(self) -> Token:
+        tok = self._tokens[self._pos]
+        self._pos += 1
+        return tok
+
+    def parse(self) -> _Node:
+        if not self._tokens:
+            raise QueryError("検索クエリが空です")
+        node = self._or_expr()
+        if self._pos != len(self._tokens):
+            raise QueryError(
+                f"予期しない記号があります: {self._tokens[self._pos][1]!r}"
+            )
+        return node
+
+    def _or_expr(self) -> _Node:
+        node = self._and_expr()
+        while self._peek() == "OR":
+            self._next()
+            node = _Or(node, self._and_expr())
+        return node
+
+    def _starts_not_expr(self) -> bool:
+        return self._peek() in ("NOT", "TERM", "CAT", "LPAREN")
+
+    def _and_expr(self) -> _Node:
+        node = self._not_expr()
+        while True:
+            if self._peek() == "AND":
+                self._next()
+                node = _And(node, self._not_expr())
+            elif self._starts_not_expr():
+                node = _And(node, self._not_expr())
+            else:
+                return node
+
+    def _not_expr(self) -> _Node:
+        if self._peek() == "NOT":
+            self._next()
+            return _Not(self._not_expr())
+        return self._primary()
+
+    def _primary(self) -> _Node:
+        kind = self._peek()
+        if kind is None:
+            raise QueryError("検索語または括弧が必要です")
+        if kind == "TERM":
+            return _Term(self._next()[1])
+        if kind == "CAT":
+            return _Cat(self._next()[1])
+        if kind == "LPAREN":
+            self._next()
+            node = self._or_expr()
+            if self._peek() != "RPAREN":
+                raise QueryError("閉じ括弧 ')' がありません")
+            self._next()
+            return node
+        raise QueryError(
+            f"検索語が必要ですが {self._tokens[self._pos][1]!r} がありました"
+        )
+
+
+def _parse(q: str) -> _Node:
+    return _Parser(tokenize(q)).parse()
+
+
+def _eval(node: _Node, e: Expense) -> bool:
+    if isinstance(node, _Term):
+        needle = node.value.casefold()
+        return needle in e.memo.casefold() or needle in e.category.casefold()
+    if isinstance(node, _Cat):
+        return node.value.casefold() == e.category.casefold()
+    if isinstance(node, _Not):
+        return not _eval(node.operand, e)
+    if isinstance(node, _And):
+        return _eval(node.left, e) and _eval(node.right, e)
+    return _eval(node.left, e) or _eval(node.right, e)
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _eval(_parse(q), e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    node = _parse(q)
+    return [e for e in rows if _eval(node, e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..ace13bd
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,73 @@
+"""Detect recurring expenses (same category and amount, roughly monthly)."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day in the next month, clamped to that month's last day."""
+    year, month = (d.year + 1, 1) if d.month == 12 else (d.year, d.month + 1)
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def _runs(days: list[date], tolerance: int) -> list[list[date]]:
+    """Split sorted, distinct dates into maximal runs where neighbours are linked."""
+    runs: list[list[date]] = []
+    for d in days:
+        if runs:
+            prev = runs[-1][-1]
+            if abs((d - add_month(prev)).days) <= tolerance:
+                runs[-1].append(d)
+                continue
+        runs.append([d])
+    return runs
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    """Find (category, amount) groups whose dates recur monthly.
+
+    Dates within a group are de-duplicated and sorted. Consecutive dates are
+    linked when the gap to the next month's same day is at most ``tolerance``
+    days. Each maximal linked run of at least ``min_count`` dates yields one
+    Recurring entry.
+    """
+    if min_count < 2:
+        raise ValueError(f"min_count は 2 以上である必要があります: {min_count}")
+    if tolerance < 0:
+        raise ValueError(f"tolerance は 0 以上である必要があります: {tolerance}")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    out: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        for run in _runs(sorted(day_set), tolerance):
+            if len(run) >= min_count:
+                out.append(
+                    Recurring(
+                        category=category,
+                        amount=amount,
+                        days=tuple(run),
+                        next_expected=add_month(run[-1]),
+                    )
+                )
+
+    out.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return out
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..d6ea15f
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,134 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥1,000", 1000),
+        ("-1,000円", -1000),
+        ("100,円", 100),  # カンマの位置は検査しない(仕様)
+    ],
+)
+def test_parse_amount_accepts(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    ["", "円", "12.5", "1 200", "--5", "¥-5", "１２３", ",100", "abc"],
+)
+def test_parse_amount_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/12/31 ", date(2026, 12, 31)),
+        ("2026-1-5", date(2026, 1, 5)),
+    ],
+)
+def test_parse_date_accepts(text: str, expected: date) -> None:
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text", ["2026/1-5", "26/1/5", "2026/02/30", "2026.1.5", "", "２０２６/1/5"]
+)
+def test_parse_date_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+def test_default_mapping_values() -> None:
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_import_rows_basic_with_extra_columns_and_order() -> None:
+    text = '利用日,分類,利用金額,利用店名,備考\n2026/1/5,食費,"1,200",スーパー A,x\n2026-01-06, 交通 ,-300,駅 \n'
+    expenses, errors = import_rows(text)
+    assert errors == []
+    assert expenses == [
+        Expense(date(2026, 1, 5), "食費", 1200, "スーパー A"),
+        Expense(date(2026, 1, 6), "交通", -300, "駅"),
+    ]
+
+
+def test_import_rows_memo_optional_when_mapping_omits_it() -> None:
+    text = "d,c,a\n2026/1/5,食費,100\n"
+    expenses, errors = import_rows(text, {"date": "d", "category": "c", "amount": "a"})
+    assert errors == []
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+def test_import_rows_mapping_missing_required_key_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows("d,c\n", {"date": "d", "category": "c"})
+
+
+def test_import_rows_mapping_column_not_in_header_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows("利用日,分類\n", DEFAULT_MAPPING)
+
+
+def test_import_rows_category_map_applied_after_strip() -> None:
+    text = "利用日,分類,利用金額,利用店名\n2026/1/5, コンビニ ,100,a\n2026/1/6,外食,200,b\n"
+    expenses, errors = import_rows(text, category_map={"コンビニ": "食費"})
+    assert errors == []
+    assert [e.category for e in expenses] == ["食費", "外食"]
+
+
+def test_import_rows_records_all_errors_per_row_in_order_and_excludes_row() -> None:
+    text = (
+        "利用日,分類,利用金額,利用店名\n"
+        "2026/02/30,,12.5,x\n"  # line 2: date, amount, category
+        "2026/1/5,食費,100,ok\n"  # line 3: fine
+        "2026/1/6,  ,abc,y\n"  # line 4: amount, category
+    )
+    expenses, errors = import_rows(text)
+    assert errors == [
+        (2, "date"),
+        (2, "amount"),
+        (2, "category"),
+        (4, "amount"),
+        (4, "category"),
+    ]
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "ok")]
+
+
+def test_import_rows_missing_trailing_columns_treated_as_empty() -> None:
+    text = "利用日,分類,利用金額,利用店名\n2026/1/5,食費\n"
+    expenses, errors = import_rows(text)
+    assert expenses == []
+    assert errors == [(2, "amount")]
+
+
+def test_import_rows_blank_lines_skipped_but_counted() -> None:
+    text = "利用日,分類,利用金額,利用店名\n\n2026/1/5,食費,100,a\n\n2026/1/x,食費,1,b\n"
+    expenses, errors = import_rows(text)
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "a")]
+    assert errors == [(5, "date")]
+
+
+def test_import_rows_quoted_newline_uses_physical_line_numbers() -> None:
+    text = '利用日,分類,利用金額,利用店名\n2026/1/5,食費,100,"multi\nline"\n2026/1/x,食費,1,b\n'
+    expenses, errors = import_rows(text)
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "multi\nline")]
+    assert errors == [(4, "date")]
