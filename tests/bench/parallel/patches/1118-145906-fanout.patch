index 0000000..3bceded
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,148 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def e(day: str, cat: str, amount: int) -> Expense:
+    return Expense(date.fromisoformat(day), cat, amount)
+
+
+ROWS = [
+    e("2026-01-05", "食費", 1000),
+    e("2026-01-20", "食費", 500),
+    e("2026-01-10", "交通", 300),
+    e("2026-01-11", "娯楽", 2000),
+    e("2026-02-03", "食費", 1800),
+    e("2026-02-04", "交通", 0),
+    e("2026-02-09", "日用品", 700),
+    e("2026-03-01", "食費", 100),
+]
+
+
+def by_cat(rows: list[DiffRow]) -> dict[str, DiffRow]:
+    return {r.category: r for r in rows}
+
+
+def test_month_diff_values_and_status() -> None:
+    d = by_cat(month_diff(ROWS, "2026-01", "2026-02"))
+    assert d["食費"] == DiffRow("食費", 1500, 1800, 300, 20.0, "up")
+    # 交通 has a (zero-amount) row in 02, so it is "down", not "gone"
+    assert d["交通"] == DiffRow("交通", 300, 0, -300, -100.0, "down")
+    assert d["娯楽"] == DiffRow("娯楽", 2000, 0, -2000, -100.0, "gone")
+    assert d["日用品"] == DiffRow("日用品", 0, 700, 700, None, "new")
+
+
+def test_status_uses_row_presence_not_sum() -> None:
+    # 交通 in 02 sums to 0 but has a row -> not "gone"; delta 0 -> "same"
+    rows = [e("2026-01-01", "交通", 300), e("2026-02-01", "交通", 0)]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    assert r.status == "down"
+    rows = [
+        e("2026-01-01", "交通", 300),
+        e("2026-02-01", "交通", 150),
+        e("2026-02-02", "交通", -150),
+    ]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    assert (r.curr, r.delta, r.status) == (0, -300, "down")
+    rows = [e("2026-01-01", "交通", 0), e("2026-02-01", "交通", 0)]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    assert (r.delta, r.pct, r.status) == (0, None, "same")
+
+
+def test_sort_by_abs_delta_then_category() -> None:
+    rows = [
+        e("2026-01-01", "b", 100),
+        e("2026-02-01", "b", 200),  # delta +100
+        e("2026-01-01", "a", 100),
+        e("2026-02-01", "a", 0),  # delta -100
+        e("2026-02-01", "c", 500),  # delta +500
+    ]
+    cats = [r.category for r in month_diff(rows, "2026-01", "2026-02")]
+    assert cats == ["c", "a", "b"]
+
+
+def test_month_diff_rejects_bad_month() -> None:
+    for bad in ["2026-1", "2026-13", "2026-00", "2026/01", "202601", "2026-01-01", ""]:
+        with pytest.raises(ValueError):
+            month_diff(ROWS, bad, "2026-02")
+        with pytest.raises(ValueError):
+            month_diff(ROWS, "2026-01", bad)
+
+
+def test_pct_rounding_and_negative_zero() -> None:
+    rows = [e("2026-01-01", "x", 3), e("2026-02-01", "x", 4)]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    assert r.pct == 33.3
+    rows = [e("2026-01-01", "x", 300), e("2026-02-01", "x", 300)]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    assert r.pct == 0.0 and str(r.pct) == "0.0"
+
+
+def test_top_movers_skips_same_and_limits() -> None:
+    rows = [
+        e("2026-01-01", "a", 100),
+        e("2026-02-01", "a", 100),  # same
+        e("2026-01-01", "b", 100),
+        e("2026-02-01", "b", 900),  # +800
+        e("2026-01-01", "c", 500),
+        e("2026-02-01", "c", 100),  # -400
+        e("2026-01-01", "d", 50),
+        e("2026-02-01", "d", 60),  # +10
+    ]
+    diffs = month_diff(rows, "2026-01", "2026-02")
+    movers = top_movers(diffs, 2)
+    assert [r.category for r in movers] == ["b", "c"]
+    assert [r.category for r in top_movers(diffs)] == ["b", "c", "d"]
+    assert top_movers(diffs, 0) == []
+    with pytest.raises(ValueError):
+        top_movers(diffs, -1)
+
+
+def test_render_diff_format() -> None:
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    text = render_diff(diffs)
+    lines = text.split("\n")
+    assert lines[0] == "category\tprev\tcurr\tdelta\tpct"
+    assert lines[1:] == [
+        "娯楽\t2000\t0\t-2000\t-100.0%",
+        "日用品\t0\t700\t+700\t-",
+        "交通\t300\t0\t-300\t-100.0%",
+        "食費\t1500\t1800\t+300\t+20.0%",
+    ]
+    assert not text.endswith("\n")
+
+
+def test_render_diff_zero_delta_and_empty() -> None:
+    rows = [e("2026-01-01", "x", 300), e("2026-02-01", "x", 300)]
+    assert render_diff(month_diff(rows, "2026-01", "2026-02")).split("\n")[1] == (
+        "x\t300\t300\t+0\t+0.0%"
+    )
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_available_months_sorted_unique() -> None:
+    assert available_months(ROWS) == ["2026-01", "2026-02", "2026-03"]
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months() -> None:
+    assert latest_diff(ROWS) == month_diff(ROWS, "2026-02", "2026-03")
+
+
+def test_latest_diff_needs_two_months() -> None:
+    with pytest.raises(ValueError):
+        latest_diff([])
+    with pytest.raises(ValueError):
+        latest_diff([e("2026-01-01", "x", 1), e("2026-01-02", "x", 2)])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..aa6ebae
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,150 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def _e(category, memo="", amount=100):
+    return Expense(day=date(2026, 11, 1), category=category, amount=amount, memo=memo)
+
+
+ROWS = [
+    _e("food", "Lunch at Cafe"),
+    _e("transport", "train pass"),
+    _e("food", "groceries"),
+    _e("Entertainment", "movie night"),
+]
+
+
+def test_tokenize_basic_kinds():
+    assert tokenize("a (b) AND OR NOT") == [
+        ("TERM", "a"),
+        ("LPAREN", "("),
+        ("TERM", "b"),
+        ("RPAREN", ")"),
+        ("AND", "AND"),
+        ("OR", "OR"),
+        ("NOT", "NOT"),
+    ]
+
+
+def test_tokenize_lowercase_operators_are_terms():
+    assert tokenize("and or not") == [
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_quoted_term_keeps_spaces_and_parens():
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+
+
+def test_tokenize_cat_prefix():
+    assert tokenize("cat:food") == [("CAT", "food")]
+
+
+def test_tokenize_word_stops_at_quote():
+    assert tokenize('abc"def"') == [("TERM", "abc"), ("TERM", "def")]
+
+
+@pytest.mark.parametrize("q", ['"abc', '""', "cat:", "cat: x"])
+def test_tokenize_errors(q):
+    with pytest.raises(QueryError):
+        tokenize(q)
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(a",
+        "a)",
+        "a AND",
+        "OR a",
+        "a OR",
+        "NOT",
+        "a AND OR b",
+        "a ( )",
+        "a NOT",
+    ],
+)
+def test_invalid_queries_raise(q):
+    with pytest.raises(QueryError):
+        filter_rows(q, ROWS)
+
+
+def test_invalid_query_raises_even_with_no_rows():
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
+
+
+def test_valid_query_with_no_rows_returns_empty():
+    assert filter_rows("food", []) == []
+
+
+def test_term_matches_memo_or_category_case_insensitively():
+    assert matches("cafe", ROWS[0])
+    assert matches("FOOD", ROWS[0])
+    assert not matches("train", ROWS[0])
+
+
+def test_cat_is_exact_match_on_category():
+    assert matches("cat:food", ROWS[0])
+    assert matches("cat:FOOD", ROWS[0])
+    assert not matches("cat:foo", ROWS[0])
+    assert not matches("cat:food", ROWS[1])
+    # カテゴリ名の部分一致は cat: では真にならない
+    assert not matches("cat:ent", ROWS[3])
+
+
+def test_term_matches_category_substring():
+    assert matches("ent", ROWS[3])
+
+
+def test_implicit_and():
+    assert filter_rows("food lunch", ROWS) == [ROWS[0]]
+
+
+def test_explicit_and_equals_implicit():
+    assert filter_rows("food AND lunch", ROWS) == filter_rows("food lunch", ROWS)
+
+
+def test_or():
+    assert filter_rows("train OR movie", ROWS) == [ROWS[1], ROWS[3]]
+
+
+def test_not():
+    assert filter_rows("cat:food NOT lunch", ROWS) == [ROWS[2]]
+
+
+def test_not_binds_tighter_than_and():
+    # NOT は AND より強い: (NOT train) AND food
+    assert filter_rows("NOT train food", ROWS) == [ROWS[0], ROWS[2]]
+
+
+def test_and_binds_tighter_than_or():
+    # AND は OR より強い: (food AND lunch) OR train
+    assert filter_rows("food lunch OR train", ROWS) == [ROWS[0], ROWS[1]]
+
+
+def test_parentheses_override_precedence():
+    assert filter_rows("food (lunch OR train)", ROWS) == [ROWS[0]]
+    assert filter_rows("(food OR transport) groceries", ROWS) == [ROWS[2]]
+
+
+def test_double_not():
+    assert filter_rows("NOT NOT train", ROWS) == [ROWS[1]]
+
+
+def test_quoted_term_with_space():
+    assert filter_rows('"train pass"', ROWS) == [ROWS[1]]
+
+
+def test_filter_rows_keeps_input_order():
+    rows = [ROWS[2], ROWS[0]]
+    assert filter_rows("food", rows) == [ROWS[2], ROWS[0]]
