+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def _e(
+    day: date, category: str = "通信", amount: int = 1000, memo: str = ""
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+@pytest.mark.parametrize(
+    ("src", "expected"),
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2024, 1, 31), date(2024, 2, 29)),
+        (date(2026, 12, 15), date(2027, 1, 15)),
+        (date(2026, 3, 30), date(2026, 4, 30)),
+        (date(2026, 11, 30), date(2026, 12, 30)),
+    ],
+)
+def test_add_month(src: date, expected: date) -> None:
+    assert add_month(src) == expected
+
+
+def test_find_recurring_basic_monthly() -> None:
+    rows = [_e(date(2026, 1, 10)), _e(date(2026, 2, 10)), _e(date(2026, 3, 10))]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="通信",
+            amount=1000,
+            days=(date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10)),
+            next_expected=date(2026, 4, 10),
+        )
+    ]
+
+
+def test_tolerance_allows_small_drift() -> None:
+    # 02-13 is 3 days after 02-10 (within tolerance); 03-12 is 1 day before 03-13.
+    rows = [_e(date(2026, 1, 10)), _e(date(2026, 2, 13)), _e(date(2026, 3, 12))]
+    (r,) = find_recurring(rows)
+    assert r.days == (date(2026, 1, 10), date(2026, 2, 13), date(2026, 3, 12))
+
+
+def test_drift_beyond_tolerance_breaks_run() -> None:
+    rows = [
+        _e(date(2026, 1, 10)),
+        _e(date(2026, 2, 10)),
+        _e(date(2026, 3, 20)),  # 7 days off from expected 2026-03-10
+        _e(date(2026, 4, 20)),
+        _e(date(2026, 5, 20)),
+    ]
+    # 2026-01-10 -> 2026-02-10 linked; 2026-02-10 -> 2026-03-20 not linked.
+    # Run 2 (03-20, 04-20, 05-20) is length 3 and qualifies.
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 3, 20)]
+    assert result[0].next_expected == date(2026, 6, 20)
+
+
+def test_short_run_is_dropped() -> None:
+    rows = [_e(date(2026, 1, 10)), _e(date(2026, 2, 10))]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_count=2)) == 1
+
+
+def test_groups_split_by_category_and_amount() -> None:
+    rows = [
+        _e(date(2026, 1, 10), amount=1000),
+        _e(date(2026, 2, 10), amount=1000),
+        _e(date(2026, 3, 10), amount=1000),
+        _e(date(2026, 1, 10), amount=500),
+        _e(date(2026, 2, 10), amount=500),
+        _e(date(2026, 3, 10), category="食費", amount=1000),
+    ]
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [("通信", 1000)]
+
+
+def test_memo_is_ignored_for_grouping() -> None:
+    rows = [
+        _e(date(2026, 1, 10), memo="a"),
+        _e(date(2026, 2, 10), memo="b"),
+        _e(date(2026, 3, 10), memo=""),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_duplicate_dates_are_collapsed() -> None:
+    rows = [
+        _e(date(2026, 1, 10)),
+        _e(date(2026, 1, 10)),
+        _e(date(2026, 2, 10)),
+        _e(date(2026, 3, 10)),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.days == (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10))
+
+
+def test_month_end_clamping_in_chain() -> None:
+    rows = [_e(date(2026, 1, 31)), _e(date(2026, 2, 28)), _e(date(2026, 3, 31))]
+    (r,) = find_recurring(rows)
+    assert r.next_expected == date(2026, 4, 30)
+
+
+def test_result_ordering() -> None:
+    rows = [
+        _e(date(2026, 1, 5), category="食費", amount=300),
+        _e(date(2026, 2, 5), category="食費", amount=300),
+        _e(date(2026, 3, 5), category="食費", amount=300),
+        _e(date(2026, 1, 1), category="通信", amount=900),
+        _e(date(2026, 2, 1), category="通信", amount=900),
+        _e(date(2026, 3, 1), category="通信", amount=900),
+        _e(date(2026, 1, 2), category="通信", amount=100),
+        _e(date(2026, 2, 2), category="通信", amount=100),
+        _e(date(2026, 3, 2), category="通信", amount=100),
+    ]
+    assert [(r.category, r.amount) for r in find_recurring(rows)] == [
+        ("通信", 100),
+        ("通信", 900),
+        ("食費", 300),
+    ]
+
+
+def test_empty_input() -> None:
+    assert find_recurring([]) == []
+
+
+@pytest.mark.parametrize(
+    ("min_count", "tolerance"),
+    [(1, 3), (0, 3), (3, -1)],
+)
+def test_invalid_arguments_raise(min_count: int, tolerance: int) -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=min_count, tolerance=tolerance)
