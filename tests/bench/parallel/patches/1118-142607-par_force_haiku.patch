@@ -0,0 +1,61 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.streak import longest_no_spend_streak
+
+
+def _e(day: date, amount: int = 100) -> Expense:
+    return Expense(day=day, category="food", amount=amount)
+
+
+def test_no_rows_whole_period_is_streak() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 1), date(2026, 1, 5)) == 5
+
+
+def test_single_day_period_without_spend() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 1), date(2026, 1, 1)) == 1
+
+
+def test_single_day_period_with_spend() -> None:
+    rows = [_e(date(2026, 1, 1))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 1)) == 0
+
+
+def test_longest_gap_in_middle() -> None:
+    rows = [_e(date(2026, 1, 1)), _e(date(2026, 1, 2)), _e(date(2026, 1, 6))]
+    # gap 3..5 is 3 days; trailing 7..10 is 4 days
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 10)) == 4
+
+
+def test_gap_at_start_counts() -> None:
+    rows = [_e(date(2026, 1, 4))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 6)) == 3
+
+
+def test_both_ends_inclusive() -> None:
+    rows = [_e(date(2026, 1, 2))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 3)) == 1
+
+
+def test_rows_outside_period_are_ignored() -> None:
+    rows = [_e(date(2025, 12, 31)), _e(date(2026, 2, 1))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 3)) == 3
+
+
+def test_multiple_records_same_day_count_as_spend() -> None:
+    rows = [_e(date(2026, 1, 2), 100), _e(date(2026, 1, 2), 200)]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 3)) == 1
+
+
+def test_zero_amount_record_still_counts_as_spend() -> None:
+    rows = [_e(date(2026, 1, 2), 0)]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 3)) == 1
+
+
+def test_start_after_end_returns_zero() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 5), date(2026, 1, 1)) == 0
+
+
+def test_crosses_month_boundary() -> None:
+    rows = [_e(date(2026, 1, 30))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 29), date(2026, 2, 3)) == 4
