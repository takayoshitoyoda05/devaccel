@@ -0,0 +1,14 @@
+"""Even splitting of amounts across people."""
+
+from __future__ import annotations
+
+
+def split_evenly(amount: int, people: int) -> list[int]:
+    """Split ``amount`` yen across ``people``; leftover yen go to the first people.
+
+    The result always sums to ``amount``. Raises ``ValueError`` if ``people`` < 1.
+    """
+    if people < 1:
+        raise ValueError(f"people は 1 以上である必要があります: {people}")
+    base, remainder = divmod(amount, people)
+    return [base + (1 if i < remainder else 0) for i in range(people)]
