--- /dev/null
+++ b/src/kakeibo/streak.py
@@ -0,0 +1,26 @@
+"""No-spend streak calculation."""
+
+from __future__ import annotations
+
+from datetime import date, timedelta
+
+from kakeibo.core import Expense
+
+
+def longest_no_spend_streak(rows: list[Expense], start: date, end: date) -> int:
+    """Longest run of consecutive days in [start, end] with no expense record.
+
+    Both ends are inclusive. Returns 0 when start > end or every day has a record.
+    """
+    spent = {e.day for e in rows}
+    best = 0
+    run = 0
+    day = start
+    while day <= end:
+        if day in spent:
+            run = 0
+        else:
+            run += 1
+            best = max(best, run)
+        day += timedelta(days=1)
+    return best
