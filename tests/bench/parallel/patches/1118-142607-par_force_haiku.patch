+import json
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.export import to_json
+
+
+def test_to_json_empty_list_is_empty_array():
+    assert to_json([]) == "[]"
+
+
+def test_to_json_keeps_input_order_and_key_order():
+    rows = [
+        Expense(date(2026, 11, 2), "food", 1200, "lunch"),
+        Expense(date(2026, 11, 1), "rent", 80000, ""),
+    ]
+    out = to_json(rows)
+    assert out == (
+        '[{"date": "2026-11-02", "category": "food", "amount": 1200, "memo": "lunch"}, '
+        '{"date": "2026-11-01", "category": "rent", "amount": 80000, "memo": ""}]'
+    )
+
+
+def test_to_json_keeps_non_ascii_unescaped():
+    out = to_json([Expense(date(2026, 1, 5), "食費", 300, "コンビニ")])
+    assert "食費" in out
+    assert "コンビニ" in out
+    assert "\\u" not in out
+
+
+def test_to_json_roundtrips_through_json_loads():
+    rows = [Expense(date(2026, 3, 9), "travel", 15000, "train")]
+    assert json.loads(to_json(rows)) == [
+        {"date": "2026-03-09", "category": "travel", "amount": 15000, "memo": "train"}
+    ]
