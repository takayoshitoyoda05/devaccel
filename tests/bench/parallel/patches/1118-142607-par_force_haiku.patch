@@ -0,0 +1,17 @@
+"""Totals grouped by day of the week."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+# date.weekday() の値 0〜6 に対応(月曜始まり)。strftime は locale に依存するため使わない。
+_WEEKDAYS = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
+
+
+def total_by_weekday(rows: list[Expense]) -> dict[str, int]:
+    """{"Mon".."Sun": yen}. 明細のない曜日は含めず、キーは月曜始まりの順。"""
+    totals: dict[str, int] = {}
+    for e in rows:
+        name = _WEEKDAYS[e.day.weekday()]
+        totals[name] = totals.get(name, 0) + e.amount
+    return {name: totals[name] for name in _WEEKDAYS if name in totals}
