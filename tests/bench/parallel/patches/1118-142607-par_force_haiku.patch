@@ -0,0 +1,19 @@
+"""Detect duplicate expense records."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def find_duplicates(rows: list[Expense]) -> list[tuple[int, int]]:
+    """Index pairs (i, j), i < j, of rows with equal day, category, amount and memo.
+
+    Sorted by i ascending, then j ascending.
+    """
+    pairs: list[tuple[int, int]] = []
+    keys = [(e.day, e.category, e.amount, e.memo) for e in rows]
+    for i in range(len(keys)):
+        for j in range(i + 1, len(keys)):
+            if keys[i] == keys[j]:
+                pairs.append((i, j))
+    return pairs
