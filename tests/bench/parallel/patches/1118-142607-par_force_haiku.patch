@@ -0,0 +1,61 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.topn import top_expenses
+
+
+def _e(day: date, amount: int, memo: str = "") -> Expense:
+    return Expense(day=day, category="food", amount=amount, memo=memo)
+
+
+def test_orders_by_amount_desc() -> None:
+    rows = [
+        _e(date(2026, 1, 1), 100),
+        _e(date(2026, 1, 2), 500),
+        _e(date(2026, 1, 3), 300),
+    ]
+    assert [e.amount for e in top_expenses(rows, 3)] == [500, 300, 100]
+
+
+def test_takes_only_n() -> None:
+    rows = [
+        _e(date(2026, 1, 1), 100),
+        _e(date(2026, 1, 2), 500),
+        _e(date(2026, 1, 3), 300),
+    ]
+    assert [e.amount for e in top_expenses(rows, 2)] == [500, 300]
+
+
+def test_n_larger_than_rows_returns_all() -> None:
+    rows = [_e(date(2026, 1, 1), 100), _e(date(2026, 1, 2), 500)]
+    assert [e.amount for e in top_expenses(rows, 10)] == [500, 100]
+
+
+def test_same_amount_sorted_by_date_asc() -> None:
+    late = _e(date(2026, 3, 1), 400, "late")
+    early = _e(date(2026, 1, 1), 400, "early")
+    assert top_expenses([late, early], 2) == [early, late]
+
+
+def test_same_amount_same_date_keeps_input_order() -> None:
+    first = _e(date(2026, 2, 1), 400, "first")
+    second = _e(date(2026, 2, 1), 400, "second")
+    assert top_expenses([first, second], 2) == [first, second]
+    assert top_expenses([second, first], 2) == [second, first]
+
+
+def test_zero_or_negative_n_returns_empty() -> None:
+    rows = [_e(date(2026, 1, 1), 100)]
+    assert top_expenses(rows, 0) == []
+    assert top_expenses(rows, -3) == []
+
+
+def test_empty_rows_returns_empty() -> None:
+    assert top_expenses([], 5) == []
+
+
+def test_does_not_mutate_input() -> None:
+    rows = [_e(date(2026, 1, 1), 100), _e(date(2026, 1, 2), 500)]
+    snapshot = list(rows)
+    top_expenses(rows, 1)
+    assert rows == snapshot
