+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.dupes import find_duplicates
+
+
+def _e(
+    day: str = "2024-01-01", category: str = "food", amount: int = 100, memo: str = ""
+) -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+def test_empty_and_no_duplicates() -> None:
+    assert find_duplicates([]) == []
+    assert find_duplicates([_e(), _e(amount=200)]) == []
+
+
+def test_single_pair() -> None:
+    assert find_duplicates([_e(), _e(day="2024-01-02"), _e()]) == [(0, 2)]
+
+
+def test_all_fields_must_match() -> None:
+    rows = [
+        _e(memo="a"),
+        _e(memo="b"),
+        _e(category="fun", memo="a"),
+        _e(day="2024-02-01", memo="a"),
+        _e(amount=101, memo="a"),
+    ]
+    assert find_duplicates(rows) == []
+
+
+def test_order_by_i_then_j() -> None:
+    rows = [_e(), _e(), _e()]
+    assert find_duplicates(rows) == [(0, 1), (0, 2), (1, 2)]
+
+
+def test_pairs_sorted_across_groups() -> None:
+    rows = [_e(amount=1), _e(amount=2), _e(amount=1), _e(amount=2), _e(amount=1)]
+    assert find_duplicates(rows) == [(0, 2), (0, 4), (1, 3), (2, 4)]
