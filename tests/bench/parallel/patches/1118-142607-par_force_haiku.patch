@@ -0,0 +1,53 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.weekday import total_by_weekday
+
+
+def _e(day: date, amount: int) -> Expense:
+    return Expense(day=day, category="food", amount=amount)
+
+
+def test_empty_rows_returns_empty_dict() -> None:
+    assert total_by_weekday([]) == {}
+
+
+def test_sums_amounts_per_weekday() -> None:
+    # 2026-11-16 は月曜、2026-11-23 も月曜
+    rows = [
+        _e(date(2026, 11, 16), 100),
+        _e(date(2026, 11, 23), 250),
+        _e(date(2026, 11, 18), 300),  # 水曜
+    ]
+    assert total_by_weekday(rows) == {"Mon": 350, "Wed": 300}
+
+
+def test_keys_are_in_monday_first_order() -> None:
+    # 2026-11-15 は日曜。逆順で入れても月曜始まりで並ぶこと。
+    rows = [
+        _e(date(2026, 11, 15), 1),  # Sun
+        _e(date(2026, 11, 18), 2),  # Wed
+        _e(date(2026, 11, 16), 3),  # Mon
+        _e(date(2026, 11, 20), 4),  # Fri
+    ]
+    result = total_by_weekday(rows)
+    assert list(result) == ["Mon", "Wed", "Fri", "Sun"]
+    assert result == {"Mon": 3, "Wed": 2, "Fri": 4, "Sun": 1}
+
+
+def test_weekdays_without_rows_are_omitted() -> None:
+    rows = [_e(date(2026, 11, 21), 500)]  # 土曜
+    assert total_by_weekday(rows) == {"Sat": 500}
+
+
+def test_all_seven_weekdays() -> None:
+    rows = [_e(date(2026, 11, 16 + i), (i + 1) * 10) for i in range(7)]
+    assert total_by_weekday(rows) == {
+        "Mon": 10,
+        "Tue": 20,
+        "Wed": 30,
+        "Thu": 40,
+        "Fri": 50,
+        "Sat": 60,
+        "Sun": 70,
+    }
