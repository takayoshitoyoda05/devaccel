@@ -0,0 +1,129 @@
+"""Detect monthly recurring expenses (subscriptions, rent, ...) and predict the next date.
+
+Pure functions only; no I/O.
+
+Decisions:
+D1: 同一とみなす鍵 = (正規化した category, 正規化した memo)。正規化 = NFKC → casefold →
+    空白(全角含む)の連続を半角空白 1 つに → strip → 末尾の「空白+数字」を除去。
+    例: "Netflix" / "ＮＥＴＦＬＩＸ" / "netflix 2" は同じ鍵。memo が空なら category だけで決まる。金額は鍵に含めない。
+D2: 金額 <= 0 の行(0 と返金の負数)は無視する。
+D3: 同じ鍵が同じ月に複数ある場合、その月は日付が最も新しい 1 件だけを使う(完全な重複も 1 か月)。
+D4: 系列 = 鍵ごとの「最新の月で終わる、暦月が連続した末尾の連なり」。月が抜けたらそこで切れ、古い側は無視する。
+D5: 系列の月数が min_months(既定 3)以上で繰り返しとみなす。入力の並び順は結果に影響しない。空入力は []。
+D6: 日の一貫性: anchor_day = 系列内の day の最大値。各日付の day が
+    min(anchor_day, その月の末日) から 3 日以内(差の絶対値 <= 3)であること。
+    例: 27,27,25 日 → OK / 5,5,20 日 → 不可 / 1/31, 2/28, 3/31 → OK。
+D7: 系列の全金額が最新の金額の ±20% 以内(abs(a - latest) * 100 <= latest * 20、境界を含む)。
+D8: next_date = last_date の翌月の anchor_day 日。翌月の末日を超えるなら末日に丸める。
+    例: 2026-01-31(anchor 31) → 2026-02-28 / 2024-01-31 → 2024-02-29 / 2026-12-05(anchor 5) → 2027-01-05。
+D9: next_monthly_date(last, anchor_day) が D8 の計算そのもの。anchor_day は last の day と違ってもよい。
+D10: 同じカテゴリ・金額でも memo が違えば別の系列。
+D11: 結果の並び = next_date 昇順、同じなら category、さらに memo の昇順。
+D12: today を取らない。最新が古い系列でも返し、next_date が過去でもそのまま返す。
+D13: Recurring.amount は系列の最新の行の金額、months は系列の月数、last_date は系列の最新の日付。
+引数: min_months は bool / int 以外 → TypeError、2 未満 → ValueError。
+      anchor_day は bool / int 以外 → TypeError、1..31 の外 → ValueError。
+"""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from collections.abc import Sequence
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_DAY_TOLERANCE = 3
+_AMOUNT_TOLERANCE_PCT = 20
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int  # yen, latest in the series
+    anchor_day: int
+    months: int
+    last_date: date
+    next_date: date
+
+
+def _check_int(value: object, name: str) -> int:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{name} は int である必要があります: {value!r}")
+    return value
+
+
+def _normalize(text: str) -> str:
+    s = unicodedata.normalize("NFKC", text).casefold()
+    s = re.sub(r"\s+", " ", s).strip()
+    return re.sub(r"\s+[0-9]+$", "", s)
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month - 1
+
+
+def next_monthly_date(last: date, anchor_day: int) -> date:
+    _check_int(anchor_day, "anchor_day")
+    if not 1 <= anchor_day <= 31:
+        raise ValueError(f"anchor_day は 1〜31 である必要があります: {anchor_day}")
+    year, month0 = divmod(_month_index(last) + 1, 12)
+    month = month0 + 1
+    return date(year, month, min(anchor_day, calendar.monthrange(year, month)[1]))
+
+
+def _is_series(run: list[Expense]) -> bool:
+    anchor = max(e.day.day for e in run)
+    for e in run:
+        target = min(anchor, calendar.monthrange(e.day.year, e.day.month)[1])
+        if abs(e.day.day - target) > _DAY_TOLERANCE:
+            return False
+    latest = run[-1].amount
+    return all(
+        abs(e.amount - latest) * 100 <= latest * _AMOUNT_TOLERANCE_PCT for e in run
+    )
+
+
+def find_recurring(rows: Sequence[Expense], *, min_months: int = 3) -> list[Recurring]:
+    _check_int(min_months, "min_months")
+    if min_months < 2:
+        raise ValueError(f"min_months は 2 以上である必要があります: {min_months}")
+
+    groups: dict[tuple[str, str], dict[int, Expense]] = {}
+    for e in rows:
+        if e.amount <= 0:
+            continue
+        by_month = groups.setdefault((_normalize(e.category), _normalize(e.memo)), {})
+        idx = _month_index(e.day)
+        cur = by_month.get(idx)
+        if cur is None or (e.day, e.amount) > (cur.day, cur.amount):
+            by_month[idx] = e
+
+    out: list[Recurring] = []
+    for by_month in groups.values():
+        idxs = sorted(by_month)
+        start = len(idxs) - 1
+        while start > 0 and idxs[start - 1] == idxs[start] - 1:
+            start -= 1
+        run = [by_month[i] for i in idxs[start:]]
+        if len(run) < min_months or not _is_series(run):
+            continue
+        latest = run[-1]
+        anchor = max(e.day.day for e in run)
+        out.append(
+            Recurring(
+                category=latest.category,
+                memo=latest.memo.strip(),
+                amount=latest.amount,
+                anchor_day=anchor,
+                months=len(run),
+                last_date=latest.day,
+                next_date=next_monthly_date(latest.day, anchor),
+            )
+        )
+    out.sort(key=lambda r: (r.next_date, r.category, r.memo))
+    return out
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
