@@ -0,0 +1,211 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring
+
+
+def E(d: date, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(day=d, category=category, amount=amount, memo=memo)
+
+
+# --- 例の表 (E1-*) -------------------------------------------------------
+
+RENT_ROWS = [
+    E(date(2023, 1, 31), "家賃", 80000, "家賃"),
+    E(date(2023, 2, 28), "家賃", 80000, "家賃"),
+    E(date(2023, 3, 31), "家賃", 80000, "家賃"),
+]
+RENT_EXPECTED = [
+    Recurring("家賃", "家賃", 80000, 3, date(2023, 3, 31), date(2023, 4, 30)),
+]
+
+VIDEO_ROWS = [
+    E(date(2024, 1, 5), "動画", 1000, "動画"),
+    E(date(2024, 2, 5), "動画", 1000, "動画"),
+    E(date(2024, 4, 5), "動画", 1000, "動画"),
+]
+
+SAME_AMOUNT_ROWS = [
+    E(date(2024, 1, 10), "食費", 500, "A"),
+    E(date(2024, 2, 10), "食費", 500, "A"),
+    E(date(2024, 3, 10), "食費", 500, "A"),
+    E(date(2024, 1, 20), "食費", 500, "B"),
+    E(date(2024, 2, 20), "食費", 500, "B"),
+    E(date(2024, 3, 20), "食費", 500, "B"),
+]
+SAME_AMOUNT_EXPECTED = [
+    Recurring("食費", "A", 500, 3, date(2024, 3, 10), date(2024, 4, 10)),
+    Recurring("食費", "B", 500, 3, date(2024, 3, 20), date(2024, 4, 20)),
+]
+
+
+@pytest.mark.parametrize(
+    ("rows", "expected"),
+    [
+        pytest.param(RENT_ROWS, RENT_EXPECTED, id="E1-1"),
+        pytest.param(VIDEO_ROWS, [], id="E1-2"),
+        pytest.param(SAME_AMOUNT_ROWS, SAME_AMOUNT_EXPECTED, id="E1-3"),
+    ],
+)
+def test_example_table(rows: list[Expense], expected: list[Recurring]) -> None:
+    assert find_recurring(rows) == expected
+
+
+# --- 追加の端のケース ----------------------------------------------------
+
+
+def test_empty_rows_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+@pytest.mark.parametrize("bad", [True, False, 2.0, "3", None, 1, 0])
+def test_min_count_rejects_invalid_values(bad: object) -> None:
+    with pytest.raises(ValueError, match="min_count"):
+        find_recurring(RENT_ROWS, min_count=bad)  # type: ignore[arg-type]
+
+
+def test_min_count_two_is_accepted() -> None:
+    rows = VIDEO_ROWS[:2]
+    result = find_recurring(rows, min_count=2)
+    assert [r.count for r in result] == [2]
+
+
+def test_non_expense_row_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([("2024-01-01", "x", 1, "")])  # type: ignore[list-item]
+
+
+def test_bool_amount_row_raises() -> None:
+    row = Expense(day=date(2024, 1, 1), category="x", amount=True, memo="")
+    with pytest.raises(ValueError):
+        find_recurring([row])
+
+
+def test_negative_and_zero_amounts_are_ignored() -> None:
+    rows = [
+        E(date(2024, 1, 5), "返金", -1000, "返金"),
+        E(date(2024, 2, 5), "返金", -1000, "返金"),
+        E(date(2024, 3, 5), "返金", -1000, "返金"),
+        E(date(2024, 1, 6), "無料", 0, "無料"),
+        E(date(2024, 2, 6), "無料", 0, "無料"),
+        E(date(2024, 3, 6), "無料", 0, "無料"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_price_change_starts_a_new_series() -> None:
+    rows = [
+        E(date(2024, 1, 1), "通信", 1000, "net"),
+        E(date(2024, 2, 1), "通信", 1000, "net"),
+        E(date(2024, 3, 1), "通信", 1200, "net"),
+        E(date(2024, 4, 1), "通信", 1200, "net"),
+    ]
+    # 1000 円系列は 1・2 月の 2 か月、1200 円系列は 3・4 月の 2 か月。どちらも min_count=3 未満
+    assert find_recurring(rows) == []
+
+
+def test_normalized_memo_groups_fullwidth_and_trailing_numbers() -> None:
+    rows = [
+        E(date(2024, 1, 1), "通信", 1000, "Ｎｅｔ #1"),
+        E(date(2024, 2, 1), "通信", 1000, "net 2"),
+        E(date(2024, 3, 1), "通信", 1000, "NET"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].memo == "NET"
+    assert result[0].count == 3
+
+
+def test_empty_normalized_memo_groups_by_category_and_amount() -> None:
+    rows = [
+        E(date(2024, 1, 1), "雑費", 300, ""),
+        E(date(2024, 2, 1), "雑費", 300, "#7"),
+        E(date(2024, 3, 1), "雑費", 300, "12"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].count == 3
+    assert result[0].memo == "12"
+
+
+def test_duplicate_month_excludes_series() -> None:
+    rows = [
+        E(date(2024, 1, 1), "家賃", 80000, "家賃"),
+        E(date(2024, 2, 1), "家賃", 80000, "家賃"),
+        E(date(2024, 2, 15), "家賃", 80000, "家賃"),
+        E(date(2024, 3, 1), "家賃", 80000, "家賃"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_gap_in_months_breaks_run_from_latest() -> None:
+    rows = [
+        E(date(2024, 1, 1), "保険", 900, "保険"),
+        E(date(2024, 2, 1), "保険", 900, "保険"),
+        E(date(2024, 3, 1), "保険", 900, "保険"),
+        E(date(2024, 5, 1), "保険", 900, "保険"),
+        E(date(2024, 6, 1), "保険", 900, "保険"),
+    ]
+    # 最新 6 月から遡ると 5・6 月の 2 か月で止まる
+    assert find_recurring(rows) == []
+
+
+def test_result_sorted_by_next_day_then_category_memo_amount() -> None:
+    rows = [
+        E(date(2024, 1, 20), "B", 100, "x"),
+        E(date(2024, 2, 20), "B", 100, "x"),
+        E(date(2024, 3, 20), "B", 100, "x"),
+        E(date(2024, 1, 5), "A", 100, "x"),
+        E(date(2024, 2, 5), "A", 100, "x"),
+        E(date(2024, 3, 5), "A", 100, "x"),
+        E(date(2024, 1, 5), "A", 200, "x"),
+        E(date(2024, 2, 5), "A", 200, "x"),
+        E(date(2024, 3, 5), "A", 200, "x"),
+    ]
+    result = find_recurring(rows)
+    assert [(r.next_day, r.category, r.amount) for r in result] == [
+        (date(2024, 4, 5), "A", 100),
+        (date(2024, 4, 5), "A", 200),
+        (date(2024, 4, 20), "B", 100),
+    ]
+
+
+def test_december_rolls_over_to_january() -> None:
+    rows = [
+        E(date(2023, 10, 15), "本", 500, "本"),
+        E(date(2023, 11, 15), "本", 500, "本"),
+        E(date(2023, 12, 15), "本", 500, "本"),
+    ]
+    assert find_recurring(rows)[0].next_day == date(2024, 1, 15)
+
+
+def test_mode_tie_prefers_larger_day() -> None:
+    rows = [
+        E(date(2024, 1, 5), "x", 100, "x"),
+        E(date(2024, 2, 20), "x", 100, "x"),
+        E(date(2024, 3, 5), "x", 100, "x"),
+        E(date(2024, 4, 20), "x", 100, "x"),
+    ]
+    assert find_recurring(rows)[0].next_day == date(2024, 5, 20)
+
+
+def test_next_day_clamps_to_month_end_non_leap() -> None:
+    rows = [
+        E(date(2021, 11, 30), "x", 100, "x"),
+        E(date(2021, 12, 31), "x", 100, "x"),
+        E(date(2022, 1, 31), "x", 100, "x"),
+    ]
+    assert find_recurring(rows)[0].next_day == date(2022, 2, 28)
+
+
+def test_next_day_clamps_to_month_end_leap() -> None:
+    rows = [
+        E(date(2023, 11, 30), "x", 100, "x"),
+        E(date(2023, 12, 31), "x", 100, "x"),
+        E(date(2024, 1, 31), "x", 100, "x"),
+    ]
+    assert find_recurring(rows)[0].next_day == date(2024, 2, 29)
