@@ -0,0 +1,75 @@
+"""Month-over-month category comparison (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense, monthly_totals
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    prev: int
+    curr: int
+    diff: int
+    pct: float | None
+    status: str  # "up" | "down" | "same" | "new" | "gone"
+
+
+def _prev_month(month: str) -> str:
+    year, mon = int(month[:4]), int(month[5:])
+    if mon == 1:
+        return f"{year - 1}-12"
+    return f"{year}-{mon - 1:02d}"
+
+
+def compare_months(rows: list[Expense], month: str) -> list[CategoryChange]:
+    if not isinstance(month, str) or not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+    prev_month = _prev_month(month)
+    totals = monthly_totals(rows)
+    prev_cats = totals.get(prev_month, {})
+    curr_cats = totals.get(month, {})
+
+    out: list[CategoryChange] = []
+    for cat in set(prev_cats) | set(curr_cats):
+        prev = prev_cats.get(cat, 0)
+        curr = curr_cats.get(cat, 0)
+        if prev == 0 and curr == 0:
+            continue
+        diff = curr - prev
+        pct = None if prev == 0 else diff / prev * 100
+        if prev == 0:
+            status = "new"
+        elif curr == 0:
+            status = "gone"
+        elif diff > 0:
+            status = "up"
+        elif diff < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(CategoryChange(cat, prev, curr, diff, pct, status))
+
+    out.sort(key=lambda c: (-abs(c.diff), c.category))
+    return out
+
+
+def format_report(month: str, changes: list[CategoryChange]) -> str:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+    lines = [f"{_prev_month(month)} → {month} の増減"]
+    if not changes:
+        lines.append("変化なし")
+    for c in changes:
+        pct = (
+            f"{c.pct:+.1f}%"
+            if c.pct is not None
+            else ("新規" if c.status == "new" else "なし")
+        )
+        lines.append(f"{c.category}: {c.prev} → {c.curr} ({c.diff:+d} 円, {pct})")
+    return "\n".join(lines)
