@@ -0,0 +1,126 @@
+"""Recurring expense detection (pure functions, standard library only)."""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from collections import Counter
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int
+    count: int
+    last_day: date
+    next_day: date
+
+
+_SPACES_RE = re.compile(r"\s+")
+_TRAILING_NUM_RE = re.compile(r"[\s#]*[0-9]+$")
+
+
+def _normalize_memo(memo: str) -> str:
+    """NFKC, casefold, collapse spaces, drop trailing number (with preceding space/#)."""
+    s = unicodedata.normalize("NFKC", memo).casefold()
+    s = _SPACES_RE.sub(" ", s).strip()
+    s = _TRAILING_NUM_RE.sub("", s)
+    return s.strip()
+
+
+# 入力の型違反も仕様どおり ValueError で返す(TypeError にはしない)。
+# ruff TRY004 は型チェック後の ValueError を指摘するため、該当行だけ抑制する。
+def _check_min_count(min_count: object) -> int:
+    if isinstance(min_count, bool) or not isinstance(min_count, int):
+        raise ValueError(f"min_count は int である必要があります: {min_count!r}")  # noqa: TRY004
+    if min_count < 2:
+        raise ValueError(f"min_count は 2 以上である必要があります: {min_count}")
+    return min_count
+
+
+def _check_row(e: object, i: int) -> Expense:
+    if not isinstance(e, Expense):
+        raise ValueError(f"rows[{i}] は Expense である必要があります")  # noqa: TRY004
+    if not isinstance(e.day, date):
+        raise ValueError(f"rows[{i}].day は date である必要があります")  # noqa: TRY004
+    if not isinstance(e.category, str):
+        raise ValueError(f"rows[{i}].category は str である必要があります")  # noqa: TRY004
+    if not isinstance(e.memo, str):
+        raise ValueError(f"rows[{i}].memo は str である必要があります")  # noqa: TRY004
+    if isinstance(e.amount, bool) or not isinstance(e.amount, int):
+        raise ValueError(f"rows[{i}].amount は int である必要があります")  # noqa: TRY004
+    return e
+
+
+def _next_day(latest: date, days: list[int]) -> date:
+    """Next month after `latest`; most frequent day (ties: larger), clamped to month end."""
+    abs_month = latest.year * 12 + (latest.month - 1) + 1
+    year, month0 = divmod(abs_month, 12)
+    month = month0 + 1
+    last = calendar.monthrange(year, month)[1]
+    freq = Counter(days)
+    best = max(freq, key=lambda d: (freq[d], d))
+    return date(year, month, min(best, last))
+
+
+def find_recurring(rows: list[Expense], min_count: int = 3) -> list[Recurring]:
+    """Detect expense series that recur monthly up to the latest month.
+
+    Only rows with amount > 0 are considered. A series is the set of rows with the
+    same (category, normalized memo, amount); it qualifies when its run of
+    consecutive months ending at the latest month is at least `min_count`, and it
+    has no two rows in the same month.
+    """
+    min_count = _check_min_count(min_count)
+    if not isinstance(rows, list):
+        raise ValueError("rows は list である必要があります")  # noqa: TRY004
+
+    groups: dict[tuple[str, str, int], list[Expense]] = {}
+    for i, raw in enumerate(rows):
+        e = _check_row(raw, i)
+        if e.amount <= 0:
+            continue
+        key = (e.category, _normalize_memo(e.memo), e.amount)
+        groups.setdefault(key, []).append(e)
+
+    out: list[Recurring] = []
+    for (category, _norm, amount), items in groups.items():
+        by_month: dict[int, Expense] = {}
+        duplicated = False
+        for e in items:
+            k = e.day.year * 12 + (e.day.month - 1)
+            if k in by_month:
+                duplicated = True
+                break
+            by_month[k] = e
+        if duplicated:
+            continue
+
+        latest_k = max(by_month)
+        run = 0
+        while latest_k - run in by_month:
+            run += 1
+        if run < min_count:
+            continue
+
+        latest = by_month[latest_k]
+        days = [e.day.day for e in items]
+        out.append(
+            Recurring(
+                category=category,
+                memo=latest.memo,
+                amount=amount,
+                count=run,
+                last_day=latest.day,
+                next_day=_next_day(latest.day, days),
+            )
+        )
+
+    out.sort(key=lambda r: (r.next_day, r.category, r.memo, r.amount))
+    return out
