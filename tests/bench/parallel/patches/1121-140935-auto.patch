+++ b/tests/test_monthly_diff.py
@@ -0,0 +1,89 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthly_diff import CategoryChange, compare_months, format_report
+
+
+def _e(y: int, m: int, category: str, amount: int) -> Expense:
+    return Expense(day=date(y, m, 15), category=category, amount=amount)
+
+
+@pytest.mark.parametrize(
+    ("rows", "month", "expected"),
+    [
+        pytest.param(
+            [_e(2026, 1, "食費", 1000), _e(2026, 2, "食費", 1500)],
+            "2026-02",
+            [CategoryChange("食費", 1000, 1500, 500, 50.0, "up")],
+            id="E4-1",
+        ),
+        pytest.param(
+            [_e(2026, 1, "交通", 800), _e(2026, 2, "食費", 100)],
+            "2026-02",
+            [
+                CategoryChange("交通", 800, 0, -800, -100.0, "gone"),
+                CategoryChange("食費", 0, 100, 100, None, "new"),
+            ],
+            id="E4-2",
+        ),
+    ],
+)
+def test_compare_months_table(
+    rows: list[Expense], month: str, expected: list[CategoryChange]
+) -> None:
+    assert compare_months(rows, month) == expected
+
+
+@pytest.mark.parametrize("month", [pytest.param("2026-13", id="E4-3")])
+def test_compare_months_rejects_invalid_month(month: str) -> None:
+    with pytest.raises(ValueError):
+        compare_months([_e(2026, 1, "食費", 1000)], month)
+
+
+def test_january_compares_with_previous_december() -> None:
+    rows = [_e(2025, 12, "食費", 900), _e(2026, 1, "食費", 900)]
+    assert compare_months(rows, "2026-01") == [
+        CategoryChange("食費", 900, 900, 0, 0.0, "same")
+    ]
+
+
+def test_no_data_in_either_month_returns_empty() -> None:
+    assert compare_months([_e(2026, 5, "食費", 100)], "2026-02") == []
+
+
+def test_zero_net_category_is_omitted() -> None:
+    rows = [_e(2026, 1, "食費", 0), _e(2026, 2, "食費", 0), _e(2026, 2, "雑費", 10)]
+    cats = [c.category for c in compare_months(rows, "2026-02")]
+    assert cats == ["雑費"]
+
+
+def test_sorted_by_abs_diff_then_category() -> None:
+    rows = [
+        _e(2026, 1, "b", 100),
+        _e(2026, 1, "a", 300),
+        _e(2026, 2, "c", 200),
+        _e(2026, 2, "b", 0),
+    ]
+    # b: diff -100, a: diff -300, c: diff +200
+    names = [c.category for c in compare_months(rows, "2026-02")]
+    assert names == ["a", "c", "b"]
+
+
+def test_format_report_up_and_new_and_gone() -> None:
+    changes = [
+        CategoryChange("食費", 1000, 1500, 500, 50.0, "up"),
+        CategoryChange("交通", 800, 0, -800, -100.0, "gone"),
+        CategoryChange("雑費", 0, 100, 100, None, "new"),
+    ]
+    assert format_report("2026-02", changes) == (
+        "2026-01 → 2026-02 の増減\n"
+        "食費: 1000 → 1500 (+500 円, +50.0%)\n"
+        "交通: 800 → 0 (-800 円, -100.0%)\n"
+        "雑費: 0 → 100 (+100 円, 新規)"
+    )
+
+
+def test_format_report_empty_says_no_change() -> None:
+    assert format_report("2026-02", []) == "2026-01 → 2026-02 の増減\n変化なし"
