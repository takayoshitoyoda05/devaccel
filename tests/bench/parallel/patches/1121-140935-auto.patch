@@ -0,0 +1,182 @@
+"""Parse bank statement CSV text into Expense records (pure, stdlib only)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from collections.abc import Callable
+from datetime import date
+
+from kakeibo.core import CsvError, Expense
+
+_ROLE_ALIASES: dict[str, tuple[str, ...]] = {
+    "日付": ("date", "日付", "利用日", "取引日", "ご利用日", "年月日"),
+    "金額": ("amount", "金額", "利用金額", "ご利用金額"),
+    "出金": ("出金額", "出金", "お支払金額", "支払金額", "支払"),
+    "入金": ("入金額", "入金", "預入"),
+    "メモ": ("memo", "description", "摘要", "メモ", "内容", "利用店名", "ご利用店名"),
+    "カテゴリ": ("category", "カテゴリ", "分類", "費目"),
+}
+
+# 日付: 区切りは同じ記号で揃える。後ろの空白・T 以降の時刻は無視する。
+_DATE_SEP_RE = re.compile(r"([0-9]{4})([-/.])([0-9]{1,2})\2([0-9]{1,2})")
+_DATE_JP_RE = re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日")
+_DATE_HEAD_RE = re.compile(r"([^ \t]*?)(?:[ \t].*|T.*)?", re.DOTALL)
+
+# 金額の符号(D2): 先頭の - − △ ▲、括弧、末尾の -。
+_YEN_RE = re.compile(r"(?:[-−△▲]([0-9]+)|\(([0-9]+)\)|([0-9]+)-|([0-9]+))")
+_YEN_NOISE_RE = re.compile(r"¥|円|JPY|\s|,", re.IGNORECASE)
+
+
+def _norm(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip().casefold()
+
+
+_ROLE_OF: dict[str, str] = {
+    _norm(alias): role for role, aliases in _ROLE_ALIASES.items() for alias in aliases
+}
+
+
+def _find(header: list[str], role: str) -> int | None:
+    idxs = [i for i, h in enumerate(header) if _ROLE_OF.get(_norm(h)) == role]
+    if len(idxs) > 1:
+        raise ValueError(f"列 {role} が重複しています")
+    return idxs[0] if idxs else None
+
+
+def _parse_date(raw: str) -> date:
+    err = ValueError(f"日付が不正です: {raw!r}")
+    head = _DATE_HEAD_RE.fullmatch(unicodedata.normalize("NFKC", raw).strip())
+    if head is None:
+        raise err
+    body = head.group(1)
+    try:
+        sep = _DATE_SEP_RE.fullmatch(body)
+        if sep is not None:
+            return date(int(sep.group(1)), int(sep.group(3)), int(sep.group(4)))
+        jp = _DATE_JP_RE.fullmatch(body)
+        if jp is not None:
+            return date(int(jp.group(1)), int(jp.group(2)), int(jp.group(3)))
+    except ValueError:
+        raise err from None
+    raise err
+
+
+def _parse_yen(raw: str, label: str, blank_zero: bool) -> int:
+    s = _YEN_NOISE_RE.sub("", unicodedata.normalize("NFKC", raw))
+    if s == "":
+        if blank_zero:
+            return 0
+        raise ValueError(f"{label}が不正です: {raw!r}")
+    m = _YEN_RE.fullmatch(s)
+    if m is None:
+        raise ValueError(f"{label}が不正です: {raw!r}")
+    neg = m.group(1) or m.group(2) or m.group(3)
+    if neg is not None:
+        return -int(neg)
+    return int(m.group(4))
+
+
+def _attempt[T](reasons: list[str], fn: Callable[..., T], *args: object) -> T | None:
+    try:
+        return fn(*args)
+    except ValueError as e:
+        reasons.append(str(e))
+        return None
+
+
+def parse_bank_csv(text: str, default_category: str = "未分類") -> list[Expense]:
+    if not isinstance(text, str):
+        raise TypeError(f"text は str である必要があります: {type(text).__name__}")
+    text = text.removeprefix("﻿")
+    if not text.strip():
+        return []
+
+    first = next(line for line in re.split(r"\r\n|\r|\n", text) if line.strip())
+    delim = "\t" if first.count("\t") > first.count(",") else ","
+
+    # 各レコードの開始行(ヘッダーが 1 行目)を保持し、空行(全セル空白)は読み飛ばす。
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delim)
+    records: list[tuple[int, list[str]]] = []
+    prev_end = 0
+    for row in reader:
+        start = prev_end + 1
+        prev_end = reader.line_num
+        if all(not c.strip() for c in row):
+            continue
+        records.append((start, row))
+    if not records:
+        return []
+
+    _, header = records[0]
+    body = records[1:]
+    idx_date = _find(header, "日付")
+    idx_amount = _find(header, "金額")
+    idx_out = _find(header, "出金")
+    idx_in = _find(header, "入金")
+    idx_memo = _find(header, "メモ")
+    idx_cat = _find(header, "カテゴリ")
+
+    if idx_amount is not None and (idx_out is not None or idx_in is not None):
+        raise ValueError("金額列と出金/入金列を同時に指定できません")
+    two_col = idx_out is not None
+
+    missing: list[tuple[int, str]] = []
+    if idx_date is None:
+        missing.append((1, "列 日付 がありません"))
+    if idx_amount is None and not two_col:
+        missing.append((1, "列 金額 がありません"))
+    if missing:
+        raise CsvError(missing)
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    width = len(header)
+    for start, row in body:
+        if len(row) != width:
+            errors.append((start, f"列数が合いません: 期待 {width}、実際 {len(row)}"))
+            continue
+
+        reasons: list[str] = []
+        day = (
+            _attempt(reasons, _parse_date, row[idx_date])
+            if idx_date is not None
+            else None
+        )
+        amount: int | None = None
+        out: int | None = None
+        inc: int | None = 0
+        if two_col and idx_out is not None:
+            out = _attempt(reasons, _parse_yen, row[idx_out], "出金", True)
+            if idx_in is not None:
+                inc = _attempt(reasons, _parse_yen, row[idx_in], "入金", True)
+        elif idx_amount is not None:
+            amount = _attempt(reasons, _parse_yen, row[idx_amount], "金額", False)
+        if reasons or day is None:
+            errors.extend((start, r) for r in reasons)
+            continue
+
+        if two_col:
+            if out is None or inc is None:
+                continue  # 到達しない(reasons が空なら両方に値がある)
+            if out != 0 and inc != 0:
+                errors.append((start, "出金と入金の両方に金額があります"))
+                continue
+            if inc != 0:
+                continue  # 入金だけの行は収入としてスキップ
+            amount = out
+        if amount is None:
+            continue  # 到達しない(reasons が空なら金額がある)
+
+        category = (
+            row[idx_cat].strip() if idx_cat is not None else ""
+        ) or default_category
+        memo = row[idx_memo].strip() if idx_memo is not None else ""
+        expenses.append(Expense(day=day, category=category, amount=amount, memo=memo))
+
+    if errors:
+        errors.sort(key=lambda e: e[0])
+        raise CsvError(errors)
+    return expenses
