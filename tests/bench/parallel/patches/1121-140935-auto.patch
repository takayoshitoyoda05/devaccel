new file mode 100644
index 0000000..ab070a4
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,115 @@
+"""Condition-based search over Expense rows (pure functions)."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable
+from datetime import date, datetime
+
+from kakeibo.core import Expense
+
+Cond = Callable[[Expense], bool]
+
+
+def _is_int(v: object) -> bool:
+    return isinstance(v, int) and not isinstance(v, bool)
+
+
+def _norm(text: str) -> str:
+    return unicodedata.normalize("NFKC", text).casefold()
+
+
+def category_is(*names: str) -> Cond:
+    if not names:
+        raise ValueError("カテゴリ名を 1 つ以上指定してください")
+    stripped: set[str] = set()
+    for name in names:
+        if not isinstance(name, str):
+            raise TypeError(f"カテゴリ名は文字列である必要があります: {name!r}")
+        s = name.strip()
+        if not s:
+            raise ValueError("空のカテゴリ名は指定できません")
+        stripped.add(s)
+
+    def cond(e: Expense) -> bool:
+        return e.category.strip() in stripped
+
+    return cond
+
+
+def amount_between(low: int | None = None, high: int | None = None) -> Cond:
+    for label, v in (("low", low), ("high", high)):
+        if v is not None and not _is_int(v):
+            raise TypeError(f"{label} は int または None である必要があります: {v!r}")
+    if low is not None and high is not None and low > high:
+        raise ValueError(f"下限 {low} が上限 {high} を超えています")
+
+    def cond(e: Expense) -> bool:
+        return (low is None or e.amount >= low) and (high is None or e.amount <= high)
+
+    return cond
+
+
+def memo_contains(text: str) -> Cond:
+    if not isinstance(text, str):
+        raise TypeError(f"text は文字列である必要があります: {text!r}")
+    if text == "":
+        raise ValueError("空文字では検索できません")
+    needle = _norm(text)
+
+    def cond(e: Expense) -> bool:
+        return needle in _norm(e.memo)
+
+    return cond
+
+
+def day_between(start: date | None = None, end: date | None = None) -> Cond:
+    for label, v in (("start", start), ("end", end)):
+        if v is not None and (not isinstance(v, date) or isinstance(v, datetime)):
+            raise TypeError(f"{label} は date または None である必要があります: {v!r}")
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"開始 {start} が終了 {end} を超えています")
+
+    def cond(e: Expense) -> bool:
+        return (start is None or e.day >= start) and (end is None or e.day <= end)
+
+    return cond
+
+
+def _check_cond(c: object) -> None:
+    if not callable(c):
+        raise TypeError(f"条件は呼び出し可能である必要があります: {c!r}")
+
+
+def all_of(*conds: Cond) -> Cond:
+    for c in conds:
+        _check_cond(c)
+
+    def cond(e: Expense) -> bool:
+        return all(c(e) for c in conds)
+
+    return cond
+
+
+def any_of(*conds: Cond) -> Cond:
+    for c in conds:
+        _check_cond(c)
+
+    def cond(e: Expense) -> bool:
+        return any(c(e) for c in conds)
+
+    return cond
+
+
+def negate(c: Cond) -> Cond:
+    _check_cond(c)
+
+    def cond(e: Expense) -> bool:
+        return not c(e)
+
+    return cond
+
+
+def search(rows: list[Expense], cond: Cond) -> list[Expense]:
+    _check_cond(cond)
+    return [e for e in rows if cond(e)]
