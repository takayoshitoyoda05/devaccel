+++ b/tests/test_search.py
@@ -0,0 +1,179 @@
+from datetime import date, datetime
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    all_of,
+    amount_between,
+    any_of,
+    category_is,
+    day_between,
+    memo_contains,
+    negate,
+    search,
+)
+
+
+def ex(
+    amount: int = 100,
+    memo: str = "",
+    category: str = "食費",
+    day: date = date(2026, 3, 15),
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- 例の表 (E3) の全行 ---
+
+
+@pytest.mark.parametrize(
+    ("make_cond", "row"),
+    [
+        pytest.param(lambda: amount_between(100, 100), ex(amount=100), id="E3-1"),
+        pytest.param(lambda: memo_contains("ＳＵＢ"), ex(memo="sub-pay"), id="E3-2"),
+    ],
+)
+def test_example_table_true_cases(make_cond, row):
+    assert make_cond()(row) is True
+
+
+@pytest.mark.parametrize(
+    "make_cond",
+    [
+        pytest.param(lambda: amount_between(500, 100), id="E3-3"),
+    ],
+)
+def test_example_table_raise_cases(make_cond):
+    with pytest.raises(ValueError):
+        make_cond()
+
+
+# --- 規則 R1〜R6 ---
+
+
+def test_amount_between_both_ends_inclusive():
+    cond = amount_between(100, 200)
+    assert cond(ex(amount=100))
+    assert cond(ex(amount=200))
+    assert not cond(ex(amount=99))
+    assert not cond(ex(amount=201))
+
+
+def test_amount_between_open_ends():
+    assert amount_between(low=100)(ex(amount=10**9))
+    assert not amount_between(low=100)(ex(amount=99))
+    assert amount_between(high=100)(ex(amount=-5000))
+    assert not amount_between(high=100)(ex(amount=101))
+    assert amount_between()(ex(amount=-1))
+
+
+def test_amount_between_accepts_negative_refunds():
+    assert amount_between(-500, -100)(ex(amount=-300))
+
+
+@pytest.mark.parametrize("bad", [True, 1.5, "100"])
+def test_amount_between_type_errors(bad):
+    with pytest.raises(TypeError):
+        amount_between(bad, None)
+    with pytest.raises(TypeError):
+        amount_between(None, bad)
+
+
+def test_day_between_inclusive_and_open_ends():
+    cond = day_between(date(2026, 3, 1), date(2026, 3, 31))
+    assert cond(ex(day=date(2026, 3, 1)))
+    assert cond(ex(day=date(2026, 3, 31)))
+    assert not cond(ex(day=date(2026, 2, 28)))
+    assert not cond(ex(day=date(2026, 4, 1)))
+    assert day_between(start=date(2026, 3, 1))(ex(day=date(2030, 1, 1)))
+    assert day_between(end=date(2026, 3, 1))(ex(day=date(2000, 1, 1)))
+
+
+def test_day_between_reversed_raises():
+    with pytest.raises(ValueError):
+        day_between(date(2026, 3, 2), date(2026, 3, 1))
+
+
+def test_day_between_rejects_datetime_and_non_date():
+    with pytest.raises(TypeError):
+        day_between(datetime(2026, 3, 1))
+    with pytest.raises(TypeError):
+        day_between(end="2026-03-01")  # type: ignore[arg-type]
+
+
+def test_category_is_exact_match_with_strip_only():
+    assert category_is("食費")(ex(category="食費"))
+    assert category_is(" 食費 ")(ex(category="食費"))
+    assert not category_is("食")(ex(category="食費"))
+    assert not category_is("食費")(ex(category="食費 外"))
+
+
+def test_category_is_multiple_names_or():
+    cond = category_is("食費", "交通費")
+    assert cond(ex(category="交通費"))
+    assert cond(ex(category="食費"))
+    assert not cond(ex(category="娯楽"))
+
+
+@pytest.mark.parametrize("args", [(), ("",), ("  ",)])
+def test_category_is_invalid_names_raise(args):
+    with pytest.raises(ValueError):
+        category_is(*args)
+
+
+def test_memo_contains_partial_and_nfkc_casefold():
+    assert memo_contains("pay")(ex(memo="SUB-PAY 2026"))
+    assert memo_contains("sub")(ex(memo="ｓｕｂ-pay"))
+    assert not memo_contains("zzz")(ex(memo="sub-pay"))
+
+
+def test_memo_contains_empty_raises():
+    with pytest.raises(ValueError):
+        memo_contains("")
+
+
+def test_memo_contains_non_str_raises_type_error():
+    with pytest.raises(TypeError):
+        memo_contains(None)  # type: ignore[arg-type]
+
+
+def test_all_of_empty_is_true_and_any_of_empty_is_false():
+    assert all_of()(ex())
+    assert not any_of()(ex())
+
+
+def test_all_of_and_any_of_combine():
+    rows = [ex(amount=100, category="食費"), ex(amount=900, category="食費")]
+    cond = all_of(category_is("食費"), amount_between(high=500))
+    assert [r.amount for r in search(rows, cond)] == [100]
+    cond2 = any_of(category_is("交通費"), amount_between(low=900))
+    assert [r.amount for r in search(rows, cond2)] == [900]
+
+
+def test_negate_inverts():
+    assert negate(category_is("食費"))(ex(category="交通費"))
+    assert not negate(category_is("食費"))(ex(category="食費"))
+
+
+def test_combinators_reject_non_callable():
+    with pytest.raises(TypeError):
+        all_of(42)  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        any_of("x")  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        negate(None)  # type: ignore[arg-type]
+
+
+def test_search_keeps_order_and_does_not_mutate_input():
+    rows = [ex(amount=300), ex(amount=100), ex(amount=200)]
+    snapshot = list(rows)
+    result = search(rows, amount_between(low=150))
+    assert [r.amount for r in result] == [300, 200]
+    assert rows == snapshot
+    assert result is not rows
+
+
+def test_search_non_callable_cond_raises_type_error():
+    with pytest.raises(TypeError):
+        search([ex()], 123)  # type: ignore[arg-type]
