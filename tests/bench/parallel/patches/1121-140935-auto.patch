@@ -0,0 +1,228 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankcsv import parse_bank_csv
+from kakeibo.core import CsvError, Expense
+
+
+def _errors(text: str) -> list[tuple[int, str]]:
+    with pytest.raises(CsvError) as info:
+        parse_bank_csv(text)
+    return info.value.errors
+
+
+# 仕様の例の表(E2-1 〜 E2-3)をそのまま写す。
+@pytest.mark.parametrize(
+    ("text", "expected", "errors"),
+    [
+        pytest.param(
+            '利用日,ご利用店名,利用金額\n2026/1/5,コンビニ,"1,234円"\n',
+            [Expense(date(2026, 1, 5), "未分類", 1234, "コンビニ")],
+            None,
+            id="E2-1",
+        ),
+        pytest.param(
+            "日付,摘要,出金額,入金額\n2026-01-05,給与,,300000\n",
+            [],
+            None,
+            id="E2-2",
+        ),
+        pytest.param(
+            "date,amount\n2026/2/30,12.5\n",
+            None,
+            [(2, "日付が不正です: '2026/2/30'"), (2, "金額が不正です: '12.5'")],
+            id="E2-3",
+        ),
+    ],
+)
+def test_spec_examples(text, expected, errors):
+    if errors is None:
+        assert parse_bank_csv(text) == expected
+    else:
+        got = _errors(text)
+        assert got == errors
+
+
+# R1: 区切りの自動判定・BOM・改行
+def test_tab_delimiter_chosen_when_header_has_more_tabs():
+    text = "日付\t摘要\t金額\n2026-01-05\tコンビニ\t100\n"
+    assert parse_bank_csv(text) == [
+        Expense(date(2026, 1, 5), "未分類", 100, "コンビニ")
+    ]
+
+
+def test_comma_delimiter_wins_tie():
+    # ヘッダーはカンマ 1 個・タブ 1 個 → 同数なのでカンマ区切り。
+    # 末尾のタブは列名の空白として除去される。
+    text = "date,amount\t\n2026-01-05,100\n"
+    assert parse_bank_csv(text) == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+def test_bom_is_ignored():
+    text = "﻿date,amount\n2026-01-05,100\n"
+    assert parse_bank_csv(text) == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+@pytest.mark.parametrize("newline", ["\n", "\r\n", "\r"])
+def test_newline_variants(newline):
+    text = newline.join(["date,amount", "2026-01-05,100", "2026-01-06,200", ""])
+    assert [e.amount for e in parse_bank_csv(text)] == [100, 200]
+
+
+def test_newline_inside_quoted_memo_is_kept():
+    text = 'date,amount,memo\n2026-01-05,100,"a\nb"\n'
+    assert parse_bank_csv(text)[0].memo == "a\nb"
+
+
+# R2: ヘッダー名の正規化・別名・カテゴリ
+def test_header_names_normalized_by_nfkc_strip_casefold():
+    text = " ＤＡＴＥ ,Amount,Memo\n2026-01-05,100,店\n"
+    assert parse_bank_csv(text) == [Expense(date(2026, 1, 5), "未分類", 100, "店")]
+
+
+def test_category_column_empty_uses_default():
+    text = "date,amount,category\n2026-01-05,100,\n"
+    assert parse_bank_csv(text, "雑費") == [Expense(date(2026, 1, 5), "雑費", 100, "")]
+
+
+def test_category_column_value_is_used():
+    text = "date,amount,カテゴリ\n2026-01-05,100,食費\n"
+    assert parse_bank_csv(text)[0].category == "食費"
+
+
+def test_unknown_columns_are_ignored():
+    text = "date,amount,残高\n2026-01-05,100,99999\n"
+    assert parse_bank_csv(text) == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+# R3: 日付の書式
+@pytest.mark.parametrize(
+    "cell",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026.1.5",
+        "2026年1月5日",
+        "２０２６－０１－０５",
+        "2026-01-05 10:30",
+        "2026-01-05T10:30:00",
+    ],
+)
+def test_date_formats(cell):
+    text = f"date,amount\n{cell},100\n"
+    assert parse_bank_csv(text)[0].day == date(2026, 1, 5)
+
+
+@pytest.mark.parametrize("cell", ["2026-02-30", "2026-1/5", "R8.1.5", "2026年2月30日"])
+def test_invalid_dates_are_row_errors(cell):
+    text = f"date,amount\n{cell},100\n"
+    errors = _errors(text)
+    assert errors == [(2, f"日付が不正です: {cell!r}")]
+
+
+# R4: 金額の書式と符号(D2)
+@pytest.mark.parametrize(
+    ("cell", "yen"),
+    [
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("¥1,000", 1000),
+        ("￥1,000", 1000),
+        ("1000円", 1000),
+        ("1000JPY", 1000),
+        (" 1 000 ", 1000),
+        ("0", 0),
+    ],
+)
+def test_amount_formats_and_sign(cell, yen):
+    text = f'date,amount\n2026-01-05,"{cell}"\n'  # 桁区切りを含むので引用する
+    assert parse_bank_csv(text)[0].amount == yen
+
+
+@pytest.mark.parametrize("cell", ["12.5", "", "-", "—", "abc"])
+def test_invalid_amounts_are_row_errors(cell):
+    text = f"date,amount\n2026-01-05,{cell}\n"
+    errors = _errors(text)
+    assert len(errors) == 1
+    assert errors[0][0] == 2
+    assert errors[0][1].startswith("金額が不正です")
+
+
+# D2: 2 列形式(出金/入金)
+def test_two_column_outflow_is_positive_and_blank_is_zero():
+    text = "date,出金,入金\n2026-01-05,500,\n"
+    assert parse_bank_csv(text) == [Expense(date(2026, 1, 5), "未分類", 500, "")]
+
+
+def test_two_column_both_blank_gives_zero_expense():
+    text = "date,出金,入金\n2026-01-05,,\n"
+    assert parse_bank_csv(text)[0].amount == 0
+
+
+def test_two_column_both_nonzero_is_row_error():
+    text = "date,出金,入金\n2026-01-05,500,300\n"
+    assert _errors(text) == [(2, "出金と入金の両方に金額があります")]
+
+
+# R5: 必須列
+def test_missing_date_column_is_header_error():
+    assert _errors("memo,amount\nx,100\n") == [(1, "列 日付 がありません")]
+
+
+def test_missing_amount_and_outflow_is_header_error():
+    assert _errors("date,memo\n2026-01-05,x\n") == [(1, "列 金額 がありません")]
+
+
+def test_inflow_only_is_not_an_amount_column():
+    assert _errors("date,入金\n2026-01-05,300\n") == [(1, "列 金額 がありません")]
+
+
+# R6: 列数の不一致・空行
+def test_unquoted_thousands_separator_gives_column_count_error():
+    text = "利用日,利用金額\n2026/1/5,1,234円\n"
+    assert _errors(text) == [(2, "列数が合いません: 期待 2、実際 3")]
+
+
+def test_blank_lines_are_skipped_and_counted_physically():
+    text = "date,amount\n\n   \n2026-01-05,100\n"
+    assert parse_bank_csv(text) == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+    text_bad = "date,amount\n\n2026/2/30,abc\n"
+    assert [n for n, _ in _errors(text_bad)] == [3, 3]
+
+
+# R7: 1 行の複数エラーと行番号の昇順
+def test_all_errors_in_a_row_are_reported_and_sorted_by_line():
+    text = "date,amount\n2026-01-05,abc\n2026-13-01,100\n2026/2/30,12.5\n"
+    errors = _errors(text)
+    assert [n for n, _ in errors] == [2, 3, 4, 4]
+    assert errors[0][1] == "金額が不正です: 'abc'"
+    assert errors[1][1] == "日付が不正です: '2026-13-01'"
+
+
+# R8: 空入力・型
+@pytest.mark.parametrize("text", ["", "  \n\t\n", "date,amount\n", "﻿"])
+def test_empty_or_header_only_returns_empty_list(text):
+    assert parse_bank_csv(text) == []
+
+
+def test_non_str_raises_type_error():
+    with pytest.raises(TypeError):
+        parse_bank_csv(None)  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        parse_bank_csv(b"date,amount\n")  # type: ignore[arg-type]
+
+
+# 規則にない入力は ValueError
+def test_amount_and_outflow_columns_together_is_value_error():
+    with pytest.raises(ValueError):
+        parse_bank_csv("date,amount,出金\n2026-01-05,1,2\n")
+
+
+def test_duplicate_role_columns_is_value_error():
+    with pytest.raises(ValueError):
+        parse_bank_csv("date,日付,amount\n2026-01-05,2026-01-05,1\n")
diff --git a/tests/test_monthly_diff.py b/tests/test_monthly_diff.py
