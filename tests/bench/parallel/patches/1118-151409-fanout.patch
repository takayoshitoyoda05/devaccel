+++ b/src/kakeibo/weekday.py
@@ -0,0 +1,19 @@
+"""Expense totals grouped by day of week."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+_WEEKDAY_NAMES = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
+
+
+def total_by_weekday(rows: list[Expense]) -> dict[str, int]:
+    """Sum amounts per weekday ("Mon".."Sun"), Monday-first.
+
+    Weekdays with no expense rows are omitted.
+    """
+    totals: dict[int, int] = {}
+    for e in rows:
+        idx = e.day.weekday()  # Monday == 0
+        totals[idx] = totals.get(idx, 0) + e.amount
+    return {_WEEKDAY_NAMES[i]: totals[i] for i in sorted(totals)}
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..2bb98c0
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,250 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+# --- parse_amount ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥980", 980),
+        ("￥980", 980),
+        ("-980", -980),
+        ("-0", 0),
+        ("1,,2", 12),  # カンマの位置は検査しない
+        ("-¥5円", -5),
+    ],
+)
+def test_parse_amount_accepts(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "   ",
+        "円",
+        "12.5",
+        "1 200",
+        "--5",
+        "¥-5",
+        "１２３",
+        "-",
+        ",",
+        "¥",
+        "-円",
+        "5円円",
+        "¥¥5",
+        "5-",
+        ",5",
+        "1,200yen",
+    ],
+)
+def test_parse_amount_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+# --- parse_date -----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        ("2026/01/05", date(2026, 1, 5)),
+        ("2026-1-5", date(2026, 1, 5)),
+        ("2026/12/31", date(2026, 12, 31)),
+        (" 2026/1/5 ", date(2026, 1, 5)),
+        ("2024/2/29", date(2024, 2, 29)),
+    ],
+)
+def test_parse_date_accepts(text: str, expected: date) -> None:
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026/1-5",
+        "2026-1/5",
+        "26/1/5",
+        "2026/02/30",
+        "2026/13/1",
+        "2026/1/0",
+        "",
+        "2026/1",
+        "2026/1/5/1",
+        "２０２６/1/5",
+        "2026.1.5",
+        "2026/001/5",
+    ],
+)
+def test_parse_date_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+# --- import_rows ----------------------------------------------------------
+
+HEADER = "利用日,分類,利用金額,利用店名"
+
+
+def _csv(*lines: str) -> str:
+    return "\n".join((HEADER, *lines)) + "\n"
+
+
+def test_default_mapping_value() -> None:
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_import_basic_rows_in_order() -> None:
+    text = _csv('2026/1/5,食費,"1,200円",  スーパー  ', "2026-01-06,交通,-300,駅")
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [
+        Expense(date(2026, 1, 5), "食費", 1200, "スーパー"),
+        Expense(date(2026, 1, 6), "交通", -300, "駅"),
+    ]
+
+
+def test_quoted_comma_in_value() -> None:
+    text = _csv('2026/1/5,"食費, 外食","980","a, b"')
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費, 外食", 980, "a, b")]
+
+
+def test_extra_columns_are_ignored() -> None:
+    text = "利用日,分類,利用金額,利用店名,備考\n2026/1/5,食費,100,店,なし\n"
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "店")]
+
+
+def test_blank_lines_skipped_but_counted() -> None:
+    text = f"{HEADER}\n\n2026/1/5,食費,100,店\n\n2026/1/6,x,abc,店\n"
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "店")]
+    assert errors == [(5, "amount")]
+
+
+def test_line_numbers_are_physical_with_header_as_one() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,100,店\n2026/13/1,食費,100,店\n"
+    rows, errors = import_rows(text)
+    assert len(rows) == 1
+    assert errors == [(3, "date")]
+
+
+def test_quoted_newline_counts_physical_lines() -> None:
+    text = f'{HEADER}\n2026/1/5,"食費\n外食",100,店\n2026/13/1,x,1,店\n'
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費\n外食", 100, "店")]
+    assert errors == [(4, "date")]
+
+
+def test_all_errors_recorded_in_date_amount_category_order() -> None:
+    text = _csv(",   ,abc,店")
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "date"), (2, "amount"), (2, "category")]
+
+
+def test_error_row_excluded_but_other_rows_kept() -> None:
+    text = _csv("2026/1/5,食費,100,店", "2026/1/6,,100,店", "2026/1/7,食費,100,店")
+    rows, errors = import_rows(text)
+    assert [r.day for r in rows] == [date(2026, 1, 5), date(2026, 1, 7)]
+    assert errors == [(3, "category")]
+
+
+def test_category_whitespace_only_is_error() -> None:
+    rows, errors = import_rows(_csv("2026/1/5,   ,100,店"))
+    assert rows == []
+    assert errors == [(2, "category")]
+
+
+def test_short_row_missing_values_are_empty() -> None:
+    # 利用金額が欠けている → amount エラー。category・date は揃っているので他は出ない。
+    rows, errors = import_rows(_csv("2026/1/5,食費"))
+    assert rows == []
+    assert errors == [(2, "amount")]
+
+
+def test_short_row_missing_memo_gives_empty_memo() -> None:
+    text = "利用日,分類,利用金額\n2026/1/5,食費,100\n"
+    mapping = {"date": "利用日", "category": "分類", "amount": "利用金額"}
+    rows, errors = import_rows(text, mapping=mapping)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+def test_memo_is_stripped() -> None:
+    rows, _ = import_rows(_csv("2026/1/5,食費,100,   店 名  "))
+    assert rows[0].memo == "店 名"
+
+
+def test_category_map_replaces_stripped_category() -> None:
+    text = _csv("2026/1/5, 食費 ,100,店", "2026/1/6,交通,100,駅")
+    rows, errors = import_rows(text, category_map={"食費": "食料品"})
+    assert errors == []
+    assert [r.category for r in rows] == ["食料品", "交通"]
+
+
+def test_category_map_not_applied_to_unstripped_key() -> None:
+    rows, _ = import_rows(_csv("2026/1/5, 食費 ,100,店"), category_map={" 食費 ": "X"})
+    assert rows[0].category == "食費"
+
+
+def test_custom_mapping_uses_given_column_names() -> None:
+    text = "日付,項目,金額\n2026/1/5,食費,100\n"
+    mapping = {"date": "日付", "category": "項目", "amount": "金額"}
+    rows, errors = import_rows(text, mapping=mapping)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+def test_mapping_memo_key_is_optional_and_used_when_given() -> None:
+    text = "日付,項目,金額,店\n2026/1/5,食費,100,コンビニ\n"
+    mapping = {"date": "日付", "category": "項目", "amount": "金額", "memo": "店"}
+    rows, _ = import_rows(text, mapping=mapping)
+    assert rows[0].memo == "コンビニ"
+
+
+@pytest.mark.parametrize("missing", ["date", "category", "amount"])
+def test_mapping_missing_required_key_raises(missing: str) -> None:
+    mapping = {k: v for k, v in DEFAULT_MAPPING.items() if k != missing}
+    with pytest.raises(ValueError):
+        import_rows(_csv(), mapping=mapping)
+
+
+def test_mapping_column_not_in_header_raises() -> None:
+    mapping = {**DEFAULT_MAPPING, "amount": "存在しない列"}
+    with pytest.raises(ValueError):
+        import_rows(_csv("2026/1/5,食費,100,店"), mapping=mapping)
+
+
+def test_mapping_memo_column_not_in_header_raises() -> None:
+    mapping = {**DEFAULT_MAPPING, "memo": "なし"}
+    with pytest.raises(ValueError):
+        import_rows(_csv(), mapping=mapping)
+
+
+def test_header_only_returns_empty() -> None:
+    assert import_rows(_csv()) == ([], [])
