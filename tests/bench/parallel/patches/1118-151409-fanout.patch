@@ -0,0 +1,62 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.dupes import find_duplicates
+
+D = date(2026, 11, 1)
+
+
+def _e(day=D, category="food", amount=100, memo=""):
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+def test_empty_list_has_no_duplicates():
+    assert find_duplicates([]) == []
+
+
+def test_single_row_has_no_duplicates():
+    assert find_duplicates([_e()]) == []
+
+
+def test_no_duplicates_when_all_rows_differ():
+    rows = [_e(amount=100), _e(amount=200), _e(category="rent", amount=100)]
+    assert find_duplicates(rows) == []
+
+
+def test_one_pair_is_reported_as_index_pair():
+    rows = [_e(amount=1), _e(amount=2), _e(amount=1)]
+    assert find_duplicates(rows) == [(0, 2)]
+
+
+def test_triple_yields_every_pair_in_order():
+    rows = [_e(), _e(), _e()]
+    assert find_duplicates(rows) == [(0, 1), (0, 2), (1, 2)]
+
+
+def test_pairs_sorted_by_i_then_j_with_interleaving():
+    rows = [_e(memo="a"), _e(memo="b"), _e(memo="b"), _e(memo="a"), _e(memo="b")]
+    assert find_duplicates(rows) == [(0, 3), (1, 2), (1, 4), (2, 4)]
+
+
+def test_differing_day_is_not_duplicate():
+    assert find_duplicates([_e(), _e(day=date(2026, 11, 2))]) == []
+
+
+def test_differing_category_is_not_duplicate():
+    assert find_duplicates([_e(), _e(category="rent")]) == []
+
+
+def test_differing_amount_is_not_duplicate():
+    assert find_duplicates([_e(), _e(amount=101)]) == []
+
+
+def test_differing_memo_is_not_duplicate():
+    assert find_duplicates([_e(memo="x"), _e(memo="y")]) == []
+
+
+def test_memo_comparison_is_exact_not_case_insensitive():
+    assert find_duplicates([_e(memo="Lunch"), _e(memo="lunch")]) == []
+
+
+def test_empty_memo_matches_empty_memo():
+    assert find_duplicates([_e(memo=""), _e(memo="")]) == [(0, 1)]
