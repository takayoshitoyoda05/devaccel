diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..f1461ea
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,255 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def ex(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+ROWS = [
+    ex("2026-01-05", "food", 1000),
+    ex("2026-01-20", "food", 500),
+    ex("2026-01-10", "rent", 0),  # 明細はあるが合計 0
+    ex("2026-01-11", "fun", 300),
+    ex("2026-02-03", "food", 1500),
+    ex("2026-02-04", "rent", 0),
+    ex("2026-02-05", "travel", 2000),  # prev に無い → new
+    ex("2026-03-01", "food", 100),  # 2026-02 に無い月が存在する
+]
+
+
+# --- month_diff: 基本の行 ---------------------------------------------------
+
+
+def test_month_diff_basic_fields_and_status() -> None:
+    rows = month_diff(ROWS, "2026-01", "2026-02")
+    by_cat = {r.category: r for r in rows}
+    assert by_cat["food"] == DiffRow("food", 1500, 1500, 0, 0.0, "same")
+    assert by_cat["fun"] == DiffRow("fun", 300, 0, -300, -100.0, "gone")
+    assert by_cat["travel"] == DiffRow("travel", 0, 2000, 2000, None, "new")
+
+
+def test_zero_total_with_entries_is_same_not_new_or_gone() -> None:
+    rows = month_diff(ROWS, "2026-01", "2026-02")
+    rent = next(r for r in rows if r.category == "rent")
+    assert rent == DiffRow("rent", 0, 0, 0, None, "same")
+
+
+def test_status_up_and_down() -> None:
+    data = [
+        ex("2026-01-01", "a", 100),
+        ex("2026-02-01", "a", 150),
+        ex("2026-01-01", "b", 200),
+        ex("2026-02-01", "b", 100),
+    ]
+    by_cat = {r.category: r for r in month_diff(data, "2026-01", "2026-02")}
+    assert by_cat["a"].status == "up"
+    assert by_cat["a"].delta == 50
+    assert by_cat["a"].pct == 50.0
+    assert by_cat["b"].status == "down"
+    assert by_cat["b"].pct == -50.0
+
+
+def test_pct_is_rounded_to_one_decimal() -> None:
+    data = [ex("2026-01-01", "a", 3), ex("2026-02-01", "a", 4)]
+    (row,) = month_diff(data, "2026-01", "2026-02")
+    assert row.pct == round(1 / 3 * 100, 1)
+    assert row.pct == 33.3
+
+
+def test_month_with_no_rows_treats_all_as_new_or_gone() -> None:
+    data = [ex("2026-01-01", "a", 100)]
+    (row,) = month_diff(data, "2025-12", "2026-01")
+    assert row == DiffRow("a", 0, 100, 100, None, "new")
+
+
+def test_same_month_twice_gives_all_same() -> None:
+    rows = month_diff(ROWS, "2026-01", "2026-01")
+    assert all(r.status == "same" and r.delta == 0 for r in rows)
+
+
+def test_no_rows_in_either_month_gives_empty() -> None:
+    assert month_diff(ROWS, "2024-01", "2024-02") == []
+
+
+def test_only_categories_in_either_month_are_listed() -> None:
+    cats = {r.category for r in month_diff(ROWS, "2026-01", "2026-02")}
+    assert cats == {"food", "fun", "rent", "travel"}
+
+
+def test_other_months_do_not_leak_into_comparison() -> None:
+    # 2026-03 の food(100) は 2026-01 vs 2026-02 の比較に入らない
+    by_cat = {r.category: r for r in month_diff(ROWS, "2026-01", "2026-02")}
+    assert by_cat["food"].curr == 1500
+
+
+# --- month_diff: 並び順 -----------------------------------------------------
+
+
+def test_sort_by_abs_delta_desc_then_category_asc() -> None:
+    data = [
+        ex("2026-01-01", "b", 100),
+        ex("2026-02-01", "b", 0),  # delta -100
+        ex("2026-01-01", "a", 0),
+        ex("2026-02-01", "a", 100),  # delta +100 (同じ abs)
+        ex("2026-02-01", "c", 500),  # delta +500
+        ex("2026-01-01", "d", 0),
+        ex("2026-01-01", "d", 0),
+    ]
+    cats = [r.category for r in month_diff(data, "2026-01", "2026-02")]
+    assert cats == ["c", "a", "b", "d"]
+
+
+# --- month_diff: 入力検証 ---------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        "2026-1",
+        "2026-13",
+        "2026-00",
+        "202601",
+        "2026/01",
+        "2026-01 ",
+        "26-01",
+        "",
+        "2026-1a",
+    ],
+)
+def test_invalid_month_format_raises(bad: str) -> None:
+    with pytest.raises(ValueError):
+        month_diff(ROWS, bad, "2026-02")
+    with pytest.raises(ValueError):
+        month_diff(ROWS, "2026-01", bad)
+
+
+def test_empty_rows_still_validates_months() -> None:
+    assert month_diff([], "2026-01", "2026-02") == []
+    with pytest.raises(ValueError):
+        month_diff([], "2026-13", "2026-02")
+
+
+# --- top_movers -------------------------------------------------------------
+
+
+def test_top_movers_excludes_same_and_keeps_order() -> None:
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    movers = top_movers(diffs, n=10)
+    assert [r.category for r in movers] == ["travel", "fun"]
+    assert all(r.status != "same" for r in movers)
+
+
+def test_top_movers_takes_first_n_after_filtering() -> None:
+    data = [
+        ex("2026-01-01", "a", 0),
+        ex("2026-02-01", "a", 900),  # up 900 (same ではない)
+        ex("2026-01-01", "b", 500),
+        ex("2026-02-01", "b", 500),  # same
+        ex("2026-01-01", "c", 0),
+        ex("2026-02-01", "c", 100),  # up 100
+        ex("2026-01-01", "d", 0),
+        ex("2026-02-01", "d", 50),
+    ]
+    diffs = month_diff(data, "2026-01", "2026-02")
+    assert [r.category for r in top_movers(diffs, n=2)] == ["a", "c"]
+
+
+def test_top_movers_default_is_three() -> None:
+    data = [ex("2026-02-01", f"c{i}", 100 - i) for i in range(5)]
+    diffs = month_diff(data, "2026-01", "2026-02")
+    assert len(top_movers(diffs)) == 3
+
+
+def test_top_movers_zero_and_short_list() -> None:
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    assert top_movers(diffs, n=0) == []
+    assert len(top_movers(diffs, n=100)) == 2
+
+
+def test_top_movers_negative_n_raises() -> None:
+    with pytest.raises(ValueError):
+        top_movers(month_diff(ROWS, "2026-01", "2026-02"), n=-1)
+
+
+def test_top_movers_empty_input() -> None:
+    assert top_movers([]) == []
+
+
+# --- render_diff ------------------------------------------------------------
+
+
+def test_render_header_and_signed_values() -> None:
+    diffs = [
+        DiffRow("food", 1000, 1300, 300, 30.0, "up"),
+        DiffRow("rent", 5000, 3000, -2000, -40.0, "down"),
+        DiffRow("fun", 300, 0, -300, -100.0, "gone"),
+        DiffRow("travel", 0, 2000, 2000, None, "new"),
+        DiffRow("misc", 700, 700, 0, 0.0, "same"),
+    ]
+    text = render_diff(diffs)
+    lines = text.split("\n")
+    assert lines[0] == "category\tprev\tcurr\tdelta\tpct"
+    assert lines[1] == "food\t1000\t1300\t+300\t+30.0%"
+    assert lines[2] == "rent\t5000\t3000\t-2000\t-40.0%"
+    assert lines[3] == "fun\t300\t0\t-300\t-100.0%"
+    assert lines[4] == "travel\t0\t2000\t+2000\t-"
+    assert lines[5] == "misc\t700\t700\t+0\t+0.0%"
+    assert len(lines) == 6
+
+
+def test_render_no_trailing_newline() -> None:
+    text = render_diff([DiffRow("a", 1, 2, 1, 100.0, "up")])
+    assert not text.endswith("\n")
+    assert text == "category\tprev\tcurr\tdelta\tpct\na\t1\t2\t+1\t+100.0%"
+
+
+def test_render_empty_is_header_only() -> None:
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_render_tiny_negative_pct_has_no_minus_zero() -> None:
+    # delta=-1, prev=10000 → pct=-0.01 → round → -0.0 。"-0.0%" にしない
+    text = render_diff(
+        [DiffRow("a", 10000, 9999, -1, round(-1 / 10000 * 100, 1), "down")]
+    )
+    assert text.split("\n")[1].split("\t")[-1] == "+0.0%"
+
+
+# --- available_months / latest_diff ----------------------------------------
+
+
+def test_available_months_sorted_unique() -> None:
+    assert available_months(ROWS) == ["2026-01", "2026-02", "2026-03"]
+
+
+def test_available_months_empty() -> None:
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months() -> None:
+    # 最後の 2 つ = 2026-02 (prev) と 2026-03 (curr)
+    by_cat = {r.category: r for r in latest_diff(ROWS)}
+    assert by_cat["food"] == DiffRow("food", 1500, 100, -1400, -93.3, "down")
+    assert by_cat["travel"].status == "gone"
+    assert "fun" not in by_cat
+
+
+def test_latest_diff_needs_two_months() -> None:
+    with pytest.raises(ValueError):
+        latest_diff([])
+    with pytest.raises(ValueError):
+        latest_diff([ex("2026-01-01", "a", 1), ex("2026-01-02", "a", 2)])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..6e9001e
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,193 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+A = Expense(date(2026, 1, 1), "food", 500, "Lunch")
+B = Expense(date(2026, 1, 2), "foodstuff", 300, "")
+C = Expense(date(2026, 1, 3), "transport", 200, "bus to food court")
+D = Expense(date(2026, 1, 4), "Food", 100, "Snack")
+ROWS = [A, B, C, D]
+
+
+# --- tokenize ---------------------------------------------------------------
+
+
+def test_tokenize_whitespace_only_gives_no_tokens() -> None:
+    assert tokenize("   ") == []
+
+
+def test_tokenize_splits_on_whitespace() -> None:
+    assert tokenize("a  b\tc") == [("TERM", "a"), ("TERM", "b"), ("TERM", "c")]
+
+
+def test_tokenize_parens() -> None:
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+
+
+def test_tokenize_quoted_keeps_spaces_and_parens() -> None:
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+
+
+def test_tokenize_quoted_keyword_is_term() -> None:
+    assert tokenize('"AND" "cat:x"') == [("TERM", "AND"), ("TERM", "cat:x")]
+
+
+def test_tokenize_unclosed_quote_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_uppercase_operators_only() -> None:
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+    assert tokenize("and or not") == [("TERM", "and"), ("TERM", "or"), ("TERM", "not")]
+
+
+def test_tokenize_operator_prefix_is_plain_term() -> None:
+    assert tokenize("ANDX") == [("TERM", "ANDX")]
+
+
+def test_tokenize_cat_prefix() -> None:
+    assert tokenize("cat:food") == [("CAT", "food")]
+
+
+def test_tokenize_cat_prefix_is_case_sensitive() -> None:
+    assert tokenize("CAT:food") == [("TERM", "CAT:food")]
+
+
+def test_tokenize_cat_empty_value_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_tokenize_cat_quoted_value_is_empty_error() -> None:
+    # 語は '"' で止まるので cat: の後ろが空になる
+    with pytest.raises(QueryError):
+        tokenize('cat:"food"')
+
+
+def test_tokenize_word_stops_at_quote_and_paren() -> None:
+    assert tokenize('ab"cd"') == [("TERM", "ab"), ("TERM", "cd")]
+    assert tokenize("cat:a(b)") == [
+        ("CAT", "a"),
+        ("LPAREN", "("),
+        ("TERM", "b"),
+        ("RPAREN", ")"),
+    ]
+
+
+# --- parse errors -----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "a OR",
+        "OR a",
+        "a AND",
+        "AND a",
+        "NOT",
+        "a NOT",
+        "(a",
+        "a)",
+        "( )",
+        "a OR )",
+    ],
+)
+def test_grammar_errors(q: str) -> None:
+    with pytest.raises(QueryError):
+        matches(q, A)
+
+
+def test_invalid_query_raises_even_with_no_rows() -> None:
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
+
+
+def test_valid_query_with_no_rows_returns_empty() -> None:
+    assert filter_rows("food", []) == []
+
+
+# --- evaluation -------------------------------------------------------------
+
+
+def test_term_matches_memo_or_category_substring() -> None:
+    assert matches("lunch", A)
+    assert matches("food", B)  # category の部分一致
+    assert matches("food", C)  # memo の部分一致
+    assert not matches("lunch", B)
+
+
+def test_term_is_case_insensitive() -> None:
+    assert matches("LUNCH", A)
+    assert matches("snack", D)
+
+
+def test_cat_is_exact_and_case_insensitive() -> None:
+    assert matches("cat:food", A)
+    assert matches("cat:FOOD", A)
+    assert matches("cat:food", D)
+    assert not matches("cat:food", B)  # foodstuff は完全一致しない
+    assert not matches("cat:food", C)  # memo は見ない
+
+
+def test_filter_rows_keeps_input_order() -> None:
+    assert filter_rows("food", ROWS) == [A, B, C, D]
+    assert filter_rows("cat:food", ROWS) == [A, D]
+
+
+def test_implicit_and_equals_explicit_and() -> None:
+    assert filter_rows("food snack", ROWS) == [D]
+    assert filter_rows("food AND snack", ROWS) == [D]
+
+
+def test_or_and_precedence() -> None:
+    # snack OR (bus AND transport)
+    assert filter_rows("snack OR bus transport", ROWS) == [C, D]
+    # (snack OR bus) AND transport と取り違えないこと
+    assert filter_rows("snack OR bus AND transport", ROWS) == [C, D]
+
+
+def test_not_binds_tighter_than_and() -> None:
+    # (NOT cat:food) AND snack
+    assert filter_rows("NOT cat:food snack", ROWS) == []
+    # NOT (cat:food AND snack) と取り違えないこと
+    assert filter_rows("NOT (cat:food snack)", ROWS) == [A, B, C]
+
+
+def test_not_applies_to_parenthesized_or() -> None:
+    assert filter_rows("NOT (cat:food OR cat:transport)", ROWS) == [B]
+
+
+def test_double_not() -> None:
+    assert filter_rows("NOT NOT lunch", ROWS) == [A]
+
+
+def test_implicit_and_with_not() -> None:
+    # food AND (NOT cat:food)
+    assert filter_rows("food NOT cat:food", ROWS) == [B, C]
+
+
+def test_quoted_term_with_spaces() -> None:
+    assert filter_rows('"bus to"', ROWS) == [C]
+    assert filter_rows('"food court"', ROWS) == [C]
+
+
+def test_quoted_keyword_is_literal_term() -> None:
+    assert filter_rows('"AND"', ROWS) == []
+
+
+def test_matches_parenthesized_precedence_override() -> None:
+    assert filter_rows("(snack OR lunch) cat:food", ROWS) == [A, D]
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..85e89cf
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,258 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def e(day: date, category: str = "通信", amount: int = 1000, memo: str = "") -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- add_month ---------------------------------------------------------------
+
+
+def test_add_month_same_day() -> None:
+    assert add_month(date(2026, 3, 15)) == date(2026, 4, 15)
+
+
+def test_add_month_clamps_to_end_of_short_month() -> None:
+    assert add_month(date(2026, 1, 31)) == date(2026, 2, 28)
+
+
+def test_add_month_clamps_to_leap_day() -> None:
+    assert add_month(date(2024, 1, 31)) == date(2024, 2, 29)
+
+
+def test_add_month_year_rollover() -> None:
+    assert add_month(date(2026, 12, 15)) == date(2027, 1, 15)
+
+
+def test_add_month_30_day_month_end() -> None:
+    assert add_month(date(2026, 4, 30)) == date(2026, 5, 30)
+    assert add_month(date(2026, 5, 31)) == date(2026, 6, 30)
+
+
+# --- validation --------------------------------------------------------------
+
+
+def test_min_count_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+
+
+def test_negative_tolerance_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_min_count_two_and_zero_tolerance_are_allowed() -> None:
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 5))]
+    assert find_recurring(rows, min_count=2, tolerance=0) == [
+        Recurring("通信", 1000, (date(2026, 1, 5), date(2026, 2, 5)), date(2026, 3, 5))
+    ]
+
+
+# --- basic detection ---------------------------------------------------------
+
+
+def test_empty_input_returns_empty() -> None:
+    assert find_recurring([]) == []
+
+
+def test_three_monthly_occurrences_detected() -> None:
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 5)), e(date(2026, 3, 5))]
+    assert find_recurring(rows) == [
+        Recurring(
+            "通信",
+            1000,
+            (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+            date(2026, 4, 5),
+        )
+    ]
+
+
+def test_below_min_count_not_reported() -> None:
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 5))]
+    assert find_recurring(rows) == []
+
+
+def test_min_count_threshold_is_inclusive() -> None:
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 5)), e(date(2026, 3, 5))]
+    assert len(find_recurring(rows, min_count=3)) == 1
+    assert find_recurring(rows, min_count=4) == []
+
+
+def test_memo_is_ignored_for_grouping() -> None:
+    rows = [
+        e(date(2026, 1, 5), memo="a"),
+        e(date(2026, 2, 5), memo="b"),
+        e(date(2026, 3, 5), memo=""),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_different_amounts_are_separate_groups() -> None:
+    rows = [
+        e(date(2026, 1, 5), amount=1000),
+        e(date(2026, 2, 5), amount=1000),
+        e(date(2026, 3, 5), amount=2000),
+        e(date(2026, 4, 5), amount=2000),
+        e(date(2026, 5, 5), amount=2000),
+    ]
+    result = find_recurring(rows)
+    assert result == [
+        Recurring(
+            "通信",
+            2000,
+            (date(2026, 3, 5), date(2026, 4, 5), date(2026, 5, 5)),
+            date(2026, 6, 5),
+        )
+    ]
+
+
+def test_different_categories_are_separate_groups() -> None:
+    rows = [
+        e(date(2026, 1, 5), category="A"),
+        e(date(2026, 2, 5), category="B"),
+        e(date(2026, 3, 5), category="A"),
+    ]
+    assert find_recurring(rows) == []
+
+
+# --- duplicates and order ----------------------------------------------------
+
+
+def test_same_day_duplicates_are_collapsed() -> None:
+    rows = [
+        e(date(2026, 1, 5)),
+        e(date(2026, 1, 5)),
+        e(date(2026, 2, 5)),
+        e(date(2026, 3, 5)),
+    ]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_duplicates_do_not_count_toward_min_count() -> None:
+    rows = [e(date(2026, 1, 5)), e(date(2026, 1, 5)), e(date(2026, 2, 5))]
+    assert find_recurring(rows) == []
+
+
+def test_input_order_does_not_matter() -> None:
+    rows = [e(date(2026, 3, 5)), e(date(2026, 1, 5)), e(date(2026, 2, 5))]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+    assert result[0].next_expected == date(2026, 4, 5)
+
+
+# --- tolerance ---------------------------------------------------------------
+
+
+def test_within_tolerance_is_connected() -> None:
+    # 2026-02-05 expected; actual 2026-02-08 is 3 days off (== tolerance)
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 8)), e(date(2026, 3, 8))]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 8), date(2026, 3, 8))
+    # next expected is add_month of the last day
+    assert result[0].next_expected == date(2026, 4, 8)
+
+
+def test_beyond_tolerance_breaks_run() -> None:
+    # 2026-02-09 is 4 days off the expected 2026-02-05 (> tolerance 3)
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 9)), e(date(2026, 3, 9))]
+    assert find_recurring(rows) == []
+
+
+def test_early_by_more_than_tolerance_breaks_run() -> None:
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 1)), e(date(2026, 3, 1))]
+    assert find_recurring(rows) == []
+
+
+def test_zero_tolerance_requires_exact_day() -> None:
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 6)), e(date(2026, 3, 6))]
+    assert find_recurring(rows, tolerance=0) == []
+    rows_exact = [e(date(2026, 1, 5)), e(date(2026, 2, 5)), e(date(2026, 3, 5))]
+    assert len(find_recurring(rows_exact, tolerance=0)) == 1
+
+
+def test_month_end_clamp_used_for_expected_date() -> None:
+    # 1/31 -> expected 2/28 (clamped); 2/28 -> expected 3/28 (not 3/31)
+    rows = [e(date(2026, 1, 31)), e(date(2026, 2, 28)), e(date(2026, 3, 28))]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 28)
+
+
+def test_run_split_into_multiple_recurring() -> None:
+    # Gap in the middle splits one group into two qualifying runs.
+    rows = [
+        e(date(2026, 1, 5)),
+        e(date(2026, 2, 5)),
+        e(date(2026, 3, 5)),
+        e(date(2026, 5, 20)),  # break: expected 4/5, off by 45 days
+        e(date(2026, 6, 20)),
+        e(date(2026, 7, 20)),
+    ]
+    result = find_recurring(rows)
+    assert result == [
+        Recurring(
+            "通信",
+            1000,
+            (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+            date(2026, 4, 5),
+        ),
+        Recurring(
+            "通信",
+            1000,
+            (date(2026, 5, 20), date(2026, 6, 20), date(2026, 7, 20)),
+            date(2026, 8, 20),
+        ),
+    ]
+
+
+def test_short_run_between_breaks_is_dropped() -> None:
+    rows = [
+        e(date(2026, 1, 5)),
+        e(date(2026, 2, 5)),
+        e(date(2026, 3, 5)),
+        e(date(2026, 6, 1)),  # break
+        e(date(2026, 7, 1)),  # run of 2 only -> dropped
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days[0] == date(2026, 1, 5)
+
+
+# --- sorting -----------------------------------------------------------------
+
+
+def test_result_sorted_by_category_then_amount() -> None:
+    rows: list[Expense] = []
+    for d in (date(2026, 1, 3), date(2026, 2, 3), date(2026, 3, 3)):
+        rows.append(e(d, category="B", amount=500))
+        rows.append(e(d, category="A", amount=900))
+    for d in (date(2026, 1, 9), date(2026, 2, 9), date(2026, 3, 9)):
+        rows.append(e(d, category="A", amount=100))
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [
+        ("A", 100),
+        ("A", 900),
+        ("B", 500),
+    ]
+
+
+def test_same_category_and_amount_sorted_by_first_day() -> None:
+    # Two runs in the same (category, amount) group; the later run is listed
+    # first in the input, but the result must be ordered by days[0] ascending.
+    later = [date(2026, 6, 10), date(2026, 7, 10), date(2026, 8, 10)]
+    earlier = [date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10)]
+    rows = [e(d) for d in later] + [e(d) for d in earlier]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 10), date(2026, 6, 10)]
diff --git a/tests/test_split.py b/tests/test_split.py
new file mode 100644
index 0000000..c21f440
--- /dev/null
+++ b/tests/test_split.py
@@ -0,0 +1,42 @@
+import pytest
+
+from kakeibo.split import split_evenly
+
+
+def test_divisible_amount_is_equal_shares():
+    assert split_evenly(900, 3) == [300, 300, 300]
+
+
+def test_remainder_goes_to_first_people_one_yen_each():
+    assert split_evenly(10, 3) == [4, 3, 3]
+    assert split_evenly(11, 3) == [4, 4, 3]
+
+
+def test_sum_always_equals_amount():
+    for amount in range(50):
+        for people in range(1, 8):
+            shares = split_evenly(amount, people)
+            assert sum(shares) == amount
+            assert len(shares) == people
+
+
+def test_single_person_gets_everything():
+    assert split_evenly(1234, 1) == [1234]
+
+
+def test_zero_amount_gives_zeros():
+    assert split_evenly(0, 4) == [0, 0, 0, 0]
+
+
+def test_amount_smaller_than_people():
+    assert split_evenly(2, 5) == [1, 1, 0, 0, 0]
+
+
+def test_people_zero_raises():
+    with pytest.raises(ValueError):
+        split_evenly(100, 0)
+
+
+def test_people_negative_raises():
+    with pytest.raises(ValueError):
+        split_evenly(100, -2)
diff --git a/tests/test_stats.py b/tests/test_stats.py
new file mode 100644
index 0000000..57889f6
--- /dev/null
+++ b/tests/test_stats.py
@@ -0,0 +1,56 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.stats import median_by_category
+
+
+def _e(category: str, amount: int) -> Expense:
+    return Expense(date(2026, 11, 1), category, amount)
+
+
+def test_empty_returns_empty_dict():
+    assert median_by_category([]) == {}
+
+
+def test_single_row_is_its_own_median():
+    assert median_by_category([_e("food", 1200)]) == {"food": 1200.0}
+
+
+def test_odd_count_takes_middle_value_regardless_of_input_order():
+    rows = [_e("food", 300), _e("food", 100), _e("food", 200)]
+    assert median_by_category(rows) == {"food": 200.0}
+
+
+def test_even_count_averages_two_middle_values():
+    rows = [_e("food", 100), _e("food", 201), _e("food", 300), _e("food", 50)]
+    # sorted: 50, 100, 201, 300 -> (100 + 201) / 2
+    assert median_by_category(rows) == {"food": 150.5}
+
+
+def test_duplicate_amounts_are_counted():
+    rows = [_e("food", 500), _e("food", 500), _e("food", 900)]
+    assert median_by_category(rows) == {"food": 500.0}
+
+
+def test_categories_are_computed_separately_and_keys_sorted_ascending():
+    rows = [
+        _e("rent", 80000),
+        _e("food", 1000),
+        _e("food", 3000),
+        _e("transport", 200),
+    ]
+    result = median_by_category(rows)
+    assert list(result) == ["food", "rent", "transport"]
+    assert result == {"food": 2000.0, "rent": 80000.0, "transport": 200.0}
+
+
+def test_values_are_floats():
+    result = median_by_category([_e("food", 100)])
+    assert isinstance(result["food"], float)
+
+
+def test_input_list_is_not_mutated():
+    rows = [_e("food", 300), _e("food", 100)]
+    before = list(rows)
+    median_by_category(rows)
+    assert rows == before
diff --git a/tests/test_streak.py b/tests/test_streak.py
new file mode 100644
index 0000000..1efe4f7
--- /dev/null
+++ b/tests/test_streak.py
@@ -0,0 +1,54 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.streak import longest_no_spend_streak
+
+
+def _e(day: date, amount: int = 100) -> Expense:
+    return Expense(day=day, category="food", amount=amount)
+
+
+def test_no_rows_returns_full_period_length() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 1), date(2026, 1, 7)) == 7
+
+
+def test_single_day_period_without_spend_is_one() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 5), date(2026, 1, 5)) == 1
+
+
+def test_single_day_period_with_spend_is_zero() -> None:
+    rows = [_e(date(2026, 1, 5))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 5), date(2026, 1, 5)) == 0
+
+
+def test_start_greater_than_end_returns_zero() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 7), date(2026, 1, 1)) == 0
+
+
+def test_longest_run_is_picked_from_several_gaps() -> None:
+    # Jan 1..10 ; spend on 3 and 4 and 9 -> gaps: 1-2 (2), 5-8 (4), 10 (1)
+    rows = [_e(date(2026, 1, 3)), _e(date(2026, 1, 4)), _e(date(2026, 1, 9))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 10)) == 4
+
+
+def test_multiple_rows_on_same_day_count_as_one_spend_day() -> None:
+    rows = [_e(date(2026, 1, 2), 100), _e(date(2026, 1, 2), 200)]
+    # Jan 1 alone (1), Jan 3..4 (2) -> longest 2
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 4)) == 2
+
+
+def test_rows_outside_period_are_ignored() -> None:
+    rows = [_e(date(2025, 12, 31)), _e(date(2026, 1, 9))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 8)) == 8
+
+
+def test_spend_on_start_and_end_bounds_are_counted() -> None:
+    rows = [_e(date(2026, 1, 1)), _e(date(2026, 1, 5))]
+    # Jan 2..4 is the only gap -> 3
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 5)) == 3
+
+
+def test_zero_amount_rows_still_count_as_spend() -> None:
+    # 明細が 1 件もない日、が条件なので金額 0 でも明細があれば支出日扱い
+    rows = [_e(date(2026, 1, 2), 0)]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 3)) == 1
diff --git a/tests/test_topn.py b/tests/test_topn.py
new file mode 100644
index 0000000..76b395c
--- /dev/null
+++ b/tests/test_topn.py
@@ -0,0 +1,60 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.topn import top_expenses
+
+
+def _e(day: str, amount: int, memo: str = "") -> Expense:
+    return Expense(date.fromisoformat(day), "食費", amount, memo)
+
+
+def test_orders_by_amount_descending() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300), _e("2026-01-03", 200)]
+    assert [e.amount for e in top_expenses(rows, 3)] == [300, 200, 100]
+
+
+def test_returns_only_n_items() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300), _e("2026-01-03", 200)]
+    assert [e.amount for e in top_expenses(rows, 2)] == [300, 200]
+
+
+def test_n_equal_to_length_returns_all() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300)]
+    assert top_expenses(rows, 2) == [rows[1], rows[0]]
+
+
+def test_n_larger_than_length_returns_all() -> None:
+    rows = [_e("2026-01-01", 100)]
+    assert top_expenses(rows, 10) == rows
+
+
+def test_n_zero_returns_empty() -> None:
+    assert top_expenses([_e("2026-01-01", 100)], 0) == []
+
+
+def test_negative_n_returns_empty() -> None:
+    assert top_expenses([_e("2026-01-01", 100)], -1) == []
+
+
+def test_empty_input_returns_empty() -> None:
+    assert top_expenses([], 3) == []
+
+
+def test_ties_broken_by_earlier_date() -> None:
+    late = _e("2026-03-01", 500, "late")
+    early = _e("2026-01-01", 500, "early")
+    assert top_expenses([late, early], 2) == [early, late]
+
+
+def test_ties_on_amount_and_date_keep_input_order() -> None:
+    first = _e("2026-01-01", 500, "first")
+    second = _e("2026-01-01", 500, "second")
+    assert top_expenses([first, second], 2) == [first, second]
+    assert top_expenses([second, first], 2) == [second, first]
+
+
+def test_does_not_mutate_input() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300)]
+    snapshot = list(rows)
+    top_expenses(rows, 2)
+    assert rows == snapshot
diff --git a/tests/test_weekday.py b/tests/test_weekday.py
new file mode 100644
index 0000000..5aad54d
--- /dev/null
+++ b/tests/test_weekday.py
@@ -0,0 +1,57 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.weekday import total_by_weekday
+
+
+def test_empty_rows_returns_empty_dict():
+    assert total_by_weekday([]) == {}
+
+
+def test_weekdays_without_rows_are_omitted():
+    rows = [Expense(date(2026, 11, 18), "food", 500)]  # Wednesday
+    assert total_by_weekday(rows) == {"Wed": 500}
+
+
+def test_same_weekday_across_weeks_is_summed():
+    rows = [
+        Expense(date(2026, 11, 2), "food", 300),  # Mon
+        Expense(date(2026, 11, 9), "food", 700),  # Mon
+        Expense(date(2026, 11, 3), "rent", 1000),  # Tue
+    ]
+    assert total_by_weekday(rows) == {"Mon": 1000, "Tue": 1000}
+
+
+def test_keys_are_in_monday_first_order_regardless_of_input_order():
+    rows = [
+        Expense(date(2026, 11, 22), "a", 1),  # Sun
+        Expense(date(2026, 11, 18), "a", 2),  # Wed
+        Expense(date(2026, 11, 16), "a", 3),  # Mon
+    ]
+    assert list(total_by_weekday(rows)) == ["Mon", "Wed", "Sun"]
+
+
+def test_zero_amount_row_still_includes_its_weekday():
+    rows = [Expense(date(2026, 11, 20), "food", 0)]  # Fri
+    assert total_by_weekday(rows) == {"Fri": 0}
+
+
+def test_negative_amounts_are_summed_as_is():
+    rows = [
+        Expense(date(2026, 11, 21), "food", 1000),  # Sat
+        Expense(date(2026, 11, 28), "food", -400),  # Sat
+    ]
+    assert total_by_weekday(rows) == {"Sat": 600}
+
+
+def test_all_seven_weekdays_use_english_three_letter_names():
+    rows = [Expense(date(2026, 11, 16 + i), "a", i + 1) for i in range(7)]
+    assert total_by_weekday(rows) == {
+        "Mon": 1,
+        "Tue": 2,
+        "Wed": 3,
+        "Thu": 4,
+        "Fri": 5,
+        "Sat": 6,
+        "Sun": 7,
+    }
