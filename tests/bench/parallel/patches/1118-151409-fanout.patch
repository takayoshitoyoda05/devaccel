new file mode 100644
index 0000000..09695da
--- /dev/null
+++ b/src/kakeibo/stats.py
@@ -0,0 +1,28 @@
+"""Per-category statistics over expense records."""
+
+from __future__ import annotations
+
+from collections import defaultdict
+
+from kakeibo.core import Expense
+
+
+def median_by_category(rows: list[Expense]) -> dict[str, float]:
+    """カテゴリごとの金額の中央値。キーはカテゴリ名の昇順、空なら {}。
+
+    偶数個のときは中央 2 つの平均を返す。
+    """
+    by_cat: dict[str, list[int]] = defaultdict(list)
+    for e in rows:
+        by_cat[e.category].append(e.amount)
+
+    out: dict[str, float] = {}
+    for cat in sorted(by_cat):
+        vals = sorted(by_cat[cat])
+        n = len(vals)
+        mid = n // 2
+        if n % 2:
+            out[cat] = float(vals[mid])
+        else:
+            out[cat] = (vals[mid - 1] + vals[mid]) / 2
+    return out
