+"""No-spend streak calculation."""
+
+from __future__ import annotations
+
+from datetime import date, timedelta
+
+from kakeibo.core import Expense
+
+
+def longest_no_spend_streak(rows: list[Expense], start: date, end: date) -> int:
+    """start〜end(両端含む)で明細が 1 件もない日の最長連続日数。
+
+    start > end の場合は 0。明細の有無だけを見るので金額は問わない。
+    期間外の明細は無視する。
+    """
+    if start > end:
+        return 0
+    spend_days = {e.day for e in rows if start <= e.day <= end}
+    best = 0
+    run = 0
+    day = start
+    while day <= end:
+        if day in spend_days:
+            run = 0
+        else:
+            run += 1
+            best = max(best, run)
+        day += timedelta(days=1)
+    return best
