+import json
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.export import to_json
+
+
+def test_empty_list_gives_empty_json_array() -> None:
+    assert to_json([]) == "[]"
+
+
+def test_single_row_has_keys_in_date_category_amount_memo_order() -> None:
+    rows = [Expense(date(2024, 3, 5), "食費", 1200, "ランチ")]
+    out = to_json(rows)
+    assert out == (
+        '[{"date": "2024-03-05", "category": "食費", "amount": 1200, "memo": "ランチ"}]'
+    )
+    assert list(json.loads(out)[0].keys()) == ["date", "category", "amount", "memo"]
+
+
+def test_preserves_input_order() -> None:
+    rows = [
+        Expense(date(2024, 5, 1), "b", 2),
+        Expense(date(2024, 1, 1), "a", 1),
+    ]
+    data = json.loads(to_json(rows))
+    assert [d["category"] for d in data] == ["b", "a"]
+
+
+def test_non_ascii_is_not_escaped() -> None:
+    out = to_json([Expense(date(2024, 1, 1), "交通費", 100, "電車")])
+    assert "交通費" in out
+    assert "\\u" not in out
+
+
+def test_empty_memo_is_empty_string() -> None:
+    out = to_json([Expense(date(2024, 1, 1), "食費", 0)])
+    assert json.loads(out)[0]["memo"] == ""
+
+
+def test_date_is_zero_padded_iso() -> None:
+    out = to_json([Expense(date(2024, 1, 9), "食費", 1)])
+    assert json.loads(out)[0]["date"] == "2024-01-09"
+
+
+def test_amount_is_integer_not_string() -> None:
+    out = to_json([Expense(date(2024, 1, 1), "食費", 1500)])
+    assert json.loads(out)[0]["amount"] == 1500
+    assert isinstance(json.loads(out)[0]["amount"], int)
+
+
+def test_output_is_not_indented() -> None:
+    out = to_json(
+        [Expense(date(2024, 1, 1), "食費", 1), Expense(date(2024, 1, 2), "x", 2)]
+    )
+    assert "\n" not in out
+
+
+def test_special_characters_in_memo_are_escaped_and_round_trip() -> None:
+    memo = 'say "hi"\\ \n tab\t'
+    out = to_json([Expense(date(2024, 1, 1), "食費", 1, memo)])
+    assert json.loads(out)[0]["memo"] == memo
