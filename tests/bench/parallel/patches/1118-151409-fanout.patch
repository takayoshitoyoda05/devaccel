index 0000000..32cf5a8
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,112 @@
+"""Import bank-statement CSV text (他行の明細) into Expense records."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"-?[¥￥]?[0-9][0-9,]*円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    """'-'? '¥'/'￥'? ASCII数字で始まる [0-9,]+ '円'? の形だけを受け付けて整数にする。"""
+    text = s.strip()
+    if not _AMOUNT_RE.fullmatch(text):
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    digits = re.sub(r"[^0-9-]", "", text)
+    return int(digits)
+
+
+def parse_date(s: str) -> date:
+    """YYYY/M/D または YYYY-M-D(区切りは統一、ゼロ埋め任意)を受け付ける。"""
+    text = s.strip()
+    m = _DATE_RE.fullmatch(text)
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    year, _, month, day = m.groups()
+    return date(int(year), int(month), int(day))  # 存在しない日付は ValueError
+
+
+def _is_blank(row: list[str]) -> bool:
+    return all(cell.strip() == "" for cell in row)
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """1 行目がヘッダーの CSV 文字列を読み、(取り込めた明細, [(行番号, フィールド名)]) を返す。"""
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+
+    # 物理行番号を追うため、各レコードの開始行を記録する。
+    reader = csv.reader(io.StringIO(text, newline=""))
+    records: list[tuple[int, list[str]]] = []
+    line_end = 0
+    for row in reader:
+        records.append((line_end + 1, row))
+        line_end = reader.line_num
+
+    header = records[0][1] if records else []
+    index: dict[str, int] = {}
+    for field, column in mapping.items():
+        if column not in header:
+            raise ValueError(f"列 {column!r} がヘッダーにありません")
+        index[field] = header.index(column)
+
+    def cell(row: list[str], field: str) -> str:
+        if field not in index:
+            return ""
+        i = index[field]
+        return row[i] if i < len(row) else ""
+
+    rows: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    for lineno, row in records[1:]:
+        if _is_blank(row):
+            continue
+        row_errors: list[tuple[int, str]] = []
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(cell(row, "date"))
+        except ValueError:
+            row_errors.append((lineno, "date"))
+        try:
+            amount = parse_amount(cell(row, "amount"))
+        except ValueError:
+            row_errors.append((lineno, "amount"))
+        category = cell(row, "category").strip()
+        if category == "":
+            row_errors.append((lineno, "category"))
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        assert day is not None and amount is not None
+        if category_map and category in category_map:
+            category = category_map[category]
+        rows.append(
+            Expense(
+                day=day,
+                category=category,
+                amount=amount,
+                memo=cell(row, "memo").strip(),
+            )
+        )
+    return rows, errors
