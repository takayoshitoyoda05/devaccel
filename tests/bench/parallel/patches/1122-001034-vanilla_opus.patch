+@pytest.mark.parametrize(
+    ("choices", "value", "case_sensitive", "expect"),
+    [
+        pytest.param(
+            ["apple", "banana", "cherry"],
+            "aple",
+            True,
+            "'aple' is not one of 'apple', 'banana', 'cherry'. Did you mean 'apple'?",
+            id="one match",
+        ),
+        pytest.param(
+            ["bar", "baz", "qux"],
+            "ba",
+            True,
+            "'ba' is not one of 'bar', 'baz', 'qux'."
+            " (Did you mean one of: 'bar', 'baz'?)",
+            id="several matches",
+        ),
+        pytest.param(
+            ["foo", "bar", "baz"],
+            "meh",
+            True,
+            "'meh' is not one of 'foo', 'bar', 'baz'.",
+            id="no match",
+        ),
+        pytest.param(
+            ["Apple", "Banana"],
+            "APLE",
+            False,
+            "'APLE' is not one of 'apple', 'banana'. Did you mean 'apple'?",
+            id="case insensitive",
+        ),
+    ],
+)
+def test_choice_suggestion(runner, choices, value, case_sensitive, expect):
+    @click.command()
+    @click.option("--fruit", type=click.Choice(choices, case_sensitive=case_sensitive))
+    def cli(fruit):
+        click.echo(fruit)
+
+    result = runner.invoke(cli, ["--fruit", value])
+    assert result.exit_code == 2
+    assert result.output.endswith(f"Invalid value for '--fruit': {expect}\n")
+
+
+def test_choice_suggestion_enum(runner):
+    class Color(enum.Enum):
+        RED = 1
+        GREEN = 2
+
+    @click.command()
+    @click.argument("color", type=click.Choice(Color))
+    def cli(color):
+        click.echo(color)
+
+    result = runner.invoke(cli, ["GREN"])
+    assert result.exit_code == 2
+    assert "'GREN' is not one of 'RED', 'GREEN'. Did you mean 'GREEN'?" in (
+        result.output
+    )
+
+
