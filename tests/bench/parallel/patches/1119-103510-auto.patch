+++ b/src/kakeibo/bank_import.py
@@ -0,0 +1,142 @@
+"""Import bank / card statement CSV text into Expense records (pure, no I/O)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int  # CSV line number (header = 1)
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+
+
+class BankImportError(ValueError):
+    """Raised when a required column (日付・金額) is missing from the header."""
+
+
+# Header aliases (already stripped and lowercased), in priority order.
+_DATE_COLUMNS = ("date", "日付", "利用日", "取引日", "ご利用日")
+_AMOUNT_COLUMNS = ("amount", "金額", "利用金額", "出金額", "支払金額")
+_CATEGORY_COLUMNS = ("category", "カテゴリ", "分類", "費目")
+_MEMO_COLUMNS = ("memo", "摘要", "内容", "利用店名", "ご利用先", "備考")
+
+_UNCATEGORIZED = "未分類"
+
+_DATE_PATTERNS = (
+    re.compile(r"([0-9]{4})-([0-9]{1,2})-([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})/([0-9]{1,2})/([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日"),
+    re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})"),
+)
+
+# Digits with optional thousands separators, e.g. "1,234" or "1234".
+_YEN_DIGITS_RE = re.compile(r"[0-9]{1,3}(?:,[0-9]{3})+|[0-9]+")
+
+
+def _find_column(header: list[str], aliases: tuple[str, ...]) -> int | None:
+    for alias in aliases:
+        if alias in header:
+            return header.index(alias)
+    return None
+
+
+def _cell(row: list[str], idx: int | None) -> str:
+    if idx is None or idx >= len(row):
+        return ""
+    return row[idx]
+
+
+def _parse_date(raw: str) -> date | None:
+    s = raw.strip()
+    for pattern in _DATE_PATTERNS:
+        m = pattern.fullmatch(s)
+        if m:
+            try:
+                return date(int(m[1]), int(m[2]), int(m[3]))
+            except ValueError:
+                return None
+    return None
+
+
+def _parse_amount(raw: str) -> int | None:
+    # NFKC folds fullwidth digits, ￥, － and the like into ASCII/standard forms.
+    s = unicodedata.normalize("NFKC", raw).strip()
+    negative = False
+    if s.startswith("(") and s.endswith(")"):
+        negative = True
+        s = s[1:-1].strip()
+    elif s.startswith("-"):
+        negative = True
+        s = s[1:].strip()
+    if s.startswith("¥"):
+        s = s[1:].strip()
+    elif s.endswith("円"):
+        s = s[:-1].strip()
+    if not _YEN_DIGITS_RE.fullmatch(s):
+        return None
+    value = int(s.replace(",", ""))
+    return -value if negative else value
+
+
+def import_bank_csv(text: str) -> ImportResult:
+    """Parse bank/card CSV text. Bad rows go to errors; good rows to expenses."""
+    text = text.removeprefix("﻿")
+    reader = csv.reader(io.StringIO(text))
+    try:
+        header_row = next(reader)
+    except StopIteration:
+        header_row = []
+    header = [h.strip().lower() for h in header_row]
+
+    date_idx = _find_column(header, _DATE_COLUMNS)
+    amount_idx = _find_column(header, _AMOUNT_COLUMNS)
+    if date_idx is None or amount_idx is None:
+        missing = [
+            label
+            for label, idx in (("日付", date_idx), ("金額", amount_idx))
+            if idx is None
+        ]
+        raise BankImportError("必須列が見つかりません: " + ", ".join(missing))
+
+    category_idx = _find_column(header, _CATEGORY_COLUMNS)
+    memo_idx = _find_column(header, _MEMO_COLUMNS)
+
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    for row in reader:
+        if not any(cell.strip() for cell in row):
+            continue  # blank line
+        line = reader.line_num
+        raw_date = _cell(row, date_idx)
+        raw_amount = _cell(row, amount_idx)
+        day = _parse_date(raw_date)
+        if day is None:
+            errors.append(RowError(line, f"日付が不正です: '{raw_date}'"))
+            continue
+        amount = _parse_amount(raw_amount)
+        if amount is None:
+            errors.append(RowError(line, f"金額が不正です: '{raw_amount}'"))
+            continue
+        category = (
+            _cell(row, category_idx).strip()
+            if category_idx is not None
+            else _UNCATEGORIZED
+        )
+        memo = _cell(row, memo_idx).strip() if memo_idx is not None else ""
+        expenses.append(Expense(day=day, category=category, amount=amount, memo=memo))
+
+    return ImportResult(expenses=expenses, errors=errors)
