+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,105 @@
+"""Detect recurring (monthly) expenses."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int  # yen
+    months: tuple[str, ...]  # "YYYY-MM", ascending
+    last_day: date
+    next_day: date
+
+
+def predict_next(last: date) -> date:
+    """Same day of the following month; clamped to that month's last day."""
+    if last.month == 12:
+        year, month = last.year + 1, 1
+    else:
+        year, month = last.year, last.month + 1
+    last_dom = calendar.monthrange(year, month)[1]
+    return date(year, month, min(last.day, last_dom))
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month - 1
+
+
+def _last_run(items: list[Expense]) -> list[Expense] | None:
+    """Last non-empty run of consecutive months with one entry each and equal amount.
+
+    `items` must be sorted by day. A month with several entries, a gap in months,
+    or an amount change ends the current run.
+    """
+    by_month: dict[int, list[Expense]] = {}
+    for e in items:
+        by_month.setdefault(_month_index(e.day), []).append(e)
+
+    runs: list[list[Expense]] = []
+    current: list[Expense] = []
+    prev_idx: int | None = None
+    for idx in sorted(by_month):
+        entries = by_month[idx]
+        if len(entries) != 1:
+            if current:
+                runs.append(current)
+            current = []
+            prev_idx = None
+            continue
+        e = entries[0]
+        if (
+            current
+            and prev_idx is not None
+            and idx == prev_idx + 1
+            and e.amount == current[-1].amount
+        ):
+            current.append(e)
+        else:
+            if current:
+                runs.append(current)
+            current = [e]
+        prev_idx = idx
+    if current:
+        runs.append(current)
+    return runs[-1] if runs else None
+
+
+def find_recurring(rows: list[Expense], min_months: int = 3) -> list[Recurring]:
+    """Find (category, memo) pairs billed the same amount in min_months+ consecutive months.
+
+    Only the last consecutive run of each pair is judged. Result is sorted by
+    amount desc, then category, then memo.
+    """
+    if min_months < 1:
+        raise ValueError("min_months は 1 以上である必要があります")
+
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.memo.strip()), []).append(e)
+
+    out: list[Recurring] = []
+    for (category, memo), items in groups.items():
+        run = _last_run(sorted(items, key=lambda e: e.day))
+        if run is None or len(run) < min_months:
+            continue
+        last = run[-1]
+        out.append(
+            Recurring(
+                category=category,
+                memo=memo,
+                amount=last.amount,
+                months=tuple(f"{e.day:%Y-%m}" for e in run),
+                last_day=last.day,
+                next_day=predict_next(last.day),
+            )
+        )
+    out.sort(key=lambda r: (-r.amount, r.category, r.memo))
+    return out
diff --git a/src/kakeibo/search.py b/src/kakeibo/search.py
