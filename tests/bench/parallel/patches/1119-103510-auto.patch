+++ b/tests/test_bank_import.py
@@ -0,0 +1,186 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import BankImportError, RowError, import_bank_csv
+from kakeibo.core import Expense
+
+
+def _csv(*lines: str) -> str:
+    return "\n".join(lines) + "\n"
+
+
+@pytest.mark.parametrize(
+    "header",
+    [
+        "date,amount,category,memo",
+        " Date , AMOUNT , Category , Memo ",
+        "利用日,利用金額,分類,利用店名",
+        "取引日,出金額,費目,内容",
+        "ご利用日,支払金額,カテゴリ,備考",
+        "日付,金額,カテゴリ,摘要",
+        "ご利用日,金額,カテゴリ,ご利用先",
+    ],
+)
+def test_column_aliases_and_case_and_space_insensitive(header: str) -> None:
+    result = import_bank_csv(_csv(header, '2026-01-05,"1,234"'))
+    assert result.errors == []
+    assert len(result.expenses) == 1
+    assert result.expenses[0].amount == 1234
+
+
+def test_missing_date_column_raises_and_names_it() -> None:
+    with pytest.raises(BankImportError) as exc:
+        import_bank_csv(_csv("金額,カテゴリ", "100,食費"))
+    assert "日付" in str(exc.value)
+    assert "金額" not in str(exc.value)
+
+
+def test_missing_amount_column_raises_and_names_it() -> None:
+    with pytest.raises(BankImportError) as exc:
+        import_bank_csv(_csv("日付,カテゴリ", "2026-01-05,食費"))
+    assert "金額" in str(exc.value)
+    assert "日付" not in str(exc.value)
+
+
+def test_missing_both_required_columns_names_both() -> None:
+    with pytest.raises(BankImportError) as exc:
+        import_bank_csv(_csv("カテゴリ,メモ", "食費,x"))
+    assert "日付" in str(exc.value)
+    assert "金額" in str(exc.value)
+
+
+def test_empty_input_raises_bank_import_error() -> None:
+    with pytest.raises(BankImportError):
+        import_bank_csv("")
+
+
+def test_bank_import_error_is_value_error() -> None:
+    assert issubclass(BankImportError, ValueError)
+
+
+def test_missing_category_column_defaults_to_uncategorized() -> None:
+    result = import_bank_csv(_csv("日付,金額", "2026-01-05,100"))
+    assert result.expenses == [
+        Expense(day=date(2026, 1, 5), category="未分類", amount=100, memo="")
+    ]
+
+
+def test_missing_memo_column_defaults_to_empty() -> None:
+    result = import_bank_csv(_csv("日付,金額,カテゴリ", "2026-01-05,100,食費"))
+    assert result.expenses[0].memo == ""
+    assert result.expenses[0].category == "食費"
+
+
+@pytest.mark.parametrize(
+    "raw",
+    ["2026-01-05", "2026/1/5", "2026年1月5日", "20260105"],
+)
+def test_date_formats(raw: str) -> None:
+    result = import_bank_csv(_csv("日付,金額", f"{raw},100"))
+    assert result.errors == []
+    assert result.expenses[0].day == date(2026, 1, 5)
+
+
+def test_invalid_calendar_date_is_row_error() -> None:
+    result = import_bank_csv(_csv("日付,金額", "2026-02-30,100"))
+    assert result.expenses == []
+    assert result.errors == [RowError(2, "日付が不正です: '2026-02-30'")]
+
+
+def test_non_date_text_is_row_error() -> None:
+    result = import_bank_csv(_csv("日付,金額", "abc,100"))
+    assert result.errors == [RowError(2, "日付が不正です: 'abc'")]
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        ("1234", 1234),
+        ("1,234", 1234),
+        ("¥1,234", 1234),
+        ("￥1,234", 1234),
+        ("1234円", 1234),
+        ("1,234円", 1234),
+        ("１２３４", 1234),
+        ("(1,234)", -1234),
+        ("-1,234", -1234),
+        ("-¥1,234", -1234),
+        (" 1,234 ", 1234),
+    ],
+)
+def test_amount_formats(raw: str, expected: int) -> None:
+    result = import_bank_csv(_csv("日付,金額", f'2026-01-05,"{raw}"'))
+    assert result.errors == []
+    assert result.expenses[0].amount == expected
+    assert isinstance(result.expenses[0].amount, int)
+
+
+@pytest.mark.parametrize("raw", ["12.5", "", "   ", "abc", "1,23", "(1,234", "--1"])
+def test_invalid_amount_is_row_error(raw: str) -> None:
+    result = import_bank_csv(_csv("日付,金額", f'2026-01-05,"{raw}"'))
+    assert result.expenses == []
+    assert result.errors == [RowError(2, f"金額が不正です: '{raw}'")]
+
+
+def test_bad_rows_collected_and_good_rows_kept_with_line_numbers() -> None:
+    text = _csv(
+        "日付,金額,カテゴリ,摘要",
+        "2026-01-05,1000,食費,スーパー",  # line 2 ok
+        "2026-01-06,abc,食費,x",  # line 3 bad amount
+        "2026-01-07,500,交通,電車",  # line 4 ok
+        "2026-13-01,700,娯楽,y",  # line 5 bad date
+    )
+    result = import_bank_csv(text)
+    assert result.expenses == [
+        Expense(date(2026, 1, 5), "食費", 1000, "スーパー"),
+        Expense(date(2026, 1, 7), "交通", 500, "電車"),
+    ]
+    assert result.errors == [
+        RowError(3, "金額が不正です: 'abc'"),
+        RowError(5, "日付が不正です: '2026-13-01'"),
+    ]
+
+
+def test_blank_lines_are_skipped_but_still_counted_in_line_numbers() -> None:
+    text = "日付,金額\n\n2026-01-05,100\n\n  \n2026-01-06,abc\n"
+    result = import_bank_csv(text)
+    assert [e.amount for e in result.expenses] == [100]
+    assert result.errors == [RowError(6, "金額が不正です: 'abc'")]
+
+
+def test_header_only_returns_empty_result() -> None:
+    result = import_bank_csv("日付,金額,カテゴリ,摘要\n")
+    assert result.expenses == []
+    assert result.errors == []
+
+
+def test_bom_at_start_is_stripped() -> None:
+    result = import_bank_csv("﻿日付,金額\n2026-01-05,100\n")
+    assert result.errors == []
+    assert result.expenses[0].amount == 100
+
+
+def test_short_row_missing_amount_is_row_error() -> None:
+    result = import_bank_csv(_csv("日付,金額,カテゴリ", "2026-01-05"))
+    assert result.expenses == []
+    assert result.errors == [RowError(2, "金額が不正です: ''")]
+
+
+def test_quoted_memo_with_comma_is_kept_whole() -> None:
+    result = import_bank_csv(
+        _csv("日付,金額,摘要", '2026-01-05,"1,234","コンビニ, 新宿"')
+    )
+    assert result.expenses == [
+        Expense(date(2026, 1, 5), "未分類", 1234, "コンビニ, 新宿")
+    ]
+
+
+def test_category_and_memo_are_stripped() -> None:
+    result = import_bank_csv(
+        _csv("日付,金額,カテゴリ,摘要", "2026-01-05,100, 食費 , お茶 ")
+    )
+    assert result.expenses[0].category == "食費"
+    assert result.expenses[0].memo == "お茶"
