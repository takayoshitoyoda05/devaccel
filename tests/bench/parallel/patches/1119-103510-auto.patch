index 0000000..d829998
--- /dev/null
+++ b/tests/test_compare.py
@@ -0,0 +1,186 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.compare import CategoryChange, compare_months, format_comparison
+from kakeibo.core import Expense
+
+
+def _e(y: int, m: int, category: str, amount: int) -> Expense:
+    return Expense(day=date(y, m, 1), category=category, amount=amount)
+
+
+def _find(changes: list[CategoryChange], category: str) -> CategoryChange:
+    matches = [c for c in changes if c.category == category]
+    assert len(matches) == 1
+    return matches[0]
+
+
+def test_increase_fields_and_status() -> None:
+    rows = [_e(2026, 2, "食費", 30000), _e(2026, 3, "食費", 35000)]
+    (c,) = compare_months(rows, "2026-03")
+    assert (c.category, c.previous, c.current, c.diff, c.status) == (
+        "食費",
+        30000,
+        35000,
+        5000,
+        "増加",
+    )
+    assert c.ratio is not None
+    assert c.ratio == pytest.approx(5000 / 30000)
+
+
+def test_decrease_status() -> None:
+    rows = [_e(2026, 2, "外食", 10000), _e(2026, 3, "外食", 4000)]
+    (c,) = compare_months(rows, "2026-03")
+    assert c.status == "減少"
+    assert c.diff == -6000
+    assert c.ratio == pytest.approx(-0.6)
+
+
+def test_unchanged_status() -> None:
+    rows = [_e(2026, 2, "通信費", 8000), _e(2026, 3, "通信費", 8000)]
+    (c,) = compare_months(rows, "2026-03")
+    assert c.status == "変化なし"
+    assert c.diff == 0
+    assert c.ratio == 0.0
+
+
+def test_new_category_has_previous_zero_and_no_ratio() -> None:
+    rows = [_e(2026, 3, "医療費", 5000)]
+    (c,) = compare_months(rows, "2026-03")
+    assert c == CategoryChange(
+        category="医療費",
+        previous=0,
+        current=5000,
+        diff=5000,
+        ratio=None,
+        status="新規",
+    )
+
+
+def test_disappeared_category_has_current_zero() -> None:
+    rows = [_e(2026, 2, "娯楽", 3000)]
+    (c,) = compare_months(rows, "2026-03")
+    assert c == CategoryChange(
+        category="娯楽", previous=3000, current=0, diff=-3000, ratio=-1.0, status="消滅"
+    )
+
+
+def test_both_months_included_for_every_category() -> None:
+    rows = [
+        _e(2026, 2, "食費", 1000),
+        _e(2026, 2, "住居費", 2000),
+        _e(2026, 3, "食費", 1000),
+        _e(2026, 3, "被服費", 500),
+    ]
+    changes = compare_months(rows, "2026-03")
+    assert {c.category for c in changes} == {"食費", "住居費", "被服費"}
+    assert _find(changes, "住居費").status == "消滅"
+    assert _find(changes, "被服費").status == "新規"
+
+
+def test_january_compares_with_previous_december() -> None:
+    rows = [
+        _e(2025, 12, "食費", 40000),
+        _e(2026, 1, "食費", 30000),
+        _e(2025, 11, "食費", 999999),  # not the previous month
+    ]
+    (c,) = compare_months(rows, "2026-01")
+    assert c.previous == 40000
+    assert c.current == 30000
+    assert c.diff == -10000
+
+
+def test_only_the_two_months_are_counted() -> None:
+    rows = [
+        _e(2026, 1, "食費", 100),  # not the previous month of 2026-03
+        _e(2026, 2, "食費", 200),
+        _e(2026, 3, "食費", 300),
+        _e(2026, 4, "食費", 400),  # after the target month
+    ]
+    (c,) = compare_months(rows, "2026-03")
+    assert (c.previous, c.current) == (200, 300)
+
+
+def test_sorted_by_abs_diff_desc_then_category_asc() -> None:
+    rows = [
+        _e(2026, 2, "B", 1000),
+        _e(2026, 3, "B", 1000),  # diff 0
+        _e(2026, 2, "A", 1000),
+        _e(2026, 3, "A", 1000),  # diff 0
+        _e(2026, 2, "C", 10000),
+        _e(2026, 3, "C", 7000),  # diff -3000
+        _e(2026, 2, "D", 1000),
+        _e(2026, 3, "D", 4000),  # diff +3000
+        _e(2026, 3, "E", 5000),  # diff +5000, new
+    ]
+    cats = [c.category for c in compare_months(rows, "2026-03")]
+    assert cats == ["E", "C", "D", "A", "B"]
+
+
+def test_both_months_empty_returns_empty_list() -> None:
+    assert compare_months([], "2026-03") == []
+    assert compare_months([_e(2025, 1, "食費", 1)], "2026-03") == []
+
+
+@pytest.mark.parametrize(
+    "bad", ["2026-13", "2026-00", "2026-1", "2026/03", "abc", "", "202603"]
+)
+def test_invalid_month_raises_value_error(bad: str) -> None:
+    with pytest.raises(ValueError):
+        compare_months([], bad)
+
+
+def test_format_example_line() -> None:
+    changes = compare_months(
+        [_e(2026, 2, "食費", 30000), _e(2026, 3, "食費", 35000)], "2026-03"
+    )
+    assert (
+        format_comparison(changes)
+        == "食費: 30,000円 → 35,000円 (+5,000円, +16.7%) 増加"
+    )
+
+
+def test_format_decrease_uses_minus_sign() -> None:
+    changes = compare_months(
+        [_e(2026, 2, "外食", 10000), _e(2026, 3, "外食", 4000)], "2026-03"
+    )
+    assert (
+        format_comparison(changes) == "外食: 10,000円 → 4,000円 (-6,000円, -60.0%) 減少"
+    )
+
+
+def test_format_omits_percent_when_ratio_is_none() -> None:
+    changes = compare_months([_e(2026, 3, "医療費", 5000)], "2026-03")
+    assert format_comparison(changes) == "医療費: 0円 → 5,000円 (+5,000円) 新規"
+
+
+def test_format_unchanged_line() -> None:
+    changes = compare_months(
+        [_e(2026, 2, "通信費", 8000), _e(2026, 3, "通信費", 8000)], "2026-03"
+    )
+    assert (
+        format_comparison(changes) == "通信費: 8,000円 → 8,000円 (+0円, +0.0%) 変化なし"
+    )
+
+
+def test_format_empty_returns_no_comparison_message() -> None:
+    assert format_comparison([]) == "比較対象がありません"
+
+
+def test_format_joins_lines_in_given_order() -> None:
+    changes = compare_months(
+        [
+            _e(2026, 2, "食費", 30000),
+            _e(2026, 3, "食費", 35000),
+            _e(2026, 2, "外食", 10000),
+            _e(2026, 3, "外食", 4000),
+        ],
+        "2026-03",
+    )
+    lines = format_comparison(changes).split("\n")
+    # 外食 (|diff| 6,000) sorts before 食費 (|diff| 5,000) in compare_months
+    assert [line.split(":")[0] for line in lines] == ["外食", "食費"]
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..c0ebb13
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,251 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, predict_next
+
+
+def ex(
+    y: int, m: int, amount: int, category: str = "通信", memo: str = "", d: int = 1
+) -> Expense:
+    return Expense(date(y, m, d), category, amount, memo)
+
+
+def monthly(
+    months: list[tuple[int, int]], amount: int = 1000, memo: str = "回線"
+) -> list[Expense]:
+    return [ex(y, m, amount, memo=memo) for y, m in months]
+
+
+# --- predict_next ---------------------------------------------------------
+
+
+def test_predict_next_clamps_to_month_end() -> None:
+    assert predict_next(date(2026, 1, 31)) == date(2026, 2, 28)
+
+
+def test_predict_next_leap_year_february() -> None:
+    assert predict_next(date(2028, 1, 31)) == date(2028, 2, 29)
+
+
+def test_predict_next_rolls_over_year() -> None:
+    assert predict_next(date(2026, 12, 15)) == date(2027, 1, 15)
+
+
+def test_predict_next_keeps_day_when_available() -> None:
+    assert predict_next(date(2026, 3, 31)) == date(2026, 4, 30)
+    assert predict_next(date(2026, 4, 10)) == date(2026, 5, 10)
+
+
+# --- find_recurring: basics -----------------------------------------------
+
+
+def test_empty_rows_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+@pytest.mark.parametrize("bad", [0, -1])
+def test_min_months_below_one_raises(bad: int) -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_months=bad)
+
+
+def test_min_months_below_one_raises_even_with_rows() -> None:
+    with pytest.raises(ValueError):
+        find_recurring(monthly([(2026, 1)]), min_months=0)
+
+
+def test_three_consecutive_months_detected() -> None:
+    rows = monthly([(2026, 1), (2026, 2), (2026, 3)])
+    assert find_recurring(rows) == [
+        Recurring(
+            category="通信",
+            memo="回線",
+            amount=1000,
+            months=("2026-01", "2026-02", "2026-03"),
+            last_day=date(2026, 3, 1),
+            next_day=date(2026, 4, 1),
+        )
+    ]
+
+
+def test_two_consecutive_months_not_enough_by_default() -> None:
+    assert find_recurring(monthly([(2026, 1), (2026, 2)])) == []
+
+
+def test_min_months_two_accepts_two_months() -> None:
+    result = find_recurring(monthly([(2026, 1), (2026, 2)]), min_months=2)
+    assert [r.months for r in result] == [("2026-01", "2026-02")]
+
+
+def test_single_occurrence_with_min_one_is_detected() -> None:
+    result = find_recurring(monthly([(2026, 5)]), min_months=1)
+    assert len(result) == 1
+    assert result[0].months == ("2026-05",)
+
+
+def test_run_longer_than_min_is_included_whole() -> None:
+    rows = monthly([(2026, m) for m in range(1, 7)])
+    result = find_recurring(rows)
+    assert result[0].months == tuple(f"2026-{m:02d}" for m in range(1, 7))
+
+
+def test_year_boundary_is_consecutive() -> None:
+    result = find_recurring(monthly([(2025, 11), (2025, 12), (2026, 1)]))
+    assert [r.months for r in result] == [("2025-11", "2025-12", "2026-01")]
+
+
+# --- gaps ----------------------------------------------------------------
+
+
+def test_skipped_month_breaks_the_run() -> None:
+    # 1,2,4 : not consecutive
+    assert find_recurring(monthly([(2026, 1), (2026, 2), (2026, 4)])) == []
+
+
+def test_only_last_run_is_judged_after_gap() -> None:
+    # 1..3 is a run of 3, but the last run (4 alone) is too short
+    assert find_recurring(monthly([(2026, 1), (2026, 2), (2026, 3), (2026, 5)])) == []
+
+
+def test_last_run_after_gap_is_used_when_long_enough() -> None:
+    rows = monthly([(2026, 1), (2026, 3), (2026, 4), (2026, 5)])
+    result = find_recurring(rows)
+    assert result[0].months == ("2026-03", "2026-04", "2026-05")
+
+
+# --- amount change / same-month duplicates ---------------------------------
+
+
+def test_amount_change_splits_runs_and_uses_last_run() -> None:
+    rows = [
+        ex(2026, 1, 1000),
+        ex(2026, 2, 1000),
+        ex(2026, 3, 1000),
+        ex(2026, 4, 1200),
+        ex(2026, 5, 1200),
+        ex(2026, 6, 1200),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].amount == 1200
+    assert result[0].months == ("2026-04", "2026-05", "2026-06")
+    assert result[0].last_day == date(2026, 6, 1)
+
+
+def test_amount_change_leaving_short_last_run_excludes_group() -> None:
+    rows = [
+        ex(2026, 1, 1000),
+        ex(2026, 2, 1000),
+        ex(2026, 3, 1000),
+        ex(2026, 4, 1200),
+        ex(2026, 5, 1200),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_same_month_duplicate_breaks_run() -> None:
+    # Feb has two entries: the run Jan alone and Mar-Apr are both short.
+    rows = [
+        ex(2026, 1, 1000),
+        ex(2026, 2, 1000, d=3),
+        ex(2026, 2, 1000, d=20),
+        ex(2026, 3, 1000),
+        ex(2026, 4, 1000),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_same_month_duplicate_then_long_last_run_is_detected() -> None:
+    rows = [
+        ex(2026, 1, 1000),
+        ex(2026, 2, 1000),
+        ex(2026, 2, 1000, d=20),
+        ex(2026, 3, 1000),
+        ex(2026, 4, 1000),
+        ex(2026, 5, 1000),
+    ]
+    result = find_recurring(rows)
+    assert [r.months for r in result] == [("2026-03", "2026-04", "2026-05")]
+
+
+def test_last_day_is_day_of_final_entry() -> None:
+    rows = [ex(2026, 1, 500, d=5), ex(2026, 2, 500, d=5), ex(2026, 3, 500, d=28)]
+    result = find_recurring(rows)
+    assert result[0].last_day == date(2026, 3, 28)
+    assert result[0].next_day == date(2026, 4, 28)
+
+
+def test_next_day_clamps_when_last_day_is_month_end() -> None:
+    rows = [ex(2026, 11, 500, d=30), ex(2026, 12, 500, d=31)]
+    result = find_recurring(rows, min_months=2)
+    assert result[0].last_day == date(2026, 12, 31)
+    assert result[0].next_day == date(2027, 1, 31)
+
+
+# --- grouping keys -------------------------------------------------------
+
+
+def test_memo_is_stripped_for_grouping() -> None:
+    rows = [
+        ex(2026, 1, 1000, memo=" 回線 "),
+        ex(2026, 2, 1000, memo="回線"),
+        ex(2026, 3, 1000, memo="回線  "),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].memo == "回線"
+
+
+def test_different_memo_is_different_group() -> None:
+    rows = [
+        ex(2026, 1, 1000, memo="A"),
+        ex(2026, 2, 1000, memo="A"),
+        ex(2026, 3, 1000, memo="B"),
+        ex(2026, 4, 1000, memo="B"),
+        ex(2026, 5, 1000, memo="B"),
+    ]
+    result = find_recurring(rows)
+    assert [r.memo for r in result] == ["B"]
+
+
+def test_different_category_is_different_group() -> None:
+    rows = monthly([(2026, 1), (2026, 2)]) + [
+        ex(2026, m, 1000, category="保険", memo="回線") for m in (1, 2, 3)
+    ]
+    result = find_recurring(rows)
+    assert [r.category for r in result] == ["保険"]
+
+
+def test_rows_given_out_of_order_are_sorted_before_judging() -> None:
+    rows = monthly([(2026, 3), (2026, 1), (2026, 2)])
+    result = find_recurring(rows)
+    assert result[0].months == ("2026-01", "2026-02", "2026-03")
+    assert result[0].last_day == date(2026, 3, 1)
+
+
+# --- ordering ------------------------------------------------------------
+
+
+def test_sort_by_amount_desc_then_category_then_memo() -> None:
+    rows: list[Expense] = []
+    rows += [ex(2026, m, 500, category="B", memo="x") for m in (1, 2, 3)]
+    rows += [ex(2026, m, 500, category="A", memo="y") for m in (1, 2, 3)]
+    rows += [ex(2026, m, 500, category="A", memo="x") for m in (1, 2, 3)]
+    rows += [ex(2026, m, 9000, category="Z", memo="z") for m in (1, 2, 3)]
+    result = find_recurring(rows)
+    assert [(r.amount, r.category, r.memo) for r in result] == [
+        (9000, "Z", "z"),
+        (500, "A", "x"),
+        (500, "A", "y"),
+        (500, "B", "x"),
+    ]
+
+
+def test_min_months_parameter_filters_longer_runs() -> None:
+    rows = monthly([(2026, 1), (2026, 2), (2026, 3), (2026, 4)])
+    assert find_recurring(rows, min_months=5) == []
+    assert len(find_recurring(rows, min_months=4)) == 1
diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..afeb2e2
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,134 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    all_of,
+    amount_between,
+    any_of,
+    between_days,
+    by_category,
+    memo_contains,
+    not_,
+    search,
+)
+
+ROWS = [
+    Expense(date(2024, 1, 1), "食費", 1000, "スーパー"),
+    Expense(date(2024, 1, 15), "交通", 200, "電車"),
+    Expense(date(2024, 2, 1), "住居", 80000, "家賃 2月"),
+    Expense(date(2024, 2, 10), "食費", 50000, ""),
+    Expense(date(2024, 3, 31), "娯楽", 5, "Coffee"),
+]
+
+
+def test_by_category_matches_any_name() -> None:
+    assert search(ROWS, by_category("食費", "交通")) == [ROWS[0], ROWS[1], ROWS[3]]
+
+
+def test_by_category_single_name_exact_match_only() -> None:
+    assert search(ROWS, by_category("食")) == []
+
+
+def test_by_category_no_args_raises() -> None:
+    with pytest.raises(ValueError):
+        by_category()
+
+
+def test_amount_between_inclusive_both_ends() -> None:
+    assert search(ROWS, amount_between(200, 1000)) == [ROWS[0], ROWS[1]]
+
+
+def test_amount_between_same_low_and_high() -> None:
+    assert search(ROWS, amount_between(200, 200)) == [ROWS[1]]
+
+
+def test_amount_between_open_ended() -> None:
+    assert search(ROWS, amount_between(low=50000)) == [ROWS[2], ROWS[3]]
+    assert search(ROWS, amount_between(high=200)) == [ROWS[1], ROWS[4]]
+
+
+def test_amount_between_no_bounds_matches_all() -> None:
+    assert search(ROWS, amount_between()) == ROWS
+
+
+def test_amount_between_low_greater_than_high_raises() -> None:
+    with pytest.raises(ValueError):
+        amount_between(10, 5)
+
+
+def test_memo_contains_case_insensitive_substring() -> None:
+    assert search(ROWS, memo_contains("家賃")) == [ROWS[2]]
+    assert search(ROWS, memo_contains("coffee")) == [ROWS[4]]
+    assert search(ROWS, memo_contains("COFFEE")) == [ROWS[4]]
+
+
+def test_memo_contains_empty_text_always_matches() -> None:
+    assert search(ROWS, memo_contains("")) == ROWS
+
+
+def test_memo_contains_does_not_match_empty_memo() -> None:
+    assert search(ROWS, memo_contains("x")) == []
+
+
+def test_between_days_inclusive_both_ends() -> None:
+    assert search(ROWS, between_days(date(2024, 1, 15), date(2024, 2, 1))) == [
+        ROWS[1],
+        ROWS[2],
+    ]
+
+
+def test_between_days_same_start_and_end() -> None:
+    assert search(ROWS, between_days(date(2024, 2, 10), date(2024, 2, 10))) == [ROWS[3]]
+
+
+def test_between_days_open_ended() -> None:
+    assert search(ROWS, between_days(start=date(2024, 3, 1))) == [ROWS[4]]
+    assert search(ROWS, between_days(end=date(2024, 1, 1))) == [ROWS[0]]
+
+
+def test_between_days_start_after_end_raises() -> None:
+    with pytest.raises(ValueError):
+        between_days(date(2024, 2, 1), date(2024, 1, 1))
+
+
+def test_all_of_is_and() -> None:
+    pred = all_of(by_category("食費", "交通"), amount_between(high=1000))
+    assert search(ROWS, pred) == [ROWS[0], ROWS[1]]
+
+
+def test_all_of_no_args_always_true() -> None:
+    assert search(ROWS, all_of()) == ROWS
+
+
+def test_any_of_is_or() -> None:
+    pred = any_of(memo_contains("家賃"), amount_between(low=50000))
+    assert search(ROWS, pred) == [ROWS[2], ROWS[3]]
+
+
+def test_any_of_no_args_always_false() -> None:
+    assert search(ROWS, any_of()) == []
+
+
+def test_not_negates() -> None:
+    assert search(ROWS, not_(by_category("食費"))) == [ROWS[1], ROWS[2], ROWS[4]]
+
+
+def test_search_preserves_input_order() -> None:
+    reordered = [ROWS[3], ROWS[0], ROWS[2]]
+    assert search(reordered, amount_between()) == reordered
+
+
+def test_search_does_not_modify_input() -> None:
+    rows = list(ROWS)
+    search(rows, by_category("食費"))
+    assert rows == ROWS
+
+
+def test_search_returns_new_list() -> None:
+    result = search(ROWS, amount_between())
+    assert result == ROWS
+    assert result is not ROWS
