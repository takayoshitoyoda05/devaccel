@@ -0,0 +1,85 @@
+"""Month-over-month comparison of expenses by category."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense, monthly_totals
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    diff: int  # current - previous
+    ratio: float | None  # diff / previous; None when previous is 0
+    status: str  # 増加 / 減少 / 変化なし / 新規 / 消滅
+
+
+def _previous_month(month: str) -> str:
+    year, mon = int(month[:4]), int(month[5:])
+    if mon == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mon - 1:02d}"
+
+
+def _status(previous: int, current: int, diff: int) -> str:
+    if previous == 0 and current == 0:
+        return "変化なし"
+    if previous == 0:
+        return "新規"
+    if current == 0:
+        return "消滅"
+    if diff > 0:
+        return "増加"
+    if diff < 0:
+        return "減少"
+    return "変化なし"
+
+
+def compare_months(rows: list[Expense], month: str) -> list[CategoryChange]:
+    """Compare `month` (YYYY-MM) with the calendar month before it."""
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+    prev_month = _previous_month(month)
+    totals = monthly_totals(rows)
+    prev_cats = totals.get(prev_month, {})
+    cur_cats = totals.get(month, {})
+
+    changes: list[CategoryChange] = []
+    for category in set(prev_cats) | set(cur_cats):
+        previous = prev_cats.get(category, 0)
+        current = cur_cats.get(category, 0)
+        diff = current - previous
+        ratio = None if previous == 0 else diff / previous
+        changes.append(
+            CategoryChange(
+                category=category,
+                previous=previous,
+                current=current,
+                diff=diff,
+                ratio=ratio,
+                status=_status(previous, current, diff),
+            )
+        )
+    changes.sort(key=lambda c: (-abs(c.diff), c.category))
+    return changes
+
+
+def format_comparison(changes: list[CategoryChange]) -> str:
+    """One Japanese line per category; the percentage is omitted when ratio is None."""
+    if not changes:
+        return "比較対象がありません"
+    lines: list[str] = []
+    for c in changes:
+        change = f"{c.diff:+,}円"
+        if c.ratio is not None:
+            change += f", {c.ratio * 100:+.1f}%"
+        lines.append(
+            f"{c.category}: {c.previous:,}円 → {c.current:,}円 ({change}) {c.status}"
+        )
+    return "\n".join(lines)
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
