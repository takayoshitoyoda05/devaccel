index 0000000..19ace1b
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,60 @@
+"""Filter expenses with composable predicates."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from datetime import date
+
+from kakeibo.core import Expense
+
+Predicate = Callable[[Expense], bool]
+
+
+def by_category(*names: str) -> Predicate:
+    """Match expenses whose category equals any of ``names``."""
+    if not names:
+        raise ValueError("by_category には少なくとも 1 つのカテゴリが必要です")
+    wanted = frozenset(names)
+    return lambda e: e.category in wanted
+
+
+def amount_between(low: int | None = None, high: int | None = None) -> Predicate:
+    """Match amounts in [low, high] (both inclusive). None means unbounded."""
+    if low is not None and high is not None and low > high:
+        raise ValueError(f"low({low}) は high({high}) 以下である必要があります")
+    return lambda e: (
+        (low is None or e.amount >= low) and (high is None or e.amount <= high)
+    )
+
+
+def memo_contains(text: str) -> Predicate:
+    """Case-insensitive substring match on memo. Empty text always matches."""
+    needle = text.casefold()
+    return lambda e: needle in e.memo.casefold()
+
+
+def between_days(start: date | None = None, end: date | None = None) -> Predicate:
+    """Match days in [start, end] (both inclusive). None means unbounded."""
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"start({start}) は end({end}) 以前である必要があります")
+    return lambda e: (start is None or e.day >= start) and (end is None or e.day <= end)
+
+
+def all_of(*preds: Predicate) -> Predicate:
+    """AND of predicates. With no arguments, always True."""
+    return lambda e: all(p(e) for p in preds)
+
+
+def any_of(*preds: Predicate) -> Predicate:
+    """OR of predicates. With no arguments, always False."""
+    return lambda e: any(p(e) for p in preds)
+
+
+def not_(pred: Predicate) -> Predicate:
+    """Negate a predicate."""
+    return lambda e: not pred(e)
+
+
+def search(rows: list[Expense], pred: Predicate) -> list[Expense]:
+    """Return matching rows in input order. The input list is not modified."""
+    return [e for e in rows if pred(e)]
diff --git a/tests/test_bank_import.py b/tests/test_bank_import.py
