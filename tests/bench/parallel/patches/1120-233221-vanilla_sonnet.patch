+"""Budget status per month/category: ok / near (about to exceed) / over.
+
+Pure functions only; reuses ``Budget`` from ``kakeibo.core``.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Literal
+
+from kakeibo.core import Budget
+
+Level = Literal["ok", "near", "over"]
+
+DEFAULT_NEAR_PERCENT = 80
+
+
+@dataclass(frozen=True)
+class BudgetStatus:
+    month: str
+    category: str
+    limit: int
+    actual: int
+    level: Level
+
+    @property
+    def remaining(self) -> int:
+        """Yen left before the limit; negative when over."""
+        return self.limit - self.actual
+
+
+def classify(
+    actual: int, limit: int, near_percent: int = DEFAULT_NEAR_PERCENT
+) -> Level:
+    """over: actual > limit; near: actual >= near_percent% of limit; else ok.
+
+    Spending exactly the limit is "near", not "over" (matches find_overruns).
+    Integer math only, so there is no float rounding at the boundary.
+    """
+    if not 0 < near_percent <= 100:
+        raise ValueError(f"near_percent は 1〜100 である必要があります: {near_percent}")
+    if actual > limit:
+        return "over"
+    if actual > 0 and actual * 100 >= limit * near_percent:
+        return "near"
+    return "ok"
+
+
+def budget_statuses(
+    totals: dict[str, dict[str, int]],
+    budget: Budget,
+    near_percent: int = DEFAULT_NEAR_PERCENT,
+) -> list[BudgetStatus]:
+    """Status of every budgeted category in each month of ``totals``.
+
+    Budgeted categories with no spending appear with actual 0. Categories
+    without a budget are omitted. Order: month ascending, then budget order.
+    """
+    out: list[BudgetStatus] = []
+    for month in sorted(totals):
+        spent = totals[month]
+        for cat, limit in budget.for_month(month).items():
+            actual = spent.get(cat, 0)
+            level = classify(actual, limit, near_percent)
+            out.append(BudgetStatus(month, cat, limit, actual, level))
+    return out
+
+
+def format_alert(s: BudgetStatus) -> str | None:
+    """Japanese alert line for near/over, None for ok."""
+    if s.level == "over":
+        return (
+            f"超過: {s.month} {s.category} {-s.remaining:,}円超過 "
+            f"(予算 {s.limit:,} / 実績 {s.actual:,})"
+        )
+    if s.level == "near":
+        return (
+            f"注意: {s.month} {s.category} 予算まで残り{s.remaining:,}円 "
+            f"(予算 {s.limit:,} / 実績 {s.actual:,})"
+        )
+    return None
+
+
+def alerts(
+    totals: dict[str, dict[str, int]],
+    budget: Budget,
+    near_percent: int = DEFAULT_NEAR_PERCENT,
+) -> list[str]:
+    """Alert lines for all near/over statuses."""
+    lines = (format_alert(s) for s in budget_statuses(totals, budget, near_percent))
+    return [line for line in lines if line is not None]
