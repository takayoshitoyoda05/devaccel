@@ -0,0 +1,89 @@
+import pytest
+
+from kakeibo.budget_status import (
+    BudgetStatus,
+    alerts,
+    budget_statuses,
+    classify,
+    format_alert,
+)
+from kakeibo.core import Budget
+
+
+@pytest.mark.parametrize(
+    ("actual", "limit", "expected"),
+    [
+        (0, 1000, "ok"),
+        (799, 1000, "ok"),
+        (800, 1000, "near"),
+        (1000, 1000, "near"),  # exactly the limit is not an overrun
+        (1001, 1000, "over"),
+        (0, 0, "ok"),
+        (1, 0, "over"),
+    ],
+)
+def test_classify(actual, limit, expected):
+    assert classify(actual, limit) == expected
+
+
+def test_classify_custom_percent():
+    assert classify(500, 1000, 50) == "near"
+    assert classify(499, 1000, 50) == "ok"
+    assert classify(1000, 1000, 100) == "near"
+    assert classify(999, 1000, 100) == "ok"
+
+
+@pytest.mark.parametrize("pct", [0, -1, 101])
+def test_classify_rejects_bad_percent(pct):
+    with pytest.raises(ValueError):
+        classify(1, 10, pct)
+
+
+def test_budget_statuses():
+    budget = Budget(
+        default={"food": 1000, "rent": 80000, "fun": 500},
+        months={"2026-11": {"food": 2000}},
+    )
+    totals = {
+        "2026-11": {"rent": 80000, "food": 1900},
+        "2026-10": {"food": 1200, "misc": 5},
+    }
+    got = budget_statuses(totals, budget)
+    assert got == [
+        BudgetStatus("2026-10", "food", 1000, 1200, "over"),
+        BudgetStatus("2026-10", "rent", 80000, 0, "ok"),
+        BudgetStatus("2026-10", "fun", 500, 0, "ok"),
+        BudgetStatus("2026-11", "food", 2000, 1900, "near"),
+        BudgetStatus("2026-11", "rent", 80000, 80000, "near"),
+        BudgetStatus("2026-11", "fun", 500, 0, "ok"),
+    ]
+    assert got[0].remaining == -200
+
+
+def test_empty_inputs():
+    assert budget_statuses({}, Budget({"food": 1}, {})) == []
+    assert budget_statuses({"2026-11": {"food": 5}}, Budget({}, {})) == []
+
+
+def test_format_alert():
+    assert format_alert(BudgetStatus("2026-11", "food", 1000, 1150, "over")) == (
+        "超過: 2026-11 food 150円超過 (予算 1,000 / 実績 1,150)"
+    )
+    assert format_alert(BudgetStatus("2026-11", "food", 1000, 900, "near")) == (
+        "注意: 2026-11 food 予算まで残り100円 (予算 1,000 / 実績 900)"
+    )
+    assert format_alert(BudgetStatus("2026-11", "food", 1000, 10, "ok")) is None
+
+
+def test_alerts():
+    budget = Budget({"food": 1000, "rent": 80000}, {})
+    totals = {"2026-11": {"food": 1150, "rent": 60000}}  # rent 75% -> ok
+    assert alerts(totals, budget) == [
+        "超過: 2026-11 food 150円超過 (予算 1,000 / 実績 1,150)",
+    ]
+    totals = {"2026-11": {"food": 900, "rent": 70000}}  # 90% / 87.5%
+    assert alerts(totals, budget) == [
+        "注意: 2026-11 food 予算まで残り100円 (予算 1,000 / 実績 900)",
+        "注意: 2026-11 rent 予算まで残り10,000円 (予算 80,000 / 実績 70,000)",
+    ]
+    assert len(alerts(totals, budget, 90)) == 1  # only food reaches 90%
