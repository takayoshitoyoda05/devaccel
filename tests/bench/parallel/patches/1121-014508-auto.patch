index 0000000..9e190a0
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,119 @@
+"""Import bank-statement CSV (他行 CSV) into Expense records."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"(-?)[¥￥]?([0-9][0-9,]*)円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    """'-' ? '¥'/'￥' ? digits-and-commas '円'? を受け付け、円の整数にする。"""
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    sign, digits = m.groups()
+    value = int(digits.replace(",", ""))
+    return -value if sign else value
+
+
+def parse_date(s: str) -> date:
+    """YYYY/M/D または YYYY-M-D(区切りは統一が必要)を date にする。"""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    year, _, month, day = m.groups()
+    try:
+        return date(int(year), int(month), int(day))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def _cell(record: list[str], index: dict[str, int], field: str) -> str:
+    """列が無い・足りない場合は空文字列。"""
+    i = index.get(field)
+    if i is None or i >= len(record):
+        return ""
+    return record[i]
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """1 行目がヘッダーの CSV 文字列を Expense の列にする。
+
+    戻り値は (取り込めた明細, [(行番号, フィールド名)] のエラー一覧)。
+    行番号は text 上の物理行番号(ヘッダーが 1、空行も数える)。
+    """
+    cols = DEFAULT_MAPPING if mapping is None else mapping
+    for key in ("date", "category", "amount"):
+        if key not in cols:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text))
+    header = next(reader, None)
+    if header is None:
+        raise ValueError("ヘッダー行がありません")
+
+    index: dict[str, int] = {}
+    for field in ("date", "category", "amount", "memo"):
+        if field not in cols:
+            continue
+        name = cols[field]
+        if name not in header:
+            raise ValueError(f"CSV に列 {name!r} がありません")
+        index[field] = header.index(name)
+
+    categories = category_map or {}
+    rows: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+
+    while True:
+        line_no = reader.line_num + 1
+        record = next(reader, None)
+        if record is None:
+            break
+        if not record:  # 空行は読み飛ばす(行番号は数える)
+            continue
+
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(_cell(record, index, "date"))
+        except ValueError:
+            errors.append((line_no, "date"))
+        try:
+            amount = parse_amount(_cell(record, index, "amount"))
+        except ValueError:
+            errors.append((line_no, "amount"))
+        category = _cell(record, index, "category").strip()
+        if not category:
+            errors.append((line_no, "category"))
+
+        if day is None or amount is None or not category:
+            continue
+        rows.append(
+            Expense(
+                day=day,
+                category=categories.get(category, category),
+                amount=amount,
+                memo=_cell(record, index, "memo").strip(),
+            )
+        )
+
+    return rows, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
new file mode 100644
index 0000000..90c81ff
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,89 @@
+"""Month-over-month comparison of expenses by category."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+
+    prev_totals: dict[str, int] = {}
+    curr_totals: dict[str, int] = {}
+    for e in rows:
+        m = e.day.strftime("%Y-%m")
+        if m == prev_month:
+            prev_totals[e.category] = prev_totals.get(e.category, 0) + e.amount
+        if m == curr_month:
+            curr_totals[e.category] = curr_totals.get(e.category, 0) + e.amount
+
+    # Presence is decided by whether any record exists, not by the sum.
+    prev_has = set(prev_totals)
+    curr_has = set(curr_totals)
+
+    out: list[DiffRow] = []
+    for cat in prev_has | curr_has:
+        prev = prev_totals.get(cat, 0)
+        curr = curr_totals.get(cat, 0)
+        delta = curr - prev
+        pct: float | None = None if prev == 0 else round(delta / prev * 100, 1) + 0.0
+        if cat not in prev_has:
+            status = "new"
+        elif cat not in curr_has:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+
+    out.sort(key=lambda r: (-abs(r.delta), r.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [r for r in diffs if r.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for r in diffs:
+        pct = "-" if r.pct is None else f"{r.pct:+.1f}%"
+        lines.append(f"{r.category}\t{r.prev}\t{r.curr}\t{r.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({e.day.strftime("%Y-%m") for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には明細のある月が 2 つ以上必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..670a18a
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,175 @@
+"""Search query: tokenize, parse and evaluate boolean filters over Expense rows."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+
+class QueryError(ValueError):
+    """Raised when a search query is malformed."""
+
+
+_OPERATORS = {"AND": "AND", "OR": "OR", "NOT": "NOT"}
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    tokens: list[tuple[str, str]] = []
+    i, n = 0, len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end < 0:
+                raise QueryError("閉じていない引用符があります")
+            body = q[i + 1 : end]
+            if body == "":
+                raise QueryError("空の引用符は使えません")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            j = i
+            while j < n and not (q[j].isspace() or q[j] in '()"'):
+                j += 1
+            word = q[i:j]
+            i = j
+            if word in _OPERATORS:
+                tokens.append((_OPERATORS[word], word))
+            elif word.startswith("cat:"):
+                value = word[len("cat:") :]
+                if value == "":
+                    raise QueryError("cat: の後ろが空です")
+                tokens.append(("CAT", value))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+@dataclass(frozen=True)
+class _Term:
+    value: str
+
+
+@dataclass(frozen=True)
+class _Cat:
+    value: str
+
+
+@dataclass(frozen=True)
+class _Not:
+    operand: _Node
+
+
+@dataclass(frozen=True)
+class _And:
+    parts: list[_Node]
+
+
+@dataclass(frozen=True)
+class _Or:
+    parts: list[_Node]
+
+
+_Node = _Term | _Cat | _Not | _And | _Or
+
+_NOT_START = ("NOT", "TERM", "CAT", "LPAREN")
+
+
+class _Parser:
+    def __init__(self, tokens: list[tuple[str, str]]) -> None:
+        self.tokens = tokens
+        self.pos = 0
+
+    def _peek(self) -> str | None:
+        return self.tokens[self.pos][0] if self.pos < len(self.tokens) else None
+
+    def _take(self) -> tuple[str, str]:
+        tok = self.tokens[self.pos]
+        self.pos += 1
+        return tok
+
+    def parse(self) -> _Node:
+        if not self.tokens:
+            raise QueryError("クエリが空です")
+        node = self._or_expr()
+        if self.pos != len(self.tokens):
+            raise QueryError("余分なトークンがあります")
+        return node
+
+    def _or_expr(self) -> _Node:
+        parts = [self._and_expr()]
+        while self._peek() == "OR":
+            self._take()
+            parts.append(self._and_expr())
+        return parts[0] if len(parts) == 1 else _Or(parts)
+
+    def _and_expr(self) -> _Node:
+        parts = [self._not_expr()]
+        while True:
+            kind = self._peek()
+            if kind == "AND":
+                self._take()
+                parts.append(self._not_expr())
+            elif kind in _NOT_START:
+                parts.append(self._not_expr())
+            else:
+                break
+        return parts[0] if len(parts) == 1 else _And(parts)
+
+    def _not_expr(self) -> _Node:
+        if self._peek() == "NOT":
+            self._take()
+            return _Not(self._not_expr())
+        return self._primary()
+
+    def _primary(self) -> _Node:
+        kind = self._peek()
+        if kind == "TERM":
+            return _Term(self._take()[1])
+        if kind == "CAT":
+            return _Cat(self._take()[1])
+        if kind == "LPAREN":
+            self._take()
+            node = self._or_expr()
+            if self._peek() != "RPAREN":
+                raise QueryError("閉じ括弧がありません")
+            self._take()
+            return node
+        if kind is None:
+            raise QueryError("項がありません")
+        raise QueryError(f"想定外のトークンです: {kind}")
+
+
+def _parse(q: str) -> _Node:
+    return _Parser(tokenize(q)).parse()
+
+
+def _eval(node: _Node, e: Expense) -> bool:
+    if isinstance(node, _Term):
+        needle = node.value.casefold()
+        return needle in e.memo.casefold() or needle in e.category.casefold()
+    if isinstance(node, _Cat):
+        return node.value.casefold() == e.category.casefold()
+    if isinstance(node, _Not):
+        return not _eval(node.operand, e)
+    if isinstance(node, _And):
+        return all(_eval(p, e) for p in node.parts)
+    return any(_eval(p, e) for p in node.parts)
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _eval(_parse(q), e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    node = _parse(q)
+    return [e for e in rows if _eval(node, e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..5cf3939
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,73 @@
+"""Detect recurring expenses (same category and amount at roughly monthly intervals)."""
+
+from __future__ import annotations
+
+import calendar
+import itertools
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day in the next month, clamped to that month's last day."""
+    year, month = d.year, d.month + 1
+    if month > 12:
+        year, month = year + 1, 1
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError("min_count は 2 以上である必要があります")
+    if tolerance < 0:
+        raise ValueError("tolerance は 0 以上である必要があります")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    result: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        days = sorted(day_set)
+        run: list[date] = [days[0]]
+        for prev, cur in itertools.pairwise(days):
+            if abs((cur - add_month(prev)).days) <= tolerance:
+                run.append(cur)
+            else:
+                _keep_run(result, category, amount, run, min_count)
+                run = [cur]
+        _keep_run(result, category, amount, run, min_count)
+
+    result.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return result
+
+
+def _keep_run(
+    out: list[Recurring],
+    category: str,
+    amount: int,
+    run: list[date],
+    min_count: int,
+) -> None:
+    if len(run) >= min_count:
+        out.append(
+            Recurring(
+                category=category,
+                amount=amount,
+                days=tuple(run),
+                next_expected=add_month(run[-1]),
+            )
+        )
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..735011e
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,216 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+HEADER = "利用日,分類,利用金額,利用店名,カード\n"
+
+
+# --- parse_amount -----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥0", 0),
+        ("1,234円", 1234),
+        ("1,", 1),  # カンマの位置は検査しない
+        ("-￥5", -5),
+    ],
+)
+def test_parse_amount_accepts(text, expected):
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "   ",
+        "円",
+        "12.5",
+        "1 200",
+        "--5",
+        "¥-5",
+        "１２３",
+        "-",
+        "¥",
+        ",1",
+        "5円円",
+        "1円¥",
+        "abc",
+    ],
+)
+def test_parse_amount_rejects(text):
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+# --- parse_date -------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/12/31 ", date(2026, 12, 31)),
+        ("2024/02/29", date(2024, 2, 29)),
+        ("2026-1-5", date(2026, 1, 5)),
+    ],
+)
+def test_parse_date_accepts(text, expected):
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "2026/1-5",
+        "2026-1/5",
+        "26/1/5",
+        "2026/02/30",
+        "2026/02/29",
+        "2026/1/5/",
+        "2026.1.5",
+        "２０２６/1/5",
+        "2026/001/5",
+        "2026//5",
+        "2026/13/1",
+        "2026/0/1",
+    ],
+)
+def test_parse_date_rejects(text):
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+# --- import_rows ------------------------------------------------------------
+
+
+def test_default_mapping_reads_columns_by_name_and_ignores_extra_columns():
+    text = (
+        'カード,利用店名,利用金額,分類,利用日\nVISA,スーパー,"1,200",食費,2026/11/3\n'
+    )
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 11, 3), "食費", 1200, "スーパー")]
+
+
+def test_default_mapping_constant_names():
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_quoted_comma_in_value_is_kept_together():
+    text = HEADER + '2026/1/5,"食費, 外食",980,"A店, 本店",x\n'
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費, 外食", 980, "A店, 本店")]
+
+
+def test_output_keeps_input_order():
+    text = HEADER + "2026/1/5,b,1,\n2026/1/6,a,2,\n2026/1/7,c,3,\n"
+    rows, _ = import_rows(text)
+    assert [r.category for r in rows] == ["b", "a", "c"]
+
+
+def test_blank_lines_are_skipped_but_counted_in_line_numbers():
+    text = HEADER + "\n2026/1/5,food,1,\n\nbad,food,1,\n"
+    rows, errors = import_rows(text)
+    assert [r.amount for r in rows] == [1]
+    assert errors == [(5, "date")]
+
+
+def test_multiline_quoted_field_still_counts_physical_lines():
+    text = HEADER + '2026/1/5,food,1,"a\nb"\nbad,food,1,\n'
+    rows, errors = import_rows(text)
+    assert len(rows) == 1
+    assert errors == [(4, "date")]
+
+
+def test_multiple_errors_in_one_row_recorded_in_order_date_amount_category():
+    text = HEADER + "bad,,abc,\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "date"), (2, "amount"), (2, "category")]
+
+
+def test_row_with_error_is_excluded_and_others_kept():
+    text = HEADER + "2026/1/5,food,1,\n2026/1/6,food,x,\n2026/1/7,rent,3,\n"
+    rows, errors = import_rows(text)
+    assert [r.day for r in rows] == [date(2026, 1, 5), date(2026, 1, 7)]
+    assert errors == [(3, "amount")]
+
+
+def test_missing_trailing_columns_are_treated_as_empty():
+    text = "利用日,分類,利用金額,利用店名,カード\n2026/1/5,food,100\n"
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "food", 100, "")]
+    assert errors == []
+
+    text = "利用日,分類,利用金額,利用店名,カード\n2026/1/5\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "amount"), (2, "category")]
+
+
+def test_blank_or_whitespace_category_is_an_error():
+    text = HEADER + "2026/1/5,   ,100,\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "category")]
+
+
+def test_category_and_memo_are_stripped():
+    text = HEADER + "2026/1/5,  food  ,100,  memo  \n"
+    rows, _ = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "food", 100, "memo")]
+
+
+def test_category_map_replaces_stripped_category_only_when_key_exists():
+    text = HEADER + "2026/1/5, 食料品 ,100,\n2026/1/6,rent,200,\n"
+    rows, _ = import_rows(text, category_map={"食料品": "food"})
+    assert [r.category for r in rows] == ["food", "rent"]
+
+
+def test_custom_mapping_and_memo_optional():
+    text = "d,c,a,x\n2026-01-05,food,100,zzz\n"
+    rows, errors = import_rows(
+        text, mapping={"date": "d", "category": "c", "amount": "a"}
+    )
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "food", 100, "")]
+
+
+def test_empty_text_has_no_header():
+    with pytest.raises(ValueError):
+        import_rows("")
+
+
+@pytest.mark.parametrize("key", ["date", "category", "amount"])
+def test_mapping_missing_required_key_raises(key):
+    mapping = {k: v for k, v in DEFAULT_MAPPING.items() if k != key}
+    with pytest.raises(ValueError):
+        import_rows(HEADER, mapping=mapping)
+
+
+def test_mapping_column_absent_from_header_raises():
+    with pytest.raises(ValueError):
+        import_rows("利用日,分類,利用金額\n", mapping=DEFAULT_MAPPING)
+
+
+def test_memo_mapping_column_absent_from_header_raises():
+    with pytest.raises(ValueError):
+        import_rows("利用日,分類,利用金額\n", mapping={**DEFAULT_MAPPING})
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..bb2fdf1
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,160 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def E(y: int, m: int, cat: str, amount: int) -> Expense:
+    return Expense(date(y, m, 1), cat, amount)
+
+
+ROWS = [
+    E(2026, 10, "food", 1000),
+    E(2026, 10, "rent", 80000),
+    E(2026, 10, "fun", 500),
+    E(2026, 11, "food", 1300),
+    E(2026, 11, "rent", 80000),
+    E(2026, 11, "misc", 200),
+    E(2026, 9, "food", 99999),  # other month: ignored
+]
+
+
+def test_month_diff_basic_statuses_and_order():
+    got = month_diff(ROWS, "2026-10", "2026-11")
+    assert got == [
+        DiffRow("fun", 500, 0, -500, -100.0, "gone"),
+        DiffRow("food", 1000, 1300, 300, 30.0, "up"),
+        DiffRow("misc", 0, 200, 200, None, "new"),
+        DiffRow("rent", 80000, 80000, 0, 0.0, "same"),
+    ]
+
+
+def test_ties_sorted_by_category_and_down_status():
+    # a: +100 (up), b: -100 (gone): equal abs(delta) -> category ascending
+    rows = [E(2026, 10, "b", 100), E(2026, 10, "a", 100), E(2026, 11, "a", 200)]
+    got = month_diff(rows, "2026-10", "2026-11")
+    assert [(r.category, r.status) for r in got] == [("a", "up"), ("b", "gone")]
+    assert got[0].pct == 100.0
+    # abs(delta) is the primary key: -100 sorts before -50
+    rows2 = [E(2026, 10, "a", 50), E(2026, 10, "b", 100)]
+    rows2.append(E(2026, 11, "a", 1))  # a: 50 -> 1 (delta -49)
+    got2 = month_diff(rows2, "2026-10", "2026-11")
+    assert [r.category for r in got2] == ["b", "a"]
+    assert got2[1].status == "down"
+
+
+def test_presence_decides_status_not_sum():
+    # prev has food entries summing to 0: present, so not "new"; prev==0 -> pct None
+    rows = [
+        E(2026, 10, "food", 100),
+        E(2026, 10, "food", -100),
+        E(2026, 11, "food", 500),
+    ]
+    (row,) = month_diff(rows, "2026-10", "2026-11")
+    assert (row.prev, row.curr, row.delta) == (0, 500, 500)
+    assert row.pct is None
+    assert row.status == "up"
+
+
+def test_same_month_is_all_same():
+    got = month_diff(ROWS, "2026-11", "2026-11")
+    assert {r.status for r in got} == {"same"}
+    assert all(r.delta == 0 and r.pct == 0.0 for r in got)
+
+
+def test_tiny_negative_change_pct_is_not_negative_zero():
+    rows = [E(2026, 10, "x", 1_000_000), E(2026, 11, "x", 999_999)]
+    (row,) = month_diff(rows, "2026-10", "2026-11")
+    assert row.pct == 0.0 and str(row.pct) == "0.0"
+
+
+def test_no_rows_empty():
+    assert month_diff([], "2026-10", "2026-11") == []
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        "2026-1",
+        "2026-13",
+        "2026-00",
+        "2026/11",
+        " 2026-11",
+        "2026-11\n",
+        "２０２６-11",
+        "",
+    ],
+)
+def test_bad_month_format_raises(bad):
+    with pytest.raises(ValueError):
+        month_diff(ROWS, bad, "2026-11")
+    with pytest.raises(ValueError):
+        month_diff(ROWS, "2026-10", bad)
+
+
+def test_top_movers_excludes_same_keeps_order_and_limits():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    assert [r.category for r in top_movers(diffs)] == ["fun", "food", "misc"]
+    assert [r.category for r in top_movers(diffs, 1)] == ["fun"]
+    assert top_movers(diffs, 0) == []
+    assert [r.category for r in top_movers(diffs, 99)] == ["fun", "food", "misc"]
+
+
+def test_top_movers_negative_n_raises():
+    with pytest.raises(ValueError):
+        top_movers([], -1)
+
+
+def test_render_diff_format():
+    diffs = [
+        DiffRow("fun", 500, 0, -500, -100.0, "gone"),
+        DiffRow("food", 1000, 1300, 300, 30.0, "up"),
+        DiffRow("misc", 0, 200, 200, None, "new"),
+        DiffRow("rent", 80000, 80000, 0, 0.0, "same"),
+        DiffRow("x", 2000, 0, -2000, -100.0, "gone"),
+    ]
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "fun\t500\t0\t-500\t-100.0%\n"
+        "food\t1000\t1300\t+300\t+30.0%\n"
+        "misc\t0\t200\t+200\t-\n"
+        "rent\t80000\t80000\t+0\t+0.0%\n"
+        "x\t2000\t0\t-2000\t-100.0%"
+    )
+    assert not render_diff(diffs).endswith("\n")
+
+
+def test_render_diff_empty_is_header_only():
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_available_months_sorted_unique():
+    rows = [
+        E(2026, 11, "a", 1),
+        E(2026, 9, "a", 1),
+        E(2026, 11, "b", 1),
+        E(2025, 12, "a", 1),
+    ]
+    assert available_months(rows) == ["2025-12", "2026-09", "2026-11"]
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months():
+    rows = [E(2026, 9, "a", 100), E(2026, 10, "a", 200), E(2026, 11, "a", 100)]
+    (row,) = latest_diff(rows)
+    assert (row.prev, row.curr, row.status) == (200, 100, "down")
+
+
+@pytest.mark.parametrize("rows", [[], [E(2026, 11, "a", 1), E(2026, 11, "b", 2)]])
+def test_latest_diff_needs_two_months(rows):
+    with pytest.raises(ValueError):
+        latest_diff(rows)
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..c086d47
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,254 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def ex(category: str, memo: str = "", amount: int = 100, day: int = 1) -> Expense:
+    return Expense(day=date(2026, 1, day), category=category, amount=amount, memo=memo)
+
+
+# --- tokenize -------------------------------------------------------------
+
+
+def test_tokenize_whitespace_only_gives_no_tokens() -> None:
+    assert tokenize("   \t ") == []
+
+
+def test_tokenize_empty_string_gives_no_tokens() -> None:
+    assert tokenize("") == []
+
+
+def test_tokenize_parens() -> None:
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+
+
+def test_tokenize_quoted_keeps_spaces_and_parens() -> None:
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+
+
+def test_tokenize_quoted_has_no_escape_and_ends_at_next_quote() -> None:
+    assert tokenize('"a"b') == [("TERM", "a"), ("TERM", "b")]
+
+
+def test_tokenize_unclosed_quote_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_quoted_operator_word_is_term() -> None:
+    assert tokenize('"AND"') == [("TERM", "AND")]
+
+
+def test_tokenize_uppercase_operators() -> None:
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+
+
+def test_tokenize_lowercase_or_longer_words_are_terms() -> None:
+    assert tokenize("and ANDx or not") == [
+        ("TERM", "and"),
+        ("TERM", "ANDx"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_word_stops_at_paren_and_quote() -> None:
+    assert tokenize('ab(cd)"ef"') == [
+        ("TERM", "ab"),
+        ("LPAREN", "("),
+        ("TERM", "cd"),
+        ("RPAREN", ")"),
+        ("TERM", "ef"),
+    ]
+
+
+def test_tokenize_cat_prefix() -> None:
+    assert tokenize("cat:食費") == [("CAT", "食費")]
+
+
+def test_tokenize_cat_keeps_rest_of_word_including_colons() -> None:
+    assert tokenize("cat:a:b") == [("CAT", "a:b")]
+
+
+def test_tokenize_cat_with_empty_value_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_tokenize_cat_then_space_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize("cat: 食費")
+
+
+def test_tokenize_cat_prefix_is_case_sensitive() -> None:
+    assert tokenize("CAT:x") == [("TERM", "CAT:x")]
+
+
+# --- grammar errors --------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "()",
+        "(",
+        ")",
+        "a)",
+        "(a",
+        "NOT",
+        "a OR",
+        "OR a",
+        "a AND",
+        "AND a",
+        "a AND AND b",
+        "a OR OR b",
+        "a OR AND b",
+        "NOT AND a",
+        "a ()",
+        "( )",
+    ],
+)
+def test_grammar_errors(q: str) -> None:
+    with pytest.raises(QueryError):
+        filter_rows(q, [])
+
+
+def test_empty_query_is_error_even_with_rows() -> None:
+    with pytest.raises(QueryError):
+        filter_rows("   ", [ex("食費")])
+
+
+def test_invalid_query_is_error_with_empty_rows() -> None:
+    with pytest.raises(QueryError):
+        filter_rows("a OR", [])
+
+
+# --- grammar valid ---------------------------------------------------------
+
+
+def test_double_not_is_valid() -> None:
+    assert matches("NOT NOT food", ex("食費", "food")) is True
+    assert matches("NOT NOT food", ex("食費", "other")) is False
+
+
+def test_and_omitted_equals_explicit_and() -> None:
+    rows = [ex("食費", "lunch"), ex("食費", "dinner"), ex("交通", "lunch")]
+    assert filter_rows("lunch 食費", rows) == filter_rows("lunch AND 食費", rows)
+    assert filter_rows("lunch 食費", rows) == [rows[0]]
+
+
+def test_or_binds_looser_than_and() -> None:
+    # a OR (b AND c)
+    rows = [ex("x", "a"), ex("x", "b"), ex("x", "c"), ex("x", "b c")]
+    assert filter_rows("a OR b c", rows) == [rows[0], rows[3]]
+
+
+def test_not_binds_tighter_than_and() -> None:
+    # (NOT a) AND b
+    rows = [ex("x", "a b"), ex("x", "b"), ex("x", "c b")]
+    assert filter_rows("NOT a b", rows) == [rows[1], rows[2]]
+
+
+def test_not_binds_tighter_than_or() -> None:
+    # (NOT a) OR b
+    rows = [ex("x", "a"), ex("x", "b"), ex("x", "c")]
+    assert filter_rows("NOT a OR b", rows) == [rows[1], rows[2]]
+
+
+def test_parens_override_precedence() -> None:
+    # (a OR b) AND c
+    rows = [ex("x", "a"), ex("x", "a c"), ex("x", "b c"), ex("x", "b")]
+    assert filter_rows("(a OR b) c", rows) == [rows[1], rows[2]]
+
+
+def test_nested_parens() -> None:
+    rows = [ex("x", "a"), ex("x", "a b"), ex("x", "c")]
+    assert filter_rows("((a))", rows) == [rows[0], rows[1]]
+
+
+# --- evaluation ------------------------------------------------------------
+
+
+def test_term_matches_memo_substring() -> None:
+    assert matches("lun", ex("食費", "lunch")) is True
+
+
+def test_term_matches_category_substring() -> None:
+    assert matches("食", ex("食費", "")) is True
+
+
+def test_term_does_not_match_amount_or_date() -> None:
+    assert matches("300", ex("食費", "x", amount=300)) is False
+    assert matches("2026", ex("食費", "x")) is False
+
+
+def test_term_is_case_insensitive() -> None:
+    assert matches("LUNCH", ex("食費", "lunch")) is True
+    assert matches("lunch", ex("食費", "LUNCH")) is True
+
+
+def test_term_casefold_handles_non_ascii_case() -> None:
+    # casefold: ß matches ss
+    assert matches("STRASSE", ex("x", "straße")) is True
+
+
+def test_cat_requires_exact_category() -> None:
+    assert matches("cat:食費", ex("食費", "lunch")) is True
+    assert matches("cat:食", ex("食費", "lunch")) is False
+
+
+def test_cat_does_not_match_memo() -> None:
+    assert matches("cat:lunch", ex("食費", "lunch")) is False
+
+
+def test_cat_is_case_insensitive() -> None:
+    assert matches("cat:FOOD", ex("food")) is True
+
+
+def test_quoted_term_with_space_matches_memo() -> None:
+    assert matches('"ice cream"', ex("食費", "Ice Cream")) is True
+    assert matches('"ice cream"', ex("食費", "ice  cream")) is False
+
+
+def test_not_term() -> None:
+    assert matches("NOT lunch", ex("食費", "dinner")) is True
+    assert matches("NOT lunch", ex("食費", "lunch")) is False
+
+
+def test_or_and_not_combined() -> None:
+    rows = [ex("食費", "lunch"), ex("交通", "bus"), ex("娯楽", "movie")]
+    assert filter_rows("cat:食費 OR bus", rows) == [rows[0], rows[1]]
+    assert filter_rows("NOT cat:食費 AND NOT bus", rows) == [rows[2]]
+
+
+# --- filter_rows -----------------------------------------------------------
+
+
+def test_filter_rows_keeps_input_order() -> None:
+    rows = [ex("食費", "b", day=3), ex("食費", "a", day=1), ex("食費", "a", day=2)]
+    assert filter_rows("a", rows) == [rows[1], rows[2]]
+
+
+def test_filter_rows_no_match_is_empty_list() -> None:
+    assert filter_rows("zzz", [ex("食費", "lunch")]) == []
+
+
+def test_filter_rows_empty_rows_valid_query() -> None:
+    assert filter_rows("a", []) == []
+
+
+def test_filter_rows_does_not_mutate_input() -> None:
+    rows = [ex("食費", "a"), ex("食費", "b")]
+    snapshot = list(rows)
+    filter_rows("a", rows)
+    assert rows == snapshot
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..1b8ec22
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,173 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def ex(
+    day: date, category: str = "subscription", amount: int = 1000, memo: str = ""
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- add_month -------------------------------------------------------------
+
+
+def test_add_month_plain_day() -> None:
+    assert add_month(date(2026, 12, 15)) == date(2027, 1, 15)
+    assert add_month(date(2026, 3, 9)) == date(2026, 4, 9)
+
+
+def test_add_month_clamps_to_end_of_short_month() -> None:
+    assert add_month(date(2026, 1, 31)) == date(2026, 2, 28)
+
+
+def test_add_month_clamps_to_leap_february() -> None:
+    assert add_month(date(2024, 1, 31)) == date(2024, 2, 29)
+
+
+def test_add_month_30th_to_february() -> None:
+    assert add_month(date(2026, 4, 30)) == date(2026, 5, 30)
+    assert add_month(date(2026, 3, 30)) == date(2026, 4, 30)
+
+
+def test_add_month_from_leap_day() -> None:
+    assert add_month(date(2024, 2, 29)) == date(2024, 3, 29)
+
+
+# --- validation ------------------------------------------------------------
+
+
+def test_min_count_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+
+
+def test_negative_tolerance_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_empty_input_returns_empty() -> None:
+    assert find_recurring([]) == []
+
+
+# --- detection -------------------------------------------------------------
+
+
+def test_monthly_series_detected_with_next_expected() -> None:
+    rows = [ex(date(2026, 1, 5)), ex(date(2026, 2, 5)), ex(date(2026, 3, 5))]
+    assert find_recurring(rows, tolerance=0) == [
+        Recurring(
+            category="subscription",
+            amount=1000,
+            days=(date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+            next_expected=date(2026, 4, 5),
+        )
+    ]
+
+
+def test_run_shorter_than_min_count_is_dropped() -> None:
+    rows = [ex(date(2026, 1, 5)), ex(date(2026, 2, 5))]
+    assert find_recurring(rows, min_count=3) == []
+    assert len(find_recurring(rows, min_count=2)) == 1
+
+
+def test_tolerance_connects_drifted_dates() -> None:
+    # 02-08 is 3 days after the expected 02-05; 03-05 is 3 days before expected 03-08.
+    rows = [ex(date(2026, 1, 5)), ex(date(2026, 2, 8)), ex(date(2026, 3, 5))]
+    result = find_recurring(rows, tolerance=3)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 8), date(2026, 3, 5))
+
+
+def test_drift_beyond_tolerance_breaks_run() -> None:
+    rows = [ex(date(2026, 1, 5)), ex(date(2026, 2, 8)), ex(date(2026, 3, 5))]
+    assert find_recurring(rows, tolerance=2) == []
+
+
+def test_run_is_split_at_break_and_only_qualifying_part_kept() -> None:
+    # 04-05 is missing, so 05-05 starts a new run of length 1.
+    rows = [
+        ex(date(2026, 1, 5)),
+        ex(date(2026, 2, 5)),
+        ex(date(2026, 3, 5)),
+        ex(date(2026, 5, 5)),
+    ]
+    result = find_recurring(rows, min_count=3, tolerance=0)
+    assert result == [
+        Recurring(
+            category="subscription",
+            amount=1000,
+            days=(date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+            next_expected=date(2026, 4, 5),
+        )
+    ]
+
+
+def test_same_day_duplicates_count_once() -> None:
+    rows = [ex(date(2026, 1, 5)), ex(date(2026, 1, 5)), ex(date(2026, 2, 5))]
+    assert find_recurring(rows, min_count=3) == []
+    result = find_recurring(rows, min_count=2)
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5))
+
+
+def test_input_order_does_not_matter() -> None:
+    rows = [ex(date(2026, 3, 5)), ex(date(2026, 1, 5)), ex(date(2026, 2, 5))]
+    result = find_recurring(rows, tolerance=0)
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_memo_is_ignored_for_grouping() -> None:
+    rows = [
+        ex(date(2026, 1, 5), memo="a"),
+        ex(date(2026, 2, 5), memo="b"),
+        ex(date(2026, 3, 5), memo=""),
+    ]
+    assert len(find_recurring(rows, tolerance=0)) == 1
+
+
+def test_different_amount_is_separate_group() -> None:
+    rows = [
+        ex(date(2026, 1, 5), amount=1000),
+        ex(date(2026, 2, 5), amount=1000),
+        ex(date(2026, 3, 5), amount=1500),
+    ]
+    assert find_recurring(rows, min_count=3, tolerance=0) == []
+
+
+def test_different_category_is_separate_group() -> None:
+    rows = [
+        ex(date(2026, 1, 5), category="a"),
+        ex(date(2026, 2, 5), category="b"),
+        ex(date(2026, 3, 5), category="a"),
+    ]
+    assert find_recurring(rows, min_count=3, tolerance=0) == []
