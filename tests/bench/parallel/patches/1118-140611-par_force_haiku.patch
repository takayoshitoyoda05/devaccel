+def test_results_sorted_by_category_then_amount_then_first_day() -> None:
+    rows: list[Expense] = []
+    # 住居 / 5000 : Jan-Mar
+    rows += [E(date(2026, m, 1), category="住居", amount=5000) for m in (1, 2, 3)]
+    # 食費 / 2000 : Jan-Mar
+    rows += [E(date(2026, m, 5), category="食費", amount=2000) for m in (1, 2, 3)]
+    # 食費 / 1000 : Jun-Aug
+    rows += [E(date(2026, m, 5), category="食費", amount=1000) for m in (6, 7, 8)]
+    # 食費 / 1000 : Jan-Mar, different day -> later first day than the Jun-Aug one
+    rows += [E(date(2026, m, 20), category="食費", amount=1000) for m in (1, 2, 3)]
+
+    result = find_recurring(rows)
+    keys = [(r.category, r.amount, r.days[0]) for r in result]
+    assert keys == [
+        ("住居", 5000, date(2026, 1, 1)),
+        ("食費", 1000, date(2026, 1, 20)),
+        ("食費", 1000, date(2026, 6, 5)),
+        ("食費", 2000, date(2026, 1, 5)),
+    ]
