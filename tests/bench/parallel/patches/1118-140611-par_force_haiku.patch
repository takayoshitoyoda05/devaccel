index 0000000..dfe727f
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,117 @@
+"""Import expense rows from a bank CSV export."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+# 任意の "-" / 任意の "¥" か "￥" 1 文字 / ASCII 数字で始まる数字とカンマの列 / 任意の "円"
+_AMOUNT_RE = re.compile(r"(-?)([¥￥]?)([0-9][0-9,]*)(円?)")
+
+# YYYY/M/D または YYYY-M-D(区切りは同じものを使う)
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    """Parse a bank amount string such as "￥1,234" or "-300円" into yen."""
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    sign, _currency, digits, _suffix = m.groups()
+    value = int(digits.replace(",", ""))
+    return -value if sign else value
+
+
+def parse_date(s: str) -> date:
+    """Parse "YYYY/M/D" or "YYYY-M-D" into a date."""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    year, _sep, month, day = m.groups()
+    try:
+        return date(int(year), int(month), int(day))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Convert a CSV text (header on line 1) into expenses.
+
+    Returns (valid expenses in input order, [(physical line number, field name)]).
+    """
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text))
+    header = next(reader, None)
+    if header is None:
+        raise ValueError("ヘッダー行がありません")
+    index = {name: i for i, name in enumerate(header)}
+    for column in mapping.values():
+        if column not in index:
+            raise ValueError(f"列 {column} がヘッダーにありません")
+
+    date_idx = index[mapping["date"]]
+    cat_idx = index[mapping["category"]]
+    amt_idx = index[mapping["amount"]]
+    memo_idx = index[mapping["memo"]] if "memo" in mapping else None
+    categories = category_map or {}
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    prev_line = reader.line_num
+    for row in reader:
+        lineno = prev_line + 1
+        prev_line = reader.line_num
+        if not row:
+            continue  # 空行は読み飛ばす(行番号は数える)
+
+        # 列が足りない行の欠けた値は空文字列として扱う
+        padded = row + [""] * (len(header) - len(row))
+        row_errors: list[tuple[int, str]] = []
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(padded[date_idx])
+        except ValueError:
+            row_errors.append((lineno, "date"))
+        try:
+            amount = parse_amount(padded[amt_idx])
+        except ValueError:
+            row_errors.append((lineno, "amount"))
+        category = padded[cat_idx].strip()
+        if category == "":
+            row_errors.append((lineno, "category"))
+
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        assert day is not None and amount is not None
+        memo = padded[memo_idx].strip() if memo_idx is not None else ""
+        expenses.append(
+            Expense(
+                day=day,
+                category=categories.get(category, category),
+                amount=amount,
+                memo=memo,
+            )
+        )
+    return expenses, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
new file mode 100644
index 0000000..0ff9f7e
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,91 @@
+"""Month-over-month expense comparison."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def _month_of(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+
+    prev_sum: dict[str, int] = {}
+    curr_sum: dict[str, int] = {}
+    for e in rows:
+        m = _month_of(e)
+        if m == prev_month:
+            prev_sum[e.category] = prev_sum.get(e.category, 0) + e.amount
+        elif m == curr_month:
+            curr_sum[e.category] = curr_sum.get(e.category, 0) + e.amount
+
+    out: list[DiffRow] = []
+    for cat in set(prev_sum) | set(curr_sum):
+        has_prev = cat in prev_sum
+        has_curr = cat in curr_sum
+        prev = prev_sum.get(cat, 0)
+        curr = curr_sum.get(cat, 0)
+        delta = curr - prev
+        pct = None if prev == 0 else round(delta / prev * 100, 1) + 0.0
+        if not has_prev:
+            status = "new"
+        elif not has_curr:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+
+    out.sort(key=lambda d: (-abs(d.delta), d.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [d for d in diffs if d.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for d in diffs:
+        pct = "-" if d.pct is None else f"{d.pct:+.1f}%"
+        lines.append(f"{d.category}\t{d.prev}\t{d.curr}\t{d.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month_of(e) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には明細のある月が 2 つ以上必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..3a5e72c
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,178 @@
+"""Search query language for expenses.
+
+Grammar (lowest precedence first):
+    or_expr  := and_expr ("OR" and_expr)*
+    and_expr := not_expr (["AND"] not_expr)*
+    not_expr := "NOT" not_expr | primary
+    primary  := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+
+from kakeibo.core import Expense
+
+Token = tuple[str, str]
+Predicate = Callable[[Expense], bool]
+
+_SPECIAL = ' \t\r\n()"'
+
+
+class QueryError(ValueError):
+    """Raised when a search query is malformed."""
+
+
+def _read_word(q: str, i: int) -> int:
+    j = i
+    while j < len(q) and q[j] not in _SPECIAL:
+        j += 1
+    return j
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    """Split a query into (kind, value) tokens."""
+    tokens: list[Token] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        ch = q[i]
+        if ch.isspace():
+            i += 1
+        elif ch == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif ch == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif ch == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError("引用符が閉じていません")
+            content = q[i + 1 : end]
+            if content == "":
+                raise QueryError("空の引用は使えません")
+            tokens.append(("TERM", content))
+            i = end + 1
+        else:
+            j = _read_word(q, i)
+            word = q[i:j]
+            i = j
+            if word == "AND":
+                tokens.append(("AND", "AND"))
+            elif word == "OR":
+                tokens.append(("OR", "OR"))
+            elif word == "NOT":
+                tokens.append(("NOT", "NOT"))
+            elif word.startswith("cat:"):
+                value = word[len("cat:") :]
+                if value == "":
+                    raise QueryError("cat: の後ろが空です")
+                tokens.append(("CAT", value))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self._tokens = tokens
+        self._pos = 0
+
+    def _peek_kind(self) -> str | None:
+        if self._pos < len(self._tokens):
+            return self._tokens[self._pos][0]
+        return None
+
+    def _next(self) -> Token:
+        tok = self._tokens[self._pos]
+        self._pos += 1
+        return tok
+
+    def parse(self) -> Predicate:
+        if not self._tokens:
+            raise QueryError("検索条件が空です")
+        pred = self._or_expr()
+        if self._pos != len(self._tokens):
+            raise QueryError(f"予期しないトークンです: {self._tokens[self._pos][1]!r}")
+        return pred
+
+    def _or_expr(self) -> Predicate:
+        left = self._and_expr()
+        while self._peek_kind() == "OR":
+            self._next()
+            right = self._and_expr()
+            left = _or(left, right)
+        return left
+
+    def _and_expr(self) -> Predicate:
+        left = self._not_expr()
+        while True:
+            kind = self._peek_kind()
+            if kind == "AND":
+                self._next()
+                left = _and(left, self._not_expr())
+            elif kind in ("TERM", "CAT", "NOT", "LPAREN"):
+                left = _and(left, self._not_expr())
+            else:
+                return left
+
+    def _not_expr(self) -> Predicate:
+        if self._peek_kind() == "NOT":
+            self._next()
+            return _not(self._not_expr())
+        return self._primary()
+
+    def _primary(self) -> Predicate:
+        kind = self._peek_kind()
+        if kind == "TERM":
+            return _term(self._next()[1])
+        if kind == "CAT":
+            return _cat(self._next()[1])
+        if kind == "LPAREN":
+            self._next()
+            inner = self._or_expr()
+            if self._peek_kind() != "RPAREN":
+                raise QueryError("括弧が閉じていません")
+            self._next()
+            return inner
+        if kind is None:
+            raise QueryError("項がありません")
+        raise QueryError(f"項が必要です: {self._tokens[self._pos][1]!r}")
+
+
+def _or(a: Predicate, b: Predicate) -> Predicate:
+    return lambda e: a(e) or b(e)
+
+
+def _and(a: Predicate, b: Predicate) -> Predicate:
+    return lambda e: a(e) and b(e)
+
+
+def _not(a: Predicate) -> Predicate:
+    return lambda e: not a(e)
+
+
+def _term(value: str) -> Predicate:
+    needle = value.casefold()
+    return lambda e: needle in e.memo.casefold() or needle in e.category.casefold()
+
+
+def _cat(value: str) -> Predicate:
+    needle = value.casefold()
+    return lambda e: e.category.casefold() == needle
+
+
+def _compile(q: str) -> Predicate:
+    return _Parser(tokenize(q)).parse()
+
+
+def matches(q: str, e: Expense) -> bool:
+    """Return True if the expense satisfies the query."""
+    return _compile(q)(e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    """Return the expenses matching the query, in input order."""
+    pred = _compile(q)
+    return [e for e in rows if pred(e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..8d51029
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,71 @@
+"""Detect recurring expenses (same category and amount at a roughly monthly cadence)."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day in the next month, clamped to that month's last day."""
+    year, month = (d.year + 1, 1) if d.month == 12 else (d.year, d.month + 1)
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def _runs(days: list[date], tolerance: int) -> list[list[date]]:
+    """Split sorted unique dates into maximal runs where neighbours are monthly-linked."""
+    runs: list[list[date]] = []
+    for d in days:
+        if runs:
+            prev = runs[-1][-1]
+            if abs((d - add_month(prev)).days) <= tolerance:
+                runs[-1].append(d)
+                continue
+        runs.append([d])
+    return runs
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    """Find (category, amount) groups whose dates recur monthly.
+
+    A run of at least ``min_count`` dates, where each date is within ``tolerance``
+    days of the month after its predecessor, yields one ``Recurring``.
+    """
+    if min_count < 2:
+        raise ValueError(f"min_count は 2 以上である必要があります: {min_count}")
+    if tolerance < 0:
+        raise ValueError(f"tolerance は 0 以上である必要があります: {tolerance}")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    found: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        for run in _runs(sorted(day_set), tolerance):
+            if len(run) >= min_count:
+                found.append(
+                    Recurring(
+                        category=category,
+                        amount=amount,
+                        days=tuple(run),
+                        next_expected=add_month(run[-1]),
+                    )
+                )
+
+    found.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return found
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..8945e6d
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,178 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+HEADER = "利用日,分類,利用金額,利用店名\n"
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥1200", 1200),
+        ("-1,000円", -1000),
+    ],
+)
+def test_parse_amount_accepts(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    ["", "円", "12.5", "1 200", "--5", "¥-5", "１２３", "1円円", ",1", "-", "¥"],
+)
+def test_parse_amount_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/12/31 ", date(2026, 12, 31)),
+        ("2026-1-5", date(2026, 1, 5)),
+    ],
+)
+def test_parse_date_accepts(text: str, expected: date) -> None:
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    ["2026/1-5", "26/1/5", "2026/02/30", "", "2026.1.5", "２０２６/1/5", "2026/13/1"],
+)
+def test_parse_date_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+def test_default_mapping() -> None:
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_import_accepts_valid_rows_in_order() -> None:
+    text = HEADER + '2026/1/5,食費,"￥1,234",  スーパー \n2026-01-06,交通,-300円,\n'
+    expenses, errors = import_rows(text)
+    assert errors == []
+    assert expenses == [
+        Expense(date(2026, 1, 5), "食費", 1234, "スーパー"),
+        Expense(date(2026, 1, 6), "交通", -300, ""),
+    ]
+
+
+def test_quoted_comma_in_value() -> None:
+    text = HEADER + '2026/1/5,食費,980,"A店, 本店"\n'
+    expenses, errors = import_rows(text)
+    assert errors == []
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 980, "A店, 本店")]
+
+
+def test_blank_lines_skipped_but_counted() -> None:
+    text = HEADER + "\n2026/1/5,食費,100,a\n\n2026/x/1,食費,100,b\n"
+    expenses, errors = import_rows(text)
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "a")]
+    assert errors == [(5, "date")]
+
+
+def test_multiple_errors_in_one_row_recorded_in_order() -> None:
+    text = HEADER + "bad,,abc,x\n"
+    expenses, errors = import_rows(text)
+    assert expenses == []
+    assert errors == [(2, "date"), (2, "amount"), (2, "category")]
+
+
+def test_amount_and_category_errors_without_date_error() -> None:
+    text = HEADER + "2026/1/5,   ,12.5,x\n"
+    expenses, errors = import_rows(text)
+    assert expenses == []
+    assert errors == [(2, "amount"), (2, "category")]
+
+
+def test_error_row_excluded_and_others_kept() -> None:
+    text = HEADER + "2026/1/5,食費,100,a\n2026/1/6,,100,b\n2026/1/7,食費,100,c\n"
+    expenses, errors = import_rows(text)
+    assert [e.memo for e in expenses] == ["a", "c"]
+    assert errors == [(3, "category")]
+
+
+def test_missing_trailing_columns_treated_as_empty() -> None:
+    text = HEADER + "2026/1/5,食費\n"
+    expenses, errors = import_rows(text)
+    assert expenses == []
+    assert errors == [(2, "amount")]
+
+
+def test_line_number_is_physical_with_multiline_quoted_field() -> None:
+    text = HEADER + '2026/1/5,食費,100,"line1\nline2"\n2026/x/1,食費,100,b\n'
+    expenses, errors = import_rows(text)
+    assert [e.memo for e in expenses] == ["line1\nline2"]
+    assert errors == [(4, "date")]
+
+
+def test_extra_columns_ignored() -> None:
+    text = "利用日,分類,利用金額,利用店名,備考\n2026/1/5,食費,100,a,zzz\n"
+    expenses, errors = import_rows(text)
+    assert errors == []
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "a")]
+
+
+def test_custom_mapping_with_columns_in_other_order() -> None:
+    text = "店,金額,日,区分\nA店,100,2026/1/5,食費\n"
+    mapping = {"date": "日", "category": "区分", "amount": "金額", "memo": "店"}
+    expenses, errors = import_rows(text, mapping)
+    assert errors == []
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "A店")]
+
+
+def test_memo_optional_in_mapping() -> None:
+    text = "日,区分,金額\n2026/1/5,食費,100\n"
+    mapping = {"date": "日", "category": "区分", "amount": "金額"}
+    expenses, errors = import_rows(text, mapping)
+    assert errors == []
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+@pytest.mark.parametrize("missing", ["date", "category", "amount"])
+def test_mapping_missing_required_key_raises(missing: str) -> None:
+    mapping = {k: v for k, v in DEFAULT_MAPPING.items() if k != missing}
+    with pytest.raises(ValueError):
+        import_rows(HEADER, mapping)
+
+
+def test_mapping_column_absent_from_header_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows(
+            "日,分類,金額\n", {"date": "利用日", "category": "分類", "amount": "金額"}
+        )
+
+
+def test_mapping_memo_column_absent_from_header_raises() -> None:
+    mapping = {**DEFAULT_MAPPING, "memo": "無い列"}
+    with pytest.raises(ValueError):
+        import_rows(HEADER, mapping)
+
+
+def test_category_map_replaces_stripped_category() -> None:
+    text = HEADER + "2026/1/5, 外食 ,100,a\n2026/1/6,交通,200,b\n"
+    expenses, errors = import_rows(text, category_map={"外食": "食費"})
+    assert errors == []
+    assert [e.category for e in expenses] == ["食費", "交通"]
+
+
+def test_category_map_none_keeps_categories() -> None:
+    text = HEADER + "2026/1/5,外食,100,a\n"
+    expenses, _ = import_rows(text, category_map=None)
+    assert expenses[0].category == "外食"
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..97f3c32
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,179 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def ex(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+ROWS = [
+    ex("2026-01-05", "food", 1000),
+    ex("2026-01-20", "food", 500),
+    ex("2026-01-10", "rent", 5000),
+    ex("2026-01-11", "fun", 300),
+    ex("2026-01-12", "zero", 0),
+    ex("2026-02-03", "food", 2000),
+    ex("2026-02-04", "rent", 5000),
+    ex("2026-02-05", "new_cat", 700),
+    ex("2026-02-06", "zero", 0),
+    ex("2026-02-07", "same_cat", 0),
+    ex("2026-01-08", "same_cat", 0),
+]
+
+
+def by_cat(diffs: list[DiffRow]) -> dict[str, DiffRow]:
+    return {d.category: d for d in diffs}
+
+
+def test_statuses_for_all_four_kinds() -> None:
+    d = by_cat(month_diff(ROWS, "2026-01", "2026-02"))
+    assert d["food"] == DiffRow("food", 1500, 2000, 500, 33.3, "up")
+    assert d["rent"].status == "same"
+    assert d["new_cat"] == DiffRow("new_cat", 0, 700, 700, None, "new")
+    assert d["fun"] == DiffRow("fun", 300, 0, -300, -100.0, "gone")
+
+
+def test_down_status() -> None:
+    rows = [ex("2026-01-01", "a", 1000), ex("2026-02-01", "a", 400)]
+    d = month_diff(rows, "2026-01", "2026-02")
+    assert d == [DiffRow("a", 1000, 400, -600, -60.0, "down")]
+
+
+def test_same_when_entries_exist_but_total_is_zero() -> None:
+    d = by_cat(month_diff(ROWS, "2026-01", "2026-02"))
+    assert d["zero"].status == "same"
+    assert d["zero"].prev == 0 and d["zero"].curr == 0
+    assert d["zero"].pct is None
+
+
+def test_same_status_for_equal_nonzero_totals() -> None:
+    rows = [ex("2026-01-01", "a", 100), ex("2026-02-01", "a", 100)]
+    d = month_diff(rows, "2026-01", "2026-02")
+    assert d[0].status == "same"
+    assert d[0].pct == 0.0
+
+
+def test_gone_with_zero_total_in_prev_is_still_gone_not_same() -> None:
+    rows = [ex("2026-01-01", "a", 0), ex("2026-02-01", "b", 1)]
+    d = by_cat(month_diff(rows, "2026-01", "2026-02"))
+    assert d["a"].status == "gone"
+    assert d["b"].status == "new"
+
+
+def test_pct_none_when_prev_zero_and_rounding() -> None:
+    rows = [
+        ex("2026-01-01", "a", 3),
+        ex("2026-02-01", "a", 4),
+        ex("2026-01-01", "b", 7),
+        ex("2026-02-01", "b", 9),
+    ]
+    d = by_cat(month_diff(rows, "2026-01", "2026-02"))
+    assert d["a"].pct == 33.3  # 1/3*100 = 33.33... -> 33.3
+    assert d["b"].pct == 28.6  # 2/7*100 = 28.57... -> 28.6
+
+
+def test_sort_by_abs_delta_desc_then_category_asc() -> None:
+    rows = [
+        ex("2026-01-01", "b", 100),
+        ex("2026-02-01", "b", 200),  # delta +100
+        ex("2026-01-01", "a", 500),
+        ex("2026-02-01", "a", 400),  # delta -100
+        ex("2026-02-01", "c", 900),  # delta +900
+        ex("2026-01-01", "d", 50),
+    ]
+    got = [d.category for d in month_diff(rows, "2026-01", "2026-02")]
+    assert got == ["c", "a", "b", "d"]
+
+
+def test_month_diff_rejects_bad_month_format() -> None:
+    for bad in ["2026-1", "2026/01", "2026-13", "2026-00", "26-01", "2026-01-01", ""]:
+        with pytest.raises(ValueError):
+            month_diff(ROWS, bad, "2026-02")
+        with pytest.raises(ValueError):
+            month_diff(ROWS, "2026-01", bad)
+
+
+def test_top_movers_excludes_same_and_keeps_order() -> None:
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    got = [d.category for d in top_movers(diffs, 2)]
+    assert got == ["new_cat", "food"]
+    assert [d.category for d in top_movers(diffs, 10)] == [
+        "new_cat",
+        "food",
+        "fun",
+    ]
+
+
+def test_top_movers_default_n_and_negative() -> None:
+    diffs = [
+        DiffRow("e", 1, 6, 5, 500.0, "up"),
+        DiffRow("b", 1, 1, 0, 0.0, "same"),
+        DiffRow("d", 1, 5, 4, 400.0, "up"),
+        DiffRow("c", 1, 3, 2, 200.0, "up"),
+        DiffRow("a", 1, 2, 1, 100.0, "up"),
+    ]
+    assert [d.category for d in top_movers(diffs)] == ["e", "d", "c"]
+    assert top_movers(diffs, 0) == []
+    with pytest.raises(ValueError):
+        top_movers(diffs, -1)
+
+
+def test_render_diff_signs_and_no_trailing_newline() -> None:
+    diffs = [
+        DiffRow("food", 1000, 1300, 300, 30.0, "up"),
+        DiffRow("rent", 2000, 0, -2000, -100.0, "gone"),
+        DiffRow("same", 5, 5, 0, 0.0, "same"),
+        DiffRow("new", 0, 7, 7, None, "new"),
+    ]
+    text = render_diff(diffs)
+    assert text == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "food\t1000\t1300\t+300\t+30.0%\n"
+        "rent\t2000\t0\t-2000\t-100.0%\n"
+        "same\t5\t5\t+0\t+0.0%\n"
+        "new\t0\t7\t+7\t-"
+    )
+    assert not text.endswith("\n")
+
+
+def test_render_diff_negative_small_pct_has_no_minus_zero() -> None:
+    d = month_diff(
+        [ex("2026-01-01", "a", 100000), ex("2026-02-01", "a", 99999)],
+        "2026-01",
+        "2026-02",
+    )
+    assert render_diff(d).splitlines()[1] == "a\t100000\t99999\t-1\t+0.0%"
+
+
+def test_available_months_sorted_unique() -> None:
+    assert available_months(ROWS) == ["2026-01", "2026-02"]
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months() -> None:
+    rows = [
+        ex("2025-12-01", "a", 999),
+        ex("2026-01-01", "a", 100),
+        ex("2026-03-01", "a", 250),
+        ex("2026-03-02", "b", 10),
+    ]
+    assert latest_diff(rows) == month_diff(rows, "2026-01", "2026-03")
+    assert [d.category for d in latest_diff(rows)] == ["a", "b"]
+
+
+def test_latest_diff_needs_two_months() -> None:
+    with pytest.raises(ValueError):
+        latest_diff([])
+    with pytest.raises(ValueError):
+        latest_diff([ex("2026-01-01", "a", 1), ex("2026-01-02", "a", 2)])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..5f7d822
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,222 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def _e(category: str, memo: str = "") -> Expense:
+    return Expense(day=date(2026, 1, 1), category=category, amount=100, memo=memo)
+
+
+# --- tokenize -------------------------------------------------------------
+
+
+def test_tokenize_empty_and_whitespace_only() -> None:
+    assert tokenize("") == []
+    assert tokenize("   \t ") == []
+
+
+def test_tokenize_plain_terms_split_on_whitespace() -> None:
+    assert tokenize("ramen  coffee") == [("TERM", "ramen"), ("TERM", "coffee")]
+
+
+def test_tokenize_parens() -> None:
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+
+
+def test_tokenize_operators_uppercase_only() -> None:
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+    assert tokenize("and or not") == [
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_cat() -> None:
+    assert tokenize("cat:food") == [("CAT", "food")]
+
+
+def test_tokenize_cat_value_keeps_case() -> None:
+    assert tokenize("cat:Food") == [("CAT", "Food")]
+
+
+def test_tokenize_word_stops_at_quote_and_paren() -> None:
+    assert tokenize('ab"cd"(e)') == [
+        ("TERM", "ab"),
+        ("TERM", "cd"),
+        ("LPAREN", "("),
+        ("TERM", "e"),
+        ("RPAREN", ")"),
+    ]
+
+
+def test_tokenize_quoted_term_keeps_spaces_and_parens() -> None:
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+
+
+def test_tokenize_quoted_keyword_is_term() -> None:
+    assert tokenize('"AND"') == [("TERM", "AND")]
+
+
+def test_tokenize_unclosed_quote_raises() -> None:
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_raises() -> None:
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_empty_cat_raises() -> None:
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+# --- matches / evaluation -------------------------------------------------
+
+
+def test_term_matches_memo_substring() -> None:
+    assert matches("ramen", _e("food", "lunch ramen"))
+    assert not matches("ramen", _e("food", "lunch"))
+
+
+def test_term_matches_category_substring() -> None:
+    assert matches("foo", _e("food", ""))
+
+
+def test_cat_requires_exact_category() -> None:
+    assert matches("cat:food", _e("food"))
+    assert not matches("cat:foo", _e("food"))
+    assert not matches("cat:food", _e("food drink"))
+
+
+def test_cat_does_not_match_memo() -> None:
+    assert not matches("cat:ramen", _e("food", "ramen"))
+
+
+def test_case_insensitive() -> None:
+    assert matches("RAMEN", _e("food", "ramen"))
+    assert matches("cat:FOOD", _e("food"))
+    assert matches("food", _e("FOOD"))
+
+
+def test_casefold_for_non_ascii() -> None:
+    assert matches("STRASSE", _e("misc", "straße"))
+
+
+def test_quoted_term_with_space() -> None:
+    assert matches('"lunch set"', _e("food", "lunch set A"))
+    assert not matches('"lunch set"', _e("food", "lunch A set"))
+
+
+def test_implicit_and() -> None:
+    e = _e("food", "ramen")
+    assert matches("ramen food", e)
+    assert not matches("ramen coffee", e)
+
+
+def test_explicit_and() -> None:
+    e = _e("food", "ramen")
+    assert matches("ramen AND food", e)
+    assert not matches("ramen AND coffee", e)
+
+
+def test_or() -> None:
+    e = _e("food", "ramen")
+    assert matches("coffee OR ramen", e)
+    assert not matches("coffee OR tea", e)
+
+
+def test_not() -> None:
+    e = _e("food", "ramen")
+    assert matches("NOT coffee", e)
+    assert not matches("NOT ramen", e)
+
+
+def test_precedence_not_binds_tighter_than_and() -> None:
+    # Parsed as (NOT a) AND b. If NOT applied to (a AND b) it would match.
+    assert not matches("NOT a b", _e("x", "a"))
+    assert matches("NOT a b", _e("x", "b"))
+
+
+def test_precedence_and_binds_tighter_than_or() -> None:
+    # Parsed as a OR (b AND c).
+    assert matches("a OR b AND c", _e("x", "a"))
+    assert not matches("a OR b AND c", _e("x", "b"))
+    assert matches("a OR b AND c", _e("x", "b c"))
+
+
+def test_double_not() -> None:
+    assert matches("NOT NOT ramen", _e("food", "ramen"))
+
+
+def test_parens_override_precedence() -> None:
+    assert matches("(a OR b) AND c", _e("x", "a c"))
+    assert not matches("(a OR b) AND c", _e("x", "a"))
+
+
+def test_nested_parens() -> None:
+    assert matches("((a))", _e("x", "a"))
+
+
+# --- errors ---------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(a",
+        "a)",
+        ")a(",
+        "a AND",
+        "AND a",
+        "a OR",
+        "OR a",
+        "a OR OR b",
+        "NOT",
+        "a NOT",
+        "a AND OR b",
+        "(a OR)",
+        "cat:",
+        '"',
+        '""',
+    ],
+)
+def test_invalid_queries_raise(q: str) -> None:
+    with pytest.raises(QueryError):
+        matches(q, _e("food", "a"))
+
+
+def test_query_error_is_value_error() -> None:
+    assert issubclass(QueryError, ValueError)
+
+
+# --- filter_rows ----------------------------------------------------------
+
+
+def test_filter_rows_keeps_input_order() -> None:
+    rows = [_e("food", "a"), _e("tea", "b"), _e("food", "c")]
+    assert filter_rows("cat:food", rows) == [rows[0], rows[2]]
+
+
+def test_filter_rows_empty_input_valid_query() -> None:
+    assert filter_rows("ramen", []) == []
+
+
+def test_filter_rows_empty_input_invalid_query_raises() -> None:
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
+
+
+def test_filter_rows_invalid_query_raises_with_rows() -> None:
+    with pytest.raises(QueryError):
+        filter_rows("a AND", [_e("food", "a")])
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..346b70c
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,254 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def E(d: date, category: str = "食費", amount: int = 1000, memo: str = "") -> Expense:
+    return Expense(day=d, category=category, amount=amount, memo=memo)
+
+
+# --- add_month -------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("src", "expected"),
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),  # non-leap February
+        (date(2024, 1, 31), date(2024, 2, 29)),  # leap February
+        (date(2026, 12, 15), date(2027, 1, 15)),  # year rollover
+        (date(2026, 3, 31), date(2026, 4, 30)),  # 30-day month
+        (date(2025, 12, 31), date(2026, 1, 31)),
+        (date(2026, 11, 30), date(2026, 12, 30)),
+    ],
+)
+def test_add_month(src: date, expected: date) -> None:
+    assert add_month(src) == expected
+
+
+# --- find_recurring: basics -------------------------------------------------
+
+
+def test_monthly_series_detected() -> None:
+    rows = [E(date(2026, 1, 15)), E(date(2026, 2, 15)), E(date(2026, 3, 15))]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="食費",
+            amount=1000,
+            days=(date(2026, 1, 15), date(2026, 2, 15), date(2026, 3, 15)),
+            next_expected=date(2026, 4, 15),
+        )
+    ]
+
+
+def test_empty_input_returns_empty() -> None:
+    assert find_recurring([]) == []
+
+
+def test_below_min_count_not_reported() -> None:
+    rows = [E(date(2026, 1, 15)), E(date(2026, 2, 15))]
+    assert find_recurring(rows, min_count=3) == []
+    assert len(find_recurring(rows, min_count=2)) == 1
+
+
+def test_no_recurrence_returns_empty() -> None:
+    rows = [E(date(2026, 1, 1)), E(date(2026, 5, 20)), E(date(2026, 9, 3))]
+    assert find_recurring(rows) == []
+
+
+def test_memo_is_ignored_for_grouping() -> None:
+    rows = [
+        E(date(2026, 1, 15), memo="a"),
+        E(date(2026, 2, 15), memo="b"),
+        E(date(2026, 3, 15), memo=""),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert len(result[0].days) == 3
+
+
+def test_different_amounts_are_separate_groups() -> None:
+    rows = [
+        E(date(2026, 1, 15), amount=1000),
+        E(date(2026, 2, 15), amount=1000),
+        E(date(2026, 3, 15), amount=2000),
+    ]
+    # amount 1000 has only two dates, amount 2000 has one -> nothing
+    assert find_recurring(rows) == []
+
+
+def test_different_categories_are_separate_groups() -> None:
+    rows = [
+        E(date(2026, 1, 15), category="食費"),
+        E(date(2026, 2, 15), category="住居"),
+        E(date(2026, 3, 15), category="食費"),
+    ]
+    assert find_recurring(rows) == []
+
+
+# --- month-end and leap year -----------------------------------------------
+
+
+def test_month_end_series() -> None:
+    rows = [E(date(2026, 1, 31)), E(date(2026, 2, 28)), E(date(2026, 3, 31))]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 30)
+
+
+def test_leap_year_february_end() -> None:
+    rows = [E(date(2024, 1, 31)), E(date(2024, 2, 29)), E(date(2024, 3, 31))]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2024, 1, 31), date(2024, 2, 29), date(2024, 3, 31))
+    assert result[0].next_expected == date(2024, 4, 30)
+
+
+# --- tolerance --------------------------------------------------------------
+
+
+def test_tolerance_allows_drift_within_limit() -> None:
+    # add_month(Jan 15) = Feb 15; Feb 18 is 3 days off -> linked at tolerance 3
+    rows = [E(date(2026, 1, 15)), E(date(2026, 2, 18)), E(date(2026, 3, 15))]
+    result = find_recurring(rows, tolerance=3)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 15), date(2026, 2, 18), date(2026, 3, 15))
+
+
+def test_drift_beyond_tolerance_splits_run() -> None:
+    # Feb 19 is 4 days off Feb 15 -> not linked at tolerance 3
+    rows = [E(date(2026, 1, 15)), E(date(2026, 2, 19)), E(date(2026, 3, 15))]
+    assert find_recurring(rows, tolerance=3) == []
+
+
+def test_zero_tolerance_requires_exact_month_step() -> None:
+    rows = [E(date(2026, 1, 15)), E(date(2026, 2, 16)), E(date(2026, 3, 16))]
+    assert find_recurring(rows, tolerance=0) == []
+    assert len(find_recurring(rows, tolerance=1)) == 1
+
+
+def test_negative_drift_within_tolerance() -> None:
+    # add_month(Feb 15) = Mar 15; Mar 12 is 3 days early -> linked
+    rows = [E(date(2026, 1, 15)), E(date(2026, 2, 15)), E(date(2026, 3, 12))]
+    result = find_recurring(rows, tolerance=3)
+    assert len(result) == 1
+    assert result[0].days[-1] == date(2026, 3, 12)
+    assert result[0].next_expected == date(2026, 4, 12)
+
+
+# --- run splitting and min_count -------------------------------------------
+
+
+def test_gap_splits_series_and_only_long_run_reported() -> None:
+    rows = [
+        E(date(2026, 1, 15)),
+        E(date(2026, 2, 15)),  # run of 2, below min_count 3
+        E(date(2026, 6, 15)),
+        E(date(2026, 7, 15)),
+        E(date(2026, 8, 15)),  # run of 3
+    ]
+    result = find_recurring(rows, min_count=3)
+    assert result == [
+        Recurring(
+            category="食費",
+            amount=1000,
+            days=(date(2026, 6, 15), date(2026, 7, 15), date(2026, 8, 15)),
+            next_expected=date(2026, 9, 15),
+        )
+    ]
+
+
+def test_each_long_run_reported_separately() -> None:
+    rows = [
+        E(date(2026, 1, 15)),
+        E(date(2026, 2, 15)),
+        E(date(2026, 3, 15)),
+        E(date(2026, 8, 15)),
+        E(date(2026, 9, 15)),
+        E(date(2026, 10, 15)),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 2
+    assert result[0].days[0] == date(2026, 1, 15)
+    assert result[1].days[0] == date(2026, 8, 15)
+
+
+def test_min_count_threshold_is_inclusive() -> None:
+    rows = [E(date(2026, m, 10)) for m in (1, 2, 3, 4)]
+    assert len(find_recurring(rows, min_count=4)) == 1
+    assert find_recurring(rows, min_count=5) == []
+
+
+# --- duplicates and input order --------------------------------------------
+
+
+def test_duplicate_dates_are_collapsed() -> None:
+    rows = [
+        E(date(2026, 1, 15)),
+        E(date(2026, 1, 15)),
+        E(date(2026, 2, 15)),
+        E(date(2026, 3, 15)),
+        E(date(2026, 3, 15)),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 15), date(2026, 2, 15), date(2026, 3, 15))
+
+
+def test_duplicates_do_not_form_a_series() -> None:
+    rows = [E(date(2026, 1, 15))] * 5
+    assert find_recurring(rows) == []
+
+
+def test_unsorted_input_is_handled() -> None:
+    rows = [E(date(2026, 3, 15)), E(date(2026, 1, 15)), E(date(2026, 2, 15))]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 15), date(2026, 2, 15), date(2026, 3, 15))
+
