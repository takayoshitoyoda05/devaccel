+++ b/src/kakeibo/bank_import.py
@@ -0,0 +1,221 @@
+"""Parse bank CSV exports into Expense records (pure: takes text, does no I/O)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from collections.abc import Callable, Iterator
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str  # 列名。行全体の誤りなら ""
+    value: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+    skipped: list[int]
+
+
+_DATE_NAMES = ("日付", "利用日", "取引日", "ご利用日", "date")
+_AMOUNT_NAMES = ("金額", "利用金額", "ご利用金額", "amount")
+_WITHDRAW_NAMES = ("出金額", "出金", "支払", "支払金額")
+_DEPOSIT_NAMES = ("入金額", "入金", "預入", "預入金額")
+_MEMO_NAMES = ("摘要", "メモ", "利用店名", "ご利用店名", "内容", "description", "memo")
+_CATEGORY_NAMES = ("カテゴリ", "カテゴリー", "category")
+
+_DATE_FORMS = (
+    re.compile(r"([0-9]{4})-([0-9]{1,2})-([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})/([0-9]{1,2})/([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})\.([0-9]{1,2})\.([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日"),
+)
+_DATE_WITH_TIME = re.compile(r"(.+?)(?:\s+([0-9]{1,2}):([0-9]{2})(?::([0-9]{2}))?)?")
+
+
+def _norm_header(name: str) -> str:
+    return unicodedata.normalize("NFKC", name.strip().lower())
+
+
+def _find(names: list[str], aliases: tuple[str, ...]) -> int | None:
+    wanted = set(aliases)
+    for i, name in enumerate(names):
+        if name in wanted:
+            return i
+    return None
+
+
+def _parse_date(raw: str) -> date:
+    s = unicodedata.normalize("NFKC", raw).strip()
+    m = _DATE_WITH_TIME.fullmatch(s)
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {raw!r}")
+    body, hh, mm, ss = m.group(1), m.group(2), m.group(3), m.group(4)
+    if hh is not None and (
+        int(hh) > 23 or int(mm) > 59 or (ss is not None and int(ss) > 59)
+    ):
+        raise ValueError(f"時刻が不正です: {raw!r}")
+    for form in _DATE_FORMS:
+        fm = form.fullmatch(body)
+        if fm is not None:
+            y, mo, d = (int(g) for g in fm.groups())
+            try:
+                return date(y, mo, d)
+            except ValueError:
+                raise ValueError(f"存在しない日付です: {raw!r}") from None
+    raise ValueError(f"日付の形式が不正です: {raw!r}")
+
+
+_CURRENCY_OR_SPACE = re.compile(r"¥|円|JPY|,|\s", re.IGNORECASE)
+
+
+def _parse_amount(raw: str) -> int:
+    s = _CURRENCY_OR_SPACE.sub("", unicodedata.normalize("NFKC", raw))
+    if not s:
+        raise ValueError("金額が空です")
+    neg = False
+    if s[0] in "-−△▲":
+        neg, s = True, s[1:]
+    elif s[0] == "(" and s[-1] == ")":
+        neg, s = True, s[1:-1]
+    elif s[-1] == "-":
+        neg, s = True, s[:-1]
+    if not re.fullmatch(r"[0-9]+", s):
+        raise ValueError(f"金額が整数ではありません: {raw!r}")
+    value = int(s)
+    return -value if neg else value
+
+
+def _detect_delimiter(body: str) -> str:
+    first = re.split(r"\r\n|\r|\n", body, maxsplit=1)[0]
+    return "\t" if first.count("\t") > first.count(",") else ","
+
+
+def _records(reader: csv.reader) -> Iterator[tuple[int, list[str]]]:  # type: ignore[valid-type]
+    """(レコード開始行, 行) を返す。開始行は前レコードの終端行 + 1。"""
+    start = 1
+    for row in reader:
+        yield start, row
+        start = reader.line_num + 1
+
+
+def parse_bank_csv(text: str, *, default_category: str = "未分類") -> ImportResult:
+    body = text.removeprefix("﻿")
+    delim = _detect_delimiter(body)
+    reader = csv.reader(io.StringIO(body, newline=""), delimiter=delim)
+    rows = [(line, row) for line, row in _records(reader) if row]
+    if not rows:
+        return ImportResult([], [], [])
+
+    _, header = rows[0]
+    names = [_norm_header(h) for h in header]
+    date_i = _find(names, _DATE_NAMES)
+    amount_i = _find(names, _AMOUNT_NAMES)
+    withdraw_i = _find(names, _WITHDRAW_NAMES)
+    deposit_i = _find(names, _DEPOSIT_NAMES)
+    if date_i is None:
+        raise ValueError("日付列がありません")
+    if amount_i is None and withdraw_i is None and deposit_i is None:
+        raise ValueError("金額列がありません")
+    memo_i = _find(names, _MEMO_NAMES)
+    category_i = _find(names, _CATEGORY_NAMES)
+    width = len(header)
+
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    skipped: list[int] = []
+
+    for line, row in rows[1:]:
+        if len(row) != width:
+            errors.append(
+                RowError(
+                    line,
+                    "",
+                    delim.join(row),
+                    f"列数が見出しと一致しません({len(row)}列、見出しは{width}列)",
+                )
+            )
+            continue
+
+        before = len(errors)
+        day = _attempt(_parse_date, row[date_i], line, header[date_i], errors)
+
+        if amount_i is not None:
+            amount = _attempt(
+                _parse_amount, row[amount_i], line, header[amount_i], errors
+            )
+            if len(errors) > before:
+                continue
+            assert day is not None and amount is not None
+            expenses.append(
+                _make(day, row, category_i, memo_i, default_category, amount)
+            )
+            continue
+
+        # 出金/入金の 2 列形式
+        w_raw = row[withdraw_i].strip() if withdraw_i is not None else ""
+        d_raw = row[deposit_i].strip() if deposit_i is not None else ""
+        w = None
+        if withdraw_i is not None and w_raw:
+            w = _attempt(
+                _parse_amount, row[withdraw_i], line, header[withdraw_i], errors
+            )
+        d = None
+        if deposit_i is not None and d_raw:
+            d = _attempt(_parse_amount, row[deposit_i], line, header[deposit_i], errors)
+        if len(errors) > before:
+            continue
+        if (w is None or w == 0) and d is not None and d > 0:
+            skipped.append(line)
+            continue
+        if w is None:
+            col = withdraw_i if withdraw_i is not None else deposit_i
+            assert col is not None
+            errors.append(RowError(line, header[col].strip(), "", "金額が空です"))
+            continue
+        assert day is not None
+        expenses.append(
+            _make(day, row, category_i, memo_i, default_category, w - (d or 0))
+        )
+
+    return ImportResult(expenses, errors, skipped)
+
+
+def _attempt[T](
+    parse: Callable[[str], T], raw: str, line: int, column: str, errors: list[RowError]
+) -> T | None:
+    """parse を実行し、失敗したら errors に積んで None を返す。"""
+    try:
+        return parse(raw)
+    except ValueError as e:
+        errors.append(RowError(line, column.strip(), raw, str(e)))
+        return None
+
+
+def _make(
+    day: date,
+    row: list[str],
+    category_i: int | None,
+    memo_i: int | None,
+    default_category: str,
+    amount: int,
+) -> Expense:
+    category = row[category_i].strip() if category_i is not None else ""
+    memo = row[memo_i].strip() if memo_i is not None else ""
+    return Expense(
+        day=day,
+        category=category or default_category,
+        amount=amount,
+        memo=memo,
+    )
