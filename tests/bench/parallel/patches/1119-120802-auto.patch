+from __future__ import annotations
+
+import dataclasses
+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import ImportResult, RowError, parse_bank_csv
+from kakeibo.core import Expense
+
+D = date(2026, 1, 5)
+
+
+def _ok(text: str, **kw: str) -> list[Expense]:
+    res = parse_bank_csv(text, **kw)
+    assert res.errors == [], res.errors
+    assert res.skipped == []
+    return res.expenses
+
+
+def _err_keys(text: str) -> list[tuple[int, str, str]]:
+    res = parse_bank_csv(text)
+    assert res.expenses == []
+    return [(e.line, e.column, e.value) for e in res.errors]
+
+
+# 表の全行(E2-1〜E2-3)
+@pytest.mark.parametrize(
+    ("text", "expenses", "skipped", "error_keys"),
+    [
+        pytest.param(
+            '利用日,ご利用店名,利用金額\n2026/1/5,スーパー,"1,234円"\n',
+            [Expense(date(2026, 1, 5), "未分類", 1234, "スーパー")],
+            [],
+            [],
+            id="E2-1",
+        ),
+        pytest.param(
+            "取引日,摘要,出金額,入金額\n2026-01-06,給与,,300000\n",
+            [],
+            [2],
+            [],
+            id="E2-2",
+        ),
+        pytest.param(
+            "日付,金額,摘要\n2026-02-30,12.5,x\n",
+            [],
+            [],
+            [(2, "日付", "2026-02-30"), (2, "金額", "12.5")],
+            id="E2-3",
+        ),
+    ],
+)
+def test_spec_table(
+    text: str,
+    expenses: list[Expense],
+    skipped: list[int],
+    error_keys: list[tuple[int, str, str]],
+) -> None:
+    res = parse_bank_csv(text)
+    assert res.expenses == expenses
+    assert res.skipped == skipped
+    assert [(e.line, e.column, e.value) for e in res.errors] == error_keys
+
+
+# R1: BOM・改行・区切り・引用
+def test_R1_bom_is_allowed() -> None:
+    assert _ok("﻿日付,金額\n2026-01-01,100\n") == [
+        Expense(date(2026, 1, 1), "未分類", 100, "")
+    ]
+
+
+@pytest.mark.parametrize("nl", ["\r\n", "\n", "\r"], ids=["CRLF", "LF", "CR"])
+def test_R1_newline_variants(nl: str) -> None:
+    text = f"日付,金額{nl}2026-01-01,100{nl}2026-01-02,200{nl}"
+    assert [e.amount for e in _ok(text)] == [100, 200]
+
+
+def test_R1_tab_delimiter_is_autodetected() -> None:
+    assert _ok("日付\t金額\n2026-01-01\t100\n")[0].amount == 100
+
+
+def test_R1_quoted_comma_and_newline_are_part_of_value() -> None:
+    text = '日付,金額,摘要\n"2026-01-01","1,2","a\nb"\n'
+    expenses = _ok(text)
+    assert expenses[0].amount == 12
+    assert expenses[0].memo == "a\nb"
+
+
+def test_R1_line_number_is_record_start_across_multiline_value() -> None:
+    text = '日付,金額,摘要\n2026-01-01,100,"a\nb"\n2026-02-30,100,x\n'
+    res = parse_bank_csv(text)
+    assert [(e.line, e.column, e.value) for e in res.errors] == [
+        (4, "日付", "2026-02-30")
+    ]
+
+
+# R2: 列名の照合
+@pytest.mark.parametrize(
+    "name", ["日付", "利用日", "取引日", "ご利用日", "date", "Date"]
+)
+def test_R2_date_aliases(name: str) -> None:
+    assert _ok(f"{name},金額\n2026-01-05,100\n")[0].day == D
+
+
+@pytest.mark.parametrize("name", ["金額", "利用金額", "ご利用金額", "amount"])
+def test_R2_amount_aliases(name: str) -> None:
+    assert _ok(f"日付,{name}\n2026-01-05,100\n")[0].amount == 100
+
+
+def test_R2_header_strip_lower_nfkc() -> None:
+    assert _ok(" ＤＡＴＥ , Amount \n2026-01-05,100\n")[0].amount == 100
+
+
+def test_R2_category_column_is_used() -> None:
+    e = _ok("日付,金額,カテゴリー\n2026-01-05,100,食費\n")[0]
+    assert e.category == "食費"
+
+
+def test_R2_default_category() -> None:
+    assert _ok("日付,金額\n2026-01-05,100\n")[0].category == "未分類"
+    assert (
+        _ok("日付,金額\n2026-01-05,100\n", default_category="雑費")[0].category
+        == "雑費"
+    )
+
+
+def test_R2_missing_date_column_raises_value_error() -> None:
+    with pytest.raises(ValueError):
+        parse_bank_csv("摘要,金額\nx,100\n")
+
+
+def test_R2_missing_amount_column_raises_value_error() -> None:
+    with pytest.raises(ValueError):
+        parse_bank_csv("日付,摘要\n2026-01-05,x\n")
+
+
+def test_empty_input_returns_empty_result() -> None:
+    assert parse_bank_csv("") == ImportResult([], [], [])
+    assert parse_bank_csv("﻿") == ImportResult([], [], [])
+
+
+def test_result_and_error_are_frozen() -> None:
+    res = parse_bank_csv("")
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        res.expenses = []  # type: ignore[misc]
+    err = RowError(1, "", "", "x")
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        err.line = 2  # type: ignore[misc]
+
+
+# R3: 金額
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        ("¥1,234", 1234),
+        ("￥1,234", 1234),
+        ("1,234円", 1234),
+        ("1234 JPY", 1234),
+        (" 1 234 ", 1234),
+        ("0", 0),
+    ],
+)
+def test_R3_amount_formats(raw: str, expected: int) -> None:
+    assert _ok(f'日付,金額\n2026-01-05,"{raw}"\n')[0].amount == expected
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("¥-300", -300),
+    ],
+)
+def test_R3_negative_forms_are_refunds(raw: str, expected: int) -> None:
+    assert _ok(f'日付,金額\n2026-01-05,"{raw}"\n')[0].amount == expected
+
+
+@pytest.mark.parametrize("raw", ["12.5", "", "-", "—", "1,2.5", "abc"])
+def test_R3_invalid_amounts_are_errors(raw: str) -> None:
+    keys = _err_keys(f'日付,金額\n2026-01-05,"{raw}"\n')
+    assert keys == [(2, "金額", raw)]
+
+
+def test_R3_two_column_withdrawal_is_positive() -> None:
+    assert _ok("取引日,摘要,出金額,入金額\n2026-01-07,買物,500,\n")[0].amount == 500
+
+
+def test_R3_two_column_deposit_is_refund() -> None:
+    # 出金 - 入金 の純額として取り込む(入金は負の金額として扱う)
+    assert _ok("取引日,摘要,出金額,入金額\n2026-01-09,返金,100,30\n")[0].amount == 70
+
+
+def test_R3_two_column_deposit_only_with_zero_withdrawal_is_skipped() -> None:
+    res = parse_bank_csv("取引日,摘要,出金額,入金額\n2026-01-10,x,0,300\n")
+    assert res.expenses == [] and res.errors == [] and res.skipped == [2]
+
+
+# R4: 日付
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026.1.5",
+        "2026年1月5日",
+        "2026/01/05 12:34",
+        "2026-01-05 12:34:56",
+        "2026-01-05 00:00",
+        "２０２６／１／５",
+    ],
+)
+def test_R4_date_formats(raw: str) -> None:
+    assert _ok(f'日付,金額\n"{raw}",100\n')[0].day == D
+
+
+@pytest.mark.parametrize(
+    "raw",
+    ["2026-1/5", "2026-02-30", "令和8年1月5日", "2026-01-05 25:00", "2026-13-01"],
+)
+def test_R4_invalid_dates_are_errors(raw: str) -> None:
+    assert _err_keys(f'日付,金額\n"{raw}",100\n') == [(2, "日付", raw)]
+
+
+# R5: 列数・空行
+def test_R5_too_few_columns_is_row_error() -> None:
+    assert _err_keys("日付,金額,摘要\n2026-01-05,100\n") == [(2, "", "2026-01-05,100")]
+
+
+def test_R5_too_many_columns_is_row_error() -> None:
+    assert _err_keys("日付,金額,摘要\n2026-01-05,100,x,y\n") == [
+        (2, "", "2026-01-05,100,x,y")
+    ]
+
+
+def test_R5_unquoted_thousands_separator_is_row_error() -> None:
+    assert _err_keys("日付,摘要,金額\n2026-01-05,スーパー,1,234\n") == [
+        (2, "", "2026-01-05,スーパー,1,234")
+    ]
+
+
+def test_R5_fully_empty_line_is_ignored_and_not_skipped() -> None:
+    res = parse_bank_csv("日付,金額\n2026-01-05,100\n\n2026-01-06,200\n")
+    assert [e.amount for e in res.expenses] == [100, 200]
+    assert res.skipped == []
+    assert res.errors == []
+
+
+# R6: 複数誤り・順序
+def test_R6_date_and_amount_errors_are_both_reported() -> None:
+    res = parse_bank_csv("日付,金額\n2026-02-30,abc\n")
+    assert [(e.column, e.value) for e in res.errors] == [
+        ("日付", "2026-02-30"),
+        ("金額", "abc"),
+    ]
+
+
+def test_R6_error_row_is_excluded_and_order_is_kept() -> None:
+    text = "日付,金額\n2026-01-01,1\n2026-02-30,2\n2026-01-03,3\n"
+    res = parse_bank_csv(text)
+    assert [e.amount for e in res.expenses] == [1, 3]
+    assert [(e.line, e.column) for e in res.errors] == [(3, "日付")]
diff --git a/tests/test_monthly_diff.py b/tests/test_monthly_diff.py
new file mode 100644
index 0000000..835b021
--- /dev/null
+++ b/tests/test_monthly_diff.py
@@ -0,0 +1,183 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthly_diff import DiffLine, diff_report, format_report
+
+
+def ex(d: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(d), category=category, amount=amount)
+
+
+def line(r, category: str) -> DiffLine:
+    return next(x for x in r.lines if x.category == category)
+
+
+# E4-1 / E4-2 / E4-3 の例の表をそのまま写したテスト
+@pytest.mark.parametrize("case_id", ["E4-1"], ids=["E4-1"])
+def test_example_year_boundary_increase(case_id: str) -> None:
+    rows = [ex("2026-12-05", "食費", 3000), ex("2027-01-05", "食費", 4500)]
+    r = diff_report(rows, "2027-01")
+    assert r.prev_month == "2026-12"
+    food = line(r, "食費")
+    assert food.delta == 1500
+    assert food.pct == 50.0
+    assert food.status == "増"
+
+
+@pytest.mark.parametrize("case_id", ["E4-2"], ids=["E4-2"])
+def test_example_new_category(case_id: str) -> None:
+    rows = [ex("2027-01-10", "交通", 800)]
+    r = diff_report(rows, "2027-01")
+    t = line(r, "交通")
+    assert t.prev == 0
+    assert t.pct is None
+    assert t.status == "新規"
+
+
+@pytest.mark.parametrize("case_id", ["E4-3"], ids=["E4-3"])
+def test_example_invalid_month(case_id: str) -> None:
+    with pytest.raises(ValueError):
+        diff_report([], "2026-13")
+
+
+# R1: 前月は暦の前月。明細が無くても 0 として扱う
+@pytest.mark.parametrize(
+    "month,prev",
+    [("2027-01", "2026-12"), ("2027-03", "2027-02"), ("2027-12", "2027-11")],
+    ids=["R1-jan", "R1-mar", "R1-dec"],
+)
+def test_prev_month_is_calendar_previous(month: str, prev: str) -> None:
+    r = diff_report([], month)
+    assert r.month == month
+    assert r.prev_month == prev
+
+
+@pytest.mark.parametrize(
+    "bad", ["2026-1", "26-01", "2026/01", "2026-00", "", "2026-01-01"]
+)
+def test_invalid_month_format_raises(bad: str) -> None:
+    with pytest.raises(ValueError):
+        diff_report([], bad)
+
+
+# R2: 片方の月だけにあるカテゴリも載せる
+def test_prev_only_category_is_decrease_with_zero_current() -> None:
+    rows = [ex("2026-12-01", "娯楽", 2000)]
+    r = diff_report(rows, "2027-01")
+    e = line(r, "娯楽")
+    assert e.prev == 2000
+    assert e.current == 0
+    assert e.delta == -2000
+    assert e.status == "減"
+    assert e.pct == -100.0
+
+
+# R2: 両方 0 の純額になったカテゴリは載せない
+def test_category_netting_to_zero_on_both_sides_is_dropped() -> None:
+    rows = [
+        ex("2026-12-01", "雑費", 500),
+        ex("2026-12-02", "雑費", -500),
+        ex("2027-01-01", "雑費", 300),
+        ex("2027-01-02", "雑費", -300),
+    ]
+    r = diff_report(rows, "2027-01")
+    assert all(x.category != "雑費" for x in r.lines)
+
+
+# D1: 返金は負の金額として純額に合算する
+def test_refund_nets_against_spending() -> None:
+    rows = [
+        ex("2026-12-01", "食費", 3000),
+        ex("2027-01-01", "食費", 4000),
+        ex("2027-01-02", "食費", -1000),
+    ]
+    r = diff_report(rows, "2027-01")
+    f = line(r, "食費")
+    assert f.current == 3000
+    assert f.delta == 0
+    assert f.status == "変化なし"
+
+
+# R3: status の判定
+@pytest.mark.parametrize(
+    "prev_amt,cur_amt,status",
+    [(1000, 1500, "増"), (1000, 500, "減"), (1000, 1000, "変化なし"), (0, 700, "新規")],
+    ids=["R3-up", "R3-down", "R3-same", "R3-new"],
+)
+def test_status_rules(prev_amt: int, cur_amt: int, status: str) -> None:
+    rows: list[Expense] = []
+    if prev_amt:
+        rows.append(ex("2026-12-01", "食費", prev_amt))
+    if cur_amt:
+        rows.append(ex("2027-01-01", "食費", cur_amt))
+    rows.append(ex("2027-01-02", "その他", 1))  # 食費 以外の行を混ぜても影響しない
+    r = diff_report(rows, "2027-01")
+    assert line(r, "食費").status == status
+
+
+# R4: 並びは abs(delta) 降順、同点は category 昇順
+def test_lines_sorted_by_abs_delta_then_category() -> None:
+    rows = [
+        ex("2026-12-01", "A", 1000),
+        ex("2027-01-01", "A", 1000),  # delta 0
+        ex("2026-12-01", "B", 100),
+        ex("2027-01-01", "B", 1100),  # delta +1000
+        ex("2026-12-01", "C", 2000),
+        ex("2027-01-01", "C", 1000),  # delta -1000
+        ex("2027-01-01", "D", 500),  # 新規 delta +500
+    ]
+    r = diff_report(rows, "2027-01")
+    assert [x.category for x in r.lines] == ["B", "C", "D", "A"]
+
+
+# R4: 合計は全カテゴリの合計。前月 0 でも新規ではなく delta で判定
+def test_total_aggregates_and_never_new() -> None:
+    rows = [ex("2027-01-01", "食費", 800)]
+    r = diff_report(rows, "2027-01")
+    assert r.total.category == "合計"
+    assert r.total.prev == 0
+    assert r.total.current == 800
+    assert r.total.delta == 800
+    assert r.total.pct is None
+    assert r.total.status == "増"
+
+
+# R4: pct は小数第 1 位に丸める
+def test_pct_rounded_to_one_decimal() -> None:
+    rows = [ex("2026-12-01", "食費", 3), ex("2027-01-01", "食費", 4)]
+    r = diff_report(rows, "2027-01")
+    assert line(r, "食費").pct == 33.3
+
+
+# R5: 空の月でも合計行を出す
+def test_format_empty_month_has_total_line() -> None:
+    text = format_report(diff_report([], "2027-01"))
+    lines = text.splitlines()
+    assert lines[0] == "2027-01 前月比(前月 2026-12)"
+    assert lines[-1].startswith("合計")
+    assert len(lines) == 2
+
+
+# R5: 形式・桁区切り・新規表示
+def test_format_lines_contain_amounts_pct_and_status() -> None:
+    rows = [
+        ex("2026-12-01", "食費", 3000),
+        ex("2027-01-01", "食費", 4500),
+        ex("2027-01-02", "交通", 1234),
+    ]
+    text = format_report(diff_report(rows, "2027-01"))
+    lines = text.splitlines()
+    assert lines[0] == "2027-01 前月比(前月 2026-12)"
+    food = next(s for s in lines if s.startswith("食費"))
+    assert "3,000" in food and "4,500" in food
+    assert "+1,500円" in food
+    assert "(+50.0%)" in food
+    assert food.endswith("増")
+    traffic = next(s for s in lines if s.startswith("交通"))
+    assert "(新規)" in traffic
+    assert traffic.endswith("新規")
+    assert lines[-1].startswith("合計")
