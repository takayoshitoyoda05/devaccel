@@ -0,0 +1,107 @@
+"""Month-over-month spending comparison by category (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+_TOTAL_LABEL = "合計"
+
+
+@dataclass(frozen=True)
+class DiffLine:
+    category: str
+    prev: int
+    current: int
+    delta: int  # current - prev
+    pct: float | None  # delta / prev * 100, None when prev == 0
+    status: str  # "増" "減" "変化なし" "新規"
+
+
+@dataclass(frozen=True)
+class DiffReport:
+    month: str
+    prev_month: str
+    lines: list[DiffLine]
+    total: DiffLine
+
+
+def _check_month(month: str) -> None:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def _prev_month(month: str) -> str:
+    year, mon = int(month[:4]), int(month[5:7])
+    if mon == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mon - 1:02d}"
+
+
+def _status(prev: int, current: int, delta: int, *, allow_new: bool) -> str:
+    if allow_new and prev == 0 and current > 0:
+        return "新規"
+    if delta > 0:
+        return "増"
+    if delta < 0:
+        return "減"
+    return "変化なし"
+
+
+def _make_line(category: str, prev: int, current: int, *, allow_new: bool) -> DiffLine:
+    delta = current - prev
+    pct = None if prev == 0 else round(delta / prev * 100, 1)
+    return DiffLine(
+        category=category,
+        prev=prev,
+        current=current,
+        delta=delta,
+        pct=pct,
+        status=_status(prev, current, delta, allow_new=allow_new),
+    )
+
+
+def _net_by_category(rows: list[Expense], month: str) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for e in rows:
+        if e.day.strftime("%Y-%m") == month:
+            out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def diff_report(rows: list[Expense], month: str) -> DiffReport:
+    _check_month(month)
+    prev_month = _prev_month(month)
+    prev_net = _net_by_category(rows, prev_month)
+    cur_net = _net_by_category(rows, month)
+
+    lines: list[DiffLine] = []
+    for cat in set(prev_net) | set(cur_net):
+        prev = prev_net.get(cat, 0)
+        cur = cur_net.get(cat, 0)
+        if prev == 0 and cur == 0:
+            continue
+        lines.append(_make_line(cat, prev, cur, allow_new=True))
+    lines.sort(key=lambda x: (-abs(x.delta), x.category))
+
+    total_prev = sum(prev_net.values())
+    total_cur = sum(cur_net.values())
+    total = _make_line(_TOTAL_LABEL, total_prev, total_cur, allow_new=False)
+    return DiffReport(month=month, prev_month=prev_month, lines=lines, total=total)
+
+
+def _format_line(x: DiffLine) -> str:
+    pct_text = "(新規)" if x.pct is None else f"({x.pct:+.1f}%)"
+    return (
+        f"{x.category}  {x.prev:,} → {x.current:,}  "
+        f"{x.delta:+,}円  {pct_text}  {x.status}"
+    )
+
+
+def format_report(r: DiffReport) -> str:
+    header = f"{r.month} 前月比(前月 {r.prev_month})"
+    body = [_format_line(x) for x in r.lines]
+    return "\n".join([header, *body, _format_line(r.total)])
