+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,101 @@
+"""Detect recurring expenses (subscriptions, rent, utilities) from expense rows."""
+
+from __future__ import annotations
+
+import calendar
+import re
+import statistics
+import unicodedata
+from collections import Counter
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_SUFFIX_RE = re.compile(r"(?:#\d+|no\.\d+|\d+)$")
+_SPACE_RE = re.compile(r"\s+")
+
+
+@dataclass(frozen=True)
+class Recurring:
+    memo_key: str
+    category: str
+    amount: int
+    months: tuple[str, ...]
+    last_day: date
+    day_of_month: int
+
+
+def _normalize_memo(memo: str) -> str:
+    s = unicodedata.normalize("NFKC", memo).lower()
+    s = _SPACE_RE.sub("", s)
+    return _SUFFIX_RE.sub("", s)
+
+
+def find_recurring(
+    rows: list[Expense],
+    *,
+    min_count: int = 3,
+    amount_tolerance: float = 0.1,
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError("min_count は 2 以上である必要があります")
+
+    # R1: 返金(amount <= 0)は除外し、(category, 正規化メモ) で系列化する
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        if e.amount <= 0:
+            continue
+        key = (e.category, _normalize_memo(e.memo))
+        groups.setdefault(key, []).append(e)
+
+    result: list[Recurring] = []
+    for (category, memo_key), items in groups.items():
+        # R2: 系列の中央値の ±tolerance 以内の行だけを同じ系列とみなす
+        median = statistics.median(e.amount for e in items)
+        series = [
+            e for e in items if abs(e.amount - median) <= amount_tolerance * median
+        ]
+
+        # R3: 月ごとに 1 件(日付の遅いほう)
+        latest_by_month: dict[str, Expense] = {}
+        for e in series:
+            m = e.day.strftime("%Y-%m")
+            prev = latest_by_month.get(m)
+            if prev is None or e.day > prev.day:
+                latest_by_month[m] = e
+        if len(latest_by_month) < min_count:
+            continue
+
+        months = tuple(sorted(latest_by_month))
+        picked = [latest_by_month[m] for m in months]
+        last = max(picked, key=lambda e: e.day)
+
+        # R4: 日の最頻値。同数なら大きいほう
+        counts = Counter(e.day.day for e in picked)
+        day_of_month = max(counts, key=lambda d: (counts[d], d))
+
+        result.append(
+            Recurring(
+                memo_key=memo_key,
+                category=category,
+                amount=last.amount,
+                months=months,
+                last_day=last.day,
+                day_of_month=day_of_month,
+            )
+        )
+
+    # R6: amount 降順、同点は memo_key、さらに category の昇順
+    result.sort(key=lambda r: (-r.amount, r.memo_key, r.category))
+    return result
+
+
+def next_due(r: Recurring) -> date:
+    # R5: last_day の翌月の day_of_month 日。存在しなければ月末に丸める
+    if r.last_day.month == 12:
+        year, month = r.last_day.year + 1, 1
+    else:
+        year, month = r.last_day.year, r.last_day.month + 1
+    last_of_month = calendar.monthrange(year, month)[1]
+    return date(year, month, min(r.day_of_month, last_of_month))
