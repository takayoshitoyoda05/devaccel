index 0000000..c700949
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,104 @@
+"""Dict-based search conditions over Expense rows (pure functions)."""
+
+from __future__ import annotations
+
+import unicodedata
+from datetime import date, datetime
+from typing import cast
+
+from kakeibo.core import Expense
+
+Cond = dict[str, object]
+
+_LEAVES = ("category", "amount_min", "amount_max", "memo", "since", "until")
+
+
+def _norm_memo(text: str) -> str:
+    """NFKC・小文字化・空白除去(末尾数字は除去しない)。"""
+    folded = unicodedata.normalize("NFKC", text).lower()
+    return "".join(ch for ch in folded if not ch.isspace())
+
+
+def _check_leaf(key: str, value: object) -> None:
+    if key == "category":
+        if isinstance(value, str):
+            return
+        if isinstance(value, list) and all(isinstance(v, str) for v in value):
+            return
+        raise ValueError(f"category は str かその list である必要があります: {value!r}")
+    if key in ("amount_min", "amount_max"):
+        if isinstance(value, bool) or not isinstance(value, int):
+            raise ValueError(f"{key} は int である必要があります: {value!r}")
+    elif key == "memo":
+        if not isinstance(value, str):
+            raise ValueError(f"memo は str である必要があります: {value!r}")
+    else:  # since / until
+        if not isinstance(value, date) or isinstance(value, datetime):
+            raise ValueError(f"{key} は date である必要があります: {value!r}")
+
+
+def _check(cond: object) -> None:
+    if not isinstance(cond, dict):
+        raise ValueError(f"条件は dict である必要があります: {cond!r}")  # noqa: TRY004 仕様どおり ValueError
+    for key, value in cond.items():
+        if key == "not":
+            _check(value)
+        elif key in ("and", "or"):
+            if not isinstance(value, list):
+                raise ValueError(f"{key} はリストである必要があります: {value!r}")
+            for sub in value:
+                _check(sub)
+        elif key in _LEAVES:
+            _check_leaf(key, value)
+        else:
+            raise ValueError(f"未知のキーです: {key!r}")
+    lo, hi = cond.get("amount_min"), cond.get("amount_max")
+    if isinstance(lo, int) and isinstance(hi, int) and lo > hi:
+        raise ValueError(f"amount_min ({lo}) > amount_max ({hi})")
+    since, until = cond.get("since"), cond.get("until")
+    if isinstance(since, date) and isinstance(until, date) and since > until:
+        raise ValueError(f"since ({since}) > until ({until})")
+
+
+def _match(e: Expense, cond: Cond) -> bool:
+    for key, value in cond.items():
+        if key == "and":
+            if not all(_match(e, c) for c in cast("list[Cond]", value)):
+                return False
+        elif key == "or":
+            if not any(_match(e, c) for c in cast("list[Cond]", value)):
+                return False
+        elif key == "not":
+            if _match(e, cast(Cond, value)):
+                return False
+        elif key == "category":
+            names = [value] if isinstance(value, str) else cast("list[str]", value)
+            if e.category.strip() not in [n.strip() for n in names]:
+                return False
+        elif key == "amount_min":
+            if e.amount < cast(int, value):
+                return False
+        elif key == "amount_max":
+            if e.amount > cast(int, value):
+                return False
+        elif key == "memo":
+            if _norm_memo(cast(str, value)) not in _norm_memo(e.memo):
+                return False
+        elif key == "since":
+            if e.day < cast(date, value):
+                return False
+        elif key == "until" and e.day > cast(date, value):
+            return False
+    return True
+
+
+def matches(e: Expense, cond: Cond) -> bool:
+    """e が条件 cond に一致するか。不正な条件は ValueError。"""
+    _check(cond)
+    return _match(e, cond)
+
+
+def search(rows: list[Expense], cond: Cond) -> list[Expense]:
+    """条件に一致する行を入力順のまま新しい list で返す。不正な条件は ValueError(行が空でも)。"""
+    _check(cond)
+    return [e for e in rows if _match(e, cond)]
