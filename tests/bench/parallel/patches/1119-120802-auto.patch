@@ -0,0 +1,204 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, next_due
+
+
+def ex(day: str, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+# E1-1: 家賃 80000 を 1/5・2/5・3/5、min_count=3 → 1 件、day_of_month=5、next_due=4/5
+def test_E1_1_rent_monthly_detected_and_next_due() -> None:
+    rows = [
+        ex("2026-01-05", "住居", 80000, "家賃"),
+        ex("2026-02-05", "住居", 80000, "家賃"),
+        ex("2026-03-05", "住居", 80000, "家賃"),
+    ]
+    result = find_recurring(rows, min_count=3)
+    assert len(result) == 1
+    r = result[0]
+    assert r.day_of_month == 5
+    assert r.months == ("2026-01", "2026-02", "2026-03")
+    assert next_due(r) == date(2026, 4, 5)
+
+
+# E1-2: メモ `Netflix 1`・`netflix２` の 3 か月 → 同じ系列 1 件
+def test_E1_2_memo_normalization_merges_series() -> None:
+    rows = [
+        ex("2026-01-10", "動画", 1490, "Netflix 1"),
+        ex("2026-02-10", "動画", 1490, "netflix２"),
+        ex("2026-03-10", "動画", 1490, "NETFLIX #3"),
+    ]
+    result = find_recurring(rows, min_count=3)
+    assert len(result) == 1
+    assert result[0].memo_key == "netflix"
+    assert result[0].months == ("2026-01", "2026-02", "2026-03")
+
+
+# E1-3: day_of_month=31、last_day=1/31 → next_due=2/28(閏年 2/29)
+@pytest.mark.parametrize(
+    ("year", "expected"),
+    [
+        pytest.param(2027, date(2027, 2, 28), id="E1-3"),
+        pytest.param(2028, date(2028, 2, 29), id="E1-3-leap"),
+    ],
+)
+def test_E1_3_next_due_clamps_to_month_end(year: int, expected: date) -> None:
+    r = Recurring(
+        memo_key="x",
+        category="c",
+        amount=100,
+        months=("2026-11", "2026-12", f"{year}-01"),
+        last_day=date(year, 1, 31),
+        day_of_month=31,
+    )
+    assert next_due(r) == expected
+
+
+def test_next_due_december_rolls_to_january() -> None:
+    r = Recurring(
+        "x", "c", 100, ("2026-10", "2026-11", "2026-12"), date(2026, 12, 15), 15
+    )
+    assert next_due(r) == date(2027, 1, 15)
+
+
+def test_recurring_is_frozen() -> None:
+    r = Recurring("x", "c", 100, ("2026-01",), date(2026, 1, 1), 1)
+    with pytest.raises(AttributeError):
+        r.amount = 200  # type: ignore[misc]
+
+
+def test_refund_rows_are_excluded() -> None:
+    # D1: amount <= 0 は定期検出から除外
+    rows = [
+        ex("2026-01-05", "住居", 80000, "家賃"),
+        ex("2026-02-05", "住居", 80000, "家賃"),
+        ex("2026-03-05", "住居", -80000, "家賃"),
+        ex("2026-03-06", "住居", 0, "家賃"),
+    ]
+    assert find_recurring(rows, min_count=3) == []
+
+
+def test_min_count_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+
+
+def test_min_count_boundary_is_inclusive() -> None:
+    rows = [ex("2026-01-05", "a", 100), ex("2026-02-05", "a", 100)]
+    assert len(find_recurring(rows, min_count=2)) == 1
+    assert find_recurring(rows, min_count=3) == []
+
+
+def test_gaps_in_months_are_allowed() -> None:
+    rows = [
+        ex("2026-01-05", "a", 100),
+        ex("2026-04-05", "a", 100),
+        ex("2026-09-05", "a", 100),
+    ]
+    result = find_recurring(rows, min_count=3)
+    assert len(result) == 1
+    assert result[0].months == ("2026-01", "2026-04", "2026-09")
+
+
+def test_same_month_keeps_latest_day_only() -> None:
+    rows = [
+        ex("2026-01-03", "a", 100),
+        ex("2026-01-20", "a", 100),
+        ex("2026-02-05", "a", 100),
+        ex("2026-03-05", "a", 100),
+    ]
+    result = find_recurring(rows, min_count=3)
+    assert len(result) == 1
+    assert result[0].months == ("2026-01", "2026-02", "2026-03")
+    assert result[0].last_day == date(2026, 3, 5)
+
+
+def test_amount_within_tolerance_joins_series_and_latest_amount_used() -> None:
+    # 中央値 1000、±10% 以内(900〜1100)は同じ系列。最新の金額を採る
+    rows = [
+        ex("2026-01-05", "a", 1000, "m"),
+        ex("2026-02-05", "a", 1050, "m"),
+        ex("2026-03-05", "a", 1100, "m"),
+    ]
+    result = find_recurring(rows, min_count=3)
+    assert len(result) == 1
+    assert result[0].amount == 1100
+
+
+def test_amount_outside_tolerance_is_dropped_not_split() -> None:
+    # 中央値 1000 の範囲外(1300)は別系列にせず捨てる → 残りは 2 か月で不足
+    rows = [
+        ex("2026-01-05", "a", 1000, "m"),
+        ex("2026-02-05", "a", 1000, "m"),
+        ex("2026-03-05", "a", 1300, "m"),
+    ]
+    assert find_recurring(rows, min_count=3) == []
+
+
+def test_different_category_is_different_series() -> None:
+    rows = [
+        ex("2026-01-05", "a", 100, "m"),
+        ex("2026-02-05", "b", 100, "m"),
+        ex("2026-03-05", "a", 100, "m"),
+    ]
+    assert find_recurring(rows, min_count=3) == []
+
+
+def test_empty_memo_uses_category_only_key() -> None:
+    rows = [
+        ex("2026-01-05", "水道", 3000),
+        ex("2026-02-05", "水道", 3000, "  "),
+        ex("2026-03-05", "水道", 3000),
+    ]
+    result = find_recurring(rows, min_count=3)
+    assert len(result) == 1
+    assert result[0].memo_key == ""
+    assert result[0].category == "水道"
+
+
+def test_day_of_month_mode_tie_prefers_larger() -> None:
+    rows = [
+        ex("2026-01-05", "a", 100),
+        ex("2026-02-10", "a", 100),
+        ex("2026-03-05", "a", 100),
+        ex("2026-04-10", "a", 100),
+    ]
+    result = find_recurring(rows, min_count=4)
+    assert len(result) == 1
+    assert result[0].day_of_month == 10
+
+
+def test_day_of_month_mode_picks_most_frequent() -> None:
+    rows = [
+        ex("2026-01-05", "a", 100),
+        ex("2026-02-05", "a", 100),
+        ex("2026-03-10", "a", 100),
+    ]
+    result = find_recurring(rows, min_count=3)
+    assert result[0].day_of_month == 5
+
+
+def test_output_sorted_by_amount_desc_then_memo_then_category() -> None:
+    rows = []
+    for m in ("2026-01", "2026-02", "2026-03"):
+        rows += [
+            ex(f"{m}-05", "b", 500, "zeta"),
+            ex(f"{m}-06", "a", 500, "alpha"),
+            ex(f"{m}-07", "a", 500, "beta"),
+            ex(f"{m}-08", "c", 9000, "x"),
+        ]
+    result = find_recurring(rows, min_count=3)
+    assert [(r.amount, r.memo_key, r.category) for r in result] == [
+        (9000, "x", "c"),
+        (500, "alpha", "a"),
+        (500, "beta", "a"),
+        (500, "zeta", "b"),
+    ]
