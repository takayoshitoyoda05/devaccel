+++ b/tests/test_search.py
@@ -0,0 +1,259 @@
+from __future__ import annotations
+
+from datetime import date, datetime
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import matches, search
+
+D = date(2026, 3, 10)
+
+
+def ex(
+    amount: int = 100,
+    category: str = "食費",
+    memo: str = "",
+    day: date = D,
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- 例の表(E3-1〜E3-3) ---
+
+
+@pytest.mark.parametrize(
+    ("rows", "cond", "expected"),
+    [
+        pytest.param([ex()], {"or": []}, 0, id="E3-1"),
+        pytest.param(
+            [ex(amount=100)], {"amount_min": 100, "amount_max": 100}, 1, id="E3-2"
+        ),
+    ],
+)
+def test_spec_examples(
+    rows: list[Expense], cond: dict[str, object], expected: int
+) -> None:
+    assert len(search(rows, cond)) == expected
+
+
+@pytest.mark.parametrize(
+    ("rows", "cond"),
+    [
+        pytest.param([], {"colour": "x"}, id="E3-3"),
+    ],
+)
+def test_spec_examples_raise(rows: list[Expense], cond: dict[str, object]) -> None:
+    with pytest.raises(ValueError, match="colour"):
+        search(rows, cond)
+
+
+# --- 葉の条件 ---
+
+
+def test_empty_cond_matches_all() -> None:
+    rows = [ex(), ex(amount=5, category="娯楽")]
+    assert search(rows, {}) == rows
+
+
+def test_category_exact_match_is_case_sensitive() -> None:
+    rows = [ex(category="食費"), ex(category="Food")]
+    assert search(rows, {"category": "食費"}) == [rows[0]]
+    assert search(rows, {"category": "food"}) == []
+
+
+def test_category_list_matches_any() -> None:
+    rows = [ex(category="食費"), ex(category="娯楽"), ex(category="交通")]
+    assert search(rows, {"category": ["食費", "交通"]}) == [rows[0], rows[2]]
+
+
+def test_category_condition_is_stripped() -> None:
+    rows = [ex(category="食費")]
+    assert search(rows, {"category": "  食費 "}) == rows
+
+
+def test_amount_min_is_inclusive() -> None:
+    rows = [ex(amount=99), ex(amount=100), ex(amount=101)]
+    assert search(rows, {"amount_min": 100}) == rows[1:]
+
+
+def test_amount_max_is_inclusive() -> None:
+    rows = [ex(amount=99), ex(amount=100), ex(amount=101)]
+    assert search(rows, {"amount_max": 100}) == rows[:2]
+
+
+def test_amount_range_both_bounds_inclusive() -> None:
+    rows = [ex(amount=99), ex(amount=100), ex(amount=5000), ex(amount=5001)]
+    assert search(rows, {"amount_min": 100, "amount_max": 5000}) == rows[1:3]
+
+
+def test_memo_partial_match_after_normalization() -> None:
+    rows = [ex(memo="セブン コンビニ"), ex(memo="スーパー")]
+    assert search(rows, {"memo": "コンビニ"}) == [rows[0]]
+
+
+def test_memo_nfkc_and_lowercase() -> None:
+    rows = [ex(memo="ＡＢＣ店")]
+    assert search(rows, {"memo": "abc"}) == rows
+    assert search(rows, {"memo": "ＡＢＣ"}) == rows
+
+
+def test_memo_whitespace_removed_on_both_sides() -> None:
+    rows = [ex(memo="ス ー パ ー")]
+    assert search(rows, {"memo": "スー パー"}) == rows
+
+
+def test_memo_trailing_digits_are_not_removed() -> None:
+    rows = [ex(memo="No.3")]
+    assert search(rows, {"memo": "no.3"}) == rows
+    assert search(rows, {"memo": "no3"}) == []
+
+
+def test_memo_empty_condition_matches_all() -> None:
+    rows = [ex(memo=""), ex(memo="x")]
+    assert search(rows, {"memo": ""}) == rows
+
+
+def test_since_until_inclusive() -> None:
+    rows = [
+        ex(day=date(2026, 2, 28)),
+        ex(day=date(2026, 3, 1)),
+        ex(day=date(2026, 3, 31)),
+        ex(day=date(2026, 4, 1)),
+    ]
+    assert (
+        search(rows, {"since": date(2026, 3, 1), "until": date(2026, 3, 31)})
+        == rows[1:3]
+    )
+
+
+def test_leaf_keys_in_one_dict_are_anded() -> None:
+    rows = [
+        ex(amount=500, category="食費"),
+        ex(amount=500, category="娯楽"),
+        ex(amount=10, category="食費"),
+    ]
+    assert search(rows, {"category": "食費", "amount_min": 100}) == [rows[0]]
+
+
+# --- 結合 ---
+
+
+def test_and_empty_is_true() -> None:
+    rows = [ex()]
+    assert search(rows, {"and": []}) == rows
+
+
+def test_and_combines_conditions() -> None:
+    rows = [ex(amount=50), ex(amount=150), ex(amount=250)]
+    assert search(rows, {"and": [{"amount_min": 100}, {"amount_max": 200}]}) == [
+        rows[1]
+    ]
+
+
+def test_or_combines_conditions() -> None:
+    rows = [ex(category="食費"), ex(category="娯楽"), ex(category="交通")]
+    assert search(rows, {"or": [{"category": "食費"}, {"category": "交通"}]}) == [
+        rows[0],
+        rows[2],
+    ]
+
+
+def test_not_inverts_condition() -> None:
+    rows = [ex(category="食費"), ex(category="娯楽")]
+    assert search(rows, {"not": {"category": "食費"}}) == [rows[1]]
+
+
+def test_nested_combinators() -> None:
+    rows = [
+        ex(amount=100, category="食費"),
+        ex(amount=900, category="食費"),
+        ex(amount=900, category="娯楽"),
+        ex(amount=100, category="娯楽"),
+    ]
+    cond: dict[str, object] = {
+        "not": {
+            "or": [
+                {"and": [{"category": "食費"}, {"amount_min": 500}]},
+                {"category": "娯楽", "amount_max": 100},
+            ]
+        }
+    }
+    assert search(rows, cond) == [rows[0], rows[2]]
+
+
+def test_mixed_leaf_and_combinator_keys_are_anded() -> None:
+    rows = [
