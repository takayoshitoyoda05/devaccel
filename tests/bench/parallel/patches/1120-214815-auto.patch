index 0000000..37d7582
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,80 @@
+"""Detect monthly recurring expenses (rent, subscriptions) and predict the next one."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+from statistics import median_low
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int  # yen, latest amount in the run
+    occurrences: int  # length of the consecutive-month run
+    last_date: date
+    next_date: date  # predicted next charge
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month - 1
+
+
+def _next_date(last: date, day: int) -> date:
+    idx = _month_index(last) + 1
+    year, month = divmod(idx, 12)
+    month += 1
+    return date(year, month, min(day, calendar.monthrange(year, month)[1]))
+
+
+def find_recurring(
+    rows: list[Expense], min_occurrences: int = 3, day_tolerance: int = 3
+) -> list[Recurring]:
+    """Find expenses charged once a month with a fixed amount on a stable day.
+
+    Rows are grouped by (category, memo). A group counts when its latest run of
+    consecutive calendar months has at least `min_occurrences` entries, with one
+    charge per month, the same amount, and days of month within `day_tolerance`
+    of each other. Groups with two charges in a month are not treated as fixed
+    costs. The next date is the month after the last one, on the median day
+    (clamped to the month's length). Result is sorted by next_date, then category.
+    """
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.memo.strip()), []).append(e)
+
+    out: list[Recurring] = []
+    for (category, memo), items in groups.items():
+        items = sorted(items, key=lambda e: e.day)
+        months = [_month_index(e.day) for e in items]
+        if len(set(months)) != len(months):
+            continue
+        run = [items[-1]]
+        for prev, cur in zip(reversed(items[:-1]), reversed(months[1:])):
+            if _month_index(prev.day) != cur - 1:
+                break
+            run.append(prev)
+        run.reverse()
+        if len(run) < min_occurrences:
+            continue
+        if len({e.amount for e in run}) != 1:
+            continue
+        days = [e.day.day for e in run]
+        if max(days) - min(days) > day_tolerance:
+            continue
+        last = run[-1]
+        out.append(
+            Recurring(
+                category=category,
+                memo=memo,
+                amount=last.amount,
+                occurrences=len(run),
+                last_date=last.day,
+                next_date=_next_date(last.day, median_low(days)),
+            )
+        )
+    return sorted(out, key=lambda r: (r.next_date, r.category, r.memo))
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..25cf98f
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,77 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring
+
+
+def _e(d, cat="rent", amount=80000, memo=""):
+    return Expense(date.fromisoformat(d), cat, amount, memo)
+
+
+def test_monthly_rent_detected_with_next_date():
+    rows = [_e("2026-09-02"), _e("2026-10-02"), _e("2026-11-02")]
+    assert find_recurring(rows) == [
+        Recurring("rent", "", 80000, 3, date(2026, 11, 2), date(2026, 12, 2))
+    ]
+
+
+def test_year_rollover():
+    rows = [
+        _e("2026-10-15", "net", 3000, "isp"),
+        _e("2026-11-15", "net", 3000, "isp"),
+        _e("2026-12-15", "net", 3000, "isp"),
+    ]
+    assert find_recurring(rows)[0].next_date == date(2027, 1, 15)
+
+
+def test_month_end_clamped():
+    rows = [_e("2026-11-30"), _e("2026-12-31"), _e("2027-01-31")]
+    assert find_recurring(rows)[0].next_date == date(2027, 2, 28)
+
+
+def test_too_few_occurrences():
+    assert find_recurring([_e("2026-10-02"), _e("2026-11-02")]) == []
+    assert (
+        len(find_recurring([_e("2026-10-02"), _e("2026-11-02")], min_occurrences=2))
+        == 1
+    )
+
+
+def test_gap_breaks_run():
+    rows = [_e("2026-06-02"), _e("2026-07-02"), _e("2026-09-02"), _e("2026-10-02")]
+    assert find_recurring(rows) == []
+
+
+def test_old_run_before_gap_ignored_but_latest_run_used():
+    rows = [_e("2026-01-02"), _e("2026-03-02"), _e("2026-04-02"), _e("2026-05-02")]
+    r = find_recurring(rows)
+    assert r[0].occurrences == 3 and r[0].next_date == date(2026, 6, 2)
+
+
+def test_varying_amount_rejected():
+    rows = [_e("2026-09-02"), _e("2026-10-02", amount=81000), _e("2026-11-02")]
+    assert find_recurring(rows) == []
+
+
+def test_unstable_day_rejected():
+    rows = [_e("2026-09-01"), _e("2026-10-15"), _e("2026-11-01")]
+    assert find_recurring(rows) == []
+
+
+def test_two_in_one_month_rejected():
+    rows = [_e("2026-09-02"), _e("2026-10-02"), _e("2026-11-02"), _e("2026-11-20")]
+    assert find_recurring(rows) == []
+
+
+def test_memo_separates_groups_and_sorted_by_next_date():
+    rows = [
+        _e(f"2026-{m:02d}-{d:02d}", "sub", 500, memo)
+        for m in (9, 10, 11)
+        for memo, d in (("music", 20), ("video", 5))
+    ]
+    r = find_recurring(rows)
+    assert [x.memo for x in r] == ["video", "music"]
+
+
+def test_empty():
+    assert find_recurring([]) == []
