diff --git a/tests/test_types/test_Choice.py b/tests/test_types/test_Choice.py
index c34f516..2528278 100644
--- a/tests/test_types/test_Choice.py
+++ b/tests/test_types/test_Choice.py
@@ -1,3 +1,5 @@
+import pytest
+
 import click
 
 
@@ -5,3 +7,56 @@ def test_choice_get_invalid_choice_message():
     choice = click.Choice(["a", "b", "c"])
     message = choice.get_invalid_choice_message("d", ctx=None)
     assert message == "'d' is not one of 'a', 'b', 'c'."
+
+
+@pytest.mark.parametrize(
+    ("value", "suffix"),
+    [
+        ("pus", "Did you mean 'push'?"),
+        ("decline", "(Did you mean one of: 'declare', 'refine'?)"),
+    ],
+)
+def test_choice_invalid_choice_suggests_close_matches(value, suffix):
+    choice = click.Choice(["push", "pull", "declare", "refine"])
+    message = choice.get_invalid_choice_message(value, ctx=None)
+    assert message.endswith(f" {suffix}")
+
+
+def test_choice_invalid_choice_no_suggestion_when_far():
+    choice = click.Choice(["push", "pull"])
+    message = choice.get_invalid_choice_message("zzzz", ctx=None)
+    assert "Did you mean" not in message
+
+
+def test_choice_suggestion_case_insensitive():
+    choice = click.Choice(["Push", "Pull"], case_sensitive=False)
+    message = choice.get_invalid_choice_message("PUS", ctx=None)
+    # Suggestions use the normalized form, which is what the user can type.
+    assert message.endswith("Did you mean 'push'?")
+
+
+def test_choice_suggestion_case_sensitive():
+    choice = click.Choice(["Push", "Pull"])
+    message = choice.get_invalid_choice_message("Pus", ctx=None)
+    assert message.endswith("Did you mean 'Push'?")
+
+
+def test_choice_suggestion_non_string_value():
+    choice = click.Choice(["10", "20"])
+    message = choice.get_invalid_choice_message(101, ctx=None)
+    assert message.endswith("Did you mean '10'?")
+
+
+def test_choice_suggestion_in_cli_error():
+    @click.command()
+    @click.option("--mode", type=click.Choice(["debug", "release"]))
+    def cli(mode):
+        pass
+
+    from click.testing import CliRunner
+
+    result = CliRunner().invoke(cli, ["--mode", "releas"])
+    assert result.exit_code == 2
+    assert "'releas' is not one of 'debug', 'release'. Did you mean 'release'?" in (
+        result.output
+    )
