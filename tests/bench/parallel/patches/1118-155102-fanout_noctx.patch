+def test_two_separate_runs_both_reported() -> None:
+    rows = [
+        e("2026-01-10"),
+        e("2026-02-10"),
+        e("2026-03-10"),
+        e("2026-06-10"),
+        e("2026-07-10"),
+        e("2026-08-10"),
