+# --- find_recurring: splitting into runs ------------------------------------
+
+
+def test_run_shorter_than_min_count_dropped_but_later_run_kept() -> None:
+    rows = [
+        e("2026-01-10"),
+        e("2026-02-10"),  # run of 2: dropped
+        e("2026-05-10"),  # gap breaks run
+        e("2026-06-10"),
+        e("2026-07-10"),  # run of 3: kept
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 5, 10), date(2026, 6, 10), date(2026, 7, 10))
+    assert result[0].next_expected == date(2026, 8, 10)
