+
+def test_beyond_tolerance_splits_run() -> None:
+    rows = [e("2026-01-10"), e("2026-02-14"), e("2026-03-10")]  # 4 days late
+    assert find_recurring(rows, tolerance=3) == []
+
+
+def test_early_by_tolerance_is_linked() -> None:
+    rows = [e("2026-01-10"), e("2026-02-07"), e("2026-03-10")]  # 3 days early
+    assert len(find_recurring(rows, tolerance=3)) == 1
+
+
+def test_zero_tolerance_requires_exact_day() -> None:
+    rows = [e("2026-01-10"), e("2026-02-11"), e("2026-03-10")]
+    assert find_recurring(rows, tolerance=0) == []
