+def test_link_uses_add_month_of_previous_date() -> None:
+    # 2026-01-31 -> expected 2026-02-28; 2026-03-01 is 1 day off from 02-28 only
+    # if measured against the clamped expectation, so it is linked.
+    rows = [e("2026-01-31"), e("2026-03-01"), e("2026-04-01")]
+    result = find_recurring(rows, tolerance=1)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 5, 1)
