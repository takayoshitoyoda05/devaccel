+def test_results_sorted_by_category_then_amount_then_first_day() -> None:
+    rows: list[Expense] = []
+    for cat, amt in [("娯楽", 500), ("通信", 2000), ("通信", 1000)]:
+        for m in (1, 2, 3):
+            rows.append(e(f"2026-{m:02d}-05", category=cat, amount=amt))
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [
+        ("娯楽", 500),
+        ("通信", 1000),
+        ("通信", 2000),
+    ]
+
