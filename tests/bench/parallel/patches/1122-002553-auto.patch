diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..d53810c 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -188,3 +188,93 @@ def test_path_type(runner, cls, expect):
 
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
+
+
+def _ext_cli(**kwargs):
+    return click.Command(
+        "cli",
+        params=[click.Option(["--p"], type=click.Path(**kwargs))],
+        callback=lambda p: p,
+    )
+
+
+@pytest.mark.parametrize(
+    "name", ["a.csv", "a.tsv", "A.CSV", "dir/b.Tsv", "x.y.csv", "a b.csv"]
+)
+def test_path_extensions_accepts(runner, name):
+    cli = _ext_cli(extensions=(".csv", ".tsv"))
+    result = runner.invoke(cli, ["--p", name], standalone_mode=False)
+    assert result.exception is None
+    assert result.return_value == name
+
+
+@pytest.mark.parametrize("name", ["a.txt", "a", "a.csv.bak", "csv", ".csv", "a.csv/"])
+def test_path_extensions_rejects(runner, name):
+    cli = _ext_cli(extensions=(".csv", ".tsv"))
+    result = runner.invoke(cli, ["--p", name])
+    assert result.exit_code == 2
+    assert "must have one of the extensions: .csv, .tsv" in result.output
+
+
+def test_path_extensions_normalized():
+    # Case-insensitive entries, leading dot optional, multi-part allowed.
+    path_type = click.Path(extensions=["CSV", ".Tar.GZ"])
+    assert path_type.extensions == (".csv", ".tar.gz")
+    assert path_type.convert("a.TAR.gz", None, None) == "a.TAR.gz"
+    with pytest.raises(click.BadParameter):
+        path_type.convert("a.gz", None, None)
+
+
+def test_path_extensions_checked_when_file_exists(tmp_path):
+    good = tmp_path / "a.CSV"
+    bad = tmp_path / "a.txt"
+    good.write_text("")
+    bad.write_text("")
+    path_type = click.Path(exists=True, extensions=[".csv"])
+    assert path_type.convert(str(good), None, None) == str(good)
+    with pytest.raises(click.BadParameter, match="extensions"):
+        path_type.convert(str(bad), None, None)
+
+
+def test_path_extensions_missing_file_still_checked(tmp_path):
+    # Output paths that do not exist yet are checked too.
+    path_type = click.Path(extensions=[".csv"])
+    with pytest.raises(click.BadParameter, match="extensions"):
+        path_type.convert(str(tmp_path / "new.txt"), None, None)
+
+
+def test_path_extensions_skips_directory_and_dash(tmp_path):
+    directory = tmp_path / "data"
+    directory.mkdir()
+    path_type = click.Path(allow_dash=True, extensions=[".csv"])
+    assert path_type.convert(str(directory), None, None) == str(directory)
+    assert path_type.convert("-", None, None) == "-"
+
+
+def test_path_extensions_bytes_and_pathlike():
+    path_type = click.Path(extensions=[".csv"])
+    assert path_type.convert(b"a.CSV", None, None) == b"a.CSV"
+    assert path_type.convert(pathlib.Path("a.csv"), None, None) == pathlib.Path("a.csv")
+    with pytest.raises(click.BadParameter):
+        path_type.convert(pathlib.Path("a.txt"), None, None)
+
+
+def test_path_extensions_default_unrestricted():
+    assert click.Path().extensions is None
+    assert click.Path().convert("a.anything", None, None) == "a.anything"
+
+
+@pytest.mark.parametrize(
+    ("value", "error"),
+    [
+        (".csv", TypeError),  # a bare string is not a sequence of entries
+        ([1], TypeError),
+        ([None], TypeError),
+        ([], ValueError),
+        ([""], ValueError),
+        ([".", ".csv"], ValueError),
+    ],
+)
+def test_path_extensions_invalid_argument(value, error):
+    with pytest.raises(error, match="extensions"):
+        click.Path(extensions=value)
