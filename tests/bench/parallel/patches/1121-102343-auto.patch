@@ -0,0 +1,104 @@
+"""Monthly per-category budget alerts (pure functions).
+
+Reuses ``core.Budget`` (limits per category, with per-month overrides) and the
+``monthly_totals`` shape ``{"YYYY-MM": {category: yen}}``.
+
+Decisions:
+D1: Budget is taken from ``kakeibo.core``; no second budget type is defined.
+D2: ``over`` = actual > limit. ``near`` = warn_percent% of the limit <= actual <= limit.
+    Exactly the limit is ``near`` (not yet exceeded).
+D3: ``warn_percent`` is an int in 1..100 (percent, integer arithmetic, so no float
+    rounding). bool / float / str / None -> TypeError; out of range -> ValueError.
+    100 means "warn only at exactly the limit".
+D4: A limit of 0 means "spend nothing": any actual > 0 is ``over``; actual 0 is no alert.
+D5: Categories with no budget, budgeted categories with no spending, and months absent
+    from the totals produce no alert (absent months are not treated as empty months).
+D6: Negative actual (refund-dominated) is simply below the limit: no alert.
+D7: Invalid limits (negative, bool, non-int) -> ValueError naming month/category.
+D8: Order: month ascending, ``over`` before ``near``, then larger actual first,
+    then category name (deterministic).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from kakeibo.core import Budget
+
+OVER = "over"
+NEAR = "near"
+
+
+@dataclass(frozen=True)
+class BudgetAlert:
+    month: str
+    category: str
+    status: str  # OVER or NEAR
+    limit: int
+    actual: int
+
+    @property
+    def over_by(self) -> int:
+        """Yen above the limit (0 unless status is OVER)."""
+        return max(0, self.actual - self.limit)
+
+    @property
+    def remaining(self) -> int:
+        """Yen left before the limit (0 once exceeded)."""
+        return max(0, self.limit - self.actual)
+
+
+def _check_percent(warn_percent: object) -> int:
+    if isinstance(warn_percent, bool) or not isinstance(warn_percent, int):
+        raise TypeError(f"warn_percent は整数である必要があります: {warn_percent!r}")
+    if not 1 <= warn_percent <= 100:
+        raise ValueError(f"warn_percent は 1〜100 である必要があります: {warn_percent}")
+    return warn_percent
+
+
+def classify(actual: int, limit: int, warn_percent: int = 80) -> str | None:
+    """Return OVER, NEAR or None for one category's actual vs. limit."""
+    pct = _check_percent(warn_percent)
+    if isinstance(limit, bool) or not isinstance(limit, int) or limit < 0:
+        raise ValueError(f"limit は 0 以上の整数である必要があります: {limit!r}")
+    if actual > limit:
+        return OVER
+    if actual > 0 and actual * 100 >= limit * pct:
+        return NEAR
+    return None
+
+
+def budget_alerts(
+    totals: dict[str, dict[str, int]], budget: Budget, warn_percent: int = 80
+) -> list[BudgetAlert]:
+    """Alerts for every (month, category) that is over or near its monthly budget."""
+    _check_percent(warn_percent)
+    out: list[BudgetAlert] = []
+    for month, cats in totals.items():
+        limits = budget.for_month(month)
+        for cat, actual in cats.items():
+            if cat not in limits:
+                continue
+            try:
+                status = classify(actual, limits[cat], warn_percent)
+            except ValueError:
+                raise ValueError(
+                    f"{month} {cat} の予算が不正です: {limits[cat]!r}"
+                ) from None
+            if status is not None:
+                out.append(BudgetAlert(month, cat, status, limits[cat], actual))
+    out.sort(key=lambda a: (a.month, a.status != OVER, -a.actual, a.category))
+    return out
+
+
+def format_alert(alert: BudgetAlert) -> str:
+    """One-line Japanese message for an alert."""
+    if alert.status == OVER:
+        return (
+            f"{alert.month} {alert.category}: 予算超過 "
+            f"{alert.actual:,}円 / {alert.limit:,}円(+{alert.over_by:,}円)"
+        )
+    return (
+        f"{alert.month} {alert.category}: 予算間近 "
+        f"{alert.actual:,}円 / {alert.limit:,}円(残り {alert.remaining:,}円)"
+    )
diff --git a/tests/test_budget_alerts.py b/tests/test_budget_alerts.py
new file mode 100644
index 0000000..43147ca
--- /dev/null
+++ b/tests/test_budget_alerts.py
@@ -0,0 +1,105 @@
+import pytest
+
+from kakeibo.budget_alerts import (
+    NEAR,
+    OVER,
+    BudgetAlert,
+    budget_alerts,
+    classify,
+    format_alert,
+)
+from kakeibo.core import Budget
+
+
+def test_over_near_and_ok():  # D2
+    b = Budget({"food": 1000, "rent": 80000, "fun": 1000}, {})
+    totals = {"2026-11": {"food": 1001, "rent": 64000, "fun": 799}}
+    got = budget_alerts(totals, b)
+    assert [(a.category, a.status) for a in got] == [("food", OVER), ("rent", NEAR)]
+
+
+def test_exactly_limit_is_near_and_threshold_inclusive():  # D2
+    assert classify(1000, 1000) == NEAR
+    assert classify(800, 1000) == NEAR
+    assert classify(799, 1000) is None
+    assert classify(1001, 1000) == OVER
+
+
+def test_percent_100_warns_only_at_limit():  # D3
+    assert classify(999, 1000, 100) is None
+    assert classify(1000, 1000, 100) == NEAR
+
+
+def test_integer_arithmetic_no_float_error():  # D3
+    assert classify(7, 10, 70) == NEAR
+
+
+@pytest.mark.parametrize("bad", [True, 80.0, "80", None])
+def test_percent_type_error(bad):  # D3
+    with pytest.raises(TypeError):
+        budget_alerts({}, Budget({}, {}), bad)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad", [0, -1, 101])
+def test_percent_range_error(bad):  # D3
+    with pytest.raises(ValueError, match="warn_percent"):
+        budget_alerts({}, Budget({}, {}), bad)
+
+
+def test_zero_limit():  # D4
+    assert classify(1, 0) == OVER
+    assert classify(0, 0) is None
+
+
+def test_unbudgeted_unspent_and_absent_months_ignored():  # D5
+    b = Budget({"food": 1000, "rent": 5}, {})
+    totals = {"2026-10": {"misc": 10**6}, "2026-12": {"food": 900}}
+    got = budget_alerts(totals, b)
+    assert [(a.month, a.category) for a in got] == [("2026-12", "food")]
+
+
+def test_refund_is_no_alert():  # D6
+    assert classify(-500, 1000) is None
+    assert budget_alerts({"2026-11": {"food": -500}}, Budget({"food": 1000}, {})) == []
+
+
+def test_month_override_used():  # D1
+    b = Budget({"food": 1000}, {"2026-11": {"food": 100}})
+    totals = {"2026-10": {"food": 500}, "2026-11": {"food": 500}}
+    got = budget_alerts(totals, b)
+    assert [(a.month, a.status) for a in got] == [("2026-11", OVER)]
+
+
+@pytest.mark.parametrize("limit", [-1, True, 1.5, "10"])
+def test_invalid_limit(limit):  # D7
+    with pytest.raises(ValueError, match="2026-11 food"):
+        budget_alerts({"2026-11": {"food": 5}}, Budget({"food": limit}, {}))  # type: ignore[dict-item]
+
+
+def test_ordering():  # D8
+    b = Budget({"a": 100, "b": 100, "c": 100, "d": 100}, {})
+    totals = {
+        "2026-12": {"a": 150},
+        "2026-11": {"a": 90, "b": 100, "c": 120, "d": 120},
+    }
+    got = budget_alerts(totals, b)
+    assert [(a.month, a.category, a.status) for a in got] == [
+        ("2026-11", "c", OVER),
+        ("2026-11", "d", OVER),
+        ("2026-11", "b", NEAR),
+        ("2026-11", "a", NEAR),
+        ("2026-12", "a", OVER),
+    ]
+
+
+def test_alert_amounts_and_format():
+    over = BudgetAlert("2026-11", "food", OVER, 1000, 1200)
+    near = BudgetAlert("2026-11", "food", NEAR, 1000, 900)
+    assert (over.over_by, over.remaining) == (200, 0)
+    assert (near.over_by, near.remaining) == (0, 100)
+    assert format_alert(over) == "2026-11 food: 予算超過 1,200円 / 1,000円(+200円)"
+    assert format_alert(near) == "2026-11 food: 予算間近 900円 / 1,000円(残り 100円)"
+
+
+def test_empty_totals():
+    assert budget_alerts({}, Budget({"food": 1}, {})) == []
