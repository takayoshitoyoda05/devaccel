--- /dev/null
+++ b/src/kakeibo/streak.py
@@ -0,0 +1,28 @@
+"""No-spend streak: longest run of consecutive days without any expense."""
+
+from __future__ import annotations
+
+from datetime import date, timedelta
+
+from kakeibo.core import Expense
+
+
+def longest_no_spend_streak(rows: list[Expense], start: date, end: date) -> int:
+    """start〜end(両端含む)で明細が 1 件もない日の最長連続日数を返す。
+
+    期間外の明細は無視する。start > end の場合は 0。
+    """
+    if start > end:
+        return 0
+    spend_days = {e.day for e in rows if start <= e.day <= end}
+    best = 0
+    current = 0
+    day = start
+    while day <= end:
+        if day in spend_days:
+            current = 0
+        else:
+            current += 1
+            best = max(best, current)
+        day += timedelta(days=1)
+    return best
diff --git a/src/kakeibo/topn.py b/src/kakeibo/topn.py
