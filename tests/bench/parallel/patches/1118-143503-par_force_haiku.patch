@@ -0,0 +1,19 @@
+"""Expense totals grouped by day of week."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+# Indexed by date.weekday() (Monday == 0). Fixed names, so output does not depend on locale.
+_WEEKDAYS = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
+
+
+def total_by_weekday(rows: list[Expense]) -> dict[str, int]:
+    """{"Mon".."Sun": yen}, Monday-first order; weekdays with no expenses are omitted."""
+    totals = [0] * 7
+    seen = [False] * 7
+    for e in rows:
+        idx = e.day.weekday()
+        totals[idx] += e.amount
+        seen[idx] = True
+    return {_WEEKDAYS[i]: totals[i] for i in range(7) if seen[i]}
