index 0000000..2e1f53d
--- /dev/null
+++ b/src/kakeibo/topn.py
@@ -0,0 +1,17 @@
+"""Top-N expense selection."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def top_expenses(rows: list[Expense], n: int) -> list[Expense]:
+    """Return up to n expenses, largest amount first.
+
+    Ties on amount are broken by earlier date first; ties on both keep input order.
+    Returns an empty list when n <= 0.
+    """
+    if n <= 0:
+        return []
+    ordered = sorted(rows, key=lambda e: (-e.amount, e.day))
+    return ordered[:n]
