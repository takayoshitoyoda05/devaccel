+import json
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.export import to_json
+
+
+def test_empty_list_is_empty_json_array() -> None:
+    assert to_json([]) == "[]"
+
+
+def test_single_row_exact_string_and_key_order() -> None:
+    rows = [Expense(date(2026, 1, 5), "食費", 1200, "ランチ")]
+    assert to_json(rows) == (
+        '[{"date": "2026-01-05", "category": "食費", "amount": 1200, "memo": "ランチ"}]'
+    )
+
+
+def test_keys_order_is_date_category_amount_memo() -> None:
+    rows = [Expense(date(2026, 2, 1), "交通", 300, "")]
+    parsed = json.loads(to_json(rows))
+    assert list(parsed[0].keys()) == ["date", "category", "amount", "memo"]
+
+
+def test_preserves_input_order() -> None:
+    rows = [
+        Expense(date(2026, 3, 2), "B", 2),
+        Expense(date(2026, 3, 1), "A", 1),
+    ]
+    parsed = json.loads(to_json(rows))
+    assert [p["category"] for p in parsed] == ["B", "A"]
+
+
+def test_non_ascii_not_escaped() -> None:
+    out = to_json([Expense(date(2026, 4, 1), "娯楽", 500, "映画")])
+    assert "娯楽" in out
+    assert "\\u" not in out
+
+
+def test_no_indentation() -> None:
+    out = to_json([Expense(date(2026, 4, 1), "食費", 1, "x")])
+    assert "\n" not in out
