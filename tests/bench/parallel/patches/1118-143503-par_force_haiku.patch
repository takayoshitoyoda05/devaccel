+import pytest
+
+from kakeibo.split import split_evenly
+
+
+def test_split_evenly_exact_division():
+    assert split_evenly(3000, 3) == [1000, 1000, 1000]
+
+
+def test_split_evenly_remainder_goes_to_first_people():
+    assert split_evenly(10, 3) == [4, 3, 3]
+    assert split_evenly(1001, 2) == [501, 500]
+
+
+def test_split_evenly_sum_matches_amount():
+    for amount in range(200):
+        for people in range(1, 9):
+            parts = split_evenly(amount, people)
+            assert len(parts) == people
+            assert sum(parts) == amount
+
+
+def test_split_evenly_single_person():
+    assert split_evenly(1234, 1) == [1234]
+
+
+def test_split_evenly_zero_amount():
+    assert split_evenly(0, 3) == [0, 0, 0]
+
+
+@pytest.mark.parametrize("people", [0, -1])
+def test_split_evenly_rejects_people_below_one(people):
+    with pytest.raises(ValueError):
+        split_evenly(100, people)
