@@ -0,0 +1,61 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.weekday import total_by_weekday
+
+
+def _e(day: date, amount: int) -> Expense:
+    return Expense(day=day, category="food", amount=amount)
+
+
+def test_empty_rows_returns_empty_dict():
+    assert total_by_weekday([]) == {}
+
+
+def test_sums_amounts_per_weekday():
+    # 2026-11-16 is a Monday, 2026-11-18 is a Wednesday.
+    rows = [
+        _e(date(2026, 11, 16), 1000),
+        _e(date(2026, 11, 23), 500),
+        _e(date(2026, 11, 18), 300),
+    ]
+    assert total_by_weekday(rows) == {"Mon": 1500, "Wed": 300}
+
+
+def test_keys_are_monday_first_regardless_of_input_order():
+    # 2026-11-22 Sun, 2026-11-17 Tue, 2026-11-16 Mon, 2026-11-21 Sat
+    rows = [
+        _e(date(2026, 11, 22), 7),
+        _e(date(2026, 11, 17), 2),
+        _e(date(2026, 11, 21), 6),
+        _e(date(2026, 11, 16), 1),
+    ]
+    result = total_by_weekday(rows)
+    assert list(result) == ["Mon", "Tue", "Sat", "Sun"]
+    assert result == {"Mon": 1, "Tue": 2, "Sat": 6, "Sun": 7}
+
+
+def test_all_seven_weekdays():
+    # 2026-11-16 (Mon) through 2026-11-22 (Sun)
+    rows = [_e(date(2026, 11, 16 + i), (i + 1) * 100) for i in range(7)]
+    assert total_by_weekday(rows) == {
+        "Mon": 100,
+        "Tue": 200,
+        "Wed": 300,
+        "Thu": 400,
+        "Fri": 500,
+        "Sat": 600,
+        "Sun": 700,
+    }
+
+
+def test_zero_amount_still_included():
+    rows = [_e(date(2026, 11, 16), 0)]
+    assert total_by_weekday(rows) == {"Mon": 0}
+
+
+def test_does_not_mutate_input():
+    rows = [_e(date(2026, 11, 16), 10)]
+    before = list(rows)
+    total_by_weekday(rows)
+    assert rows == before
