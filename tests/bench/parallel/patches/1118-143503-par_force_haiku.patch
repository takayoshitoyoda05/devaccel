+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.dupes import find_duplicates
+
+
+def _e(day: int, cat: str = "food", amount: int = 100, memo: str = "") -> Expense:
+    return Expense(day=date(2026, 1, day), category=cat, amount=amount, memo=memo)
+
+
+def test_empty_and_no_duplicates() -> None:
+    assert find_duplicates([]) == []
+    assert find_duplicates([_e(1), _e(2), _e(1, amount=200)]) == []
+
+
+def test_simple_pair() -> None:
+    assert find_duplicates([_e(1), _e(2), _e(1)]) == [(0, 2)]
+
+
+def test_all_fields_must_match() -> None:
+    rows = [
+        _e(1, memo="a"),
+        _e(1, memo="b"),
+        _e(1, cat="rent", memo="a"),
+        _e(1, amount=101, memo="a"),
+        _e(2, memo="a"),
+    ]
+    assert find_duplicates(rows) == []
+
+
+def test_ordering_across_groups_and_triples() -> None:
+    rows = [
+        _e(1),  # 0
+        _e(2),  # 1
+        _e(1),  # 2
+        _e(2),  # 3
+        _e(1),  # 4
+    ]
+    assert find_duplicates(rows) == [(0, 2), (0, 4), (1, 3), (2, 4)]
+
+
+def test_pairs_sorted_by_i_then_j() -> None:
+    rows = [_e(5), _e(3), _e(3), _e(5)]
+    assert find_duplicates(rows) == [(0, 3), (1, 2)]
