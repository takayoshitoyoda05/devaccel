+++ b/tests/test_statement.py
@@ -0,0 +1,214 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import CsvError, Expense
+from kakeibo.statement import parse_statement
+
+
+def _amount(raw: str) -> int:
+    (e,) = parse_statement(f"日付,金額\n2026-01-05,{raw}\n")
+    return e.amount
+
+
+def _errors(text: str) -> list[tuple[int, str]]:
+    with pytest.raises(CsvError) as ei:
+        parse_statement(text)
+    return ei.value.errors
+
+
+def test_basic_and_category():
+    got = parse_statement(
+        "date,amount,memo\n2026-01-05,1200, lunch \n", category="食費"
+    )
+    assert got == [Expense(date(2026, 1, 5), "食費", 1200, "lunch")]
+    assert got[0].category == "食費"
+
+
+@pytest.mark.parametrize(
+    "raw,want",
+    [
+        ("1,234円", 1234),
+        ("￥１，２３４", 1234),
+        ("JPY 1234", 1234),
+        ("jpy1234", 1234),
+        ("¥ 1,234", 1234),
+        ("1234.0", 1234),
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("+700", 700),
+        ("0", 0),
+    ],
+)
+def test_amount_formats(raw, want):
+    if "," in raw and '"' not in raw:
+        raw = f'"{raw}"'
+    assert _amount(raw) == want
+
+
+@pytest.mark.parametrize(
+    "raw", ["12.5", "abc", "1,23", "△-5", "(5", "1 2.5", "12,34,567"]
+)
+def test_bad_amounts(raw):
+    errs = _errors(f'日付,金額\n2026-01-05,"{raw}"\n')
+    assert errs[0][0] == 2
+    assert "金額" in errs[0][1] and repr(raw) in errs[0][1]
+
+
+@pytest.mark.parametrize("raw", ["", "-", "—"])
+def test_single_amount_empty_is_error(raw):
+    errs = _errors(f"日付,金額\n2026-01-05,{raw}\n")
+    assert errs == [(2, f"金額: 金額がありません: {raw!r}")]
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026/1/5",
+        "2026-01-05",
+        "2026.1.5",
+        "2026年1月5日",
+        "20260105",
+        "２０２６／１／５",
+        "2026-01-05 12:30:45",
+        "2026/01/05 9:05",
+    ],
+)
+def test_date_formats(raw):
+    (e,) = parse_statement(f'日付,金額\n"{raw}",1\n')
+    assert e.day == date(2026, 1, 5)
+
+
+@pytest.mark.parametrize(
+    "raw", ["2026/02/30", "2026-1/5", "R8.1.5", "26/1/5", "", "2026-13-01"]
+)
+def test_bad_dates(raw):
+    errs = _errors(f'日付,金額\n"{raw}",1\n')
+    assert errs[0][0] == 2 and "日付" in errs[0][1] and repr(raw) in errs[0][1]
+
+
+def test_nonexistent_date_message():
+    assert "存在しない" in _errors("日付,金額\n2026/2/30,1\n")[0][1]
+
+
+def test_leap_day():
+    assert parse_statement("日付,金額\n2024-02-29,1\n")[0].day == date(2024, 2, 29)
+
+
+def test_header_aliases_case_space_fullwidth():
+    text = "　取引日 ,ご利用金額,ご利用店名\n2026-01-05,100,店\n"
+    assert parse_statement(text) == [Expense(date(2026, 1, 5), "未分類", 100, "店")]
+    assert parse_statement("DATE, Amount ,MEMO\n2026-01-05,1,x\n")[0].memo == "x"
+
+
+def test_memo_column_optional():
+    assert parse_statement("日付,金額\n2026-01-05,1\n")[0].memo == ""
+
+
+def test_leftmost_alias_wins():
+    got = parse_statement("日付,摘要,メモ,金額\n2026-01-05,A,B,1\n")
+    assert got[0].memo == "A"
+
+
+def test_missing_required_columns():
+    errs = _errors("日付,摘要\n2026-01-05,x\n")
+    assert errs[0][0] == 1 and "金額または出金" in errs[0][1] and "摘要" in errs[0][1]
+    errs = _errors("金額\n1\n")
+    assert errs[0][0] == 1 and "日付" in errs[0][1]
+    assert _errors("日付,入金\n2026-01-05,1\n")[0][0] == 1
+
+
+def test_split_columns_withdraw_deposit():
+    text = "取引日,摘要,出金,入金\n2026-01-05,A,1000,\n2026-01-06,給与,,300000\n2026-01-07,B,-,\n"
+    assert _errors(text) == [(4, "出金: 出金も入金も空です: '-'")]
+    ok = '取引日,摘要,出金,入金\n2026-01-05,A,"1,000",\n2026-01-06,給与,,300000\n2026-01-07,B,0,200\n'
+    got = parse_statement(ok)
+    assert [(e.memo, e.amount) for e in got] == [("A", 1000), ("B", 0)]
+
+
+def test_split_columns_both_values_is_error():
+    errs = _errors("日付,出金,入金\n2026-01-05,100,200\n")
+    assert errs == [(2, "出金: 出金と入金の両方に値があります: '100'")]
+
+
+def test_split_columns_without_deposit_column():
+    assert parse_statement("日付,支払\n2026-01-05,100\n")[0].amount == 100
+
+
+def test_split_deposit_invalid_reported():
+    errs = _errors("日付,出金,入金\n2026-01-05,,abc\n")
+    assert errs[0][0] == 2 and "入金" in errs[0][1]
+
+
+def test_amount_column_beats_split_columns():
+    got = parse_statement("日付,金額,出金,入金\n2026-01-05,5,9,9\n")
+    assert got[0].amount == 5
+
+
+def test_all_errors_on_row_reported_with_columns_and_values():
+    errs = _errors("日付,金額\nxx,yy\n2026-01-05,1\nzz,3\n")
+    assert [n for n, _ in errs] == [2, 2, 4]
+    assert errs[0][1] == "日付: 日付の書式が不正です: 'xx'"
+    assert errs[1][1] == "金額: 金額が整数として読めません: 'yy'"
+
+
+def test_wrong_column_count_unquoted_comma():
+    errs = _errors("日付,金額\n2026-01-05,1,234円\n")
+    assert len(errs) == 1 and errs[0][0] == 2 and "3 列" in errs[0][1]
+    assert len(_errors("日付,金額\n2026-01-05\n")) == 1
+
+
+def test_line_numbers_use_record_start_with_quoted_newlines():
+    text = '日付,金額,メモ\n2026-01-05,1,"a\nb"\nbad,2,x\n'
+    assert _errors(text) == [(4, "日付: 日付の書式が不正です: 'bad'")]
+    assert parse_statement('日付,金額,メモ\n2026-01-05,1,"a\nb"\n')[0].memo == "a\nb"
+
+
+def test_quoted_delimiter_in_memo():
+    got = parse_statement('日付,金額,摘要\n2026-01-05,1,"A,B"\n')
+    assert got[0].memo == "A,B"
+
+
+def test_tab_separated_and_bom_and_crlf_cr():
+    assert parse_statement('﻿日付\t金額\r\n2026-01-05\t"1,200"\r\n')[0].amount == 1200
+    assert len(parse_statement("日付,金額\r2026-01-05,1\r2026-01-06,2\r")) == 2
+
+
+def test_blank_lines_skipped_and_header_only():
+    assert parse_statement("日付,金額\n\n2026-01-05,1\n,\n\n") == [
+        Expense(date(2026, 1, 5), "未分類", 1)
+    ]
+    assert parse_statement("日付,金額\n") == []
+    assert parse_statement("日付,金額") == []
+
+
+@pytest.mark.parametrize("text", ["", "  \n\n"])
+def test_empty_input_is_error(text):
+    assert _errors(text) == [(1, "入力が空です(ヘッダー行がありません)")]
+
+
+def test_refund_kept_negative_and_totals_flow():
+    got = parse_statement("日付,金額\n2026-01-05,1000\n2026-01-06,△300\n")
+    assert [e.amount for e in got] == [1000, -300]
+
+
+@pytest.mark.parametrize("bad", [None, b"x", 1, ["a"]])
+def test_text_type(bad):
+    with pytest.raises(TypeError):
+        parse_statement(bad)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad", [None, 1, True, b"x"])
+def test_category_type(bad):
+    with pytest.raises(TypeError):
+        parse_statement("日付,金額\n", category=bad)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad", ["", "  ", "　"])
+def test_category_value(bad):
+    with pytest.raises(ValueError, match="category"):
+        parse_statement("日付,金額\n", category=bad)
