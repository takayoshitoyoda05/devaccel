+"""Tests for kakeibo.budget_status.evaluate_month."""
+
+from __future__ import annotations
+
+import math
+
+import pytest
+
+from kakeibo.budget_status import BudgetStatus, evaluate_month
+
+
+# 仕様の例の表 (E1-1 ... E1-3) をそのまま写す。
+@pytest.mark.parametrize(
+    ("actuals", "limits", "projected", "level", "margin"),
+    [
+        ({"食費": 40000}, {"食費": 40000}, None, "warn", 0),
+        ({"食費": 10000}, {"食費": 30000}, {"食費": 35000}, "forecast", 20000),
+        ({"交通": 5}, {"交通": 0}, None, "over", -5),
+    ],
+    ids=["E1-1", "E1-2", "E1-3"],
+)
+def test_spec_examples(actuals, limits, projected, level, margin):
+    [status] = evaluate_month(actuals, limits, projected=projected)
+    assert status.level == level
+    assert status.margin == margin
+
+
+# --- D1: over / warn の境界 ---
+
+
+def test_over_is_strictly_greater_than_limit():
+    [status] = evaluate_month({"食費": 30001}, {"食費": 30000})
+    assert status.level == "over"
+    assert status.margin == -1
+
+
+def test_warn_at_exact_ratio_boundary():
+    # 10000 * 0.8 = 8000 ちょうどは warn
+    [status] = evaluate_month({"食費": 8000}, {"食費": 10000})
+    assert status.level == "warn"
+
+
+def test_just_below_ratio_boundary_is_ok():
+    [status] = evaluate_month({"食費": 7999}, {"食費": 10000})
+    assert status.level == "ok"
+
+
+def test_warn_ratio_one_warns_only_at_limit():
+    [at_limit] = evaluate_month({"食費": 10000}, {"食費": 10000}, warn_ratio=1)
+    [below] = evaluate_month({"食費": 9999}, {"食費": 10000}, warn_ratio=1)
+    assert at_limit.level == "warn"
+    assert below.level == "ok"
+
+
+def test_warn_comparison_is_exact_for_decimal_ratio():
+    # 0.1 は float では誤差があるが、10 * 0.1 = 1 ちょうどで warn になること
+    [status] = evaluate_month({"x": 1}, {"x": 10}, warn_ratio=0.1)
+    assert status.level == "warn"
+
+
+# --- D3: 上限 0 ---
+
+
+def test_zero_limit_and_zero_actual_is_ok_not_warn():
+    [status] = evaluate_month({"交通": 0}, {"交通": 0})
+    assert status.level == "ok"
+    assert status.margin == 0
+
+
+def test_zero_limit_and_negative_actual_is_ok():
+    [status] = evaluate_month({"交通": -300}, {"交通": 0})
+    assert status.level == "ok"
+    assert status.margin == 300
+
+
+# --- D2: 負の実績・型・負の上限 ---
+
+
+def test_negative_actual_from_refund_is_accepted_as_ok():
+    [status] = evaluate_month({"食費": -100}, {"食費": 1000})
+    assert status.level == "ok"
+    assert status.margin == 1100
+
+
+@pytest.mark.parametrize("bad", [True, 1.0, "100", None])
+def test_actual_value_wrong_type_raises_type_error(bad):
+    with pytest.raises(TypeError, match="actuals"):
+        evaluate_month({"食費": bad}, {"食費": 1000})
+
+
+@pytest.mark.parametrize("bad", [True, 1.0, "1000", None])
+def test_limit_value_wrong_type_raises_type_error(bad):
+    with pytest.raises(TypeError, match="limits"):
+        evaluate_month({"食費": 0}, {"食費": bad})
+
+
+@pytest.mark.parametrize("bad", [True, 1.0, "100"])
+def test_projected_value_wrong_type_raises_type_error(bad):
+    with pytest.raises(TypeError, match="projected"):
+        evaluate_month({"食費": 0}, {"食費": 1000}, projected={"食費": bad})
+
+
+def test_non_str_category_key_raises_type_error():
+    with pytest.raises(TypeError):
+        evaluate_month({1: 0}, {"食費": 1000})  # type: ignore[dict-item]
+    with pytest.raises(TypeError):
+        evaluate_month({"食費": 0}, {1: 1000})  # type: ignore[dict-item]
+
+
+def test_negative_limit_raises_value_error():
+    with pytest.raises(ValueError, match="limits"):
+        evaluate_month({"食費": 0}, {"食費": -1})
+
+
+# --- R1: warn_ratio の受け付け・拒否 ---
+
+
+@pytest.mark.parametrize("ratio", [0.8, 0.5, 1, 1.0, 0.01])
+def test_valid_warn_ratio_accepted(ratio):
+    evaluate_month({"食費": 0}, {"食費": 1000}, warn_ratio=ratio)
+
+
+@pytest.mark.parametrize("ratio", [0, -0.5, 1.01, math.nan])
+def test_out_of_range_warn_ratio_raises_value_error(ratio):
+    with pytest.raises(ValueError, match="warn_ratio"):
+        evaluate_month({"食費": 0}, {"食費": 1000}, warn_ratio=ratio)
+
+
+@pytest.mark.parametrize("ratio", [True, "0.8", None])
+def test_non_numeric_warn_ratio_raises_type_error(ratio):
+    with pytest.raises(TypeError, match="warn_ratio"):
+        evaluate_month({"食費": 0}, {"食費": 1000}, warn_ratio=ratio)
+
+
+# --- R3 / D5: forecast ---
+
+
+def test_forecast_over_limit_when_not_yet_over():
+    [status] = evaluate_month({"食費": 0}, {"食費": 1000}, projected={"食費": 1001})
+    assert status.level == "forecast"
+
+
+def test_projected_equal_to_limit_is_not_forecast():
+    [status] = evaluate_month({"食費": 0}, {"食費": 1000}, projected={"食費": 1000})
+    assert status.level == "ok"
+
+
+def test_forecast_wins_over_warn():
+    [status] = evaluate_month({"食費": 900}, {"食費": 1000}, projected={"食費": 1200})
+    assert status.level == "forecast"
+
+
+def test_over_wins_over_forecast():
+    [status] = evaluate_month({"食費": 1500}, {"食費": 1000}, projected={"食費": 2000})
+    assert status.level == "over"
+
+
+def test_no_forecast_when_projected_is_none_or_missing_category():
+    [a] = evaluate_month({"食費": 0}, {"食費": 1000}, projected=None)
+    [b] = evaluate_month({"食費": 0}, {"食費": 1000}, projected={"交通": 5000})
+    assert a.level == "ok"
+    assert b.level == "ok"
+
+
+# --- D4: 対象カテゴリ ---
+
+
+def test_actual_category_without_budget_is_not_reported():
+    result = evaluate_month({"食費": 0, "娯楽": 99999}, {"食費": 1000})
+    assert [s.category for s in result] == ["食費"]
+
+
+def test_budget_category_without_spending_is_reported_as_zero_ok():
+    [status] = evaluate_month({}, {"住居": 80000})
+    assert status == BudgetStatus(
+        category="住居", limit=80000, actual=0, level="ok", margin=80000
+    )
+
+
+# --- R2 / D6: 並び ---
+
+
+def test_sort_by_level_then_slack_then_name():
+    limits = {
+        "ov_big": 100,
+        "ov_small": 100,
+        "fc": 100,
+        "warn_b": 100,
+        "warn_a": 100,
+        "ok": 100,
+    }
+    actuals = {
+        "ov_big": 300,
+        "ov_small": 120,
+        "fc": 10,
+        "warn_b": 85,
+        "warn_a": 85,
+        "ok": 0,
+    }
+    result = evaluate_month(actuals, limits, projected={"fc": 150})
+    assert [s.category for s in result] == [
+        "ov_small",  # over, 超過額 20
+        "ov_big",  # over, 超過額 200
+        "fc",  # forecast
+        "warn_a",  # warn, 余裕 15, 同点は名前順
+        "warn_b",
+        "ok",
+    ]
+
+
+# --- R4 / 基本 ---
+
+
+def test_empty_limits_returns_empty_list():
+    assert evaluate_month({"食費": 5000}, {}) == []
+
+
+def test_inputs_are_not_mutated():
+    actuals = {"食費": 100}
+    limits = {"食費": 1000, "交通": 500}
+    projected = {"食費": 2000}
+    evaluate_month(actuals, limits, projected=projected)
+    assert actuals == {"食費": 100}
+    assert limits == {"食費": 1000, "交通": 500}
+    assert projected == {"食費": 2000}
