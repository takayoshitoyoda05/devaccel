index 0000000..d09c5a7
--- /dev/null
+++ b/src/kakeibo/budget_status.py
@@ -0,0 +1,99 @@
+"""Per-category monthly budget status: over / forecast / warn / ok.
+
+Pure functions only: no I/O. Budget values are plain dicts (``dict[str, int]``),
+as returned by ``kakeibo.core.Budget.for_month``.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from fractions import Fraction
+
+_RANK = {"over": 0, "forecast": 1, "warn": 2, "ok": 3}
+
+
+@dataclass(frozen=True)
+class BudgetStatus:
+    category: str
+    limit: int
+    actual: int
+    level: str  # "over" | "forecast" | "warn" | "ok"
+    margin: int  # limit - actual; negative when over
+
+
+def _check_int(value: object, where: str) -> int:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{where} は int である必要があります: {value!r}")
+    return value
+
+
+def _check_str_key(key: object, where: str) -> str:
+    if not isinstance(key, str):
+        raise TypeError(f"{where} のキーは str である必要があります: {key!r}")
+    return key
+
+
+def _warn_fraction(warn_ratio: object) -> Fraction:
+    if isinstance(warn_ratio, bool) or not isinstance(warn_ratio, (int, float)):
+        raise TypeError(f"warn_ratio は数値である必要があります: {warn_ratio!r}")
+    # nan は比較が偽になるので、この検査で弾かれる。
+    if not 0 < warn_ratio <= 1:
+        raise ValueError(
+            f"warn_ratio は 0 < warn_ratio <= 1 である必要があります: {warn_ratio!r}"
+        )
+    # str 経由で厳密な有理数にする (float の二進誤差を持ち込まない)。
+    return Fraction(str(warn_ratio))
+
+
+def evaluate_month(
+    actuals: dict[str, int],
+    limits: dict[str, int],
+    warn_ratio: float = 0.8,
+    projected: dict[str, int] | None = None,
+) -> list[BudgetStatus]:
+    """Judge each budgeted category for one month.
+
+    - over: actual > limit
+    - forecast: not over, and projected month-end > limit
+    - warn: not over, limit > 0, and actual >= limit * warn_ratio
+    - ok: otherwise
+
+    Only categories in ``limits`` are reported. Results are sorted by level
+    (over > forecast > warn > ok), then by slack (least slack first; for over,
+    the overrun amount), then by category name.
+    """
+    ratio = _warn_fraction(warn_ratio)
+
+    for cat, amount in actuals.items():
+        _check_str_key(cat, "actuals")
+        _check_int(amount, f"actuals[{cat!r}]")
+    for cat, limit in limits.items():
+        _check_str_key(cat, "limits")
+        _check_int(limit, f"limits[{cat!r}]")
+        if limit < 0:
+            raise ValueError(f"limits[{cat!r}] は 0 以上である必要があります: {limit}")
+    if projected is not None:
+        for cat, amount in projected.items():
+            _check_int(amount, f"projected[{cat!r}]")
+
+    found: list[tuple[tuple[int, int, str], BudgetStatus]] = []
+    for cat, limit in limits.items():
+        actual = actuals.get(cat, 0)
+        margin = limit - actual
+        if actual > limit:
+            level = "over"
+        elif projected is not None and cat in projected and projected[cat] > limit:
+            level = "forecast"
+        elif limit > 0 and actual >= limit * ratio:
+            level = "warn"
+        else:
+            level = "ok"
+        # 同レベル内は余裕の少ない順 (over は超過額の昇順)、同点はカテゴリ名順。
+        slack = -margin if level == "over" else margin
+        status = BudgetStatus(
+            category=cat, limit=limit, actual=actual, level=level, margin=margin
+        )
+        found.append(((_RANK[level], slack, cat), status))
+
+    found.sort(key=lambda item: item[0])
+    return [status for _, status in found]
diff --git a/tests/test_budget_projection.py b/tests/test_budget_projection.py
new file mode 100644
index 0000000..5921840
--- /dev/null
+++ b/tests/test_budget_projection.py
@@ -0,0 +1,105 @@
+from datetime import date, datetime
+
+import pytest
+
+from kakeibo.budget_projection import project_month_end
+
+
+# 例の表(E2-1 〜 E2-3)
+@pytest.mark.parametrize(
+    ("actuals", "today", "expected"),
+    [
+        pytest.param({"食費": 10000}, date(2026, 11, 10), {"食費": 30000}, id="E2-1"),
+        pytest.param({"食費": 10001}, date(2026, 11, 3), {"食費": 100010}, id="E2-2"),
+        pytest.param({"食費": -500}, date(2026, 11, 15), {"食費": 0}, id="E2-3"),
+    ],
+)
+def test_spec_examples(actuals, today, expected):
+    assert project_month_end(actuals, today) == expected
+
+
+# R1: 日割り線形 + 床除算
+def test_floor_division_truncates():
+    # 11/3 は 30 日の月で 10001 * 30 // 3 = 100010 (割り切れる)
+    # 11/4: 10001 * 30 // 4 = 75007 (切り捨て)
+    assert project_month_end({"食費": 10001}, date(2026, 11, 4)) == {"食費": 75007}
+
+
+# R1: 負の実績は 0 を下限にする
+def test_negative_actual_clamped_to_zero():
+    assert project_month_end({"食費": -1}, date(2026, 11, 1)) == {"食費": 0}
+
+
+# R1: 実績 0 は 0
+def test_zero_actual_projects_zero():
+    assert project_month_end({"食費": 0}, date(2026, 11, 10)) == {"食費": 0}
+
+
+# R2: 月末日は実績そのまま(負は 0)
+def test_month_end_returns_actual():
+    assert project_month_end({"食費": 12345}, date(2026, 11, 30)) == {"食費": 12345}
+
+
+def test_month_end_negative_clamped_to_zero():
+    assert project_month_end({"食費": -700}, date(2026, 11, 30)) == {"食費": 0}
+
+
+# 閏年 2024-02 は 29 日
+def test_leap_year_february_has_29_days():
+    # 2 日で 1000 → 1000 * 29 // 2 = 14500
+    assert project_month_end({"食費": 1000}, date(2024, 2, 2)) == {"食費": 14500}
+
+
+def test_leap_year_february_month_end_is_29():
+    assert project_month_end({"食費": 500}, date(2024, 2, 29)) == {"食費": 500}
+
+
+def test_non_leap_february_has_28_days():
+    # 2026-02-28 は月末
+    assert project_month_end({"食費": 500}, date(2026, 2, 28)) == {"食費": 500}
+
+
+# R4: 空 dict は空 dict
+def test_empty_actuals_returns_empty():
+    assert project_month_end({}, date(2026, 11, 10)) == {}
+
+
+# 入力を変更しない
+def test_input_not_mutated():
+    actuals = {"食費": 10000, "交通費": -300}
+    snapshot = dict(actuals)
+    project_month_end(actuals, date(2026, 11, 10))
+    assert actuals == snapshot
+
+
+# 返す dict のキー順は入力順
+def test_key_order_preserved():
+    actuals = {"食費": 100, "交通費": 200, "娯楽": 300}
+    result = project_month_end(actuals, date(2026, 11, 10))
+    assert list(result) == ["食費", "交通費", "娯楽"]
+
+
+# R3: today は date のみ。datetime は date のサブクラスだが TypeError
+def test_datetime_today_rejected():
+    with pytest.raises(TypeError):
+        project_month_end({"食費": 100}, datetime(2026, 11, 10))
+
+
+@pytest.mark.parametrize("bad_today", ["2026-11-10", None, 20261110])
+def test_non_date_today_rejected(bad_today):
+    with pytest.raises(TypeError):
+        project_month_end({"食費": 100}, bad_today)
+
+
+# D2: 値の型検査(実績は負も可だが bool/float/str/None は TypeError)
+@pytest.mark.parametrize("bad_value", [True, 1.5, "100", None])
+def test_non_int_actual_rejected(bad_value):
+    with pytest.raises(TypeError, match="食費"):
+        project_month_end({"食費": bad_value}, date(2026, 11, 10))
+
+
+# キーは str でなければ TypeError
+@pytest.mark.parametrize("bad_key", [1, None, b"food"])
+def test_non_str_key_rejected(bad_key):
+    with pytest.raises(TypeError):
+        project_month_end({bad_key: 100}, date(2026, 11, 10))
