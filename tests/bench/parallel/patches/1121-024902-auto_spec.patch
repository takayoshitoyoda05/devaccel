@@ -0,0 +1,37 @@
+"""カテゴリ別の月末予測(日割り線形)。純粋関数のみ。"""
+
+import calendar
+from datetime import date
+
+
+def _check_int(name: str, value: object) -> None:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{name} must be int, got {type(value).__name__}")
+
+
+def project_month_end(actuals: dict[str, int], today: date) -> dict[str, int]:
+    """各カテゴリの月末予測を返す。
+
+    予測 = actual * days_in_month // elapsed (elapsed = today.day)。
+    負の結果は 0 に下限を設ける。today が月末日なら予測 = max(0, actual)。
+    """
+    # datetime は date のサブクラスなので type() で厳密に弾く
+    if type(today) is not date:
+        raise TypeError(f"today must be date, got {type(today).__name__}")
+
+    for key, value in actuals.items():
+        if not isinstance(key, str):
+            raise TypeError(f"category key must be str, got {type(key).__name__}")
+        _check_int(f"actual for {key!r}", value)
+
+    days_in_month = calendar.monthrange(today.year, today.month)[1]
+    elapsed = today.day
+
+    result: dict[str, int] = {}
+    for key, actual in actuals.items():
+        if elapsed == days_in_month:
+            projected = actual
+        else:
+            projected = actual * days_in_month // elapsed
+        result[key] = max(0, projected)
+    return result
