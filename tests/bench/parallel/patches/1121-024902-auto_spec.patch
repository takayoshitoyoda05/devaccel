+"""予算アラートの通知文を作る純粋関数。
+
+入力は (category, level, limit, actual) の素の tuple。判定自体は行わない。
+"""
+
+from __future__ import annotations
+
+import re
+
+_LEVELS = ("over", "forecast", "warn", "ok")
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+def _check_int(value: object, name: str) -> int:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{name} は int である必要があります: {value!r}")
+    return value
+
+
+def _check_month(month: object) -> str:
+    if month is None:
+        return ""
+    if not isinstance(month, str):
+        raise TypeError(f"month は str である必要があります: {month!r}")
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"month は YYYY-MM 形式である必要があります: {month!r}")
+    return f"{month} "
+
+
+def format_alerts(
+    rows: list[tuple[str, str, int, int]], month: str | None = None
+) -> list[str]:
+    """各行を通知文にする。ok は出さず、入力順を保つ。"""
+    prefix = _check_month(month)
+    lines: list[str] = []
+    for category, level, limit, actual in rows:
+        if level not in _LEVELS:
+            raise ValueError(f"level は {_LEVELS} のいずれかです: {level!r}")
+        _check_int(limit, "limit")
+        _check_int(actual, "actual")
+        if limit < 0:
+            raise ValueError(f"limit は負にできません: {limit!r}")
+
+        if level == "ok":
+            continue
+        if level == "over":
+            lines.append(
+                f"{prefix}{category}: 予算超過 {actual - limit:,}円"
+                f"(予算 {limit:,}円 / 使用 {actual:,}円)"
+            )
+        elif level == "forecast":
+            lines.append(
+                f"{prefix}{category}: このままでは超過しそう"
+                f"(予算 {limit:,}円 / 使用 {actual:,}円)"
+            )
+        else:  # warn
+            if limit == 0:
+                raise ValueError(f"limit は warn では 0 にできません: {limit!r}")
+            pct = actual * 100 // limit
+            lines.append(
+                f"{prefix}{category}: 予算の {pct}% に達しました"
+                f"(予算 {limit:,}円 / 使用 {actual:,}円)"
+            )
+    return lines
diff --git a/src/kakeibo/budget_status.py b/src/kakeibo/budget_status.py
