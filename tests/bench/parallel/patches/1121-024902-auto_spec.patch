@@ -0,0 +1,185 @@
+from typing import Any
+
+import pytest
+
+from kakeibo.budget_report import format_alerts
+
+
+# 例の表 E3-1〜E3-3 (仕様どおり)
+@pytest.mark.parametrize(
+    ("rows", "month", "expected"),
+    [
+        pytest.param(
+            [("食費", "over", 30000, 32500)],
+            "2026-11",
+            ["2026-11 食費: 予算超過 2,500円(予算 30,000円 / 使用 32,500円)"],
+            id="E3-1",
+        ),
+        pytest.param(
+            [("交通", "ok", 5000, 100)],
+            None,
+            [],
+            id="E3-2",
+        ),
+        pytest.param(
+            [("交通", "warn", 5000, 4000)],
+            None,
+            ["交通: 予算の 80% に達しました(予算 5,000円 / 使用 4,000円)"],
+            id="E3-3",
+        ),
+    ],
+)
+def test_spec_examples(rows, month, expected):
+    assert format_alerts(rows, month) == expected
+
+
+# 端のケース (仕様の文面から)
+def test_empty_rows_returns_empty_list():
+    assert format_alerts([]) == []
+
+
+def test_ok_only_returns_empty_list():
+    assert format_alerts([("食費", "ok", 1000, 0), ("娯楽", "ok", 0, 0)]) == []
+
+
+def test_forecast_format():
+    assert format_alerts([("娯楽", "forecast", 10000, 6000)]) == [
+        "娯楽: このままでは超過しそう(予算 10,000円 / 使用 6,000円)"
+    ]
+
+
+def test_forecast_with_month_prefix():
+    assert format_alerts([("娯楽", "forecast", 10000, 6000)], "2026-01") == [
+        "2026-01 娯楽: このままでは超過しそう(予算 10,000円 / 使用 6,000円)"
+    ]
+
+
+def test_over_line_with_zero_excess_is_rendered_as_given():
+    # level は呼び出し側が決める。over が渡されたら超過額 0円 でもそのまま行にする
+    assert format_alerts([("食費", "over", 1000, 1000)]) == [
+        "食費: 予算超過 0円(予算 1,000円 / 使用 1,000円)"
+    ]
+
+
+def test_warn_pct_is_floor_of_integer_division():
+    # 2 / 3 = 66.66...% -> 66
+    assert format_alerts([("食費", "warn", 3, 2)]) == [
+        "食費: 予算の 66% に達しました(予算 3円 / 使用 2円)"
+    ]
+
+
+def test_order_is_kept_as_input():
+    rows = [
+        ("b", "warn", 1000, 800),
+        ("a", "over", 1000, 1500),
+        ("c", "forecast", 1000, 500),
+    ]
+    out = format_alerts(rows)
+    assert [line.split(":")[0] for line in out] == ["b", "a", "c"]
+
+
+def test_ok_rows_are_skipped_among_others():
+    rows = [("食費", "ok", 1000, 10), ("交通", "warn", 1000, 900)]
+    assert format_alerts(rows) == [
+        "交通: 予算の 90% に達しました(予算 1,000円 / 使用 900円)"
+    ]
+
+
+def test_negative_actual_is_accepted_for_ok_and_warn():
+    # 返金で実績が負になりうる
+    assert format_alerts([("食費", "ok", 1000, -500)]) == []
+
+
+def test_large_amounts_use_thousands_separator():
+    assert format_alerts([("家賃", "over", 1_000_000, 1_234_567)]) == [
+        "家賃: 予算超過 234,567円(予算 1,000,000円 / 使用 1,234,567円)"
+    ]
+
+
+# 検査 (R3)
+@pytest.mark.parametrize(
+    "rows",
+    [
+        [("食費", "danger", 1000, 2000)],
+        [("食費", "OVER", 1000, 2000)],
+        [("食費", None, 1000, 2000)],
+    ],
+)
+def test_bad_level_raises_value_error(rows):
+    with pytest.raises(ValueError, match="level"):
+        format_alerts(rows)
+
+
+@pytest.mark.parametrize(
+    "row",
+    [
+        ("食費", "over", True, 2000),
+        ("食費", "over", 1000, True),
+        ("食費", "over", 1000.0, 2000),
+        ("食費", "over", 1000, 2000.0),
+        ("食費", "over", "1000", 2000),
+        ("食費", "over", 1000, None),
+        ("食費", "ok", None, 0),
+    ],
+)
+def test_non_int_amount_raises_type_error(row):
+    bad: Any = [row]  # 型外の値を意図的に渡す
+    with pytest.raises(TypeError):
+        format_alerts(bad)
+
+
+def test_type_error_message_names_the_argument():
+    with pytest.raises(TypeError, match="limit"):
+        bad_limit: Any = [("食費", "over", 1.5, 2000)]
+        format_alerts(bad_limit)
+    with pytest.raises(TypeError, match="actual"):
+        bad_actual: Any = [("食費", "over", 1000, 2.0)]
+        format_alerts(bad_actual)
+
+
+def test_negative_limit_raises_value_error():
+    with pytest.raises(ValueError, match="limit"):
+        format_alerts([("食費", "ok", -1, 0)])
+
+
+def test_zero_limit_warn_raises_value_error():
+    with pytest.raises(ValueError, match="limit"):
+        format_alerts([("食費", "warn", 0, 0)])
+
+
+def test_zero_limit_over_is_allowed():
+    assert format_alerts([("食費", "over", 0, 100)]) == [
+        "食費: 予算超過 100円(予算 0円 / 使用 100円)"
+    ]
+
+
+@pytest.mark.parametrize(
+    "month",
+    [
+        "2026-13",
+        "2026-00",
+        "2026-1",
+        "26-11",
+        "2026/11",
+        "2026-11 ",
+        "２０２６-11",
+        "",
+        "2026-011",
+    ],
+)
+def test_bad_month_raises_value_error(month):
+    with pytest.raises(ValueError, match="month"):
+        format_alerts([("食費", "over", 1, 2)], month)
+
+
+@pytest.mark.parametrize("month", ["2026-01", "2026-12"])
+def test_month_boundaries_accepted(month):
+    assert format_alerts([("食費", "over", 1, 2)], month) == [
+        f"{month} 食費: 予算超過 1円(予算 1円 / 使用 2円)"
+    ]
+
+
+@pytest.mark.parametrize("month", [202611, 11, b"2026-11"])
+def test_non_str_month_raises_type_error(month):
+    with pytest.raises(TypeError, match="month"):
+        format_alerts([("食費", "over", 1, 2)], month)
