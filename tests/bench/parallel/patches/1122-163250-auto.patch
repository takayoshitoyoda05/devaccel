diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..1a2a528 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -186,5 +186,114 @@ def test_path_type(runner, cls, expect):
     assert result.return_value == expect
 
 
+@pytest.mark.parametrize(
+    "name",
+    ["a.csv", "a.TSV", "A.Csv", "dir.x/a.csv", "a.b.tsv"],
+)
+@pytest.mark.parametrize(
+    "extensions", [[".csv", ".tsv"], ["csv", "TSV"], (".CSV", ".tsv")]
+)
+def test_path_extensions_accepted(name, extensions):
+    assert click.Path(extensions=extensions).convert(name, None, None) == name
+
+
+@pytest.mark.parametrize(
+    "name", ["a.txt", "a", "a.csv.bak", "acsv", ".csv", "a.csv/", "dir.csv/", ""]
+)
+def test_path_extensions_rejected(name):
+    with pytest.raises(click.BadParameter, match="extensions .csv, .tsv"):
+        click.Path(extensions=[".csv", ".TSV"]).convert(name, None, None)
+
+
+def test_path_extensions_multi_dot():
+    t_ = click.Path(extensions=[".tar.gz"])
+    assert t_.convert("a.TAR.GZ", None, None) == "a.TAR.GZ"
+
+    with pytest.raises(click.BadParameter):
+        t_.convert("a.gz", None, None)
+
+
+def test_path_extensions_bytes_and_pathlike():
+    assert click.Path(extensions=[".csv"]).convert(b"a.CSV", None, None) == b"a.CSV"
+    t_ = click.Path(extensions=[".csv"], path_type=pathlib.Path)
+    assert t_.convert(pathlib.Path("a.csv"), None, None) == pathlib.Path("a.csv")
+
+    with pytest.raises(click.BadParameter):
+        t_.convert(pathlib.Path("a.txt"), None, None)
+
+
+def test_path_extensions_existing_file(tmp_path):
+    good = tmp_path / "a.csv"
+    bad = tmp_path / "a.txt"
+    good.touch()
+    bad.touch()
+    t_ = click.Path(exists=True, extensions=[".csv"])
+    assert t_.convert(os.fspath(good), None, None) == os.fspath(good)
+
+    with pytest.raises(click.BadParameter, match="extensions"):
+        t_.convert(os.fspath(bad), None, None)
+
+
+def test_path_extensions_missing_file_is_checked(tmp_path):
+    # Without ``exists``, a file that is not there yet is still checked.
+    t_ = click.Path(extensions=[".csv"])
+
+    with pytest.raises(click.BadParameter, match="extensions"):
+        t_.convert(os.fspath(tmp_path / "out.txt"), None, None)
+
+
+def test_path_extensions_exists_error_comes_first(tmp_path):
+    t_ = click.Path(exists=True, extensions=[".csv"])
+
+    with pytest.raises(click.BadParameter, match="does not exist"):
+        t_.convert(os.fspath(tmp_path / "missing.txt"), None, None)
+
+
+def test_path_extensions_skips_directory(tmp_path):
+    folder = tmp_path / "data.txt"
+    folder.mkdir()
+    t_ = click.Path(extensions=[".csv"])
+    assert t_.convert(os.fspath(folder), None, None) == os.fspath(folder)
+
+
+def test_path_extensions_skips_dash():
+    assert click.Path(allow_dash=True, extensions=[".csv"]).convert("-", None, None)
+
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions=[".csv"]).convert("-", None, None)
+
+
+def test_path_extensions_default_unchanged():
+    assert click.Path().extensions is None
+    assert click.Path().convert("a.anything", None, None) == "a.anything"
+
+
+@pytest.mark.parametrize("extensions", [[], (), [""], ["."], [".csv", ""], ["..."]])
+def test_path_extensions_invalid_value(extensions):
+    with pytest.raises(ValueError, match="extensions"):
+        click.Path(extensions=extensions)
+
+
+@pytest.mark.parametrize("extensions", [".csv", b".csv"])
+def test_path_extensions_bare_string_rejected(extensions):
+    with pytest.raises(TypeError, match="extensions"):
+        click.Path(extensions=extensions)  # type: ignore[arg-type]
+
+
+def test_path_extensions_cli(runner):
+    @click.command()
+    @click.option("--file", type=click.Path(extensions=[".csv", ".tsv"]))
+    def cli(file):
+        click.echo(file)
+
+    ok = runner.invoke(cli, ["--file", "x.CSV"])
+    assert ok.exit_code == 0
+    assert ok.output == "x.CSV\n"
+
+    bad = runner.invoke(cli, ["--file", "x.json"])
+    assert bad.exit_code == 2
+    assert "must have one of the extensions .csv, .tsv" in bad.output
+
+
 def test_path_converted_type_parameter_at_runtime():
