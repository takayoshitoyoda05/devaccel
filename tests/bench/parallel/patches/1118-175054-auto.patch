@@ -0,0 +1,68 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.dupes import find_duplicates
+
+A = Expense(date(2024, 1, 5), "食費", 1200, "lunch")
+
+
+def test_empty_list_has_no_duplicates() -> None:
+    assert find_duplicates([]) == []
+
+
+def test_single_row_has_no_duplicates() -> None:
+    assert find_duplicates([A]) == []
+
+
+def test_two_identical_rows() -> None:
+    assert find_duplicates([A, A]) == [(0, 1)]
+
+
+def test_three_identical_rows_yields_all_pairs() -> None:
+    assert find_duplicates([A, A, A]) == [(0, 1), (0, 2), (1, 2)]
+
+
+def test_non_adjacent_duplicates_ordered_by_i_then_j() -> None:
+    b = Expense(date(2024, 1, 6), "交通費", 300, "")
+    # indices: 0=A, 1=B, 2=A, 3=B, 4=A
+    assert find_duplicates([A, b, A, b, A]) == [
+        (0, 2),
+        (0, 4),
+        (1, 3),
+        (2, 4),
+    ]
+
+
+def test_pairs_within_one_group_sorted_by_i_then_j() -> None:
+    # 0=A, 1=A, 2=B, 3=A  -> (0,1), (0,3), (1,3)
+    b = Expense(date(2024, 2, 1), "娯楽", 500, "")
+    assert find_duplicates([A, A, b, A]) == [(0, 1), (0, 3), (1, 3)]
+
+
+@pytest.mark.parametrize(
+    "other",
+    [
+        Expense(date(2024, 1, 6), "食費", 1200, "lunch"),  # day differs
+        Expense(date(2024, 1, 5), "交通費", 1200, "lunch"),  # category differs
+        Expense(date(2024, 1, 5), "食費", 1201, "lunch"),  # amount differs
+        Expense(date(2024, 1, 5), "食費", 1200, "dinner"),  # memo differs
+        Expense(date(2024, 1, 5), "食費", 1200, ""),  # memo empty vs not
+    ],
+)
+def test_rows_differing_in_any_field_are_not_duplicates(other: Expense) -> None:
+    assert find_duplicates([A, other]) == []
+
+
+def test_category_and_memo_comparison_is_exact() -> None:
+    lower = Expense(date(2024, 1, 5), "food", 1200, "Lunch")
+    upper = Expense(date(2024, 1, 5), "food", 1200, "lunch")
+    assert find_duplicates([lower, upper]) == []
+
+
+def test_amount_zero_and_day_are_compared_too() -> None:
+    z1 = Expense(date(2024, 3, 1), "食費", 0, "")
+    z2 = Expense(date(2024, 3, 2), "食費", 0, "")
+    assert find_duplicates([z1, z2]) == []
+    assert find_duplicates([z1, z1]) == [(0, 1)]
diff --git a/tests/test_export.py b/tests/test_export.py
new file mode 100644
index 0000000..1e8b119
--- /dev/null
+++ b/tests/test_export.py
@@ -0,0 +1,57 @@
+import json
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.export import to_json
+
+
+def test_empty_list_is_empty_json_array() -> None:
+    assert to_json([]) == "[]"
+
+
+def test_single_row_keys_in_order_and_values() -> None:
+    rows = [Expense(date(2024, 3, 5), "食費", 1200, "ランチ")]
+    assert to_json(rows) == (
+        '[{"date": "2024-03-05", "category": "食費", "amount": 1200, "memo": "ランチ"}]'
+    )
+
+
+def test_keeps_input_order_and_does_not_sort() -> None:
+    rows = [
+        Expense(date(2024, 5, 1), "b", 1),
+        Expense(date(2024, 1, 1), "a", 2),
+    ]
+    parsed = json.loads(to_json(rows))
+    assert [r["date"] for r in parsed] == ["2024-05-01", "2024-01-01"]
+
+
+def test_empty_memo_is_kept_as_empty_string() -> None:
+    rows = [Expense(date(2024, 1, 2), "交通費", 300)]
+    assert json.loads(to_json(rows)) == [
+        {"date": "2024-01-02", "category": "交通費", "amount": 300, "memo": ""}
+    ]
+
+
+def test_non_ascii_is_not_escaped() -> None:
+    out = to_json([Expense(date(2024, 1, 2), "食費", 1, "コーヒー")])
+    assert "食費" in out
+    assert "\\u" not in out
+
+
+def test_no_indentation_or_newlines() -> None:
+    out = to_json(
+        [Expense(date(2024, 1, 2), "a", 1), Expense(date(2024, 1, 3), "b", 2)]
+    )
+    assert "\n" not in out
+
+
+def test_special_characters_are_escaped_as_json() -> None:
+    rows = [Expense(date(2024, 1, 2), 'a"b', 1, "line1\nline2")]
+    assert json.loads(to_json(rows))[0]["category"] == 'a"b'
+    assert json.loads(to_json(rows))[0]["memo"] == "line1\nline2"
+
+
+def test_amount_is_integer_not_string() -> None:
+    rows = [Expense(date(2024, 1, 2), "a", 0, "")]
+    assert json.loads(to_json(rows))[0]["amount"] == 0
+    assert isinstance(json.loads(to_json(rows))[0]["amount"], int)
