+"""JSON export of expense records."""
+
+from __future__ import annotations
+
+import json
+
+from kakeibo.core import Expense
+
+
+def to_json(rows: list[Expense]) -> str:
+    """Serialize rows (in input order) as a compact JSON array string."""
+    records = [
+        {
+            "date": e.day.isoformat(),
+            "category": e.category,
+            "amount": e.amount,
+            "memo": e.memo,
+        }
+        for e in rows
+    ]
+    return json.dumps(records, ensure_ascii=False)
