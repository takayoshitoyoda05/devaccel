+++ b/src/kakeibo/streak.py
@@ -0,0 +1,30 @@
+"""No-spend streak calculation."""
+
+from __future__ import annotations
+
+from datetime import date, timedelta
+
+from kakeibo.core import Expense
+
+
+def longest_no_spend_streak(rows: list[Expense], start: date, end: date) -> int:
+    """Longest run of consecutive days in [start, end] with no expense record.
+
+    Both ends are inclusive. Records outside the period are ignored. A day
+    counts as spending if at least one record exists for it, regardless of
+    amount. Returns 0 when start is after end.
+    """
+    if start > end:
+        return 0
+    spent = {e.day for e in rows if start <= e.day <= end}
+    best = 0
+    run = 0
+    day = start
+    while day <= end:
+        if day in spent:
+            run = 0
+        else:
+            run += 1
+            best = max(best, run)
+        day += timedelta(days=1)
+    return best
diff --git a/src/kakeibo/topn.py b/src/kakeibo/topn.py
new file mode 100644
index 0000000..b1b3ecf
--- /dev/null
+++ b/src/kakeibo/topn.py
@@ -0,0 +1,18 @@
+"""Top-N expense selection."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def top_expenses(rows: list[Expense], n: int) -> list[Expense]:
+    """Return up to n expenses, largest amount first.
+
+    Ties on amount are broken by earlier day; ties on both keep input order.
+    Returns [] when n <= 0. The input list is not modified.
+    """
+    if n <= 0:
+        return []
+    # sorted() is stable, so equal (amount, day) keep their input order.
+    ordered = sorted(rows, key=lambda e: (-e.amount, e.day))
+    return ordered[:n]
