+++ b/src/kakeibo/stats.py
@@ -0,0 +1,28 @@
+"""Descriptive statistics over expense records."""
+
+from __future__ import annotations
+
+from collections import defaultdict
+
+from kakeibo.core import Expense
+
+
+def median_by_category(rows: list[Expense]) -> dict[str, float]:
+    """{category: median amount}; keys in ascending category name order.
+
+    The median of an even number of amounts is the mean of the two middle ones.
+    Returns {} for empty input.
+    """
+    by_cat: dict[str, list[int]] = defaultdict(list)
+    for e in rows:
+        by_cat[e.category].append(e.amount)
+    out: dict[str, float] = {}
+    for cat in sorted(by_cat):
+        values = sorted(by_cat[cat])
+        n = len(values)
+        mid = n // 2
+        if n % 2:
+            out[cat] = float(values[mid])
+        else:
+            out[cat] = (values[mid - 1] + values[mid]) / 2
+    return out
