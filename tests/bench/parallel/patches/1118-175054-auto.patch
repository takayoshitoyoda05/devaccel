+++ b/src/kakeibo/weekday.py
@@ -0,0 +1,17 @@
+"""Aggregate expenses by day of the week."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+# Monday-first order. Fixed names so the output does not depend on locale.
+_WEEKDAYS: tuple[str, ...] = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
+
+
+def total_by_weekday(rows: list[Expense]) -> dict[str, int]:
+    """{"Mon".."Sun": yen}; weekdays with no rows are omitted, keys Monday-first."""
+    sums: dict[str, int] = {}
+    for e in rows:
+        name = _WEEKDAYS[e.day.weekday()]
+        sums[name] = sums.get(name, 0) + e.amount
+    return {name: sums[name] for name in _WEEKDAYS if name in sums}
