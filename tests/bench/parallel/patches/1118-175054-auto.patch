+from kakeibo.fmt import yen
+
+
+def test_formats_with_thousands_separator_and_yen_suffix() -> None:
+    assert yen(1234567) == "1,234,567円"
+
+
+def test_zero_has_no_separator() -> None:
+    assert yen(0) == "0円"
+
+
+def test_three_digits_have_no_separator() -> None:
+    assert yen(999) == "999円"
+
+
+def test_boundary_at_one_thousand() -> None:
+    assert yen(1000) == "1,000円"
+
+
+def test_negative_amount_keeps_sign_in_front() -> None:
+    assert yen(-1200) == "-1,200円"
+
+
+def test_negative_small_amount() -> None:
+    assert yen(-5) == "-5円"
+
+
+def test_large_amount() -> None:
+    assert yen(10**12) == "1,000,000,000,000円"
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..af56988
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,231 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def E(d: str, cat: str, amt: int) -> Expense:
+    return Expense(date.fromisoformat(d), cat, amt)
+
+
+def test_basic_up_row() -> None:
+    rows = [E("2024-01-05", "food", 1000), E("2024-02-05", "food", 1300)]
+    assert month_diff(rows, "2024-01", "2024-02") == [
+        DiffRow("food", 1000, 1300, 300, 30.0, "up")
+    ]
+
+
+def test_down_status_and_negative_pct() -> None:
+    rows = [E("2024-01-05", "food", 1000), E("2024-02-05", "food", 800)]
+    (r,) = month_diff(rows, "2024-01", "2024-02")
+    assert (r.delta, r.status, r.pct) == (-200, "down", -20.0)
+
+
+def test_same_status_when_delta_zero() -> None:
+    rows = [E("2024-01-05", "food", 1000), E("2024-02-05", "food", 1000)]
+    (r,) = month_diff(rows, "2024-01", "2024-02")
+    assert (r.delta, r.status, r.pct) == (0, "same", 0.0)
+
+
+def test_new_category_has_none_pct() -> None:
+    rows = [E("2024-02-05", "book", 500)]
+    assert month_diff(rows, "2024-01", "2024-02") == [
+        DiffRow("book", 0, 500, 500, None, "new")
+    ]
+
+
+def test_gone_category_is_minus_100_percent() -> None:
+    rows = [E("2024-01-05", "book", 800)]
+    assert month_diff(rows, "2024-01", "2024-02") == [
+        DiffRow("book", 800, 0, -800, -100.0, "gone")
+    ]
+
+
+def test_status_uses_entry_presence_not_sum() -> None:
+    # prev sums to 0 but has entries -> not "new"; pct None because prev == 0
+    rows = [
+        E("2024-01-05", "food", 500),
+        E("2024-01-06", "food", -500),
+        E("2024-02-05", "food", 200),
+    ]
+    (r,) = month_diff(rows, "2024-01", "2024-02")
+    assert (r.prev, r.pct, r.status) == (0, None, "up")
+
+
+def test_curr_sum_zero_with_entries_is_down_not_gone() -> None:
+    rows = [
+        E("2024-01-05", "food", 300),
+        E("2024-02-05", "food", 100),
+        E("2024-02-06", "food", -100),
+    ]
+    (r,) = month_diff(rows, "2024-01", "2024-02")
+    assert (r.curr, r.delta, r.pct, r.status) == (0, -300, -100.0, "down")
+
+
+def test_zero_amount_entry_counts_as_present() -> None:
+    rows = [E("2024-01-05", "food", 0), E("2024-02-05", "food", 0)]
+    (r,) = month_diff(rows, "2024-01", "2024-02")
+    assert r.status == "same"
+
+
+def test_pct_is_rounded_to_one_decimal() -> None:
+    rows = [E("2024-01-05", "food", 3000), E("2024-02-05", "food", 3100)]
+    (r,) = month_diff(rows, "2024-01", "2024-02")
+    assert r.pct == 3.3
+
+
+def test_negative_tiny_change_rounds_to_zero_not_negative_zero() -> None:
+    rows = [E("2024-01-05", "food", 10000), E("2024-02-05", "food", 9999)]
+    (r,) = month_diff(rows, "2024-01", "2024-02")
+    assert r.status == "down"
+    assert r.pct == 0.0
+    assert str(r.pct) == "0.0"
+
+
+def test_other_months_are_ignored() -> None:
+    rows = [
+        E("2023-12-31", "food", 9999),
+        E("2024-01-05", "food", 100),
+        E("2024-02-05", "food", 100),
+        E("2024-03-01", "food", 7777),
+    ]
+    (r,) = month_diff(rows, "2024-01", "2024-02")
+    assert (r.prev, r.curr, r.status) == (100, 100, "same")
+
+
+def test_only_categories_in_either_month_appear() -> None:
+    rows = [E("2024-01-05", "a", 1), E("2024-02-05", "b", 1), E("2024-04-05", "c", 1)]
+    cats = {r.category for r in month_diff(rows, "2024-01", "2024-02")}
+    assert cats == {"a", "b"}
+
+
+def test_sort_by_abs_delta_desc_then_category_asc() -> None:
+    rows = [
+        E("2024-01-05", "z", 1000),
+        E("2024-02-05", "z", 1000),  # delta 0
+        E("2024-01-05", "b", 500),
+        E("2024-02-05", "b", 0),  # delta -500
+        E("2024-01-05", "a", 0),
+        E("2024-02-05", "a", 500),  # delta +500
+        E("2024-02-05", "c", 2000),  # delta +2000
+    ]
+    order = [r.category for r in month_diff(rows, "2024-01", "2024-02")]
+    assert order == ["c", "a", "b", "z"]
+
+
+def test_empty_rows_gives_empty_list() -> None:
+    assert month_diff([], "2024-01", "2024-02") == []
+
+
+@pytest.mark.parametrize(
+    "prev, curr",
+    [
+        ("2024-1", "2024-02"),
+        ("2024-13", "2024-02"),
+        ("2024-00", "2024-02"),
+        ("202401", "2024-02"),
+        ("2024/01", "2024-02"),
+        ("2024-01", "2024-1"),
+        ("2024-01", "2024-13"),
+        ("2024-01", ""),
+        ("24-01", "2024-02"),
+    ],
+)
+def test_invalid_month_format_raises(prev: str, curr: str) -> None:
+    with pytest.raises(ValueError):
+        month_diff([], prev, curr)
+
+
+def _row(cat: str, delta: int, status: str) -> DiffRow:
+    return DiffRow(cat, 0, delta, delta, None, status)
+
+
+def test_top_movers_excludes_same_and_keeps_order() -> None:
+    diffs = [
+        _row("a", 900, "up"),
+        _row("b", 0, "same"),
+        _row("c", -500, "down"),
+        _row("d", 100, "new"),
+    ]
+    assert [r.category for r in top_movers(diffs)] == ["a", "c", "d"]
+
+
+def test_top_movers_limits_to_n() -> None:
+    diffs = [
+        _row("a", 3, "up"),
+        _row("b", 2, "up"),
+        _row("c", 1, "up"),
+        _row("d", 1, "up"),
+    ]
+    assert [r.category for r in top_movers(diffs, 2)] == ["a", "b"]
+    assert [r.category for r in top_movers(diffs, 0)] == []
+    assert len(top_movers(diffs, 10)) == 4
+
+
+def test_top_movers_negative_n_raises() -> None:
+    with pytest.raises(ValueError):
+        top_movers([], -1)
+
+
+def test_render_diff_format() -> None:
+    diffs = [
+        DiffRow("food", 1000, 1300, 300, 30.0, "up"),
+        DiffRow("gas", 2000, 0, -2000, -100.0, "gone"),
+        DiffRow("book", 0, 500, 500, None, "new"),
+        DiffRow("misc", 100, 100, 0, 0.0, "same"),
+        DiffRow("rent", 3000, 3100, 100, 3.3, "up"),
+    ]
+    text = render_diff(diffs)
+    assert text == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "food\t1000\t1300\t+300\t+30.0%\n"
+        "gas\t2000\t0\t-2000\t-100.0%\n"
+        "book\t0\t500\t+500\t-\n"
+        "misc\t100\t100\t+0\t+0.0%\n"
+        "rent\t3000\t3100\t+100\t+3.3%"
+    )
+    assert not text.endswith("\n")
+
+
+def test_render_diff_empty_is_header_only() -> None:
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_available_months_sorted_unique_across_years() -> None:
+    rows = [
+        E("2025-01-01", "a", 1),
+        E("2024-12-31", "a", 1),
+        E("2024-12-01", "b", 1),
+        E("2024-02-10", "c", 1),
+    ]
+    assert available_months(rows) == ["2024-02", "2024-12", "2025-01"]
+
+
+def test_available_months_empty() -> None:
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months() -> None:
+    rows = [
+        E("2024-11-01", "food", 100),
+        E("2024-12-01", "food", 200),
+        E("2025-01-01", "food", 150),
+        E("2024-06-01", "gas", 5),
+    ]
+    assert latest_diff(rows) == [DiffRow("food", 200, 150, -50, -25.0, "down")]
+
+
+def test_latest_diff_needs_two_months() -> None:
+    with pytest.raises(ValueError):
+        latest_diff([])
+    with pytest.raises(ValueError):
+        latest_diff([E("2024-01-01", "food", 1), E("2024-01-02", "food", 2)])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..86086a7
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,241 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def _e(category: str, memo: str = "", amount: int = 100) -> Expense:
+    return Expense(day=date(2026, 1, 1), category=category, amount=amount, memo=memo)
+
+
+# --- tokenize ---------------------------------------------------------------
+
+
+def test_tokenize_splits_on_whitespace_only() -> None:
+    assert tokenize("  食費   外食 ") == [("TERM", "食費"), ("TERM", "外食")]
+
+
+def test_tokenize_empty_and_blank_give_no_tokens() -> None:
+    assert tokenize("") == []
+    assert tokenize("   ") == []
+
+
+def test_tokenize_parens() -> None:
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+
+
+def test_tokenize_quoted_term_keeps_spaces_and_parens() -> None:
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+
+
+def test_tokenize_quoted_has_no_escape() -> None:
+    # the backslash is literal and the first " closes the quote
+    assert tokenize(r'"a\"') == [("TERM", "a\\")]
+
+
+def test_tokenize_unclosed_quote_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_uppercase_keywords_only() -> None:
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+    assert tokenize("and or not") == [
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_quoted_keyword_is_term() -> None:
+    assert tokenize('"AND"') == [("TERM", "AND")]
+
+
+def test_tokenize_keyword_prefix_is_plain_word() -> None:
+    assert tokenize("NOTE ANDROID") == [("TERM", "NOTE"), ("TERM", "ANDROID")]
+
+
+def test_tokenize_cat_prefix() -> None:
+    assert tokenize("cat:食費") == [("CAT", "食費")]
+
+
+def test_tokenize_cat_prefix_is_case_sensitive() -> None:
+    assert tokenize("CAT:食費") == [("TERM", "CAT:食費")]
+
+
+def test_tokenize_cat_with_empty_value_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_tokenize_word_stops_at_paren_and_quote() -> None:
+    assert tokenize("a(b)") == [
+        ("TERM", "a"),
+        ("LPAREN", "("),
+        ("TERM", "b"),
+        ("RPAREN", ")"),
+    ]
+
+
+# --- parse errors ----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(a",
+        "a)",
+        ")",
+        "a OR",
+        "OR a",
+        "a AND",
+        "AND a",
+        "a AND AND b",
+        "NOT",
+        "a OR OR b",
+        "a ( )",
+    ],
+)
+def test_malformed_queries_raise(q: str) -> None:
+    with pytest.raises(QueryError):
+        filter_rows(q, [])
+
+
+def test_malformed_query_raises_even_with_no_rows() -> None:
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
+
+
+def test_empty_query_raises() -> None:
+    with pytest.raises(QueryError):
+        filter_rows("", [_e("食費")])
+
+
+# --- evaluation ------------------------------------------------------------
+
+
+def test_term_matches_memo_substring() -> None:
+    assert matches("ランチ", _e("食費", memo="駅前ランチ"))
+
+
+def test_term_matches_category_substring() -> None:
+    assert matches("食", _e("食費"))
+
+
+def test_term_does_not_match_amount_or_date() -> None:
+    assert not matches("999", _e("食費", amount=999))
+    assert not matches("2026", _e("食費"))
+
+
+def test_term_is_case_insensitive() -> None:
+    assert matches("lunch", _e("食費", memo="LUNCH set"))
+    assert matches("LUNCH", _e("食費", memo="lunch set"))
+
+
+def test_casefold_handles_eszett() -> None:
+    assert matches("STRASSE", _e("x", memo="straße"))
+
+
+def test_quoted_term_with_space_matches_substring() -> None:
+    assert matches('"駅 前"', _e("食費", memo="駅 前 ランチ"))
+    assert not matches('"駅 前"', _e("食費", memo="駅前ランチ"))
+
+
+def test_cat_requires_exact_category_match() -> None:
+    assert matches("cat:食費", _e("食費"))
+    assert not matches("cat:食", _e("食費"))
+    assert not matches("cat:食費", _e("食費ランチ"))
+
+
+def test_cat_ignores_memo() -> None:
+    assert not matches("cat:ランチ", _e("食費", memo="ランチ"))
+
+
+def test_cat_is_case_insensitive() -> None:
+    assert matches("cat:food", _e("FOOD"))
+
+
+def test_implicit_and_between_terms() -> None:
+    rows = [
+        _e("食費", memo="ランチ"),
+        _e("食費", memo="夕食"),
+        _e("交通", memo="ランチ"),
+    ]
+    assert filter_rows("食費 ランチ", rows) == [rows[0]]
+
+
+def test_explicit_and() -> None:
+    rows = [_e("食費", memo="ランチ"), _e("交通", memo="ランチ")]
+    assert filter_rows("食費 AND ランチ", rows) == [rows[0]]
+
+
+def test_or_is_lower_than_and() -> None:
+    # a OR (b AND c)
+    rows = [_e("x", memo="a"), _e("x", memo="b"), _e("x", memo="c")]
+    assert filter_rows("a OR b c", rows) == [rows[0]]
+    # (a OR b) AND c, via parentheses
+    assert filter_rows("(a OR b) c", rows) == []
+
+
+def test_not_binds_tighter_than_and() -> None:
+    rows = [_e("食費", memo="ランチ"), _e("食費", memo="夕食")]
+    assert filter_rows("食費 NOT ランチ", rows) == [rows[1]]
+
+
+def test_not_applies_to_primary_only() -> None:
+    # NOT a OR b  ==  (NOT a) OR b
+    rows = [_e("x", memo="a"), _e("x", memo="b"), _e("x", memo="c")]
+    assert filter_rows("NOT a OR b", rows) == [rows[1], rows[2]]
+
+
+def test_double_not() -> None:
+    rows = [_e("x", memo="a"), _e("x", memo="b")]
+    assert filter_rows("NOT NOT a", rows) == [rows[0]]
+
+
+def test_not_with_parenthesized_group() -> None:
+    rows = [_e("x", memo="a b"), _e("x", memo="a"), _e("x", memo="b")]
+    assert filter_rows("NOT (a b)", rows) == [rows[1], rows[2]]
+
+
+def test_or_is_left_associative_result_is_same_as_set_union() -> None:
+    rows = [_e("x", memo="a"), _e("x", memo="b"), _e("x", memo="c")]
+    assert filter_rows("a OR b OR c", rows) == rows
+
+
+def test_filter_rows_keeps_input_order() -> None:
+    rows = [_e("食費", memo="2"), _e("食費", memo="1"), _e("交通", memo="3")]
+    assert filter_rows("食費", rows) == [rows[0], rows[1]]
+
+
+def test_filter_rows_empty_input_returns_empty() -> None:
+    assert filter_rows("食費", []) == []
+
+
+def test_filter_rows_no_match_returns_empty() -> None:
+    assert filter_rows("cat:なし", [_e("食費")]) == []
+
+
+def test_mixed_cat_and_term() -> None:
+    rows = [
+        _e("食費", memo="ランチ"),
+        _e("食費", memo="夕食"),
+        _e("交通", memo="ランチ"),
+    ]
+    assert filter_rows("cat:食費 NOT 夕食", rows) == [rows[0]]
+
+
+def test_matches_agrees_with_filter_rows() -> None:
+    rows = [_e("食費", memo="ランチ"), _e("交通", memo="電車")]
+    q = "ランチ OR cat:交通"
+    assert filter_rows(q, rows) == [e for e in rows if matches(q, e)]
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..ae6237a
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,216 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def _e(
+    day: date, category: str = "通信費", amount: int = 1000, memo: str = ""
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- add_month ---------------------------------------------------------------
+
+
+def test_add_month_same_day() -> None:
+    assert add_month(date(2026, 3, 15)) == date(2026, 4, 15)
+
+
+def test_add_month_clamps_to_end_of_short_month() -> None:
+    assert add_month(date(2026, 1, 31)) == date(2026, 2, 28)
+
+
+def test_add_month_clamps_to_leap_february() -> None:
+    assert add_month(date(2024, 1, 31)) == date(2024, 2, 29)
+
+
+def test_add_month_non_leap_year_feb_29_clamps() -> None:
+    assert add_month(date(2024, 2, 29)) == date(2024, 3, 29)
+
+
+def test_add_month_rolls_over_year() -> None:
+    assert add_month(date(2026, 12, 15)) == date(2027, 1, 15)
+
+
+def test_add_month_dec_31_to_jan_31() -> None:
+    assert add_month(date(2026, 12, 31)) == date(2027, 1, 31)
+
+
+# --- find_recurring: argument validation ------------------------------------
+
+
+@pytest.mark.parametrize("min_count", [1, 0, -3])
+def test_min_count_below_two_raises(min_count: int) -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=min_count)
+
+
+def test_negative_tolerance_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_min_count_two_and_zero_tolerance_are_allowed() -> None:
+    rows = [_e(date(2026, 1, 10)), _e(date(2026, 2, 10))]
+    assert find_recurring(rows, min_count=2, tolerance=0) == [
+        Recurring(
+            "通信費", 1000, (date(2026, 1, 10), date(2026, 2, 10)), date(2026, 3, 10)
+        )
+    ]
+
+
+# --- find_recurring: basic detection ----------------------------------------
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+def test_monthly_detected_with_next_expected() -> None:
+    rows = [_e(date(2026, 1, 15)), _e(date(2026, 2, 15)), _e(date(2026, 3, 15))]
+    assert find_recurring(rows) == [
+        Recurring(
+            "通信費",
+            1000,
+            (date(2026, 1, 15), date(2026, 2, 15), date(2026, 3, 15)),
+            date(2026, 4, 15),
+        )
+    ]
+
+
+def test_run_shorter_than_min_count_is_dropped() -> None:
+    rows = [_e(date(2026, 1, 15)), _e(date(2026, 2, 15))]
+    assert find_recurring(rows, min_count=3) == []
+
+
+def test_run_exactly_min_count_is_kept() -> None:
+    rows = [_e(date(2026, 1, 15)), _e(date(2026, 2, 15)), _e(date(2026, 3, 15))]
+    assert len(find_recurring(rows, min_count=3)) == 1
+
+
+def test_memo_is_ignored_for_grouping() -> None:
+    rows = [
+        _e(date(2026, 1, 15), memo="a"),
+        _e(date(2026, 2, 15), memo="b"),
+        _e(date(2026, 3, 15), memo=""),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 15), date(2026, 2, 15), date(2026, 3, 15))
+
+
+def test_different_amounts_are_separate_groups() -> None:
+    rows = [
+        _e(date(2026, 1, 15), amount=1000),
+        _e(date(2026, 2, 15), amount=1000),
+        _e(date(2026, 3, 15), amount=1200),
+        _e(date(2026, 4, 15), amount=1200),
+    ]
+    # Each amount has only 2 occurrences -> nothing with min_count=3.
+    assert find_recurring(rows) == []
+
+
+def test_different_categories_are_separate_groups() -> None:
+    rows = [
+        _e(date(2026, 1, 15), category="A"),
+        _e(date(2026, 2, 15), category="B"),
+        _e(date(2026, 3, 15), category="A"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_duplicate_dates_do_not_count_twice() -> None:
+    rows = [
+        _e(date(2026, 1, 15)),
+        _e(date(2026, 1, 15)),
+        _e(date(2026, 2, 15)),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_unsorted_input_is_sorted_ascending() -> None:
+    rows = [_e(date(2026, 3, 15)), _e(date(2026, 1, 15)), _e(date(2026, 2, 15))]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 15), date(2026, 2, 15), date(2026, 3, 15))
+
+
+# --- find_recurring: tolerance ----------------------------------------------
+
+
+def test_month_end_clamp_within_default_tolerance() -> None:
+    # 01-31 -> expected 02-28; 02-28 -> expected 03-28; 03-31 is 3 days off.
+    rows = [_e(date(2026, 1, 31)), _e(date(2026, 2, 28)), _e(date(2026, 3, 31))]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_tolerance_boundary_is_inclusive() -> None:
+    # Each step is exactly 3 days off the expected date.
+    rows = [_e(date(2026, 1, 10)), _e(date(2026, 2, 13)), _e(date(2026, 3, 16))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+
+
+def test_one_day_beyond_tolerance_breaks_chain() -> None:
+    rows = [_e(date(2026, 1, 10)), _e(date(2026, 2, 13)), _e(date(2026, 3, 16))]
+    assert find_recurring(rows, tolerance=2) == []
+
+
+def test_early_deviation_counts_as_connected() -> None:
+    # Expected 02-10; actual 02-07 is 3 days early.
+    rows = [_e(date(2026, 1, 10)), _e(date(2026, 2, 7)), _e(date(2026, 3, 10))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+
+
+def test_gap_splits_runs_and_only_long_enough_run_is_kept() -> None:
+    rows = [
+        _e(date(2026, 1, 15)),
+        _e(date(2026, 2, 15)),
+        _e(date(2026, 3, 15)),
+        # break: next expected would be 04-15, this is far off
+        _e(date(2026, 7, 1)),
+        _e(date(2026, 8, 1)),
+    ]
+    result = find_recurring(rows, min_count=3)
+    assert len(result) == 1
+    assert result[0].days[-1] == date(2026, 3, 15)
+
+
+def test_split_runs_in_same_group_are_both_reported() -> None:
+    rows = [
+        _e(date(2026, 1, 5)),
+        _e(date(2026, 2, 5)),
+        _e(date(2026, 3, 5)),
+        _e(date(2026, 6, 5)),
+        _e(date(2026, 7, 5)),
+        _e(date(2026, 8, 5)),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 5), date(2026, 6, 5)]
+    assert result[0].next_expected == date(2026, 4, 5)
+    assert result[1].next_expected == date(2026, 9, 5)
+
+
+# --- find_recurring: result ordering ----------------------------------------
+
+
+def test_results_sorted_by_category_then_amount_then_first_day() -> None:
+    def triple(cat: str, amount: int, start: date) -> list[Expense]:
+        return [
+            _e(start, category=cat, amount=amount),
+            _e(add_month(start), category=cat, amount=amount),
+            _e(add_month(add_month(start)), category=cat, amount=amount),
+        ]
+
+    rows = (
+        triple("B", 100, date(2026, 1, 1))
+        + triple("A", 500, date(2026, 1, 1))
+        + triple("A", 300, date(2026, 1, 1))
+    )
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [
+        ("A", 300),
+        ("A", 500),
+        ("B", 100),
+    ]
diff --git a/tests/test_split.py b/tests/test_split.py
new file mode 100644
index 0000000..35970b9
--- /dev/null
+++ b/tests/test_split.py
@@ -0,0 +1,40 @@
+import pytest
+
+from kakeibo.split import split_evenly
+
+
+def test_remainder_goes_to_first_people() -> None:
+    assert split_evenly(10, 3) == [4, 3, 3]
+
+
+def test_exact_division_gives_equal_shares() -> None:
+    assert split_evenly(9, 3) == [3, 3, 3]
+
+
+def test_zero_amount_gives_all_zeros() -> None:
+    assert split_evenly(0, 3) == [0, 0, 0]
+
+
+def test_amount_smaller_than_people() -> None:
+    assert split_evenly(1, 3) == [1, 0, 0]
+
+
+def test_single_person_gets_everything() -> None:
+    assert split_evenly(7, 1) == [7]
+
+
+def test_result_length_equals_people() -> None:
+    assert len(split_evenly(100, 7)) == 7
+
+
+@pytest.mark.parametrize("amount", [1, 2, 99, 1000, 12345])
+@pytest.mark.parametrize("people", [1, 2, 3, 5, 8])
+def test_sum_always_equals_amount(amount: int, people: int) -> None:
+    shares = split_evenly(amount, people)
+    assert sum(shares) == amount
+
+
+@pytest.mark.parametrize("people", [0, -1])
+def test_people_below_one_raises(people: int) -> None:
+    with pytest.raises(ValueError):
+        split_evenly(100, people)
diff --git a/tests/test_stats.py b/tests/test_stats.py
new file mode 100644
index 0000000..70a13ee
--- /dev/null
+++ b/tests/test_stats.py
@@ -0,0 +1,67 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.stats import median_by_category
+
+
+def _e(cat: str, amount: int, d: int = 1) -> Expense:
+    return Expense(date(2026, 11, d), cat, amount)
+
+
+def test_empty_input_returns_empty_dict():
+    assert median_by_category([]) == {}
+
+
+def test_single_row_median_is_its_amount():
+    assert median_by_category([_e("food", 1200)]) == {"food": 1200.0}
+
+
+def test_odd_count_takes_middle_value_regardless_of_input_order():
+    rows = [_e("food", 300), _e("food", 100), _e("food", 200)]
+    assert median_by_category(rows) == {"food": 200.0}
+
+
+def test_even_count_averages_two_middle_values():
+    rows = [_e("food", 100), _e("food", 400), _e("food", 201), _e("food", 300)]
+    # sorted: 100, 201, 300, 400 -> (201 + 300) / 2
+    assert median_by_category(rows) == {"food": 250.5}
+
+
+def test_even_count_with_equal_middle_values():
+    rows = [_e("food", 50), _e("food", 100), _e("food", 100), _e("food", 900)]
+    assert median_by_category(rows) == {"food": 100.0}
+
+
+def test_duplicate_values_counted_each_time():
+    rows = [_e("food", 500), _e("food", 500), _e("food", 500)]
+    assert median_by_category(rows) == {"food": 500.0}
+
+
+def test_keys_sorted_by_category_name_not_by_amount():
+    rows = [_e("rent", 80000), _e("food", 100), _e("book", 900)]
+    result = median_by_category(rows)
+    assert list(result) == ["book", "food", "rent"]
+
+
+def test_medians_are_computed_per_category_only():
+    rows = [
+        _e("food", 100),
+        _e("rent", 80000),
+        _e("food", 300),
+        _e("rent", 90000),
+        _e("food", 200),
+    ]
+    assert median_by_category(rows) == {"food": 200.0, "rent": 85000.0}
+
+
+def test_returns_floats():
+    result = median_by_category([_e("food", 100), _e("food", 101)])
+    assert isinstance(result["food"], float)
+    assert result["food"] == 100.5
+
+
+def test_input_list_is_not_mutated():
+    rows = [_e("food", 300), _e("food", 100), _e("rent", 5)]
+    snapshot = list(rows)
+    median_by_category(rows)
+    assert rows == snapshot
diff --git a/tests/test_streak.py b/tests/test_streak.py
new file mode 100644
index 0000000..97d43d5
--- /dev/null
+++ b/tests/test_streak.py
@@ -0,0 +1,61 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.streak import longest_no_spend_streak
+
+
+def _e(day: date, amount: int = 100) -> Expense:
+    return Expense(day=day, category="food", amount=amount)
+
+
+def test_no_rows_counts_whole_period() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 1), date(2026, 1, 7)) == 7
+
+
+def test_single_day_without_spend_is_one() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 5), date(2026, 1, 5)) == 1
+
+
+def test_single_day_with_spend_is_zero() -> None:
+    rows = [_e(date(2026, 1, 5))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 5), date(2026, 1, 5)) == 0
+
+
+def test_start_after_end_is_zero() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 10), date(2026, 1, 1)) == 0
+
+
+def test_spend_on_start_and_end_days_excluded_from_streak() -> None:
+    rows = [_e(date(2026, 1, 1)), _e(date(2026, 1, 5))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 5)) == 3
+
+
+def test_longest_of_multiple_runs_is_chosen() -> None:
+    # no-spend runs: 1-2 (2 days), 4 (1 day), 6-9 (4 days)
+    rows = [_e(date(2026, 1, 3)), _e(date(2026, 1, 5))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 9)) == 4
+
+
+def test_multiple_records_on_same_day_break_streak_once() -> None:
+    rows = [_e(date(2026, 1, 3), 100), _e(date(2026, 1, 3), 200)]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 5)) == 2
+
+
+def test_rows_outside_period_are_ignored() -> None:
+    rows = [_e(date(2025, 12, 31)), _e(date(2026, 1, 8))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 7)) == 7
+
+
+def test_unsorted_rows_give_same_result() -> None:
+    rows = [_e(date(2026, 1, 5)), _e(date(2026, 1, 2))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 6)) == 2
+
+
+def test_zero_amount_record_still_counts_as_spend() -> None:
+    rows = [_e(date(2026, 1, 3), 0)]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 5)) == 2
+
+
+def test_streak_crosses_month_boundary() -> None:
+    rows = [_e(date(2026, 1, 31))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 29), date(2026, 2, 3)) == 3
diff --git a/tests/test_topn.py b/tests/test_topn.py
new file mode 100644
index 0000000..644aabd
--- /dev/null
+++ b/tests/test_topn.py
@@ -0,0 +1,63 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.topn import top_expenses
+
+
+def _e(day: str, amount: int, memo: str = "") -> Expense:
+    return Expense(date.fromisoformat(day), "食費", amount, memo)
+
+
+def test_empty_rows_returns_empty() -> None:
+    assert top_expenses([], 3) == []
+
+
+def test_n_zero_returns_empty() -> None:
+    rows = [_e("2026-01-01", 100)]
+    assert top_expenses(rows, 0) == []
+
+
+def test_negative_n_returns_empty() -> None:
+    rows = [_e("2026-01-01", 100)]
+    assert top_expenses(rows, -1) == []
+
+
+def test_sorted_by_amount_descending() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300), _e("2026-01-03", 200)]
+    assert [e.amount for e in top_expenses(rows, 3)] == [300, 200, 100]
+
+
+def test_returns_only_n_items() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300), _e("2026-01-03", 200)]
+    assert [e.amount for e in top_expenses(rows, 2)] == [300, 200]
+
+
+def test_n_larger_than_length_returns_all() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300)]
+    assert [e.amount for e in top_expenses(rows, 10)] == [300, 100]
+
+
+def test_n_equal_to_length_returns_all() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300)]
+    assert [e.amount for e in top_expenses(rows, 2)] == [300, 100]
+
+
+def test_equal_amounts_ordered_by_earlier_day() -> None:
+    rows = [
+        _e("2026-03-01", 500, "c"),
+        _e("2026-01-01", 500, "a"),
+        _e("2026-02-01", 500, "b"),
+    ]
+    assert [e.memo for e in top_expenses(rows, 3)] == ["a", "b", "c"]
+
+
+def test_equal_amount_and_day_keeps_input_order() -> None:
+    rows = [_e("2026-01-01", 500, "first"), _e("2026-01-01", 500, "second")]
+    assert [e.memo for e in top_expenses(rows, 2)] == ["first", "second"]
+
+
+def test_does_not_mutate_input() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300)]
+    snapshot = list(rows)
+    top_expenses(rows, 1)
+    assert rows == snapshot
diff --git a/tests/test_weekday.py b/tests/test_weekday.py
new file mode 100644
index 0000000..710a05b
--- /dev/null
+++ b/tests/test_weekday.py
@@ -0,0 +1,63 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.weekday import total_by_weekday
+
+# 2024-01-01 is a Monday.
+MON = date(2024, 1, 1)
+TUE = date(2024, 1, 2)
+WED = date(2024, 1, 3)
+THU = date(2024, 1, 4)
+FRI = date(2024, 1, 5)
+SAT = date(2024, 1, 6)
+SUN = date(2024, 1, 7)
+
+
+def _e(day: date, amount: int) -> Expense:
+    return Expense(day=day, category="food", amount=amount)
+
+
+def test_empty_rows_returns_empty_dict() -> None:
+    assert total_by_weekday([]) == {}
+
+
+def test_single_row_maps_to_its_weekday() -> None:
+    assert total_by_weekday([_e(MON, 500)]) == {"Mon": 500}
+
+
+def test_each_day_maps_to_english_three_letter_name() -> None:
+    rows = [_e(d, i + 1) for i, d in enumerate([MON, TUE, WED, THU, FRI, SAT, SUN])]
+    assert total_by_weekday(rows) == {
+        "Mon": 1,
+        "Tue": 2,
+        "Wed": 3,
+        "Thu": 4,
+        "Fri": 5,
+        "Sat": 6,
+        "Sun": 7,
+    }
+
+
+def test_same_weekday_amounts_are_summed() -> None:
+    rows = [_e(MON, 100), _e(MON, 250)]
+    assert total_by_weekday(rows) == {"Mon": 350}
+
+
+def test_same_weekday_in_different_weeks_is_summed() -> None:
+    rows = [_e(MON, 100), _e(date(2024, 1, 8), 200)]  # two Mondays
+    assert total_by_weekday(rows) == {"Mon": 300}
+
+
+def test_weekdays_without_rows_are_omitted() -> None:
+    rows = [_e(WED, 300), _e(SUN, 700)]
+    assert total_by_weekday(rows) == {"Wed": 300, "Sun": 700}
+
+
+def test_keys_are_monday_first_regardless_of_input_order() -> None:
+    rows = [_e(SUN, 7), _e(FRI, 5), _e(MON, 1)]
+    result = total_by_weekday(rows)
+    assert list(result) == ["Mon", "Fri", "Sun"]
+
+
+def test_zero_amount_row_still_creates_its_weekday_key() -> None:
+    assert total_by_weekday([_e(TUE, 0)]) == {"Tue": 0}
