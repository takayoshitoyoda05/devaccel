diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
new file mode 100644
index 0000000..7c2e22e
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,97 @@
+"""Month-over-month category comparison."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def _month_of(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+    prev_sum: dict[str, int] = {}
+    curr_sum: dict[str, int] = {}
+    prev_seen: set[str] = set()
+    curr_seen: set[str] = set()
+    for e in rows:
+        m = _month_of(e)
+        if m == prev_month:
+            prev_sum[e.category] = prev_sum.get(e.category, 0) + e.amount
+            prev_seen.add(e.category)
+        elif m == curr_month:
+            curr_sum[e.category] = curr_sum.get(e.category, 0) + e.amount
+            curr_seen.add(e.category)
+
+    out: list[DiffRow] = []
+    for cat in prev_seen | curr_seen:
+        prev = prev_sum.get(cat, 0)
+        curr = curr_sum.get(cat, 0)
+        delta = curr - prev
+        # +0.0 turns a rounded -0.0 into 0.0
+        pct = None if prev == 0 else round(delta / prev * 100, 1) + 0.0
+        if cat not in prev_seen:
+            status = "new"
+        elif cat not in curr_seen:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+    out.sort(key=lambda r: (-abs(r.delta), r.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [r for r in diffs if r.status != "same"][:n]
+
+
+def _fmt_pct(pct: float | None) -> str:
+    return "-" if pct is None else f"{pct:+.1f}%"
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for r in diffs:
+        lines.append(
+            f"{r.category}\t{r.prev}\t{r.curr}\t{r.delta:+d}\t{_fmt_pct(r.pct)}"
+        )
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month_of(e) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には明細のある月が 2 つ以上必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..b84c8e0
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,175 @@
+"""Search query language for expense rows.
+
+Grammar (lowest precedence first)::
+
+    or_expr  := and_expr ("OR" and_expr)*
+    and_expr := not_expr (["AND"] not_expr)*
+    not_expr := "NOT" not_expr | primary
+    primary  := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+__all__ = ["QueryError", "filter_rows", "matches", "tokenize"]
+
+
+class QueryError(ValueError):
+    """Raised when a search query is malformed."""
+
+
+Token = tuple[str, str]
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    """Split a query string into ``(kind, value)`` tokens."""
+    tokens: list[Token] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError("閉じていない引用符があります")
+            content = q[i + 1 : end]
+            if content == "":
+                raise QueryError("空の引用符は使えません")
+            tokens.append(("TERM", content))
+            i = end + 1
+        else:
+            j = i
+            while j < n and not q[j].isspace() and q[j] not in '()"':
+                j += 1
+            word = q[i:j]
+            i = j
+            if word == "AND":
+                tokens.append(("AND", "AND"))
+            elif word == "OR":
+                tokens.append(("OR", "OR"))
+            elif word == "NOT":
+                tokens.append(("NOT", "NOT"))
+            elif word.startswith("cat:"):
+                value = word[len("cat:") :]
+                if value == "":
+                    raise QueryError("cat: の後ろにカテゴリ名がありません")
+                tokens.append(("CAT", value))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+@dataclass(frozen=True)
+class _Node:
+    op: str  # "or" | "and" | "not" | "term" | "cat"
+    left: _Node | None = None
+    right: _Node | None = None
+    value: str = ""
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self._tokens = tokens
+        self._pos = 0
+
+    def _peek(self) -> str | None:
+        if self._pos < len(self._tokens):
+            return self._tokens[self._pos][0]
+        return None
+
+    def _next(self) -> Token:
+        tok = self._tokens[self._pos]
+        self._pos += 1
+        return tok
+
+    def parse(self) -> _Node:
+        if not self._tokens:
+            raise QueryError("検索クエリが空です")
+        node = self._or_expr()
+        if self._pos != len(self._tokens):
+            raise QueryError(f"予期しないトークンです: {self._tokens[self._pos][1]!r}")
+        return node
+
+    def _or_expr(self) -> _Node:
+        node = self._and_expr()
+        while self._peek() == "OR":
+            self._next()
+            node = _Node("or", node, self._and_expr())
+        return node
+
+    def _and_expr(self) -> _Node:
+        node = self._not_expr()
+        while True:
+            kind = self._peek()
+            if kind == "AND":
+                self._next()
+            elif kind not in ("TERM", "CAT", "NOT", "LPAREN"):
+                break
+            node = _Node("and", node, self._not_expr())
+        return node
+
+    def _not_expr(self) -> _Node:
+        if self._peek() == "NOT":
+            self._next()
+            return _Node("not", self._not_expr())
+        return self._primary()
+
+    def _primary(self) -> _Node:
+        kind = self._peek()
+        if kind == "TERM":
+            return _Node("term", value=self._next()[1])
+        if kind == "CAT":
+            return _Node("cat", value=self._next()[1])
+        if kind == "LPAREN":
+            self._next()
+            node = self._or_expr()
+            if self._peek() != "RPAREN":
+                raise QueryError("括弧が閉じていません")
+            self._next()
+            return node
+        if kind is None:
+            raise QueryError("項がありません")
+        raise QueryError(f"項が必要な位置に {self._tokens[self._pos][1]!r} があります")
+
+
+def _parse(q: str) -> _Node:
+    return _Parser(tokenize(q)).parse()
+
+
+def _evaluate(node: _Node, e: Expense) -> bool:
+    if node.op == "or":
+        assert node.left is not None and node.right is not None
+        return _evaluate(node.left, e) or _evaluate(node.right, e)
+    if node.op == "and":
+        assert node.left is not None and node.right is not None
+        return _evaluate(node.left, e) and _evaluate(node.right, e)
+    if node.op == "not":
+        assert node.left is not None
+        return not _evaluate(node.left, e)
+    if node.op == "term":
+        needle = node.value.casefold()
+        return needle in e.memo.casefold() or needle in e.category.casefold()
+    # "cat"
+    return node.value.casefold() == e.category.casefold()
+
+
+def matches(q: str, e: Expense) -> bool:
+    """Return True if the expense matches the query."""
+    return _evaluate(_parse(q), e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    """Return the rows matching the query, in input order."""
+    node = _parse(q)
+    return [e for e in rows if _evaluate(node, e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..3011a71
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,63 @@
+"""Detect recurring expenses (same category and amount, roughly monthly)."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day in the next month, or that month's last day if it does not exist."""
+    year, month = (d.year, d.month + 1) if d.month < 12 else (d.year + 1, 1)
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def _runs(days: list[date], tolerance: int) -> list[list[date]]:
+    """Split sorted, unique dates into maximal runs where neighbours are connected."""
+    runs: list[list[date]] = []
+    for d in days:
+        if runs and abs((d - add_month(runs[-1][-1])).days) <= tolerance:
+            runs[-1].append(d)
+        else:
+            runs.append([d])
+    return runs
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError("min_count は 2 以上である必要があります")
+    if tolerance < 0:
+        raise ValueError("tolerance は 0 以上である必要があります")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    out: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        for run in _runs(sorted(day_set), tolerance):
+            if len(run) >= min_count:
+                out.append(
+                    Recurring(
+                        category=category,
+                        amount=amount,
+                        days=tuple(run),
+                        next_expected=add_month(run[-1]),
+                    )
+                )
+    out.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return out
