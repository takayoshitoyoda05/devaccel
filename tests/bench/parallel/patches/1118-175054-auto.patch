--- /dev/null
+++ b/src/kakeibo/dupes.py
@@ -0,0 +1,25 @@
+"""Detect duplicate expense records."""
+
+from __future__ import annotations
+
+from collections import defaultdict
+
+from kakeibo.core import Expense
+
+
+def find_duplicates(rows: list[Expense]) -> list[tuple[int, int]]:
+    """Index pairs (i, j), i < j, of rows identical in day, category, amount and memo.
+
+    Sorted by i ascending, then j ascending.
+    """
+    groups: dict[tuple[object, str, int, str], list[int]] = defaultdict(list)
+    for idx, e in enumerate(rows):
+        groups[(e.day, e.category, e.amount, e.memo)].append(idx)
+
+    pairs: list[tuple[int, int]] = []
+    for indices in groups.values():
+        for a, i in enumerate(indices):
+            for j in indices[a + 1 :]:
+                pairs.append((i, j))
+    pairs.sort()
+    return pairs
