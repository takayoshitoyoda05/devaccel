diff --git a/src/kakeibo/bankimport.py b/src/kakeibo/bankimport.py
new file mode 100644
index 0000000..f9e9715
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,113 @@
+"""Import bank statement CSV (他行 CSV) into Expense records."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"-?[¥￥]?[0-9][0-9,]*円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    """Parse amounts like ``-¥1,234円`` into integer yen. Raises ValueError."""
+    t = s.strip()
+    if not _AMOUNT_RE.fullmatch(t):
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    digits = t.replace(",", "").replace("¥", "").replace("￥", "").replace("円", "")
+    return int(digits)
+
+
+def parse_date(s: str) -> date:
+    """Parse ``YYYY/M/D`` or ``YYYY-M-D``. Raises ValueError."""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    return date(
+        int(m.group(1)), int(m.group(3)), int(m.group(4))
+    )  # ValueError if nonexistent
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Convert bank CSV text into expenses.
+
+    Returns (valid expenses in input order, [(physical line number, field), ...]).
+    Line numbers count the header as line 1 and blank lines are counted too.
+    """
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header_row = next(reader, None)
+    if header_row is None:
+        raise ValueError("ヘッダー行がありません")
+    index: dict[str, int] = {}
+    for field, col in mapping.items():
+        if col not in header_row:
+            raise ValueError(f"列 {col!r} がヘッダーにありません")
+        index[field] = header_row.index(col)
+
+    def cell(row: list[str], field: str) -> str:
+        if field not in index:
+            return ""
+        i = index[field]
+        return row[i] if i < len(row) else ""
+
+    rows: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    line_no = reader.line_num
+    for row in reader:
+        start = line_no + 1
+        line_no = reader.line_num
+        if not row or (len(row) == 1 and not row[0].strip()):
+            continue  # blank line: skipped but still counted
+
+        row_errors: list[tuple[int, str]] = []
+        day: date | None = None
+        amount: int | None = None
+        category = ""
+        try:
+            day = parse_date(cell(row, "date"))
+        except ValueError:
+            row_errors.append((start, "date"))
+        try:
+            amount = parse_amount(cell(row, "amount"))
+        except ValueError:
+            row_errors.append((start, "amount"))
+        category = cell(row, "category").strip()
+        if not category:
+            row_errors.append((start, "category"))
+
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        assert day is not None and amount is not None
+        if category_map is not None and category in category_map:
+            category = category_map[category]
+        rows.append(
+            Expense(
+                day=day,
+                category=category,
+                amount=amount,
+                memo=cell(row, "memo").strip(),
+            )
+        )
+    return rows, errors
diff --git a/src/kakeibo/dupes.py b/src/kakeibo/dupes.py
