index 0000000..bc7600c
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,257 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+HEADER = "利用日,分類,利用金額,利用店名"
+
+
+# --- parse_amount -----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥5", 5),
+        ("￥5", 5),
+        ("-5", -5),
+        ("1234", 1234),
+        ("-1,000円", -1000),
+        ("1,,2", 12),  # comma positions are not checked
+        ("1,", 1),
+        ("-0", 0),
+    ],
+)
+def test_parse_amount_accepts(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "   ",
+        "円",
+        "¥",
+        "-",
+        "-円",
+        ",",
+        ",1",
+        "12.5",
+        "1 200",
+        "--5",
+        "¥-5",
+        "円5",
+        "5円円",
+        "5円¥",
+        "１２３",
+        "$5",
+        "+5",
+        "1¥",
+    ],
+)
+def test_parse_amount_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+# --- parse_date -------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        ("2026/12/31", date(2026, 12, 31)),
+        ("2026-1-5", date(2026, 1, 5)),
+        (" 2026/1/5 ", date(2026, 1, 5)),
+        ("2024/2/29", date(2024, 2, 29)),
+    ],
+)
+def test_parse_date_accepts(text: str, expected: date) -> None:
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "2026/1-5",
+        "2026-1/5",
+        "26/1/5",
+        "2026/02/30",
+        "2026/2/29",
+        "2026/13/1",
+        "2026/1/0",
+        "2026/123/1",
+        "2026/1/5/",
+        "2026.1.5",
+        "２０２６/1/5",
+        "2026/1",
+        "abc",
+    ],
+)
+def test_parse_date_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+# --- DEFAULT_MAPPING --------------------------------------------------------
+
+
+def test_default_mapping() -> None:
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+# --- import_rows ------------------------------------------------------------
+
+
+def test_import_rows_happy_path() -> None:
+    text = f'{HEADER}\n2026/1/5,食費,"1,200",スーパー\n2026-01-06,交通,300円, 駅 \n'
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [
+        Expense(date(2026, 1, 5), "食費", 1200, "スーパー"),
+        Expense(date(2026, 1, 6), "交通", 300, "駅"),
+    ]
+
+
+def test_import_rows_extra_columns_ignored() -> None:
+    text = "x,利用日,分類,利用金額,利用店名,y\nzz,2026/1/5,食費,100,店,qq\n"
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "店")]
+
+
+def test_import_rows_category_and_memo_are_stripped() -> None:
+    text = f"{HEADER}\n2026/1/5,  食費  ,100,  店  \n"
+    rows, _ = import_rows(text)
+    assert rows[0].category == "食費"
+    assert rows[0].memo == "店"
+
+
+def test_import_rows_category_map_applies_after_strip() -> None:
+    text = f"{HEADER}\n2026/1/5, 食費 ,100,店\n2026/1/6,交通,200,駅\n"
+    rows, errors = import_rows(text, category_map={"食費": "Food"})
+    assert errors == []
+    assert [r.category for r in rows] == ["Food", "交通"]
+
+
+def test_import_rows_category_map_not_applied_to_unmapped_or_error_rows() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,abc,店\n"
+    rows, errors = import_rows(text, category_map={"食費": "Food"})
+    assert rows == []
+    assert errors == [(2, "amount")]
+
+
+def test_import_rows_empty_category_map_value_is_kept() -> None:
+    # category_map の値は検査しない。キーにあれば置き換える。
+    text = f"{HEADER}\n2026/1/5,食費,100,店\n"
+    rows, errors = import_rows(text, category_map={"食費": ""})
+    assert errors == []
+    assert rows[0].category == ""
+
+
+def test_import_rows_memo_missing_from_mapping_is_empty() -> None:
+    mapping = {"date": "利用日", "category": "分類", "amount": "利用金額"}
+    text = f"{HEADER}\n2026/1/5,食費,100,店\n"
+    rows, errors = import_rows(text, mapping)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+def test_import_rows_custom_mapping() -> None:
+    mapping = {"date": "D", "category": "C", "amount": "A"}
+    text = "D,C,A\n2026/1/5,食費,100\n"
+    rows, errors = import_rows(text, mapping)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+@pytest.mark.parametrize("missing", ["date", "category", "amount"])
+def test_import_rows_mapping_missing_required_key_raises(missing: str) -> None:
+    mapping = {k: v for k, v in DEFAULT_MAPPING.items() if k != missing}
+    with pytest.raises(ValueError):
+        import_rows(f"{HEADER}\n", mapping)
+
+
+def test_import_rows_mapping_column_not_in_header_raises() -> None:
+    mapping = {**DEFAULT_MAPPING, "amount": "存在しない列"}
+    with pytest.raises(ValueError):
+        import_rows(f"{HEADER}\n2026/1/5,食費,100,店\n", mapping)
+
+
+def test_import_rows_none_mapping_uses_default() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,100,店\n"
+    assert import_rows(text, None) == import_rows(text, DEFAULT_MAPPING)
+
+
+def test_import_rows_errors_record_all_fields_in_order() -> None:
+    text = f"{HEADER}\nbad,  ,abc,店\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "date"), (2, "amount"), (2, "category")]
+
+
+def test_import_rows_row_with_one_error_is_excluded_others_kept() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,100,A\n2026/1/6,,100,B\n2026/1/7,交通,100,C\n"
+    rows, errors = import_rows(text)
+    assert errors == [(3, "category")]
+    assert [r.memo for r in rows] == ["A", "C"]
+
+
+def test_import_rows_line_numbers_count_blank_lines() -> None:
+    text = f"{HEADER}\n\n2026/1/5,食費,100,A\n\nxx,食費,100,B\n"
+    rows, errors = import_rows(text)
+    assert [r.memo for r in rows] == ["A"]
+    assert errors == [(5, "date")]
+
+
+def test_import_rows_quoted_comma_in_value() -> None:
+    text = f'{HEADER}\n2026/1/5,食費,100,"A, B"\n'
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows[0].memo == "A, B"
+
+
+def test_import_rows_short_row_missing_values_are_empty() -> None:
+    text = f"{HEADER}\n2026/1/5\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "amount"), (2, "category")]
+
+
+def test_import_rows_short_row_memo_missing_is_empty_string() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,100\n"
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+def test_import_rows_preserves_input_order() -> None:
+    text = f"{HEADER}\n2026/3/1,a,3,\n2026/1/1,b,1,\n2026/2/1,c,2,\n"
+    rows, _ = import_rows(text)
+    assert [r.category for r in rows] == ["a", "b", "c"]
+
+
+def test_import_rows_header_only_returns_empty() -> None:
+    assert import_rows(f"{HEADER}\n") == ([], [])
+
+
+def test_import_rows_empty_text_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows("", DEFAULT_MAPPING)
diff --git a/tests/test_dupes.py b/tests/test_dupes.py
