@@ -0,0 +1,100 @@
+"""Month-over-month change of per-category spending (pure functions).
+
+Reuses ``monthly_totals`` from ``core`` for the per-month sums.
+
+Decisions:
+D1: 前月比の対象は「前の暦月」。データに無い月は空の月(全カテゴリ 0)として
+    補うので、1 月にあって 2 月に無いカテゴリは 2 月に gone になる。
+    最初の月から最後の月まで、途中の空の月も 1 行ずつ出す。
+D2: 最初の月は空の月と比べる(全カテゴリ new)。
+D3: 状態は new(前月に無く今月にある)/ gone(前月にあり今月に無い)/
+    up / down / same。「ある」は支出の行が存在することで決め、合計が 0 でも
+    行があれば「ある」。返金(負の金額)もそのまま合算する。
+D4: delta = 今月 - 前月(円の整数。gone は負、new は正)。
+D5: ratio = delta / 前月。前月が 0(new を含む)のときは None。gone は -1.0。
+D6: 並びは月の昇順、月内は |delta| の降順、同じなら カテゴリ名の昇順。
+D7: 入力が空なら空のリスト。rows に Expense 以外が混じると TypeError。
+"""
+
+from __future__ import annotations
+
+from collections.abc import Iterable
+from dataclasses import dataclass
+from typing import Literal
+
+from .core import Expense, monthly_totals
+
+Status = Literal["up", "down", "new", "gone", "same"]
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int  # yen; 0 when absent last month
+    current: int  # yen; 0 when absent this month
+    delta: int
+    ratio: float | None
+    status: Status
+
+
+@dataclass(frozen=True)
+class MonthTrend:
+    month: str  # "YYYY-MM"
+    changes: tuple[CategoryChange, ...]
+
+
+def _next_month(month: str) -> str:
+    y, m = int(month[:4]), int(month[5:])
+    return f"{y + 1:04d}-01" if m == 12 else f"{y:04d}-{m + 1:02d}"
+
+
+def _months_between(first: str, last: str) -> list[str]:
+    out = [first]
+    while out[-1] != last:
+        out.append(_next_month(out[-1]))
+    return out
+
+
+def compare_months(
+    previous: dict[str, int], current: dict[str, int]
+) -> tuple[CategoryChange, ...]:
+    """Compare two {category: yen} maps; see D3-D6."""
+    changes: list[CategoryChange] = []
+    for cat in previous.keys() | current.keys():
+        prev = previous.get(cat, 0)
+        cur = current.get(cat, 0)
+        delta = cur - prev
+        status: Status
+        if cat not in previous:
+            status = "new"
+        elif cat not in current:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        ratio = delta / prev if prev != 0 else None
+        changes.append(CategoryChange(cat, prev, cur, delta, ratio, status))
+    changes.sort(key=lambda c: (-abs(c.delta), c.category))
+    return tuple(changes)
+
+
+def month_over_month(rows: Iterable[Expense]) -> list[MonthTrend]:
+    """Per-month category changes versus the previous calendar month."""
+    items = list(rows)
+    for e in items:
+        if not isinstance(e, Expense):
+            raise TypeError(f"rows must contain Expense, got {type(e).__name__}")
+    totals = monthly_totals(items)
+    if not totals:
+        return []
+    months = sorted(totals)
+    prev: dict[str, int] = {}
+    out: list[MonthTrend] = []
+    for m in _months_between(months[0], months[-1]):
+        cur = totals.get(m, {})
+        out.append(MonthTrend(m, compare_months(prev, cur)))
+        prev = cur
+    return out
diff --git a/tests/test_trend.py b/tests/test_trend.py
new file mode 100644
index 0000000..edc0eb6
--- /dev/null
+++ b/tests/test_trend.py
@@ -0,0 +1,115 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.trend import compare_months, month_over_month
+
+
+def e(d: str, cat: str, amount: int) -> Expense:
+    return Expense(date.fromisoformat(d), cat, amount)
+
+
+def by_cat(trend):
+    return {c.category: c for c in trend.changes}
+
+
+def test_empty_input():  # D7
+    assert month_over_month([]) == []
+
+
+def test_non_expense_rejected():  # D7
+    with pytest.raises(TypeError):
+        month_over_month(["x"])  # type: ignore[list-item]
+
+
+def test_first_month_is_all_new():  # D2
+    (t,) = month_over_month([e("2026-01-05", "食費", 1000)])
+    c = by_cat(t)["食費"]
+    assert (c.status, c.previous, c.current, c.delta, c.ratio) == (
+        "new",
+        0,
+        1000,
+        1000,
+        None,
+    )
+
+
+def test_up_down_new_gone_same():  # D3 D4 D5
+    rows = [
+        e("2026-01-01", "食費", 1000),
+        e("2026-01-02", "交通", 500),
+        e("2026-01-03", "家賃", 5000),
+        e("2026-01-04", "娯楽", 800),
+        e("2026-02-01", "食費", 1500),
+        e("2026-02-02", "交通", 250),
+        e("2026-02-03", "家賃", 5000),
+        e("2026-02-04", "医療", 300),
+    ]
+    feb = by_cat(month_over_month(rows)[1])
+    assert (feb["食費"].status, feb["食費"].delta, feb["食費"].ratio) == (
+        "up",
+        500,
+        0.5,
+    )
+    assert (feb["交通"].status, feb["交通"].delta, feb["交通"].ratio) == (
+        "down",
+        -250,
+        -0.5,
+    )
+    assert feb["家賃"].status == "same" and feb["家賃"].delta == 0
+    assert (feb["医療"].status, feb["医療"].ratio) == ("new", None)
+    assert (feb["娯楽"].status, feb["娯楽"].delta, feb["娯楽"].ratio) == (
+        "gone",
+        -800,
+        -1.0,
+    )
+    assert feb["娯楽"].current == 0
+
+
+def test_missing_month_is_empty_month():  # D1
+    rows = [e("2026-01-10", "食費", 1000), e("2026-03-10", "食費", 1000)]
+    trends = month_over_month(rows)
+    assert [t.month for t in trends] == ["2026-01", "2026-02", "2026-03"]
+    assert by_cat(trends[1])["食費"].status == "gone"
+    assert by_cat(trends[2])["食費"].status == "new"
+
+
+def test_year_boundary():  # D1
+    rows = [e("2025-12-31", "食費", 100), e("2026-01-01", "食費", 200)]
+    trends = month_over_month(rows)
+    assert [t.month for t in trends] == ["2025-12", "2026-01"]
+    assert by_cat(trends[1])["食費"].status == "up"
+
+
+def test_zero_previous_ratio_none():  # D3 D5
+    rows = [
+        e("2026-01-01", "食費", 500),
+        e("2026-01-02", "食費", -500),
+        e("2026-02-01", "食費", 300),
+    ]
+    c = by_cat(month_over_month(rows)[1])["食費"]
+    assert (c.previous, c.status, c.delta, c.ratio) == (0, "up", 300, None)
+
+
+def test_refund_summed():  # D3
+    rows = [e("2026-01-01", "食費", 1000), e("2026-01-02", "食費", -400)]
+    assert by_cat(month_over_month(rows)[0])["食費"].current == 600
+
+
+def test_ordering_abs_delta_then_name():  # D6
+    prev = {"b": 100, "a": 100, "c": 100}
+    cur = {"b": 200, "a": 200, "c": 0}
+    assert [c.category for c in compare_months(prev, cur)] == ["a", "b", "c"]
+    prev = {"x": 100, "y": 100}
+    cur = {"x": 90, "y": 300}
+    assert [c.category for c in compare_months(prev, cur)] == ["y", "x"]
+
+
+def test_months_ascending_regardless_of_input_order():  # D6
+    rows = [e("2026-03-01", "a", 1), e("2026-01-01", "a", 1), e("2026-02-01", "a", 1)]
+    assert [t.month for t in month_over_month(rows)] == [
+        "2026-01",
+        "2026-02",
+        "2026-03",
+    ]
