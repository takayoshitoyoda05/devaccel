@@ -0,0 +1,117 @@
+"""Per-category monthly budget status: OK / 注意(もうすぐ超えそう) / 超過.
+
+Pure functions only (no I/O). Budgets come from ``kakeibo.core.Budget`` and
+totals from ``kakeibo.core.monthly_totals``.
+
+Rules (consistent with ``core.find_overruns``):
+- OVER:    actual > limit (ちょうど予算額は超過ではない)
+- WARNING: not OVER, actual > 0 and actual >= limit * warn_percent / 100
+- OK:      otherwise
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from enum import Enum
+
+from kakeibo.core import Budget
+
+DEFAULT_WARN_PERCENT = 80
+
+
+class Status(Enum):
+    OK = "ok"
+    WARNING = "warning"
+    OVER = "over"
+
+
+@dataclass(frozen=True)
+class BudgetStatus:
+    month: str  # "YYYY-MM"
+    category: str
+    limit: int  # yen
+    actual: int  # yen
+    status: Status
+
+    @property
+    def remaining(self) -> int:
+        """予算の残り(超過時は負の値)。"""
+        return self.limit - self.actual
+
+    @property
+    def percent(self) -> int | None:
+        """予算に対する使用率(%、切り捨て)。予算 0 円なら None。"""
+        if self.limit == 0:
+            return None
+        return self.actual * 100 // self.limit
+
+
+def _check_warn_percent(warn_percent: int) -> None:
+    if (
+        isinstance(warn_percent, bool)
+        or not isinstance(warn_percent, int)
+        or not 1 <= warn_percent <= 100
+    ):
+        raise ValueError(
+            f"warn_percent は 1〜100 の整数である必要があります: {warn_percent!r}"
+        )
+
+
+def classify(
+    actual: int, limit: int, warn_percent: int = DEFAULT_WARN_PERCENT
+) -> Status:
+    """Classify spending against a limit. Integer arithmetic only (no float rounding)."""
+    _check_warn_percent(warn_percent)
+    if limit < 0:
+        raise ValueError(f"limit は 0 以上である必要があります: {limit!r}")
+    if actual > limit:
+        return Status.OVER
+    if actual > 0 and actual * 100 >= limit * warn_percent:
+        return Status.WARNING
+    return Status.OK
+
+
+def budget_statuses(
+    totals: dict[str, dict[str, int]],
+    budget: Budget,
+    warn_percent: int = DEFAULT_WARN_PERCENT,
+) -> list[BudgetStatus]:
+    """Status for every budgeted category in every month present in ``totals``.
+
+    - 予算のないカテゴリは対象外。
+    - 予算はあるがその月に支出がないカテゴリは actual=0 として含める。
+    - 並び順: 月は ``totals`` の順、月内はカテゴリ名昇順。
+    """
+    _check_warn_percent(warn_percent)
+    out: list[BudgetStatus] = []
+    for month, cats in totals.items():
+        for cat, limit in sorted(budget.for_month(month).items()):
+            actual = cats.get(cat, 0)
+            out.append(
+                BudgetStatus(
+                    month, cat, limit, actual, classify(actual, limit, warn_percent)
+                )
+            )
+    return out
+
+
+def alerts(statuses: list[BudgetStatus]) -> list[BudgetStatus]:
+    """知らせるべきもの(超過・注意)だけを、超過→注意の順で返す(各グループ内は元の順)。"""
+    over = [s for s in statuses if s.status is Status.OVER]
+    warn = [s for s in statuses if s.status is Status.WARNING]
+    return over + warn
+
+
+def format_alert(s: BudgetStatus) -> str:
+    """Human-readable one-line message. OK のものには使わない想定(ValueError)。"""
+    if s.status is Status.OVER:
+        return (
+            f"警告: {s.month} {s.category} {-s.remaining:,}円超過 "
+            f"(予算 {s.limit:,} / 実績 {s.actual:,})"
+        )
+    if s.status is Status.WARNING:
+        return (
+            f"注意: {s.month} {s.category} 残り{s.remaining:,}円 "
+            f"(予算 {s.limit:,} / 実績 {s.actual:,} / {s.percent}%)"
+        )
+    raise ValueError(f"OK の項目は通知対象ではありません: {s.month} {s.category}")
diff --git a/tests/test_budget_status.py b/tests/test_budget_status.py
new file mode 100644
index 0000000..b6ec6e5
--- /dev/null
+++ b/tests/test_budget_status.py
@@ -0,0 +1,129 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.budget_status import (
+    BudgetStatus,
+    Status,
+    alerts,
+    budget_statuses,
+    classify,
+    format_alert,
+)
+from kakeibo.core import Budget, Expense, find_overruns, monthly_totals
+
+
+@pytest.mark.parametrize(
+    ("actual", "limit", "expected"),
+    [
+        (0, 1000, Status.OK),
+        (799, 1000, Status.OK),
+        (800, 1000, Status.WARNING),  # ちょうど 80%
+        (1000, 1000, Status.WARNING),  # ちょうど予算額は超過ではない
+        (1001, 1000, Status.OVER),
+        (0, 0, Status.OK),  # 予算 0 円・支出なし
+        (1, 0, Status.OVER),
+        (-100, 1000, Status.OK),  # 返金などでマイナス
+    ],
+)
+def test_classify_default_threshold(actual, limit, expected):
+    assert classify(actual, limit) is expected
+
+
+def test_classify_custom_threshold_uses_exact_integer_math():
+    # 3 * 100 >= 10 * 30 → 境界ちょうど(float だと誤差が出うるケース)
+    assert classify(3, 10, warn_percent=30) is Status.WARNING
+    assert classify(2, 10, warn_percent=30) is Status.OK
+    assert classify(1000, 1000, warn_percent=100) is Status.WARNING
+    assert classify(999, 1000, warn_percent=100) is Status.OK
+
+
+@pytest.mark.parametrize("bad", [0, 101, -5, 0.8, True, "80"])
+def test_classify_rejects_bad_warn_percent(bad):
+    with pytest.raises(ValueError):
+        classify(100, 1000, warn_percent=bad)
+
+
+def test_classify_rejects_negative_limit():
+    with pytest.raises(ValueError):
+        classify(0, -1)
+
+
+def test_budget_statuses():
+    budget = Budget(
+        default={"food": 1000, "rent": 80000, "fun": 5000},
+        months={"2026-11": {"food": 3000}},
+    )
+    totals = {
+        "2026-10": {"food": 1200, "misc": 999},
+        "2026-11": {"rent": 80000, "food": 2500},
+    }
+    assert budget_statuses(totals, budget) == [
+        BudgetStatus("2026-10", "food", 1000, 1200, Status.OVER),
+        BudgetStatus("2026-10", "fun", 5000, 0, Status.OK),
+        BudgetStatus("2026-10", "rent", 80000, 0, Status.OK),
+        BudgetStatus("2026-11", "food", 3000, 2500, Status.WARNING),
+        BudgetStatus("2026-11", "fun", 5000, 0, Status.OK),
+        BudgetStatus("2026-11", "rent", 80000, 80000, Status.WARNING),
+    ]
+
+
+def test_budget_statuses_empty_inputs():
+    assert budget_statuses({}, Budget({"food": 1}, {})) == []
+    assert budget_statuses({"2026-11": {"food": 5}}, Budget({}, {})) == []
+
+
+def test_budget_statuses_rejects_bad_warn_percent_even_when_empty():
+    with pytest.raises(ValueError):
+        budget_statuses({}, Budget({}, {}), warn_percent=0)
+
+
+def test_budget_statuses_works_with_monthly_totals_and_agrees_with_find_overruns():
+    rows = [
+        Expense(date(2026, 11, 1), "food", 1200),
+        Expense(date(2026, 11, 3), "food", 800),
+        Expense(date(2026, 11, 2), "rent", 75000),
+        Expense(date(2026, 10, 5), "food", 300),
+    ]
+    budget = Budget({"food": 1500, "rent": 80000}, {})
+    totals = monthly_totals(rows)
+    statuses = budget_statuses(totals, budget)
+    over = [
+        (s.month, s.category, -s.remaining, s.limit, s.actual)
+        for s in statuses
+        if s.status is Status.OVER
+    ]
+    assert over == find_overruns(totals, budget)
+    assert [(s.month, s.category) for s in alerts(statuses)] == [
+        ("2026-11", "food"),  # 2000 > 1500
+        ("2026-11", "rent"),  # 75000 >= 64000
+    ]
+
+
+def test_alerts_orders_over_before_warning_and_drops_ok():
+    a = BudgetStatus("2026-10", "a", 100, 90, Status.WARNING)
+    b = BudgetStatus("2026-10", "b", 100, 10, Status.OK)
+    c = BudgetStatus("2026-11", "c", 100, 200, Status.OVER)
+    d = BudgetStatus("2026-11", "d", 100, 85, Status.WARNING)
+    assert alerts([a, b, c, d]) == [c, a, d]
+    assert alerts([]) == []
+
+
+def test_remaining_and_percent():
+    s = BudgetStatus("2026-11", "food", 3000, 2500, Status.WARNING)
+    assert s.remaining == 500
+    assert s.percent == 83
+    assert BudgetStatus("2026-11", "x", 0, 5, Status.OVER).percent is None
+
+
+def test_format_alert():
+    over = BudgetStatus("2026-11", "food", 1000, 2000, Status.OVER)
+    assert (
+        format_alert(over) == "警告: 2026-11 food 1,000円超過 (予算 1,000 / 実績 2,000)"
+    )
+    warn = BudgetStatus("2026-11", "rent", 80000, 72000, Status.WARNING)
+    assert format_alert(warn) == (
+        "注意: 2026-11 rent 残り8,000円 (予算 80,000 / 実績 72,000 / 90%)"
+    )
+    with pytest.raises(ValueError):
+        format_alert(BudgetStatus("2026-11", "x", 100, 1, Status.OK))
