+"""Month-over-month comparison of category totals (pure functions, no I/O).
+
+Input is the shape returned by ``core.monthly_totals``:
+``{"YYYY-MM": {category: yen}}``.
+
+"Previous month" means the calendar previous month (2026-11 -> 2026-10),
+not the previous month that happens to have data. A month with no records
+is treated as having no categories, so gaps show up as GONE / NEW.
+
+A category is "present" in a month if it has a key in that month's dict,
+even when its total is 0 (e.g. purchases and refunds that cancel out).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from enum import StrEnum
+
+
+class Change(StrEnum):
+    INCREASED = "increased"
+    DECREASED = "decreased"
+    UNCHANGED = "unchanged"
+    NEW = "new"  # absent last month, present this month
+    GONE = "gone"  # present last month, absent this month
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int | None  # None = absent in the previous month
+    current: int | None  # None = absent in the current month
+    status: Change
+
+    @property
+    def diff(self) -> int:
+        """current - previous, counting an absent side as 0."""
+        return (self.current or 0) - (self.previous or 0)
+
+
+@dataclass(frozen=True)
+class MonthComparison:
+    month: str  # "YYYY-MM"
+    previous_month: str  # calendar previous month of ``month``
+    changes: list[CategoryChange]
+
+
+def previous_month(month: str) -> str:
+    """'2026-01' -> '2025-12'. Raises ValueError on a malformed month."""
+    year, mon = _parse_month(month)
+    if mon == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mon - 1:02d}"
+
+
+def compare_months(prev: dict[str, int], cur: dict[str, int]) -> list[CategoryChange]:
+    """Classify every category appearing in either month.
+
+    Sorted by |diff| descending, then category name ascending.
+    """
+    out: list[CategoryChange] = []
+    for cat in prev.keys() | cur.keys():
+        p = prev.get(cat)
+        c = cur.get(cat)
+        if p is None:
+            status = Change.NEW
+        elif c is None:
+            status = Change.GONE
+        elif c > p:
+            status = Change.INCREASED
+        elif c < p:
+            status = Change.DECREASED
+        else:
+            status = Change.UNCHANGED
+        out.append(CategoryChange(cat, p, c, status))
+    out.sort(key=lambda ch: (-abs(ch.diff), ch.category))
+    return out
+
+
+def month_over_month(totals: dict[str, dict[str, int]]) -> list[MonthComparison]:
+    """One comparison per calendar month from the 2nd month through the last.
+
+    The earliest month in ``totals`` has no baseline, so it is not compared.
+    Months missing from ``totals`` in between are treated as empty.
+    Result is in ascending month order. Raises ValueError on malformed keys.
+    """
+    if not totals:
+        return []
+    months = sorted(totals, key=_parse_month)
+    first, last = _parse_month(months[0]), _parse_month(months[-1])
+    out: list[MonthComparison] = []
+    y, m = first
+    while (y, m) < last:
+        prev = f"{y:04d}-{m:02d}"
+        y, m = (y + 1, 1) if m == 12 else (y, m + 1)
+        cur = f"{y:04d}-{m:02d}"
+        out.append(
+            MonthComparison(
+                month=cur,
+                previous_month=prev,
+                changes=compare_months(totals.get(prev, {}), totals.get(cur, {})),
+            )
+        )
+    return out
+
+
+def _parse_month(month: str) -> tuple[int, int]:
+    parts = month.split("-")
+    if (
+        len(parts) != 2
+        or len(parts[0]) != 4
+        or len(parts[1]) != 2
+        or not (parts[0].isascii() and parts[0].isdigit())
+        or not (parts[1].isascii() and parts[1].isdigit())
+        or not 1 <= int(parts[1]) <= 12
+    ):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+    return int(parts[0]), int(parts[1])
diff --git a/tests/test_compare.py b/tests/test_compare.py
new file mode 100644
index 0000000..3ff1190
--- /dev/null
+++ b/tests/test_compare.py
@@ -0,0 +1,129 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.compare import (
+    CategoryChange,
+    Change,
+    compare_months,
+    month_over_month,
+    previous_month,
+)
+from kakeibo.core import Expense, monthly_totals
+
+
+def _by_cat(changes: list[CategoryChange]) -> dict[str, CategoryChange]:
+    return {ch.category: ch for ch in changes}
+
+
+def test_compare_months_all_statuses():
+    prev = {"food": 1000, "rent": 80000, "book": 500, "gym": 3000}
+    cur = {"food": 1500, "rent": 80000, "book": 200, "travel": 20000}
+    got = _by_cat(compare_months(prev, cur))
+    assert got["food"] == CategoryChange("food", 1000, 1500, Change.INCREASED)
+    assert got["book"] == CategoryChange("book", 500, 200, Change.DECREASED)
+    assert got["rent"] == CategoryChange("rent", 80000, 80000, Change.UNCHANGED)
+    assert got["travel"] == CategoryChange("travel", None, 20000, Change.NEW)
+    assert got["gym"] == CategoryChange("gym", 3000, None, Change.GONE)
+    assert len(got) == 5
+
+
+def test_diff_treats_absent_as_zero():
+    got = _by_cat(compare_months({"a": 300, "b": 100}, {"b": 250, "c": 40}))
+    assert got["a"].diff == -300
+    assert got["b"].diff == 150
+    assert got["c"].diff == 40
+
+
+def test_compare_months_sorted_by_abs_diff_then_name():
+    prev = {"a": 100, "b": 100, "z": 500}
+    cur = {"a": 400, "b": 100, "y": 300}
+    got = [ch.category for ch in compare_months(prev, cur)]
+    # z: -500, a: +300, y: +300 (tie -> name), b: 0
+    assert got == ["z", "a", "y", "b"]
+
+
+def test_zero_total_counts_as_present():
+    got = _by_cat(compare_months({"food": 0}, {"food": 100, "misc": 0}))
+    assert got["food"].status is Change.INCREASED
+    assert got["misc"] == CategoryChange("misc", None, 0, Change.NEW)
+
+
+def test_compare_months_empty():
+    assert compare_months({}, {}) == []
+
+
+def test_inputs_not_mutated():
+    prev = {"a": 1}
+    cur = {"b": 2}
+    compare_months(prev, cur)
+    month_over_month({"2026-01": prev, "2026-02": cur})
+    assert prev == {"a": 1} and cur == {"b": 2}
+
+
+@pytest.mark.parametrize(
+    ("month", "expected"),
+    [("2026-11", "2026-10"), ("2026-01", "2025-12"), ("2026-10", "2026-09")],
+)
+def test_previous_month(month, expected):
+    assert previous_month(month) == expected
+
+
+@pytest.mark.parametrize(
+    "bad", ["2026-13", "2026-00", "2026-1", "26-01", "2026/01", ""]
+)
+def test_malformed_month_raises(bad):
+    with pytest.raises(ValueError):
+        previous_month(bad)
+    with pytest.raises(ValueError):
+        month_over_month({bad: {"a": 1}})
+
+
+def test_month_over_month_empty_and_single():
+    assert month_over_month({}) == []
+    assert month_over_month({"2026-11": {"food": 1}}) == []
+
+
+def test_month_over_month_consecutive():
+    totals = {
+        "2026-10": {"food": 1000, "gym": 3000},
+        "2026-11": {"food": 1200, "book": 800},
+    }
+    [mc] = month_over_month(totals)
+    assert (mc.month, mc.previous_month) == ("2026-11", "2026-10")
+    got = _by_cat(mc.changes)
+    assert got["food"].status is Change.INCREASED
+    assert got["gym"].status is Change.GONE
+    assert got["book"].status is Change.NEW
+
+
+def test_month_over_month_gap_uses_calendar_previous_month():
+    totals = {"2026-09": {"food": 1000}, "2026-11": {"food": 1000}}
+    result = month_over_month(totals)
+    assert [(r.previous_month, r.month) for r in result] == [
+        ("2026-09", "2026-10"),
+        ("2026-10", "2026-11"),
+    ]
+    assert result[0].changes == [CategoryChange("food", 1000, None, Change.GONE)]
+    assert result[1].changes == [CategoryChange("food", None, 1000, Change.NEW)]
+
+
+def test_month_over_month_crosses_year_and_ignores_key_order():
+    totals = {"2026-01": {"food": 500}, "2025-12": {"food": 700}}
+    [mc] = month_over_month(totals)
+    assert (mc.previous_month, mc.month) == ("2025-12", "2026-01")
+    assert mc.changes == [CategoryChange("food", 700, 500, Change.DECREASED)]
+
+
+def test_works_with_monthly_totals():
+    rows = [
+        Expense(date(2026, 10, 1), "food", 1000),
+        Expense(date(2026, 10, 5), "food", 500),
+        Expense(date(2026, 11, 2), "food", 1200),
+        Expense(date(2026, 11, 3), "rent", 80000),
+    ]
+    [mc] = month_over_month(monthly_totals(rows))
+    assert mc.changes == [
+        CategoryChange("rent", None, 80000, Change.NEW),
+        CategoryChange("food", 1500, 1200, Change.DECREASED),
+    ]
