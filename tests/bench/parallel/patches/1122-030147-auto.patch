diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..dadbcd7 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -188,3 +188,129 @@ def test_path_type(runner, cls, expect):
 
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
+
+
+@pytest.mark.parametrize(
+    "name",
+    ["a.csv", "a.tsv", "A.CSV", "a.Tsv", "dir/a.b.csv", "x.tsv.csv"],
+)
+def test_extensions_accepts(name):
+    ty = click.Path(extensions=[".csv", ".tsv"])
+    assert ty.convert(name, None, None) == name
+
+
+@pytest.mark.parametrize("name", ["a.txt", "a", "a.csv.bak", "csv", "a.csvx", ""])
+def test_extensions_rejects(name):
+    ty = click.Path(extensions=[".csv", ".tsv"])
+
+    with pytest.raises(click.BadParameter, match="must have one of these extensions"):
+        ty.convert(name, None, None)
+
+
+def test_extensions_message_lists_normalized():
+    ty = click.Path(extensions=["CSV", ".TSV"])
+
+    with pytest.raises(click.BadParameter, match=r"\.csv, \.tsv\."):
+        ty.convert("a.txt", None, None)
+
+
+def test_extensions_dot_optional_and_multi_dot():
+    ty = click.Path(extensions=["csv", ".tar.gz"])
+    assert ty.convert("A.TAR.GZ", None, None) == "A.TAR.GZ"
+    assert ty.convert("a.csv", None, None) == "a.csv"
+
+    with pytest.raises(click.BadParameter):
+        ty.convert("a.gz", None, None)
+
+
+def test_extensions_default_accepts_any():
+    assert click.Path().extensions is None
+    assert click.Path(extensions=None).convert("a.txt", None, None) == "a.txt"
+
+
+def test_extensions_checked_on_existing_file(tmp_path):
+    good = tmp_path / "a.CSV"
+    bad = tmp_path / "a.txt"
+    good.write_text("x")
+    bad.write_text("x")
+    ty = click.Path(exists=True, extensions=[".csv"])
+
+    assert ty.convert(str(good), None, None) == str(good)
+
+    with pytest.raises(click.BadParameter, match="extensions"):
+        ty.convert(str(bad), None, None)
+
+
+def test_extensions_missing_file_reports_missing_first_when_exists(tmp_path):
+    ty = click.Path(exists=True, extensions=[".csv"])
+
+    with pytest.raises(click.BadParameter, match="does not exist"):
+        ty.convert(str(tmp_path / "nope.csv"), None, None)
+
+
+def test_extensions_directory_not_checked(tmp_path):
+    d = tmp_path / "data.d"
+    d.mkdir()
+    ty = click.Path(extensions=[".csv"])
+    assert ty.convert(str(d), None, None) == str(d)
+
+
+def test_extensions_dash_not_checked():
+    ty = click.Path(allow_dash=True, extensions=[".csv"])
+    assert ty.convert("-", None, None) == "-"
+
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions=[".csv"]).convert("-", None, None)
+
+
+def test_extensions_bytes_and_pathlib():
+    ty = click.Path(extensions=[".csv"])
+    assert ty.convert(b"a.CSV", None, None) == b"a.CSV"
+    assert ty.convert(pathlib.PurePosixPath("a.csv"), None, None)
+
+    with pytest.raises(click.BadParameter):
+        ty.convert(b"a.txt", None, None)
+
+    with pytest.raises(click.BadParameter):
+        ty.convert(pathlib.PurePosixPath("a.txt"), None, None)
+
+
+def test_extensions_any_iterable():
+    ty = click.Path(extensions=(e for e in ["csv"]))
+    assert ty.extensions == (".csv",)
+
+
+def test_extensions_invalid_arguments():
+    with pytest.raises(TypeError, match="single string"):
+        click.Path(extensions=".csv")  # type: ignore[arg-type]
+
+    with pytest.raises(TypeError, match="must be str"):
+        click.Path(extensions=[1])  # type: ignore[list-item]
+
+    with pytest.raises(ValueError, match="must not be empty"):
+        click.Path(extensions=[])
+
+    with pytest.raises(ValueError, match="must not be empty"):
+        click.Path(extensions=["", "csv"])
+
+    with pytest.raises(ValueError, match="must not be empty"):
+        click.Path(extensions=["."])
+
+
+def test_extensions_info_dict():
+    assert click.Path(extensions=["CSV"]).to_info_dict()["extensions"] == [".csv"]
+
+
+def test_extensions_in_cli(runner):
+    @click.command()
+    @click.argument("p", type=click.Path(extensions=[".csv", ".tsv"]))
+    def cli(p):
+        click.echo(p)
+
+    ok = runner.invoke(cli, ["DATA.CSV"])
+    assert ok.exit_code == 0
+    assert ok.output == "DATA.CSV\n"
+
+    bad = runner.invoke(cli, ["data.txt"])
+    assert bad.exit_code == 2
+    assert "must have one of these extensions: .csv, .tsv." in bad.output
