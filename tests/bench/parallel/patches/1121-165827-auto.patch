+CAUTION_PERCENT = 90
+
+
+def find_budget_alerts(
+    totals: dict[str, dict[str, int]], budget: Budget
+) -> list[tuple[str, str, str, int, int, int | None]]:
+    """(month, category, level, limit, actual, percent) in totals order.
+
+    D1: level は "over"(actual > limit) か "caution"(超過ではないが
+        actual >= 予算の 90%)。しきい値の比較は整数演算(浮動小数を使わない)。
+    D2: percent は切り捨ての整数 %(99.95% を 100% と表示しない)。
+    D3: 予算 0 円で実績 > 0 は over で percent は None(0 で割らない)。
+        予算 0 円で実績 0 は警告しない。
+    D4: 予算にないカテゴリは対象外。ちょうど 90% は caution、ちょうど 100% も
+        caution(超過ではない)。
+    """
+    out: list[tuple[str, str, str, int, int, int | None]] = []
+    for month, cats in totals.items():
+        limits = budget.for_month(month)
+        for cat, actual in cats.items():
+            if cat not in limits or actual <= 0:
+                continue
+            limit = limits[cat]
+            pct = actual * 100 // limit if limit > 0 else None
+            if actual > limit:
+                out.append((month, cat, "over", limit, actual, pct))
+            elif actual * 100 >= limit * CAUTION_PERCENT:
+                out.append((month, cat, "caution", limit, actual, pct))
+    return out
+
+
