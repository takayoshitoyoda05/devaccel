@@ -0,0 +1,451 @@
+"""銀行・カード会社の CSV を Expense に変換する純粋関数群。
+
+ファイル I/O は行わない。呼び出し側がバイト列/文字列を渡す。
+
+    text = decode_csv_bytes(path.read_bytes())
+    result = import_csv(text, ColumnMap(date=("利用日",), amount=("利用金額",)))
+    for err in result.errors:
+        print(err)  # 例: 5行目 列「利用金額」: 金額が数値ではありません: 'abc'
+
+会社ごとの違いは ColumnMap で吸収する:
+- 列名: 各項目に候補名をタプルで渡す(最初に見つかった列を使う)。
+  比較時は全角/半角・大文字小文字・空白の有無を無視する。
+- 金額: 1列(amount) か、出金/入金の2列(withdrawal/deposit) のどちらか。
+- 符号: expense_is_negative=True なら「支出がマイナス」の列として反転する。
+- ヘッダ前の説明行(カード番号や氏名など)は自動で読み飛ばす。
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from collections.abc import Callable
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+__all__ = [
+    "DEFAULT_COLUMNS",
+    "ColumnMap",
+    "ImportFormatError",
+    "ImportResult",
+    "RowError",
+    "SkippedRow",
+    "decode_csv_bytes",
+    "import_csv",
+    "parse_amount",
+    "parse_date",
+]
+
+
+# ---------------------------------------------------------------------------
+# 設定と結果
+# ---------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class ColumnMap:
+    """CSV の列と Expense の項目の対応。各項目は列名の候補(優先順)。
+
+    amount か withdrawal のどちらかは必須。ヘッダに withdrawal の候補が
+    見つかれば出金/入金の2列モード、なければ amount の1列モードになる。
+    """
+
+    date: tuple[str, ...]
+    amount: tuple[str, ...] = ()
+    withdrawal: tuple[str, ...] = ()
+    deposit: tuple[str, ...] = ()
+    memo: tuple[str, ...] = ()
+    category: tuple[str, ...] = ()
+    # 1列モードで「支出がマイナス・収入がプラス」の会社なら True。
+    expense_is_negative: bool = False
+    # 符号調整後にマイナス(返金・入金)になった行を取り込まず skipped に回す。
+    skip_credits: bool = False
+
+    def __post_init__(self) -> None:
+        if not self.date:
+            raise ValueError("ColumnMap.date に列名の候補が必要です")
+        if not self.amount and not self.withdrawal:
+            raise ValueError("ColumnMap.amount か withdrawal のどちらかが必要です")
+
+
+# よくある列名をまとめた汎用設定。会社固有の名前は ColumnMap を自作する。
+DEFAULT_COLUMNS = ColumnMap(
+    date=("date", "日付", "利用日", "ご利用日", "取引日", "お取引日", "年月日"),
+    amount=(
+        "amount",
+        "金額",
+        "利用金額",
+        "ご利用金額",
+        "支払金額",
+        "お支払金額",
+        "支払総額",
+        "入出金額",
+    ),
+    withdrawal=("出金", "出金額", "お引出し", "お引出し額", "引出額"),
+    deposit=("入金", "入金額", "お預入れ", "お預入れ額", "預入額"),
+    memo=(
+        "memo",
+        "摘要",
+        "内容",
+        "お取引内容",
+        "利用店名",
+        "ご利用店名",
+        "利用先",
+        "ご利用先",
+        "店名",
+        "備考",
+    ),
+    category=("category", "カテゴリ", "費目", "分類"),
+)
+
+
+@dataclass(frozen=True)
+class RowError:
+    """取り込めなかった行の問題1件。line は CSV の物理行番号(1始まり)。
+
+    column はファイル上の列名(行全体の問題なら None)、value はその生の値
+    (セル自体が無い場合は None)。1行に複数の問題があれば複数件になる。
+    """
+
+    line: int
+    column: str | None
+    value: str | None
+    reason: str
+
+    def __str__(self) -> str:
+        where = f"{self.line}行目"
+        if self.column is not None:
+            where += f" 列「{self.column}」"
+        return f"{where}: {self.reason}"
+
+
+@dataclass(frozen=True)
+class SkippedRow:
+    """エラーではないが取り込まなかった行(skip_credits による入金など)。"""
+
+    line: int
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: tuple[Expense, ...]
+    errors: tuple[RowError, ...]
+    skipped: tuple[SkippedRow, ...]
+    header_line: int  # ヘッダとして採用した行の番号
+
+    @property
+    def ok(self) -> bool:
+        return not self.errors
+
+
+class ImportFormatError(ValueError):
+    """ファイル全体として読めない(文字コード不明・ヘッダが見つからない等)。"""
+
+
+# ---------------------------------------------------------------------------
+# 文字コード
+# ---------------------------------------------------------------------------
+
+
+def decode_csv_bytes(
+    data: bytes, encodings: tuple[str, ...] = ("utf-8-sig", "cp932")
+) -> str:
+    """UTF-8(BOM 可) → Shift_JIS(cp932) の順に試してデコードする。"""
+    for enc in encodings:
+        try:
+            return data.decode(enc)
+        except UnicodeDecodeError:
+            continue
+    raise ImportFormatError(
+        f"文字コードを判別できません(試したもの: {', '.join(encodings)})"
+    )
+
+
+# ---------------------------------------------------------------------------
+# 値のパース
+# ---------------------------------------------------------------------------
+
+# NFKC 後も残るマイナス記号の揺れ。△▲は会計でのマイナス表記。
+_MINUS_CHARS = "-−‐‑–—ー△▲"
+_CURRENCY_RE = re.compile(r"^(?:¥|\\|JPY)\s*|\s*(?:円|JPY)$", re.IGNORECASE)
+_INT_RE = re.compile(r"[0-9]+|[0-9]{1,3}(?:,[0-9]{3})+")
+_DIGITS_RE = re.compile(r"[0-9]+")
+
+
+def _nfkc(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip()
+
+
+def parse_amount(text: str) -> int:
+    """金額文字列を円の整数にする。不正なら理由付きの ValueError。
+
+    受け付ける例: "1200", "1,200", "¥1,200", "1,200円", "１，２００",
+    "-1,200", "-¥1,200", "△1,200", "▲1200", "(1,200)", "1200.00"
+    """
+    s = _nfkc(text)
+    if not s:
+        raise ValueError("金額が空です")
+    negative = False
+    if s.startswith("(") and s.endswith(")"):
+        negative, s = True, s[1:-1].strip()
+    if s[:1] and s[0] in _MINUS_CHARS:
+        negative, s = not negative, s[1:].strip()
+    elif s.startswith("+"):
+        s = s[1:].strip()
+    # 符号は通貨記号の前後どちらにも来うる("-¥1,200" / "¥-1,200")
+    s = _CURRENCY_RE.sub("", s).strip()
+    if s[:1] and s[0] in _MINUS_CHARS and not negative:
+        negative, s = True, s[1:].strip()
+    whole, dot, frac = s.partition(".")
+    if dot:
+        if not _DIGITS_RE.fullmatch(frac):
+            raise ValueError(f"金額が数値ではありません: {text!r}")
+        if frac.strip("0"):
+            raise ValueError(f"金額に円未満の端数があります: {text!r}")
+    if not _INT_RE.fullmatch(whole):
+        if "," in whole and _DIGITS_RE.fullmatch(whole.replace(",", "")):
+            raise ValueError(f"金額の桁区切りが不正です: {text!r}")
+        raise ValueError(f"金額が数値ではありません: {text!r}")
+    value = int(whole.replace(",", ""))
+    return -value if negative else value
+
+
+_DATE_PATTERNS = (
+    re.compile(r"([0-9]{4})[-/.]([0-9]{1,2})[-/.]([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日?"),
+    re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})"),
+)
+_TWO_DIGIT_YEAR_RE = re.compile(r"[0-9]{2}[-/.][0-9]{1,2}[-/.][0-9]{1,2}")
+_TIME_SUFFIX_RE = re.compile(r"[ T][0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?$")
+
+
+def parse_date(text: str) -> date:
+    """日付文字列を date にする。不正なら理由付きの ValueError。
+
+    受け付ける例: "2026-11-01", "2026/11/1", "2026.11.01",
+    "2026年11月1日", "20261101", "２０２６／１１／０１", "2026/11/01 12:34"
+    """
+    s = _nfkc(text)
+    if not s:
+        raise ValueError("日付が空です")
+    s = _TIME_SUFFIX_RE.sub("", s)
+    for pat in _DATE_PATTERNS:
+        m = pat.fullmatch(s)
+        if m:
+            y, mo, d = (int(g) for g in m.groups())
+            try:
+                return date(y, mo, d)
+            except ValueError:
+                raise ValueError(f"存在しない日付です: {text!r}") from None
+    if _TWO_DIGIT_YEAR_RE.fullmatch(s):
+        raise ValueError(f"年が2桁の日付は解釈できません: {text!r}")
+    raise ValueError(f"日付の形式が不正です: {text!r}")
+
+
+# ---------------------------------------------------------------------------
+# 取り込み本体
+# ---------------------------------------------------------------------------
+
+
+def _norm_header(s: str) -> str:
+    return re.sub(r"\s+", "", unicodedata.normalize("NFKC", s)).casefold()
+
+
+def _find(header: list[str], candidates: tuple[str, ...]) -> int | None:
+    normed = [_norm_header(h) for h in header]
+    for cand in candidates:
+        key = _norm_header(cand)
+        if key in normed:
+            return normed.index(key)
+    return None
+
+
+@dataclass(frozen=True)
+class _Layout:
+    names: tuple[str, ...]  # ファイル上の列名(エラー表示用)
+    date: int
+    amount: int | None
+    withdrawal: int | None
+    deposit: int | None
+    memo: int | None
+    category: int | None
+
+
+def _resolve(header: list[str], cols: ColumnMap) -> _Layout | None:
+    d = _find(header, cols.date)
+    if d is None:
+        return None
+    w = _find(header, cols.withdrawal) if cols.withdrawal else None
+    a = None if w is not None else _find(header, cols.amount)
+    if w is None and a is None:
+        return None
+    return _Layout(
+        names=tuple(h.strip() for h in header),
+        date=d,
+        amount=a,
+        withdrawal=w,
+        deposit=_find(header, cols.deposit) if w is not None else None,
+        memo=_find(header, cols.memo),
+        category=_find(header, cols.category),
+    )
+
+
+def _describe_required(cols: ColumnMap) -> str:
+    money = (*cols.amount, *cols.withdrawal)
+    return f"日付({' / '.join(cols.date)})、金額({' / '.join(money)})"
+
+
+def _is_blank(row: list[str]) -> bool:
+    return not any(c.strip() for c in row)
+
+
+def import_csv(
+    text: str,
+    columns: ColumnMap = DEFAULT_COLUMNS,
+    *,
+    default_category: str = "未分類",
+    header_search_rows: int = 20,
+) -> ImportResult:
+    """CSV テキストを Expense に変換する。
+
+    ヘッダは先頭 header_search_rows 行(空行除く)から、日付と金額の列が
+    揃う最初の行を探す。不正な行は errors に(行番号・列名・生の値・理由付きで)
+    集め、残りの行の取り込みは続ける。空行は無視する。
+    ファイル全体が読めない場合のみ ImportFormatError を送出する。
+    """
+    text = text.removeprefix("﻿")
+    # strict: 閉じ忘れの " で以降の行が1セルに飲み込まれるのを黙って許さない
+    reader = csv.reader(io.StringIO(text, newline=""), strict=True)
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    skipped: list[SkippedRow] = []
+    try:
+        layout: _Layout | None = None
+        first_row: list[str] | None = None
+        searched = 0
+        for row in reader:
+            if _is_blank(row):
+                continue
+            first_row = first_row or row
+            layout = _resolve(row, columns)
+            searched += 1
+            if layout is not None or searched >= header_search_rows:
+                break
+        if layout is None:
+            raise ImportFormatError(
+                f"ヘッダ行が見つかりません。必要な列: {_describe_required(columns)}。"
+                f"先頭行の列: {first_row or []}"
+            )
+        header_line = reader.line_num
+
+        for row in reader:
+            if _is_blank(row):
+                continue
+            out = _convert(row, reader.line_num, layout, columns, default_category)
+            if isinstance(out, Expense):
+                expenses.append(out)
+            elif isinstance(out, SkippedRow):
+                skipped.append(out)
+            else:
+                errors.extend(out)
+    except csv.Error as e:
+        raise ImportFormatError(
+            f"{reader.line_num}行目: CSV として読めません: {e}"
+        ) from None
+    return ImportResult(tuple(expenses), tuple(errors), tuple(skipped), header_line)
+
+
+def _convert(
+    row: list[str],
+    line: int,
+    layout: _Layout,
+    cols: ColumnMap,
+    default_category: str,
+) -> Expense | SkippedRow | list[RowError]:
+    errors: list[RowError] = []
+    names = layout.names
+
+    def required(idx: int) -> str | None:
+        if idx < len(row):
+            return row[idx]
+        errors.append(
+            RowError(
+                line,
+                names[idx],
+                None,
+                f"列が足りません(ヘッダは {len(names)} 列、この行は {len(row)} 列)",
+            )
+        )
+        return None
+
+    def optional(idx: int | None) -> str:
+        # 末尾の空列を省略する出力もあるので、任意列は欠けていても空扱い
+        return row[idx].strip() if idx is not None and idx < len(row) else ""
+
+    def parse[T](idx: int, raw: str, fn: Callable[[str], T]) -> T | None:
+        try:
+            return fn(raw)
+        except ValueError as e:
+            errors.append(RowError(line, names[idx], raw, str(e)))
+            return None
+
+    day: date | None = None
+    raw_day = required(layout.date)
+    if raw_day is not None:
+        day = parse(layout.date, raw_day, parse_date)
+
+    amount: int | None = None
+    if layout.withdrawal is not None:
+        w_idx, d_idx = layout.withdrawal, layout.deposit
+        w_raw = required(w_idx)
+        d_raw = required(d_idx) if d_idx is not None else ""
+        if w_raw is not None and d_raw is not None:
+            # 使わない側を空欄でなく 0 で埋める銀行もあるので、0 は「値なし」扱い
+            n_before = len(errors)
+            w = parse(w_idx, w_raw, parse_amount) if _nfkc(w_raw) else None
+            d = None
+            if d_idx is not None and _nfkc(d_raw):
+                d = parse(d_idx, d_raw, parse_amount)
+            if len(errors) == n_before:
+                if w and d:
+                    errors.append(
+                        RowError(
+                            line,
+                            names[w_idx],
+                            w_raw,
+                            f"出金と入金の両方に値があります(入金: {d_raw!r})",
+                        )
+                    )
+                elif w is None and d is None:
+                    what = (
+                        "出金・入金のどちらも空です"
+                        if d_idx is not None
+                        else "出金が空です"
+                    )
+                    errors.append(RowError(line, names[w_idx], w_raw, what))
+                else:
+                    amount = w if w else -(d or 0)
+    else:
+        assert layout.amount is not None
+        raw_amount = required(layout.amount)
+        if raw_amount is not None:
+            amount = parse(layout.amount, raw_amount, parse_amount)
+            if amount is not None and cols.expense_is_negative:
+                amount = -amount
+
+    if errors:
+        return errors
+    assert day is not None and amount is not None
+    if amount < 0 and cols.skip_credits:
+        return SkippedRow(line, f"入金・返金のため除外しました({-amount:,}円)")
+    return Expense(
+        day=day,
+        category=optional(layout.category) or default_category,
+        amount=amount,
+        memo=optional(layout.memo),
+    )
