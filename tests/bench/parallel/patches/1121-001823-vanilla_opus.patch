@@ -0,0 +1,392 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.importer import (
+    DEFAULT_COLUMNS,
+    ColumnMap,
+    ImportFormatError,
+    RowError,
+    SkippedRow,
+    decode_csv_bytes,
+    import_csv,
+    parse_amount,
+    parse_date,
+)
+
+# ---------------------------------------------------------------------------
+# parse_amount
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("1200", 1200),
+        (" 1200 ", 1200),
+        ("1,200", 1200),
+        ("1,234,567", 1234567),
+        ("¥1,200", 1200),
+        ("￥1,200", 1200),
+        ("\\1,200", 1200),
+        ("1,200円", 1200),
+        ("JPY 1200", 1200),
+        ("１，２００", 1200),
+        ("１２００円", 1200),
+        ("+1200", 1200),
+        ("-1,200", -1200),
+        ("−1,200", -1200),  # U+2212 MINUS SIGN
+        ("－1,200", -1200),  # 全角ハイフンマイナス
+        ("△1,200", -1200),
+        ("▲1200", -1200),
+        ("(1,200)", -1200),
+        ("-¥1,200", -1200),
+        ("¥-1,200", -1200),
+        ("1200.00", 1200),
+        ("1,200.0", 1200),
+        ("0", 0),
+    ],
+)
+def test_parse_amount_ok(text, expected):
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    ("text", "reason"),
+    [
+        ("", "金額が空です"),
+        ("   ", "金額が空です"),
+        ("abc", "数値ではありません"),
+        ("12a", "数値ではありません"),
+        ("1200.5", "円未満の端数"),
+        ("1200.", "数値ではありません"),
+        ("1,20", "桁区切りが不正"),
+        ("12,00,000", "桁区切りが不正"),
+        ("-", "数値ではありません"),
+        ("¥", "数値ではありません"),
+        ("1 200", "数値ではありません"),
+        ("--1200", "数値ではありません"),
+    ],
+)
+def test_parse_amount_error(text, reason):
+    with pytest.raises(ValueError, match=reason) as ei:
+        parse_amount(text)
+    if text.strip():
+        assert repr(text) in str(ei.value)  # 生の値がメッセージに含まれる
+
+
+# ---------------------------------------------------------------------------
+# parse_date
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026-11-01",
+        "2026/11/01",
+        "2026/11/1",
+        "2026.11.01",
+        "2026年11月1日",
+        "2026年11月01",
+        "20261101",
+        "２０２６／１１／０１",
+        "2026/11/01 12:34",
+        "2026-11-01T12:34:56",
+        " 2026/11/01 ",
+    ],
+)
+def test_parse_date_ok(text):
+    assert parse_date(text) == date(2026, 11, 1)
+
+
+@pytest.mark.parametrize(
+    ("text", "reason"),
+    [
+        ("", "日付が空です"),
+        ("2026/02/30", "存在しない日付"),
+        ("2026/13/01", "存在しない日付"),
+        ("26/11/01", "年が2桁"),
+        ("11/01", "形式が不正"),
+        ("2026-11", "形式が不正"),
+        ("yesterday", "形式が不正"),
+    ],
+)
+def test_parse_date_error(text, reason):
+    with pytest.raises(ValueError, match=reason):
+        parse_date(text)
+
+
+# ---------------------------------------------------------------------------
+# decode_csv_bytes
+# ---------------------------------------------------------------------------
+
+
+def test_decode_utf8_bom():
+    assert decode_csv_bytes("﻿日付,金額\n".encode()) == "日付,金額\n"
+
+
+def test_decode_cp932():
+    assert decode_csv_bytes("日付,金額\n".encode("cp932")) == "日付,金額\n"
+
+
+def test_decode_unknown():
+    with pytest.raises(ImportFormatError, match="文字コード"):
+        decode_csv_bytes(b"\xff\xfe\xff", encodings=("utf-8",))
+
+
+# ---------------------------------------------------------------------------
+# import_csv: 会社ごとの書式
+# ---------------------------------------------------------------------------
+
+
+def test_card_style_with_preamble():
+    text = (
+        "カード名称,○○カード\n"
+        "会員番号,****-****-****-1234\n"
+        "\n"
+        "ご利用日,ご利用店名,ご利用金額,支払区分\n"
+        '2026/11/01,スーパー,"1,200",1回\n'
+        "2026/11/03,カフェ,¥480,1回\n"
+    )
