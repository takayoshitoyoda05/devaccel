+def test_bad_rows_are_reported_with_line_column_value():
+    text = (
+        "ご利用日,ご利用店名,ご利用金額\n"
+        "2026/11/01,A,100\n"
+        "2026/02/30,B,200\n"
+        "2026/11/03,C,1.5\n"
+        "2026/11/04,D,300\n"
+    )
+    r = import_csv(text)
+    assert not r.ok
+    # 正しい行は取り込みが続く
+    assert [e.memo for e in r.expenses] == ["A", "D"]
+    assert r.errors == (
+        RowError(3, "ご利用日", "2026/02/30", "存在しない日付です: '2026/02/30'"),
+        RowError(4, "ご利用金額", "1.5", "金額に円未満の端数があります: '1.5'"),
+    )
+    assert str(r.errors[0]) == "3行目 列「ご利用日」: 存在しない日付です: '2026/02/30'"
