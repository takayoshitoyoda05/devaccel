+def test_month_end_drift_is_tolerated_and_anchored_on_previous_date():
+    # Jan 31 -> Feb 28 (diff 0); Feb 28 -> Mar 28, so Mar 31 is 3 days off
+    rows = [_e(date(2026, 1, 31)), _e(date(2026, 2, 28)), _e(date(2026, 3, 31))]
+    (r,) = find_recurring(rows, min_count=3, tolerance=3)
+    assert r.days == (date(2026, 1, 31), date(2026, 2, 28), date(2026, 3, 31))
+    assert r.next_expected == date(2026, 4, 30)
+    # At tolerance 2 the last date is split off, leaving a run of 2
+    assert find_recurring(rows, min_count=3, tolerance=2) == []
+    (r2,) = find_recurring(rows, min_count=2, tolerance=2)
+    assert r2.days == (date(2026, 1, 31), date(2026, 2, 28))
+    assert r2.next_expected == date(2026, 3, 28)
+
