new file mode 100644
index 0000000..df8dc3e
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,247 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, next_due
+
+
+def ex(
+    y: int, m: int, d: int, amount: int, memo: str = "家賃", category: str = "住居"
+) -> Expense:
+    return Expense(day=date(y, m, d), category=category, amount=amount, memo=memo)
+
+
+# --- 例の表 (E2-*) ---------------------------------------------------------
+# E2-1 の「31・31・28」は 2 月 31 日が存在しないため、1/31・2/28・3/31 として写す。
+
+
+@pytest.mark.parametrize(
+    ("rows", "expected"),
+    [
+        pytest.param(
+            [ex(2026, 1, 31, 50000), ex(2026, 2, 28, 50000), ex(2026, 3, 31, 50000)],
+            [
+                Recurring(
+                    category="住居",
+                    memo="家賃",
+                    amount=50000,
+                    months=3,
+                    last_day=date(2026, 3, 31),
+                    next_day=date(2026, 4, 30),
+                )
+            ],
+            id="E2-1",
+        ),
+        pytest.param(
+            [ex(2026, 1, 10, 800), ex(2026, 2, 10, 800), ex(2026, 4, 10, 800)],
+            [],
+            id="E2-2",
+        ),
+        pytest.param(
+            [ex(2026, 1, 5, 1000), ex(2026, 2, 5, 1050), ex(2026, 3, 5, 1080)],
+            [
+                Recurring(
+                    category="住居",
+                    memo="家賃",
+                    amount=1050,
+                    months=3,
+                    last_day=date(2026, 3, 5),
+                    next_day=date(2026, 4, 5),
+                )
+            ],
+            id="E2-3",
+        ),
+    ],
+)
+def test_example_table(rows: list[Expense], expected: list[Recurring]) -> None:
+    assert find_recurring(rows) == expected
+
+
+# --- 追加の規則テスト ------------------------------------------------------
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+def test_output_sorted_by_next_day_then_amount_desc_then_category_memo() -> None:
+    rows = [
+        # 次回 4/20 の系列 (金額 500)
+        ex(2026, 1, 20, 500, memo="B", category="通信"),
+        ex(2026, 2, 20, 500, memo="B", category="通信"),
+        ex(2026, 3, 20, 500, memo="B", category="通信"),
+        # 次回 4/5 の系列 (金額 300 と 900)
+        ex(2026, 1, 5, 300, memo="A", category="娯楽"),
+        ex(2026, 2, 5, 300, memo="A", category="娯楽"),
+        ex(2026, 3, 5, 300, memo="A", category="娯楽"),
+        ex(2026, 1, 5, 900, memo="Z", category="住居"),
+        ex(2026, 2, 5, 900, memo="Z", category="住居"),
+        ex(2026, 3, 5, 900, memo="Z", category="住居"),
+    ]
+    result = find_recurring(rows)
+    assert [(r.next_day, r.amount, r.category) for r in result] == [
+        (date(2026, 4, 5), 900, "住居"),
+        (date(2026, 4, 5), 300, "娯楽"),
+        (date(2026, 4, 20), 500, "通信"),
+    ]
+
+
+def test_same_category_and_amount_but_different_memo_are_separate_series() -> None:
+    rows = []
+    for m in (1, 2, 3):
+        rows.append(ex(2026, m, 5, 1000, memo="動画"))
+        rows.append(ex(2026, m, 20, 1000, memo="音楽"))
+    result = find_recurring(rows)
+    assert sorted((r.memo, r.next_day) for r in result) == [
+        ("動画", date(2026, 4, 5)),
+        ("音楽", date(2026, 4, 20)),
+    ]
+
+
+def test_memo_normalization_nfkc_casefold_space_and_trailing_digits() -> None:
+    rows = [
+        ex(2026, 1, 1, 1000, memo="Netflix"),
+        ex(2026, 2, 1, 1000, memo="ｎｅｔｆｌｉｘ 2"),
+        ex(2026, 3, 1, 1000, memo="NETFLIX"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].months == 3
+    # memo は系列の最新の元のメモ
+    assert result[0].memo == "NETFLIX"
+
+
+def test_empty_memo_is_series_by_category_only() -> None:
+    rows = [ex(2026, m, 1, 700, memo="") for m in (1, 2, 3)]
+    result = find_recurring(rows)
+    assert [(r.category, r.memo) for r in result] == [("住居", "")]
+
+
+def test_refunds_are_ignored_and_not_mixed_into_series() -> None:
+    rows = [
+        ex(2026, 1, 1, 1000),
+        ex(2026, 2, 1, -1000),
+        ex(2026, 2, 1, 1000),
+        ex(2026, 3, 1, 1000),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].months == 3
+    assert result[0].amount == 1000
+
+
+def test_same_month_uses_only_earliest_day_record() -> None:
+    rows = [
+        ex(2026, 1, 3, 1000),
+        ex(2026, 1, 25, 1000),
+        ex(2026, 2, 3, 1000),
+        ex(2026, 3, 3, 1000),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].months == 3
+    assert result[0].last_day == date(2026, 3, 3)
+
+
+def test_amount_outside_tolerance_breaks_series() -> None:
+    # 直近の 2000 円は中央値 1500 の ±10 % に入らないため、系列は 1 件だけ
+    rows = [ex(2026, 1, 1, 1000), ex(2026, 2, 1, 1000), ex(2026, 3, 1, 2000)]
+    assert find_recurring(rows) == []
+
+
+def test_price_increase_within_tolerance_is_same_series() -> None:
+    rows = [
+        ex(2026, 1, 1, 1000),
+        ex(2026, 2, 1, 1000),
+        ex(2026, 3, 1, 1000),
+        ex(2026, 4, 1, 1050),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].months == 4
+    assert result[0].amount == 1000
+
+
+def test_even_count_median_floors_average() -> None:
+    rows = [
+        ex(2026, 1, 1, 1000),
+        ex(2026, 2, 1, 1001),
+        ex(2026, 3, 1, 1001),
+        ex(2026, 4, 1, 1002),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    # 中央 2 値 1001, 1001 → 1001
+    assert result[0].amount == 1001
+
+
+def test_only_latest_contiguous_run_is_considered() -> None:
+    rows = [
+        ex(2025, 10, 1, 500),
+        ex(2025, 11, 1, 500),
+        ex(2025, 12, 1, 500),
+        # 2026-01 が欠けて新しい区間は 2 か月だけ
+        ex(2026, 2, 1, 500),
+        ex(2026, 3, 1, 500),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_input_list_is_not_mutated() -> None:
+    rows = [ex(2026, 3, 1, 100), ex(2026, 1, 1, 100), ex(2026, 2, 1, 100)]
+    snapshot = list(rows)
+    find_recurring(rows)
+    assert rows == snapshot
+
+
+def test_non_list_input_raises_type_error() -> None:
+    with pytest.raises(TypeError):
+        find_recurring(())  # type: ignore[arg-type]
+
+
+def test_non_expense_element_raises_type_error() -> None:
+    with pytest.raises(TypeError):
+        find_recurring([("2026-01-01", "住居", 100, "")])  # type: ignore[list-item]
+
+
+def test_invalid_field_raises_value_error() -> None:
+    bad = Expense(day=date(2026, 1, 1), category="住居", amount=1.5, memo="")  # type: ignore[arg-type]
+    with pytest.raises(ValueError):
+        find_recurring([bad])
+
+
+# --- next_due ---------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("last", "dom", "expected"),
+    [
+        pytest.param(date(2026, 3, 31), 31, date(2026, 4, 30), id="month-end-clip"),
+        pytest.param(
+            date(2026, 12, 15), 10, date(2027, 1, 10), id="december-to-january"
+        ),
+        pytest.param(date(2027, 12, 31), 31, date(2028, 1, 31), id="year-rollover-31"),
+        pytest.param(date(2027, 1, 31), 31, date(2027, 2, 28), id="feb-non-leap"),
+        pytest.param(
+            date(2027, 1, 31), 29, date(2027, 2, 28), id="feb-29-clip-non-leap"
+        ),
+        pytest.param(date(2028, 1, 31), 29, date(2028, 2, 29), id="feb-29-leap"),
+        pytest.param(date(2100, 1, 1), 29, date(2100, 2, 28), id="century-not-leap"),
+    ],
+)
+def test_next_due(last: date, dom: int, expected: date) -> None:
+    assert next_due(last, dom) == expected
+
+
+@pytest.mark.parametrize("dom", [0, 32, -1])
+def test_next_due_rejects_day_out_of_range(dom: int) -> None:
+    with pytest.raises(ValueError):
+        next_due(date(2026, 1, 1), dom)
+
+
+def test_next_due_rejects_non_int_day() -> None:
+    with pytest.raises(TypeError):
+        next_due(date(2026, 1, 1), "5")  # type: ignore[arg-type]
