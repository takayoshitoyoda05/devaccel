@@ -0,0 +1,74 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import parse_bank_csv
+from kakeibo.core import CsvError, Expense
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (
+            '利用日,ご利用店名,利用金額\n2026/1/5,ABC,"1,234円"',
+            [Expense(date(2026, 1, 5), "未分類", 1234, "ABC")],
+        ),
+        (
+            "日付,出金,入金\n2026-01-05,,5000\n2026-01-06,300,",
+            [Expense(date(2026, 1, 6), "未分類", 300, "")],
+        ),
+    ],
+    ids=["E1-1", "E1-2"],
+)
+def test_examples(text: str, expected: list[Expense]) -> None:
+    assert parse_bank_csv(text) == expected
+
+
+def test_e1_3() -> None:  # E1-3
+    with pytest.raises(CsvError) as ei:
+        parse_bank_csv("date,amount\n2026-02-30,abc")
+    assert len(ei.value.errors) == 1
+    n, why = ei.value.errors[0]
+    assert n == 2
+    assert "date" in why and "amount" in why
+
+
+@pytest.mark.parametrize(
+    ("raw", "val"),
+    [
+        ("−300", -300),
+        ("△500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("￥1，234", 1234),
+        ("JPY 1234", 1234),
+        ("０", 0),
+        ("-300", -300),
+    ],
+)
+def test_amounts(raw: str, val: int) -> None:
+    r = parse_bank_csv(f'date,amount\n20260105,"{raw}"')
+    assert r[0].amount == val
+
+
+@pytest.mark.parametrize("raw", ["", "-", "—", "12.5"])
+def test_bad_amounts(raw: str) -> None:
+    with pytest.raises(CsvError):
+        parse_bank_csv(f"date,amount\n2026-01-05,{raw}")
+
+
+def test_misc() -> None:
+    assert parse_bank_csv("") == []
+    assert parse_bank_csv("date,amount\n") == []
+    r = parse_bank_csv(
+        "﻿Date\tAmount\r\n2026年1月5日 12:34\t5\r\n\r\n2026.1.5T1:02\t6\r"
+    )
+    assert [e.amount for e in r] == [5, 6]
+    with pytest.raises(CsvError) as ei:
+        parse_bank_csv("date,memo\n2026-01-05,x")
+    assert ei.value.errors[0][0] == 1
+    with pytest.raises(CsvError) as ei:
+        parse_bank_csv("date,amount\n2026-01-05,1,234\n2026-01-05")
+    assert [n for n, _ in ei.value.errors] == [2, 3]
+    with pytest.raises(TypeError):
+        parse_bank_csv(b"x")  # type: ignore[arg-type]
diff --git a/tests/test_monthly_report.py b/tests/test_monthly_report.py
