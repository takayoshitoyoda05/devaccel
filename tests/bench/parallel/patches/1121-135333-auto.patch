@@ -0,0 +1,98 @@
+"""Month-over-month category comparison (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    diff: int
+    ratio: float | None
+    status: str
+
+
+def _parse_month(month: str) -> tuple[int, int]:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"month は YYYY-MM 形式である必要があります: {month!r}")
+    year, mon = int(month[:4]), int(month[5:])
+    return year, mon
+
+
+def _previous_month(year: int, mon: int) -> tuple[int, int]:
+    if mon == 1:
+        return year - 1, 12
+    return year, mon - 1
+
+
+def _totals(rows: list[Expense], year: int, mon: int) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for e in rows:
+        if e.day.year == year and e.day.month == mon:
+            out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def _status(previous: int, current: int, diff: int) -> str:
+    if previous == 0 and current > 0:
+        return "新規"
+    if previous > 0 and current == 0:
+        return "なくなった"
+    if diff > 0:
+        return "増"
+    if diff < 0:
+        return "減"
+    return "変わらず"
+
+
+def compare_months(rows: list[Expense], month: str) -> list[CategoryChange]:
+    if not isinstance(rows, list):
+        raise TypeError("rows は list である必要があります")
+    if not isinstance(month, str):
+        raise TypeError("month は str である必要があります")
+    for e in rows:
+        if not isinstance(e, Expense):
+            raise TypeError("rows の要素は Expense である必要があります")
+    year, mon = _parse_month(month)
+    py, pm = _previous_month(year, mon)
+    current_totals = _totals(rows, year, mon)
+    previous_totals = _totals(rows, py, pm)
+
+    changes: list[CategoryChange] = []
+    for cat in set(current_totals) | set(previous_totals):
+        prev = previous_totals.get(cat, 0)
+        cur = current_totals.get(cat, 0)
+        diff = cur - prev
+        ratio = None if prev == 0 else diff / abs(prev)
+        changes.append(
+            CategoryChange(
+                category=cat,
+                previous=prev,
+                current=cur,
+                diff=diff,
+                ratio=ratio,
+                status=_status(prev, cur, diff),
+            )
+        )
+    changes.sort(key=lambda c: (-abs(c.diff), c.category))
+    return changes
+
+
+def format_report(changes: list[CategoryChange]) -> str:
+    if not changes:
+        return "変化なし"
+    lines = []
+    for c in changes:
+        ratio = "-" if c.ratio is None else f"{c.ratio * 100:+.1f}%"
+        lines.append(
+            f"{c.category}: {c.previous}円 → {c.current}円 ({c.diff:+d}円, {ratio})"
+        )
+    return "\n".join(lines)
