@@ -0,0 +1,193 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    amount_between,
+    and_,
+    category_is,
+    date_between,
+    memo_contains,
+    not_,
+    or_,
+    search,
+)
+
+
+def _rows() -> list[Expense]:
+    return [
+        Expense(date(2026, 1, 1), "food", 99, "lunch"),
+        Expense(date(2026, 1, 15), "food", 100, "ABC shop"),
+        Expense(date(2026, 2, 1), "rent", 101, "abc"),
+        Expense(date(2026, 3, 31), "book", 500, "xabcx"),
+        Expense(date(2026, 4, 1), "food", -50, "refund"),
+    ]
+
+
+# 表の例 (E3-*) ------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("case_id", "pred", "expected_amounts"),
+    [
+        ("E3-1", amount_between(100, 100), [100]),
+    ],
+    ids=["E3-1"],
+)
+def test_example_table_amount(case_id, pred, expected_amounts):
+    assert [e.amount for e in search(_rows(), pred)] == expected_amounts
+
+
+@pytest.mark.parametrize(
+    ("case_id", "pred", "expected_count"),
+    [
+        ("E3-2-or", or_(), 0),
+        ("E3-2-and", and_(), 5),
+    ],
+    ids=["E3-2-or", "E3-2-and"],
+)
+def test_example_table_empty_combinators(case_id, pred, expected_count):
+    assert len(search(_rows(), pred)) == expected_count
+
+
+@pytest.mark.parametrize(
+    ("case_id", "memo", "expected_memos"),
+    [
+        ("E3-3", "ＡＢＣ", ["ABC shop", "abc", "xabcx"]),
+    ],
+    ids=["E3-3"],
+)
+def test_example_table_memo(case_id, memo, expected_memos):
+    got = [e.memo for e in search(_rows(), memo_contains(memo))]
+    assert got == expected_memos
+
+
+# R1 部品 -------------------------------------------------------------------
+
+
+def test_category_is_exact_match_ignoring_outer_spaces():
+    got = search(_rows(), category_is(" food ", "book"))
+    assert [e.category for e in got] == ["food", "food", "book", "food"]
+
+
+def test_category_is_no_names_raises():
+    with pytest.raises(ValueError):
+        category_is()
+
+
+def test_category_is_does_not_partial_match():
+    assert search(_rows(), category_is("foo")) == []
+
+
+@pytest.mark.parametrize(
+    ("lo", "hi", "expected"),
+    [
+        (None, None, [99, 100, 101, 500, -50]),
+        (100, None, [100, 101, 500]),
+        (None, 100, [99, 100, -50]),
+        (99, 101, [99, 100, 101]),
+    ],
+    ids=["none-none", "lo-only", "hi-only", "both-inclusive"],
+)
+def test_amount_between_bounds_inclusive(lo, hi, expected):
+    assert [e.amount for e in search(_rows(), amount_between(lo, hi))] == expected
+
+
+def test_amount_between_lo_greater_than_hi_raises():
+    with pytest.raises(ValueError):
+        amount_between(101, 100)
+
+
+@pytest.mark.parametrize("bad", [True, False, 1.0, "100"])
+def test_amount_between_rejects_bool_float_str(bad):
+    with pytest.raises(TypeError):
+        amount_between(bad, None)
+    with pytest.raises(TypeError):
+        amount_between(None, bad)
+
+
+def test_memo_contains_empty_matches_all():
+    assert len(search(_rows(), memo_contains(""))) == 5
+
+
+def test_memo_contains_rejects_non_str():
+    with pytest.raises(TypeError):
+        memo_contains(1)  # type: ignore[arg-type]
+
+
+def test_date_between_inclusive_both_ends():
+    got = search(_rows(), date_between(date(2026, 1, 15), date(2026, 3, 31)))
+    assert [e.day for e in got] == [
+        date(2026, 1, 15),
+        date(2026, 2, 1),
+        date(2026, 3, 31),
+    ]
+
+
+def test_date_between_open_ends():
+    assert len(search(_rows(), date_between(None, None))) == 5
+    assert len(search(_rows(), date_between(date(2026, 4, 1), None))) == 1
+    assert len(search(_rows(), date_between(None, date(2026, 1, 1)))) == 1
+
+
+def test_date_between_start_after_end_raises():
+    with pytest.raises(ValueError):
+        date_between(date(2026, 2, 1), date(2026, 1, 1))
+
+
+def test_date_between_rejects_non_date():
+    with pytest.raises(TypeError):
+        date_between("2026-01-01", None)  # type: ignore[arg-type]
+
+
+# R2 組み合わせ -------------------------------------------------------------
+
+
+def test_not_inverts():
+    got = search(_rows(), not_(category_is("food")))
+    assert [e.category for e in got] == ["rent", "book"]
+
+
+def test_nested_combinators():
+    pred = or_(
+        and_(category_is("food"), amount_between(100, None)),
+        not_(amount_between(None, 400)),
+    )
+    got = search(_rows(), pred)
+    assert [e.amount for e in got] == [100, 500]
+
+
+@pytest.mark.parametrize("bad", [1, "x", None])
+def test_combinators_reject_non_callable(bad):
+    with pytest.raises(TypeError):
+        and_(bad)  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        or_(bad)  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        not_(bad)  # type: ignore[arg-type]
+
+
+# R3 search -----------------------------------------------------------------
+
+
+def test_search_keeps_order_and_returns_new_list():
+    rows = _rows()
+    snapshot = list(rows)
+    got = search(rows, lambda e: True)
+    assert got == rows
+    assert got is not rows
+    assert rows == snapshot
+
+
+def test_search_empty_rows():
+    assert search([], lambda e: True) == []
+
+
+def test_search_non_callable_raises():
+    with pytest.raises(TypeError):
+        search(_rows(), "not callable")  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        search([], None)  # type: ignore[arg-type]
