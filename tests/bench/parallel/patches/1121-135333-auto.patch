@@ -0,0 +1,141 @@
+"""銀行・カード CSV の文字列を Expense のリストへ変換する純粋関数。"""
+
+import csv
+import io
+import re
+import unicodedata
+from datetime import date
+
+from kakeibo.core import CsvError, Expense
+
+_ALIASES = {
+    "date": ("date", "日付", "利用日", "取引日", "ご利用日"),
+    "amount": ("amount", "金額", "利用金額", "ご利用金額"),
+    "out": ("出金", "出金額", "お支払金額", "支払"),
+    "in": ("入金", "入金額", "預入"),
+    "memo": ("memo", "摘要", "メモ", "利用店名", "ご利用店名", "description"),
+    "category": ("category", "カテゴリ", "分類"),
+}
+_TIME = r"(?:[ T]\d{1,2}:\d{2}(?::\d{2})?)?"
+_DATE_RES = (
+    re.compile(r"(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})" + _TIME),
+    re.compile(r"(\d{4})(\d{2})(\d{2})" + _TIME),
+    re.compile(r"(\d{4})年(\d{1,2})月(\d{1,2})日" + _TIME),
+)
+_DIGITS = re.compile(r"\d+|\d{1,3}(?:,\d{3})+")
+_NEG_PREFIX = ("-", "−", "△", "▲")
+
+
+def _norm(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip()
+
+
+def _parse_date(raw: str) -> date | None:
+    s = _norm(raw)
+    for rx in _DATE_RES:
+        m = rx.fullmatch(s)
+        if m:
+            try:
+                return date(int(m[1]), int(m[2]), int(m[3]))
+            except ValueError:
+                return None
+    return None
+
+
+def _parse_amount(raw: str) -> int | None:
+    s = _norm(raw)
+    neg = False
+    if s.startswith("(") and s.endswith(")"):
+        neg, s = True, s[1:-1].strip()
+    elif s and s[0] in _NEG_PREFIX:
+        neg, s = True, s[1:].strip()
+    elif s.endswith("-"):
+        neg, s = True, s[:-1].strip()
+    if s.startswith("¥"):
+        s = s[1:].strip()
+    elif s.upper().startswith("JPY"):
+        s = s[3:].strip()
+    elif s.endswith("円"):
+        s = s[:-1].strip()
+    if not _DIGITS.fullmatch(s):
+        return None
+    v = int(s.replace(",", ""))
+    return -v if neg else v
+
+
+def parse_bank_csv(text: str) -> list[Expense]:
+    if not isinstance(text, str):
+        raise TypeError("text must be str")
+    text = text.removeprefix("﻿")
+    first = next((ln for ln in text.splitlines() if ln.strip()), "")
+    delim = "\t" if first.count("\t") > first.count(",") else ","
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delim)
+
+    header: list[str] | None = None
+    idx: dict[str, int] = {}
+    names: dict[str, str] = {}
+    out: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    while True:
+        start = reader.line_num + 1
+        try:
+            row = next(reader)
+        except StopIteration:
+            break
+        except csv.Error as e:
+            raise ValueError(f"CSV を読めません: {e}") from e
+        if not row or all(not c.strip() for c in row):
+            continue
+        if header is None:
+            header = [_norm(c).casefold() for c in row]
+            for key, aliases in _ALIASES.items():
+                for a in aliases:
+                    if a.casefold() in header:
+                        idx[key] = header.index(a.casefold())
+                        names[key] = row[idx[key]].strip()
+                        break
+            if "date" not in idx or not ("amount" in idx or "out" in idx):
+                raise CsvError([(1, "必須列(日付と金額または出金)がありません")])
+            continue
+        if len(row) != len(header):
+            why = "列数が多い" if len(row) > len(header) else "列数が足りない"
+            errors.append((start, f"{why}(期待 {len(header)}、実際 {len(row)})"))
+            continue
+        errs: list[str] = []
+        d = _parse_date(row[idx["date"]])
+        if d is None:
+            errs.append(f"{names['date']}: 日付が不正 {row[idx['date']]!r}")
+        amount: int | None = None
+        skip = False
+        if "amount" in idx:
+            raw = row[idx["amount"]]
+            amount = _parse_amount(raw)
+            if amount is None:
+                errs.append(f"{names['amount']}: 金額が不正 {raw!r}")
+        else:
+            o = row[idx["out"]].strip()
+            i = row[idx["in"]].strip() if "in" in idx else ""
+            if o and i:
+                errs.append(
+                    f"{names['out']}: 出金と入金の両方に値があります {o!r} {i!r}"
+                )
+            elif o:
+                amount = _parse_amount(o)
+                if amount is None:
+                    errs.append(f"{names['out']}: 金額が不正 {o!r}")
+            elif i:
+                skip = True
+            else:
+                errs.append(f"{names['out']}: 出金も入金も空です")
+        if errs:
+            errors.append((start, "; ".join(errs)))
+            continue
+        if skip:
+            continue
+        assert d is not None and amount is not None
+        cat = row[idx["category"]].strip() if "category" in idx else ""
+        memo = row[idx["memo"]].strip() if "memo" in idx else ""
+        out.append(Expense(d, cat or "未分類", amount, memo))
+    if errors:
+        raise CsvError(errors)
+    return out
