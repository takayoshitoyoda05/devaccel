+++ b/tests/test_monthly_report.py
@@ -0,0 +1,148 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthly_report import CategoryChange, compare_months, format_report
+
+
+def _e(d: str, cat: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(d), category=cat, amount=amount)
+
+
+def _by_cat(changes: list[CategoryChange]) -> dict[str, CategoryChange]:
+    return {c.category: c for c in changes}
+
+
+@pytest.mark.parametrize(
+    ("rows", "month", "category", "expected"),
+    [
+        pytest.param(
+            [_e("2026-01-10", "食費", 1000)],
+            "2026-02",
+            "食費",
+            {
+                "previous": 1000,
+                "current": 0,
+                "diff": -1000,
+                "ratio": -1.0,
+                "status": "なくなった",
+            },
+            id="E4-1",
+        ),
+        pytest.param(
+            [_e("2025-12-20", "交通費", 500), _e("2026-01-05", "交通費", 750)],
+            "2026-01",
+            "交通費",
+            {
+                "previous": 500,
+                "current": 750,
+                "diff": 250,
+                "ratio": 0.5,
+                "status": "増",
+            },
+            id="E4-2",
+        ),
+        pytest.param(
+            [_e("2026-02-03", "雑費", 300), _e("2026-03-03", "雑費", 300)],
+            "2026-03",
+            "雑費",
+            {
+                "previous": 300,
+                "current": 300,
+                "diff": 0,
+                "ratio": 0.0,
+                "status": "変わらず",
+            },
+            id="E4-3-setup",
+        ),
+        pytest.param(
+            [_e("2026-03-01", "雑費", 300)],
+            "2026-03",
+            "雑費",
+            {
+                "previous": 0,
+                "current": 300,
+                "diff": 300,
+                "ratio": None,
+                "status": "新規",
+            },
+            id="E4-3",
+        ),
+    ],
+)
+def test_example_rows(rows, month, category, expected):
+    c = _by_cat(compare_months(rows, month))[category]
+    for key, value in expected.items():
+        assert getattr(c, key) == value, key
+
+
+def test_month_validation():
+    for bad in ["2026-1", "2026/01", "2026-13", "2026-00"]:
+        with pytest.raises(ValueError):
+            compare_months([], bad)
+
+
+def test_type_errors():
+    with pytest.raises(TypeError):
+        compare_months(("x",), "2026-01")  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        compare_months([], 202601)  # type: ignore[arg-type]
+
+
+def test_both_months_empty_returns_empty_list():
+    assert compare_months([], "2026-01") == []
+    assert format_report([]) == "変化なし"
+
+
+def test_january_compares_with_previous_december():
+    rows = [_e("2025-12-01", "食費", 800), _e("2026-01-01", "食費", 800)]
+    c = _by_cat(compare_months(rows, "2026-01"))["食費"]
+    assert c.status == "変わらず"
+    assert c.ratio == 0.0
+
+
+def test_refund_is_subtracted():
+    rows = [
+        _e("2026-01-01", "食費", 1000),
+        _e("2026-02-01", "食費", 1000),
+        _e("2026-02-05", "食費", -300),
+    ]
+    c = _by_cat(compare_months(rows, "2026-02"))["食費"]
+    assert c.current == 700
+    assert c.diff == -300
+    assert c.status == "減"
+
+
+def test_ratio_uses_abs_of_negative_previous():
+    rows = [_e("2025-12-01", "その他", -400), _e("2026-01-01", "その他", 100)]
+    c = _by_cat(compare_months(rows, "2026-01"))["その他"]
+    assert c.diff == 500
+    assert c.ratio == 500 / 400
+    assert c.status == "増"
+
+
+def test_sorted_by_abs_diff_then_category():
+    rows = [
+        _e("2025-12-01", "B", 100),
+        _e("2026-01-01", "B", 200),  # diff 100
+        _e("2025-12-01", "A", 300),
+        _e("2026-01-01", "A", 200),  # diff -100
+        _e("2026-01-01", "C", 500),  # diff 500
+    ]
+    names = [c.category for c in compare_months(rows, "2026-01")]
+    assert names == ["C", "A", "B"]
+
+
+def test_format_report_line():
+    c = CategoryChange(
+        category="食費", previous=1000, current=1125, diff=125, ratio=0.125, status="増"
+    )
+    assert format_report([c]) == "食費: 1000円 → 1125円 (+125円, +12.5%)"
+
+
+def test_format_report_none_ratio():
+    c = CategoryChange(
+        category="雑費", previous=0, current=300, diff=300, ratio=None, status="新規"
+    )
+    assert format_report([c]) == "雑費: 0円 → 300円 (+300円, -)"
