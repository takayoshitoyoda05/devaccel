@@ -0,0 +1,127 @@
+"""Detect recurring (subscription-like) expenses. Pure functions, stdlib only."""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+MIN_MONTHS = 3
+TOLERANCE_PCT = 10  # 中央値からの許容差 (±%)
+
+_SPACE_RE = re.compile(r"\s+")
+_TRAILING_RE = re.compile(r"[\d\W_]+$")
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int
+    months: int
+    last_day: date
+    next_day: date
+
+
+def next_due(last: date, day_of_month: int) -> date:
+    """last の翌月で、day_of_month を翌月の末日に切り詰めた日付。"""
+    if not isinstance(last, date):
+        raise TypeError("last は date である必要があります")
+    if isinstance(day_of_month, bool) or not isinstance(day_of_month, int):
+        raise TypeError("day_of_month は int である必要があります")
+    if not 1 <= day_of_month <= 31:
+        raise ValueError(f"day_of_month は 1〜31 である必要があります: {day_of_month}")
+    if last.month == 12:
+        year, month = last.year + 1, 1
+    else:
+        year, month = last.year, last.month + 1
+    last_dom = calendar.monthrange(year, month)[1]
+    return date(year, month, min(day_of_month, last_dom))
+
+
+def _norm_memo(memo: str) -> str:
+    s = unicodedata.normalize("NFKC", memo).casefold()
+    s = _SPACE_RE.sub("", s)
+    return _TRAILING_RE.sub("", s)
+
+
+def _median(values: list[int]) -> int:
+    s = sorted(values)
+    n = len(s)
+    if n % 2:
+        return s[n // 2]
+    return (s[n // 2 - 1] + s[n // 2]) // 2
+
+
+def _within_tolerance(x: int, med: int) -> bool:
+    return abs(x - med) * 100 <= med * TOLERANCE_PCT
+
+
+def _check_expense(e: Expense) -> None:
+    if not isinstance(e, Expense):
+        raise TypeError(f"Expense の list である必要があります: {type(e).__name__}")
+    # 仕様 R5: 規則にない値の内容は ValueError(型でなく値の範囲外として扱う)
+    if not isinstance(e.day, date):
+        raise ValueError(f"day が date ではありません: {e.day!r}")  # noqa: TRY004
+    if isinstance(e.amount, bool) or not isinstance(e.amount, int):
+        raise ValueError(f"amount が整数ではありません: {e.amount!r}")  # noqa: TRY004
+    if not isinstance(e.category, str) or not isinstance(e.memo, str):
+        raise ValueError("category と memo は str である必要があります")  # noqa: TRY004
+
+
+def find_recurring(rows: list[Expense]) -> list[Recurring]:
+    if not isinstance(rows, list):
+        raise TypeError("rows は list である必要があります")
+    for e in rows:
+        _check_expense(e)
+
+    # (category, 正規化メモ) -> {月インデックス: その月で最初の日付の支出}
+    groups: dict[tuple[str, str], dict[int, Expense]] = {}
+    for e in rows:
+        if e.amount < 0:  # 返金は系列に混ぜない
+            continue
+        key = (e.category, _norm_memo(e.memo))
+        by_month = groups.setdefault(key, {})
+        mi = e.day.year * 12 + e.day.month
+        cur = by_month.get(mi)
+        if cur is None or e.day < cur.day:
+            by_month[mi] = e
+
+    out: list[Recurring] = []
+    for (category, _), by_month in groups.items():
+        idx = sorted(by_month)
+        # 最新の連続した月の区間だけを見る
+        start = len(idx) - 1
+        while start > 0 and idx[start - 1] == idx[start] - 1:
+            start -= 1
+        # 区間の末尾から、金額が中央値の ±10 % 以内に収まる範囲を伸ばす
+        chosen: list[Expense] = []
+        for mi in reversed(idx[start:]):
+            e = by_month[mi]
+            cand = [x.amount for x in chosen] + [e.amount]
+            med = _median(cand)
+            if all(_within_tolerance(a, med) for a in cand):
+                chosen.append(e)
+            else:
+                break
+        if len(chosen) < MIN_MONTHS:
+            continue
+        chosen.reverse()
+        latest = chosen[-1]
+        out.append(
+            Recurring(
+                category=category,
+                memo=latest.memo,
+                amount=_median([x.amount for x in chosen]),
+                months=len(chosen),
+                last_day=latest.day,
+                next_day=next_due(latest.day, max(x.day.day for x in chosen)),
+            )
+        )
+
+    out.sort(key=lambda r: (r.next_day, -r.amount, r.category, r.memo))
+    return out
diff --git a/src/kakeibo/search.py b/src/kakeibo/search.py
new file mode 100644
index 0000000..29f220e
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,111 @@
+"""Composable, pure search predicates over Expense rows."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable
+from datetime import date, datetime
+
+from kakeibo.core import Expense
+
+Predicate = Callable[[Expense], bool]
+
+
+def _check_pred(pred: object) -> None:
+    if not callable(pred):
+        raise TypeError(f"条件は呼び出し可能である必要があります: {pred!r}")
+
+
+def _norm(text: str) -> str:
+    return unicodedata.normalize("NFKC", text).casefold()
+
+
+def _int_bound(value: object, name: str) -> int | None:
+    if value is None:
+        return None
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{name} は int か None である必要があります: {value!r}")
+    return value
+
+
+def _date_bound(value: object, name: str) -> date | None:
+    if value is None:
+        return None
+    if isinstance(value, datetime) or not isinstance(value, date):
+        raise TypeError(f"{name} は date か None である必要があります: {value!r}")
+    return value
+
+
+def category_is(*names: str) -> Predicate:
+    """カテゴリがいずれかの名前に完全一致する(前後の空白は無視)。"""
+    if not names:
+        raise ValueError("カテゴリ名を 1 つ以上指定してください")
+    for name in names:
+        if not isinstance(name, str):
+            raise TypeError(f"カテゴリ名は str である必要があります: {name!r}")
+    targets = frozenset(name.strip() for name in names)
+    return lambda e: e.category in targets
+
+
+def amount_between(lo: int | None = None, hi: int | None = None) -> Predicate:
+    """金額が lo 以上 hi 以下(両端を含む)。None は片側なし。"""
+    low = _int_bound(lo, "lo")
+    high = _int_bound(hi, "hi")
+    if low is not None and high is not None and low > high:
+        raise ValueError(f"lo > hi です: {low} > {high}")
+    return lambda e: (
+        (low is None or e.amount >= low) and (high is None or e.amount <= high)
+    )
+
+
+def memo_contains(text: str) -> Predicate:
+    """メモが text を部分一致で含む(NFKC + casefold)。空文字は全件一致。"""
+    if not isinstance(text, str):
+        raise TypeError(f"検索文字列は str である必要があります: {text!r}")
+    needle = _norm(text)
+    return lambda e: needle in _norm(e.memo)
+
+
+def date_between(start: date | None = None, end: date | None = None) -> Predicate:
+    """日付が start 以上 end 以下(両端を含む)。None は片側なし。"""
+    first = _date_bound(start, "start")
+    last = _date_bound(end, "end")
+    if first is not None and last is not None and first > last:
+        raise ValueError(f"start > end です: {first} > {last}")
+    return lambda e: (
+        (first is None or e.day >= first) and (last is None or e.day <= last)
+    )
+
+
+def and_(*preds: Predicate) -> Predicate:
+    """すべてを満たす。引数なしは常に真。"""
+    for p in preds:
+        _check_pred(p)
+    return lambda e: all(p(e) for p in preds)
+
+
+def or_(*preds: Predicate) -> Predicate:
+    """いずれかを満たす。引数なしは常に偽。"""
+    for p in preds:
+        _check_pred(p)
+    return lambda e: any(p(e) for p in preds)
+
+
+def not_(pred: Predicate) -> Predicate:
+    """条件の否定。"""
+    _check_pred(pred)
+    return lambda e: not pred(e)
+
+
+def search(rows: list[Expense], pred: Predicate) -> list[Expense]:
+    """pred を満たす行を入力の順で新しい list に返す。入力は変更しない。"""
+    _check_pred(pred)
+    if not isinstance(rows, list):
+        raise TypeError(f"rows は list である必要があります: {type(rows).__name__}")
+    out: list[Expense] = []
+    for row in rows:
+        if not isinstance(row, Expense):
+            raise TypeError(f"Expense ではない要素があります: {row!r}")
+        if pred(row):
+            out.append(row)
+    return out
