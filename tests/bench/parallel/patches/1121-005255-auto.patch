+"""Monthly per-category budget status (pure functions).
+
+Reuses `Budget` (and `Budget.for_month`) and the `monthly_totals` shape from core.
+
+D1: 予算は core.Budget を受け取り、月ごとの上限は for_month(month)(default + 月別の上書き)。
+D2: 状態は "over"(実績 > 上限)/ "warn"(実績 >= 上限 × warn_percent %)/ "ok"。
+    上限ちょうどは超過ではなく "warn"(超えたとは言わない)。
+D3: 比較は整数演算(actual * 100 >= limit * warn_percent)。浮動小数点は使わない。
+D4: warn_percent は 1〜100 の int。bool・float・str・None は TypeError、範囲外は ValueError。
+    100 は「上限ちょうどで warn」。
+D5: 上限 0 の場合、実績 0 は "ok"、実績 > 0 は "over"(0 >= 0 で warn にしない)。
+D6: 返金などで実績が負・0 の場合は "ok"。
+D7: 予算の無いカテゴリは対象外。予算があって支出の無いカテゴリは実績 0 として含める。
+D8: 評価する月は totals にある月だけ。データの無い月は作らない。
+D9: 並びは月の昇順、同月はカテゴリ名の昇順(安定・決定的)。
+D10: budget が Budget でない、totals が dict でないときは TypeError。
+D11: 超過額 over は max(actual - limit, 0)、残り remaining は limit - actual(超過なら負)。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from kakeibo.core import Budget
+
+DEFAULT_WARN_PERCENT = 80
+
+
+@dataclass(frozen=True)
+class BudgetStatus:
+    month: str
+    category: str
+    limit: int
+    actual: int
+    status: str  # "ok" | "warn" | "over"
+
+    @property
+    def remaining(self) -> int:
+        return self.limit - self.actual
+
+    @property
+    def over(self) -> int:
+        return max(self.actual - self.limit, 0)
+
+
+def _check_percent(warn_percent: object) -> int:
+    if isinstance(warn_percent, bool) or not isinstance(warn_percent, int):
+        raise TypeError("warn_percent は int である必要があります")
+    if not 1 <= warn_percent <= 100:
+        raise ValueError("warn_percent は 1〜100 である必要があります")
+    return warn_percent
+
+
+def classify(limit: int, actual: int, warn_percent: int = DEFAULT_WARN_PERCENT) -> str:
+    """Return "over", "warn" or "ok" for one category."""
+    pct = _check_percent(warn_percent)
+    if actual > limit:
+        return "over"
+    if actual <= 0:
+        return "ok"
+    if actual * 100 >= limit * pct:
+        return "warn"
+    return "ok"
+
+
+def budget_statuses(
+    totals: dict[str, dict[str, int]],
+    budget: Budget,
+    warn_percent: int = DEFAULT_WARN_PERCENT,
+) -> list[BudgetStatus]:
+    """Status of every budgeted category for each month in totals."""
+    if not isinstance(budget, Budget):
+        raise TypeError("budget は Budget である必要があります")
+    if not isinstance(totals, dict):
+        raise TypeError("totals は dict である必要があります")
+    _check_percent(warn_percent)
+    out: list[BudgetStatus] = []
+    for month in sorted(totals):
+        spent = totals[month]
+        limits = budget.for_month(month)
+        for cat in sorted(limits):
+            actual = spent.get(cat, 0)
+            out.append(
+                BudgetStatus(
+                    month,
+                    cat,
+                    limits[cat],
+                    actual,
+                    classify(limits[cat], actual, warn_percent),
+                )
+            )
+    return out
+
+
+def budget_alerts(
+    totals: dict[str, dict[str, int]],
+    budget: Budget,
+    warn_percent: int = DEFAULT_WARN_PERCENT,
+) -> list[BudgetStatus]:
+    """Only the "warn" and "over" entries of budget_statuses."""
+    return [
+        s for s in budget_statuses(totals, budget, warn_percent) if s.status != "ok"
+    ]
diff --git a/tests/test_budget_status.py b/tests/test_budget_status.py
new file mode 100644
index 0000000..94c466b
--- /dev/null
+++ b/tests/test_budget_status.py
@@ -0,0 +1,90 @@
+import pytest
+
+from kakeibo.budget import BudgetStatus, budget_alerts, budget_statuses, classify
+from kakeibo.core import Budget
+
+B = Budget(default={"食費": 1000, "交通": 500}, months={"2026-02": {"食費": 2000}})
+
+
+def test_classify_boundaries():
+    assert classify(1000, 799) == "ok"
+    assert classify(1000, 800) == "warn"
+    assert classify(1000, 1000) == "warn"  # D2: ちょうどは超過ではない
+    assert classify(1000, 1001) == "over"
+
+
+def test_classify_zero_limit():
+    assert classify(0, 0) == "ok"  # D5
+    assert classify(0, 1) == "over"
+
+
+def test_classify_refund_ok():
+    assert classify(1000, -500) == "ok"  # D6
+    assert classify(1000, 0) == "ok"
+
+
+def test_warn_percent_100_and_custom():
+    assert classify(1000, 999, 100) == "ok"
+    assert classify(1000, 1000, 100) == "warn"
+    assert classify(1000, 500, 50) == "warn"
+
+
+@pytest.mark.parametrize("bad", [True, 80.0, "80", None])
+def test_warn_percent_type(bad):
+    with pytest.raises(TypeError, match="warn_percent"):
+        classify(1000, 1, bad)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad", [0, -1, 101])
+def test_warn_percent_range(bad):
+    with pytest.raises(ValueError, match="warn_percent"):
+        classify(1000, 1, bad)
+
+
+def test_statuses_order_and_override():
+    totals = {"2026-02": {"食費": 1900}, "2026-01": {"食費": 1200, "交通": 100}}
+    got = budget_statuses(totals, B)
+    assert [(s.month, s.category, s.limit, s.actual, s.status) for s in got] == [
+        ("2026-01", "交通", 500, 100, "ok"),
+        ("2026-01", "食費", 1000, 1200, "over"),
+        ("2026-02", "交通", 500, 0, "ok"),  # D7: 支出なしは 0
+        ("2026-02", "食費", 2000, 1900, "warn"),  # D1: 月別の上書き
+    ]
+
+
+def test_unbudgeted_category_ignored():
+    got = budget_statuses({"2026-01": {"趣味": 99999}}, B)
+    assert all(s.category != "趣味" for s in got)
+
+
+def test_no_synthesized_months_and_empty():  # D8
+    assert budget_statuses({}, B) == []
+    assert {s.month for s in budget_statuses({"2026-01": {}, "2026-03": {}}, B)} == {
+        "2026-01",
+        "2026-03",
+    }
+
+
+def test_alerts_only_non_ok():
+    totals = {"2026-01": {"食費": 1200, "交通": 100}, "2026-02": {"食費": 1900}}
+    got = budget_alerts(totals, B)
+    assert [(s.month, s.category, s.status) for s in got] == [
+        ("2026-01", "食費", "over"),
+        ("2026-02", "食費", "warn"),
+    ]
+
+
+def test_over_and_remaining():  # D11
+    s = BudgetStatus("2026-01", "食費", 1000, 1200, "over")
+    assert (s.over, s.remaining) == (200, -200)
+    s = BudgetStatus("2026-01", "食費", 1000, 300, "ok")
+    assert (s.over, s.remaining) == (0, 700)
+
+
+def test_argument_types():  # D10
+    with pytest.raises(TypeError, match="budget"):
+        budget_statuses({}, {"食費": 1})  # type: ignore[arg-type]
+    with pytest.raises(TypeError, match="totals"):
+        budget_statuses([], B)  # type: ignore[arg-type]
+    with pytest.raises(ValueError, match="warn_percent"):
+        budget_statuses({}, B, 0)
