+++ b/tests/test_recurring.py
@@ -0,0 +1,159 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, normalize_memo
+
+
+def e(day: str, amount: int, memo: str = "", cat: str = "サブスク") -> Expense:
+    return Expense(date.fromisoformat(day), cat, amount, memo)
+
+
+def monthly(
+    memo: str, amount: int, start: str, n: int, cat: str = "サブスク"
+) -> list[Expense]:
+    y, m, d = (int(x) for x in start.split("-"))
+    out = []
+    for i in range(n):
+        yy, mm = divmod(m - 1 + i, 12)
+        out.append(e(f"{y + yy}-{mm + 1:02d}-{d:02d}", amount, memo, cat))
+    return out
+
+
+def test_basic_detection_and_next_date():
+    rows = monthly("Netflix", 1490, "2026-01-05", 3)
+    assert find_recurring(rows) == [
+        Recurring("サブスク", "Netflix", 1490, 3, date(2026, 3, 5), date(2026, 4, 5))
+    ]
+
+
+def test_empty_and_too_short():
+    assert find_recurring([]) == []
+    assert find_recurring(monthly("Netflix", 1490, "2026-01-05", 2)) == []
+    assert (
+        len(find_recurring(monthly("Netflix", 1490, "2026-01-05", 2), min_months=2))
+        == 1
+    )
+
+
+def test_min_months_lower_bound():
+    with pytest.raises(ValueError):
+        find_recurring([], min_months=1)
+
+
+def test_month_end_clamps_and_uses_max_day():
+    rows = [
+        e("2026-01-31", 5000, "家賃"),
+        e("2026-02-28", 5000, "家賃"),
+        e("2026-03-31", 5000, "家賃"),
+    ]
+    r = find_recurring(rows)[0]
+    assert r.next_date == date(2026, 4, 30)
+    rows2 = [
+        e("2026-11-30", 900, "x"),
+        e("2026-12-31", 900, "x"),
+        e("2027-01-31", 900, "x"),
+    ]
+    assert find_recurring(rows2)[0].next_date == date(2027, 2, 28)
+
+
+def test_after_28_uses_max_day_not_last():
+    rows = [
+        e("2026-01-31", 5000, "家賃"),
+        e("2026-02-28", 5000, "家賃"),
+        e("2026-03-28", 5000, "家賃"),
+    ]
+    assert find_recurring(rows)[0].next_date == date(2026, 4, 30)
+
+
+def test_leap_year_february():
+    rows = [
+        e("2023-11-30", 700, "x"),
+        e("2023-12-31", 700, "x"),
+        e("2024-01-31", 700, "x"),
+    ]
+    assert find_recurring(rows)[0].next_date == date(2024, 2, 29)
+
+
+def test_december_rolls_to_next_year():
+    r = find_recurring(monthly("x", 700, "2026-10-15", 3))[0]
+    assert r.last_date == date(2026, 12, 15)
+    assert r.next_date == date(2027, 1, 15)
+
+
+def test_memo_normalization_groups_variants():
+    rows = [
+        e("2026-01-05", 980, "ＮＥＴＦＬＩＸ"),
+        e("2026-02-05", 980, "netflix  #2"),
+        e("2026-03-05", 980, "Netflix 3"),
+    ]
+    assert len(find_recurring(rows)) == 1
+    assert normalize_memo("7-11") == "7-11"
+
+
+def test_refunds_and_zero_ignored():
+    rows = monthly("x", 1000, "2026-01-10", 3) + [
+        e("2026-04-10", -1000, "x"),
+        e("2026-05-10", 0, "x"),
+    ]
+    r = find_recurring(rows)[0]
+    assert r.last_date == date(2026, 3, 10)
+
+
+def test_price_increase_same_series_big_change_splits():
+    rows = [
+        e("2026-01-05", 1000, "p"),
+        e("2026-02-05", 1000, "p"),
+        e("2026-03-05", 1080, "p"),
+    ]
+    r = find_recurring(rows)[0]
+    assert (r.amount, r.months) == (1080, 3)
+    rows = [
+        e("2026-01-05", 980, "p"),
+        e("2026-02-05", 980, "p"),
+        e("2026-03-05", 1480, "p"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_two_subscriptions_same_category_and_amount_differ_by_memo():
+    rows = monthly("A", 1000, "2026-01-05", 3) + monthly("B", 1000, "2026-01-20", 3)
+    found = find_recurring(rows)
+    assert [(r.memo, r.next_date) for r in found] == [
+        ("A", date(2026, 4, 5)),
+        ("B", date(2026, 4, 20)),
+    ]
+
+
+def test_two_in_same_month_rejected():
+    rows = monthly("x", 1000, "2026-01-05", 3) + [e("2026-03-20", 1000, "x")]
+    assert find_recurring(rows) == []
+
+
+def test_gap_breaks_series():
+    rows = [
+        e("2026-01-05", 1000, "x"),
+        e("2026-02-05", 1000, "x"),
+        e("2026-04-05", 1000, "x"),
+        e("2026-05-05", 1000, "x"),
+    ]
+    assert find_recurring(rows) == []
+    rows.append(e("2026-06-05", 1000, "x"))
+    r = find_recurring(rows)[0]
+    assert (r.months, r.next_date) == (3, date(2026, 7, 5))
+
+
+def test_unsorted_input_and_ordering():
+    rows = monthly("small", 500, "2026-01-01", 3) + monthly(
+        "rent", 80000, "2026-01-25", 3
+    )
+    rows.reverse()
+    assert [r.memo for r in find_recurring(rows)] == ["rent", "small"]
+
+
+def test_empty_memo_groups_by_category():
+    rows = monthly("", 3000, "2026-01-05", 3, cat="家賃") + monthly(
+        "", 3000, "2026-01-05", 3, cat="保険"
+    )
+    assert [r.category for r in find_recurring(rows)] == ["保険", "家賃"]
