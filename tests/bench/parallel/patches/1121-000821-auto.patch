+"""Detect monthly recurring expenses (subscriptions, rent, ...) and predict the next one.
+
+Pure functions only: no I/O, no clock (the next date is derived from the data alone).
+
+Decisions:
+D1: 同一とみなすキーは (category, 正規化したメモ)。正規化は NFKC・大文字小文字無視・
+    空白の畳み込み・末尾の番号(空白 # - / 数字)の除去。メモが空ならカテゴリだけで束ねる。
+D2: 0 円以下(返金・無料)の行は系列に混ぜず無視する。
+D3: 金額が最小の 10% 以内に収まる行を同じ系列とみなす(値上げ・小さな揺れは同一)。
+    それを超えて離れた金額は別系列(同じカテゴリ・メモでも 980 円と 1480 円は別物)。
+D4: 1 つの系列で同じ月に 2 件以上ある場合は毎月の支出ではないとして捨てる。
+D5: 最新の月から遡って連続した月が min_months(既定 3)以上あれば繰り返しとみなす。
+    欠けた月があればそこで途切れ、それより前は数えない。min_months < 2 は ValueError。
+D6: 次の日付は最後の月の翌月。基準日は連続区間の中の最大の日で、月末は切り詰める
+    (31・31・28 の次は 3/31、1/31 の翌月は 2/28(閏年は 2/29))。12 月の次は翌年 1 月。
+D7: 予想金額は系列の最新の金額。メモの表示も最新の行のもの。
+D8: 並びは金額の降順、同点は category、memo の昇順。空入力は空リスト。
+"""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_TRAILING_NUMBER = re.compile(r"[\s#\-/0-9]+$")
+_SPACES = re.compile(r"\s+")
+_AMOUNT_TOLERANCE = 1.1
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int  # latest amount, yen
+    months: int  # length of the consecutive-month run
+    last_date: date
+    next_date: date
+
+
+def normalize_memo(memo: str) -> str:
+    s = _SPACES.sub(" ", unicodedata.normalize("NFKC", memo)).strip().casefold()
+    stripped = _TRAILING_NUMBER.sub("", s).strip()
+    return stripped or s
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month - 1
+
+
+def _add_month(d: date, anchor_day: int) -> date:
+    year, month0 = divmod(_month_index(d) + 1, 12)
+    month = month0 + 1
+    day = min(anchor_day, calendar.monthrange(year, month)[1])
+    return date(year, month, day)
+
+
+def _amount_clusters(rows: list[Expense]) -> list[list[Expense]]:
+    clusters: list[list[Expense]] = []
+    floor = 0
+    for e in sorted(rows, key=lambda e: e.amount):
+        if clusters and e.amount <= floor * _AMOUNT_TOLERANCE:
+            clusters[-1].append(e)
+        else:
+            clusters.append([e])
+            floor = e.amount
+    return clusters
+
+
+def _series(cluster: list[Expense], min_months: int) -> Recurring | None:
+    cluster = sorted(cluster, key=lambda e: e.day)
+    months = [_month_index(e.day) for e in cluster]
+    if len(set(months)) != len(months):  # D4
+        return None
+    run = [cluster[-1]]
+    for e in reversed(cluster[:-1]):
+        if _month_index(e.day) + 1 != _month_index(run[0].day):
+            break
+        run.insert(0, e)
+    if len(run) < min_months:
+        return None
+    last = run[-1]
+    anchor = max(e.day.day for e in run)
+    return Recurring(
+        category=last.category,
+        memo=last.memo,
+        amount=last.amount,
+        months=len(run),
+        last_date=last.day,
+        next_date=_add_month(last.day, anchor),
+    )
+
+
+def find_recurring(rows: list[Expense], min_months: int = 3) -> list[Recurring]:
+    """Monthly recurring expenses found in rows, each with its predicted next date."""
+    if min_months < 2:
+        raise ValueError("min_months は 2 以上である必要があります")
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        if e.amount <= 0:  # D2
+            continue
+        groups.setdefault((e.category, normalize_memo(e.memo)), []).append(e)
+    found: list[Recurring] = []
+    for group in groups.values():
+        for cluster in _amount_clusters(group):
+            r = _series(cluster, min_months)
+            if r is not None:
+                found.append(r)
+    return sorted(found, key=lambda r: (-r.amount, r.category, r.memo))
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..fe3b3fc
