diff --git a/tests/test_types/test_Choice.py b/tests/test_types/test_Choice.py
index c34f516..7079ea0 100644
--- a/tests/test_types/test_Choice.py
+++ b/tests/test_types/test_Choice.py
@@ -1,3 +1,5 @@
+import pytest
+
 import click
 
 
@@ -5,3 +7,48 @@ def test_choice_get_invalid_choice_message():
     choice = click.Choice(["a", "b", "c"])
     message = choice.get_invalid_choice_message("d", ctx=None)
     assert message == "'d' is not one of 'a', 'b', 'c'."
+
+
+@pytest.mark.parametrize(
+    ("choices", "value", "suggestion"),
+    [
+        (["push", "pull", "fetch"], "pus", "Did you mean 'push'?"),
+        (
+            ["declare", "refine", "push"],
+            "decline",
+            "(Did you mean one of: 'declare', 'refine'?)",
+        ),
+    ],
+)
+def test_choice_invalid_message_suggests_close_matches(choices, value, suggestion):
+    message = click.Choice(choices).get_invalid_choice_message(value, ctx=None)
+    assert message.endswith(suggestion)
+
+
+def test_choice_invalid_message_no_suggestion_when_far():
+    message = click.Choice(["foo", "bar", "baz"]).get_invalid_choice_message(
+        "meh", ctx=None
+    )
+    assert "Did you mean" not in message
+
+
+def test_choice_invalid_message_suggestion_case_insensitive():
+    choice = click.Choice(["Push", "Pull"], case_sensitive=False)
+    message = choice.get_invalid_choice_message("PUSHH", ctx=None)
+    assert message.endswith("Did you mean 'push'?")
+
+
+def test_choice_invalid_message_non_str_value():
+    message = click.Choice(["1", "2"]).get_invalid_choice_message(12, ctx=None)
+    assert "Did you mean" in message
+
+
+def test_choice_suggestion_in_cli_output(runner):
+    @click.command()
+    @click.option("--action", type=click.Choice(["push", "pull"]))
+    def cli(action):
+        pass
+
+    result = runner.invoke(cli, ["--action", "pus"])
+    assert result.exit_code == 2
+    assert "'pus' is not one of 'push', 'pull'. Did you mean 'push'?" in result.output
