+
+def test_within_tolerance_chains() -> None:
+    # 2026-02-08 は add_month(01-05)=02-05 から 3 日ずれ。tolerance=3 なら連なる
+    rows = [e("2026-01-05"), e("2026-02-08"), e("2026-03-05")]
+    result = find_recurring(rows, tolerance=3)
+    assert len(result) == 1
+
+
+def test_beyond_tolerance_breaks_chain() -> None:
+    # 4 日ずれ。tolerance=3 では切れる。切れた後の区間はどちらも 2 件なので該当なし
+    rows = [e("2026-01-05"), e("2026-02-09"), e("2026-03-09")]
+    assert find_recurring(rows, min_count=3, tolerance=3) == []
+
+
+def test_tolerance_boundary_is_inclusive() -> None:
+    rows = [e("2026-01-05"), e("2026-02-08"), e("2026-03-08")]
+    # 02-08 は 3 日ずれ(<= 3 で連なる)。03-08 は add_month(02-08)=03-08 で 0 日ずれ
+    assert len(find_recurring(rows, tolerance=3)) == 1
+    assert find_recurring(rows, tolerance=2) == []
+
+
+def test_tolerance_zero_requires_exact_month_day() -> None:
+    rows = [e("2026-01-05"), e("2026-02-05"), e("2026-03-06")]
+    assert find_recurring(rows, tolerance=0) == []
+
+
+def test_negative_offset_within_tolerance_chains() -> None:
+    # 早めに来た場合(d_{i+1} < add_month(d_i))も abs で許容される
+    rows = [e("2026-01-05"), e("2026-02-03"), e("2026-03-03")]
+    assert len(find_recurring(rows, tolerance=2)) == 1
+
+
+def test_chaining_uses_previous_date_for_month_add() -> None:
+    # 基準は直前の日付 d_i から翌月を求める。01-31 → 02-28 → 03-28 と連なる
+    rows = [e("2026-01-31"), e("2026-02-28"), e("2026-03-28")]
+    result = find_recurring(rows, tolerance=0)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 28)
