+def test_results_sorted_by_category_then_amount_then_first_day() -> None:
+    rows: list[Expense] = []
+    # 「食費」2 種類(金額違い)、「交通費」1 種類、さらに「食費 1000」の別区間
+    for d in ("2026-01-05", "2026-02-05", "2026-03-05"):
+        rows.append(e(d, "食費", 2000))
+        rows.append(e(d, "交通費", 500))
+        rows.append(e(d, "食費", 1000))
+    for d in ("2026-08-01", "2026-09-01", "2026-10-01"):
+        rows.append(e(d, "食費", 1000))
+
+    result = find_recurring(rows, min_count=3)
+    keys = [(r.category, r.amount, r.days[0]) for r in result]
+    assert keys == [
+        ("交通費", 500, date(2026, 1, 5)),
+        ("食費", 1000, date(2026, 1, 5)),
+        ("食費", 1000, date(2026, 8, 1)),
+        ("食費", 2000, date(2026, 1, 5)),
+    ]
+
