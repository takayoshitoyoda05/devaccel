+"""Monthly per-category budget check (pure functions).
+
+Reuses ``Budget`` from ``kakeibo.core`` (per-month limits via ``for_month``)
+and the ``{"YYYY-MM": {category: yen}}`` shape of ``monthly_totals``.
+
+Decisions:
+D1: ``Budget`` is reused from core; no second budget type is defined.
+D2: status is "over" if actual > limit, "warn" if actual >= limit * warn_ratio
+    (up to and including the limit), otherwise "ok". actual == limit is "warn".
+D3: ``warn_ratio`` must satisfy 0 < warn_ratio <= 1 (``bool`` and non-numbers
+    -> TypeError, out of range or nan -> ValueError). 1.0 disables early warning.
+D4: limit 0: any actual > 0 is "over"; actual 0 is "ok" (never "warn").
+D5: negative actual (refunds) is compared as is, so it is "ok".
+D6: categories without a limit are skipped; categories with a limit but no
+    spending in a month present in ``totals`` are reported with actual 0 ("ok").
+    Months absent from ``totals`` are not reported.
+D7: result order: month ascending, then over > warn > ok, then category name.
+D8: amounts in ``totals`` must be ``int`` (``bool``/``float``/``str`` -> TypeError).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from fractions import Fraction
+from typing import Literal
+
+from kakeibo.core import Budget
+
+Status = Literal["over", "warn", "ok"]
+
+_ORDER: dict[str, int] = {"over": 0, "warn": 1, "ok": 2}
+
+
+@dataclass(frozen=True)
+class BudgetStatus:
+    month: str
+    category: str
+    limit: int
+    actual: int
+    status: Status
+
+    @property
+    def remaining(self) -> int:
+        """limit - actual (negative when over budget)."""
+        return self.limit - self.actual
+
+
+def _check_ratio(warn_ratio: float) -> Fraction:
+    if isinstance(warn_ratio, bool) or not isinstance(warn_ratio, (int, float)):
+        raise TypeError("warn_ratio は数値である必要があります")
+    if not 0 < warn_ratio <= 1:  # also rejects nan
+        raise ValueError("warn_ratio は 0 より大きく 1 以下である必要があります")
+    return Fraction(str(warn_ratio))  # exact decimal: 0.8 -> 4/5
+
+
+def _classify(actual: int, limit: int, ratio: Fraction) -> Status:
+    if actual > limit:
+        return "over"
+    if limit > 0 and actual >= limit * ratio:
+        return "warn"
+    return "ok"
+
+
+def check_budget(
+    totals: dict[str, dict[str, int]],
+    budget: Budget,
+    warn_ratio: float = 0.8,
+) -> list[BudgetStatus]:
+    """Classify every budgeted category of every month in ``totals``."""
+    ratio = _check_ratio(warn_ratio)
+    out: list[BudgetStatus] = []
+    for month in sorted(totals):
+        cats = totals[month]
+        for cat, yen in cats.items():
+            if isinstance(yen, bool) or not isinstance(yen, int):
+                raise TypeError(f"{month}.{cat} の金額は整数である必要があります")
+        month_rows = []
+        for cat, limit in budget.for_month(month).items():
+            actual = cats.get(cat, 0)
+            month_rows.append(
+                BudgetStatus(month, cat, limit, actual, _classify(actual, limit, ratio))
+            )
+        month_rows.sort(key=lambda s: (_ORDER[s.status], s.category))
+        out.extend(month_rows)
+    return out
+
+
+def alerts(statuses: list[BudgetStatus]) -> list[BudgetStatus]:
+    """Only the "over" and "warn" entries, order preserved."""
+    return [s for s in statuses if s.status != "ok"]
diff --git a/tests/test_budget_status.py b/tests/test_budget_status.py
new file mode 100644
index 0000000..036f5c3
--- /dev/null
+++ b/tests/test_budget_status.py
@@ -0,0 +1,97 @@
+import pytest
+
+from kakeibo.budget import BudgetStatus, alerts, check_budget
+from kakeibo.core import Budget
+
+B = Budget(default={"食費": 1000, "交通": 500}, months={"2026-02": {"食費": 2000}})
+
+
+def st(totals, budget=B, **kw):
+    return {(s.month, s.category): s for s in check_budget(totals, budget, **kw)}
+
+
+def test_over_warn_ok():
+    r = st({"2026-01": {"食費": 1001, "交通": 400}})
+    assert r[("2026-01", "食費")].status == "over"
+    assert r[("2026-01", "交通")].status == "warn"  # 400 == 80% of 500
+    assert r[("2026-01", "食費")].remaining == -1
+    r = st({"2026-01": {"食費": 799, "交通": 399}})
+    assert {s.status for s in r.values()} == {"ok"}
+
+
+def test_equal_to_limit_is_warn():
+    assert st({"2026-01": {"食費": 1000}})[("2026-01", "食費")].status == "warn"
+
+
+def test_month_override():
+    r = st({"2026-02": {"食費": 1600}})
+    assert r[("2026-02", "食費")].limit == 2000
+    assert r[("2026-02", "食費")].status == "warn"
+
+
+def test_zero_limit():
+    b = Budget({"娯楽": 0}, {})
+    assert st({"2026-01": {"娯楽": 1}}, b)[("2026-01", "娯楽")].status == "over"
+    assert st({"2026-01": {"娯楽": 0}}, b)[("2026-01", "娯楽")].status == "ok"
+
+
+def test_negative_actual_is_ok():
+    assert st({"2026-01": {"食費": -500}})[("2026-01", "食費")].status == "ok"
+
+
+def test_unbudgeted_skipped_and_missing_spend_is_zero():
+    r = st({"2026-01": {"その他": 99999}})
+    assert ("2026-01", "その他") not in r
+    assert r[("2026-01", "食費")].actual == 0
+
+
+def test_months_absent_not_reported_and_empty():
+    assert check_budget({}, B) == []
+    assert {k[0] for k in st({"2026-03": {}})} == {"2026-03"}
+
+
+def test_ordering():
+    got = check_budget(
+        {"2026-02": {"食費": 1}, "2026-01": {"食費": 900, "交通": 600}}, B
+    )
+    assert [(s.month, s.category) for s in got] == [
+        ("2026-01", "交通"),
+        ("2026-01", "食費"),
+        ("2026-02", "交通"),  # ok だが同月内ではカテゴリ名順(交通 < 食費)
+        ("2026-02", "食費"),
+    ]
+
+
+def test_alerts_filters_ok():
+    got = alerts(check_budget({"2026-01": {"食費": 900, "交通": 0}}, B))
+    assert got == [BudgetStatus("2026-01", "食費", 1000, 900, "warn")]
+
+
+def test_warn_ratio_custom_and_exact():
+    assert (
+        st({"2026-01": {"食費": 500}}, warn_ratio=0.5)[("2026-01", "食費")].status
+        == "warn"
+    )
+    assert (
+        st({"2026-01": {"食費": 999}}, warn_ratio=1)[("2026-01", "食費")].status == "ok"
+    )
+    b = Budget({"a": 10}, {})  # 0.7 * 10 is 7.000000000000001 in float
+    assert st({"m": {"a": 7}}, b, warn_ratio=0.7)[("m", "a")].status == "warn"
+
+
+@pytest.mark.parametrize("bad", [0, -0.1, 1.01, float("nan")])
+def test_warn_ratio_value_error(bad):
+    with pytest.raises(ValueError, match="warn_ratio"):
+        check_budget({}, B, warn_ratio=bad)
+
+
+@pytest.mark.parametrize("bad", [True, "0.8", None])
+def test_warn_ratio_type_error(bad):
+    with pytest.raises(TypeError, match="warn_ratio"):
+        check_budget({}, B, warn_ratio=bad)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad", [True, 1.5, "100", None])
+def test_amount_type_error(bad):
+    with pytest.raises(TypeError, match="2026-01.食費"):
+        check_budget({"2026-01": {"食費": bad}}, B)  # type: ignore[dict-item]
