+++ b/src/kakeibo/topn.py
@@ -0,0 +1,17 @@
+"""Top-N expense selection."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def top_expenses(rows: list[Expense], n: int) -> list[Expense]:
+    """Return up to n expenses, largest amount first.
+
+    Ties on amount are broken by earlier date first; if still tied, input order
+    is kept (sorted() is stable). n <= 0 returns an empty list.
+    """
+    if n <= 0:
+        return []
+    ordered = sorted(rows, key=lambda e: (-e.amount, e.day))
+    return ordered[:n]
