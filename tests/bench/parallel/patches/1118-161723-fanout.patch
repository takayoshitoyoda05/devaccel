+++ b/src/kakeibo/split.py
@@ -0,0 +1,15 @@
+"""Split an amount in yen evenly among people."""
+
+from __future__ import annotations
+
+
+def split_evenly(amount: int, people: int) -> list[int]:
+    """Split ``amount`` yen among ``people``.
+
+    The remainder is distributed one yen at a time starting from the first
+    person, so the result always sums to ``amount``.
+    """
+    if people < 1:
+        raise ValueError(f"人数は 1 以上である必要があります: {people}")
+    base, remainder = divmod(amount, people)
+    return [base + 1 if i < remainder else base for i in range(people)]
diff --git a/src/kakeibo/stats.py b/src/kakeibo/stats.py
new file mode 100644
index 0000000..9452fdd
--- /dev/null
+++ b/src/kakeibo/stats.py
@@ -0,0 +1,21 @@
+"""Per-category statistics over expense rows."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def _median(values: list[int]) -> float:
+    ordered = sorted(values)
+    mid = len(ordered) // 2
+    if len(ordered) % 2 == 1:
+        return float(ordered[mid])
+    return (ordered[mid - 1] + ordered[mid]) / 2
+
+
+def median_by_category(rows: list[Expense]) -> dict[str, float]:
+    """{category: median amount}; keys in ascending category order. {} if no rows."""
+    by_cat: dict[str, list[int]] = {}
+    for e in rows:
+        by_cat.setdefault(e.category, []).append(e.amount)
+    return {cat: _median(by_cat[cat]) for cat in sorted(by_cat)}
