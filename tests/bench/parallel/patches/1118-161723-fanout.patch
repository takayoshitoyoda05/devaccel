--- /dev/null
+++ b/src/kakeibo/dupes.py
@@ -0,0 +1,25 @@
+"""Detect duplicate expense records."""
+
+from __future__ import annotations
+
+from collections import defaultdict
+
+from kakeibo.core import Expense
+
+
+def find_duplicates(rows: list[Expense]) -> list[tuple[int, int]]:
+    """Return index pairs (i, j), i < j, of rows that are fully equal.
+
+    Equality covers day, category, amount and memo (Expense's dataclass equality).
+    Pairs are ordered by i ascending, then j ascending.
+    """
+    groups: dict[Expense, list[int]] = defaultdict(list)
+    for idx, row in enumerate(rows):
+        groups[row].append(idx)
+    pairs = [
+        (i, j)
+        for idxs in groups.values()
+        for k, i in enumerate(idxs)
+        for j in idxs[k + 1 :]
+    ]
+    return sorted(pairs)
