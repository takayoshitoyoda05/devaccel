new file mode 100644
index 0000000..6ab12de
--- /dev/null
+++ b/src/kakeibo/weekday.py
@@ -0,0 +1,20 @@
+"""Totals by day of the week."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+# date.weekday() の値(月=0 ... 日=6)に対応する英語 3 文字。
+# strftime("%a") はロケールに依存するため使わない。
+_WEEKDAY_NAMES = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
+
+
+def total_by_weekday(rows: list[Expense]) -> dict[str, int]:
+    """{"Mon".."Sun": yen}。明細のない曜日は含めず、キーは月曜始まりの順。"""
+    totals = [0] * len(_WEEKDAY_NAMES)
+    seen = [False] * len(_WEEKDAY_NAMES)
+    for e in rows:
+        i = e.day.weekday()
+        totals[i] += e.amount
+        seen[i] = True
+    return {name: totals[i] for i, name in enumerate(_WEEKDAY_NAMES) if seen[i]}
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..8ff64f0
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,206 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import (
+    DEFAULT_MAPPING,
+    import_rows,
+    parse_amount,
+    parse_date,
+)
+from kakeibo.core import Expense
+
+# --- parse_amount ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥1", 1),
+        ("-980円", -980),
+        ("1,,2", 12),  # カンマの位置は検査しない
+        ("1,", 1),
+        ("-0", 0),
+    ],
+)
+def test_parse_amount_accepts(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "円",
+        "12.5",
+        "1 200",
+        "--5",
+        "¥-5",
+        "１２３",
+        "-",
+        "¥",
+        ",1",
+        "1円円",
+        "1 円",
+    ],
+)
+def test_parse_amount_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+# --- parse_date -----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/1/5 ", date(2026, 1, 5)),
+        ("2026/12/31", date(2026, 12, 31)),
+        ("2026-1-5", date(2026, 1, 5)),
+    ],
+)
+def test_parse_date_accepts(text: str, expected: date) -> None:
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026/1-5",  # 区切りの混在
+        "26/1/5",  # 年が 4 桁でない
+        "2026/02/30",  # 存在しない日付
+        "2026/13/1",
+        "2026/1/5/",
+        "abc",
+        "",
+        "２０２６/1/5",  # 全角数字
+        "2026/123/1",
+    ],
+)
+def test_parse_date_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+# --- import_rows ----------------------------------------------------------
+
+
+def test_default_mapping_constant() -> None:
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_import_basic_default_mapping_keeps_order() -> None:
+    text = '利用日,分類,利用金額,利用店名\n2026/1/5,食費,"1,200",  スーパー  \n2026-01-06,交通,300円,駅\n'
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [
+        Expense(date(2026, 1, 5), "食費", 1200, "スーパー"),
+        Expense(date(2026, 1, 6), "交通", 300, "駅"),
+    ]
+
+
+def test_quoted_comma_in_memo_and_extra_columns_ignored() -> None:
+    text = '利用日,分類,利用金額,利用店名,備考\n2026/1/5,食費,500,"マック, 新宿",無視\n'
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 500, "マック, 新宿")]
+
+
+def test_custom_mapping_and_missing_memo_gives_empty_string() -> None:
+    text = "day,cat,yen\n2026/1/5,食費,500\n"
+    mapping = {"date": "day", "category": "cat", "amount": "yen"}
+    rows, errors = import_rows(text, mapping)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 500, "")]
+
+
+def test_mapping_missing_required_key_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows("a,b,c\n", {"date": "a", "category": "b"})
+
+
+def test_mapping_column_not_in_header_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows(
+            "利用日,分類,利用金額\n",
+            {"date": "利用日", "category": "分類", "amount": "無い列"},
+        )
+
+
+def test_blank_lines_are_skipped_but_counted() -> None:
+    text = "利用日,分類,利用金額\n\n2026/1/5,食費,x\n"
+    rows, errors = import_rows(
+        text, {"date": "利用日", "category": "分類", "amount": "利用金額"}
+    )
+    assert rows == []
+    assert errors == [(3, "amount")]
+
+
+def test_multiple_errors_in_one_row_recorded_in_order_and_row_excluded() -> None:
+    text = "利用日,分類,利用金額\n2026/1/5,食費,500\nxx,,abc\n2026/1/7,,100\n"
+    rows, errors = import_rows(
+        text, {"date": "利用日", "category": "分類", "amount": "利用金額"}
+    )
+    assert rows == [Expense(date(2026, 1, 5), "食費", 500, "")]
+    assert errors == [(3, "date"), (3, "amount"), (3, "category"), (4, "category")]
+
+
+def test_short_row_missing_values_treated_as_empty() -> None:
+    text = "利用日,分類,利用金額,利用店名\n2026/1/5\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "amount"), (2, "category")]
+
+
+def test_category_whitespace_only_is_error() -> None:
+    text = "利用日,分類,利用金額\n2026/1/5,   ,100\n"
+    rows, errors = import_rows(
+        text, {"date": "利用日", "category": "分類", "amount": "利用金額"}
+    )
+    assert rows == []
+    assert errors == [(2, "category")]
+
+
+def test_category_map_applied_after_strip_and_memo_not_mapped() -> None:
+    text = "利用日,分類,利用金額,利用店名\n2026/1/5, 食費 ,100,食費\n"
+    rows, errors = import_rows(text, category_map={"食費": "Food"})
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "Food", 100, "食費")]
+
+
+def test_category_map_without_key_keeps_category() -> None:
+    text = "利用日,分類,利用金額\n2026/1/5,交通,100\n"
+    rows, errors = import_rows(
+        text,
+        {"date": "利用日", "category": "分類", "amount": "利用金額"},
+        {"食費": "Food"},
+    )
+    assert rows == [Expense(date(2026, 1, 5), "交通", 100, "")]
+    assert errors == []
+
+
+def test_multiline_quoted_record_reports_start_line() -> None:
+    text = '利用日,分類,利用金額,利用店名\n2026/1/5,食費,100,"改行\nあり"\n2026/1/x,食費,100,\n'
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "改行\nあり")]
+    assert errors == [(4, "date")]
+
+
+def test_header_only_returns_empty() -> None:
+    rows, errors = import_rows("利用日,分類,利用金額,利用店名\n")
+    assert rows == []
+    assert errors == []
