--- /dev/null
+++ b/tests/test_split.py
@@ -0,0 +1,46 @@
+import pytest
+
+from kakeibo.split import split_evenly
+
+
+def test_even_division() -> None:
+    assert split_evenly(10, 2) == [5, 5]
+
+
+def test_remainder_goes_to_first_people() -> None:
+    assert split_evenly(10, 3) == [4, 3, 3]
+
+
+def test_remainder_one_yen_each_from_front() -> None:
+    assert split_evenly(2, 5) == [1, 1, 0, 0, 0]
+
+
+def test_amount_zero_gives_all_zero() -> None:
+    assert split_evenly(0, 3) == [0, 0, 0]
+
+
+def test_single_person_gets_everything() -> None:
+    assert split_evenly(1234, 1) == [1234]
+
+
+def test_amount_zero_single_person() -> None:
+    assert split_evenly(0, 1) == [0]
+
+
+def test_people_zero_raises() -> None:
+    with pytest.raises(ValueError):
+        split_evenly(100, 0)
+
+
+def test_people_negative_raises() -> None:
+    with pytest.raises(ValueError):
+        split_evenly(100, -1)
+
+
+@pytest.mark.parametrize("amount", [0, 1, 7, 99, 1000, 12345])
+@pytest.mark.parametrize("people", [1, 2, 3, 7, 10])
+def test_sum_matches_and_length_matches(amount: int, people: int) -> None:
+    parts = split_evenly(amount, people)
+    assert len(parts) == people
+    assert sum(parts) == amount
+    assert max(parts) - min(parts) <= 1
