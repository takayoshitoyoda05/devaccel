diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..5bc360e
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,223 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def _e(y, m, d, cat, amount):
+    return Expense(date(y, m, d), cat, amount)
+
+
+ROWS = [
+    _e(2026, 10, 1, "food", 1000),
+    _e(2026, 10, 2, "rent", 80000),
+    _e(2026, 10, 3, "misc", 500),
+    _e(2026, 11, 1, "food", 1300),
+    _e(2026, 11, 2, "rent", 80000),
+    _e(2026, 11, 3, "fun", 2000),
+]
+
+
+def _by_cat(diffs):
+    return {r.category: r for r in diffs}
+
+
+# --- month_diff: 基本の状態と値 ---
+
+
+def test_month_diff_statuses_and_values():
+    r = _by_cat(month_diff(ROWS, "2026-10", "2026-11"))
+    assert r["food"] == DiffRow("food", 1000, 1300, 300, 30.0, "up")
+    assert r["rent"] == DiffRow("rent", 80000, 80000, 0, 0.0, "same")
+    assert r["misc"] == DiffRow("misc", 500, 0, -500, -100.0, "gone")
+    assert r["fun"] == DiffRow("fun", 0, 2000, 2000, None, "new")
+
+
+def test_month_diff_down_status():
+    rows = [_e(2026, 10, 1, "food", 1000), _e(2026, 11, 1, "food", 400)]
+    (r,) = month_diff(rows, "2026-10", "2026-11")
+    assert (r.delta, r.pct, r.status) == (-600, -60.0, "down")
+
+
+def test_month_diff_only_listed_categories_and_empty_input():
+    # 2 つの月のどちらにも明細が無いカテゴリは出ない
+    rows = [_e(2026, 9, 1, "old", 10), _e(2026, 10, 1, "food", 5)]
+    assert [r.category for r in month_diff(rows, "2026-10", "2026-11")] == ["food"]
+    assert month_diff([], "2026-10", "2026-11") == []
+
+
+def test_month_diff_pct_rounds_to_one_decimal():
+    rows = [_e(2026, 10, 1, "a", 3), _e(2026, 11, 1, "a", 4)]
+    (r,) = month_diff(rows, "2026-10", "2026-11")
+    assert r.pct == round(1 / 3 * 100, 1) == 33.3
+
+
+def test_month_diff_zero_prev_total_gives_none_pct_but_presence_decides_status():
+    # 前月に明細はあるが合計 0: status は new ではなく up、pct は None
+    rows = [_e(2026, 10, 1, "a", 0), _e(2026, 11, 1, "a", 300)]
+    (r,) = month_diff(rows, "2026-10", "2026-11")
+    assert (r.prev, r.curr, r.delta, r.pct, r.status) == (0, 300, 300, None, "up")
+
+
+def test_month_diff_zero_both_is_same_not_new():
+    rows = [_e(2026, 10, 1, "a", 0), _e(2026, 11, 1, "a", 0)]
+    (r,) = month_diff(rows, "2026-10", "2026-11")
+    assert (r.delta, r.pct, r.status) == (0, None, "same")
+
+
+def test_month_diff_multiple_rows_per_category_are_summed():
+    rows = [
+        _e(2026, 10, 1, "food", 400),
+        _e(2026, 10, 30, "food", 600),
+        _e(2026, 11, 1, "food", 500),
+        _e(2026, 11, 2, "food", 500),
+    ]
+    (r,) = month_diff(rows, "2026-10", "2026-11")
+    assert (r.prev, r.curr, r.delta) == (1000, 1000, 0)
+    assert r.status == "same"
+
+
+def test_month_diff_negative_amounts_use_same_formula():
+    # 返金などで負の合計になっても pct は delta / prev * 100 のまま
+    rows = [_e(2026, 10, 1, "x", -200), _e(2026, 11, 1, "x", -100)]
+    (r,) = month_diff(rows, "2026-10", "2026-11")
+    assert (r.delta, r.pct, r.status) == (100, -50.0, "up")
+
+
+# --- month_diff: 月の形式 ---
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        "2026-1",
+        "2026-13",
+        "2026-00",
+        "202611",
+        "2026/11",
+        "26-11",
+        "2026-11\n",
+        " 2026-11",
+        "",
+        "２０２６-11",
+    ],
+)
+def test_month_diff_rejects_bad_month(bad):
+    with pytest.raises(ValueError):
+        month_diff(ROWS, bad, "2026-11")
+    with pytest.raises(ValueError):
+        month_diff(ROWS, "2026-10", bad)
+
+
+# --- 並び順 ---
+
+
+def test_month_diff_sorted_by_abs_delta_then_category():
+    rows = [
+        _e(2026, 10, 1, "b", 500),
+        _e(2026, 11, 1, "b", 400),  # -100
+        _e(2026, 10, 1, "a", 300),
+        _e(2026, 11, 1, "a", 400),  # +100
+        _e(2026, 11, 1, "c", 1000),  # +1000
+    ]
+    got = [(r.category, r.delta) for r in month_diff(rows, "2026-10", "2026-11")]
+    assert got == [("c", 1000), ("a", 100), ("b", -100)]
+
+
+# --- top_movers ---
+
+
+def test_top_movers_excludes_same_and_keeps_order():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    got = [r.category for r in top_movers(diffs)]
+    assert got == ["fun", "misc", "food"]  # rent (same) は除外
+
+
+def test_top_movers_limits_n():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    assert [r.category for r in top_movers(diffs, 1)] == ["fun"]
+    assert [r.category for r in top_movers(diffs, 0)] == []
+    assert [r.category for r in top_movers(diffs, 99)] == ["fun", "misc", "food"]
+
+
+def test_top_movers_default_n_is_three():
+    rows = [_e(2026, 10, 1, f"c{i}", 0) for i in range(5)]
+    rows += [_e(2026, 11, 1, f"c{i}", i + 1) for i in range(5)]
+    diffs = month_diff(rows, "2026-10", "2026-11")
+    assert len(top_movers(diffs)) == 3
+
+
+def test_top_movers_rejects_negative_n():
+    with pytest.raises(ValueError):
+        top_movers([], -1)
+
+
+# --- render_diff ---
+
+
+def test_render_diff_format():
+    diffs = [
+        DiffRow("fun", 0, 2000, 2000, None, "new"),
+        DiffRow("food", 1000, 1300, 300, 30.0, "up"),
+        DiffRow("misc", 500, 0, -500, -100.0, "gone"),
+        DiffRow("rent", 80000, 80000, 0, 0.0, "same"),
+    ]
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "fun\t0\t2000\t+2000\t-\n"
+        "food\t1000\t1300\t+300\t+30.0%\n"
+        "misc\t500\t0\t-500\t-100.0%\n"
+        "rent\t80000\t80000\t+0\t+0.0%"
+    )
+
+
+def test_render_diff_negative_zero_pct_has_no_minus_sign():
+    row = DiffRow("x", 10000, 9999, -1, -0.0, "down")
+    assert render_diff([row]).split("\n")[1] == "x\t10000\t9999\t-1\t+0.0%"
+
+
+def test_render_diff_header_only_when_empty_and_no_trailing_newline():
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+    assert not render_diff(month_diff(ROWS, "2026-10", "2026-11")).endswith("\n")
+
+
+# --- available_months / latest_diff ---
+
+
+def test_available_months_sorted_unique_and_skips_empty_months():
+    rows = [
+        _e(2026, 1, 5, "a", 1),
+        _e(2025, 12, 31, "a", 1),
+        _e(2026, 1, 1, "a", 1),
+        _e(2026, 3, 1, "a", 1),
+    ]
+    assert available_months(rows) == ["2025-12", "2026-01", "2026-03"]
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months():
+    rows = [
+        _e(2026, 9, 1, "food", 9999),
+        _e(2026, 10, 1, "food", 1000),
+        _e(2026, 11, 1, "food", 1300),
+    ]
+    assert latest_diff(rows) == month_diff(rows, "2026-10", "2026-11")
+    assert latest_diff(rows)[0].status == "up"
+
+
+def test_latest_diff_requires_two_months():
+    with pytest.raises(ValueError):
+        latest_diff([])
+    with pytest.raises(ValueError):
+        latest_diff([_e(2026, 11, 1, "food", 1)])
+    with pytest.raises(ValueError):
+        latest_diff([_e(2026, 11, 1, "food", 1), _e(2026, 11, 2, "rent", 2)])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..b58defd
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,271 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+E = Expense(date(2024, 1, 5), "食費", 1200, "Lunch with Bob")
+F = Expense(date(2024, 2, 1), "交通費", 300, "")
+
+
+# --- tokenize ---------------------------------------------------------------
+
+
+def test_tokenize_empty_and_whitespace_only_gives_no_tokens() -> None:
+    assert tokenize("") == []
+    assert tokenize("   \t ") == []
+
+
+def test_tokenize_whitespace_is_only_a_separator() -> None:
+    assert tokenize("  a   b ") == [("TERM", "a"), ("TERM", "b")]
+
+
+def test_tokenize_parens() -> None:
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+
+
+def test_tokenize_word_stops_at_paren() -> None:
+    assert tokenize("a(b") == [("TERM", "a"), ("LPAREN", "("), ("TERM", "b")]
+
+
+def test_tokenize_quoted_keeps_spaces_and_parens() -> None:
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+
+
+def test_tokenize_quote_has_no_escape() -> None:
+    # 最初の " から次の " までが引用。バックスラッシュは普通の文字。
+    assert tokenize('"a\\" b') == [("TERM", "a\\"), ("TERM", "b")]
+
+
+def test_tokenize_unclosed_quote_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_quoted_whitespace_is_not_empty() -> None:
+    assert tokenize('"  "') == [("TERM", "  ")]
+
+
+def test_tokenize_operators_only_uppercase() -> None:
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+    assert tokenize("and or not") == [
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_operator_must_be_whole_word() -> None:
+    assert tokenize("NOTE ANDY") == [("TERM", "NOTE"), ("TERM", "ANDY")]
+
+
+def test_tokenize_quoted_operator_is_term() -> None:
+    assert tokenize('"AND"') == [("TERM", "AND")]
+
+
+def test_tokenize_cat_prefix() -> None:
+    assert tokenize("cat:食費") == [("CAT", "食費")]
+
+
+def test_tokenize_cat_keeps_rest_verbatim() -> None:
+    assert tokenize("cat:AND") == [("CAT", "AND")]
+
+
+def test_tokenize_cat_empty_value_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+    with pytest.raises(QueryError):
+        tokenize("cat: x")
+
+
+def test_tokenize_quoted_cat_is_term() -> None:
+    assert tokenize('"cat:食費"') == [("TERM", "cat:食費")]
+
+
+def test_tokenize_uppercase_cat_is_term() -> None:
+    assert tokenize("CAT:食費") == [("TERM", "CAT:食費")]
+
+
+def test_tokenize_word_adjacent_to_quote() -> None:
+    assert tokenize('ab"cd"') == [("TERM", "ab"), ("TERM", "cd")]
+
+
+# --- parse / evaluate: primaries and operators -------------------------------
+
+
+def test_term_matches_memo_substring_case_insensitively() -> None:
+    assert matches("bob", E)
+    assert matches("LUNCH", E)
+
+
+def test_term_matches_category_substring() -> None:
+    assert matches("食", E)
+
+
+def test_term_no_match() -> None:
+    assert not matches("dinner", E)
+
+
+def test_term_empty_memo_only_matches_category() -> None:
+    assert not matches("x", F)
+    assert matches("交通", F)
+
+
+def test_cat_requires_exact_category_case_insensitively() -> None:
+    assert matches("cat:食費", E)
+    assert not matches("cat:食", E)  # 部分一致ではない
+    assert not matches("cat:Lunch", E)  # memo は見ない
+
+
+def test_cat_casefold() -> None:
+    e = Expense(date(2024, 1, 1), "Food", 1, "")
+    assert matches("cat:FOOD", e)
+    assert matches("cat:food", e)
+
+
+def test_term_uses_casefold_not_lower() -> None:
+    # "ß".casefold() == "ss"。lower() では一致しない。
+    e = Expense(date(2024, 1, 1), "x", 1, "straße")
+    assert matches("STRASSE", e)
+
+
+def test_implicit_and() -> None:
+    assert matches("lunch bob", E)
+    assert not matches("lunch dinner", E)
+
+
+def test_explicit_and() -> None:
+    assert matches("lunch AND bob", E)
+    assert not matches("lunch AND dinner", E)
+
+
+def test_or() -> None:
+    assert matches("dinner OR bob", E)
+    assert not matches("dinner OR tea", E)
+
+
+def test_not() -> None:
+    assert matches("NOT cat:交通費", E)
+    assert not matches("NOT bob", E)
+
+
+def test_not_not() -> None:
+    assert matches("NOT NOT bob", E)
+
+
+def test_precedence_and_binds_tighter_than_or() -> None:
+    # a OR (b AND c)
+    assert matches("bob OR nope AND nope", E)
+    assert not matches("nope OR nope AND bob", E)
+
+
+def test_precedence_not_binds_tighter_than_and() -> None:
+    # (NOT a) AND b
+    assert matches("NOT nope bob", E)
+    assert not matches("NOT lunch bob", E)
+
+
+def test_not_applies_to_primary_not_whole_and() -> None:
+    # "NOT lunch bob" は (NOT lunch) AND bob。NOT (lunch AND bob) ではない。
+    only_bob = Expense(date(2024, 1, 1), "食費", 1, "bob")
+    only_lunch = Expense(date(2024, 1, 1), "食費", 1, "lunch")
+    assert matches("NOT lunch bob", only_bob)
+    assert not matches("NOT lunch bob", only_lunch)
+
+
+def test_parens_override_precedence() -> None:
+    assert not matches("(bob OR nope) AND nope", E)
+    assert matches("bob OR (nope AND nope)", E)
+
+
+def test_nested_parens() -> None:
+    assert matches("((bob))", E)
+    assert matches("NOT (nope OR nope)", E)
+
+
+def test_implicit_and_with_parens() -> None:
+    assert matches("(lunch) (bob)", E)
+
+
+def test_empty_memo_matches_term_only_by_category() -> None:
+    assert matches("NOT lunch", F)
+
+
+# --- grammar errors -----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(a",
+        "a)",
+        ")a(",
+        "a OR",
+        "OR a",
+        "a AND",
+        "AND a",
+        "a AND AND b",
+        "a OR OR b",
+        "NOT",
+        "a NOT",
+        "( )",
+        "a ()",
+        "(a) ()",
+    ],
+)
+def test_grammar_errors(q: str) -> None:
+    with pytest.raises(QueryError):
+        matches(q, E)
+
+
+def test_empty_query_error_even_for_no_rows() -> None:
+    with pytest.raises(QueryError):
+        filter_rows("", [])
+
+
+def test_invalid_query_error_even_for_no_rows() -> None:
+    with pytest.raises(QueryError):
+        filter_rows("a OR", [])
+
+
+def test_tokenizer_errors_surface_through_matches() -> None:
+    with pytest.raises(QueryError):
+        matches('"abc', E)
+    with pytest.raises(QueryError):
+        matches("cat:", E)
+
+
+# --- filter_rows --------------------------------------------------------------
+
+
+def test_filter_rows_keeps_input_order() -> None:
+    rows = [F, E, Expense(date(2024, 3, 1), "食費", 50, "bob again")]
+    got = filter_rows("bob", rows)
+    assert got == [E, rows[2]]
+
+
+def test_filter_rows_empty_result() -> None:
+    assert filter_rows("nothing", [E, F]) == []
+
+
+def test_filter_rows_empty_input_valid_query() -> None:
+    assert filter_rows("bob", []) == []
+
+
+def test_filter_rows_does_not_mutate_input() -> None:
+    rows = [E, F]
+    filter_rows("cat:食費", rows)
+    assert rows == [E, F]
+
+
+def test_filter_rows_with_not() -> None:
+    assert filter_rows("NOT cat:食費", [E, F]) == [F]
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..096a0ac
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,216 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def e(day: date, category: str = "通信", amount: int = 1000, memo: str = "") -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- add_month -------------------------------------------------------------
+
+
+def test_add_month_same_day() -> None:
+    assert add_month(date(2026, 1, 15)) == date(2026, 2, 15)
+
+
+def test_add_month_year_rollover() -> None:
+    assert add_month(date(2026, 12, 15)) == date(2027, 1, 15)
+
+
+def test_add_month_dec_31_rolls_over_without_clamp() -> None:
+    assert add_month(date(2026, 12, 31)) == date(2027, 1, 31)
+
+
+def test_add_month_clamps_to_non_leap_february() -> None:
+    assert add_month(date(2026, 1, 31)) == date(2026, 2, 28)
+
+
+def test_add_month_clamps_to_leap_february() -> None:
+    assert add_month(date(2024, 1, 31)) == date(2024, 2, 29)
+
+
+def test_add_month_clamps_to_30_day_month() -> None:
+    assert add_month(date(2025, 3, 31)) == date(2025, 4, 30)
+
+
+# --- find_recurring: argument validation -----------------------------------
+
+
+def test_min_count_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+
+
+def test_min_count_two_is_allowed() -> None:
+    rows = [e(date(2026, 1, 15)), e(date(2026, 2, 15))]
+    assert len(find_recurring(rows, min_count=2)) == 1
+
+
+def test_negative_tolerance_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_zero_tolerance_is_allowed() -> None:
+    rows = [e(date(2026, 1, 15)), e(date(2026, 2, 15)), e(date(2026, 3, 15))]
+    assert len(find_recurring(rows, tolerance=0)) == 1
+
+
+# --- find_recurring: basic behaviour ---------------------------------------
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+def test_three_monthly_rows_form_one_recurring() -> None:
+    rows = [e(date(2026, 1, 15)), e(date(2026, 2, 15)), e(date(2026, 3, 15))]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="通信",
+            amount=1000,
+            days=(date(2026, 1, 15), date(2026, 2, 15), date(2026, 3, 15)),
+            next_expected=date(2026, 4, 15),
+        )
+    ]
+
+
+def test_fewer_than_min_count_is_excluded() -> None:
+    rows = [e(date(2026, 1, 15)), e(date(2026, 2, 15))]
+    assert find_recurring(rows) == []
+
+
+def test_run_exactly_min_count_is_included() -> None:
+    rows = [e(date(2026, 1, 15)), e(date(2026, 2, 15)), e(date(2026, 3, 15))]
+    assert len(find_recurring(rows, min_count=3)) == 1
+    assert find_recurring(rows, min_count=4) == []
+
+
+def test_memo_is_ignored_when_grouping() -> None:
+    rows = [
+        e(date(2026, 1, 15), memo="a"),
+        e(date(2026, 2, 15), memo="b"),
+        e(date(2026, 3, 15), memo=""),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_different_amount_is_a_separate_group() -> None:
+    rows = [
+        e(date(2026, 1, 15), amount=1000),
+        e(date(2026, 2, 15), amount=2000),
+        e(date(2026, 3, 15), amount=1000),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_different_category_is_a_separate_group() -> None:
+    rows = [
+        e(date(2026, 1, 15), category="通信"),
+        e(date(2026, 2, 15), category="娯楽"),
+        e(date(2026, 3, 15), category="通信"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_duplicate_days_are_counted_once() -> None:
+    rows = [
+        e(date(2026, 1, 15)),
+        e(date(2026, 1, 15), memo="dup"),
+        e(date(2026, 2, 15)),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_input_order_does_not_matter() -> None:
+    rows = [e(date(2026, 3, 15)), e(date(2026, 1, 15)), e(date(2026, 2, 15))]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 15), date(2026, 2, 15), date(2026, 3, 15))
+
+
+def test_year_rollover_run() -> None:
+    rows = [e(date(2026, 11, 15)), e(date(2026, 12, 15)), e(date(2027, 1, 15))]
+    result = find_recurring(rows)
+    assert result[0].next_expected == date(2027, 2, 15)
+
+
+# --- find_recurring: tolerance ---------------------------------------------
+
+
+def test_drift_within_tolerance_connects() -> None:
+    # add_month(1/15) = 2/15; 2/18 is +3 days -> connected at tolerance 3
+    rows = [e(date(2026, 1, 15)), e(date(2026, 2, 18)), e(date(2026, 3, 15))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+
+
+def test_early_drift_within_tolerance_connects() -> None:
+    # 2/12 is -3 days from 2/15 -> connected at tolerance 3
+    rows = [e(date(2026, 1, 15)), e(date(2026, 2, 12)), e(date(2026, 3, 15))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+
+
+def test_drift_beyond_tolerance_splits() -> None:
+    # 2/19 is +4 days from 2/15 -> not connected at tolerance 3
+    rows = [e(date(2026, 1, 15)), e(date(2026, 2, 19)), e(date(2026, 3, 15))]
+    assert find_recurring(rows, min_count=2, tolerance=3) == []
+
+
+def test_link_is_measured_from_previous_day_with_month_clamp() -> None:
+    # add_month(1/31) = 2/28 (0 days off); add_month(2/28) = 3/28, and 3/31 is +3 -> linked
+    rows = [e(date(2026, 1, 31)), e(date(2026, 2, 28)), e(date(2026, 3, 31))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+    # with tolerance 2 the 3/31 link breaks, so no run of 3 remains
+    assert find_recurring(rows, tolerance=2) == []
+
+
+# --- find_recurring: run splitting and output ordering ---------------------
+
+
+def test_gap_splits_into_separate_recurrings() -> None:
+    rows = [
+        e(date(2026, 1, 15)),
+        e(date(2026, 2, 15)),
+        e(date(2026, 3, 15)),
+        e(date(2026, 6, 15)),
+        e(date(2026, 7, 15)),
+        e(date(2026, 8, 15)),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 15), date(2026, 6, 15)]
+    assert result[0].next_expected == date(2026, 4, 15)
+    assert result[1].next_expected == date(2026, 9, 15)
+
+
+def test_short_run_after_split_is_dropped() -> None:
+    rows = [
+        e(date(2026, 1, 15)),
+        e(date(2026, 2, 15)),
+        e(date(2026, 3, 15)),
+        e(date(2026, 6, 15)),
+        e(date(2026, 7, 15)),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days[0] == date(2026, 1, 15)
+
+
+def test_results_sorted_by_category_then_amount_then_first_day() -> None:
+    rows = [
+        e(date(2026, 1, 1), category="娯楽", amount=500),
+        e(date(2026, 2, 1), category="娯楽", amount=500),
+        e(date(2026, 3, 1), category="娯楽", amount=500),
+        e(date(2026, 1, 2), category="通信", amount=900),
+        e(date(2026, 2, 2), category="通信", amount=900),
+        e(date(2026, 3, 2), category="通信", amount=900),
+        e(date(2026, 1, 3), category="通信", amount=100),
+        e(date(2026, 2, 3), category="通信", amount=100),
+        e(date(2026, 3, 3), category="通信", amount=100),
+    ]
+    keys = [(r.category, r.amount) for r in find_recurring(rows)]
+    assert keys == [("娯楽", 500), ("通信", 100), ("通信", 900)]
diff --git a/tests/test_split.py b/tests/test_split.py
new file mode 100644
