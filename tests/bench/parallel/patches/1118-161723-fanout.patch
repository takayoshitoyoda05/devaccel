@@ -0,0 +1,53 @@
+import json
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.export import to_json
+
+
+def test_empty_list_gives_empty_array():
+    assert to_json([]) == "[]"
+
+
+def test_single_row_has_keys_in_order_and_iso_date():
+    rows = [Expense(day=date(2026, 3, 5), category="食費", amount=1200, memo="昼")]
+    assert to_json(rows) == (
+        '[{"date": "2026-03-05", "category": "食費", "amount": 1200, "memo": "昼"}]'
+    )
+
+
+def test_keeps_input_order_and_does_not_sort():
+    rows = [
+        Expense(day=date(2026, 3, 9), category="外食", amount=800),
+        Expense(day=date(2026, 3, 1), category="交通", amount=200),
+    ]
+    data = json.loads(to_json(rows))
+    assert [d["date"] for d in data] == ["2026-03-09", "2026-03-01"]
+
+
+def test_non_ascii_is_not_escaped():
+    rows = [
+        Expense(day=date(2026, 1, 2), category="日用品", amount=5, memo="ティッシュ")
+    ]
+    out = to_json(rows)
+    assert "日用品" in out
+    assert "ティッシュ" in out
+    assert "\\u" not in out
+
+
+def test_empty_memo_is_kept_as_empty_string():
+    rows = [Expense(day=date(2026, 1, 2), category="食費", amount=100)]
+    data = json.loads(to_json(rows))
+    assert data[0]["memo"] == ""
+
+
+def test_output_has_no_indentation_or_newlines():
+    rows = [Expense(day=date(2026, 1, 2), category="食費", amount=100, memo="a")]
+    assert "\n" not in to_json(rows)
+
+
+def test_amount_is_integer_in_json():
+    rows = [Expense(day=date(2026, 1, 2), category="食費", amount=0)]
+    data = json.loads(to_json(rows))
+    assert data[0]["amount"] == 0
+    assert isinstance(data[0]["amount"], int)
