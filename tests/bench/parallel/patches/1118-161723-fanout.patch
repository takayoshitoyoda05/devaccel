@@ -0,0 +1,72 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.dupes import find_duplicates
+
+A = Expense(date(2026, 1, 5), "食費", 1200, "lunch")
+B = Expense(date(2026, 1, 6), "交通", 300, "bus")
+
+
+def test_empty_list_has_no_duplicates() -> None:
+    assert find_duplicates([]) == []
+
+
+def test_single_row_has_no_duplicates() -> None:
+    assert find_duplicates([A]) == []
+
+
+def test_two_distinct_rows_have_no_duplicates() -> None:
+    assert find_duplicates([A, B]) == []
+
+
+def test_identical_pair_is_reported() -> None:
+    assert find_duplicates([A, A]) == [(0, 1)]
+
+
+def test_triple_reports_every_pair_in_order() -> None:
+    assert find_duplicates([A, A, A]) == [(0, 1), (0, 2), (1, 2)]
+
+
+def test_non_adjacent_duplicates_use_input_indices() -> None:
+    assert find_duplicates([A, B, A]) == [(0, 2)]
+
+
+def test_result_sorted_by_i_then_j() -> None:
+    # A at 0,2 and B at 1,3 -> pairs (0,2) and (1,3); order must be i asc, then j asc.
+    assert find_duplicates([A, B, A, B]) == [(0, 2), (1, 3)]
+
+
+def test_mixed_groups_sorted_by_i_then_j() -> None:
+    # A at 0,3 -> (0,3); B at 1,2 -> (1,2). Sorted by i: (0,3) before (1,2).
+    assert find_duplicates([A, B, B, A]) == [(0, 3), (1, 2)]
+
+
+@pytest.mark.parametrize(
+    "other",
+    [
+        Expense(date(2026, 1, 6), "食費", 1200, "lunch"),  # day differs
+        Expense(date(2026, 1, 5), "交通", 1200, "lunch"),  # category differs
+        Expense(date(2026, 1, 5), "食費", 1201, "lunch"),  # amount differs
+        Expense(date(2026, 1, 5), "食費", 1200, "dinner"),  # memo differs
+    ],
+)
+def test_rows_differing_in_any_single_field_are_not_duplicates(other: Expense) -> None:
+    assert find_duplicates([A, other]) == []
+
+
+def test_empty_memo_equal_to_empty_memo_is_duplicate() -> None:
+    x = Expense(date(2026, 2, 1), "雑費", 500)
+    y = Expense(date(2026, 2, 1), "雑費", 500, "")
+    assert find_duplicates([x, y]) == [(0, 1)]
+
+
+def test_equal_fields_with_different_memo_is_not_duplicate_even_if_memo_empty_vs_text() -> (
+    None
+):
+    x = Expense(date(2026, 2, 1), "雑費", 500, "")
+    y = Expense(date(2026, 2, 1), "雑費", 500, "x")
+    assert find_duplicates([x, y]) == []
