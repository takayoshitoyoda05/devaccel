@@ -0,0 +1,55 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.stats import median_by_category
+
+
+def _e(category: str, amount: int) -> Expense:
+    return Expense(date(2026, 11, 1), category, amount)
+
+
+def test_empty_rows_return_empty_dict():
+    assert median_by_category([]) == {}
+
+
+def test_single_row_is_its_own_median_as_float():
+    result = median_by_category([_e("food", 100)])
+    assert result == {"food": 100.0}
+    assert isinstance(result["food"], float)
+
+
+def test_odd_count_takes_middle_value_regardless_of_input_order():
+    rows = [_e("food", 300), _e("food", 100), _e("food", 200)]
+    assert median_by_category(rows) == {"food": 200.0}
+
+
+def test_even_count_averages_the_two_middle_values():
+    rows = [_e("food", 100), _e("food", 300), _e("food", 200), _e("food", 400)]
+    assert median_by_category(rows) == {"food": 250.0}
+
+
+def test_identical_values_return_that_value():
+    rows = [_e("rent", 80000), _e("rent", 80000), _e("rent", 80000)]
+    assert median_by_category(rows) == {"rent": 80000.0}
+
+
+def test_each_category_is_computed_separately():
+    rows = [
+        _e("food", 100),
+        _e("rent", 80000),
+        _e("food", 300),
+        _e("rent", 90000),
+        _e("food", 200),
+    ]
+    assert median_by_category(rows) == {"food": 200.0, "rent": 85000.0}
+
+
+def test_keys_are_sorted_by_category_name_not_by_amount():
+    rows = [_e("rent", 80000), _e("books", 500), _e("food", 1200)]
+    result = median_by_category(rows)
+    assert list(result) == ["books", "food", "rent"]
+
+
+def test_categories_absent_from_rows_are_not_included():
+    rows = [_e("food", 100)]
+    assert set(median_by_category(rows)) == {"food"}
diff --git a/tests/test_streak.py b/tests/test_streak.py
new file mode 100644
index 0000000..12d8386
--- /dev/null
+++ b/tests/test_streak.py
@@ -0,0 +1,76 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.streak import longest_no_spend_streak
+
+
+def _e(day: date, amount: int = 100) -> Expense:
+    return Expense(day=day, category="食費", amount=amount)
+
+
+D = date
+
+
+def test_no_rows_returns_full_period_length() -> None:
+    assert longest_no_spend_streak([], D(2026, 1, 1), D(2026, 1, 10)) == 10
+
+
+def test_every_day_has_spending_returns_zero() -> None:
+    rows = [_e(D(2026, 1, d)) for d in range(1, 4)]
+    assert longest_no_spend_streak(rows, D(2026, 1, 1), D(2026, 1, 3)) == 0
+
+
+def test_single_day_period_without_spending_returns_one() -> None:
+    assert longest_no_spend_streak([], D(2026, 1, 5), D(2026, 1, 5)) == 1
+
+
+def test_single_day_period_with_spending_returns_zero() -> None:
+    rows = [_e(D(2026, 1, 5))]
+    assert longest_no_spend_streak(rows, D(2026, 1, 5), D(2026, 1, 5)) == 0
+
+
+def test_start_after_end_returns_zero() -> None:
+    assert longest_no_spend_streak([], D(2026, 1, 10), D(2026, 1, 1)) == 0
+
+
+def test_streak_in_middle_is_found() -> None:
+    # 1日・2日使用, 3〜5日なし, 6日使用
+    rows = [_e(D(2026, 1, 1)), _e(D(2026, 1, 2)), _e(D(2026, 1, 6))]
+    assert longest_no_spend_streak(rows, D(2026, 1, 1), D(2026, 1, 6)) == 3
+
+
+def test_streak_at_end_is_found() -> None:
+    rows = [_e(D(2026, 1, 1)), _e(D(2026, 1, 2))]
+    assert longest_no_spend_streak(rows, D(2026, 1, 1), D(2026, 1, 6)) == 4
+
+
+def test_streak_at_start_is_found() -> None:
+    rows = [_e(D(2026, 1, 4))]
+    assert longest_no_spend_streak(rows, D(2026, 1, 1), D(2026, 1, 4)) == 3
+
+
+def test_longest_of_several_streaks_is_returned() -> None:
+    # 空白: 1日(1), 3〜5日(3), 7日(1)
+    rows = [_e(D(2026, 1, 2)), _e(D(2026, 1, 6))]
+    assert longest_no_spend_streak(rows, D(2026, 1, 1), D(2026, 1, 7)) == 3
+
+
+def test_multiple_expenses_on_same_day_count_as_one_spending_day() -> None:
+    rows = [_e(D(2026, 1, 2), 100), _e(D(2026, 1, 2), 200)]
+    assert longest_no_spend_streak(rows, D(2026, 1, 1), D(2026, 1, 3)) == 1
+
+
+def test_rows_outside_period_are_ignored() -> None:
+    rows = [_e(D(2025, 12, 31)), _e(D(2026, 2, 1))]
+    assert longest_no_spend_streak(rows, D(2026, 1, 1), D(2026, 1, 3)) == 3
+
+
+def test_row_order_does_not_matter() -> None:
+    rows = [_e(D(2026, 1, 6)), _e(D(2026, 1, 2)), _e(D(2026, 1, 1))]
+    assert longest_no_spend_streak(rows, D(2026, 1, 1), D(2026, 1, 6)) == 3
+
+
+def test_zero_amount_expense_still_counts_as_spending_record() -> None:
+    # 明細が1件でもあれば「使った日」扱い(金額は問わない)
+    rows = [_e(D(2026, 1, 2), 0)]
+    assert longest_no_spend_streak(rows, D(2026, 1, 1), D(2026, 1, 3)) == 1
diff --git a/tests/test_topn.py b/tests/test_topn.py
new file mode 100644
index 0000000..5ce375a
--- /dev/null
+++ b/tests/test_topn.py
@@ -0,0 +1,60 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.topn import top_expenses
+
+
+def _e(day: str, amount: int, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category="食費", amount=amount, memo=memo
+    )
+
+
+def test_orders_by_amount_descending() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300), _e("2026-01-03", 200)]
+    assert [e.amount for e in top_expenses(rows, 3)] == [300, 200, 100]
+
+
+def test_returns_only_n_items() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300), _e("2026-01-03", 200)]
+    assert [e.amount for e in top_expenses(rows, 2)] == [300, 200]
+
+
+def test_n_larger_than_length_returns_all() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300)]
+    assert [e.amount for e in top_expenses(rows, 10)] == [300, 100]
+
+
+def test_equal_amount_sorted_by_earlier_date_first() -> None:
+    late = _e("2026-03-01", 500, "late")
+    early = _e("2026-01-01", 500, "early")
+    result = top_expenses([late, early], 2)
+    assert [e.memo for e in result] == ["early", "late"]
+
+
+def test_equal_amount_and_date_keeps_input_order() -> None:
+    first = _e("2026-01-01", 500, "first")
+    second = _e("2026-01-01", 500, "second")
+    result = top_expenses([first, second], 2)
+    assert [e.memo for e in result] == ["first", "second"]
+
+
+def test_n_zero_returns_empty() -> None:
+    rows = [_e("2026-01-01", 100)]
+    assert top_expenses(rows, 0) == []
+
+
+def test_negative_n_returns_empty() -> None:
+    rows = [_e("2026-01-01", 100)]
+    assert top_expenses(rows, -1) == []
+
+
+def test_empty_input_returns_empty() -> None:
+    assert top_expenses([], 3) == []
+
+
+def test_does_not_mutate_input() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300)]
+    snapshot = list(rows)
+    top_expenses(rows, 2)
+    assert rows == snapshot
diff --git a/tests/test_weekday.py b/tests/test_weekday.py
new file mode 100644
index 0000000..636e858
--- /dev/null
+++ b/tests/test_weekday.py
@@ -0,0 +1,68 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.weekday import total_by_weekday
+
+
+def _e(day: date, amount: int, category: str = "食費") -> Expense:
+    return Expense(day=day, category=category, amount=amount)
+
+
+def test_empty_rows_returns_empty_dict() -> None:
+    assert total_by_weekday([]) == {}
+
+
+def test_single_row_maps_to_its_weekday() -> None:
+    # 2026-11-16 は月曜
+    assert total_by_weekday([_e(date(2026, 11, 16), 500)]) == {"Mon": 500}
+
+
+def test_same_weekday_across_weeks_is_summed() -> None:
+    rows = [
+        _e(date(2026, 11, 16), 500),  # Mon
+        _e(date(2026, 11, 23), 300),  # Mon
+        _e(date(2026, 11, 17), 1000),  # Tue
+    ]
+    assert total_by_weekday(rows) == {"Mon": 800, "Tue": 1000}
+
+
+def test_weekdays_without_rows_are_omitted() -> None:
+    rows = [_e(date(2026, 11, 21), 100), _e(date(2026, 11, 15), 200)]  # Sat, Sun
+    result = total_by_weekday(rows)
+    assert result == {"Sat": 100, "Sun": 200}
+    assert set(result) == {"Sat", "Sun"}
+
+
+def test_keys_are_in_monday_first_order_regardless_of_input_order() -> None:
+    rows = [
+        _e(date(2026, 11, 15), 1),  # Sun
+        _e(date(2026, 11, 18), 2),  # Wed
+        _e(date(2026, 11, 16), 3),  # Mon
+        _e(date(2026, 11, 20), 4),  # Fri
+    ]
+    assert list(total_by_weekday(rows)) == ["Mon", "Wed", "Fri", "Sun"]
+
+
+def test_keys_ordered_by_weekday_not_by_amount() -> None:
+    rows = [_e(date(2026, 11, 16), 1), _e(date(2026, 11, 22), 999)]  # Mon, Sun
+    assert list(total_by_weekday(rows)) == ["Mon", "Sun"]
+
+
+def test_all_seven_weekdays_present_in_order() -> None:
+    rows = [_e(date(2026, 11, 16 + i), (i + 1) * 10) for i in range(7)]
+    result = total_by_weekday(rows)
+    assert list(result) == ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
+    assert list(result.values()) == [10, 20, 30, 40, 50, 60, 70]
+
+
+def test_zero_amount_row_still_counts_its_weekday() -> None:
+    # 明細があれば金額 0 でも曜日は含める
+    assert total_by_weekday([_e(date(2026, 11, 18), 0)]) == {"Wed": 0}
+
+
+def test_categories_are_ignored_and_summed_per_weekday() -> None:
+    rows = [
+        _e(date(2026, 11, 16), 100, "食費"),
+        _e(date(2026, 11, 16), 200, "交通費"),
+    ]
+    assert total_by_weekday(rows) == {"Mon": 300}
