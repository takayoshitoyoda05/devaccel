@@ -0,0 +1,25 @@
+"""No-spend streak calculation."""
+
+from __future__ import annotations
+
+from datetime import date, timedelta
+
+from kakeibo.core import Expense
+
+
+def longest_no_spend_streak(rows: list[Expense], start: date, end: date) -> int:
+    """start〜end(両端含む)で明細が 1 件もない日の最長連続日数。期間が空なら 0。"""
+    if start > end:
+        return 0
+    spent = {e.day for e in rows if start <= e.day <= end}
+    best = 0
+    current = 0
+    day = start
+    while day <= end:
+        if day in spent:
+            current = 0
+        else:
+            current += 1
+            best = max(best, current)
+        day += timedelta(days=1)
+    return best
