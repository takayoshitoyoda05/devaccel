diff --git a/tests/test_report_total.py b/tests/test_report_total.py
new file mode 100644
index 0000000..d0fc86c
--- /dev/null
+++ b/tests/test_report_total.py
@@ -0,0 +1,78 @@
+import sys
+
+from kakeibo import main
+
+HEADER = "date,category,amount,memo\n"
+BODY = (
+    "2026-10-05,food,300,lunch\n"
+    "2026-11-01,food,1200,lunch\n"
+    "2026-11-02,rent,80000,\n"
+    "2026-11-03,food,800,coffee\n"
+    "2026-10-20,rent,75000,\n"
+)
+
+
+def _run(tmp_path, monkeypatch, capsys, *args, body=BODY):
+    p = tmp_path / "in.csv"
+    p.write_text(HEADER + body, encoding="utf-8")
+    monkeypatch.setattr(sys, "argv", ["kakeibo", str(p), *args])
+    main()
+    return capsys.readouterr()
+
+
+def test_report_total_adds_monthly_subtotals_and_grand_total(
+    tmp_path, monkeypatch, capsys
+):
+    out = _run(tmp_path, monkeypatch, capsys, "--report", "--total")
+    assert out.out == (
+        "2026-10\trent\t75000\n"
+        "2026-10\tfood\t300\n"
+        "2026-10\tSUBTOTAL\t75300\n"
+        "2026-11\trent\t80000\n"
+        "2026-11\tfood\t2000\n"
+        "2026-11\tSUBTOTAL\t82000\n"
+        "TOTAL\t\t157300\n"
+    )
+    assert out.err == ""
+
+
+def test_report_without_total_unchanged(tmp_path, monkeypatch, capsys):
+    out = _run(tmp_path, monkeypatch, capsys, "--report")
+    assert "SUBTOTAL" not in out.out
+    assert "TOTAL" not in out.out
+    assert len(out.out.splitlines()) == 4
+
+
+def test_report_total_rows_have_three_columns(tmp_path, monkeypatch, capsys):
+    out = _run(tmp_path, monkeypatch, capsys, "--report", "--total")
+    assert all(len(line.split("\t")) == 3 for line in out.out.splitlines())
+
+
+def test_report_total_with_memo(tmp_path, monkeypatch, capsys):
+    out = _run(tmp_path, monkeypatch, capsys, "--report", "--total", "--memo", "lunch")
+    assert out.out == (
+        "2026-10\tfood\t300\n"
+        "2026-10\tSUBTOTAL\t300\n"
+        "2026-11\tfood\t1200\n"
+        "2026-11\tSUBTOTAL\t1200\n"
+        "TOTAL\t\t1500\n"
+    )
+
+
+def test_report_total_memo_no_match(tmp_path, monkeypatch, capsys):
+    out = _run(tmp_path, monkeypatch, capsys, "--report", "--total", "--memo", "zzz")
+    assert out.out == "TOTAL\t\t0\n"
+    assert "zzz" in out.err
+
+
+def test_report_total_empty_csv(tmp_path, monkeypatch, capsys):
+    out = _run(tmp_path, monkeypatch, capsys, "--report", "--total", body="")
+    assert out.out == "TOTAL\t\t0\n"
+
+
+def test_report_total_ignores_category(tmp_path, monkeypatch, capsys):
+    base = _run(tmp_path, monkeypatch, capsys, "--report", "--total")
+    out = _run(
+        tmp_path, monkeypatch, capsys, "--report", "--total", "--category", "food"
+    )
+    assert out.out == base.out
