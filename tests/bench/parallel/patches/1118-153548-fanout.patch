+++ b/tests/test_monthdiff.py
@@ -0,0 +1,348 @@
+from __future__ import annotations
+
+from dataclasses import FrozenInstanceError
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def e(day: str, category: str, amount: int) -> Expense:
+    return Expense(date.fromisoformat(day), category, amount)
+
+
+def row(
+    category: str,
+    prev: int,
+    curr: int,
+    delta: int,
+    pct: float | None,
+    status: str,
+) -> DiffRow:
+    return DiffRow(category, prev, curr, delta, pct, status)
+
+
+# --- DiffRow -----------------------------------------------------------------
+
+
+def test_diffrow_is_frozen_with_field_order() -> None:
+    r = row("food", 1, 2, 1, 100.0, "up")
+    assert [f for f in r.__dataclass_fields__] == [
+        "category",
+        "prev",
+        "curr",
+        "delta",
+        "pct",
+        "status",
+    ]
+    with pytest.raises(FrozenInstanceError):
+        r.prev = 5  # type: ignore[misc]
+
+
+# --- month_diff: validation ----------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        "2026-1",
+        "26-01",
+        "2026/01",
+        "2026-13",
+        "2026-00",
+        " 2026-01",
+        "2026-01 ",
+        "202601",
+        "",
+    ],
+)
+def test_month_diff_rejects_bad_month_format(bad: str) -> None:
+    with pytest.raises(ValueError):
+        month_diff([], bad, "2026-02")
+    with pytest.raises(ValueError):
+        month_diff([], "2026-01", bad)
+
+
+# --- month_diff: rows, pct, status ---------------------------------------------
+
+
+def test_month_diff_basic_up_down() -> None:
+    rows = [
+        e("2026-01-05", "food", 1000),
+        e("2026-02-05", "food", 1300),
+        e("2026-01-06", "fun", 500),
+        e("2026-02-06", "fun", 200),
+    ]
+    got = month_diff(rows, "2026-01", "2026-02")
+    assert got == [
+        row("food", 1000, 1300, 300, 30.0, "up"),
+        row("fun", 500, 200, -300, -60.0, "down"),
+    ]
+
+
+def test_month_diff_same_status_uses_row_presence_and_zero_delta() -> None:
+    rows = [e("2026-01-01", "food", 500), e("2026-02-01", "food", 500)]
+    assert month_diff(rows, "2026-01", "2026-02") == [
+        row("food", 500, 500, 0, 0.0, "same")
+    ]
+
+
+def test_month_diff_zero_total_with_rows_is_same_not_new_or_gone() -> None:
+    rows = [e("2026-01-01", "food", 0), e("2026-02-01", "food", 0)]
+    assert month_diff(rows, "2026-01", "2026-02") == [
+        row("food", 0, 0, 0, None, "same")
+    ]
+
+
+def test_month_diff_new_when_prev_has_no_rows() -> None:
+    rows = [e("2026-02-01", "rent", 80000)]
+    assert month_diff(rows, "2026-01", "2026-02") == [
+        row("rent", 0, 80000, 80000, None, "new")
+    ]
+
+
+def test_month_diff_new_with_zero_amount_rows_still_new() -> None:
+    rows = [e("2026-02-01", "rent", 0)]
+    assert month_diff(rows, "2026-01", "2026-02") == [row("rent", 0, 0, 0, None, "new")]
+
+
+def test_month_diff_gone_when_curr_has_no_rows() -> None:
+    rows = [e("2026-01-01", "rent", 80000)]
+    assert month_diff(rows, "2026-01", "2026-02") == [
+        row("rent", 80000, 0, -80000, -100.0, "gone")
+    ]
+
+
+def test_month_diff_gone_with_zero_amount_rows_still_gone() -> None:
+    rows = [e("2026-01-01", "rent", 0)]
+    assert month_diff(rows, "2026-01", "2026-02") == [
+        row("rent", 0, 0, 0, None, "gone")
+    ]
+
+
+def test_month_diff_ignores_other_months_and_unrelated_categories() -> None:
+    rows = [
+        e("2025-12-31", "food", 9999),
+        e("2026-01-10", "food", 100),
+        e("2026-03-01", "food", 7777),
+    ]
+    assert month_diff(rows, "2026-01", "2026-02") == [
+        row("food", 100, 0, -100, -100.0, "gone")
+    ]
+
+
+def test_month_diff_empty_rows_gives_empty_list() -> None:
+    assert month_diff([], "2026-01", "2026-02") == []
+
+
+def test_month_diff_sums_multiple_rows_per_category() -> None:
+    rows = [
+        e("2026-01-01", "food", 100),
+        e("2026-01-02", "food", 250),
+        e("2026-02-01", "food", 175),
+    ]
+    assert month_diff(rows, "2026-01", "2026-02") == [
+        row("food", 350, 175, -175, -50.0, "down")
+    ]
+
+
+def test_month_diff_pct_none_when_prev_zero_but_prev_rows_exist() -> None:
+    rows = [e("2026-01-01", "food", 0), e("2026-02-01", "food", 300)]
+    assert month_diff(rows, "2026-01", "2026-02") == [
+        row("food", 0, 300, 300, None, "up")
+    ]
+
+
+def test_month_diff_pct_rounded_to_one_decimal() -> None:
+    rows = [e("2026-01-01", "food", 3), e("2026-02-01", "food", 4)]
+    # 1 / 3 * 100 = 33.333... -> 33.3
+    assert month_diff(rows, "2026-01", "2026-02") == [row("food", 3, 4, 1, 33.3, "up")]
+
+
+def test_month_diff_category_is_case_sensitive_exact_match() -> None:
+    rows = [e("2026-01-01", "Food", 100), e("2026-02-01", "food", 100)]
+    got = month_diff(rows, "2026-01", "2026-02")
+    assert {r.category for r in got} == {"Food", "food"}
+    assert all(r.status in {"gone", "new"} for r in got)
+
+
+def test_month_diff_sort_by_abs_delta_desc_then_category_asc() -> None:
+    rows = [
+        e("2026-01-01", "b", 100),
+        e("2026-02-01", "b", 0),  # delta -100, abs 100
+        e("2026-01-01", "a", 0),
+        e("2026-02-01", "a", 100),  # delta +100, abs 100 -> tie, 'a' first
+        e("2026-01-01", "c", 1000),
+        e("2026-02-01", "c", 1000),  # delta 0
+        e("2026-02-01", "d", 500),  # new, delta 500 -> first
+    ]
+    cats = [r.category for r in month_diff(rows, "2026-01", "2026-02")]
+    assert cats == ["d", "a", "b", "c"]
+
+
+def test_month_diff_sort_negative_large_before_positive_small() -> None:
+    rows = [
+        e("2026-01-01", "x", 10000),
+        e("2026-02-01", "x", 0),  # delta -10000 (gone)
+        e("2026-01-01", "y", 100),
+        e("2026-02-01", "y", 101),  # delta +1
+    ]
+    cats = [r.category for r in month_diff(rows, "2026-01", "2026-02")]
+    assert cats == ["x", "y"]
+
+
+# --- top_movers ------------------------------------------------------------------
+
+
+def test_top_movers_excludes_same_and_keeps_order() -> None:
+    diffs = [
+        row("a", 100, 100, 0, 0.0, "same"),
+        row("b", 500, 0, -500, -100.0, "gone"),
+        row("c", 0, 200, 200, None, "new"),
+        row("d", 100, 100, 0, 0.0, "same"),
+        row("e", 10, 20, 10, 100.0, "up"),
+    ]
+    assert top_movers(diffs) == [
+        row("b", 500, 0, -500, -100.0, "gone"),
+        row("c", 0, 200, 200, None, "new"),
+        row("e", 10, 20, 10, 100.0, "up"),
+    ]
+
+
+def test_top_movers_default_n_is_three() -> None:
+    diffs = [row(f"c{i}", 0, 10, 10, None, "new") for i in range(5)]
+    assert top_movers(diffs) == diffs[:3]
+
+
+def test_top_movers_n_limits_count_after_excluding_same() -> None:
+    diffs = [
+        row("a", 1, 1, 0, 0.0, "same"),
+        row("b", 1, 2, 1, 100.0, "up"),
+        row("c", 1, 3, 2, 200.0, "up"),
+    ]
+    assert top_movers(diffs, 1) == [row("b", 1, 2, 1, 100.0, "up")]
+
+
+def test_top_movers_n_zero_gives_empty() -> None:
+    diffs = [row("b", 1, 2, 1, 100.0, "up")]
+    assert top_movers(diffs, 0) == []
+
+
+def test_top_movers_n_larger_than_available() -> None:
+    diffs = [row("b", 1, 2, 1, 100.0, "up")]
+    assert top_movers(diffs, 10) == diffs
+
+
+def test_top_movers_negative_n_raises() -> None:
+    with pytest.raises(ValueError):
+        top_movers([], -1)
+
+
+def test_top_movers_empty_input() -> None:
+    assert top_movers([]) == []
+
+
+def test_top_movers_all_same_gives_empty() -> None:
+    diffs = [row("a", 1, 1, 0, 0.0, "same")]
+    assert top_movers(diffs) == []
+
+
+# --- render_diff -------------------------------------------------------------------
+
+HEADER = "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_render_diff_formats_signs_and_pct() -> None:
+    diffs = [
+        row("food", 1000, 1300, 300, 30.0, "up"),
+        row("fun", 500, 0, -500, -100.0, "gone"),
+        row("new", 0, 10, 10, None, "new"),
+        row("same", 7, 7, 0, 0.0, "same"),
+    ]
+    expected = (
+        f"{HEADER}\n"
+        "food\t1000\t1300\t+300\t+30.0%\n"
+        "fun\t500\t0\t-500\t-100.0%\n"
+        "new\t0\t10\t+10\t-\n"
+        "same\t7\t7\t+0\t+0.0%"
+    )
+    assert render_diff(diffs) == expected
+
+
+def test_render_diff_no_trailing_newline() -> None:
+    out = render_diff([row("a", 1, 2, 1, 100.0, "up")])
+    assert not out.endswith("\n")
+    assert out.count("\n") == 1
+
+
+def test_render_diff_empty_is_header_only() -> None:
+    assert render_diff([]) == HEADER
+
+
+def test_render_diff_negative_zero_pct_shows_plus_zero() -> None:
+    # delta -1 on prev 10000 -> pct -0.01 rounds to -0.0; must render as +0.0%
+    out = render_diff([row("a", 10000, 9999, -1, -0.0, "down")])
+    assert out.splitlines()[1] == "a\t10000\t9999\t-1\t+0.0%"
+
+
+def test_render_diff_pct_small_negative_keeps_minus() -> None:
+    out = render_diff([row("a", 3, 2, -1, -33.3, "down")])
+    assert out.splitlines()[1] == "a\t3\t2\t-1\t-33.3%"
+
+
+# --- available_months ------------------------------------------------------------
+
+
+def test_available_months_sorted_unique() -> None:
+    rows = [
+        e("2026-03-01", "x", 1),
+        e("2025-12-31", "x", 1),
+        e("2026-03-30", "y", 1),
+        e("2026-01-15", "x", 1),
+    ]
+    assert available_months(rows) == ["2025-12", "2026-01", "2026-03"]
+
+
+def test_available_months_empty() -> None:
+    assert available_months([]) == []
+
+
+def test_available_months_zero_padded() -> None:
+    assert available_months([e("2026-09-01", "x", 1)]) == ["2026-09"]
+
+
+# --- latest_diff -----------------------------------------------------------------
+
+
+def test_latest_diff_uses_last_two_months() -> None:
+    rows = [
+        e("2026-01-01", "food", 100),
+        e("2026-02-01", "food", 200),
+        e("2026-03-01", "food", 150),
+    ]
+    assert latest_diff(rows) == month_diff(rows, "2026-02", "2026-03")
+    assert latest_diff(rows) == [row("food", 200, 150, -50, -25.0, "down")]
+
+
+def test_latest_diff_exactly_two_months() -> None:
+    rows = [e("2026-01-01", "food", 100), e("2026-02-01", "food", 100)]
+    assert latest_diff(rows) == [row("food", 100, 100, 0, 0.0, "same")]
+
+
+def test_latest_diff_one_month_raises() -> None:
+    with pytest.raises(ValueError):
+        latest_diff([e("2026-01-01", "food", 100), e("2026-01-02", "food", 1)])
+
+
+def test_latest_diff_empty_raises() -> None:
+    with pytest.raises(ValueError):
+        latest_diff([])
