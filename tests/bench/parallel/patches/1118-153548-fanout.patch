new file mode 100644
index 0000000..27d1896
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,207 @@
+"""Tests for the search query language."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def _e(category: str, memo: str = "", amount: int = 100) -> Expense:
+    return Expense(day=date(2026, 1, 1), category=category, amount=amount, memo=memo)
+
+
+# --- tokenize ---------------------------------------------------------------
+
+
+def test_tokenize_whitespace_only_gives_no_tokens() -> None:
+    assert tokenize("   ") == []
+
+
+def test_tokenize_parens() -> None:
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+
+
+def test_tokenize_whitespace_separates_words() -> None:
+    assert tokenize("  a   b ") == [("TERM", "a"), ("TERM", "b")]
+
+
+def test_tokenize_quoted_keeps_spaces_and_parens() -> None:
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+
+
+def test_tokenize_quoted_keyword_is_term() -> None:
+    assert tokenize('"AND" "NOT" "cat:x"') == [
+        ("TERM", "AND"),
+        ("TERM", "NOT"),
+        ("TERM", "cat:x"),
+    ]
+
+
+def test_tokenize_quoted_whitespace_only_is_nonempty_term() -> None:
+    assert tokenize('" "') == [("TERM", " ")]
+
+
+def test_tokenize_unclosed_quote_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_operators_only_when_exact_uppercase() -> None:
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+    assert tokenize("and or not Or") == [
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+        ("TERM", "Or"),
+    ]
+
+
+def test_tokenize_cat_prefix() -> None:
+    assert tokenize("cat:食費") == [("CAT", "食費")]
+
+
+def test_tokenize_cat_with_empty_value_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+    with pytest.raises(QueryError):
+        tokenize("cat:)")
+
+
+def test_tokenize_cat_prefix_is_case_sensitive() -> None:
+    assert tokenize("CAT:x") == [("TERM", "CAT:x")]
+
+
+def test_tokenize_bare_word_stops_at_quote() -> None:
+    assert tokenize('a"b c"') == [("TERM", "a"), ("TERM", "b c")]
+
+
+# --- parsing errors ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(a",
+        "a)",
+        "AND a",
+        "a AND",
+        "a OR",
+        "OR a",
+        "a AND OR b",
+        "NOT",
+        "(a OR)",
+        "a ( )",
+    ],
+)
+def test_grammar_errors(q: str) -> None:
+    with pytest.raises(QueryError):
+        matches(q, _e("食費"))
+
+
+# --- evaluation -------------------------------------------------------------
+
+
+def test_term_matches_memo_substring() -> None:
+    assert matches("ランチ", _e("食費", memo="駅前ランチ"))
+
+
+def test_term_matches_category_substring() -> None:
+    assert matches("食", _e("食費"))
+
+
+def test_term_does_not_match_amount() -> None:
+    assert not matches("100", _e("食費", amount=100))
+
+
+def test_cat_is_exact_match_on_category() -> None:
+    assert matches("cat:食費", _e("食費"))
+    assert not matches("cat:食", _e("食費"))
+    assert not matches("cat:食費", _e("外食", memo="食費"))
+
+
+def test_casefold_is_applied_to_terms_and_cat() -> None:
+    assert matches("ABC", _e("x", memo="abc"))
+    assert matches("STRASSE", _e("x", memo="straße"))
+    assert matches("cat:FOOD", _e("food"))
+
+
+def test_implicit_and_between_terms() -> None:
+    assert matches("a b", _e("x", memo="a b"))
+    assert not matches("a b", _e("x", memo="a"))
+
+
+def test_explicit_and() -> None:
+    assert matches("a AND b", _e("x", memo="ab"))
+    assert not matches("a AND c", _e("x", memo="ab"))
+
+
+def test_or() -> None:
+    assert matches("a OR z", _e("x", memo="a"))
+    assert not matches("y OR z", _e("x", memo="a"))
+
+
+def test_and_binds_tighter_than_or() -> None:
+    # a OR (b AND c)
+    assert matches("a OR b c", _e("x", memo="a"))
+    assert matches("a OR b c", _e("x", memo="b c"))
+    assert not matches("a OR b c", _e("x", memo="b"))
+
+
+def test_not_binds_tighter_than_and() -> None:
+    # (NOT a) AND b
+    assert matches("NOT a b", _e("x", memo="b"))
+    assert not matches("NOT a b", _e("x", memo="a b"))
+
+
+def test_double_not() -> None:
+    assert matches("NOT NOT a", _e("x", memo="a"))
+    assert not matches("NOT NOT a", _e("x", memo="b"))
+
+
+def test_parens_override_precedence() -> None:
+    # (a OR b) AND c
+    assert not matches("(a OR b) c", _e("x", memo="a"))
+    assert matches("(a OR b) c", _e("x", memo="a c"))
+
+
+def test_quoted_term_with_space_is_one_term() -> None:
+    assert matches('"a b"', _e("x", memo="a b"))
+    assert not matches('"a b"', _e("x", memo="a"))
+
+
+def test_cat_combined_with_not() -> None:
+    assert matches("cat:食費 NOT 外食", _e("食費", memo="ランチ"))
+    assert not matches("cat:食費 NOT ランチ", _e("食費", memo="ランチ"))
+
+
+# --- filter_rows ------------------------------------------------------------
+
+
+def test_filter_rows_keeps_input_order() -> None:
+    rows = [_e("食費", "a"), _e("交通", "b"), _e("食費", "c a")]
+    assert filter_rows("a", rows) == [rows[0], rows[2]]
+
+
+def test_filter_rows_empty_input_returns_empty() -> None:
+    assert filter_rows("a", []) == []
+
+
+def test_filter_rows_invalid_query_raises_even_with_no_rows() -> None:
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
+
+
+def test_filter_rows_no_match_returns_empty() -> None:
+    assert filter_rows("zzz", [_e("食費", "a")]) == []
