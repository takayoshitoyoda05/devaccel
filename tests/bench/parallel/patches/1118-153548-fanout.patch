+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def e(day: date, category: str = "通信", amount: int = 3000, memo: str = "") -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- add_month ---------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("src", "expected"),
+    [
+        (date(2026, 1, 15), date(2026, 2, 15)),
+        (date(2026, 1, 31), date(2026, 2, 28)),  # 平年の2月に丸め
+        (date(2024, 1, 31), date(2024, 2, 29)),  # うるう年の2月に丸め
+        (date(2026, 3, 31), date(2026, 4, 30)),  # 30日までの月に丸め
+        (date(2026, 12, 15), date(2027, 1, 15)),  # 年またぎ
+        (date(2026, 12, 31), date(2027, 1, 31)),
+    ],
+)
+def test_add_month(src: date, expected: date) -> None:
+    assert add_month(src) == expected
+
+
+# --- find_recurring: 引数検証 -------------------------------------------------
+
+
+@pytest.mark.parametrize("min_count", [1, 0, -1])
+def test_min_count_below_two_raises(min_count: int) -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=min_count)
+
+
+def test_negative_tolerance_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_min_count_two_and_zero_tolerance_are_accepted() -> None:
+    assert find_recurring([], min_count=2, tolerance=0) == []
+
+
+# --- find_recurring: 基本動作 -------------------------------------------------
+
+
+def test_empty_input_returns_empty() -> None:
+    assert find_recurring([]) == []
+
+
+def test_three_monthly_charges_detected() -> None:
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 5)), e(date(2026, 3, 5))]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="通信",
+            amount=3000,
+            days=(date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+            next_expected=date(2026, 4, 5),
+        )
+    ]
+
+
+def test_fewer_than_min_count_not_reported() -> None:
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 5))]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_count=2)) == 1
+
+
+def test_memo_is_ignored_for_grouping() -> None:
+    rows = [
+        e(date(2026, 1, 5), memo="a"),
+        e(date(2026, 2, 5), memo="b"),
+        e(date(2026, 3, 5), memo=""),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert len(result[0].days) == 3
+
+
+def test_different_amount_or_category_are_separate_groups() -> None:
+    rows = [
+        e(date(2026, 1, 5), amount=3000),
+        e(date(2026, 2, 5), amount=3000),
+        e(date(2026, 3, 5), amount=3001),  # 金額違い: 別グループ
+        e(date(2026, 1, 9), category="家賃"),
+        e(date(2026, 2, 9), category="家賃"),
+        e(date(2026, 3, 9), category="家賃"),
+    ]
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [("家賃", 3000)]
+
+
+def test_duplicate_days_are_collapsed() -> None:
+    rows = [
+        e(date(2026, 1, 5)),
+        e(date(2026, 1, 5)),  # 同日の重複
+        e(date(2026, 2, 5)),
+        e(date(2026, 3, 5)),
+    ]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_unsorted_input_is_sorted_ascending() -> None:
+    rows = [e(date(2026, 3, 5)), e(date(2026, 1, 5)), e(date(2026, 2, 5))]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_next_expected_uses_add_month_of_last_day() -> None:
+    rows = [e(date(2025, 11, 30)), e(date(2025, 12, 30)), e(date(2026, 1, 30))]
+    result = find_recurring(rows)
+    # 2026-01-30 の翌月は 2026-02-28 (丸め)。その後の判定は tolerance 内なので連続。
+    assert result[0].next_expected == date(2026, 2, 28)
+
+
+# --- find_recurring: 連続性・tolerance ----------------------------------------
+
+
+def test_tolerance_boundary_connects_exactly_at_limit() -> None:
+    # add_month(2026-01-05)=2026-02-05。2026-02-08 は差 3 日 → tolerance=3 で連続。
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 8)), e(date(2026, 3, 8))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+
+
+def test_gap_beyond_tolerance_splits_runs() -> None:
+    # 2026-02-09 は差 4 日 → tolerance=3 では切れる。
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 9)), e(date(2026, 3, 9))]
+    assert find_recurring(rows, tolerance=3) == []
+
+
+def test_early_charge_within_tolerance_connects() -> None:
+    # 2026-02-02 は差 -3 日。絶対値で判定するので連続。
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 2)), e(date(2026, 3, 2))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+
+
+def test_zero_tolerance_requires_exact_month_day() -> None:
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 6)), e(date(2026, 3, 5))]
+    assert find_recurring(rows, tolerance=0) == []
+
+
+def test_runs_split_and_only_long_runs_reported() -> None:
+    # 1〜3月の連続 (3件) と、8〜10月の連続 (3件) は別々に報告される。
+    # 途中の 6月 1件だけの区間は min_count 未満で捨てられる。
+    rows = [
+        e(date(2026, 1, 5)),
+        e(date(2026, 2, 5)),
+        e(date(2026, 3, 5)),
+        e(date(2026, 6, 5)),
+        e(date(2026, 8, 5)),
+        e(date(2026, 9, 5)),
+        e(date(2026, 10, 5)),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 5), date(2026, 8, 5)]
+    assert result[0].next_expected == date(2026, 4, 5)
+    assert result[1].next_expected == date(2026, 11, 5)
+
+
+def test_run_break_in_middle_keeps_longer_segments_separately() -> None:
+    rows = [
+        e(date(2026, 1, 5)),
+        e(date(2026, 2, 5)),
+        e(date(2026, 3, 5)),
+        e(date(2026, 7, 5)),  # 切れ目
+        e(date(2026, 8, 5)),
+    ]
+    result = find_recurring(rows, min_count=2)
+    assert [r.days for r in result] == [
+        (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+        (date(2026, 7, 5), date(2026, 8, 5)),
+    ]
+
+
+# --- find_recurring: 並び順 ---------------------------------------------------
+
+
+def test_result_order_category_then_amount_then_first_day() -> None:
+    rows: list[Expense] = []
+    # B/500 と B/100 は同じ category。amount 昇順で並ぶ (100 が先)。
+    for amount in (500, 100):
+        for m in (1, 2, 3):
+            rows.append(e(date(2026, m, 1), category="B", amount=amount))
+    # A/900 は category 昇順で最初。
+    for m in (5, 6, 7):
+        rows.append(e(date(2026, m, 1), category="A", amount=900))
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [
+        ("A", 900),
+        ("B", 100),
+        ("B", 500),
+    ]
