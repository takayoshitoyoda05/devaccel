+def test_results_sorted_by_category_then_amount_then_first_day() -> None:
+    rows = [
+        # category "b", amount 100, first day 2026-02-10
+        e("2026-02-10", category="b", amount=100),
+        e("2026-03-10", category="b", amount=100),
+        e("2026-04-10", category="b", amount=100),
