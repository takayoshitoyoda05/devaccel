diff --git a/tests/test_types/test_FloatRange.py b/tests/test_types/test_FloatRange.py
index 53fd429..e0e0032 100644
--- a/tests/test_types/test_FloatRange.py
+++ b/tests/test_types/test_FloatRange.py
@@ -40,3 +40,29 @@ def test_float_range_no_clamp_open():
 
     with pytest.raises(RuntimeError):
         sneaky.convert("1.5", None, None)
+
+
+@pytest.mark.parametrize(
+    ("type", "expect"),
+    [
+        (click.IntRange(1), "x>=1"),
+        (click.IntRange(1, min_open=True), "x>1"),
+        (click.IntRange(max=5), "x<=5"),
+        (click.IntRange(max=5, max_open=True), "x<5"),
+        (click.IntRange(1, 5), "1<=x<=5"),
+        (click.IntRange(1, 5, min_open=True, max_open=True), "1<x<5"),
+        (click.FloatRange(0.5), "x>=0.5"),
+        (click.FloatRange(0.5, min_open=True), "x>0.5"),
+        (click.FloatRange(max=1.5), "x<=1.5"),
+        (click.FloatRange(max=1.5, max_open=True), "x<1.5"),
+        (click.FloatRange(0.5, 1.5), "0.5<=x<=1.5"),
+        (click.FloatRange(0.5, 1.5, min_open=True, max_open=True), "0.5<x<1.5"),
+    ],
+)
+def test_describe_range_open_closed(type, expect):
+    """A closed bound must render as ``>=``/``<=``, an open one as ``>``/``<``."""
+    assert type._describe_range() == expect
+
+    option = click.Option(["--n"], type=type, show_default=True, default=type.min or 0)
+    ctx = click.Context(click.Command("t"))
+    assert option.get_help_extra(ctx)["range"] == expect
