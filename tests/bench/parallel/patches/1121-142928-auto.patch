+from datetime import date, datetime
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    all_of,
+    amount_between,
+    any_of,
+    category_is,
+    date_between,
+    memo_contains,
+    not_,
+    search,
+)
+
+ROWS = [
+    Expense(date(2026, 1, 5), "食費", 1000, "スーパー"),
+    Expense(date(2026, 1, 9), "交通", 500, "Suica"),
+    Expense(date(2026, 2, 1), "食費", -300, "返品 Coffee"),
+    Expense(date(2026, 2, 20), "娯楽", 4000, "映画"),
+]
+
+
+# --- 表の行 (ID をテストに書く) ---
+
+
+@pytest.mark.parametrize(
+    ("query", "expected"),
+    [
+        pytest.param(amount_between(1000, 1000), [ROWS[0]], id="E3-1"),
+        pytest.param(any_of(), [], id="E3-2"),
+    ],
+)
+def test_table_rows(query, expected):
+    assert search(ROWS, query) == expected
+
+
+@pytest.mark.parametrize("make", [pytest.param(lambda: memo_contains(""), id="E3-3")])
+def test_table_error_rows(make):
+    with pytest.raises(ValueError):
+        make()
+
+
+# --- R1 category_is ---
+
+
+def test_R1_exact_match_case_and_space_insensitive_or():
+    assert search(ROWS, category_is(" 食費 ")) == [ROWS[0], ROWS[2]]
+    assert search(ROWS, category_is("交通", "娯楽")) == [ROWS[1], ROWS[3]]
+
+
+def test_R1_no_partial_match_and_no_names_raises():
+    assert search(ROWS, category_is("食")) == []
+    with pytest.raises(ValueError):
+        category_is()
+
+
+# --- R2 amount_between / D1 / D2 ---
+
+
+def test_R2_inclusive_and_one_sided():
+    assert search(ROWS, amount_between(500, None)) == [ROWS[0], ROWS[1], ROWS[3]]
+    assert search(ROWS, amount_between(None, 500)) == [ROWS[1], ROWS[2]]
+
+
+def test_D1_refund_negative_amount_compared_in_range():
+    assert search(ROWS, amount_between(-300, -300)) == [ROWS[2]]
+
+
+@pytest.mark.parametrize("bad", [True, 1.0])
+def test_D2_bool_and_float_rejected(bad):
+    with pytest.raises(TypeError):
+        amount_between(bad, None)
+
+
+def test_R2_both_none_and_low_above_high_raise():
+    with pytest.raises(ValueError):
+        amount_between()
+    with pytest.raises(ValueError):
+        amount_between(10, 5)
+
+
+# --- R3 memo_contains ---
+
+
+def test_R3_partial_nfkc_case_insensitive():
+    # 全角 "ｃｏｆｆｅｅ" は NFKC で "coffee" になる
+    assert search(ROWS, memo_contains("COFFEE")) == [ROWS[2]]
+    assert search(ROWS, memo_contains("ｃｏｆｆ")) == [ROWS[2]]
+
+
+# --- R4 date_between / D3 ---
+
+
+def test_R4_inclusive_range_and_one_sided():
+    assert search(ROWS, date_between(date(2026, 1, 9), date(2026, 2, 1))) == [
+        ROWS[1],
+        ROWS[2],
+    ]
+    assert search(ROWS, date_between(date(2026, 2, 20))) == [ROWS[3]]
+
+
+def test_R4_both_none_and_start_after_end_raise():
+    with pytest.raises(ValueError):
+        date_between()
+    with pytest.raises(ValueError):
+        date_between(date(2026, 2, 1), date(2026, 1, 1))
+
+
+def test_D3_datetime_and_str_rejected():
+    with pytest.raises(TypeError):
+        date_between(datetime(2026, 1, 1))
+    with pytest.raises(TypeError):
+        date_between("2026-01-01")  # type: ignore[arg-type]
+
+
+# --- R5 all_of / any_of / not_ ---
+
+
+def test_R5_empty_all_true_any_false():
+    assert search(ROWS, all_of()) == ROWS
+    assert search(ROWS, any_of()) == []
+
+
+def test_R5_nested_composition_uses_structure():
+    q = all_of(category_is("食費"), not_(amount_between(None, 0)))
+    assert search(ROWS, q) == [ROWS[0]]
+
+
+# --- R6 / D4 / D6 ---
+
+
+def test_R6_keeps_input_order_and_returns_new_list():
+    result = search(ROWS, any_of(category_is("食費"), category_is("娯楽")))
+    assert result == [ROWS[0], ROWS[2], ROWS[3]]
+    assert result is not ROWS
+
+
+def test_D6_empty_rows_returns_empty():
+    assert search([], amount_between(0, None)) == []
+
+
+# --- R7 ---
+
+
+def test_R7_non_query_in_composition_raises_type_error():
+    with pytest.raises(TypeError):
+        all_of(category_is("食費"), "食費")  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        not_(lambda e: True)  # type: ignore[arg-type]
