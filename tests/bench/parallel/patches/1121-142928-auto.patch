@@ -0,0 +1,256 @@
+"""Bank / card CSV import (pure functions, standard library only).
+
+D1: 金額は円の整数。正 = 支出、負 = 返金。取込は返金を負の Expense.amount として受ける。
+D2: 引数は str のみ受ける。bytes・None など str 以外は TypeError。金額は int 以外を作らない。
+D3: 日付は datetime.date で返す。文字列の日付は取込の中だけで解釈する。
+D4: 結果は入力の行順を保つ(R7)。並べ替えはしない。同点規則は適用しない。
+D5: 同一判定はしない。同じ内容の行も別々に返す(メモ正規化は使わない)。
+D6: ヘッダーも無い完全に空の入力は CsvError。ヘッダーだけなら []。
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from collections.abc import Callable, Iterator
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import CsvError, Expense
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str
+    value: str
+    reason: str
+
+
+_UNCATEGORIZED = "未分類"
+_COLUMN_COUNT = "(列数)"
+
+_DATE_KEYS = frozenset({"日付", "利用日", "取引日", "ご利用日", "年月日", "date"})
+_AMOUNT_KEYS = frozenset({"金額", "利用金額", "ご利用金額", "amount"})
+_MEMO_KEYS = frozenset(
+    {"摘要", "メモ", "利用店名", "ご利用店名", "内容", "description", "memo"}
+)
+_CATEGORY_KEYS = frozenset({"カテゴリ", "分類", "費目", "category"})
+_OUT_KEYS = frozenset({"出金", "出金額", "お支払金額", "支払", "withdrawal"})
+_IN_KEYS = frozenset({"入金", "入金額", "預入", "deposit"})
+
+# 金額の記号・単位・区切り（NFKC 後に除去する）
+_NOISE_RE = re.compile(r"¥|円|JPY|,|\s", re.IGNORECASE)
+_LEADING_NEG = ("-", "−", "▲", "△")
+
+_DATE_SEP_RE = re.compile(r"([0-9]{4})([-/.])([0-9]{1,2})\2([0-9]{1,2})")
+_DATE_JP_RE = re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日")
+_DATE_COMPACT_RE = re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})")
+_DIGITS_RE = re.compile(r"[0-9]+")
+_NEWLINE_RE = re.compile(r"\r\n|\r|\n")
+
+
+def _norm(s: str) -> str:
+    """NFKC 正規化と前後空白除去。"""
+    return unicodedata.normalize("NFKC", s).strip()
+
+
+def _key(s: str) -> str:
+    """ヘッダー照合用の鍵(NFKC・前後空白除去・大文字小文字無視)。"""
+    return _norm(s).casefold()
+
+
+def _parse_amount(raw: str) -> int:
+    s = _NOISE_RE.sub("", _norm(raw))
+    if s == "":
+        raise ValueError("金額が空です")
+    neg = False
+    if s.startswith("(") and s.endswith(")"):
+        neg, s = True, s[1:-1]
+    elif s.endswith("-"):
+        neg, s = True, s[:-1]
+    elif s[:1] in _LEADING_NEG:
+        neg, s = True, s[1:]
+    elif s[:1] == "+":
+        s = s[1:]
+    if "." in s:
+        raise ValueError("小数は扱えません")
+    if _DIGITS_RE.fullmatch(s) is None:
+        raise ValueError("金額として解釈できません")
+    value = int(s)
+    return -value if neg else value
+
+
+def _parse_date(raw: str) -> date:
+    s = re.split(r"[ T]", _norm(raw), maxsplit=1)[0]
+    m = _DATE_SEP_RE.fullmatch(s)
+    if m is not None:
+        y, mo, d = int(m[1]), int(m[3]), int(m[4])
+    else:
+        m = _DATE_JP_RE.fullmatch(s) or _DATE_COMPACT_RE.fullmatch(s)
+        if m is None:
+            raise ValueError("日付の形式が不正です")
+        y, mo, d = int(m[1]), int(m[2]), int(m[3])
+    try:
+        return date(y, mo, d)
+    except ValueError:
+        raise ValueError("存在しない日付です") from None
+
+
+def _try[T](
+    errors: list[RowError],
+    line: int,
+    column: str,
+    raw: str,
+    fn: Callable[[str], T],
+) -> T | None:
+    try:
+        return fn(raw)
+    except ValueError as e:
+        errors.append(RowError(line, column, raw, str(e)))
+        return None
+
+
+@dataclass(frozen=True)
+class _Columns:
+    width: int
+    date: int
+    amount: int | None
+    out: int | None
+    inflow: int | None
+    category: int | None
+    memo: int | None
+
+
+def _find(keys: list[str], aliases: frozenset[str]) -> int | None:
+    for i, k in enumerate(keys):
+        if k in aliases:
+            return i
+    return None
+
+
+def _map_header(row: list[str]) -> _Columns:
+    keys = [_key(c) for c in row]
+    date_col = _find(keys, _DATE_KEYS)
+    if date_col is None:
+        raise CsvError([(1, "必須の日付列がありません")])
+    amount = _find(keys, _AMOUNT_KEYS)
+    out = _find(keys, _OUT_KEYS)
+    inflow = _find(keys, _IN_KEYS)
+    if amount is None and out is None and inflow is None:
+        raise CsvError([(1, "金額列(金額、または出金・入金)がありません")])
+    return _Columns(
+        width=len(row),
+        date=date_col,
+        amount=amount,
+        out=out,
+        inflow=inflow,
+        category=_find(keys, _CATEGORY_KEYS),
+        memo=_find(keys, _MEMO_KEYS),
+    )
+
+
+def _is_blank(row: list[str]) -> bool:
+    return all(_norm(c) == "" for c in row)
+
+
+def _detect_delimiter(text: str) -> str:
+    first = _NEWLINE_RE.split(text, maxsplit=1)[0]
+    return "\t" if first.count("\t") > first.count(",") else ","
+
+
+def _records(text: str, delimiter: str) -> Iterator[tuple[int, list[str]]]:
+    """(レコード開始の物理行, 行の値) を順に返す。行番号は 1 始まり。"""
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delimiter)
+    while True:
+        start = reader.line_num + 1
+        row = next(reader, None)
+        if row is None:
+            return
+        yield start, row
+
+
+def _convert_row(
+    line: int, row: list[str], cols: _Columns
+) -> tuple[Expense | None, list[RowError]]:
+    if len(row) != cols.width:
+        return None, [
+            RowError(
+                line,
+                _COLUMN_COUNT,
+                str(len(row)),
+                f"ヘッダーは {cols.width} 列、この行は {len(row)} 列",
+            )
+        ]
+
+    def cell(i: int | None) -> str:
+        return "" if i is None else row[i]
+
+    errors: list[RowError] = []
+    amount: int | None
+    if cols.amount is not None:
+        day = _try(errors, line, "日付", cell(cols.date), _parse_date)
+        amount = _try(errors, line, "金額", cell(cols.amount), _parse_amount)
+    else:
+        out_raw, in_raw = cell(cols.out), cell(cols.inflow)
+        if _norm(out_raw) == "" and _norm(in_raw) == "":
+            return None, []  # 両方空の行は空行扱い
+        day = _try(errors, line, "日付", cell(cols.date), _parse_date)
+        if _norm(out_raw) != "" and _norm(in_raw) != "":
+            errors.append(
+                RowError(
+                    line,
+                    "出金・入金",
+                    f"{out_raw}/{in_raw}",
+                    "出金と入金が両方入っています",
+                )
+            )
+            amount = None
+        elif _norm(in_raw) != "":
+            value = _try(errors, line, "入金", in_raw, _parse_amount)
+            amount = None if value is None else -value
+        else:
+            amount = _try(errors, line, "出金", out_raw, _parse_amount)
+
+    if errors or day is None or amount is None:
+        return None, errors
+    category = _norm(cell(cols.category)) or _UNCATEGORIZED
+    memo = _norm(cell(cols.memo))
+    return Expense(day=day, category=category, amount=amount, memo=memo), []
+
+
+def parse_bank_csv_lenient(text: str) -> tuple[list[Expense], list[RowError]]:
+    """誤りのある行を除いて (取込できた行, 行ごとの誤り) を返す。"""
+    if not isinstance(text, str):
+        raise TypeError("text は str である必要があります")
+    text = text.removeprefix("﻿")
+    records = _records(text, _detect_delimiter(text))
+    header: list[str] | None = None
+    for _, row in records:
+        if not _is_blank(row):
+            header = row
+            break
+    if header is None:
+        raise CsvError([(1, "ヘッダーがありません")])
+    cols = _map_header(header)
+
+    rows: list[Expense] = []
+    errors: list[RowError] = []
+    for line, row in records:
+        if _is_blank(row):
+            continue
+        expense, row_errors = _convert_row(line, row, cols)
+        errors.extend(row_errors)
+        if expense is not None:
+            rows.append(expense)
+    return rows, errors
+
+
+def parse_bank_csv(text: str) -> list[Expense]:
+    """誤りが 1 つでもあれば CsvError、無ければ行順の Expense を返す。"""
+    rows, errors = parse_bank_csv_lenient(text)
+    if errors:
+        raise CsvError([(e.line, f"{e.column} {e.value}: {e.reason}") for e in errors])
+    return rows
diff --git a/src/kakeibo/monthly_diff.py b/src/kakeibo/monthly_diff.py
