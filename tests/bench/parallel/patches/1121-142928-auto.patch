@@ -0,0 +1,333 @@
+from __future__ import annotations
+
+import random
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, next_due
+
+
+def ex(d: date, category: str = "家賃", amount: int = 80000, memo: str = "") -> Expense:
+    return Expense(day=d, category=category, amount=amount, memo=memo)
+
+
+# --- 例の表 ---------------------------------------------------------------
+
+
+def test_E1_1_next_due_clamps_to_month_end() -> None:
+    """E1-1: next_due(2026-01-31, 31) == 2026-02-28 (R5)"""
+    assert next_due(date(2026, 1, 31), 31) == date(2026, 2, 28)
+
+
+def test_E1_2_monthly_rent_detected_with_next_date() -> None:
+    """E1-2: 家賃 80000 を 1・2・3 月の 25 日に → 1 件、next_date=2026-04-25 (R2,R4)"""
+    rows = [ex(date(2026, 1, 25)), ex(date(2026, 2, 25)), ex(date(2026, 3, 25))]
+    result = find_recurring(rows)
+    assert result == [
+        Recurring(
+            category="家賃",
+            memo="",
+            amount=80000,
+            occurrences=3,
+            last_date=date(2026, 3, 25),
+            next_date=date(2026, 4, 25),
+        )
+    ]
+
+
+def test_E1_3_min_occurrences_below_two_raises() -> None:
+    """E1-3: min_occurrences=1 → ValueError (R3)"""
+    with pytest.raises(ValueError, match="min_occurrences"):
+        find_recurring([], min_occurrences=1)
+
+
+# --- next_due (R5) ---------------------------------------------------------
+
+
+def test_next_due_december_rolls_to_january() -> None:
+    assert next_due(date(2026, 12, 15), 15) == date(2027, 1, 15)
+
+
+def test_next_due_leap_year_february() -> None:
+    assert next_due(date(2027, 12, 31), 31) == date(2028, 1, 31)
+    assert next_due(date(2028, 1, 31), 31) == date(2028, 2, 29)
+
+
+def test_next_due_uses_day_of_month_not_last_day() -> None:
+    assert next_due(date(2026, 3, 10), 25) == date(2026, 4, 25)
+
+
+@pytest.mark.parametrize("bad", [0, 32, -1])
+def test_next_due_day_out_of_range_raises(bad: int) -> None:
+    with pytest.raises(ValueError, match="day_of_month"):
+        next_due(date(2026, 1, 1), bad)
+
+
+def test_next_due_bool_day_raises_type_error() -> None:
+    with pytest.raises(TypeError):
+        next_due(date(2026, 1, 1), True)  # type: ignore[arg-type]
+
+
+def test_next_due_rejects_string_date() -> None:
+    with pytest.raises(TypeError):
+        next_due("2026-01-01", 1)  # type: ignore[arg-type]
+
+
+# --- D1 返金 ---------------------------------------------------------------
+
+
+def test_refunds_are_ignored_and_do_not_join_series() -> None:
+    rows = [
+        ex(date(2026, 1, 25)),
+        ex(date(2026, 2, 25)),
+        ex(date(2026, 3, 25), amount=-80000),  # 返金は系列に入らない
+        ex(date(2026, 4, 25)),
+    ]
+    # 1,2,4 月の 3 件。3 月の欠けは 1 つだけなので毎月扱い。
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].occurrences == 3
+    assert result[0].next_date == date(2026, 5, 25)
+
+
+def test_series_of_only_refunds_is_not_returned() -> None:
+    rows = [
+        ex(d, amount=-100)
+        for d in (date(2026, 1, 1), date(2026, 2, 1), date(2026, 3, 1))
+    ]
+    assert find_recurring(rows) == []
+
+
+# --- D2 引数の型 ---------------------------------------------------------------
+
+
+def test_bool_amount_raises_type_error() -> None:
+    row = Expense(day=date(2026, 1, 1), category="x", amount=True)  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        find_recurring([row])
+
+
+def test_float_amount_raises_type_error() -> None:
+    row = Expense(day=date(2026, 1, 1), category="x", amount=100.0)  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        find_recurring([row])
+
+
+def test_none_amount_raises_type_error() -> None:
+    row = Expense(day=date(2026, 1, 1), category="x", amount=None)  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        find_recurring([row])
+
+
+def test_bool_min_occurrences_raises_type_error() -> None:
+    with pytest.raises(TypeError):
+        find_recurring([], min_occurrences=True)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("tol", [-0.01, 1.01])
+def test_tolerance_out_of_range_raises(tol: float) -> None:
+    with pytest.raises(ValueError, match="amount_tolerance"):
+        find_recurring([], amount_tolerance=tol)
+
+
+def test_datetime_day_raises_type_error() -> None:
+    from datetime import datetime
+
+    row = Expense(day=datetime(2026, 1, 1), category="x", amount=1)  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        find_recurring([row])
+
+
+def test_string_day_raises_type_error() -> None:
+    row = Expense(day="2026-01-01", category="x", amount=1)  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        find_recurring([row])
+
+
+# --- D4 並び ---------------------------------------------------------------
+
+
+def test_result_is_independent_of_input_order() -> None:
+    rows = [
+        ex(date(2026, m, 5), category=c, amount=a)
+        for m in (1, 2, 3)
+        for c, a in (("通信", 3000), ("家賃", 80000), ("保険", 1200))
+    ]
+    expected = find_recurring(rows)
+    rng = random.Random(0)
+    for _ in range(5):
+        shuffled = rows[:]
+        rng.shuffle(shuffled)
+        assert find_recurring(shuffled) == expected
+
+
+def test_ties_on_next_date_sorted_by_category_then_memo() -> None:
+    rows = []
+    for m in (1, 2, 3):
+        d = date(2026, m, 5)
+        rows += [
+            ex(d, category="通信", amount=3000),
+            ex(d, category="家賃", amount=80000),
+        ]
+    result = find_recurring(rows)
+    assert [r.category for r in result] == ["家賃", "通信"]
+
+
+def test_results_sorted_by_next_date_ascending() -> None:
+    rows = [ex(date(2026, m, 20), category="A", amount=1) for m in (1, 2, 3)]
+    rows += [ex(date(2026, m, 5), category="B", amount=1) for m in (1, 2, 3)]
+    result = find_recurring(rows)
+    assert [r.category for r in result] == ["B", "A"]
+    assert result[0].next_date < result[1].next_date
+
+
+# --- D5 メモの正規化 ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "memo",
+    [
+        "Netflix",
+        "netflix",
+        "  NETFLIX  ",
+        "Netflix #3",
+        "Netflix (2)",
+        "ＮＥＴＦＬＩＸ",
+        "netflix  #12",
+    ],
+)
+def test_memo_normalization_groups_variants(memo: str) -> None:
+    rows = [
+        ex(date(2026, 1, 3), category="動画", amount=1490, memo="Netflix"),
+        ex(date(2026, 2, 3), category="動画", amount=1490, memo="netflix"),
+        ex(date(2026, 3, 3), category="動画", amount=1490, memo=memo),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_different_memo_is_different_series() -> None:
+    rows = [
+        ex(date(2026, 1, 3), category="動画", amount=1490, memo="Netflix"),
+        ex(date(2026, 2, 3), category="動画", amount=1490, memo="Hulu"),
+        ex(date(2026, 3, 3), category="動画", amount=1490, memo="Netflix"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_digits_only_memo_normalizes_to_empty() -> None:
+    rows = [
+        ex(date(2026, 1, 3), amount=1, memo="12"),
+        ex(date(2026, 2, 3), amount=1, memo=""),
+        ex(date(2026, 3, 3), amount=1, memo="7"),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+# --- D6 空入力 ---------------------------------------------------------------
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+# --- R1 金額の許容・日の分離 ---------------------------------------------------
+
+
+def test_amount_tolerance_keeps_near_amounts_in_one_series() -> None:
+    rows = [
+        ex(date(2026, 1, 10), category="電気", amount=1000),
+        ex(date(2026, 2, 10), category="電気", amount=1040),
+        ex(date(2026, 3, 10), category="電気", amount=1000),
+    ]
+    result = find_recurring(rows, amount_tolerance=0.05)
+    assert len(result) == 1
+    assert result[0].amount == 1000  # 直近の金額
+
+
+def test_default_tolerance_splits_different_amounts() -> None:
+    rows = [
+        ex(date(2026, 1, 10), category="電気", amount=1000),
+        ex(date(2026, 2, 10), category="電気", amount=1040),
+        ex(date(2026, 3, 10), category="電気", amount=1000),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_same_amount_on_days_more_than_ten_apart_are_separate_series() -> None:
+    rows = []
+    for m in (1, 2, 3):
+        rows += [
+            ex(date(2026, m, 5), category="保険", amount=500),
+            ex(date(2026, m, 20), category="保険", amount=500),
+        ]
+    result = find_recurring(rows)
+    assert len(result) == 2
+    assert {r.next_date for r in result} == {date(2026, 4, 5), date(2026, 4, 20)}
+
+
+# --- R2 毎月判定 ---------------------------------------------------------------
+
+
+def test_two_occurrences_in_same_month_excluded() -> None:
+    rows = [
+        ex(date(2026, 1, 5), amount=100),
+        ex(date(2026, 1, 8), amount=100),
+        ex(date(2026, 2, 5), amount=100),
+        ex(date(2026, 3, 5), amount=100),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_one_missing_month_is_allowed() -> None:
+    rows = [ex(date(2026, m, 5), amount=100) for m in (1, 3, 4)]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].occurrences == 3
+
+
+def test_two_missing_months_excluded() -> None:
+    rows = [ex(date(2026, m, 5), amount=100) for m in (1, 4, 5)]
+    assert find_recurring(rows) == []
+
+
+def test_gap_of_three_months_excluded() -> None:
+    rows = [ex(date(2026, m, 5), amount=100) for m in (1, 2, 5)]
+    assert find_recurring(rows) == []
+
+
+# --- R3 件数 ---------------------------------------------------------------
+
+
+def test_below_min_occurrences_not_returned() -> None:
+    rows = [ex(date(2026, 1, 25)), ex(date(2026, 2, 25))]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_occurrences=2)) == 1
+
+
+# --- R4 基準日と直近金額 ---------------------------------------------------------
+
+
+def test_base_day_is_mode_with_ties_going_to_larger_day() -> None:
+    rows = [
+        ex(date(2026, 1, 10), amount=100),
+        ex(date(2026, 2, 20), amount=100),
+        ex(date(2026, 3, 10), amount=100),
+        ex(date(2026, 4, 20), amount=100),
+    ]
+    # 10 日と 20 日が 2 回ずつ。同数なので大きい方 20 日。
+    result = find_recurring(rows)
+    assert result[0].next_date == date(2026, 5, 20)
+
+
+def test_amount_is_latest_and_next_date_uses_mode_day() -> None:
+    rows = [
+        ex(date(2026, 1, 25), amount=100),
+        ex(date(2026, 2, 25), amount=100),
+        ex(date(2026, 3, 25), amount=100),
+    ]
+    r = find_recurring(rows)[0]
+    assert r.amount == 100
+    assert r.last_date == date(2026, 3, 25)
+    assert r.interval_months == 1
