index 0000000..afabe4c
--- /dev/null
+++ b/src/kakeibo/monthly_diff.py
@@ -0,0 +1,103 @@
+"""前月比レポート(カテゴリ別・純粋関数)。
+
+判断:
+- D1: 正 = 支出、負 = 返金。返金は負として合算する(前月比の集計も同じ)。
+- D2: 金額が bool・float・None なら TypeError。month の形式不正など範囲外は ValueError。
+- D3: 日付は Expense.day(date)だけを見る。月は "YYYY-MM" 文字列で受ける。
+- D4: 結果は決定的。並びは abs(delta) の降順、同点はカテゴリの昇順。入力の並びに依存しない。
+- D5: 本モジュールはメモを使わないため、メモの正規化は対象外(メモは集計に影響しない)。
+- D6: 空入力は空の結果([] / "(データなし)")を返し、例外にしない。
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from decimal import ROUND_HALF_UP, Decimal
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryDiff:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    percent: float | None
+    status: str
+
+
+def _parse_month(month: str) -> tuple[int, int]:
+    if not isinstance(month, str) or not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"month は YYYY-MM 形式である必要があります: {month!r}")
+    return int(month[:4]), int(month[5:])
+
+
+def _sums(rows: list[Expense], key: tuple[int, int]) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for e in rows:
+        if isinstance(e.amount, bool) or not isinstance(e.amount, int):
+            raise TypeError(f"amount は int である必要があります: {e.amount!r}")
+        if (e.day.year, e.day.month) == key:
+            out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def _percent(delta: int, previous: int) -> float | None:
+    if previous <= 0:
+        return None
+    value = Decimal(delta) * 100 / Decimal(previous)
+    return float(value.quantize(Decimal("0.1"), rounding=ROUND_HALF_UP))
+
+
+def _status(previous: int, current: int, delta: int) -> str:
+    if previous == 0 and current > 0:
+        return "新規"
+    if current == 0 and previous > 0:
+        return "なし"
+    if delta > 0:
+        return "増"
+    if delta < 0:
+        return "減"
+    return "同"
+
+
+def compare_months(rows: list[Expense], month: str) -> list[CategoryDiff]:
+    """month と、その暦の前月(1 月なら前年 12 月)をカテゴリごとに比べる。"""
+    year, mon = _parse_month(month)
+    prev_key = (year - 1, 12) if mon == 1 else (year, mon - 1)
+    current_sums = _sums(rows, (year, mon))
+    previous_sums = _sums(rows, prev_key)
+
+    diffs: list[CategoryDiff] = []
+    for cat in set(current_sums) | set(previous_sums):
+        prev = previous_sums.get(cat, 0)
+        cur = current_sums.get(cat, 0)
+        delta = cur - prev
+        diffs.append(
+            CategoryDiff(
+                category=cat,
+                previous=prev,
+                current=cur,
+                delta=delta,
+                percent=_percent(delta, prev),
+                status=_status(prev, cur, delta),
+            )
+        )
+    diffs.sort(key=lambda d: (-abs(d.delta), d.category))
+    return diffs
+
+
+def format_report(diffs: list[CategoryDiff]) -> str:
+    if not diffs:
+        return "(データなし)"
+    lines: list[str] = []
+    for d in diffs:
+        pct = "(-)" if d.percent is None else f"({d.percent:+.1f}%)"
+        lines.append(
+            f"{d.category}  {d.previous:,}→{d.current:,}  {d.delta:+,}円 {pct}  {d.status}"
+        )
+    return "\n".join(lines)
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..f37a089
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,178 @@
+"""定期支出の検出(純粋関数。標準ライブラリのみ)。
+
+D1: 金額は正 = 支出、負 = 返金。定期検出では返金は系列に混ぜず無視する。
+D2: bool は int の仲間でも拒否する。float・None などの型違いは TypeError。
+    範囲外(件数 < 2、許容率が 0〜1 の外、日が 1〜31 の外)は ValueError で引数名を書く。
+D3: 日付は date のみ受ける(datetime も拒否)。月は "YYYY-MM" 文字列。
+D4: 結果は決定的。next_date 昇順、同点はカテゴリ → メモ → 金額の昇順。入力の並びに依存しない。
+D5: メモの正規化(同一判定用): NFKC → 小文字化 → 空白の連続を 1 つに → 前後空白除去
+    → 末尾の " #12"・"(3)" を除く → 数字だけのメモは空扱い。
+D6: 空入力は [] を返す(例外にしない)。
+
+規則の要点:
+- R1 系列の同一判定は (カテゴリ, 正規化メモ)。同じ組の中で、金額が代表額(系列の最初の金額)の
+  amount_tolerance 倍を超えて違うもの、または日(日付の日)が 10 日超離れたものは別系列に分ける。
+- R2 毎月 = 各月に高々 1 件で、隣り合う出現が 1 か月差(欠けた月は全体で 1 つまで許容)。
+  同じ月に 2 回ある系列は毎月ではないとして除外する。
+- R3 min_occurrences(2 以上)回以上の系列だけ返す。
+- R4 Recurring.amount は直近の金額、memo は直近の件のメモ、
+  next_date は next_due(last_date, 基準日)。基準日は系列の日の最頻値(同数なら大きい方)。
+- R5 next_due は翌月の同じ日。その月に無ければ月末。12 月の次は翌年 1 月。
+"""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from collections import Counter
+from dataclasses import dataclass, field
+from datetime import date, datetime
+from itertools import pairwise
+
+from kakeibo.core import Expense
+
+_DAY_SPLIT_DAYS = 10
+_TRAILING_RE = re.compile(r" #\d+$|\s?\(\d+\)$")
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int
+    occurrences: int
+    last_date: date
+    next_date: date
+    interval_months: int = field(default=1, kw_only=True)
+
+
+def _check_day_of_month(day_of_month: object) -> int:
+    if isinstance(day_of_month, bool) or not isinstance(day_of_month, int):
+        raise TypeError("day_of_month は int である必要があります")
+    if not 1 <= day_of_month <= 31:
+        raise ValueError(f"day_of_month は 1〜31 である必要があります: {day_of_month}")
+    return day_of_month
+
+
+def next_due(last: date, day_of_month: int) -> date:
+    """last の翌月の day_of_month 日。その月に無ければ月末。"""
+    if not isinstance(last, date) or isinstance(last, datetime):
+        raise TypeError("last は date である必要があります")
+    dom = _check_day_of_month(day_of_month)
+    year, month = (
+        (last.year + 1, 1) if last.month == 12 else (last.year, last.month + 1)
+    )
+    last_day = calendar.monthrange(year, month)[1]
+    return date(year, month, min(dom, last_day))
+
+
+def _normalize_memo(memo: str) -> str:
+    s = unicodedata.normalize("NFKC", memo).lower()
+    s = re.sub(r"\s+", " ", s).strip()
+    s = _TRAILING_RE.sub("", s).strip()
+    if re.fullmatch(r"\d+", s):
+        return ""
+    return s
+
+
+def _check_expense(e: object) -> Expense:
+    if not isinstance(e, Expense):
+        raise TypeError("rows は Expense のリストである必要があります")
+    if not isinstance(e.day, date) or isinstance(e.day, datetime):
+        raise TypeError("Expense.day は date である必要があります")
+    if isinstance(e.amount, bool) or not isinstance(e.amount, int):
+        raise TypeError("Expense.amount は int(円)である必要があります")
+    return e
+
+
+def _sort_key(e: Expense) -> tuple[date, int, str]:
+    return (e.day, e.amount, e.memo)
+
+
+def _amount_close(a: int, rep: int, tolerance: float) -> bool:
+    return abs(a - rep) <= tolerance * rep
+
+
+def _day_close(a: int, b: int) -> bool:
+    return abs(a - b) <= _DAY_SPLIT_DAYS
+
+
+def _split_series(items: list[Expense], tolerance: float) -> list[list[Expense]]:
+    """items は日付順。代表(先頭)の金額と日付に近い件を同じ系列に入れる。"""
+    series: list[list[Expense]] = []
+    for e in items:
+        for s in series:
+            rep = s[0]
+            if _amount_close(e.amount, rep.amount, tolerance) and _day_close(
+                e.day.day, rep.day.day
+            ):
+                s.append(e)
+                break
+        else:
+            series.append([e])
+    return series
+
+
+def _to_recurring(
+    category: str, series: list[Expense], min_occurrences: int
+) -> Recurring | None:
+    if len(series) < min_occurrences:
+        return None
+    months = [(e.day.year, e.day.month) for e in series]
+    if len(set(months)) != len(months):
+        return None  # 同じ月に 2 回ある: 毎月ではない
+    missing = 0
+    for (y1, m1), (y2, m2) in pairwise(months):
+        gap = (y2 * 12 + m2) - (y1 * 12 + m1)
+        if gap not in (1, 2):
+            return None
+        missing += gap - 1
+    if missing > 1:
+        return None
+    counts = Counter(e.day.day for e in series)
+    dom = max(counts, key=lambda d: (counts[d], d))
+    last = series[-1]
+    return Recurring(
+        category=category,
+        memo=last.memo,
+        amount=last.amount,
+        occurrences=len(series),
+        last_date=last.day,
+        next_date=next_due(last.day, dom),
+    )
+
+
+def find_recurring(
+    rows: list[Expense], *, min_occurrences: int = 3, amount_tolerance: float = 0.0
+) -> list[Recurring]:
+    if isinstance(min_occurrences, bool) or not isinstance(min_occurrences, int):
+        raise TypeError("min_occurrences は int である必要があります")
+    if min_occurrences < 2:
+        raise ValueError(
+            f"min_occurrences は 2 以上である必要があります: {min_occurrences}"
+        )
+    if isinstance(amount_tolerance, bool) or not isinstance(
+        amount_tolerance, (int, float)
+    ):
+        raise TypeError("amount_tolerance は float である必要があります")
+    if not 0.0 <= amount_tolerance <= 1.0:
+        raise ValueError(
+            f"amount_tolerance は 0.0〜1.0 である必要があります: {amount_tolerance}"
+        )
+
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for raw in rows:
+        e = _check_expense(raw)
+        if e.amount < 0:  # D1: 返金は無視
+            continue
+        groups.setdefault((e.category, _normalize_memo(e.memo)), []).append(e)
+
+    found: list[Recurring] = []
+    for (category, _key), items in groups.items():
+        for series in _split_series(sorted(items, key=_sort_key), amount_tolerance):
+            rec = _to_recurring(category, series, min_occurrences)
+            if rec is not None:
+                found.append(rec)
+    found.sort(key=lambda r: (r.next_date, r.category, r.memo, r.amount))
+    return found
diff --git a/src/kakeibo/search.py b/src/kakeibo/search.py
new file mode 100644
index 0000000..c017a16
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,148 @@
+"""Composable search conditions over Expense rows.
+
+D1: 金額は正が支出・負が返金。amount_between は負の金額も範囲で比較する(除外しない)。
+D2: 金額の引数は int のみ。bool・float・None(両端としての None 以外)は TypeError。
+    上限 < 下限、両端 None、名前ゼロなどの範囲外は ValueError。
+D3: 日付は date のみ受ける(datetime は date の子だが拒否)。文字列は受けない。
+D4: 結果は決定的。並べ替えはしない。R6 により入力の並びをそのまま保って絞る
+    (入力の並びに依存しない並べ替えは行わない)。
+D5: 本モジュールの memo_contains は R3 の規則(NFKC + 小文字化の両側比較)のみ適用し、
+    連番除去などの D5 全体の正規化は使わない。
+D6: rows が空なら search は [] を返す(例外にしない)。
+"""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable
+from dataclasses import dataclass
+from datetime import date, datetime
+
+from kakeibo.core import Expense
+
+
+def _norm(text: str) -> str:
+    return unicodedata.normalize("NFKC", text)
+
+
+@dataclass(frozen=True)
+class Query:
+    """A condition on a single Expense. Build with the helpers in this module."""
+
+    predicate: Callable[[Expense], bool]
+
+    def matches(self, e: Expense) -> bool:
+        return self.predicate(e)
+
+
+def _require_queries(qs: tuple[object, ...]) -> list[Query]:
+    for q in qs:
+        if not isinstance(q, Query):
+            raise TypeError(f"Query を渡してください: {type(q).__name__}")
+    return list(qs)  # type: ignore[arg-type]
+
+
+def _check_int_bound(value: object, name: str) -> int | None:
+    if value is None:
+        return None
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{name} は int である必要があります: {type(value).__name__}")
+    return value
+
+
+def _check_date_bound(value: object, name: str) -> date | None:
+    if value is None:
+        return None
+    if not isinstance(value, date) or isinstance(value, datetime):
+        raise TypeError(f"{name} は date である必要があります: {type(value).__name__}")
+    return value
+
+
+def category_is(*names: str) -> Query:
+    """R1: カテゴリ完全一致(NFKC・前後空白除去・大文字小文字無視)。複数名は OR。"""
+    if not names:
+        raise ValueError("names には 1 つ以上のカテゴリ名が必要です")
+    wanted: set[str] = set()
+    for name in names:
+        if not isinstance(name, str):
+            raise TypeError(
+                f"カテゴリ名は str である必要があります: {type(name).__name__}"
+            )
+        key = _norm(name).strip().lower()
+        if not key:
+            raise ValueError("空のカテゴリ名は指定できません")
+        wanted.add(key)
+
+    def pred(e: Expense) -> bool:
+        return _norm(e.category).strip().lower() in wanted
+
+    return Query(pred)
+
+
+def amount_between(low: int | None = None, high: int | None = None) -> Query:
+    """R2: 両端を含む金額範囲。片側 None は無制限。両方 None・low > high は ValueError。"""
+    lo = _check_int_bound(low, "low")
+    hi = _check_int_bound(high, "high")
+    if lo is None and hi is None:
+        raise ValueError("low と high の少なくとも一方を指定してください")
+    if lo is not None and hi is not None and lo > hi:
+        raise ValueError(f"low ({lo}) は high ({hi}) 以下である必要があります")
+
+    def pred(e: Expense) -> bool:
+        return (lo is None or e.amount >= lo) and (hi is None or e.amount <= hi)
+
+    return Query(pred)
+
+
+def memo_contains(text: str) -> Query:
+    """R3: メモの部分一致。NFKC + 小文字化の両側で比べる。空文字は ValueError。"""
+    if not isinstance(text, str):
+        raise TypeError(f"text は str である必要があります: {type(text).__name__}")
+    needle = _norm(text).lower()
+    if not needle:
+        raise ValueError("空文字では検索できません")
+
+    def pred(e: Expense) -> bool:
+        return needle in _norm(e.memo).lower()
+
+    return Query(pred)
+
+
+def date_between(start: date | None = None, end: date | None = None) -> Query:
+    """R4: 両端を含む日付範囲。片側 None は無制限。両方 None・start > end は ValueError。"""
+    s = _check_date_bound(start, "start")
+    en = _check_date_bound(end, "end")
+    if s is None and en is None:
+        raise ValueError("start と end の少なくとも一方を指定してください")
+    if s is not None and en is not None and s > en:
+        raise ValueError(f"start ({s}) は end ({en}) 以下である必要があります")
+
+    def pred(e: Expense) -> bool:
+        return (s is None or e.day >= s) and (en is None or e.day <= en)
+
+    return Query(pred)
+
+
+def all_of(*qs: Query) -> Query:
+    """R5: AND。空は常に真。"""
+    items = _require_queries(qs)
+    return Query(lambda e: all(q.matches(e) for q in items))
+
+
+def any_of(*qs: Query) -> Query:
+    """R5: OR。空は常に偽。"""
+    items = _require_queries(qs)
+    return Query(lambda e: any(q.matches(e) for q in items))
+
+
+def not_(q: Query) -> Query:
+    """否定。"""
+    (item,) = _require_queries((q,))
+    return Query(lambda e: not item.matches(e))
+
+
+def search(rows: list[Expense], query: Query) -> list[Expense]:
+    """R6: 入力の並びを保って条件に合う行だけを新しいリストで返す。"""
+    if not isinstance(query, Query):
+        raise TypeError(f"Query を渡してください: {type(query).__name__}")
+    return [e for e in rows if query.matches(e)]
diff --git a/tests/test_bank_import.py b/tests/test_bank_import.py
new file mode 100644
index 0000000..500a445
--- /dev/null
+++ b/tests/test_bank_import.py
@@ -0,0 +1,228 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import RowError, parse_bank_csv, parse_bank_csv_lenient
+from kakeibo.core import CsvError, Expense
+
+
+# E2 の表（例の全行をそのまま写す）
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param(
+            '利用日,ご利用店名,利用金額\n2026/1/5,ＡＢＣ,"1,234円"\n',
+            [Expense(date(2026, 1, 5), "未分類", 1234, "ABC")],
+            id="E2-1",
+        ),
+        pytest.param(
+            "取引日,摘要,出金,入金\n20260105,振込,,3000\n",
+            [Expense(date(2026, 1, 5), "未分類", -3000, "振込")],
+            id="E2-2",
+        ),
+    ],
+)
+def test_spec_examples(text: str, expected: list[Expense]) -> None:
+    assert parse_bank_csv(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [pytest.param("日付,金額\n2026/2/30,12.5\n", id="E2-3")],
+)
+def test_spec_example_two_row_errors_same_line(text: str) -> None:
+    rows, errors = parse_bank_csv_lenient(text)
+    assert rows == []
+    assert {e.column for e in errors} == {"金額", "日付"}
+    assert len(errors) == 2
+    assert all(e.line == 2 for e in errors)
+    with pytest.raises(CsvError) as exc:
+        parse_bank_csv(text)
+    assert sorted(line for line, _ in exc.value.errors) == [2, 2]
+
+
+# D1: 返金は負の金額（1 列）
+def test_d1_negative_amount_in_single_column_is_refund() -> None:
+    rows = parse_bank_csv("日付,金額\n2026/1/5,-500\n")
+    assert rows[0].amount == -500
+
+
+# D2: 引数は str のみ。それ以外は TypeError
+@pytest.mark.parametrize("bad", [None, "日付,金額\n".encode(), 1])
+def test_d2_non_str_input_is_type_error(bad: object) -> None:
+    with pytest.raises(TypeError):
+        parse_bank_csv(bad)  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        parse_bank_csv_lenient(bad)  # type: ignore[arg-type]
+
+
+# D3: 日付は date で返す
+def test_d3_day_is_date_instance() -> None:
+    (e,) = parse_bank_csv("日付,金額\n2026/1/5,100\n")
+    assert type(e.day) is date
+
+
+# D4: 行順を保つ（並べ替えしない）
+def test_d4_keeps_input_row_order() -> None:
+    rows = parse_bank_csv("日付,金額,カテゴリ\n2026/1/9,100,Z\n2026/1/1,200,A\n")
+    assert [e.day for e in rows] == [date(2026, 1, 9), date(2026, 1, 1)]
+
+
+# D5: 同一判定をしない。同じ内容の行は別々に返す
+def test_d5_identical_rows_are_not_deduplicated() -> None:
+    rows = parse_bank_csv("日付,金額,摘要\n2026/1/5,100,A\n2026/1/5,100,A\n")
+    assert len(rows) == 2
+
+
+# D6: ヘッダーも無い完全に空は CsvError、ヘッダーだけは []
+@pytest.mark.parametrize("text", ["", "﻿", "  \r\n\n"])
+def test_d6_no_header_at_all_is_csv_error(text: str) -> None:
+    with pytest.raises(CsvError):
+        parse_bank_csv(text)
+
+
+def test_d6_header_only_is_empty_list() -> None:
+    assert parse_bank_csv("日付,金額\n") == []
+    assert parse_bank_csv_lenient("日付,金額") == ([], [])
+
+
+# R1: BOM・改行・区切りの自動判定・引用内の改行
+def test_r1_bom_and_crlf_and_cr_newlines() -> None:
+    text = "﻿日付,金額\r\n2026/1/5,100\r2026/1/6,200\n"
+    assert [e.amount for e in parse_bank_csv(text)] == [100, 200]
+
+
+def test_r1_tab_delimiter_detected_from_first_line() -> None:
+    rows = parse_bank_csv("日付\t金額\n2026/1/5\t100\n")
+    assert rows == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+def test_r1_quoted_newline_in_field() -> None:
+    rows = parse_bank_csv('日付,摘要,金額\n2026/1/5,"a\nb",100\n')
+    assert rows[0].memo == "a\nb"
+
+
+# R2: ヘッダー別名（前後空白・大文字小文字・NFKC）
+@pytest.mark.parametrize(
+    "header",
+    [" Date , AMOUNT ", "年月日,金額", "ＤＡＴＥ,Amount"],
+)
+def test_r2_header_aliases(header: str) -> None:
+    rows = parse_bank_csv(f"{header}\n2026/1/5,100\n")
+    assert rows == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+def test_r2_category_and_memo_columns_used() -> None:
+    rows = parse_bank_csv("日付,分類,内容,金額\n2026/1/5,食費,ランチ,980\n")
+    assert rows == [Expense(date(2026, 1, 5), "食費", 980, "ランチ")]
+
+
+# R3: 2 列（出金 → 正、入金 → 負）、両方空はスキップ、両方入りは誤り
+def test_r3_both_empty_row_is_skipped() -> None:
+    rows, errors = parse_bank_csv_lenient("日付,出金,入金\n2026/1/5,,\n2026/1/6,5,\n")
+    assert [e.amount for e in rows] == [5]
+    assert errors == []
+
+
+def test_r3_both_filled_is_row_error() -> None:
+    rows, errors = parse_bank_csv_lenient("日付,出金,入金\n2026/1/5,5,6\n")
+    assert rows == []
+    assert [e.column for e in errors] == ["出金・入金"]
+
+
+def test_r3_missing_required_column_is_header_error() -> None:
+    with pytest.raises(CsvError) as exc:
+        parse_bank_csv("金額\n100\n")
+    assert exc.value.errors == [(1, "必須の日付列がありません")]
+    with pytest.raises(CsvError) as exc2:
+        parse_bank_csv_lenient("日付,摘要\n2026/1/5,x\n")
+    assert exc2.value.errors == [(1, "金額列(金額、または出金・入金)がありません")]
+
+
+# R4: 金額文字列
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        ("¥1,234", 1234),
+        ("￥1,234", 1234),
+        ("1,234円", 1234),
+        ("JPY500", 500),
+        ("▲500", -500),
+        ("△500", -500),
+        ("-500", -500),
+        ("−500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("+500", 500),
+        ("0", 0),
+        ("-0", 0),
+    ],
+)
+def test_r4_amount_forms(raw: str, expected: int) -> None:
+    (e,) = parse_bank_csv(f'日付,金額\n2026/1/5,"{raw}"\n')
+    assert e.amount == expected
+
+
+@pytest.mark.parametrize("raw", ["12.5", "", "-", "—", "(500", "--500"])
+def test_r4_invalid_amount_is_row_error(raw: str) -> None:
+    rows, errors = parse_bank_csv_lenient(f'日付,金額\n2026/1/5,"{raw}"\n')
+    assert rows == []
+    assert [e.column for e in errors] == ["金額"]
+    assert errors[0].value == raw
+
+
+# R5: 日付形式
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026.1.5",
+        "2026年1月5日",
+        "20260105",
+        "2026-01-05 12:30",
+        "2026-01-05T12:30",
+    ],
+)
+def test_r5_date_forms(raw: str) -> None:
+    (e,) = parse_bank_csv(f"日付,金額\n{raw},100\n")
+    assert e.day == date(2026, 1, 5)
+
+
+@pytest.mark.parametrize("raw", ["2026/2/30", "令和8年1月5日", "2026-13-01"])
+def test_r5_invalid_date_is_row_error(raw: str) -> None:
+    _, errors = parse_bank_csv_lenient(f"日付,金額\n{raw},100\n")
+    assert [e.column for e in errors] == ["日付"]
+
+
+# R6: 誤りは全列分を集める。列数の不一致は (列数) で報告し修復しない
+def test_r6_column_count_mismatch_reported_not_repaired() -> None:
+    rows, errors = parse_bank_csv_lenient("日付,金額\n2026/1/5,1,234円\n")
+    assert rows == []
+    assert errors == [RowError(2, "(列数)", "3", "ヘッダーは 2 列、この行は 3 列")]
+
+
+def test_r6_fully_blank_lines_skipped() -> None:
+    rows = parse_bank_csv("\n日付,金額\n\n2026/1/5,100\n\n")
+    assert len(rows) == 1
+
+
+# R7: parse_bank_csv は誤りで CsvError、lenient は誤り行だけ除く
+def test_r7_strict_raises_with_line_and_message() -> None:
+    with pytest.raises(CsvError) as exc:
+        parse_bank_csv("日付,金額\n2026/1/5,100\n2026/1/6,12.5\n")
+    assert exc.value.errors == [(3, "金額 12.5: 小数は扱えません")]
+
+
+def test_r7_lenient_drops_only_bad_rows() -> None:
+    rows, errors = parse_bank_csv_lenient(
+        "日付,金額\n2026/1/5,100\n2026/1/6,x\n2026/1/7,300\n"
+    )
+    assert [e.amount for e in rows] == [100, 300]
+    assert [(e.line, e.column) for e in errors] == [(3, "金額")]
+
+
+# 行番号はレコード開始の物理行（引用内改行を跨ぐ）
+def test_line_number_is_record_start_line() -> None:
+    _, errors = parse_bank_csv_lenient('日付,摘要,金額\n2026/1/5,"a\nb",12.5\n')
+    assert [(e.line, e.column) for e in errors] == [(2, "金額")]
