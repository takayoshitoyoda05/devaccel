new file mode 100644
index 0000000..9ff5bb7
--- /dev/null
+++ b/tests/test_monthly_diff.py
@@ -0,0 +1,191 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthly_diff import CategoryDiff, compare_months, format_report
+
+
+def ex(y: int, m: int, d: int, cat: str, amount: int, memo: str = "") -> Expense:
+    return Expense(date(y, m, d), cat, amount, memo)
+
+
+# 例の表(E4-1 〜 E4-3)
+@pytest.mark.parametrize(
+    ("rows", "month", "expected"),
+    [
+        pytest.param(
+            [ex(2026, 1, 5, "食費", 100)],
+            "2026-02",
+            [CategoryDiff("食費", 100, 0, -100, -100.0, "なし")],
+            id="E4-1",
+        ),
+        pytest.param(
+            [ex(2025, 12, 10, "食費", 200), ex(2026, 1, 10, "食費", 300)],
+            "2026-01",
+            [CategoryDiff("食費", 200, 300, 100, 50.0, "増")],
+            id="E4-2",
+        ),
+        pytest.param(
+            [ex(2026, 2, 3, "食費", 500)],
+            "2026-02",
+            [CategoryDiff("食費", 0, 500, 500, None, "新規")],
+            id="E4-3",
+        ),
+    ],
+)
+def test_example_table(rows, month, expected):
+    assert compare_months(rows, month) == expected
+
+
+# R1: month の形式
+@pytest.mark.parametrize(
+    "month", ["2026-13", "2026-00", "2026-1", "2026/01", "202601", "", None]
+)
+def test_r1_invalid_month_raises(month):
+    with pytest.raises(ValueError):
+        compare_months([], month)
+
+
+def test_r1_january_compares_with_previous_december():
+    rows = [ex(2025, 12, 1, "食費", 400), ex(2026, 1, 1, "食費", 400)]
+    assert compare_months(rows, "2026-01") == [
+        CategoryDiff("食費", 400, 400, 0, 0.0, "同")
+    ]
+
+
+# R2: 返金は負として合算、片方の月にだけあるカテゴリも出す
+def test_r2_refund_is_summed_as_negative():
+    rows = [ex(2026, 1, 1, "食費", 500), ex(2026, 1, 2, "食費", -200)]
+    result = compare_months(rows, "2026-01")
+    assert result == [CategoryDiff("食費", 0, 300, 300, None, "新規")]
+
+
+def test_r2_category_only_in_previous_is_listed():
+    rows = [ex(2025, 12, 1, "娯楽", 50)]
+    result = compare_months(rows, "2026-01")
+    assert [d.category for d in result] == ["娯楽"]
+    assert result[0].current == 0
+
+
+# R3: 増・減・同・新規・なし
+@pytest.mark.parametrize(
+    ("prev", "cur", "delta", "status"),
+    [
+        (100, 300, 200, "増"),
+        (300, 100, -200, "減"),
+        (100, 100, 0, "同"),
+    ],
+)
+def test_r3_status_by_delta(prev, cur, delta, status):
+    rows = [ex(2025, 12, 1, "食費", prev), ex(2026, 1, 1, "食費", cur)]
+    (d,) = compare_months(rows, "2026-01")
+    assert (d.delta, d.status) == (delta, status)
+
+
+# R4: 四捨五入で小数 1 桁、前月 0 以下は None
+def test_r4_percent_rounds_half_up():
+    # 1 / 400 * 100 = 0.25 → 0.3(銀行丸めなら 0.2)
+    rows = [ex(2025, 12, 1, "食費", 400), ex(2026, 1, 1, "食費", 401)]
+    (d,) = compare_months(rows, "2026-01")
+    assert d.percent == 0.3
+
+
+def test_r4_percent_negative_rounding():
+    rows = [ex(2025, 12, 1, "食費", 300), ex(2026, 1, 1, "食費", 100)]
+    (d,) = compare_months(rows, "2026-01")
+    assert d.percent == -66.7
+
+
+def test_r4_previous_negative_gives_none():
+    rows = [ex(2025, 12, 1, "食費", -100), ex(2026, 1, 1, "食費", 50)]
+    (d,) = compare_months(rows, "2026-01")
+    assert (d.percent, d.status) == (None, "増")
+
+
+# R5: abs(delta) 降順、同点はカテゴリ昇順
+def test_r5_order_by_abs_delta_then_category():
+    rows = [
+        ex(2025, 12, 1, "b", 0),
+        ex(2026, 1, 1, "b", 300),  # +300
+        ex(2025, 12, 1, "a", 300),
+        ex(2026, 1, 1, "a", 0),  # -300
+        ex(2026, 1, 1, "c", 50),  # +50
+    ]
+    assert [d.category for d in compare_months(rows, "2026-01")] == ["a", "b", "c"]
+
+
+# R6: レポート形式
+def test_r6_format_line():
+    d = CategoryDiff("食費", 100, 300, 200, 200.0, "増")
+    assert format_report([d]) == "食費  100→300  +200円 (+200.0%)  増"
+
+
+def test_r6_format_thousands_negative_and_none_percent():
+    d = CategoryDiff("住居", 2500, 1000, -1500, None, "減")
+    assert format_report([d]) == "住居  2,500→1,000  -1,500円 (-)  減"
+
+
+def test_r6_format_multiple_lines_joined():
+    a = CategoryDiff("a", 0, 1, 1, None, "新規")
+    b = CategoryDiff("b", 1, 0, -1, -100.0, "なし")
+    assert format_report([a, b]).split("\n") == [
+        "a  0→1  +1円 (-)  新規",
+        "b  1→0  -1円 (-100.0%)  なし",
+    ]
+
+
+# R7 / D6: 空入力
+def test_r7_both_months_empty_returns_empty_list():
+    rows = [ex(2024, 6, 1, "食費", 100)]
+    assert compare_months(rows, "2026-01") == []
+
+
+def test_d6_empty_input_and_empty_report():
+    assert compare_months([], "2026-01") == []
+    assert format_report([]) == "(データなし)"
+
+
+# D1: 返金も支出と同じ扱いで合算
+def test_d1_refund_counts_in_both_months():
+    rows = [
+        ex(2025, 12, 1, "食費", 1000),
+        ex(2025, 12, 2, "食費", -200),
+        ex(2026, 1, 1, "食費", 800),
+    ]
+    (d,) = compare_months(rows, "2026-01")
+    assert (d.previous, d.current, d.delta) == (800, 800, 0)
+
+
+# D2: 金額の型
+@pytest.mark.parametrize("bad", [True, 1.0, None])
+def test_d2_non_int_amount_raises_type_error(bad):
+    rows = [Expense(date(2026, 1, 1), "食費", bad)]  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        compare_months(rows, "2026-01")
+
+
+# D3: 日付は date のみ。対象外の月の行は無視
+def test_d3_rows_outside_target_months_are_ignored():
+    rows = [ex(2026, 3, 1, "食費", 999)]
+    assert compare_months(rows, "2026-01") == []
+
+
+# D4: 入力順に依存しない
+def test_d4_result_independent_of_input_order():
+    rows = [
+        ex(2025, 12, 1, "b", 100),
+        ex(2026, 1, 1, "b", 100),
+        ex(2025, 12, 1, "a", 10),
+        ex(2026, 1, 1, "a", 60),
+    ]
+    assert compare_months(rows, "2026-01") == compare_months(
+        list(reversed(rows)), "2026-01"
+    )
+
+
+# D5: メモは集計に影響しない
+def test_d5_memo_does_not_affect_totals():
+    rows = [ex(2026, 1, 1, "食費", 100, "昼"), ex(2026, 1, 2, "食費", 200, "夜")]
+    (d,) = compare_months(rows, "2026-01")
+    assert d.current == 300
