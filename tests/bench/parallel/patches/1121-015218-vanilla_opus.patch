+class OpeningError(ValueError):
+    """Raised when the opening-balance JSON is missing or invalid."""
+
+
+def load_opening(path: Path) -> dict[str, int]:
+    """期首残高 JSON {"口座名": 円, ...} を読む(負の値も可。クレジットカードの未払いなど)。"""
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+    except OSError as e:
+        raise OpeningError(
+            f"期首残高ファイルを読めません: {e.strerror}: {path}"
+        ) from None
+    except ValueError as e:
+        raise OpeningError(f"期首残高ファイルが不正な JSON です: {e}") from None
+    if not isinstance(data, dict):
+        raise OpeningError("期首残高ファイルの最上位はオブジェクトである必要があります")
+    for acc, yen in data.items():
+        if isinstance(yen, bool) or not isinstance(yen, int):
+            raise OpeningError(f"{acc} の期首残高は整数である必要があります")
+    return dict(data)
+
+
+def accounts(rows: list[Expense]) -> set[str]:
+    """明細に現れる口座名(振替先を含む)。"""
+    out: set[str] = set()
+    for e in rows:
+        out.add(e.account)
+        if e.to_account is not None:
+            out.add(e.to_account)
+    return out
+
+
+def _deltas(e: Expense) -> list[tuple[str, int]]:
+    """明細が各口座の残高に与える増減。"""
+    if e.to_account is None:
+        return [(e.account, -e.amount)]
+    return [(e.account, -e.amount), (e.to_account, e.amount)]
+
+
+def balance_history(
+    rows: list[Expense], opening: dict[str, int] | None = None
+) -> list[tuple[date, str, int]]:
+    """(日付, 口座, その日の終わりの残高)。口座に動きのあった日だけ、日付昇順・口座名昇順。
+
+    支出は口座残高を減らし(負の金額なら増やす)、振替は振替元から振替先へ移す。
+    CSV の行順は問わない。
+    """
+    bal = dict(opening or {})
+    by_day: dict[date, list[Expense]] = {}
+    for e in rows:
+        by_day.setdefault(e.day, []).append(e)
+    out: list[tuple[date, str, int]] = []
+    for day in sorted(by_day):
+        changed: set[str] = set()
+        for e in by_day[day]:
+            for acc, d in _deltas(e):
+                bal[acc] = bal.get(acc, 0) + d
+                changed.add(acc)
+        out.extend((day, acc, bal[acc]) for acc in sorted(changed))
+    return out
+
+
+@dataclass(frozen=True)
+class AccountMonth:
+    month: str  # YYYY-MM
+    account: str
+    spent: int  # 支出合計(振替を除く)
+    transfer_in: int
+    transfer_out: int
+    balance: int  # 月末残高
+
+
+def monthly_account_report(
+    rows: list[Expense], opening: dict[str, int] | None = None
+) -> list[AccountMonth]:
+    """明細のある月ごと(昇順)に、その月末までに登場した全口座(期首残高の口座を含む)を
+    口座名昇順で返す。動きの無い口座も残高を示すため 0 円の行として出る。"""
+    bal = dict(opening or {})
+    by_month: dict[str, list[Expense]] = {}
+    for e in rows:
+        by_month.setdefault(e.day.strftime("%Y-%m"), []).append(e)
+    out: list[AccountMonth] = []
+    for month in sorted(by_month):
+        spent: dict[str, int] = {}
+        t_in: dict[str, int] = {}
+        t_out: dict[str, int] = {}
+        for e in by_month[month]:
+            for acc, d in _deltas(e):
+                bal[acc] = bal.get(acc, 0) + d
+            if e.to_account is None:
+                spent[e.account] = spent.get(e.account, 0) + e.amount
+            else:
+                t_out[e.account] = t_out.get(e.account, 0) + e.amount
+                t_in[e.to_account] = t_in.get(e.to_account, 0) + e.amount
+        out.extend(
+            AccountMonth(
+                month,
+                acc,
+                spent.get(acc, 0),
+                t_in.get(acc, 0),
+                t_out.get(acc, 0),
+                bal[acc],
+            )
+            for acc in sorted(bal)
+        )
+    return out
