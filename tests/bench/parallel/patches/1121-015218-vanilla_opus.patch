+import json
+import sys
+from datetime import date
+
+import pytest
+
+from kakeibo import main
+from kakeibo.core import (
+    DEFAULT_ACCOUNT,
+    AccountMonth,
+    CsvError,
+    Expense,
+    OpeningError,
+    balance_history,
+    load_csv,
+    load_opening,
+    monthly_account_report,
+    monthly_totals,
+    total_by_category,
+)
+
+HEADER = "date,category,amount,memo,account,to_account\n"
+BODY = (
+    "2026-10-25,salary,-300000,給料,bank,\n"
+    "2026-11-01,food,1200,lunch,cash,\n"
+    "2026-11-01,,20000,引き出し,bank,cash\n"
+    "2026-11-02,rent,80000,,bank,\n"
+    "2026-11-03,food,800,coffee,card,\n"
+    "2026-11-27,,800,カード引き落とし,bank,card\n"
+)
+
+
+def _csv(tmp_path, body=BODY, header=HEADER):
+    p = tmp_path / "in.csv"
+    p.write_text(header + body, encoding="utf-8")
+    return p
+
+
+def _run(tmp_path, monkeypatch, capsys, *args, body=BODY, header=HEADER):
+    p = _csv(tmp_path, body, header)
+    monkeypatch.setattr(sys, "argv", ["kakeibo", str(p), *map(str, args)])
+    code = 0
+    try:
+        main()
+    except SystemExit as e:
+        code = e.code
+    cap = capsys.readouterr()
+    return code, cap.out, cap.err
+
+
+# --- CSV 読み込み ---
+
+
+def test_legacy_csv_without_account_column(tmp_path):
+    p = _csv(tmp_path, "2026-11-01,food,1200,lunch\n", "date,category,amount,memo\n")
+    assert load_csv(p) == [
+        Expense(date(2026, 11, 1), "food", 1200, "lunch", DEFAULT_ACCOUNT, None)
+    ]
+
+
+def test_account_and_transfer_columns_parsed(tmp_path):
+    rows = load_csv(_csv(tmp_path))
+    assert rows[1].account == "cash" and not rows[1].is_transfer
+    assert rows[2].account == "bank" and rows[2].to_account == "cash"
+    assert rows[2].is_transfer
+
+
+def test_blank_or_short_account_falls_back_to_default(tmp_path):
+    p = _csv(
+        tmp_path,
+        "2026-11-01,food,1,, \n2026-11-02,food,2\n",
+        "date,category,amount,memo,account\n",
+    )
+    assert [r.account for r in load_csv(p)] == [DEFAULT_ACCOUNT, DEFAULT_ACCOUNT]
+
+
+def test_account_name_is_stripped(tmp_path):
+    p = _csv(tmp_path, "2026-11-01,,5,, bank , cash \n")
+    (r,) = load_csv(p)
+    assert (r.account, r.to_account) == ("bank", "cash")
+
+
+@pytest.mark.parametrize(
+    "line",
+    [
+        "2026-11-01,,100,,bank,bank\n",  # 同一口座
+        "2026-11-01,,0,,bank,cash\n",  # 0円振替
+        "2026-11-01,,-100,,bank,cash\n",  # 負の振替
+        "2026-11-01,,100,,,default\n",  # 既定口座→既定口座
