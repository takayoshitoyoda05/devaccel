+)
 
 HEADER = "date,category,amount,memo\n"
 
@@ -63,3 +69,163 @@ def test_total_flag_appends_total_row(tmp_path, capsys, monkeypatch):
     monkeypatch.setattr(sys, "argv", ["kakeibo", str(csv), "--total"])
     main()
     assert capsys.readouterr().out.splitlines()[-1] == "TOTAL\t2,000"
+
+
+# --- load_csv: edge cases ---
+
+
+def test_load_csv_empty_file_returns_empty_list(tmp_path):
+    p = tmp_path / "in.csv"
+    p.write_text("", encoding="utf-8")
+    assert load_csv(p) == []
+
+
+def test_load_csv_header_only_returns_empty_list(tmp_path):
+    assert load_csv(_write(tmp_path, "")) == []
+
+
+def test_load_csv_without_memo_column_defaults_to_empty_memo(tmp_path):
+    p = tmp_path / "in.csv"
+    p.write_text("date,category,amount\n2026-11-01,food,100\n", encoding="utf-8")
+    assert load_csv(p) == [Expense(date(2026, 11, 1), "food", 100, "")]
+
+
+def test_load_csv_strips_category_and_keeps_memo(tmp_path):
+    p = _write(tmp_path, "2026-11-01,  food ,100,lunch\n")
+    assert load_csv(p) == [Expense(date(2026, 11, 1), "food", 100, "lunch")]
+
+
+def test_load_csv_quoted_fields_with_comma_and_newline_in_memo(tmp_path):
+    p = _write(tmp_path, '2026-11-01,food,100,"a, b\nc"\n')
+    assert load_csv(p) == [Expense(date(2026, 11, 1), "food", 100, "a, b\nc")]
+
+
+def test_load_csv_extra_columns_are_ignored(tmp_path):
+    p = _write(tmp_path, "2026-11-01,food,100,m,extra\n")
+    assert load_csv(p) == [Expense(date(2026, 11, 1), "food", 100, "m")]
+
+
+def test_load_csv_skips_blank_lines_but_keeps_physical_line_numbers(tmp_path):
+    p = _write(tmp_path, "\n2026-11-01,food,100,\n\nbad,food,1,\n")
+    with pytest.raises(CsvError) as ei:
+        load_csv(p)
+    assert [line for line, _ in ei.value.errors] == [5]
+
+
+def test_load_csv_crlf_line_endings(tmp_path):
+    p = tmp_path / "in.csv"
+    p.write_bytes(
+        b"date,category,amount,memo\r\n2026-11-01,food,100,\r\nbad,food,1,\r\n"
+    )
+    with pytest.raises(CsvError) as ei:
+        load_csv(p)
+    assert [line for line, _ in ei.value.errors] == [3]
+
+
+@pytest.mark.parametrize("amount", ["", "1,000", "1.5", "1e3"])
+def test_load_csv_rejects_non_integer_amount(tmp_path, amount):
+    p = _write(tmp_path, '2026-11-01,food,"' + amount + '",\n')
+    with pytest.raises(CsvError) as ei:
+        load_csv(p)
+    assert ei.value.errors == [(2, "金額が整数ではありません: " + repr(amount))]
+
+
+@pytest.mark.parametrize("day", ["", "2026-02-30", "2026/11/01", "2026-13-01"])
+def test_load_csv_rejects_invalid_date(tmp_path, day):
+    p = _write(tmp_path, day + ",food,100,\n")
+    with pytest.raises(CsvError) as ei:
+        load_csv(p)
+    assert ei.value.errors == [(2, "日付が不正です: " + repr(day))]
+
+
+def test_load_csv_missing_required_header_reports_every_row(tmp_path):
+    p = tmp_path / "in.csv"
+    p.write_text("date,amount\n2026-11-01,100\n2026-11-02,200\n", encoding="utf-8")
+    with pytest.raises(CsvError) as ei:
+        load_csv(p)
+    assert ei.value.errors == [
+        (2, "列 category がありません"),
+        (3, "列 category がありません"),
+    ]
+
+
+def test_load_csv_error_message_joins_all_errors(tmp_path):
+    p = _write(tmp_path, "bad,food,1,\n2026-11-01,food,x,\n")
+    with pytest.raises(CsvError) as ei:
+        load_csv(p)
+    assert str(ei.value) == "2: 日付が不正です: 'bad'; 3: 金額が整数ではありません: 'x'"
+
+
+@pytest.mark.xfail(
+    strict=True,
+    reason="BUG: utf-8 で開くため BOM 付き CSV のヘッダ先頭が '\\ufeffdate' になる",
+)
+def test_load_csv_accepts_utf8_bom(tmp_path):
+    p = tmp_path / "in.csv"
+    p.write_text(HEADER + "2026-11-01,food,100,\n", encoding="utf-8-sig")
+    assert load_csv(p) == [Expense(date(2026, 11, 1), "food", 100, "")]
+
+
+@pytest.mark.xfail(
+    strict=True, reason="BUG: reader.line_num は複数行レコードの終了行を返す"
+)
+def test_load_csv_multiline_record_error_points_to_start_line(tmp_path):
+    p = _write(tmp_path, 'bad,food,100,"a\nb"\n')
+    with pytest.raises(CsvError) as ei:
+        load_csv(p)
+    assert [line for line, _ in ei.value.errors] == [2]
+
+
+# --- monthly_totals: edge cases ---
+
+
+def test_monthly_totals_empty():
+    assert monthly_totals([]) == {}
+
+
+def test_monthly_totals_sorts_months_across_year_boundary():
+    rows = [
+        Expense(date(2027, 1, 1), "food", 1),
+        Expense(date(2026, 12, 31), "food", 2),
+        Expense(date(2026, 2, 1), "food", 3),
+    ]
+    assert list(monthly_totals(rows)) == ["2026-02", "2026-12", "2027-01"]
+
+
+def test_monthly_totals_same_month_different_years_are_separate():
+    rows = [
+        Expense(date(2025, 11, 1), "food", 1),
+        Expense(date(2026, 11, 1), "food", 2),
+    ]
+    assert monthly_totals(rows) == {"2025-11": {"food": 1}, "2026-11": {"food": 2}}
+
+
+def test_monthly_totals_tie_keeps_first_seen_order():
+    rows = [Expense(date(2026, 11, 1), "b", 100), Expense(date(2026, 11, 2), "a", 100)]
+    assert list(monthly_totals(rows)["2026-11"]) == ["b", "a"]
+
+
+def test_monthly_totals_negative_amounts_net_out_and_zero_is_kept():
+    rows = [
+        Expense(date(2026, 11, 1), "food", 500),
+        Expense(date(2026, 11, 2), "food", -500),
+        Expense(date(2026, 11, 3), "refund", -100),
+    ]
+    assert monthly_totals(rows) == {"2026-11": {"food": 0, "refund": -100}}
+    assert list(monthly_totals(rows)["2026-11"]) == ["food", "refund"]
+
+
+def test_monthly_totals_does_not_mutate_input():
+    rows = [Expense(date(2026, 11, 2), "a", 1), Expense(date(2026, 10, 1), "b", 2)]
+    before = list(rows)
+    monthly_totals(rows)
+    assert rows == before
+
+
+@pytest.mark.xfail(
+    strict=True,
+    reason="BUG: 年 < 1000 で strftime('%Y') がゼロ埋めされず、月キーと並び順が崩れる",
+)
+def test_monthly_totals_zero_pads_small_years():
+    rows = [Expense(date(2026, 1, 1), "a", 1), Expense(date(999, 1, 1), "a", 1)]
+    assert list(monthly_totals(rows)) == ["0999-01", "2026-01"]
