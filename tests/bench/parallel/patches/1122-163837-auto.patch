diff --git a/tests/test_types/test_Choice.py b/tests/test_types/test_Choice.py
index c34f516..51bbfb1 100644
--- a/tests/test_types/test_Choice.py
+++ b/tests/test_types/test_Choice.py
@@ -1,3 +1,7 @@
+import enum
+
+import pytest
+
 import click
 
 
@@ -5,3 +9,61 @@ def test_choice_get_invalid_choice_message():
     choice = click.Choice(["a", "b", "c"])
     message = choice.get_invalid_choice_message("d", ctx=None)
     assert message == "'d' is not one of 'a', 'b', 'c'."
+
+
+@pytest.mark.parametrize(
+    ("value", "suffix"),
+    [
+        ("pause", "Did you mean 'push'?"),
+        ("decline", "(Did you mean one of: 'declare', 'refine'?)"),
+        ("xyz", None),
+    ],
+)
+def test_choice_suggests_close_choices(value, suffix):
+    choice = click.Choice(["push", "pull", "declare", "refine"])
+    message = choice.get_invalid_choice_message(value, ctx=None)
+    assert message.startswith(f"{value!r} is not one of ")
+    if suffix is None:
+        assert "Did you mean" not in message
+    else:
+        assert message.endswith(f". {suffix}")
+
+
+def test_choice_single_choice_suggestion():
+    choice = click.Choice(["push"])
+    message = choice.get_invalid_choice_message("pusj", ctx=None)
+    assert message == "'pusj' is not 'push'. Did you mean 'push'?"
+
+
+def test_choice_suggestion_uses_normalized_choices():
+    choice = click.Choice(["Push", "Pull"], case_sensitive=False)
+    message = choice.get_invalid_choice_message("PUSJ", ctx=None)
+    assert message.endswith("Did you mean 'push'?")
+
+
+def test_choice_suggestion_with_enum_and_non_str_value():
+    class Color(enum.Enum):
+        RED = 1
+        BLUE = 2
+
+    choice = click.Choice(Color)
+    assert choice.get_invalid_choice_message("REE", ctx=None).endswith(
+        "Did you mean 'RED'?"
+    )
+    assert "Did you mean" not in choice.get_invalid_choice_message(7, ctx=None)
+
+
+def test_choice_suggestion_in_cli_error():
+    @click.command()
+    @click.option("--action", type=click.Choice(["push", "pull"]))
+    def cli(action):
+        pass
+
+    from click.testing import CliRunner
+
+    result = CliRunner().invoke(cli, ["--action", "pusj"])
+    assert result.exit_code == 2
+    assert (
+        "Invalid value for '--action': 'pusj' is not one of 'push', 'pull'. "
+        "Did you mean 'push'?"
+    ) in result.output
