+"""Tests for kakeibo.stmt_date.parse_date."""
+
+from __future__ import annotations
+
+import re
+from datetime import date
+
+import pytest
+
+from kakeibo.stmt_date import DateError, parse_date
+
+
+# 仕様の例の表 (E3-*) をそのまま写す
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("令和元年5月1日", date(2019, 5, 1)),  # E3-1
+        ("2026/1/5 09:30", date(2026, 1, 5)),  # E3-2
+    ],
+    ids=["E3-1", "E3-2"],
+)
+def test_spec_examples(text: str, expected: date) -> None:
+    assert parse_date(text) == expected
+
+
+def test_e3_3_nonexistent_day_raises() -> None:  # E3-3
+    with pytest.raises(DateError):
+        parse_date("2025/2/29")
+
+
+# R1: 受け付ける西暦の書き方
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026-01-05", date(2026, 1, 5)),
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026.1.5", date(2026, 1, 5)),
+        ("20260105", date(2026, 1, 5)),
+        ("2026年1月5日", date(2026, 1, 5)),
+        ("2026-01-05 12:34", date(2026, 1, 5)),
+        ("2026/1/5 12:34:56", date(2026, 1, 5)),
+        ("2026-01-05T12:34:56", date(2026, 1, 5)),
+        ("２０２６／１／５", date(2026, 1, 5)),  # D2: NFKC
+        ("  2026-01-05  ", date(2026, 1, 5)),  # 前後の空白は除去
+        ("2024/2/29", date(2024, 2, 29)),  # 閏年は可
+    ],
+    ids=[
+        "R1-iso",
+        "R1-slash-1digit",
+        "R1-dot",
+        "R1-compact",
+        "R1-kanji",
+        "R1-time-hm",
+        "R1-time-hms-slash",
+        "R1-time-T",
+        "R1-fullwidth",
+        "R1-strip",
+        "R1-leap-ok",
+    ],
+)
+def test_western_forms(text: str, expected: date) -> None:
+    assert parse_date(text) == expected
+
+
+# R2: 和暦
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("令和8年1月5日", date(2026, 1, 5)),
+        ("R8.1.5", date(2026, 1, 5)),
+        ("平成31年4月30日", date(2019, 4, 30)),
+        ("H31/4/30", date(2019, 4, 30)),
+        ("昭和64年1月7日", date(1989, 1, 7)),
+        ("平成元年1月8日", date(1989, 1, 8)),
+    ],
+    ids=[
+        "R2-reiwa-kanji",
+        "R2-reiwa-alpha",
+        "R2-heisei-kanji",
+        "R2-heisei-alpha",
+        "R2-showa-64",
+        "R2-heisei-gannen",
+    ],
+)
+def test_wareki_forms(text: str, expected: date) -> None:
+    assert parse_date(text) == expected
+
+
+# R3: DateError
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "   ",
+        "2026/2/30",
+        "2026-13-01",
+        "2026-1/5",  # 区切りの混在
+        "1/5/2026",
+        "5 Jan 2026",
+        "令和0年1月1日",  # 和暦の年が 0
+        "R0.1.1",
+        "1899/12/31",  # 1900 未満
+        "2101/1/1",  # 2100 超
+        "令和100年1月1日",  # 西暦 2118 で 2100 超
+    ],
+    ids=[
+        "R3-empty",
+        "R3-blank",
+        "R3-feb30",
+        "R3-month13",
+        "R3-mixed-sep",
+        "R3-us-order",
+        "R3-english",
+        "R3-wareki-year0-kanji",
+        "R3-wareki-year0-alpha",
+        "R3-below-1900",
+        "R3-above-2100",
+        "R3-wareki-above-2100",
+    ],
+)
+def test_invalid_text_raises(text: str) -> None:
+    with pytest.raises(DateError):
+        parse_date(text)
+
+
+def test_error_message_contains_repr_of_original() -> None:
+    with pytest.raises(DateError, match=re.escape("日付が不正です: '2025/2/29'")):
+        parse_date("2025/2/29")
+
+
+# R4: str 以外は TypeError
+@pytest.mark.parametrize(
+    "value",
+    [None, 20260105, 2026.0, True, b"2026-01-05", date(2026, 1, 5)],
+    ids=["none", "int", "float", "bool", "bytes", "date"],
+)
+def test_non_str_raises_type_error(value: object) -> None:
+    with pytest.raises(TypeError):
+        parse_date(value)  # type: ignore[arg-type]
