@@ -0,0 +1,111 @@
+"""Import a bank / card statement CSV (already decoded text) into Expenses.
+
+Glue over stmt_table / stmt_date / stmt_amount.
+
+- D1: Every bad cell is reported as an ``Issue`` (line, column, raw value,
+  reason); a row with two bad cells gives two issues. Only header problems
+  raise (``TableError``).
+- D2: With a single ``amount`` column, ``negative_is_expense`` says which sign
+  is spending (False: positive, as card statements; True: bank withdrawals
+  written as negatives). The other sign and 0 go to ``skipped``.
+- D3: With ``out`` / ``in`` columns, a filled ``out`` is an expense (its
+  absolute value); a row with only ``in`` is skipped; both filled is an issue.
+- D4: Category comes from the ``category`` column if present (empty = issue),
+  otherwise ``default_category``.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+
+from kakeibo.core import Expense
+from kakeibo.stmt_amount import AmountError, parse_amount
+from kakeibo.stmt_date import DateError, parse_date
+from kakeibo.stmt_table import read_table
+
+
+@dataclass(frozen=True)
+class Issue:
+    line: int
+    column: str
+    value: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class StatementImport:
+    expenses: list[Expense] = field(default_factory=list)
+    skipped: list[tuple[int, str]] = field(default_factory=list)
+    issues: list[Issue] = field(default_factory=list)
+
+
+def import_statement(
+    text: str,
+    *,
+    skip_lines: int = 0,
+    default_category: str = "未分類",
+    negative_is_expense: bool = False,
+) -> StatementImport:
+    table = read_table(text, skip_lines=skip_lines)
+    expenses: list[Expense] = []
+    skipped: list[tuple[int, str]] = []
+    issues = [Issue(n, "", "", why) for n, why in table.problems]
+
+    for row in table.rows:
+        c = row.cells
+        bad = len(issues)
+        day = None
+        try:
+            day = parse_date(c["date"])
+        except DateError as e:
+            issues.append(Issue(row.line, "date", c["date"], str(e)))
+
+        category = default_category
+        if "category" in c:
+            category = c["category"]
+            if not category:
+                issues.append(Issue(row.line, "category", "", "カテゴリが空です"))
+
+        spent: int | None = None  # None: not an expense
+        skip_reason = ""
+        if "amount" in c:
+            try:
+                v = parse_amount(c["amount"])
+                signed = -v if negative_is_expense else v
+                if signed > 0:
+                    spent = signed
+                else:
+                    skip_reason = "支出ではない金額です"
+            except AmountError as e:
+                issues.append(Issue(row.line, "amount", c["amount"], str(e)))
+        else:
+            out_v = in_v = 0
+            for col in ("out", "in"):
+                raw = c.get(col, "")
+                if not raw:
+                    continue
+                try:
+                    v = abs(parse_amount(raw))
+                except AmountError as e:
+                    issues.append(Issue(row.line, col, raw, str(e)))
+                    continue
+                if col == "out":
+                    out_v = v
+                else:
+                    in_v = v
+            if out_v and in_v:
+                issues.append(
+                    Issue(row.line, "out", c["out"], "出金と入金の両方があります")
+                )
+            elif out_v:
+                spent = out_v
+            elif len(issues) == bad:
+                skip_reason = "入金または 0 円の行です"
+
+        if len(issues) > bad:
+            continue
+        if spent is None:
+            skipped.append((row.line, skip_reason))
+        elif day is not None:
+            expenses.append(Expense(day, category, spent, c.get("memo", "")))
+    return StatementImport(expenses, skipped, issues)
diff --git a/src/kakeibo/stmt_amount.py b/src/kakeibo/stmt_amount.py
