+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.statement_import import import_statement
+from kakeibo.stmt_table import TableError
+
+
+def test_card_statement_with_quoted_amount() -> None:
+    r = import_statement('利用日,ご利用店名,利用金額\n2026/1/5,カフェ,"1,200"\n')
+    assert r.expenses == [Expense(date(2026, 1, 5), "未分類", 1200, "カフェ")]
+    assert not r.issues and not r.skipped
+
+
+def test_every_bad_cell_is_reported_with_line_and_column() -> None:
+    r = import_statement("日付,金額\n2026/2/30,12.5\n2026/1/5,100\n")
+    assert [(i.line, i.column, i.value) for i in r.issues] == [
+        (2, "date", "2026/2/30"),
+        (2, "amount", "12.5"),
+    ]
+    assert len(r.expenses) == 1
+
+
+def test_column_count_problem_is_an_issue() -> None:
+    r = import_statement("日付,金額\n2026-01-05,1,200円\n")
+    assert r.issues[0].line == 2 and "列数" in r.issues[0].reason
+    assert r.expenses == []
+
+
+def test_bank_out_in_columns() -> None:
+    text = '取引日,摘要,出金額,入金額\n2026/1/5,家賃,"80,000",\n2026/1/6,給与,,300000\n'
+    r = import_statement(text, default_category="銀行")
+    assert r.expenses == [Expense(date(2026, 1, 5), "銀行", 80000, "家賃")]
+    assert [n for n, _ in r.skipped] == [3]
+
+
+def test_both_out_and_in_is_issue() -> None:
+    r = import_statement("日付,出金額,入金額\n2026/1/5,100,200\n")
+    assert r.issues[0].column == "out"
+
+
+def test_negative_is_expense_and_refund_skipped() -> None:
+    r = import_statement(
+        "日付,金額\n2026/1/5,▲500\n2026/1/6,300\n", negative_is_expense=True
+    )
+    assert [e.amount for e in r.expenses] == [500]
+    assert [n for n, _ in r.skipped] == [3]
+
+
+def test_category_column_empty_is_issue() -> None:
+    r = import_statement("日付,金額,分類\n2026/1/5,100,\n")
+    assert r.issues[0].column == "category"
+
+
+def test_missing_required_column_raises() -> None:
+    with pytest.raises(TableError):
+        import_statement("日付,メモ\n")
