index 0000000..aefbba0
--- /dev/null
+++ b/src/kakeibo/stmt_amount.py
@@ -0,0 +1,67 @@
+"""銀行・カード明細の金額文字列を円の整数に変換する(純粋関数)。
+
+受け付ける書き方は R1〜R4 に従う。負数は符号つき int で返す(D3)。
+"""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+
+__all__ = ["AmountError", "parse_amount"]
+
+
+class AmountError(ValueError):
+    """金額として解釈できない文字列。"""
+
+
+# 通貨記号(前後どちらにも置ける。1 つだけ)。
+_CUR = r"(?:¥|円|JPY)"
+# 桁区切りは 3 桁ごとのみ。小数点・符号は含まない。
+_NUM = r"(?:[0-9]+|[0-9]{1,3}(?:,[0-9]{3})+)"
+# 符号なしの本体。通貨と数字の間にだけ空白を許す。
+_BODY = rf"(?:{_CUR}\s*{_NUM}|{_NUM}\s*{_CUR}|{_NUM})"
+
+_PLAIN = re.compile(rf"\+?({_BODY})")  # 正数(先頭の + は任意)
+_PREFIX_NEG = re.compile(rf"[-−▲△]({_BODY})")  # 先頭の符号
+_PAREN_NEG = re.compile(rf"\(({_BODY})\)")  # 括弧
+_SUFFIX_NEG = re.compile(rf"({_BODY})-")  # 末尾の -
+
+_FORMS: tuple[tuple[re.Pattern[str], int], ...] = (
+    (_PLAIN, 1),
+    (_PREFIX_NEG, -1),
+    (_PAREN_NEG, -1),
+    (_SUFFIX_NEG, -1),
+)
+
+_SIGN_CHARS = "-−▲△+"
+
+
+def _reason(t: str) -> str:
+    """不正な理由を日本語で返す(t は NFKC 正規化・前後空白除去済み)。"""
+    if t == "":
+        return "空の文字列です"
+    if "." in t:
+        return "小数点は使えません"
+    if sum(t.count(c) for c in _SIGN_CHARS) >= 2:
+        return "符号は 1 つだけです"
+    if "(" in t and any(c in t for c in _SIGN_CHARS):
+        return "括弧の中に符号は書けません"
+    return "数字・桁区切り(3 桁ごと)・通貨記号の書式ではありません"
+
+
+def parse_amount(text: str) -> int:
+    """明細の金額文字列を円の整数に変換する。負数は負の int になる。
+
+    不正な文字列は AmountError、str 以外は TypeError を投げる。
+    """
+    if not isinstance(text, str):
+        raise TypeError(f"金額は str で渡してください: {type(text).__name__}")
+    t = unicodedata.normalize("NFKC", text).strip()
+    if t:
+        for pattern, sign in _FORMS:
+            m = pattern.fullmatch(t)
+            if m:
+                value = int(re.sub(r"[^0-9]", "", m.group(1)))
+                return sign * value
+    raise AmountError(f"金額が不正です: {text!r}({_reason(t)})")
diff --git a/src/kakeibo/stmt_date.py b/src/kakeibo/stmt_date.py
new file mode 100644
index 0000000..a64ebca
--- /dev/null
+++ b/src/kakeibo/stmt_date.py
@@ -0,0 +1,80 @@
+"""Date parsing for bank/card statement CSVs (pure functions, stdlib only)."""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from datetime import date
+
+
+class DateError(ValueError):
+    """Raised when a statement date cannot be parsed."""
+
+
+# 西暦: 2026-01-05 / 2026/1/5 / 2026.1.5 (区切りは前後で統一) + 任意の時刻(捨てる)
+_WESTERN_SEP = re.compile(
+    r"(?P<y>[0-9]{4})(?P<s>[-/.])(?P<m>[0-9]{1,2})(?P=s)(?P<d>[0-9]{1,2})"
+    r"(?:[ T][0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?)?"
+)
+_WESTERN_KANJI = re.compile(r"(?P<y>[0-9]{4})年(?P<m>[0-9]{1,2})月(?P<d>[0-9]{1,2})日")
+_WESTERN_COMPACT = re.compile(r"(?P<y>[0-9]{4})(?P<m>[0-9]{2})(?P<d>[0-9]{2})")
+
+# 和暦: 令和8年1月5日 / 令和元年5月1日 / R8.1.5 / H31/4/30
+_WAREKI_KANJI = re.compile(
+    r"(?P<era>令和|平成|昭和)(?P<y>元|[0-9]+)年(?P<m>[0-9]{1,2})月(?P<d>[0-9]{1,2})日"
+)
+_WAREKI_SEP = re.compile(
+    r"(?P<era>[RHS])(?P<y>元|[0-9]+)(?P<s>[-/.])(?P<m>[0-9]{1,2})(?P=s)(?P<d>[0-9]{1,2})"
+)
+
+# 元年 = 1 年目。西暦 = 元号の基準年 + 和暦の年
+_ERA_BASE = {
+    "令和": 2018,
+    "平成": 1988,
+    "昭和": 1925,
+    "R": 2018,
+    "H": 1988,
+    "S": 1925,
+}
+
+
+def _error(text: str, reason: str) -> DateError:
+    return DateError(f"日付が不正です: {text!r}({reason})")
+
+
+def _build(text: str, year: int, month: int, day: int) -> date:
+    if not 1900 <= year <= 2100:
+        raise _error(text, "年が 1900〜2100 の範囲外です")
+    try:
+        return date(year, month, day)
+    except ValueError:
+        raise _error(text, "存在しない日付です") from None
+
+
+def parse_date(text: str) -> date:
+    """Parse a statement date string. Time parts are discarded.
+
+    Raises TypeError for non-str input and DateError for invalid text.
+    """
+    if not isinstance(text, str):
+        raise TypeError(f"str が必要です: {type(text).__name__}")
+    s = unicodedata.normalize("NFKC", text).strip()
+    if not s:
+        raise _error(text, "空文字です")
+
+    m = (
+        _WESTERN_SEP.fullmatch(s)
+        or _WESTERN_KANJI.fullmatch(s)
+        or _WESTERN_COMPACT.fullmatch(s)
+    )
+    if m:
+        return _build(text, int(m["y"]), int(m["m"]), int(m["d"]))
+
+    m = _WAREKI_KANJI.fullmatch(s) or _WAREKI_SEP.fullmatch(s)
+    if m:
+        n = 1 if m["y"] == "元" else int(m["y"])
+        if n == 0:
+            raise _error(text, "和暦の年が 0 です")
+        return _build(text, _ERA_BASE[m["era"]] + n, int(m["m"]), int(m["d"]))
+
+    raise _error(text, "対応していない書式です")
diff --git a/src/kakeibo/stmt_table.py b/src/kakeibo/stmt_table.py
