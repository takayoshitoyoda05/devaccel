index 0000000..1091f9d
--- /dev/null
+++ b/src/kakeibo/stmt_table.py
@@ -0,0 +1,123 @@
+"""Bank/card statement table reader (pure function; no I/O, no amount/date parsing)."""
+
+from __future__ import annotations
+
+import csv
+import unicodedata
+from dataclasses import dataclass
+from io import StringIO
+
+
+@dataclass(frozen=True)
+class TableRow:
+    line: int  # 物理行番号(1 始まり・レコードの開始行)
+    cells: dict[str, str]  # キーは正規名、値は前後空白除去済み
+
+
+@dataclass(frozen=True)
+class StatementTable:
+    rows: list[TableRow]
+    problems: list[tuple[int, str]]  # (行番号, 理由)
+
+
+class TableError(ValueError):
+    """Raised when the header is missing or required columns are absent or duplicated."""
+
+
+_ALIASES: dict[str, tuple[str, ...]] = {
+    "date": ("date", "日付", "利用日", "取引日", "ご利用日", "年月日"),
+    "amount": ("amount", "金額", "利用金額", "ご利用金額", "お取引金額"),
+    "out": ("出金額", "お支払金額", "支払金額", "出金", "支払"),
+    "in": ("入金額", "お預り金額", "預入金額", "入金", "預入"),
+    "memo": (
+        "memo",
+        "摘要",
+        "メモ",
+        "利用店名",
+        "ご利用店名",
+        "内容",
+        "備考",
+        "お取引内容",
+    ),
+    "category": ("category", "カテゴリ", "分類", "種別"),
+}
+
+
+def _norm(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip().lower()
+
+
+_CANONICAL: dict[str, str] = {
+    _norm(alias): canon for canon, aliases in _ALIASES.items() for alias in aliases
+}
+
+
+def _map_header(header: list[str]) -> dict[str, int]:
+    """Return {正規名: 列番号}. Raises TableError on duplicates or missing required columns."""
+    index: dict[str, list[int]] = {}
+    for i, cell in enumerate(header):
+        canon = _CANONICAL.get(_norm(cell))
+        if canon is not None:
+            index.setdefault(canon, []).append(i)
+
+    dups = sorted(c for c, idx in index.items() if len(idx) > 1)
+    if dups:
+        raise TableError(f"同じ正規名の列が 2 つ以上あります: {', '.join(dups)}")
+
+    missing: list[str] = []
+    if "date" not in index:
+        missing.append("date")
+    if "amount" not in index and "out" not in index and "in" not in index:
+        missing.append("amount か out/in のいずれか")
+    if missing:
+        raise TableError(f"必須列がありません: {', '.join(missing)}")
+
+    return {canon: idx[0] for canon, idx in index.items()}
+
+
+def read_table(text: str, *, skip_lines: int = 0) -> StatementTable:
+    if not isinstance(text, str):
+        raise TypeError(f"text は str である必要があります: {type(text).__name__}")
+    if isinstance(skip_lines, bool) or not isinstance(skip_lines, int):
+        raise TypeError(f"skip_lines は int である必要があります: {skip_lines!r}")
+    if skip_lines < 0:
+        raise ValueError(f"skip_lines は 0 以上である必要があります: {skip_lines!r}")
+
+    text = text.removeprefix("﻿")
+
+    src = StringIO(text, newline="")
+    for _ in range(skip_lines):
+        src.readline()
+    rest = src.read()
+
+    header_raw = next((ln for ln in StringIO(rest, newline="") if ln.strip()), None)
+    if header_raw is None:
+        raise TableError("ヘッダー行がありません")
+    delimiter = "\t" if "\t" in header_raw and "," not in header_raw else ","
+
+    reader = csv.reader(StringIO(rest, newline=""), delimiter=delimiter)
+    header: list[str] | None = None
+    mapping: dict[str, int] = {}
+    rows: list[TableRow] = []
+    problems: list[tuple[int, str]] = []
+    end = 0  # 直前レコードの終了行(rest 基準)
+    for record in reader:
+        start = skip_lines + end + 1  # 元テキストの物理行(レコード開始行)
+        end = reader.line_num
+        if all(not cell.strip() for cell in record):
+            continue
+        if header is None:
+            header = record
+            mapping = _map_header(header)
+            continue
+        if len(record) != len(header):
+            problems.append(
+                (start, f"列数が {len(header)} ではなく {len(record)} です")
+            )
+            continue
+        cells = {canon: record[i].strip() for canon, i in mapping.items()}
+        rows.append(TableRow(start, cells))
+
+    if header is None:
+        raise TableError("ヘッダー行がありません")
+    return StatementTable(rows=rows, problems=problems)
