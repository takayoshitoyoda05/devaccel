+"""Tests for kakeibo.stmt_table.read_table (pure function, no I/O)."""
+
+from __future__ import annotations
+
+import pytest
+
+from kakeibo.stmt_table import StatementTable, TableError, TableRow, read_table
+
+
+# 仕様の例の表 (E1-*) をそのままテストに写す。
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param(
+            '利用日,ご利用店名,利用金額\n2026/1/5,A,"1,200"\n',
+            StatementTable(
+                rows=[
+                    TableRow(2, {"date": "2026/1/5", "memo": "A", "amount": "1,200"})
+                ],
+                problems=[],
+            ),
+            id="E1-1",
+        ),
+        pytest.param(
+            "日付,金額\n2026-01-05,1,200円\n",
+            StatementTable(rows=[], problems=[(2, "列数が 2 ではなく 3 です")]),
+            id="E1-2",
+        ),
+    ],
+)
+def test_example_table(text: str, expected: StatementTable) -> None:
+    assert read_table(text) == expected
+
+
+def test_E1_3_missing_amount_column_raises() -> None:
+    with pytest.raises(TableError, match="amount"):
+        read_table("日付,メモ\n")
+
+
+# 以下は規則 R1〜R6 の確認(表に無い端のケースは追加しない)。
+
+
+def test_R1_bom_is_ignored() -> None:
+    result = read_table("﻿日付,金額\n2026-01-05,100\n")
+    assert result.rows == [TableRow(2, {"date": "2026-01-05", "amount": "100"})]
+
+
+@pytest.mark.parametrize("newline", ["\r\n", "\r", "\n"])
+def test_R1_all_newline_styles(newline: str) -> None:
+    text = newline.join(["日付,金額", "2026-01-05,100", "2026-01-06,200"]) + newline
+    result = read_table(text)
+    assert [r.line for r in result.rows] == [2, 3]
+
+
+def test_R1_skip_lines_then_header() -> None:
+    text = "会社名: X\n期間: 2026\n日付,金額\n2026-01-05,100\n"
+    result = read_table(text, skip_lines=2)
+    assert result.rows == [TableRow(4, {"date": "2026-01-05", "amount": "100"})]
+
+
+def test_R1_negative_skip_lines_raises_value_error() -> None:
+    with pytest.raises(ValueError):
+        read_table("日付,金額\n", skip_lines=-1)
+
+
+@pytest.mark.parametrize("bad", [True, None, 1.0, "1"])
+def test_R1_non_int_skip_lines_raises_type_error(bad: object) -> None:
+    with pytest.raises(TypeError):
+        read_table("日付,金額\n", skip_lines=bad)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad", [None, b"x", 1])
+def test_non_str_text_raises_type_error(bad: object) -> None:
+    with pytest.raises(TypeError):
+        read_table(bad)  # type: ignore[arg-type]
+
+
+def test_R2_tab_delimiter_when_header_has_only_tabs() -> None:
+    result = read_table("日付\t金額\n2026-01-05\t100\n")
+    assert result.rows == [TableRow(2, {"date": "2026-01-05", "amount": "100"})]
+
+
+def test_R2_comma_wins_when_header_has_tab_and_comma() -> None:
+    result = read_table("日付,金額,摘要\n2026-01-05,100,昼食\t弁当\n")
+    # 区切りは ","。タブを含む値はそのまま残る(前後空白のみ除去)。
+    assert result.rows == [
+        TableRow(2, {"date": "2026-01-05", "amount": "100", "memo": "昼食\t弁当"})
+    ]
+
+
+def test_R2_quoted_comma_and_newline_follow_csv_rules() -> None:
+    text = '日付,金額,摘要\n2026-01-05,"1,200","改行\nあり"\n'
+    result = read_table(text)
+    assert result.rows == [
+        TableRow(2, {"date": "2026-01-05", "amount": "1,200", "memo": "改行\nあり"})
+    ]
+
+
+def test_R3_unknown_columns_ignored_and_aliases_mapped() -> None:
+    result = read_table("ｄａｔｅ,出金額,入金,その他\n2026-01-05,300,,x\n")
+    assert result.rows == [TableRow(2, {"date": "2026-01-05", "out": "300", "in": ""})]
+
+
+def test_R3_nfkc_and_case_insensitive_column_names() -> None:
+    result = read_table("ＤＡＴＥ, Amount \n2026-01-05,100\n")
+    assert result.rows == [TableRow(2, {"date": "2026-01-05", "amount": "100"})]
+
+
+def test_R4_out_or_in_satisfies_amount_requirement() -> None:
+    result = read_table("日付,入金額\n2026-01-05,500\n")
+    assert result.rows == [TableRow(2, {"date": "2026-01-05", "in": "500"})]
+
+
+def test_R4_missing_date_raises_with_name() -> None:
+    with pytest.raises(TableError, match="date"):
+        read_table("金額\n100\n")
+
+
+def test_R4_duplicate_canonical_column_raises() -> None:
+    with pytest.raises(TableError):
+        read_table("日付,金額,amount\n2026-01-05,1,2\n")
+
+
+@pytest.mark.parametrize(
+    ("text", "skip"),
+    [("", 0), ("   \n\n", 0), ("前置き\n", 1)],
+    ids=["empty", "blank", "preamble-only"],
+)
+def test_R4_no_header_raises(text: str, skip: int) -> None:
+    with pytest.raises(TableError):
+        read_table(text, skip_lines=skip)
+
+
+def test_R5_blank_lines_are_ignored() -> None:
+    result = read_table("日付,金額\n\n  ,  \n2026-01-05,100\n")
+    assert result.rows == [TableRow(4, {"date": "2026-01-05", "amount": "100"})]
+    assert result.problems == []
+
+
+def test_R5_values_are_stripped_not_interpreted() -> None:
+    result = read_table("日付, 金額 \n 2026-01-05 , -１，２３４ \n")
+    assert result.rows == [TableRow(2, {"date": "2026-01-05", "amount": "-１，２３４"})]
+
+
+def test_R6_header_only_gives_empty_result() -> None:
+    assert read_table("日付,金額\n") == StatementTable(rows=[], problems=[])
+
