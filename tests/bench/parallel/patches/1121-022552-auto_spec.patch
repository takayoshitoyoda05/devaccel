+"""銀行・カード明細の金額文字列の解析(kakeibo.stmt_amount)のテスト。"""
+
+from __future__ import annotations
+
+import pytest
+
+from kakeibo.stmt_amount import AmountError, parse_amount
+
+
+# 仕様の例の表(E2-x)をそのまま写す。
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param("￥１，２３４", 1234, id="E2-1"),
+        pytest.param("△5,000円", -5000, id="E2-2"),
+    ],
+)
+def test_spec_examples_parse(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        pytest.param("12.5", id="E2-3"),
+    ],
+)
+def test_spec_examples_rejected(text: str) -> None:
+    with pytest.raises(AmountError):
+        parse_amount(text)
+
+
+# R1: 数字・桁区切り・通貨記号の書き方。
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param("1234", 1234, id="R1-plain"),
+        pytest.param("1,234", 1234, id="R1-group"),
+        pytest.param("12,345,678", 12345678, id="R1-group-many"),
+        pytest.param("¥1,234", 1234, id="R1-yen-prefix"),
+        pytest.param("1,234円", 1234, id="R1-yen-kanji-suffix"),
+        pytest.param("1,234 JPY", 1234, id="R1-jpy-suffix-space"),
+        pytest.param("¥ 1,234", 1234, id="R1-space-after-currency"),
+        pytest.param("  1,234  ", 1234, id="R1-outer-space"),
+    ],
+)
+def test_r1_accepted_forms(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        pytest.param("1,23", id="R1-bad-group-short"),
+        pytest.param(",123", id="R1-bad-group-leading-comma"),
+        pytest.param("1 234", id="R1-inner-space-digits"),
+    ],
+)
+def test_r1_rejected_forms(text: str) -> None:
+    with pytest.raises(AmountError):
+        parse_amount(text)
+
+
+# R2: 負数の書き方と符号の個数。
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param("-500", -500, id="R2-hyphen"),
+        pytest.param("−500", -500, id="R2-minus-sign"),
+        pytest.param("▲500", -500, id="R2-triangle-black"),
+        pytest.param("△500", -500, id="R2-triangle-white"),
+        pytest.param("(500)", -500, id="R2-paren"),
+        pytest.param("500-", -500, id="R2-suffix"),
+        pytest.param("+500", 500, id="R2-plus-positive"),
+    ],
+)
+def test_r2_sign_forms(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        pytest.param("--5", id="R2-double-hyphen"),
+        pytest.param("▲-5", id="R2-triangle-and-hyphen"),
+        pytest.param("(−5)", id="R2-sign-inside-paren"),
+    ],
+)
+def test_r2_multiple_signs_rejected(text: str) -> None:
+    with pytest.raises(AmountError):
+        parse_amount(text)
+
+
+# R3: 解釈できない文字列はすべて AmountError。
+@pytest.mark.parametrize(
+    "text",
+    [
+        pytest.param("", id="R3-empty"),
+        pytest.param("   ", id="R3-spaces"),
+        pytest.param("-", id="R3-hyphen-only"),
+        pytest.param("—", id="R3-em-dash"),
+        pytest.param("1,234.00", id="R3-decimal-grouped"),
+        pytest.param("nan", id="R3-nan"),
+        pytest.param("1e3", id="R3-exponent"),
+    ],
+)
+def test_r3_invalid_text_rejected(text: str) -> None:
+    with pytest.raises(AmountError):
+        parse_amount(text)
+
+
+def test_r3_zero_and_negative_zero_return_zero() -> None:
+    assert parse_amount("0") == 0
+    assert parse_amount("-0") == 0
+
+
+def test_r3_error_message_contains_repr_and_reason() -> None:
+    with pytest.raises(AmountError) as info:
+        parse_amount("12.5")
+    assert str(info.value).startswith("金額が不正です: '12.5'(")
+
+
+# R4: str 以外は TypeError。
+@pytest.mark.parametrize(
+    "value",
+    [
+        pytest.param(True, id="R4-bool"),
+        pytest.param(None, id="R4-none"),
+        pytest.param(1234, id="R4-int"),
+        pytest.param(12.5, id="R4-float"),
+    ],
+)
+def test_r4_non_str_raises_type_error(value: object) -> None:
+    with pytest.raises(TypeError):
+        parse_amount(value)  # type: ignore[arg-type]
