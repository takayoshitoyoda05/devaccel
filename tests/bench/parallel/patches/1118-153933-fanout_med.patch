index 0000000..d4f68c4
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,118 @@
+"""Import rows from other banks' CSV exports as Expense records (stdlib only)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+# 任意の "-" → 任意の "¥"/"￥" → ASCII 数字で始まる数字とカンマの列 → 任意の "円"
+_AMOUNT_RE = re.compile(r"(-?)[¥￥]?([0-9][0-9,]*)円?")
+# YYYY/M/D または YYYY-M-D。区切りは同じものを使う(\2 で一致を強制)。
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+_REQUIRED_FIELDS = ("date", "category", "amount")
+
+
+def parse_amount(s: str) -> int:
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    sign, digits = m.groups()
+    value = int(digits.replace(",", ""))
+    return -value if sign else value
+
+
+def parse_date(s: str) -> date:
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    year, _sep, month, day = m.groups()
+    try:
+        return date(int(year), int(month), int(day))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def _cell(row: list[str], index: int) -> str:
+    return row[index] if index < len(row) else ""
+
+
+def _is_blank(row: list[str]) -> bool:
+    return row == [] or (len(row) == 1 and row[0].strip() == "")
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    cols = DEFAULT_MAPPING if mapping is None else mapping
+    for key in _REQUIRED_FIELDS:
+        if key not in cols:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    try:
+        header = next(reader)
+    except StopIteration:
+        header = []
+    # 物理行番号: 直前のレコードの終端行の次が今のレコードの開始行
+    line = reader.line_num
+
+    index: dict[str, int] = {}
+    for i, name in enumerate(header):
+        index.setdefault(name, i)
+    for field in ("date", "category", "amount", "memo"):
+        if field in cols and cols[field] not in index:
+            raise ValueError(f"ヘッダーに列 {cols[field]!r} がありません")
+
+    date_i = index[cols["date"]]
+    category_i = index[cols["category"]]
+    amount_i = index[cols["amount"]]
+    memo_i = index[cols["memo"]] if "memo" in cols else None
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    for row in reader:
+        start = line + 1
+        line = reader.line_num
+        if _is_blank(row):
+            continue
+
+        row_errors: list[tuple[int, str]] = []
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(_cell(row, date_i))
+        except ValueError:
+            row_errors.append((start, "date"))
+        try:
+            amount = parse_amount(_cell(row, amount_i))
+        except ValueError:
+            row_errors.append((start, "amount"))
+        category = _cell(row, category_i).strip()
+        if not category:
+            row_errors.append((start, "category"))
+
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        if day is None or amount is None:  # 検査済みのため到達しない
+            continue
+
+        if category_map is not None:
+            category = category_map.get(category, category)
+        memo = _cell(row, memo_i).strip() if memo_i is not None else ""
+        expenses.append(Expense(day=day, category=category, amount=amount, memo=memo))
+
+    return expenses, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
