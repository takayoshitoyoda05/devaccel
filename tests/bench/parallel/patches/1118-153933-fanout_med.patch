@@ -0,0 +1,268 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def E(day: date, category: str = "通信", amount: int = 1000, memo: str = "") -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- add_month -------------------------------------------------------------
+
+
+def test_add_month_plain() -> None:
+    assert add_month(date(2026, 3, 10)) == date(2026, 4, 10)
+
+
+def test_add_month_clamps_to_end_of_short_month() -> None:
+    assert add_month(date(2026, 1, 31)) == date(2026, 2, 28)
+
+
+def test_add_month_clamps_to_leap_february() -> None:
+    assert add_month(date(2024, 1, 31)) == date(2024, 2, 29)
+
+
+def test_add_month_keeps_day_when_it_exists() -> None:
+    assert add_month(date(2026, 12, 15)) == date(2027, 1, 15)
+
+
+def test_add_month_clamps_30_to_february_and_keeps_30_for_april() -> None:
+    assert add_month(date(2026, 3, 30)) == date(2026, 4, 30)
+    assert add_month(date(2026, 1, 30)) == date(2026, 2, 28)
+
+
+def test_add_month_wraps_year_from_december_31() -> None:
+    assert add_month(date(2026, 12, 31)) == date(2027, 1, 31)
+
+
+# --- validation ------------------------------------------------------------
+
+
+@pytest.mark.parametrize("min_count", [1, 0, -1])
+def test_min_count_below_two_raises(min_count: int) -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=min_count)
+
+
+def test_negative_tolerance_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_min_count_two_is_allowed() -> None:
+    rows = [E(date(2026, 1, 5)), E(date(2026, 2, 5))]
+    assert len(find_recurring(rows, min_count=2)) == 1
+
+
+def test_zero_tolerance_is_allowed() -> None:
+    assert find_recurring([]) == []
+    rows = [E(date(2026, 1, 5)), E(date(2026, 2, 5)), E(date(2026, 3, 5))]
+    assert len(find_recurring(rows, tolerance=0)) == 1
+
+
+# --- basic detection --------------------------------------------------------
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+def test_detects_monthly_series_with_next_expected() -> None:
+    rows = [E(date(2026, 1, 5)), E(date(2026, 2, 5)), E(date(2026, 3, 5))]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="通信",
+            amount=1000,
+            days=(date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+            next_expected=date(2026, 4, 5),
+        )
+    ]
+
+
+def test_series_below_min_count_is_dropped() -> None:
+    rows = [E(date(2026, 1, 5)), E(date(2026, 2, 5))]
+    assert find_recurring(rows, min_count=3) == []
+
+
+def test_series_exactly_min_count_is_kept() -> None:
+    rows = [E(date(2026, 1, 5)), E(date(2026, 2, 5)), E(date(2026, 3, 5))]
+    assert len(find_recurring(rows, min_count=3)) == 1
+
+
+def test_single_row_never_recurs_when_min_count_is_two() -> None:
+    assert find_recurring([E(date(2026, 1, 5))], min_count=2) == []
+
+
+def test_input_order_does_not_matter() -> None:
+    rows = [E(date(2026, 3, 5)), E(date(2026, 1, 5)), E(date(2026, 2, 5))]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_memo_is_ignored_for_grouping() -> None:
+    rows = [
+        E(date(2026, 1, 5), memo="a"),
+        E(date(2026, 2, 5), memo="b"),
+        E(date(2026, 3, 5), memo=""),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+# --- grouping ----------------------------------------------------------------
+
+
+def test_different_amount_is_a_different_series() -> None:
+    rows = [
+        E(date(2026, 1, 5), amount=1000),
+        E(date(2026, 2, 5), amount=1000),
+        E(date(2026, 3, 5), amount=1001),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_different_category_is_a_different_series() -> None:
+    rows = [
+        E(date(2026, 1, 5), category="通信"),
+        E(date(2026, 2, 5), category="水道"),
+        E(date(2026, 3, 5), category="通信"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_same_day_duplicates_count_once() -> None:
+    rows = [
+        E(date(2026, 1, 5)),
+        E(date(2026, 1, 5)),
+        E(date(2026, 2, 5)),
+    ]
+    assert find_recurring(rows) == []
+    assert find_recurring(rows, min_count=2)[0].days == (
+        date(2026, 1, 5),
+        date(2026, 2, 5),
+    )
+
+
+def test_same_category_and_amount_mixed_with_others_is_grouped_separately() -> None:
+    rows = [
+        E(date(2026, 1, 5), category="通信", amount=1000),
+        E(date(2026, 1, 9), category="食費", amount=500),
+        E(date(2026, 2, 5), category="通信", amount=1000),
+        E(date(2026, 3, 5), category="通信", amount=1000),
+        E(date(2026, 2, 9), category="食費", amount=500),
+    ]
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [("通信", 1000)]
+
+
+# --- tolerance ---------------------------------------------------------------
+
+
+def test_within_tolerance_links_months() -> None:
+    # 2026-02-08 is 3 days after the expected 2026-02-05 -> linked at tolerance 3
+    rows = [E(date(2026, 1, 5)), E(date(2026, 2, 8)), E(date(2026, 3, 5))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+
+
+def test_beyond_tolerance_breaks_series() -> None:
+    # 2026-02-09 is 4 days after 2026-02-05 -> not linked at tolerance 3
+    rows = [E(date(2026, 1, 5)), E(date(2026, 2, 9)), E(date(2026, 3, 5))]
+    assert find_recurring(rows, tolerance=3) == []
+
+
+def test_tolerance_links_dates_earlier_than_expected() -> None:
+    # 2026-02-02 is 3 days before the expected 2026-02-05 -> linked at tolerance 3
+    rows = [E(date(2026, 1, 5)), E(date(2026, 2, 2)), E(date(2026, 3, 5))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+    assert find_recurring(rows, tolerance=2) == []
+
+
+def test_tolerance_is_measured_from_expected_month_day() -> None:
+    # Jan 31 -> expected Feb 28; Mar 3 is 3 days after Feb 28 -> linked
+    rows = [E(date(2026, 1, 31)), E(date(2026, 3, 3)), E(date(2026, 4, 3))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+
+
+def test_month_end_clamping_participates_in_links() -> None:
+    # 2026-01-31 -> expected 2026-02-28; 2026-02-28 -> expected 2026-03-28
+    rows = [E(date(2026, 1, 31)), E(date(2026, 2, 28)), E(date(2026, 3, 28))]
+    result = find_recurring(rows, tolerance=0)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 28)
+
+
+def test_next_expected_uses_clamped_add_month_of_last_date() -> None:
+    # Feb 28 expected Mar 28; Mar 31 is 3 days later -> linked at tolerance 3
+    rows = [E(date(2026, 1, 31)), E(date(2026, 2, 28)), E(date(2026, 3, 31))]
+    result = find_recurring(rows, tolerance=3)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 30)
+
+
+# --- splitting into chains ---------------------------------------------------
+
+
+def test_gap_splits_into_separate_runs_each_checked_against_min_count() -> None:
+    rows = [
+        E(date(2026, 1, 5)),
+        E(date(2026, 2, 5)),
+        E(date(2026, 3, 5)),
+        # gap: April skipped
+        E(date(2026, 5, 5)),
+        E(date(2026, 6, 5)),
+        E(date(2026, 7, 5)),
+    ]
+    result = find_recurring(rows, min_count=3)
+    assert [r.days[0] for r in result] == [date(2026, 1, 5), date(2026, 5, 5)]
+    assert result[0].next_expected == date(2026, 4, 5)
+    assert result[1].next_expected == date(2026, 8, 5)
+
+
+def test_short_run_on_one_side_of_gap_is_dropped() -> None:
+    rows = [
+        E(date(2026, 1, 5)),
+        E(date(2026, 2, 5)),
+        E(date(2026, 3, 5)),
+        E(date(2026, 6, 5)),
+        E(date(2026, 7, 5)),
+    ]
+    result = find_recurring(rows, min_count=3)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_run_is_maximal_not_a_sliding_window() -> None:
+    # Four consecutive months yield one Recurring with all four days, not two.
+    rows = [E(date(2026, m, 5)) for m in (1, 2, 3, 4)]
+    result = find_recurring(rows, min_count=3)
+    assert len(result) == 1
+    assert len(result[0].days) == 4
+
+
+def test_days_are_ascending() -> None:
+    rows = [E(date(2026, m, 5)) for m in (3, 1, 2)]
+    assert find_recurring(rows)[0].days == (
+        date(2026, 1, 5),
+        date(2026, 2, 5),
+        date(2026, 3, 5),
+    )
+
+
+# --- ordering ----------------------------------------------------------------
+
+
+def test_results_sorted_by_category_then_amount_then_first_day() -> None:
+    rows: list[Expense] = []
+    for amount in (2000, 1000):
+        for m in (1, 2, 3):
+            rows.append(E(date(2026, m, 5), category="通信", amount=amount))
+    for m in (1, 2, 3):
+        rows.append(E(date(2026, m, 1), category="食費", amount=300))
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [
+        ("通信", 1000),
+        ("通信", 2000),
+        ("食費", 300),
+    ]
