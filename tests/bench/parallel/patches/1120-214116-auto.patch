+"""Monthly budget checks: pure functions, no I/O."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Literal
+
+Level = Literal["ok", "warning", "over"]
+
+DEFAULT_WARN_PERCENT = 80
+
+
+@dataclass(frozen=True)
+class BudgetStatus:
+    category: str
+    limit: int  # yen
+    spent: int  # yen
+    level: Level
+
+    @property
+    def remaining(self) -> int:
+        """Yen left; negative when over budget."""
+        return self.limit - self.spent
+
+    @property
+    def percent(self) -> int | None:
+        """Used percentage, rounded down. None when limit is 0."""
+        if self.limit == 0:
+            return None
+        return self.spent * 100 // self.limit
+
+
+def classify(spent: int, limit: int, warn_percent: int = DEFAULT_WARN_PERCENT) -> Level:
+    """over: spent > limit / warning: spent >= warn_percent% of limit / else ok.
+
+    Spending exactly the limit is "warning" (not yet exceeded).
+    Zero spend is always "ok".
+    """
+    if not 0 <= warn_percent <= 100:
+        raise ValueError("warn_percent は 0〜100 である必要があります")
+    if limit < 0:
+        raise ValueError("limit は 0 以上である必要があります")
+    if spent > limit:
+        return "over"
+    if spent > 0 and spent * 100 >= limit * warn_percent:
+        return "warning"
+    return "ok"
+
+
+def check_budget(
+    spent_by_category: dict[str, int],
+    limits: dict[str, int],
+    warn_percent: int = DEFAULT_WARN_PERCENT,
+) -> list[BudgetStatus]:
+    """Status for every category that has a limit (including unspent ones).
+
+    Sorted: over first, then warning, then ok; within a level, by category name.
+    Categories without a limit are ignored.
+    """
+    order = {"over": 0, "warning": 1, "ok": 2}
+    out = [
+        BudgetStatus(cat, limit, spent, classify(spent, limit, warn_percent))
+        for cat, limit in limits.items()
+        for spent in [spent_by_category.get(cat, 0)]
+    ]
+    return sorted(out, key=lambda s: (order[s.level], s.category))
+
+
+def alerts(statuses: list[BudgetStatus]) -> list[BudgetStatus]:
+    """Only the statuses worth notifying (warning or over)."""
+    return [s for s in statuses if s.level != "ok"]
+
+
+def format_alert(s: BudgetStatus) -> str:
+    if s.level == "over":
+        return f"{s.category}: 予算超過 {s.spent:,}円 / {s.limit:,}円({-s.remaining:,}円オーバー)"
+    if s.level == "warning":
+        return f"{s.category}: 予算間近 {s.spent:,}円 / {s.limit:,}円(残り {s.remaining:,}円)"
+    return f"{s.category}: 予算内 {s.spent:,}円 / {s.limit:,}円"
diff --git a/tests/test_budget_status.py b/tests/test_budget_status.py
new file mode 100644
index 0000000..51801ed
--- /dev/null
+++ b/tests/test_budget_status.py
@@ -0,0 +1,74 @@
+import pytest
+
+from kakeibo.budget import (
+    BudgetStatus,
+    alerts,
+    check_budget,
+    classify,
+    format_alert,
+)
+
+
+@pytest.mark.parametrize(
+    ("spent", "limit", "expected"),
+    [
+        (0, 10000, "ok"),
+        (7999, 10000, "ok"),
+        (8000, 10000, "warning"),
+        (10000, 10000, "warning"),  # ちょうど上限は超過ではない
+        (10001, 10000, "over"),
+        (0, 0, "ok"),
+        (1, 0, "over"),
+    ],
+)
+def test_classify(spent, limit, expected):
+    assert classify(spent, limit) == expected
+
+
+def test_classify_custom_threshold():
+    assert classify(5000, 10000, warn_percent=50) == "warning"
+    assert classify(4999, 10000, warn_percent=50) == "ok"
+
+
+def test_classify_invalid_args():
+    with pytest.raises(ValueError):
+        classify(1, 100, warn_percent=101)
+    with pytest.raises(ValueError):
+        classify(1, -1)
+
+
+def test_check_budget_sorted_and_includes_unspent():
+    statuses = check_budget(
+        {"food": 9000, "rent": 80000, "fun": 100, "misc": 5000},
+        {"food": 10000, "rent": 70000, "fun": 5000, "travel": 3000},
+    )
+    assert [(s.category, s.level) for s in statuses] == [
+        ("rent", "over"),
+        ("food", "warning"),
+        ("fun", "ok"),
+        ("travel", "ok"),  # 未使用でも出る。limit の無い misc は出ない
+    ]
+
+
+def test_remaining_and_percent():
+    s = BudgetStatus("food", 10000, 12500, "over")
+    assert s.remaining == -2500
+    assert s.percent == 125
+    assert BudgetStatus("x", 0, 0, "ok").percent is None
+
+
+def test_alerts_excludes_ok():
+    statuses = check_budget({"a": 100, "b": 90, "c": 1}, {"a": 50, "b": 100, "c": 100})
+    assert [s.category for s in alerts(statuses)] == ["a", "b"]
+
+
+def test_format_alert():
+    assert format_alert(BudgetStatus("food", 10000, 12500, "over")) == (
+        "food: 予算超過 12,500円 / 10,000円(2,500円オーバー)"
+    )
+    assert format_alert(BudgetStatus("food", 10000, 9000, "warning")) == (
+        "food: 予算間近 9,000円 / 10,000円(残り 1,000円)"
+    )
+    assert format_alert(BudgetStatus("food", 10000, 100, "ok")) == (
+        "food: 予算内 100円 / 10,000円"
+    )
