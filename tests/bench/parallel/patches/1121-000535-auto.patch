+"""Monthly per-category budget alerts (pure functions).
+
+Decisions:
+D1: 超過は spent > limit。spent == limit ちょうどは「超えていない」ので warning。
+D2: warning は spent * 100 >= limit * warn_percent(既定 80)。整数演算のみ(浮動小数を使わない)。
+D3: limit が 0 のとき、spent が 0 なら ok、1 円でも使えば over。
+D4: 返金(負の金額)は合計に含める。合計が負でも ok(remaining は limit を超えうる)。
+D5: 予算の無いカテゴリは報告しない。予算があって支出の無いカテゴリは spent=0 の ok で報告する。
+D6: limit は 0 以上の int(bool 不可)。warn_percent は 0..100 の int。違反は ValueError。
+D7: 月は "YYYY-MM"(月 01..12)のみ。不正は ValueError。月の端は暦月で、1 日と末日を含む。
+D8: 並びは重大度(over → warning → ok)、同じ重大度ではカテゴリ名の昇順。
+D9: カテゴリ名は完全一致(正規化しない)。予算が空なら空リスト。
+"""
+
+from __future__ import annotations
+
+import re
+from collections.abc import Iterable
+from dataclasses import dataclass
+from typing import Literal
+
+from .core import Expense
+
+Status = Literal["over", "warning", "ok"]
+
+DEFAULT_WARN_PERCENT = 80
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+_SEVERITY: dict[str, int] = {"over": 0, "warning": 1, "ok": 2}
+
+
+@dataclass(frozen=True)
+class BudgetStatus:
+    category: str
+    limit: int
+    spent: int
+    status: Status
+
+    @property
+    def remaining(self) -> int:
+        """limit - spent(超過なら負)。"""
+        return self.limit - self.spent
+
+
+def classify(
+    spent: int, limit: int, warn_percent: int = DEFAULT_WARN_PERCENT
+) -> Status:
+    _check_limit("limit", limit)
+    _check_percent(warn_percent)
+    if spent > limit:
+        return "over"
+    if spent <= 0:
+        return "ok"
+    if spent * 100 >= limit * warn_percent:
+        return "warning"
+    return "ok"
+
+
+def spent_in_month(rows: Iterable[Expense], month: str) -> dict[str, int]:
+    """{category: yen} for expenses dated in `month` (YYYY-MM)."""
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+    out: dict[str, int] = {}
+    for e in rows:
+        if e.day.strftime("%Y-%m") == month:
+            out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def evaluate(
+    spent: dict[str, int],
+    budgets: dict[str, int],
+    warn_percent: int = DEFAULT_WARN_PERCENT,
+) -> list[BudgetStatus]:
+    _check_percent(warn_percent)
+    for cat, limit in budgets.items():
+        _check_limit(f"budgets[{cat!r}]", limit)
+    result = [
+        BudgetStatus(
+            cat,
+            limit,
+            spent.get(cat, 0),
+            classify(spent.get(cat, 0), limit, warn_percent),
+        )
+        for cat, limit in budgets.items()
+    ]
+    return sorted(result, key=lambda s: (_SEVERITY[s.status], s.category))
+
+
+def evaluate_month(
+    rows: Iterable[Expense],
+    budgets: dict[str, int],
+    month: str,
+    warn_percent: int = DEFAULT_WARN_PERCENT,
+) -> list[BudgetStatus]:
+    return evaluate(spent_in_month(rows, month), budgets, warn_percent)
+
+
+def alerts(statuses: Iterable[BudgetStatus]) -> list[BudgetStatus]:
+    """over / warning のみ。"""
+    return [s for s in statuses if s.status != "ok"]
+
+
+def _check_limit(name: str, limit: object) -> None:
+    if isinstance(limit, bool) or not isinstance(limit, int) or limit < 0:
+        raise ValueError(f"{name} は 0 以上の整数である必要があります: {limit!r}")
+
+
+def _check_percent(p: object) -> None:
+    if isinstance(p, bool) or not isinstance(p, int) or not 0 <= p <= 100:
+        raise ValueError(f"warn_percent は 0〜100 の整数である必要があります: {p!r}")
diff --git a/tests/test_budget_alert.py b/tests/test_budget_alert.py
new file mode 100644
index 0000000..2ef78a0
--- /dev/null
+++ b/tests/test_budget_alert.py
@@ -0,0 +1,103 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.budget_alert import (
+    BudgetStatus,
+    alerts,
+    classify,
+    evaluate,
+    evaluate_month,
+    spent_in_month,
+)
+from kakeibo.core import Expense
+
+
+def test_d1_exactly_at_limit_is_warning_not_over():
+    assert classify(10000, 10000) == "warning"
+    assert classify(10001, 10000) == "over"
+
+
+def test_d2_warning_threshold_integer_boundary():
+    assert classify(7999, 10000) == "ok"
+    assert classify(8000, 10000) == "warning"
+    assert classify(50, 100, warn_percent=50) == "warning"
+    assert classify(49, 100, warn_percent=50) == "ok"
+
+
+def test_d3_zero_limit():
+    assert classify(0, 0) == "ok"
+    assert classify(1, 0) == "over"
+
+
+def test_d4_refunds_net_out():
+    rows = [
+        Expense(date(2026, 1, 5), "食費", 5000),
+        Expense(date(2026, 1, 6), "食費", -7000),
+    ]
+    r = evaluate_month(rows, {"食費": 1000}, "2026-01")
+    assert r == [BudgetStatus("食費", 1000, -2000, "ok")]
+    assert r[0].remaining == 3000
+
+
+def test_d5_unbudgeted_skipped_and_unspent_reported():
+    r = evaluate({"食費": 500, "娯楽": 9999}, {"食費": 1000, "交通": 300})
+    assert [(s.category, s.spent, s.status) for s in r] == [
+        ("交通", 0, "ok"),
+        ("食費", 500, "ok"),
+    ]
+
+
+def test_d6_invalid_inputs():
+    with pytest.raises(ValueError):
+        evaluate({}, {"食費": -1})
+    with pytest.raises(ValueError):
+        evaluate({}, {"食費": True})
+    with pytest.raises(ValueError):
+        evaluate({}, {"食費": 1.5})  # type: ignore[dict-item]
+    with pytest.raises(ValueError):
+        classify(1, 10, warn_percent=101)
+    with pytest.raises(ValueError):
+        evaluate({}, {}, warn_percent=-1)
+
+
+@pytest.mark.parametrize("bad", ["2026-13", "2026-1", "2026/01", "", "2026-00"])
+def test_d7_bad_month(bad):
+    with pytest.raises(ValueError):
+        spent_in_month([], bad)
+
+
+def test_d7_month_boundaries_inclusive():
+    rows = [
+        Expense(date(2026, 1, 31), "食費", 100),
+        Expense(date(2026, 2, 1), "食費", 200),
+        Expense(date(2026, 2, 28), "食費", 300),
+        Expense(date(2026, 3, 1), "食費", 400),
+    ]
+    assert spent_in_month(rows, "2026-02") == {"食費": 500}
+
+
+def test_d8_ordering():
+    r = evaluate(
+        {"b": 200, "a": 200, "c": 90, "d": 10, "e": 100},
+        {"b": 100, "a": 100, "c": 100, "d": 100, "e": 100},
+    )
+    assert [(s.category, s.status) for s in r] == [
+        ("a", "over"),
+        ("b", "over"),
+        ("c", "warning"),
+        ("e", "warning"),
+        ("d", "ok"),
+    ]
+
+
+def test_d9_empty_and_exact_match():
+    assert evaluate({"食費": 1}, {}) == []
+    r = evaluate({"食費 ": 5000}, {"食費": 1000})
+    assert r == [BudgetStatus("食費", 1000, 0, "ok")]
+
+
+def test_alerts_filters_ok():
+    r = evaluate({"a": 150, "b": 90, "c": 1}, {"a": 100, "b": 100, "c": 100})
+    assert [s.category for s in alerts(r)] == ["a", "b"]
+    assert alerts([]) == []
