index 0000000..56c8b71
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,122 @@
+"""Filter expenses with composable, data-only queries (no callables)."""
+
+from __future__ import annotations
+
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+from typing import cast
+
+from kakeibo.core import Expense
+
+# D5: 型違い・範囲違いも含め、不正な引数はすべて ValueError にする(TypeError にしない)。
+
+
+def _norm(text: str) -> str:
+    """D4: NFKC normalisation, then case-insensitive (casefold)."""
+    return unicodedata.normalize("NFKC", text).casefold()
+
+
+def _check_int_or_none(value: object, name: str) -> None:
+    if value is None:
+        return
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise ValueError(f"{name} は int か None である必要があります: {value!r}")  # noqa: TRY004
+
+
+def _check_date_or_none(value: object, name: str) -> None:
+    if value is None:
+        return
+    if not isinstance(value, date):
+        raise ValueError(f"{name} は date か None である必要があります: {value!r}")  # noqa: TRY004
+
+
+@dataclass(frozen=True)
+class Query:
+    """A condition tree. `op` selects the rule; `args`/`children` carry its data."""
+
+    op: str
+    args: tuple[object, ...] = ()
+    children: tuple[Query, ...] = ()
+
+    def matches(self, e: Expense) -> bool:
+        if self.op == "category":
+            return _norm(e.category) == self.args[0]
+        if self.op == "amount":
+            low = cast(int | None, self.args[0])
+            high = cast(int | None, self.args[1])
+            return (low is None or e.amount >= low) and (
+                high is None or e.amount <= high
+            )
+        if self.op == "memo":
+            return cast(str, self.args[0]) in _norm(e.memo)
+        if self.op == "date":
+            start = cast(date | None, self.args[0])
+            end = cast(date | None, self.args[1])
+            return (start is None or e.day >= start) and (end is None or e.day <= end)
+        if self.op == "and":
+            return all(c.matches(e) for c in self.children)
+        if self.op == "or":
+            return any(c.matches(e) for c in self.children)
+        if self.op == "not":
+            return not self.children[0].matches(e)
+        raise ValueError(f"不明な条件です: {self.op!r}")
+
+
+def category(name: str) -> Query:
+    if not isinstance(name, str):
+        raise ValueError(f"category は str である必要があります: {name!r}")  # noqa: TRY004
+    norm = _norm(name)
+    if not norm:
+        raise ValueError("category に空文字は使えません")
+    return Query("category", (norm,))
+
+
+def amount_between(low: int | None, high: int | None) -> Query:
+    _check_int_or_none(low, "low")
+    _check_int_or_none(high, "high")
+    if low is not None and high is not None and low > high:
+        raise ValueError(f"下限 {low} が上限 {high} より大きいです")
+    return Query("amount", (low, high))
+
+
+def memo_contains(text: str) -> Query:
+    if not isinstance(text, str):
+        raise ValueError(f"memo_contains は str である必要があります: {text!r}")  # noqa: TRY004
+    norm = _norm(text)
+    if not norm:
+        raise ValueError("memo_contains に空文字は使えません")
+    return Query("memo", (norm,))
+
+
+def between_dates(start: date | None, end: date | None) -> Query:
+    _check_date_or_none(start, "start")
+    _check_date_or_none(end, "end")
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"開始 {start} が終了 {end} より後です")
+    return Query("date", (start, end))
+
+
+def _children(qs: tuple[object, ...]) -> tuple[Query, ...]:
+    for q in qs:
+        if not isinstance(q, Query):
+            raise ValueError(f"条件は Query である必要があります: {q!r}")  # noqa: TRY004
+    return cast(tuple[Query, ...], qs)
+
+
+def and_(*qs: Query) -> Query:
+    return Query("and", (), _children(qs))
+
+
+def or_(*qs: Query) -> Query:
+    return Query("or", (), _children(qs))
+
+
+def not_(q: Query) -> Query:
+    return Query("not", (), _children((q,)))
+
+
+def search(rows: list[Expense], query: Query) -> list[Expense]:
+    if not isinstance(query, Query):
+        raise ValueError(f"query は Query である必要があります: {query!r}")  # noqa: TRY004
+    return [e for e in rows if query.matches(e)]
