@@ -0,0 +1,101 @@
+"""Detect monthly recurring expenses (pure functions, standard library only)."""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int
+    months: int
+    last: date
+    next_expected: date
+
+
+_TRAILING_RE = re.compile(r"[0-9#]+$")
+_SPACE_RE = re.compile(r"\s+")
+
+
+def _norm(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).casefold()
+
+
+def _series_key(e: Expense) -> tuple[str, str]:
+    memo = _SPACE_RE.sub("", _norm(e.memo))
+    memo = _TRAILING_RE.sub("", memo)
+    return (_norm(e.category), memo)
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month - 1
+
+
+def _detect(group: list[Expense], min_months: int) -> Recurring | None:
+    # 同じ月は 1 回とみなし、その月の最後の日付の行を代表にする。
+    per_month: dict[int, Expense] = {}
+    for e in sorted(group, key=lambda e: e.day):
+        per_month[_month_index(e.day)] = e
+
+    # 最新の月から遡って、欠けずに続く最後の並びを取る。
+    months = sorted(per_month)
+    run = [months[-1]]
+    for m in reversed(months[:-1]):
+        if m != run[-1] - 1:
+            break
+        run.append(m)
+    if len(run) < min_months:
+        return None
+
+    reps = [per_month[m] for m in reversed(run)]  # 古い順
+    latest = reps[-1]
+
+    # 金額の揺れは最新の金額の 10 % 以内(整数で比べる)。
+    amounts = [e.amount for e in reps]
+    if (max(amounts) - min(amounts)) * 10 > latest.amount:
+        return None
+
+    base_day = max(e.day.day for e in reps)
+    next_year, rem = divmod(_month_index(latest.day) + 1, 12)
+    next_month = rem + 1
+    last_day = calendar.monthrange(next_year, next_month)[1]
+    return Recurring(
+        category=latest.category,
+        memo=latest.memo,
+        amount=latest.amount,
+        months=len(run),
+        last=latest.day,
+        next_expected=date(next_year, next_month, min(base_day, last_day)),
+    )
+
+
+def find_recurring(rows: list[Expense], min_months: int = 3) -> list[Recurring]:
+    if (
+        isinstance(min_months, bool)
+        or not isinstance(min_months, int)
+        or min_months < 2
+    ):
+        raise ValueError(
+            f"min_months={min_months!r} は 2 以上の整数である必要があります"
+        )
+
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        if e.amount > 0:  # 返金・入金(負)は支出ではないので対象外
+            groups.setdefault(_series_key(e), []).append(e)
+
+    found: list[Recurring] = []
+    for group in groups.values():
+        rec = _detect(group, min_months)
+        if rec is not None:
+            found.append(rec)
+    found.sort(key=lambda r: (r.next_expected, -r.amount, r.memo))
+    return found
