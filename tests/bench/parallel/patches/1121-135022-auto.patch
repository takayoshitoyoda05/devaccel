+from datetime import date
+
+import pytest
+
+from kakeibo.core import CsvError, Expense
+from kakeibo.importer import parse_bank_csv
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (
+            '利用日,ご利用店名,利用金額\n2026/1/5,ＮＥＴＦＬＩＸ,"1,490円"',
+            [Expense(date(2026, 1, 5), "未分類", 1490, "NETFLIX")],
+        ),
+        (
+            "日付,出金,入金\n2026-01-05,,3000\n2026-01-06,0,0",
+            [Expense(date(2026, 1, 5), "未分類", -3000, "")],
+        ),
+    ],
+    ids=["E1-1", "E1-2"],
+)
+def test_examples(text: str, expected: list[Expense]) -> None:
+    assert parse_bank_csv(text) == expected
+
+
+def test_E1_3() -> None:
+    with pytest.raises(CsvError) as ei:
+        parse_bank_csv("date,amount\n2026-02-30,12.5")
+    errs = ei.value.errors
+    assert len(errs) == 2
+    assert all(n == 2 for n, _ in errs)
+    assert errs[0][1].startswith("date:")
+    assert errs[1][1].startswith("amount:")
+
+
+@pytest.mark.parametrize(
+    "raw",
+    ["1234", "1,234", "¥1,234", "￥1,234", "1,234円", "JPY 1,234", "１，２３４"],
+)
+def test_amount_forms(raw: str) -> None:
+    r = parse_bank_csv(f'date,amount\n2026-01-05,"{raw}"')
+    assert r[0].amount == 1234
+
+
+@pytest.mark.parametrize("raw", ["-300", "−300", "△300", "▲300", "(300)", "300-"])
+def test_negative_forms(raw: str) -> None:
+    assert parse_bank_csv(f"date,amount\n2026-01-05,{raw}")[0].amount == -300
+
+
+@pytest.mark.parametrize("raw", ["", "-", "—", "abc", "12.5"])
+def test_bad_amount(raw: str) -> None:
+    with pytest.raises(CsvError):
+        parse_bank_csv(f"date,amount\n2026-01-05,{raw}")
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026.1.5",
+        "20260105",
+        "2026年1月5日",
+        "2026-01-05 12:34",
+    ],
+)
+def test_date_forms(raw: str) -> None:
+    assert parse_bank_csv(f"date,amount\n{raw},1")[0].day == date(2026, 1, 5)
+
+
+@pytest.mark.parametrize("raw", ["1/5", "令和8年1月5日", "2026-02-30"])
+def test_bad_date(raw: str) -> None:
+    with pytest.raises(CsvError):
+        parse_bank_csv(f"date,amount\n{raw},1")
+
+
+def test_bom_tab_crlf_blank_and_quotes() -> None:
+    t = '﻿日付\t金額\t摘要\r\n2026-01-05\t100\t"a\nb"\r\n\r\n2026-01-06\t200\t x \r\n'
+    r = parse_bank_csv(t)
+    assert [e.memo for e in r] == ["a\nb", "x"]
+
+
+def test_line_number_after_multiline_quote() -> None:
+    with pytest.raises(CsvError) as ei:
+        parse_bank_csv('date,amount,memo\n2026-01-05,1,"a\nb"\n2026-01-06,x,m')
+    assert ei.value.errors[0][0] == 4
+
+
+def test_column_count() -> None:
+    with pytest.raises(CsvError) as ei:
+        parse_bank_csv("date,amount\n2026-01-05,1,490円")
+    assert ei.value.errors == [(2, "列数が不正です(期待 2、実際 3)")]
+
+
+def test_header_missing() -> None:
+    with pytest.raises(CsvError) as ei:
+        parse_bank_csv("amount\n1")
+    assert ei.value.errors == [(1, "日付列が見つかりません: 日付")]
+
+
+def test_both_values_error() -> None:
+    with pytest.raises(CsvError):
+        parse_bank_csv("日付,出金,入金\n2026-01-05,1,2")
+
+
+def test_empty_and_type() -> None:
+    assert parse_bank_csv("") == []
+    assert parse_bank_csv("  \n ") == []
+    assert parse_bank_csv("date,amount\n") == []
+    with pytest.raises(ValueError):
+        parse_bank_csv(None)  # type: ignore[arg-type]
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..9fca511
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,184 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring
+
+
+def ex(
+    y: int, m: int, d: int, amount: int, category: str = "家賃", memo: str = ""
+) -> Expense:
+    return Expense(day=date(y, m, d), category=category, amount=amount, memo=memo)
+
+
+# --- 例の表(E2-x) ---------------------------------------------------------
+
+
+def test_E2_1_rent_end_of_month_rolls_to_30() -> None:
+    rows = [
+        ex(2026, 1, 31, 80000, memo="家賃"),
+        ex(2026, 2, 28, 80000, memo="家賃"),
+        ex(2026, 3, 31, 80000, memo="家賃"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 30)
+
+
+def test_E2_2_same_category_and_amount_different_memo_splits() -> None:
+    rows: list[Expense] = []
+    for m in (1, 2, 3):
+        rows.append(ex(2026, m, 5, 3000, category="通信", memo="電気"))
+        rows.append(ex(2026, m, 20, 3000, category="通信", memo="ガス"))
+    result = find_recurring(rows)
+    assert len(result) == 2
+    assert {r.memo for r in result} == {"電気", "ガス"}
+
+
+def test_E2_3_gap_in_months_leaves_only_last_run() -> None:
+    rows = [
+        ex(2026, 1, 10, 1500, category="動画", memo="Netflix"),
+        ex(2026, 2, 10, 1500, category="動画", memo="Netflix"),
+        ex(2026, 4, 10, 1500, category="動画", memo="Netflix"),
+    ]
+    assert find_recurring(rows) == []
+
+
+# --- 規則 R1〜R6 -----------------------------------------------------------
+
+
+def test_R1_non_positive_amounts_are_ignored() -> None:
+    rows = [
+        ex(2026, 1, 1, -80000, memo="家賃"),
+        ex(2026, 2, 1, -80000, memo="家賃"),
+        ex(2026, 3, 1, -80000, memo="家賃"),
+        ex(2026, 1, 2, 0, memo="家賃"),
+    ]
+    assert find_recurring(rows) == []
+
+
+@pytest.mark.parametrize(
+    "memos",
+    [
+        pytest.param(("Netflix 2", "netflix#3", "ＮＥＴＦＬＩＸ"), id="R1-normalize"),
+    ],
+)
+def test_R1_memo_normalization_groups_same_series(memos: tuple[str, ...]) -> None:
+    rows = [
+        ex(2026, m, 1, 1500, category="動画", memo=memo)
+        for m, memo in zip((1, 2, 3), memos)
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].months == 3
+
+
+def test_R1_empty_memo_is_one_series_per_category() -> None:
+    rows = [
+        ex(2026, 1, 1, 500, category="水道", memo=""),
+        ex(2026, 2, 1, 500, category="水道", memo=""),
+        ex(2026, 3, 1, 500, category="水道", memo=""),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].memo == ""
+
+
+def test_R2_same_month_counts_once_using_last_date() -> None:
+    rows = [
+        ex(2026, 1, 3, 500, category="水道"),
+        ex(2026, 1, 25, 500, category="水道"),
+        ex(2026, 2, 1, 500, category="水道"),
+    ]
+    result = find_recurring(rows, min_months=2)
+    assert len(result) == 1
+    assert result[0].months == 2
+    assert result[0].last == date(2026, 2, 1)
+
+
+def test_R2_counts_only_last_consecutive_run() -> None:
+    rows = [ex(2026, m, 1, 500, category="水道") for m in (1, 2, 3, 5, 6, 7, 8)]
+    result = find_recurring(rows, min_months=3)
+    assert len(result) == 1
+    assert result[0].months == 4
+    assert result[0].next_expected == date(2026, 9, 1)
+
+
+def test_R2_bimonthly_is_not_recurring() -> None:
+    rows = [ex(2026, m, 1, 500, category="水道") for m in (1, 3, 5, 7)]
+    assert find_recurring(rows) == []
+
+
+def test_R3_small_variation_is_same_series() -> None:
+    rows = [
+        ex(2026, 1, 1, 10000, category="電気"),
+        ex(2026, 2, 1, 10000, category="電気"),
+        ex(2026, 3, 1, 11000, category="電気"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].amount == 11000
+
+
+def test_R3_large_variation_drops_series() -> None:
+    rows = [
+        ex(2026, 1, 1, 8000, category="電気"),
+        ex(2026, 2, 1, 8000, category="電気"),
+        ex(2026, 3, 1, 10000, category="電気"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_R4_december_rolls_to_next_year() -> None:
+    rows = [ex(2026, m, 15, 1000, category="保険") for m in (10, 11, 12)]
+    result = find_recurring(rows)
+    assert result[0].next_expected == date(2027, 1, 15)
+
+
+def test_R4_base_day_is_max_day_of_series() -> None:
+    rows = [
+        ex(2026, 1, 10, 1000, category="保険"),
+        ex(2026, 2, 10, 1000, category="保険"),
+        ex(2026, 3, 20, 1000, category="保険"),
+    ]
+    result = find_recurring(rows)
+    assert result[0].next_expected == date(2026, 4, 20)
+
+
+def test_R5_sorted_by_next_expected_then_amount_desc_then_memo() -> None:
+    rows: list[Expense] = []
+    for m in (1, 2, 3):
+        rows.append(ex(2026, m, 1, 1000, category="A", memo="b"))
+        rows.append(ex(2026, m, 1, 2000, category="B", memo="z"))
+        rows.append(ex(2026, m, 1, 1000, category="C", memo="a"))
+        rows.append(ex(2026, m, 1, 1000, category="D", memo="c"))
+    result = find_recurring(rows)
+    # 次回予定日は全て同じ(4/1)。金額の降順、同額は memo の昇順。
+    assert [r.next_expected for r in result] == [date(2026, 4, 1)] * 4
+    assert [r.category for r in result] == ["B", "C", "A", "D"]
+
+
+@pytest.mark.parametrize("bad", [1.5, "3", None, True, False, 1, 0, -1])
+def test_R6_invalid_min_months_raises(bad: object) -> None:
+    with pytest.raises(ValueError, match="min_months"):
+        find_recurring([], min_months=bad)  # type: ignore[arg-type]
+
+
+def test_R6_empty_rows_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+def test_R6_input_is_not_mutated() -> None:
+    rows = [ex(2026, m, 1, 500, category="水道") for m in (1, 2, 3)]
+    snapshot = list(rows)
+    find_recurring(rows)
+    assert rows == snapshot
+
+
+def test_returns_recurring_instances() -> None:
+    rows = [ex(2026, m, 1, 500, category="水道") for m in (1, 2, 3)]
+    result = find_recurring(rows)
+    assert isinstance(result[0], Recurring)
diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..50d81f9
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,263 @@
+"""Tests for kakeibo.search (rule R1-R4 and examples E3-1..E3-3)."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    Query,
+    amount_between,
+    and_,
+    between_dates,
+    category,
+    memo_contains,
+    not_,
+    or_,
+    search,
+)
+
+
+def row(
+    day: str = "2026-01-15", cat: str = "food", amount: int = 100, memo: str = ""
+) -> Expense:
+    return Expense(date.fromisoformat(day), cat, amount, memo)
+
+
+# --- 例の表 (E3-1..E3-3) ---
+
+
+@pytest.mark.parametrize(
+    ("query", "rows", "expected"),
+    [
+        pytest.param(
+            amount_between(100, 100),
+            [row(amount=100)],
+            [row(amount=100)],
+            id="E3-1",
+        ),
+        pytest.param(
+            memo_contains("ＮＥＴ"),
+            [row(memo="netflix")],
+            [row(memo="netflix")],
+            id="E3-2",
+        ),
+        pytest.param(
+            or_(),
+            [row(), row(cat="rent")],
+            [],
+            id="E3-3",
+        ),
+    ],
+)
+def test_spec_examples(
+    query: Query, rows: list[Expense], expected: list[Expense]
+) -> None:
+    assert search(rows, query) == expected
+
+
+# --- R1 条件の部品 ---
+
+
+def test_amount_between_is_inclusive_on_both_ends() -> None:
+    rows = [row(amount=99), row(amount=100), row(amount=200), row(amount=201)]
+    assert search(rows, amount_between(100, 200)) == [row(amount=100), row(amount=200)]
+
+
+def test_amount_between_none_low_is_unbounded_below() -> None:
+    rows = [row(amount=-5000), row(amount=100), row(amount=101)]
+    assert search(rows, amount_between(None, 100)) == [
+        row(amount=-5000),
+        row(amount=100),
+    ]
+
+
+def test_amount_between_none_high_is_unbounded_above() -> None:
+    rows = [row(amount=99), row(amount=100), row(amount=1_000_000)]
+    assert search(rows, amount_between(100, None)) == [
+        row(amount=100),
+        row(amount=1_000_000),
+    ]
+
+
+def test_amount_between_none_none_matches_everything() -> None:
+    rows = [row(amount=-1), row(amount=0), row(amount=9)]
+    assert search(rows, amount_between(None, None)) == rows
+
+
+def test_category_is_exact_match_not_substring() -> None:
+    rows = [row(cat="food"), row(cat="food delivery")]
+    assert search(rows, category("food")) == [row(cat="food")]
+
+
+def test_category_ignores_case_and_nfkc() -> None:
+    rows = [row(cat="ＦＯＯＤ"), row(cat="Rent")]
+    assert search(rows, category("food")) == [row(cat="ＦＯＯＤ")]
+    assert search(rows, category("rent")) == [row(cat="Rent")]
+
+
+def test_memo_contains_is_partial_match() -> None:
+    rows = [row(memo="netflix plan"), row(memo="spotify")]
+    assert search(rows, memo_contains("flix")) == [row(memo="netflix plan")]
+
+
+def test_memo_contains_ignores_case() -> None:
+    rows = [row(memo="NetFlix")]
+    assert search(rows, memo_contains("netflix")) == rows
+
+
+def test_between_dates_is_inclusive_on_both_ends() -> None:
+    rows = [
+        row(day="2026-01-31"),
+        row(day="2026-02-01"),
+        row(day="2026-02-28"),
+        row(day="2026-03-01"),
+    ]
+    got = search(rows, between_dates(date(2026, 2, 1), date(2026, 2, 28)))
+    assert got == [row(day="2026-02-01"), row(day="2026-02-28")]
+
+
+def test_between_dates_none_start_is_unbounded() -> None:
+    rows = [row(day="2000-01-01"), row(day="2026-06-01")]
+    assert search(rows, between_dates(None, date(2026, 1, 1))) == [
+        row(day="2000-01-01")
+    ]
+
+
+def test_between_dates_none_end_is_unbounded() -> None:
+    rows = [row(day="2000-01-01"), row(day="2026-06-01")]
+    assert search(rows, between_dates(date(2026, 1, 1), None)) == [
+        row(day="2026-06-01")
+    ]
+
+
+def test_between_dates_none_none_matches_everything() -> None:
+    rows = [row(day="2000-01-01"), row(day="2026-06-01")]
+    assert search(rows, between_dates(None, None)) == rows
+
+
+# --- R2 組み合わせ ---
+
+
+def test_and_requires_all_conditions() -> None:
+    rows = [
+        row(cat="food", amount=500),
+        row(cat="food", amount=50),
+        row(cat="rent", amount=500),
+    ]
+    q = and_(category("food"), amount_between(100, None))
+    assert search(rows, q) == [row(cat="food", amount=500)]
+
+
+def test_and_with_no_arguments_is_always_true() -> None:
+    rows = [row(), row(cat="rent")]
+    assert search(rows, and_()) == rows
+
+
+def test_or_matches_any_condition() -> None:
+    rows = [row(cat="food"), row(cat="rent"), row(cat="fun")]
+    q = or_(category("food"), category("rent"))
+    assert search(rows, q) == [row(cat="food"), row(cat="rent")]
+
+
+def test_or_with_no_arguments_matches_nothing() -> None:
+    assert search([row(), row()], or_()) == []
+
+
+def test_not_inverts_condition() -> None:
+    rows = [row(cat="food"), row(cat="rent")]
+    assert search(rows, not_(category("food"))) == [row(cat="rent")]
+
+
+def test_nested_combinations() -> None:
+    rows = [
+        row(cat="food", amount=500),
+        row(cat="rent", amount=500),
+        row(cat="food", amount=10),
+    ]
+    q = and_(or_(category("food"), category("rent")), not_(amount_between(None, 100)))
+    assert search(rows, q) == [row(cat="food", amount=500), row(cat="rent", amount=500)]
+
+
+def test_query_matches_single_expense() -> None:
+    assert and_(category("food")).matches(row(cat="FOOD"))
+    assert not not_(category("food")).matches(row(cat="food"))
+
+
+# --- R3 結果の順序・重複・入力不変 ---
+
+
+def test_result_keeps_input_order_and_duplicates() -> None:
+    a = row(cat="food", amount=1)
+    b = row(cat="rent", amount=2)
+    rows = [b, a, a, b, a]
+    assert search(rows, category("food")) == [a, a, a]
+    assert search(rows, or_(category("food"), category("rent"))) == rows
+
+
+def test_search_does_not_mutate_input() -> None:
+    rows = [row(cat="food"), row(cat="rent")]
+    snapshot = list(rows)
+    search(rows, category("food"))
+    assert rows == snapshot
+
+
+def test_search_empty_rows_returns_empty_list() -> None:
+    assert search([], category("food")) == []
+
+
+# --- R4 不正な引数 ---
+
+
+@pytest.mark.parametrize("bad", [True, False, 1.0, "100"])
+def test_amount_between_rejects_non_int(bad: object) -> None:
+    with pytest.raises(ValueError):
+        amount_between(bad, None)  # type: ignore[arg-type]
+    with pytest.raises(ValueError):
+        amount_between(None, bad)  # type: ignore[arg-type]
+
+
+def test_amount_between_rejects_low_greater_than_high() -> None:
+    with pytest.raises(ValueError):
+        amount_between(101, 100)
+
+
+def test_between_dates_rejects_start_after_end() -> None:
+    with pytest.raises(ValueError):
+        between_dates(date(2026, 2, 2), date(2026, 2, 1))
+
+
+@pytest.mark.parametrize("bad", ["2026-01-01", 20260101])
+def test_between_dates_rejects_non_date(bad: object) -> None:
+    with pytest.raises(ValueError):
+        between_dates(bad, None)  # type: ignore[arg-type]
+
+
+def test_memo_contains_rejects_empty_string() -> None:
+    with pytest.raises(ValueError):
+        memo_contains("")
+
+
+def test_category_rejects_empty_string() -> None:
+    with pytest.raises(ValueError):
+        category("")
+
+
+@pytest.mark.parametrize(
+    "combinator",
+    [and_, or_, not_],
+)
+def test_combinators_reject_non_query(combinator: object) -> None:
+    with pytest.raises(ValueError):
+        combinator("food")  # type: ignore[operator]
+    with pytest.raises(ValueError):
+        combinator(None)  # type: ignore[operator]
+
+
+def test_search_rejects_non_query() -> None:
+    with pytest.raises(ValueError):
+        search([row()], "food")  # type: ignore[arg-type]
+    with pytest.raises(ValueError):
+        search([row()], None)  # type: ignore[arg-type]
diff --git a/tests/test_trend.py b/tests/test_trend.py
new file mode 100644
index 0000000..e39dd5f
--- /dev/null
+++ b/tests/test_trend.py
@@ -0,0 +1,158 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.trend import CategoryChange, format_report, month_over_month
+
+
+def ex(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+# 受け入れ条件の例表 (E4-*) をそのまま写す
+@pytest.mark.parametrize(
+    ("rows", "month", "expected"),
+    [
+        pytest.param(
+            [ex("2026-01-10", "食費", 3000), ex("2026-02-10", "食費", 4500)],
+            "2026-02",
+            [CategoryChange("食費", 3000, 4500, 1500, 50.0, "増加")],
+            id="E4-1",
+        ),
+        pytest.param(
+            [ex("2025-12-05", "交通", 1000)],
+            "2026-01",
+            [CategoryChange("交通", 1000, 0, -1000, -100.0, "なくなった")],
+            id="E4-2",
+        ),
+        pytest.param(
+            [ex("2026-02-03", "光熱費", 500)],
+            "2026-02",
+            [CategoryChange("光熱費", 0, 500, 500, None, "新規")],
+            id="E4-3",
+        ),
+    ],
+)
+def test_example_table(rows, month, expected):
+    assert month_over_month(rows, month) == expected
+
+
+# 端のケース (仕様文面から)
+def test_empty_rows_returns_empty_list():
+    assert month_over_month([], "2026-02") == []
+
+
+def test_both_months_absent_returns_empty_list():
+    rows = [ex("2025-06-01", "食費", 100)]
+    assert month_over_month(rows, "2026-02") == []
+
+
+def test_both_months_zero_category_is_omitted():
+    rows = [ex("2026-01-01", "食費", 100), ex("2026-01-02", "食費", -100)]
+    assert month_over_month(rows, "2026-02") == []
+
+
+def test_no_change_status_and_zero_pct():
+    rows = [ex("2026-01-01", "食費", 1000), ex("2026-02-01", "食費", 1000)]
+    assert month_over_month(rows, "2026-02") == [
+        CategoryChange("食費", 1000, 1000, 0, 0.0, "変化なし")
+    ]
+
+
+def test_decrease_status_and_pct():
+    rows = [ex("2026-01-01", "食費", 4000), ex("2026-02-01", "食費", 3000)]
+    assert month_over_month(rows, "2026-02") == [
+        CategoryChange("食費", 4000, 3000, -1000, -25.0, "減少")
+    ]
+
+
+def test_refunds_are_summed_not_filtered():
+    rows = [ex("2026-01-01", "食費", 1000), ex("2026-01-02", "食費", -200)]
+    rows.append(ex("2026-02-01", "食費", 800))
+    assert month_over_month(rows, "2026-02") == [
+        CategoryChange("食費", 800, 800, 0, 0.0, "変化なし")
+    ]
+
+
+def test_other_months_are_ignored():
+    rows = [
+        ex("2025-12-31", "食費", 100),
+        ex("2026-01-31", "食費", 200),
+        ex("2026-02-01", "食費", 300),
+        ex("2026-03-01", "食費", 9999),
+    ]
+    assert month_over_month(rows, "2026-02") == [
+        CategoryChange("食費", 200, 300, 100, 50.0, "増加")
+    ]
+
+
+def test_category_comparison_is_nfkc_and_case_insensitive():
+    rows = [ex("2026-01-01", "ＡＢＣ", 100), ex("2026-02-01", "abc", 150)]
+    result = month_over_month(rows, "2026-02")
+    assert len(result) == 1
+    assert (result[0].previous, result[0].current, result[0].status) == (
+        100,
+        150,
+        "増加",
+    )
+
+
+def test_sorted_by_abs_diff_desc_then_name_asc():
+    rows = [
+        ex("2026-01-01", "b", 1000),
+        ex("2026-01-01", "a", 1000),
+        ex("2026-01-01", "c", 5000),
+        ex("2026-02-01", "b", 1000),  # diff 0
+        ex("2026-02-01", "a", 500),  # diff -500
+        ex("2026-02-01", "c", 5500),  # diff +500
+    ]
+    names = [c.category for c in month_over_month(rows, "2026-02")]
+    assert names == ["a", "c", "b"]
+
+
+def test_january_compares_with_previous_december():
+    rows = [ex("2025-12-01", "食費", 700), ex("2026-01-01", "食費", 1400)]
+    assert month_over_month(rows, "2026-01") == [
+        CategoryChange("食費", 700, 1400, 700, 100.0, "増加")
+    ]
+
+
+@pytest.mark.parametrize("month", ["2026-1", "2026/01", "2026-13", "2026-00", ""])
+def test_invalid_month_string_raises(month):
+    with pytest.raises(ValueError):
+        month_over_month([], month)
+
+
+def test_non_str_month_raises():
+    with pytest.raises(ValueError):
+        month_over_month([], 202601)  # type: ignore[arg-type]
+
+
+def test_bool_amount_raises():
+    rows = [Expense(day=date(2026, 1, 1), category="食費", amount=True)]  # type: ignore[arg-type]
+    with pytest.raises(ValueError):
+        month_over_month(rows, "2026-02")
+
+
+def test_format_report_lines():
+    changes = [
+        CategoryChange("食費", 3000, 4500, 1500, 50.0, "増加"),
+        CategoryChange("光熱費", 0, 500, 500, None, "新規"),
+    ]
+    assert format_report(changes, "2026-02") == (
+        "2026-02 の前月比\n"
+        "食費: 3,000円 → 4,500円 (+1,500円, +50.0%) 増加\n"
+        "光熱費: 0円 → 500円 (+500円, 新規) 新規"
+    )
+
+
+def test_format_report_empty_changes():
+    assert format_report([], "2026-02") == "2026-02 の前月比\n変化なし"
+
+
+def test_format_report_invalid_month_raises():
+    with pytest.raises(ValueError):
+        format_report([], "2026-1")
