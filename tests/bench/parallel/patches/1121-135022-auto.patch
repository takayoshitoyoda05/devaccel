@@ -0,0 +1,228 @@
+"""Bank CSV importer (pure function over a string)."""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from datetime import date
+
+from kakeibo.core import CsvError, Expense
+
+_DATE = ("date", "日付", "利用日", "取引日", "ご利用日", "年月日")
+_AMOUNT = ("amount", "金額", "利用金額", "ご利用金額", "支払金額")
+_OUT = ("出金", "出金額", "お支払金額", "支払")
+_IN = ("入金", "入金額", "預入", "お預り金額")
+_MEMO = ("memo", "摘要", "メモ", "利用店名", "ご利用店名", "内容", "description")
+_CAT = ("category", "カテゴリ", "分類")
+
+_DATE_RES = [
+    re.compile(r"([0-9]{4})[-/.]([0-9]{1,2})[-/.]([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})"),
+    re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日"),
+]
+_TIME = re.compile(r"[ T][0-9]{1,2}:[0-9]{2}(:[0-9]{2})?")
+_NUM = re.compile(r"[0-9]+|[0-9]{1,3}(,[0-9]{3})+")
+
+
+def _nfkc(s: str) -> str:
+    return unicodedata.normalize("NFKC", s)
+
+
+def _split_records(text: str, delim: str) -> list[tuple[int, list[str], bool]]:
+    """(start_line, fields, is_blank). Unterminated quote -> fields None marker via error."""
+    out: list[tuple[int, list[str], bool]] = []
+    i, n, line = 0, len(text), 1
+    while i < n:
+        start = line
+        fields: list[str] = []
+        cur: list[str] = []
+        quoted_any = False
+        while True:
+            if i < n and text[i] == '"' and not cur:
+                quoted_any = True
+                i += 1
+                while i < n:
+                    c = text[i]
+                    if c == '"':
+                        if i + 1 < n and text[i + 1] == '"':
+                            cur.append('"')
+                            i += 2
+                            continue
+                        i += 1
+                        break
+                    if c == "\n":
+                        line += 1
+                    cur.append(c)
+                    i += 1
+                else:
+                    raise _Unterminated(start)
+                continue
+            if i >= n:
+                fields.append("".join(cur))
+                break
+            c = text[i]
+            if c == delim:
+                fields.append("".join(cur))
+                cur = []
+                i += 1
+            elif c == "\n":
+                fields.append("".join(cur))
+                i += 1
+                line += 1
+                break
+            else:
+                cur.append(c)
+                i += 1
+        out.append((start, fields, fields == [""] and not quoted_any))
+    return out
+
+
+class _Unterminated(Exception):
+    def __init__(self, line: int) -> None:
+        self.line = line
+
+
+def _parse_amount(raw: str) -> int | None:
+    s = _nfkc(raw).strip()
+    neg = False
+    if len(s) >= 2 and s[0] == "(" and s[-1] == ")":
+        neg, s = True, s[1:-1].strip()
+    if s and s[0] in "-−△▲":
+        neg, s = True, s[1:].strip()
+    elif s and s[-1] == "-":
+        neg, s = True, s[:-1].strip()
+    if s.upper().startswith("JPY"):
+        s = s[3:].strip()
+    elif s.startswith("¥"):
+        s = s[1:].strip()
+    if s.endswith("円"):
+        s = s[:-1].strip()
+    if not _NUM.fullmatch(s):
+        return None
+    v = int(s.replace(",", ""))
+    return -v if neg else v
+
+
+def _parse_date(raw: str) -> date | None:
+    s = _nfkc(raw).strip()
+    m = _TIME.search(s)
+    if m and m.end() == len(s):
+        s = s[: m.start()]
+    for rx in _DATE_RES:
+        m2 = rx.fullmatch(s)
+        if m2:
+            try:
+                return date(int(m2[1]), int(m2[2]), int(m2[3]))
+            except ValueError:
+                return None
+    return None
+
+
+def _find(names: tuple[str, ...], header: list[str]) -> int | None:
+    for idx, h in enumerate(header):
+        if h in names:
+            return idx
+    return None
+
+
+def parse_bank_csv(text: str) -> list[Expense]:
+    if not isinstance(text, str):
+        raise ValueError("text は str である必要があります")  # noqa: TRY004
+    text = text.removeprefix("﻿").replace("\r\n", "\n").replace("\r", "\n")
+    if not text.strip():
+        return []
+    first = text.split("\n", 1)[0]
+    delim = "\t" if "\t" in first else ","
+    try:
+        records = _split_records(text, delim)
+    except _Unterminated as e:
+        raise CsvError([(e.line, "引用符が閉じていません")]) from None
+    _, hfields, _ = records[0]
+    raw_header = [f.strip() for f in hfields]
+    header = [_nfkc(f).lower() for f in raw_header]
+    i_date = _find(_DATE, header)
+    i_amt = _find(_AMOUNT, header)
+    i_out = _find(_OUT, header)
+    i_in = _find(_IN, header)
+    i_memo = _find(_MEMO, header)
+    i_cat = _find(_CAT, header)
+    herrs: list[tuple[int, str]] = []
+    if i_date is None:
+        herrs.append((1, "日付列が見つかりません: 日付"))
+    if i_amt is None and (i_out is None or i_in is None):
+        herrs.append((1, "金額列が見つかりません: 金額"))
+    if herrs:
+        raise CsvError(herrs)
+
+    errors: list[tuple[int, str]] = []
+    result: list[Expense] = []
+    for line, fields, blank in records[1:]:
+        if blank:
+            continue
+        if len(fields) != len(header):
+            errors.append(
+                (line, f"列数が不正です(期待 {len(header)}、実際 {len(fields)})")
+            )
+            continue
+        assert i_date is not None
+        day = _parse_date(fields[i_date])
+        if day is None:
+            errors.append(
+                (
+                    line,
+                    f"{raw_header[i_date]}: 日付が不正です(元の値 '{fields[i_date]}')",
+                )
+            )
+        amount: int | None = None
+        skip = False
+        if i_amt is not None:
+            amount = _parse_amount(fields[i_amt])
+            if amount is None:
+                errors.append(
+                    (
+                        line,
+                        f"{raw_header[i_amt]}: 金額が不正です(元の値 '{fields[i_amt]}')",
+                    )
+                )
+        else:
+            assert i_out is not None and i_in is not None
+            ro, ri = fields[i_out], fields[i_in]
+            vo = vi = None
+            ok = True
+            if ro.strip():
+                vo = _parse_amount(ro)
+                if vo is None:
+                    ok = False
+                    errors.append(
+                        (line, f"{raw_header[i_out]}: 金額が不正です(元の値 '{ro}')")
+                    )
+            if ri.strip():
+                vi = _parse_amount(ri)
+                if vi is None:
+                    ok = False
+                    errors.append(
+                        (line, f"{raw_header[i_in]}: 金額が不正です(元の値 '{ri}')")
+                    )
+            if ok:
+                if vo and vi:
+                    errors.append(
+                        (
+                            line,
+                            f"{raw_header[i_out]}/{raw_header[i_in]}: 出金と入金の両方に値があります(元の値 '{ro}' '{ri}')",
+                        )
+                    )
+                elif not vo and not vi:
+                    skip = True
+                elif vo:
+                    amount = vo
+                else:
+                    assert vi is not None
+                    amount = -vi
+        if skip or day is None or amount is None:
+            continue
+        memo = _nfkc(fields[i_memo]).strip() if i_memo is not None else ""
+        cat = fields[i_cat].strip() if i_cat is not None else ""
+        result.append(Expense(day, cat or "未分類", amount, memo))
+    if errors:
+        raise CsvError(errors)
+    return result
