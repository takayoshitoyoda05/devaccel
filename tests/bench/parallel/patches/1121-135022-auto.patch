index 0000000..2e31760
--- /dev/null
+++ b/src/kakeibo/trend.py
@@ -0,0 +1,102 @@
+"""Month-over-month category comparison and report text."""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    diff: int
+    pct: float | None
+    status: str
+
+
+def _parse_month(month: object) -> tuple[int, int]:
+    if not isinstance(month, str) or not _MONTH_RE.fullmatch(month):
+        raise ValueError(
+            f"month は YYYY-MM の文字列である必要があります: {month!r}"
+        )  # D5: 型違いも ValueError
+    return int(month[:4]), int(month[5:])
+
+
+def _key(category: str) -> str:
+    return unicodedata.normalize("NFKC", category).casefold()
+
+
+def _validate_rows(rows: object) -> list[Expense]:
+    if not isinstance(rows, list):
+        raise ValueError("rows は list である必要があります")  # noqa: TRY004  # D5
+    for e in rows:
+        if not isinstance(e, Expense):
+            raise ValueError(f"Expense ではありません: {e!r}")  # noqa: TRY004  # D5
+        if isinstance(e.amount, bool) or not isinstance(e.amount, int):
+            raise ValueError(f"金額は整数である必要があります: {e.amount!r}")  # noqa: TRY004  # D5
+    return rows
+
+
+def _totals(rows: list[Expense], year: int, mon: int) -> dict[str, tuple[str, int]]:
+    """{normalized category: (first-seen name, sum of amount)} for one month."""
+    out: dict[str, tuple[str, int]] = {}
+    for e in rows:
+        if (e.day.year, e.day.month) != (year, mon):
+            continue
+        k = _key(e.category)
+        name, total = out.get(k, (e.category, 0))
+        out[k] = (name, total + e.amount)
+    return out
+
+
+def month_over_month(rows: list[Expense], month: str) -> list[CategoryChange]:
+    year, mon = _parse_month(month)
+    _validate_rows(rows)
+    prev_year, prev_mon = (year - 1, 12) if mon == 1 else (year, mon - 1)
+    cur = _totals(rows, year, mon)
+    prev = _totals(rows, prev_year, prev_mon)
+
+    changes: list[CategoryChange] = []
+    for k in set(cur) | set(prev):
+        name = cur[k][0] if k in cur else prev[k][0]
+        before = prev[k][1] if k in prev else 0
+        after = cur[k][1] if k in cur else 0
+        if before == 0 and after == 0:
+            continue
+        diff = after - before
+        pct = None if before == 0 else round(diff / abs(before) * 100, 1)
+        if before == 0:
+            status = "新規"
+        elif after == 0:
+            status = "なくなった"
+        elif diff > 0:
+            status = "増加"
+        elif diff < 0:
+            status = "減少"
+        else:
+            status = "変化なし"
+        changes.append(CategoryChange(name, before, after, diff, pct, status))
+
+    changes.sort(key=lambda c: (-abs(c.diff), c.category))
+    return changes
+
+
+def format_report(changes: list[CategoryChange], month: str) -> str:
+    _parse_month(month)
+    lines = [f"{month} の前月比"]
+    if not changes:
+        lines.append("変化なし")
+    for c in changes:
+        pct = "新規" if c.pct is None else f"{c.pct:+.1f}%"
+        lines.append(
+            f"{c.category}: {c.previous:,}円 → {c.current:,}円 "
+            f"({c.diff:+,}円, {pct}) {c.status}"
+        )
+    return "\n".join(lines)
