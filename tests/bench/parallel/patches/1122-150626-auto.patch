diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..a9d09f0 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -186,5 +186,135 @@ def test_path_type(runner, cls, expect):
     assert result.return_value == expect
 
 
+@pytest.mark.parametrize(
+    "name", ["a.csv", "a.tsv", "A.CSV", "a.Tsv", "dir.csv/b.tsv", "a.b.csv"]
+)
+def test_path_extensions_accepts(name):
+    type = click.Path(extensions=[".csv", ".tsv"])
+    assert type.convert(name, None, None) == name
+
+
+@pytest.mark.parametrize("name", ["a.txt", "a", "csv", "a.csv.bak", ".csvx", "a.csv/"])
+def test_path_extensions_rejects(name):
+    type = click.Path(extensions=[".csv", ".tsv"])
+
+    with pytest.raises(click.BadParameter, match=r"must have one of these") as info:
+        type.convert(name, None, None)
+
+    assert ".csv, .tsv" in info.value.message
+
+
+def test_path_extensions_forms():
+    # Leading dot optional, case ignored, multi-part allowed.
+    type = click.Path(extensions=["CSV", ".Tar.GZ"])
+    assert type.extensions == (".csv", ".tar.gz")
+    assert type.convert("x.TAR.gz", None, None) == "x.TAR.gz"
+    assert type.convert("x.Csv", None, None) == "x.Csv"
+
+    with pytest.raises(click.BadParameter):
+        type.convert("x.gz", None, None)
+
+
+def test_path_extensions_default_accepts_anything():
+    assert click.Path().extensions is None
+    assert click.Path().convert("a.whatever", None, None) == "a.whatever"
+
+
+@pytest.mark.parametrize(
+    ("extensions", "error"),
+    [
+        ([], ValueError),
+        ([""], ValueError),
+        (["."], ValueError),
+        (".csv", TypeError),
+        (b".csv", TypeError),
+        ([1], TypeError),
+        ([None], TypeError),
+        (5, TypeError),
+    ],
+)
+def test_path_extensions_invalid_argument(extensions, error):
+    with pytest.raises(error, match="extensions"):
+        click.Path(extensions=extensions)
+
+
+def test_path_extensions_accepts_tuple():
+    assert click.Path(extensions=(".csv",)).extensions == (".csv",)
+
+
+def test_path_extensions_existing_files(tmp_path):
+    good = tmp_path / "data.CSV"
+    bad = tmp_path / "data.txt"
+    good.write_text("")
+    bad.write_text("")
+    type = click.Path(exists=True, extensions=[".csv"])
+
+    assert type.convert(os.fspath(good), None, None) == os.fspath(good)
+
+    with pytest.raises(click.BadParameter, match="must have one of these"):
+        type.convert(os.fspath(bad), None, None)
+
+
+def test_path_extensions_missing_file_still_checked(tmp_path):
+    # A path that does not need to exist (e.g. an output file) is checked too.
+    type = click.Path(extensions=[".csv"])
+
+    with pytest.raises(click.BadParameter, match="must have one of these"):
+        type.convert(os.fspath(tmp_path / "new.txt"), None, None)
+
+    # A missing file still reports "does not exist" first when required.
+    with pytest.raises(click.BadParameter, match="does not exist"):
+        click.Path(exists=True, extensions=[".csv"]).convert(
+            os.fspath(tmp_path / "new.csv"), None, None
+        )
+
+
+def test_path_extensions_skips_directories(tmp_path):
+    directory = tmp_path / "folder.txt"
+    directory.mkdir()
+    type = click.Path(exists=True, extensions=[".csv"])
+    assert type.convert(os.fspath(directory), None, None) == os.fspath(directory)
+
+
+def test_path_extensions_skips_dash():
+    type = click.Path(allow_dash=True, extensions=[".csv"])
+    assert type.convert("-", None, None) == "-"
+
+    # Without allow_dash, "-" is an ordinary name and is rejected.
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions=[".csv"]).convert("-", None, None)
+
+
+def test_path_extensions_bytes_and_pathlib():
+    assert click.Path(extensions=[".csv"]).convert(b"a.CSV", None, None) == b"a.CSV"
+
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions=[".csv"]).convert(b"a.txt", None, None)
+
+    type = click.Path(extensions=[".csv"], path_type=pathlib.Path)
+    assert type.convert(pathlib.Path("a.csv"), None, None) == pathlib.Path("a.csv")
+
+    with pytest.raises(click.BadParameter):
+        type.convert(pathlib.Path("a.txt"), None, None)
+
+
+def test_path_extensions_info_dict():
+    info = click.Path(extensions=["CSV", ".tsv"]).to_info_dict()
+    assert info["extensions"] == [".csv", ".tsv"]
+
+
+def test_path_extensions_cli(runner):
+    @click.command()
+    @click.argument("p", type=click.Path(extensions=[".csv", ".tsv"]))
+    def cli(p):
+        click.echo(p)
+
+    assert runner.invoke(cli, ["x.TSV"]).output == "x.TSV\n"
+
+    result = runner.invoke(cli, ["x.txt"])
+    assert result.exit_code == 2
+    assert "must have one of these extensions: .csv, .tsv." in result.output
+
+
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
