@@ -0,0 +1,172 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.compare import CategoryChange, compare_months, format_comparison
+from kakeibo.core import Expense
+
+
+def _e(ym: str, category: str, amount: int) -> Expense:
+    return Expense(
+        day=date(int(ym[:4]), int(ym[5:7]), 1), category=category, amount=amount
+    )
+
+
+def _find(changes: list[CategoryChange], category: str) -> CategoryChange:
+    return next(c for c in changes if c.category == category)
+
+
+def test_E4_1_up_with_pct() -> None:
+    """E4-1: 2026-01 食費 10000、2026-02 食費 12500、month="2026-02" (R1,R2,R3)"""
+    rows = [_e("2026-01", "食費", 10000), _e("2026-02", "食費", 12500)]
+    ch = _find(compare_months(rows, "2026-02"), "食費")
+    assert ch.previous == 10000
+    assert ch.current == 12500
+    assert ch.diff == 2500
+    assert ch.pct == 25.0
+    assert ch.status == "up"
+
+
+def test_E4_2_down_with_pct() -> None:
+    """E4-2: 2026-01 交通 3000、2026-02 交通 2000 (R2,R3)"""
+    rows = [_e("2026-01", "交通", 3000), _e("2026-02", "交通", 2000)]
+    ch = _find(compare_months(rows, "2026-02"), "交通")
+    assert ch.diff == -1000
+    assert ch.pct == -33.3
+    assert ch.status == "down"
+
+
+def test_E4_3_new_has_no_pct() -> None:
+    """E4-3: 前月に無い 光熱 5000 (R2,R3)"""
+    rows = [_e("2026-02", "光熱", 5000)]
+    ch = _find(compare_months(rows, "2026-02"), "光熱")
+    assert ch.previous == 0
+    assert ch.status == "new"
+    assert ch.pct is None
+
+
+def test_E4_4_gone_has_no_pct() -> None:
+    """E4-4: 今月に無い 娯楽 4000 (R2,R3)"""
+    rows = [_e("2026-01", "娯楽", 4000)]
+    ch = _find(compare_months(rows, "2026-02"), "娯楽")
+    assert ch.current == 0
+    assert ch.diff == -4000
+    assert ch.status == "gone"
+    assert ch.pct is None
+
+
+def test_E4_5_same_pct_zero() -> None:
+    """E4-5: 2026-01 の食費 3000 と month="2026-02" で食費 3000 (R2,R3)"""
+    rows = [_e("2026-01", "食費", 3000), _e("2026-02", "食費", 3000)]
+    ch = _find(compare_months(rows, "2026-02"), "食費")
+    assert ch.status == "same"
+    assert ch.pct == 0.0
+
+
+def test_E4_6_year_wrap_previous_month_is_december() -> None:
+    """E4-6: 2025-12 と month="2026-01"(年またぎ)では前月は 2025-12 (R1)"""
+    rows = [_e("2025-12", "食費", 1000), _e("2026-01", "食費", 2000)]
+    ch = _find(compare_months(rows, "2026-01"), "食費")
+    assert ch.previous == 1000
+    assert ch.current == 2000
+
+
+def test_E4_7_order_by_abs_diff_then_category() -> None:
+    """E4-7: 変化 +500(食費)、-2000(交通)、+500(娯楽) → 交通, 娯楽, 食費 (R4)"""
+    rows = [
+        _e("2026-01", "食費", 1000),
+        _e("2026-02", "食費", 1500),
+        _e("2026-01", "交通", 4000),
+        _e("2026-02", "交通", 2000),
+        _e("2026-01", "娯楽", 2000),
+        _e("2026-02", "娯楽", 2500),
+    ]
+    names = [c.category for c in compare_months(rows, "2026-02")]
+    assert names == ["交通", "娯楽", "食費"]
+
+
+def test_E4_8_invalid_month_raises_and_format_lines() -> None:
+    """E4-8: month="2026-13" は ValueError / 出力行の形式 (R1,R5)"""
+    with pytest.raises(ValueError):
+        compare_months([], "2026-13")
+
+    food = compare_months(
+        [_e("2026-01", "食費", 10000), _e("2026-02", "食費", 12500)], "2026-02"
+    )
+    heat = compare_months([_e("2026-02", "光熱", 5000)], "2026-02")
+    assert format_comparison(food + heat) == (
+        "食費: 10,000円 → 12,500円 (+2,500円, +25.0%)\n"
+        "光熱: 0円 → 5,000円 (+5,000円, 新規)"
+    )
+
+
+@pytest.mark.parametrize(
+    "month", ["2026-1", "2026-00", "2026-13", "26-01", "2026/01", "2026-01-01"]
+)
+def test_R1_malformed_month_raises(month: str) -> None:
+    """R1: YYYY-MM (01〜12) 以外は ValueError"""
+    with pytest.raises(ValueError):
+        compare_months([], month)
+
+
+def test_R4_category_with_zero_total_is_included() -> None:
+    """R4: 合計が 0 でも明細があればカテゴリを含める"""
+    rows = [_e("2026-02", "雑費", 0)]
+    changes = compare_months(rows, "2026-02")
+    assert [c.category for c in changes] == ["雑費"]
+    assert changes[0].status == "same"
+
+
+def test_R4_category_without_rows_is_excluded() -> None:
+    """R4: どちらの月にも明細が無いカテゴリは含めない"""
+    rows = [_e("2026-01", "食費", 100)]
+    assert [c.category for c in compare_months(rows, "2026-02")] == ["食費"]
+
+
+def test_R5_empty_list_message() -> None:
+    """R5: 空リストは「比較できるデータがありません」"""
+    assert format_comparison([]) == "比較できるデータがありません"
+
+
+def test_R5_same_line_format() -> None:
+    """R5: same は (±0円)"""
+    changes = compare_months(
+        [_e("2026-01", "食費", 3000), _e("2026-02", "食費", 3000)], "2026-02"
+    )
+    assert format_comparison(changes) == "食費: 3,000円 → 3,000円 (±0円)"
+
+
+def test_R5_gone_line_format() -> None:
+    """R5: gone で pct None は ', 消滅)'"""
+    changes = compare_months([_e("2026-01", "娯楽", 4000)], "2026-02")
+    assert format_comparison(changes) == "娯楽: 4,000円 → 0円 (-4,000円, 消滅)"
+
+
+def test_P1_diff_equals_current_minus_previous() -> None:
+    """P1: 全要素で diff = current − previous"""
+    rows = [
+        _e("2026-01", "食費", 1000),
+        _e("2026-02", "食費", 1700),
+        _e("2026-01", "交通", 5000),
+        _e("2026-02", "交通", 200),
+        _e("2026-02", "光熱", 900),
+        _e("2026-01", "娯楽", 300),
+    ]
+    for c in compare_months(rows, "2026-02"):
+        assert c.diff == c.current - c.previous
+
+
+def test_P2_sorted_by_abs_diff_descending() -> None:
+    """P2: 並びは |diff| の降順"""
+    rows = [
+        _e("2026-01", "食費", 1000),
+        _e("2026-02", "食費", 1700),
+        _e("2026-01", "交通", 5000),
+        _e("2026-02", "交通", 200),
+        _e("2026-02", "光熱", 900),
+        _e("2026-01", "娯楽", 300),
+    ]
+    diffs = [abs(c.diff) for c in compare_months(rows, "2026-02")]
+    assert diffs == sorted(diffs, reverse=True)
