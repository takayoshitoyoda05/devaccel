+"""Detect recurring expenses: same category/memo/amount, once a month, consecutive months."""
+
+from __future__ import annotations
+
+import calendar
+import itertools
+from collections import defaultdict
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int
+    months: int
+    last_day: date
+    day_of_month: int
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month
+
+
+def find_recurring(rows: list[Expense], min_months: int = 3) -> list[Recurring]:
+    """Return recurring groups, sorted by amount desc, then category and memo asc.
+
+    Refunds (amount <= 0) are never recurring. A group qualifies when it has one
+    entry per month, the months are consecutive, there are at least ``min_months``
+    of them, and the day-of-month spread (max - min) is at most 3.
+    """
+    if min_months < 2:
+        raise ValueError("min_months は 2 以上である必要があります")
+    groups: dict[tuple[str, str, int], list[Expense]] = defaultdict(list)
+    for e in rows:
+        if e.amount <= 0:
+            continue
+        groups[(e.category, e.memo.strip(), e.amount)].append(e)
+
+    out: list[Recurring] = []
+    for (category, memo, amount), items in groups.items():
+        if len(items) < min_months:
+            continue
+        month_idx = sorted(_month_index(e.day) for e in items)
+        if len(set(month_idx)) != len(month_idx):
+            continue  # two or more in the same month
+        if any(b - a != 1 for a, b in itertools.pairwise(month_idx)):
+            continue  # a month is skipped
+        days = [e.day.day for e in items]
+        if max(days) - min(days) > 3:
+            continue
+        last = max(e.day for e in items)
+        out.append(Recurring(category, memo, amount, len(items), last, max(days)))
+    out.sort(key=lambda r: (-r.amount, r.category, r.memo))
+    return out
+
+
+def next_expected(r: Recurring) -> date:
+    """The month after last_day, with day_of_month clipped to that month's last day."""
+    if r.last_day.month == 12:
+        year, month = r.last_day.year + 1, 1
+    else:
+        year, month = r.last_day.year, r.last_day.month + 1
+    last_of_month = calendar.monthrange(year, month)[1]
+    return date(year, month, min(r.day_of_month, last_of_month))
