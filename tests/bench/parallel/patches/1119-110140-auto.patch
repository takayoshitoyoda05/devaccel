@@ -0,0 +1,183 @@
+from __future__ import annotations
+
+import random
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, next_expected
+
+
+def _e(
+    day: str, category: str = "家賃", memo: str = "", amount: int = 80000
+) -> Expense:
+    return Expense(date.fromisoformat(day), category, amount, memo)
+
+
+def _summary(rows: list[Expense], min_months: int = 3) -> list[tuple]:
+    return [
+        (
+            r.category,
+            r.memo,
+            r.amount,
+            r.months,
+            r.last_day,
+            r.day_of_month,
+            next_expected(r),
+        )
+        for r in find_recurring(rows, min_months=min_months)
+    ]
+
+
+# 表 E1 の全行(ID はテスト ID)
+@pytest.mark.parametrize(
+    ("rows", "expected"),
+    [
+        pytest.param(
+            [_e("2026-01-25"), _e("2026-02-25"), _e("2026-03-25")],
+            [("家賃", "", 80000, 3, date(2026, 3, 25), 25, date(2026, 4, 25))],
+            id="E1-1",
+        ),
+        pytest.param(
+            [_e("2026-01-25"), _e("2026-02-25")],
+            [],
+            id="E1-2",
+        ),
+        pytest.param(
+            [_e("2026-01-25"), _e("2026-03-25"), _e("2026-04-25")],
+            [],
+            id="E1-3",
+        ),
+        pytest.param(
+            [
+                _e("2026-01-25", amount=80000),
+                _e("2026-02-25", amount=80000),
+                _e("2026-03-25", amount=81000),
+            ],
+            [],
+            id="E1-4",
+        ),
+        pytest.param(
+            [_e("2026-01-31"), _e("2026-02-28"), _e("2026-03-31")],
+            [("家賃", "", 80000, 3, date(2026, 3, 31), 31, date(2026, 4, 30))],
+            id="E1-5",
+        ),
+        pytest.param(
+            [_e("2026-10-05"), _e("2026-11-05"), _e("2026-12-05")],
+            [("家賃", "", 80000, 3, date(2026, 12, 5), 5, date(2027, 1, 5))],
+            id="E1-6",
+        ),
+        pytest.param(
+            [
+                _e("2026-01-10", amount=-500),
+                _e("2026-02-10", amount=-500),
+                _e("2026-03-10", amount=-500),
+            ],
+            [],
+            id="E1-7",
+        ),
+        pytest.param(
+            [_e("2026-01-10"), _e("2026-01-10"), _e("2026-02-10"), _e("2026-03-10")],
+            [],
+            id="E1-8",
+        ),
+    ],
+)
+def test_table_e1(rows: list[Expense], expected: list[tuple]) -> None:
+    assert _summary(rows) == expected
+
+
+def test_day_spread_over_three_is_not_recurring() -> None:
+    rows = [_e("2026-01-01"), _e("2026-02-05"), _e("2026-03-01")]
+    assert find_recurring(rows) == []
+
+
+def test_memo_is_compared_after_strip() -> None:
+    rows = [
+        _e("2026-01-10", memo=" 水道 "),
+        _e("2026-02-10", memo="水道"),
+        _e("2026-03-10", memo="水道 "),
+    ]
+    assert _summary(rows) == [
+        ("家賃", "水道", 80000, 3, date(2026, 3, 10), 10, date(2026, 4, 10))
+    ]
+
+
+def test_different_category_or_memo_are_separate_groups() -> None:
+    rows = [
+        _e("2026-01-10", category="水道"),
+        _e("2026-02-10", category="水道"),
+        _e("2026-03-10", category="水道"),
+        _e("2026-01-10", memo="A"),
+        _e("2026-02-10", memo="B"),
+        _e("2026-03-10", memo="A"),
+    ]
+    assert find_recurring(rows) == [
+        Recurring("水道", "", 80000, 3, date(2026, 3, 10), 10),
+    ]
+
+
+def test_min_months_two_accepts_two_month_series() -> None:
+    rows = [_e("2026-01-10"), _e("2026-02-10")]
+    assert _summary(rows, min_months=2) == [
+        ("家賃", "", 80000, 2, date(2026, 2, 10), 10, date(2026, 3, 10))
+    ]
+
+
+def test_min_months_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_months=1)
+
+
+def test_empty_input_returns_empty() -> None:
+    assert find_recurring([]) == []
+
+
+def test_order_is_amount_desc_then_category_then_memo() -> None:
+    rows: list[Expense] = []
+    for month in ("2026-01-10", "2026-02-10", "2026-03-10"):
+        rows += [
+            _e(month, category="通信", memo="b", amount=5000),
+            _e(month, category="通信", memo="a", amount=5000),
+            _e(month, category="家賃", memo="", amount=80000),
+            _e(month, category="ジム", memo="", amount=5000),
+        ]
+    got = [(r.category, r.memo, r.amount) for r in find_recurring(rows)]
+    assert got == [
+        ("家賃", "", 80000),
+        ("ジム", "", 5000),
+        ("通信", "a", 5000),
+        ("通信", "b", 5000),
+    ]
+
+
+def test_result_does_not_depend_on_input_order() -> None:
+    rows = [
+        _e("2026-01-25"),
+        _e("2026-02-25"),
+        _e("2026-03-25"),
+        _e("2026-01-05", category="水道", amount=3000),
+        _e("2026-02-05", category="水道", amount=3000),
+        _e("2026-03-05", category="水道", amount=3000),
+    ]
+    expected = find_recurring(rows)
+    rng = random.Random(0)
+    for _ in range(5):
+        shuffled = rows[:]
+        rng.shuffle(shuffled)
+        assert find_recurring(shuffled) == expected
+
+
+def test_next_expected_is_after_last_day() -> None:
+    rows = [_e("2026-10-05"), _e("2026-11-05"), _e("2026-12-05")]
+    for r in find_recurring(rows):
+        assert next_expected(r) > r.last_day
+
+
+def test_results_meet_min_months_invariant() -> None:
+    rows = [_e(f"2026-{m:02d}-15") for m in range(1, 5)] + [
+        _e("2026-01-20", category="x", amount=1)
+    ]
+    for r in find_recurring(rows, min_months=3):
+        assert r.months >= 3
