+++ b/src/kakeibo/search.py
@@ -0,0 +1,60 @@
+"""Search expenses with composable predicates (pure functions, no I/O)."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from datetime import date
+
+from kakeibo.core import Expense
+
+Predicate = Callable[[Expense], bool]
+
+
+def category(*names: str) -> Predicate:
+    """Match if the category equals any of the given names (surrounding spaces ignored)."""
+    if not names:
+        raise ValueError("category() には名前が 1 つ以上必要です")
+    wanted = frozenset(n.strip() for n in names)
+    return lambda e: e.category.strip() in wanted
+
+
+def amount_between(low: int | None = None, high: int | None = None) -> Predicate:
+    """Match if low <= amount <= high (inclusive). None means unbounded."""
+    if low is not None and high is not None and low > high:
+        raise ValueError(f"low({low}) は high({high}) 以下である必要があります")
+    return lambda e: (
+        (low is None or e.amount >= low) and (high is None or e.amount <= high)
+    )
+
+
+def memo_contains(text: str) -> Predicate:
+    """Case-insensitive substring match on memo (casefold). Empty text matches all."""
+    needle = text.casefold()
+    return lambda e: needle in e.memo.casefold()
+
+
+def between_dates(start: date | None = None, end: date | None = None) -> Predicate:
+    """Match if start <= day <= end (inclusive). None means unbounded."""
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"start({start}) は end({end}) 以前である必要があります")
+    return lambda e: (start is None or e.day >= start) and (end is None or e.day <= end)
+
+
+def all_of(*preds: Predicate) -> Predicate:
+    """AND of predicates. With no predicates, always True."""
+    return lambda e: all(p(e) for p in preds)
+
+
+def any_of(*preds: Predicate) -> Predicate:
+    """OR of predicates. With no predicates, always False."""
+    return lambda e: any(p(e) for p in preds)
+
+
+def not_(pred: Predicate) -> Predicate:
+    """Negation of a predicate."""
+    return lambda e: not pred(e)
+
+
+def search(rows: list[Expense], pred: Predicate) -> list[Expense]:
+    """Return a new list of matching rows, preserving input order. Input is not modified."""
+    return [e for e in rows if pred(e)]
