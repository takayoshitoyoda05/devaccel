+"""Month-over-month comparison of expenses by category."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    diff: int
+    pct: float | None
+    status: str
+
+
+def _previous_month(month: str) -> str:
+    year, mon = int(month[:4]), int(month[5:7])
+    if mon == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mon - 1:02d}"
+
+
+def _totals_for_month(rows: list[Expense], month: str) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for e in rows:
+        if e.day.strftime("%Y-%m") == month:
+            out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def compare_months(rows: list[Expense], month: str) -> list[CategoryChange]:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+    before = _totals_for_month(rows, _previous_month(month))
+    now = _totals_for_month(rows, month)
+
+    changes: list[CategoryChange] = []
+    for cat in set(before) | set(now):
+        prev = before.get(cat, 0)
+        cur = now.get(cat, 0)
+        diff = cur - prev
+        if prev == 0 and cur != 0:
+            status = "new"
+        elif cur == 0 and prev != 0:
+            status = "gone"
+        elif diff > 0:
+            status = "up"
+        elif diff < 0:
+            status = "down"
+        else:
+            status = "same"
+        pct: float | None = None
+        if prev > 0 and status not in ("new", "gone"):
+            pct = round(diff * 100 / prev, 1)
+        changes.append(
+            CategoryChange(
+                category=cat,
+                previous=prev,
+                current=cur,
+                diff=diff,
+                pct=pct,
+                status=status,
+            )
+        )
+    changes.sort(key=lambda c: (-abs(c.diff), c.category))
+    return changes
+
+
+def format_comparison(changes: list[CategoryChange]) -> str:
+    if not changes:
+        return "比較できるデータがありません"
+    lines: list[str] = []
+    for c in changes:
+        head = f"{c.category}: {c.previous:,}円 → {c.current:,}円"
+        if c.status == "same":
+            tail = "(±0円)"
+        elif c.pct is not None:
+            tail = f"({c.diff:+,}円, {c.pct:+.1f}%)"
+        elif c.status == "new":
+            tail = f"({c.diff:+,}円, 新規)"
+        elif c.status == "gone":
+            tail = f"({c.diff:+,}円, 消滅)"
+        else:
+            tail = f"({c.diff:+,}円)"
+        lines.append(f"{head} {tail}")
+    return "\n".join(lines)
