@@ -0,0 +1,203 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    all_of,
+    amount_between,
+    any_of,
+    between_dates,
+    category,
+    memo_contains,
+    not_,
+    search,
+)
+
+
+def ex(day: date, cat: str, amount: int, memo: str = "") -> Expense:
+    return Expense(day=day, category=cat, amount=amount, memo=memo)
+
+
+# E3-1: 食費 2 件・交通 1 件。category("食費") は食費 2 件を元の順で返す
+def test_E3_1_category_keeps_order() -> None:
+    rows = [
+        ex(date(2026, 1, 1), "食費", 1200),
+        ex(date(2026, 1, 2), "交通", 500),
+        ex(date(2026, 1, 3), "食費", 3000),
+    ]
+    out = search(rows, category("食費"))
+    assert out == [rows[0], rows[2]]
+
+
+# R1: 名前のどれかと完全一致(前後空白は無視)。名前 0 個は ValueError
+def test_R1_category_multiple_names_and_whitespace() -> None:
+    rows = [
+        ex(date(2026, 1, 1), "食費", 1),
+        ex(date(2026, 1, 2), "交通", 2),
+        ex(date(2026, 1, 3), "日用品", 3),
+    ]
+    out = search(rows, category(" 食費 ", "交通"))
+    assert out == [rows[0], rows[1]]
+
+
+def test_R1_category_is_exact_match() -> None:
+    rows = [ex(date(2026, 1, 1), "食費外", 1)]
+    assert search(rows, category("食費")) == []
+
+
+def test_E3_8_category_without_names_raises() -> None:
+    with pytest.raises(ValueError):
+        category()
+
+
+# E3-2: amount_between(500,1200) で 499・500・1200・1201 -> 500 と 1200
+@pytest.mark.parametrize(
+    "amount, expected",
+    [(499, False), (500, True), (1200, True), (1201, False)],
+    ids=["E3-2-499", "E3-2-500", "E3-2-1200", "E3-2-1201"],
+)
+def test_E3_2_amount_between_inclusive(amount: int, expected: bool) -> None:
+    row = ex(date(2026, 1, 1), "食費", amount)
+    assert amount_between(500, 1200)(row) is expected
+
+
+def test_E3_2_amount_between_result_list() -> None:
+    rows = [
+        ex(date(2026, 1, d), "食費", a)
+        for d, a in ((1, 499), (2, 500), (3, 1200), (4, 1201))
+    ]
+    out = search(rows, amount_between(500, 1200))
+    assert [r.amount for r in out] == [500, 1200]
+
+
+# R2: None は無制限。low>high は ValueError
+def test_R2_amount_between_open_ends() -> None:
+    row_low = ex(date(2026, 1, 1), "食費", -(10**9))
+    row_high = ex(date(2026, 1, 1), "食費", 10**9)
+    assert amount_between(high=1000)(row_low) is True
+    assert amount_between(low=1000)(row_high) is True
+    assert amount_between()(row_low) is True
+
+
+# E3-8: amount_between(10,5) は ValueError
+def test_E3_8_amount_between_reversed_raises() -> None:
+    with pytest.raises(ValueError):
+        amount_between(10, 5)
+
+
+# E3-3: memo_contains("coffee") で memo "Coffee Shop" は一致
+def test_E3_3_memo_contains_casefold() -> None:
+    row = ex(date(2026, 1, 1), "食費", 300, "Coffee Shop")
+    assert memo_contains("coffee")(row) is True
+
+
+# R3: 部分一致・大文字小文字無視・空文字は全件一致
+def test_R3_memo_contains_partial_and_empty() -> None:
+    row = ex(date(2026, 1, 1), "食費", 300, "")
+    assert memo_contains("")(row) is True
+    row2 = ex(date(2026, 1, 1), "食費", 300, "家賃振込")
+    assert memo_contains("賃振")(row2) is True
+    assert memo_contains("家賃")(row) is False
+
+
+# E3-4: between_dates(2026-01-01, 2026-01-31) で 12-31・01-01・01-31・02-01 -> 01-01 と 01-31
+@pytest.mark.parametrize(
+    "day, expected",
+    [
+        (date(2025, 12, 31), False),
+        (date(2026, 1, 1), True),
+        (date(2026, 1, 31), True),
+        (date(2026, 2, 1), False),
+    ],
+    ids=["E3-4-12-31", "E3-4-01-01", "E3-4-01-31", "E3-4-02-01"],
+)
+def test_E3_4_between_dates_inclusive(day: date, expected: bool) -> None:
+    row = ex(day, "食費", 1)
+    assert between_dates(date(2026, 1, 1), date(2026, 1, 31))(row) is expected
+
+
+# R2: between_dates の None は無制限。start>end は ValueError
+def test_R2_between_dates_open_ends() -> None:
+    row = ex(date(2026, 6, 1), "食費", 1)
+    assert between_dates(start=date(2026, 1, 1))(row) is True
+    assert between_dates(end=date(2026, 1, 1))(row) is False
+    assert between_dates()(row) is True
+
+
+# E3-8: between_dates(新,旧) は ValueError
+def test_E3_8_between_dates_reversed_raises() -> None:
+    with pytest.raises(ValueError):
+        between_dates(date(2026, 2, 1), date(2026, 1, 1))
+
+
+# E3-5: all_of(category("食費"), amount_between(high=1000)) は 食費かつ 1000 以下
+def test_E3_5_all_of_combines() -> None:
+    rows = [
+        ex(date(2026, 1, 1), "食費", 1000),
+        ex(date(2026, 1, 2), "食費", 1001),
+        ex(date(2026, 1, 3), "交通", 500),
+    ]
+    out = search(rows, all_of(category("食費"), amount_between(high=1000)))
+    assert out == [rows[0]]
+
+
+# E3-6: any_of(category("食費"), memo_contains("家賃")) は OR、not_(category("食費")) は否定
+def test_E3_6_any_of_is_or() -> None:
+    rows = [
+        ex(date(2026, 1, 1), "食費", 1),
+        ex(date(2026, 1, 2), "住居", 2, "家賃"),
+        ex(date(2026, 1, 3), "交通", 3, "電車"),
+    ]
+    out = search(rows, any_of(category("食費"), memo_contains("家賃")))
+    assert out == [rows[0], rows[1]]
+
+
+def test_E3_6_not_is_negation() -> None:
+    rows = [ex(date(2026, 1, 1), "食費", 1), ex(date(2026, 1, 2), "交通", 2)]
+    out = search(rows, not_(category("食費")))
+    assert out == [rows[1]]
+
+
+# E3-7: all_of() は常に True、any_of() は常に False
+@pytest.mark.parametrize(
+    "combinator, expected",
+    [(all_of, True), (any_of, False)],
+    ids=["E3-7-all_of", "E3-7-any_of"],
+)
+def test_E3_7_empty_combinators(combinator: object, expected: bool) -> None:
+    pred = combinator()  # type: ignore[operator]
+    rows = [ex(date(2026, 1, 1), "食費", 1, "memo"), ex(date(2026, 1, 2), "", 0)]
+    for row in rows:
+        assert pred(row) is expected
+
+
+# P2: not_(p) と p は排他で、合わせて全件
+def test_P2_not_partitions_all_rows() -> None:
+    rows = [
+        ex(date(2026, 1, 1), "食費", 1),
+        ex(date(2026, 1, 2), "交通", 2),
+        ex(date(2026, 1, 3), "食費", 3),
+    ]
+    p = category("食費")
+    yes = search(rows, p)
+    no = search(rows, not_(p))
+    assert len(yes) + len(no) == len(rows)
+    assert all(r not in no for r in yes)
+
+
+# R5 / P1: 入力を変えず、新しいリストを返し、結果は rows の部分列
+def test_R5_P1_search_returns_new_subsequence() -> None:
+    rows = [
+        ex(date(2026, 1, 1), "食費", 1),
+        ex(date(2026, 1, 2), "交通", 2),
+        ex(date(2026, 1, 3), "食費", 3),
+    ]
+    snapshot = list(rows)
+    out = search(rows, category("食費"))
+    assert rows == snapshot
+    assert out is not rows
+    it = iter(rows)
+    assert all(any(r is x for x in it) for r in out)
