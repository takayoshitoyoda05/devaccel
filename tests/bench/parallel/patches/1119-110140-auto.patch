@@ -0,0 +1,135 @@
+"""Import bank / card statement CSV text with varied column names and amount styles."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+
+
+class StatementError(ValueError):
+    """Raised when the header is missing or lacks required columns."""
+
+
+_DATE_COLS = {"日付", "利用日", "ご利用日", "取引日", "date"}
+_AMOUNT_COLS = {"金額", "利用金額", "ご利用金額", "amount"}
+_CATEGORY_COLS = {"カテゴリ", "種別", "分類", "category"}
+_MEMO_COLS = {"メモ", "摘要", "内容", "ご利用店名", "利用店名", "備考", "memo"}
+_OUT_COLS = {"出金", "出金金額"}
+_IN_COLS = {"入金", "入金金額"}
+
+_DATE_RES = [
+    re.compile(r"(\d{4})-(\d{1,2})-(\d{1,2})"),
+    re.compile(r"(\d{4})/(\d{1,2})/(\d{1,2})"),
+    re.compile(r"(\d{4})年(\d{1,2})月(\d{1,2})日"),
+    re.compile(r"(\d{4})(\d{2})(\d{2})"),
+]
+
+
+def _norm_header(cell: str) -> str:
+    s = unicodedata.normalize("NFKC", cell.replace("﻿", ""))
+    return s.strip().casefold()
+
+
+def _find(headers: list[str], names: set[str]) -> int | None:
+    for i, h in enumerate(headers):
+        if h in {n.casefold() for n in names}:
+            return i
+    return None
+
+
+def _parse_date(raw: str) -> date:
+    s = unicodedata.normalize("NFKC", raw).strip()
+    for rx in _DATE_RES:
+        m = rx.fullmatch(s)
+        if m:
+            try:
+                return date(int(m[1]), int(m[2]), int(m[3]))
+            except ValueError:
+                break
+    raise ValueError(f"日付が不正です: {raw!r}")
+
+
+def _parse_amount(raw: str, col: str) -> int:
+    s = unicodedata.normalize("NFKC", raw)
+    for ch in "円¥,":
+        s = s.replace(ch, "")
+    s = "".join(s.split())
+    negative = False
+    while s and s[0] in "-−△▲":
+        negative = not negative if s[0] in "-−" else True
+        s = s[1:]
+    if not s.isascii() or not s.isdigit():
+        raise ValueError(f"金額({col})が整数ではありません: {raw!r}")
+    n = int(s)
+    return -n if negative else n
+
+
+def parse_statement(text: str) -> ImportResult:
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header: list[str] | None = None
+    for row in reader:
+        if any(c.strip() for c in row):
+            header = [_norm_header(c) for c in row]
+            break
+    if header is None:
+        raise StatementError("見出し行がありません")
+
+    i_date = _find(header, _DATE_COLS)
+    i_amount = _find(header, _AMOUNT_COLS)
+    i_out = _find(header, _OUT_COLS)
+    i_in = _find(header, _IN_COLS)
+    if i_date is None:
+        raise StatementError("日付の列が見つかりません")
+    if i_amount is None and i_out is None and i_in is None:
+        raise StatementError("金額(または出金/入金)の列が見つかりません")
+    i_cat = _find(header, _CATEGORY_COLS)
+    i_memo = _find(header, _MEMO_COLS)
+
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    for row in reader:
+        if not any(c.strip() for c in row):
+            continue
+        line = reader.line_num
+        if len(row) < len(header):
+            errors.append(
+                RowError(line, f"列の数が足りません({len(row)} < {len(header)})")
+            )
+            continue
+        try:
+            day = _parse_date(row[i_date])
+            if i_amount is not None:
+                amount = _parse_amount(row[i_amount], "金額")
+            else:
+                out_raw = row[i_out].strip() if i_out is not None else ""
+                in_raw = row[i_in].strip() if i_in is not None else ""
+                if not out_raw and not in_raw:
+                    raise ValueError("出金・入金がどちらも空です")
+                amount = (_parse_amount(out_raw, "出金") if out_raw else 0) - (
+                    _parse_amount(in_raw, "入金") if in_raw else 0
+                )
+        except ValueError as e:
+            errors.append(RowError(line, str(e)))
+            continue
+        category = row[i_cat].strip() if i_cat is not None else "未分類"
+        memo = row[i_memo].strip() if i_memo is not None else ""
+        expenses.append(Expense(day=day, category=category, amount=amount, memo=memo))
+    return ImportResult(expenses, errors)
