+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import ImportResult, RowError, StatementError, parse_statement
+from kakeibo.core import Expense
+
+
+def test_e2_1_basic_with_slash_date_and_comma_amount():
+    r = parse_statement('日付,摘要,金額\n2026/1/5,スーパー,"1,200"')
+    assert r.expenses == [Expense(date(2026, 1, 5), "未分類", 1200, "スーパー")]
+    assert r.errors == []
+
+
+def test_e2_2_bom_compact_date_fullwidth_yen():
+    r = parse_statement("﻿利用日,ご利用店名,利用金額\n20260105,カフェ,¥１２０円")
+    assert r.expenses == [Expense(date(2026, 1, 5), "未分類", 120, "カフェ")]
+
+
+def test_e2_3_withdrawal_and_deposit_columns():
+    r = parse_statement(
+        "日付,摘要,出金,入金\n2026-01-05,返金,,500\n2026-01-06,家賃,80000,"
+    )
+    assert [e.amount for e in r.expenses] == [-500, 80000]
+    assert r.errors == []
+
+
+def test_e2_4_japanese_date_and_triangle_negative():
+    r = parse_statement("日付,金額\n2026年1月5日,△300")
+    assert r.expenses == [Expense(date(2026, 1, 5), "未分類", -300, "")]
+
+
+def test_e2_5_bad_rows_collected_with_reasons():
+    text = (
+        "date,amount\n2026-02-30,100\n2026-02-01,12.5\n2026-02-02,abc\n2026-02-03,100"
+    )
+    r = parse_statement(text)
+    assert len(r.expenses) == 1
+    assert [e.line for e in r.errors] == [2, 3, 4]
+    assert "2026-02-30" in r.errors[0].reason
+    assert "12.5" in r.errors[1].reason
+    assert "abc" in r.errors[2].reason
+
+
+def test_e2_6_blank_lines_ignored():
+    r = parse_statement("日付,金額\n\n2026-01-05,100")
+    assert len(r.expenses) == 1
+    assert r.errors == []
+
+
+def test_e2_7_short_row_is_error():
+    r = parse_statement("日付,金額,メモ\n2026-01-05")
+    assert r.expenses == []
+    assert [e.line for e in r.errors] == [2]
+
+
+@pytest.mark.parametrize("text", ["摘要,金額\nx,1", "", "日付,摘要\n2026-01-05,x"])
+def test_e2_8_header_problems_raise(text):
+    with pytest.raises(StatementError):
+        parse_statement(text)
+
+
+def test_both_withdrawal_and_deposit_empty_is_error():
+    r = parse_statement("日付,出金,入金\n2026-01-05,,")
+    assert r.expenses == []
+    assert r.errors[0].line == 2
+
+
+def test_line_number_with_quoted_newline():
+    r = parse_statement('日付,金額,メモ\n2026-01-05,100,"a\nb"\n2026-01-06,xx,c')
+    assert len(r.expenses) == 1
+    assert r.errors == [RowError(4, r.errors[0].reason)]
+
+
+def test_category_column_and_extra_cells():
+    r = parse_statement("Date,Category,Amount,Memo\n2026-01-05, 食費 ,100,x,extra")
+    assert r.expenses == [Expense(date(2026, 1, 5), "食費", 100, "x")]
+
+
+def test_p1_p2_counts_and_order():
+    text = "日付,金額\n2026-01-03,1\nbad,2\n\n2026-01-01,3"
+    r: ImportResult = parse_statement(text)
+    assert len(r.expenses) + len(r.errors) == 3
+    assert [e.day for e in r.expenses] == [date(2026, 1, 3), date(2026, 1, 1)]
