@@ -0,0 +1,255 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankcsv import HeaderError, ImportResult, RowError, import_bank_csv
+from kakeibo.core import Expense
+
+
+@pytest.mark.parametrize(
+    ("text", "expenses", "skipped", "error_keys"),
+    [
+        pytest.param(
+            '利用日,利用店名,利用金額\n2026/1/5,ＮＥＴＦＬＩＸ,"1,490円"',
+            [Expense(date(2026, 1, 5), "未分類", 1490, "ＮＥＴＦＬＩＸ")],
+            0,
+            [],
+            id="E1-1",
+        ),
+        pytest.param(
+            "日付,出金額,入金額\n2026-01-05,,3000\n2026-01-06,500,",
+            [Expense(date(2026, 1, 6), "未分類", 500, "")],
+            1,
+            [],
+            id="E1-2",
+        ),
+        pytest.param(
+            "日付,金額\n2026-02-30,abc",
+            [],
+            0,
+            [(2, "日付"), (2, "金額")],
+            id="E1-3",
+        ),
+    ],
+)
+def test_examples(
+    text: str,
+    expenses: list[Expense],
+    skipped: int,
+    error_keys: list[tuple[int, str]],
+) -> None:
+    result = import_bank_csv(text)
+    assert result.expenses == expenses
+    assert result.skipped == skipped
+    assert [(e.line, e.column) for e in result.errors] == error_keys
+
+
+# --- R1: BOM, delimiter detection, quoting, line numbers ---
+
+
+def test_bom_is_stripped() -> None:
+    result = import_bank_csv("﻿日付,金額\n2026-01-05,300")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 300, "")]
+
+
+def test_tab_delimiter_is_detected() -> None:
+    result = import_bank_csv("日付\t金額\t摘要\n2026-01-05\t300\tコンビニ")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 300, "コンビニ")]
+
+
+def test_tie_in_delimiter_count_uses_comma() -> None:
+    # header has one comma and one tab -> tie -> comma; the tab stays inside a cell
+    result = import_bank_csv("日付,金額,摘要\t\n2026-01-05,300,x")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 300, "x")]
+
+
+def test_quoted_newline_keeps_record_start_line() -> None:
+    text = '日付,金額,摘要\n2026-01-05,300,"a\nb"\n2026-01-06,abc,x'
+    result = import_bank_csv(text)
+    assert [(e.line, e.column) for e in result.errors] == [(4, "金額")]
+
+
+def test_blank_lines_are_ignored_and_not_skipped() -> None:
+    result = import_bank_csv("日付,金額\n\n2026-01-05,300\n\n")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 300, "")]
+    assert result.skipped == 0
+    assert result.errors == []
+
+
+# --- R2: column names ---
+
+
+def test_header_names_match_case_insensitively_and_nfkc() -> None:
+    result = import_bank_csv(" ＤＡＴＥ , Amount ,MEMO\n2026-01-05,300,x")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 300, "x")]
+
+
+def test_category_and_memo_columns_are_read() -> None:
+    result = import_bank_csv("取引日,金額,摘要,費目\n2026-01-05,300,店,食費")
+    assert result.expenses == [Expense(date(2026, 1, 5), "食費", 300, "店")]
+
+
+def test_missing_date_column_raises_header_error() -> None:
+    with pytest.raises(HeaderError, match="日付"):
+        import_bank_csv("金額,摘要\n300,x")
+
+
+def test_missing_amount_column_raises_header_error() -> None:
+    with pytest.raises(HeaderError, match="金額"):
+        import_bank_csv("日付,摘要\n2026-01-05,x")
+
+
+def test_empty_input_gives_empty_result() -> None:
+    assert import_bank_csv("") == ImportResult([], [], 0)
+
+
+def test_header_only_gives_empty_result() -> None:
+    assert import_bank_csv("日付,金額") == ImportResult([], [], 0)
+
+
+# --- R3: dates ---
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026.1.5",
+        "2026年1月5日",
+        "20260105",
+        "２０２６/１/５",
+    ],
+)
+def test_date_formats(raw: str) -> None:
+    result = import_bank_csv(f"日付,金額\n{raw},300")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 300, "")]
+
+
+def test_trailing_time_is_ignored() -> None:
+    result = import_bank_csv("日付,金額\n2026/01/05 12:30,300")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 300, "")]
+
+
+def test_nonexistent_date_is_error_with_original_text() -> None:
+    result = import_bank_csv("日付,金額\n2026/2/30,300")
+    assert len(result.errors) == 1
+    err = result.errors[0]
+    assert (err.line, err.column, err.value) == (2, "日付", "2026/2/30")
+    assert "2026/2/30" in err.reason
+
+
+def test_wareki_is_error() -> None:
+    result = import_bank_csv("日付,金額\n令和8年1月5日,300")
+    assert [(e.column, e.value) for e in result.errors] == [("日付", "令和8年1月5日")]
+    assert result.expenses == []
+
+
+# --- R4: amounts ---
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        ("1,490円", 1490),
+        ("¥1,490", 1490),
+        ("1490JPY", 1490),
+        (" 1 490 ", 1490),
+        ("0", 0),
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+    ],
+)
+def test_amount_forms(raw: str, expected: int) -> None:
+    result = import_bank_csv(f'日付,金額\n2026-01-05,"{raw}"')
+    assert [e.amount for e in result.expenses] == [expected]
+    assert result.errors == []
+
+
+@pytest.mark.parametrize("raw", ["12.5", "", "abc", "--5", "(500", "+300"])
+def test_invalid_amounts_are_errors(raw: str) -> None:
+    result = import_bank_csv(f"日付,金額\n2026-01-05,{raw}")
+    assert result.expenses == []
+    assert [(e.line, e.column, e.value) for e in result.errors] == [(2, "金額", raw)]
+
+
+def test_negative_amount_is_refund_in_single_column() -> None:
+    result = import_bank_csv("日付,金額\n2026-01-05,-300")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", -300, "")]
+
+
+# --- R5: withdrawal / deposit form ---
+
+
+def test_withdrawal_negative_sign_is_accepted() -> None:
+    result = import_bank_csv("日付,出金額,入金額\n2026-01-05,(200),")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", -200, "")]
+
+
+def test_both_withdrawal_and_deposit_empty_is_error() -> None:
+    result = import_bank_csv("日付,出金額,入金額\n2026-01-05,,")
+    assert [(e.line, e.column) for e in result.errors] == [(2, "出金額")]
+    assert result.skipped == 0
+
+
+def test_both_withdrawal_and_deposit_filled_is_error() -> None:
+    result = import_bank_csv("日付,出金額,入金額\n2026-01-05,100,100")
+    assert [(e.line, e.column) for e in result.errors] == [(2, "出金額")]
+    assert result.expenses == []
+    assert result.skipped == 0
+
+
+def test_invalid_deposit_value_is_error_not_skipped() -> None:
+    result = import_bank_csv("日付,出金額,入金額\n2026-01-05,,abc")
+    assert [(e.column, e.value) for e in result.errors] == [("入金額", "abc")]
+    assert result.skipped == 0
+
+
+def test_deposit_only_rows_are_skipped_and_counted() -> None:
+    result = import_bank_csv("日付,出金,入金\n2026-01-05,,3000\n2026-01-06,,4000")
+    assert result.expenses == []
+    assert result.skipped == 2
+
+
+def test_withdrawal_withdrawal_alias_with_amount_sign() -> None:
+    result = import_bank_csv("日付,出金\n2026-01-05,△500")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", -500, "")]
+
+
+# --- R6: row shape ---
+
+
+def test_column_count_mismatch_is_single_row_error() -> None:
+    result = import_bank_csv("日付,金額\n2026-01-05,300,余分\n2026-01-06,400")
+    assert [(e.line, e.column) for e in result.errors] == [(2, "(行)")]
+    assert result.expenses == [Expense(date(2026, 1, 6), "未分類", 400, "")]
+
+
+def test_results_keep_input_order() -> None:
+    result = import_bank_csv("日付,金額\n2026-01-09,1\n2026-01-03,2\n2026-01-05,3")
+    assert [e.day for e in result.expenses] == [
+        date(2026, 1, 9),
+        date(2026, 1, 3),
+        date(2026, 1, 5),
+    ]
+
+
+# --- R7 / D1: errors ---
+
+
+def test_error_value_is_raw_text_and_column_is_original_header() -> None:
+    result = import_bank_csv("Date,ＡＭＯＵＮＴ\n 2026-02-30 ,abc")
+    assert result.errors == [
+        RowError(2, "Date", " 2026-02-30 ", result.errors[0].reason),
+        RowError(2, "ＡＭＯＵＮＴ", "abc", result.errors[1].reason),
+    ]
+
+
+def test_all_errors_of_a_row_are_collected() -> None:
+    result = import_bank_csv("日付,金額\n2026-02-30,abc\n2026-01-05,300")
+    assert [(e.line, e.column) for e in result.errors] == [(2, "日付"), (2, "金額")]
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 300, "")]
