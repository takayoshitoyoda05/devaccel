+"""前月比レポート: 指定月と暦の前の月のカテゴリ別合計を比較する(純粋関数)。"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense, monthly_totals
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryDiff:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    pct: float | None
+    status: str  # "increased" | "decreased" | "new" | "gone" | "same"
+
+
+def _previous_month(month: str) -> str:
+    year, mon = int(month[:4]), int(month[5:])
+    if mon == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mon - 1:02d}"
+
+
+def compare_with_previous(rows: list[Expense], month: str) -> list[CategoryDiff]:
+    """month(YYYY-MM)と暦の前の月のカテゴリ別合計を比較する。
+
+    並びは abs(delta) の降順、同じなら category の昇順。両方の月が空なら空のリスト。
+    """
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+    totals = monthly_totals(rows)
+    prev_month = _previous_month(month)
+    cur_cats = totals.get(month, {})
+    prev_cats = totals.get(prev_month, {})
+
+    out: list[CategoryDiff] = []
+    for cat in set(cur_cats) | set(prev_cats):
+        in_cur = cat in cur_cats
+        in_prev = cat in prev_cats
+        current = cur_cats.get(cat, 0)
+        previous = prev_cats.get(cat, 0)
+        delta = current - previous
+        pct = None if previous == 0 else round(delta / previous * 100, 1)
+        if in_prev and not in_cur:
+            status = "gone"
+        elif in_cur and not in_prev:
+            status = "new"
+        elif current == previous:
+            status = "same"
+        elif current > previous:
+            status = "increased"
+        else:
+            status = "decreased"
+        out.append(CategoryDiff(cat, previous, current, delta, pct, status))
+
+    out.sort(key=lambda d: (-abs(d.delta), d.category))
+    return out
+
+
+_LABELS = {
+    "increased": "増",
+    "decreased": "減",
+    "new": "新規",
+    "gone": "なくなった",
+    "same": "変化なし",
+}
+
+
+def format_diff(diffs: list[CategoryDiff]) -> str:
+    """1 カテゴリ 1 行で整形する。差分が空なら「変化なし」の 1 行。末尾に改行は付けない。"""
+    if not diffs:
+        return "変化なし"
+    lines: list[str] = []
+    for d in diffs:
+        line = f"{d.category}  {d.delta:+,}円"
+        if d.pct is not None:
+            line += f" ({d.pct:+.1f}%)"
+        line += f" {_LABELS[d.status]}"
+        lines.append(line)
+    return "\n".join(lines)
