--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,108 @@
+"""Detect recurring monthly expenses and predict the next occurrence."""
+
+from __future__ import annotations
+
+import re
+import statistics
+import unicodedata
+from calendar import monthrange
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+# 末尾の「 12」「#12」「No.3」を取り除く(R1)
+_TRAILING_RE = re.compile(r"\s*(?:#\s*\d+|no\.\s*\d+|\d+)$")
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int
+    count: int
+    last_date: date
+    next_date: date
+
+
+def _normalize_memo(memo: str) -> str:
+    s = unicodedata.normalize("NFKC", memo).casefold()
+    s = " ".join(s.split())
+    while True:
+        t = _TRAILING_RE.sub("", s).rstrip()
+        if t == s:
+            return s
+        s = t
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month - 1
+
+
+def _series(
+    category: str, norm: str, items: list[Expense], min_count: int
+) -> tuple[Recurring, str] | None:
+    # R2: 中央値の ±10% を外れた明細は除く
+    med = statistics.median_low([e.amount for e in items])
+    kept = [e for e in items if abs(e.amount - med) * 10 <= med]
+
+    # R3: 同じ月は最も早い日の 1 件だけ
+    per_month: dict[int, Expense] = {}
+    for e in sorted(kept, key=lambda e: e.day):
+        per_month.setdefault(_month_index(e.day), e)
+    if not per_month:
+        return None
+
+    # 最新の連続月の並びを求める
+    months = sorted(per_month)
+    run = [months[0]]
+    for m in months[1:]:
+        if m == run[-1] + 1:
+            run.append(m)
+        else:
+            run = [m]
+    if len(run) < min_count:
+        return None
+
+    # R4: 最新の明細を基準にする
+    latest = per_month[run[-1]]
+
+    # R5: 次回は翌月。日は系列内の最大日を翌月末日で切り詰める
+    max_day = max(per_month[i].day.day for i in run)
+    next_idx = run[-1] + 1
+    next_year, next_month = divmod(next_idx, 12)
+    next_month += 1
+    day = min(max_day, monthrange(next_year, next_month)[1])
+
+    recurring = Recurring(
+        category=category,
+        memo=latest.memo,
+        amount=latest.amount,
+        count=len(run),
+        last_date=latest.day,
+        next_date=date(next_year, next_month, day),
+    )
+    return recurring, norm
+
+
+def find_recurring(rows: list[Expense], min_count: int = 3) -> list[Recurring]:
+    """Return recurring monthly expenses, sorted by next_date, category, memo."""
+    if min_count < 2:
+        raise ValueError("min_count は 2 以上である必要があります")
+
+    # R1: 系列の鍵は (カテゴリ, 正規化メモ)。返金・0 円は無視(R2)
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        if e.amount <= 0:
+            continue
+        groups.setdefault((e.category, _normalize_memo(e.memo)), []).append(e)
+
+    found: list[tuple[Recurring, str]] = []
+    for (category, norm), items in groups.items():
+        result = _series(category, norm, items, min_count)
+        if result is not None:
+            found.append(result)
+
+    # R6: 並び順
+    found.sort(key=lambda p: (p[0].next_date, p[0].category, p[1]))
+    return [r for r, _ in found]
diff --git a/src/kakeibo/search.py b/src/kakeibo/search.py
new file mode 100644
index 0000000..29e64c6
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,130 @@
+"""Condition search over expenses (pure functions, standard library only)."""
+
+from __future__ import annotations
+
+import unicodedata
+from dataclasses import dataclass
+from datetime import date, datetime
+
+from kakeibo.core import Expense
+
+
+def _is_int(v: object) -> bool:
+    return isinstance(v, int) and not isinstance(v, bool)
+
+
+def _is_day(v: object) -> bool:
+    return isinstance(v, date) and not isinstance(v, datetime)
+
+
+def _normalize_text(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).casefold()
+
+
+@dataclass(frozen=True)
+class Cond:
+    """Leaf condition. Every specified (non-None) field must match (AND)."""
+
+    category: str | None = None
+    min_amount: int | None = None
+    max_amount: int | None = None
+    memo_contains: str | None = None
+    since: date | None = None
+    until: date | None = None
+
+    def __post_init__(self) -> None:
+        if self.category is not None and not isinstance(self.category, str):
+            raise TypeError("category は str または None である必要があります")
+        for name in ("min_amount", "max_amount"):
+            v = getattr(self, name)
+            if v is not None and not _is_int(v):
+                raise TypeError(f"{name} は int または None である必要があります")
+        if self.memo_contains is not None and not isinstance(self.memo_contains, str):
+            raise TypeError("memo_contains は str または None である必要があります")
+        for name in ("since", "until"):
+            v = getattr(self, name)
+            if v is not None and not _is_day(v):
+                raise TypeError(f"{name} は date または None である必要があります")
+        if (
+            self.min_amount is not None
+            and self.max_amount is not None
+            and self.min_amount > self.max_amount
+        ):
+            raise ValueError("min_amount は max_amount 以下である必要があります")
+        if (
+            self.since is not None
+            and self.until is not None
+            and self.since > self.until
+        ):
+            raise ValueError("since は until 以前である必要があります")
+
+
+@dataclass(frozen=True, init=False)
+class And:
+    items: tuple[Query, ...]
+
+    def __init__(self, *items: Query) -> None:
+        _check_items(items)
+        object.__setattr__(self, "items", tuple(items))
+
+
+@dataclass(frozen=True, init=False)
+class Or:
+    items: tuple[Query, ...]
+
+    def __init__(self, *items: Query) -> None:
+        _check_items(items)
+        object.__setattr__(self, "items", tuple(items))
+
+
+@dataclass(frozen=True)
+class Not:
+    item: Query
+
+    def __post_init__(self) -> None:
+        _check_items((self.item,))
+
+
+Query = Cond | And | Or | Not
+
+
+def _check_items(items: tuple[object, ...]) -> None:
+    for item in items:
+        if not isinstance(item, (Cond, And, Or, Not)):
+            raise TypeError(f"Query ではありません: {item!r}")
+
+
+def _cond_matches(e: Expense, c: Cond) -> bool:
+    if c.category is not None and e.category != c.category.strip():
+        return False
+    if c.min_amount is not None and e.amount < c.min_amount:
+        return False
+    if c.max_amount is not None and e.amount > c.max_amount:
+        return False
+    if c.memo_contains is not None:
+        needle = _normalize_text(c.memo_contains)
+        if needle not in _normalize_text(e.memo):
+            return False
+    if c.since is not None and e.day < c.since:
+        return False
+    return c.until is None or e.day <= c.until
+
+
+def matches(e: Expense, query: Query) -> bool:
+    """Return True if expense ``e`` satisfies ``query``."""
+    if isinstance(query, Cond):
+        return _cond_matches(e, query)
+    if isinstance(query, And):
+        return all(matches(e, q) for q in query.items)
+    if isinstance(query, Or):
+        return any(matches(e, q) for q in query.items)
+    if isinstance(query, Not):
+        return not matches(e, query.item)
+    raise TypeError(f"Query ではありません: {query!r}")
+
+
+def search(rows: list[Expense], query: Query) -> list[Expense]:
+    """Return the expenses matching ``query``, in input order. ``rows`` is not modified."""
+    if not isinstance(query, (Cond, And, Or, Not)):
+        raise TypeError(f"Query ではありません: {query!r}")
+    return [e for e in rows if matches(e, query)]
diff --git a/tests/test_bankcsv.py b/tests/test_bankcsv.py
