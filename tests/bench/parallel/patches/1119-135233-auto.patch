+"""Tests for kakeibo.recurring."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring
+
+
+def _e(y: int, m: int, d: int, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(day=date(y, m, d), category=category, amount=amount, memo=memo)
+
+
+def _e2_1() -> tuple[list[Expense], list[Recurring]]:
+    rows = [
+        _e(2026, 1, 25, "家賃", 80000),
+        _e(2026, 2, 25, "家賃", 80000),
+        _e(2026, 3, 25, "家賃", 80000),
+    ]
+    return rows, [Recurring("家賃", "", 80000, 3, date(2026, 3, 25), date(2026, 4, 25))]
+
+
+def _e2_2() -> tuple[list[Expense], list[Recurring]]:
+    rows = [
+        _e(2026, 1, 5, "食費", 1000, "A"),
+        _e(2026, 2, 5, "食費", 1000, "A"),
+        _e(2026, 3, 5, "食費", 1000, "A"),
+        _e(2026, 1, 20, "食費", 1000, "B"),
+        _e(2026, 2, 20, "食費", 1000, "B"),
+        _e(2026, 3, 20, "食費", 1000, "B"),
+    ]
+    return rows, [
+        Recurring("食費", "A", 1000, 3, date(2026, 3, 5), date(2026, 4, 5)),
+        Recurring("食費", "B", 1000, 3, date(2026, 3, 20), date(2026, 4, 20)),
+    ]
+
+
+def _e2_3() -> tuple[list[Expense], list[Recurring]]:
+    rows = [
+        _e(2026, 1, 31, "通信", 5000),
+        _e(2026, 2, 28, "通信", 5000),
+        _e(2026, 3, 31, "通信", 5000),
+    ]
+    return rows, [Recurring("通信", "", 5000, 3, date(2026, 3, 31), date(2026, 4, 30))]
+
+
+@pytest.mark.parametrize(
+    ("rows", "expected"),
+    [
+        pytest.param(*_e2_1(), id="E2-1"),
+        pytest.param(*_e2_2(), id="E2-2"),
+        pytest.param(*_e2_3(), id="E2-3"),
+    ],
+)
+def test_find_recurring_table(rows: list[Expense], expected: list[Recurring]) -> None:
+    assert find_recurring(rows) == expected
+
+
+def test_min_count_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
