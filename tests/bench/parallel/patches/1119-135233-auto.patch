@@ -0,0 +1,230 @@
+"""Tests for kakeibo.search (condition search)."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import And, Cond, Not, Or, matches, search
+
+
+def _e(day: date, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- 仕様の例の表 (ID をテストに残す) ---------------------------------------
+
+
+def test_E3_1_exact_amount_range_matches() -> None:
+    row = _e(date(2024, 1, 5), "食費", 1000)
+    assert matches(row, Cond(min_amount=1000, max_amount=1000)) is True  # E3-1
+
+
+def test_E3_2_or_and_not_combination() -> None:
+    query = Or(
+        Cond(category="食費"),
+        And(Cond(memo_contains="ｎｅｔｆｌｉｘ"), Not(Cond(max_amount=999))),
+    )
+    rows = [
+        _e(date(2024, 1, 1), "食費", 300, "lunch"),  # 食費 -> 一致
+        _e(date(2024, 1, 2), "娯楽", 1500, "Netflix"),  # 1000 円以上 + NETFLIX -> 一致
+        _e(date(2024, 1, 3), "娯楽", 999, "NETFLIX"),  # 999 円以下 -> 不一致
+        _e(date(2024, 1, 4), "娯楽", 1500, "Spotify"),  # メモ不一致 -> 不一致
+    ]
+    assert search(rows, query) == [rows[0], rows[1]]  # E3-2
+
+
+def test_E3_3_min_greater_than_max_raises() -> None:
+    with pytest.raises(ValueError):
+        Cond(min_amount=5, max_amount=1)  # E3-3
+
+
+# --- Cond の規則 ------------------------------------------------------------
+
+
+def test_empty_cond_is_always_true() -> None:
+    assert matches(_e(date(2024, 1, 1), "x", -5), Cond()) is True
+
+
+@pytest.mark.parametrize(
+    ("cond", "expected"),
+    [
+        pytest.param(Cond(category="食費"), True, id="R2-category-exact"),
+        pytest.param(Cond(category=" 食費 "), True, id="R2-category-strip-query"),
+        pytest.param(Cond(category="食"), False, id="R2-category-no-partial"),
+        pytest.param(Cond(category="食費x"), False, id="R2-category-no-suffix"),
+        pytest.param(Cond(min_amount=1000), True, id="R2-min-inclusive"),
+        pytest.param(Cond(min_amount=1001), False, id="R2-min-exclusive-below"),
+        pytest.param(Cond(max_amount=1000), True, id="R2-max-inclusive"),
+        pytest.param(Cond(max_amount=999), False, id="R2-max-exclusive-above"),
+        pytest.param(
+            Cond(min_amount=-1000, max_amount=-1000), False, id="R1-amount-not-equal"
+        ),
+        pytest.param(Cond(memo_contains="NET"), True, id="R3-substring"),
+        pytest.param(Cond(memo_contains="ｎｅｔ"), True, id="R3-nfkc-query"),
+        pytest.param(Cond(memo_contains="ＮＥＴ"), True, id="R3-nfkc-query-upper"),
+        pytest.param(Cond(memo_contains="netflix"), True, id="R3-ignore-case"),
+        pytest.param(Cond(memo_contains=""), True, id="R3-empty-memo-query"),
+        pytest.param(Cond(memo_contains="spotify"), False, id="R3-no-match"),
+        pytest.param(Cond(since=date(2024, 1, 5)), True, id="R2-since-inclusive"),
+        pytest.param(Cond(since=date(2024, 1, 6)), False, id="R2-since-exclusive"),
+        pytest.param(Cond(until=date(2024, 1, 5)), True, id="R2-until-inclusive"),
+        pytest.param(Cond(until=date(2024, 1, 4)), False, id="R2-until-exclusive"),
+        pytest.param(
+            Cond(category="食費", min_amount=1000, memo_contains="net"),
+            True,
+            id="R1-all-and",
+        ),
+        pytest.param(
+            Cond(category="食費", min_amount=2000, memo_contains="net"),
+            False,
+            id="R1-all-and-one-fails",
+        ),
+    ],
+)
+def test_cond_rules(cond: Cond, expected: bool) -> None:
+    row = _e(date(2024, 1, 5), "食費", 1000, "NETFLIX")
+    assert matches(row, cond) is expected
+
+
+def test_cond_min_greater_than_max_raises() -> None:
+    with pytest.raises(ValueError):
+        Cond(min_amount=2, max_amount=1)
+
+
+def test_cond_since_after_until_raises() -> None:
+    with pytest.raises(ValueError):
+        Cond(since=date(2024, 2, 1), until=date(2024, 1, 1))
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        pytest.param({"min_amount": "1"}, id="R5-min-amount-str"),
+        pytest.param({"max_amount": 1.0}, id="R5-max-amount-float"),
+        pytest.param({"category": 1}, id="R5-category-int"),
+        pytest.param({"memo_contains": b"x"}, id="R5-memo-bytes"),
+        pytest.param({"since": "2024-01-01"}, id="R5-since-str"),
+        pytest.param({"until": 20240101}, id="R5-until-int"),
+    ],
+)
+def test_cond_wrong_type_raises(kwargs: dict[str, object]) -> None:
+    with pytest.raises(TypeError):
+        Cond(**kwargs)  # type: ignore[arg-type]
+
+
+# --- And / Or / Not ---------------------------------------------------------
+
+
+def test_empty_and_is_true() -> None:
+    assert matches(_e(date(2024, 1, 1), "x", 1), And()) is True  # R4
+
+
+def test_empty_or_is_false() -> None:
+    assert matches(_e(date(2024, 1, 1), "x", 1), Or()) is False  # R4
+
+
+def test_not_negates() -> None:
+    row = _e(date(2024, 1, 1), "x", 1)
+    assert matches(row, Not(Cond(category="x"))) is False  # R4
+    assert matches(row, Not(Cond(category="y"))) is True  # R4
+
+
+def test_nested_structure_decides_precedence() -> None:
+    row = _e(date(2024, 1, 1), "食費", 100)
+    # Or(A, And(B, C)) と And(Or(A, B), C) は構造が違うので結果が変わる
+    a = Cond(category="食費")
+    b = Cond(category="娯楽")
+    c = Cond(max_amount=50)
+    assert matches(row, Or(a, And(b, c))) is True  # R4
+    assert matches(row, And(Or(a, b), c)) is False  # R4
+
+
+def test_and_or_accept_variadic_items() -> None:
+    row = _e(date(2024, 1, 1), "食費", 100)
+    assert matches(row, And(Cond(category="食費"), Cond(min_amount=1))) is True
+    assert matches(row, Or(Cond(category="x"), Cond(min_amount=1))) is True
+
+
+def test_and_or_store_items_as_tuple() -> None:
+    a = And(Cond(), Cond())
+    o = Or(Cond(), Cond())
+    assert isinstance(a.items, tuple)
+    assert isinstance(o.items, tuple)
+    assert len(a.items) == 2
+    assert len(o.items) == 2
+
+
+def test_frozen_dataclasses_reject_mutation() -> None:
+    cond = Cond(category="食費")
+    with pytest.raises(AttributeError):
+        cond.category = "娯楽"  # type: ignore[misc]
+    with pytest.raises(AttributeError):
+        Not(Cond()).item = Cond()  # type: ignore[misc]
+
+
+@pytest.mark.parametrize(
+    "build",
+    [
+        pytest.param(lambda: And(Cond(), "x"), id="R5-and-item-str"),  # type: ignore[arg-type]
+        pytest.param(lambda: Or({"category": "食費"}), id="R5-or-item-dict"),  # type: ignore[arg-type]
+        pytest.param(lambda: Not("食費"), id="R5-not-item-str"),  # type: ignore[arg-type]
+    ],
+)
+def test_non_query_items_raise_type_error(build: Callable[[], object]) -> None:
+    with pytest.raises(TypeError):
+        build()
+
+
+# --- search -----------------------------------------------------------------
+
+
+def test_search_preserves_order_and_does_not_mutate_input() -> None:
+    rows = [
+        _e(date(2024, 3, 1), "食費", 500),
+        _e(date(2024, 1, 1), "食費", 2000),
+        _e(date(2024, 2, 1), "娯楽", 3000),
+        _e(date(2024, 4, 1), "食費", 1500),
+    ]
+    snapshot = list(rows)
+    result = search(rows, Cond(category="食費", min_amount=1000))
+    assert result == [rows[1], rows[3]]
+    assert rows == snapshot
+
+
+def test_search_empty_input_returns_empty_list() -> None:
+    assert search([], Cond(category="食費")) == []
+
+
+def test_search_returns_new_list() -> None:
+    rows = [_e(date(2024, 1, 1), "食費", 1)]
+    result = search(rows, Cond())
+    assert result == rows
+    assert result is not rows
+
+
+def test_search_with_no_match_returns_empty_list() -> None:
+    rows = [_e(date(2024, 1, 1), "食費", 1)]
+    assert search(rows, Cond(category="娯楽")) == []
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        pytest.param({"category": "食費"}, id="R5-dict"),
+        pytest.param("食費", id="R5-str"),
+        pytest.param(None, id="R5-none"),
+    ],
+)
+def test_search_non_query_raises_type_error(query: object) -> None:
+    rows = [_e(date(2024, 1, 1), "食費", 1)]
+    with pytest.raises(TypeError):
+        search(rows, query)  # type: ignore[arg-type]
+
+
+def test_matches_non_query_raises_type_error() -> None:
+    with pytest.raises(TypeError):
+        matches(_e(date(2024, 1, 1), "食費", 1), {"category": "食費"})  # type: ignore[arg-type]
