+++ b/tests/test_monthdiff.py
@@ -0,0 +1,157 @@
+"""Tests for kakeibo.monthdiff (前月比レポート)."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import CategoryDiff, compare_with_previous, format_diff
+
+
+def _e(y: int, m: int, category: str, amount: int) -> Expense:
+    return Expense(day=date(y, m, 1), category=category, amount=amount, memo="")
+
+
+# E4-1 / E4-2 / E4-3 は仕様の例の表そのまま。
+@pytest.mark.parametrize(
+    ("rows", "month", "expected"),
+    [
+        pytest.param(
+            [_e(2026, 10, "食費", 1000), _e(2026, 11, "食費", 1150)],
+            "2026-11",
+            [CategoryDiff("食費", 1000, 1150, 150, 15.0, "increased")],
+            id="E4-1",
+        ),
+        pytest.param(
+            [_e(2026, 12, "交通費", 300)],
+            "2026-12",
+            [CategoryDiff("交通費", 0, 300, 300, None, "new")],
+            id="E4-2",
+        ),
+        pytest.param(
+            [_e(2026, 10, "食費", 1000)],
+            "2026-1",
+            ValueError,
+            id="E4-3",
+        ),
+    ],
+)
+def test_spec_examples(
+    rows: list[Expense],
+    month: str,
+    expected: list[CategoryDiff] | type[Exception],
+) -> None:
+    if expected is ValueError:
+        with pytest.raises(ValueError):
+            compare_with_previous(rows, month)
+    else:
+        assert compare_with_previous(rows, month) == expected
+
+
+# R1: 月の形式
+@pytest.mark.parametrize(
+    "month", ["2026-00", "2026-13", "2026-1", "202611", "2026/11", "abcd-ef", ""]
+)
+def test_invalid_month_raises(month: str) -> None:
+    with pytest.raises(ValueError):
+        compare_with_previous([], month)
+
+
+# R1: 前の月は暦の前の月(2026-01 の前は 2025-12)
+def test_previous_month_crosses_year() -> None:
+    rows = [_e(2025, 12, "食費", 800), _e(2026, 1, "食費", 1000)]
+    assert compare_with_previous(rows, "2026-01") == [
+        CategoryDiff("食費", 800, 1000, 200, 25.0, "increased")
+    ]
+
+
+# R2: gone / same / decreased
+def test_gone_same_decreased() -> None:
+    rows = [
+        _e(2026, 10, "娯楽", 500),  # 今月なし → gone
+        _e(2026, 10, "通信", 2000),  # 同額 → same
+        _e(2026, 10, "食費", 1000),  # 減 → decreased
+        _e(2026, 11, "通信", 2000),
+        _e(2026, 11, "食費", 800),
+    ]
+    got = {d.category: d for d in compare_with_previous(rows, "2026-11")}
+    assert got["娯楽"] == CategoryDiff("娯楽", 500, 0, -500, -100.0, "gone")
+    assert got["通信"] == CategoryDiff("通信", 2000, 2000, 0, 0.0, "same")
+    assert got["食費"] == CategoryDiff("食費", 1000, 800, -200, -20.0, "decreased")
+
+
+# R3: 前月 0 円の増減率は None
+def test_pct_none_when_previous_zero_total() -> None:
+    rows = [
+        _e(2026, 10, "食費", 500),
+        _e(2026, 10, "食費", -500),  # 返金で前月合計 0
+        _e(2026, 11, "食費", 300),
+    ]
+    assert compare_with_previous(rows, "2026-11") == [
+        CategoryDiff("食費", 0, 300, 300, None, "increased")
+    ]
+
+
+# R3: pct は小数 1 桁に丸める
+def test_pct_rounded_to_one_decimal() -> None:
+    rows = [_e(2026, 10, "食費", 3), _e(2026, 11, "食費", 4)]
+    [d] = compare_with_previous(rows, "2026-11")
+    assert d.pct == 33.3
+
+
+# R4: abs(delta) 降順、同じなら category 昇順
+def test_sorted_by_abs_delta_then_category() -> None:
+    rows = [
+        _e(2026, 10, "B", 100),
+        _e(2026, 10, "A", 100),
+        _e(2026, 10, "C", 1000),
+        _e(2026, 11, "B", 200),  # +100
+        _e(2026, 11, "A", 0),  # -100
+        _e(2026, 11, "C", 1000),  # 0
+        _e(2026, 11, "D", -300),  # new, delta -300
+    ]
+    cats = [d.category for d in compare_with_previous(rows, "2026-11")]
+    assert cats == ["D", "A", "B", "C"]
+
+
+# R4: 両方の月が空なら空のリスト
+def test_both_months_empty_returns_empty() -> None:
+    rows = [_e(2026, 3, "食費", 100)]
+    assert compare_with_previous(rows, "2026-11") == []
+
+
+# R5: format_diff
+def test_format_increase_line() -> None:
+    diffs = [CategoryDiff("食費", 1000, 2200, 1200, 120.0, "increased")]
+    assert format_diff(diffs) == "食費  +1,200円 (+120.0%) 増"
+
+
+def test_format_decrease_line() -> None:
+    diffs = [CategoryDiff("食費", 1000, 800, -200, -20.0, "decreased")]
+    assert format_diff(diffs) == "食費  -200円 (-20.0%) 減"
+
+
+def test_format_new_and_gone_and_same() -> None:
+    diffs = [
+        CategoryDiff("交通費", 0, 300, 300, None, "new"),
+        CategoryDiff("娯楽", 500, 0, -500, -100.0, "gone"),
+        CategoryDiff("通信", 2000, 2000, 0, 0.0, "same"),
+    ]
+    expected = "交通費  +300円 新規\n娯楽  -500円 (-100.0%) なくなった\n通信  +0円 (+0.0%) 変化なし"
+    assert format_diff(diffs) == expected
+
+
+def test_format_empty_is_single_line() -> None:
+    assert format_diff([]) == "変化なし"
+
+
+def test_format_no_trailing_newline() -> None:
+    diffs = [
+        CategoryDiff("食費", 1000, 1100, 100, 10.0, "increased"),
+        CategoryDiff("交通費", 0, 300, 300, None, "new"),
+    ]
+    out = format_diff(diffs)
+    assert out.count("\n") == 1
+    assert not out.endswith("\n")
