@@ -0,0 +1,250 @@
+"""Import bank / card CSV exports into Expense records (pure functions, no I/O)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str
+    value: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+    skipped: int
+
+
+class HeaderError(ValueError):
+    """Raised when the header lacks a required column."""
+
+
+_ROLE_ALIASES: dict[str, tuple[str, ...]] = {
+    "date": ("日付", "利用日", "取引日", "ご利用日", "date"),
+    "amount": ("金額", "利用金額", "ご利用金額", "amount"),
+    "withdrawal": ("出金額", "出金", "お支払金額", "支払", "withdrawal"),
+    "deposit": ("入金額", "入金", "預入", "deposit"),
+    "memo": ("摘要", "メモ", "利用店名", "ご利用店名", "内容", "description", "memo"),
+    "category": ("カテゴリ", "分類", "費目", "category"),
+}
+
+_UNCATEGORIZED = "未分類"
+
+_TIME_SUFFIX_RE = re.compile(r"\s+[0-9]{1,2}:[0-9]{2}(:[0-9]{2})?$")
+_DATE_SEP_RE = re.compile(
+    r"(?P<y>[0-9]{4})(?P<sep>[-/.])(?P<m>[0-9]{1,2})(?P=sep)(?P<d>[0-9]{1,2})"
+)
+_DATE_KANJI_RE = re.compile(r"(?P<y>[0-9]{4})年(?P<m>[0-9]{1,2})月(?P<d>[0-9]{1,2})日")
+_DATE_COMPACT_RE = re.compile(r"(?P<y>[0-9]{4})(?P<m>[0-9]{2})(?P<d>[0-9]{2})")
+_WAREKI_RE = re.compile(r"(明治|大正|昭和|平成|令和)")
+_AMOUNT_NOISE_RE = re.compile(r"[\s,¥円]|JPY", re.IGNORECASE)
+_DIGITS_RE = re.compile(r"[0-9]+")
+_DECIMAL_RE = re.compile(r"[0-9]*\.[0-9]+|[0-9]+\.")
+
+
+def _norm(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip().casefold()
+
+
+_ALIAS_TO_ROLE: dict[str, str] = {
+    _norm(alias): role for role, aliases in _ROLE_ALIASES.items() for alias in aliases
+}
+
+
+def _is_blank_text(s: str) -> bool:
+    return unicodedata.normalize("NFKC", s).strip() == ""
+
+
+def _is_blank_record(rec: list[str]) -> bool:
+    return not rec or (len(rec) == 1 and rec[0].strip() == "")
+
+
+def _detect_delimiter(text: str) -> str:
+    first = text.split("\n", 1)[0]
+    return "\t" if first.count("\t") > first.count(",") else ","
+
+
+def _read_records(
+    text: str, delim: str
+) -> tuple[list[tuple[int, list[str]]], list[RowError]]:
+    """(start_line, fields) per CSV record; start_line is 1-based physical line."""
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delim)
+    records: list[tuple[int, list[str]]] = []
+    errors: list[RowError] = []
+    while True:
+        start = reader.line_num + 1
+        try:
+            rec = next(reader)
+        except StopIteration:
+            break
+        except csv.Error as e:
+            errors.append(RowError(start, "(行)", "", f"CSV として読めません: {e}"))
+            break
+        records.append((start, rec))
+    return records, errors
+
+
+def _find_columns(header: list[str]) -> dict[str, int]:
+    cols: dict[str, int] = {}
+    for i, name in enumerate(header):
+        role = _ALIAS_TO_ROLE.get(_norm(name))
+        if role is not None and role not in cols:
+            cols[role] = i
+    return cols
+
+
+def _cell(rec: list[str], cols: dict[str, int], role: str) -> str:
+    idx = cols.get(role)
+    return "" if idx is None else rec[idx]
+
+
+def _parse_date(raw: str) -> date:
+    s = unicodedata.normalize("NFKC", raw).strip()
+    if not s:
+        raise ValueError("日付が空です")
+    s = _TIME_SUFFIX_RE.sub("", s)
+    if _WAREKI_RE.search(s):
+        raise ValueError(f"和暦は未対応です: {raw.strip()!r}")
+    m = None
+    for pat in (_DATE_SEP_RE, _DATE_KANJI_RE, _DATE_COMPACT_RE):
+        m = pat.fullmatch(s)
+        if m is not None:
+            break
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {raw.strip()!r}")
+    try:
+        return date(int(m.group("y")), int(m.group("m")), int(m.group("d")))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {raw.strip()!r}") from None
+
+
+def _parse_amount(raw: str) -> int:
+    """Parse a yen amount; negative forms are returned as negative ints."""
+    s = _AMOUNT_NOISE_RE.sub("", unicodedata.normalize("NFKC", raw))
+    if not s:
+        raise ValueError("金額が空です")
+    negative = False
+    if s[0] in "-−△▲":
+        negative, s = True, s[1:]
+    elif s.startswith("(") and s.endswith(")"):
+        negative, s = True, s[1:-1]
+    elif s.endswith("-"):
+        negative, s = True, s[:-1]
+    if _DIGITS_RE.fullmatch(s):
+        n = int(s)
+        return -n if negative else n
+    if _DECIMAL_RE.fullmatch(s):
+        raise ValueError(f"小数は扱えません: {raw.strip()!r}")
+    raise ValueError(f"金額が数字ではありません: {raw.strip()!r}")
+
+
+def import_bank_csv(text: str) -> ImportResult:
+    text = text.removeprefix("﻿")
+    delim = _detect_delimiter(text)
+    records, errors = _read_records(text, delim)
+    records = [(ln, rec) for ln, rec in records if not _is_blank_record(rec)]
+    if not records:
+        return ImportResult([], errors, 0)
+
+    _, header = records[0]
+    cols = _find_columns(header)
+    missing: list[str] = []
+    if "date" not in cols:
+        missing.append("日付")
+    if "amount" not in cols and "withdrawal" not in cols:
+        missing.append("金額(または出金額)")
+    if missing:
+        raise HeaderError(f"ヘッダーに必要な列がありません: {', '.join(missing)}")
+
+    single = "amount" in cols
+    expenses: list[Expense] = []
+    skipped = 0
+    for line, rec in records[1:]:
+        if len(rec) != len(header):
+            errors.append(
+                RowError(
+                    line,
+                    "(行)",
+                    delim.join(rec),
+                    f"列数がヘッダーと違います({len(rec)} 列、ヘッダーは {len(header)} 列)",
+                )
+            )
+            continue
+
+        row_errors: list[RowError] = []
+        day: date | None = None
+        amount: int | None = None
+        is_deposit_only = False
+
+        raw_date = _cell(rec, cols, "date")
+        try:
+            day = _parse_date(raw_date)
+        except ValueError as e:
+            row_errors.append(RowError(line, header[cols["date"]], raw_date, str(e)))
+
+        if single:
+            raw_amount = rec[cols["amount"]]
+            try:
+                amount = _parse_amount(raw_amount)
+            except ValueError as e:
+                row_errors.append(
+                    RowError(line, header[cols["amount"]], raw_amount, str(e))
+                )
+        else:
+            wname = header[cols["withdrawal"]]
+            raw_w = rec[cols["withdrawal"]]
+            raw_d = _cell(rec, cols, "deposit")
+            has_w = not _is_blank_text(raw_w)
+            has_d = not _is_blank_text(raw_d)
+            if not has_w and not has_d:
+                row_errors.append(
+                    RowError(line, wname, raw_w, "出金額と入金額がどちらも空です")
+                )
+            elif has_w and has_d:
+                row_errors.append(
+                    RowError(line, wname, raw_w, "出金額と入金額の両方に値があります")
+                )
+            elif has_w:
+                try:
+                    amount = _parse_amount(raw_w)
+                except ValueError as e:
+                    row_errors.append(RowError(line, wname, raw_w, str(e)))
+            else:
+                try:
+                    _parse_amount(raw_d)
+                except ValueError as e:
+                    row_errors.append(
+                        RowError(line, header[cols["deposit"]], raw_d, str(e))
+                    )
+                else:
+                    is_deposit_only = True
+
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        if is_deposit_only:
+            skipped += 1
+            continue
+        if day is None or amount is None:
+            continue
+        category = (
+            _cell(rec, cols, "category").strip()
+            if "category" in cols
+            else _UNCATEGORIZED
+        )
+        memo = _cell(rec, cols, "memo").strip()
+        expenses.append(Expense(day=day, category=category, amount=amount, memo=memo))
+
+    return ImportResult(expenses, errors, skipped)
