@@ -0,0 +1,167 @@
+"""Tests for kakeibo.query: condition data and search."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import And, Cond, Not, Or, search
+
+ROWS = [
+    Expense(date(2026, 1, 1), "食費", 1000, "ランチ"),
+    Expense(date(2026, 1, 15), "Food", 2500, "Dinner #2"),
+    Expense(date(2026, 2, 1), "交通費", 1000, "電車"),
+    Expense(date(2026, 2, 20), "食費", -500, "返金"),
+    Expense(date(2026, 3, 31), "日用品", 300, ""),
+]
+
+
+# --- 例の表 (E3) ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("make_cond", "expected"),
+    [
+        pytest.param(lambda: Or(), [], id="E3-1"),
+        pytest.param(
+            lambda: Cond(min_amount=1000, max_amount=1000),
+            [ROWS[0], ROWS[2]],
+            id="E3-2",
+        ),
+    ],
+)
+def test_spec_examples(make_cond, expected: list[Expense]) -> None:
+    assert search(ROWS, make_cond()) == expected
+
+
+@pytest.mark.parametrize(
+    "make_cond",
+    [
+        pytest.param(
+            lambda: Cond(start=date(2026, 2, 1), end=date(2026, 1, 1)),
+            id="E3-3",
+        ),
+    ],
+)
+def test_spec_error_examples(make_cond) -> None:
+    with pytest.raises(ValueError, match="start"):
+        search(ROWS, make_cond())
+
+
+# --- R1: Cond の項目は全て AND、カテゴリは NFKC 完全一致 (大小無視) -------
+
+
+def test_r1_fields_are_anded() -> None:
+    assert search(ROWS, Cond(category="食費", min_amount=1000)) == [ROWS[0]]
+
+
+def test_r1_category_is_exact_not_substring() -> None:
+    assert search(ROWS, Cond(category="食")) == []
+
+
+def test_r1_category_nfkc_and_case_insensitive() -> None:
+    assert search(ROWS, Cond(category="ＦＯＯＤ")) == [ROWS[1]]
+    assert search(ROWS, Cond(category="food")) == [ROWS[1]]
+
+
+# --- R2: 金額・期間は両端を含む ----------------------------------------
+
+
+def test_r2_min_amount_inclusive() -> None:
+    assert search(ROWS, Cond(min_amount=1000)) == [ROWS[0], ROWS[1], ROWS[2]]
+
+
+def test_r2_max_amount_inclusive() -> None:
+    assert search(ROWS, Cond(max_amount=1000)) == [ROWS[0], ROWS[2], ROWS[3], ROWS[4]]
+
+
+def test_r2_date_range_inclusive() -> None:
+    cond = Cond(start=date(2026, 1, 15), end=date(2026, 2, 1))
+    assert search(ROWS, cond) == [ROWS[1], ROWS[2]]
+
+
+def test_r2_min_greater_than_max_raises_with_arg_names() -> None:
+    with pytest.raises(ValueError, match="min_amount"):
+        Cond(min_amount=2000, max_amount=1000)
+
+
+# --- R3: メモは NFKC・小文字化後の部分一致、空文字は全件一致 ---------------
+
+
+def test_r3_memo_substring() -> None:
+    assert search(ROWS, Cond(memo_contains="ランチ")) == [ROWS[0]]
+
+
+def test_r3_memo_case_and_nfkc() -> None:
+    assert search(ROWS, Cond(memo_contains="dinner")) == [ROWS[1]]
+    assert search(ROWS, Cond(memo_contains="＃２")) == [ROWS[1]]
+
+
+def test_r3_empty_memo_matches_all() -> None:
+    assert search(ROWS, Cond(memo_contains="")) == ROWS
+
+
+# --- R4: 空の And は真、空の Or は偽、Not は反転、入れ子可 ------------------
+
+
+def test_r4_empty_and_is_true() -> None:
+    assert search(ROWS, And()) == ROWS
+
+
+def test_r4_empty_cond_matches_all() -> None:
+    assert search(ROWS, Cond()) == ROWS
+
+
+def test_r4_not_inverts() -> None:
+    assert search(ROWS, Not(Or())) == ROWS
+    assert search(ROWS, Not(And())) == []
+
+
+def test_r4_nested() -> None:
+    cond = And(
+        Or(Cond(category="食費"), Cond(category="交通費")),
+        Not(Cond(min_amount=1000, max_amount=1000)),
+    )
+    assert search(ROWS, cond) == [ROWS[3]]
+
+
+# --- R5: 入力の順を保つ、未知・型違いは TypeError ------------------------
+
+
+def test_r5_keeps_input_order() -> None:
+    reversed_rows = list(reversed(ROWS))
+    cond = Or(Cond(category="日用品"), Cond(category="食費"))
+    assert search(reversed_rows, cond) == [ROWS[4], ROWS[3], ROWS[0]]
+
+
+def test_r5_unknown_condition_type_raises() -> None:
+    with pytest.raises(TypeError):
+        search(ROWS, "食費")  # type: ignore[arg-type]
+
+
+def test_r5_unknown_condition_nested_raises() -> None:
+    with pytest.raises(TypeError):
+        search(ROWS, And(Cond(category="食費"), 42))  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize(
+    "make_cond",
+    [
+        pytest.param(lambda: Cond(min_amount=True), id="bool-min"),  # type: ignore[arg-type]
+        pytest.param(lambda: Cond(max_amount=1.0), id="float-max"),  # type: ignore[arg-type]
+        pytest.param(lambda: Cond(category=1), id="int-category"),  # type: ignore[arg-type]
+        pytest.param(lambda: Cond(memo_contains=1), id="int-memo"),  # type: ignore[arg-type]
+        pytest.param(lambda: Cond(start="2026-01-01"), id="str-start"),  # type: ignore[arg-type]
+    ],
+)
+def test_r5_wrong_field_types_raise_type_error(make_cond) -> None:
+    with pytest.raises(TypeError):
+        make_cond()
+
+
+def test_r5_bool_row_amount_raises_type_error() -> None:
+    bad = [Expense(date(2026, 1, 1), "食費", True)]  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        search(bad, Cond())
