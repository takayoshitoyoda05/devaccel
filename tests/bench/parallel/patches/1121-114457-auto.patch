+"""Search over expense rows with composable condition data.
+
+Conditions are plain frozen dataclasses (not functions), so they can be
+inspected, compared and combined. Only the standard library is used.
+"""
+
+from __future__ import annotations
+
+import unicodedata
+from dataclasses import dataclass
+from datetime import date, datetime
+
+from kakeibo.core import Expense
+
+
+def _fold(s: str) -> str:
+    """NFKC normalisation followed by lower-casing (used for text comparison)."""
+    return unicodedata.normalize("NFKC", s).lower()
+
+
+def _is_amount(value: object) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _is_date(value: object) -> bool:
+    return isinstance(value, date) and not isinstance(value, datetime)
+
+
+@dataclass(frozen=True)
+class Cond:
+    """Leaf condition. Every specified field must hold (AND); bounds are inclusive."""
+
+    category: str | None = None
+    min_amount: int | None = None
+    max_amount: int | None = None
+    memo_contains: str | None = None
+    start: date | None = None
+    end: date | None = None
+
+    def __post_init__(self) -> None:
+        if self.category is not None and not isinstance(self.category, str):
+            raise TypeError(
+                f"category は str か None である必要があります: {self.category!r}"
+            )
+        for name in ("min_amount", "max_amount"):
+            value = getattr(self, name)
+            if value is not None and not _is_amount(value):
+                raise TypeError(
+                    f"{name} は int か None である必要があります: {value!r}"
+                )
+        if self.memo_contains is not None and not isinstance(self.memo_contains, str):
+            raise TypeError(
+                f"memo_contains は str か None である必要があります: {self.memo_contains!r}"
+            )
+        for name in ("start", "end"):
+            value = getattr(self, name)
+            if value is not None and not _is_date(value):
+                raise TypeError(
+                    f"{name} は date か None である必要があります: {value!r}"
+                )
+        if (
+            self.min_amount is not None
+            and self.max_amount is not None
+            and self.min_amount > self.max_amount
+        ):
+            raise ValueError(
+                f"min_amount ({self.min_amount}) は max_amount ({self.max_amount}) "
+                "以下である必要があります"
+            )
+        if self.start is not None and self.end is not None and self.start > self.end:
+            raise ValueError(
+                f"start ({self.start}) は end ({self.end}) 以前である必要があります"
+            )
+
+
+@dataclass(frozen=True, init=False)
+class And:
+    """True when every child holds. ``And()`` is always true."""
+
+    conds: tuple[Condition, ...]
+
+    def __init__(self, *conds: Condition) -> None:
+        object.__setattr__(self, "conds", conds)
+
+
+@dataclass(frozen=True, init=False)
+class Or:
+    """True when any child holds. ``Or()`` is always false."""
+
+    conds: tuple[Condition, ...]
+
+    def __init__(self, *conds: Condition) -> None:
+        object.__setattr__(self, "conds", conds)
+
+
+@dataclass(frozen=True)
+class Not:
+    """Inverts its child."""
+
+    cond: Condition
+
+
+type Condition = Cond | And | Or | Not
+
+
+def _check_tree(cond: object) -> None:
+    if isinstance(cond, Cond):
+        return
+    if isinstance(cond, (And, Or)):
+        for child in cond.conds:
+            _check_tree(child)
+        return
+    if isinstance(cond, Not):
+        _check_tree(cond.cond)
+        return
+    raise TypeError(f"未知の条件型です: {type(cond).__name__}")
+
+
+def _match_cond(e: Expense, c: Cond) -> bool:
+    if c.category is not None and _fold(e.category) != _fold(c.category):
+        return False
+    if c.min_amount is not None and e.amount < c.min_amount:
+        return False
+    if c.max_amount is not None and e.amount > c.max_amount:
+        return False
+    if c.memo_contains is not None and _fold(c.memo_contains) not in _fold(e.memo):
+        return False
+    if c.start is not None and e.day < c.start:
+        return False
+    return c.end is None or e.day <= c.end
+
+
+def _matches(e: Expense, cond: Condition) -> bool:
+    if isinstance(cond, Cond):
+        return _match_cond(e, cond)
+    if isinstance(cond, And):
+        return all(_matches(e, child) for child in cond.conds)
+    if isinstance(cond, Or):
+        return any(_matches(e, child) for child in cond.conds)
+    return not _matches(e, cond.cond)
+
+
+def search(rows: list[Expense], cond: Condition) -> list[Expense]:
+    """Return the rows satisfying ``cond``, in their original order."""
+    _check_tree(cond)
+    for e in rows:
+        if not _is_amount(e.amount):
+            raise TypeError(f"金額は int である必要があります: {e.amount!r}")
+    return [e for e in rows if _matches(e, cond)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..1a3f796
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,120 @@
+"""Detect recurring expenses (定期支出) from a list of Expense rows. Pure functions."""
+
+from __future__ import annotations
+
+import calendar
+import itertools
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    key: str  # normalized memo (D2)
+    category: str
+    amount: int  # latest amount in the series, yen
+    count: int  # number of months
+    last: date  # latest date in the series
+    next_expected: date
+
+
+_TRAILING_NUMBER = re.compile(r"#?\d+$")
+
+
+def _normalize_memo(memo: str) -> str:
+    """D2: NFKC -> lowercase -> remove whitespace -> strip trailing number / '#' number."""
+    s = unicodedata.normalize("NFKC", memo).lower()
+    s = re.sub(r"\s+", "", s)
+    return _TRAILING_NUMBER.sub("", s)
+
+
+def _same_series(base: int, amount: int, tolerance: float) -> bool:
+    """R1: same series if within tolerance of the base amount.
+
+    Negative (refund) and non-negative amounts never share a series, so refunds
+    are not mixed into a positive series (D1).
+    """
+    if (amount < 0) != (base < 0):
+        return False
+    return abs(amount - base) <= abs(base) * tolerance
+
+
+def _to_recurring(
+    category: str, norm: str, series: list[Expense], min_months: int
+) -> Recurring | None:
+    # R2: one entry per month (the latest day in that month).
+    best: dict[int, Expense] = {}
+    for e in series:  # series is sorted by day
+        idx = e.day.year * 12 + (e.day.month - 1)
+        cur = best.get(idx)
+        if cur is None or e.day >= cur.day:
+            best[idx] = e
+    months = sorted(best)
+    if len(months) < min_months:
+        return None
+    if any(b - a != 1 for a, b in itertools.pairwise(months)):
+        return None  # a missing month breaks the series
+
+    last_idx = months[-1]
+    last_e = best[last_idx]
+    # R3: next month's same day, clipped to that month's last day.
+    next_year, next_month0 = divmod(last_idx + 1, 12)
+    max_day = max(e.day.day for e in best.values())
+    day = min(max_day, calendar.monthrange(next_year, next_month0 + 1)[1])
+    return Recurring(
+        key=norm,
+        category=category,
+        amount=last_e.amount,
+        count=len(months),
+        last=last_e.day,
+        next_expected=date(next_year, next_month0 + 1, day),
+    )
+
+
+def find_recurring(
+    rows: list[Expense], *, min_months: int = 3, amount_tolerance: float = 0.0
+) -> list[Recurring]:
+    """Return recurring series, sorted by amount desc then key asc (R4)."""
+    if not isinstance(rows, list):
+        raise TypeError("rows は list である必要があります")
+    for e in rows:
+        if not isinstance(e, Expense):
+            raise TypeError("rows の要素は Expense である必要があります")
+        if isinstance(e.amount, bool) or not isinstance(e.amount, int):
+            raise TypeError("amount は int である必要があります(円の整数)")
+    if isinstance(min_months, bool) or not isinstance(min_months, int):
+        raise TypeError("min_months は int である必要があります")
+    if min_months < 2:
+        raise ValueError("min_months は 2 以上である必要があります")
+    if isinstance(amount_tolerance, bool) or not isinstance(
+        amount_tolerance, (int, float)
+    ):
+        raise TypeError("amount_tolerance は float である必要があります")
+    if not amount_tolerance >= 0:
+        raise ValueError("amount_tolerance は 0 以上である必要があります")
+    tolerance = float(amount_tolerance)
+
+    # R1: group by (category, normalized memo), then split each group into series.
+    groups: dict[tuple[str, str], list[list[Expense]]] = {}
+    for e in sorted(rows, key=lambda x: x.day):  # stable: input order for same day
+        gkey = (e.category, _normalize_memo(e.memo))
+        seriess = groups.setdefault(gkey, [])
+        for s in seriess:
+            if _same_series(s[0].amount, e.amount, tolerance):
+                s.append(e)
+                break
+        else:
+            seriess.append([e])
+
+    out: list[Recurring] = []
+    for (category, norm), seriess in groups.items():
+        for s in seriess:
+            r = _to_recurring(category, norm, s, min_months)
+            if r is not None:
+                out.append(r)
+    out.sort(key=lambda r: (-r.amount, r.key, r.category, r.last))
+    return out
