+"""Parse bank / card CSV text into Expense records (pure, no file I/O)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str
+    value: str
+    reason: str
+
+
+_DATE_COLS = {"日付", "利用日", "取引日", "ご利用日", "date"}
+_AMOUNT_COLS = {"金額", "利用金額", "ご利用金額", "amount"}
+_OUT_COLS = {"出金額", "お支払金額", "支払"}
+_IN_COLS = {"入金額", "お預入金額", "預入"}
+_MEMO_COLS = {"摘要", "メモ", "利用店名", "ご利用店名", "内容", "description", "memo"}
+_CAT_COLS = {"カテゴリ", "category"}
+
+_DATE_RES = [
+    re.compile(r"(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})"),
+    re.compile(r"(\d{4})年(\d{1,2})月(\d{1,2})日"),
+    re.compile(r"(\d{4})(\d{2})(\d{2})"),
+]
+_NEG_MARKS = "-−△▲"
+
+
+def _parse_date(raw: str) -> date:
+    s = unicodedata.normalize("NFKC", raw).strip()
+    s = re.split(r"[T\s]", s, maxsplit=1)[0]
+    for rx in _DATE_RES:
+        m = rx.fullmatch(s)
+        if m:
+            return date(int(m[1]), int(m[2]), int(m[3]))  # ValueError if invalid
+    raise ValueError("日付の形式が不正です")
+
+
+def _parse_amount(raw: str) -> int:
+    s = unicodedata.normalize("NFKC", raw).upper()
+    for tok in ("¥", "円", "JPY", ",", "、"):
+        s = s.replace(tok, "")
+    s = "".join(s.split())
+    neg = False
+    if len(s) >= 2 and s[0] == "(" and s[-1] == ")":
+        neg, s = True, s[1:-1]
+    if s and s[0] in _NEG_MARKS:
+        neg, s = True, s[1:]
+    if s and s[-1] in _NEG_MARKS:
+        neg, s = True, s[:-1]
+    if not (s.isascii() and s.isdigit()):
+        raise ValueError("金額が整数ではありません")
+    n = int(s)
+    return -n if neg else n
+
+
+def _find(header: list[str], names: set[str]) -> int | None:
+    for i, h in enumerate(header):
+        if h in names:
+            return i
+    return None
+
+
+def parse_bank_csv(
+    text: str, *, default_category: str = "未分類"
+) -> tuple[list[Expense], list[RowError]]:
+    if not isinstance(text, str):
+        raise TypeError("text は str である必要があります")
+    if not isinstance(default_category, str):
+        raise TypeError("default_category は str である必要があります")
+    text = text.removeprefix("﻿")
+    if not text.strip():
+        return [], []
+    first = text.lstrip("\r\n").split("\n", 1)[0]
+    delim = "\t" if first.count("\t") > first.count(",") else ","
+
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delim)
+    header: list[str] | None = None
+    idx: dict[str, int | None] = {}
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    prev_end = 0
+    for row in reader:
+        start = prev_end + 1
+        prev_end = reader.line_num
+        if not row or (len(row) == 1 and not row[0].strip()):
+            continue
+        if header is None:
+            header = [c.strip().lower() for c in row]
+            idx = {
+                "date": _find(header, _DATE_COLS),
+                "amount": _find(header, _AMOUNT_COLS),
+                "out": _find(header, _OUT_COLS),
+                "in": _find(header, _IN_COLS),
+                "memo": _find(header, _MEMO_COLS),
+                "cat": _find(header, _CAT_COLS),
+            }
+            if idx["date"] is None:
+                raise ValueError("日付の列がありません")
+            if idx["amount"] is None and idx["out"] is None:
+                raise ValueError("金額または出金の列がありません")
+            continue
+        if len(row) != len(header):
+            errors.append(
+                RowError(
+                    start, "", delim.join(row), f"列数が {len(header)} 列ではありません"
+                )
+            )
+            continue
+
+        def cell(
+            key: str, row: list[str] = row, idx: dict[str, int | None] = idx
+        ) -> str:
+            i = idx[key]
+            return "" if i is None else row[i]
+
+        row_errs: list[RowError] = []
+        day: date | None = None
+        raw_d = cell("date")
+        try:
+            day = _parse_date(raw_d)
+        except ValueError as e:
+            row_errs.append(RowError(start, header[idx["date"] or 0], raw_d, str(e)))
+
+        amount: int | None = None
+        if idx["amount"] is not None:
+            col = header[idx["amount"]]
+            raw = cell("amount")
+            try:
+                amount = _parse_amount(raw)
+            except ValueError as e:
+                row_errs.append(RowError(start, col, raw, str(e)))
+        else:
+            out_raw, in_raw = cell("out"), cell("in")
+            has_out, has_in = bool(out_raw.strip()), bool(in_raw.strip())
+            out_col = header[idx["out"] or 0]
+            if has_out and has_in:
+                row_errs.append(
+                    RowError(start, out_col, out_raw, "出金と入金の両方が入っています")
+                )
+            elif not has_out and not has_in:
+                row_errs.append(RowError(start, out_col, out_raw, "金額が空です"))
+            elif has_out:
+                try:
+                    amount = _parse_amount(out_raw)
+                except ValueError as e:
+                    row_errs.append(RowError(start, out_col, out_raw, str(e)))
+            else:
+                in_col = header[idx["in"] or 0]
+                try:
+                    amount = -_parse_amount(in_raw)
+                except ValueError as e:
+                    row_errs.append(RowError(start, in_col, in_raw, str(e)))
+
+        if row_errs:
+            errors.extend(row_errs)
+            continue
+        assert day is not None and amount is not None
+        category = cell("cat").strip() or default_category
+        expenses.append(Expense(day, category, amount, cell("memo").strip()))
+    return expenses, errors
