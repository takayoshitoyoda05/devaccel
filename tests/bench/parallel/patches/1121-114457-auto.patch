+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring
+
+
+def _e(day: str, amount: int, memo: str = "", category: str = "家賃") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+# --- 表の例 (E1-1 .. E1-3) ---
+
+
+def test_E1_1_next_expected_clips_to_month_end() -> None:
+    """E1-1: 家賃 80000 を 1/31, 2/28, 3/31 -> next_expected=2026-04-30 (R3)."""
+    rows = [_e("2026-01-31", 80000), _e("2026-02-28", 80000), _e("2026-03-31", 80000)]
+    result = find_recurring(rows)
+    assert result == [
+        Recurring(
+            key="",
+            category="家賃",
+            amount=80000,
+            count=3,
+            last=date(2026, 3, 31),
+            next_expected=date(2026, 4, 30),
+        )
+    ]
+
+
+def test_E1_2_different_memo_makes_separate_series() -> None:
+    """E1-2: 同カテゴリ同金額で メモ「A」5日 と「B」20日 の 3 か月 -> 2 件の別系列 (R1)."""
+    rows = [
+        _e("2026-01-05", 5000, "A"),
+        _e("2026-02-05", 5000, "A"),
+        _e("2026-03-05", 5000, "A"),
+        _e("2026-01-20", 5000, "B"),
+        _e("2026-02-20", 5000, "B"),
+        _e("2026-03-20", 5000, "B"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 2
+    assert {r.key for r in result} == {"a", "b"}
+
+
+def test_E1_3_min_months_below_two_raises_value_error() -> None:
+    """E1-3: min_months=1 -> ValueError (R2, D6)."""
+    with pytest.raises(ValueError, match="min_months"):
+        find_recurring([], min_months=1)
+
+
+# --- 追加の端のケース ---
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+def test_normalized_memo_variants_are_same_series() -> None:
+    """D2: NFKC・大小文字・空白・末尾の数字/#番号を無視して同一視する."""
+    rows = [
+        _e("2026-01-10", 3000, "Gas#2"),
+        _e("2026-02-10", 3000, "ｇａｓ 5"),
+        _e("2026-03-10", 3000, "gas"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].count == 3
+    assert result[0].key == "gas"
+
+
+def test_tolerance_zero_splits_different_amounts() -> None:
+    """R1: 許容差 0.0 では金額が 1 円でも違えば別系列."""
+    rows = [_e("2026-01-10", 10000), _e("2026-02-10", 10400), _e("2026-03-10", 10000)]
+    assert find_recurring(rows) == []
+
+
+def test_tolerance_joins_close_amounts_and_reports_latest_amount() -> None:
+    """R1: 許容差 5% 以内なら同一系列. amount は最新の金額."""
+    rows = [_e("2026-01-10", 10000), _e("2026-02-10", 10400), _e("2026-03-10", 10000)]
+    result = find_recurring(rows, amount_tolerance=0.05)
+    assert len(result) == 1
+    assert result[0].count == 3
+    assert result[0].amount == 10000
+
+
+def test_two_entries_in_same_month_count_once_using_latest_day() -> None:
+    """R2: 同じ月は最も遅い日の 1 件. next_expected の日は系列の日の最大値 (20)."""
+    rows = [
+        _e("2026-01-05", 500),
+        _e("2026-01-20", 500),
+        _e("2026-02-10", 500),
+        _e("2026-03-15", 500),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].count == 3
+    assert result[0].last == date(2026, 3, 15)
+    assert result[0].next_expected == date(2026, 4, 20)
+
+
+def test_missing_month_is_not_recurring() -> None:
+    """R2: 欠け月があれば定期ではない."""
+    rows = [_e("2026-01-10", 500), _e("2026-02-10", 500), _e("2026-04-10", 500)]
+    assert find_recurring(rows) == []
+
+
+def test_fewer_months_than_min_is_not_recurring() -> None:
+    """R2: min_months 未満の系列は出さない."""
+    rows = [_e("2026-01-10", 500), _e("2026-02-10", 500)]
+    assert find_recurring(rows, min_months=3) == []
+    assert len(find_recurring(rows, min_months=2)) == 1
+
+
+def test_next_expected_crosses_december_and_leap_february() -> None:
+    """R3: 1/31 の系列の次は閏年の 2 月末 (29)."""
+    rows = [_e("2027-11-30", 100), _e("2027-12-31", 100), _e("2028-01-31", 100)]
+    result = find_recurring(rows)
+    assert result[0].next_expected == date(2028, 2, 29)
+
+
+def test_next_expected_clips_to_non_leap_february() -> None:
+    """R3: 非閏年の 2 月末 (28) に切り詰める."""
+    rows = [_e("2026-11-30", 100), _e("2026-12-31", 100), _e("2027-01-31", 100)]
+    result = find_recurring(rows)
+    assert result[0].next_expected == date(2027, 2, 28)
+
+
+def test_result_sorted_by_amount_desc_then_key_asc() -> None:
+    """R4: 金額の降順、同点は key の昇順."""
+    rows: list[Expense] = []
+    for m in (1, 2, 3):
+        d = f"2026-{m:02d}-10"
+        rows.append(_e(d, 300, "x"))
+        rows.append(_e(d, 500, "y", category="食費"))
+        rows.append(_e(d, 300, "a", category="通信"))
+    result = find_recurring(rows)
+    assert [(r.amount, r.key) for r in result] == [(500, "y"), (300, "a"), (300, "x")]
+
+
+def test_refund_is_ignored_in_positive_series() -> None:
+    """D1: 正の系列では負の金額(返金)は定期の一部にしない."""
+    rows = [
+        _e("2026-01-10", 1000),
+        _e("2026-02-10", 1000),
+        _e("2026-02-12", -1000),
+        _e("2026-03-10", 1000),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].count == 3
+    assert result[0].amount == 1000
+
+
+def test_negative_series_is_treated_as_normal_value() -> None:
+    """D1: 負の金額だけの系列は通常の値として検出される."""
+    rows = [_e("2026-01-10", -500), _e("2026-02-10", -500), _e("2026-03-10", -500)]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].amount == -500
+
+
+@pytest.mark.parametrize("bad", [True, 1.5, "100"])
+def test_non_int_amount_raises_type_error(bad: object) -> None:
+    """金額は円の整数. bool・float・str は受けない."""
+    rows = [Expense(day=date(2026, 1, 1), category="家賃", amount=bad, memo="")]  # type: ignore[arg-type]
+    with pytest.raises(TypeError, match="amount"):
+        find_recurring(rows)
+
+
+def test_rows_not_list_raises_type_error() -> None:
+    with pytest.raises(TypeError, match="rows"):
+        find_recurring(("a",))  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad", [True, 3.0, "3"])
+def test_min_months_wrong_type_raises_type_error(bad: object) -> None:
+    with pytest.raises(TypeError, match="min_months"):
+        find_recurring([], min_months=bad)  # type: ignore[arg-type]
+
+
+def test_min_months_zero_raises_value_error() -> None:
+    with pytest.raises(ValueError, match="min_months"):
+        find_recurring([], min_months=0)
+
+
+@pytest.mark.parametrize("bad", [True, "0.1"])
+def test_tolerance_wrong_type_raises_type_error(bad: object) -> None:
+    with pytest.raises(TypeError, match="amount_tolerance"):
+        find_recurring([], amount_tolerance=bad)  # type: ignore[arg-type]
+
+
+def test_negative_tolerance_raises_value_error() -> None:
+    with pytest.raises(ValueError, match="amount_tolerance"):
+        find_recurring([], amount_tolerance=-0.1)
