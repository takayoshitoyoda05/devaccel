@@ -0,0 +1,101 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import RowError, parse_bank_csv
+from kakeibo.core import Expense
+
+
+def test_E2_1() -> None:
+    text = '利用日,ご利用店名,利用金額\n2026/1/5,ABC,"1,234円"\n'
+    assert parse_bank_csv(text) == (
+        [Expense(date(2026, 1, 5), "未分類", 1234, "ABC")],
+        [],
+    )
+
+
+def test_E2_2() -> None:
+    exp, errs = parse_bank_csv("日付,金額\n2026-01-05,▲500\n")
+    assert errs == []
+    assert exp[0].amount == -500
+
+
+def test_E2_3() -> None:
+    exp, errs = parse_bank_csv("日付,金額\n2026/2/30,1.5\n")
+    assert exp == []
+    assert errs == [
+        RowError(2, "日付", "2026/2/30", errs[0].reason),
+        RowError(2, "金額", "1.5", errs[1].reason),
+    ]
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026.1.5",
+        "2026年1月5日",
+        "20260105",
+        "2026-01-05 12:34:56",
+    ],
+)
+def test_date_formats(raw: str) -> None:
+    exp, errs = parse_bank_csv(f"date,amount\n{raw},1\n")
+    assert errs == [] and exp[0].day == date(2026, 1, 5)
+
+
+@pytest.mark.parametrize(
+    "raw,want",
+    [
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("¥1,000", 1000),
+        ("JPY 10", 10),
+    ],
+)
+def test_amounts(raw: str, want: int) -> None:
+    exp, _ = parse_bank_csv(f'date,amount\n2026-01-05,"{raw}"\n')
+    assert exp[0].amount == want
+
+
+@pytest.mark.parametrize("raw", ["", "-", "1.5"])
+def test_bad_amounts(raw: str) -> None:
+    exp, errs = parse_bank_csv(f"date,amount\n2026-01-05,{raw}\n")
+    assert exp == [] and len(errs) == 1
+
+
+def test_out_in_columns() -> None:
+    text = "日付,出金額,入金額\n2026-01-05,100,\n2026-01-06,,200\n2026-01-07,1,2\n"
+    exp, errs = parse_bank_csv(text)
+    assert [e.amount for e in exp] == [100, -200]
+    assert len(errs) == 1 and errs[0].line == 4
+
+
+def test_tab_bom_quotes_line_numbers() -> None:
+    text = '﻿date\tamount\tmemo\n2026-01-05\t1\t"a\nb"\n\n2026-01-06\tx\t\n'
+    exp, errs = parse_bank_csv(text)
+    assert exp[0].memo == "a\nb"
+    assert errs[0].line == 5
+
+
+def test_column_mismatch_and_category() -> None:
+    exp, errs = parse_bank_csv(
+        "date,amount,category\n2026-01-05,1\n2026-01-05,2,食費\n"
+    )
+    assert errs[0].column == "" and errs[0].line == 2
+    assert exp[0].category == "食費"
+    exp, _ = parse_bank_csv("date,amount\n2026-01-05,2\n", default_category="X")
+    assert exp[0].category == "X"
+
+
+def test_empty_and_errors() -> None:
+    assert parse_bank_csv("") == ([], [])
+    assert parse_bank_csv("date,amount\n") == ([], [])
+    with pytest.raises(ValueError):
+        parse_bank_csv("foo,bar\n1,2\n")
+    with pytest.raises(TypeError):
+        parse_bank_csv(1)  # type: ignore[arg-type]
