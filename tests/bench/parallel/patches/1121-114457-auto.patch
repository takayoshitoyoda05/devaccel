+"""Month-over-month category comparison (pure functions)."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    diff: int
+    rate: float | None
+    status: str
+
+
+def _month_index(day_year: int, day_month: int) -> int:
+    return day_year * 12 + (day_month - 1)
+
+
+def _month_key(index: int) -> str:
+    return f"{index // 12:04d}-{index % 12 + 1:02d}"
+
+
+def _status(previous: int, current: int, diff: int) -> str:
+    if previous == 0 and current > 0:
+        return "new"
+    if previous > 0 and current == 0:
+        return "gone"
+    if diff > 0:
+        return "increased"
+    if diff < 0:
+        return "decreased"
+    return "unchanged"
+
+
+def compare_months(rows: list[Expense]) -> dict[str, list[CategoryChange]]:
+    """Compare each month with the previous month (gap months count as empty).
+
+    Returns {"YYYY-MM": [...]} in ascending month order. The first month is
+    never a key; fewer than two months of data gives {}.
+    """
+    totals: dict[int, dict[str, int]] = {}
+    for e in rows:
+        idx = _month_index(e.day.year, e.day.month)
+        cats = totals.setdefault(idx, {})
+        cats[e.category] = cats.get(e.category, 0) + e.amount
+
+    if len(totals) < 2:
+        return {}
+
+    first, last = min(totals), max(totals)
+    out: dict[str, list[CategoryChange]] = {}
+    for idx in range(first + 1, last + 1):
+        prev = totals.get(idx - 1, {})
+        cur = totals.get(idx, {})
+        changes: list[CategoryChange] = []
+        for cat in set(prev) | set(cur):
+            p = prev.get(cat, 0)
+            c = cur.get(cat, 0)
+            if p == 0 and c == 0:
+                continue
+            diff = c - p
+            changes.append(
+                CategoryChange(
+                    category=cat,
+                    previous=p,
+                    current=c,
+                    diff=diff,
+                    rate=None if p == 0 else diff / p,
+                    status=_status(p, c, diff),
+                )
+            )
+        changes.sort(key=lambda ch: (-abs(ch.diff), ch.category))
+        out[_month_key(idx)] = changes
+    return out
+
+
+def format_report(changes: dict[str, list[CategoryChange]]) -> str:
+    lines: list[str] = []
+    for month, items in changes.items():
+        lines.append(month)
+        for ch in items:
+            if ch.rate is None:
+                tail = f"{ch.diff:+d}"
+            else:
+                tail = f"{ch.diff:+d}, {ch.rate * 100:+.1f}%"
+            lines.append(f"{ch.category}  {ch.previous}→{ch.current} ({tail})")
+    return "\n".join(lines)
