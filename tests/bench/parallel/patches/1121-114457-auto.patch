@@ -0,0 +1,163 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.month_compare import CategoryChange, compare_months, format_report
+
+
+def _e(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+# 例の表 E4-1〜E4-3 をそのまま写す
+@pytest.mark.parametrize(
+    ("case_id", "rows", "expected"),
+    [
+        pytest.param(
+            "E4-1",
+            [_e("2026-01-05", "食費", 100), _e("2026-03-05", "食費", 150)],
+            {
+                "2026-02": [CategoryChange("食費", 100, 0, -100, -1.0, "gone")],
+                "2026-03": [CategoryChange("食費", 0, 150, 150, None, "new")],
+            },
+            id="E4-1",
+        ),
+        pytest.param(
+            "E4-2",
+            [_e("2026-01-05", "食費", 100), _e("2026-02-05", "食費", 150)],
+            {
+                "2026-02": [CategoryChange("食費", 100, 150, 50, 0.5, "increased")],
+            },
+            id="E4-2",
+        ),
+        pytest.param(
+            "E4-3",
+            [_e("2026-01-05", "食費", 100)],
+            {},
+            id="E4-3",
+        ),
+    ],
+)
+def test_examples_from_table(case_id, rows, expected):
+    assert compare_months(rows) == expected
+
+
+# 表以外の端のケース(規則 R1〜R4 から)
+@pytest.mark.parametrize(
+    ("case_id", "rows", "expected"),
+    [
+        pytest.param("R1-empty", [], {}, id="R1-empty"),
+        pytest.param(
+            "R3-decreased",
+            [_e("2026-01-05", "食費", 150), _e("2026-02-05", "食費", 100)],
+            {"2026-02": [CategoryChange("食費", 150, 100, -50, -1 / 3, "decreased")]},
+            id="R3-decreased",
+        ),
+        pytest.param(
+            "R3-unchanged",
+            [_e("2026-01-05", "食費", 100), _e("2026-02-05", "食費", 100)],
+            {"2026-02": [CategoryChange("食費", 100, 100, 0, 0.0, "unchanged")]},
+            id="R3-unchanged",
+        ),
+        pytest.param(
+            "R1-refund-summed",
+            [
+                _e("2026-01-05", "食費", 100),
+                _e("2026-02-05", "食費", 100),
+                _e("2026-02-06", "食費", -30),
+            ],
+            {"2026-02": [CategoryChange("食費", 100, 70, -30, -0.3, "decreased")]},
+            id="R1-refund-summed",
+        ),
+        pytest.param(
+            "R2-gap-two-months",
+            [_e("2026-01-05", "食費", 100), _e("2026-04-05", "食費", 80)],
+            {
+                "2026-02": [CategoryChange("食費", 100, 0, -100, -1.0, "gone")],
+                "2026-03": [],
+                "2026-04": [CategoryChange("食費", 0, 80, 80, None, "new")],
+            },
+            id="R2-gap-two-months",
+        ),
+        pytest.param(
+            "R3-new-and-gone-same-month",
+            [_e("2026-01-05", "住居", 50), _e("2026-02-05", "食費", 40)],
+            {
+                "2026-02": [
+                    CategoryChange("住居", 50, 0, -50, -1.0, "gone"),
+                    CategoryChange("食費", 0, 40, 40, None, "new"),
+                ],
+            },
+            id="R3-new-and-gone-same-month",
+        ),
+        pytest.param(
+            "R4-sort-abs-diff-desc",
+            [
+                _e("2026-01-05", "A", 100),
+                _e("2026-01-05", "B", 300),
+                _e("2026-02-05", "A", 150),  # diff +50
+                _e("2026-02-05", "B", 100),  # diff -200
+            ],
+            {
+                "2026-02": [
+                    CategoryChange("B", 300, 100, -200, -2 / 3, "decreased"),
+                    CategoryChange("A", 100, 150, 50, 0.5, "increased"),
+                ],
+            },
+            id="R4-sort-abs-diff-desc",
+        ),
+        pytest.param(
+            "R4-tie-by-name",
+            [
+                _e("2026-01-05", "B", 100),
+                _e("2026-01-05", "A", 100),
+                _e("2026-02-05", "B", 150),
+                _e("2026-02-05", "A", 50),
+            ],
+            {
+                "2026-02": [
+                    CategoryChange("A", 100, 50, -50, -0.5, "decreased"),
+                    CategoryChange("B", 100, 150, 50, 0.5, "increased"),
+                ],
+            },
+            id="R4-tie-by-name",
+        ),
+        pytest.param(
+            "R4-both-zero-excluded",
+            [
+                _e("2026-01-05", "食費", 100),
+                _e("2026-01-05", "雑費", 100),
+                _e("2026-01-06", "雑費", -100),  # 1月の雑費合計は 0
+                _e("2026-02-05", "食費", 100),
+            ],
+            {"2026-02": [CategoryChange("食費", 100, 100, 0, 0.0, "unchanged")]},
+            id="R4-both-zero-excluded",
+        ),
+    ],
+)
+def test_rules_edge_cases(case_id, rows, expected):
+    assert compare_months(rows) == expected
+
+
+# R5 format_report
+@pytest.mark.parametrize(
+    ("case_id", "changes", "expected"),
+    [
+        pytest.param("R5-empty", {}, "", id="R5-empty"),
+        pytest.param(
+            "R5-line-with-rate",
+            {"2026-02": [CategoryChange("食費", 100, 150, 50, 0.5, "increased")]},
+            "2026-02\n食費  100→150 (+50, +50.0%)",
+            id="R5-line-with-rate",
+        ),
+        pytest.param(
+            "R5-no-percent-when-rate-none",
+            {"2026-03": [CategoryChange("食費", 0, 150, 150, None, "new")]},
+            "2026-03\n食費  0→150 (+150)",
+            id="R5-no-percent-when-rate-none",
+        ),
+    ],
+)
+def test_format_report(case_id, changes, expected):
+    assert format_report(changes) == expected
