diff --git a/src/click/types.py b/src/click/types.py
index 5d11e9f..290911f 100644
--- a/src/click/types.py
+++ b/src/click/types.py
@@ -1049,6 +1049,16 @@ class Path(ParamType[_PathT_co, str | os.PathLike[str]], t.Generic[_PathT_co]):
     :param path_type: Convert the incoming path value to this type. If
         ``None``, keep Python's default, which is ``str``. Useful to
         convert to :class:`pathlib.Path`.
+    :param extensions: Only accept values that end with one of these
+        extensions, compared case-insensitively. Each extension may be
+        written with or without the leading dot, and may contain more
+        than one dot, such as ``".tar.gz"``. A name that is only an
+        extension, such as ``.csv``, does not match. The check applies
+        whether or not the path exists, and is skipped for a dash
+        allowed by ``allow_dash``.
+
+    .. versionchanged:: 8.6
+        Added the ``extensions`` parameter.
 
     .. versionchanged:: 8.5.1
         Reveal the actual type of the value as converted from raw input.
@@ -1086,6 +1096,7 @@ class Path(ParamType[_PathT_co, str | os.PathLike[str]], t.Generic[_PathT_co]):
         allow_dash: bool = False,
         path_type: type[_PathT_co] | None = None,
         executable: bool = False,
+        extensions: cabc.Sequence[str] | None = None,
     ) -> None:
         self.exists = exists
         self.file_okay = file_okay
@@ -1096,6 +1107,22 @@ class Path(ParamType[_PathT_co, str | os.PathLike[str]], t.Generic[_PathT_co]):
         self.resolve_path = resolve_path
         self.allow_dash = allow_dash
         self.type: type[_PathT_co] | None = path_type
+        self.extensions: tuple[str, ...] | None = None
+
+        if extensions is not None:
+            if isinstance(extensions, str):
+                raise TypeError("'extensions' must be a sequence of strings.")
+
+            normalized = tuple(
+                "." + e.lstrip(".").lower() if e.lstrip(".") else "" for e in extensions
+            )
+
+            if not normalized or "" in normalized:
+                raise ValueError(
+                    "'extensions' must be a non-empty sequence of non-empty extensions."
+                )
+
+            self.extensions = normalized
 
         if self.file_okay and not self.dir_okay:
             self.name = _("file")
@@ -1141,6 +1168,22 @@ class Path(ParamType[_PathT_co, str | os.PathLike[str]], t.Generic[_PathT_co]):
         is_dash = self.file_okay and self.allow_dash and rv == dash
 
         if not is_dash:
+            if self.extensions is not None:
+                name = os.path.basename(os.fsdecode(rv)).lower()
+
+                if not any(
+                    name.endswith(e) and len(name) > len(e) for e in self.extensions
+                ):
+                    self.fail(
+                        _("{name} {filename!r} must end with {extensions}.").format(
+                            name=self.name.title(),
+                            filename=format_filename(value),
+                            extensions=", ".join(self.extensions),
+                        ),
+                        param,
+                        ctx,
+                    )
+
             if self.resolve_path:
                 rv = os.path.realpath(rv)
 
diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..234082f 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -188,3 +188,69 @@ def test_path_type(runner, cls, expect):
 
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["a.csv", "A.CSV", "dir/data.Tsv", "x.y.csv", b"a.csv"],
+)
+def test_path_extensions_accepted(value):
+    type = click.Path(extensions=[".csv", "tsv"])
+    assert type.convert(value, None, None) == value
+
+
+@pytest.mark.parametrize("value", ["a.txt", "a", "a.csv.bak", ".csv", "csv", "d.csv/x"])
+def test_path_extensions_rejected(value):
+    type = click.Path(extensions=[".csv", ".tsv"])
+
+    with pytest.raises(click.BadParameter, match="must end with .csv, .tsv"):
+        type.convert(value, None, None)
+
+
+def test_path_extensions_multi_dot():
+    type = click.Path(extensions=["TAR.GZ"])
+    assert type.convert("a.tar.gz", None, None) == "a.tar.gz"
+
+    with pytest.raises(click.BadParameter):
+        type.convert("a.gz", None, None)
+
+
+def test_path_extensions_checked_before_exists(tmp_path):
+    type = click.Path(exists=True, extensions=[".csv"])
+
+    with pytest.raises(click.BadParameter, match="must end with"):
+        type.convert(str(tmp_path / "missing.txt"), None, None)
+
+    with pytest.raises(click.BadParameter, match="does not exist"):
+        type.convert(str(tmp_path / "missing.csv"), None, None)
+
+
+def test_path_extensions_dash_allowed():
+    type = click.Path(allow_dash=True, extensions=[".csv"])
+    assert type.convert("-", None, None) == "-"
+
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions=[".csv"]).convert("-", None, None)
+
+
+def test_path_extensions_path_type():
+    type = click.Path(extensions=[".csv"], path_type=pathlib.Path)
+    assert type.convert("a.CSV", None, None) == pathlib.Path("a.CSV")
+
+
+@pytest.mark.parametrize("bad", ["csv", [], [""], ["."], [".csv", ""]])
+def test_path_extensions_invalid_argument(bad):
+    with pytest.raises((TypeError, ValueError)):
+        click.Path(extensions=bad)
+
+
+def test_path_extensions_cli(runner):
+    @click.command()
+    @click.option("--f", type=click.Path(extensions=[".csv", ".tsv"]))
+    def cli(f):
+        click.echo(f)
+
+    assert runner.invoke(cli, ["--f", "A.CSV"]).output == "A.CSV\n"
+    result = runner.invoke(cli, ["--f", "a.json"])
+    assert result.exit_code == 2
+    assert "must end with .csv, .tsv" in result.output
