@@ -0,0 +1,75 @@
+"""Budget over / near evaluation for one month (pure functions, stdlib only).
+
+Takes plain ``dict[str, int]`` mappings (category -> yen); does not import Budget.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class BudgetStatus:
+    category: str
+    limit: int
+    actual: int
+    level: str  # "over" | "near" | "ok"
+
+
+_LEVEL_ORDER = {"over": 0, "near": 1, "ok": 2}
+
+
+def _check_amounts(amounts: dict[str, int], name: str) -> None:
+    for cat, yen in amounts.items():
+        if not isinstance(cat, str):
+            raise TypeError(f"{name} のキーは str である必要があります: {cat!r}")
+        if isinstance(yen, bool) or not isinstance(yen, int):
+            raise TypeError(f"{name}[{cat!r}] は int である必要があります: {yen!r}")
+        if yen < 0:
+            raise ValueError(f"{name}[{cat!r}] は 0 以上である必要があります: {yen}")
+
+
+def _check_warn_percent(warn_percent: object) -> None:
+    if isinstance(warn_percent, bool) or not isinstance(warn_percent, int):
+        raise TypeError(f"warn_percent は int である必要があります: {warn_percent!r}")
+    if not 1 <= warn_percent <= 100:
+        raise ValueError(f"warn_percent は 1〜100 である必要があります: {warn_percent}")
+
+
+def evaluate_month(
+    actuals: dict[str, int],
+    limits: dict[str, int],
+    warn_percent: int = 80,
+) -> list[BudgetStatus]:
+    """Classify every category that has a limit as over / near / ok.
+
+    - over: actual > limit
+    - near: not over, actual > 0, and actual * 100 >= limit * warn_percent
+    - ok: otherwise
+    Categories without a limit are ignored; limit categories without an actual use 0.
+    Order: over (excess desc), near (remaining asc), ok (name asc); ties by name.
+    """
+    _check_amounts(actuals, "actuals")
+    _check_amounts(limits, "limits")
+    _check_warn_percent(warn_percent)
+
+    out: list[BudgetStatus] = []
+    for cat, limit in limits.items():
+        actual = actuals.get(cat, 0)
+        if actual > limit:
+            level = "over"
+        elif actual > 0 and actual * 100 >= limit * warn_percent:
+            level = "near"
+        else:
+            level = "ok"
+        out.append(BudgetStatus(cat, limit, actual, level))
+
+    def sort_key(s: BudgetStatus) -> tuple[int, int, str]:
+        if s.level == "over":
+            return (_LEVEL_ORDER["over"], -(s.actual - s.limit), s.category)
+        if s.level == "near":
+            return (_LEVEL_ORDER["near"], s.limit - s.actual, s.category)
+        return (_LEVEL_ORDER["ok"], 0, s.category)
+
+    out.sort(key=sort_key)
+    return out
