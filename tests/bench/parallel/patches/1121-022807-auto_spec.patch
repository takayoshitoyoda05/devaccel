@@ -0,0 +1,45 @@
+"""Budget alert wording (Japanese). Pure functions; no Budget import."""
+
+from __future__ import annotations
+
+
+def _check_yen(name: str, value: object) -> int:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{name} は整数(円)である必要があります: {value!r}")
+    if value < 0:
+        raise ValueError(f"{name} は 0 以上である必要があります: {value}")
+    return value
+
+
+def format_alert(level: str, category: str, limit: int, amount: int) -> str:
+    """level: "over" | "near" | "pace". Returns one line of Japanese text."""
+    if level not in ("over", "near", "pace"):
+        raise ValueError(f"未知の level です: {level!r}")
+    if not isinstance(category, str):
+        raise TypeError(f"category は str である必要があります: {category!r}")
+    limit = _check_yen("limit", limit)
+    amount = _check_yen("amount", amount)
+
+    if level == "over":
+        return (
+            f"警告: {category} {amount - limit:,}円超過 "
+            f"(予算 {limit:,} / 実績 {amount:,})"
+        )
+    if level == "near":
+        if limit == 0:
+            pct = "予算 0円に到達"
+        else:
+            pct = f"予算の {amount * 100 // limit}% に到達"
+        return (
+            f"注意: {category} {pct} "
+            f"(予算 {limit:,} / 実績 {amount:,} / 残り {limit - amount:,}円)"
+        )
+    # pace: amount is the projected month-end total
+    return f"注意: {category} このペースだと月末に {amount:,}円 (予算 {limit:,})"
+
+
+def format_alerts(rows: list[tuple[str, str, int, int]]) -> list[str]:
+    """Format each (level, category, limit, amount) row, keeping input order."""
+    return [
+        format_alert(level, cat, limit, amount) for level, cat, limit, amount in rows
+    ]
diff --git a/tests/test_budget_pace.py b/tests/test_budget_pace.py
new file mode 100644
index 0000000..f95a558
--- /dev/null
+++ b/tests/test_budget_pace.py
@@ -0,0 +1,135 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.budget_pace import pace_alerts
+
+
+@pytest.mark.parametrize(
+    ("actuals", "limits", "today", "expected", "id_"),
+    [
+        # E2-1: 500 * 30 // 10 = 1500 > 1000, 現時点は超過でない
+        ({"f": 500}, {"f": 1000}, date(2026, 11, 10), [("f", 1500, 1000)], "E2-1"),
+        # E2-2: 実績がちょうど予算でも、現時点で超過していなければ予測超過は対象
+        ({"f": 1000}, {"f": 1000}, date(2026, 11, 10), [("f", 3000, 1000)], "E2-2"),
+        # E2-3: min_day(7) 未満の日は空
+        ({"f": 999}, {"f": 1}, date(2026, 11, 6), [], "E2-3"),
+    ],
+    ids=["E2-1", "E2-2", "E2-3"],
+)
+def test_spec_examples(actuals, limits, today, expected, id_):
+    assert pace_alerts(actuals, limits, today) == expected
+
+
+def test_r2_excludes_already_over_budget():
+    # 実績が予算を超えている(現時点で超過)は pace に含めない
+    assert pace_alerts({"f": 1001}, {"f": 1000}, date(2026, 11, 10)) == []
+
+
+def test_r2_excludes_projection_within_budget():
+    # 予測 300 * 30 // 10 = 900 <= 1000 は対象外
+    assert pace_alerts({"f": 300}, {"f": 1000}, date(2026, 11, 10)) == []
+
+
+def test_r1_uses_leap_february():
+    # 2028 年 2 月は 29 日: 100 * 29 // 10 = 290
+    assert pace_alerts({"f": 100}, {"f": 200}, date(2028, 2, 10)) == [("f", 290, 200)]
+
+
+def test_r1_uses_non_leap_february():
+    # 2026 年 2 月は 28 日: 100 * 28 // 10 = 280
+    assert pace_alerts({"f": 100}, {"f": 200}, date(2026, 2, 10)) == [("f", 280, 200)]
+
+
+def test_r2_sorted_by_overrun_desc_then_name():
+    actuals = {"b": 500, "a": 500, "c": 100}
+    limits = {"a": 1000, "b": 1000, "c": 1000}
+    # projected: a=1500, b=1500 (over 500 each), c=300 (not over)
+    # 同点はカテゴリ名の昇順
+    assert pace_alerts(actuals, limits, date(2026, 11, 10)) == [
+        ("a", 1500, 1000),
+        ("b", 1500, 1000),
+    ]
+
+
+def test_r2_sort_prefers_larger_overrun():
+    actuals = {"a": 500, "b": 800}
+    limits = {"a": 1000, "b": 1000}
+    # a: 1500 (超過額 500), b: 2400 (超過額 1400)
+    assert pace_alerts(actuals, limits, date(2026, 11, 10)) == [
+        ("b", 2400, 1000),
+        ("a", 1500, 1000),
+    ]
+
+
+def test_min_day_boundary_day_7_is_evaluated():
+    # today.day == min_day(7) は対象: 100 * 30 // 7 = 428
+    assert pace_alerts({"f": 100}, {"f": 200}, date(2026, 11, 7)) == [("f", 428, 200)]
+
+
+def test_category_without_limit_is_ignored():
+    assert pace_alerts({"x": 999}, {}, date(2026, 11, 10)) == []
+
+
+def test_category_without_actual_counts_as_zero():
+    # 実績なし(0): 予測 0 <= 予算 なので対象外
+    assert pace_alerts({}, {"f": 1000}, date(2026, 11, 10)) == []
+
+
+def test_zero_limit_with_zero_actual_is_not_alert():
+    assert pace_alerts({"f": 0}, {"f": 0}, date(2026, 11, 10)) == []
+
+
+def test_custom_min_day_passes_at_threshold():
+    # 500 * 30 // 3 = 5000
+    assert pace_alerts({"f": 500}, {"f": 1000}, date(2026, 11, 3), min_day=3) == [
+        ("f", 5000, 1000)
+    ]
+
+
+def test_custom_min_day_blocks_before_threshold():
+    assert pace_alerts({"f": 500}, {"f": 1000}, date(2026, 11, 2), min_day=3) == []
+
+
+@pytest.mark.parametrize("bad", [True, 1.0, "1", None])
+def test_actual_wrong_type_raises_type_error(bad):
+    with pytest.raises(TypeError, match="actual"):
+        pace_alerts({"f": bad}, {"f": 1000}, date(2026, 11, 10))
+
+
+@pytest.mark.parametrize("bad", [True, 1.0, "1", None])
+def test_limit_wrong_type_raises_type_error(bad):
+    with pytest.raises(TypeError, match="limit"):
+        pace_alerts({"f": 500}, {"f": bad}, date(2026, 11, 10))
+
+
+def test_negative_actual_raises_value_error():
+    with pytest.raises(ValueError, match="actual"):
+        pace_alerts({"f": -1}, {"f": 1000}, date(2026, 11, 10))
+
+
+def test_negative_limit_raises_value_error():
+    with pytest.raises(ValueError, match="limit"):
+        pace_alerts({"f": 500}, {"f": -1}, date(2026, 11, 10))
+
+
+def test_today_must_be_date():
+    with pytest.raises(TypeError, match="today"):
+        pace_alerts({"f": 500}, {"f": 1000}, "2026-11-10")  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad", [0, 32, -1])
+def test_min_day_out_of_range_raises_value_error(bad):
+    with pytest.raises(ValueError, match="min_day"):
+        pace_alerts({"f": 500}, {"f": 1000}, date(2026, 11, 10), min_day=bad)
+
+
+def test_min_day_bool_raises_type_error():
+    with pytest.raises(TypeError, match="min_day"):
+        pace_alerts({"f": 500}, {"f": 1000}, date(2026, 11, 10), min_day=True)
+
+
+@pytest.mark.parametrize("bad", [7.0, "7", None])
+def test_min_day_non_int_raises_value_error(bad):
+    with pytest.raises(ValueError, match="min_day"):
+        pace_alerts({"f": 500}, {"f": 1000}, date(2026, 11, 10), min_day=bad)  # type: ignore[arg-type]
