@@ -0,0 +1,126 @@
+"""Tests for kakeibo.budget_status (budget over / near evaluation)."""
+
+from __future__ import annotations
+
+import pytest
+
+from kakeibo.budget_status import BudgetStatus, evaluate_month
+
+
+# 仕様の例表(E1-*)をそのまま写す。
+@pytest.mark.parametrize(
+    ("actuals", "limits", "expected"),
+    [
+        pytest.param(
+            {"food": 1000},
+            {"food": 1000},
+            [BudgetStatus("food", 1000, 1000, "near")],
+            id="E1-1",
+        ),
+        pytest.param(
+            {},
+            {"food": 0},
+            [BudgetStatus("food", 0, 0, "ok")],
+            id="E1-2",
+        ),
+        pytest.param(
+            {"a": True},
+            {"a": 10},
+            TypeError,
+            id="E1-3",
+        ),
+    ],
+)
+def test_spec_examples(actuals, limits, expected):
+    if expected is TypeError:
+        with pytest.raises(TypeError):
+            evaluate_month(actuals, limits)
+    else:
+        assert evaluate_month(actuals, limits) == expected
+
+
+# --- 仕様から導く追加の規則テスト ---
+
+
+def test_over_when_actual_exceeds_limit():
+    res = evaluate_month({"food": 1001}, {"food": 1000})
+    assert res == [BudgetStatus("food", 1000, 1001, "over")]
+
+
+def test_near_threshold_default_80_percent():
+    # 800 / 1000 は 80% ちょうどで near、799 は ok
+    assert evaluate_month({"f": 800}, {"f": 1000})[0].level == "near"
+    assert evaluate_month({"f": 799}, {"f": 1000})[0].level == "ok"
+
+
+def test_warn_percent_100_only_exact_limit_is_near():
+    assert evaluate_month({"f": 999}, {"f": 1000}, warn_percent=100)[0].level == "ok"
+    assert evaluate_month({"f": 1000}, {"f": 1000}, warn_percent=100)[0].level == "near"
+
+
+@pytest.mark.parametrize("bad", [0, 101, -1])
+def test_warn_percent_out_of_range_is_value_error(bad):
+    with pytest.raises(ValueError):
+        evaluate_month({}, {"f": 1}, warn_percent=bad)
+
+
+@pytest.mark.parametrize("bad", [True, 80.0, "80", None])
+def test_warn_percent_non_int_is_type_error(bad):
+    with pytest.raises(TypeError):
+        evaluate_month({}, {"f": 1}, warn_percent=bad)
+
+
+def test_zero_budget_zero_actual_is_ok_not_near():
+    assert evaluate_month({"f": 0}, {"f": 0})[0].level == "ok"
+
+
+def test_zero_budget_positive_actual_is_over():
+    assert evaluate_month({"f": 1}, {"f": 0})[0].level == "over"
+
+
+def test_category_only_in_actuals_is_ignored():
+    assert evaluate_month({"x": 500}, {}) == []
+
+
+@pytest.mark.parametrize("bad", [1.0, "1", None, True])
+def test_non_int_amount_is_type_error(bad):
+    with pytest.raises(TypeError):
+        evaluate_month({"f": bad}, {"f": 10})
+    with pytest.raises(TypeError):
+        evaluate_month({"f": 1}, {"f": bad})
+
+
+def test_negative_amount_is_value_error():
+    with pytest.raises(ValueError):
+        evaluate_month({"f": -1}, {"f": 10})
+    with pytest.raises(ValueError):
+        evaluate_month({"f": 1}, {"f": -10})
+
+
+def test_non_str_category_key_is_type_error():
+    with pytest.raises(TypeError):
+        evaluate_month({1: 10}, {"f": 10})  # type: ignore[dict-item]
+    with pytest.raises(TypeError):
+        evaluate_month({"f": 10}, {2: 10})  # type: ignore[dict-item]
+
+
+def test_ordering_over_then_near_then_ok():
+    actuals = {"ok1": 0, "near1": 90, "over_small": 1100, "over_big": 3000}
+    limits = {"ok1": 100, "near1": 100, "over_small": 1000, "over_big": 1000}
+    got = [s.category for s in evaluate_month(actuals, limits)]
+    # over: 超過額の大きい順 → near: 残りの小さい順 → ok: 名前順
+    assert got == ["over_big", "over_small", "near1", "ok1"]
+
+
+def test_near_sorted_by_remaining_then_name():
+    actuals = {"b": 850, "a": 850, "c": 900}
+    limits = {"a": 1000, "b": 1000, "c": 1000}
+    got = [s.category for s in evaluate_month(actuals, limits)]
+    # c は残り 100、a と b は残り 150 → 同点は名前順
+    assert got == ["c", "a", "b"]
+
+
+def test_ok_sorted_by_name_and_returns_all_limit_categories():
+    res = evaluate_month({}, {"z": 10, "m": 10})
+    assert [s.category for s in res] == ["m", "z"]
+    assert all(s.actual == 0 and s.level == "ok" for s in res)
