+"""Tests for kakeibo.budget_text (alert wording)."""
+
+from __future__ import annotations
+
+import pytest
+
+from kakeibo.budget_text import format_alert, format_alerts
+
+
+# 例の表(E3-x)の全行。ID はテストの中に書く。
+@pytest.mark.parametrize(
+    ("args", "expected"),
+    [
+        pytest.param(
+            ("over", "food", 1000, 1150),
+            "警告: food 150円超過 (予算 1,000 / 実績 1,150)",
+            id="E3-1",
+        ),
+        pytest.param(
+            ("pace", "food", 1000, 1300),
+            "注意: food このペースだと月末に 1,300円 (予算 1,000)",
+            id="E3-2",
+        ),
+        pytest.param(
+            ("bad", "food", 1, 1),
+            ValueError,
+            id="E3-3",
+        ),
+    ],
+)
+def test_spec_examples(args, expected):
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            format_alert(*args)
+    else:
+        assert format_alert(*args) == expected
+
+
+# R1: near
+def test_near_shows_percentage_and_remaining():
+    assert (
+        format_alert("near", "food", 1000, 900)
+        == "注意: food 予算の 90% に到達 (予算 1,000 / 実績 900 / 残り 100円)"
+    )
+
+
+def test_near_percentage_is_floored():
+    # 999 * 100 // 1000 = 99
+    assert format_alert("near", "food", 1000, 999) == (
+        "注意: food 予算の 99% に到達 (予算 1,000 / 実績 999 / 残り 1円)"
+    )
+
+
+def test_near_with_zero_limit_uses_yen_wording():
+    assert format_alert("near", "food", 0, 0) == (
+        "注意: food 予算 0円に到達 (予算 0 / 実績 0 / 残り 0円)"
+    )
+
+
+def test_over_with_zero_limit():
+    assert format_alert("over", "food", 0, 5) == "警告: food 5円超過 (予算 0 / 実績 5)"
+
+
+def test_amounts_use_thousands_separator():
+    assert format_alert("over", "rent", 100000, 1234567) == (
+        "警告: rent 1,134,567円超過 (予算 100,000 / 実績 1,234,567)"
+    )
+
+
+# R2: format_alerts
+def test_format_alerts_keeps_input_order_one_line_each():
+    rows = [
+        ("over", "food", 1000, 1150),
+        ("near", "book", 500, 450),
+        ("pace", "food", 1000, 1300),
+    ]
+    assert format_alerts(rows) == [
+        format_alert(*rows[0]),
+        format_alert(*rows[1]),
+        format_alert(*rows[2]),
+    ]
+
+
+def test_format_alerts_empty_returns_empty_list():
+    assert format_alerts([]) == []
+
+
+# R3: validation
+@pytest.mark.parametrize("bad", [True, False, 1.0, "1000", None])
+def test_limit_wrong_type_raises_type_error(bad):
+    with pytest.raises(TypeError, match="limit"):
+        format_alert("over", "food", bad, 1)
+
+
+@pytest.mark.parametrize("bad", [True, 1.5, "1", None])
+def test_amount_wrong_type_raises_type_error(bad):
+    with pytest.raises(TypeError, match="amount"):
+        format_alert("over", "food", 1, bad)
+
+
+def test_negative_limit_raises_value_error():
+    with pytest.raises(ValueError, match="limit"):
+        format_alert("over", "food", -1, 1)
+
+
+def test_negative_amount_raises_value_error():
+    with pytest.raises(ValueError, match="amount"):
+        format_alert("over", "food", 1, -1)
+
+
+def test_non_str_category_raises_type_error():
+    with pytest.raises(TypeError, match="category"):
+        format_alert("over", 1, 1, 1)  # type: ignore[arg-type]
+
+
+def test_format_alerts_propagates_validation_errors():
+    with pytest.raises(ValueError):
+        format_alerts([("bad", "food", 1, 1)])
