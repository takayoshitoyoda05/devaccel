@@ -0,0 +1,53 @@
+"""Budget pace alerts: project month-end spending and flag categories that will overrun."""
+
+from __future__ import annotations
+
+import calendar
+from datetime import date
+
+
+def _check_amount(value: object, name: str) -> int:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{name} は int (円) である必要があります: {value!r}")
+    if value < 0:
+        raise ValueError(f"{name} は 0 以上である必要があります: {value!r}")
+    return value
+
+
+def pace_alerts(
+    actuals: dict[str, int],
+    limits: dict[str, int],
+    today: date,
+    min_day: int = 7,
+) -> list[tuple[str, int, int]]:
+    """Return (category, projected, limit) for categories whose month-end projection
+    exceeds the limit while current actual spending has not yet exceeded it.
+
+    projected = actual * days_in_month // today.day (floor).
+    Returns [] when today.day < min_day. Sorted by (projected - limit) desc, then category asc.
+    """
+    if not isinstance(today, date):
+        raise TypeError(f"today は date である必要があります: {today!r}")
+    if isinstance(min_day, bool):
+        raise TypeError(f"min_day は int である必要があります: {min_day!r}")
+    if not isinstance(min_day, int) or not 1 <= min_day <= 31:
+        raise ValueError(f"min_day は 1〜31 の int である必要があります: {min_day!r}")
+
+    for cat, actual in actuals.items():
+        _check_amount(actual, f"actuals[{cat!r}]")
+    for cat, limit in limits.items():
+        _check_amount(limit, f"limits[{cat!r}]")
+
+    if today.day < min_day:
+        return []
+
+    days_in_month = calendar.monthrange(today.year, today.month)[1]
+    found: list[tuple[str, int, int]] = []
+    for cat, limit in limits.items():
+        actual = actuals.get(cat, 0)
+        projected = actual * days_in_month // today.day
+        if projected > limit and actual <= limit:
+            found.append((cat, projected, limit))
+
+    found.sort(key=lambda t: (-(t[1] - t[2]), t[0]))
+    return found
