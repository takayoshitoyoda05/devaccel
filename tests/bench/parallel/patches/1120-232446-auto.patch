@@ -0,0 +1,357 @@
+"""Import bank / credit-card CSV text into Expense records (pure functions).
+
+Input is CSV *text* (no file IO). Bad rows never raise: they are reported as
+RowError(line, column, value, reason) next to the rows that did parse.
+
+Decisions:
+D1: 区切りは見出し行の `,` とタブの多い方(同数なら `,`)。先頭の BOM と CRLF/CR/LF は許す。
+D2: 見出しは NFKC・大文字小文字・空白を無視して別名を照合する。同じ項目に複数の列が
+    当たったら最初の列を使う。順序は問わない。
+D3: 必須列(日付、金額か出金額)が無いときは行ごとの検査をせず、見出し行の位置で
+    列が無いエラーだけ返す(expenses は空)。
+D4: 空入力・見出しだけは「空の結果・エラー無し」。空行と全列が空の行は黙って飛ばす。
+D5: 行番号はレコードの開始行(1 始まり)。引用符内の改行を含むレコードでも開始行を報告する。
+D6: 1 行の誤りは全部報告する(日付・金額・列数の順)。列数が見出しと違う行(桁区切りの
+    引用忘れ `1,234円` を含む)は、修復せず「列数の誤り」だけ報告する(他の列は信用できない)。
+D7: 金額は NFKC で正規化(全角数字・`，`・`￥`・全角空白)し、`¥` `円` `JPY` と空白を除く。
+    桁区切りは 3 桁区切りの `,` のみ(`1,23` は不正)。
+D8: 負号は `-` `−`(U+2212) `△` `▲` 先頭、`500-` 末尾、`(500)` 括弧。重ねたら不正。
+    負の金額は返金として負のまま受け取る。`+500` は 500。
+D9: 小数(`12.5`、`12.0`)は丸めず拒否する。0 は受け付ける。単独の金額列で空欄・`-`・`—` は拒否。
+D10: 出金/入金に分かれた形式は、出金が 0 以外なら支出、入金だけ 0 以外の行は収入として
+     スキップ(skipped に数える)。出金・入金とも空欄(`-` 含む)なら金額なしで拒否。
+     両方 0 の行は動きが無いのでスキップ。出金・入金とも 0 以外なら曖昧なので拒否。
+     単独の金額列がある場合はそちらを優先する。
+D11: 日付は `2026-01-05` `2026/1/5` `2026.1.5` `2026年1月5日` `20260105`、和暦
+     (`令和8年1月5日` `R8.1.5` `令和元年5月1日`)。区切りの混在、2 桁年、2/30 のような
+     存在しない日付は拒否。末尾の時刻(`2026/1/5 12:34[:56]`、`T` 区切り)は捨てる。
+D12: カテゴリ列が無い、または空欄なら DEFAULT_CATEGORY。メモは前後の空白だけ除く。
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass, field
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_CATEGORY = "未分類"
+
+_DATE_ALIASES = (
+    "date",
+    "日付",
+    "利用日",
+    "ご利用日",
+    "取引日",
+    "年月日",
+    "日時",
+    "お取引日",
+)
+_AMOUNT_ALIASES = ("amount", "金額", "利用金額", "ご利用金額", "取引金額")
+_OUT_ALIASES = (
+    "出金額",
+    "出金",
+    "支払金額",
+    "お支払金額",
+    "支払",
+    "お支払い金額",
+    "お引出し",
+)
+_IN_ALIASES = ("入金額", "入金", "預入金額", "預入", "お預入れ", "お預り金額")
+_MEMO_ALIASES = (
+    "memo", "description", "摘要", "メモ", "利用店名", "ご利用店名", "内容",
+    "ご利用内容", "取引内容", "備考",
+)  # fmt: skip
+_CATEGORY_ALIASES = ("category", "カテゴリ", "カテゴリー", "分類", "費目")
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int  # 1-based line where the record starts
+    column: str  # column name as written in the header ("" if not column-specific)
+    value: str  # original text
+    reason: str
+
+    def __str__(self) -> str:
+        col = f" 列 {self.column!r}" if self.column else ""
+        val = f" {self.value!r}" if self.value else ""
+        return f"{self.line} 行目{col}{val}: {self.reason}"
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense] = field(default_factory=list)
+    errors: list[RowError] = field(default_factory=list)
+    skipped: int = 0  # income-only / zero-movement rows
+
+    @property
+    def ok(self) -> bool:
+        return not self.errors
+
+
+class _Bad(Exception):
+    """Internal: a single value failed to parse."""
+
+
+def _norm_header(s: str) -> str:
+    return re.sub(r"\s+", "", unicodedata.normalize("NFKC", s)).casefold()
+
+
+def _find(norm_headers: list[str], aliases: tuple[str, ...]) -> int | None:
+    wanted = {_norm_header(a) for a in aliases}
+    for i, h in enumerate(norm_headers):
+        if h in wanted:
+            return i
+    return None
+
+
+_BLANK = {"", "-", "—", "–", "―"}
+_DIGITS = re.compile(r"[0-9]+|[0-9]{1,3}(,[0-9]{3})+")
+_DECIMAL = re.compile(r"[0-9]+\.[0-9]+")
+
+
+def _is_blank(raw: str) -> bool:
+    return unicodedata.normalize("NFKC", raw).strip() in _BLANK
+
+
+def parse_amount(raw: str) -> int:
+    """Parse a yen string (see D7-D9). Raises ValueError with the reason."""
+    try:
+        return _parse_amount(raw)
+    except _Bad as e:
+        raise ValueError(str(e)) from None
+
+
+def _parse_amount(raw: str) -> int:
+    s = unicodedata.normalize("NFKC", raw)
+    s = re.sub(r"\s+", "", s).replace("−", "-")
+    if s in _BLANK:
+        raise _Bad("金額が空です")
+    s = re.sub(r"JPY|円|¥", "", s, flags=re.IGNORECASE)
+    neg = 0
+    if s.startswith("(") and s.endswith(")"):
+        s = s[1:-1]
+        neg += 1
+    if s and s[0] in "-△▲":
+        s = s[1:]
+        neg += 1
+    elif s.startswith("+"):
+        s = s[1:]
+    if s.endswith("-"):
+        s = s[:-1]
+        neg += 1
+    if neg > 1:
+        raise _Bad("符号が重複しています")
+    if _DECIMAL.fullmatch(s):
+        raise _Bad("小数は受け付けません(円の整数のみ)")
+    if not _DIGITS.fullmatch(s):
+        raise _Bad("金額として読めません")
+    n = int(s.replace(",", ""))
+    return -n if neg else n
+
+
+_ERA_BASE = {"令和": 2018, "R": 2018, "平成": 1988, "H": 1988, "昭和": 1925, "S": 1925}
+_ERA_RE = re.compile(
+    r"(令和|平成|昭和|[RHS])(元|[0-9]{1,2})([年./-])([0-9]{1,2})([月./-])([0-9]{1,2})日?",
+    re.IGNORECASE,
+)
+_ISO_RE = re.compile(r"([0-9]{4})([-/.])([0-9]{1,2})\2([0-9]{1,2})")
+_KANJI_RE = re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日?")
+_COMPACT_RE = re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})")
+_TIME_TAIL = re.compile(r"[ T]+[0-9]{1,2}:[0-9]{2}(:[0-9]{2})?")
+
+
+def parse_date(raw: str) -> date:
+    """Parse a date string (see D11). Raises ValueError with the reason."""
+    try:
+        return _parse_date(raw)
+    except _Bad as e:
+        raise ValueError(str(e)) from None
+
+
+def _parse_date(raw: str) -> date:
+    s = unicodedata.normalize("NFKC", raw).strip()
+    if not s:
+        raise _Bad("日付が空です")
+    s = _TIME_TAIL.sub("", s, count=1) if _TIME_TAIL.search(s) else s
+    s = s.strip()
+    ymd: tuple[int, int, int]
+    if m := _ISO_RE.fullmatch(s):
+        ymd = (int(m[1]), int(m[3]), int(m[4]))
+    elif (m := _KANJI_RE.fullmatch(s)) or (m := _COMPACT_RE.fullmatch(s)):
+        ymd = (int(m[1]), int(m[2]), int(m[3]))
+    elif m := _ERA_RE.fullmatch(s):
+        era = m[1] if m[1] in _ERA_BASE else m[1].upper()
+        # separators must be consistent: 年月日 together or the same symbol
+        if (m[3] == "年") != (m[5] == "月") or (m[3] != "年" and m[3] != m[5]):
+            raise _Bad(f"日付の区切りが不統一です: {raw!r}")
+        n = 1 if m[2] == "元" else int(m[2])
+        ymd = (_ERA_BASE[era] + n, int(m[4]), int(m[6]))
+    else:
+        raise _Bad(f"日付の書式が不明です: {raw!r}")
+    try:
+        return date(*ymd)
+    except ValueError:
+        raise _Bad(f"存在しない日付です: {raw!r}") from None
+
+
+def _detect_delimiter(text: str) -> str:
+    first = next((ln for ln in text.splitlines() if ln.strip()), "")
+    return "\t" if first.count("\t") > first.count(",") else ","
+
+
+def import_csv(text: str) -> ImportResult:
+    """Parse bank/card CSV text. Never raises on bad data; see ImportResult."""
+    text = text.removeprefix("﻿")
+    reader = csv.reader(
+        io.StringIO(text, newline=""), delimiter=_detect_delimiter(text)
+    )
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    skipped = 0
+
+    header: list[str] | None = None
+    idx: dict[str, int | None] = {}
+    prev_end = 0
+    while True:
+        try:
+            rec = next(reader)
+        except StopIteration:
+            break
+        except csv.Error as e:
+            errors.append(RowError(prev_end + 1, "", "", f"CSV として読めません: {e}"))
+            break
+        start, prev_end = prev_end + 1, reader.line_num
+        if not any(c.strip() for c in rec):
+            continue
+
+        if header is None:
+            header = rec
+            norm = [_norm_header(h) for h in header]
+            idx = {
+                "date": _find(norm, _DATE_ALIASES),
+                "amount": _find(norm, _AMOUNT_ALIASES),
+                "out": _find(norm, _OUT_ALIASES),
+                "in": _find(norm, _IN_ALIASES),
+                "memo": _find(norm, _MEMO_ALIASES),
+                "category": _find(norm, _CATEGORY_ALIASES),
+            }
+            if idx["date"] is None:
+                errors.append(
+                    RowError(
+                        start,
+                        "",
+                        "",
+                        f"日付の列がありません(例: {', '.join(_DATE_ALIASES[:4])})",
+                    )
+                )
+            if idx["amount"] is None and idx["out"] is None:
+                errors.append(
+                    RowError(
+                        start,
+                        "",
+                        "",
+                        f"金額の列がありません(例: {', '.join(_AMOUNT_ALIASES[:3])}、または出金額)",
+                    )
+                )
+            if errors:
+                break
+            continue
+
+        if len(rec) != len(header):
+            hint = (
+                "(桁区切りの `,` を含む値は引用符で囲まれていますか)"
+                if len(rec) > len(header)
+                else ""
+            )
+            errors.append(
+                RowError(
+                    start,
+                    "",
+                    "",
+                    f"列数が見出しと違います(見出し {len(header)} 列、この行 {len(rec)} 列){hint}",
+                )
+            )
+            continue
+
+        row_errors: list[RowError] = []
+
+        def cell(
+            key: str, rec: list[str] = rec, idx: dict[str, int | None] = idx
+        ) -> str:
+            i = idx[key]
+            return rec[i] if i is not None else ""
+
+        def name(
+            key: str, hdr: list[str] = header, idx: dict[str, int | None] = idx
+        ) -> str:
+            i = idx[key]
+            assert i is not None
+            return hdr[i]
+
+        day: date | None = None
+        try:
+            day = _parse_date(cell("date"))
+        except _Bad as e:
+            row_errors.append(RowError(start, name("date"), cell("date"), str(e)))
+
+        amount: int | None = None
+        skip = False
+        if idx["amount"] is not None:
+            try:
+                amount = _parse_amount(cell("amount"))
+            except _Bad as e:
+                row_errors.append(
+                    RowError(start, name("amount"), cell("amount"), str(e))
+                )
+        else:
+            assert idx["out"] is not None
+            out_raw = cell("out")
+            in_raw = cell("in") if idx["in"] is not None else ""
+            out = inc = None
+            for key, raw in (("out", out_raw), ("in", in_raw)):
+                if _is_blank(raw):
+                    continue
+                try:
+                    val = _parse_amount(raw)
+                except _Bad as e:
+                    row_errors.append(RowError(start, name(key), raw, str(e)))
+                    continue
+                if key == "out":
+                    out = val
+                else:
+                    inc = val
+            if not row_errors:
+                if out is None and inc is None:
+                    row_errors.append(
+                        RowError(start, name("out"), out_raw, "出金額も入金額も空です")
+                    )
+                elif out and inc:
+                    row_errors.append(
+                        RowError(
+                            start,
+                            name("out"),
+                            out_raw,
+                            "出金額と入金額の両方に金額があります",
+                        )
+                    )
+                elif out:
+                    amount = out
+                else:
+                    skip = True  # income-only or all-zero movement
+
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        if skip:
+            skipped += 1
+            continue
+        assert day is not None and amount is not None
+        category = cell("category").strip() or DEFAULT_CATEGORY
+        expenses.append(Expense(day, category, amount, cell("memo").strip()))
+
+    return ImportResult(expenses, errors, skipped)
diff --git a/tests/test_importer.py b/tests/test_importer.py
new file mode 100644
index 0000000..d624217
--- /dev/null
+++ b/tests/test_importer.py
@@ -0,0 +1,179 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.importer import DEFAULT_CATEGORY, import_csv, parse_amount, parse_date
+
+
+@pytest.mark.parametrize(
+    ("raw", "want"),
+    [
+        ("1234", 1234),
+        ("1,234", 1234),
+        ("１，２３４", 1234),
+        ("¥1,234", 1234),
+        ("￥1234", 1234),
+        ("1,234円", 1234),
+        ("JPY 500", 500),
+        ("1 234".replace(" ", "　"), 1234),
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("-¥500", -500),
+        ("+500", 500),
+        ("0", 0),
+    ],
+)
+def test_parse_amount_ok(raw: str, want: int) -> None:
+    assert parse_amount(raw) == want
+
+
+@pytest.mark.parametrize(
+    "raw", ["", "-", "—", "abc", "12.5", "12.0", "1,23", "--5", "(-5)", "5-円-"]
+)
+def test_parse_amount_bad(raw: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(raw)
+
+
+@pytest.mark.parametrize(
+    ("raw", "want"),
+    [
+        ("2026-01-05", date(2026, 1, 5)),
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026.1.5", date(2026, 1, 5)),
+        ("2026年1月5日", date(2026, 1, 5)),
+        ("２０２６／１／５", None),  # NFKC maps ／ to / -> accepted below
+        ("20260105", date(2026, 1, 5)),
+        ("2026/1/5 12:34", date(2026, 1, 5)),
+        ("2026-01-05T12:34:56", date(2026, 1, 5)),
+        ("令和8年1月5日", date(2026, 1, 5)),
+        ("R8.1.5", date(2026, 1, 5)),
+        ("令和元年5月1日", date(2019, 5, 1)),
+        ("2024-02-29", date(2024, 2, 29)),
+    ],
+)
+def test_parse_date_ok(raw: str, want: date | None) -> None:
+    assert parse_date(raw) == (want or date(2026, 1, 5))
+
+
+@pytest.mark.parametrize(
+    "raw",
+    ["", "2026/1-5", "2026-02-30", "2025-02-29", "26/1/5", "1/5", "R8.1年5", "abc"],
+)
+def test_parse_date_bad(raw: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(raw)
+
+
+def test_card_csv_with_bom_and_aliases() -> None:
+    text = '﻿利用日,ご利用店名,利用金額\r\n2026/1/5,コンビニ,"1,234"\r\n2026/1/6,返金,▲300\r\n'
+    r = import_csv(text)
+    assert r.ok
+    assert r.expenses == [
+        Expense(date(2026, 1, 5), DEFAULT_CATEGORY, 1234, "コンビニ"),
+        Expense(date(2026, 1, 6), DEFAULT_CATEGORY, -300, "返金"),
+    ]
+
+
+def test_header_case_space_order_and_category() -> None:
+    r = import_csv(" Amount , Category ,DATE\n500,食費,2026-01-05\n300, ,2026-01-06\n")
+    assert [(e.category, e.amount) for e in r.expenses] == [
+        ("食費", 500),
+        (DEFAULT_CATEGORY, 300),
+    ]
+
+
+def test_tab_delimited() -> None:
+    r = import_csv("取引日\t摘要\t金額\n2026-01-05\tATM, 手数料\t220\n")
+    assert r.ok and r.expenses == [
+        Expense(date(2026, 1, 5), DEFAULT_CATEGORY, 220, "ATM, 手数料")
+    ]
+
+
+def test_split_out_in_columns() -> None:
+    text = '日付,摘要,出金額,入金額\n2026-01-05,家賃,"80,000",\n2026-01-25,給与,,300000\n2026-01-26,なし,0,0\n'
+    r = import_csv(text)
+    assert r.ok
+    assert r.expenses == [Expense(date(2026, 1, 5), DEFAULT_CATEGORY, 80000, "家賃")]
+    assert r.skipped == 2
+
+
+def test_split_columns_errors() -> None:
+    r = import_csv(
+        "日付,出金額,入金額\n2026-01-05,,\n2026-01-05,-,\n2026-01-05,100,200\n2026-01-05,x,y\n"
+    )
+    assert [e.line for e in r.errors] == [2, 3, 4, 5, 5]
+    assert [e.column for e in r.errors] == [
+        "出金額",
+        "出金額",
+        "出金額",
+        "出金額",
+        "入金額",
+    ]
+
+
+def test_single_amount_wins_over_split() -> None:
+    r = import_csv("日付,金額,出金額\n2026-01-05,100,999\n")
+    assert r.expenses[0].amount == 100
+
+
+def test_row_reports_every_error_with_line_column_value() -> None:
+    r = import_csv("date,amount\n2026-02-30,abc\n2026-01-05,100\n")
+    assert [(e.line, e.column, e.value) for e in r.errors] == [
+        (2, "date", "2026-02-30"),
+        (2, "amount", "abc"),
+    ]
+    assert len(r.expenses) == 1  # good row is still imported
+    assert "2 行目" in str(r.errors[0]) and "2026-02-30" in str(r.errors[0])
+
+
+def test_unquoted_thousands_separator_reports_column_count() -> None:
+    r = import_csv("日付,金額\n2026-01-05,1,234円\n")
+    assert len(r.errors) == 1
+    assert r.errors[0].line == 2
+    assert "列数" in r.errors[0].reason and "引用符" in r.errors[0].reason
+    assert r.expenses == []
+
+
+def test_too_few_columns() -> None:
+    r = import_csv("日付,金額,摘要\n2026-01-05,100\n")
+    assert [e.line for e in r.errors] == [2] and "列数" in r.errors[0].reason
+
+
+def test_line_number_is_record_start_with_quoted_newline() -> None:
+    text = '日付,金額,メモ\n2026-01-05,100,"a\nb"\n\nxxx,100,m\n'
+    r = import_csv(text)
+    assert r.expenses[0].memo == "a\nb"
+    assert [e.line for e in r.errors] == [5]
+
+
+def test_missing_required_columns() -> None:
+    r = import_csv("日付,摘要\n2026-01-05,x\n")
+    assert r.expenses == [] and len(r.errors) == 1
+    assert r.errors[0].line == 1 and "金額" in r.errors[0].reason
+    r = import_csv("摘要,メモ\nx,y\n")
+    assert len(r.errors) == 2
+
+
+@pytest.mark.parametrize("text", ["", "\n\n", "日付,金額\n", "﻿日付,金額\r\n,\r\n"])
+def test_empty_and_header_only(text: str) -> None:
+    r = import_csv(text)
+    assert r.ok and r.expenses == [] and r.skipped == 0
+
+
+def test_blank_lines_skipped_and_crlf_cr() -> None:
+    r = import_csv("日付,金額\r\n\r\n2026-01-05,1\r\n,\r\n2026-01-06,2\r\n")
+    assert [e.amount for e in r.expenses] == [1, 2]
+    r = import_csv("日付,金額\r2026-01-05,1\r2026-01-06,x\r")
+    assert [e.line for e in r.errors] == [3]
+
+
+def test_single_column_amount_blank_rejected() -> None:
+    r = import_csv("日付,金額\n2026-01-05,\n2026-01-05,-\n2026-01-05,0\n")
+    assert [e.line for e in r.errors] == [2, 3]
+    assert [e.amount for e in r.expenses] == [0]
