+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import ImportResult, RowError, import_bank_csv
+from kakeibo.core import Expense
+
+
+# E1: 例の表(ID はテスト名・parametrize の ids に書く)
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param(
+            '利用日,ご利用店名,利用金額\n2026/1/5,ネットフリックス,"1,490円"',
+            ImportResult(
+                [Expense(date(2026, 1, 5), "未分類", 1490, "ネットフリックス")], []
+            ),
+            id="E1-1",
+        ),
+        pytest.param(
+            "日付,摘要,出金額,入金額\n2026-01-06,給与,,300000",
+            ImportResult([], []),
+            id="E1-2",
+        ),
+    ],
+)
+def test_example_table(text: str, expected: ImportResult) -> None:
+    assert import_bank_csv(text) == expected
+
+
+def test_E1_3_date_and_amount_both_reported_on_same_row() -> None:
+    # E1-3: 1 行の誤りは全部集め、(行番号, 列名, 元の値, 理由) で返す
+    result = import_bank_csv("date,amount\n2026-02-30,12.5")
+    assert result.expenses == []
+    assert [(e.line, e.column, e.value) for e in result.errors] == [
+        (2, "date", "2026-02-30"),
+        (2, "amount", "12.5"),
+    ]
+    assert all(isinstance(e, RowError) and e.reason for e in result.errors)
+
+
+# R3: 日付の書式
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026.1.5",
+        "20260105",
+        "2026年1月5日",
+        "2026-01-05 12:34",
+        "2026-01-05 12:34:56",
+        "２０２６-０１-０５",
+    ],
+)
+def test_date_formats(raw: str) -> None:
+    result = import_bank_csv(f'date,amount\n"{raw}",100')
+    assert result.errors == []
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+# R4: 金額の書き方(正)
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        ("1234", 1234),
+        ("1,234", 1234),
+        ("1，２３４", 1234),
+        ("¥1,234", 1234),
+        ("￥1,234", 1234),
+        ("1,234円", 1234),
+        ("JPY 1,234", 1234),
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+    ],
+)
+def test_amount_formats(raw: str, expected: int) -> None:
+    result = import_bank_csv(f'date,amount\n2026-01-05,"{raw}"')
+    assert result.errors == []
+    assert result.expenses[0].amount == expected
+
+
+# R4: 金額の誤り(丸めない・符号の重複などは誤り)
+@pytest.mark.parametrize("raw", ["12.5", "1,23", "--5", "abc"])
+def test_amount_invalid_is_row_error(raw: str) -> None:
+    result = import_bank_csv(f'date,amount\n2026-01-05,"{raw}"')
+    assert result.expenses == []
+    assert [(e.line, e.column, e.value) for e in result.errors] == [(2, "amount", raw)]
+
+
+# R2: 列名の別名・カテゴリ・メモ
+def test_category_alias_and_memo_column() -> None:
+    result = import_bank_csv(" Date ,分類,金額,摘要\n2026-01-05,食費,100,スーパー")
+    assert result.expenses == [Expense(date(2026, 1, 5), "食費", 100, "スーパー")]
+
+
+# R4: 出金・入金の別列
+def test_split_columns_withdrawal_positive_deposit_skipped() -> None:
+    text = "日付,出金,入金\n2026-01-05,100,\n2026-01-06,,300\n2026-01-07,,500"
+    result = import_bank_csv(text)
+    assert result.errors == []
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+def test_split_columns_both_empty_is_error() -> None:
+    result = import_bank_csv("日付,出金,入金\n2026-01-05,,")
+    assert result.expenses == []
+    assert [(e.line, e.column) for e in result.errors] == [(2, "出金")]
+
+
+# R1: 区切り・BOM・改行
+def test_bom_and_crlf() -> None:
+    result = import_bank_csv("﻿日付,金額\r\n2026-01-05,1000\r\n")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 1000, "")]
+
+
+def test_tab_delimiter_and_cr_only_newlines() -> None:
+    result = import_bank_csv("日付\t金額\r2026-01-05\t1000\r")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 1000, "")]
+
+
+def test_quoted_newline_counts_as_one_record_for_line_numbers() -> None:
+    text = 'date,amount,memo\n2026-01-05,100,"a\nb"\n2026-01-06,x,y'
+    result = import_bank_csv(text)
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "a\nb")]
+    assert [(e.line, e.column) for e in result.errors] == [(4, "amount")]
+
+
+# R5: 必須列・空入力・空行・列数
+def test_missing_amount_and_withdrawal_column_raises() -> None:
+    with pytest.raises(ValueError):
+        import_bank_csv("date,memo\n2026-01-05,x")
+
+
+def test_missing_date_column_raises() -> None:
+    with pytest.raises(ValueError):
+        import_bank_csv("amount\n100")
+
+
+@pytest.mark.parametrize("text", ["", "日付,金額\n"])
+def test_empty_or_header_only(text: str) -> None:
+    assert import_bank_csv(text) == ImportResult([], [])
+
+
+def test_blank_lines_ignored() -> None:
+    result = import_bank_csv("date,amount\n\n2026-01-05,100\n\n")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+    assert result.errors == []
+
+
+def test_excess_columns_is_error() -> None:
+    result = import_bank_csv("date,amount\n2026-01-05,100,extra")
+    assert result.expenses == []
+    assert [(e.line, e.column) for e in result.errors] == [(2, "(列数)")]
+
+
+def test_short_row_missing_required_value_is_error() -> None:
+    result = import_bank_csv("date,amount,memo\n2026-01-05")
+    assert result.expenses == []
+    assert [(e.line, e.column, e.value) for e in result.errors] == [(2, "amount", "")]
+
+
+# R6: 元の行の順を保つ
+def test_order_is_preserved() -> None:
+    result = import_bank_csv("date,amount\n2026-01-06,2\n2026-01-05,1")
+    assert [e.amount for e in result.expenses] == [2, 1]
diff --git a/tests/test_monthly_diff.py b/tests/test_monthly_diff.py
new file mode 100644
index 0000000..8c51505
--- /dev/null
+++ b/tests/test_monthly_diff.py
@@ -0,0 +1,141 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthly_diff import compare_months, format_diff
+
+
+def _e(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+# E4-1: 前月 食費 20000、今月 食費 25000 -> delta=5000, percent=25.0 (R2)
+# E4-2: compare_months(rows, "2026-01") で前月は 2025-12 -> previous="2025-12" (R1)
+# E4-3: 前月だけにある 交通費 3000 -> current=0, delta=-3000, percent=-100.0 (R2)
+@pytest.mark.parametrize(
+    ("rows", "month", "check"),
+    [
+        pytest.param(
+            [_e("2026-02-03", "食費", 20000), _e("2026-03-03", "食費", 25000)],
+            "2026-03",
+            lambda d: d.rows[0].delta == 5000 and d.rows[0].percent == 25.0,
+            id="E4-1",
+        ),
+        pytest.param(
+            [_e("2025-12-10", "食費", 100), _e("2026-01-10", "食費", 200)],
+            "2026-01",
+            lambda d: d.previous == "2025-12",
+            id="E4-2",
+        ),
+        pytest.param(
+            [_e("2026-02-03", "交通費", 3000)],
+            "2026-03",
+            lambda d: (
+                d.rows[0].category == "交通費"
+                and d.rows[0].current == 0
+                and d.rows[0].delta == -3000
+                and d.rows[0].percent == -100.0
+            ),
+            id="E4-3",
+        ),
+    ],
+)
+def test_spec_examples(rows, month, check):
+    assert check(compare_months(rows, month))
+
+
+def test_previous_month_is_calendar_month_not_last_data_month():
+    rows = [_e("2026-01-05", "食費", 100), _e("2026-03-05", "食費", 300)]
+    d = compare_months(rows, "2026-04")
+    assert d.previous == "2026-03"
+    assert d.rows[0].previous == 300
+
+
+def test_previous_is_zero_gives_none_percent_and_new_label():
+    d = compare_months([_e("2026-03-01", "食費", 500)], "2026-03")
+    assert d.rows[0].previous == 0
+    assert d.rows[0].percent is None
+    assert "(新規)" in format_diff(d)
+
+
+def test_previous_zero_and_current_zero_row_is_omitted():
+    rows = [_e("2026-02-01", "食費", 0), _e("2026-03-01", "食費", 0)]
+    d = compare_months(rows, "2026-03")
+    assert d.rows == []
+
+
+def test_zero_delta_is_shown_with_plus_minus_zero():
+    rows = [_e("2026-02-01", "食費", 1000), _e("2026-03-01", "食費", 1000)]
+    d = compare_months(rows, "2026-03")
+    assert d.rows[0].delta == 0
+    assert "±0" in format_diff(d)
+
+
+def test_negative_current_with_previous_is_not_new():
+    rows = [_e("2026-02-01", "食費", 1000), _e("2026-03-01", "食費", -500)]
+    d = compare_months(rows, "2026-03")
+    assert d.rows[0].delta == -1500
+    assert d.rows[0].percent == -150.0
+    assert "(-150.0%)" in format_diff(d)
+
+
+def test_sort_by_abs_delta_desc_then_category_asc():
+    rows = [
+        _e("2026-02-01", "住居", 1000),
+        _e("2026-02-01", "食費", 1000),
+        _e("2026-02-01", "通信", 1000),
+        _e("2026-03-01", "住居", 1000),
+        _e("2026-03-01", "食費", 1000 + 300),
+        _e("2026-03-01", "通信", 1000 - 300),
+        _e("2026-03-01", "雑費", 5000),
+    ]
+    d = compare_months(rows, "2026-03")
+    # 雑費: |5000| / 通信・食費: |300| で同点 -> 名前の昇順 / 住居: 差額 0 は最後
+    assert [r.category for r in d.rows] == ["雑費", "通信", "食費", "住居"]
+
+
+def test_total_is_not_in_rows_and_sums_all_categories():
+    rows = [
+        _e("2026-02-01", "食費", 1000),
+        _e("2026-02-01", "交通費", 500),
+        _e("2026-03-01", "食費", 2000),
+    ]
+    d = compare_months(rows, "2026-03")
+    assert all(r.category != "合計" for r in d.rows)
+    assert d.total.category == "合計"
+    assert d.total.previous == 1500
+    assert d.total.current == 2000
+    assert d.total.delta == 500
+    assert d.total.percent == 33.3
+
+
+def test_both_months_empty_gives_empty_rows_and_zero_total():
+    d = compare_months([], "2026-03")
+    assert d.rows == []
+    assert d.total.previous == 0
+    assert d.total.current == 0
+    assert d.total.delta == 0
+    assert d.total.percent is None
+
+
+@pytest.mark.parametrize("bad", ["2026-3", "2026-13", "2026-00", "202603", "abcd-ef"])
+def test_invalid_month_raises_value_error(bad):
+    with pytest.raises(ValueError):
+        compare_months([], bad)
+
+
+def test_format_diff_last_line_is_total_and_shape():
+    rows = [_e("2026-02-01", "食費", 20000), _e("2026-03-01", "食費", 25000)]
+    text = format_diff(compare_months(rows, "2026-03"))
+    lines = text.splitlines()
+    assert lines[0] == "食費  20000 → 25000  +5000 (+25.0%)"
+    assert lines[-1].startswith("合計  ")
+
+
+def test_format_diff_decrease_uses_minus_sign():
+    rows = [_e("2026-02-01", "食費", 20000), _e("2026-03-01", "食費", 15000)]
+    text = format_diff(compare_months(rows, "2026-03"))
+    assert "-5000 (-25.0%)" in text.splitlines()[0]
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..aed56da
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,185 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, next_due
+
+
+def ex(day: str, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+E21_ROWS = [
+    ex("2026-01-31", "住居", 80000, "家賃"),
+    ex("2026-02-28", "住居", 80000, "家賃"),
+    ex("2026-03-31", "住居", 80000, "家賃"),
+]
+E22_ROWS = [
+    ex("2026-01-10", "娯楽", 1490, "Netflix 1"),
+    ex("2026-02-10", "娯楽", 1490, "Netflix 2"),
+    ex("2026-03-10", "娯楽", 1600, "Netflix 3"),
+]
+E23_ROWS = [
+    ex("2026-01-15", "通信", 5000, "携帯"),
+    ex("2026-02-15", "通信", 5000, "携帯"),
+    ex("2026-04-15", "通信", 5000, "携帯"),
+    ex("2026-05-15", "通信", 5000, "携帯"),
+]
+
+
+@pytest.mark.parametrize(
+    ("rows", "expected"),
+    [
+        pytest.param(E21_ROWS, [("住居", "家賃", 80000, 3, 31)], id="E2-1"),
+        pytest.param(E22_ROWS, [("娯楽", "Netflix 3", 1490, 3, 10)], id="E2-2"),
+        pytest.param(E23_ROWS, [], id="E2-3"),
+    ],
+)
+def test_find_recurring_examples(rows: list[Expense], expected: list[tuple]) -> None:
+    got = find_recurring(rows)
+    assert [(r.category, r.memo, r.amount, r.months, r.day) for r in got] == expected
+
+
+@pytest.mark.parametrize(
+    ("recurring", "expected"),
+    [
+        pytest.param(
+            Recurring("住居", "家賃", 80000, 3, date(2026, 3, 31), 31),
+            date(2026, 4, 30),
+            id="E2-1",
+        ),
+    ],
+)
+def test_next_due_examples(recurring: Recurring, expected: date) -> None:
+    assert next_due(recurring) == expected
+
+
+def test_E2_1_series_is_found_from_fixture() -> None:
+    (r,) = find_recurring(E21_ROWS)
+    assert next_due(r) == date(2026, 4, 30)
+
+
+# --- edge cases derived from the rule list ---
+
+
+def test_negative_and_zero_amounts_are_excluded() -> None:
+    rows = [
+        ex("2026-01-05", "雑費", 500, "x"),
+        ex("2026-02-05", "雑費", 0, "x"),
+        ex("2026-03-05", "雑費", -500, "x"),
+        ex("2026-04-05", "雑費", 500, "x"),
+        ex("2026-05-05", "雑費", 500, "x"),
+    ]
+    # Jan, Apr, May only (Feb/Mar removed) -> no run of 3
+    assert find_recurring(rows) == []
+
+
+def test_duplicate_month_is_not_recurring() -> None:
+    rows = [
+        ex("2026-01-05", "雑費", 300, "水"),
+        ex("2026-01-20", "雑費", 300, "水"),
+        ex("2026-02-05", "雑費", 300, "水"),
+        ex("2026-03-05", "雑費", 300, "水"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_gap_keeps_only_last_run() -> None:
+    rows = [ex(f"2026-{m:02d}-10", "保険", 2000, "生命") for m in (1, 2, 3, 5, 6, 7, 8)]
+    (r,) = find_recurring(rows)
+    assert r.months == 4
+    assert r.last == date(2026, 8, 10)
+
+
+def test_fewer_than_three_months_not_returned() -> None:
+    rows = [
+        ex("2026-01-10", "保険", 2000, "生命"),
+        ex("2026-02-10", "保険", 2000, "生命"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_amount_change_beyond_tolerance_is_separate_series() -> None:
+    rows = [ex(f"2026-{m:02d}-01", "通信", 1000, "回線") for m in (1, 2, 3)]
+    rows += [ex(f"2026-{m:02d}-01", "通信", 1200, "回線") for m in (4, 5, 6)]
+    got = sorted((r.amount, r.months) for r in find_recurring(rows))
+    assert got == [(1000, 3), (1200, 3)]
+
+
+def test_amount_within_tolerance_is_same_series() -> None:
+    rows = [
+        ex("2026-01-01", "通信", 1000, "回線"),
+        ex("2026-02-01", "通信", 1000, "回線"),
+        ex("2026-03-01", "通信", 1090, "回線"),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.months == 3
+
+
+def test_result_does_not_depend_on_input_order() -> None:
+    rows = E21_ROWS + E22_ROWS
+    assert find_recurring(rows) == find_recurring(list(reversed(rows)))
+
+
+def test_results_sorted_by_next_due_then_category_and_memo() -> None:
+    rows = [ex(f"2026-{m:02d}-10", "B", 100, "b") for m in (1, 2, 3)]
+    rows += [ex(f"2026-{m:02d}-05", "A", 100, "a") for m in (1, 2, 3)]
+    rows += [ex(f"2026-{m:02d}-20", "C", 100, "c") for m in (1, 2, 3)]
+    keys = [(r.category, next_due(r)) for r in find_recurring(rows)]
+    assert keys == [
+        ("A", date(2026, 4, 5)),
+        ("B", date(2026, 4, 10)),
+        ("C", date(2026, 4, 20)),
+    ]
+
+
+def test_category_is_stripped_but_case_sensitive() -> None:
+    rows = [
+        ex("2026-01-01", "住居 ", 100, "家賃"),
+        ex("2026-02-01", "住居", 100, "家賃"),
+        ex("2026-03-01", "住居", 100, "家賃"),
+    ]
+    (r,) = find_recurring(rows)
+    assert (r.category, r.months) == ("住居", 3)
+
+    rows_case = [
+        ex("2026-01-01", "Food", 100, "x"),
+        ex("2026-02-01", "food", 100, "x"),
+        ex("2026-03-01", "Food", 100, "x"),
+    ]
+    # "Food" has only 2 rows (Jan, Mar, not consecutive) and "food" has 1 -> nothing
+    assert find_recurring(rows_case) == []
+
+
+@pytest.mark.parametrize(
+    ("recurring", "expected"),
+    [
+        pytest.param(
+            Recurring("a", "a", 1, 3, date(2025, 12, 15), 15),
+            date(2026, 1, 15),
+            id="dec-to-jan",
+        ),
+        pytest.param(
+            Recurring("a", "a", 1, 3, date(2026, 12, 31), 31),
+            date(2027, 1, 31),
+            id="dec-31",
+        ),
+        pytest.param(
+            Recurring("a", "a", 1, 3, date(2028, 1, 31), 31),
+            date(2028, 2, 29),
+            id="leap-feb",
+        ),
+        pytest.param(
+            Recurring("a", "a", 1, 3, date(2027, 1, 31), 31),
+            date(2027, 2, 28),
+            id="feb-28",
+        ),
+    ],
+)
+def test_next_due_month_rollover(recurring: Recurring, expected: date) -> None:
+    assert next_due(recurring) == expected
diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..b156d25
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,205 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    AmountRange,
+    And,
+    Category,
+    DateRange,
+    MemoContains,
+    Not,
+    Or,
+    matches,
+    search,
+)
+
+
+def _e(
+    day: date = date(2026, 1, 15),
+    category: str = "食費",
+    amount: int = 100,
+    memo: str = "",
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- 例の表 ---------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("cond", "e", "expected"),
+    [
+        pytest.param(MemoContains("ＮＥＴ"), _e(memo="netflix"), True, id="E3-1"),
+        pytest.param(AmountRange(100, 100), _e(amount=100), True, id="E3-2"),
+    ],
+)
+def test_example_table_matches(cond, e, expected):
+    assert matches(cond, e) is expected
+
+
+def test_E3_3_amount_range_low_above_high_raises():
+    with pytest.raises(ValueError):
+        AmountRange(500, 100)
+
+
+# --- R1 Category / MemoContains -------------------------------------------
+
+
+def test_category_exact_ignoring_outer_space_and_case():
+    assert matches(Category("  Food "), _e(category="food"))
+    assert not matches(Category("食"), _e(category="食費"))
+
+
+def test_memo_contains_is_partial_and_case_insensitive():
+    assert matches(MemoContains("FLIX"), _e(memo="Netflix plan"))
+
+
+def test_memo_contains_empty_text_is_always_true():
+    assert matches(MemoContains(""), _e(memo=""))
+    assert matches(MemoContains(""), _e(memo="anything"))
+
+
+# --- R2 ranges -------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("cond", "amount", "expected"),
+    [
+        pytest.param(AmountRange(None, None), -5000, True, id="amt-both-none"),
+        pytest.param(AmountRange(low=100), 99, False, id="amt-low-only-below"),
+        pytest.param(AmountRange(low=100), 100, True, id="amt-low-only-edge"),
+        pytest.param(AmountRange(high=100), 100, True, id="amt-high-edge"),
+        pytest.param(AmountRange(high=100), 101, False, id="amt-high-above"),
+        pytest.param(AmountRange(100, 200), 150, True, id="amt-inside"),
+    ],
+)
+def test_amount_range_bounds(cond, amount, expected):
+    assert matches(cond, _e(amount=amount)) is expected
+
+
+@pytest.mark.parametrize(
+    ("cond", "day", "expected"),
+    [
+        pytest.param(
+            DateRange(None, None), date(1999, 1, 1), True, id="date-both-none"
+        ),
+        pytest.param(
+            DateRange(date(2026, 1, 1), date(2026, 1, 31)),
+            date(2026, 1, 1),
+            True,
+            id="date-start-edge",
+        ),
+        pytest.param(
+            DateRange(date(2026, 1, 1), date(2026, 1, 31)),
+            date(2026, 1, 31),
+            True,
+            id="date-end-edge",
+        ),
+        pytest.param(
+            DateRange(date(2026, 1, 1), date(2026, 1, 31)),
+            date(2026, 2, 1),
+            False,
+            id="date-after-end",
+        ),
+        pytest.param(
+            DateRange(start=date(2026, 1, 2)),
+            date(2026, 1, 1),
+            False,
+            id="date-before-start-open-end",
+        ),
+    ],
+)
+def test_date_range_bounds(cond, day, expected):
+    assert matches(cond, _e(day=day)) is expected
+
+
+def test_date_range_start_after_end_raises():
+    with pytest.raises(ValueError):
+        DateRange(date(2026, 2, 1), date(2026, 1, 1))
+
+
+# --- R3 And / Or / Not -----------------------------------------------------
+
+
+def test_empty_and_is_true_and_empty_or_is_false():
+    assert matches(And(()), _e()) is True
+    assert matches(Or(()), _e()) is False
+
+
+def test_nested_and_or_not():
+    cond = And(
+        (
+            Or((Category("食費"), Category("日用品"))),
+            Not(MemoContains("外食")),
+            AmountRange(high=1000),
+        )
+    )
+    assert matches(cond, _e(category="日用品", amount=500, memo="スーパー"))
+    assert not matches(cond, _e(category="日用品", amount=500, memo="外食"))
+    assert not matches(cond, _e(category="交通費", amount=500))
+    assert not matches(cond, _e(category="食費", amount=1001))
+
+
+# --- R4 search -------------------------------------------------------------
+
+
+def test_search_keeps_order_and_returns_new_list():
+    rows = [
+        _e(amount=300, category="食費"),
+        _e(amount=50, category="日用品"),
+        _e(amount=200, category="食費"),
+    ]
+    snapshot = list(rows)
+    result = search(rows, Category("食費"))
+    assert [e.amount for e in result] == [300, 200]
+    assert result is not rows
+    assert rows == snapshot
+
+
+def test_search_does_not_modify_input_and_handles_empty():
+    rows: list[Expense] = []
+    assert search(rows, And(())) == []
+    assert search([_e()], Or(())) == []
+
+
+# --- R5 type errors --------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "factory",
+    [
+        # 型違いを意図的に渡すため、型検査器の指摘は無視する
+        pytest.param(lambda: Category(1), id="category-int"),  # type: ignore
+        pytest.param(lambda: AmountRange(low="a"), id="amount-str"),  # type: ignore
+        pytest.param(lambda: AmountRange(low=True), id="amount-bool"),  # type: ignore
+        pytest.param(lambda: AmountRange(high=1.5), id="amount-float"),  # type: ignore
+        pytest.param(lambda: MemoContains(None), id="memo-none"),  # type: ignore
+        pytest.param(lambda: DateRange(start="2026-01-01"), id="date-str"),  # type: ignore
+        pytest.param(lambda: And([Category("食費")]), id="and-list"),  # type: ignore
+        pytest.param(lambda: Or((1,)), id="or-non-cond"),  # type: ignore
+        pytest.param(lambda: Not(42), id="not-non-cond"),  # type: ignore
+    ],
+)
+def test_construction_with_wrong_type_raises_type_error(factory):
+    with pytest.raises(TypeError):
+        factory()
+
+
+def test_matches_rejects_non_cond_value():
+    with pytest.raises(TypeError):
+        matches("食費", _e())  # type: ignore[arg-type]
+
+
+def test_search_rejects_non_cond_value():
+    with pytest.raises(TypeError):
+        search([_e()], 123)  # type: ignore[arg-type]
+
+
+def test_conditions_are_frozen():
+    cond = Category("食費")
+    with pytest.raises(AttributeError):
+        cond.name = "x"  # type: ignore[misc]
