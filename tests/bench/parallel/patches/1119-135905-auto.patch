@@ -0,0 +1,98 @@
+"""Month-over-month comparison of expenses by category."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+TOTAL_LABEL = "合計"
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    percent: float | None
+
+
+@dataclass(frozen=True)
+class MonthDiff:
+    month: str
+    previous: str
+    rows: list[DiffRow]
+    total: DiffRow
+
+
+def _prev_month(month: str) -> str:
+    year, mon = int(month[:4]), int(month[5:])
+    if mon == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mon - 1:02d}"
+
+
+def _month_key(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def _make_row(category: str, previous: int, current: int) -> DiffRow:
+    delta = current - previous
+    percent = None if previous == 0 else round(delta / previous * 100, 1) + 0.0
+    return DiffRow(category, previous, current, delta, percent)
+
+
+def compare_months(rows: list[Expense], month: str) -> MonthDiff:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+    prev = _prev_month(month)
+
+    cur_totals: dict[str, int] = {}
+    prev_totals: dict[str, int] = {}
+    for e in rows:
+        key = _month_key(e)
+        if key == month:
+            cur_totals[e.category] = cur_totals.get(e.category, 0) + e.amount
+        elif key == prev:
+            prev_totals[e.category] = prev_totals.get(e.category, 0) + e.amount
+
+    diff_rows: list[DiffRow] = []
+    for cat in set(cur_totals) | set(prev_totals):
+        p = prev_totals.get(cat, 0)
+        c = cur_totals.get(cat, 0)
+        if p == 0 and c == 0:
+            continue
+        diff_rows.append(_make_row(cat, p, c))
+    diff_rows.sort(key=lambda r: (-abs(r.delta), r.category))
+
+    total = _make_row(
+        TOTAL_LABEL,
+        sum(prev_totals.values()),
+        sum(cur_totals.values()),
+    )
+    return MonthDiff(month=month, previous=prev, rows=diff_rows, total=total)
+
+
+def _format_line(r: DiffRow) -> str:
+    if r.delta > 0:
+        sign = "+"
+    elif r.delta < 0:
+        sign = "-"
+    else:
+        sign = "±"
+    amount = f"{sign}{abs(r.delta)}"
+    if r.percent is None:
+        pct = "(新規)" if r.previous == 0 and r.current > 0 else "(-)"
+    else:
+        pct_sign = "+" if r.delta > 0 else "-" if r.delta < 0 else "±"
+        pct = f"({pct_sign}{abs(r.percent):.1f}%)"
+    return f"{r.category}  {r.previous} → {r.current}  {amount} {pct}"
+
+
+def format_diff(d: MonthDiff) -> str:
+    lines = [_format_line(r) for r in d.rows]
+    lines.append(_format_line(d.total))
+    return "\n".join(lines)
