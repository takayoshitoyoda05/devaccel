@@ -0,0 +1,230 @@
+"""銀行 CSV の取り込み。文字列を受けて Expense と行ごとの誤りを返す純粋関数。"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from collections.abc import Callable, Iterator
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+UNCATEGORIZED = "未分類"
+
+_DATE_ALIASES = {"date", "日付", "利用日", "取引日", "ご利用日"}
+_AMOUNT_ALIASES = {"amount", "金額", "利用金額", "ご利用金額"}
+_OUT_ALIASES = {"出金額", "出金", "支払", "お支払金額"}
+_IN_ALIASES = {"入金額", "入金", "預入", "お預り金額"}
+_MEMO_ALIASES = {"memo", "摘要", "メモ", "利用店名", "ご利用店名", "description"}
+_CATEGORY_ALIASES = {"category", "カテゴリ", "分類"}
+
+_DATE_PATTERNS = (
+    re.compile(r"([0-9]{4})[-/.]([0-9]{1,2})[-/.]([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日"),
+    re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})"),
+)
+_TIME_SUFFIX = re.compile(r"\s+[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?$")
+_AMOUNT_CORE = re.compile(r"[0-9]{1,3}(?:,[0-9]{3})+|[0-9]+")
+_NEG_PREFIXES = ("-", "−", "▲", "△")
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str
+    value: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+
+
+@dataclass(frozen=True)
+class _Columns:
+    date: int
+    amount: int | None
+    out: int | None
+    inc: int | None
+    memo: int | None
+    category: int | None
+
+
+def _parse_date(raw: str) -> date:
+    s = unicodedata.normalize("NFKC", raw).strip()
+    s = _TIME_SUFFIX.sub("", s)
+    for pattern in _DATE_PATTERNS:
+        m = pattern.fullmatch(s)
+        if m is not None:
+            y, mo, d = (int(g) for g in m.groups())
+            try:
+                return date(y, mo, d)
+            except ValueError:
+                raise ValueError("存在しない日付です") from None
+    raise ValueError("日付の形式が不正です")
+
+
+def _parse_amount(raw: str) -> int:
+    s = "".join(unicodedata.normalize("NFKC", raw).split())
+    neg = False
+    if len(s) >= 2 and s[0] == "(" and s[-1] == ")":
+        neg = True
+        s = s[1:-1]
+    while True:
+        if s[:3].upper() == "JPY":
+            s = s[3:]
+        elif s.startswith("¥"):
+            s = s[1:]
+        elif s.endswith("円"):
+            s = s[:-1]
+        elif s[:1] in _NEG_PREFIXES or s.endswith("-"):
+            if neg:
+                raise ValueError("符号が重複しています")
+            neg = True
+            s = s[1:] if s[:1] in _NEG_PREFIXES else s[:-1]
+        else:
+            break
+    if _AMOUNT_CORE.fullmatch(s) is None:
+        raise ValueError("金額の形式が不正です(整数で書いてください)")
+    value = int(s.replace(",", ""))
+    return -value if neg else value
+
+
+def _attempt[T](
+    parse: Callable[[str], T],
+    raw: str,
+    line: int,
+    column: str,
+    errors: list[RowError],
+) -> T | None:
+    if raw == "":
+        errors.append(RowError(line, column, raw, "値が空です"))
+        return None
+    try:
+        return parse(raw)
+    except ValueError as e:
+        errors.append(RowError(line, column, raw, str(e)))
+        return None
+
+
+def _find(header: list[str], aliases: set[str]) -> int | None:
+    for i, name in enumerate(header):
+        if name.strip().lower() in aliases:
+            return i
+    return None
+
+
+def _columns(header: list[str]) -> _Columns:
+    date_idx = _find(header, _DATE_ALIASES)
+    if date_idx is None:
+        raise ValueError("日付の列がありません")
+    amount = _find(header, _AMOUNT_ALIASES)
+    out = _find(header, _OUT_ALIASES)
+    if amount is None and out is None:
+        raise ValueError("金額の列も出金の列もありません")
+    return _Columns(
+        date=date_idx,
+        amount=amount,
+        out=out,
+        inc=_find(header, _IN_ALIASES),
+        memo=_find(header, _MEMO_ALIASES),
+        category=_find(header, _CATEGORY_ALIASES),
+    )
+
+
+def _records(text: str, delimiter: str) -> Iterator[tuple[int, list[str]]]:
+    """空行を除いたレコードを (開始行番号, セル) で返す。"""
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delimiter)
+    prev = 0
+    for cells in reader:
+        start = prev + 1
+        prev = reader.line_num
+        if any(c.strip() for c in cells):
+            yield start, cells
+
+
+def _convert(
+    line: int, cells: list[str], header: list[str], cols: _Columns
+) -> tuple[Expense | None, list[RowError]]:
+    errors: list[RowError] = []
+
+    def cell(idx: int | None) -> str:
+        if idx is None or idx >= len(cells):
+            return ""
+        return cells[idx].strip()
+
+    def name(idx: int | None) -> str:
+        return header[idx].strip() if idx is not None else ""
+
+    if len(cells) > len(header):
+        errors.append(
+            RowError(
+                line,
+                "(列数)",
+                str(len(cells)),
+                f"ヘッダーは {len(header)} 列ですが {len(cells)} 列あります",
+            )
+        )
+
+    day = _attempt(_parse_date, cell(cols.date), line, name(cols.date), errors)
+
+    skip = False
+    amount: int | None = None
+    if cols.out is None:
+        amount = _attempt(
+            _parse_amount, cell(cols.amount), line, name(cols.amount), errors
+        )
+    else:
+        out_raw = cell(cols.out)
+        in_raw = cell(cols.inc)
+        if out_raw == "" and in_raw == "":
+            errors.append(
+                RowError(line, name(cols.out), "", "出金額と入金額がどちらも空です")
+            )
+        elif out_raw == "":
+            # 入金だけの行は取り込まない(エラーにもしない)
+            _attempt(_parse_amount, in_raw, line, name(cols.inc), errors)
+            skip = True
+        else:
+            out_val = _attempt(_parse_amount, out_raw, line, name(cols.out), errors)
+            in_val = (
+                _attempt(_parse_amount, in_raw, line, name(cols.inc), errors)
+                if in_raw != ""
+                else 0
+            )
+            if out_val is not None and in_val is not None:
+                amount = out_val - in_val
+
+    if errors:
+        return None, errors
+    if skip or day is None or amount is None:
+        return None, []
+    category = cell(cols.category) or UNCATEGORIZED
+    return Expense(day, category, amount, cell(cols.memo)), []
+
+
+def import_bank_csv(text: str) -> ImportResult:
+    text = text.removeprefix("﻿")
+    first_line = re.split(r"\r\n|\r|\n", text, maxsplit=1)[0]
+    delimiter = "\t" if first_line.count("\t") > first_line.count(",") else ","
+
+    records = _records(text, delimiter)
+    head = next(records, None)
+    if head is None:
+        return ImportResult([], [])
+    _, header = head
+    cols = _columns(header)
+
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    for line, cells in records:
+        expense, row_errors = _convert(line, cells, header, cols)
+        errors.extend(row_errors)
+        if expense is not None:
+            expenses.append(expense)
+    return ImportResult(expenses, errors)
