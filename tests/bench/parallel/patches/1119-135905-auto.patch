new file mode 100644
index 0000000..b51c1f1
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,144 @@
+"""Condition-based search over expenses (pure functions)."""
+
+from __future__ import annotations
+
+import unicodedata
+from dataclasses import dataclass
+from datetime import date, datetime
+
+from kakeibo.core import Expense
+
+
+def _check_int_or_none(value: object, name: str) -> None:
+    if value is None:
+        return
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{name} は int か None である必要があります: {value!r}")
+
+
+def _check_date_or_none(value: object, name: str) -> None:
+    if value is None:
+        return
+    if isinstance(value, datetime) or not isinstance(value, date):
+        raise TypeError(f"{name} は date か None である必要があります: {value!r}")
+
+
+def _check_str(value: object, name: str) -> None:
+    if not isinstance(value, str):
+        raise TypeError(f"{name} は str である必要があります: {value!r}")
+
+
+def _normalize(text: str) -> str:
+    return unicodedata.normalize("NFKC", text).lower()
+
+
+@dataclass(frozen=True)
+class Category:
+    name: str
+
+    def __post_init__(self) -> None:
+        _check_str(self.name, "name")
+
+
+@dataclass(frozen=True)
+class AmountRange:
+    low: int | None = None
+    high: int | None = None
+
+    def __post_init__(self) -> None:
+        _check_int_or_none(self.low, "low")
+        _check_int_or_none(self.high, "high")
+        if self.low is not None and self.high is not None and self.low > self.high:
+            raise ValueError(f"下限({self.low})が上限({self.high})を超えています")
+
+
+@dataclass(frozen=True)
+class MemoContains:
+    text: str
+
+    def __post_init__(self) -> None:
+        _check_str(self.text, "text")
+
+
+@dataclass(frozen=True)
+class DateRange:
+    start: date | None = None
+    end: date | None = None
+
+    def __post_init__(self) -> None:
+        _check_date_or_none(self.start, "start")
+        _check_date_or_none(self.end, "end")
+        if self.start is not None and self.end is not None and self.start > self.end:
+            raise ValueError(f"開始({self.start})が終了({self.end})より後です")
+
+
+@dataclass(frozen=True)
+class And:
+    conds: tuple[Cond, ...]
+
+    def __post_init__(self) -> None:
+        _check_conds(self.conds, "conds")
+
+
+@dataclass(frozen=True)
+class Or:
+    conds: tuple[Cond, ...]
+
+    def __post_init__(self) -> None:
+        _check_conds(self.conds, "conds")
+
+
+@dataclass(frozen=True)
+class Not:
+    cond: Cond
+
+    def __post_init__(self) -> None:
+        _check_cond(self.cond, "cond")
+
+
+Cond = Category | AmountRange | MemoContains | DateRange | And | Or | Not
+
+_COND_TYPES = (Category, AmountRange, MemoContains, DateRange, And, Or, Not)
+
+
+def _check_cond(value: object, name: str) -> None:
+    if not isinstance(value, _COND_TYPES):
+        raise TypeError(f"{name} は条件である必要があります: {value!r}")
+
+
+def _check_conds(value: object, name: str) -> None:
+    if not isinstance(value, tuple):
+        raise TypeError(f"{name} は tuple である必要があります: {value!r}")
+    for item in value:
+        _check_cond(item, f"{name} の要素")
+
+
+def matches(cond: Cond, e: Expense) -> bool:
+    """Return True if expense ``e`` satisfies ``cond``."""
+    if isinstance(cond, Category):
+        return e.category.strip().casefold() == cond.name.strip().casefold()
+    if isinstance(cond, MemoContains):
+        if cond.text == "":
+            return True
+        return _normalize(cond.text) in _normalize(e.memo)
+    if isinstance(cond, AmountRange):
+        return (cond.low is None or e.amount >= cond.low) and (
+            cond.high is None or e.amount <= cond.high
+        )
+    if isinstance(cond, DateRange):
+        return (cond.start is None or e.day >= cond.start) and (
+            cond.end is None or e.day <= cond.end
+        )
+    if isinstance(cond, And):
+        return all(matches(c, e) for c in cond.conds)
+    if isinstance(cond, Or):
+        return any(matches(c, e) for c in cond.conds)
+    if isinstance(cond, Not):
+        return not matches(cond.cond, e)
+    raise TypeError(f"条件ではありません: {cond!r}")
+
+
+def search(rows: list[Expense], cond: Cond) -> list[Expense]:
+    """Return a new list of the rows matching ``cond``, in input order."""
+    _check_cond(cond, "cond")
+    return [e for e in rows if matches(cond, e)]
