index 0000000..3c9e448
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,110 @@
+"""Detect recurring expenses and predict their next due date (pure functions)."""
+
+from __future__ import annotations
+
+import calendar
+import re
+import statistics
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_TOLERANCE = 0.10  # amount may differ from the series median by up to ±10%
+_MIN_MONTHS = 3
+# trailing "#", "No." and digits, e.g. "netflix#3" / "netflixno.2" / "netflix2"
+_TRAILING_RE = re.compile(r"(?:#|no\.|\d)+$")
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str  # raw memo of the series' last row
+    amount: int  # median amount of the series (yen)
+    months: int  # number of consecutive months
+    last: date  # date of the series' last row
+    day: int  # median day-of-month
+
+
+def _normalize_memo(memo: str) -> str:
+    s = unicodedata.normalize("NFKC", memo).lower()
+    s = "".join(s.split())
+    return _TRAILING_RE.sub("", s)
+
+
+def _month_index(ym: tuple[int, int]) -> int:
+    return ym[0] * 12 + ym[1]
+
+
+def _amount_clusters(members: list[Expense]) -> list[list[Expense]]:
+    """Split same-key rows into clusters whose amounts stay within ±10% of the median."""
+    clusters: list[list[Expense]] = []
+    for e in sorted(members, key=lambda x: (x.day, x.amount, x.memo)):
+        for c in clusters:
+            ref = statistics.median([x.amount for x in c])
+            if abs(e.amount - ref) <= _TOLERANCE * ref:
+                c.append(e)
+                break
+        else:
+            clusters.append([e])
+    return clusters
+
+
+def _to_recurring(category: str, cluster: list[Expense]) -> Recurring | None:
+    by_month: dict[tuple[int, int], list[Expense]] = {}
+    for e in cluster:
+        by_month.setdefault((e.day.year, e.day.month), []).append(e)
+    if any(len(v) > 1 for v in by_month.values()):
+        return None  # two rows in one month: not a recurring series
+
+    runs: list[list[tuple[int, int]]] = []
+    for ym in sorted(by_month):
+        if runs and _month_index(ym) == _month_index(runs[-1][-1]) + 1:
+            runs[-1].append(ym)
+        else:
+            runs.append([ym])
+    last_run = runs[-1]
+    if len(last_run) < _MIN_MONTHS:
+        return None
+
+    rows = [by_month[ym][0] for ym in last_run]  # ascending by month
+    latest = rows[-1]
+    return Recurring(
+        category=category,
+        memo=latest.memo,
+        amount=statistics.median_low([e.amount for e in rows]),
+        months=len(rows),
+        last=latest.day,
+        day=statistics.median_low([e.day.day for e in rows]),
+    )
+
+
+def find_recurring(rows: list[Expense]) -> list[Recurring]:
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        if e.amount <= 0:  # refunds and zero amounts are not series members
+            continue
+        key = (e.category.strip(), _normalize_memo(e.memo))
+        groups.setdefault(key, []).append(e)
+
+    found: list[Recurring] = []
+    for (category, _), members in groups.items():
+        for cluster in _amount_clusters(members):
+            r = _to_recurring(category, cluster)
+            if r is not None:
+                found.append(r)
+
+    found.sort(
+        key=lambda r: (next_due(r), r.category, r.memo, r.amount, r.months, r.day)
+    )
+    return found
+
+
+def next_due(r: Recurring) -> date:
+    """The `day` of the month after `last`, clipped to that month's last day."""
+    month_index = r.last.month  # 1..12
+    year = r.last.year + month_index // 12
+    month = month_index % 12 + 1
+    last_day = calendar.monthrange(year, month)[1]
+    return date(year, month, min(r.day, last_day))
