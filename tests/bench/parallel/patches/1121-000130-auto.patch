+++ b/tests/test_bank_import.py
@@ -0,0 +1,195 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import (
+    ImportFormatError,
+    parse_amount,
+    parse_bank_csv,
+    parse_date,
+)
+from kakeibo.core import Expense
+
+
+@pytest.mark.parametrize(
+    "raw,want",
+    [
+        ("1234", 1234),
+        ("1,234", 1234),
+        ("１，２３４", 1234),
+        ("¥1,234", 1234),
+        ("￥1,234", 1234),
+        ("1,234円", 1234),
+        ("JPY 500", 500),
+        (" 500 ", 500),
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("0", 0),
+        ("", None),
+        ("-", None),
+        ("—", None),
+    ],
+)
+def test_parse_amount(raw, want):
+    assert parse_amount(raw) == want
+
+
+@pytest.mark.parametrize("raw", ["12.5", "abc", "1,2,3x", "¥", "--5"])
+def test_parse_amount_rejects(raw):
+    with pytest.raises(ValueError):
+        parse_amount(raw)
+
+
+@pytest.mark.parametrize(
+    "raw,want",
+    [
+        ("2026-01-05", date(2026, 1, 5)),
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026.1.5", date(2026, 1, 5)),
+        ("2026年1月5日", date(2026, 1, 5)),
+        ("20260105", date(2026, 1, 5)),
+        ("２０２６/１/５", date(2026, 1, 5)),
+        ("2026/1/5 12:34", date(2026, 1, 5)),
+        ("2026-01-05T12:34:56", date(2026, 1, 5)),
+        ("R8.1.5", date(2026, 1, 5)),
+        ("令和8年1月5日", date(2026, 1, 5)),
+        ("H30/4/1", date(2018, 4, 1)),
+        ("2024/2/29", date(2024, 2, 29)),
+    ],
+)
+def test_parse_date(raw, want):
+    assert parse_date(raw) == want
+
+
+@pytest.mark.parametrize(
+    "raw", ["2026/2/30", "2025/2/29", "2026/13/1", "", "yesterday", "2026/1/5 xx"]
+)
+def test_parse_date_rejects(raw):
+    with pytest.raises(ValueError):
+        parse_date(raw)
+
+
+def test_card_csv_single_amount_with_aliases():
+    text = '利用日,ご利用店名,利用金額\n2026/1/5,スーパー,"1,234"\n2026/1/6,返品,△500\n'
+    r = parse_bank_csv(text)
+    assert r.errors == []
+    assert r.expenses == [
+        Expense(date(2026, 1, 5), "未分類", 1234, "スーパー"),
+        Expense(date(2026, 1, 6), "未分類", -500, "返品"),
+    ]
+
+
+def test_bank_csv_two_amount_columns_skips_deposits():
+    text = (
+        "取引日,摘要,出金額,入金額\n2026-01-05,家賃,80000,\n2026-01-25,給与,,300000\n"
+    )
+    r = parse_bank_csv(text)
+    assert [e.amount for e in r.expenses] == [80000]
+    assert r.skipped == [(3, "入金(収入)の行")]
+    assert r.errors == []
+
+
+def test_two_columns_both_filled_is_error():
+    r = parse_bank_csv("日付,出金,入金\n2026-01-05,100,200\n")
+    assert r.expenses == []
+    assert len(r.errors) == 1 and r.errors[0].line == 2
+    assert "両方" in r.errors[0].reason
+
+
+def test_two_columns_both_empty_is_error():
+    r = parse_bank_csv("日付,出金,入金\n2026-01-05,,\n")
+    assert len(r.errors) == 1 and "空" in r.errors[0].reason
+
+
+def test_two_columns_both_bad_reports_both():
+    r = parse_bank_csv("日付,出金,入金\n2026-01-05,x,y\n")
+    assert [e.column for e in r.errors] == ["出金", "入金"]
+
+
+def test_zero_amount_skipped():
+    r = parse_bank_csv("date,amount\n2026-01-05,0\n")
+    assert r.expenses == [] and r.skipped == [(2, "金額が 0")]
+
+
+def test_empty_amount_is_error():
+    r = parse_bank_csv("date,amount\n2026-01-05,\n")
+    assert r.errors[0].column == "amount" and r.errors[0].line == 2
+
+
+def test_multiple_errors_in_one_row_all_reported():
+    r = parse_bank_csv("date,amount\n2026/2/30,abc\n")
+    assert [(e.line, e.column, e.value) for e in r.errors] == [
+        (2, "date", "2026/2/30"),
+        (2, "amount", "abc"),
+    ]
+    assert "2026/2/30" in str(r.errors[0]) and "2行目" in str(r.errors[0])
+
+
+def test_bad_rows_do_not_stop_good_rows():
+    r = parse_bank_csv("date,amount\n2026-01-05,100\nbad,200\n2026-01-07,300\n")
+    assert [e.amount for e in r.expenses] == [100, 300]
+    assert [e.line for e in r.errors] == [3]
+
+
+def test_unquoted_thousands_separator_reported_as_column_count():
+    r = parse_bank_csv("date,memo,amount\n2026-01-05,店,1,234円\n")
+    assert r.expenses == []
+    assert (
+        r.errors[0].line == 2
+        and "列数" in r.errors[0].reason
+        and "多い" in r.errors[0].reason
+    )
+
+
+def test_too_few_columns():
+    r = parse_bank_csv("date,memo,amount\n2026-01-05,店\n")
+    assert "少ない" in r.errors[0].reason
+
+
+def test_bom_crlf_and_blank_lines():
+    text = "﻿date,amount\r\n\r\n2026-01-05,100\r\n  ,  \r\n2026-01-06,200\r\n"
+    r = parse_bank_csv(text)
+    assert [e.amount for e in r.expenses] == [100, 200]
+    assert r.errors == []
+
+
+def test_tab_delimited():
+    r = parse_bank_csv("日付\t金額\t摘要\n2026/1/5\t1,000\tカフェ\n")
+    assert r.expenses == [Expense(date(2026, 1, 5), "未分類", 1000, "カフェ")]
+
+
+def test_header_case_and_whitespace_insensitive():
+    r = parse_bank_csv(" DATE , Amount , Description \n2026-01-05,100,x\n")
+    assert r.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "x")]
+
+
+def test_category_column_and_default():
+    r = parse_bank_csv(
+        "date,category,amount\n2026-01-05,食費,100\n2026-01-06,,200\n",
+        default_category="他",
+    )
+    assert [e.category for e in r.expenses] == ["食費", "他"]
+
+
+def test_error_line_is_record_start_with_multiline_quote():
+    text = 'date,memo,amount\n2026-01-05,"a\nb",100\nbad,x,5\n'
+    r = parse_bank_csv(text)
+    assert r.expenses[0].memo == "a\nb"
+    assert r.errors[0].line == 4
+
+
+def test_empty_and_header_only():
+    for text in ("", "\n\n", "date,amount\n"):
+        r = parse_bank_csv(text)
+        assert r.expenses == [] and r.errors == [] and r.skipped == []
+
+
+def test_missing_required_columns():
+    with pytest.raises(ImportFormatError, match="日付"):
+        parse_bank_csv("foo,amount\n1,2\n")
+    with pytest.raises(ImportFormatError, match="金額"):
+        parse_bank_csv("date,memo\n2026-01-05,x\n")
