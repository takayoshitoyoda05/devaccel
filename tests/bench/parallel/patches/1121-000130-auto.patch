@@ -0,0 +1,273 @@
+"""Import bank / credit-card CSV exports into Expense records (pure functions).
+
+Decisions:
+D1: 先頭の BOM は除く。区切りはヘッダー行で `,` とタブの多い方を自動判定。改行は CRLF/LF どちらも可。
+D2: 列名は NFKC・前後空白除去・大文字小文字無視で別名に対応(日付/利用日/取引日/date、
+    金額/利用金額/出金額/amount、摘要/メモ/利用店名/ご利用店名/description など)。
+    ヘッダーは最初の空でない行。日付列または金額列が無い場合は ImportFormatError。
+D3: 金額が 1 列(金額/利用金額/amount)の形式では、正を支出、負(`-300` `−300` `△500` `▲500`
+    `(500)` `500-`)を返金(負の Expense)として受ける。
+D4: 金額が 2 列(出金/入金 など)の形式では、出金のみの行は支出、入金のみの行は収入として
+    スキップ(skipped に記録、エラーではない)。両方に値がある行・両方空の行はエラー。
+D5: 金額の記号 `¥ ￥ 円 JPY`、桁区切り `, ，`、全角数字・空白(NFKC)を許す。空欄・`-`・`—` は
+    「値なし」。小数(`12.5`)は拒否。金額 0 の行はスキップ。引用されていない `1,234円` で列が
+    増えた行は「列数が多い」エラー(修復しない)。
+D6: 日付は `2026-01-05` `2026/1/5` `2026.1.5` `2026年1月5日` `20260105`、時刻付き(`2026/1/5 12:34`)、
+    和暦(`R8.1.5` `令和8年1月5日`、R/H/S と 令和/平成/昭和)。存在しない日付(2/30)はエラー。
+D7: カテゴリ列(カテゴリ/分類/category)が無ければ default_category(既定 "未分類")。
+D8: 1 行に誤りが複数あれば全部報告する。各エラーは 行番号(レコード開始行)・列名・元の値・理由。
+    空行は黙って飛ばす。空入力・ヘッダーだけは空の結果。
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass, field
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+class ImportFormatError(ValueError):
+    """Raised when the header lacks a required column."""
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str
+    value: str
+    reason: str
+
+    def __str__(self) -> str:
+        return f"{self.line}行目 列 {self.column!r} 値 {self.value!r}: {self.reason}"
+
+
+@dataclass
+class ImportResult:
+    expenses: list[Expense] = field(default_factory=list)
+    errors: list[RowError] = field(default_factory=list)
+    skipped: list[tuple[int, str]] = field(default_factory=list)  # (line, reason)
+
+
+_DATE_NAMES = {"日付", "利用日", "取引日", "ご利用日", "年月日", "date"}
+_AMOUNT_NAMES = {"金額", "利用金額", "ご利用金額", "支払金額", "amount"}
+_OUT_NAMES = {
+    "出金",
+    "出金額",
+    "お支払金額",
+    "お支払い金額",
+    "支払",
+    "支払金",
+    "withdrawal",
+    "debit",
+}
+_IN_NAMES = {
+    "入金",
+    "入金額",
+    "お預り金額",
+    "お預入金額",
+    "預入",
+    "預入金",
+    "deposit",
+    "credit",
+}
+_MEMO_NAMES = {
+    "摘要", "メモ", "備考", "内容", "利用店名", "ご利用店名", "ご利用先", "利用先",
+    "description", "memo",
+}  # fmt: skip
+_CATEGORY_NAMES = {"カテゴリ", "カテゴリー", "分類", "category"}
+
+_EMPTY_AMOUNTS = {"", "-", "—", "−", "ー"}
+
+
+def _norm(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip().casefold()
+
+
+def _find(headers: list[str], names: set[str]) -> int | None:
+    wanted = {_norm(n) for n in names}
+    for i, h in enumerate(headers):
+        if _norm(h) in wanted:
+            return i
+    return None
+
+
+def parse_amount(raw: str) -> int | None:
+    """Parse a yen string. None = no value. Negative = refund. ValueError if malformed."""
+    s = unicodedata.normalize("NFKC", raw).strip()
+    s = re.sub(r"\s+", "", s)
+    if s in _EMPTY_AMOUNTS:
+        return None
+    s = s.replace("−", "-").replace("△", "-").replace("▲", "-")
+    s = s.replace("¥", "").replace("円", "")
+    if s.upper().startswith("JPY"):
+        s = s[3:]
+    elif s.upper().endswith("JPY"):
+        s = s[:-3]
+    negative = False
+    if s.startswith("(") and s.endswith(")"):
+        negative, s = True, s[1:-1]
+    if s.startswith("-"):
+        negative, s = not negative, s[1:]
+    elif s.endswith("-"):
+        negative, s = not negative, s[:-1]
+    s = s.replace(",", "")
+    if not s.isascii() or not s.isdigit():
+        raise ValueError("金額として読めません(整数の円のみ対応)")
+    n = int(s)
+    return -n if negative else n
+
+
+_ERA_BASE = {"R": 2018, "令": 2018, "H": 1988, "平": 1988, "S": 1925, "昭": 1925}
+_WESTERN = re.compile(r"(\d{4})[-/.年](\d{1,2})[-/.月](\d{1,2})日?")
+_COMPACT = re.compile(r"(\d{4})(\d{2})(\d{2})")
+_WAREKI = re.compile(
+    r"([RHS令平昭])(?:和|成)?\.?(\d{1,2})[-/.年](\d{1,2})[-/.月](\d{1,2})日?"
+)
+_TIME = re.compile(r"(?:[ T]\d{1,2}:\d{2}(?::\d{2})?)?")
+
+
+def parse_date(raw: str) -> date:
+    """Parse the date formats of D6. ValueError if malformed or nonexistent."""
+    s = unicodedata.normalize("NFKC", raw).strip().upper()
+    s = re.sub(r"\s+", " ", s)
+    for pat, kind in ((_WESTERN, "w"), (_WAREKI, "j"), (_COMPACT, "c")):
+        m = pat.match(s)
+        if m and _TIME.fullmatch(s[m.end() :]):
+            g = m.groups()
+            if kind == "j":
+                y, mo, d = _ERA_BASE[g[0]] + int(g[1]), int(g[2]), int(g[3])
+            else:
+                y, mo, d = int(g[0]), int(g[1]), int(g[2])
+            try:
+                return date(y, mo, d)
+            except ValueError:
+                raise ValueError("存在しない日付です") from None
+    raise ValueError("日付の書式が不明です")
+
+
+def parse_bank_csv(text: str, default_category: str = "未分類") -> ImportResult:
+    """Parse CSV text from a bank or card company. See module docstring for rules."""
+    text = text.removeprefix("﻿")
+    result = ImportResult()
+    first = next((ln for ln in text.splitlines() if ln.strip()), None)
+    if first is None:
+        return result
+    delim = "\t" if first.count("\t") > first.count(",") else ","
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delim)
+
+    headers: list[str] | None = None
+    cols: dict[str, int | None] = {}
+    prev_end = 0
+    for fields in reader:
+        start = prev_end + 1
+        prev_end = reader.line_num
+        if not any(f.strip() for f in fields):
+            continue
+        if headers is None:
+            headers = fields
+            cols = {
+                "date": _find(headers, _DATE_NAMES),
+                "amount": _find(headers, _AMOUNT_NAMES),
+                "out": _find(headers, _OUT_NAMES),
+                "in": _find(headers, _IN_NAMES),
+                "memo": _find(headers, _MEMO_NAMES),
+                "category": _find(headers, _CATEGORY_NAMES),
+            }
+            if cols["date"] is None:
+                raise ImportFormatError(f"日付の列が見つかりません: {headers!r}")
+            if cols["amount"] is None and cols["out"] is None:
+                raise ImportFormatError(f"金額の列が見つかりません: {headers!r}")
+            continue
+        _import_row(fields, start, headers, cols, default_category, result)
+    return result
+
+
+def _get(fields: list[str], idx: int | None) -> str:
+    return fields[idx] if idx is not None and idx < len(fields) else ""
+
+
+def _import_row(
+    fields: list[str],
+    line: int,
+    headers: list[str],
+    cols: dict[str, int | None],
+    default_category: str,
+    result: ImportResult,
+) -> None:
+    if len(fields) != len(headers):
+        kind = "多い" if len(fields) > len(headers) else "少ない"
+        result.errors.append(
+            RowError(
+                line,
+                "(行全体)",
+                ",".join(fields),
+                f"列数がヘッダーより{kind}({len(fields)} != {len(headers)})",
+            )
+        )
+        return
+
+    errs: list[RowError] = []
+    day: date | None = None
+    raw_date = _get(fields, cols["date"])
+    try:
+        day = parse_date(raw_date)
+    except ValueError as e:
+        errs.append(RowError(line, headers[cols["date"] or 0], raw_date, str(e)))
+
+    amount: int | None = None
+    skip_reason = ""
+    if cols["amount"] is not None:
+        name, raw = headers[cols["amount"]], _get(fields, cols["amount"])
+        try:
+            amount = parse_amount(raw)
+            if amount is None:
+                errs.append(RowError(line, name, raw, "金額が空です"))
+            elif amount == 0:
+                amount, skip_reason = None, "金額が 0"
+        except ValueError as e:
+            errs.append(RowError(line, name, raw, str(e)))
+    else:
+        out_i = cols["out"]
+        assert out_i is not None
+        o_name, o_raw = headers[out_i], _get(fields, out_i)
+        i_raw = _get(fields, cols["in"])
+        in_i = cols["in"]
+        i_name = headers[in_i] if in_i is not None else ""
+        out_v = in_v = None
+        try:
+            out_v = parse_amount(o_raw)
+        except ValueError as e:
+            errs.append(RowError(line, o_name, o_raw, str(e)))
+        try:
+            in_v = parse_amount(i_raw)
+        except ValueError as e:
+            errs.append(RowError(line, i_name, i_raw, str(e)))
+        if not errs:
+            if out_v and in_v:
+                errs.append(
+                    RowError(line, o_name, o_raw, "出金と入金の両方に値があります")
+                )
+            elif out_v:
+                amount = out_v
+            elif in_v:
+                skip_reason = "入金(収入)の行"
+            elif out_v == 0 or in_v == 0:
+                skip_reason = "金額が 0"
+            else:
+                errs.append(RowError(line, o_name, o_raw, "出金も入金も空です"))
+
+    if errs:
+        result.errors.extend(errs)
+        return
+    if amount is None or day is None:
+        result.skipped.append((line, skip_reason))
+        return
+    category = _get(fields, cols["category"]).strip() or default_category
+    result.expenses.append(
+        Expense(day, category, amount, _get(fields, cols["memo"]).strip())
+    )
diff --git a/tests/test_bank_import.py b/tests/test_bank_import.py
