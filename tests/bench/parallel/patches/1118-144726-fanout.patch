@@ -0,0 +1,55 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.topn import top_expenses
+
+
+def _e(day: str, amount: int, memo: str = "") -> Expense:
+    return Expense(date.fromisoformat(day), "food", amount, memo)
+
+
+ROWS = [
+    _e("2026-11-03", 1200, "a"),
+    _e("2026-11-01", 80000, "b"),
+    _e("2026-11-02", 1200, "c"),
+    _e("2026-11-05", 500, "d"),
+]
+
+
+def test_orders_by_amount_desc():
+    out = top_expenses(ROWS, 2)
+    assert [e.memo for e in out] == ["b", "c"]
+
+
+def test_ties_broken_by_earlier_date_then_input_order():
+    out = top_expenses(ROWS, 4)
+    assert [e.memo for e in out] == ["b", "c", "a", "d"]
+
+
+def test_same_amount_same_date_keeps_input_order():
+    rows = [_e("2026-11-01", 100, "first"), _e("2026-11-01", 100, "second")]
+    assert [e.memo for e in top_expenses(rows, 2)] == ["first", "second"]
+
+
+def test_n_larger_than_rows_returns_all_sorted():
+    out = top_expenses(ROWS, 10)
+    assert len(out) == 4
+    assert out[0].amount == 80000
+
+
+def test_n_zero_returns_empty():
+    assert top_expenses(ROWS, 0) == []
+
+
+def test_negative_n_returns_empty():
+    assert top_expenses(ROWS, -3) == []
+
+
+def test_empty_rows_returns_empty():
+    assert top_expenses([], 3) == []
+
+
+def test_does_not_mutate_input():
+    rows = list(ROWS)
+    top_expenses(rows, 2)
+    assert rows == ROWS
