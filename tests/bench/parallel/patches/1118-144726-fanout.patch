new file mode 100644
index 0000000..dbd71bf
--- /dev/null
+++ b/src/kakeibo/streak.py
@@ -0,0 +1,28 @@
+"""No-spend streak: longest run of days without any expense."""
+
+from __future__ import annotations
+
+from datetime import date, timedelta
+
+from kakeibo.core import Expense
+
+
+def longest_no_spend_streak(rows: list[Expense], start: date, end: date) -> int:
+    """start〜end(両端含む)で明細が 1 件もない日の最長連続日数。
+
+    期間外の明細は無視する。start > end の場合は 0。
+    """
+    if start > end:
+        return 0
+    spend_days = {e.day for e in rows if start <= e.day <= end}
+    best = 0
+    run = 0
+    day = start
+    while day <= end:
+        if day in spend_days:
+            run = 0
+        else:
+            run += 1
+            best = max(best, run)
+        day += timedelta(days=1)
+    return best
