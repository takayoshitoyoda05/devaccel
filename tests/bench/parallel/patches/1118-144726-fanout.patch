index 0000000..fca8be3
--- /dev/null
+++ b/src/kakeibo/topn.py
@@ -0,0 +1,16 @@
+"""Top-N expense selection."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def top_expenses(rows: list[Expense], n: int) -> list[Expense]:
+    """金額の大きい順に n 件。同額は日付の早い順、それも同じなら入力の順。
+
+    n が 0 以下なら空リスト。sorted は安定ソートなので入力順が保たれる。
+    """
+    if n <= 0:
+        return []
+    ordered = sorted(rows, key=lambda e: (-e.amount, e.day))
+    return ordered[:n]
