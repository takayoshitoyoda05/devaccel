+"""Split an amount in yen evenly among people."""
+
+from __future__ import annotations
+
+
+def split_evenly(amount: int, people: int) -> list[int]:
+    """Split ``amount`` yen among ``people``; the remainder goes to the first people one yen each."""
+    if people < 1:
+        raise ValueError(f"people は 1 以上である必要があります: {people}")
+    base, rem = divmod(amount, people)
+    return [base + 1 if i < rem else base for i in range(people)]
