+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.weekday import total_by_weekday
+
+
+def _e(day: date, amount: int) -> Expense:
+    return Expense(day=day, category="food", amount=amount)
+
+
+def test_empty_returns_empty_dict():
+    assert total_by_weekday([]) == {}
+
+
+def test_sums_per_weekday():
+    rows = [
+        _e(date(2026, 11, 16), 1000),  # Mon
+        _e(date(2026, 11, 23), 500),  # Mon
+        _e(date(2026, 11, 22), 300),  # Sun
+    ]
+    assert total_by_weekday(rows) == {"Mon": 1500, "Sun": 300}
+
+
+def test_keys_are_monday_first_regardless_of_input_order():
+    rows = [
+        _e(date(2026, 11, 22), 1),  # Sun
+        _e(date(2026, 11, 18), 2),  # Wed
+        _e(date(2026, 11, 16), 3),  # Mon
+        _e(date(2026, 11, 20), 4),  # Fri
+    ]
+    assert list(total_by_weekday(rows)) == ["Mon", "Wed", "Fri", "Sun"]
+
+
+def test_missing_weekdays_are_omitted():
+    rows = [_e(date(2026, 11, 21), 700)]  # Sat
+    assert total_by_weekday(rows) == {"Sat": 700}
+
+
+def test_all_seven_weekdays():
+    rows = [_e(date(2026, 11, 16 + i), 10 * (i + 1)) for i in range(7)]
+    assert total_by_weekday(rows) == {
+        "Mon": 10,
+        "Tue": 20,
+        "Wed": 30,
+        "Thu": 40,
+        "Fri": 50,
+        "Sat": 60,
+        "Sun": 70,
+    }
