+from __future__ import annotations
+
+import json
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.export import to_json
+
+
+def test_empty_list_is_empty_json_array() -> None:
+    assert to_json([]) == "[]"
+
+
+def test_serializes_fields_in_order_without_indent() -> None:
+    rows = [Expense(date(2026, 1, 5), "食費", 1200, "ランチ")]
+    assert to_json(rows) == (
+        '[{"date": "2026-01-05", "category": "食費", "amount": 1200, "memo": "ランチ"}]'
+    )
+
+
+def test_keeps_input_order_and_non_ascii() -> None:
+    rows = [
+        Expense(date(2026, 3, 2), "交通費", 300, ""),
+        Expense(date(2026, 3, 1), "食費", 500, "カフェ"),
+    ]
+    text = to_json(rows)
+    assert "\\u" not in text
+    data = json.loads(text)
+    assert [d["date"] for d in data] == ["2026-03-02", "2026-03-01"]
+    assert data[1]["memo"] == "カフェ"
+    assert list(data[0].keys()) == ["date", "category", "amount", "memo"]
