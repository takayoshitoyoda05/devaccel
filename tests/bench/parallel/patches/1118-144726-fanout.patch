@@ -0,0 +1,53 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.dupes import find_duplicates
+
+D1 = date(2026, 11, 1)
+D2 = date(2026, 11, 2)
+
+
+def test_empty():
+    assert find_duplicates([]) == []
+
+
+def test_no_duplicates():
+    rows = [Expense(D1, "food", 100, ""), Expense(D1, "food", 200, "")]
+    assert find_duplicates(rows) == []
+
+
+def test_single_pair():
+    rows = [
+        Expense(D1, "food", 100, "x"),
+        Expense(D2, "rent", 5, ""),
+        Expense(D1, "food", 100, "x"),
+    ]
+    assert find_duplicates(rows) == [(0, 2)]
+
+
+def test_memo_difference_is_not_duplicate():
+    rows = [Expense(D1, "food", 100, "a"), Expense(D1, "food", 100, "b")]
+    assert find_duplicates(rows) == []
+
+
+def test_day_category_amount_must_match():
+    rows = [
+        Expense(D1, "food", 100, ""),
+        Expense(D2, "food", 100, ""),
+        Expense(D1, "book", 100, ""),
+        Expense(D1, "food", 101, ""),
+    ]
+    assert find_duplicates(rows) == []
+
+
+def test_triple_yields_all_pairs_in_order():
+    e = Expense(D1, "food", 100, "m")
+    assert find_duplicates([e, e, e]) == [(0, 1), (0, 2), (1, 2)]
+
+
+def test_interleaved_groups_sorted_by_i_then_j():
+    a = Expense(D1, "food", 100, "")
+    b = Expense(D2, "rent", 5, "")
+    rows = [a, b, b, a, a, b]
+    # a at 0,3,4 ; b at 1,2,5
+    assert find_duplicates(rows) == [(0, 3), (0, 4), (1, 2), (1, 5), (2, 5), (3, 4)]
