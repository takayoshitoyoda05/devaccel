+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.stats import median_by_category
+
+
+def _e(category: str, amount: int) -> Expense:
+    return Expense(date(2026, 11, 1), category, amount)
+
+
+def test_median_by_category_empty():
+    assert median_by_category([]) == {}
+
+
+def test_median_by_category_odd_count_uses_middle_value():
+    rows = [_e("food", 300), _e("food", 100), _e("food", 200)]
+    assert median_by_category(rows) == {"food": 200.0}
+
+
+def test_median_by_category_even_count_averages_middle_pair():
+    rows = [_e("rent", 80000), _e("rent", 60000), _e("rent", 70000), _e("rent", 90000)]
+    assert median_by_category(rows) == {"rent": 75000.0}
+
+
+def test_median_by_category_keys_sorted_ascending():
+    rows = [_e("rent", 1), _e("food", 2), _e("books", 3)]
+    result = median_by_category(rows)
+    assert list(result) == ["books", "food", "rent"]
+    assert result == {"books": 3.0, "food": 2.0, "rent": 1.0}
+
+
+def test_median_by_category_is_per_category():
+    rows = [_e("food", 100), _e("food", 900), _e("food", 500), _e("tea", 1000)]
+    assert median_by_category(rows) == {"food": 500.0, "tea": 1000.0}
