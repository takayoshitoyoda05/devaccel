@@ -0,0 +1,21 @@
+"""Detect duplicate expense rows."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def find_duplicates(rows: list[Expense]) -> list[tuple[int, int]]:
+    """Index pairs (i, j), i < j, of rows identical in day, category, amount and memo.
+
+    Sorted by i ascending, then j ascending.
+    """
+    groups: dict[tuple[object, str, int, str], list[int]] = {}
+    for idx, e in enumerate(rows):
+        groups.setdefault((e.day, e.category, e.amount, e.memo), []).append(idx)
+    pairs: list[tuple[int, int]] = []
+    for indices in groups.values():
+        for k, i in enumerate(indices):
+            pairs.extend((i, j) for j in indices[k + 1 :])
+    pairs.sort()
+    return pairs
