@@ -0,0 +1,54 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.streak import longest_no_spend_streak
+
+
+def _e(day: date) -> Expense:
+    return Expense(day=day, category="食費", amount=100)
+
+
+def test_no_rows_returns_whole_period_length() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 1), date(2026, 1, 10)) == 10
+
+
+def test_single_day_period_without_spend() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 5), date(2026, 1, 5)) == 1
+
+
+def test_single_day_period_with_spend() -> None:
+    rows = [_e(date(2026, 1, 5))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 5), date(2026, 1, 5)) == 0
+
+
+def test_longest_gap_in_middle() -> None:
+    rows = [_e(date(2026, 1, 1)), _e(date(2026, 1, 2)), _e(date(2026, 1, 6))]
+    # 3,4,5 が連続して明細なし
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 7)) == 3
+
+
+def test_streak_at_start_and_end_counted() -> None:
+    rows = [_e(date(2026, 1, 3))]
+    # 1〜2 日目(2日)と 4〜5 日目(2日)
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 5)) == 2
+
+
+def test_both_ends_inclusive() -> None:
+    rows = [_e(date(2026, 1, 2)), _e(date(2026, 1, 4))]
+    # start=1 と end=5 の両端を含めて数える: 1 日目と 3 日目と 5 日目 → 最長 1
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 5)) == 1
+
+
+def test_rows_outside_period_are_ignored() -> None:
+    rows = [_e(date(2025, 12, 31)), _e(date(2026, 2, 1))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 3)) == 3
+
+
+def test_multiple_expenses_same_day_count_once() -> None:
+    rows = [_e(date(2026, 1, 2)), _e(date(2026, 1, 2))]
+    # 1 日目と 3〜4 日目が明細なし → 最長 2
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 4)) == 2
+
+
+def test_start_after_end_returns_zero() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 5), date(2026, 1, 1)) == 0
