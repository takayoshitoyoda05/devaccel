+import pytest
+
+from kakeibo.split import split_evenly
+
+
+def test_even_split():
+    assert split_evenly(900, 3) == [300, 300, 300]
+
+
+def test_remainder_goes_to_first_people():
+    assert split_evenly(10, 3) == [4, 3, 3]
+    assert split_evenly(7, 4) == [2, 2, 2, 1]
+
+
+def test_single_person_gets_all():
+    assert split_evenly(1234, 1) == [1234]
+
+
+def test_amount_smaller_than_people():
+    assert split_evenly(2, 5) == [1, 1, 0, 0, 0]
+
+
+def test_zero_amount():
+    assert split_evenly(0, 3) == [0, 0, 0]
+
+
+def test_sum_matches_amount():
+    for amount in range(50):
+        for people in range(1, 8):
+            parts = split_evenly(amount, people)
+            assert len(parts) == people
+            assert sum(parts) == amount
+            assert max(parts) - min(parts) <= 1
+
+
+@pytest.mark.parametrize("people", [0, -1])
+def test_people_below_one_rejected(people):
+    with pytest.raises(ValueError):
+        split_evenly(100, people)
