@@ -0,0 +1,16 @@
+"""Aggregation by day of week."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+WEEKDAYS = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
+
+
+def total_by_weekday(rows: list[Expense]) -> dict[str, int]:
+    """{"Mon".."Sun": yen}; weekdays with no expenses are omitted, Monday first."""
+    totals: dict[str, int] = {}
+    for e in rows:
+        name = WEEKDAYS[e.day.weekday()]
+        totals[name] = totals.get(name, 0) + e.amount
+    return {name: totals[name] for name in WEEKDAYS if name in totals}
