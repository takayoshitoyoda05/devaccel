+"""金額の表示用フォーマット。"""
+
+
+def yen(n: int) -> str:
+    """整数の金額を 3 桁区切りと「円」付きの文字列にする。
+
+    例: 1234567 -> "1,234,567円", 0 -> "0円", -1200 -> "-1,200円"
+    """
+    return f"{n:,}円"
