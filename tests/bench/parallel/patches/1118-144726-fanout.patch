+"""Per-category statistics for expense records."""
+
+from __future__ import annotations
+
+import statistics
+
+from kakeibo.core import Expense
+
+
+def median_by_category(rows: list[Expense]) -> dict[str, float]:
+    """{category: median amount}; keys ascending by category name, {} if empty."""
+    amounts: dict[str, list[int]] = {}
+    for e in rows:
+        amounts.setdefault(e.category, []).append(e.amount)
+    return {cat: float(statistics.median(amounts[cat])) for cat in sorted(amounts)}
