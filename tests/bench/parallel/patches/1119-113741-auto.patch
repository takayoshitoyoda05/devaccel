+"""Import bank / credit-card CSV text into Expense records (pure, never raises)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_ALIASES: dict[str, tuple[str, ...]] = {
+    "date": ("date", "日付", "利用日", "取引日"),
+    "amount": ("amount", "金額", "利用金額"),
+    "out": ("出金", "出金額", "withdrawal"),
+    "in": ("入金", "入金額", "deposit"),
+    "category": ("category", "カテゴリ"),
+    "memo": ("memo", "摘要", "内容", "description"),
+}
+_DEFAULT_CATEGORY = "未分類"
+_DATE_RE = re.compile(r"(\d{4})(?:-|/|年)(\d{1,2})(?:-|/|月)(\d{1,2})日?")
+_INT_RE = re.compile(r"[+-]?\d+")
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[tuple[int, str]]
+
+
+def _norm(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip()
+
+
+def _parse_date(raw: str) -> date:
+    m = _DATE_RE.fullmatch(_norm(raw))
+    if m:
+        try:
+            return date(int(m[1]), int(m[2]), int(m[3]))
+        except ValueError:
+            pass
+    raise ValueError(f"日付が不正です: {raw!r}")
+
+
+def _parse_amount(raw: str, what: str = "金額") -> int:
+    s = unicodedata.normalize("NFKC", raw)
+    s = s.replace("−", "-").replace("▲", "-").replace("△", "-")
+    s = re.sub(r"[¥￥円,\s]", "", s)
+    if not _INT_RE.fullmatch(s):
+        raise ValueError(f"{what}が整数ではありません: {raw!r}")
+    return int(s)
+
+
+def _find_columns(header: list[str]) -> dict[str, int]:
+    cols: dict[str, int] = {}
+    for i, name in enumerate(header):
+        key = _norm(name).lower()
+        for field, names in _ALIASES.items():
+            if key in names and field not in cols:
+                cols[field] = i
+    return cols
+
+
+def _cell(row: list[str], cols: dict[str, int], field: str) -> str | None:
+    i = cols.get(field)
+    if i is None or i >= len(row):
+        return None
+    return row[i]
+
+
+def _parse_row(row: list[str], cols: dict[str, int]) -> Expense:
+    raw_day = _cell(row, cols, "date")
+    if raw_day is None:
+        raise ValueError("列 日付 がありません")
+    day = _parse_date(raw_day)
+
+    if "amount" in cols:
+        raw = _cell(row, cols, "amount")
+        if raw is None:
+            raise ValueError("列 金額 がありません")
+        amount = _parse_amount(raw)
+    else:
+        out = (_cell(row, cols, "out") or "").strip()
+        inc = (_cell(row, cols, "in") or "").strip()
+        if out and inc:
+            raise ValueError("出金と入金が両方入力されています")
+        if not out and not inc:
+            raise ValueError("出金と入金がどちらも空です")
+        amount = _parse_amount(out, "出金") if out else -_parse_amount(inc, "入金")
+
+    category = (_cell(row, cols, "category") or "").strip() or _DEFAULT_CATEGORY
+    memo = (_cell(row, cols, "memo") or "").strip()
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+def import_csv(text: str) -> ImportResult:
+    """Parse CSV text. Good rows go to expenses, bad rows to (line_number, reason)."""
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    reader = csv.reader(io.StringIO(text.lstrip("﻿"), newline=""))
+    try:
+        header = next(reader, None)
+        if header is None:
+            return ImportResult(expenses, errors)
+        cols = _find_columns(header)
+        if "date" not in cols:
+            return ImportResult([], [(1, "列 日付 がありません")])
+        if "amount" not in cols and not ("out" in cols or "in" in cols):
+            return ImportResult([], [(1, "列 金額 がありません")])
+        for row in reader:
+            if not row or all(not c.strip() for c in row):
+                continue
+            try:
+                expenses.append(_parse_row(row, cols))
+            except ValueError as e:
+                errors.append((reader.line_num, str(e)))
+    except csv.Error as e:
+        errors.append((reader.line_num, f"CSV として読めません: {e}"))
+    return ImportResult(expenses, errors)
