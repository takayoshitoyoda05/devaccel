@@ -0,0 +1,101 @@
+"""Detect recurring monthly expenses. Pure functions; no I/O."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+from itertools import pairwise
+
+from kakeibo.core import Expense
+
+_MIN_COUNT = 3
+_MIN_GAP_DAYS = 25
+_MAX_GAP_DAYS = 35
+_TOLERANCE_PCT = 10
+
+
+@dataclass(frozen=True)
+class RecurringItem:
+    key: str
+    count: int
+    amount: int  # median, yen; negative for recurring refunds
+    last_day: date
+    next_day: date
+
+
+def _label(e: Expense) -> str:
+    """Display label: memo (stripped), falling back to category."""
+    return e.memo.strip() or e.category
+
+
+def _next_month_same_day(day: date) -> date:
+    """Same day next month; clamp to month end. Dec rolls to Jan of next year."""
+    if day.month == 12:
+        year, month = day.year + 1, 1
+    else:
+        year, month = day.year, day.month + 1
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(day.day, last))
+
+
+def _is_monthly(days: list[date]) -> bool:
+    """days must be sorted ascending; every gap within [25, 35] days."""
+    return all(
+        _MIN_GAP_DAYS <= (later - earlier).days <= _MAX_GAP_DAYS
+        for earlier, later in pairwise(days)
+    )
+
+
+def _median_low(values: list[int]) -> int:
+    """Median; for even counts the lower of the two middle values."""
+    ordered = sorted(values)
+    return ordered[(len(ordered) - 1) // 2]
+
+
+def _within_tolerance(value: int, center: int) -> bool:
+    """|value - center| <= center * 10%, in exact integer arithmetic."""
+    return abs(value - center) * 100 <= center * _TOLERANCE_PCT
+
+
+def _check_group(members: list[Expense]) -> RecurringItem | None:
+    if len(members) < _MIN_COUNT:
+        return None
+
+    signs_negative = [e.amount < 0 for e in members]
+    all_negative = all(signs_negative)
+    if any(signs_negative) and not all_negative:
+        return None  # refunds mixed with expenses
+
+    ordered = sorted(members, key=lambda e: (e.day, _label(e)))
+    days = [e.day for e in ordered]
+    if not _is_monthly(days):
+        return None
+
+    magnitudes = [abs(e.amount) for e in members]
+    center = _median_low(magnitudes)
+    if not all(_within_tolerance(m, center) for m in magnitudes):
+        return None
+
+    last_day = days[-1]
+    return RecurringItem(
+        key=_label(ordered[0]),
+        count=len(members),
+        amount=-center if all_negative else center,
+        last_day=last_day,
+        next_day=_next_month_same_day(last_day),
+    )
+
+
+def find_recurring(rows: list[Expense]) -> list[RecurringItem]:
+    """Return monthly recurring groups, sorted by next_day then key."""
+    groups: dict[str, list[Expense]] = {}
+    for e in rows:
+        groups.setdefault(_label(e).casefold(), []).append(e)
+
+    items: list[RecurringItem] = []
+    for members in groups.values():
+        item = _check_group(members)
+        if item is not None:
+            items.append(item)
+    return sorted(items, key=lambda i: (i.next_day, i.key))
