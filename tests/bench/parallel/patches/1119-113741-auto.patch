+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.importer import import_csv
+
+
+def _lines(*ls: str) -> str:
+    return "\n".join(ls) + "\n"
+
+
+def test_e2_1_bom_and_thousands() -> None:
+    r = import_csv(
+        "﻿" + _lines("date,category,amount,memo", '2026-11-03,food,"1,200",lunch')
+    )
+    assert r.expenses == [Expense(date(2026, 11, 3), "food", 1200, "lunch")]
+    assert r.errors == []
+
+
+def test_e2_2_withdrawal_deposit() -> None:
+    r = import_csv(
+        _lines(
+            "日付,摘要,出金,入金",
+            '2026/11/5,スーパー,"¥3,500",',
+            '2026年11月6日,返金,,"2,000円"',
+        )
+    )
+    assert r.expenses == [
+        Expense(date(2026, 11, 5), "未分類", 3500, "スーパー"),
+        Expense(date(2026, 11, 6), "未分類", -2000, "返金"),
+    ]
+    assert r.errors == []
+
+
+def test_e2_3_fullwidth_and_signs() -> None:
+    r = import_csv(
+        _lines(
+            "date,amount",
+            "２０２６-１１-０７,１，２３４円",
+            "2026-11-08,▲¥500",
+            "2026-11-09,0",
+        )
+    )
+    assert [e.amount for e in r.expenses] == [1234, -500, 0]
+    assert r.expenses[0].day == date(2026, 11, 7)
+
+
+def test_e2_4_bad_rows_reported() -> None:
+    r = import_csv(
+        _lines(
+            "date,amount,memo",
+            "2026-11-01,100,a",
+            "2026-02-30,200,b",
+            "2026-11-02,12.5,c",
+            "2026-11-03,300,d",
+        )
+    )
+    assert [e.memo for e in r.expenses] == ["a", "d"]
+    assert r.errors == [
+        (3, "日付が不正です: '2026-02-30'"),
+        (4, "金額が整数ではありません: '12.5'"),
+    ]
+
+
+def test_e2_5_both_or_neither() -> None:
+    r = import_csv(_lines("日付,出金,入金", "2026-11-01,100,200", "2026-11-02,,"))
+    assert r.expenses == []
+    assert r.errors == [
+        (2, "出金と入金が両方入力されています"),
+        (3, "出金と入金がどちらも空です"),
+    ]
+
+
+def test_e2_6_quoted_newline_and_blank_line() -> None:
+    text = 'date,amount,memo\n2026-11-01,100,"a,b\nc"\n\n2026-11-02,x,e\n'
+    r = import_csv(text)
+    assert [e.memo for e in r.expenses] == ["a,b\nc"]
+    assert r.errors == [(5, "金額が整数ではありません: 'x'")]
+
+
+def test_e2_7_missing_required_column() -> None:
+    r = import_csv(_lines("date,memo", "2026-11-01,x"))
+    assert r.expenses == []
+    assert r.errors == [(1, "列 金額 がありません")]
+
+
+def test_e2_8_empty_inputs() -> None:
+    for text in ("", "date,amount\n"):
+        r = import_csv(text)
+        assert r.expenses == [] and r.errors == []
+
+
+def test_short_row_names_missing_column() -> None:
+    r = import_csv(_lines("date,amount", "2026-11-01"))
+    assert r.errors == [(2, "列 金額 がありません")]
