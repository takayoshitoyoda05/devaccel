--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,68 @@
+"""Filter expense rows with composable condition objects (pure functions)."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Condition:
+    """A predicate over one Expense. Build with the helpers below."""
+
+    test: Callable[[Expense], bool]
+
+    def __call__(self, e: Expense) -> bool:
+        return self.test(e)
+
+
+def category(name: str) -> Condition:
+    """R1: exact, case-sensitive match on category (no whitespace stripping)."""
+    return Condition(lambda e: e.category == name)
+
+
+def amount_between(lo: int | None, hi: int | None) -> Condition:
+    """R2: lo <= amount <= hi (inclusive). None means unbounded on that side."""
+    if lo is not None and hi is not None and lo > hi:
+        raise ValueError(f"金額の範囲が逆転しています: lo={lo} > hi={hi}")
+    return Condition(
+        lambda e: (lo is None or e.amount >= lo) and (hi is None or e.amount <= hi)
+    )
+
+
+def memo_contains(text: str) -> Condition:
+    """R3: case-insensitive substring match. Empty text matches every row."""
+    needle = text.lower()
+    return Condition(lambda e: needle in e.memo.lower())
+
+
+def period(start: date | None, end: date | None) -> Condition:
+    """R4: start <= day <= end (inclusive). None means unbounded on that side."""
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"期間が逆転しています: start={start} > end={end}")
+    return Condition(
+        lambda e: (start is None or e.day >= start) and (end is None or e.day <= end)
+    )
+
+
+def all_of(*conds: Condition) -> Condition:
+    """R5: every condition holds. No conditions -> matches everything."""
+    return Condition(lambda e: all(c(e) for c in conds))
+
+
+def any_of(*conds: Condition) -> Condition:
+    """R5: at least one condition holds. No conditions -> matches nothing."""
+    return Condition(lambda e: any(c(e) for c in conds))
+
+
+def not_of(cond: Condition) -> Condition:
+    """R5: inversion of cond."""
+    return Condition(lambda e: not cond(e))
+
+
+def search(rows: list[Expense], cond: Condition) -> list[Expense]:
+    """R6: rows matching cond, in original order. rows is not modified."""
+    return [e for e in rows if cond(e)]
