+"""Tests for kakeibo.search (D4 / R1-R7 / E3-*, P1-P3)."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    all_of,
+    amount_between,
+    any_of,
+    category,
+    memo_contains,
+    not_of,
+    period,
+    search,
+)
+
+
+def ex(day: str, cat: str, amount: int, memo: str = "") -> Expense:
+    return Expense(day=date.fromisoformat(day), category=cat, amount=amount, memo=memo)
+
+
+# --- E3-1 (R1, R6): 完全一致、元の順 ---------------------------------------
+def test_E3_1_category_exact_keeps_order() -> None:
+    rows = [
+        ex("2024-01-01", "食費", 100),
+        ex("2024-01-02", "交通", 200),
+        ex("2024-01-03", "食費", 300),
+    ]
+    assert search(rows, category("食費")) == [rows[0], rows[2]]
+
+
+# --- E3-2 (R1): 前後空白は無視しない -----------------------------------------
+def test_E3_2_category_does_not_strip_whitespace() -> None:
+    rows = [ex("2024-01-01", "食費 ", 100)]
+    assert search(rows, category("食費")) == []
+
+
+# --- E3-3 (R2): 両端含む -----------------------------------------------------
+def test_E3_3_amount_between_inclusive_bounds() -> None:
+    rows = [
+        ex("2024-01-01", "a", 999),
+        ex("2024-01-02", "a", 1000),
+        ex("2024-01-03", "a", 3000),
+        ex("2024-01-04", "a", 3001),
+    ]
+    assert search(rows, amount_between(1000, 3000)) == [rows[1], rows[2]]
+
+
+# --- E3-4 (R2): 負の金額(返金)も範囲で比較 ----------------------------------
+def test_E3_4_amount_between_negative_refund() -> None:
+    rows = [
+        ex("2024-01-01", "a", -500),
+        ex("2024-01-02", "a", 0),
+        ex("2024-01-03", "a", 1),
+    ]
+    assert search(rows, amount_between(-500, 0)) == [rows[0], rows[1]]
+
+
+# --- E3-5 (R2): 片側無制限 --------------------------------------------------
+def test_E3_5_amount_between_open_lower() -> None:
+    rows = [
+        ex("2024-01-01", "a", -10),
+        ex("2024-01-02", "a", 0),
+        ex("2024-01-03", "a", 1000),
+        ex("2024-01-04", "a", 999),
+    ]
+    assert search(rows, amount_between(None, 0)) == [rows[0], rows[1]]
+
+
+def test_E3_5_amount_between_open_upper() -> None:
+    rows = [
+        ex("2024-01-01", "a", 999),
+        ex("2024-01-02", "a", 1000),
+        ex("2024-01-03", "a", 5000),
+    ]
+    assert search(rows, amount_between(1000, None)) == [rows[1], rows[2]]
+
+
+# --- E3-6 (R3): 部分一致・大文字小文字無視 -----------------------------------
+def test_E3_6_memo_contains_case_insensitive() -> None:
+    rows = [
+        ex("2024-01-01", "a", 1, "Coffee Shop"),
+        ex("2024-01-02", "a", 1, "tea"),
+        ex("2024-01-03", "a", 1, ""),
+    ]
+    assert search(rows, memo_contains("coffee")) == [rows[0]]
+
+
+# --- E3-7 (R3): 空文字は全件一致 --------------------------------------------
+def test_E3_7_memo_contains_empty_matches_all() -> None:
+    rows = [ex("2024-01-01", "a", 1, "a"), ex("2024-01-02", "a", 1, "")]
+    assert search(rows, memo_contains("")) == rows
+
+
+# --- E3-8 (R4): 両端含む、閏年 ----------------------------------------------
+def test_E3_8_period_inclusive_leap_year() -> None:
+    rows = [
+        ex("2024-01-31", "a", 1),
+        ex("2024-02-01", "a", 1),
+        ex("2024-02-29", "a", 1),
+        ex("2024-03-01", "a", 1),
+    ]
+    assert search(rows, period(date(2024, 2, 1), date(2024, 2, 29))) == [
+        rows[1],
+        rows[2],
+    ]
+
+
+# --- E3-9 (R5): all_of は全条件を満たす ------------------------------------
+def test_E3_9_all_of_requires_every_condition() -> None:
+    rows = [
+        ex("2024-01-01", "食費", 500),
+        ex("2024-01-02", "食費", 1500),
+        ex("2024-01-03", "交通", 1500),
+    ]
+    assert search(rows, all_of(category("食費"), amount_between(1000, None))) == [
+        rows[1]
+    ]
+
+
+# --- E3-10 (R5, R6): any_of は 1 つでも満たす --------------------------------
+def test_E3_10_any_of_matches_one_and_keeps_order() -> None:
+    rows = [
+        ex("2024-01-01", "食費", 1),
+        ex("2024-01-02", "交通", 1, "taxi"),
+        ex("2024-01-03", "交通", 1, "bus"),
+    ]
+    assert search(rows, any_of(category("食費"), memo_contains("taxi"))) == [
+        rows[0],
+        rows[1],
+    ]
+
+
+# --- E3-11 (R5): not_of は反転 ----------------------------------------------
+def test_E3_11_not_of_inverts() -> None:
+    rows = [ex("2024-01-01", "食費", 1), ex("2024-01-02", "交通", 1)]
+    assert search(rows, not_of(category("食費"))) == [rows[1]]
+
+
+# --- E3-12 (R5): 空の合成 ---------------------------------------------------
+def test_E3_12_empty_all_of_matches_all_and_empty_any_of_matches_none() -> None:
+    rows = [ex("2024-01-01", "食費", 1), ex("2024-01-02", "交通", 2)]
+    assert search(rows, all_of()) == rows
+    assert search(rows, any_of()) == []
+
+
+# --- E3-13 (R6): 空リスト ---------------------------------------------------
+def test_E3_13_empty_rows() -> None:
+    assert search([], category("食費")) == []
+
+
+# --- E3-14 (R6): 重複行は残す -----------------------------------------------
+def test_E3_14_duplicates_preserved() -> None:
+    a = ex("2024-01-01", "食費", 100, "lunch")
+    rows = [a, ex("2024-01-01", "食費", 100, "lunch")]
+    assert search(rows, category("食費")) == rows
+    assert len(search(rows, category("食費"))) == 2
+
+
+# --- E3-15 (R7): 逆転した範囲は ValueError ----------------------------------
+def test_E3_15_amount_between_reversed_raises() -> None:
+    with pytest.raises(ValueError):
+        amount_between(3000, 1000)
+
+
+def test_E3_15_period_reversed_raises() -> None:
+    with pytest.raises(ValueError):
+        period(date(2024, 3, 1), date(2024, 2, 1))
+
+
+# --- E3-16 (R2, R5): 入れ子の not_of / any_of --------------------------------
+def test_E3_16_nested_not_of_any_of() -> None:
+    rows = [
+        ex("2024-01-01", "食費", 1),
+        ex("2024-01-02", "交通", -100),
+        ex("2024-01-03", "交通", 200),
+    ]
+    cond = not_of(any_of(category("食費"), amount_between(None, -1)))
+    assert search(rows, cond) == [rows[2]]
+
+
+# --- P1 / P2 / P3 不変条件 ---------------------------------------------------
+def test_P1_result_is_subsequence_of_rows() -> None:
+    rows = [
+        ex("2024-01-01", "食費", 1),
+        ex("2024-01-02", "交通", 2),
+        ex("2024-01-03", "食費", 3),
+    ]
+    result = search(rows, category("食費"))
+    it = iter(rows)
+    assert all(any(r is x for x in it) for r in result)
+
+
+def test_P2_cond_and_not_cond_partition_rows() -> None:
+    rows = [
+        ex("2024-01-01", "食費", 1),
+        ex("2024-01-02", "交通", 2),
+        ex("2024-01-03", "食費", 3),
+    ]
+    c = category("食費")
+    yes = search(rows, c)
+    no = search(rows, not_of(c))
+    assert len(yes) + len(no) == len(rows)
+    assert not any(y in no for y in yes)
+
+
+def test_P3_rows_unchanged() -> None:
+    rows = [ex("2024-01-01", "食費", 1), ex("2024-01-02", "交通", 2)]
+    snapshot = list(rows)
+    search(rows, any_of(category("食費"), amount_between(2, None)))
+    assert rows == snapshot
