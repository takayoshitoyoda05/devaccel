new file mode 100644
index 0000000..d7d3d0c
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,260 @@
+from __future__ import annotations
+
+import random
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import RecurringItem, find_recurring
+
+
+def ex(day: str, amount: int, memo: str = "家賃", category: str = "住居") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+def test_E1_1_three_monthly_rent_is_recurring() -> None:
+    """E1-1: 家賃 8万 を 1/5, 2/5, 3/5 → 1 件、amount 80000、next 4/5。"""
+    rows = [
+        ex("2026-01-05", 80000),
+        ex("2026-02-05", 80000),
+        ex("2026-03-05", 80000),
+    ]
+    assert find_recurring(rows) == [
+        RecurringItem(
+            key="家賃",
+            count=3,
+            amount=80000,
+            last_day=date(2026, 3, 5),
+            next_day=date(2026, 4, 5),
+        )
+    ]
+
+
+def test_E1_2_only_two_occurrences_is_not_recurring() -> None:
+    """E1-2: 同じ 家賃 を 1/5, 2/5 の 2 回のみ → []。"""
+    rows = [ex("2026-01-05", 80000), ex("2026-02-05", 80000)]
+    assert find_recurring(rows) == []
+
+
+def test_E1_3_netflix_30_day_gaps_next_is_may_1() -> None:
+    """E1-3: Netflix 1490 を 1/31, 3/2, 4/1(間隔 30・30 日) → 1 件、next 5/1。"""
+    rows = [
+        ex("2026-01-31", 1490, memo="Netflix"),
+        ex("2026-03-02", 1490, memo="Netflix"),
+        ex("2026-04-01", 1490, memo="Netflix"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_day == date(2026, 5, 1)
+
+
+@pytest.mark.parametrize(
+    ("gap", "expected_count"),
+    [
+        pytest.param(24, 0, id="E1-4-gap24"),
+        pytest.param(25, 1, id="E1-4-gap25"),
+        pytest.param(35, 1, id="E1-4-gap35"),
+        pytest.param(36, 0, id="E1-4-gap36"),
+    ],
+)
+def test_E1_4_gap_boundaries(gap: int, expected_count: int) -> None:
+    """E1-4: 間隔 24/25/35/36 日の各 3 回組。24・36 は []、25・35 は 1 件。"""
+    start = date(2026, 1, 1)
+    days = [start, date.fromordinal(start.toordinal() + gap)]
+    days.append(date.fromordinal(days[-1].toordinal() + gap))
+    rows = [Expense(day=d, category="通信", amount=1000, memo="net") for d in days]
+    assert len(find_recurring(rows)) == expected_count
+
+
+def test_E1_5_amount_at_plus_10_percent_boundary_is_included() -> None:
+    """E1-5: 金額 1000, 1000, 1100(中央値 1000)→ 1 件(境界 +10% は含む)。"""
+    rows = [
+        ex("2026-01-05", 1000, memo="通信"),
+        ex("2026-02-05", 1000, memo="通信"),
+        ex("2026-03-05", 1100, memo="通信"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].amount == 1000
+
+
+def test_E1_6_amount_beyond_10_percent_is_excluded() -> None:
+    """E1-6: 金額 1000, 1000, 1101 → []。"""
+    rows = [
+        ex("2026-01-05", 1000, memo="通信"),
+        ex("2026-02-05", 1000, memo="通信"),
+        ex("2026-03-05", 1101, memo="通信"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_E1_7_month_end_clamp_in_next_day() -> None:
+    """E1-7: 1/31, 2/28, 3/28 の Netflix(2026 年)→ 1 件、next 4/28。"""
+    rows = [
+        ex("2026-01-31", 1490, memo="Netflix"),
+        ex("2026-02-28", 1490, memo="Netflix"),
+        ex("2026-03-28", 1490, memo="Netflix"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_day == date(2026, 4, 28)
+
+
+def test_E1_8_month_end_clamp_to_february_end() -> None:
+    """E1-8: 最終日 2026-01-31 → next 2026-02-28。"""
+    rows = [
+        ex("2025-11-30", 1490, memo="Netflix"),
+        ex("2025-12-31", 1490, memo="Netflix"),
+        ex("2026-01-31", 1490, memo="Netflix"),
+    ]
+    result = find_recurring(rows)
+    assert result[0].next_day == date(2026, 2, 28)
+
+
+def test_E1_8_leap_year_february_end() -> None:
+    """E1-8: 最終日 2028-01-30 → next 2028-02-29(閏年)。"""
+    rows = [
+        ex("2027-11-30", 1490, memo="Netflix"),
+        ex("2027-12-30", 1490, memo="Netflix"),
+        ex("2028-01-30", 1490, memo="Netflix"),
+    ]
+    result = find_recurring(rows)
+    assert result[0].next_day == date(2028, 2, 29)
+
+
+def test_E1_9_december_rolls_to_january() -> None:
+    """E1-9: 最終日 2026-12-15 → next 2027-01-15。"""
+    rows = [
+        ex("2026-10-15", 500, memo="保険"),
+        ex("2026-11-15", 500, memo="保険"),
+        ex("2026-12-15", 500, memo="保険"),
+    ]
+    result = find_recurring(rows)
+    assert result[0].next_day == date(2027, 1, 15)
+
+
+def test_E1_10_memo_case_and_spaces_are_merged_key_is_first_spelling() -> None:
+    """E1-10: メモ "Netflix" と " netflix " が各月に交互 → 1 件に統合、key は最初の表記。"""
+    rows = [
+        ex("2026-01-05", 1490, memo="Netflix"),
+        ex("2026-02-05", 1490, memo=" netflix "),
+        ex("2026-03-05", 1490, memo="Netflix"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].key == "Netflix"
+    assert result[0].count == 3
+
+
+def test_E1_11_empty_memo_falls_back_to_category() -> None:
+    """E1-11: メモ空でカテゴリ「通信」が毎月 3 回 → 1 件、key「通信」。"""
+    rows = [
+        ex("2026-01-05", 3000, memo="", category="通信"),
+        ex("2026-02-05", 3000, memo="", category="通信"),
+        ex("2026-03-05", 3000, memo="", category="通信"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].key == "通信"
+
+
+def test_E1_12_monthly_refund_keeps_negative_amount() -> None:
+    """E1-12: 家賃 -80000 が毎月 3 回(返金)→ 1 件、amount -80000。"""
+    rows = [
+        ex("2026-01-05", -80000),
+        ex("2026-02-05", -80000),
+        ex("2026-03-05", -80000),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].amount == -80000
+
+
+def test_E1_13_mixed_sign_group_is_excluded() -> None:
+    """E1-13: 1000, -1000, 1000 を毎月 → []。"""
+    rows = [
+        ex("2026-01-05", 1000, memo="通信"),
+        ex("2026-02-05", -1000, memo="通信"),
+        ex("2026-03-05", 1000, memo="通信"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_E1_14_same_day_duplicate_rows_break_monthly_gap() -> None:
+    """E1-14: 同日同キーが 3 行(2/5 に重複を含む 1/5, 2/5, 2/5)→ []。"""
+    rows = [
+        ex("2026-01-05", 1000, memo="通信"),
+        ex("2026-02-05", 1000, memo="通信"),
+        ex("2026-02-05", 1000, memo="通信"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_E1_15_same_next_day_sorted_by_key() -> None:
+    """E1-15: 2 つの定期(next が同じ日、key は B, A)→ A, B の順。"""
+    rows = [
+        ex("2026-01-05", 500, memo="B"),
+        ex("2026-02-05", 500, memo="B"),
+        ex("2026-03-05", 500, memo="B"),
+        ex("2026-01-05", 700, memo="A"),
+        ex("2026-02-05", 700, memo="A"),
+        ex("2026-03-05", 700, memo="A"),
+    ]
+    result = find_recurring(rows)
+    assert [i.key for i in result] == ["A", "B"]
+    assert result[0].next_day == result[1].next_day
+
+
+def test_E1_16_empty_input_returns_empty() -> None:
+    """E1-16: [] → []。"""
+    assert find_recurring([]) == []
+
+
+def test_E1_16_single_row_returns_empty() -> None:
+    """E1-16: 1 行のみ → []。"""
+    assert find_recurring([ex("2026-01-05", 80000)]) == []
+
+
+def _sample_rows() -> list[Expense]:
+    return [
+        ex("2026-01-05", 80000),
+        ex("2026-02-05", 80000),
+        ex("2026-03-05", 80000),
+        ex("2026-01-31", 1490, memo="Netflix"),
+        ex("2026-03-02", 1490, memo="Netflix"),
+        ex("2026-04-01", 1490, memo="Netflix"),
+        ex("2026-02-10", 300, memo="ランダム"),
+    ]
+
+
+def test_P1_invariants_hold_for_all_outputs() -> None:
+    """P1: count >= 3、next_day > last_day、next_day は last_day の翌月。"""
+    result = find_recurring(_sample_rows())
+    assert result
+    for item in result:
+        assert item.count >= 3
+        assert item.next_day > item.last_day
+        expected_month = 1 if item.last_day.month == 12 else item.last_day.month + 1
+        assert item.next_day.month == expected_month
+
+
+def test_P2_input_order_does_not_change_output() -> None:
+    """P2: 入力行の並びを入れ替えても出力は同じ。"""
+    rows = _sample_rows()
+    shuffled = list(rows)
+    random.Random(0).shuffle(shuffled)
+    assert find_recurring(shuffled) == find_recurring(rows)
+    assert find_recurring(list(reversed(rows))) == find_recurring(rows)
+
+
+def test_P3_repeated_calls_are_equal_and_input_unchanged() -> None:
+    """P3: find_recurring を 2 回呼んでも結果は等しく、入力リストは変化しない。"""
+    rows = _sample_rows()
+    snapshot = list(rows)
+    first = find_recurring(rows)
+    second = find_recurring(rows)
+    assert first == second
+    assert rows == snapshot
