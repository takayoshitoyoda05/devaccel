+"""Month-over-month category comparison (pure functions, no I/O)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"([0-9]{4})-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryDiff:
+    category: str
+    previous: int
+    current: int
+    diff: int
+    rate: float | None
+
+
+def _parse_month(month: str) -> tuple[int, int]:
+    m = _MONTH_RE.fullmatch(month)
+    if m is None:
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+    return int(m.group(1)), int(m.group(2))
+
+
+def _previous_month(year: int, mon: int) -> tuple[int, int]:
+    if mon == 1:
+        return year - 1, 12
+    return year, mon - 1
+
+
+def _category_totals(rows: list[Expense], year: int, mon: int) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for e in rows:
+        if e.day.year == year and e.day.month == mon:
+            out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def compare_months(rows: list[Expense], month: str) -> list[CategoryDiff]:
+    """Compare category totals of `month` with the calendar month before it."""
+    year, mon = _parse_month(month)
+    py, pm = _previous_month(year, mon)
+    current = _category_totals(rows, year, mon)
+    previous = _category_totals(rows, py, pm)
+
+    diffs: list[CategoryDiff] = []
+    for cat in set(current) | set(previous):
+        prev = previous.get(cat, 0)
+        cur = current.get(cat, 0)
+        diff = cur - prev
+        rate = round(diff / prev * 100, 1) if prev > 0 else None
+        diffs.append(CategoryDiff(cat, prev, cur, diff, rate))
+
+    diffs.sort(key=lambda d: (-abs(d.diff), d.category))
+    return diffs
+
+
+def _format_line(d: CategoryDiff) -> str:
+    if d.diff == 0:
+        diff_s = "±0円"
+    else:
+        diff_s = f"{d.diff:+,}円"
+    if d.rate is None:
+        rate_s = "比較不可"
+    elif d.rate == 0:
+        rate_s = "0.0%"
+    else:
+        rate_s = f"{d.rate:+.1f}%"
+    return f"{d.category}: {d.previous:,}円 → {d.current:,}円 ({diff_s}, {rate_s})"
+
+
+def format_diffs(diffs: list[CategoryDiff]) -> str:
+    if not diffs:
+        return "前月との差はありません"
+    return "\n".join(_format_line(d) for d in diffs)
