@@ -0,0 +1,163 @@
+"""Tests for kakeibo.compare (month-over-month category diffs)."""
+
+from __future__ import annotations
+
+import copy
+from datetime import date
+
+import pytest
+
+from kakeibo.compare import CategoryDiff, compare_months, format_diffs
+from kakeibo.core import Expense
+
+
+def e(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+@pytest.mark.parametrize(
+    ("rows", "month", "expected"),
+    [
+        pytest.param(
+            [e("2026-10-05", "食費", 10000), e("2026-11-05", "食費", 12000)],
+            "2026-11",
+            [CategoryDiff("食費", 10000, 12000, 2000, 20.0)],
+            id="E4-1",
+        ),
+        pytest.param(
+            [
+                e("2026-10-05", "食費", 5000),
+                e("2026-11-05", "交通", 1000),
+            ],
+            "2026-11",
+            [
+                CategoryDiff("食費", 5000, 0, -5000, -100.0),
+                CategoryDiff("交通", 0, 1000, 1000, None),
+            ],
+            id="E4-2",
+        ),
+        pytest.param(
+            [e("2026-11-05", "交通", 3000)],
+            "2026-11",
+            [CategoryDiff("交通", 0, 3000, 3000, None)],
+            id="E4-3",
+        ),
+        pytest.param(
+            [
+                e("2026-10-01", "食費", 12000),
+                e("2026-10-02", "食費", -2000),
+                e("2026-10-03", "交通", -500),
+                e("2026-11-01", "食費", 10000),
+                e("2026-11-02", "交通", 1000),
+            ],
+            "2026-11",
+            [
+                CategoryDiff("交通", -500, 1000, 1500, None),
+                CategoryDiff("食費", 10000, 10000, 0, 0.0),
+            ],
+            id="E4-4",
+        ),
+        pytest.param(
+            [e("2026-12-03", "食費", 1000), e("2027-01-03", "食費", 2000)],
+            "2027-01",
+            [CategoryDiff("食費", 1000, 2000, 1000, 100.0)],
+            id="E4-5",
+        ),
+        pytest.param(
+            [
+                e("2026-11-01", "食費", 1000),
+                e("2026-11-02", "住居", 1000),
+                e("2026-11-03", "交通", 3000),
+            ],
+            "2026-11",
+            [
+                CategoryDiff("交通", 0, 3000, 3000, None),
+                CategoryDiff("住居", 0, 1000, 1000, None),
+                CategoryDiff("食費", 0, 1000, 1000, None),
+            ],
+            id="E4-6",
+        ),
+        pytest.param([], "2026-11", [], id="E4-7"),
+    ],
+)
+def test_compare_months_examples(
+    rows: list[Expense], month: str, expected: list[CategoryDiff]
+) -> None:
+    assert compare_months(rows, month) == expected
+
+
+@pytest.mark.parametrize(
+    "month",
+    [
+        pytest.param("2026-13", id="E4-8: 2026-13"),
+        pytest.param("2026-1", id="E4-8: 2026-1"),
+        pytest.param("", id="E4-8: empty"),
+    ],
+)
+def test_compare_months_invalid_month(month: str) -> None:
+    with pytest.raises(ValueError):
+        compare_months([], month)
+
+
+@pytest.mark.parametrize(
+    ("diffs", "text"),
+    [
+        pytest.param(
+            [CategoryDiff("食費", 10000, 12000, 2000, 20.0)],
+            "食費: 10,000円 → 12,000円 (+2,000円, +20.0%)",
+            id="E4-1",
+        ),
+        pytest.param(
+            [CategoryDiff("食費", 5000, 0, -5000, -100.0)],
+            "食費: 5,000円 → 0円 (-5,000円, -100.0%)",
+            id="E4-2",
+        ),
+        pytest.param(
+            [CategoryDiff("交通", 0, 3000, 3000, None)],
+            "交通: 0円 → 3,000円 (+3,000円, 比較不可)",
+            id="E4-3",
+        ),
+        pytest.param(
+            [
+                CategoryDiff("交通", -500, 1000, 1500, None),
+                CategoryDiff("食費", 10000, 10000, 0, 0.0),
+            ],
+            "交通: -500円 → 1,000円 (+1,500円, 比較不可)\n"
+            "食費: 10,000円 → 10,000円 (±0円, 0.0%)",
+            id="E4-4",
+        ),
+        pytest.param([], "前月との差はありません", id="E4-7"),
+    ],
+)
+def test_format_diffs(diffs: list[CategoryDiff], text: str) -> None:
+    assert format_diffs(diffs) == text
+
+
+def test_format_diffs_no_trailing_newline() -> None:
+    out = format_diffs([CategoryDiff("食費", 1, 2, 1, 100.0)])
+    assert not out.endswith("\n")
+
+
+def test_compare_months_does_not_mutate_rows() -> None:
+    rows = [e("2026-10-05", "食費", 5000), e("2026-11-05", "食費", 12000)]
+    snapshot = copy.deepcopy(rows)
+    compare_months(rows, "2026-11")
+    assert rows == snapshot
+
+
+def test_invariants_hold_for_mixed_input() -> None:
+    rows = [
+        e("2026-10-01", "食費", 12000),
+        e("2026-10-02", "食費", -2000),
+        e("2026-10-03", "交通", -500),
+        e("2026-10-04", "住居", 80000),
+        e("2026-11-01", "食費", 10000),
+        e("2026-11-02", "交通", 1000),
+        e("2026-11-03", "娯楽", 7000),
+    ]
+    diffs = compare_months(rows, "2026-11")
+    for d in diffs:
+        assert d.diff == d.current - d.previous  # P1
+        assert (d.rate is None) == (d.previous <= 0)  # P2
+    magnitudes = [abs(d.diff) for d in diffs]
+    assert magnitudes == sorted(magnitudes, reverse=True)  # P3
