diff --git a/tests/test_types/test_Choice.py b/tests/test_types/test_Choice.py
index c34f516..7d545de 100644
--- a/tests/test_types/test_Choice.py
+++ b/tests/test_types/test_Choice.py
@@ -5,3 +5,47 @@ def test_choice_get_invalid_choice_message():
     choice = click.Choice(["a", "b", "c"])
     message = choice.get_invalid_choice_message("d", ctx=None)
     assert message == "'d' is not one of 'a', 'b', 'c'."
+
+
+def test_choice_suggests_close_match():
+    choice = click.Choice(["json", "yaml", "toml"])
+    message = choice.get_invalid_choice_message("jsno", ctx=None)
+    assert (
+        message == "'jsno' is not one of 'json', 'yaml', 'toml'. Did you mean 'json'?"
+    )
+
+
+def test_choice_suggests_multiple_close_matches():
+    choice = click.Choice(["declare", "refine", "other"])
+    message = choice.get_invalid_choice_message("decline", ctx=None)
+    assert message.endswith("(Did you mean one of: 'declare', 'refine'?)")
+
+
+def test_choice_no_suggestion_when_nothing_close():
+    choice = click.Choice(["a", "b", "c"])
+    assert "Did you mean" not in choice.get_invalid_choice_message("zzz", ctx=None)
+
+
+def test_choice_suggestion_case_insensitive():
+    choice = click.Choice(["Json", "Yaml"], case_sensitive=False)
+    message = choice.get_invalid_choice_message("JSNO", ctx=None)
+    assert message.endswith("Did you mean 'json'?")
+
+
+def test_choice_suggestion_non_str_value():
+    choice = click.Choice(["100", "200"])
+    message = choice.get_invalid_choice_message(101, ctx=None)
+    assert message == "101 is not one of '100', '200'. Did you mean '100'?"
+
+
+def test_choice_suggestion_in_cli_error():
+    @click.command()
+    @click.option("--fmt", type=click.Choice(["json", "yaml"]))
+    def cli(fmt):
+        pass
+
+    from click.testing import CliRunner
+
+    result = CliRunner().invoke(cli, ["--fmt", "jsn"])
+    assert result.exit_code == 2
+    assert "Did you mean 'json'?" in result.output
