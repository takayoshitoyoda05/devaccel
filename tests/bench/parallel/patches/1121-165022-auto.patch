+def test_monthly_totals_zero_padded_and_ordered():
+    rows = [
+        Expense(date(2026, 10, 5), "food", 1),
+        Expense(date(2026, 2, 5), "food", 2),
+        Expense(date(2026, 1, 5), "food", 3),
+    ]
+    assert list(monthly_totals(rows)) == ["2026-01", "2026-02", "2026-10"]
+
+
+def test_overrun_warning_for_single_digit_month(tmp_path, monkeypatch, capsys):
+    csv_path = _csv(tmp_path, "2026-03-01,food,5000,\n")
+    b = _budget(tmp_path, {"months": {"2026-03": {"food": 1000}}})
+    assert _run(monkeypatch, csv_path, "--budget", b) == 0
+    assert "警告: 2026-03 food 4,000円超過" in capsys.readouterr().err
+
+
+def test_report_month_order(tmp_path, monkeypatch, capsys):
+    csv_path = _csv(tmp_path, "2026-10-01,food,1,\n2026-02-01,food,2,\n")
+    assert _run(monkeypatch, csv_path, "--report") == 0
+    months = [ln.split("\t")[0] for ln in capsys.readouterr().out.splitlines()]
+    assert months == ["2026-02", "2026-10"]
+
+
