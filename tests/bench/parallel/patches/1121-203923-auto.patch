diff --git a/src/kakeibo/core.py b/src/kakeibo/core.py
index 8c3cbab..02f5b7f 100644
--- a/src/kakeibo/core.py
+++ b/src/kakeibo/core.py
@@ -126,10 +126,31 @@ def find_overruns(
     totals: dict[str, dict[str, int]], budget: Budget
 ) -> list[tuple[str, str, int, int, int]]:
     """(month, category, over, limit, actual) for actual > limit."""
-    out: list[tuple[str, str, int, int, int]] = []
+    return [
+        (month, cat, actual - limit, limit, actual)
+        for month, cat, level, limit, actual, _ in find_budget_alerts(totals, budget)
+        if level == "over"
+    ]
+
+
+def find_budget_alerts(
+    totals: dict[str, dict[str, int]], budget: Budget
+) -> list[tuple[str, str, str, int, int, int | None]]:
+    """(month, category, level, limit, actual, percent) in the order of totals.
+
+    level is "over" for actual > limit, "near" for limit > 0 and
+    actual >= 90% of limit. percent is floor(actual * 100 / limit), None if limit is 0.
+    """
+    out: list[tuple[str, str, str, int, int, int | None]] = []
     for month, cats in totals.items():
         limits = budget.for_month(month)
         for cat, actual in cats.items():
-            if cat in limits and actual > limits[cat]:
-                out.append((month, cat, actual - limits[cat], limits[cat], actual))
+            if cat not in limits:
+                continue
+            limit = limits[cat]
+            percent = actual * 100 // limit if limit > 0 else None
+            if actual > limit:
+                out.append((month, cat, "over", limit, actual, percent))
+            elif limit > 0 and actual * 10 >= limit * 9:
+                out.append((month, cat, "near", limit, actual, percent))
     return out
