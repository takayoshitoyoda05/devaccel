new file mode 100644
index 0000000..ceaab35
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,94 @@
+"""Import CSV exports from other banks / card issuers."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+_AMOUNT_RE = re.compile(r"-?[¥￥]?[0-9][0-9,]*円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+DEFAULT_MAPPING = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+
+def parse_amount(s: str) -> int:
+    t = s.strip()
+    if not _AMOUNT_RE.fullmatch(t):
+        raise ValueError(f"金額が不正です: {s!r}")
+    neg = t.startswith("-")
+    digits = "".join(c for c in t if c in "0123456789")
+    n = int(digits)
+    return -n if neg else n
+
+
+def parse_date(s: str) -> date:
+    m = _DATE_RE.fullmatch(s.strip())
+    if not m:
+        raise ValueError(f"日付が不正です: {s!r}")
+    return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header = next(reader, [])
+    idx: dict[str, int] = {}
+    for key, col in mapping.items():
+        if col not in header:
+            raise ValueError(f"列 {col} がヘッダーにありません")
+        idx[key] = header.index(col)
+
+    def get(row: list[str], key: str) -> str:
+        if key not in idx:
+            return ""
+        i = idx[key]
+        return row[i] if i < len(row) else ""
+
+    cmap = category_map or {}
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    prev = reader.line_num
+    for row in reader:
+        lineno = prev + 1
+        prev = reader.line_num
+        if not row:
+            continue
+        bad = False
+        day = None
+        amount = 0
+        try:
+            day = parse_date(get(row, "date"))
+        except ValueError:
+            errors.append((lineno, "date"))
+            bad = True
+        try:
+            amount = parse_amount(get(row, "amount"))
+        except ValueError:
+            errors.append((lineno, "amount"))
+            bad = True
+        category = get(row, "category").strip()
+        if not category:
+            errors.append((lineno, "category"))
+            bad = True
+        if bad or day is None:
+            continue
+        category = cmap.get(category, category)
+        expenses.append(Expense(day, category, amount, get(row, "memo").strip()))
+    return expenses, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
