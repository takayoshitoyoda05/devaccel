index 0000000..6c8f6c9
--- /dev/null
+++ b/src/kakeibo/yearly.py
@@ -0,0 +1,48 @@
+"""Pure yearly summary of expenses (no I/O)."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class YearlySummary:
+    year: int
+    monthly: dict[int, int]
+    top_month: int | None
+    category_share: dict[str, float]
+    total: int
+
+
+def summarize_year(rows: list[Expense], year: int) -> YearlySummary:
+    monthly: dict[int, int] = {m: 0 for m in range(1, 13)}
+    by_category: dict[str, int] = {}
+    for e in rows:
+        if e.day.year != year:
+            continue
+        monthly[e.day.month] += e.amount
+        by_category[e.category] = by_category.get(e.category, 0) + e.amount
+
+    total = sum(monthly.values())
+
+    top_month: int | None = None
+    best = 0
+    for m in range(1, 13):
+        if monthly[m] > best:
+            best = monthly[m]
+            top_month = m
+
+    category_share: dict[str, float] = {}
+    if total > 0:
+        shares = {cat: amt / total for cat, amt in by_category.items()}
+        category_share = dict(sorted(shares.items(), key=lambda kv: (-kv[1], kv[0])))
+
+    return YearlySummary(
+        year=year,
+        monthly=monthly,
+        top_month=top_month,
+        category_share=category_share,
+        total=total,
+    )
