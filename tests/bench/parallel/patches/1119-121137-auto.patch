+++ b/tests/test_fx.py
@@ -0,0 +1,156 @@
+from __future__ import annotations
+
+from datetime import date
+from decimal import Decimal
+from typing import Any
+
+import pytest
+
+from kakeibo.fx import RateError, to_yen
+
+
+@pytest.mark.parametrize(
+    ("amount", "currency", "day", "rates", "expected"),
+    [
+        # E2-1: 3 日前のレートしか無いので前方補完される (R3)
+        pytest.param(
+            "10.00",
+            "USD",
+            date(2026, 11, 17),
+            {"USD": {date(2026, 11, 14): Decimal(150)}},
+            1500,
+            id="E2-1",
+        ),
+        # E2-2: 151 (150.5 は 0 から遠い方へ丸める) (R4)
+        pytest.param(
+            1,
+            "USD",
+            date(2026, 11, 17),
+            {"USD": {date(2026, 11, 17): Decimal("150.5")}},
+            151,
+            id="E2-2",
+        ),
+    ],
+)
+def test_example_rows(amount, currency, day, rates, expected):
+    assert to_yen(amount, currency, day, rates) == expected
+
+
+def test_e2_3_gap_over_seven_days_raises():
+    # E2-3: 8 日前のレートのみ → RateError (R3, D2)
+    rates = {"EUR": {date(2026, 11, 9): Decimal(160)}}
+    with pytest.raises(RateError):
+        to_yen(1, "EUR", date(2026, 11, 17), rates)
+
+
+def test_gap_of_exactly_seven_days_is_allowed():
+    rates = {"EUR": {date(2026, 11, 10): Decimal(160)}}
+    assert to_yen(1, "EUR", date(2026, 11, 17), rates) == 160
+
+
+def test_gap_limit_is_configurable():
+    rates = {"EUR": {date(2026, 11, 9): Decimal(160)}}
+    assert to_yen(1, "EUR", date(2026, 11, 17), rates, max_gap_days=8) == 160
+
+
+def test_same_day_rate_is_used_over_earlier_one():
+    rates = {
+        "USD": {
+            date(2026, 11, 16): Decimal(100),
+            date(2026, 11, 17): Decimal(200),
+        }
+    }
+    assert to_yen(1, "USD", date(2026, 11, 17), rates) == 200
+
+
+def test_forward_fill_uses_most_recent_earlier_rate():
+    rates = {
+        "USD": {
+            date(2026, 11, 10): Decimal(100),
+            date(2026, 11, 15): Decimal(200),
+        }
+    }
+    assert to_yen(1, "USD", date(2026, 11, 17), rates) == 200
+
+
+def test_no_rate_on_or_before_day_raises():
+    rates = {"USD": {date(2026, 11, 20): Decimal(150)}}
+    with pytest.raises(RateError):
+        to_yen(1, "USD", date(2026, 11, 17), rates)
+
+
+@pytest.mark.parametrize("code", ["usd", "USD", "Usd"])
+def test_currency_code_is_case_insensitive(code):
+    rates = {"USD": {date(2026, 11, 17): Decimal(150)}}
+    assert to_yen(2, code, date(2026, 11, 17), rates) == 300
+
+
+def test_rates_key_in_lowercase_matches_uppercase_currency():
+    rates = {"usd": {date(2026, 11, 17): Decimal(150)}}
+    assert to_yen(2, "USD", date(2026, 11, 17), rates) == 300
+
+
+def test_unknown_currency_raises():
+    with pytest.raises(RateError):
+        to_yen(
+            1, "XYZ", date(2026, 11, 17), {"USD": {date(2026, 11, 17): Decimal(150)}}
+        )
+
+
+def test_jpy_passes_through_without_rates():
+    assert to_yen(1234, "JPY", date(2026, 11, 17), {}) == 1234
+
+
+def test_jpy_fractional_amount_raises():
+    with pytest.raises(RateError):
+        to_yen("12.5", "JPY", date(2026, 11, 17), {})
+
+
+@pytest.mark.parametrize(
+    ("amount", "expected"),
+    [
+        (Decimal("12.50"), 1875),  # 12.5 * 150
+        ("12.50", 1875),
+        ("1,234.5", 185175),  # 1234.5 * 150
+        (-1, -150),  # 返金も換算する
+        ("-10.00", -1500),
+    ],
+)
+def test_amount_input_forms(amount, expected):
+    rates = {"USD": {date(2026, 11, 17): Decimal(150)}}
+    assert to_yen(amount, "USD", date(2026, 11, 17), rates) == expected
+
+
+def test_float_amount_raises_type_error():
+    rates = {"USD": {date(2026, 11, 17): Decimal(150)}}
+    bad: Any = 1.5  # 型外の値を実行時に渡して TypeError を確かめる
+    with pytest.raises(TypeError):
+        to_yen(bad, "USD", date(2026, 11, 17), rates)
+
+
+def test_malformed_string_amount_raises():
+    rates = {"USD": {date(2026, 11, 17): Decimal(150)}}
+    with pytest.raises(RateError):
+        to_yen("abc", "USD", date(2026, 11, 17), rates)
+
+
+@pytest.mark.parametrize(
+    ("amount", "rate", "expected"),
+    [
+        # R4: 0.5 は 0 から遠い方へ。負数は -0.5 → -1
+        (Decimal(1), Decimal("0.5"), 1),
+        (Decimal(-1), Decimal("0.5"), -1),
+        (Decimal(1), Decimal("0.4"), 0),
+        (Decimal(-1), Decimal("0.4"), 0),
+        (Decimal(1), Decimal("2.5"), 3),
+    ],
+)
+def test_rounding_half_away_from_zero(amount, rate, expected):
+    rates = {"USD": {date(2026, 11, 17): rate}}
+    assert to_yen(amount, "USD", date(2026, 11, 17), rates) == expected
+
+
+def test_result_is_int():
+    rates = {"USD": {date(2026, 11, 17): Decimal(150)}}
+    result = to_yen("1.5", "USD", date(2026, 11, 17), rates)
+    assert isinstance(result, int)
diff --git a/tests/test_receipt.py b/tests/test_receipt.py
new file mode 100644
index 0000000..f39aa46
--- /dev/null
+++ b/tests/test_receipt.py
@@ -0,0 +1,148 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.receipt import ReceiptInfo, parse_receipt
+
+NONE = ReceiptInfo(None, None, None)
+
+
+# 仕様の例の表 (E3-1 〜 E3-3) をそのまま写す
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param(
+            "ファミリーマート\n2026/11/19\n小計 ¥1,000\n合計 ¥1,080",
+            ReceiptInfo(date(2026, 11, 19), 1080, "ファミリーマート"),
+            id="E3-1",
+        ),
+        pytest.param(
+            "2O26/l1/I9\n合 計 1O80円",
+            ReceiptInfo(date(2026, 11, 19), 1080, None),
+            id="E3-2",
+        ),
+        pytest.param(
+            "2026/02/30\n2026/03/01",
+            ReceiptInfo(date(2026, 3, 1), None, None),
+            id="E3-3",
+        ),
+    ],
+)
+def test_spec_examples(text, expected):
+    assert parse_receipt(text) == expected
+
+
+# R1: 日付の形式
+@pytest.mark.parametrize(
+    ("text", "day"),
+    [
+        pytest.param("2026/11/19", date(2026, 11, 19), id="R1-slash"),
+        pytest.param("2026-11-19", date(2026, 11, 19), id="R1-hyphen"),
+        pytest.param("2026.11.19", date(2026, 11, 19), id="R1-dot"),
+        pytest.param("２０２６／１１／１９", date(2026, 11, 19), id="R1-fullwidth"),
+        pytest.param("26/11/19", date(2026, 11, 19), id="R1-two-digit-year"),
+        pytest.param("2026 / 11 / 19", date(2026, 11, 19), id="R1-spaced-separators"),
+        pytest.param("2026年11月19日", None, id="R1-kanji-not-supported"),
+        pytest.param("R8.11.19", None, id="R1-reiwa-not-supported"),
+        pytest.param("2026/02/29", None, id="R1-not-leap-year"),
+        pytest.param("2026/11/199", None, id="R1-day-too-long"),
+        pytest.param("2026/11/19\n2026/11/20", date(2026, 11, 19), id="R1-first-wins"),
+    ],
+)
+def test_date_formats(text, day):
+    assert parse_receipt(text).day == day
+
+
+# R2: OCR 崩れ(O→0, l/I→1)は数字の並びの中でのみ補正
+@pytest.mark.parametrize(
+    ("text", "day"),
+    [
+        pytest.param("2O26/1l/I9", date(2026, 11, 19), id="R2-date-letters"),
+        pytest.param("2o26-11-l9", date(2026, 11, 19), id="R2-lowercase-o"),
+        pytest.param("Mo.11.19", None, id="R2-letter-prefix-not-a-date"),
+    ],
+)
+def test_ocr_correction_in_dates(text, day):
+    assert parse_receipt(text).day == day
+
+
+# R3: 金額の書き方
+@pytest.mark.parametrize(
+    "amount_text",
+    [
+        pytest.param("¥1,234", id="R3-yen-sign"),
+        pytest.param("￥1,234", id="R3-fullwidth-yen-sign"),
+        pytest.param("1,234円", id="R3-yen-suffix"),
+        pytest.param("1234", id="R3-plain"),
+        pytest.param("1 234", id="R3-space-group"),
+        pytest.param("1.234", id="R3-dot-group"),
+    ],
+)
+def test_amount_forms(amount_text):
+    assert parse_receipt(f"合計 {amount_text}").total == 1234
+
+
+def test_dot_is_decimal_not_group_when_not_three_digits():
+    assert parse_receipt("合計 1.5").total is None
+
+
+# R3: 合計キーワードは空白混入・大文字小文字を無視
+@pytest.mark.parametrize(
+    "line",
+    [
+        "合計 500",
+        "合 計 500",
+        "小 計 500",
+        "TOTAL 500",
+        "Total 500",
+        "total 500",
+        "お会計 500",
+        "税込 500",
+    ],
+)
+def test_total_keywords(line):
+    assert parse_receipt(line).total == 500
+
+
+# D4: 合計は keyword 行の金額の最大値。keyword が無ければ全金額の最大値
+def test_total_is_max_of_keyword_lines():
+    assert parse_receipt("税込 ¥300\n合計 ¥100").total == 300
+
+
+def test_total_falls_back_to_max_of_all_amounts():
+    assert parse_receipt("ABC\n2026/11/19\n1,200\n300").total == 1200
+
+
+def test_total_ignores_phone_and_date_digits():
+    text = "ABC\n03-1234-5678\n2026/11/19\n980"
+    assert parse_receipt(text).total == 980
+
+
+def test_total_unreadable_is_none():
+    assert parse_receipt("ABC\n合計 なし").total is None
+
+
+# R4: 店名は先頭から見て最初の条件を満たす行
+def test_store_is_first_non_trivial_line():
+    text = "\n  \n領収書\n03-1234-5678\nセブン-イレブン\n2026/11/19\n合計 500"
+    assert parse_receipt(text).store == "セブン-イレブン"
+
+
+def test_store_is_stripped_and_nfkc_normalized():
+    assert parse_receipt("  ＡＢＣストア  \n合計 500").store == "ABCストア"
+
+
+def test_store_skips_receipt_words_only_line():
+    assert parse_receipt("RECEIPT\nローソン").store == "ローソン"
+
+
+def test_store_none_when_only_trivial_lines():
+    assert parse_receipt("2026/11/19\n¥1,000\n領収書").store is None
+
+
+# R5: 空・解析不能は全 None
+@pytest.mark.parametrize("text", ["", "   ", "???", "\n\n"])
+def test_empty_or_unparseable_gives_all_none(text):
+    assert parse_receipt(text) == NONE
