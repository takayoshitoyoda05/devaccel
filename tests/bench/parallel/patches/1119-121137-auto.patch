+++ b/src/kakeibo/receipt.py
@@ -0,0 +1,131 @@
+"""レシート OCR テキストから日付・合計・店名を取り出す純粋関数群。
+
+副作用なし・標準ライブラリのみ。金額は円の整数。
+"""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+
+@dataclass(frozen=True)
+class ReceiptInfo:
+    day: date | None
+    total: int | None
+    store: str | None
+
+
+# OCR で数字と取り違えやすい文字(数字の並びの中でのみ補正する)
+_D = "[0-9OoIl]"
+_OCR = str.maketrans({"O": "0", "o": "0", "l": "1", "I": "1"})
+
+# 電話番号: ハイフン区切り、または 10〜11 桁の連続
+_PHONE_RE = re.compile(
+    r"(?<![0-9A-Za-z])0[0-9]{1,4}-[0-9]{1,4}-[0-9]{3,4}(?![0-9])"
+    r"|(?<![0-9A-Za-z])0[0-9]{9,10}(?![0-9])"
+)
+
+# 日付: 区切りは / . - のみ。2 桁年は 2000 年代とみなす。
+_DATE_RE = re.compile(
+    r"(?<![0-9A-Za-z])"
+    r"(" + _D + r"{4}|" + _D + r"{2})"
+    r"[ \t]*[/.\-][ \t]*"
+    r"(" + _D + r"{1,2})"
+    r"[ \t]*[/.\-][ \t]*"
+    r"(" + _D + r"{1,2})"
+    r"(?![0-9A-Za-z])"
+)
+
+# 金額: ¥ 接頭・円 接尾・桁区切り(, . 空白。. は 3 桁ちょうどのときのみ)
+_AMOUNT_RE = re.compile(
+    r"(?<![0-9A-Za-z.,])"
+    r"(?:¥[ \t]*)?"
+    r"([0-9]" + _D + r"*(?:(?:,|\.| )" + _D + r"{3})*)"
+    r"(?:[ \t]*円)?"
+    r"(?![0-9A-Za-z]|[.,][0-9])"
+)
+
+_TOTAL_KEYS = ("合計", "小計", "税込", "お会計", "total")
+_RECEIPT_WORDS_RE = re.compile(r"領収書|レシート|receipt", re.IGNORECASE)
+
+
+def _squash(line: str) -> str:
+    """空白を除き小文字化したもの(キーワード照合用)。"""
+    return re.sub(r"\s+", "", line).lower()
+
+
+def _is_total_line(line: str) -> bool:
+    squashed = _squash(line)
+    return any(key in squashed for key in _TOTAL_KEYS)
+
+
+def _strip_phones(line: str) -> str:
+    return _PHONE_RE.sub(" ", line)
+
+
+def _strip_dates(line: str) -> str:
+    return _DATE_RE.sub(" ", line)
+
+
+def _amounts(line: str) -> list[int]:
+    """行から金額を順に取り出す。日付・電話番号は先に除いておく。"""
+    body = _strip_dates(_strip_phones(line))
+    return [
+        int(re.sub(r"[ ,.]", "", m.group(1)).translate(_OCR))
+        for m in _AMOUNT_RE.finditer(body)
+    ]
+
+
+def _find_day(line: str) -> date | None:
+    """行内で最初に存在する有効な日付を返す。存在しない日付は飛ばす。"""
+    for m in _DATE_RE.finditer(_strip_phones(line)):
+        year_s, month_s, day_s = (g.translate(_OCR) for g in m.groups())
+        year = int(year_s)
+        if len(year_s) == 2:
+            year += 2000
+        try:
+            return date(year, int(month_s), int(day_s))
+        except ValueError:
+            continue
+    return None
+
+
+def _find_total(lines: list[str]) -> int | None:
+    """合計キーワード行の金額の最大値。無ければ全金額の最大値。"""
+    keyword_amounts: list[int] = []
+    all_amounts: list[int] = []
+    for line in lines:
+        amounts = _amounts(line)
+        all_amounts.extend(amounts)
+        if _is_total_line(line):
+            keyword_amounts.extend(amounts)
+    pool = keyword_amounts or all_amounts
+    return max(pool) if pool else None
+
+
+def _is_store_line(line: str) -> bool:
+    if not line or _is_total_line(line):
+        return False
+    rest = _strip_phones(line)
+    rest = _strip_dates(rest)
+    rest = _AMOUNT_RE.sub(" ", rest)
+    rest = _RECEIPT_WORDS_RE.sub(" ", rest)
+    return re.search(r"[^\W\d_]", rest) is not None
+
+
+def parse_receipt(text: str) -> ReceiptInfo:
+    normalized = unicodedata.normalize("NFKC", text)
+    lines = [line.strip() for line in normalized.splitlines()]
+
+    day = None
+    for line in lines:
+        day = _find_day(line)
+        if day is not None:
+            break
+
+    store = next((line for line in lines if _is_store_line(line)), None)
+
+    return ReceiptInfo(day=day, total=_find_total(lines), store=store)
diff --git a/src/kakeibo/yearly.py b/src/kakeibo/yearly.py
