@@ -0,0 +1,100 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.budget_alert import Alert, check_budgets
+from kakeibo.core import Expense
+
+
+def _e(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+@pytest.mark.parametrize(
+    ("rows", "budgets", "expected"),
+    [
+        # E1-1: 使用額が予算ちょうどは warn
+        pytest.param(
+            [_e("2026-03-05", "food", 1000)],
+            {"food": 1000},
+            [Alert("food", 1000, 1000, "warn")],
+            id="E1-1",
+        ),
+        # E1-2: 予算超過は over
+        pytest.param(
+            [_e("2026-03-05", "food", 1001)],
+            {"food": 1000},
+            [Alert("food", 1001, 1000, "over")],
+            id="E1-2",
+        ),
+    ],
+)
+def test_table_cases(
+    rows: list[Expense], budgets: dict[str, int], expected: list[Alert]
+) -> None:
+    assert check_budgets(rows, budgets, "2026-03") == expected
+
+
+def test_E1_3_invalid_month_raises() -> None:
+    # E1-3: 13 月は ValueError
+    with pytest.raises(ValueError):
+        check_budgets([], {"food": 1000}, "2026-13")
+
+
+# R1: 対象は month の支出のみ
+def test_R1_other_months_are_ignored() -> None:
+    rows = [_e("2026-02-28", "food", 5000), _e("2026-04-01", "food", 5000)]
+    assert check_budgets(rows, {"food": 1000}, "2026-03") == []
+
+
+# R2: 支出が無いカテゴリはアラートなし、予算 0 で支出ありは over
+def test_R2_no_spend_no_alert() -> None:
+    assert check_budgets([], {"food": 0}, "2026-03") == []
+
+
+def test_R2_zero_budget_with_spend_is_over() -> None:
+    rows = [_e("2026-03-01", "food", 1)]
+    assert check_budgets(rows, {"food": 0}, "2026-03") == [Alert("food", 1, 0, "over")]
+
+
+def test_R2_negative_budget_raises() -> None:
+    with pytest.raises(ValueError):
+        check_budgets([], {"food": -1}, "2026-03")
+
+
+@pytest.mark.parametrize("ratio", [-0.1, 1.1])
+def test_R2_warn_ratio_out_of_range_raises(ratio: float) -> None:
+    with pytest.raises(ValueError):
+        check_budgets([], {"food": 1000}, "2026-03", warn_ratio=ratio)
+
+
+# R3: over 先、次に warn、同 status 内は超過額の降順、同点はカテゴリ名昇順
+def test_R3_ordering() -> None:
+    rows = [
+        _e("2026-03-01", "a_warn", 800),  # warn, 超過額 -200
+        _e("2026-03-01", "b_over", 1500),  # over, 超過額 +500
+        _e("2026-03-01", "c_over", 1200),  # over, 超過額 +200
+        _e("2026-03-01", "d_over", 1200),  # over, 超過額 +200 (同点)
+        _e("2026-03-01", "e_warn", 1000),  # warn, 超過額 0
+    ]
+    budgets = {
+        "a_warn": 1000,
+        "b_over": 1000,
+        "c_over": 1000,
+        "d_over": 1000,
+        "e_warn": 1000,
+    }
+    got = [a.category for a in check_budgets(rows, budgets, "2026-03")]
+    assert got == ["b_over", "c_over", "d_over", "e_warn", "a_warn"]
+
+
+# R4: 予算の 80% 以上 100% 未満は warn、80% 未満はアラートなし
+def test_R4_warn_ratio_band() -> None:
+    assert check_budgets(
+        [_e("2026-03-01", "food", 800)], {"food": 1000}, "2026-03"
+    ) == [Alert("food", 800, 1000, "warn")]
+    assert (
+        check_budgets([_e("2026-03-01", "food", 799)], {"food": 1000}, "2026-03") == []
+    )
diff --git a/tests/test_fx.py b/tests/test_fx.py
