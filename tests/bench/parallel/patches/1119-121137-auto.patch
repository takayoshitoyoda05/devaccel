new file mode 100644
index 0000000..651c43f
--- /dev/null
+++ b/tests/test_yearly.py
@@ -0,0 +1,119 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.yearly import YearlySummary, summarize_year
+
+
+def _e(day: date, category: str, amount: int) -> Expense:
+    return Expense(day=day, category=category, amount=amount)
+
+
+@pytest.mark.parametrize(
+    ("rows", "expected_top"),
+    [
+        pytest.param(
+            [_e(date(2026, 3, 1), "food", 500), _e(date(2026, 5, 1), "food", 500)],
+            3,
+            id="E4-1",
+        ),
+    ],
+)
+def test_top_month_is_max_and_ties_pick_earliest(
+    rows: list[Expense], expected_top: int
+) -> None:
+    assert summarize_year(rows, 2026).top_month == expected_top
+
+
+@pytest.mark.parametrize(
+    ("rows", "year"),
+    [
+        pytest.param([], 2026, id="E4-2"),
+    ],
+)
+def test_empty_year_is_all_zero_with_no_top_and_no_share(
+    rows: list[Expense], year: int
+) -> None:
+    s = summarize_year(rows, year)
+    assert s.monthly == {m: 0 for m in range(1, 13)}
+    assert s.top_month is None
+    assert s.category_share == {}
+    assert s.total == 0
+
+
+@pytest.mark.parametrize(
+    ("rows", "expected_share"),
+    [
+        pytest.param(
+            [_e(date(2026, 1, 10), "food", 300), _e(date(2026, 2, 10), "rent", 700)],
+            {"rent": 0.7, "food": 0.3},
+            id="E4-3",
+        ),
+    ],
+)
+def test_category_share_sorted_by_share_desc(
+    rows: list[Expense], expected_share: dict[str, float]
+) -> None:
+    s = summarize_year(rows, 2026)
+    assert s.category_share == expected_share
+    assert list(s.category_share) == list(expected_share)
+
+
+def test_monthly_has_all_twelve_keys_with_zero_for_empty_months() -> None:
+    s = summarize_year([_e(date(2026, 7, 1), "food", 100)], 2026)
+    assert s.monthly == {**{m: 0 for m in range(1, 13)}, 7: 100}
+
+
+def test_rows_outside_year_are_ignored() -> None:
+    rows = [_e(date(2025, 12, 31), "food", 999), _e(date(2026, 1, 1), "food", 100)]
+    s = summarize_year(rows, 2026)
+    assert s.total == 100
+    assert s.monthly[1] == 100
+    assert s.category_share == {"food": 1.0}
+
+
+def test_category_share_ties_sorted_by_name_asc() -> None:
+    rows = [_e(date(2026, 1, 1), "beta", 100), _e(date(2026, 1, 2), "alpha", 100)]
+    assert list(summarize_year(rows, 2026).category_share) == ["alpha", "beta"]
+
+
+def test_top_month_tie_picks_earlier_month_not_later() -> None:
+    rows = [_e(date(2026, 12, 1), "food", 800), _e(date(2026, 4, 1), "food", 800)]
+    assert summarize_year(rows, 2026).top_month == 4
+
+
+def test_share_is_not_rounded() -> None:
+    rows = [_e(date(2026, 1, 1), "a", 1), _e(date(2026, 1, 2), "b", 2)]
+    share = summarize_year(rows, 2026).category_share
+    assert share["b"] == pytest.approx(2 / 3)
+    assert share["b"] != round(2 / 3, 2)
+
+
+def test_negative_amounts_are_summed_as_is() -> None:
+    rows = [_e(date(2026, 1, 1), "food", 1000), _e(date(2026, 2, 1), "food", -300)]
+    s = summarize_year(rows, 2026)
+    assert s.total == 700
+    assert s.monthly[2] == -300
+    assert s.top_month == 1
+
+
+def test_share_empty_when_total_not_positive() -> None:
+    rows = [_e(date(2026, 1, 1), "food", 100), _e(date(2026, 2, 1), "refund", -300)]
+    s = summarize_year(rows, 2026)
+    assert s.total == -200
+    assert s.category_share == {}
+
+
+def test_top_month_none_when_all_months_nonpositive() -> None:
+    rows = [_e(date(2026, 1, 1), "refund", -100)]
+    assert summarize_year(rows, 2026).top_month is None
+
+
+def test_result_is_frozen_dataclass() -> None:
+    s = summarize_year([], 2026)
+    assert isinstance(s, YearlySummary)
+    with pytest.raises(AttributeError):
+        s.total = 1  # type: ignore[misc]
