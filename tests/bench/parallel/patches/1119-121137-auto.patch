@@ -0,0 +1,70 @@
+"""Foreign-currency to yen conversion (pure functions, no I/O)."""
+
+from __future__ import annotations
+
+from datetime import date
+from decimal import ROUND_HALF_UP, Decimal, InvalidOperation
+
+
+class RateError(ValueError):
+    """Raised when a yen conversion cannot be done with the given rates."""
+
+
+def _to_decimal(amount: str | Decimal | int) -> Decimal:
+    if isinstance(amount, bool) or not isinstance(amount, (str, Decimal, int)):
+        raise TypeError(
+            f"amount は str / Decimal / int である必要があります: {type(amount).__name__}"
+        )
+    if isinstance(amount, str):
+        try:
+            return Decimal(amount.replace(",", ""))
+        except InvalidOperation:
+            raise RateError(f"金額が数値ではありません: {amount!r}") from None
+    return Decimal(amount)
+
+
+def _find_rate(
+    table: dict[date, Decimal], day: date, currency: str, max_gap_days: int
+) -> Decimal:
+    if day in table:
+        return table[day]
+    earlier = [d for d in table if d < day]
+    if not earlier:
+        raise RateError(f"{currency} のレートが {day} 以前にありません")
+    nearest = max(earlier)
+    gap = (day - nearest).days
+    if gap > max_gap_days:
+        raise RateError(
+            f"{currency} の最新レートは {nearest} で、{day} から {gap} 日離れています"
+            f"(上限 {max_gap_days} 日)"
+        )
+    return table[nearest]
+
+
+def to_yen(
+    amount: str | Decimal | int,
+    currency: str,
+    day: date,
+    rates: dict[str, dict[date, Decimal]],
+    max_gap_days: int = 7,
+) -> int:
+    """Convert a foreign amount to whole yen (half-up, away from zero)."""
+    value = _to_decimal(amount)
+    code = currency.upper()
+
+    if code == "JPY":
+        if value != value.to_integral_value():
+            raise RateError(f"JPY は整数である必要があります: {amount!r}")
+        return int(value)
+
+    table: dict[date, Decimal] | None = None
+    for key, candidate in rates.items():
+        if key.upper() == code:
+            table = candidate
+            break
+    if table is None:
+        raise RateError(f"通貨 {currency} のレートがありません")
+
+    rate = _find_rate(table, day, code, max_gap_days)
+    yen = (value * rate).quantize(Decimal(1), rounding=ROUND_HALF_UP)
+    return int(yen)
