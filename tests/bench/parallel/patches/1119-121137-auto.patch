@@ -0,0 +1,60 @@
+"""Budget alerts for a single month. Pure functions, no I/O."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from decimal import Decimal
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class Alert:
+    category: str
+    spent: int
+    budget: int
+    status: str  # "warn" | "over"
+
+
+def check_budgets(
+    rows: list[Expense],
+    budgets: dict[str, int],
+    month: str,
+    warn_ratio: float = 0.8,
+) -> list[Alert]:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"month は YYYY-MM 形式である必要があります: {month!r}")
+    if not 0 <= warn_ratio <= 1:
+        raise ValueError(
+            f"warn_ratio は 0〜1 の範囲である必要があります: {warn_ratio!r}"
+        )
+    for cat, budget in budgets.items():
+        if budget < 0:
+            raise ValueError(f"予算は負にできません: {cat} = {budget}")
+
+    spent_by_cat: dict[str, int] = {}
+    for e in rows:
+        if e.day.strftime("%Y-%m") == month:
+            spent_by_cat[e.category] = spent_by_cat.get(e.category, 0) + e.amount
+
+    ratio = Decimal(str(warn_ratio))
+    alerts: list[Alert] = []
+    for cat, budget in budgets.items():
+        spent = spent_by_cat.get(cat, 0)
+        if spent == 0:
+            continue
+        if spent > budget:
+            status = "over"
+        elif spent == budget or spent >= Decimal(budget) * ratio:
+            status = "warn"
+        else:
+            continue
+        alerts.append(Alert(cat, spent, budget, status))
+
+    def sort_key(a: Alert) -> tuple[int, int, str]:
+        return (0 if a.status == "over" else 1, -(a.spent - a.budget), a.category)
+
+    return sorted(alerts, key=sort_key)
