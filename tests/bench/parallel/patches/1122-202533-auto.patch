diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..551a408 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -188,3 +188,119 @@ def test_path_type(runner, cls, expect):
 
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
+
+
+@pytest.mark.parametrize(
+    "name",
+    ["a.csv", "a.TSV", "dir/A.Csv", "a.b.csv", ".csv"],
+)
+def test_path_extensions_accepts(name):
+    path = click.Path(extensions=[".csv", ".tsv"])
+    assert path.convert(name, None, None) == name
+
+
+@pytest.mark.parametrize("name", ["a.txt", "csv", "a.csv.bak", "a", "a.csv/", ""])
+def test_path_extensions_rejects(name):
+    path = click.Path(extensions=[".csv", ".tsv"])
+
+    with pytest.raises(click.BadParameter, match="must have one of the extensions"):
+        path.convert(name, None, None)
+
+
+def test_path_extensions_dot_optional_and_case():
+    assert click.Path(extensions=["CSV", ".Tsv"]).extensions == (".csv", ".tsv")
+    assert click.Path(extensions=("csv", ".csv")).extensions == (".csv",)
+    assert click.Path(extensions=["tar.gz"]).convert("x.TAR.GZ", None, None)
+
+
+def test_path_extensions_default_accepts_anything():
+    assert click.Path().extensions is None
+    assert click.Path().convert("a.txt", None, None) == "a.txt"
+
+
+@pytest.mark.parametrize(
+    ("extensions", "error"),
+    [
+        ("csv", TypeError),
+        (b"csv", TypeError),
+        ([b"csv"], TypeError),
+        ([None], TypeError),
+        ([], ValueError),
+        ([""], ValueError),
+        ([".", ".csv"], ValueError),
+    ],
+)
+def test_path_extensions_invalid_argument(extensions, error):
+    with pytest.raises(error):
+        click.Path(extensions=extensions)
+
+
+def test_path_extensions_error_message_lists_extensions():
+    path = click.Path(extensions=["csv", "tsv"])
+
+    with pytest.raises(click.BadParameter) as info:
+        path.convert("a.txt", None, None)
+
+    assert "'a.txt'" in info.value.message
+    assert ".csv, .tsv" in info.value.message
+
+
+def test_path_extensions_existing_file(tmp_path):
+    good = tmp_path / "data.CSV"
+    good.write_text("x")
+    bad = tmp_path / "data.txt"
+    bad.write_text("x")
+    path = click.Path(exists=True, extensions=["csv"], path_type=pathlib.Path)
+
+    assert path.convert(os.fspath(good), None, None) == good
+
+    with pytest.raises(click.BadParameter, match="must have one of the extensions"):
+        path.convert(os.fspath(bad), None, None)
+
+
+def test_path_extensions_missing_file_reports_not_exist_first(tmp_path):
+    path = click.Path(exists=True, extensions=["csv"])
+
+    with pytest.raises(click.BadParameter, match="does not exist"):
+        path.convert(os.fspath(tmp_path / "missing.txt"), None, None)
+
+
+def test_path_extensions_skips_directory(tmp_path):
+    directory = tmp_path / "data.d"
+    directory.mkdir()
+    path = click.Path(extensions=["csv"])
+
+    assert path.convert(os.fspath(directory), None, None) == os.fspath(directory)
+
+
+def test_path_extensions_skips_dash():
+    path = click.Path(allow_dash=True, extensions=["csv"])
+    assert path.convert("-", None, None) == "-"
+
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions=["csv"]).convert("-", None, None)
+
+
+def test_path_extensions_bytes_and_pathlike():
+    path = click.Path(extensions=["csv"])
+    assert path.convert(b"a.CSV", None, None) == b"a.CSV"
+    assert path.convert(pathlib.PurePosixPath("a.csv"), None, None)
+
+    with pytest.raises(click.BadParameter):
+        path.convert(b"a.txt", None, None)
+
+
+def test_path_extensions_info_dict():
+    assert click.Path(extensions=["CSV"]).to_info_dict()["extensions"] == [".csv"]
+
+
+def test_path_extensions_cli(runner):
+    @click.command()
+    @click.argument("f", type=click.Path(extensions=["csv", "tsv"]))
+    def cli(f):
+        click.echo(f)
+
+    assert runner.invoke(cli, ["a.TSV"]).output == "a.TSV\n"
+    result = runner.invoke(cli, ["a.txt"])
+    assert result.exit_code == 2
+    assert "must have one of the extensions: .csv, .tsv." in result.output
