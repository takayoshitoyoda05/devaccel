+def _normalize_extensions(
+    extensions: cabc.Iterable[str] | None,
+) -> tuple[str, ...] | None:
+    """Lower-case each extension and give it a leading dot."""
+    if extensions is None:
+        return None
+
+    if isinstance(extensions, (str, bytes)):
+        raise TypeError("'extensions' must be a collection of strings, not a string.")
+
+    result: list[str] = []
+
+    for ext in extensions:
+        if not isinstance(ext, str):
+            raise TypeError(f"Each extension must be a string, got {ext!r}.")
+
+        ext = ext.lower()
+
+        if not ext.startswith("."):
+            ext = f".{ext}"
+
+        if ext == ".":
+            raise ValueError("An extension must not be empty.")
+
+        if ext not in result:
+            result.append(ext)
+
+    if not result:
+        raise ValueError("'extensions' must not be empty.")
+
+    return tuple(result)
 
 
