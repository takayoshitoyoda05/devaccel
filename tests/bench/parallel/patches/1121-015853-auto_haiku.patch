@@ -0,0 +1,303 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import (
+    UNCATEGORIZED,
+    ColumnSpec,
+    ImportFormatError,
+    format_issue,
+    import_bank_csv,
+    parse_amount,
+    parse_date,
+)
+from kakeibo.core import Expense
+
+CARD = "日付,利用店名,利用金額,分類\n"
+BANK = "日付,摘要,出金,入金,残高\n"
+
+
+# --- parse_amount -----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        ("1,234", 1234),
+        ("1234", 1234),
+        ("¥1,234", 1234),
+        ("￥1,234", 1234),
+        ("1,234円", 1234),
+        ("１，２３４", 1234),
+        ("１２３４", 1234),
+        (" 1 234 ", 1234),
+        ("+500", 500),
+        ("0", 0),
+        ("-500", -500),
+        ("−500", -500),
+        ("△1,234", -1234),
+        ("▲1,234", -1234),
+        ("(1,234)", -1234),
+    ],
+)
+def test_parse_amount_accepts_common_formats(raw, expected):
+    assert parse_amount(raw) == expected
+
+
+@pytest.mark.parametrize(
+    ("raw", "reason"),
+    [
+        ("", "金額が空です"),
+        ("   ", "金額が空です"),
+        ("abc", "金額が整数ではありません"),
+        ("1.5", "金額が整数ではありません"),
+        ("1,234.00", "金額が整数ではありません"),
+        ("--1", "金額が整数ではありません"),
+        ("()", "金額が整数ではありません"),
+        ("12ドル", "金額が整数ではありません"),
+    ],
+)
+def test_parse_amount_rejects_bad_values(raw, reason):
+    with pytest.raises(ValueError, match=reason):
+        parse_amount(raw)
+
+
+# --- parse_date -------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-11-01",
+        "2026/11/1",
+        "2026.11.01",
+        "2026年11月1日",
+        "20261101",
+        "2026/11/01 10:23",
+        "2026-11-01T10:23:00",
+        "２０２６/１１/０１",
+    ],
+)
+def test_parse_date_accepts_common_formats(raw):
+    assert parse_date(raw) == date(2026, 11, 1)
+
+
+@pytest.mark.parametrize(
+    ("raw", "reason"),
+    [
+        ("", "日付が空です"),
+        ("2026-02-30", "存在しない日付です"),
+        ("11/01/2026", "日付の形式が不正です"),
+        ("abc", "日付の形式が不正です"),
+    ],
+)
+def test_parse_date_rejects_bad_values(raw, reason):
+    with pytest.raises(ValueError, match=reason):
+        parse_date(raw)
+
+
+# --- import_bank_csv: card statements ----------------------------------------
+
+
+def test_card_statement_maps_columns_by_name_and_keeps_file_order():
+    text = (
+        "日付,利用店名,利用金額,分類\n"
+        '2026/11/01,ストアA,"1,200",食費\n'
+        '2026/11/02,カフェB,"¥800",\n'
+    )
+    result = import_bank_csv(text)
+    assert result.errors == []
+    assert result.skipped == []
+    assert result.expenses == [
+        Expense(date(2026, 11, 1), "食費", 1200, "ストアA"),
+        Expense(date(2026, 11, 2), UNCATEGORIZED, 800, "カフェB"),
+    ]
+
+
+def test_card_refund_is_skipped_not_dropped_silently():
+    text = CARD + "2026/11/01,ストアA,1200,食費\n2026/11/02,ストアA,△1200,食費\n"
+    result = import_bank_csv(text)
+    assert [e.amount for e in result.expenses] == [1200]
+    assert [s.line for s in result.skipped] == [3]
+    assert result.skipped[0].column == "利用金額"
+    assert result.skipped[0].value == "△1200"
+
+
+def test_spend_is_negative_flips_the_sign_convention():
+    spec = ColumnSpec(spend_is_negative=True)
+    text = "日付,摘要,金額\n2026-11-01,コンビニ,-300\n2026-11-02,給与,500000\n"
+    result = import_bank_csv(text, spec)
+    assert result.expenses == [
+        Expense(date(2026, 11, 1), UNCATEGORIZED, 300, "コンビニ")
+    ]
+    assert [s.line for s in result.skipped] == [3]
+
+
+def test_zero_amount_is_skipped():
+    result = import_bank_csv(CARD + "2026-11-01,ストア,0,食費\n")
+    assert result.expenses == []
+    assert [s.line for s in result.skipped] == [2]
+
+
+# --- import_bank_csv: bank statements (出金/入金) ----------------------------
+
+
+def test_bank_withdrawal_becomes_expense_and_deposit_is_skipped():
+    text = BANK + (
+        '2026-11-01,電気代,"3,200",,100000\n2026-11-02,給与,,250000,350000\n'
+    )
+    result = import_bank_csv(text)
+    assert result.errors == []
+    assert result.expenses == [
+        Expense(date(2026, 11, 1), UNCATEGORIZED, 3200, "電気代")
+    ]
+    assert len(result.skipped) == 1
+    assert result.skipped[0].line == 3
+    assert result.skipped[0].column == "入金"
+
+
+def test_bank_row_with_both_withdrawal_and_deposit_is_error():
+    result = import_bank_csv(BANK + "2026-11-01,謎,100,200,0\n")
+    assert result.expenses == []
+    assert len(result.errors) == 1
+    assert result.errors[0].line == 2
+    assert "両方に金額" in result.errors[0].reason
+
+
+def test_bank_row_with_neither_withdrawal_nor_deposit_is_error():
+    result = import_bank_csv(BANK + "2026-11-01,謎,,,0\n")
+    assert len(result.errors) == 1
+    assert "金額がありません" in result.errors[0].reason
+
+
+def test_bank_withdrawal_with_yen_sign_and_negative_withdrawal_is_error():
+    result = import_bank_csv(BANK + "2026-11-01,謎,△100,,0\n")
+    assert len(result.errors) == 1
+    assert result.errors[0].column == "出金"
+    assert "マイナス" in result.errors[0].reason
+
+
+# --- import_bank_csv: header detection and column names -----------------------
+
+
+def test_preamble_lines_before_header_are_ignored_and_line_numbers_kept():
+    text = (
+        "お取引明細,,\n"
+        "口座: 123-456\n"
+        "\n"
+        "日付,摘要,出金,入金,残高\n"
+        "2026-11-01,電気代,100,,0\n"
+        "2026-11-02,水道,abc,,0\n"
+    )
+    result = import_bank_csv(text)
+    assert [e.amount for e in result.expenses] == [100]
+    assert len(result.errors) == 1
+    assert result.errors[0].line == 6
+    assert result.errors[0].column == "出金"
+
+
+def test_utf8_bom_is_removed_before_header_match():
+    result = import_bank_csv("﻿" + CARD + "2026-11-01,ストア,100,食費\n")
+    assert [e.amount for e in result.expenses] == [100]
+
+
+def test_header_matching_ignores_case_spaces_and_fullwidth_forms():
+    text = " Ｄａｔｅ , 摘 要 ,AMOUNT\n2026-11-01,ストア,100\n"
+    spec = ColumnSpec(date=("date",), memo=("摘要",), amount=("amount",))
+    result = import_bank_csv(text, spec)
+    assert result.expenses == [Expense(date(2026, 11, 1), UNCATEGORIZED, 100, "ストア")]
+
+
+def test_company_specific_column_names_via_spec():
+    spec = ColumnSpec(date=("ご利用日",), amount=("ご利用金額",), memo=("ご利用店名",))
+    text = 'ご利用日,ご利用店名,ご利用金額\n2026-11-01,ストアZ,"2,500"\n'
