+def test_every_bad_row_is_reported_with_line_column_and_value():
+    text = (
+        CARD
+        + "2026-11-01,ストア,100,食費\n"  # line 2 ok
+        + "2026-13-01,ストア,100,食費\n"  # line 3 bad date
+        + "2026-11-03,ストア,1.5,食費\n"  # line 4 bad amount
+        + "2026-11-04,ストア,100\n"  # line 5 too few columns
+        + "2026-11-05,ストア,100,食費,余計\n"  # line 6 extra value
+    )
+    result = import_bank_csv(text)
+    assert [e.amount for e in result.expenses] == [100]
+    assert [(e.line, e.column) for e in result.errors] == [
+        (3, "日付"),
+        (4, "利用金額"),
+        (5, ""),
+        (6, ""),
+    ]
+    assert result.errors[1].value == "1.5"
+    assert result.errors[1].reason == "金額が整数ではありません"
+    assert "列数が足りません" in result.errors[2].reason
+    assert "列数が多すぎます" in result.errors[3].reason
