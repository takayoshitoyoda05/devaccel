+++ b/tests/test_recurring.py
@@ -0,0 +1,183 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, next_due
+
+
+def _series(months, day, category="sub", memo="Netflix", amount=980):
+    return [
+        Expense(date(int(m[:4]), int(m[5:]), day), category, amount, memo)
+        for m in months
+    ]
+
+
+M3 = ["2026-08", "2026-09", "2026-10"]
+SERIES = _series(M3, 5)
+
+
+@pytest.mark.parametrize(
+    "memos, expected",
+    [
+        (["Netflix", "ＮＥＴＦＬＩＸ ", "netflix"], "netflix"),
+        (["  Foo   Bar ", "foo bar", "FOO　BAR"], "foo bar"),
+        (["", "", ""], ""),
+    ],
+)
+def test_d1_memo_normalized(memos, expected):
+    rows = [
+        Expense(date(2026, mo, 5), "sub", 980, memo)
+        for mo, memo in zip((8, 9, 10), memos)
+    ]
+    assert find_recurring(rows) == [
+        Recurring("sub", expected, 980, 5, 3, date(2026, 10, 5), date(2026, 11, 5))
+    ]
+
+
+def test_d2_ignores_nonpositive_amounts():
+    rows = SERIES + [
+        Expense(date(2026, 10, 5), "sub", -980, "Netflix"),  # refund in same month
+        Expense(
+            date(2026, 11, 5), "sub", 0, "Netflix"
+        ),  # 0 yen, still counts for D4c max month
+    ]
+    assert find_recurring(rows) == [
+        Recurring("sub", "netflix", 980, 5, 3, date(2026, 10, 5), date(2026, 11, 5))
+    ]
+
+
+def test_d3_price_change_needs_new_amount_to_repeat():
+    rows = _series(["2026-06", "2026-07", "2026-08"], 5, amount=980) + _series(
+        ["2026-09", "2026-10"], 5, amount=1200
+    )
+    assert find_recurring(rows) == []
+
+
+def test_d4_gap_stops_the_run():
+    rows = _series(["2026-01", "2026-02", "2026-04", "2026-05", "2026-06"], 5)
+    assert find_recurring(rows) == [
+        Recurring("sub", "netflix", 980, 5, 3, date(2026, 6, 5), date(2026, 7, 5))
+    ]
+    assert find_recurring(rows, min_months=4) == []
+
+
+def test_d4b_same_key_twice_in_one_month_is_excluded():
+    rows = SERIES + [Expense(date(2026, 9, 20), "sub", 980, "Netflix")]
+    assert find_recurring(rows) == []
+
+
+@pytest.mark.parametrize(
+    "months, expected_count",
+    [
+        (["2026-06", "2026-07", "2026-08"], 0),  # ends 2 months before max (2026-11)
+        (["2026-08", "2026-09", "2026-10"], 1),  # ends 1 month before max
+    ],
+)
+def test_d4c_cancelled_series_excluded(months, expected_count):
+    rows = _series(months, 5) + [Expense(date(2026, 11, 1), "food", 100)]
+    assert len(find_recurring(rows)) == expected_count
+
+
+def test_d4d_irregular_day_excluded():
+    rows = [
+        Expense(date(2026, 8, 5), "sub", 980, "Netflix"),
+        Expense(date(2026, 9, 5), "sub", 980, "Netflix"),
+        Expense(date(2026, 10, 25), "sub", 980, "Netflix"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_d4d_month_end_rounding_is_regular():
+    rows = [
+        Expense(date(2026, 1, 31), "sub", 980, "Netflix"),
+        Expense(date(2026, 2, 28), "sub", 980, "Netflix"),
+        Expense(date(2026, 3, 31), "sub", 980, "Netflix"),
+    ]
+    assert find_recurring(rows) == [
+        Recurring("sub", "netflix", 980, 31, 3, date(2026, 3, 31), date(2026, 4, 30))
+    ]
+
+
+@pytest.mark.parametrize(
+    "last, anchor, expected",
+    [
+        (date(2026, 1, 31), 31, date(2026, 2, 28)),
+        (date(2024, 1, 31), 31, date(2024, 2, 29)),  # leap year
+        (date(2025, 12, 5), 5, date(2026, 1, 5)),  # year rollover
+    ],
+)
+def test_d5_next_due_clamps_to_month_end(last, anchor, expected):
+    assert next_due(last, anchor) == expected
+
+
+@pytest.mark.parametrize("anchor", [0, 32])
+def test_d5_next_due_rejects_bad_anchor(anchor):
+    with pytest.raises(ValueError):
+        next_due(date(2026, 1, 31), anchor)
+
+
+def test_d6_sorted_by_next_date_then_category_then_memo():
+    rows = (
+        _series(M3, 5, category="b", memo="")
+        + _series(M3, 5, category="a", memo="y")
+        + _series(M3, 5, category="a", memo="w")
+        + _series(M3, 20, category="z", memo="")
+    )
+    result = find_recurring(rows)
+    assert [(r.category, r.memo) for r in result] == [
+        ("a", "w"),
+        ("a", "y"),
+        ("b", ""),
+        ("z", ""),
+    ]
+
+
+def test_d6_empty_rows_returns_empty_list():
+    assert find_recurring([]) == []
+
+
+def test_d7_different_memo_is_separate_series():
+    rows = _series(M3, 5, memo="A") + _series(M3, 5, memo="B")
+    result = find_recurring(rows)
+    assert [r.memo for r in result] == ["a", "b"]
+
+
+@pytest.mark.parametrize(
+    "kw",
+    [
+        {"min_months": True},
+        {"min_months": 3.0},
+        {"min_months": "3"},
+        {"min_months": None},
+        {"day_tolerance": False},
+        {"day_tolerance": 3.0},
+        {"day_tolerance": None},
+    ],
+)
+def test_args_must_be_int(kw):
+    with pytest.raises(TypeError):
+        find_recurring(SERIES, **kw)
+
+
+@pytest.mark.parametrize(
+    "kw, name",
+    [
+        ({"min_months": 1}, "min_months"),
+        ({"day_tolerance": -1}, "day_tolerance"),
+    ],
+)
+def test_args_out_of_range(kw, name):
+    with pytest.raises(ValueError, match=name):
+        find_recurring(SERIES, **kw)
+
+
+def test_d5_anchor_is_max_day_and_year_rollover():
+    rows = [
+        Expense(date(2026, 10, 30), "rent", 70000, "rent"),
+        Expense(date(2026, 11, 28), "rent", 70000, "rent"),
+        Expense(date(2026, 12, 31), "rent", 70000, "rent"),
+    ]
+    assert find_recurring(rows) == [
+        Recurring("rent", "rent", 70000, 31, 3, date(2026, 12, 31), date(2027, 1, 31))
+    ]
