@@ -0,0 +1,91 @@
+"""Month-over-month change of per-category spending (pure functions).
+
+Reuses ``core.monthly_totals`` for the per-month, per-category sums.
+
+Decisions:
+D1: Input is ``list[Expense]``; empty input gives ``[]``.
+D2: Months with no data between the first and last month are filled as empty
+    months (every category 0), so a category present in Jan and absent in Feb
+    is "gone" in Feb, and "new" again if it returns in Mar.
+D3: The first month is compared with an empty month, so all its categories
+    are "new".
+D4: Status is decided by presence of the category key, not by amount:
+    new (only this month), gone (only previous month), up, down, flat.
+    A category whose refunds net to 0 is still present.
+D5: ``delta`` = current - previous (a missing side counts as 0). ``pct`` is
+    ``delta / previous * 100`` and is ``None`` when previous <= 0 (new, or a
+    zero/negative base) to avoid dividing by zero.
+D6: Within a month, changes are sorted by ``abs(delta)`` descending, then by
+    category name ascending (deterministic for ties).
+D7: Negative amounts (refunds) are summed as they are, like ``core``.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Literal
+
+from kakeibo.core import Expense, monthly_totals
+
+Status = Literal["new", "gone", "up", "down", "flat"]
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    pct: float | None
+    status: Status
+
+
+@dataclass(frozen=True)
+class MonthTrend:
+    month: str  # "YYYY-MM"
+    changes: tuple[CategoryChange, ...]
+
+
+def _next_month(month: str) -> str:
+    y, m = int(month[:4]), int(month[5:7])
+    y, m = (y + 1, 1) if m == 12 else (y, m + 1)
+    return f"{y:04d}-{m:02d}"
+
+
+def _classify(cat: str, prev: dict[str, int], cur: dict[str, int]) -> CategoryChange:
+    p = prev.get(cat, 0)
+    c = cur.get(cat, 0)
+    delta = c - p
+    status: Status
+    if cat not in prev:
+        status = "new"
+    elif cat not in cur:
+        status = "gone"
+    elif delta > 0:
+        status = "up"
+    elif delta < 0:
+        status = "down"
+    else:
+        status = "flat"
+    pct = delta / p * 100 if p > 0 else None
+    return CategoryChange(cat, p, c, delta, pct, status)
+
+
+def month_over_month(rows: list[Expense]) -> list[MonthTrend]:
+    """Per-month category changes against the previous calendar month."""
+    totals = monthly_totals(rows)
+    if not totals:
+        return []
+    months = sorted(totals)
+    out: list[MonthTrend] = []
+    prev: dict[str, int] = {}
+    month = months[0]
+    while month <= months[-1]:
+        cur = totals.get(month, {})
+        cats = sorted(set(prev) | set(cur))
+        changes = [_classify(c, prev, cur) for c in cats]
+        changes.sort(key=lambda ch: (-abs(ch.delta), ch.category))
+        out.append(MonthTrend(month, tuple(changes)))
+        prev = cur
+        month = _next_month(month)
+    return out
diff --git a/tests/test_trend.py b/tests/test_trend.py
new file mode 100644
index 0000000..4493484
--- /dev/null
+++ b/tests/test_trend.py
@@ -0,0 +1,100 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.trend import month_over_month
+
+
+def e(d: str, cat: str, amount: int) -> Expense:
+    return Expense(date.fromisoformat(d), cat, amount)
+
+
+def by_cat(trend, month):  # type: ignore[no-untyped-def]
+    t = next(t for t in trend if t.month == month)
+    return {c.category: c for c in t.changes}
+
+
+def test_empty():
+    assert month_over_month([]) == []
+
+
+def test_first_month_all_new():
+    r = month_over_month([e("2026-01-05", "食費", 1000)])
+    ch = by_cat(r, "2026-01")["食費"]
+    assert (ch.status, ch.previous, ch.current, ch.delta, ch.pct) == (
+        "new",
+        0,
+        1000,
+        1000,
+        None,
+    )
+
+
+def test_up_down_flat_new_gone():
+    rows = [
+        e("2026-01-01", "食費", 1000),
+        e("2026-01-02", "家賃", 5000),
+        e("2026-01-03", "交通", 400),
+        e("2026-01-04", "娯楽", 300),
+        e("2026-02-01", "食費", 1500),
+        e("2026-02-02", "家賃", 5000),
+        e("2026-02-03", "交通", 100),
+        e("2026-02-04", "日用品", 700),
+    ]
+    c = by_cat(month_over_month(rows), "2026-02")
+    assert c["食費"].status == "up" and c["食費"].delta == 500 and c["食費"].pct == 50.0
+    assert c["家賃"].status == "flat" and c["家賃"].delta == 0
+    assert c["交通"].status == "down" and c["交通"].delta == -300
+    assert c["日用品"].status == "new" and c["日用品"].pct is None
+    assert c["娯楽"].status == "gone"
+    assert (c["娯楽"].current, c["娯楽"].delta, c["娯楽"].pct) == (0, -300, -100.0)
+
+
+def test_missing_month_is_empty_month():
+    rows = [e("2026-01-01", "食費", 100), e("2026-03-01", "食費", 100)]
+    r = month_over_month(rows)
+    assert [t.month for t in r] == ["2026-01", "2026-02", "2026-03"]
+    assert by_cat(r, "2026-02")["食費"].status == "gone"
+    assert by_cat(r, "2026-03")["食費"].status == "new"
+
+
+def test_year_boundary():
+    rows = [e("2025-12-31", "食費", 100), e("2026-01-01", "食費", 200)]
+    r = month_over_month(rows)
+    assert [t.month for t in r] == ["2025-12", "2026-01"]
+    assert by_cat(r, "2026-01")["食費"].status == "up"
+
+
+def test_zero_net_category_is_present_not_gone():
+    rows = [
+        e("2026-01-01", "食費", 100),
+        e("2026-02-01", "食費", 500),
+        e("2026-02-02", "食費", -500),
+        e("2026-03-01", "食費", 100),
+    ]
+    r = month_over_month(rows)
+    feb = by_cat(r, "2026-02")["食費"]
+    assert feb.status == "down" and feb.current == 0
+    mar = by_cat(r, "2026-03")["食費"]
+    assert mar.status == "up" and mar.pct is None  # previous == 0
+
+
+def test_order_abs_delta_desc_then_name():
+    rows = [
+        e("2026-01-01", "b", 100),
+        e("2026-01-02", "a", 100),
+        e("2026-01-03", "c", 100),
+        e("2026-02-01", "b", 200),
+        e("2026-02-02", "a", 200),
+        e("2026-02-03", "c", 0),
+    ]
+    # c: delta -100 (present, flat->down), a/b: +100 tie -> name order
+    r = month_over_month(rows)
+    feb = next(t for t in r if t.month == "2026-02")
+    assert [c.category for c in feb.changes] == ["a", "b", "c"]
+
+
+def test_input_order_irrelevant():
+    rows = [e("2026-02-01", "x", 5), e("2026-01-01", "x", 3)]
+    r = month_over_month(rows)
+    assert [t.month for t in r] == ["2026-01", "2026-02"]
+    assert by_cat(r, "2026-02")["x"].delta == 2
