+from datetime import date
+
+from kakeibo.account_report import (
+    AccountMonth,
+    format_account_report,
+    monthly_account_report,
+)
+from kakeibo.core import Expense
+
+
+def ex(d: date, amount: int, account: str = "cash", to: str = "") -> Expense:
+    return Expense(
+        day=d, category="food", amount=amount, account=account, transfer_to=to
+    )
+
+
+NOV = date(2026, 11, 1)
+
+
+def test_e4_1_expense_and_income_split() -> None:
+    r = monthly_account_report([ex(NOV, 100), ex(NOV, -50)])
+    m = r["2026-11"]["cash"]
+    assert (m.expense, m.income, m.net) == (100, 50, -50)
+
+
+def test_e4_2_transfer_not_expense() -> None:
+    r = monthly_account_report([ex(NOV, 300, "cash", "bank")])["2026-11"]
+    assert r["cash"] == AccountMonth(transfer_out=300)
+    assert r["cash"].net == -300
+    assert r["bank"] == AccountMonth(transfer_in=300)
+    assert r["bank"].net == 300
+
+
+def test_e4_3_format_line() -> None:
+    rep = {"2026-11": {"cash": AccountMonth(100, 50, 0, 0)}}
+    assert format_account_report(rep) == ["2026-11\tcash\t100\t50\t0\t0\t-50"]
+
+
+def test_e4_4_empty_month_absent() -> None:
+    r = monthly_account_report([ex(date(2026, 10, 5), 1), ex(date(2026, 12, 5), 1)])
+    assert list(r) == ["2026-10", "2026-12"]
+    assert "2026-11" not in r
+
+
+def test_empty() -> None:
+    assert monthly_account_report([]) == {}
+    assert format_account_report({}) == []
+
+
+def test_zero_amount_ignored() -> None:
+    assert monthly_account_report([ex(NOV, 0)]) == {}
+    r = monthly_account_report([ex(NOV, 0, "bank"), ex(NOV, 5, "cash")])
+    assert list(r["2026-11"]) == ["cash"]
+
+
+def test_ordering() -> None:
+    rows = [
+        ex(date(2026, 12, 1), 1, "bank"),
+        ex(NOV, 1, "zeta"),
+        ex(NOV, 1, "alpha"),
+        ex(date(2026, 10, 1), 1, "bank"),
+    ]
+    r = monthly_account_report(rows)
+    assert list(r) == ["2026-10", "2026-11", "2026-12"]
+    assert list(r["2026-11"]) == ["alpha", "zeta"]
+    lines = format_account_report(r)
+    assert [ln.split("\t")[:2] for ln in lines] == [
+        ["2026-10", "bank"],
+        ["2026-11", "alpha"],
+        ["2026-11", "zeta"],
+        ["2026-12", "bank"],
+    ]
+
+
+def test_accumulates() -> None:
+    r = monthly_account_report([ex(NOV, 10), ex(date(2026, 11, 30), 20)])
+    assert r["2026-11"]["cash"].expense == 30
