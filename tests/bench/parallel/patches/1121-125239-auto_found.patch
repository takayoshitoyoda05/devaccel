@@ -0,0 +1,72 @@
+"""Tests for kakeibo.opening.load_opening (D1-D4)."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from kakeibo.opening import OpeningError, load_opening
+
+
+def _write(tmp_path: Path, text: str) -> Path:
+    p = tmp_path / "opening.json"
+    p.write_text(text, encoding="utf-8")
+    return p
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        # E1-1: 負の残高を受ける (D1)
+        pytest.param(
+            '{"cash": 1000, "card": -500}', {"cash": 1000, "card": -500}, id="E1-1"
+        ),
+        # 0 も受ける (D1)
+        pytest.param('{"cash": 0}', {"cash": 0}, id="zero"),
+        # 空オブジェクト
+        pytest.param("{}", {}, id="empty"),
+        # D4: 前後の空白は除く
+        pytest.param('{" a ": 1}', {"a": 1}, id="strip-name"),
+    ],
+)
+def test_valid_files(tmp_path: Path, text: str, expected: dict[str, int]) -> None:
+    assert load_opening(_write(tmp_path, text)) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        # E1-2: float 拒否 (D2)
+        pytest.param('{"cash": 1.0}', id="E1-2"),
+        # E1-3: bool 拒否 (D2)
+        pytest.param('{"a": true}', id="E1-3"),
+        # E1-4: strip 後の重複 (D4)
+        pytest.param('{" a ": 1, "a": 2}', id="E1-4"),
+        # D2: str / null も拒否
+        pytest.param('{"cash": "100"}', id="str"),
+        pytest.param('{"cash": null}', id="null"),
