@@ -0,0 +1,61 @@
+"""月次の口座別レポート。
+
+D1: 月は行の日付の "YYYY-MM"。行のある月だけ出す(空の月は出さない)。月昇順、口座は名前昇順。
+D2: 非振替で amount > 0 は expense に、amount < 0 は income(-amount の正の値)に足す。amount == 0 はどちらにも足さない。
+D3: 振替は元の口座の transfer_out、先の口座の transfer_in に amount を足す。expense には数えない。
+D4: net = income + transfer_in - expense - transfer_out(その月の残高の増減)。
+D5: その月にその口座の動きが無ければ、その月のその口座は出さない(0 行を作らない)。
+D6: format_account_report の各行は
+    "YYYY-MM\\t口座\\texpense\\tincome\\ttransfer_in\\ttransfer_out\\tnet"(桁区切り無しの整数)。
+    月昇順、同月は口座名昇順。レポートが空なら []。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class AccountMonth:
+    expense: int = 0
+    income: int = 0
+    transfer_in: int = 0
+    transfer_out: int = 0
+
+    @property
+    def net(self) -> int:
+        return self.income + self.transfer_in - self.expense - self.transfer_out
+
+
+def monthly_account_report(rows: list[Expense]) -> dict[str, dict[str, AccountMonth]]:
+    """{"YYYY-MM": {口座: AccountMonth}}(月昇順・口座名昇順)。"""
+    acc: dict[str, dict[str, list[int]]] = {}
+    for e in rows:
+        month = e.day.strftime("%Y-%m")
+        if e.is_transfer:
+            moves = [(e.account, 3, e.amount), (e.transfer_to, 2, e.amount)]
+        elif e.amount > 0:
+            moves = [(e.account, 0, e.amount)]
+        elif e.amount < 0:
+            moves = [(e.account, 1, -e.amount)]
+        else:
+            moves = []
+        for account, idx, yen in moves:
+            acc.setdefault(month, {}).setdefault(account, [0, 0, 0, 0])[idx] += yen
+    return {
+        m: {a: AccountMonth(*acc[m][a]) for a in sorted(acc[m])} for m in sorted(acc)
+    }
+
+
+def format_account_report(report: dict[str, dict[str, AccountMonth]]) -> list[str]:
+    """タブ区切りの行リストにする。"""
+    out: list[str] = []
+    for m in sorted(report):
+        for a in sorted(report[m]):
+            r = report[m][a]
+            out.append(
+                f"{m}\t{a}\t{r.expense}\t{r.income}\t{r.transfer_in}\t{r.transfer_out}\t{r.net}"
+            )
+    return out
