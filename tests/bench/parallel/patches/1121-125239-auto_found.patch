+
+def _e(account: str, transfer_to: str = "", amount: int = 100) -> Expense:
+    return Expense(
+        day=date(2026, 11, 1),
+        category="food",
+        amount=amount,
+        account=account,
+        transfer_to=transfer_to,
+    )
+
+
+# --- filter_by_account ---
+
+
+@pytest.mark.parametrize(
+    ("rows", "name", "expected_idx"),
+    [
+        # E2-1: 振替 cash→bank の 1 行。振替先でも一致する。
+        pytest.param(
+            [_e("cash", transfer_to="bank", amount=500)],
+            "bank",
+            [0],
+            id="E2-1",
+        ),
+        # E2-2: 大文字小文字を区別する。
+        pytest.param([_e("bank")], "Bank", [], id="E2-2"),
+    ],
+)
+def test_filter_examples(rows, name, expected_idx):
+    result = filter_by_account(rows, name)
+    assert result == [rows[i] for i in expected_idx]
+
+
+def test_filter_matches_transfer_source_and_destination():
+    t = _e("cash", transfer_to="bank", amount=500)
+    rows = [t]
+    assert filter_by_account(rows, "cash") == [t]
+    assert filter_by_account(rows, "bank") == [t]
+
+
+def test_filter_empty_rows_returns_empty_list():
+    assert filter_by_account([], "cash") == []
+
+
+def test_filter_no_match_returns_empty_list():
+    assert filter_by_account([_e("cash")], "bank") == []
+
+
+def test_filter_is_case_sensitive():
+    assert filter_by_account([_e("bank")], "BANK") == []
+
+
+def test_filter_distinguishes_fullwidth_and_halfwidth():
+    assert filter_by_account([_e("ｂａｎｋ")], "bank") == []
+    assert filter_by_account([_e("bank")], "ｂａｎｋ") == []
+
+
+def test_filter_strips_surrounding_whitespace_of_name():
+    rows = [_e("bank")]
+    assert filter_by_account(rows, "  bank \t") == rows
+
+
+def test_filter_keeps_original_order():
+    a = _e("cash", amount=1)
+    b = _e("bank", amount=2)
+    c = _e("cash", transfer_to="bank", amount=3)
+    d = _e("cash", amount=4)
+    rows = [a, b, c, d]
+    assert filter_by_account(rows, "cash") == [a, c, d]
+    assert filter_by_account(rows, "bank") == [b, c]
+
+
+def test_filter_does_not_mutate_input():
+    rows = [_e("cash"), _e("bank"), _e("cash", transfer_to="bank")]
+    before = copy.deepcopy(rows)
+    filter_by_account(rows, "bank")
+    assert rows == before
+
+
+@pytest.mark.parametrize("name", [None, 1, b"bank"])
+def test_filter_non_str_name_raises_type_error(name):
+    with pytest.raises(TypeError):
+        filter_by_account([_e("bank")], name)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("name", ["", "   ", "\t"])
+def test_filter_blank_name_raises_value_error(name):
+    with pytest.raises(ValueError):
+        filter_by_account([_e("bank")], name)
+
+
+# --- list_accounts ---
+
+
+def test_list_accounts_example_includes_transfer_destination_sorted():
+    # E2-3: 口座 b, a、振替先 c
+    rows = [_e("b"), _e("a"), _e("b", transfer_to="c")]
+    assert list_accounts(rows) == ["a", "b", "c"]
+
+
+def test_list_accounts_empty_rows():
+    assert list_accounts([]) == []
+
+
+def test_list_accounts_deduplicates():
+    rows = [_e("bank"), _e("bank"), _e("cash", transfer_to="bank")]
+    assert list_accounts(rows) == ["bank", "cash"]
+
+
+def test_list_accounts_excludes_empty_transfer_to():
+    # 振替でない行の transfer_to("")は口座として数えない。
+    assert list_accounts([_e("cash")]) == ["cash"]
+
+
+def test_list_accounts_does_not_mutate_input():
+    rows = [_e("b"), _e("a", transfer_to="c")]
+    before = copy.deepcopy(rows)
+    list_accounts(rows)
+    assert rows == before
