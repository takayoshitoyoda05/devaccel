+from datetime import date
+
+import pytest
+
+from kakeibo.core import (
+    DEFAULT_ACCOUNT,
+    CsvError,
+    Expense,
+    effects,
+    load_csv,
+    monthly_totals,
+    total_by_category,
+)
+
+
+def _write(tmp_path, text):
+    p = tmp_path / "in.csv"
+    p.write_text(text, encoding="utf-8")
+    return p
+
+
+def test_legacy_csv_without_account_column(tmp_path):
+    rows = load_csv(
+        _write(tmp_path, "date,category,amount,memo\n2026-11-01,food,100,x\n")
+    )
+    assert rows[0].account == DEFAULT_ACCOUNT
+    assert rows[0].transfer_to == ""
+    assert not rows[0].is_transfer
+
+
+def test_blank_account_is_default_and_stripped(tmp_path):
+    rows = load_csv(
+        _write(
+            tmp_path,
+            "date,category,amount,memo,account\n"
+            "2026-11-01,food,100,,\n2026-11-02,food,100,, cash \n",
+        )
+    )
+    assert [r.account for r in rows] == [DEFAULT_ACCOUNT, "cash"]
+
+
+def test_transfer_row_parsed(tmp_path):
+    rows = load_csv(
+        _write(
+            tmp_path,
+            "date,category,amount,memo,account,transfer_to\n"
+            "2026-11-01,transfer,5000,,bank,cash\n",
+        )
+    )
+    assert (
+        rows[0].is_transfer
+        and rows[0].account == "bank"
+        and rows[0].transfer_to == "cash"
+    )
+
+
+@pytest.mark.parametrize(
+    "row",
+    ["2026-11-01,t,0,,a,b", "2026-11-01,t,-5,,a,b", "2026-11-01,t,5,,a,a"],
+)
+def test_bad_transfer_rejected(tmp_path, row):
+    p = _write(tmp_path, "date,category,amount,memo,account,transfer_to\n" + row + "\n")
+    with pytest.raises(CsvError):
+        load_csv(p)
+
+
+def test_transfers_not_counted_as_spending():
+    rows = [
+        Expense(date(2026, 11, 1), "food", 100, account="cash"),
+        Expense(
+            date(2026, 11, 2), "transfer", 5000, account="bank", transfer_to="cash"
+        ),
+    ]
+    assert total_by_category(rows) == {"food": 100}
+    assert monthly_totals(rows) == {"2026-11": {"food": 100}}
+    only_transfer = rows[1:]
+    assert total_by_category(only_transfer) == {}
+    assert monthly_totals(only_transfer) == {}
+
+
+def test_effects():
+    spend = Expense(date(2026, 11, 1), "food", 100, account="cash")
+    income = Expense(date(2026, 11, 1), "salary", -300, account="bank")
+    move = Expense(date(2026, 11, 1), "t", 50, account="bank", transfer_to="cash")
+    assert effects(spend) == [("cash", -100)]
+    assert effects(income) == [("bank", 300)]
+    assert effects(move) == [("bank", -50), ("cash", 50)]
