+++ b/src/kakeibo/account_filter.py
@@ -0,0 +1,32 @@
+"""口座での絞り込みと口座一覧。
+
+D1: 口座名の一致は完全一致(大文字小文字・全角半角を区別。前後の空白は引数側のみ除く)。
+D2: 振替は元・先のどちらの口座でも一致する(account == name または transfer_to == name)。
+D3: 絞り込みは元の並びを保つ。一致なしは空リスト(例外にしない)。
+D4: name が str でなければ TypeError、strip 後に空なら ValueError。
+D5: list_accounts は account と transfer_to に現れる全口座の昇順・重複なしのリスト。
+"""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def list_accounts(rows: list[Expense]) -> list[str]:
+    """行に現れる口座名(振替先を含む)を昇順・重複なしで返す。"""
+    names: set[str] = set()
+    for e in rows:
+        names.add(e.account)
+        if e.is_transfer:
+            names.add(e.transfer_to)
+    return sorted(names)
+
+
+def filter_by_account(rows: list[Expense], name: str) -> list[Expense]:
+    """name の口座に関係する行(振替は元・先どちらでも)を元の順で返す。"""
+    if not isinstance(name, str):
+        raise TypeError(f"口座名は str である必要があります: {type(name).__name__}")
+    key = name.strip()
+    if not key:
+        raise ValueError("口座名が空です")
+    return [e for e in rows if e.account == key or e.transfer_to == key]
