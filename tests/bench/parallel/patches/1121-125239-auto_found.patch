index 0000000..c7b97d0
--- /dev/null
+++ b/src/kakeibo/opening.py
@@ -0,0 +1,43 @@
+"""口座の開始残高ファイル(JSON)の読込。
+
+形式: {"cash": 10000, "bank": 250000, "card": -30000}(口座名 → 円の整数)。
+
+D1: 負の残高(カードの未払い)を受ける。0 も受ける。
+D2: bool・float(1.0 含む)・str・None は拒否(OpeningError)。
+D3: 最上位がオブジェクトでない、ファイルが無い/読めない、不正 JSON は OpeningError。
+D4: 口座名は前後の空白を除く。空名は OpeningError。除いた結果が重複したら OpeningError。
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+
+class OpeningError(ValueError):
+    """Raised when the opening-balance file is missing or invalid."""
+
+
+def load_opening(path: Path) -> dict[str, int]:
+    """開始残高ファイルを {口座: 円} で返す。"""
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+    except OSError as e:
+        raise OpeningError(
+            f"開始残高ファイルを読めません: {e.strerror}: {path}"
+        ) from None
+    except ValueError as e:
+        raise OpeningError(f"開始残高ファイルが不正な JSON です: {e}") from None
+    if not isinstance(data, dict):
+        raise OpeningError("開始残高ファイルの最上位はオブジェクトである必要があります")
+    out: dict[str, int] = {}
+    for raw_name, yen in data.items():
+        name = raw_name.strip()
+        if not name:
+            raise OpeningError("開始残高の口座名が空です")
+        if isinstance(yen, bool) or not isinstance(yen, int):
+            raise OpeningError(f"開始残高 {name} は整数である必要があります: {yen!r}")
+        if name in out:
+            raise OpeningError(f"開始残高の口座名が重複しています: {name!r}")
+        out[name] = yen
+    return out
