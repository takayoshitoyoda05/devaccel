+from __future__ import annotations
+
+import copy
+from datetime import date
+
+import pytest
+
+from kakeibo.balances import balance_history, final_balances
+from kakeibo.core import Expense
+
+NOV1 = date(2026, 11, 1)
+NOV3 = date(2026, 11, 3)
+
+
+def _exp(
+    day: date,
+    amount: int,
+    account: str = "cash",
+    transfer_to: str = "",
+    category: str = "food",
+) -> Expense:
+    return Expense(
+        day=day,
+        category=category,
+        amount=amount,
+        account=account,
+        transfer_to=transfer_to,
+    )
+
+
+# --- 表 E3 ---
+
+
+@pytest.mark.parametrize(
+    ("rows", "opening", "expected"),
+    [
+        pytest.param(
+            [_exp(NOV1, 300)],
+            {"cash": 1000},
+            [(NOV1, {"cash": 700})],
+            id="E3-1",
+        ),
+    ],
+)
+def test_E3_1_history_spending_reduces_balance(rows, opening, expected) -> None:
+    assert balance_history(rows, opening) == expected
+
+
+def test_E3_2_final_transfer_moves_money_between_accounts() -> None:
+    rows = [_exp(NOV1, 500, account="cash", transfer_to="bank")]
+    assert final_balances(rows) == {"bank": 500, "cash": -500}
+
+
+def test_E3_3_history_carries_untouched_account_forward() -> None:
+    rows = [
+        _exp(NOV1, 100, account="cash"),
+        _exp(NOV3, -200, account="bank"),
+    ]
+    history = balance_history(rows)
+    assert history == [
+        (NOV1, {"bank": 0, "cash": -100}),
+        (NOV3, {"bank": 200, "cash": -100}),
+    ]
+
+
+def test_E3_4_same_day_rows_make_one_element() -> None:
+    rows = [_exp(NOV1, 100), _exp(NOV1, 200)]
+    history = balance_history(rows, {"cash": 1000})
+    assert history == [(NOV1, {"cash": 700})]
+
+
+# --- 空 rows ---
+
+
+def test_empty_rows_history_is_empty_with_opening() -> None:
+    assert balance_history([], {"cash": 1000}) == []
+
+
+def test_empty_rows_history_is_empty_without_opening() -> None:
+    assert balance_history([]) == []
+
+
+def test_empty_rows_final_is_opening_copy() -> None:
+    assert final_balances([], {"bank": 5, "cash": 1000}) == {"bank": 5, "cash": 1000}
+
+
+def test_empty_rows_final_without_opening_is_empty() -> None:
+    assert final_balances([]) == {}
+    assert final_balances([], None) == {}
+
+
+# --- 口座の扱い ---
+
+
+def test_opening_account_without_rows_appears_in_history() -> None:
+    rows = [_exp(NOV1, 300, account="cash")]
+    history = balance_history(rows, {"cash": 1000, "bank": 50})
+    assert history == [(NOV1, {"bank": 50, "cash": 700})]
+
+
+def test_opening_account_without_rows_appears_in_final() -> None:
+    rows = [_exp(NOV1, 300, account="cash")]
+    assert final_balances(rows, {"cash": 1000, "bank": 50}) == {"bank": 50, "cash": 700}
+
+
+def test_transfer_only_destination_counts_from_zero() -> None:
+    rows = [_exp(NOV1, 200, account="cash", transfer_to="card")]
+    assert final_balances(rows, {"cash": 1000}) == {"card": 200, "cash": 800}
+
+
+# --- 入力を変更しない ---
+
+
+def test_inputs_are_not_mutated() -> None:
+    rows = [
+        _exp(NOV3, 100, account="cash"),
+        _exp(NOV1, 50, account="cash", transfer_to="bank"),
+    ]
+    opening = {"cash": 1000}
+    rows_before = copy.deepcopy(rows)
+    opening_before = copy.deepcopy(opening)
+    balance_history(rows, opening)
+    final_balances(rows, opening)
+    assert rows == rows_before
+    assert opening == opening_before
+
+
+# --- 並び順 ---
+
+
+def test_history_is_sorted_by_date_even_when_input_is_unsorted() -> None:
+    rows = [_exp(NOV3, 100), _exp(NOV1, 200)]
+    history = balance_history(rows, {"cash": 1000})
+    assert [d for d, _ in history] == [NOV1, NOV3]
+    assert history == [(NOV1, {"cash": 800}), (NOV3, {"cash": 700})]
+
+
+def test_final_keys_are_sorted_by_account_name() -> None:
+    rows = [_exp(NOV1, 100, account="zeta"), _exp(NOV1, 100, account="alpha")]
+    assert list(final_balances(rows)) == ["alpha", "zeta"]
+
+
+def test_history_keys_are_sorted_by_account_name() -> None:
+    rows = [_exp(NOV1, 100, account="zeta"), _exp(NOV1, 100, account="alpha")]
+    ((_, balances),) = balance_history(rows)
+    assert list(balances) == ["alpha", "zeta"]
