@@ -0,0 +1,57 @@
+"""口座ごとの残高と推移。残高への影響は kakeibo.core.effects を使う(二重に持たない)。
+
+D1: 残高 = 開始残高(opening、無ければ 0) + 各行の effects の合計。
+D2: 開始残高に無い口座は 0 から始まる。振替先にだけ現れる口座も口座として数える。
+D3: balance_history は行のある日ごとに 1 要素(日付昇順)。値はその日の終わりの
+    全口座(opening の口座 + 行に現れる口座)の残高で、口座名昇順の dict。
+    動きの無い口座も前日の残高を持ち越す。同じ日の複数行は 1 要素にまとめる。
+D4: 行が空なら balance_history は []、final_balances は opening のコピー(無ければ {})。
+D5: final_balances は口座名昇順の dict。残高は負になってよい(拒否しない)。
+D6: 入力の rows・opening を変更しない。
+"""
+
+from __future__ import annotations
+
+from datetime import date
+
+from kakeibo.core import Expense, effects
+
+
+def _all_accounts(rows: list[Expense], opening: dict[str, int]) -> set[str]:
+    accounts = set(opening)
+    for e in rows:
+        accounts.update(acc for acc, _ in effects(e))
+    return accounts
+
+
+def _start(rows: list[Expense], opening: dict[str, int] | None) -> dict[str, int]:
+    opening = opening or {}
+    return {acc: opening.get(acc, 0) for acc in _all_accounts(rows, opening)}
+
+
+def balance_history(
+    rows: list[Expense], opening: dict[str, int] | None = None
+) -> list[tuple[date, dict[str, int]]]:
+    """[(日付, {口座: その日終了時の残高})] を日付昇順で返す。"""
+    by_day: dict[date, list[Expense]] = {}
+    for e in rows:
+        by_day.setdefault(e.day, []).append(e)
+    current = _start(rows, opening)
+    out: list[tuple[date, dict[str, int]]] = []
+    for day in sorted(by_day):
+        for e in by_day[day]:
+            for acc, delta in effects(e):
+                current[acc] += delta
+        out.append((day, dict(sorted(current.items()))))
+    return out
+
+
+def final_balances(
+    rows: list[Expense], opening: dict[str, int] | None = None
+) -> dict[str, int]:
+    """全行を反映した後の {口座: 残高}(口座名昇順)。"""
+    current = _start(rows, opening)
+    for e in rows:
+        for acc, delta in effects(e):
+            current[acc] += delta
+    return dict(sorted(current.items()))
