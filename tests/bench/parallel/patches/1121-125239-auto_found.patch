+import json
+
+from kakeibo import main
+
+HEADER = "date,category,amount,memo,account,transfer_to\n"
+BODY = (
+    "2026-10-31,salary,-100000,,bank,\n"
+    "2026-11-01,food,1200,lunch,cash,\n"
+    "2026-11-02,transfer,5000,atm,bank,cash\n"
+    "2026-11-03,food,800,coffee,card,\n"
+)
+
+
+def _csv(tmp_path, text=HEADER + BODY):
+    p = tmp_path / "in.csv"
+    p.write_text(text, encoding="utf-8")
+    return p
+
+
+def _run(monkeypatch, capsys, *argv):
+    monkeypatch.setattr("sys.argv", ["kakeibo", *map(str, argv)])
+    try:
+        main()
+        code = 0
+    except SystemExit as e:
+        code = e.code
+    out = capsys.readouterr()
+    return code, out.out, out.err
+
+
+def test_legacy_csv_unchanged(tmp_path, monkeypatch, capsys):
+    p = tmp_path / "old.csv"
+    p.write_text(
+        "date,category,amount,memo\n2026-11-01,food,100,\n2026-11-02,rent,900,\n"
+    )
+    code, out, _ = _run(monkeypatch, capsys, p, "--total")
+    assert code == 0
+    assert out == "rent\t900\nfood\t100\nTOTAL\t1,000\n"
+
+
+def test_transfer_not_in_default_output(tmp_path, monkeypatch, capsys):
+    _, out, _ = _run(monkeypatch, capsys, _csv(tmp_path), "--total")
+    assert "transfer" not in out
+    assert "TOTAL\t-98,000" in out
+
+
+def test_account_filter_default_output(tmp_path, monkeypatch, capsys):
+    code, out, _ = _run(monkeypatch, capsys, _csv(tmp_path), "--account", "cash")
+    assert code == 0
+    assert out == "food\t1,200\n"
+
+
+def test_account_filter_unknown(tmp_path, monkeypatch, capsys):
+    code, out, err = _run(monkeypatch, capsys, _csv(tmp_path), "--account", "nope")
+    assert code == 0 and out == ""
+    assert "nope" in err
+
+
+def test_account_filter_empty_name(tmp_path, monkeypatch, capsys):
+    code, _, err = _run(monkeypatch, capsys, _csv(tmp_path), "--account", " ")
+    assert code == 2 and "--account" in err
+
+
+def test_accounts_report(tmp_path, monkeypatch, capsys):
+    code, out, _ = _run(monkeypatch, capsys, _csv(tmp_path), "--accounts-report")
+    assert code == 0
+    assert out.splitlines() == [
+        "2026-10\tbank\t0\t100000\t0\t0\t100000",
+        "2026-11\tbank\t0\t0\t0\t5000\t-5000",
+        "2026-11\tcard\t800\t0\t0\t0\t-800",
+        "2026-11\tcash\t1200\t0\t5000\t0\t3800",
+    ]
+
+
+def test_accounts_report_filtered(tmp_path, monkeypatch, capsys):
+    _, out, _ = _run(
+        monkeypatch, capsys, _csv(tmp_path), "--accounts-report", "--account", "cash"
+    )
+    assert out.splitlines() == ["2026-11\tcash\t1200\t0\t5000\t0\t3800"]
+
+
+def test_balances_with_opening(tmp_path, monkeypatch, capsys):
+    op = tmp_path / "open.json"
+    op.write_text(json.dumps({"cash": 1000, "card": -500}))
+    code, out, _ = _run(
+        monkeypatch,
+        capsys,
+        _csv(tmp_path),
+        "--balances",
+        "--opening",
+        op,
+        "--account",
+        "cash",
+    )
+    assert code == 0
+    assert out.splitlines() == [
+        "2026-10-31\tcash\t1000",
+        "2026-11-01\tcash\t-200",
+        "2026-11-02\tcash\t4800",
+        "2026-11-03\tcash\t4800",
+    ]
+
+
+def test_balances_all_accounts_last_day(tmp_path, monkeypatch, capsys):
+    _, out, _ = _run(monkeypatch, capsys, _csv(tmp_path), "--balances")
+    last = [ln for ln in out.splitlines() if ln.startswith("2026-11-03")]
+    assert last == [
+        "2026-11-03\tbank\t95000",
+        "2026-11-03\tcard\t-800",
+        "2026-11-03\tcash\t3800",
+    ]
+
+
+def test_bad_opening_exits_2(tmp_path, monkeypatch, capsys):
+    op = tmp_path / "open.json"
+    op.write_text("[]")
+    code, out, err = _run(
+        monkeypatch, capsys, _csv(tmp_path), "--balances", "--opening", op
+    )
+    assert code == 2 and out == "" and err
+
+
+def test_existing_features_still_work_with_accounts(tmp_path, monkeypatch, capsys):
+    b = tmp_path / "b.json"
+    b.write_text(json.dumps({"default": {"food": 1000}}))
+    code, out, err = _run(
+        monkeypatch, capsys, _csv(tmp_path), "--memo", "lunch", "--budget", b
+    )
+    assert code == 0 and out == "food\t1,200\n"
+    assert "200円超過" in err
