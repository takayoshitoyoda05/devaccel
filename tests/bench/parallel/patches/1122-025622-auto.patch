diff --git a/tests/test_types/test_Choice.py b/tests/test_types/test_Choice.py
index c34f516..f224377 100644
--- a/tests/test_types/test_Choice.py
+++ b/tests/test_types/test_Choice.py
@@ -5,3 +5,72 @@ def test_choice_get_invalid_choice_message():
     choice = click.Choice(["a", "b", "c"])
     message = choice.get_invalid_choice_message("d", ctx=None)
     assert message == "'d' is not one of 'a', 'b', 'c'."
+
+
+def test_choice_invalid_message_suggests_close_choice():
+    choice = click.Choice(["apple", "banana", "cherry"])
+    message = choice.get_invalid_choice_message("appel", ctx=None)
+    assert message == (
+        "'appel' is not one of 'apple', 'banana', 'cherry'. Did you mean 'apple'?"
+    )
+
+
+def test_choice_invalid_message_suggests_several_sorted():
+    choice = click.Choice(["color", "colour", "other"])
+    message = choice.get_invalid_choice_message("colr", ctx=None)
+    assert message.endswith("(Did you mean one of: 'color', 'colour'?)")
+
+
+def test_choice_invalid_message_no_suggestion_when_far():
+    choice = click.Choice(["a", "b", "c"])
+    assert "Did you mean" not in choice.get_invalid_choice_message("zzz", ctx=None)
+
+
+def test_choice_invalid_message_single_choice():
+    choice = click.Choice(["json"])
+    assert choice.get_invalid_choice_message("jsno", ctx=None) == (
+        "'jsno' is not 'json'. Did you mean 'json'?"
+    )
+
+
+def test_choice_invalid_message_case_insensitive_suggests_normalized():
+    choice = click.Choice(["Apple", "Banana"], case_sensitive=False)
+    message = choice.get_invalid_choice_message("APPEL", ctx=None)
+    assert message.endswith("Did you mean 'apple'?")
+
+
+def test_choice_invalid_message_non_str_value():
+    choice = click.Choice(["100", "200"])
+    message = choice.get_invalid_choice_message(101, ctx=None)
+    assert message.endswith("Did you mean '100'?")
+
+
+def test_choice_invalid_message_enum(runner):
+    import enum
+
+    class Color(enum.Enum):
+        RED = 1
+        GREEN = 2
+
+    @click.command()
+    @click.option("--c", type=click.Choice(Color, case_sensitive=False))
+    def cli(c):
+        pass
+
+    result = runner.invoke(cli, ["--c", "gren"])
+    assert result.exit_code == 2
+    assert "'gren' is not one of 'red', 'green'. Did you mean 'green'?" in result.output
+
+
+def test_choice_option_suggestion_via_cli(runner):
+    @click.command()
+    @click.option("--fmt", type=click.Choice(["json", "yaml"]))
+    def cli(fmt):
+        pass
+
+    result = runner.invoke(cli, ["--fmt", "jsno"])
+    assert result.exit_code == 2
+    assert (
+        "Invalid value for '--fmt': 'jsno' is not one of 'json', 'yaml'. "
+        "Did you mean 'json'?"
+    ) in result.output
