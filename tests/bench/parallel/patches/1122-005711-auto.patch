diff --git a/tests/test_report_total.py b/tests/test_report_total.py
new file mode 100644
index 0000000..e873fa5
--- /dev/null
+++ b/tests/test_report_total.py
@@ -0,0 +1,72 @@
+import sys
+
+from kakeibo import main
+
+HEADER = "date,category,amount,memo\n"
+BODY = (
+    "2026-11-01,food,1200,lunch\n"
+    "2026-10-02,rent,80000,\n"
+    "2026-11-03,food,800,coffee\n"
+    "2026-10-04,food,500,lunch\n"
+)
+
+
+def _run(tmp_path, monkeypatch, capsys, *args, body=BODY):
+    p = tmp_path / "in.csv"
+    p.write_text(HEADER + body, encoding="utf-8")
+    monkeypatch.setattr(sys, "argv", ["kakeibo", str(p), *args])
+    main()
+    return capsys.readouterr()
+
+
+def test_report_total_monthly_subtotals_and_grand_total(tmp_path, monkeypatch, capsys):
+    out = _run(tmp_path, monkeypatch, capsys, "--report", "--total")
+    assert out.out == (
+        "2026-10\trent\t80000\n"
+        "2026-10\tfood\t500\n"
+        "2026-10\tSUBTOTAL\t80500\n"
+        "2026-11\tfood\t2000\n"
+        "2026-11\tSUBTOTAL\t2000\n"
+        "TOTAL\t82500\n"
+    )
+    assert out.err == ""
+
+
+def test_report_without_total_unchanged(tmp_path, monkeypatch, capsys):
+    out = _run(tmp_path, monkeypatch, capsys, "--report")
+    assert "SUBTOTAL" not in out.out
+    assert "TOTAL" not in out.out
+
+
+def test_report_total_with_memo_filter(tmp_path, monkeypatch, capsys):
+    out = _run(tmp_path, monkeypatch, capsys, "--report", "--total", "--memo", "coffee")
+    assert out.out == "2026-11\tfood\t800\n2026-11\tSUBTOTAL\t800\nTOTAL\t800\n"
+
+
+def test_report_total_memo_no_match(tmp_path, monkeypatch, capsys):
+    out = _run(tmp_path, monkeypatch, capsys, "--report", "--total", "--memo", "zzz")
+    assert out.out == "TOTAL\t0\n"
+
+
+def test_report_total_empty_csv(tmp_path, monkeypatch, capsys):
+    out = _run(tmp_path, monkeypatch, capsys, "--report", "--total", body="")
+    assert out.out == "TOTAL\t0\n"
+
+
+def test_report_total_with_csv_format_still_ignored(tmp_path, monkeypatch, capsys):
+    base = _run(tmp_path, monkeypatch, capsys, "--report", "--total")
+    out = _run(tmp_path, monkeypatch, capsys, "--report", "--total", "--format", "csv")
+    assert out.out == base.out
+    assert "--format csv" in out.err
+
+
+def test_report_total_with_refund_month_can_be_negative(tmp_path, monkeypatch, capsys):
+    out = _run(
+        tmp_path,
+        monkeypatch,
+        capsys,
+        "--report",
+        "--total",
+        body="2026-11-01,food,-300,refund\n",
+    )
+    assert out.out == "2026-11\tfood\t-300\n2026-11\tSUBTOTAL\t-300\nTOTAL\t-300\n"
