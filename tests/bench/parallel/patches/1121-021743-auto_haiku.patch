index 0000000..759ee7d
--- /dev/null
+++ b/src/kakeibo/budget_alert.py
@@ -0,0 +1,107 @@
+"""Per-category budget alerts for a single month (pure functions).
+
+Input is a month's ``{category: yen}`` spending (one entry of
+``core.monthly_totals``) and the month's limits (``Budget.for_month``).
+
+Decisions:
+- D1: Only categories that have a limit are assessed. Spending in a category
+  without a limit produces no alert.
+- D2: "over" = spending is strictly greater than the limit (exactly on the limit
+  is not over, matching ``core.find_overruns``).
+- D3: "near" = spending has reached ``warn_ratio`` of the limit but has not
+  exceeded it. The default ``warn_ratio`` is 0.8.
+- D4: A limit of 0 never produces "near"; any spending over 0 is "over".
+- D5: Results are sorted with "over" first, then by how far past the limit
+  (or how close to it) the spending is, then by category name.
+- D6: ``spent`` and ``limits`` values must be non-negative ``int`` (yen).
+  ``bool``, ``float`` and negative values raise ``ValueError`` naming the
+  category, instead of producing a silent result.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Literal
+
+from kakeibo.core import Budget
+
+Level = Literal["over", "near"]
+
+DEFAULT_WARN_RATIO = 0.8
+
+
+@dataclass(frozen=True)
+class Alert:
+    category: str
+    level: Level
+    limit: int  # yen
+    spent: int  # yen
+
+    @property
+    def remaining(self) -> int:
+        """Yen left before the limit (negative when over)."""
+        return self.limit - self.spent
+
+    @property
+    def ratio(self) -> float:
+        """spent / limit. A zero limit gives inf when anything is spent (D4)."""
+        if self.limit == 0:
+            return float("inf") if self.spent > 0 else 0.0
+        return self.spent / self.limit
+
+
+def _check_yen(amounts: dict[str, int], name: str) -> None:
+    for cat, yen in amounts.items():
+        if isinstance(yen, bool) or not isinstance(yen, int) or yen < 0:
+            raise ValueError(
+                f"{name}.{cat} は 0 以上の整数(円)である必要があります: {yen!r}"
+            )
+
+
+def assess_budget(
+    spent: dict[str, int],
+    limits: dict[str, int],
+    warn_ratio: float = DEFAULT_WARN_RATIO,
+) -> list[Alert]:
+    """Return alerts for categories that are over or near their limit."""
+    if not 0 < warn_ratio <= 1:
+        raise ValueError(
+            f"warn_ratio は 0 より大きく 1 以下である必要があります: {warn_ratio}"
+        )
+    _check_yen(spent, "spent")
+    _check_yen(limits, "limits")
+    alerts: list[Alert] = []
+    for cat, limit in limits.items():
+        if cat not in spent:
+            continue
+        actual = spent[cat]
+        if actual > limit:
+            alerts.append(Alert(cat, "over", limit, actual))
+        elif limit > 0 and actual >= limit * warn_ratio:
+            alerts.append(Alert(cat, "near", limit, actual))
+    alerts.sort(key=lambda a: (a.level != "over", -a.ratio, a.category))
+    return alerts
+
+
+def assess_month(
+    spent: dict[str, int],
+    budget: Budget,
+    month: str,
+    warn_ratio: float = DEFAULT_WARN_RATIO,
+) -> list[Alert]:
+    """Assess one month using the limits that ``budget`` defines for ``month``."""
+    return assess_budget(spent, budget.for_month(month), warn_ratio)
+
+
+def format_alert(alert: Alert, month: str | None = None) -> str:
+    """Human-readable Japanese message for one alert."""
+    prefix = f"{month} " if month else ""
+    if alert.level == "over":
+        return (
+            f"{prefix}{alert.category}: 予算超過 {-alert.remaining:,}円超過 "
+            f"(予算 {alert.limit:,} / 実績 {alert.spent:,})"
+        )
+    return (
+        f"{prefix}{alert.category}: もうすぐ超過 残り {alert.remaining:,}円 "
+        f"(予算 {alert.limit:,} / 実績 {alert.spent:,})"
+    )
diff --git a/tests/test_budget_alert.py b/tests/test_budget_alert.py
new file mode 100644
index 0000000..4d21053
--- /dev/null
+++ b/tests/test_budget_alert.py
@@ -0,0 +1,102 @@
+import pytest
+
+from kakeibo.budget_alert import assess_budget, assess_month, format_alert
+from kakeibo.core import Budget
+
+
+def test_over_and_near_levels():
+    alerts = assess_budget({"food": 1150, "rent": 75000}, {"food": 1000, "rent": 90000})
+    assert [(a.category, a.level) for a in alerts] == [
+        ("food", "over"),
+        ("rent", "near"),
+    ]
+    over, near = alerts
+    assert over.remaining == -150
+    assert near.remaining == 15000
+
+
+def test_exactly_on_limit_is_near_not_over():
+    alerts = assess_budget({"food": 1000}, {"food": 1000})
+    assert [(a.category, a.level) for a in alerts] == [("food", "near")]
+
+
+def test_below_warn_ratio_has_no_alert():
+    assert assess_budget({"food": 799}, {"food": 1000}) == []
+
+
+def test_warn_ratio_boundary_is_inclusive():
+    alerts = assess_budget({"food": 800}, {"food": 1000})
+    assert [a.level for a in alerts] == ["near"]
+
+
+def test_custom_warn_ratio():
+    assert (
+        assess_budget({"food": 500}, {"food": 1000}, warn_ratio=0.5)[0].level == "near"
+    )
+    assert assess_budget({"food": 500}, {"food": 1000}, warn_ratio=0.9) == []
+
+
+@pytest.mark.parametrize("ratio", [0, -0.1, 1.5])
+def test_invalid_warn_ratio_raises(ratio):
+    with pytest.raises(ValueError):
+        assess_budget({"food": 1}, {"food": 10}, warn_ratio=ratio)
+
+
+@pytest.mark.parametrize(
+    "spent, limits, name",
+    [
+        ({"food": -1}, {"food": 1000}, "spent.food"),
+        ({"food": 1}, {"food": -1000}, "limits.food"),
+        ({"food": 1.5}, {"food": 1000}, "spent.food"),
+        ({"food": True}, {"food": 1000}, "spent.food"),
+        ({"food": 1}, {"food": None}, "limits.food"),
+    ],
+)
+def test_invalid_amounts_raise(spent, limits, name):
+    with pytest.raises(ValueError, match=name.replace(".", r"\.")):
+        assess_budget(spent, limits)
+
+
+def test_category_without_limit_is_ignored():
+    assert assess_budget({"hobby": 999999}, {"food": 1000}) == []
+
+
+def test_limit_without_spending_is_ignored():
+    assert assess_budget({}, {"food": 1000}) == []
+
+
+def test_zero_limit_is_over_when_spent_but_never_near():
+    assert [a.level for a in assess_budget({"fun": 1}, {"fun": 0})] == ["over"]
+    assert assess_budget({"fun": 0}, {"fun": 0}) == []
+
+
+def test_sorting_over_first_then_closeness_then_name():
+    alerts = assess_budget(
+        {"a": 900, "b": 2000, "c": 1500, "d": 1000},
+        {"a": 1000, "b": 1000, "c": 1000, "d": 1000},
+    )
+    assert [a.category for a in alerts] == ["b", "c", "d", "a"]
+    assert [a.level for a in alerts] == ["over", "over", "near", "near"]
+
+
+def test_assess_month_uses_monthly_override():
+    budget = Budget(default={"food": 1000}, months={"2026-11": {"food": 3000}})
+    assert assess_month({"food": 2000}, budget, "2026-11") == []
+    assert [a.level for a in assess_month({"food": 2500}, budget, "2026-11")] == [
+        "near"
+    ]
+    assert [a.level for a in assess_month({"food": 2500}, budget, "2026-10")] == [
+        "over"
+    ]
+
+
+def test_format_alert_messages():
+    over = assess_budget({"food": 1150}, {"food": 1000})[0]
+    near = assess_budget({"rent": 85000}, {"rent": 90000})[0]
+    assert format_alert(over, "2026-11") == (
+        "2026-11 food: 予算超過 150円超過 (予算 1,000 / 実績 1,150)"
+    )
+    assert (
+        format_alert(near)
+        == "rent: もうすぐ超過 残り 5,000円 (予算 90,000 / 実績 85,000)"
+    )
