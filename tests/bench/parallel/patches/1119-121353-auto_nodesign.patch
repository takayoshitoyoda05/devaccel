--- /dev/null
+++ b/src/kakeibo/yearly.py
@@ -0,0 +1,47 @@
+"""Yearly summary of expenses (pure functions, no I/O)."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class YearlySummary:
+    year: int
+    monthly: dict[str, int]  # "YYYY-01".."YYYY-12", all 12 keys
+    top_month: str | None
+    shares: dict[str, float]  # category -> share of year total (0..1)
+    total: int
+
+
+def summarize_year(rows: list[Expense], year: int) -> YearlySummary:
+    monthly = {f"{year:04d}-{m:02d}": 0 for m in range(1, 13)}
+    by_category: dict[str, int] = {}
+    total = 0
+    for e in rows:
+        if e.day.year != year:
+            continue
+        key = e.day.strftime("%Y-%m")
+        monthly[key] += e.amount
+        by_category[e.category] = by_category.get(e.category, 0) + e.amount
+        total += e.amount
+
+    top_month: str | None = None
+    if any(v != 0 for v in monthly.values()):
+        # max() returns the first maximal key, so ties go to the earlier month.
+        top_month = max(monthly, key=lambda k: monthly[k])
+
+    shares: dict[str, float] = {}
+    if total != 0:
+        ratios = {cat: amt / total for cat, amt in by_category.items()}
+        shares = dict(sorted(ratios.items(), key=lambda kv: (-kv[1], kv[0])))
+
+    return YearlySummary(
+        year=year,
+        monthly=monthly,
+        top_month=top_month,
+        shares=shares,
+        total=total,
+    )
diff --git a/tests/test_budget_alert.py b/tests/test_budget_alert.py
new file mode 100644
index 0000000..48f605a
--- /dev/null
+++ b/tests/test_budget_alert.py
@@ -0,0 +1,163 @@
+"""Tests for kakeibo.budget_alert (pure function, no I/O)."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.budget_alert import Alert, check_budgets
+from kakeibo.core import Expense
+
+
+def _e(day: str, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+LIMITS = {"食費": 30000}
+
+
+def test_warn_when_spent_at_80_percent() -> None:
+    rows = [_e("2026-03-01", "食費", 24000)]
+    assert check_budgets(rows, LIMITS, "2026-03") == [
+        Alert(category="食費", month="2026-03", spent=24000, limit=30000, level="warn")
+    ]
+
+
+def test_over_when_spent_exceeds_limit() -> None:
+    rows = [_e("2026-03-01", "食費", 30001)]
+    assert check_budgets(rows, LIMITS, "2026-03") == [
+        Alert(category="食費", month="2026-03", spent=30001, limit=30000, level="over")
+    ]
+
+
+def test_no_alert_just_below_warn_threshold() -> None:
+    rows = [_e("2026-03-01", "食費", 23999)]
+    assert check_budgets(rows, LIMITS, "2026-03") == []
+
+
+def test_exactly_limit_is_warn_not_over() -> None:
+    rows = [_e("2026-03-01", "食費", 30000)]
+    assert check_budgets(rows, LIMITS, "2026-03") == [
+        Alert(category="食費", month="2026-03", spent=30000, limit=30000, level="warn")
+    ]
+
+
+def test_only_rows_of_given_month_are_summed() -> None:
+    rows = [
+        _e("2026-02-28", "食費", 20000),
+        _e("2026-03-01", "食費", 10000),
+        _e("2026-04-01", "食費", 20000),
+    ]
+    assert check_budgets(rows, LIMITS, "2026-03") == []
+    assert check_budgets(rows, LIMITS, "2026-02") == []
+
+
+def test_rows_of_same_category_in_month_are_summed() -> None:
+    rows = [_e("2026-03-01", "食費", 12000), _e("2026-03-31", "食費", 12000)]
+    assert check_budgets(rows, LIMITS, "2026-03") == [
+        Alert(category="食費", month="2026-03", spent=24000, limit=30000, level="warn")
+    ]
+
+
+def test_categories_not_in_limits_are_ignored() -> None:
+    rows = [_e("2026-03-01", "娯楽", 999999)]
+    assert check_budgets(rows, LIMITS, "2026-03") == []
+
+
+def test_empty_rows_gives_no_alerts() -> None:
+    assert check_budgets([], LIMITS, "2026-03") == []
+
+
+def test_no_rows_in_month_gives_no_alerts() -> None:
+    rows = [_e("2026-02-01", "食費", 99999)]
+    assert check_budgets(rows, LIMITS, "2026-03") == []
+
+
+def test_custom_warn_ratio() -> None:
+    rows = [_e("2026-03-01", "食費", 15000)]
+    assert check_budgets(rows, LIMITS, "2026-03", warn_ratio=0.5) == [
+        Alert(category="食費", month="2026-03", spent=15000, limit=30000, level="warn")
+    ]
+
+
+def test_warn_ratio_one_warns_only_at_limit() -> None:
+    rows = [_e("2026-03-01", "食費", 29999)]
+    assert check_budgets(rows, LIMITS, "2026-03", warn_ratio=1.0) == []
+
+
+def test_warn_ratio_zero_is_allowed() -> None:
+    rows = [_e("2026-03-01", "食費", 1000)]
+    assert check_budgets(rows, LIMITS, "2026-03", warn_ratio=0.0) == [
+        Alert(category="食費", month="2026-03", spent=1000, limit=30000, level="warn")
+    ]
+
+
+@pytest.mark.parametrize("bad_limit", [0, -1])
+def test_limit_zero_or_negative_raises(bad_limit: int) -> None:
+    with pytest.raises(ValueError):
+        check_budgets([], {"食費": bad_limit}, "2026-03")
+
+
+@pytest.mark.parametrize("bad_ratio", [-0.1, 1.1, 2.0])
+def test_warn_ratio_outside_0_1_raises(bad_ratio: float) -> None:
+    with pytest.raises(ValueError):
+        check_budgets([], LIMITS, "2026-03", warn_ratio=bad_ratio)
+
+
+@pytest.mark.parametrize(
+    "bad_month", ["2026-3", "2026/03", "202603", "2026-13", "2026-00", "", "2026-03-01"]
+)
+def test_invalid_month_format_raises(bad_month: str) -> None:
+    with pytest.raises(ValueError):
+        check_budgets([], LIMITS, bad_month)
+
+
+def test_sort_over_first_then_warn() -> None:
+    limits = {"食費": 10000, "娯楽": 10000}
+    rows = [
+        _e("2026-03-01", "食費", 8000),  # warn
+        _e("2026-03-01", "娯楽", 10001),  # over
+    ]
+    result = check_budgets(rows, limits, "2026-03")
+    assert [a.level for a in result] == ["over", "warn"]
+    assert [a.category for a in result] == ["娯楽", "食費"]
+
+
+def test_same_level_sorted_by_overage_desc() -> None:
+    limits = {"A": 1000, "B": 1000}
+    rows = [
+        _e("2026-03-01", "A", 1100),  # over by 100
+        _e("2026-03-01", "B", 1500),  # over by 500
+    ]
+    result = check_budgets(rows, limits, "2026-03")
+    assert [a.category for a in result] == ["B", "A"]
+
+
+def test_same_overage_tie_broken_by_category_name_asc() -> None:
+    limits = {"B": 1000, "A": 1000}
+    rows = [
+        _e("2026-03-01", "B", 1100),
+        _e("2026-03-01", "A", 1100),
+    ]
+    result = check_budgets(rows, limits, "2026-03")
+    assert [a.category for a in result] == ["A", "B"]
+
+
+def test_warn_ties_sorted_by_category_name_asc() -> None:
+    limits = {"B": 1000, "A": 1000}
+    rows = [
+        _e("2026-03-01", "B", 800),
+        _e("2026-03-01", "A", 800),
+    ]
+    result = check_budgets(rows, limits, "2026-03")
+    assert [a.category for a in result] == ["A", "B"]
+    assert all(a.level == "warn" for a in result)
+
+
+def test_alert_is_frozen_dataclass() -> None:
+    alert = Alert(category="食費", month="2026-03", spent=1, limit=2, level="warn")
+    with pytest.raises(AttributeError):
+        alert.spent = 5  # type: ignore[misc]
diff --git a/tests/test_fx.py b/tests/test_fx.py
new file mode 100644
index 0000000..2f0e442
--- /dev/null
+++ b/tests/test_fx.py
@@ -0,0 +1,116 @@
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from kakeibo.fx import RateNotFound, to_yen
+
+D = date(2026, 3, 10)
+RATES: dict[str, dict[date, Decimal]] = {
+    "USD": {D: Decimal("150.25")},
+}
+
+
+def test_exact_day_rate_usd_decimal_amount() -> None:
+    assert to_yen(Decimal("10.00"), "USD", D, RATES) == 1503
+
+
+def test_half_yen_rounds_half_up() -> None:
+    # 10 * 150.25 = 1502.5 -> 1503
+    assert to_yen(10, "USD", D, RATES) == 1503
+
+
+def test_rounds_down_below_half() -> None:
+    rates = {"USD": {D: Decimal("150.24")}}
+    assert to_yen(Decimal(10), "USD", D, rates) == 1502
+
+
+def test_str_amount() -> None:
+    assert to_yen("10.00", "USD", D, RATES) == 1503
+
+
+def test_int_amount() -> None:
+    rates = {"USD": {D: Decimal(100)}}
+    assert to_yen(3, "USD", D, rates) == 300
+
+
+def test_currency_is_case_insensitive() -> None:
+    assert to_yen(10, "usd", D, RATES) == 1503
+
+
+def test_rates_key_case_is_ignored() -> None:
+    rates = {"usd": {D: Decimal("150.25")}}
+    assert to_yen(10, "USD", D, rates) == 1503
+
+
+def test_jpy_returns_int_without_rates() -> None:
+    assert to_yen(1200, "JPY", D, {}) == 1200
+    assert isinstance(to_yen(1200, "jpy", D, {}), int)
+
+
+def test_jpy_str_amount_is_int() -> None:
+    assert to_yen("1200", "JPY", D, {}) == 1200
+
+
+def test_negative_amount_refund() -> None:
+    # -10 * 150.25 = -1502.5 -> ROUND_HALF_UP は 0 から遠ざかる方向 -> -1503
+    assert to_yen(-10, "USD", D, RATES) == -1503
+
+
+def test_falls_back_to_earlier_rate_three_days_before() -> None:
+    rates = {"USD": {date(2026, 3, 7): Decimal(150)}}
+    assert to_yen(Decimal(1), "USD", D, rates) == 150
+
+
+def test_uses_nearest_earlier_rate_not_older_one() -> None:
+    rates = {
+        "USD": {
+            date(2026, 3, 5): Decimal(100),
+            date(2026, 3, 8): Decimal(150),
+        }
+    }
+    assert to_yen(1, "USD", D, rates) == 150
+
+
+def test_ignores_rates_after_the_day() -> None:
+    rates = {
+        "USD": {date(2026, 3, 11): Decimal(999)},
+    }
+    with pytest.raises(RateNotFound):
+        to_yen(1, "USD", D, rates)
+
+
+def test_exactly_seven_days_old_is_allowed() -> None:
+    rates = {"USD": {date(2026, 3, 3): Decimal(150)}}
+    assert to_yen(1, "USD", D, rates) == 150
+
+
+def test_eight_days_old_only_raises_rate_not_found() -> None:
+    rates = {"USD": {date(2026, 3, 2): Decimal(150)}}
+    with pytest.raises(RateNotFound):
+        to_yen(1, "USD", D, rates)
+
+
+def test_no_rate_on_or_before_day_raises() -> None:
+    rates = {"USD": {date(2026, 3, 11): Decimal(150)}}
+    with pytest.raises(RateNotFound):
+        to_yen(1, "USD", D, rates)
+
+
+def test_unknown_currency_raises_rate_not_found() -> None:
+    with pytest.raises(RateNotFound):
+        to_yen(1, "XYZ", D, RATES)
+
+
+def test_rate_not_found_is_value_error() -> None:
+    assert issubclass(RateNotFound, ValueError)
+
+
+def test_float_amount_raises_type_error() -> None:
+    with pytest.raises(TypeError):
+        to_yen(10.0, "USD", D, RATES)  # type: ignore[arg-type]
+
+
+def test_float_amount_raises_type_error_for_jpy() -> None:
+    with pytest.raises(TypeError):
+        to_yen(1200.0, "JPY", D, {})  # type: ignore[arg-type]
diff --git a/tests/test_receipt.py b/tests/test_receipt.py
