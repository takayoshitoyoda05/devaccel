+++ b/src/kakeibo/budget_alert.py
@@ -0,0 +1,66 @@
+"""Per-category monthly budget alerts (pure functions, no I/O)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+_LEVEL_ORDER = {"over": 0, "warn": 1}
+
+
+@dataclass(frozen=True)
+class Alert:
+    category: str
+    month: str
+    spent: int
+    limit: int
+    level: str  # "over" = 超過 / "warn" = もうすぐ超えそう
+
+
+def check_budgets(
+    rows: list[Expense],
+    limits: dict[str, int],
+    month: str,
+    warn_ratio: float = 0.8,
+) -> list[Alert]:
+    """Return alerts for categories in ``limits`` whose spending in ``month`` is near or over the limit.
+
+    - spent > limit            -> "over"
+    - spent >= limit*warn_ratio and spent <= limit -> "warn" (exactly the limit is "warn")
+    - categories not in ``limits`` are ignored.
+    Order: "over" before "warn"; within a level, larger overage first, then category name ascending.
+    """
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"month は YYYY-MM 形式である必要があります: {month!r}")
+    if not 0.0 <= warn_ratio <= 1.0:
+        raise ValueError(
+            f"warn_ratio は 0 以上 1 以下である必要があります: {warn_ratio!r}"
+        )
+    for cat, limit in limits.items():
+        if limit <= 0:
+            raise ValueError(f"limit は正の整数である必要があります: {cat}={limit!r}")
+
+    spent_by_cat: dict[str, int] = {}
+    for e in rows:
+        if f"{e.day.year:04d}-{e.day.month:02d}" != month:
+            continue
+        spent_by_cat[e.category] = spent_by_cat.get(e.category, 0) + e.amount
+
+    alerts: list[Alert] = []
+    for cat, limit in limits.items():
+        spent = spent_by_cat.get(cat, 0)
+        if spent > limit:
+            level = "over"
+        elif spent / limit >= warn_ratio:
+            level = "warn"
+        else:
+            continue
+        alerts.append(
+            Alert(category=cat, month=month, spent=spent, limit=limit, level=level)
+        )
+
+    alerts.sort(key=lambda a: (_LEVEL_ORDER[a.level], -(a.spent - a.limit), a.category))
+    return alerts
diff --git a/src/kakeibo/fx.py b/src/kakeibo/fx.py
new file mode 100644
index 0000000..a279544
--- /dev/null
+++ b/src/kakeibo/fx.py
@@ -0,0 +1,50 @@
+"""外貨の金額を、日ごとのレートで円に換算する(純粋関数・I/O なし)。"""
+
+from datetime import date, timedelta
+from decimal import ROUND_HALF_UP, Decimal
+
+MAX_RATE_AGE = timedelta(days=7)
+_YEN = Decimal(1)
+
+
+class RateNotFound(ValueError):
+    """換算に使えるレートが無い(未知の通貨、または 7 日より古い/それ以前が無い)。"""
+
+
+def to_yen(
+    amount: Decimal | str | int,
+    currency: str,
+    day: date,
+    rates: dict[str, dict[date, Decimal]],
+) -> int:
+    """外貨建ての amount を、day 時点のレートで円(整数)に換算する。
+
+    rates[通貨][日付] = 1 単位あたりの円。通貨コードは大文字小文字を区別しない。
+    その日のレートが無ければ、その日より前で最も近い日のレートを使う(7 日まで)。
+    円への丸めは四捨五入(ROUND_HALF_UP)。
+    """
+    if isinstance(amount, float):
+        raise TypeError(
+            "amount に float は使えません。Decimal・str・int を渡してください"
+        )
+    value = Decimal(amount)
+    code = currency.upper()
+
+    if code == "JPY":
+        return int(value.quantize(_YEN, rounding=ROUND_HALF_UP))
+
+    table = next((t for k, t in rates.items() if k.upper() == code), None)
+    if table is None:
+        raise RateNotFound(f"未知の通貨です: {currency}")
+
+    earlier = [d for d in table if d <= day]
+    if not earlier:
+        raise RateNotFound(f"{currency} の {day} 以前のレートがありません")
+    nearest = max(earlier)
+    if day - nearest > MAX_RATE_AGE:
+        raise RateNotFound(
+            f"{currency} のレートが {day} から {MAX_RATE_AGE.days} 日より古いです"
+        )
+
+    rate = table[nearest]
+    return int((value * rate).quantize(_YEN, rounding=ROUND_HALF_UP))
diff --git a/src/kakeibo/receipt.py b/src/kakeibo/receipt.py
new file mode 100644
index 0000000..8d2d3f2
--- /dev/null
+++ b/src/kakeibo/receipt.py
@@ -0,0 +1,86 @@
+"""Extract date, total and store name from OCR text of a receipt (pure functions)."""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+
+@dataclass(frozen=True)
+class Receipt:
+    day: date | None
+    total: int | None
+    store: str | None
+
+
+# 2026/11/19, 2026-11-19, 2026.11.19, 2026年11月19日 (after NFKC: full-width digits are half-width)
+_DATE_RE = re.compile(
+    r"(?<!\d)(\d{4})(?:[/\-.]|年)(\d{1,2})(?:[/\-.]|月)(\d{1,2})(?!\d)"
+)
+_TOTAL_KEYWORD_RE = re.compile(r"合計|お会計|総計|total", re.IGNORECASE)
+_SUBTOTAL = "小計"
+_PHONE_RE = re.compile(
+    r"(?:TEL|電話)?[:：]?\s*0\d{1,4}[-\s]?\d{1,4}[-\s]?\d{3,4}", re.IGNORECASE
+)
+# ¥1,234 / \1,234 / 1,234円 / 1234 / 1.234 / 1 234 (3-digit groups separated by , . or space)
+_AMOUNT_RE = re.compile(
+    r"(?P<cur>[¥\\])?\s*(?P<num>\d{1,3}(?:[,.\s]\d{3})+|\d+)\s*(?P<yen>円)?"
+)
+_NOISE_RE = re.compile(r"領収書|レシート")
+
+
+def parse_receipt(text: str) -> Receipt:
+    """Parse OCR text. Never raises; unreadable items are None."""
+    lines = text.splitlines()
+    normalized = [unicodedata.normalize("NFKC", line) for line in lines]
+    return Receipt(
+        day=_find_date(normalized),
+        total=_find_total(normalized),
+        store=_find_store(lines, normalized),
+    )
+
+
+def _find_date(lines: list[str]) -> date | None:
+    for line in lines:
+        for m in _DATE_RE.finditer(line):
+            try:
+                return date(int(m.group(1)), int(m.group(2)), int(m.group(3)))
+            except ValueError:
+                continue
+    return None
+
+
+def _find_total(lines: list[str]) -> int | None:
+    result: int | None = None
+    for line in lines:
+        if _SUBTOTAL in line or not _TOTAL_KEYWORD_RE.search(line):
+            continue
+        value = _amount_in_line(line)
+        if value is not None:
+            result = value  # later lines win
+    return result
+
+
+def _amount_in_line(line: str) -> int | None:
+    cleaned = _PHONE_RE.sub(" ", _DATE_RE.sub(" ", line))
+    candidates = list(_AMOUNT_RE.finditer(cleaned))
+    marked = [m for m in candidates if m.group("cur") or m.group("yen")]
+    picks = marked or candidates
+    if not picks:
+        return None
+    return int(re.sub(r"\D", "", picks[-1].group("num")))
+
+
+def _find_store(raw_lines: list[str], lines: list[str]) -> str | None:
+    for raw, line in zip(raw_lines, lines):
+        if not raw.strip():
+            continue
+        residue = line
+        for pattern in (_DATE_RE, _PHONE_RE, _AMOUNT_RE, _NOISE_RE):
+            residue = pattern.sub(" ", residue)
+        residue = re.sub(r"[¥\\円]", " ", residue)
+        if re.search(r"[^\W_]", residue):
+            return raw.strip()
+    return None
diff --git a/src/kakeibo/yearly.py b/src/kakeibo/yearly.py
