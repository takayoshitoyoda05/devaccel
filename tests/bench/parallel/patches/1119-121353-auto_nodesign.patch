+++ b/tests/test_receipt.py
@@ -0,0 +1,172 @@
+"""Tests for kakeibo.receipt.parse_receipt (OCR text -> date / total / store)."""
+
+from __future__ import annotations
+
+from dataclasses import FrozenInstanceError
+from datetime import date
+
+import pytest
+
+from kakeibo.receipt import Receipt, parse_receipt
+
+EMPTY = Receipt(None, None, None)
+
+
+# --- date -------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "text, expected",
+    [
+        ("2026/11/19", date(2026, 11, 19)),
+        ("2026-11-19", date(2026, 11, 19)),
+        ("2026.11.19", date(2026, 11, 19)),
+        ("2026年11月19日", date(2026, 11, 19)),
+        ("２０２６／１１／１９", date(2026, 11, 19)),  # full-width digits and slash
+        ("2026/1/9", date(2026, 1, 9)),  # single-digit month and day
+    ],
+)
+def test_date_formats(text: str, expected: date) -> None:
+    assert parse_receipt(text).day == expected
+
+
+def test_date_invalid_day_is_none() -> None:
+    assert parse_receipt("2026/02/30").day is None
+
+
+def test_date_first_valid_is_used_when_earlier_one_is_invalid() -> None:
+    assert parse_receipt("2026/02/30\n2026/11/19").day == date(2026, 11, 19)
+
+
+def test_date_first_of_several_valid_is_used() -> None:
+    assert parse_receipt("2026/11/19\n2026/11/20").day == date(2026, 11, 19)
+
+
+def test_date_requires_four_digit_year() -> None:
+    assert parse_receipt("12026/11/19").day is None
+
+
+def test_no_date_is_none() -> None:
+    assert parse_receipt("合計 ¥100").day is None
+
+
+# --- total ------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "line, expected",
+    [
+        ("合計 ¥1,234", 1234),
+        ("合計 1,234円", 1234),
+        ("合計 1234", 1234),
+        ("合計 \\1,234", 1234),
+        ("合計 ￥１，２３４円", 1234),  # full-width yen, digits and comma
+        ("合計 1.234", 1234),  # OCR turned the comma into a dot
+        ("合計 1 234", 1234),  # OCR turned the comma into a space
+        ("お会計 ¥980", 980),
+        ("総計 ¥500", 500),
+        ("TOTAL ¥1,234", 1234),
+        ("total 1,234", 1234),
+        ("Total: 1,234", 1234),
+    ],
+)
+def test_total_formats(line: str, expected: int) -> None:
+    assert parse_receipt(line).total == expected
+
+
+def test_subtotal_line_is_not_total() -> None:
+    assert parse_receipt("小計 ¥1,000").total is None
+
+
+def test_subtotal_ignored_when_total_exists() -> None:
+    assert parse_receipt("小計 ¥1,000\n合計 ¥1,100").total == 1100
+
+
+def test_subtotal_after_total_does_not_override() -> None:
+    assert parse_receipt("合計 1,234\n小計 1,000").total == 1234
+
+
+def test_last_total_line_wins() -> None:
+    assert parse_receipt("合計 ¥100\n合計 ¥200").total == 200
+
+
+def test_keyword_line_without_amount_is_none() -> None:
+    assert parse_receipt("合計").total is None
+
+
+def test_no_keyword_is_none() -> None:
+    assert parse_receipt("牛乳 ¥198\n1,234").total is None
+
+
+def test_total_line_with_phone_number_ignores_phone() -> None:
+    assert parse_receipt("合計 ¥1,234 TEL 03-1234-5678").total == 1234
+
+
+def test_total_line_with_date_ignores_date() -> None:
+    assert parse_receipt("2026/11/19 合計 ¥1,234").total == 1234
+
+
+def test_total_prefers_marked_amount_over_trailing_count() -> None:
+    assert parse_receipt("合計 ¥1,234 (2点)").total == 1234
+
+
+# --- store ------------------------------------------------------------------
+
+
+def test_store_is_first_non_empty_line_stripped() -> None:
+    assert parse_receipt("\n\n  ローソン  \n合計 ¥100").store == "ローソン"
+
+
+def test_store_skips_date_only_line() -> None:
+    assert parse_receipt("2026/11/19\nダイエー").store == "ダイエー"
+
+
+def test_store_skips_amount_only_line() -> None:
+    assert parse_receipt("¥1,200\nセブン").store == "セブン"
+
+
+def test_store_skips_phone_only_line() -> None:
+    assert parse_receipt("03-1234-5678\nABC店").store == "ABC店"
+
+
+def test_store_skips_receipt_title_lines() -> None:
+    assert parse_receipt("領収書\nレシート\nスーパーX").store == "スーパーX"
+
+
+def test_store_none_when_only_non_store_lines() -> None:
+    assert parse_receipt("2026/11/19\n¥100").store is None
+
+
+def test_store_skips_meaningless_symbols() -> None:
+    assert parse_receipt("***\n---\nカフェ").store == "カフェ"
+
+
+# --- whole receipt / degenerate input ----------------------------------------
+
+
+def test_full_receipt() -> None:
+    text = (
+        "スーパーマルエー\n"
+        "東京都千代田区1-2-3\n"
+        "TEL 03-1234-5678\n"
+        "2026/11/19 14:32\n"
+        "牛乳 ¥198\n"
+        "小計 ¥1,000\n"
+        "合計 ¥1,080\n"
+    )
+    assert parse_receipt(text) == Receipt(date(2026, 11, 19), 1080, "スーパーマルエー")
+
+
+@pytest.mark.parametrize("text", ["", "   \n \n\t"])
+def test_empty_text(text: str) -> None:
+    assert parse_receipt(text) == EMPTY
+
+
+def test_meaningless_text() -> None:
+    assert parse_receipt("???") == EMPTY
+
+
+def test_receipt_is_frozen() -> None:
+    receipt = parse_receipt("")
+    with pytest.raises(FrozenInstanceError):
+        receipt.total = 1  # type: ignore[misc]
diff --git a/tests/test_yearly.py b/tests/test_yearly.py
new file mode 100644
index 0000000..a9384f3
--- /dev/null
+++ b/tests/test_yearly.py
@@ -0,0 +1,102 @@
+from __future__ import annotations
+
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.yearly import YearlySummary, summarize_year
+
+
+def _e(day: str, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+def test_empty_rows_gives_twelve_zero_months_and_no_top() -> None:
+    s = summarize_year([], 2026)
+    assert isinstance(s, YearlySummary)
+    assert s.year == 2026
+    assert s.monthly == {f"2026-{m:02d}": 0 for m in range(1, 13)}
+    assert s.top_month is None
+    assert s.shares == {}
+    assert s.total == 0
+
+
+def test_monthly_has_all_twelve_keys_in_order() -> None:
+    s = summarize_year([_e("2026-03-01", "food", 100)], 2026)
+    assert list(s.monthly) == [f"2026-{m:02d}" for m in range(1, 13)]
+    assert s.monthly["2026-03"] == 100
+    assert s.monthly["2026-01"] == 0
+
+
+def test_rows_from_other_years_are_ignored() -> None:
+    rows = [
+        _e("2025-12-31", "food", 999),
+        _e("2026-05-10", "food", 300),
+        _e("2027-01-01", "food", 888),
+    ]
+    s = summarize_year(rows, 2026)
+    assert s.total == 300
+    assert s.monthly["2026-05"] == 300
+    assert sum(s.monthly.values()) == 300
+    assert s.shares == {"food": 1.0}
+
+
+def test_same_month_amounts_are_summed() -> None:
+    rows = [_e("2026-02-01", "food", 100), _e("2026-02-28", "rent", 50)]
+    s = summarize_year(rows, 2026)
+    assert s.monthly["2026-02"] == 150
+
+
+def test_top_month_is_max_total() -> None:
+    rows = [
+        _e("2026-01-05", "food", 100),
+        _e("2026-07-05", "food", 500),
+        _e("2026-09-05", "food", 200),
+    ]
+    assert summarize_year(rows, 2026).top_month == "2026-07"
+
+
+def test_top_month_tie_goes_to_earlier_month() -> None:
+    rows = [
+        _e("2026-10-05", "food", 300),
+        _e("2026-04-05", "food", 300),
+        _e("2026-06-05", "food", 100),
+    ]
+    assert summarize_year(rows, 2026).top_month == "2026-04"
+
+
+def test_top_month_none_when_all_amounts_zero() -> None:
+    rows = [_e("2026-03-01", "food", 0)]
+    s = summarize_year(rows, 2026)
+    assert s.top_month is None
+    assert s.total == 0
+
+
+def test_shares_sorted_by_share_desc_then_name_asc() -> None:
+    rows = [
+        _e("2026-01-01", "rent", 100),
+        _e("2026-01-02", "food", 100),
+        _e("2026-01-03", "book", 200),
+    ]
+    s = summarize_year(rows, 2026)
+    assert list(s.shares) == ["book", "food", "rent"]
+    assert s.shares["book"] == 0.5
+    assert s.shares["food"] == 0.25
+    assert s.shares["rent"] == 0.25
+
+
+def test_shares_are_fractions_of_year_total_not_month() -> None:
+    rows = [
+        _e("2026-01-01", "food", 300),
+        _e("2026-02-01", "rent", 100),
+        _e("2025-06-01", "food", 9999),
+    ]
+    s = summarize_year(rows, 2026)
+    assert s.total == 400
+    assert s.shares == {"food": 0.75, "rent": 0.25}
+
+
+def test_total_is_sum_of_all_rows_in_year() -> None:
+    rows = [_e("2026-01-01", "food", 120), _e("2026-12-31", "rent", 80)]
+    assert summarize_year(rows, 2026).total == 200
