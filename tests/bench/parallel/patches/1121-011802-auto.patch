--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,128 @@
+"""Condition-based search over Expense rows (pure functions)."""
+
+from __future__ import annotations
+
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def _fold(text: str) -> str:
+    """D6: NFKC + casefold (case and full/half width insensitive)."""
+    return unicodedata.normalize("NFKC", text).casefold()
+
+
+def _check_int(value: object, name: str) -> None:
+    # R2: amounts must be int; bool, float and str are rejected.
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{name} は int である必要があります: {type(value).__name__}")
+
+
+@dataclass(frozen=True)
+class Category:
+    name: str
+
+    def matches(self, e: Expense) -> bool:
+        return _fold(e.category).strip() == _fold(self.name).strip()
+
+
+@dataclass(frozen=True)
+class AmountRange:
+    min: int | None = None
+    max: int | None = None
+
+    def __post_init__(self) -> None:
+        if self.min is not None:
+            _check_int(self.min, "min")
+        if self.max is not None:
+            _check_int(self.max, "max")
+        if self.min is not None and self.max is not None and self.min > self.max:
+            raise ValueError(
+                f"min ({self.min}) は max ({self.max}) 以下である必要があります"
+            )
+
+    def matches(self, e: Expense) -> bool:
+        # R4: compared on the signed amount (refunds are negative).
+        if self.min is not None and e.amount < self.min:
+            return False
+        return self.max is None or e.amount <= self.max
+
+
+@dataclass(frozen=True)
+class MemoContains:
+    text: str
+
+    def matches(self, e: Expense) -> bool:
+        needle = _fold(self.text)
+        return needle in _fold(e.memo)
+
+
+@dataclass(frozen=True)
+class DateRange:
+    start: date | None = None
+    end: date | None = None
+
+    def __post_init__(self) -> None:
+        if self.start is not None and self.end is not None and self.start > self.end:
+            raise ValueError(
+                f"start ({self.start}) は end ({self.end}) 以前である必要があります"
+            )
+
+    def matches(self, e: Expense) -> bool:
+        if self.start is not None and e.day < self.start:
+            return False
+        return self.end is None or e.day <= self.end
+
+
+def _check_queries(queries: tuple[object, ...]) -> None:
+    for q in queries:
+        if not isinstance(q, _QUERY_TYPES):
+            raise TypeError(f"条件は Query である必要があります: {type(q).__name__}")
+
+
+@dataclass(frozen=True, init=False)
+class And:
+    queries: tuple[Query, ...]
+
+    def __init__(self, *queries: Query) -> None:
+        _check_queries(queries)
+        object.__setattr__(self, "queries", tuple(queries))
+
+    def matches(self, e: Expense) -> bool:
+        return all(q.matches(e) for q in self.queries)  # empty -> True
+
+
+@dataclass(frozen=True, init=False)
+class Or:
+    queries: tuple[Query, ...]
+
+    def __init__(self, *queries: Query) -> None:
+        _check_queries(queries)
+        object.__setattr__(self, "queries", tuple(queries))
+
+    def matches(self, e: Expense) -> bool:
+        return any(q.matches(e) for q in self.queries)  # empty -> False
+
+
+@dataclass(frozen=True)
+class Not:
+    query: Query
+
+    def __post_init__(self) -> None:
+        _check_queries((self.query,))
+
+    def matches(self, e: Expense) -> bool:
+        return not self.query.matches(e)
+
+
+Query = Category | AmountRange | MemoContains | DateRange | And | Or | Not
+_QUERY_TYPES = (Category, AmountRange, MemoContains, DateRange, And, Or, Not)
+
+
+def search(rows: list[Expense], query: Query) -> list[Expense]:
+    """Return the rows matching query, in input order. Inputs are not modified."""
+    if not isinstance(query, _QUERY_TYPES):
+        raise TypeError(f"query は Query である必要があります: {type(query).__name__}")
+    return [e for e in rows if query.matches(e)]
