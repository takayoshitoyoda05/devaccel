@@ -0,0 +1,326 @@
+"""Tests for kakeibo.bankcsv.parse_bank_csv."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankcsv import parse_bank_csv
+from kakeibo.core import CsvError, Expense
+
+JAN5 = date(2026, 1, 5)
+
+
+def _errors(text: str) -> list[tuple[int, str]]:
+    with pytest.raises(CsvError) as info:
+        parse_bank_csv(text)
+    return info.value.errors
+
+
+# --- 例の表 (E1) -------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param(
+            '利用日,ご利用店名,利用金額\n2026/1/5,ＡＢＣ,"1,200円"',
+            [Expense(JAN5, "未分類", 1200, "ABC")],
+            id="E1-1",
+        ),
+        pytest.param(
+            "日付,出金額,入金額\n2026-01-05,,500",
+            [Expense(JAN5, "未分類", -500, "")],
+            id="E1-2",
+        ),
+    ],
+)
+def test_example_table_success(text: str, expected: list[Expense]) -> None:
+    assert parse_bank_csv(text) == expected
+
+
+@pytest.mark.parametrize(
+    ("text", "labels"),
+    [pytest.param("日付,金額\n2026-02-30,abc", ["日付", "金額"], id="E1-3")],
+)
+def test_example_table_errors(text: str, labels: list[str]) -> None:
+    errs = _errors(text)
+    assert [line for line, _ in errs] == [2] * len(labels)
+    for (_, reason), label in zip(errs, labels):
+        assert reason.startswith(label)
+
+
+# --- R1 区切り・BOM・改行・行番号 ----------------------------------------------
+
+
+def test_R1_tab_delimiter_is_detected_from_header() -> None:
+    assert parse_bank_csv("日付\t金額\n2026-01-05\t1200") == [
+        Expense(JAN5, "未分類", 1200, "")
+    ]
+
+
+def test_R1_bom_is_removed() -> None:
+    assert parse_bank_csv("﻿日付,金額\n2026-01-05,1200") == [
+        Expense(JAN5, "未分類", 1200, "")
+    ]
+
+
+@pytest.mark.parametrize("newline", ["\r\n", "\n", "\r"])
+def test_R1_line_endings(newline: str) -> None:
+    text = newline.join(["日付,金額", "2026-01-05,1200", "2026-01-06,300"])
+    assert parse_bank_csv(text) == [
+        Expense(JAN5, "未分類", 1200, ""),
+        Expense(date(2026, 1, 6), "未分類", 300, ""),
+    ]
+
+
+def test_R1_quoted_delimiter_and_newline_stay_in_field() -> None:
+    text = '日付,金額,摘要\n2026-01-05,1200,"A,\nB"'
+    assert parse_bank_csv(text) == [Expense(JAN5, "未分類", 1200, "A,\nB")]
+
+
+def test_R1_error_line_is_record_start_after_multiline_record() -> None:
+    text = '日付,金額,摘要\n2026-01-05,1200,"A\nB"\n2026-02-30,100,x'
+    assert [line for line, _ in _errors(text)] == [4]
+
+
+# --- R2 列名の別名・ヘッダーの誤り ----------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "header", ["日付", "利用日", "取引日", "ご利用日", "date", " DATE ", "Ｄａｔｅ"]
+)
+def test_R2_date_aliases(header: str) -> None:
+    assert parse_bank_csv(f"{header},金額\n2026-01-05,1200") == [
+        Expense(JAN5, "未分類", 1200, "")
+    ]
+
+
+@pytest.mark.parametrize(
+    "header", ["金額", "利用金額", "ご利用金額", "amount", "AMOUNT"]
+)
+def test_R2_amount_aliases(header: str) -> None:
+    assert parse_bank_csv(f"日付,{header}\n2026-01-05,1200") == [
+        Expense(JAN5, "未分類", 1200, "")
+    ]
+
+
+@pytest.mark.parametrize("header", ["出金額", "出金", "お支払金額", "支払"])
+def test_R2_withdrawal_aliases(header: str) -> None:
+    assert parse_bank_csv(f"日付,{header}\n2026-01-05,1200") == [
+        Expense(JAN5, "未分類", 1200, "")
+    ]
+
+
+@pytest.mark.parametrize("header", ["入金額", "入金", "預入"])
+def test_R2_deposit_aliases(header: str) -> None:
+    assert parse_bank_csv(f"日付,{header}\n2026-01-05,1200") == [
+        Expense(JAN5, "未分類", -1200, "")
+    ]
+
+
+@pytest.mark.parametrize(
+    "header", ["摘要", "メモ", "利用店名", "ご利用店名", "内容", "description", "memo"]
+)
+def test_R2_memo_aliases(header: str) -> None:
+    assert parse_bank_csv(f"日付,金額,{header}\n2026-01-05,100,X") == [
+        Expense(JAN5, "未分類", 100, "X")
+    ]
+
+
+@pytest.mark.parametrize("header", ["カテゴリ", "category"])
+def test_R2_category_aliases(header: str) -> None:
+    assert parse_bank_csv(f"日付,金額,{header}\n2026-01-05,100,食費") == [
+        Expense(JAN5, "食費", 100, "")
+    ]
+
+
+def test_R2_missing_date_column_is_header_error() -> None:
+    errs = _errors("金額\n1200")
+    assert len(errs) == 1
+    assert errs[0][0] == 1
+    assert "日付" in errs[0][1]
+
+
+def test_R2_missing_amount_and_withdrawal_and_deposit_is_header_error() -> None:
+    errs = _errors("日付,摘要\n2026-01-05,x")
+    assert len(errs) == 1
+    assert errs[0][0] == 1
+    assert "金額" in errs[0][1]
+
+
+# --- R3 日付 -----------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026/01/05",
+        "2026.1.5",
+        "2026年1月5日",
+        "20260105",
+        "2026-01-05 12:30",
+        "2026/1/5 12:30:00",
+        "２０２６-０１-０５",
+        "２０２６／１／５",
+    ],
+)
+def test_R3_valid_dates(raw: str) -> None:
+    assert parse_bank_csv(f'日付,金額\n"{raw}",1200') == [
+        Expense(JAN5, "未分類", 1200, "")
+    ]
+
+
+@pytest.mark.parametrize(
+    "raw", ["2026-1/5", "2026-02-30", "2026-13-01", "2026/1", "R8.1.5"]
+)
+def test_R3_invalid_dates_report_date_error(raw: str) -> None:
+    errs = _errors(f'日付,金額\n"{raw}",100')
+    assert len(errs) == 1
+    assert errs[0][0] == 2
+    assert errs[0][1].startswith("日付")
+    assert raw in errs[0][1]
+
+
+@pytest.mark.parametrize("raw", ["令和8年1月5日", "平成30年1月5日", "昭和64年1月7日"])
+def test_R3_wareki_is_rejected_with_reason(raw: str) -> None:
+    errs = _errors(f'日付,金額\n"{raw}",100')
+    assert errs[0][0] == 2
+    assert "和暦" in errs[0][1]
+    assert raw in errs[0][1]
+
+
+# --- R4 金額 -----------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        ("1200", 1200),
+        ("1,200", 1200),
+        ("¥1,200", 1200),
+        ("￥1200", 1200),
+        ("1200円", 1200),
+        ("JPY 1200", 1200),
+        ("１，２００円", 1200),
+        (" 1 200 ", 1200),
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("12.0", 12),
+        ("12.00", 12),
+    ],
+)
+def test_R4_valid_amounts(raw: str, expected: int) -> None:
+    assert parse_bank_csv(f'日付,金額\n2026-01-05,"{raw}"') == [
+        Expense(JAN5, "未分類", expected, "")
+    ]
+
+
+@pytest.mark.parametrize("raw", ["", "-", "—", "0", "0円"])
+def test_R4_blank_or_zero_amount_is_skipped(raw: str) -> None:
+    assert parse_bank_csv(f'日付,金額\n2026-01-05,"{raw}"') == []
+
+
+@pytest.mark.parametrize("raw", ["12.5", "abc", "1200.50", "--5", "(500"])
+def test_R4_invalid_amounts_report_amount_error(raw: str) -> None:
+    errs = _errors(f'日付,金額\n2026-01-05,"{raw}"')
+    assert len(errs) == 1
+    assert errs[0][0] == 2
+    assert errs[0][1].startswith("金額")
+    assert raw in errs[0][1]
+
+
+# --- R5 金額列の形式 -----------------------------------------------------------
+
+
+def test_R5_single_amount_column_keeps_sign_as_is() -> None:
+    assert parse_bank_csv("日付,金額\n2026-01-05,-300") == [
+        Expense(JAN5, "未分類", -300, "")
+    ]
+
+
+def test_R5_withdrawal_only_is_positive_expense() -> None:
+    assert parse_bank_csv("日付,出金,入金\n2026-01-05,1000,") == [
+        Expense(JAN5, "未分類", 1000, "")
+    ]
+
+
+def test_R5_deposit_only_is_negative_refund() -> None:
+    assert parse_bank_csv("日付,出金,入金\n2026-01-05,,500") == [
+        Expense(JAN5, "未分類", -500, "")
+    ]
+
+
+def test_R5_both_columns_use_withdrawal_minus_deposit() -> None:
+    assert parse_bank_csv("日付,出金,入金\n2026-01-05,1000,300") == [
+        Expense(JAN5, "未分類", 700, "")
+    ]
+
+
+@pytest.mark.parametrize("line", ["2026-01-05,0,0", "2026-01-05,,", ",,"])
+def test_R5_rows_with_no_amount_or_blank_cells_are_skipped(line: str) -> None:
+    assert parse_bank_csv(f"日付,出金,入金\n{line}") == []
+
+
+def test_R5_single_column_blank_amount_row_is_skipped() -> None:
+    assert parse_bank_csv("日付,金額\n2026-01-05,") == []
+
+
+@pytest.mark.parametrize("text", ["日付,金額", "日付,出金,入金\n", ""])
+def test_R5_header_only_or_empty_input_returns_empty_list(text: str) -> None:
+    assert parse_bank_csv(text) == []
+
+
+# --- R6 列数 -----------------------------------------------------------------
+
+
+def test_R6_unquoted_thousands_separator_breaks_column_count() -> None:
+    assert _errors("日付,金額\n2026-01-05,1,234円") == [
+        (2, "列数が合いません(期待 2、実際 3)")
+    ]
+
+
+def test_R6_too_few_columns_is_reported() -> None:
+    assert _errors("日付,金額,摘要\n2026-01-05,100") == [
+        (2, "列数が合いません(期待 3、実際 2)")
+    ]
+
+
+# --- R7 誤りの集約 ---------------------------------------------------------------
+
+
+def test_R7_all_errors_are_reported_and_no_partial_result() -> None:
+    errs = _errors("日付,金額\n2026-02-30,100\n2026-01-05,abc\n2026-01-06,300")
+    assert [line for line, _ in errs] == [2, 3]
+    assert errs[0][1].startswith("日付")
+    assert errs[1][1].startswith("金額")
+    assert "金額" in errs[1][1]
+    assert "abc" in errs[1][1]
+
+
+# --- R8 カテゴリ・メモの既定 -----------------------------------------------------
+
+
+def test_R8_blank_category_uses_default_category() -> None:
+    assert parse_bank_csv(
+        "日付,金額,カテゴリ\n2026-01-05,100,", default_category="その他"
+    ) == [Expense(JAN5, "その他", 100, "")]
+
+
+def test_R8_missing_category_column_uses_default_category() -> None:
+    assert parse_bank_csv("日付,金額\n2026-01-05,100", default_category="その他") == [
+        Expense(JAN5, "その他", 100, "")
+    ]
+
+
+def test_R8_missing_memo_column_gives_empty_memo() -> None:
+    assert parse_bank_csv("日付,金額\n2026-01-05,100") == [
+        Expense(JAN5, "未分類", 100, "")
+    ]
