+++ b/tests/test_compare.py
@@ -0,0 +1,185 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.compare import CategoryChange, month_over_month
+from kakeibo.core import Expense
+
+
+def e(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+def by_cat(changes: list[CategoryChange]) -> dict[str, CategoryChange]:
+    return {c.category: c for c in changes}
+
+
+# 例の表 E4-1〜E4-3
+@pytest.mark.parametrize(
+    ("rows", "month", "category", "expected"),
+    [
+        pytest.param(
+            [e("2026-02-10", "食費", 300)],
+            "2026-03",
+            "食費",
+            {
+                "status": "gone",
+                "pct": -100.0,
+                "previous": 300,
+                "current": 0,
+                "diff": -300,
+            },
+            id="E4-1",
+        ),
+        pytest.param(
+            [e("2025-12-05", "食費", 1000), e("2026-01-05", "食費", 1500)],
+            "2026-01",
+            "食費",
+            {
+                "status": "up",
+                "pct": 50.0,
+                "previous": 1000,
+                "current": 1500,
+                "diff": 500,
+            },
+            id="E4-2",
+        ),
+        pytest.param(
+            [e("2026-02-01", "食費", 0), e("2026-03-01", "食費", 500)],
+            "2026-03",
+            "食費",
+            {"status": "up", "pct": None, "previous": 0, "current": 500, "diff": 500},
+            id="E4-3",
+        ),
+    ],
+)
+def test_example_table(rows, month, category, expected):
+    got = by_cat(month_over_month(rows, month))[category]
+    for key, value in expected.items():
+        assert getattr(got, key) == value
+
+
+# R1: 比較対象は month と直前の暦月。前月が空なら全カテゴリ 0 として比べる
+def test_empty_previous_month_is_treated_as_zero():
+    rows = [e("2026-03-01", "食費", 500)]
+    got = month_over_month(rows, "2026-03")
+    assert got == [CategoryChange("食費", 0, 500, 500, None, "new")]
+
+
+def test_both_months_empty_returns_empty_list():
+    rows = [e("2025-06-01", "食費", 500)]
+    assert month_over_month(rows, "2026-03") == []
+
+
+def test_no_rows_returns_empty_list():
+    assert month_over_month([], "2026-03") == []
+
+
+# R2: 返金込みの純額・前月か当月のどちらかにあるカテゴリを出す
+def test_refund_is_netted_in_totals():
+    rows = [
+        e("2026-02-01", "食費", 1000),
+        e("2026-03-01", "食費", 800),
+        e("2026-03-02", "食費", -300),
+    ]
+    got = by_cat(month_over_month(rows, "2026-03"))["食費"]
+    assert (got.previous, got.current, got.diff) == (1000, 500, -500)
+    assert got.status == "down"
+
+
+def test_category_in_either_month_is_included():
+    rows = [e("2026-02-01", "食費", 100), e("2026-03-01", "交通", 200)]
+    cats = {c.category: c.status for c in month_over_month(rows, "2026-03")}
+    assert cats == {"食費": "gone", "交通": "new"}
+
+
+# R3: pct は生の float。previous<0 は abs(previous) で割る
+def test_pct_is_raw_float_not_rounded():
+    rows = [e("2026-02-01", "食費", 3), e("2026-03-01", "食費", 4)]
+    got = by_cat(month_over_month(rows, "2026-03"))["食費"]
+    assert got.pct is not None
+    assert got.pct == 1 / 3 * 100
+    assert got.pct != round(got.pct, 1)
+
+
+def test_negative_previous_uses_abs_denominator():
+    rows = [e("2026-02-01", "食費", -100), e("2026-03-01", "食費", 0)]
+    got = by_cat(month_over_month(rows, "2026-03"))["食費"]
+    # diff = 0 - (-100) = 100, pct = 100 / 100 * 100
+    assert (got.diff, got.pct) == (100, 100.0)
+    assert got.status == "up"
+
+
+# R4: status 判定
+@pytest.mark.parametrize(
+    ("prev", "cur", "status"),
+    [
+        (100, 200, "up"),
+        (200, 100, "down"),
+        (100, 100, "same"),
+    ],
+)
+def test_status_up_down_same(prev, cur, status):
+    rows = [e("2026-02-01", "食費", prev), e("2026-03-01", "食費", cur)]
+    assert by_cat(month_over_month(rows, "2026-03"))["食費"].status == status
+
+
+def test_zero_total_present_counts_as_existing():
+    # 前月は合計 0 だが明細はある → gone ではなく same
+    rows = [
+        e("2026-02-01", "食費", 100),
+        e("2026-02-02", "食費", -100),
+        e("2026-03-01", "食費", 0),
+    ]
+    got = by_cat(month_over_month(rows, "2026-03"))["食費"]
+    assert got.status == "same"
+    assert got.pct is None
+
+
+def test_zero_total_previous_is_not_new():
+    rows = [
+        e("2026-02-01", "食費", 100),
+        e("2026-02-02", "食費", -100),
+        e("2026-03-01", "食費", 50),
+    ]
+    got = by_cat(month_over_month(rows, "2026-03"))["食費"]
+    assert got.status == "up"
+    assert got.pct is None
+
+
+# R5: abs(diff) 降順、同点は category 昇順
+def test_sorted_by_abs_diff_desc_then_category_asc():
+    rows = [
+        e("2026-02-01", "B", 100),
+        e("2026-03-01", "B", 200),  # diff +100
+        e("2026-02-01", "A", 500),
+        e("2026-03-01", "A", 400),  # diff -100
+        e("2026-03-01", "C", 1000),  # new, diff +1000
+        e("2026-02-01", "D", 50),
+        e("2026-03-01", "D", 50),  # same, diff 0
+    ]
+    order = [c.category for c in month_over_month(rows, "2026-03")]
+    assert order == ["C", "A", "B", "D"]
+
+
+# R6: 不正な month
+@pytest.mark.parametrize(
+    "bad", ["2026-3", "2026-13", "2026-00", "2026/03", "", "202603"]
+)
+def test_invalid_month_string_raises_value_error(bad):
+    with pytest.raises(ValueError):
+        month_over_month([], bad)
+
+
+@pytest.mark.parametrize("bad", [None, 202603, b"2026-03", date(2026, 3, 1)])
+def test_non_str_month_raises_type_error(bad):
+    with pytest.raises(TypeError):
+        month_over_month([], bad)  # type: ignore[arg-type]
+
+
+# 純粋性: 入力を変更しない
+def test_input_list_is_not_mutated():
+    rows = [e("2026-02-01", "食費", 100), e("2026-03-01", "食費", 200)]
+    snapshot = list(rows)
+    month_over_month(rows, "2026-03")
+    assert rows == snapshot
