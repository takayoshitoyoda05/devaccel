@@ -0,0 +1,68 @@
+"""Month-over-month comparison of expenses by category (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense, monthly_totals
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    diff: int
+    pct: float | None
+    status: str
+
+
+def _previous_month(month: str) -> str:
+    year, mon = int(month[:4]), int(month[5:7])
+    if mon == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mon - 1:02d}"
+
+
+def month_over_month(rows: list[Expense], month: str) -> list[CategoryChange]:
+    """Compare `month` with the calendar month right before it, per category.
+
+    Refunds (negative amounts) are netted in the totals. A category counts as
+    present in a month when it has at least one expense in that month, even if
+    its total is 0. Result is sorted by abs(diff) desc, then category asc.
+    """
+    if not isinstance(month, str):
+        raise TypeError(f"month は str である必要があります: {type(month).__name__}")
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"month は YYYY-MM 形式である必要があります: {month!r}")
+
+    totals = monthly_totals(rows)
+    prev_month = _previous_month(month)
+    prev_cats = totals.get(prev_month, {})
+    cur_cats = totals.get(month, {})
+
+    out: list[CategoryChange] = []
+    for category in set(prev_cats) | set(cur_cats):
+        previous = prev_cats.get(category, 0)
+        current = cur_cats.get(category, 0)
+        diff = current - previous
+        pct = None if previous == 0 else diff / abs(previous) * 100
+        in_prev = category in prev_cats
+        in_cur = category in cur_cats
+        if in_cur and not in_prev:
+            status = "new"
+        elif in_prev and not in_cur:
+            status = "gone"
+        elif diff > 0:
+            status = "up"
+        elif diff < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(CategoryChange(category, previous, current, diff, pct, status))
+
+    out.sort(key=lambda c: (-abs(c.diff), c.category))
+    return out
