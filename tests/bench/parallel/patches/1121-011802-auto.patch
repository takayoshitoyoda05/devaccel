+@pytest.mark.parametrize("bad", [True, False, 1.5, "100"])
+def test_amount_range_rejects_non_int(bad):
+    with pytest.raises(TypeError):
+        AmountRange(min=bad)
+    with pytest.raises(TypeError):
+        AmountRange(max=bad)
