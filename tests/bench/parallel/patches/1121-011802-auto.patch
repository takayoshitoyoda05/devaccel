+"""Detect recurring expenses (fixed monthly payments) from Expense rows.
+
+Pure functions: inputs are never modified.
+"""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_TRAILING_RE = re.compile(r"(?:\s*#\s*[0-9]+|\s*no\.\s*[0-9]+|\s*[0-9]+)$")
+_SPACE_RE = re.compile(r"\s+")
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int
+    day_of_month: int
+    months: tuple[str, ...]
+    last: date
+
+
+@dataclass
+class _Series:
+    base: int  # first amount of the series (tolerance is relative to this)
+    entries: list[Expense]  # chronological, at most one per month
+    seen_months: set[tuple[int, int]]
+
+
+def _memo_key(memo: str) -> str:
+    """D5: NFKC, casefold, collapse spaces, drop a trailing number/#n/No.n."""
+    s = unicodedata.normalize("NFKC", memo).casefold()
+    s = _SPACE_RE.sub(" ", s).strip()
+    return _TRAILING_RE.sub("", s).strip()
+
+
+def _check_min_months(value: object) -> None:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"min_months は int である必要があります: {value!r}")
+    if value < 2:
+        raise ValueError(f"min_months は 2 以上である必要があります: {value!r}")
+
+
+def _check_tolerance(value: object) -> None:
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        raise TypeError(f"amount_tolerance は数値である必要があります: {value!r}")
+    if not 0 <= value <= 1:
+        raise ValueError(
+            f"amount_tolerance は 0 以上 1 以下である必要があります: {value!r}"
+        )
+
+
+def _last_run(entries: list[Expense]) -> list[Expense]:
+    """Entries (chronological, one per month) restricted to the last consecutive run."""
+    run: list[Expense] = []
+    prev_index: int | None = None
+    for e in entries:
+        index = e.day.year * 12 + e.day.month
+        if prev_index is not None and index != prev_index + 1:
+            run = []
+        run.append(e)
+        prev_index = index
+    return run
+
+
+def find_recurring(
+    rows: list[Expense],
+    *,
+    min_months: int = 3,
+    amount_tolerance: float = 0.0,
+) -> list[Recurring]:
+    """Find expense series that recur in consecutive months.
+
+    Series key: (category, normalized memo). Amounts within ``amount_tolerance``
+    (relative to the series' first amount) belong to the same series.
+    """
+    _check_min_months(min_months)
+    _check_tolerance(amount_tolerance)
+
+    series_by_key: dict[tuple[str, str], list[_Series]] = {}
+    # Stable sort: same-day rows keep their input order.
+    for e in sorted(rows, key=lambda x: x.day):
+        if e.amount <= 0:  # R4 / D2: refunds and zero are excluded
+            continue
+        key = (e.category, _memo_key(e.memo))
+        groups = series_by_key.setdefault(key, [])
+        target = next(
+            (s for s in groups if abs(e.amount - s.base) <= amount_tolerance * s.base),
+            None,
+        )
+        if target is None:
+            target = _Series(base=e.amount, entries=[], seen_months=set())
+            groups.append(target)
+        month = (e.day.year, e.day.month)
+        if month in target.seen_months:  # R2: first entry of the month wins
+            continue
+        target.seen_months.add(month)
+        target.entries.append(e)
+
+    out: list[Recurring] = []
+    for (category, _), groups in series_by_key.items():
+        for s in groups:
+            run = _last_run(s.entries)
+            if len(run) < min_months:  # R3
+                continue
+            latest = run[-1]
+            out.append(
+                Recurring(
+                    category=category,
+                    memo=latest.memo,
+                    amount=latest.amount,  # latest value in the series
+                    day_of_month=max(e.day.day for e in run),  # R5
+                    months=tuple(f"{e.day.year:04d}-{e.day.month:02d}" for e in run),
+                    last=latest.day,
+                )
+            )
+    out.sort(key=lambda r: (r.last, r.category, r.memo))  # R6
+    return out
+
+
+def next_due(r: Recurring) -> date:
+    """Next expected date: day_of_month in the month after ``r.last``, clamped to month end."""
+    year, month = r.last.year, r.last.month + 1
+    if month == 13:
+        year, month = year + 1, 1
+    last_day = calendar.monthrange(year, month)[1]
+    return date(year, month, min(r.day_of_month, last_day))
