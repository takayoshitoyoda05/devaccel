@@ -0,0 +1,191 @@
+"""Bank / card statement CSV import. Pure: takes text, returns Expense records."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from datetime import date
+
+from kakeibo.core import CsvError, Expense
+
+
+def _norm(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip()
+
+
+def _key(s: str) -> str:
+    return _norm(s).casefold()
+
+
+def _aliases(*names: str) -> frozenset[str]:
+    return frozenset(_key(n) for n in names)
+
+
+_DATE_ALIASES = _aliases("日付", "利用日", "取引日", "ご利用日", "date")
+_AMOUNT_ALIASES = _aliases("金額", "利用金額", "ご利用金額", "amount")
+_OUT_ALIASES = _aliases("出金額", "出金", "お支払金額", "支払")
+_IN_ALIASES = _aliases("入金額", "入金", "預入")
+_MEMO_ALIASES = _aliases(
+    "摘要", "メモ", "利用店名", "ご利用店名", "内容", "description", "memo"
+)
+_CAT_ALIASES = _aliases("カテゴリ", "category")
+
+_TIME = r"(?:\s+[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?)?"
+_DATE_PATTERNS = (
+    re.compile(
+        r"(?P<y>[0-9]{4})(?P<sep>[-/.])(?P<m>[0-9]{1,2})(?P=sep)(?P<d>[0-9]{1,2})"
+        + _TIME
+    ),
+    re.compile(r"(?P<y>[0-9]{4})年(?P<m>[0-9]{1,2})月(?P<d>[0-9]{1,2})日" + _TIME),
+    re.compile(r"(?P<y>[0-9]{4})(?P<m>[0-9]{2})(?P<d>[0-9]{2})" + _TIME),
+)
+_WAREKI_RE = re.compile("令和|平成|昭和|大正|明治")
+_YEN_NOISE_RE = re.compile(r"¥|円|JPY|[,\s]", re.IGNORECASE)
+
+
+def _delimiter(text: str) -> str:
+    first = next((ln for ln in re.split(r"\r\n|\r|\n", text) if ln.strip()), "")
+    return "\t" if first.count("\t") > first.count(",") else ","
+
+
+def _parse_day(raw: str) -> date:
+    s = _norm(raw)
+    if _WAREKI_RE.search(s):
+        raise ValueError("和暦は使えません")
+    for pat in _DATE_PATTERNS:
+        m = pat.fullmatch(s)
+        if m:
+            try:
+                return date(int(m.group("y")), int(m.group("m")), int(m.group("d")))
+            except ValueError:
+                raise ValueError("存在しない日付です") from None
+    raise ValueError("形式が不正です")
+
+
+def _parse_yen(raw: str) -> int | None:
+    """Return yen (sign kept), or None when the cell means 'no amount' (blank, -, —, 0)."""
+    s = _YEN_NOISE_RE.sub("", _norm(raw).replace("−", "-"))
+    if s in ("", "-", "—"):
+        return None
+    neg = False
+    if s.startswith("-") or s[:1] in ("△", "▲"):
+        neg, s = True, s[1:]
+    elif len(s) >= 2 and s[0] == "(" and s[-1] == ")":
+        neg, s = True, s[1:-1]
+    elif s.endswith("-"):
+        neg, s = True, s[:-1]
+    if not re.fullmatch(r"[0-9]+(?:\.0+)?", s):
+        raise ValueError("整数ではありません")
+    value = int(s.split(".")[0])
+    if value == 0:
+        return None
+    return -value if neg else value
+
+
+def _yen_cell(raw: str, label: str, col: str) -> tuple[int | None, str | None]:
+    try:
+        return _parse_yen(raw), None
+    except ValueError:
+        return None, f"{label}: 列 {col!r} の値 {raw!r} は整数の金額ではありません"
+
+
+def _find(keys: list[str], aliases: frozenset[str]) -> int | None:
+    for i, k in enumerate(keys):
+        if k in aliases:
+            return i
+    return None
+
+
+def parse_bank_csv(text: str, *, default_category: str = "未分類") -> list[Expense]:
+    text = text.removeprefix("﻿")
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=_delimiter(text))
+
+    header: list[str] | None = None
+    header_line = 0
+    records: list[tuple[int, list[str]]] = []
+    prev_line = 0
+    for row in reader:
+        start = prev_line + 1  # record start line (header is line 1)
+        prev_line = reader.line_num
+        if all(not c.strip() for c in row):
+            continue
+        if header is None:
+            header, header_line = row, start
+        else:
+            records.append((start, row))
+    if header is None:
+        return []
+
+    keys = [_key(c) for c in header]
+    date_i = _find(keys, _DATE_ALIASES)
+    amount_i = _find(keys, _AMOUNT_ALIASES)
+    out_i = _find(keys, _OUT_ALIASES)
+    in_i = _find(keys, _IN_ALIASES)
+    memo_i = _find(keys, _MEMO_ALIASES)
+    cat_i = _find(keys, _CAT_ALIASES)
+    if date_i is None:
+        raise CsvError(
+            [
+                (
+                    header_line,
+                    "日付列がありません(日付・利用日・取引日・ご利用日・date のいずれか)",
+                )
+            ]
+        )
+    if amount_i is None and out_i is None and in_i is None:
+        raise CsvError(
+            [(header_line, "金額列がありません(金額・出金額・入金額 のいずれか)")]
+        )
+
+    n = len(header)
+    result: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    for start, row in records:
+        if len(row) != n:
+            errors.append((start, f"列数が合いません(期待 {n}、実際 {len(row)})"))
+            continue
+
+        row_errors: list[tuple[int, str]] = []
+        day: date | None = None
+        raw_day = row[date_i]
+        try:
+            day = _parse_day(raw_day)
+        except ValueError as e:
+            row_errors.append(
+                (start, f"日付: 列 {header[date_i]!r} の値 {raw_day!r} は不正です({e})")
+            )
+
+        amount: int | None = None
+        if amount_i is not None:
+            amount, err = _yen_cell(row[amount_i], "金額", header[amount_i])
+            if err:
+                row_errors.append((start, err))
+        else:
+            out: int | None = None
+            deposit: int | None = None
+            if out_i is not None:
+                out, err = _yen_cell(row[out_i], "金額(出金)", header[out_i])
+                if err:
+                    row_errors.append((start, err))
+            if in_i is not None:
+                deposit, err = _yen_cell(row[in_i], "金額(入金)", header[in_i])
+                if err:
+                    row_errors.append((start, err))
+            if out is not None or deposit is not None:
+                amount = (out or 0) - (deposit or 0)
+
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        if day is None or amount is None:
+            continue
+
+        category = _norm(row[cat_i]) if cat_i is not None else ""
+        memo = _norm(row[memo_i]) if memo_i is not None else ""
+        result.append(Expense(day, category or default_category, amount, memo))
+
+    if errors:
+        raise CsvError(errors)
+    return result
