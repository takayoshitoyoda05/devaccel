@@ -0,0 +1,141 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    AmountRange,
+    And,
+    Category,
+    DateRange,
+    MemoContains,
+    Not,
+    Or,
+    search,
+)
+
+ROWS = [
+    Expense(date(2026, 11, 1), "food", 1200, "Lunch"),
+    Expense(date(2026, 11, 2), "Rent", 80000, "Netflix"),
+    Expense(date(2026, 11, 3), "food", -300, "返金"),
+    Expense(date(2026, 11, 4), "fun", 500, "Netflix #2"),
+]
+
+
+# --- 例の表 (ID は仕様のまま) ---
+
+
+@pytest.mark.parametrize(
+    "query, expected",
+    [
+        pytest.param(And(), ROWS, id="E3-1"),
+        pytest.param(Or(), [], id="E3-1-or"),
+    ],
+)
+def test_e3_1_empty_and_or(query, expected):
+    assert search(ROWS, query) == expected
+
+
+def test_e3_2_amount_range_min_greater_than_max_is_value_error():
+    with pytest.raises(ValueError):
+        AmountRange(500, 100)
+
+
+def test_e3_3_memo_fullwidth_matches_ascii_case_insensitive():
+    rows = [Expense(date(2026, 11, 1), "sub", 1490, "Netflix")]
+    assert search(rows, MemoContains("ｎｅｔｆｌｉｘ")) == rows
+
+
+# --- R1 条件の構築 ---
+
+
+def test_category_exact_match_ignores_outer_space_case_and_width():
+    assert search(ROWS, Category("  FOOD ")) == [ROWS[0], ROWS[2]]
+    assert search(ROWS, Category("ｆｏｏｄ")) == [ROWS[0], ROWS[2]]
+
+
+def test_category_is_exact_not_partial():
+    assert search(ROWS, Category("foo")) == []
+
+
+def test_amount_range_inclusive_ends_and_none_unbounded():
+    assert search(ROWS, AmountRange(500, 1200)) == [ROWS[0], ROWS[3]]
+    assert search(ROWS, AmountRange(min=80000)) == [ROWS[1]]
+    assert search(ROWS, AmountRange(max=500)) == [ROWS[2], ROWS[3]]
+    assert search(ROWS, AmountRange()) == ROWS
+
+
+def test_amount_range_min_equals_max_is_allowed():
+    assert search(ROWS, AmountRange(500, 500)) == [ROWS[3]]
+
+
+def test_memo_contains_empty_text_is_always_true():
+    assert search(ROWS, MemoContains("")) == ROWS
+
+
+def test_date_range_inclusive_and_validation():
+    assert search(ROWS, DateRange(date(2026, 11, 2), date(2026, 11, 3))) == [
+        ROWS[1],
+        ROWS[2],
+    ]
+    assert search(ROWS, DateRange(start=date(2026, 11, 4))) == [ROWS[3]]
+    assert search(ROWS, DateRange(end=date(2026, 11, 1))) == [ROWS[0]]
+    with pytest.raises(ValueError):
+        DateRange(date(2026, 11, 5), date(2026, 11, 1))
+    same = DateRange(date(2026, 11, 1), date(2026, 11, 1))
+    assert search(ROWS, same) == [ROWS[0]]
+
+
+def test_and_or_not_compose_and_nest():
+    q = And(Category("food"), Not(MemoContains("返金")))
+    assert search(ROWS, q) == [ROWS[0]]
+    q2 = Or(AmountRange(min=80000), And(Category("fun"), MemoContains("netflix")))
+    assert search(ROWS, q2) == [ROWS[1], ROWS[3]]
