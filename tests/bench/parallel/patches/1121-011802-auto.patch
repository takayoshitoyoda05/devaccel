@@ -0,0 +1,279 @@
+"""Tests for kakeibo.recurring (定期支出の検出)."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, next_due
+
+
+def ex(
+    y: int,
+    m: int,
+    d: int,
+    amount: int = 1000,
+    category: str = "通信",
+    memo: str = "回線",
+) -> Expense:
+    return Expense(date(y, m, d), category, amount, memo)
+
+
+def rec(day_of_month: int, last: date) -> Recurring:
+    return Recurring(
+        category="通信",
+        memo="回線",
+        amount=1000,
+        day_of_month=day_of_month,
+        months=("2025-01",),
+        last=last,
+    )
+
+
+# --- 例の表 (E2-1 .. E2-3) ---
+
+
+def test_E2_1_month_end_rent_has_day_31_and_next_due_is_april_30():
+    """E2-1: 1/31・2/28・3/31 の家賃 80000 → day_of_month=31, next_due=4/30 (R5)"""
+    rows = [
+        ex(2025, 1, 31, 80000, "住居", "家賃"),
+        ex(2025, 2, 28, 80000, "住居", "家賃"),
+        ex(2025, 3, 31, 80000, "住居", "家賃"),
+    ]
+    [r] = find_recurring(rows)
+    assert r.day_of_month == 31
+    assert next_due(r) == date(2025, 4, 30)
+
+
+def test_E2_2_same_category_and_amount_different_memo_gives_two_series():
+    """E2-2: 同カテゴリ・同金額・別メモの 2 本(5 日と 20 日) → 2 系列 (R1)"""
+    rows = [ex(2025, m, 5, 1000, "通信", "A") for m in (1, 2, 3)] + [
+        ex(2025, m, 20, 1000, "通信", "B") for m in (1, 2, 3)
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 2
+    assert {r.memo for r in result} == {"A", "B"}
+
+
+def test_E2_3_gap_month_keeps_only_last_run_4_to_6():
+    """E2-3: 1,2,4,5,6 月(3 月欠け), min_months=3 → 4〜6 月の系列 (R3)"""
+    rows = [ex(2025, m, 10) for m in (1, 2, 4, 5, 6)]
+    [r] = find_recurring(rows, min_months=3)
+    assert r.months == ("2025-04", "2025-05", "2025-06")
+
+
+# --- R1 金額の同一視 ---
+
+
+def test_R1_tolerance_joins_amounts_within_ratio_and_reports_latest():
+    """R1: tolerance 以内の差は同じ系列、金額は系列の最新の値"""
+    rows = [ex(2025, 1, 10, 1000), ex(2025, 2, 10, 1100), ex(2025, 3, 10, 1150)]
+    [r] = find_recurring(rows, amount_tolerance=0.2)
+    assert r.amount == 1150
+    assert r.months == ("2025-01", "2025-02", "2025-03")
+
+
+def test_R1_price_rise_beyond_tolerance_splits_and_old_series_survives():
+    """R1: 値上げが tolerance を超えれば別系列。旧系列は min_months を満たせば残る"""
+    rows = [ex(2025, m, 10, 1000) for m in (1, 2, 3)] + [
+        ex(2025, m, 10, 1300) for m in (4, 5, 6)
+    ]
+    result = find_recurring(rows, amount_tolerance=0.1)
+    assert [r.amount for r in result] == [1000, 1300]
+
+
+def test_R1_zero_tolerance_splits_small_difference_and_drops_short_series():
+    """R1: 既定 tolerance=0 では 1 円差も別系列。短い旧系列は落ちる"""
+    rows = [ex(2025, m, 10, 1000) for m in (1, 2)] + [
+        ex(2025, m, 10, 1001) for m in (3, 4, 5)
+    ]
+    result = find_recurring(rows)
+    assert [r.amount for r in result] == [1001]
+
+
+# --- R2 1 系列 1 月 1 件 ---
+
+
+def test_R2_first_entry_in_month_is_kept_and_rest_ignored():
+    """R2: 同じ月の 2 件目は無視。系列は 1 本のまま、day_of_month は採用分の最大"""
+    rows = [
+        ex(2025, 1, 5),
+        ex(2025, 1, 20),
+        ex(2025, 2, 5),
+        ex(2025, 3, 5),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    [r] = result
+    assert r.day_of_month == 5
+    assert r.last == date(2025, 3, 5)
+    assert r.months == ("2025-01", "2025-02", "2025-03")
+
+
+# --- R3 繰り返しの条件 ---
+
+
+def test_R3_default_min_months_is_3():
+    """R3: 既定の min_months は 3"""
+    rows = [ex(2025, m, 10) for m in (1, 2)]
+    assert find_recurring(rows) == []
+    rows.append(ex(2025, 3, 10))
+    assert len(find_recurring(rows)) == 1
+
+
+def test_R3_min_months_2_is_accepted():
+    """R3: min_months=2 は有効"""
+    rows = [ex(2025, 1, 10), ex(2025, 2, 10)]
+    assert len(find_recurring(rows, min_months=2)) == 1
+
+
+@pytest.mark.parametrize("bad", [1, 0, -3])
+def test_R3_min_months_at_most_1_is_value_error(bad: int):
+    """R3: min_months が 1 以下は ValueError (引数名を含む)"""
+    with pytest.raises(ValueError, match="min_months"):
+        find_recurring([], min_months=bad)
+
+
+@pytest.mark.parametrize("bad", [True, 2.0, "3", None])
+def test_R3_min_months_non_int_is_type_error(bad: object):
+    """R3/D1: min_months の bool・float・str・None は TypeError (引数名を含む)"""
+    with pytest.raises(TypeError, match="min_months"):
+        find_recurring([], min_months=bad)  # type: ignore[arg-type]
+
+
+def test_R3_only_last_consecutive_run_counts_earlier_run_is_ignored():
+    """R3: 最後の連続区間だけが系列。前の区間が 3 か月あっても最後が 2 か月なら無し"""
+    rows = [ex(2025, m, 10) for m in (1, 2, 3, 5, 6)]
+    assert find_recurring(rows, min_months=3) == []
+
+
+def test_R3_consecutive_months_cross_year_boundary():
+    """R3: 12 月→翌年 1 月は連続"""
+    rows = [ex(2025, 11, 10), ex(2025, 12, 10), ex(2026, 1, 10)]
+    [r] = find_recurring(rows)
+    assert r.months == ("2025-11", "2025-12", "2026-01")
+
+
+# --- R4 負の金額・0 円は除外 ---
+
+
+def test_R4_negative_and_zero_amounts_are_excluded():
+    """R4/D2: 負の金額(返金)・0 円は系列に入らない"""
+    rows = [ex(2025, m, 10, -1000) for m in (1, 2, 3)] + [
+        ex(2025, m, 10, 0) for m in (4, 5, 6)
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_R4_refund_in_a_month_does_not_break_series():
+    """R4/D2: 返金行は除外されるだけで、同じ系列の正の行は残る"""
+    rows = [
+        ex(2025, 1, 10, 1000),
+        ex(2025, 2, 10, 1000),
+        ex(2025, 2, 15, -1000),
+        ex(2025, 3, 10, 1000),
+    ]
+    [r] = find_recurring(rows)
+    assert r.months == ("2025-01", "2025-02", "2025-03")
+    assert r.amount == 1000
+
+
+# --- R5 次回予定日 ---
+
+
+def test_R5_day_of_month_is_max_day_in_series():
+    """R5: day_of_month は系列内の日の最大値"""
+    rows = [ex(2025, 1, 5), ex(2025, 2, 20), ex(2025, 3, 10)]
+    [r] = find_recurring(rows)
+    assert r.day_of_month == 20
+
+
+def test_R5_next_due_clamps_to_end_of_month_in_common_year():
+    """R5: 1/31 系列の翌 2 月は 28 日へ丸める"""
+    assert next_due(rec(31, date(2027, 1, 31))) == date(2027, 2, 28)
+
+
+def test_R5_next_due_clamps_to_leap_day():
+    """R5: 翌年が閏年なら 2/29 へ丸める"""
+    assert next_due(rec(31, date(2028, 1, 31))) == date(2028, 2, 29)
+
+
+def test_R5_next_due_december_rolls_to_january_next_year():
+    """R5: 12 月→翌年 1 月"""
+    assert next_due(rec(15, date(2025, 12, 15))) == date(2026, 1, 15)
+
+
+def test_R5_next_due_uses_day_of_month_when_it_exists():
+    """R5: 翌月の該当日が存在すればそのまま使う"""
+    assert next_due(rec(20, date(2025, 1, 15))) == date(2025, 2, 20)
+
+
+# --- R6 並び ---
+
+
+def test_R6_sorted_by_last_then_category_then_memo():
+    """R6: last 昇順、同点は category、memo の昇順"""
+    rows = (
+        [ex(2025, m, 2, 1000, "y", "p") for m in (1, 2)]
+        + [ex(2025, 3, 2, 1000, "y", "p")]
+        + [ex(2025, m, 3, 1000, "b", "m") for m in (1, 2, 3)]
+        + [ex(2025, m, 3, 1000, "a", "n") for m in (1, 2, 3)]
+        + [ex(2025, m, 3, 1000, "a", "m") for m in (1, 2, 3)]
+    )
+    result = find_recurring(rows)
+    assert [(r.category, r.memo) for r in result] == [
+        ("y", "p"),
+        ("a", "m"),
+        ("a", "n"),
+        ("b", "m"),
+    ]
+
+
+# --- D5 メモの同一視 ---
+
+
+def test_D5_memo_variants_form_one_series():
+    """D5: NFKC・casefold・末尾の数字/#数字/No.数字 を除去して同一視"""
+    rows = [
+        ex(2025, 1, 10, 1000, "通信", "Netflix 2"),
+        ex(2025, 2, 10, 1000, "通信", "ｎｅｔｆｌｉｘ"),
+        ex(2025, 3, 10, 1000, "通信", "Netflix #3"),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_D5_no_dot_number_suffix_is_removed():
+    """D5: No.数字 の形も同一視"""
+    rows = [
+        ex(2025, 1, 10, 1000, "通信", "Netflix"),
+        ex(2025, 2, 10, 1000, "通信", "NETFLIX No.12"),
+        ex(2025, 3, 10, 1000, "通信", "netflix"),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+# --- D1 引数検証・公開関数の純粋性 ---
+
+
+@pytest.mark.parametrize("bad", [True, "0.1", None])
+def test_D1_tolerance_non_number_is_type_error(bad: object):
+    """D1: amount_tolerance の bool・str・None は TypeError (引数名を含む)"""
+    with pytest.raises(TypeError, match="amount_tolerance"):
+        find_recurring([], amount_tolerance=bad)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad", [-0.1, 1.5])
+def test_D1_tolerance_out_of_range_is_value_error(bad: float):
+    """D1: amount_tolerance が 0〜1 の範囲外なら ValueError (引数名を含む)"""
+    with pytest.raises(ValueError, match="amount_tolerance"):
+        find_recurring([], amount_tolerance=bad)
+
+
+def test_pure_input_rows_are_not_mutated():
+    """純粋: 入力リストと要素は変更されない"""
+    rows = [ex(2025, 3, 10), ex(2025, 1, 10), ex(2025, 2, 10)]
+    before = list(rows)
+    find_recurring(rows)
+    assert rows == before
