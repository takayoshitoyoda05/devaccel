+
+@pytest.mark.parametrize("bad", [None, 1, "x", Expense(date(2026, 11, 1), "a", 1)])
+def test_combinators_reject_non_query(bad):
+    with pytest.raises(TypeError):
+        And(bad)
+    with pytest.raises(TypeError):
+        Or(Category("food"), bad)
+    with pytest.raises(TypeError):
+        Not(bad)
+
+
+def test_search_rejects_non_query():
+    with pytest.raises(TypeError):
+        search(ROWS, "food")  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        search(ROWS, None)  # type: ignore[arg-type]
