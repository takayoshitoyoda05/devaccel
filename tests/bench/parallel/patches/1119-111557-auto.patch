+"""Month-over-month comparison by category (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    diff: int
+    ratio: float | None
+    kind: str  # "new" / "gone" / "up" / "down" / "same"
+
+
+def _previous_month(month: str) -> str:
+    y, m = int(month[:4]), int(month[5:7])
+    if m == 1:
+        return f"{y - 1:04d}-12"
+    return f"{y:04d}-{m - 1:02d}"
+
+
+def month_over_month(rows: list[Expense], month: str) -> list[CategoryChange]:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+    prev_month = _previous_month(month)
+
+    prev_sum: dict[str, int] = {}
+    cur_sum: dict[str, int] = {}
+    prev_seen: set[str] = set()
+    cur_seen: set[str] = set()
+    for e in rows:
+        key = e.day.strftime("%Y-%m")
+        if key == prev_month:
+            prev_sum[e.category] = prev_sum.get(e.category, 0) + e.amount
+            prev_seen.add(e.category)
+        elif key == month:
+            cur_sum[e.category] = cur_sum.get(e.category, 0) + e.amount
+            cur_seen.add(e.category)
+
+    changes: list[CategoryChange] = []
+    for cat in prev_seen | cur_seen:
+        previous = prev_sum.get(cat, 0)
+        current = cur_sum.get(cat, 0)
+        diff = current - previous
+        if cat not in prev_seen:
+            kind = "new"
+        elif cat not in cur_seen:
+            kind = "gone"
+        elif diff > 0:
+            kind = "up"
+        elif diff < 0:
+            kind = "down"
+        else:
+            kind = "same"
+        ratio = None if previous <= 0 or kind == "new" else diff / previous
+        changes.append(CategoryChange(cat, previous, current, diff, ratio, kind))
+
+    changes.sort(key=lambda c: (-abs(c.diff), c.category))
+    return changes
+
+
+def _rate(c: CategoryChange) -> str:
+    if c.kind == "new":
+        return "新規"
+    if c.kind == "gone":
+        return "消滅"
+    if c.ratio is None:
+        return "-"
+    return f"{c.ratio * 100:+.1f}%"
+
+
+def format_report(changes: list[CategoryChange]) -> str:
+    lines = [
+        f"{c.category}\t{c.previous}\t{c.current}\t{c.diff:+d}\t{_rate(c)}"
+        for c in changes
+    ]
+    return "\n".join(lines)
