+"""Tests for kakeibo.search (predicate-based filtering)."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    all_of,
+    amount_between,
+    any_of,
+    category_is,
+    date_between,
+    memo_contains,
+    not_,
+    search,
+)
+
+
+def _e(day: date, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# E3-1: category_is は名前のどれかに完全一致する(OR)
+@pytest.mark.parametrize(
+    ("cats", "expected"),
+    [
+        pytest.param(("food", "rent"), ["food", "rent"], id="E3-1"),
+    ],
+)
+def test_category_is_or(cats: tuple[str, ...], expected: list[str]) -> None:
+    rows = [_e(date(2026, 1, 1), c, 100) for c in ("food", "rent", "fun")]
+    got = search(rows, category_is(*cats))
+    assert [e.category for e in got] == expected
+
+
+# E3-2: amount_between は両端を含む / 符号付きのまま比べる
+@pytest.mark.parametrize(
+    ("pred_args", "amounts", "expected"),
+    [
+        pytest.param((1000, 2000), [999, 1000, 2000, 2001], [1000, 2000], id="E3-2a"),
+        pytest.param((None, 500), [-300], [-300], id="E3-2b"),
+    ],
+)
+def test_amount_between_inclusive(
+    pred_args: tuple[int | None, int | None],
+    amounts: list[int],
+    expected: list[int],
+) -> None:
+    rows = [_e(date(2026, 1, 1), "x", a) for a in amounts]
+    got = search(rows, amount_between(*pred_args))
+    assert [e.amount for e in got] == expected
+
+
+# E3-3: memo_contains は NFKC+casefold した部分一致。空文字は全件一致
+@pytest.mark.parametrize(
+    ("needle", "memo", "expected"),
+    [
+        pytest.param("ＮＥＴＦＬＩＸ", "netflix 月額", True, id="E3-3a"),
+        pytest.param("", "netflix 月額", True, id="E3-3b"),
+    ],
+)
+def test_memo_contains(needle: str, memo: str, expected: bool) -> None:
+    rows = [_e(date(2026, 1, 1), "x", 1, memo)]
+    assert (len(search(rows, memo_contains(needle)))) == (1 if expected else 0)
+
+
+# E3-4: date_between は両端を含む
+def test_date_between_inclusive_E3_4() -> None:
+    days = [date(2026, 1, 31), date(2026, 2, 1), date(2026, 2, 28), date(2026, 3, 1)]
+    rows = [_e(d, "x", 1) for d in days]
+    got = search(rows, date_between(date(2026, 2, 1), date(2026, 2, 28)))
+    assert [e.day for e in got] == [date(2026, 2, 1), date(2026, 2, 28)]
+
+
+# E3-5: all_of は両方満たす行のみ
+def test_all_of_E3_5() -> None:
+    rows = [
+        _e(date(2026, 1, 1), "food", 500),
+        _e(date(2026, 1, 1), "food", 501),
+        _e(date(2026, 1, 1), "rent", 100),
+    ]
+    got = search(rows, all_of(category_is("food"), amount_between(high=500)))
+    assert [(e.category, e.amount) for e in got] == [("food", 500)]
+
+
+# E3-6: any_of は OR、not_ は否定
+def test_any_of_and_not_E3_6() -> None:
+    rows = [
+        _e(date(2026, 1, 1), "rent", 1, "家賃"),
+        _e(date(2026, 1, 1), "fun", 1, "Netflix"),
+        _e(date(2026, 1, 1), "food", 1, "store"),
+    ]
+    pred = any_of(category_is("rent"), memo_contains("netflix"))
+    assert [e.category for e in search(rows, pred)] == ["rent", "fun"]
+    assert [e.category for e in search(rows, not_(pred))] == ["food"]
+
+
+# E3-7: 空の合成と単独の category_is
+@pytest.mark.parametrize(
+    ("pred", "expected_count"),
+    [
+        pytest.param(all_of(), 3, id="E3-7a"),
+        pytest.param(any_of(), 0, id="E3-7b"),
+        pytest.param(category_is(), 0, id="E3-7c"),
+    ],
+)
+def test_empty_composition_E3_7(pred: object, expected_count: int) -> None:
+    rows = [_e(date(2026, 1, 1), c, 1) for c in ("food", "rent", "fun")]
+    assert len(search(rows, pred)) == expected_count  # type: ignore[arg-type]
+
+
+# E3-8: 不正な範囲は ValueError / 入力順の保持 / 空入力
+def test_amount_between_low_gt_high_E3_8a() -> None:
+    with pytest.raises(ValueError):
+        amount_between(5, 1)
+
+
+def test_date_between_start_gt_end_E3_8b() -> None:
+    with pytest.raises(ValueError):
+        date_between(date(2026, 2, 2), date(2026, 2, 1))
+
+
+def test_order_preserved_E3_8c() -> None:
+    rows = [
+        _e(date(2026, 3, 1), "x", 3),
+        _e(date(2026, 1, 1), "x", 1),
+        _e(date(2026, 2, 1), "x", 2),
+    ]
+    got = search(rows, all_of())
+    assert [e.amount for e in got] == [3, 1, 2]
+    assert got is not rows
+
+
+def test_empty_rows_E3_8d() -> None:
+    assert search([], category_is("food")) == []
+
+
+# P1: p と not_(p) は互いに素で、合わせると rows と同じ件数
+def test_P1_partition() -> None:
+    rows = [
+        _e(date(2026, 1, 1), "food", 100),
+        _e(date(2026, 1, 2), "rent", 200),
+        _e(date(2026, 1, 3), "food", 300),
+    ]
+    p = category_is("food")
+    yes = search(rows, p)
+    no = search(rows, not_(p))
+    assert not (set(map(id, yes)) & set(map(id, no)))
+    assert len(yes) + len(no) == len(rows)
