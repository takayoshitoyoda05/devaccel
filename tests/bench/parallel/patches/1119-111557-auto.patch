+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.importer import RowError, import_statement
+
+
+@pytest.mark.parametrize(
+    "text, expected_rows, expected_skipped",
+    [
+        pytest.param(
+            '日付,摘要,出金額,入金額\n2026/11/03,スーパー,"1,280",\n2026/11/04,給与,,300000\n',
+            [Expense(date(2026, 11, 3), "未分類", 1280, "スーパー")],
+            [3],
+            id="E2-1",
+        ),
+        pytest.param(
+            "利用日,ご利用店名,利用金額\n2026年11月3日,カフェ,￥１，２００\n",
+            [Expense(date(2026, 11, 3), "未分類", 1200, "カフェ")],
+            [],
+            id="E2-2",
+        ),
+    ],
+)
+def test_example_rows_and_skipped(
+    text: str, expected_rows: list[Expense], expected_skipped: list[int]
+) -> None:
+    res = import_statement(text)
+    assert res.rows == expected_rows
+    assert res.skipped == expected_skipped
+    assert res.errors == []
+
+
+@pytest.mark.parametrize(
+    "raw, expected",
+    [
+        pytest.param("△500", -500, id="E2-3 △500"),
+        pytest.param("(500)", -500, id="E2-3 (500)"),
+        pytest.param("-500", -500, id="E2-3 -500"),
+        pytest.param("500円", 500, id="E2-3 500円"),
+    ],
+)
+def test_sign_notation(raw: str, expected: int) -> None:
+    res = import_statement(f"日付,摘要,金額\n2026/11/03,x,{raw}\n")
+    assert [e.amount for e in res.rows] == [expected]
+    assert res.errors == []
+
+
+@pytest.mark.parametrize(
+    "text, expected_rows, expected_errors",
+    [
+        pytest.param(
+            "﻿date\tamount\n\n2026-11-03\t100\n\n2026-11-04\tabc\n",
+            [Expense(date(2026, 11, 3), "未分類", 100, "")],
+            [(5, "金額")],
+            id="E2-4",
+        ),
+        pytest.param(
+            "日付,金額,摘要\n2026/02/30,100,a\n2026/02/03,200,b\n",
+            [Expense(date(2026, 2, 3), "未分類", 200, "b")],
+            [(2, "日付")],
+            id="E2-5",
+        ),
+    ],
+)
+def test_example_errors_and_rows(
+    text: str,
+    expected_rows: list[Expense],
+    expected_errors: list[tuple[int, str]],
+) -> None:
+    res = import_statement(text)
+    assert res.rows == expected_rows
+    assert [(e.line, e.column) for e in res.errors] == expected_errors
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        pytest.param("12.5", id="E2-6 12.5"),
+        pytest.param("abc", id="E2-6 abc"),
+        pytest.param("", id="E2-6 empty"),
+    ],
+)
+def test_bad_amount_is_amount_row_error(raw: str) -> None:
+    res = import_statement(f"日付,金額,摘要\n2026/11/03,{raw},x\n")
+    assert res.rows == []
+    assert [e.column for e in res.errors] == ["金額"]
+    assert res.errors[0].line == 2
+
+
+@pytest.mark.parametrize(
+    "text, expected_rows, expected_errors",
+    [
+        pytest.param(
+            "日付,摘要\n2026/11/03,x\n",
+            [],
+            [RowError(1, "金額", "列がありません")],
+            id="E2-7 no amount column",
+        ),
+        pytest.param(
+            "日付,金額,摘要\n2026/11/03,100,x\n2026/11/04,200\n",
+            [Expense(date(2026, 11, 3), "未分類", 100, "x")],
+            [RowError(3, "", "列数が 2 列です(ヘッダは 3 列)")],
+            id="E2-7 short row",
+        ),
+    ],
+)
+def test_missing_column_and_short_row(
+    text: str,
+    expected_rows: list[Expense],
+    expected_errors: list[RowError],
+) -> None:
+    res = import_statement(text)
+    assert res.rows == expected_rows
+    assert [(e.line, e.column) for e in res.errors] == [
+        (e.line, e.column) for e in expected_errors
+    ]
+    assert [e.reason for e in res.errors] == [e.reason for e in expected_errors]
+
+
+@pytest.mark.parametrize(
+    "text, expected_rows, expected_errors",
+    [
+        pytest.param(
+            '日付,摘要,金額,カテゴリ\n2026/11/03,"a,b",100,食費\n',
+            [Expense(date(2026, 11, 3), "食費", 100, "a,b")],
+            [],
+            id="E2-8 quoted comma",
+        ),
+        pytest.param(
+            '日付,金額,摘要\n2026/11/03,100,"a\nb"\n2026/02/30,200,"line1\nline2"\n',
+            [Expense(date(2026, 11, 3), "未分類", 100, "a\nb")],
+            [(5, "日付")],
+            id="E2-8 quoted newline",
+        ),
+    ],
+)
+def test_quoted_comma_newline_and_category(
+    text: str,
+    expected_rows: list[Expense],
+    expected_errors: list[tuple[int, str]],
+) -> None:
+    res = import_statement(text)
+    assert res.rows == expected_rows
+    assert [(e.line, e.column) for e in res.errors] == expected_errors
+
+
+def test_invariants_p1_p2_counts_and_ascending_error_lines() -> None:
+    text = (
+        "日付,金額,摘要\n"
+        "2026/02/30,100,a\n"
+        "2026/11/03,abc,b\n"
+        "2026/11/04,200,c\n"
+        "2026/11/05,300\n"
+    )
+    res = import_statement(text)
+    data_rows = 4
+    assert len(res.rows) + len(res.errors) + len(res.skipped) <= data_rows
+    lines = [e.line for e in res.errors]
+    assert lines == sorted(lines)
