+"""Import bank/card statement CSV text into Expense rows (pure; takes str, no file I/O)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    rows: list[Expense]
+    errors: list[RowError]
+    skipped: list[int]
+
+
+def _norm(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip().casefold()
+
+
+def _aliases(*names: str) -> frozenset[str]:
+    return frozenset(_norm(n) for n in names)
+
+
+_DATE_ALIASES = _aliases("date", "日付", "利用日", "取引日", "年月日")
+_AMOUNT_ALIASES = _aliases("amount", "金額", "利用金額", "出金額")
+_WITHDRAW_ALIASES = _aliases("出金額")
+_DEPOSIT_ALIASES = _aliases("入金額")
+_MEMO_ALIASES = _aliases(
+    "memo", "摘要", "内容", "ご利用店名", "利用店名", "ご利用店名・商品名"
+)
+_CATEGORY_ALIASES = _aliases("category", "カテゴリ", "分類")
+
+_DATE_PATTERNS = (
+    re.compile(r"(\d{4})[-/](\d{1,2})[-/](\d{1,2})"),
+    re.compile(r"(\d{4})年(\d{1,2})月(\d{1,2})日"),
+    re.compile(r"(\d{4})(\d{2})(\d{2})"),
+)
+_AMOUNT_BODY = re.compile(r"(\d+)(?:\.(\d*))?")
+_AMOUNT_JUNK = re.compile(r"[\s¥円,]")
+# △ / ▲ / ASCII hyphen-minus / MINUS SIGN (U+2212)
+_NEGATIVE_PREFIXES = ("△", "▲", "-", "−")
+
+
+def _find(header: list[str], aliases: frozenset[str]) -> int | None:
+    """Leftmost header column whose normalized name is one of the aliases."""
+    for i, name in enumerate(header):
+        if _norm(name) in aliases:
+            return i
+    return None
+
+
+def _delimiter(body: str) -> str:
+    first = next((ln for ln in body.splitlines() if ln.strip()), "")
+    return "\t" if first.count("\t") > first.count(",") else ","
+
+
+def _parse_date(raw: str) -> date:
+    text = unicodedata.normalize("NFKC", raw).strip()
+    if not text:
+        raise ValueError("日付が空です")
+    for pat in _DATE_PATTERNS:
+        m = pat.fullmatch(text)
+        if m:
+            y, mo, d = (int(g) for g in m.groups())
+            try:
+                return date(y, mo, d)
+            except ValueError:
+                raise ValueError("存在しない日付です") from None
+    raise ValueError("日付の形式が不正です")
+
+
+def _parse_amount(raw: str) -> int:
+    text = _AMOUNT_JUNK.sub("", unicodedata.normalize("NFKC", raw))
+    if not text:
+        raise ValueError("金額が空です")
+    negative = False
+    if text.startswith(_NEGATIVE_PREFIXES):
+        negative = True
+        text = text[1:]
+    elif text.startswith("(") and text.endswith(")"):
+        negative = True
+        text = text[1:-1]
+    m = _AMOUNT_BODY.fullmatch(text)
+    if m is None:
+        raise ValueError("金額が数値ではありません")
+    if (m.group(2) or "").strip("0"):
+        raise ValueError("金額は整数である必要があります")
+    value = int(m.group(1))
+    return -value if negative else value
+
+
+def _import_row(
+    cells: list[str],
+    line: int,
+    cols: dict[str, int | None],
+    default_category: str,
+) -> tuple[Expense | None, list[RowError], bool]:
+    """Return (expense, errors, skipped) for one data record."""
+
+    def cell(key: str) -> str:
+        i = cols[key]
+        return cells[i] if i is not None else ""
+
+    if cols["withdraw"] is not None:
+        if not cell("withdraw").strip() and cell("deposit").strip():
+            return None, [], True
+        amount_text = cell("withdraw")
+    else:
+        amount_text = cell("amount")
+
+    errors: list[RowError] = []
+    day: date | None = None
+    amount: int | None = None
+    try:
+        day = _parse_date(cell("date"))
+    except ValueError as e:
+        errors.append(RowError(line, "日付", str(e)))
+    try:
+        amount = _parse_amount(amount_text)
+    except ValueError as e:
+        errors.append(RowError(line, "金額", str(e)))
+    if day is None or amount is None:
+        return None, errors, False
+
+    category = cell("category").strip() or default_category
+    return Expense(day, category, amount, cell("memo").strip()), [], False
+
+
+def import_statement(text: str, default_category: str = "未分類") -> ImportResult:
+    body = text.removeprefix("﻿")
+    reader = csv.reader(io.StringIO(body, newline=""), delimiter=_delimiter(body))
+
+    rows: list[Expense] = []
+    errors: list[RowError] = []
+    skipped: list[int] = []
+    header: list[str] | None = None
+    cols: dict[str, int | None] = {}
+
+    try:
+        for record in reader:
+            if all(not c.strip() for c in record):
+                continue
+            line = reader.line_num
+            if header is None:
+                header = record
+                cols = {
+                    "date": _find(header, _DATE_ALIASES),
+                    "amount": _find(header, _AMOUNT_ALIASES),
+                    "withdraw": _find(header, _WITHDRAW_ALIASES),
+                    "deposit": _find(header, _DEPOSIT_ALIASES),
+                    "memo": _find(header, _MEMO_ALIASES),
+                    "category": _find(header, _CATEGORY_ALIASES),
+                }
+                if cols["date"] is None:
+                    errors.append(RowError(line, "日付", "列がありません"))
+                if cols["amount"] is None and cols["withdraw"] is None:
+                    errors.append(RowError(line, "金額", "列がありません"))
+                if errors:
+                    return ImportResult([], errors, [])
+                continue
+
+            if len(record) != len(header):
+                errors.append(
+                    RowError(
+                        line,
+                        "",
+                        f"列数が {len(record)} 列です(ヘッダは {len(header)} 列)",
+                    )
+                )
+                continue
+
+            expense, row_errors, is_skipped = _import_row(
+                record, line, cols, default_category
+            )
+            errors.extend(row_errors)
+            if is_skipped:
+                skipped.append(line)
+            if expense is not None:
+                rows.append(expense)
+    except csv.Error as e:
+        errors.append(RowError(reader.line_num, "", str(e)))
+
+    return ImportResult(rows, errors, skipped)
