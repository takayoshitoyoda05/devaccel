@@ -0,0 +1,172 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.compare import CategoryChange, format_report, month_over_month
+from kakeibo.core import Expense
+
+
+def E(d: str, cat: str, amount: int, memo: str = "") -> Expense:
+    return Expense(day=date.fromisoformat(d), category=cat, amount=amount, memo=memo)
+
+
+def find(changes: list[CategoryChange], cat: str) -> CategoryChange:
+    return next(c for c in changes if c.category == cat)
+
+
+# E4-1: 前月の複数行は合計され、up になる
+def test_E4_1_sums_multiple_rows_and_reports_up() -> None:
+    rows = [
+        E("2026-10-03", "food", 400),
+        E("2026-10-20", "food", 600),
+        E("2026-11-05", "food", 1500),
+    ]
+    (c,) = month_over_month(rows, "2026-11")
+    assert c == CategoryChange(
+        category="food", previous=1000, current=1500, diff=500, ratio=0.5, kind="up"
+    )
+
+
+# E4-2: 1 月は前年 12 月と比べる
+def test_E4_2_january_compares_with_previous_december() -> None:
+    rows = [
+        E("2025-12-01", "food", 2000),
+        E("2026-01-10", "food", 2500),
+        E("2026-11-10", "food", 9999),  # 無関係な月は無視
+    ]
+    (c,) = month_over_month(rows, "2026-01")
+    assert (c.previous, c.current, c.diff, c.kind) == (2000, 2500, 500, "up")
+
+
+# E4-3: 当月だけは new、前月だけは gone
+def test_E4_3_new_and_gone_categories() -> None:
+    rows = [
+        E("2026-11-02", "fun", 700),
+        E("2026-10-15", "rent", 5000),
+    ]
+    changes = month_over_month(rows, "2026-11")
+    fun = find(changes, "fun")
+    assert (fun.kind, fun.previous, fun.ratio) == ("new", 0, None)
+    rent = find(changes, "rent")
+    assert (rent.kind, rent.current, rent.diff) == ("gone", 0, -5000)
+
+
+# E4-4: 同額 / 減少 / 前月合計が負
+@pytest.mark.parametrize(
+    ("prev_amount", "cur_amount", "kind", "diff", "ratio"),
+    [
+        pytest.param(1000, 1000, "same", 0, 0.0, id="E4-4-same"),
+        pytest.param(1000, 800, "down", -200, -0.2, id="E4-4-down"),
+        pytest.param(-300, -100, "up", 200, None, id="E4-4-negative"),
+    ],
+)
+def test_E4_4_same_down_and_negative_previous(
+    prev_amount: int, cur_amount: int, kind: str, diff: int, ratio: float | None
+) -> None:
+    rows = [
+        E("2026-10-01", "food", prev_amount),
+        E("2026-11-01", "food", cur_amount),
+    ]
+    (c,) = month_over_month(rows, "2026-11")
+    assert (c.kind, c.diff, c.ratio) == (kind, diff, ratio)
+
+
+# E4-5: 変化額の絶対値が同じなら category 昇順
+def test_E4_5_ties_sorted_by_category() -> None:
+    rows = [
+        E("2026-10-01", "b", 1000),
+        E("2026-11-01", "b", 1300),
+        E("2026-10-01", "a", 1000),
+        E("2026-11-01", "a", 700),
+    ]
+    changes = month_over_month(rows, "2026-11")
+    assert [c.category for c in changes] == ["a", "b"]
+
+
+# E4-6: 2 か月以外の行だけ / rows=[] は []
+@pytest.mark.parametrize(
+    "rows",
+    [
+        pytest.param(
+            [E("2026-09-01", "food", 100), E("2026-12-01", "food", 100)],
+            id="E4-6-other-months",
+        ),
+        pytest.param([], id="E4-6-empty"),
+    ],
+)
+def test_E4_6_no_rows_in_either_month(rows: list[Expense]) -> None:
+    assert month_over_month(rows, "2026-11") == []
+
+
+# E4-7: 形式不正な month は ValueError
+@pytest.mark.parametrize(
+    "month",
+    [
+        pytest.param("2026-13", id="E4-7-13"),
+        pytest.param("", id="E4-7-empty"),
+    ],
+)
+def test_E4_7_invalid_month_raises(month: str) -> None:
+    with pytest.raises(ValueError):
+        month_over_month([], month)
+
+
+# E4-8: format_report の列と率の表記
+@pytest.mark.parametrize(
+    ("change", "line"),
+    [
+        pytest.param(
+            CategoryChange("food", 1000, 1250, 250, 0.25, "up"),
+            "food\t1000\t1250\t+250\t+25.0%",
+            id="E4-8-up",
+        ),
+        pytest.param(
+            CategoryChange("fun", 0, 700, 700, None, "new"),
+            "fun\t0\t700\t+700\t新規",
+            id="E4-8-new",
+        ),
+        pytest.param(
+            CategoryChange("rent", 5000, 0, -5000, -1.0, "gone"),
+            "rent\t5000\t0\t-5000\t消滅",
+            id="E4-8-gone",
+        ),
+        pytest.param(
+            CategoryChange("misc", 0, 300, 300, None, "up"),
+            "misc\t0\t300\t+300\t-",
+            id="E4-8-zero-previous",
+        ),
+    ],
+)
+def test_E4_8_format_report_rows(change: CategoryChange, line: str) -> None:
+    assert format_report([change]) == line
+
+
+def test_format_report_joins_lines_without_trailing_newline() -> None:
+    changes = [
+        CategoryChange("food", 1000, 1250, 250, 0.25, "up"),
+        CategoryChange("fun", 0, 700, 700, None, "new"),
+    ]
+    assert (
+        format_report(changes)
+        == "food\t1000\t1250\t+250\t+25.0%\nfun\t0\t700\t+700\t新規"
+    )
+
+
+def test_format_report_empty_list() -> None:
+    assert format_report([]) == ""
+
+
+# 不変条件 P1 / P2
+def test_invariants_diff_and_total_change() -> None:
+    rows = [
+        E("2026-10-01", "food", 1000),
+        E("2026-10-02", "rent", 5000),
+        E("2026-11-01", "food", 1500),
+        E("2026-11-02", "fun", 700),
+    ]
+    changes = month_over_month(rows, "2026-11")
+    for c in changes:
+        assert c.diff == c.current - c.previous
+    assert sum(c.diff for c in changes) == (1500 + 700) - (1000 + 5000)
