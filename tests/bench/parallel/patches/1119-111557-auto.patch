+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,89 @@
+"""Detect recurring expenses and predict their next due date."""
+
+from __future__ import annotations
+
+import calendar
+import unicodedata
+from collections import defaultdict
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str  # 最新行の元の綴り
+    amount: int  # 最新行の金額
+    months: int  # 連続した月数
+    last_date: date  # 最新行の日付
+    anchor_day: int  # run 内の日の最大値
+
+
+def _norm_memo(memo: str) -> str:
+    return unicodedata.normalize("NFKC", memo).strip().casefold()
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + (d.month - 1)
+
+
+def find_recurring(rows: list[Expense], min_months: int = 3) -> list[Recurring]:
+    if min_months < 2:
+        raise ValueError("min_months は 2 以上である必要があります")
+
+    # R1: 金額 0 以下(返金・戻し)は無視する。R2: キーは (category, 正規化 memo)。
+    groups: dict[tuple[str, str], list[Expense]] = defaultdict(list)
+    for e in rows:
+        if e.amount <= 0:
+            continue
+        groups[(e.category, _norm_memo(e.memo))].append(e)
+
+    found: list[Recurring] = []
+    for group in groups.values():
+        by_month: dict[int, list[Expense]] = defaultdict(list)
+        for e in group:
+            by_month[_month_index(e.day)].append(e)
+        # R2: 1 か月に 2 行以上ある月があれば定期でない
+        if any(len(v) >= 2 for v in by_month.values()):
+            continue
+
+        # R3: 最新月から暦月が連続する run
+        run: list[Expense] = []
+        idx = max(by_month)
+        while idx in by_month:
+            run.append(by_month[idx][0])
+            idx -= 1
+        if len(run) < min_months:
+            continue
+
+        # D1: 金額の最大-最小が最大の 10% 以内
+        hi = max(e.amount for e in run)
+        lo = min(e.amount for e in run)
+        if (hi - lo) * 10 > hi:
+            continue
+
+        latest = run[0]
+        found.append(
+            Recurring(
+                category=latest.category,
+                memo=latest.memo,
+                amount=latest.amount,
+                months=len(run),
+                last_date=latest.day,
+                anchor_day=max(e.day.day for e in run),
+            )
+        )
+
+    # R4: 金額降順、同点は category・memo 昇順
+    found.sort(key=lambda r: (-r.amount, r.category, r.memo))
+    return found
+
+
+def next_due(r: Recurring) -> date:
+    """R5: last_date の翌月の min(anchor_day, その月の末日)。"""
+    year, month0 = divmod(_month_index(r.last_date) + 1, 12)
+    month = month0 + 1
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(r.anchor_day, last))
