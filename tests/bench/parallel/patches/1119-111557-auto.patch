+"""Tests for kakeibo.recurring (表 E1-1 … E1-8 と規則 R1–R6)。"""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, next_due
+
+
+def _rows(category: str, memo: str, amount: int, days: list[date]) -> list[Expense]:
+    return [Expense(day=d, category=category, amount=amount, memo=memo) for d in days]
+
+
+def test_e1_1_monthly_rent_detected_with_anchor_day() -> None:
+    """E1-1: housing/家賃 4000 が 2026-08〜11 の各 5 日 → months=4, anchor_day=5, next_due=2026-12-05。"""
+    rows = _rows(
+        "housing",
+        "家賃",
+        4000,
+        [date(2026, 8, 5), date(2026, 9, 5), date(2026, 10, 5), date(2026, 11, 5)],
+    )
+    result = find_recurring(rows)
+    assert result == [
+        Recurring(
+            category="housing",
+            memo="家賃",
+            amount=4000,
+            months=4,
+            last_date=date(2026, 11, 5),
+            anchor_day=5,
+        )
+    ]
+    assert next_due(result[0]) == date(2026, 12, 5)
+
+
+def test_e1_2_next_due_rolls_into_next_year_for_december_end() -> None:
+    """E1-2: 最新が 2026-12-20 の 3 か月 → next_due=2027-01-20。"""
+    rows = _rows(
+        "utility",
+        "電気",
+        3000,
+        [date(2026, 10, 20), date(2026, 11, 20), date(2026, 12, 20)],
+    )
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert next_due(result[0]) == date(2027, 1, 20)
+
+
+def test_e1_3_anchor_day_31_clamped_to_month_end() -> None:
+    """E1-3: 2026-01-31, 02-28, 03-31 の同額 → anchor_day=31, next_due=2026-04-30。"""
+    rows = _rows(
+        "phone",
+        "通信費",
+        5000,
+        [date(2026, 1, 31), date(2026, 2, 28), date(2026, 3, 31)],
+    )
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].anchor_day == 31
+    assert next_due(result[0]) == date(2026, 4, 30)
+
+
+@pytest.mark.parametrize(
+    ("days", "expected"),
+    [
+        # E1-4 (a): 2027-11-30, 12-30, 2028-01-30 → 2028-02-29(閏年)
+        (
+            [date(2027, 11, 30), date(2027, 12, 30), date(2028, 1, 30)],
+            date(2028, 2, 29),
+        ),
+        # E1-4 (b): 2028-11-30, 2028-12-30, 2029-01-30 → 2029-02-28
+        (
+            [date(2028, 11, 30), date(2028, 12, 30), date(2029, 1, 30)],
+            date(2029, 2, 28),
+        ),
+    ],
+    ids=["E1-4-a", "E1-4-b"],
+)
+def test_e1_4_next_due_clamps_to_february_end(days: list[date], expected: date) -> None:
+    rows = _rows("subscription", "サブスク", 1500, days)
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert next_due(result[0]) == expected
+
+
+@pytest.mark.parametrize(
+    "rows",
+    [
+        # E1-5: 3 月が欠けている(run は 4,5 月の 2 か月)
+        _rows(
+            "housing",
+            "家賃",
+            4000,
+            [date(2026, 1, 5), date(2026, 2, 5), date(2026, 4, 5), date(2026, 5, 5)],
+        ),
+        # E1-5: 2 か月だけ
+        _rows("housing", "家賃", 4000, [date(2026, 4, 5), date(2026, 5, 5)]),
+        # E1-5: 空リスト
+        [],
+    ],
+    ids=["E1-5-gap", "E1-5-two-months", "E1-5-empty"],
+)
+def test_e1_5_not_enough_contiguous_months_returns_empty(rows: list[Expense]) -> None:
+    assert find_recurring(rows) == []
+
+
+def test_e1_6_duplicate_in_one_month_disqualifies_key() -> None:
+    """E1-6: 同メモで 11 月に 2 行ある 3 か月分 → []。"""
+    rows = _rows(
