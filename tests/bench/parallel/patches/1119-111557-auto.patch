@@ -0,0 +1,68 @@
+"""Predicate-based search over Expense rows (pure functions)."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable
+from datetime import date
+
+from kakeibo.core import Expense
+
+Predicate = Callable[[Expense], bool]
+
+
+def _norm(text: str) -> str:
+    return unicodedata.normalize("NFKC", text).casefold()
+
+
+def category_is(*names: str) -> Predicate:
+    """カテゴリが名前のどれかに(strip 後)完全一致する。名前なしは何にも一致しない。"""
+    wanted = frozenset(n.strip() for n in names)
+    return lambda e: e.category.strip() in wanted
+
+
+def amount_between(low: int | None = None, high: int | None = None) -> Predicate:
+    """両端を含む。None は無制限。金額は符号付きのまま比べる。"""
+    if low is not None and high is not None and low > high:
+        raise ValueError(f"low({low}) > high({high})")
+
+    def pred(e: Expense) -> bool:
+        return (low is None or e.amount >= low) and (high is None or e.amount <= high)
+
+    return pred
+
+
+def memo_contains(text: str) -> Predicate:
+    """NFKC + casefold した部分一致。空文字は全件一致。"""
+    needle = _norm(text)
+    return lambda e: needle in _norm(e.memo)
+
+
+def date_between(start: date | None = None, end: date | None = None) -> Predicate:
+    """両端を含む。None は無制限。"""
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"start({start}) > end({end})")
+
+    def pred(e: Expense) -> bool:
+        return (start is None or e.day >= start) and (end is None or e.day <= end)
+
+    return pred
+
+
+def all_of(*preds: Predicate) -> Predicate:
+    """全て満たす。空なら True。"""
+    return lambda e: all(p(e) for p in preds)
+
+
+def any_of(*preds: Predicate) -> Predicate:
+    """どれか満たす。空なら False。"""
+    return lambda e: any(p(e) for p in preds)
+
+
+def not_(pred: Predicate) -> Predicate:
+    return lambda e: not pred(e)
+
+
+def search(rows: list[Expense], pred: Predicate) -> list[Expense]:
+    """入力順を保った新しいリストを返す。"""
+    return [e for e in rows if pred(e)]
