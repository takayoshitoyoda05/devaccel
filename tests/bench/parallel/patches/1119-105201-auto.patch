--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,102 @@
+"""Detect recurring (fixed-interval monthly) expenses."""
+
+from __future__ import annotations
+
+import calendar
+import statistics
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    key: str
+    category: str
+    amount: int  # yen, amount in the latest month
+    day_of_month: int
+    months: tuple[str, ...]  # "YYYY-MM", ascending, contiguous
+    last_date: date
+    next_date: date
+
+
+def _ym(year: int, month: int) -> str:
+    return f"{year:04d}-{month:02d}"
+
+
+def _prev_month(year: int, month: int) -> tuple[int, int]:
+    return (year - 1, 12) if month == 1 else (year, month - 1)
+
+
+def next_due(last: date, day_of_month: int) -> date:
+    """Day `day_of_month` of the month after `last`, clipped to month end."""
+    if not 1 <= day_of_month <= 31:
+        raise ValueError(f"日は 1〜31 で指定してください: {day_of_month}")
+    if last.month == 12:
+        year, month = last.year + 1, 1
+    else:
+        year, month = last.year, last.month + 1
+    last_day = calendar.monthrange(year, month)[1]
+    return date(year, month, min(day_of_month, last_day))
+
+
+def find_recurring(
+    rows: list[Expense],
+    *,
+    min_months: int = 3,
+    amount_tolerance: float = 0.0,
+) -> list[Recurring]:
+    if min_months < 2:
+        raise ValueError(f"min_months は 2 以上で指定してください: {min_months}")
+    if amount_tolerance < 0:
+        raise ValueError(
+            f"amount_tolerance は 0 以上で指定してください: {amount_tolerance}"
+        )
+
+    # (category, normalized memo) -> {"YYYY-MM": [expenses in that month]}
+    groups: dict[tuple[str, str], dict[str, list[Expense]]] = {}
+    for e in rows:
+        gkey = (e.category, e.memo.strip().casefold())
+        by_month = groups.setdefault(gkey, {})
+        by_month.setdefault(_ym(e.day.year, e.day.month), []).append(e)
+
+    found: list[Recurring] = []
+    for (category, norm), by_month in groups.items():
+        last_ym = max(by_month)
+        last_entries = by_month[last_ym]
+        if len(last_entries) != 1:
+            continue
+        ref = last_entries[0].amount
+
+        run: list[Expense] = []  # newest first
+        year, month = int(last_ym[:4]), int(last_ym[5:])
+        while True:
+            entries = by_month.get(_ym(year, month))
+            if not entries or len(entries) != 1:
+                break
+            e = entries[0]
+            if abs(e.amount - ref) > amount_tolerance * abs(ref):
+                break
+            run.append(e)
+            year, month = _prev_month(year, month)
+
+        if len(run) < min_months:
+            continue
+        run.reverse()  # ascending
+        latest = run[-1]
+        day_of_month = statistics.median_low([e.day.day for e in run])
+        found.append(
+            Recurring(
+                key=f"{category}:{norm}",
+                category=category,
+                amount=latest.amount,
+                day_of_month=day_of_month,
+                months=tuple(_ym(e.day.year, e.day.month) for e in run),
+                last_date=latest.day,
+                next_date=next_due(latest.day, day_of_month),
+            )
+        )
+
+    found.sort(key=lambda r: (r.next_date, r.category, r.key))
+    return found
