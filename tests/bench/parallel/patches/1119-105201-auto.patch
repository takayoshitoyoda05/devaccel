+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.importer import (
+    ImportFormatError,
+    ImportResult,
+    RowError,
+    parse_statement,
+)
+
+
+def test_slash_date_and_quoted_amount_becomes_expense() -> None:
+    text = '日付,摘要,出金\n2026/11/03,スーパー,"1,200"\n'
+    result = parse_statement(text)
+    assert result == ImportResult(
+        [Expense(date(2026, 11, 3), "未分類", 1200, "スーパー")], []
+    )
+
+
+def test_bad_row_is_reported_and_good_row_is_kept() -> None:
+    text = (
+        "利用日,ご利用金額,ご利用店名・商品名\n"
+        "2026年11月3日,¥3,980円,書店\n"
+        "2026-13-01,500,x\n"
+    )
+    result = parse_statement(text)
+    assert result.expenses == [Expense(date(2026, 11, 3), "未分類", 3980, "書店")]
+    assert result.errors == [
+        RowError(
+            line=3,
+            column="利用日",
+            reason="日付の形式が不正です: '2026-13-01'",
+            raw="2026-13-01,500,x",
+        )
+    ]
+
+
+def test_empty_text_raises_format_error() -> None:
+    with pytest.raises(ImportFormatError):
+        parse_statement("")
+
+
+def test_blank_only_text_raises_format_error() -> None:
+    with pytest.raises(ImportFormatError):
+        parse_statement("\n \n\n")
+
+
+def test_bom_only_raises_format_error() -> None:
+    with pytest.raises(ImportFormatError):
+        parse_statement("﻿")
+
+
+def test_format_error_is_value_error() -> None:
+    assert issubclass(ImportFormatError, ValueError)
+
+
+def test_header_only_returns_empty_result() -> None:
+    assert parse_statement("date,amount\n") == ImportResult([], [])
+
+
+def test_header_with_category_but_no_rows_returns_empty_result() -> None:
+    assert parse_statement("date,amount,category\n") == ImportResult([], [])
+
+
+def test_missing_date_column_raises() -> None:
+    with pytest.raises(ImportFormatError):
+        parse_statement("memo,amount\nx,100\n")
+
+
+def test_missing_amount_column_raises() -> None:
+    with pytest.raises(ImportFormatError):
+        parse_statement("date,memo\n2026-11-01,x\n")
+
+
+def test_bom_is_ignored() -> None:
+    result = parse_statement("﻿date,amount\n2026-11-01,100\n")
+    assert result == ImportResult([Expense(date(2026, 11, 1), "未分類", 100, "")], [])
+
+
+def test_fullwidth_digits_in_amount() -> None:
+    result = parse_statement("date,amount\n2026-11-01,１２００\n")
+    assert result.expenses[0].amount == 1200
+
+
+@pytest.mark.parametrize(
+    "cell", ["1,200", "¥1,200", "￥1,200", "1200円", "１２００", " 1,200 円 "]
+)
+def test_amount_forms_normalize_to_integer(cell: str) -> None:
+    result = parse_statement(f'date,amount\n2026-11-01,"{cell}"\n')
+    assert result.expenses == [Expense(date(2026, 11, 1), "未分類", 1200, "")]
+    assert result.errors == []
+
+
+@pytest.mark.parametrize(
+    "header",
+    [
+        "取引日,金額,摘要",
+        "Date,Amount,Memo",
+        "年月日,支払金額,内容",
+        "ご利用日,出金金額,description",
+    ],
+)
+def test_header_aliases_are_recognized(header: str) -> None:
+    result = parse_statement(f"{header}\n2026-11-01,300,メモ\n")
+    assert result.expenses == [Expense(date(2026, 11, 1), "未分類", 300, "メモ")]
+    assert result.errors == []
+
+
+def test_leftmost_alias_wins_for_same_role() -> None:
+    text = "日付,date,金額,amount\n2026-11-05,2026-11-06,100,200\n"
+    result = parse_statement(text)
+    assert result.expenses == [Expense(date(2026, 11, 5), "未分類", 100, "")]
+
+
+def test_category_column_is_used() -> None:
+    result = parse_statement("date,amount,category\n2026-11-01,100,食費\n")
+    assert result.expenses[0].category == "食費"
+
+
+def test_blank_category_cell_uses_default() -> None:
+    result = parse_statement("date,amount,category\n2026-11-01,100,  \n")
+    assert result.expenses[0].category == "未分類"
+
+
+def test_missing_category_column_uses_given_default() -> None:
+    result = parse_statement("date,amount\n2026-11-01,100\n", default_category="雑費")
+    assert result.expenses[0].category == "雑費"
+
+
+def test_missing_memo_column_gives_empty_memo() -> None:
+    result = parse_statement("date,amount\n2026-11-01,100\n")
+    assert result.expenses[0].memo == ""
+
+
+@pytest.mark.parametrize(
+    ("cell", "expected"),
+    [
+        ("2026-11-03", date(2026, 11, 3)),
+        ("2026/11/03", date(2026, 11, 3)),
+        ("2026/1/3", date(2026, 1, 3)),
+        ("2026年11月3日", date(2026, 11, 3)),
+        ("20261103", date(2026, 11, 3)),
+    ],
+)
+def test_five_date_formats_are_accepted(cell: str, expected: date) -> None:
+    result = parse_statement(f'date,amount\n"{cell}",100\n')
+    assert result.expenses == [Expense(expected, "未分類", 100, "")]
+    assert result.errors == []
+
+
+@pytest.mark.parametrize("cell", ["2026.11.03", "11/03/2026"])
+def test_unrecognized_date_format_reason(cell: str) -> None:
+    result = parse_statement(f'date,amount\n"{cell}",100\n')
+    assert result.errors == [
+        RowError(
+            line=2,
+            column="date",
+            reason=f"日付の形式が不正です: '{cell}'",
+            raw=f'"{cell}",100',
+        )
+    ]
+
+
+def test_nonexistent_date_has_same_reason() -> None:
+    result = parse_statement("date,amount\n2026/02/30,100\n")
+    assert result.expenses == []
+    assert result.errors[0].reason == "日付の形式が不正です: '2026/02/30'"
+
+
+@pytest.mark.parametrize("cell", ["12.5", "abc", ""])
+def test_non_integer_amount_reason(cell: str) -> None:
+    result = parse_statement(f'date,amount\n2026-11-01,"{cell}"\n')
+    assert result.expenses == []
+    assert result.errors == [
+        RowError(
+            line=2,
+            column="amount",
+            reason=f"金額が整数ではありません: '{cell}'",
+            raw=f'2026-11-01,"{cell}"',
+        )
+    ]
+
+
+@pytest.mark.parametrize("cell", ["0", "-500", "▲500", "△500"])
+def test_zero_or_negative_amount_reason(cell: str) -> None:
+    result = parse_statement(f'date,amount\n2026-11-01,"{cell}"\n')
+    assert result.expenses == []
+    assert result.errors[0].reason == (
+        f"金額は 1 円以上が必要です(入金・返金は対象外): '{cell}'"
+    )
+
+
+def test_short_row_has_no_column_and_count_reason() -> None:
+    result = parse_statement("date,memo,amount\n2026-11-01\n")
+    assert result.errors == [
+        RowError(
+            line=2,
+            column=None,
+            reason="列数が足りません(期待 3 列、実際 1 列)",
+            raw="2026-11-01",
+        )
+    ]
+
+
+def test_date_error_is_reported_before_amount_error() -> None:
+    result = parse_statement("date,amount\nxx,abc\n")
+    assert len(result.errors) == 1
+    assert result.errors[0].column == "date"
+    assert result.errors[0].reason == "日付の形式が不正です: 'xx'"
+
+
+def test_amount_error_uses_original_header_text() -> None:
+    result = parse_statement("date,利用金額\n2026-11-01,0\n")
+    assert len(result.errors) == 1
+    assert result.errors[0].column == "利用金額"
+
+
+def test_blank_lines_keep_physical_line_numbers() -> None:
+    text = "date,amount\n\n2026-11-01,100\n\n2026-11-02,abc\n"
+    result = parse_statement(text)
+    assert result.expenses == [Expense(date(2026, 11, 1), "未分類", 100, "")]
+    assert result.errors == [
+        RowError(
+            line=5,
+            column="amount",
+            reason="金額が整数ではありません: 'abc'",
+            raw="2026-11-02,abc",
+        )
+    ]
+
+
+def test_blank_lines_before_header_are_counted() -> None:
+    result = parse_statement("\n\ndate,amount\n2026-13-01,100\n")
+    assert result.errors[0].line == 4
+
+
+def test_expenses_keep_file_order_and_errors_sorted_by_line() -> None:
+    text = "date,amount\n2026-11-05,300\nbad,1\n2026-11-01,100\n2026-11-02,0\n"
+    result = parse_statement(text)
+    assert [e.amount for e in result.expenses] == [300, 100]
+    assert [r.line for r in result.errors] == [3, 5]
diff --git a/tests/test_monthly_diff.py b/tests/test_monthly_diff.py
new file mode 100644
index 0000000..29b4858
--- /dev/null
+++ b/tests/test_monthly_diff.py
@@ -0,0 +1,191 @@
+from __future__ import annotations
+
+import dataclasses
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthly_diff import CategoryDiff, compare_months, render_diff
+
+
+def _e(y: int, m: int, category: str, amount: int) -> Expense:
+    return Expense(day=date(y, m, 5), category=category, amount=amount, memo="")
+
+
+def _example_rows() -> list[Expense]:
+    return [
+        _e(2026, 10, "food", 10000),
+        _e(2026, 10, "rent", 80000),
+        _e(2026, 10, "game", 3000),
+        _e(2026, 11, "food", 11500),
+        _e(2026, 11, "rent", 80000),
+        _e(2026, 11, "cafe", 700),
+    ]
+
+
+def _by_cat(diffs: list[CategoryDiff]) -> dict[str, CategoryDiff]:
+    return {d.category: d for d in diffs}
+
+
+# --- 正常系: 5 種の status と値 ---
+
+
+def test_example_values_and_statuses() -> None:
+    diffs = _by_cat(compare_months(_example_rows(), "2026-11"))
+    assert diffs["food"] == CategoryDiff("food", 10000, 11500, 1500, 0.15, "up")
+    assert diffs["rent"] == CategoryDiff("rent", 80000, 80000, 0, 0.0, "same")
+    assert diffs["game"] == CategoryDiff("game", 3000, 0, -3000, -1.0, "gone")
+    assert diffs["cafe"] == CategoryDiff("cafe", 0, 700, 700, None, "new")
+
+
+def test_down_status() -> None:
+    rows = [_e(2026, 10, "food", 10000), _e(2026, 11, "food", 4000)]
+    (d,) = compare_months(rows, "2026-11")
+    assert d == CategoryDiff("food", 10000, 4000, -6000, -0.6, "down")
+
+
+def test_same_status_with_nonzero_totals() -> None:
+    rows = [_e(2026, 10, "food", 500), _e(2026, 11, "food", 500)]
+    (d,) = compare_months(rows, "2026-11")
+    assert d.status == "same"
+    assert d.delta == 0
+    assert d.ratio == 0.0
+
+
+def test_multiple_rows_in_month_are_summed() -> None:
+    rows = [
+        _e(2026, 10, "food", 1000),
+        _e(2026, 10, "food", 2000),
+        _e(2026, 11, "food", 500),
+        _e(2026, 11, "food", 500),
+    ]
+    (d,) = compare_months(rows, "2026-11")
+    assert (d.previous, d.current, d.delta) == (3000, 1000, -2000)
+
+
+def test_result_order_example() -> None:
+    diffs = compare_months(_example_rows(), "2026-11")
+    assert [d.category for d in diffs] == ["game", "food", "cafe", "rent"]
+
+
+def test_category_diff_is_frozen() -> None:
+    d = CategoryDiff("food", 1, 2, 1, 1.0, "up")
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        d.delta = 5  # type: ignore[misc]
+
+
+# --- 端・年またぎ・前月が空・空入力 ---
+
+
+def test_year_crossover_compares_with_previous_december() -> None:
+    rows = [
+        _e(2026, 12, "food", 9000),
+        _e(2027, 1, "food", 9500),
+        _e(2026, 11, "food", 1),  # 前々月は無視される
+    ]
+    (d,) = compare_months(rows, "2027-01")
+    assert d == CategoryDiff("food", 9000, 9500, 500, 500 / 9000, "up")
+
+
+def test_january_ignores_november_rows() -> None:
+    rows = [_e(2026, 11, "food", 100), _e(2027, 1, "food", 200)]
+    (d,) = compare_months(rows, "2027-01")
+    assert d.previous == 0
+    assert d.status == "new"
+
+
+def test_empty_previous_month_makes_everything_new() -> None:
+    rows = [_e(2026, 11, "food", 300), _e(2026, 11, "rent", 800)]
+    diffs = compare_months(rows, "2026-11")
+    assert {d.status for d in diffs} == {"new"}
+    assert all(d.ratio is None for d in diffs)
+    assert [d.category for d in diffs] == ["rent", "food"]
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert compare_months([], "2026-11") == []
+
+
+def test_categories_absent_in_both_months_are_excluded() -> None:
+    rows = [
+        _e(2026, 9, "old", 100),  # 前々月のみ
+        _e(2026, 12, "later", 100),  # 翌月のみ
+        _e(2026, 10, "food", 100),
+        _e(2026, 11, "food", 100),
+    ]
+    diffs = compare_months(rows, "2026-11")
+    assert [d.category for d in diffs] == ["food"]
+
+
+def test_input_list_is_not_mutated() -> None:
+    rows = _example_rows()
+    snapshot = list(rows)
+    compare_months(rows, "2026-11")
+    assert rows == snapshot
+
+
+# --- 並び順 ---
+
+
+def test_ties_on_abs_delta_are_sorted_by_category() -> None:
+    rows = [
+        _e(2026, 10, "c", 2000),
+        _e(2026, 11, "c", 2500),  # +500
+        _e(2026, 10, "a", 1000),
+        _e(2026, 11, "a", 1500),  # +500
+        _e(2026, 10, "b", 1000),
+        _e(2026, 11, "b", 500),  # -500
+    ]
+    diffs = compare_months(rows, "2026-11")
+    assert [d.category for d in diffs] == ["a", "b", "c"]
+
+
+# --- render_diff ---
+
+
+def test_render_empty_returns_empty_string() -> None:
+    assert render_diff([]) == ""
+
+
+def test_render_single_row_format() -> None:
+    diffs = [CategoryDiff("food", 10000, 11500, 1500, 0.15, "up")]
+    assert render_diff(diffs) == (
+        "food\t10,000\t11,500\t+1,500\t+15.0%\nTOTAL\t10,000\t11,500\t+1,500\t+15.0%\n"
+    )
+
+
+def test_render_example_full_output_with_total() -> None:
+    out = render_diff(compare_months(_example_rows(), "2026-11"))
+    assert out == (
+        "game\t3,000\t0\t-3,000\t-100.0%\n"
+        "food\t10,000\t11,500\t+1,500\t+15.0%\n"
+        "cafe\t0\t700\t+700\t-\n"
+        "rent\t80,000\t80,000\t+0\t+0.0%\n"
+        "TOTAL\t93,000\t92,200\t-800\t-0.9%\n"
+    )
+
+
+def test_render_none_ratio_shows_dash() -> None:
+    out = render_diff([CategoryDiff("cafe", 0, 700, 700, None, "new")])
+    assert out.splitlines()[0] == "cafe\t0\t700\t+700\t-"
+
+
+def test_render_total_dash_when_total_previous_is_zero() -> None:
+    out = render_diff([CategoryDiff("cafe", 0, 700, 700, None, "new")])
+    assert out.splitlines()[-1] == "TOTAL\t0\t700\t+700\t-"
+
+
+def test_render_ends_with_single_newline() -> None:
+    out = render_diff(compare_months(_example_rows(), "2026-11"))
+    assert out.endswith("\n")
+    assert not out.endswith("\n\n")
+
+
+# --- 例外 ---
+
+
+@pytest.mark.parametrize("bad", ["2026-13", "202611", "", "2026-00", "2026-1", "26-11"])
+def test_invalid_month_raises_value_error(bad: str) -> None:
+    with pytest.raises(ValueError):
+        compare_months([], bad)
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..649be72
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,239 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, next_due
+
+
+def _row(day: str, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+# --- next_due -------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("last", "dom", "expected"),
+    [
+        (date(2026, 1, 31), 31, date(2026, 2, 28)),  # 平年の 2 月に丸める
+        (date(2026, 12, 15), 15, date(2027, 1, 15)),  # 12 月 → 翌年 1 月
+        (date(2024, 1, 31), 31, date(2024, 2, 29)),  # うるう年の 2 月
+        (date(2026, 3, 1), 31, date(2026, 4, 30)),  # 30 日までの月に丸める
+        (date(2026, 11, 30), 31, date(2026, 12, 31)),  # 31 日がある月はそのまま
+    ],
+)
+def test_next_due_examples(last: date, dom: int, expected: date) -> None:
+    assert next_due(last, dom) == expected
+
+
+@pytest.mark.parametrize("dom", [0, 32, -1])
+def test_next_due_rejects_bad_day(dom: int) -> None:
+    with pytest.raises(ValueError):
+        next_due(date(2026, 1, 1), dom)
+
+
+# --- find_recurring: basic detection --------------------------------------
+
+
+def test_rent_monthly_detected() -> None:
+    rows = [
+        _row("2026-08-01", "rent", 80000),
+        _row("2026-09-01", "rent", 80000),
+        _row("2026-10-01", "rent", 80000),
+    ]
+    assert find_recurring(rows) == [
+        Recurring(
+            key="rent:",
+            category="rent",
+            amount=80000,
+            day_of_month=1,
+            months=("2026-08", "2026-09", "2026-10"),
+            last_date=date(2026, 10, 1),
+            next_date=date(2026, 11, 1),
+        )
+    ]
+
+
+def test_missing_month_breaks_run() -> None:
+    rows = [
+        _row("2026-08-01", "rent", 80000),
+        _row("2026-09-01", "rent", 80000),
+        _row("2026-11-01", "rent", 80000),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_fewer_than_min_months_not_detected() -> None:
+    rows = [
+        _row("2026-09-01", "rent", 80000),
+        _row("2026-10-01", "rent", 80000),
+    ]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_months=2)) == 1
+
+
+def test_december_to_january_is_contiguous() -> None:
+    rows = [
+        _row("2026-11-05", "utility", 5000, "電気"),
+        _row("2026-12-05", "utility", 5000, "電気"),
+        _row("2027-01-05", "utility", 5000, "電気"),
+    ]
+    assert find_recurring(rows) == [
+        Recurring(
+            key="utility:電気",
+            category="utility",
+            amount=5000,
+            day_of_month=5,
+            months=("2026-11", "2026-12", "2027-01"),
+            last_date=date(2027, 1, 5),
+            next_date=date(2027, 2, 5),
+        )
+    ]
+
+
+def test_same_month_duplicate_breaks_run() -> None:
+    rows = [
+        _row("2026-06-01", "sub", 1000, "x"),
+        _row("2026-07-01", "sub", 1000, "x"),
+        _row("2026-08-01", "sub", 1000, "x"),
+        _row("2026-08-15", "sub", 1000, "x"),  # 同じ月に 2 件目
+        _row("2026-09-01", "sub", 1000, "x"),
+        _row("2026-10-01", "sub", 1000, "x"),
+    ]
+    # 9・10 月の 2 か月だけが連続。8 月の重複で途切れる
+    assert find_recurring(rows, min_months=3) == []
+    result = find_recurring(rows, min_months=2)
+    assert len(result) == 1
+    assert result[0].months == ("2026-09", "2026-10")
+
+
+def test_duplicate_in_latest_month_is_not_recurring() -> None:
+    rows = [
+        _row("2026-08-01", "rent", 80000),
+        _row("2026-09-01", "rent", 80000),
+        _row("2026-10-01", "rent", 80000),
+        _row("2026-10-20", "rent", 80000),
+    ]
+    assert find_recurring(rows, min_months=2) == []
+
+
+def test_day_of_month_is_median_low() -> None:
+    rows = [
+        _row("2026-08-10", "gym", 500),
+        _row("2026-09-20", "gym", 500),
+        _row("2026-10-30", "gym", 500),
+        _row("2026-11-20", "gym", 500),
+    ]
+    # 日の並び [10, 20, 20, 30] の median_low は 20
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].day_of_month == 20
+    assert result[0].last_date == date(2026, 11, 20)
+    assert result[0].next_date == date(2026, 12, 20)
+
+
+# --- amount_tolerance -----------------------------------------------------
+
+
+def _gym_rows() -> list[Expense]:
+    # 直近(10 月)は 80000。8 月は 84000 で 5% 高い
+    return [
+        _row("2026-08-01", "gym", 84000),
+        _row("2026-09-01", "gym", 80000),
+        _row("2026-10-01", "gym", 80000),
+    ]
+
+
+def test_tolerance_zero_requires_same_amount() -> None:
+    assert find_recurring(_gym_rows(), amount_tolerance=0.0) == []
+
+
+def test_tolerance_within_range_detected() -> None:
+    result = find_recurring(_gym_rows(), amount_tolerance=0.1)
+    assert len(result) == 1
+    assert result[0].amount == 80000  # 直近の金額
+    assert result[0].months == ("2026-08", "2026-09", "2026-10")
+
+
+def test_tolerance_outside_range_not_detected() -> None:
+    assert find_recurring(_gym_rows(), amount_tolerance=0.04) == []
+
+
+# --- memo normalization and grouping -------------------------------------
+
+
+def test_memo_normalized_by_strip_and_casefold() -> None:
+    rows = [
+        _row("2026-08-01", "video", 1500, " Netflix "),
+        _row("2026-09-01", "video", 1500, "netflix"),
+        _row("2026-10-01", "video", 1500, "NETFLIX"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].key == "video:netflix"
+
+
+def test_same_memo_different_category_are_separate() -> None:
+    rows: list[Expense] = []
+    for day in ("2026-08-01", "2026-09-01", "2026-10-01"):
+        rows.append(_row(day, "a", 100, "same"))
+        rows.append(_row(day, "b", 200, "same"))
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [("a", 100), ("b", 200)]
+
+
+# --- ordering -------------------------------------------------------------
+
+
+def test_sorted_by_next_date_then_category_then_key() -> None:
+    rows: list[Expense] = []
+    for day in ("2026-08-01", "2026-09-01", "2026-10-01"):
+        rows.append(_row(day, "z", 1, "m1"))
+        rows.append(_row(day, "a", 1, "q"))
+        rows.append(_row(day, "a", 1, "p"))
+        rows.append(_row(day, "b", 1, "m4"))
+    for day in ("2026-09-15", "2026-10-15", "2026-11-15"):
+        rows.append(_row(day, "m", 1, "m3"))
+    result = find_recurring(rows)
+    assert [r.key for r in result] == ["a:p", "a:q", "b:m4", "z:m1", "m:m3"]
+    assert [r.next_date for r in result] == [
+        date(2026, 11, 1),
+        date(2026, 11, 1),
+        date(2026, 11, 1),
+        date(2026, 11, 1),
+        date(2026, 12, 15),
+    ]
+
+
+# --- edge cases and errors ------------------------------------------------
+
+
+def test_empty_rows_returns_empty() -> None:
+    assert find_recurring([]) == []
+
+
+def test_input_not_mutated() -> None:
+    rows = [
+        _row("2026-08-01", "rent", 80000),
+        _row("2026-09-01", "rent", 80000),
+        _row("2026-10-01", "rent", 80000),
+    ]
+    snapshot = list(rows)
+    find_recurring(rows)
+    assert rows == snapshot
+
+
+@pytest.mark.parametrize("min_months", [1, 0, -3])
+def test_min_months_below_two_rejected(min_months: int) -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_months=min_months)
+
+
+def test_negative_tolerance_rejected() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], amount_tolerance=-0.1)
diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..c781c4b
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,203 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    all_of,
+    amount_between,
+    any_of,
+    category,
+    date_between,
+    memo_contains,
+    not_,
+    search,
+)
+
+ROWS = [
+    Expense(date(2024, 1, 5), "food", 1000, "lunch with friends"),
+    Expense(date(2024, 1, 10), "cafe", 500, "Coffee"),
+    Expense(date(2024, 2, 1), "transport", 500, "train"),
+    Expense(date(2024, 2, 28), "food", 2999, "dinner"),
+    Expense(date(2024, 3, 1), "rent", 80000, ""),
+]
+
+
+# --- search() 全体の振る舞い ---
+
+
+def test_search_without_query_returns_copy_of_all_rows() -> None:
+    result = search(ROWS)
+    assert result == ROWS
+    assert result is not ROWS
+
+
+def test_search_empty_rows() -> None:
+    assert search([]) == []
+    assert search([], category("food")) == []
+
+
+def test_search_does_not_mutate_input() -> None:
+    rows = list(ROWS)
+    search(rows, amount_between(min=500))
+    search(rows)
+    assert rows == ROWS
+
+
+def test_search_keeps_input_order_and_duplicates() -> None:
+    rows = [ROWS[3], ROWS[0], ROWS[3], ROWS[1]]
+    assert search(rows, all_of()) == rows
+    assert search(rows, category("food")) == [ROWS[3], ROWS[0], ROWS[3]]
+
+
+def test_search_keeps_order_not_sorted_by_amount() -> None:
+    result = search(ROWS, amount_between(min=500, max=2999))
+    assert [e.amount for e in result] == [1000, 500, 500, 2999]
+
+
+# --- category ---
+
+
+def test_category_matches_any_given_name() -> None:
+    assert search(ROWS, category("food", "cafe")) == [ROWS[0], ROWS[1], ROWS[3]]
+
+
+def test_category_is_exact_match() -> None:
+    assert search(ROWS, category("foo")) == []
+    assert search(ROWS, category("FOOD")) == []
+
+
+def test_category_ignores_surrounding_spaces_in_names() -> None:
+    assert search(ROWS, category("  food ")) == [ROWS[0], ROWS[3]]
+
+
+def test_category_no_args_raises() -> None:
+    with pytest.raises(ValueError):
+        category()
+
+
+# --- amount_between ---
+
+
+def test_amount_between_includes_both_ends() -> None:
+    assert search(ROWS, amount_between(500, 1000)) == [ROWS[0], ROWS[1], ROWS[2]]
+
+
+def test_amount_between_exact_value() -> None:
+    assert search(ROWS, amount_between(500, 500)) == [ROWS[1], ROWS[2]]
+
+
+def test_amount_between_only_min() -> None:
+    assert search(ROWS, amount_between(min=2999)) == [ROWS[3], ROWS[4]]
+
+
+def test_amount_between_only_max() -> None:
+    assert search(ROWS, amount_between(max=500)) == [ROWS[1], ROWS[2]]
+
+
+def test_amount_between_no_bounds_raises() -> None:
+    with pytest.raises(ValueError):
+        amount_between(None, None)
+
+
+def test_amount_between_min_greater_than_max_raises() -> None:
+    with pytest.raises(ValueError):
+        amount_between(min=501, max=500)
+
+
+# --- date_between ---
+
+
+def test_date_between_includes_both_ends() -> None:
+    result = search(ROWS, date_between(date(2024, 1, 10), date(2024, 2, 28)))
+    assert result == [ROWS[1], ROWS[2], ROWS[3]]
+
+
+def test_date_between_same_day() -> None:
+    assert search(ROWS, date_between(date(2024, 1, 5), date(2024, 1, 5))) == [ROWS[0]]
+
+
+def test_date_between_only_start() -> None:
+    assert search(ROWS, date_between(start=date(2024, 3, 1))) == [ROWS[4]]
+
+
+def test_date_between_only_end() -> None:
+    assert search(ROWS, date_between(end=date(2024, 1, 10))) == [ROWS[0], ROWS[1]]
+
+
+def test_date_between_no_bounds_raises() -> None:
+    with pytest.raises(ValueError):
+        date_between(None, None)
+
+
+def test_date_between_start_after_end_raises() -> None:
+    with pytest.raises(ValueError):
+        date_between(date(2024, 2, 1), date(2024, 1, 31))
+
+
+# --- memo_contains ---
+
+
+def test_memo_contains_partial_match() -> None:
+    assert search(ROWS, memo_contains("with")) == [ROWS[0]]
+
+
+def test_memo_contains_ignores_case_by_default() -> None:
+    assert search(ROWS, memo_contains("LUNCH")) == [ROWS[0]]
+    assert search(ROWS, memo_contains("coffee")) == [ROWS[1]]
+
+
+def test_memo_contains_case_sensitive_when_ignore_case_false() -> None:
+    assert search(ROWS, memo_contains("LUNCH", ignore_case=False)) == []
+    assert search(ROWS, memo_contains("Coffee", ignore_case=False)) == [ROWS[1]]
+    assert search(ROWS, memo_contains("coffee", ignore_case=False)) == []
+
+
+def test_memo_contains_empty_memo_never_matches_nonempty_text() -> None:
+    assert search(ROWS, memo_contains("x")) == []
+
+
+def test_memo_contains_empty_text_raises() -> None:
+    with pytest.raises(ValueError):
+        memo_contains("")
+
+
+# --- all_of / any_of / not_ ---
+
+
+def test_all_of_empty_is_always_true() -> None:
+    assert search(ROWS, all_of()) == ROWS
+
+
+def test_any_of_empty_is_always_false() -> None:
+    assert search(ROWS, any_of()) == []
+
+
+def test_all_of_is_and() -> None:
+    q = all_of(category("food", "cafe"), amount_between(min=1000))
+    assert search(ROWS, q) == [ROWS[0], ROWS[3]]
+
+
+def test_any_of_is_or() -> None:
+    q = any_of(category("cafe"), memo_contains("dinner"))
+    assert search(ROWS, q) == [ROWS[1], ROWS[3]]
+
+
+def test_not_negates() -> None:
+    assert search(ROWS, not_(category("food"))) == [ROWS[1], ROWS[2], ROWS[4]]
+
+
+def test_nested_combination() -> None:
+    # (food OR transport) AND NOT (amount > 2000)
+    q = all_of(
+        any_of(category("food"), category("transport")),
+        not_(amount_between(min=2000)),
+    )
+    assert search(ROWS, q) == [ROWS[0], ROWS[2]]
+
+
+def test_nested_not_of_all_of() -> None:
+    q = not_(all_of(category("food"), memo_contains("lunch")))
+    assert search(ROWS, q) == [ROWS[1], ROWS[2], ROWS[3], ROWS[4]]
