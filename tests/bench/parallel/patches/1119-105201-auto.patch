new file mode 100644
index 0000000..1756b23
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,101 @@
+"""Expense search: composable predicates over Expense records (pure functions)."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from datetime import date
+
+from kakeibo.core import Expense
+
+Query = Callable[[Expense], bool]
+
+
+def category(*names: str) -> Query:
+    """Match rows whose category equals one of ``names`` (surrounding spaces ignored)."""
+    if not names:
+        raise ValueError("カテゴリ名を 1 つ以上指定してください")
+    wanted = frozenset(n.strip() for n in names)
+
+    def pred(e: Expense) -> bool:
+        return e.category.strip() in wanted
+
+    return pred
+
+
+def amount_between(min: int | None = None, max: int | None = None) -> Query:
+    """Match rows with ``min <= amount <= max`` (both ends inclusive; either may be omitted)."""
+    if min is None and max is None:
+        raise ValueError("金額の下限・上限の少なくとも一方を指定してください")
+    if min is not None and max is not None and min > max:
+        raise ValueError(f"金額の下限が上限を超えています: {min} > {max}")
+
+    def pred(e: Expense) -> bool:
+        if min is not None and e.amount < min:
+            return False
+        return not (max is not None and e.amount > max)
+
+    return pred
+
+
+def date_between(start: date | None = None, end: date | None = None) -> Query:
+    """Match rows with ``start <= day <= end`` (both ends inclusive; either may be omitted)."""
+    if start is None and end is None:
+        raise ValueError("日付の開始・終了の少なくとも一方を指定してください")
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"開始日が終了日を超えています: {start} > {end}")
+
+    def pred(e: Expense) -> bool:
+        if start is not None and e.day < start:
+            return False
+        return not (end is not None and e.day > end)
+
+    return pred
+
+
+def memo_contains(text: str, *, ignore_case: bool = True) -> Query:
+    """Match rows whose memo contains ``text`` (substring; case-insensitive by default)."""
+    if text == "":
+        raise ValueError("検索文字列が空です")
+    needle = text.lower() if ignore_case else text
+
+    def pred(e: Expense) -> bool:
+        hay = e.memo.lower() if ignore_case else e.memo
+        return needle in hay
+
+    return pred
+
+
+def all_of(*queries: Query) -> Query:
+    """AND of the queries. With no queries, always True."""
+    qs = tuple(queries)
+
+    def pred(e: Expense) -> bool:
+        return all(q(e) for q in qs)
+
+    return pred
+
+
+def any_of(*queries: Query) -> Query:
+    """OR of the queries. With no queries, always False."""
+    qs = tuple(queries)
+
+    def pred(e: Expense) -> bool:
+        return any(q(e) for q in qs)
+
+    return pred
+
+
+def not_(query: Query) -> Query:
+    """Negation of ``query``."""
+
+    def pred(e: Expense) -> bool:
+        return not query(e)
+
+    return pred
+
+
+def search(rows: list[Expense], query: Query | None = None) -> list[Expense]:
+    """Return rows matching ``query`` in input order. ``None`` returns a copy of all rows."""
+    if query is None:
+        return list(rows)
+    return [e for e in rows if query(e)]
diff --git a/tests/test_importer.py b/tests/test_importer.py
