+"""Month-over-month category comparison (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from typing import Literal
+
+from kakeibo.core import Expense
+
+Status = Literal["up", "down", "same", "new", "gone"]
+
+_MONTH_RE = re.compile(r"([0-9]{4})-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryDiff:
+    category: str
+    previous: int
+    current: int
+    delta: int  # current - previous
+    ratio: float | None  # delta / previous; None when previous == 0
+    status: Status
+
+
+def _parse_month(month: str) -> tuple[int, int]:
+    m = _MONTH_RE.fullmatch(month)
+    if m is None:
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+    return int(m.group(1)), int(m.group(2))
+
+
+def _ratio(previous: int, delta: int) -> float | None:
+    return None if previous == 0 else delta / previous
+
+
+def _status(previous: int, current: int) -> Status:
+    if previous == 0 and current > 0:
+        return "new"
+    if previous > 0 and current == 0:
+        return "gone"
+    delta = current - previous
+    if delta > 0:
+        return "up"
+    if delta < 0:
+        return "down"
+    return "same"
+
+
+def compare_months(rows: list[Expense], month: str) -> list[CategoryDiff]:
+    """Compare per-category totals of `month` (YYYY-MM) with the calendar month before it."""
+    year, mon = _parse_month(month)
+    prev_year, prev_mon = (year - 1, 12) if mon == 1 else (year, mon - 1)
+
+    prev_totals: dict[str, int] = {}
+    cur_totals: dict[str, int] = {}
+    for e in rows:
+        key = (e.day.year, e.day.month)
+        if key == (prev_year, prev_mon):
+            prev_totals[e.category] = prev_totals.get(e.category, 0) + e.amount
+        elif key == (year, mon):
+            cur_totals[e.category] = cur_totals.get(e.category, 0) + e.amount
+
+    diffs: list[CategoryDiff] = []
+    for cat in set(prev_totals) | set(cur_totals):
+        previous = prev_totals.get(cat, 0)
+        current = cur_totals.get(cat, 0)
+        delta = current - previous
+        diffs.append(
+            CategoryDiff(
+                category=cat,
+                previous=previous,
+                current=current,
+                delta=delta,
+                ratio=_ratio(previous, delta),
+                status=_status(previous, current),
+            )
+        )
+    diffs.sort(key=lambda d: (-abs(d.delta), d.category))
+    return diffs
+
+
+def _pct(ratio: float | None) -> str:
+    return "-" if ratio is None else f"{ratio * 100:+.1f}%"
+
+
+def _line(name: str, previous: int, current: int) -> str:
+    delta = current - previous
+    return (
+        f"{name}\t{previous:,}\t{current:,}\t{delta:+,}\t"
+        f"{_pct(_ratio(previous, delta))}"
+    )
+
+
+def render_diff(diffs: list[CategoryDiff]) -> str:
+    if not diffs:
+        return ""
+    lines = [_line(d.category, d.previous, d.current) for d in diffs]
+    lines.append(
+        _line(
+            "TOTAL",
+            sum(d.previous for d in diffs),
+            sum(d.current for d in diffs),
+        )
+    )
+    return "\n".join(lines) + "\n"
