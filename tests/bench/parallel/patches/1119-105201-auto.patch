+"""Import bank / card statement CSV text into Expense records (pure functions)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+class ImportFormatError(ValueError):
+    """Raised when the whole input cannot be read (no header, missing columns)."""
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int  # physical line number in the source text (header is usually line 1)
+    column: str | None  # original header of the bad column; None for whole-row problems
+    reason: str
+    raw: str  # the physical line(s) of the row
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+
+
+_DATE_ALIASES = frozenset({"date", "日付", "利用日", "ご利用日", "取引日", "年月日"})
+_AMOUNT_ALIASES = frozenset(
+    {"amount", "金額", "利用金額", "ご利用金額", "支払金額", "出金", "出金金額"}
+)
+_CATEGORY_ALIASES = frozenset({"category", "カテゴリ", "分類", "費目"})
+_MEMO_ALIASES = frozenset(
+    {"memo", "メモ", "摘要", "内容", "利用店名", "ご利用店名・商品名", "description"}
+)
+
+_DATE_PATTERNS = (
+    re.compile(r"([0-9]{4})-([0-9]{1,2})-([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})/([0-9]{1,2})/([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日"),
+    re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})"),
+)
+_AMOUNT_NOISE = re.compile(r"[¥￥円,\s]")
+_AMOUNT_SHAPE = re.compile(r"[-▲△]?[0-9]+")
+_NEGATIVE_SIGNS = "-▲△"
+
+
+@dataclass(frozen=True)
+class _Layout:
+    header: list[str]
+    date_i: int
+    amount_i: int
+    category_i: int | None
+    memo_i: int | None
+
+
+def _find(header: list[str], aliases: frozenset[str]) -> int | None:
+    for i, name in enumerate(header):
+        if name.lower() in aliases:
+            return i
+    return None
+
+
+def _locate(header: list[str]) -> _Layout:
+    date_i = _find(header, _DATE_ALIASES)
+    if date_i is None:
+        raise ImportFormatError("日付の列が見つかりません")
+    amount_i = _find(header, _AMOUNT_ALIASES)
+    if amount_i is None:
+        raise ImportFormatError("金額の列が見つかりません")
+    return _Layout(
+        header=header,
+        date_i=date_i,
+        amount_i=amount_i,
+        category_i=_find(header, _CATEGORY_ALIASES),
+        memo_i=_find(header, _MEMO_ALIASES),
+    )
+
+
+_THOUSANDS_GROUP = re.compile(r"[0-9]{3}円?")
+
+
+def _rejoin_split_amount(cells: list[str], width: int, amount_i: int) -> list[str]:
+    """Undo an unquoted thousands comma (``¥3,980円`` split into ``¥3`` and ``980円``).
+
+    Only applies while the row has more cells than the header; quoted input is
+    never split, so this is a no-op for it.
+    """
+    out = list(cells)
+    i = amount_i
+    while (
+        len(out) > width
+        and i + 1 < len(out)
+        and any(ch.isdigit() for ch in out[i])
+        and _THOUSANDS_GROUP.fullmatch(out[i + 1]) is not None
+    ):
+        out[i] = f"{out[i]},{out[i + 1]}"
+        del out[i + 1]
+    return out
+
+
+def _parse_date(cell: str) -> date:
+    reason = f"日付の形式が不正です: '{cell}'"
+    for pattern in _DATE_PATTERNS:
+        m = pattern.fullmatch(cell)
+        if m is not None:
+            try:
+                return date(int(m.group(1)), int(m.group(2)), int(m.group(3)))
+            except ValueError:
+                raise ValueError(reason) from None
+    raise ValueError(reason)
+
+
+def _parse_amount(cell: str) -> int:
+    s = _AMOUNT_NOISE.sub("", unicodedata.normalize("NFKC", cell))
+    if _AMOUNT_SHAPE.fullmatch(s) is None:
+        raise ValueError(f"金額が整数ではありません: '{cell}'")
+    negative = s[0] in _NEGATIVE_SIGNS
+    value = int(s[1:] if negative else s)
+    if negative or value == 0:
+        raise ValueError(f"金額は 1 円以上が必要です(入金・返金は対象外): '{cell}'")
+    return value
+
+
+def parse_statement(text: str, *, default_category: str = "未分類") -> ImportResult:
+    """Parse statement CSV text. Bad rows go to ``errors``; good rows are kept."""
+    text = text.removeprefix("﻿")
+    physical = io.StringIO(text, newline="").readlines()
+    reader = csv.reader(physical)
+
+    layout: _Layout | None = None
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    prev = 0
+    for row in reader:
+        cur = reader.line_num
+        start, prev = prev, cur
+        if not any(cell.strip() for cell in row):
+            continue
+        if layout is None:
+            layout = _locate([cell.strip() for cell in row])
+            continue
+        raw = "".join(physical[start:cur]).rstrip("\r\n")
+        expected = len(layout.header)
+        cells = _rejoin_split_amount(
+            [cell.strip() for cell in row], expected, layout.amount_i
+        )
+        if len(cells) < expected:
+            errors.append(
+                RowError(
+                    line=cur,
+                    column=None,
+                    reason=(
+                        f"列数が足りません(期待 {expected} 列、実際 {len(cells)} 列)"
+                    ),
+                    raw=raw,
+                )
+            )
+            continue
+        try:
+            day = _parse_date(cells[layout.date_i])
+        except ValueError as e:
+            errors.append(RowError(cur, layout.header[layout.date_i], str(e), raw))
+            continue
+        try:
+            amount = _parse_amount(cells[layout.amount_i])
+        except ValueError as e:
+            errors.append(RowError(cur, layout.header[layout.amount_i], str(e), raw))
+            continue
+        category = (
+            cells[layout.category_i] if layout.category_i is not None else ""
+        ) or default_category
+        memo = cells[layout.memo_i] if layout.memo_i is not None else ""
+        expenses.append(Expense(day=day, category=category, amount=amount, memo=memo))
+    if layout is None:
+        raise ImportFormatError("入力が空です")
+    return ImportResult(expenses, errors)
