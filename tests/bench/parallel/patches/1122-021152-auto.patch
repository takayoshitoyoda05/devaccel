diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..666218a 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -188,3 +188,102 @@ def test_path_type(runner, cls, expect):
 
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
+
+
+@pytest.mark.parametrize(
+    "name",
+    ["a.csv", "a.tsv", "A.CSV", "a.Tsv", "dir/a.csv", "a.b.csv", " .csv", "a.csv.csv"],
+)
+def test_path_suffixes_accept(name):
+    ty = click.Path(suffixes=[".csv", ".tsv"])
+    assert ty.convert(name, None, None) == name
+
+
+@pytest.mark.parametrize(
+    "name", ["a.txt", "a", "a.csv.bak", ".csv", "csv", "dir.csv/a", "a.csvx", ""]
+)
+def test_path_suffixes_reject(name):
+    ty = click.Path(suffixes=[".csv", ".tsv"])
+
+    with pytest.raises(click.BadParameter, match=r"must end with one of: \.csv, \.tsv"):
+        ty.convert(name, None, None)
+
+
+def test_path_suffixes_normalized():
+    assert click.Path(suffixes=["CSV", ".Tsv"]).suffixes == (".csv", ".tsv")
+    assert click.Path().suffixes is None
+    assert (
+        click.Path(suffixes=[".tar.gz"]).convert("x.TAR.GZ", None, None) == "x.TAR.GZ"
+    )
+
+
+@pytest.mark.parametrize(
+    ("suffixes", "error"),
+    [
+        ("csv", TypeError),
+        ([1], TypeError),
+        ([], ValueError),
+        ([""], ValueError),
+        (["."], ValueError),
+    ],
+)
+def test_path_suffixes_invalid_argument(suffixes, error):
+    with pytest.raises(error):
+        click.Path(suffixes=suffixes)
+
+
+def test_path_suffixes_bytes_and_pathlike():
+    ty = click.Path(suffixes=[".csv"])
+    assert ty.convert(b"a.CSV", None, None) == b"a.CSV"
+    assert ty.convert(pathlib.Path("a.csv"), None, None) == pathlib.Path("a.csv")
+
+    with pytest.raises(click.BadParameter):
+        ty.convert(b"a.txt", None, None)
+
+
+def test_path_suffixes_skips_dash_and_directories(tmp_path):
+    assert (
+        click.Path(allow_dash=True, suffixes=[".csv"]).convert("-", None, None) == "-"
+    )
+
+    directory = tmp_path / "data.txt"
+    directory.mkdir()
+    ty = click.Path(exists=True, suffixes=[".csv"])
+    assert ty.convert(os.fspath(directory), None, None) == os.fspath(directory)
+
+    with pytest.raises(click.BadParameter):
+        click.Path(file_okay=False, suffixes=[".csv"]).convert("-", None, None)
+
+
+def test_path_suffixes_existing_file(tmp_path):
+    good = tmp_path / "a.CSV"
+    bad = tmp_path / "a.txt"
+    good.write_text("")
+    bad.write_text("")
+    ty = click.Path(exists=True, suffixes=[".csv"])
+    assert ty.convert(os.fspath(good), None, None) == os.fspath(good)
+
+    with pytest.raises(click.BadParameter, match="must end with one of"):
+        ty.convert(os.fspath(bad), None, None)
+
+
+def test_path_suffixes_missing_file_still_checked(tmp_path):
+    ty = click.Path(exists=True, suffixes=[".csv"])
+
+    with pytest.raises(click.BadParameter, match="does not exist"):
+        ty.convert(os.fspath(tmp_path / "missing.csv"), None, None)
+
+
+def test_path_suffixes_cli(runner):
+    @click.command()
+    @click.argument("p", type=click.Path(suffixes=[".csv", ".tsv"]))
+    def cli(p):
+        click.echo(p)
+
+    ok = runner.invoke(cli, ["x.CSV"])
+    assert ok.exit_code == 0
+    assert ok.output == "x.CSV\n"
+
+    bad = runner.invoke(cli, ["x.json"])
+    assert bad.exit_code == 2
+    assert "must end with one of: .csv, .tsv" in bad.output
