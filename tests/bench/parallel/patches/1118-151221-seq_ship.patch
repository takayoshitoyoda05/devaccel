+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def _e(d: date, cat: str = "家賃", amount: int = 1000, memo: str = "") -> Expense:
+    return Expense(d, cat, amount, memo)
+
+
+@pytest.mark.parametrize(
+    "src,want",
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2024, 1, 31), date(2024, 2, 29)),
+        (date(2026, 12, 15), date(2027, 1, 15)),
+        (date(2026, 3, 31), date(2026, 4, 30)),
+        (date(2026, 5, 10), date(2026, 6, 10)),
+    ],
+)
+def test_add_month(src: date, want: date) -> None:
+    assert add_month(src) == want
+
+
+def test_basic_detection() -> None:
+    rows = [_e(date(2026, 1, 25)), _e(date(2026, 2, 25)), _e(date(2026, 3, 27))]
+    assert find_recurring(rows) == [
+        Recurring(
+            "家賃",
+            1000,
+            (date(2026, 1, 25), date(2026, 2, 25), date(2026, 3, 27)),
+            date(2026, 4, 27),
+        )
+    ]
+
+
+def test_invalid_args() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_empty_and_below_min() -> None:
+    assert find_recurring([]) == []
+    rows = [_e(date(2026, 1, 1)), _e(date(2026, 2, 1))]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_count=2)) == 1
+
+
+def test_duplicates_and_memo_ignored() -> None:
+    rows = [
+        _e(date(2026, 1, 5), memo="a"),
+        _e(date(2026, 1, 5), memo="b"),
+        _e(date(2026, 2, 5)),
+        _e(date(2026, 3, 5)),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_different_amount_not_grouped() -> None:
+    rows = [
+        _e(date(2026, 1, 5), amount=1000),
+        _e(date(2026, 2, 5), amount=1100),
+        _e(date(2026, 3, 5), amount=1000),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_tolerance_boundary() -> None:
+    rows = [_e(date(2026, 1, 10)), _e(date(2026, 2, 13)), _e(date(2026, 3, 16))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+    assert find_recurring(rows, tolerance=2) == []
+
+
+def test_end_of_month_chain() -> None:
+    rows = [_e(date(2026, 1, 31)), _e(date(2026, 2, 28)), _e(date(2026, 3, 28))]
+    (r,) = find_recurring(rows, tolerance=0)
+    assert r.next_expected == date(2026, 4, 28)
+
+
+def test_split_into_runs_and_order() -> None:
+    a = [_e(date(2026, m, 1), cat="b") for m in (1, 2, 3)]
+    gap = [_e(date(2026, m, 1), cat="b") for m in (8, 9, 10)]
+    other = [_e(date(2026, m, 1), cat="a", amount=5) for m in (1, 2, 3)]
+    got = find_recurring(gap + other + a)
+    assert [(r.category, r.days[0]) for r in got] == [
+        ("a", date(2026, 1, 1)),
+        ("b", date(2026, 1, 1)),
+        ("b", date(2026, 8, 1)),
+    ]
+
+
+def test_sorted_by_amount_within_category() -> None:
+    rows = [_e(date(2026, m, 1), amount=9) for m in (1, 2, 3)] + [
+        _e(date(2026, m, 1), amount=2) for m in (1, 2, 3)
+    ]
+    assert [r.amount for r in find_recurring(rows)] == [2, 9]
