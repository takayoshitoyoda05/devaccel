new file mode 100644
index 0000000..e6307f8
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,103 @@
+"""Import CSVs exported by other banks / card issuers."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"-?[¥￥]?[0-9][0-9,]*円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    t = s.strip()
+    if not _AMOUNT_RE.fullmatch(t):
+        raise ValueError(f"金額として解釈できません: {s!r}")
+    neg = t.startswith("-")
+    n = int("".join(c for c in t if "0" <= c <= "9"))
+    return -n if neg else n
+
+
+def parse_date(s: str) -> date:
+    m = _DATE_RE.fullmatch(s.strip())
+    if not m:
+        raise ValueError(f"日付として解釈できません: {s!r}")
+    try:
+        return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+    category_map = category_map or {}
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    try:
+        header = next(reader)
+    except StopIteration:
+        raise ValueError("ヘッダー行がありません") from None
+    index: dict[str, int] = {}
+    for field, col in mapping.items():
+        if col not in header:
+            raise ValueError(f"列 {col!r} がヘッダーにありません")
+        index[field] = header.index(col)
+
+    def cell(rec: list[str], field: str) -> str:
+        if field not in index:
+            return ""
+        i = index[field]
+        return rec[i] if i < len(rec) else ""
+
+    rows: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    prev_end = reader.line_num
+    for rec in reader:
+        start = prev_end + 1  # physical line where this record begins
+        prev_end = reader.line_num
+        if not rec:
+            continue
+        bad: list[str] = []
+        day = amount = None
+        try:
+            day = parse_date(cell(rec, "date"))
+        except ValueError:
+            bad.append("date")
+        try:
+            amount = parse_amount(cell(rec, "amount"))
+        except ValueError:
+            bad.append("amount")
+        category = cell(rec, "category").strip()
+        if not category:
+            bad.append("category")
+        if bad or day is None or amount is None:
+            errors.extend((start, f) for f in bad)
+            continue
+        rows.append(
+            Expense(
+                day=day,
+                category=category_map.get(category, category),
+                amount=amount,
+                memo=cell(rec, "memo").strip(),
+            )
+        )
+    return rows, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
new file mode 100644
index 0000000..1b2d6d1
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,88 @@
+"""Month-over-month comparison per category."""
+
+from __future__ import annotations
+
+import re
+from collections import defaultdict
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(m: str) -> None:
+    if not _MONTH_RE.fullmatch(m):
+        raise ValueError(f"月は YYYY-MM 形式で指定してください: {m!r}")
+
+
+def _ym(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+    prev_sum: dict[str, int] = defaultdict(int)
+    curr_sum: dict[str, int] = defaultdict(int)
+    for e in rows:
+        m = _ym(e)
+        if m == prev_month:
+            prev_sum[e.category] += e.amount
+        if m == curr_month:
+            curr_sum[e.category] += e.amount
+
+    out: list[DiffRow] = []
+    for cat in set(prev_sum) | set(curr_sum):
+        prev = prev_sum.get(cat, 0)
+        curr = curr_sum.get(cat, 0)
+        delta = curr - prev
+        pct = None if prev == 0 else round(delta / prev * 100, 1)
+        if cat not in prev_sum:
+            status = "new"
+        elif cat not in curr_sum:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+    out.sort(key=lambda r: (-abs(r.delta), r.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError("n must be >= 0")
+    return [d for d in diffs if d.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for d in diffs:
+        pct = "-" if d.pct is None else f"{d.pct:+.1f}%"
+        lines.append(f"{d.category}\t{d.prev}\t{d.curr}\t{d.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_ym(e) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("比較には 2 か月以上の明細が必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..6b93614
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,131 @@
+"""A tiny search query language over expenses."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+
+from kakeibo.core import Expense
+
+_SPECIAL = frozenset('()"')
+
+
+class QueryError(ValueError):
+    pass
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    tokens: list[tuple[str, str]] = []
+    i, n = 0, len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", c))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", c))
+            i += 1
+        elif c == '"':
+            j = q.find('"', i + 1)
+            if j == -1:
+                raise QueryError("引用符が閉じていません")
+            if j == i + 1:
+                raise QueryError("引用符の中身が空です")
+            tokens.append(("TERM", q[i + 1 : j]))
+            i = j + 1
+        else:
+            j = i
+            while j < n and not q[j].isspace() and q[j] not in _SPECIAL:
+                j += 1
+            word = q[i:j]
+            i = j
+            if word in ("AND", "OR", "NOT"):
+                tokens.append((word, word))
+            elif word.startswith("cat:"):
+                rest = word[4:]
+                if not rest:
+                    raise QueryError("cat: の後ろが空です")
+                tokens.append(("CAT", rest))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+Pred = Callable[[Expense], bool]
+
+
+class _Parser:
+    def __init__(self, tokens: list[tuple[str, str]]) -> None:
+        self.t = tokens
+        self.i = 0
+
+    def peek(self) -> str | None:
+        return self.t[self.i][0] if self.i < len(self.t) else None
+
+    def or_expr(self) -> Pred:
+        parts = [self.and_expr()]
+        while self.peek() == "OR":
+            self.i += 1
+            parts.append(self.and_expr())
+        return lambda e: any(p(e) for p in parts)
+
+    def and_expr(self) -> Pred:
+        parts = [self.not_expr()]
+        while True:
+            k = self.peek()
+            if k == "AND":
+                self.i += 1
+            elif k not in ("TERM", "CAT", "LPAREN", "NOT"):
+                break
+            parts.append(self.not_expr())
+        return lambda e: all(p(e) for p in parts)
+
+    def not_expr(self) -> Pred:
+        if self.peek() == "NOT":
+            self.i += 1
+            inner = self.not_expr()
+            return lambda e: not inner(e)
+        return self.primary()
+
+    def primary(self) -> Pred:
+        k = self.peek()
+        if k is None:
+            raise QueryError("項が必要です")
+        value = self.t[self.i][1]
+        if k == "TERM":
+            self.i += 1
+            v = value.casefold()
+            return lambda e: v in e.memo.casefold() or v in e.category.casefold()
+        if k == "CAT":
+            self.i += 1
+            v = value.casefold()
+            return lambda e: e.category.casefold() == v
+        if k == "LPAREN":
+            self.i += 1
+            inner = self.or_expr()
+            if self.peek() != "RPAREN":
+                raise QueryError("括弧が閉じていません")
+            self.i += 1
+            return inner
+        raise QueryError(f"予期しないトークン: {value}")
+
+
+def _compile(q: str) -> Pred:
+    p = _Parser(tokenize(q))
+    try:
+        pred = p.or_expr()
+    except RecursionError:
+        raise QueryError("クエリが深すぎます") from None
+    if p.i != len(p.t):
+        raise QueryError(f"予期しないトークン: {p.t[p.i][1]}")
+    return pred
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _compile(q)(e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    pred = _compile(q)
+    return [e for e in rows if pred(e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..f71cc34
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,53 @@
+"""Detect recurring (monthly) expenses."""
+
+from __future__ import annotations
+
+import calendar
+from collections import defaultdict
+from dataclasses import dataclass
+from datetime import date
+from itertools import pairwise
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Same day next month, clamped to the end of that month."""
+    year, month = (d.year + 1, 1) if d.month == 12 else (d.year, d.month + 1)
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2 or tolerance < 0:
+        raise ValueError("min_count must be >= 2 and tolerance >= 0")
+    groups: dict[tuple[str, int], set[date]] = defaultdict(set)
+    for e in rows:
+        groups[(e.category, e.amount)].add(e.day)
+
+    result: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        days = sorted(day_set)
+        runs: list[list[date]] = [[days[0]]]
+        for prev, cur in pairwise(days):
+            if abs((cur - add_month(prev)).days) <= tolerance:
+                runs[-1].append(cur)
+            else:
+                runs.append([cur])
+        for run in runs:
+            if len(run) >= min_count:
+                result.append(
+                    Recurring(category, amount, tuple(run), add_month(run[-1]))
+                )
+    result.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return result
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..3f8b399
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,104 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+
+@pytest.mark.parametrize(
+    "s,want",
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥1,0,0円", 100),
+        ("-980円", -980),
+    ],
+)
+def test_parse_amount_ok(s: str, want: int) -> None:
+    assert parse_amount(s) == want
+
+
+@pytest.mark.parametrize(
+    "s", ["", "円", "12.5", "1 200", "--5", "¥-5", "１２３", ",5", "¥", "5円円", "-"]
+)
+def test_parse_amount_bad(s: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(s)
+
+
+@pytest.mark.parametrize(
+    "s,want",
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        (" 2026-01-05 ", date(2026, 1, 5)),
+        ("2024/02/29", date(2024, 2, 29)),
+    ],
+)
+def test_parse_date_ok(s: str, want: date) -> None:
+    assert parse_date(s) == want
+
+
+@pytest.mark.parametrize(
+    "s",
+    ["2026/1-5", "26/1/5", "2026/02/30", "2026.1.5", "2026/001/5", "２０２６/1/5", ""],
+)
+def test_parse_date_bad(s: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(s)
+
+
+def test_import_basic() -> None:
+    text = (
+        "利用日,分類,利用金額,利用店名,余分\n"
+        '2026/1/5,食費,"¥1,200", スーパー ,x\n'
+        '2026-01-06,交通,300円,"電車,バス",y\n'
+    )
+    rows, errs = import_rows(text, category_map={"食費": "food"})
+    assert errs == []
+    assert rows == [
+        Expense(date(2026, 1, 5), "food", 1200, "スーパー"),
+        Expense(date(2026, 1, 6), "交通", 300, "電車,バス"),
+    ]
+
+
+def test_import_errors_and_line_numbers() -> None:
+    text = (
+        "利用日,分類,利用金額,利用店名\n"  # 1
+        "\n"  # 2 blank
+        "bad,,xx,m\n"  # 3: all three errors, in order
+        "2026/1/1,a,100,m\n"  # 4 ok
+        "2026/1/2,b\n"  # 5 short row -> amount error
+    )
+    rows, errs = import_rows(text)
+    assert errs == [(3, "date"), (3, "amount"), (3, "category"), (5, "amount")]
+    assert rows == [Expense(date(2026, 1, 1), "a", 100, "m")]
+
+
+def test_import_multiline_quoted_field_line_numbers() -> None:
+    text = (
+        "利用日,分類,利用金額,利用店名\n"
+        '2026/1/1,a,100,"x\ny"\n'  # lines 2-3
+        "bad,a,100,m\n"  # line 4
+    )
+    rows, errs = import_rows(text)
+    assert len(rows) == 1 and rows[0].memo == "x\ny"
+    assert errs == [(4, "date")]
+
+
+def test_import_custom_mapping_without_memo() -> None:
+    mapping = {"date": "d", "category": "c", "amount": "a"}
+    rows, errs = import_rows("d,c,a\n2026/3/4,x,5\n", mapping)
+    assert errs == []
+    assert rows == [Expense(date(2026, 3, 4), "x", 5, "")]
+
+
+def test_import_mapping_errors() -> None:
+    with pytest.raises(ValueError):
+        import_rows("d,c,a\n", {"date": "d", "category": "c"})
+    with pytest.raises(ValueError):
+        import_rows("d,c\n", {"date": "d", "category": "c", "amount": "a"})
+    with pytest.raises(ValueError):
+        import_rows("利用日,分類,利用金額\n", DEFAULT_MAPPING)  # memo column missing
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..2480a9d
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,103 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+ROWS = [
+    Expense(date(2026, 1, 5), "food", 1000),
+    Expense(date(2026, 1, 9), "food", 1000),
+    Expense(date(2026, 2, 1), "food", 2400),
+    Expense(date(2026, 1, 3), "rent", 5000),
+    Expense(date(2026, 2, 3), "rent", 5000),
+    Expense(date(2026, 1, 7), "gym", 3000),
+    Expense(date(2026, 2, 7), "game", 800),
+    Expense(date(2026, 3, 1), "other", 1),
+]
+
+
+def test_month_diff() -> None:
+    got = month_diff(ROWS, "2026-01", "2026-02")
+    assert [d.category for d in got] == ["gym", "game", "food", "rent"]
+    by = {d.category: d for d in got}
+    assert by["gym"] == DiffRow("gym", 3000, 0, -3000, -100.0, "gone")
+    assert by["food"] == DiffRow("food", 2000, 2400, 400, 20.0, "up")
+    assert by["game"] == DiffRow("game", 0, 800, 800, None, "new")
+    assert by["rent"] == DiffRow("rent", 5000, 5000, 0, 0.0, "same")
+
+
+def test_status_by_presence_not_total() -> None:
+    rows = [
+        Expense(date(2026, 1, 1), "a", 100),
+        Expense(date(2026, 1, 2), "a", -100),
+        Expense(date(2026, 2, 1), "a", 50),
+        Expense(date(2026, 1, 1), "b", 0),
+    ]
+    by = {d.category: d for d in month_diff(rows, "2026-01", "2026-02")}
+    assert by["a"].prev == 0 and by["a"].pct is None and by["a"].status == "up"
+    assert by["b"].status == "gone"
+
+
+def test_down_and_tiebreak_by_category() -> None:
+    rows = [
+        Expense(date(2026, 1, 1), "b", 100),
+        Expense(date(2026, 2, 1), "b", 50),
+        Expense(date(2026, 1, 1), "a", 100),
+        Expense(date(2026, 2, 1), "a", 150),
+    ]
+    got = month_diff(rows, "2026-01", "2026-02")
+    assert [(d.category, d.status, d.pct) for d in got] == [
+        ("a", "up", 50.0),
+        ("b", "down", -50.0),
+    ]
+
+
+@pytest.mark.parametrize(
+    "m", ["2026-1", "2026-13", "2026-00", "202601", "2026-01-01", ""]
+)
+def test_bad_month(m: str) -> None:
+    with pytest.raises(ValueError):
+        month_diff([], m, "2026-01")
+    with pytest.raises(ValueError):
+        month_diff([], "2026-01", m)
+
+
+def test_top_movers() -> None:
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    assert [d.category for d in top_movers(diffs, 2)] == ["gym", "game"]
+    assert [d.category for d in top_movers(diffs, 10)] == ["gym", "game", "food"]
+    assert top_movers(diffs, 0) == []
+    assert len(top_movers(diffs)) == 3
+    with pytest.raises(ValueError):
+        top_movers(diffs, -1)
+
+
+def test_render_diff() -> None:
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "gym\t3000\t0\t-3000\t-100.0%\n"
+        "game\t0\t800\t+800\t-\n"
+        "food\t2000\t2400\t+400\t+20.0%\n"
+        "rent\t5000\t5000\t+0\t+0.0%"
+    )
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_available_months_and_latest_diff() -> None:
+    assert available_months(ROWS) == ["2026-01", "2026-02", "2026-03"]
+    assert available_months([]) == []
+    latest = latest_diff(ROWS)
+    assert latest == month_diff(ROWS, "2026-02", "2026-03")
+    with pytest.raises(ValueError):
+        latest_diff(ROWS[:2])
+    with pytest.raises(ValueError):
+        latest_diff([])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..bf7fbf7
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,83 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def _e(cat: str, memo: str = "") -> Expense:
+    return Expense(date(2026, 1, 1), cat, 100, memo)
+
+
+def test_tokenize() -> None:
+    assert tokenize('(a AND "b c") OR NOT cat:Food and') == [
+        ("LPAREN", "("),
+        ("TERM", "a"),
+        ("AND", "AND"),
+        ("TERM", "b c"),
+        ("RPAREN", ")"),
+        ("OR", "OR"),
+        ("NOT", "NOT"),
+        ("CAT", "Food"),
+        ("TERM", "and"),
+    ]
+
+
+def test_tokenize_quote_keeps_specials() -> None:
+    assert tokenize('"(x) AND"') == [("TERM", "(x) AND")]
+    assert tokenize("   ") == []
+
+
+@pytest.mark.parametrize("q", ['"abc', '""', "cat:", "x cat:"])
+def test_tokenize_errors(q: str) -> None:
+    with pytest.raises(QueryError):
+        tokenize(q)
+
+
+@pytest.mark.parametrize(
+    "q",
+    ["", "   ", "()", "(a", "a)", "a AND", "AND a", "a OR", "OR a", "NOT", "a OR OR b"]
+    + ["a AND AND b", "(a))", "NOT )"],
+)
+def test_syntax_errors(q: str) -> None:
+    with pytest.raises(QueryError):
+        matches(q, _e("x"))
+
+
+def test_query_error_is_value_error() -> None:
+    assert issubclass(QueryError, ValueError)
+
+
+def test_term_matches_memo_or_category_casefold() -> None:
+    assert matches("lunch", _e("食費", "Team LUNCH"))
+    assert matches("食", _e("食費"))
+    assert not matches("tea", _e("食費", "coffee"))
+
+
+def test_cat_exact() -> None:
+    assert matches("cat:food", _e("Food"))
+    assert not matches("cat:foo", _e("Food"))
+
+
+def test_precedence_and_implicit_and() -> None:
+    e = _e("a", "x")
+    assert matches("zzz OR a x", e)  # zzz OR (a AND x)
+    assert not matches("(zzz OR a) zzz", e)
+    assert matches("a x", e) and matches("a AND x", e)
+    assert not matches("NOT a", e)
+    assert matches("NOT NOT a", e)
+    assert matches("NOT zzz a", e)  # (NOT zzz) AND a
+    assert not matches("NOT (zzz OR a)", e)
+
+
+def test_filter_rows_order_and_invalid_on_empty() -> None:
+    rows = [_e("a", "1"), _e("b", "2"), _e("a", "3")]
+    assert filter_rows("cat:a", rows) == [rows[0], rows[2]]
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
+
+
+def test_deep_nesting_is_query_error() -> None:
+    with pytest.raises(QueryError):
+        matches("(" * 5000 + "a" + ")" * 5000, _e("a"))
