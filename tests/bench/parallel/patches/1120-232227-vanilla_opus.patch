+++ b/src/kakeibo/csv_import.py
@@ -0,0 +1,384 @@
+"""銀行・カード会社の明細 CSV を Expense に変換する(純粋関数のみ。ファイル I/O なし)。
+
+会社ごとの違い(列名・日付形式・金額の書き方・出金/入金の列構成)は `Profile` で吸収する。
+
+    text = decode_bytes(path.read_bytes())       # I/O は呼び出し側で
+    result = parse_statement(text, profile)
+    for err in result.errors:
+        print(err)                               # 例: 5行目 列「利用金額」 値 '1,2a4': 数値として読めません
+
+金額の符号: 戻り値の Expense.amount は「支出 = 正」。入金・返金は負になる
+(`Profile.skip_inflows=True` なら入金行は取り込まず `skipped` に行番号を残す)。
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date, datetime
+
+from kakeibo.core import Expense
+
+DEFAULT_DATE_FORMATS: tuple[str, ...] = (
+    "%Y-%m-%d",
+    "%Y/%m/%d",
+    "%Y.%m.%d",
+    "%Y年%m月%d日",
+    "%Y%m%d",
+)
+
+
+class StatementFormatError(ValueError):
+    """ファイル全体として読めない(文字コード不明・ヘッダ行なし・CSV 構文エラー)。"""
+
+
+@dataclass(frozen=True)
+class Profile:
+    """1 社分の CSV 形式。列は「候補名のタプル」で、ヘッダ中で最初に見つかったものを使う。
+
+    金額は次のどちらか一方で指定する:
+      - amount: 1 列に符号付き金額。negative_is_outflow=True なら負の値が支出(銀行に多い)、
+        False なら正の値が支出(カード会社に多い)。
+      - outflow / inflow: 出金列と入金列が分かれている形式(片方だけでもよい)。空欄は 0 扱い。
+
+    列名の照合は NFKC 正規化・空白除去後の完全一致(全角/半角や「ご利用 金額」の空白差は吸収)。
+    """
+
+    name: str
+    date: tuple[str, ...]
+    amount: tuple[str, ...] = ()
+    outflow: tuple[str, ...] = ()
+    inflow: tuple[str, ...] = ()
+    memo: tuple[str, ...] = ()
+    category: tuple[str, ...] = ()
+    default_category: str = "未分類"
+    date_formats: tuple[str, ...] = DEFAULT_DATE_FORMATS
+    negative_is_outflow: bool = False
+    skip_inflows: bool = False
+
+    def __post_init__(self) -> None:
+        if not self.date:
+            raise ValueError(f"{self.name}: date 列の候補が必要です")
+        split = bool(self.outflow or self.inflow)
+        if bool(self.amount) == split:
+            raise ValueError(
+                f"{self.name}: amount か outflow/inflow のどちらか一方を指定してください"
+            )
+        if not self.date_formats:
+            raise ValueError(f"{self.name}: date_formats が空です")
+
+    def _fields(self) -> dict[str, tuple[str, ...]]:
+        """論理名 -> 候補列名(指定されたものだけ。指定した列はすべて必須)。"""
+        fields = {
+            "日付": self.date,
+            "金額": self.amount,
+            "出金": self.outflow,
+            "入金": self.inflow,
+            "メモ": self.memo,
+            "カテゴリ": self.category,
+        }
+        return {k: v for k, v in fields.items() if v}
+
+
+@dataclass(frozen=True)
+class RowError:
+    """不正な行の 1 箇所。line はファイル上の行番号(1 始まり、複数行セルは開始行)。"""
+
+    line: int
+    column: str | None  # ファイル上の列名(行全体の問題なら None)
+    value: str | None
+    reason: str
+
+    def __str__(self) -> str:
+        parts = [f"{self.line}行目"]
+        if self.column is not None:
+            parts.append(f"列「{self.column}」")
+        if self.value is not None:
+            parts.append(f"値 {self.value!r}")
+        return " ".join(parts) + f": {self.reason}"
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: tuple[Expense, ...]
+    errors: tuple[RowError, ...]
+    skipped: tuple[int, ...]  # skip_inflows で除外した行番号
+    header_line: int
+
+    @property
+    def ok(self) -> bool:
+        return not self.errors
+
+
+# ---------------------------------------------------------------- 値のパース
+
+_MINUS_CHARS = str.maketrans({c: "-" for c in "−‐‑‒–﹣"})
+_NUMBER_RE = re.compile(r"(?P<int>\d{1,3}(?:,\d{3})+|\d+)(?:\.(?P<frac>\d+))?")
+
+
+def _normalize(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).translate(_MINUS_CHARS)
+
+
+def _strip_currency(s: str) -> str:
+    # cp932 の CSV では円記号がバックスラッシュとして出てくることがある
+    return s.removeprefix("¥").removeprefix("\\").removesuffix("円")
+
+
+def parse_amount(raw: str) -> int:
+    """会社ごとの金額表記を円の整数にする。読めなければ ValueError(理由つき)。
+
+    対応: 桁区切り「1,234」、全角「１，２３４」、通貨記号「¥1,234」「1,234円」、
+    符号「-1,234」「+1,234」「1,234-」「△1,234」「▲1,234」「(1,234)」、端数ゼロ「1234.00」。
+    """
+    s = "".join(_normalize(raw).split())
+    if not s:
+        raise ValueError("金額が空です")
+    signs = 0
+    negative = False
+    s = _strip_currency(s)
+    if s and s[0] in "△▲":
+        signs, negative, s = signs + 1, True, s[1:]
+    if len(s) >= 2 and s[0] == "(" and s[-1] == ")":
+        signs, negative, s = signs + 1, True, s[1:-1]
+    if s and s[0] in "+-":
+        signs, negative, s = signs + 1, s[0] == "-", s[1:]
+    if s and s[-1] == "-":
+        signs, negative, s = signs + 1, True, s[:-1]
+    if signs > 1:
+        raise ValueError("符号が重複しています")
+    s = _strip_currency(s)
+    m = _NUMBER_RE.fullmatch(s)
+    if m is None:
+        raise ValueError("数値として読めません")
+    frac = m.group("frac")
+    if frac and frac.strip("0"):
+        raise ValueError("円未満の端数があります")
+    n = int(m.group("int").replace(",", ""))
+    return -n if negative else n
+
+
+def parse_date(raw: str, formats: tuple[str, ...] = DEFAULT_DATE_FORMATS) -> date:
+    """formats を順に試して日付にする。読めなければ ValueError(理由つき)。"""
+    s = _normalize(raw).strip()
+    if not s:
+        raise ValueError("日付が空です")
+    for fmt in formats:
+        # "%Y%m%d" に "2026115" のような桁不足を通すと曖昧に解釈されるので 8 桁に限る
+        if fmt == "%Y%m%d" and not (s.isdigit() and len(s) == 8):
+            continue
+        try:
+            return datetime.strptime(s, fmt).date()
+        except ValueError:
+            continue
+    raise ValueError(f"日付として読めません(対応形式: {', '.join(formats)})")
+
+
+def decode_bytes(data: bytes) -> str:
+    """UTF-8(BOM 可)→ CP932(Shift_JIS)の順に試してデコードする。"""
+    for enc in ("utf-8-sig", "cp932"):
+        try:
+            return data.decode(enc)
+        except UnicodeDecodeError:
+            continue
+    raise StatementFormatError("文字コードを判別できません(UTF-8 / Shift_JIS 以外)")
+
+
+# ---------------------------------------------------------------- ヘッダ探索
+
+
+def _header_key(name: str) -> str:
+    return "".join(_normalize(name).split())
+
+
+def _match_header(row: list[str], profile: Profile) -> tuple[dict[str, int], list[str]]:
+    """(論理名 -> 列番号, 見つからなかった論理名)。"""
+    index: dict[str, int] = {}
+    for i, cell in enumerate(row):
+        index.setdefault(_header_key(cell), i)
+    found: dict[str, int] = {}
+    missing: list[str] = []
+    for field, candidates in profile._fields().items():
+        for c in candidates:
+            if _header_key(c) in index:
+                found[field] = index[_header_key(c)]
+                break
+        else:
+            missing.append(field)
+    return found, missing
+
+
+def _read_records(text: str) -> list[tuple[int, list[str]]]:
+    """(開始行番号, セル) のリスト。先頭 BOM は除去する。"""
+    reader = csv.reader(io.StringIO(text.removeprefix("﻿"), newline=""))
+    out: list[tuple[int, list[str]]] = []
+    prev = 0
+    try:
+        for row in reader:
+            out.append((prev + 1, row))
+            prev = reader.line_num
+    except csv.Error as e:
+        raise StatementFormatError(
+            f"{prev + 1}行目: CSV として読めません: {e}"
+        ) from None
+    return out
+
+
+def _is_blank(row: list[str]) -> bool:
+    return all(not c.strip() for c in row)
+
+
+def _find_header(
+    records: list[tuple[int, list[str]]], profile: Profile
+) -> tuple[int, dict[str, int]]:
+    """必要な列がすべて揃う最初の行をヘッダとみなす(前置きの口座情報行などは読み飛ばす)。"""
+    best: tuple[int, list[str], list[str]] | None = None  # (行, 不足, 行の中身)
+    for pos, (line, row) in enumerate(records):
+        cols, missing = _match_header(row, profile)
+        if not missing:
+            return pos, cols
+        if not _is_blank(row) and (best is None or len(missing) < len(best[1])):
+            best = (line, missing, row)
+    fields = profile._fields()
+    want = "、".join(f"{f}({' / '.join(fields[f])})" for f in fields)
+    msg = f"[{profile.name}] ヘッダ行が見つかりません。必要な列: {want}"
+    if best is not None:
+        line, missing, row = best
+        msg += f"。最も近い {line}行目 {row} には {'、'.join(missing)} の列がありません"
+    raise StatementFormatError(msg)
+
+
+# ---------------------------------------------------------------- 本体
+
+
+def _cell(
+    row: list[str], header: list[str], cols: dict[str, int], field: str, line: int
+) -> tuple[str | None, RowError | None]:
+    i = cols[field]
+    if i >= len(row):
+        return None, RowError(
+            line,
+            header[i],
+            None,
+            f"列が足りません(この行は {len(row)} 列、ヘッダは {len(header)} 列)",
+        )
+    return row[i], None
+
+
+def _parse_record(
+    line: int, row: list[str], header: list[str], cols: dict[str, int], profile: Profile
+) -> tuple[Expense | None, list[RowError]]:
+    errors: list[RowError] = []
+
+    def get(field: str) -> str | None:
+        value, err = _cell(row, header, cols, field, line)
+        if err is not None:
+            errors.append(err)
+        return value
+
+    def bad(field: str, value: str, e: ValueError) -> None:
+        errors.append(RowError(line, header[cols[field]], value, str(e)))
+
+    day: date | None = None
+    raw = get("日付")
+    if raw is not None:
+        try:
+            day = parse_date(raw, profile.date_formats)
+        except ValueError as e:
+            bad("日付", raw, e)
+
+    amount: int | None = None
+    if profile.amount:
+        raw = get("金額")
+        if raw is not None:
+            try:
+                v = parse_amount(raw)
+                amount = -v if profile.negative_is_outflow else v
+            except ValueError as e:
+                bad("金額", raw, e)
+    else:
+        parts: dict[str, int] = {}
+        ok = True
+        for field in ("出金", "入金"):
+            if field not in cols:
+                continue
+            raw = get(field)
+            if raw is None:
+                ok = False
+            elif raw.strip():
+                try:
+                    parts[field] = parse_amount(raw)
+                except ValueError as e:
+                    bad(field, raw, e)
+                    ok = False
+        if ok:
+            nonzero = [f for f, v in parts.items() if v != 0]
+            if len(nonzero) == 2:
+                errors.append(
+                    RowError(line, None, None, "出金と入金の両方に金額があります")
+                )
+            elif not parts:
+                names = "・".join(
+                    header[cols[f]] for f in ("出金", "入金") if f in cols
+                )
+                errors.append(
+                    RowError(line, None, None, f"金額がありません({names} が空)")
+                )
+            else:
+                amount = parts.get("出金", 0) - parts.get("入金", 0)
+
+    memo = ""
+    if "メモ" in cols:
+        memo = (get("メモ") or "").strip()
+    category = profile.default_category
+    if "カテゴリ" in cols:
+        category = (get("カテゴリ") or "").strip() or profile.default_category
+
+    if errors or day is None or amount is None:
+        return None, errors
+    return Expense(day=day, category=category, amount=amount, memo=memo), []
+
+
+def parse_statement(text: str, profile: Profile) -> ImportResult:
+    """明細 CSV のテキストを Expense に変換する。
+
+    - ヘッダ行より前の行(口座情報など)と空行は無視する。
+    - 不正な行は取り込まず、悪い箇所ごとに RowError を返す(1 行に複数あればすべて)。
+    - ファイル全体として読めない場合だけ StatementFormatError を送出する。
+    """
+    records = _read_records(text)
+    pos, cols = _find_header(records, profile)
+    header_line, header = records[pos]
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    skipped: list[int] = []
+    for line, row in records[pos + 1 :]:
+        if _is_blank(row):
+            continue
+        expense, row_errors = _parse_record(line, row, header, cols, profile)
+        errors.extend(row_errors)
+        if expense is None:
+            continue
+        if profile.skip_inflows and expense.amount < 0:
+            skipped.append(line)
+            continue
+        expenses.append(expense)
+    return ImportResult(tuple(expenses), tuple(errors), tuple(skipped), header_line)
+
+
+def detect_profile(text: str, profiles: list[Profile]) -> Profile | None:
+    """ヘッダ行が見つかる最初の Profile を返す(どれも合わなければ None)。"""
+    try:
+        records = _read_records(text)
+    except StatementFormatError:
+        return None
+    for p in profiles:
+        try:
+            _find_header(records, p)
+        except StatementFormatError:
+            continue
+        return p
+    return None
diff --git a/tests/test_csv_import.py b/tests/test_csv_import.py
