+++ b/tests/test_csv_import.py
@@ -0,0 +1,346 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.csv_import import (
+    Profile,
+    RowError,
+    StatementFormatError,
+    decode_bytes,
+    detect_profile,
+    parse_amount,
+    parse_date,
+    parse_statement,
+)
+
+# 架空の 3 形式(列名・符号・出金入金の分け方がそれぞれ違う)
+CARD = Profile(
+    name="card",
+    date=("利用日", "ご利用日"),
+    amount=("利用金額", "ご利用金額"),
+    memo=("利用店名", "ご利用先"),
+)
+BANK_SPLIT = Profile(
+    name="bank-split",
+    date=("取引日",),
+    outflow=("お引出し", "出金金額"),
+    inflow=("お預入れ", "入金金額"),
+    memo=("摘要",),
+)
+BANK_SIGNED = Profile(
+    name="bank-signed",
+    date=("Date",),
+    amount=("Amount",),
+    memo=("Description",),
+    category=("Category",),
+    negative_is_outflow=True,
+    date_formats=("%m/%d/%Y",),
+)
+
+
+# ---------------------------------------------------------------- parse_amount
+
+
+@pytest.mark.parametrize(
+    ("raw", "want"),
+    [
+        ("1234", 1234),
+        ("1,234", 1234),
+        ("  1,234,567 ", 1234567),
+        ("１，２３４", 1234),
+        ("¥1,234", 1234),
+        ("￥1,234", 1234),
+        ("\\1,234", 1234),
+        ("1,234円", 1234),
+        ("+500", 500),
+        ("-500", -500),
+        ("−500", -500),  # U+2212
+        ("－500", -500),  # 全角ハイフンマイナス
+        ("500-", -500),
+        ("△500", -500),
+        ("▲1,000", -1000),
+        ("(1,000)", -1000),
+        ("-¥1,000", -1000),
+        ("¥-1,000", -1000),
+        ("1234.00", 1234),
+        ("0", 0),
+    ],
+)
+def test_parse_amount_accepts_company_notations(raw, want):
+    assert parse_amount(raw) == want
+
+
+@pytest.mark.parametrize(
+    ("raw", "reason"),
+    [
+        ("", "金額が空です"),
+        ("   ", "金額が空です"),
+        ("abc", "数値として読めません"),
+        ("1,2a4", "数値として読めません"),
+        ("12,34", "数値として読めません"),  # 桁区切りの位置が不正
+        ("1234.5", "円未満の端数があります"),
+        ("△-500", "符号が重複しています"),
+        ("-500-", "符号が重複しています"),
+        ("¥", "数値として読めません"),
+    ],
+)
+def test_parse_amount_rejects_with_reason(raw, reason):
+    with pytest.raises(ValueError, match=reason):
+        parse_amount(raw)
+
+
+# ---------------------------------------------------------------- parse_date
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-11-05",
+        "2026/11/05",
+        "2026/11/5",
+        "2026.11.05",
+        "2026年11月5日",
+        "２０２６／１１／０５",
+        "20261105",
+        " 2026/11/05 ",
+    ],
+)
+def test_parse_date_default_formats(raw):
+    assert parse_date(raw) == date(2026, 11, 5)
+
+
+@pytest.mark.parametrize("raw", ["2026115", "2026/13/01", "2026/02/30", "11/05", "x"])
+def test_parse_date_rejects(raw):
+    with pytest.raises(ValueError, match="日付として読めません"):
+        parse_date(raw)
+
+
+def test_parse_date_empty():
+    with pytest.raises(ValueError, match="日付が空です"):
+        parse_date("")
+
+
+def test_parse_date_custom_format():
+    assert parse_date("11/05/2026", ("%m/%d/%Y",)) == date(2026, 11, 5)
+
+
+# ---------------------------------------------------------------- decode_bytes
+
+
+def test_decode_bytes_utf8_bom_and_cp932():
+    assert decode_bytes("\ufeff利用日".encode()) == "利用日"
+    assert decode_bytes("利用日,￥".encode("cp932")) == "利用日,￥"
+
+
+def test_decode_bytes_unknown():
+    with pytest.raises(StatementFormatError):
+        decode_bytes(b"\xff\xfe\xfa\x80\x81")
+
+
+# ---------------------------------------------------------------- Profile
+
+
+def test_profile_requires_exactly_one_amount_style():
+    with pytest.raises(ValueError):
+        Profile(name="x", date=("d",))
+    with pytest.raises(ValueError):
+        Profile(name="x", date=("d",), amount=("a",), outflow=("o",))
+    with pytest.raises(ValueError):
+        Profile(name="x", date=(), amount=("a",))
+    Profile(name="x", date=("d",), outflow=("o",))  # 出金列のみも可
+
+
+# ---------------------------------------------------------------- parse_statement
+
+
+def test_card_statement_positive_is_outflow():
+    text = (
+        "ご利用日,ご利用先,ご利用金額\n"
+        '2026/11/01,コンビニ,"1,200"\n'
+        "2026/11/02,返品,-300\n"
+    )
+    r = parse_statement(text, CARD)
+    assert r.ok
+    assert r.header_line == 1
+    assert r.expenses == (
+        Expense(date(2026, 11, 1), "未分類", 1200, "コンビニ"),
+        Expense(date(2026, 11, 2), "未分類", -300, "返品"),
+    )
+
+
+def test_bank_split_columns_and_preamble_is_skipped():
+    text = (
+        "口座番号,1234567\n"
+        "照会期間,2026/11/01～2026/11/30\n"
+        "\n"
+        "取引日,摘要,お引出し,お預入れ,残高\n"
+        "2026/11/01,デンキ,8000,,100000\n"
+        "2026/11/25,キュウヨ,,300000,400000\n"
+    )
+    r = parse_statement(text, BANK_SPLIT)
+    assert r.ok
+    assert r.header_line == 4
+    assert [(e.memo, e.amount) for e in r.expenses] == [
+        ("デンキ", 8000),
+        ("キュウヨ", -300000),
+    ]
+
+
+def test_skip_inflows_records_skipped_lines():
+    p = Profile(
+        name="b",
+        date=("取引日",),
+        outflow=("お引出し",),
+        inflow=("お預入れ",),
+        skip_inflows=True,
+    )
+    text = "取引日,お引出し,お預入れ\n2026/11/01,800,\n2026/11/02,,5000\n"
+    r = parse_statement(text, p)
+    assert [e.amount for e in r.expenses] == [800]
+    assert r.skipped == (3,)
+    assert r.ok
+
+
+def test_signed_bank_with_category_and_custom_dates():
+    text = (
