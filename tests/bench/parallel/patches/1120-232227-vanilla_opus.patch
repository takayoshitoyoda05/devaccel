+def test_bad_rows_report_line_column_value_and_reason():
+    text = (
+        "ご利用日,ご利用先,ご利用金額\n"
+        "2026/11/01,OK,100\n"
+        "2026/13/01,月が変,200\n"
+        '2026/11/03,金額が変,"1,2a4"\n'
+        '2026/11/04,"メモが\n改行",abc\n'  # 複数行セル: 開始行(5)を報告
+        "昨日,両方変,\n"
+        "2026/11/06,短い\n"
+        "2026/11/07,OK2,300\n"
+    )
+    r = parse_statement(text, CARD)
+    assert not r.ok
+    assert [e.memo for e in r.expenses] == ["OK", "OK2"]
+    date_reason = "日付として読めません(対応形式: " + ", ".join(CARD.date_formats) + ")"
+    assert r.errors == (
+        RowError(3, "ご利用日", "2026/13/01", date_reason),
+        RowError(4, "ご利用金額", "1,2a4", "数値として読めません"),
+        RowError(5, "ご利用金額", "abc", "数値として読めません"),
+        RowError(7, "ご利用日", "昨日", date_reason),
+        RowError(7, "ご利用金額", "", "金額が空です"),
+        RowError(8, "ご利用金額", None, "列が足りません(この行は 2 列、ヘッダは 3 列)"),
+    )
