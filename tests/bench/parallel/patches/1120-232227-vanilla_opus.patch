+def test_header_names_are_normalized():
+    # 全角英数・空白の差・BOM を吸収する
+    text = "\ufeff ＤＡＴＥ ,Ａｍｏｕｎｔ,Desc ription,Category\n11/01/2026,-100,x,y\n"
+    p = Profile(
+        name="n",
+        date=("Date",),
+        amount=("Amount",),
+        memo=("Description",),
+        category=("Category",),
+        date_formats=("%m/%d/%Y",),
+    )
+    # DATE は大文字小文字が違うので一致しない -> ヘッダなし
+    with pytest.raises(StatementFormatError):
+        parse_statement(text, p)
+    text = "\ufeff Ｄａｔｅ ,Ａｍｏｕｎｔ,Desc ription,Category\n11/01/2026,-100,x,y\n"
+    r = parse_statement(text, p)
+    assert r.ok and r.expenses[0].memo == "x"
