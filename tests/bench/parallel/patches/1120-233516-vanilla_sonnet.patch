@@ -0,0 +1,82 @@
+"""Pure budget alert evaluation: exceeded / near-limit per month and category."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from enum import Enum
+
+from kakeibo.core import Budget
+
+
+class Level(Enum):
+    OK = "ok"
+    NEAR = "near"  # threshold reached but not exceeded
+    OVER = "over"  # actual > limit
+
+
+@dataclass(frozen=True)
+class Alert:
+    month: str
+    category: str
+    level: Level
+    limit: int
+    actual: int
+
+    @property
+    def remaining(self) -> int:
+        """Yen left before the limit (negative when exceeded)."""
+        return self.limit - self.actual
+
+
+def classify(actual: int, limit: int, near_percent: int = 80) -> Level:
+    """OVER if actual > limit; NEAR if actual >= near_percent% of limit.
+
+    Integer arithmetic only. limit == 0 means any spending is OVER and no
+    spending is OK.
+    """
+    if not 0 <= near_percent <= 100:
+        raise ValueError("near_percent は 0〜100 である必要があります")
+    if actual > limit:
+        return Level.OVER
+    if limit > 0 and actual * 100 >= limit * near_percent:
+        return Level.NEAR
+    return Level.OK
+
+
+def evaluate(
+    totals: dict[str, dict[str, int]],
+    budget: Budget,
+    near_percent: int = 80,
+) -> list[Alert]:
+    """Return NEAR/OVER alerts for categories that have a budget.
+
+    Order: month ascending, then OVER before NEAR, then higher usage ratio
+    first, then category name for stability.
+    """
+    out: list[Alert] = []
+    for month in sorted(totals):
+        limits = budget.for_month(month)
+        for cat, actual in totals[month].items():
+            if cat not in limits:
+                continue
+            level = classify(actual, limits[cat], near_percent)
+            if level is not Level.OK:
+                out.append(Alert(month, cat, level, limits[cat], actual))
+
+    def key(a: Alert) -> tuple[str, int, float, str]:
+        ratio = a.actual / a.limit if a.limit else float("inf")
+        return (a.month, 0 if a.level is Level.OVER else 1, -ratio, a.category)
+
+    return sorted(out, key=key)
+
+
+def format_alert(a: Alert) -> str:
+    if a.level is Level.OVER:
+        return (
+            f"超過: {a.month} {a.category} {-a.remaining:,}円超過 "
+            f"(予算 {a.limit:,} / 実績 {a.actual:,})"
+        )
+    return (
+        f"注意: {a.month} {a.category} 予算まで残り {a.remaining:,}円 "
+        f"(予算 {a.limit:,} / 実績 {a.actual:,})"
+    )
diff --git a/tests/test_alerts.py b/tests/test_alerts.py
new file mode 100644
index 0000000..b838b57
--- /dev/null
+++ b/tests/test_alerts.py
@@ -0,0 +1,61 @@
+import pytest
+
+from kakeibo.alerts import Alert, Level, classify, evaluate, format_alert
+from kakeibo.core import Budget
+
+
+@pytest.mark.parametrize(
+    "actual,limit,pct,expected",
+    [
+        (0, 1000, 80, Level.OK),
+        (799, 1000, 80, Level.OK),
+        (800, 1000, 80, Level.NEAR),
+        (1000, 1000, 80, Level.NEAR),  # ちょうど予算額は超過ではない
+        (1001, 1000, 80, Level.OVER),
+        (0, 0, 80, Level.OK),
+        (1, 0, 80, Level.OVER),
+        (1000, 1000, 100, Level.NEAR),
+        (999, 1000, 100, Level.OK),
+    ],
+)
+def test_classify(actual, limit, pct, expected):
+    assert classify(actual, limit, pct) is expected
+
+
+@pytest.mark.parametrize("pct", [-1, 101])
+def test_classify_bad_percent(pct):
+    with pytest.raises(ValueError):
+        classify(1, 10, pct)
+
+
+def test_evaluate_order_and_filtering():
+    b = Budget({"food": 1000, "rent": 80000, "fun": 500}, {"2026-11": {"fun": 100}})
+    totals = {
+        "2026-11": {"rent": 80000, "food": 850, "fun": 150, "misc": 9999},
+        "2026-10": {"food": 1200, "fun": 100},
+    }
+    got = evaluate(totals, b)
+    # 2026-10 fun (20%) と予算なしの misc は出ない
+    assert [(a.month, a.category, a.level) for a in got] == [
+        ("2026-10", "food", Level.OVER),
+        ("2026-11", "fun", Level.OVER),
+        ("2026-11", "rent", Level.NEAR),
+        ("2026-11", "food", Level.NEAR),
+    ]
+
+
+def test_evaluate_empty():
+    assert evaluate({}, Budget({"food": 1}, {})) == []
+    assert evaluate({"2026-11": {"food": 5}}, Budget({}, {})) == []
+
+
+def test_remaining_and_format():
+    over = Alert("2026-11", "food", Level.OVER, 1000, 1150)
+    near = Alert("2026-11", "food", Level.NEAR, 1000, 900)
+    assert over.remaining == -150 and near.remaining == 100
+    assert (
+        format_alert(over) == "超過: 2026-11 food 150円超過 (予算 1,000 / 実績 1,150)"
+    )
+    assert format_alert(near) == (
+        "注意: 2026-11 food 予算まで残り 100円 (予算 1,000 / 実績 900)"
+    )
