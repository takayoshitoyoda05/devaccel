+def test_results_sorted_by_category_amount_then_first_day() -> None:
+    rows = [
+        e(date(2026, 1, 5), category="rent", amount=100),
+        e(date(2026, 2, 5), category="rent", amount=100),
+        e(date(2026, 3, 5), category="rent", amount=100),
+        e(date(2026, 7, 5), category="rent", amount=100),
+        e(date(2026, 8, 5), category="rent", amount=100),
+        e(date(2026, 9, 5), category="rent", amount=100),
+        e(date(2026, 1, 10), category="gas", amount=900),
+        e(date(2026, 2, 10), category="gas", amount=900),
+        e(date(2026, 3, 10), category="gas", amount=900),
+        e(date(2026, 1, 20), category="gas", amount=50),
+        e(date(2026, 2, 20), category="gas", amount=50),
+        e(date(2026, 3, 20), category="gas", amount=50),
+    ]
+    keys = [(r.category, r.amount, r.days[0]) for r in find_recurring(rows)]
