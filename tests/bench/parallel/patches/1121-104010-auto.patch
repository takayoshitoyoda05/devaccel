@@ -0,0 +1,109 @@
+"""Month-over-month expense comparison (pure functions).
+
+D2: 負の金額(返金)は月の合計にそのまま含めて相殺する。
+D3: データの無い月は空の月(全カテゴリ 0)として比べる。最初の月は比較相手が無いので
+    previous_month=None とし、内訳は全て status="new"(previous=0、diff=current、rate=None)で出す。
+D4: 前月が 0 のカテゴリの増減率 rate は None。rate は丸めず小数のまま持つ。
+R-note: 両月とも 0 のカテゴリは出さない。changes は |diff| 降順、同点はカテゴリ昇順。
+R-note: 見出しは最初の月だけ `YYYY-MM`、以降は `YYYY-MM (前月 YYYY-MM)`(表示の判断)。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from kakeibo.core import Expense, monthly_totals
+
+
+@dataclass(frozen=True)
+class Change:
+    category: str
+    previous: int
+    current: int
+    diff: int
+    rate: float | None
+    status: str
+
+
+@dataclass(frozen=True)
+class MonthComparison:
+    month: str
+    previous_month: str | None
+    changes: list[Change]
+
+
+_MARK = {
+    "increased": "増",
+    "decreased": "減",
+    "new": "新",
+    "gone": "消",
+    "unchanged": "同",
+}
+
+
+def _month_range(first: str, last: str) -> list[str]:
+    """Inclusive list of "YYYY-MM" from first to last, one month at a time."""
+    y, m = int(first[:4]), int(first[5:])
+    end = (int(last[:4]), int(last[5:]))
+    out: list[str] = []
+    while (y, m) <= end:
+        out.append(f"{y:04d}-{m:02d}")
+        m += 1
+        if m == 13:
+            y, m = y + 1, 1
+    return out
+
+
+def _status(previous: int, current: int, diff: int) -> str:
+    if previous == 0 and current > 0:
+        return "new"
+    if previous > 0 and current == 0:
+        return "gone"
+    if diff > 0:
+        return "increased"
+    if diff < 0:
+        return "decreased"
+    return "unchanged"
+
+
+def compare_months(rows: list[Expense]) -> list[MonthComparison]:
+    if not rows:
+        return []
+    totals = monthly_totals(rows)
+    months = _month_range(min(totals), max(totals))
+    result: list[MonthComparison] = []
+    prev_month: str | None = None
+    prev_cats: dict[str, int] = {}
+    for month in months:
+        cur_cats = totals.get(month, {})
+        changes: list[Change] = []
+        for cat in set(prev_cats) | set(cur_cats):
+            previous = prev_cats.get(cat, 0)
+            current = cur_cats.get(cat, 0)
+            if previous == 0 and current == 0:
+                continue
+            diff = current - previous
+            rate = None if previous == 0 else diff / previous
+            if prev_month is None:
+                status = "new"
+            else:
+                status = _status(previous, current, diff)
+            changes.append(Change(cat, previous, current, diff, rate, status))
+        changes.sort(key=lambda c: (-abs(c.diff), c.category))
+        result.append(MonthComparison(month, prev_month, changes))
+        prev_month = month
+        prev_cats = cur_cats
+    return result
+
+
+def render_comparison(comparisons: list[MonthComparison]) -> str:
+    lines: list[str] = []
+    for comp in comparisons:
+        if comp.previous_month is None:
+            lines.append(comp.month)
+        else:
+            lines.append(f"{comp.month} (前月 {comp.previous_month})")
+        for c in comp.changes:
+            rate = "(—)" if c.rate is None else f"({c.rate * 100:+.1f}%)"
+            lines.append(f"  {c.category}  {c.diff:+,}円  {rate}  {_MARK[c.status]}")
+    return "\n".join(lines)
