@@ -0,0 +1,298 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import ImportResult, RowError, import_bank_csv
+from kakeibo.core import Expense
+
+
+@pytest.mark.parametrize(
+    ("text", "rows", "error_pairs"),
+    [
+        pytest.param(
+            '利用日,ご利用店名,利用金額\n2026/1/5,ＮＥＴＦＬＩＸ,"1,490円"\n',
+            [Expense(date(2026, 1, 5), "未分類", 1490, "NETFLIX")],
+            [],
+            id="E2-1",
+        ),
+        pytest.param(
+            "日付,金額\n2026-01-05,△500\n",
+            [Expense(date(2026, 1, 5), "未分類", -500, "")],
+            [],
+            id="E2-2",
+        ),
+        pytest.param(
+            "日付,金額\n2026/2/30,abc\n",
+            [],
+            [(2, "日付"), (2, "金額")],
+            id="E2-3",
+        ),
+    ],
+)
+def test_example_table(text, rows, error_pairs):
+    result = import_bank_csv(text)
+    assert result.rows == rows
+    assert [(e.line, e.column) for e in result.errors] == error_pairs
+
+
+# R1: 区切り・BOM・改行・引用符内のレコード
+def test_R1_bom_and_crlf_are_accepted():
+    result = import_bank_csv("﻿日付,金額\r\n2026-01-05,100\r\n")
+    assert result.rows == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+def test_R1_tab_delimiter_detected_from_header():
+    result = import_bank_csv("日付\t金額\n2026-01-05\t100\n")
+    assert result.rows == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+def test_R1_quoted_newline_is_one_record_and_line_is_record_start():
+    text = '日付,金額,摘要\n2026-01-05,100,"A\nB"\n2026/13/01,abc,x\n'
+    result = import_bank_csv(text)
+    assert result.rows == [Expense(date(2026, 1, 5), "未分類", 100, "A\nB")]
+    assert [(e.line, e.column) for e in result.errors] == [(4, "日付"), (4, "金額")]
+
+
+# D8: 区切りは最初の非空行で決める
+def test_D8_delimiter_uses_first_nonblank_line():
+    result = import_bank_csv("\n日付\t金額\n2026-01-05\t100\n")
+    assert result.rows == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+# R2: 列名の別名・前後空白・大文字小文字
+@pytest.mark.parametrize("alias", ["日付", "利用日", "取引日", "ご利用日", "date"])
+def test_R2_date_aliases(alias):
+    result = import_bank_csv(f"{alias},金額\n2026-01-05,100\n")
+    assert result.rows[0].day == date(2026, 1, 5)
+
+
+@pytest.mark.parametrize("alias", ["金額", "利用金額", "ご利用金額", "amount"])
+def test_R2_amount_aliases(alias):
+    result = import_bank_csv(f"日付,{alias}\n2026-01-05,100\n")
+    assert result.rows[0].amount == 100
+
+
+@pytest.mark.parametrize("alias", ["出金", "出金額", "支払", "お支払金額"])
+def test_R2_withdrawal_aliases(alias):
+    result = import_bank_csv(f"日付,{alias}\n2026-01-05,300\n")
+    assert result.rows[0].amount == 300
+
+
+@pytest.mark.parametrize("alias", ["入金", "入金額", "預入", "お預り金額"])
+def test_R2_deposit_aliases_are_skipped_when_only_deposit(alias):
+    result = import_bank_csv(f"日付,出金,{alias}\n2026-01-05,,500\n")
+    assert result == ImportResult([], [])
+
+
+@pytest.mark.parametrize(
+    "alias", ["摘要", "メモ", "利用店名", "ご利用店名", "内容", "description", "memo"]
+)
+def test_R2_memo_aliases(alias):
+    result = import_bank_csv(f"日付,金額,{alias}\n2026-01-05,100,メモ値\n")
+    assert result.rows[0].memo == "メモ値"
+
+
+@pytest.mark.parametrize("alias", ["カテゴリ", "category"])
+def test_R2_category_aliases(alias):
+    result = import_bank_csv(f"日付,金額,{alias}\n2026-01-05,100,食費\n")
+    assert result.rows[0].category == "食費"
+
+
+def test_R2_header_is_stripped_and_case_insensitive():
+    result = import_bank_csv(" DATE , Amount \n2026-01-05,100\n")
+    assert result.rows == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+def test_R2_missing_date_column_raises():
+    with pytest.raises(ValueError):
+        import_bank_csv("金額\n100\n")
+
+
+def test_R2_missing_amount_and_withdrawal_raises():
+    with pytest.raises(ValueError):
+        import_bank_csv("日付,摘要\n2026-01-05,x\n")
+
+
+# D1: 同じ系列の別名は、ヘッダー上で先に現れる列を使う
+def test_D1_first_matching_column_in_header_wins():
+    result = import_bank_csv("利用日,日付,金額\n2026-01-05,2026-02-06,100\n")
+    assert result.rows[0].day == date(2026, 1, 5)
+
+
+# D2: 金額列があれば出金列は無視する
+def test_D2_amount_column_preferred_over_withdrawal():
+    result = import_bank_csv("日付,金額,出金\n2026-01-05,100,999\n")
+    assert result.rows[0].amount == 100
+
+
+# D3: 出金の値を使い、入金の値は使わない
+def test_D3_withdrawal_wins_over_deposit_value():
+    result = import_bank_csv("日付,出金,入金\n2026-01-05,300,999\n")
+    assert result.rows == [Expense(date(2026, 1, 5), "未分類", 300, "")]
+
+
+# D4: 出金も入金も空なら出金列の RowError
+def test_D4_both_empty_is_row_error_on_withdrawal():
+    result = import_bank_csv("日付,出金,入金\n2026-01-05,,\n")
+    assert result.rows == []
+    assert len(result.errors) == 1
+    assert result.errors[0].line == 2
+    assert result.errors[0].column == "出金"
+
+
+def test_D4_both_empty_without_deposit_column_is_row_error():
+    result = import_bank_csv("日付,出金\n2026-01-05,\n")
+    assert [(e.line, e.column) for e in result.errors] == [(2, "出金")]
+
+
+# D5: カテゴリ無し・空セルは default_category
+def test_D5_missing_category_column_uses_default():
+    result = import_bank_csv("日付,金額\n2026-01-05,100\n", default_category="雑費")
+    assert result.rows[0].category == "雑費"
+
+
+def test_D5_empty_category_cell_uses_default():
+    result = import_bank_csv("日付,金額,カテゴリ\n2026-01-05,100,  \n")
+    assert result.rows[0].category == "未分類"
+
+
+def test_D5_category_cell_is_stripped():
+    result = import_bank_csv("日付,金額,カテゴリ\n2026-01-05,100, 食費 \n")
+    assert result.rows[0].category == "食費"
+
+
+# D6: メモは NFKC と前後空白除去。メモ列が無ければ空
+def test_D6_memo_is_nfkc_and_stripped():
+    result = import_bank_csv("日付,金額,摘要\n2026-01-05,100,　ＡＢＣ　\n")
+    assert result.rows[0].memo == "ABC"
+
+
+def test_D6_missing_memo_column_gives_empty_memo():
+    result = import_bank_csv("日付,金額\n2026-01-05,100\n")
+    assert result.rows[0].memo == ""
+
+
+# D7: 全セルが空白の行はスキップ
+def test_D7_all_blank_rows_are_skipped():
+    result = import_bank_csv("日付,金額,摘要\n,,\n   \n\n2026-01-05,100,x\n\n")
+    assert result.rows == [Expense(date(2026, 1, 5), "未分類", 100, "x")]
+    assert result.errors == []
+
+
+# D9: 同じ行の誤りは列がヘッダーで前にある順
+def test_D9_errors_follow_header_column_order():
+    result = import_bank_csv("金額,日付\nabc,2026/2/30\n")
+    assert [e.column for e in result.errors] == ["金額", "日付"]
+
+
+# D10: 負の値は符号を保つ
+def test_D10_negative_withdrawal_is_kept_as_refund():
+    result = import_bank_csv("日付,出金\n2026-01-05,-300\n")
+    assert result.rows[0].amount == -300
+
+
+# R3: 日付の形式
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        ("2026-01-05", date(2026, 1, 5)),
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026/01/05", date(2026, 1, 5)),
+        ("2026.1.5", date(2026, 1, 5)),
+        ("2026年1月5日", date(2026, 1, 5)),
+        ("20260105", date(2026, 1, 5)),
+        ("２０２６／１／５", date(2026, 1, 5)),
+        ("2026-01-05 12:30", date(2026, 1, 5)),
+    ],
+)
+def test_R3_date_formats(raw, expected):
+    result = import_bank_csv(f'日付,金額\n"{raw}",100\n')
+    assert result.rows[0].day == expected
+
+
+@pytest.mark.parametrize("raw", ["2026/2/30", "2026-13-01", "abc", ""])
+def test_R3_invalid_date_is_row_error(raw):
+    result = import_bank_csv(f'日付,金額\n"{raw}",100\n')
+    assert result.rows == []
+    assert [(e.line, e.column) for e in result.errors] == [(2, "日付")]
+
+
+# R4: 金額の形式
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        ("¥1,490", 1490),
+        ("￥1,490", 1490),
+        ("1490円", 1490),
+        ("JPY 1490", 1490),
+        (" 1 490 ", 1490),
+        ("0", 0),
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+    ],
+)
+def test_R4_amount_formats(raw, expected):
+    result = import_bank_csv(f'日付,金額\n2026-01-05,"{raw}"\n')
+    assert result.rows[0].amount == expected
+
+
+@pytest.mark.parametrize("raw", ["12.5", "12.0", "", "-", "—", "abc", "--300"])
+def test_R4_invalid_amount_is_row_error(raw):
+    result = import_bank_csv(f'日付,金額\n2026-01-05,"{raw}"\n')
+    assert result.rows == []
+    assert [(e.line, e.column) for e in result.errors] == [(2, "金額")]
+
+
+# R5: 出金/入金の 2 列形式
+def test_R5_two_column_form():
+    text = (
+        "日付,出金,入金,摘要\n"
+        "2026-01-05,1200,,家賃\n"
+        "2026-01-06,,5000,給与\n"
+        "2026-01-07,,,\n"
+        "2026-01-08,300,999,x\n"
+    )
+    result = import_bank_csv(text)
+    assert result.rows == [
+        Expense(date(2026, 1, 5), "未分類", 1200, "家賃"),
+        Expense(date(2026, 1, 8), "未分類", 300, "x"),
+    ]
+    assert [(e.line, e.column) for e in result.errors] == [(4, "出金")]
+
+
+# R6: 列数の過不足・空行・ヘッダーのみ
+@pytest.mark.parametrize("row", ["2026-01-05,100", "2026-01-05,100,x,y"])
+def test_R6_column_count_mismatch_is_row_error(row):
+    result = import_bank_csv(f"日付,金額,摘要\n{row}\n")
+    assert result.rows == []
+    assert len(result.errors) == 1
+    error = result.errors[0]
+    assert (error.line, error.column) == (2, "(行)")
+    assert "期待 3" in error.reason
+    assert f"実際 {len(row.split(','))}" in error.reason
+
+
+def test_R6_header_only_gives_empty_result():
+    assert import_bank_csv("日付,金額\n") == ImportResult([], [])
+
+
+@pytest.mark.parametrize("text", ["", "\n\n", "﻿"])
+def test_R6_empty_input_raises(text):
+    with pytest.raises(ValueError):
+        import_bank_csv(text)
+
+
+# R7: rows は入力順、errors は行番号昇順
+def test_R7_rows_keep_input_order_and_errors_ascend_by_line():
+    text = "日付,金額\n2026-01-09,300\n2026-02-30,100\n2026-01-07,200\n2026-01-06,abc\n"
+    result = import_bank_csv(text)
+    assert result.rows == [
+        Expense(date(2026, 1, 9), "未分類", 300, ""),
+        Expense(date(2026, 1, 7), "未分類", 200, ""),
+    ]
+    assert [(e.line, e.column) for e in result.errors] == [(3, "日付"), (5, "金額")]
+    assert all(isinstance(e, RowError) for e in result.errors)
