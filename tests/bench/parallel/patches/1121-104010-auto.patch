@@ -0,0 +1,200 @@
+"""銀行 CSV の取り込み(標準ライブラリのみ・ファイル I/O なし。入力は str)。
+
+D1: 列名は前後空白と大文字小文字を無視して照合し、別名のうちヘッダー上で先に現れる列を使う。
+D2: 金額列と出金列が両方ある場合は金額列を使い、出金列は無視する。
+D3: 出金列の形式で、出金が空かつ入金に値がある行は取り込まずスキップする(errors にも入れない)。入金列の値は使わない。
+D4: 出金も入金も空の行は RowError(column="出金")。
+D5: カテゴリ列が無い、またはセルが空なら default_category を使う。
+D6: メモは NFKC 正規化と前後空白除去をする。メモ列が無ければ空文字。
+D7: 全セルが空白だけの行(区切りだけの行を含む)は空行としてスキップする。
+D8: 区切りは最初の非空行にタブがあればタブ、無ければ `,`。
+D9: 同じ行の日付と金額の誤りは、列がヘッダーで前にある順に errors へ並べる。
+D10: 金額・出金の負の値は符号を保ったまま Expense に渡す(返金)。
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from collections.abc import Iterator
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str
+    value: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    rows: list[Expense]
+    errors: list[RowError]
+
+
+_ALIASES: dict[str, tuple[str, ...]] = {
+    "date": ("日付", "利用日", "取引日", "ご利用日", "date"),
+    "amount": ("金額", "利用金額", "ご利用金額", "amount"),
+    "withdrawal": ("出金", "出金額", "支払", "お支払金額"),
+    "deposit": ("入金", "入金額", "預入", "お預り金額"),
+    "memo": ("摘要", "メモ", "利用店名", "ご利用店名", "内容", "description", "memo"),
+    "category": ("カテゴリ", "category"),
+}
+
+_DATE_PATTERNS = (
+    re.compile(r"([0-9]{4})[-/.]([0-9]{1,2})[-/.]([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日"),
+    re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})"),
+)
+_AMOUNT_NOISE = re.compile(r"[¥円]|JPY|[\s,]", re.IGNORECASE)
+_NEGATIVE_PREFIXES = ("-", "−", "△", "▲")
+_EMPTY_AMOUNT_MARKS = ("", "-", "—")
+
+
+def _nfkc(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip()
+
+
+def _parse_date(raw: str) -> date:
+    text = _nfkc(raw)
+    if not text:
+        raise ValueError("日付が空です")
+    part = text.split()[0]  # 時刻が続く場合は日付部分だけ
+    for pattern in _DATE_PATTERNS:
+        m = pattern.fullmatch(part)
+        if m is not None:
+            year, month, day = (int(g) for g in m.groups())
+            try:
+                return date(year, month, day)
+            except ValueError:
+                raise ValueError(f"存在しない日付です: {raw!r}") from None
+    raise ValueError(f"日付の形式が不正です: {raw!r}")
+
+
+def _parse_amount(raw: str) -> int:
+    text = _AMOUNT_NOISE.sub("", _nfkc(raw))
+    if text in _EMPTY_AMOUNT_MARKS:
+        raise ValueError("金額が空です")
+    negative = False
+    if text.startswith("(") and text.endswith(")"):
+        negative, text = True, text[1:-1]
+    elif text.startswith(_NEGATIVE_PREFIXES):
+        negative, text = True, text[1:]
+    elif text.endswith("-"):
+        negative, text = True, text[:-1]
+    if not re.fullmatch(r"[0-9]+", text):
+        raise ValueError(f"金額が整数ではありません: {raw!r}")
+    value = int(text)
+    return -value if negative else value
+
+
+def _is_blank(cells: list[str]) -> bool:
+    return all(not c.strip() for c in cells)
+
+
+def _delimiter(text: str) -> str:
+    for line in text.split("\n"):
+        if line.strip():
+            return "\t" if "\t" in line else ","
+    return ","
+
+
+def _records(text: str, delimiter: str) -> Iterator[tuple[int, list[str]]]:
+    """(レコードの開始行, セル) を返す。引用符内の改行を含むレコードは 1 件。"""
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delimiter)
+    start = 1
+    for cells in reader:
+        yield start, cells
+        start = reader.line_num + 1
+
+
+def _find(names: list[str], key: str) -> int | None:
+    for i, name in enumerate(names):
+        if name in _ALIASES[key]:
+            return i
+    return None
+
+
+def import_bank_csv(text: str, *, default_category: str = "未分類") -> ImportResult:
+    text = text.removeprefix("﻿")
+    delimiter = _delimiter(text)
+    records = [(n, c) for n, c in _records(text, delimiter) if not _is_blank(c)]
+    if not records:
+        raise ValueError("入力が空です")
+
+    _, header = records[0]
+    names = [h.strip().lower() for h in header]
+    date_i = _find(names, "date")
+    amount_i = _find(names, "amount")
+    withdrawal_i = _find(names, "withdrawal")
+    deposit_i = _find(names, "deposit")
+    memo_i = _find(names, "memo")
+    category_i = _find(names, "category")
+    if date_i is None:
+        raise ValueError("日付列がありません")
+    if amount_i is None and withdrawal_i is None:
+        raise ValueError("金額列または出金列がありません")
+
+    split = amount_i is None  # 出金・入金の 2 列形式
+    amount_col = withdrawal_i if split else amount_i
+    amount_name = "出金" if split else "金額"
+    assert amount_col is not None
+    width = len(header)
+
+    rows: list[Expense] = []
+    errors: list[RowError] = []
+    for line, cells in records[1:]:
+        if len(cells) != width:
+            errors.append(
+                RowError(
+                    line,
+                    "(行)",
+                    delimiter.join(cells),
+                    f"列数が不正です(期待 {width} 列・実際 {len(cells)} 列)",
+                )
+            )
+            continue
+
+        amount_cell = cells[amount_col]
+        deposit_cell = cells[deposit_i] if deposit_i is not None else ""
+        if split and not _nfkc(amount_cell) and _nfkc(deposit_cell):
+            continue  # D3: 入金だけの行
+
+        found: list[tuple[int, RowError]] = []
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = _parse_date(cells[date_i])
+        except ValueError as e:
+            found.append((date_i, RowError(line, "日付", cells[date_i], str(e))))
+        if split and not _nfkc(amount_cell) and not _nfkc(deposit_cell):
+            found.append(
+                (
+                    amount_col,
+                    RowError(line, "出金", amount_cell, "出金と入金がともに空です"),
+                )
+            )
+        else:
+            try:
+                amount = _parse_amount(amount_cell)
+            except ValueError as e:
+                found.append(
+                    (amount_col, RowError(line, amount_name, amount_cell, str(e)))
+                )
+
+        if day is None or amount is None:
+            errors.extend(err for _, err in sorted(found, key=lambda item: item[0]))
+            continue
+
+        category = cells[category_i].strip() if category_i is not None else ""
+        memo = _nfkc(cells[memo_i]) if memo_i is not None else ""
+        rows.append(Expense(day, category or default_category, amount, memo))
+
+    return ImportResult(rows, errors)
