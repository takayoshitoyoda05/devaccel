+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import Amount, And, Category, Memo, Not, Or, Period, search
+
+ROWS = [
+    Expense(date(2026, 1, 5), "食費", 12000, "weekly groceries"),
+    Expense(date(2026, 1, 9), "食費", 800, "Net cafe"),
+    Expense(date(2026, 2, 1), "交通費", 15000, "train pass"),
+    Expense(date(2026, 2, 14), "食費", 9000, "ｎｅｔ shop"),
+    Expense(date(2026, 3, 3), "娯楽", 500, ""),
+    Expense(date(2026, 3, 20), "食費", -3000, "返品 refund"),
+]
+
+
+def _ids(rows: list[Expense]) -> list[tuple[date, str, int]]:
+    return [(r.day, r.category, r.amount) for r in rows]
+
+
+def _food() -> list[Expense]:
+    return [r for r in ROWS if r.category == "食費"]
+
+
+# --- 表の例 (E3-*) ----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("case_id", "query", "expected"),
+    [
+        # E3-1: 食費 or (1万円以上 and メモに net を含む) → 食費の全件 + 1万円以上の net 行
+        ("E3-1", Or(Category("食費"), And(Amount(min=10000), Memo("net"))), _food()),
+    ],
+    ids=["E3-1"],
+)
+def test_example_table(case_id: str, query, expected: list[Expense]) -> None:
+    assert _ids(search(ROWS, query)) == _ids(expected)
+
+
+@pytest.mark.parametrize(
+    ("case_id", "query", "expected"),
+    [
+        ("E3-2a", And(), ROWS),
+        ("E3-2b", Or(), []),
+    ],
+    ids=["E3-2a", "E3-2b"],
+)
+def test_empty_and_or(case_id: str, query, expected: list[Expense]) -> None:
+    assert _ids(search(ROWS, query)) == _ids(expected)
+
+
+@pytest.mark.parametrize(
+    ("case_id", "build"),
+    [("E3-3", lambda: Amount(min=500, max=100))],
+    ids=["E3-3"],
+)
+def test_amount_min_greater_than_max_raises(case_id: str, build) -> None:
+    with pytest.raises(ValueError):
+        build()
+
+
+# --- R1: 論理演算 --------------------------------------------------------
+
+
+def test_not_flips_match() -> None:
+    assert _ids(search(ROWS, Not(Category("食費")))) == _ids(
+        [r for r in ROWS if r.category != "食費"]
+    )
+
+
+def test_not_nested_double_negation() -> None:
+    assert _ids(search(ROWS, Not(Not(Category("食費"))))) == _ids(_food())
+
+
+def test_and_of_single_item_matches_item() -> None:
+    assert _ids(search(ROWS, And(Category("娯楽")))) == _ids(
+        [r for r in ROWS if r.category == "娯楽"]
+    )
+
+
+def test_or_of_single_item_matches_item() -> None:
+    assert _ids(search(ROWS, Or(Category("交通費")))) == _ids(
+        [r for r in ROWS if r.category == "交通費"]
+    )
+
+
+# --- R2: カテゴリ・メモ --------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "name",
+    ["食費", " 食費 ", "食費\t"],
+    ids=["exact", "leading-trailing-spaces", "trailing-tab"],
+)
+def test_category_ignores_surrounding_whitespace(name: str) -> None:
+    assert _ids(search(ROWS, Category(name))) == _ids(_food())
+
+
+def test_category_is_exact_not_partial() -> None:
+    assert search(ROWS, Category("食")) == []
+
+
+def test_category_applies_nfkc() -> None:
+    fullwidth = "ＡＢＣ"
+    rows = [Expense(date(2026, 1, 1), "ABC", 100)]
+    assert search(rows, Category(fullwidth)) == rows
+
+
+@pytest.mark.parametrize(
+    "text",
+    ["net", "NET", "Net", "ｎｅｔ", "NeT"],
+    ids=["lower", "upper", "title", "fullwidth", "mixed"],
+)
+def test_memo_is_partial_case_and_nfkc_insensitive(text: str) -> None:
+    got = search(ROWS, Memo(text))
+    assert _ids(got) == [
+        (date(2026, 1, 9), "食費", 800),
+        (date(2026, 2, 14), "食費", 9000),
+    ]
+
+
+def test_memo_empty_string_matches_all() -> None:
+    assert _ids(search(ROWS, Memo(""))) == _ids(ROWS)
+
+
+def test_memo_does_not_match_empty_memo_with_text() -> None:
+    assert search(ROWS, Memo("x")) == []
+
+
+# --- R3: 金額・期間 ------------------------------------------------------
+
+
+def test_amount_bounds_are_inclusive() -> None:
+    got = search(ROWS, Amount(min=500, max=800))
+    assert _ids(got) == [
+        (date(2026, 1, 9), "食費", 800),
+        (date(2026, 3, 3), "娯楽", 500),
+    ]
+
+
+def test_amount_min_only() -> None:
+    got = search(ROWS, Amount(min=15000))
+    assert _ids(got) == [(date(2026, 2, 1), "交通費", 15000)]
+
+
+def test_amount_max_only_includes_negative_refunds() -> None:
+    got = search(ROWS, Amount(max=0))
+    assert _ids(got) == [(date(2026, 3, 20), "食費", -3000)]
+
+
+def test_amount_none_none_is_unbounded() -> None:
+    assert _ids(search(ROWS, Amount())) == _ids(ROWS)
+
+
+def test_amount_equal_min_and_max() -> None:
+    got = search(ROWS, Amount(min=800, max=800))
+    assert _ids(got) == [(date(2026, 1, 9), "食費", 800)]
+
+
+def test_amount_range_with_negative_bounds_applies_to_refund() -> None:
+    got = search(ROWS, Amount(min=-5000, max=-1000))
+    assert _ids(got) == [(date(2026, 3, 20), "食費", -3000)]
+
+
+def test_period_bounds_are_inclusive() -> None:
+    got = search(ROWS, Period(date(2026, 1, 9), date(2026, 2, 1)))
+    assert _ids(got) == [
+        (date(2026, 1, 9), "食費", 800),
+        (date(2026, 2, 1), "交通費", 15000),
+    ]
+
+
+def test_period_start_only() -> None:
+    got = search(ROWS, Period(start=date(2026, 3, 1)))
+    assert _ids(got) == [
+        (date(2026, 3, 3), "娯楽", 500),
+        (date(2026, 3, 20), "食費", -3000),
+    ]
+
+
+def test_period_end_only() -> None:
+    got = search(ROWS, Period(end=date(2026, 1, 5)))
+    assert _ids(got) == [(date(2026, 1, 5), "食費", 12000)]
+
+
+def test_period_none_none_is_unbounded() -> None:
+    assert _ids(search(ROWS, Period())) == _ids(ROWS)
+
+
+def test_period_single_day() -> None:
+    got = search(ROWS, Period(date(2026, 2, 14), date(2026, 2, 14)))
+    assert _ids(got) == [(date(2026, 2, 14), "食費", 9000)]
+
+
+@pytest.mark.parametrize(
+    "build",
+    [
+        lambda: Amount(min=500, max=100),
+        lambda: Period(date(2026, 2, 2), date(2026, 2, 1)),
+    ],
+    ids=["amount-min-gt-max", "period-start-gt-end"],
+)
+def test_inverted_range_raises(build) -> None:
+    with pytest.raises(ValueError):
+        build()
+
+
+# --- R4: 順序・非破壊 ----------------------------------------------------
+
+
+def test_result_keeps_input_order() -> None:
+    rows = [ROWS[5], ROWS[0], ROWS[3]]
+    got = search(rows, Category("食費"))
+    assert got == [ROWS[5], ROWS[0], ROWS[3]]
+
+
+def test_input_list_is_not_modified() -> None:
+    rows = list(ROWS)
+    before = list(rows)
+    search(rows, Or(Category("食費"), Memo("net")))
+    assert rows == before
+
+
+def test_result_is_a_new_list() -> None:
+    got = search(ROWS, And())
+    assert got is not ROWS
+    got.clear()
+    assert len(ROWS) == 6
+
+
+# --- R5: 型・構築時の検査 ----------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [{"category": "食費"}, "食費", None],
+    ids=["dict", "str", "none"],
+)
+def test_search_rejects_non_query(bad: object) -> None:
+    with pytest.raises(TypeError):
+        search(ROWS, bad)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize(
+    "build",
+    [
+        lambda: Amount(min=True),
+        lambda: Amount(max=False),
+        lambda: Amount(min=1.5),  # type: ignore[arg-type]
+        lambda: Amount(min="1"),  # type: ignore[arg-type]
+    ],
+    ids=["min-bool", "max-bool", "min-float", "min-str"],
+)
+def test_amount_wrong_type_raises_at_construction(build) -> None:
+    with pytest.raises(TypeError):
+        build()
+
+
+def test_memo_wrong_type_raises_at_construction() -> None:
+    with pytest.raises(TypeError):
+        Memo(text=1)  # type: ignore[arg-type]
+
+
+def test_category_wrong_type_raises_at_construction() -> None:
+    with pytest.raises(TypeError):
+        Category(name=None)  # type: ignore[arg-type]
+
+
+def test_period_wrong_type_raises_at_construction() -> None:
+    with pytest.raises(TypeError):
+        Period(start="2026-01-01")  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize(
+    "build",
+    [
+        lambda: And(Category("食費"), "食費"),  # type: ignore[arg-type]
+        lambda: Or({"category": "食費"}),  # type: ignore[arg-type]
+        lambda: Not("食費"),  # type: ignore[arg-type]
+        lambda: Not(None),  # type: ignore[arg-type]
+    ],
+    ids=["and-str-item", "or-dict-item", "not-str", "not-none"],
+)
+def test_combinator_rejects_non_query_items(build) -> None:
+    with pytest.raises(TypeError):
+        build()
