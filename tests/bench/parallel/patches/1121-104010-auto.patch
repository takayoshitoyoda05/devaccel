@@ -0,0 +1,328 @@
+"""Tests for kakeibo.recurring: E1-1..E1-3, R1..R5, D1, D2, D6..D9."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, next_due
+
+
+def ex(
+    day: date, category: str = "家賃", amount: int = 80000, memo: str = ""
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+def monthly(
+    months: list[int],
+    *,
+    day: int = 25,
+    category: str = "家賃",
+    amount: int = 80000,
+    memo: str = "",
+) -> list[Expense]:
+    return [
+        ex(date(2026, m, day), category=category, amount=amount, memo=memo)
+        for m in months
+    ]
+
+
+def with_memos(memos: list[str]) -> list[Expense]:
+    return [ex(date(2026, i + 1, 10), amount=5000, memo=m) for i, m in enumerate(memos)]
+
+
+# --- 表の行 -------------------------------------------------------------
+
+
+def test_E1_1_rent_over_three_months_is_one_series() -> None:
+    """E1-1: 家賃 80000 を 1・2・3 月の 25 日 → 1 件、次回は 2026-04-25。"""
+    assert find_recurring(monthly([1, 2, 3])) == [
+        Recurring(
+            category="家賃",
+            memo="",
+            amount=80000,
+            day_of_month=25,
+            months=3,
+            last=date(2026, 3, 25),
+            next_due=date(2026, 4, 25),
+        )
+    ]
+
+
+def test_E1_2_same_category_different_memo_gives_two_series() -> None:
+    """E1-2: 同カテゴリで 5 日と 20 日の別メモ、各 3 か月 → 2 件(別系列)。"""
+    rows = monthly(
+        [1, 2, 3], day=5, category="通信", amount=1000, memo="動画"
+    ) + monthly([1, 2, 3], day=20, category="通信", amount=1000, memo="音楽")
+    result = find_recurring(rows)
+    assert len(result) == 2
+    assert {r.memo for r in result} == {"動画", "音楽"}
+
+
+@pytest.mark.parametrize(
+    ("last", "day", "expected"),
+    [
+        pytest.param(date(2026, 12, 31), 31, date(2027, 1, 31), id="E1-3"),
+        pytest.param(date(2026, 1, 31), 31, date(2026, 2, 28), id="R4-feb-non-leap"),
+        pytest.param(date(2024, 1, 31), 31, date(2024, 2, 29), id="R4-feb-leap"),
+        pytest.param(date(2026, 1, 15), 30, date(2026, 2, 28), id="R4-cap-30"),
+        pytest.param(date(2026, 11, 5), 10, date(2026, 12, 10), id="R4-same-year"),
+        pytest.param(date(2026, 12, 5), 10, date(2027, 1, 10), id="R4-dec-to-jan"),
+    ],
+)
+def test_next_due_table(last: date, day: int, expected: date) -> None:
+    assert next_due(last, day) == expected
+
+
+@pytest.mark.parametrize("day", [0, 32, -1])
+def test_next_due_day_out_of_range_is_value_error(day: int) -> None:
+    with pytest.raises(ValueError, match="day_of_month"):
+        next_due(date(2026, 1, 1), day)
+
+
+@pytest.mark.parametrize("day", [True, 25.0])
+def test_next_due_bool_or_float_day_is_type_error(day: object) -> None:
+    with pytest.raises(TypeError, match="day_of_month"):
+        next_due(date(2026, 1, 1), day)  # type: ignore[arg-type]
+
+
+# --- 引数の検証 ---------------------------------------------------------
+
+
+@pytest.mark.parametrize("n", [1, 0, -3])
+def test_min_months_below_two_is_value_error(n: int) -> None:
+    with pytest.raises(ValueError, match="min_months"):
+        find_recurring([], min_months=n)
+
+
+@pytest.mark.parametrize("n", [True, 3.0])
+def test_min_months_bool_or_float_is_type_error(n: object) -> None:
+    with pytest.raises(TypeError, match="min_months"):
+        find_recurring([], min_months=n)  # type: ignore[arg-type]
+
+
+def test_negative_tolerance_is_value_error() -> None:
+    with pytest.raises(ValueError, match="tolerance"):
+        find_recurring([], tolerance=-0.1)
+
+
+def test_bool_tolerance_is_type_error() -> None:
+    with pytest.raises(TypeError, match="tolerance"):
+        find_recurring([], tolerance=True)  # type: ignore[arg-type]
+
+
+def test_empty_rows_gives_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+# --- R1 同一系列 --------------------------------------------------------
+
+
+def test_R1_amount_within_tolerance_is_included() -> None:
+    rows = [
+        ex(date(2026, 1, 25), amount=1000),
+        ex(date(2026, 2, 25), amount=1100),
+        ex(date(2026, 3, 25), amount=900),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].amount == 1000
+
+
+def test_R1_amount_outside_tolerance_splits_series() -> None:
+    rows = [
+        ex(date(2026, 1, 25), amount=1000),
+        ex(date(2026, 2, 25), amount=1000),
+        ex(date(2026, 3, 25), amount=1500),
+    ]
+    # 1500 は別系列になり 1 か月しかないので、どちらも min_months=3 に届かない
+    assert find_recurring(rows) == []
+
+
+def test_R1_tolerance_zero_excludes_any_difference() -> None:
+    rows = [
+        ex(date(2026, 1, 25), amount=1000),
+        ex(date(2026, 2, 25), amount=1100),
+        ex(date(2026, 3, 25), amount=1000),
+    ]
+    assert find_recurring(rows, tolerance=0) == []
+    assert len(find_recurring(rows, tolerance=0.1)) == 1
+
+
+@pytest.mark.parametrize(
+    "memos",
+    [
+        pytest.param(["Netflix", "NETFLIX", "netflix"], id="case"),
+        pytest.param(["ＮＥＴＦＬＩＸ", "netflix", "Netflix"], id="D1-NFKC"),
+        pytest.param(["net flix", "net　flix", "netflix"], id="D1-whitespace"),
+        pytest.param(["netflix 1", "netflix#2", "netflix 3"], id="D1-trailing-number"),
+        pytest.param(["netflix", "netflix 2024", "netflix"], id="D1-trailing-year"),
+        pytest.param(["store1", "store2", "store3"], id="D1-trailing-digit-only"),
+    ],
+)
+def test_R1_D1_normalized_memo_is_same_series(memos: list[str]) -> None:
+    result = find_recurring(with_memos(memos), min_months=3)
+    assert len(result) == 1
+
+
+def test_D1_internal_digit_is_kept() -> None:
+    # "a1b" は末尾ではないので数字を除去しない → "ab" とは別系列
+    assert find_recurring(with_memos(["a1b", "ab", "ab"])) == []
+
+
+def test_D9_memo_is_raw_memo_of_latest_record() -> None:
+    rows = [
+        ex(date(2026, 1, 10), amount=5000, memo="Netflix"),
+        ex(date(2026, 2, 10), amount=5000, memo="netflix"),
+        ex(date(2026, 3, 10), amount=5000, memo="NETFLIX#3"),
+    ]
+    assert find_recurring(rows)[0].memo == "NETFLIX#3"
+
+
+def test_R1_same_memo_different_category_is_separate() -> None:
+    rows = monthly([1, 2, 3], category="A") + monthly([1, 2, 3], category="B")
+    assert len(find_recurring(rows)) == 2
+
+
+# --- D2 負の金額 --------------------------------------------------------
+
+
+def test_D2_negative_amount_is_excluded_from_series() -> None:
+    rows = monthly([1, 2, 3]) + [ex(date(2026, 4, 25), amount=-80000)]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].months == 3
+    assert result[0].last == date(2026, 3, 25)
+
+
+def test_D2_only_negative_amounts_gives_nothing() -> None:
+    rows = [ex(date(2026, m, 25), amount=-80000) for m in (1, 2, 3)]
+    assert find_recurring(rows) == []
+
+
+# --- D7 系列の切り方 -----------------------------------------------------
+
+
+def test_D7_group_split_by_median_center() -> None:
+    # 中央値 500 を基準に 500 の群、残った 1000 の群の 2 系列になる
+    rows = monthly([1, 2, 3], amount=500, memo="a") + monthly(
+        [1, 2, 3], amount=1000, memo="a"
+    )
+    result = find_recurring(rows)
+    assert sorted(r.amount for r in result) == [500, 1000]
+
+
+# --- R2 min_months・連続性・同月重複 -----------------------------------------
+
+
+def test_R2_min_months_two_accepts_two_months() -> None:
+    assert len(find_recurring(monthly([1, 2]), min_months=2)) == 1
+
+
+def test_R2_months_need_not_be_consecutive() -> None:
+    result = find_recurring(monthly([1, 5, 9]))
+    assert len(result) == 1
+    assert result[0].months == 3
+    assert result[0].next_due == date(2026, 10, 25)
+
+
+def test_R2_same_month_counts_once() -> None:
+    rows = [
+        ex(date(2026, 1, 3)),
+        ex(date(2026, 1, 20)),
+        ex(date(2026, 2, 3)),
+    ]
+    assert find_recurring(rows, min_months=3) == []
+
+
+# --- D8 日の最頻値(月ごとの最も早い日) ------------------------------------
+
+
+def test_D8_day_uses_earliest_day_per_month() -> None:
+    rows = [
+        ex(date(2026, 1, 3)),
+        ex(date(2026, 1, 20)),
+        ex(date(2026, 2, 20)),
+        ex(date(2026, 3, 3)),
+        ex(date(2026, 4, 3)),
+    ]
+    result = find_recurring(rows)
+    assert result[0].day_of_month == 3
+    assert result[0].months == 4
+    assert result[0].next_due == date(2026, 5, 3)
+
+
+def test_D8_day_mode_tie_takes_larger_day() -> None:
+    rows = [
+        ex(date(2026, 1, 5)),
+        ex(date(2026, 2, 20)),
+        ex(date(2026, 3, 5)),
+        ex(date(2026, 4, 20)),
+    ]
+    result = find_recurring(rows)
+    assert result[0].day_of_month == 20
+
+
+# --- D6 次回予定日の頭打ち -------------------------------------------------
+
+
+def test_D6_next_due_capped_at_month_end() -> None:
+    rows = [
+        ex(date(2026, 1, 31)),
+        ex(date(2026, 3, 31)),
+        ex(date(2026, 5, 31)),
+    ]
+    result = find_recurring(rows)
+    assert result[0].day_of_month == 31
+    assert result[0].next_due == date(2026, 6, 30)
+
+
+# --- R3 並び順 --------------------------------------------------------------
+
+
+def test_R3_sorted_by_next_due_then_amount_desc_then_category() -> None:
+    rows = (
+        monthly([1, 2, 3], category="b", amount=1000)
+        + monthly([1, 2, 3], category="a", amount=500)
+        + monthly([1, 2, 3], category="a", amount=1000)
+        + monthly([1, 2, 3], day=5, category="z", amount=700)
+    )
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [
+        ("z", 700),
+        ("a", 1000),
+        ("b", 1000),
+        ("a", 500),
+    ]
+
+
+def test_R3_memo_breaks_final_tie() -> None:
+    rows = monthly([1, 2, 3], memo="y") + monthly([1, 2, 3], memo="x")
+    assert [r.memo for r in find_recurring(rows)] == ["x", "y"]
+
+
+# --- R5 金額は中央値 ----------------------------------------------------------
+
+
+def test_R5_even_count_uses_lower_median() -> None:
+    rows = [
+        ex(date(2026, 1, 25), amount=1000),
+        ex(date(2026, 2, 25), amount=1010),
+        ex(date(2026, 3, 25), amount=1020),
+        ex(date(2026, 4, 25), amount=1030),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].amount == 1010
+
+
+def test_R5_odd_count_uses_middle_value() -> None:
+    rows = [
+        ex(date(2026, 1, 25), amount=1000),
+        ex(date(2026, 2, 25), amount=1050),
+        ex(date(2026, 3, 25), amount=1020),
+    ]
+    assert find_recurring(rows)[0].amount == 1020
