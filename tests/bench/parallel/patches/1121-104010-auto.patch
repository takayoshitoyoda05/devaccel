index 0000000..7d694a4
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,149 @@
+"""Condition search over Expense rows (pure functions, standard library only).
+
+Query tree: Category / Amount / Memo / Period leaves, And / Or / Not nodes.
+
+規則:
+- R1: 空の And() は全件に真、空の Or() は全件に偽。Not は入れ子可。
+- R2: Category はカテゴリ完全一致(NFKC 後、前後空白は無視)。
+      Memo は部分一致で NFKC・大文字小文字を無視。Memo("") は全件に真。
+- R3: Amount・Period は両端を含む。None は無制限。min > max・start > end は ValueError。
+      金額範囲は負の金額(返金)にもそのまま適用する。
+- R4: 結果は入力の順序のまま。元のリストは変えない。
+- R5: Query 以外の値を search に渡したら TypeError。Amount(min=True) や
+      Memo(text=1) のような型違いは構築時に TypeError。
+"""
+
+from __future__ import annotations
+
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def _nfkc(text: str) -> str:
+    return unicodedata.normalize("NFKC", text)
+
+
+def _check_int_or_none(value: object, where: str) -> None:
+    if value is None:
+        return
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{where} は int または None である必要があります: {value!r}")
+
+
+def _check_date_or_none(value: object, where: str) -> None:
+    if value is None:
+        return
+    if not isinstance(value, date):
+        raise TypeError(f"{where} は date または None である必要があります: {value!r}")
+
+
+@dataclass(frozen=True)
+class Category:
+    name: str
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.name, str):
+            raise TypeError(f"Category.name は str である必要があります: {self.name!r}")
+
+
+@dataclass(frozen=True)
+class Amount:
+    min: int | None = None
+    max: int | None = None
+
+    def __post_init__(self) -> None:
+        _check_int_or_none(self.min, "Amount.min")
+        _check_int_or_none(self.max, "Amount.max")
+        if self.min is not None and self.max is not None and self.min > self.max:
+            raise ValueError(f"Amount: min({self.min}) > max({self.max})")
+
+
+@dataclass(frozen=True)
+class Memo:
+    text: str
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.text, str):
+            raise TypeError(f"Memo.text は str である必要があります: {self.text!r}")
+
+
+@dataclass(frozen=True)
+class Period:
+    start: date | None = None
+    end: date | None = None
+
+    def __post_init__(self) -> None:
+        _check_date_or_none(self.start, "Period.start")
+        _check_date_or_none(self.end, "Period.end")
+        if self.start is not None and self.end is not None and self.start > self.end:
+            raise ValueError(f"Period: start({self.start}) > end({self.end})")
+
+
+@dataclass(frozen=True, init=False)
+class And:
+    items: tuple[Query, ...]
+
+    def __init__(self, *items: Query) -> None:
+        object.__setattr__(self, "items", _checked_items(items, "And"))
+
+
+@dataclass(frozen=True, init=False)
+class Or:
+    items: tuple[Query, ...]
+
+    def __init__(self, *items: Query) -> None:
+        object.__setattr__(self, "items", _checked_items(items, "Or"))
+
+
+@dataclass(frozen=True)
+class Not:
+    item: Query
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.item, _QUERY_TYPES):
+            raise TypeError(f"Not.item は Query である必要があります: {self.item!r}")
+
+
+def _checked_items(items: tuple[object, ...], where: str) -> tuple:
+    for item in items:
+        if not isinstance(item, _QUERY_TYPES):
+            raise TypeError(f"{where} の要素は Query である必要があります: {item!r}")
+    return items
+
+
+Query = Category | Amount | Memo | Period | And | Or | Not
+
+_QUERY_TYPES = (Category, Amount, Memo, Period, And, Or, Not)
+
+
+def _matches(query: Query, row: Expense) -> bool:
+    if isinstance(query, And):
+        return all(_matches(item, row) for item in query.items)
+    if isinstance(query, Or):
+        return any(_matches(item, row) for item in query.items)
+    if isinstance(query, Not):
+        return not _matches(query.item, row)
+    if isinstance(query, Category):
+        return _nfkc(query.name).strip() == _nfkc(row.category).strip()
+    if isinstance(query, Memo):
+        needle = _nfkc(query.text).casefold()
+        return needle in _nfkc(row.memo).casefold()
+    if isinstance(query, Amount):
+        return (query.min is None or row.amount >= query.min) and (
+            query.max is None or row.amount <= query.max
+        )
+    if isinstance(query, Period):
+        return (query.start is None or row.day >= query.start) and (
+            query.end is None or row.day <= query.end
+        )
+    raise TypeError(f"Query ではありません: {query!r}")
+
+
+def search(rows: list[Expense], query: Query) -> list[Expense]:
+    """Return the rows matching ``query``, in input order. ``rows`` is not modified."""
+    if not isinstance(query, _QUERY_TYPES):
+        raise TypeError(f"query は Query である必要があります: {query!r}")
+    return [row for row in rows if _matches(query, row)]
