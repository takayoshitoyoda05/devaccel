index 0000000..70a70cf
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,147 @@
+"""Recurring expense detection (定期支出の検出). Pure functions, stdlib only.
+
+判断:
+D1: メモの正規化は NFKC → 小文字化 → 空白除去 → 末尾の数字/`#`番号を除去。
+    同一系列は (カテゴリ, 正規化メモ) が同じもの。
+D2: 負の金額(返金)は定期検出では系列から除外する。
+D6: 次回予定日は系列の最後の日付の翌月。日は系列の日(D8)の最頻値(同数なら大きい方)で、
+    その月の末日で頭打ちにする。
+D7: 同じ (カテゴリ, 正規化メモ) の中で、残った金額の中央値を基準に ±tolerance 以内の
+    金額を 1 つの系列に集め、残りに同じ手順を繰り返す。系列の金額は R5 の中央値。
+D8: 系列の日は月ごとの代表日(その月で最も早い日)で数える。同じ月の 2 回目以降は
+    月数にも日数の最頻値にも数えない。
+D9: Recurring.memo は系列の中で最も新しい記録の、正規化前のメモ。
+
+規則:
+R1: 同一系列は D1 の同一性と、金額が系列の中央値の ±tolerance 以内。
+R2: min_months は 2 以上。異なる月の数が min_months 以上の系列だけ返す。
+R3: 並びは next_due 昇順、同日は金額降順、さらに category・memo 昇順。
+R4: next_due は D6。12 月の次は翌年 1 月。
+R5: amount は系列の中央値(偶数個なら下側の値、整数)。
+"""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int
+    day_of_month: int
+    months: int
+    last: date
+    next_due: date
+
+
+_TRAILING_NUMBER_RE = re.compile(r"#?[0-9]+$")
+_WHITESPACE_RE = re.compile(r"\s+")
+
+
+def _check_int(name: str, value: object) -> None:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{name} は int である必要があります: {value!r}")
+
+
+def _normalize_memo(memo: str) -> str:
+    s = unicodedata.normalize("NFKC", memo).lower()
+    s = _WHITESPACE_RE.sub("", s)
+    return _TRAILING_NUMBER_RE.sub("", s)
+
+
+def _median(amounts: list[int]) -> int:
+    s = sorted(amounts)
+    return s[(len(s) - 1) // 2]
+
+
+def next_due(last: date, day_of_month: int) -> date:
+    """D6/R4: last の翌月の day_of_month 日(その月の末日で頭打ち)。"""
+    if not isinstance(last, date):
+        raise TypeError(f"last は date である必要があります: {last!r}")
+    _check_int("day_of_month", day_of_month)
+    if not 1 <= day_of_month <= 31:
+        raise ValueError(f"day_of_month は 1〜31 である必要があります: {day_of_month}")
+    year, month = (
+        (last.year + 1, 1) if last.month == 12 else (last.year, last.month + 1)
+    )
+    last_day = calendar.monthrange(year, month)[1]
+    return date(year, month, min(day_of_month, last_day))
+
+
+def _split_series(items: list[Expense], tolerance: float) -> list[list[Expense]]:
+    """D7: 残りの中央値を基準に ±tolerance 以内を集め、残りを繰り返す。"""
+    rest = sorted(items, key=lambda e: e.amount)
+    out: list[list[Expense]] = []
+    while rest:
+        center = _median([e.amount for e in rest])
+        limit = tolerance * center
+        taken = [e for e in rest if abs(e.amount - center) <= limit]
+        rest = [e for e in rest if abs(e.amount - center) > limit]
+        out.append(taken)
+    return out
+
+
+def _to_recurring(
+    category: str, members: list[Expense], min_months: int
+) -> Recurring | None:
+    first_day_by_month: dict[tuple[int, int], date] = {}
+    for e in members:  # D8: 月ごとの最も早い日
+        key = (e.day.year, e.day.month)
+        if key not in first_day_by_month or e.day < first_day_by_month[key]:
+            first_day_by_month[key] = e.day
+    if len(first_day_by_month) < min_months:
+        return None
+
+    day_counts: dict[int, int] = {}
+    for d in first_day_by_month.values():
+        day_counts[d.day] = day_counts.get(d.day, 0) + 1
+    day_of_month = max(day_counts, key=lambda day: (day_counts[day], day))  # D6
+
+    last = max(e.day for e in members)
+    latest = max(members, key=lambda e: e.day)  # D9
+    return Recurring(
+        category=category,
+        memo=latest.memo,
+        amount=_median([e.amount for e in members]),
+        day_of_month=day_of_month,
+        months=len(first_day_by_month),
+        last=last,
+        next_due=next_due(last, day_of_month),
+    )
+
+
+def find_recurring(
+    rows: list[Expense], *, min_months: int = 3, tolerance: float = 0.1
+) -> list[Recurring]:
+    """定期支出の系列を検出する。並びは R3。"""
+    _check_int("min_months", min_months)
+    if min_months < 2:
+        raise ValueError(f"min_months は 2 以上である必要があります: {min_months}")
+    if isinstance(tolerance, bool) or not isinstance(tolerance, (int, float)):
+        raise TypeError(f"tolerance は数値である必要があります: {tolerance!r}")
+    if tolerance < 0:
+        raise ValueError(f"tolerance は 0 以上である必要があります: {tolerance}")
+
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        if e.amount < 0:  # D2
+            continue
+        groups.setdefault((e.category, _normalize_memo(e.memo)), []).append(e)
+
+    found: list[Recurring] = []
+    for (category, _), items in groups.items():
+        for members in _split_series(items, tolerance):
+            rec = _to_recurring(category, members, min_months)
+            if rec is not None:
+                found.append(rec)
+
+    found.sort(key=lambda r: (r.next_due, -r.amount, r.category, r.memo))  # R3
+    return found
