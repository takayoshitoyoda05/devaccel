@@ -0,0 +1,153 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.compare import Change, MonthComparison, compare_months, render_comparison
+from kakeibo.core import Expense
+
+
+def _e(month: int, cat: str, amount: int) -> Expense:
+    return Expense(date(2026, month, 1), cat, amount)
+
+
+@pytest.mark.parametrize(
+    ("rows", "expected"),
+    [
+        pytest.param(
+            [_e(1, "食費", 1000), _e(3, "食費", 500)],
+            [
+                MonthComparison(
+                    "2026-01",
+                    None,
+                    [Change("食費", 0, 1000, 1000, None, "new")],
+                ),
+                MonthComparison(
+                    "2026-02",
+                    "2026-01",
+                    [Change("食費", 1000, 0, -1000, -1.0, "gone")],
+                ),
+                MonthComparison(
+                    "2026-03",
+                    "2026-02",
+                    [Change("食費", 0, 500, 500, None, "new")],
+                ),
+            ],
+            id="E4-1",
+        ),
+        pytest.param(
+            [_e(1, "食費", 1000), _e(2, "食費", 1100)],
+            [
+                MonthComparison(
+                    "2026-01",
+                    None,
+                    [Change("食費", 0, 1000, 1000, None, "new")],
+                ),
+                MonthComparison(
+                    "2026-02",
+                    "2026-01",
+                    [Change("食費", 1000, 1100, 100, 0.1, "increased")],
+                ),
+            ],
+            id="E4-2",
+        ),
+        pytest.param(
+            [_e(1, "食費", 1000), _e(1, "雑費", 300)],
+            [
+                MonthComparison(
+                    "2026-01",
+                    None,
+                    [
+                        Change("食費", 0, 1000, 1000, None, "new"),
+                        Change("雑費", 0, 300, 300, None, "new"),
+                    ],
+                ),
+            ],
+            id="E4-3",
+        ),
+    ],
+)
+def test_example_table(rows, expected):
+    assert compare_months(rows) == expected
+
+
+def test_empty_rows_returns_empty_list():
+    assert compare_months([]) == []
+
+
+def test_refund_nets_into_monthly_total():
+    # D2: 返金(負の金額)は合計に含めて相殺する
+    rows = [_e(1, "食費", 1000), _e(2, "食費", 1000), _e(2, "食費", -300)]
+    result = compare_months(rows)
+    assert result[1].changes == [
+        Change("食費", 1000, 700, -300, -0.3, "decreased"),
+    ]
+
+
+def test_unchanged_category_is_listed_with_zero_diff():
+    rows = [_e(1, "食費", 1000), _e(2, "食費", 1000)]
+    result = compare_months(rows)
+    assert result[1].changes == [Change("食費", 1000, 1000, 0, 0.0, "unchanged")]
+
+
+def test_category_zero_in_both_months_is_omitted():
+    # 1 月の雑費は +500 と -500 で合計 0、2 月も無いので出さない
+    rows = [
+        _e(1, "食費", 1000),
+        _e(1, "雑費", 500),
+        _e(1, "雑費", -500),
+        _e(2, "食費", 1000),
+    ]
+    result = compare_months(rows)
+    assert [c.category for c in result[0].changes] == ["食費"]
+    assert [c.category for c in result[1].changes] == ["食費"]
+
+
+def test_missing_middle_month_is_compared_as_empty():
+    # D3: 2 月にデータが無くても 2 月を空の月として並べる
+    rows = [_e(1, "食費", 1000), _e(3, "食費", 1000)]
+    result = compare_months(rows)
+    assert [c.month for c in result] == ["2026-01", "2026-02", "2026-03"]
+    assert result[1].changes == [Change("食費", 1000, 0, -1000, -1.0, "gone")]
+
+
+def test_changes_sorted_by_abs_diff_then_category():
+    # 食費 +100 / 雑費 -100 / 住居 +500(新規): |diff| 降順、同点はカテゴリ昇順(雑費 < 食費)
+    rows = [
+        _e(1, "食費", 1000),
+        _e(1, "雑費", 1100),
+        _e(2, "食費", 1100),
+        _e(2, "雑費", 1000),
+        _e(2, "住居", 500),
+    ]
+    result = compare_months(rows)
+    assert [c.category for c in result[1].changes] == ["住居", "雑費", "食費"]
+
+
+def test_first_month_is_all_new_even_when_negative():
+    # D3/R2: 最初の月は previous=0 扱いの new。返金のみでも内訳として出す
+    rows = [_e(1, "食費", -200)]
+    result = compare_months(rows)
+    assert result == [
+        MonthComparison("2026-01", None, [Change("食費", 0, -200, -200, None, "new")]),
+    ]
+
+
+def test_render_comparison_exact_output():
+    rows = [
+        _e(1, "食費", 1000),
+        _e(1, "雑費", 500),
+        _e(2, "食費", 1200),
+    ]
+    text = render_comparison(compare_months(rows))
+    assert text == (
+        "2026-01\n"
+        "  食費  +1,000円  (—)  新\n"
+        "  雑費  +500円  (—)  新\n"
+        "2026-02 (前月 2026-01)\n"
+        "  雑費  -500円  (-100.0%)  消\n"
+        "  食費  +200円  (+20.0%)  増"
+    )
+
+
+def test_render_empty_list_returns_empty_string():
+    assert render_comparison([]) == ""
