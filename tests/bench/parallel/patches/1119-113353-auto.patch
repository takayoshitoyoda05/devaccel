@@ -0,0 +1,52 @@
+"""Month-over-month comparison per category (pure function)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryDiff:
+    category: str
+    base: int
+    target: int
+    diff: int
+    direction: str  # "up" | "down" | "same"
+
+
+def _parse_month(month: str) -> tuple[int, int]:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月は YYYY-MM 形式で指定してください(例: 2026-10): {month!r}")
+    return int(month[:4]), int(month[5:7])
+
+
+def _sums(rows: list[Expense], key: tuple[int, int]) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for e in rows:
+        if (e.day.year, e.day.month) == key:
+            out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def compare_months(rows: list[Expense], base: str, target: str) -> list[CategoryDiff]:
+    base_key = _parse_month(base)
+    target_key = _parse_month(target)
+
+    base_sums = _sums(rows, base_key)
+    target_sums = _sums(rows, target_key)
+
+    result: list[CategoryDiff] = []
+    for cat in set(base_sums) | set(target_sums):
+        b = base_sums.get(cat, 0)
+        t = target_sums.get(cat, 0)
+        diff = t - b
+        direction = "up" if diff > 0 else "down" if diff < 0 else "same"
+        result.append(CategoryDiff(cat, b, t, diff, direction))
+
+    result.sort(key=lambda d: (-abs(d.diff), d.category))
+    return result
