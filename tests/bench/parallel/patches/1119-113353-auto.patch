@@ -0,0 +1,91 @@
+"""Detect recurring monthly expenses and predict their next occurrence."""
+
+from __future__ import annotations
+
+import calendar
+import re
+import statistics
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_SPACES = re.compile(r"\s+")
+_MIN_MONTHS = 3
+_MAX_DAY_SPREAD = 3
+
+
+@dataclass(frozen=True)
+class Recurring:
+    memo: str
+    amount: int
+    months: int
+    last_day: date
+    next_day: date
+
+
+def _normalize(memo: str) -> str:
+    text = unicodedata.normalize("NFKC", memo).strip()
+    return _SPACES.sub(" ", text).casefold()
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month - 1
+
+
+def _latest_single_run(entries: list[Expense]) -> list[Expense]:
+    """Newest run of consecutive months that each hold exactly one entry."""
+    by_month: dict[int, list[Expense]] = {}
+    for e in entries:
+        by_month.setdefault(_month_index(e.day), []).append(e)
+    runs: list[list[Expense]] = []
+    current: list[Expense] = []
+    prev_idx: int | None = None
+    for idx in sorted(by_month):
+        items = by_month[idx]
+        if len(items) != 1:
+            prev_idx = None  # a month with 2+ entries cuts the run
+            continue
+        if prev_idx is None or idx != prev_idx + 1:
+            current = []
+            runs.append(current)
+        current.append(items[0])
+        prev_idx = idx
+    return runs[-1] if runs else []
+
+
+def _next_month_same_day(d: date) -> date:
+    year, month = (d.year + 1, 1) if d.month == 12 else (d.year, d.month + 1)
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+def find_recurring(rows: list[Expense]) -> list[Recurring]:
+    groups: dict[tuple[str, int], list[Expense]] = {}
+    for e in rows:
+        memo = _normalize(e.memo)
+        if not memo:
+            continue
+        groups.setdefault((memo, e.amount), []).append(e)
+
+    found: list[Recurring] = []
+    for (memo, amount), entries in groups.items():
+        run = _latest_single_run(entries)
+        if len(run) < _MIN_MONTHS:
+            continue
+        days = [e.day.day for e in run]
+        mid = statistics.median(days)
+        if any(abs(d - mid) > _MAX_DAY_SPREAD for d in days):
+            continue
+        last_day = run[-1].day
+        found.append(
+            Recurring(
+                memo=memo,
+                amount=amount,
+                months=len(run),
+                last_day=last_day,
+                next_day=_next_month_same_day(last_day),
+            )
+        )
+    return sorted(found, key=lambda r: (r.next_day, r.memo, r.amount))
