@@ -0,0 +1,76 @@
+"""Expense search by condition (pure functions, standard library only)."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Condition:
+    """Conditions on a single Expense. None means "do not filter on this field".
+
+    All non-None fields must match (AND). Use all_of / any_of to compose.
+    """
+
+    category: str | None = None
+    min_amount: int | None = None
+    max_amount: int | None = None
+    memo: str | None = None
+    start: date | None = None
+    end: date | None = None
+
+    def __post_init__(self) -> None:
+        if (
+            self.min_amount is not None
+            and self.max_amount is not None
+            and self.min_amount > self.max_amount
+        ):
+            raise ValueError("min_amount は max_amount 以下である必要があります")
+        if self.start is not None and self.end is not None and self.start > self.end:
+            raise ValueError("start は end 以前である必要があります")
+
+
+@dataclass(frozen=True)
+class _AllOf(Condition):
+    parts: tuple[Condition, ...] = ()
+
+
+@dataclass(frozen=True)
+class _AnyOf(Condition):
+    parts: tuple[Condition, ...] = ()
+
+
+def all_of(*conds: Condition) -> Condition:
+    """AND of conditions. With no arguments, matches everything."""
+    return _AllOf(parts=tuple(conds))
+
+
+def any_of(*conds: Condition) -> Condition:
+    """OR of conditions. With no arguments, matches nothing."""
+    return _AnyOf(parts=tuple(conds))
+
+
+def _matches(cond: Condition, e: Expense) -> bool:
+    if isinstance(cond, _AllOf):
+        return all(_matches(p, e) for p in cond.parts)
+    if isinstance(cond, _AnyOf):
+        return any(_matches(p, e) for p in cond.parts)
+    if cond.category is not None and e.category != cond.category:
+        return False
+    if cond.min_amount is not None and e.amount < cond.min_amount:
+        return False
+    if cond.max_amount is not None and e.amount > cond.max_amount:
+        return False
+    if cond.memo is not None and cond.memo.casefold() not in e.memo.casefold():
+        return False
+    if cond.start is not None and e.day < cond.start:
+        return False
+    return cond.end is None or e.day <= cond.end
+
+
+def search(rows: list[Expense], cond: Condition) -> list[Expense]:
+    """Return matching rows in input order (new list; input is not modified)."""
+    return [e for e in rows if _matches(cond, e)]
