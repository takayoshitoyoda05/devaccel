@@ -0,0 +1,116 @@
+"""Import bank/card CSV text into Expense records (pure: takes text, no file I/O)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from datetime import date
+
+from kakeibo.core import Expense
+
+_DATE_ALIASES = ("日付", "利用日", "取引日", "date")
+_AMOUNT_ALIASES = ("金額", "利用金額", "出金額", "amount")
+_MEMO_ALIASES = ("摘要", "内容", "利用店名", "memo")
+_CATEGORY_ALIAS = "category"
+_DEFAULT_CATEGORY = "未分類"
+
+_ISO_RE = re.compile(r"([0-9]{4})-([0-9]{2})-([0-9]{2})")
+_SLASH_RE = re.compile(r"([0-9]{4})/([0-9]{1,2})/([0-9]{1,2})")
+_JP_RE = re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日")
+_AMOUNT_RE = re.compile(r"-?[0-9]+")
+_AMOUNT_NOISE_RE = re.compile(r"[¥円,\s]")
+
+
+def _parse_day(raw: str) -> date:
+    s = raw.strip()
+    for rx in (_ISO_RE, _SLASH_RE, _JP_RE):
+        m = rx.fullmatch(s)
+        if m:
+            try:
+                return date(int(m[1]), int(m[2]), int(m[3]))
+            except ValueError:
+                break
+    raise ValueError(f"日付が不正です: {raw!r}")
+
+
+def _parse_amount(raw: str) -> int:
+    s = _AMOUNT_NOISE_RE.sub("", unicodedata.normalize("NFKC", raw))
+    if not _AMOUNT_RE.fullmatch(s):
+        raise ValueError(f"金額が整数ではありません: {raw!r}")
+    return int(s)
+
+
+def _find_column(header: list[str], aliases: tuple[str, ...]) -> int | None:
+    for i, name in enumerate(header):
+        if name.strip().lower() in aliases:
+            return i
+    return None
+
+
+def _is_blank(row: list[str]) -> bool:
+    return not row or (len(row) == 1 and not row[0].strip())
+
+
+def import_bank_csv(text: str) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Parse bank/card CSV text.
+
+    Returns (expenses in input order, errors as (physical line number, reason)).
+    Bad rows are reported, not raised; good rows are still imported.
+    """
+    text = text.removeprefix("﻿")
+    reader = csv.reader(io.StringIO(text, newline=""))
+    it = iter(reader)
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    header: list[str] | None = None
+    idx_date = idx_amount = idx_category = idx_memo = None
+    line = 0  # physical lines consumed so far
+
+    while True:
+        start = line + 1
+        try:
+            row = next(it)
+        except StopIteration:
+            break
+        except csv.Error as e:
+            errors.append((start, f"CSV として読めません: {e}"))
+            break
+        line = reader.line_num
+        if _is_blank(row):
+            continue
+
+        if header is None:
+            header = row
+            idx_date = _find_column(header, _DATE_ALIASES)
+            idx_amount = _find_column(header, _AMOUNT_ALIASES)
+            idx_category = _find_column(header, (_CATEGORY_ALIAS,))
+            idx_memo = _find_column(header, _MEMO_ALIASES)
+            if idx_date is None:
+                return [], [(1, "列 日付 がありません")]
+            if idx_amount is None:
+                return [], [(1, "列 金額 がありません")]
+            continue
+
+        assert idx_date is not None and idx_amount is not None
+        if len(row) != len(header):
+            errors.append(
+                (start, f"列の数が合いません: 期待 {len(header)}, 実際 {len(row)}")
+            )
+            continue
+        try:
+            day = _parse_day(row[idx_date])
+            amount = _parse_amount(row[idx_amount])
+        except ValueError as e:
+            errors.append((start, str(e)))
+            continue
+        category = (
+            row[idx_category].strip() if idx_category is not None else _DEFAULT_CATEGORY
+        )
+        memo = row[idx_memo] if idx_memo is not None else ""
+        expenses.append(Expense(day, category, amount, memo))
+
+    if header is None:
+        return [], errors or [(1, "列 日付 がありません")]
+    return expenses, errors
