+            ex(2026, 2, 15, "netflix", 980),
+            ex(2026, 3, 15, "netflix", 980),
+            ex(2026, 2, 20, "netflix", 1000),
+            ex(2026, 1, 25, "rent", 80000),
+            ex(2026, 2, 25, "rent", 80000),
+            ex(2026, 3, 25, "rent", 80000),
+        ],
+        [
+            Recurring("netflix", 980, 3, date(2026, 3, 15), date(2026, 4, 15)),
+            Recurring("rent", 80000, 3, date(2026, 3, 25), date(2026, 4, 25)),
+        ],
+        id="E1-8",
+    ),
+]
+
+
+@pytest.mark.parametrize(("rows", "expected"), EXAMPLE_CASES)
+def test_examples(rows: list[Expense], expected: list[Recurring]) -> None:
+    assert find_recurring(rows) == expected
+
+
+def test_empty_input() -> None:
+    assert find_recurring([]) == []
+
+
+def test_invariants_and_order_independence() -> None:
+    rows = [
+        ex(2026, 1, 15, "netflix", 980),
+        ex(2026, 2, 15, "netflix", 980),
+        ex(2026, 3, 15, "netflix", 980),
+        ex(2026, 1, 25, "rent", 80000),
+        ex(2026, 2, 25, "rent", 80000),
+        ex(2026, 3, 25, "rent", 80000),
+    ]
+    forward = find_recurring(rows)
+    backward = find_recurring(list(reversed(rows)))
+    assert forward == backward
+    for r in forward:
+        assert r.months >= 3  # P1
+        assert r.next_day > r.last_day  # P2
+
+
+def test_input_not_mutated() -> None:
+    rows = [
+        ex(2026, 3, 15, "netflix", 980),
+        ex(2026, 1, 15, "netflix", 980),
+        ex(2026, 2, 15, "netflix", 980),
+    ]
+    snapshot = list(rows)
+    find_recurring(rows)
+    assert rows == snapshot
