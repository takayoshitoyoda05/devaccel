+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.month_compare import CategoryDiff, compare_months
+
+
+def ex(day: str, category: str, amount: int) -> Expense:
+    y, m, d = (int(p) for p in day.split("-"))
+    return Expense(date(y, m, d), category, amount)
+
+
+# E4-1: 9 月は無視される / E4-2: 減少 / E4-3: 片方にしかないカテゴリは 0 扱い
+# E4-4: 同額は same / E4-5: 返金込みで合計 0 は same / E4-6: 並び順 / E4-7: 空・base==target
+# E4-8: 不正な月形式は ValueError
+
+
+@pytest.mark.parametrize(
+    ("rows", "base", "target", "expected"),
+    [
+        pytest.param(
+            [
+                ex("2026-09-05", "食費", 9000),
+                ex("2026-10-05", "食費", 30000),
+                ex("2026-11-05", "食費", 35000),
+            ],
+            "2026-10",
+            "2026-11",
+            [CategoryDiff("食費", 30000, 35000, 5000, "up")],
+            id="E4-1",
+        ),
+        pytest.param(
+            [ex("2026-10-01", "交通", 10000), ex("2026-11-01", "交通", 8000)],
+            "2026-10",
+            "2026-11",
+            [CategoryDiff("交通", 10000, 8000, -2000, "down")],
+            id="E4-2",
+        ),
+        pytest.param(
+            [ex("2026-10-01", "光熱", 6000), ex("2026-11-01", "趣味", 4000)],
+            "2026-10",
+            "2026-11",
+            [
+                CategoryDiff("光熱", 6000, 0, -6000, "down"),
+                CategoryDiff("趣味", 0, 4000, 4000, "up"),
+            ],
+            id="E4-3",
+        ),
+        pytest.param(
+            [ex("2026-10-01", "家賃", 80000), ex("2026-11-01", "家賃", 80000)],
+            "2026-10",
+            "2026-11",
+            [CategoryDiff("家賃", 80000, 80000, 0, "same")],
+            id="E4-4",
+        ),
+        pytest.param(
+            [
+                ex("2026-10-01", "食費", 5000),
+                ex("2026-10-02", "食費", -5000),
+                ex("2026-11-01", "食費", 0),
+            ],
+            "2026-10",
+            "2026-11",
+            [CategoryDiff("食費", 0, 0, 0, "same")],
+            id="E4-5",
+        ),
+        pytest.param(
+            [
+                ex("2026-10-01", "food", 0),
+                ex("2026-10-01", "rent", 3000),
+                ex("2026-10-01", "fun", 0),
+                ex("2026-11-01", "food", 3000),
+                ex("2026-11-01", "rent", 0),
+                ex("2026-11-01", "fun", 500),
+            ],
+            "2026-10",
+            "2026-11",
+            [
+                CategoryDiff("food", 0, 3000, 3000, "up"),
+                CategoryDiff("rent", 3000, 0, -3000, "down"),
+                CategoryDiff("fun", 0, 500, 500, "up"),
+            ],
+            id="E4-6",
+        ),
+        pytest.param([], "2026-10", "2026-11", [], id="E4-7a"),
+        pytest.param(
+            [ex("2026-11-03", "食費", 1000)],
+            "2026-11",
+            "2026-11",
+            [CategoryDiff("食費", 1000, 1000, 0, "same")],
+            id="E4-7b",
+        ),
+    ],
+)
+def test_example_table(
+    rows: list[Expense],
+    base: str,
+    target: str,
+    expected: list[CategoryDiff],
+) -> None:
+    assert compare_months(rows, base, target) == expected
+
+
+@pytest.mark.parametrize(
+    ("base", "target"),
+    [
+        pytest.param("2026-13", "2026-11", id="E4-8a"),
+        pytest.param("2026-10", "2026-1", id="E4-8b"),
+    ],
+)
+def test_invalid_month_raises(base: str, target: str) -> None:
+    with pytest.raises(ValueError, match="YYYY-MM"):
+        compare_months([], base, target)
+
+
+@pytest.mark.parametrize(
+    ("base", "target"),
+    [
+        pytest.param("2026-00", "2026-11", id="R7-zero-month"),
+        pytest.param("2026/10", "2026-11", id="R7-slash"),
+        pytest.param("26-10", "2026-11", id="R7-short-year"),
+    ],
+)
+def test_malformed_month_raises(base: str, target: str) -> None:
+    with pytest.raises(ValueError, match="YYYY-MM"):
+        compare_months([ex("2026-10-01", "食費", 1)], base, target)
+
+
+def test_year_crossing_and_reversed_order() -> None:
+    rows = [
+        ex("2025-12-01", "食費", 4000),
+        ex("2026-01-01", "食費", 6000),
+    ]
+    assert compare_months(rows, "2025-12", "2026-01") == [
+        CategoryDiff("食費", 4000, 6000, 2000, "up"),
+    ]
+    assert compare_months(rows, "2026-01", "2025-12") == [
+        CategoryDiff("食費", 6000, 4000, -2000, "down"),
+    ]
+
+
+def test_rows_not_mutated() -> None:
+    rows = [ex("2026-10-01", "食費", 100), ex("2026-11-01", "食費", 200)]
+    snapshot = list(rows)
+    compare_months(rows, "2026-10", "2026-11")
+    assert rows == snapshot
+
+
+def test_invariants_hold() -> None:
+    rows = [
+        ex("2026-09-01", "食費", 999),
+        ex("2026-10-01", "食費", 5000),
+        ex("2026-10-02", "交通", 1200),
+        ex("2026-11-01", "食費", 3000),
+        ex("2026-11-02", "趣味", 700),
+        ex("2026-11-03", "交通", -200),
+    ]
+    result = compare_months(rows, "2026-10", "2026-11")
+
+    names = [d.category for d in result]
+    assert len(names) == len(set(names))  # P2
+
+    for d in result:  # P1
+        assert d.diff == d.target - d.base
+        expected_dir = "up" if d.diff > 0 else "down" if d.diff < 0 else "same"
+        assert d.direction == expected_dir
+
+    base_total = sum(e.amount for e in rows if e.day.strftime("%Y-%m") == "2026-10")
+    target_total = sum(e.amount for e in rows if e.day.strftime("%Y-%m") == "2026-11")
+    assert sum(d.diff for d in result) == target_total - base_total  # P3
