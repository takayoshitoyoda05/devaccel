+"""Tests for kakeibo.search (E3-* examples, R1-R7, P1-P3)."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import Condition, all_of, any_of, search
+
+
+def ex(day: date, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# E3-1 (R7): 範囲が逆順なら ValueError
+@pytest.mark.parametrize(
+    "make",
+    [
+        lambda: Condition(min_amount=1000, max_amount=999),
+        lambda: Condition(start=date(2024, 3, 2), end=date(2024, 3, 1)),
+    ],
+    ids=["E3-1a", "E3-1b"],
+)
+def test_e3_1_inverted_range_raises(make: Callable[[], Condition]) -> None:
+    with pytest.raises(ValueError):
+        make()
+
+
+# E3-2 (R2): 金額の範囲は両端を含む
+def test_e3_2_amount_range_inclusive_single_value() -> None:
+    rows = [
+        ex(date(2024, 1, 1), "食費", 999),
+        ex(date(2024, 1, 2), "食費", 1000),
+        ex(date(2024, 1, 3), "食費", 1001),
+    ]
+    cond = Condition(min_amount=1000, max_amount=1000)
+    assert search(rows, cond) == [rows[1]]
+
+
+# E3-3 (R2): 返金(負額)は範囲に含められる
+def test_e3_3_refund_is_included_in_range() -> None:
+    rows = [
+        ex(date(2024, 1, 1), "食費", -500),
+        ex(date(2024, 1, 2), "食費", 0),
+        ex(date(2024, 1, 3), "食費", 300),
+    ]
+    cond = Condition(max_amount=0)
+    assert search(rows, cond) == [rows[0], rows[1]]
+
+
+# E3-4 (R3): メモは大文字小文字を無視した部分一致、"" は全件一致
+@pytest.mark.parametrize(
+    ("memo", "expected_idx"),
+    [("coffee", [0]), ("", [0, 1])],
+    ids=["E3-4a", "E3-4b"],
+)
+def test_e3_4_memo_partial_casefold(memo: str, expected_idx: list[int]) -> None:
+    rows = [
+        ex(date(2024, 1, 1), "食費", 100, "Coffee Shop"),
+        ex(date(2024, 1, 2), "食費", 200, ""),
+    ]
+    assert search(rows, Condition(memo=memo)) == [rows[i] for i in expected_idx]
+
+
+# E3-5 (R4): 期間は両端を含み、閏日を含む
+def test_e3_5_period_inclusive_with_leap_day() -> None:
+    rows = [
+        ex(date(2024, 2, 28), "食費", 1),
+        ex(date(2024, 2, 29), "食費", 2),
+        ex(date(2024, 3, 1), "食費", 3),
+        ex(date(2024, 3, 2), "食費", 4),
+    ]
+    cond = Condition(start=date(2024, 2, 29), end=date(2024, 3, 1))
+    assert search(rows, cond) == [rows[1], rows[2]]
+
+
+# E3-6 (R1, R5): AND と OR の入れ子
+def test_e3_6_nested_all_of_any_of() -> None:
+    rows = [
+        ex(date(2024, 3, 1), "食費", 500, "スタバ"),
+        ex(date(2024, 3, 2), "食費", 300, "コンビニ"),
+        ex(date(2024, 3, 3), "食費", 200, "米"),
+        ex(date(2024, 3, 4), "交通費", 400, "スタバ"),
+    ]
+    cond = all_of(
+        Condition(category="食費"),
+        any_of(Condition(memo="スタバ"), Condition(memo="コンビニ")),
+    )
+    assert search(rows, cond) == [rows[0], rows[1]]
+
+
+# E3-7 (R5): all_of() は全件一致、any_of() は 1 件も一致しない
+@pytest.mark.parametrize(
+    ("cond", "expected_len"),
+    [(all_of(), 1), (any_of(), 0)],
+    ids=["E3-7a", "E3-7b"],
+)
+def test_e3_7_empty_composites(cond: Condition, expected_len: int) -> None:
+    rows = [ex(date(2024, 1, 1), "食費", 100)]
+    assert len(search(rows, cond)) == expected_len
+
+
+# E3-8 (R1, R6): 全件一致は入力と同じ順で重複も残す。空入力は常に []
+@pytest.mark.parametrize(
+    ("rows_kind", "cond", "expected"),
+    [("dup", Condition(), "same"), ("empty", Condition(category="食費"), "empty")],
+    ids=["E3-8a", "E3-8b"],
+)
+def test_e3_8_all_match_keeps_order_and_duplicates(
+    rows_kind: str, cond: Condition, expected: str
+) -> None:
+    a = ex(date(2024, 1, 1), "食費", 100, "x")
+    b = ex(date(2024, 1, 2), "交通費", 200, "y")
+    if rows_kind == "dup":
+        rows = [a, a, b]
+        assert search(rows, cond) == [a, a, b]
+    else:
+        assert search([], cond) == []
+
+
+# R6: 新しいリストを返し、入力は変更しない
+def test_r6_returns_new_list_and_leaves_input_unchanged() -> None:
+    rows = [ex(date(2024, 1, 1), "食費", 100), ex(date(2024, 1, 2), "食費", 200)]
+    snapshot = list(rows)
+    out = search(rows, Condition())
+    assert out == snapshot
+    assert out is not rows
+    assert rows == snapshot
+
+
+# P1: 結果は入力の部分列で、件数は入力以下
+def test_p1_result_is_ordered_subsequence() -> None:
+    rows = [
+        ex(date(2024, 1, 1), "食費", 100, "a"),
+        ex(date(2024, 1, 2), "交通費", 200, "b"),
+        ex(date(2024, 1, 3), "食費", 300, "c"),
+    ]
+    out = search(rows, Condition(category="食費"))
+    assert len(out) <= len(rows)
+    it = iter(rows)
+    assert all(any(x is y for y in it) for x in out)
+
+
+# P2: all_of(a, b) は a と b の両方に含まれる
+def test_p2_all_of_is_subset_of_each_part() -> None:
+    rows = [
+        ex(date(2024, 1, 1), "食費", 100, "スタバ"),
+        ex(date(2024, 1, 2), "食費", 300, "米"),
+        ex(date(2024, 1, 3), "交通費", 200, "スタバ"),
+    ]
+    a, b = Condition(category="食費"), Condition(memo="スタバ")
+    both = search(rows, all_of(a, b))
+    assert all(r in search(rows, a) and r in search(rows, b) for r in both)
+
+
+# P3: any_of(a, b) は a と b の和集合で、入力の並びを保つ
+def test_p3_any_of_is_union_in_input_order() -> None:
+    rows = [
+        ex(date(2024, 1, 1), "食費", 100, "x"),
+        ex(date(2024, 1, 2), "交通費", 200, "y"),
+        ex(date(2024, 1, 3), "食費", 300, "z"),
+    ]
+    a, b = Condition(category="食費"), Condition(min_amount=200)
+    expected = [r for r in rows if r in search(rows, a) or r in search(rows, b)]
+    assert search(rows, any_of(a, b)) == expected
