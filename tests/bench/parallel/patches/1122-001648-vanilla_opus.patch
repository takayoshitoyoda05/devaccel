diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..e19a7d1 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -188,3 +188,117 @@ def test_path_type(runner, cls, expect):
 
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "data.csv",
+        "data.tsv",
+        "DATA.CSV",
+        "data.Tsv",
+        "dir/sub/data.csv",
+        "archive.v2.csv",
+        pathlib.Path("data.CSV"),
+        b"data.csv",
+    ],
+)
+def test_path_extensions_accepted(value):
+    path_type = click.Path(extensions=(".csv", ".tsv"))
+    assert path_type.convert(value, None, None) == value
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["data.txt", "data", "data.csv.bak", "datacsv", ".csv", "dir.csv/data"],
+)
+def test_path_extensions_rejected(value):
+    path_type = click.Path(extensions=(".csv", ".tsv"))
+
+    with pytest.raises(click.BadParameter) as exc_info:
+        path_type.convert(value, None, None)
+
+    message = exc_info.value.message
+    assert "does not have one of the extensions '.csv', '.tsv'" in message
+
+
+def test_path_extensions_single_message():
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Path(extensions=[".csv"]).convert("data.txt", None, None)
+
+    assert "does not have the extension '.csv'." in exc_info.value.message
+
+
+@pytest.mark.parametrize(
+    ("extensions", "expect"),
+    [
+        ([".csv", ".tsv"], (".csv", ".tsv")),
+        (["csv", "TSV"], (".csv", ".tsv")),
+        ([".CSV", "csv", ".Csv"], (".csv",)),
+        ("csv", (".csv",)),
+        ([".tar.gz"], (".tar.gz",)),
+    ],
+)
+def test_path_extensions_normalized(extensions, expect):
+    assert click.Path(extensions=extensions).extensions == expect
+
+
+@pytest.mark.parametrize("extensions", [[], [""], ["."], ["csv", "."]])
+def test_path_extensions_invalid(extensions):
+    with pytest.raises(ValueError):
+        click.Path(extensions=extensions)
+
+
+def test_path_extensions_default_accepts_anything():
+    path_type = click.Path()
+    assert path_type.extensions is None
+    assert path_type.convert("data.whatever", None, None) == "data.whatever"
+
+
+def test_path_extensions_multi_part():
+    path_type = click.Path(extensions=[".tar.gz"])
+    assert path_type.convert("backup.TAR.GZ", None, None) == "backup.TAR.GZ"
+
+    with pytest.raises(click.BadParameter):
+        path_type.convert("backup.gz", None, None)
+
+
+def test_path_extensions_existing_file(tmp_path):
+    good = tmp_path / "data.CSV"
+    good.write_text("")
+    bad = tmp_path / "data.txt"
+    bad.write_text("")
+    path_type = click.Path(exists=True, extensions=[".csv"])
+
+    assert path_type.convert(os.fspath(good), None, None) == os.fspath(good)
+
+    with pytest.raises(click.BadParameter, match="does not have the extension"):
+        path_type.convert(os.fspath(bad), None, None)
+
+
+def test_path_extensions_directory_not_checked(tmp_path):
+    path_type = click.Path(exists=True, extensions=[".csv"])
+    assert path_type.convert(os.fspath(tmp_path), None, None) == os.fspath(tmp_path)
+
+
+def test_path_extensions_dash_not_checked():
+    path_type = click.Path(allow_dash=True, extensions=[".csv"])
+    assert path_type.convert("-", None, None) == "-"
+
+
+def test_path_extensions_cli(runner):
+    @click.command()
+    @click.argument("src", type=click.Path(dir_okay=False, extensions=["csv", "tsv"]))
+    def cli(src):
+        click.echo(src)
+
+    result = runner.invoke(cli, ["input.TSV"])
+    assert result.exit_code == 0
+    assert result.output == "input.TSV\n"
+
+    result = runner.invoke(cli, ["input.json"])
+    assert result.exit_code == 2
+    assert (
+        "Invalid value for 'SRC': File 'input.json' does not have one of the"
+        " extensions '.csv', '.tsv'." in result.output
+    )
