diff --git a/src/kakeibo/core.py b/src/kakeibo/core.py
index 8c3cbab..1b8f18e 100644
--- a/src/kakeibo/core.py
+++ b/src/kakeibo/core.py
@@ -122,14 +122,28 @@ def load_budget(path: Path) -> Budget:
     return Budget(default, months)
 
 
-def find_overruns(
+NOTICE_PERCENT = 90
+
+
+def percent_of(actual: int, limit: int) -> int:
+    """actual / limit in whole percent, rounded down. limit must be > 0."""
+    return actual * 100 // limit
+
+
+def find_alerts(
     totals: dict[str, dict[str, int]], budget: Budget
-) -> list[tuple[str, str, int, int, int]]:
-    """(month, category, over, limit, actual) for actual > limit."""
-    out: list[tuple[str, str, int, int, int]] = []
+) -> list[tuple[str, str, int, int]]:
+    """(month, category, limit, actual) for actual > limit or >= NOTICE_PERCENT %.
+
+    A limit of 0 only alerts when actual > 0 (an overrun).
+    """
+    out: list[tuple[str, str, int, int]] = []
     for month, cats in totals.items():
         limits = budget.for_month(month)
         for cat, actual in cats.items():
-            if cat in limits and actual > limits[cat]:
-                out.append((month, cat, actual - limits[cat], limits[cat], actual))
+            if cat not in limits:
+                continue
+            limit = limits[cat]
+            if actual > limit or (limit > 0 and actual * 100 >= limit * NOTICE_PERCENT):
+                out.append((month, cat, limit, actual))
     return out
