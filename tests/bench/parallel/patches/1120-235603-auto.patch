diff --git a/tests/test_import_columns.py b/tests/test_import_columns.py
new file mode 100644
index 0000000..78b38ea
--- /dev/null
+++ b/tests/test_import_columns.py
@@ -0,0 +1,140 @@
+"""Tests for kakeibo.import_columns.map_columns."""
+
+from __future__ import annotations
+
+import pytest
+
+from kakeibo.import_columns import ColumnMap, map_columns
+
+
+@pytest.mark.parametrize(
+    ("header", "expected"),
+    [
+        pytest.param(
+            ["ご利用日", "ご利用店名", "ご利用金額"],
+            ColumnMap(
+                date=0, amount=2, withdrawal=None, deposit=None, memo=1, category=None
+            ),
+            id="E3-1",
+        ),
+        pytest.param(
+            ["取引日", "摘要", "出金額", "入金額"],
+            ColumnMap(
+                date=0, amount=None, withdrawal=2, deposit=3, memo=1, category=None
+            ),
+            id="E3-2",
+        ),
+        pytest.param(
+            ["摘要", "残高"],
+            ValueError,
+            id="E3-3",
+        ),
+    ],
+)
+def test_example_table(
+    header: list[str], expected: ColumnMap | type[Exception]
+) -> None:
+    if expected is ValueError:
+        with pytest.raises(ValueError):
+            map_columns(header)
+    else:
+        assert map_columns(header) == expected
+
+
+# R1: 正規化(NFKC・空白除去・casefold)してから完全一致。
+def test_r1_fullwidth_and_inner_spaces_are_ignored() -> None:
+    result = map_columns(["ご 利用 日", "Ｄａｔｅ", "金額"])
+    assert result.date == 0
+    assert result.amount == 2
+
+
+def test_r1_case_is_folded() -> None:
+    result = map_columns(["DATE", "AMOUNT"])
+    assert (result.date, result.amount) == (0, 1)
+
+
+def test_r1_no_partial_match() -> None:
+    with pytest.raises(ValueError):
+        map_columns(["取引日時", "利用金額合計"])
+
+
+# R2: 役割ごとの別名。
+@pytest.mark.parametrize(
+    "name", ["日付", "利用日", "ご利用日", "取引日", "お取引日", "年月日", "date"]
+)
+def test_r2_date_aliases(name: str) -> None:
+    assert map_columns([name, "金額"]).date == 0
+
+
+@pytest.mark.parametrize(
+    "name", ["金額", "利用金額", "ご利用金額", "支払金額", "amount"]
+)
+def test_r2_amount_aliases(name: str) -> None:
+    assert map_columns(["日付", name]).amount == 1
+
+
+@pytest.mark.parametrize("name", ["出金", "出金額", "お支払金額", "お引出し", "支払"])
+def test_r2_withdrawal_aliases(name: str) -> None:
+    assert map_columns(["日付", name]).withdrawal == 1
+
+
+@pytest.mark.parametrize("name", ["入金", "入金額", "お預入れ", "預入", "預入額"])
+def test_r2_deposit_aliases(name: str) -> None:
+    assert map_columns(["日付", "出金", name]).deposit == 2
+
+
+@pytest.mark.parametrize(
+    "name",
+    ["摘要", "メモ", "内容", "備考", "利用店名", "ご利用店名", "description", "memo"],
+)
+def test_r2_memo_aliases(name: str) -> None:
+    assert map_columns(["日付", name, "金額"]).memo == 1
+
+
+@pytest.mark.parametrize("name", ["カテゴリ", "分類", "費目", "category"])
+def test_r2_category_aliases(name: str) -> None:
+    assert map_columns(["日付", "金額", name]).category == 2
+
+
+# R3: 同じ役割の別名が複数あれば左の列。どの役割にも当たらない列は無視。
+def test_r3_leftmost_alias_wins() -> None:
+    result = map_columns(["日付", "金額", "amount", "摘要"])
+    assert result.amount == 1
+
+
+def test_r3_unknown_columns_are_ignored() -> None:
+    result = map_columns(["残高", "日付", "謎", "金額"])
+    assert (result.date, result.amount) == (1, 3)
+
+
+# R4: 必須は date と amount か withdrawal のどちらか。
+def test_r4_amount_and_withdrawal_both_kept() -> None:
+    result = map_columns(["日付", "金額", "出金", "入金"])
+    assert (result.amount, result.withdrawal, result.deposit) == (1, 2, 3)
+
+
+def test_r4_withdrawal_alone_is_enough() -> None:
+    result = map_columns(["日付", "出金"])
+    assert (result.amount, result.withdrawal) == (None, 1)
+
+
+def test_r4_missing_date_lists_role() -> None:
+    with pytest.raises(ValueError, match="必須の列がありません: 日付$"):
+        map_columns(["金額"])
+
+
+def test_r4_missing_amount_and_withdrawal_lists_both() -> None:
+    with pytest.raises(ValueError) as exc:
+        map_columns(["摘要", "残高"])
+    assert str(exc.value) == "必須の列がありません: 日付, 金額(または出金)"
+
+
+# R5: 先頭列名の BOM は無視。空の header は ValueError。
+def test_r5_bom_on_first_column_is_ignored() -> None:
+    assert map_columns(["﻿日付", "金額"]).date == 0
+
+
+def test_r5_empty_header_raises() -> None:
+    with pytest.raises(ValueError) as exc:
+        map_columns([])
+    assert str(exc.value) == "必須の列がありません: 日付, 金額(または出金)"
