@@ -0,0 +1,67 @@
+"""Map bank/card CSV header names to column indexes."""
+
+from __future__ import annotations
+
+import unicodedata
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class ColumnMap:
+    date: int
+    amount: int | None
+    withdrawal: int | None
+    deposit: int | None
+    memo: int | None
+    category: int | None
+
+
+def _normalize(name: str) -> str:
+    """NFKC, drop BOM, remove all whitespace, casefold (R1/R5)."""
+    s = unicodedata.normalize("NFKC", name).replace("﻿", "")
+    return "".join(s.split()).casefold()
+
+
+def _aliases(*names: str) -> frozenset[str]:
+    return frozenset(_normalize(n) for n in names)
+
+
+_DATE = _aliases("日付", "利用日", "ご利用日", "取引日", "お取引日", "年月日", "date")
+_AMOUNT = _aliases("金額", "利用金額", "ご利用金額", "支払金額", "amount")
+_WITHDRAWAL = _aliases("出金", "出金額", "お支払金額", "お引出し", "支払")
+_DEPOSIT = _aliases("入金", "入金額", "お預入れ", "預入", "預入額")
+_MEMO = _aliases(
+    "摘要", "メモ", "内容", "備考", "利用店名", "ご利用店名", "description", "memo"
+)
+_CATEGORY = _aliases("カテゴリ", "分類", "費目", "category")
+
+
+def _find(header: list[str], aliases: frozenset[str]) -> int | None:
+    """Index of the leftmost column whose normalized name is an alias (R3)."""
+    for i, name in enumerate(header):
+        if _normalize(name) in aliases:
+            return i
+    return None
+
+
+def map_columns(header: list[str]) -> ColumnMap:
+    date = _find(header, _DATE)
+    amount = _find(header, _AMOUNT)
+    withdrawal = _find(header, _WITHDRAWAL)
+
+    missing: list[str] = []
+    if date is None:
+        missing.append("日付")
+    if amount is None and withdrawal is None:
+        missing.append("金額(または出金)")
+    if date is None or (amount is None and withdrawal is None):
+        raise ValueError(f"必須の列がありません: {', '.join(missing)}")
+
+    return ColumnMap(
+        date=date,
+        amount=amount,
+        withdrawal=withdrawal,
+        deposit=_find(header, _DEPOSIT),
+        memo=_find(header, _MEMO),
+        category=_find(header, _CATEGORY),
+    )
