@@ -0,0 +1,70 @@
+"""銀行・カード CSV の日付文字列を `datetime.date` に変換する純粋関数。"""
+
+import re
+import unicodedata
+from datetime import date
+
+# 元号: (名前, 元年を 1 年とした基準年, 受け付ける最大年 or None)
+_ERAS = {
+    "令和": (2018, None),
+    "R": (2018, None),
+    "平成": (1988, 31),
+    "H": (1988, 31),
+    "昭和": (1925, 64),
+    "S": (1925, 64),
+}
+
+_TIME_RE = re.compile(r"^(?P<d>.+?)(?:\s+|T)(?P<h>\d+):(?P<m>\d+)(?::(?P<s>\d+))?$")
+_WESTERN_RE = re.compile(r"^(\d{4})([/.\-])(\d{1,2})\2(\d{1,2})$")
+_WESTERN_KANJI_RE = re.compile(r"^(\d{4})年(\d{1,2})月(\d{1,2})日$")
+_WAREKI_KANJI_RE = re.compile(
+    r"^(令和|平成|昭和|[RHS])(元|\d+)年(\d{1,2})月(\d{1,2})日$"
+)
+_WAREKI_SEP_RE = re.compile(
+    r"^(令和|平成|昭和|[RHS])(元|\d+)([/.\-])(\d{1,2})\3(\d{1,2})$"
+)
+
+
+def _error(raw: str) -> ValueError:
+    return ValueError(f"日付が不正です: {raw!r}")
+
+
+def _wareki_year(era: str, num: str, raw: str) -> int:
+    base, max_year = _ERAS[era]
+    n = 1 if num == "元" else int(num)
+    if n < 1 or (max_year is not None and n > max_year):
+        raise _error(raw)
+    return base + n
+
+
+def parse_date(s: str) -> date:
+    raw = s
+    text = unicodedata.normalize("NFKC", s).strip()
+    if not text:
+        raise _error(raw)
+
+    # 時刻付きは時刻を捨てる(時刻の形が不正なら拒否)
+    m = _TIME_RE.match(text)
+    if m:
+        h, mi = int(m.group("h")), int(m.group("m"))
+        sec = m.group("s")
+        if h > 23 or mi > 59 or (sec is not None and int(sec) > 59):
+            raise _error(raw)
+        text = m.group("d")
+
+    try:
+        if m := _WESTERN_RE.match(text):
+            y, mo, d = int(m.group(1)), int(m.group(3)), int(m.group(4))
+        elif m := _WESTERN_KANJI_RE.match(text):
+            y, mo, d = int(m.group(1)), int(m.group(2)), int(m.group(3))
+        elif m := _WAREKI_KANJI_RE.match(text):
+            y = _wareki_year(m.group(1), m.group(2), raw)
+            mo, d = int(m.group(3)), int(m.group(4))
+        elif m := _WAREKI_SEP_RE.match(text):
+            y = _wareki_year(m.group(1), m.group(2), raw)
+            mo, d = int(m.group(4)), int(m.group(5))
+        else:
+            raise _error(raw)
+        return date(y, mo, d)
+    except ValueError:
+        raise _error(raw) from None
diff --git a/src/kakeibo/importer.py b/src/kakeibo/importer.py
new file mode 100644
index 0000000..4e3ca10
--- /dev/null
+++ b/src/kakeibo/importer.py
@@ -0,0 +1,175 @@
+"""銀行・カード会社の CSV を Expense に取り込む(文字列を受ける純粋関数)。
+
+列名の対応は import_columns、金額は import_amount、日付は import_date が受け持つ。
+このモジュールは行の組み立てと誤りの報告だけを行う。
+
+D1 金額は書かれたまま(負数は返金)。出金/入金の 2 列形式は出金を支出、入金だけの行はスキップ(エラーにしない)
+D2 誤りは 1 行に複数あれば全部報告。誤りのある行は取り込まず、他の行は取り込む(例外にしない)
+D3 区切りはヘッダー行の `,` とタブの多いほう(同数なら `,`)。BOM は無視
+D4 行番号はレコードの開始行(1 始まり、ヘッダーが 1 行目)。引用符内の改行はレコードの一部
+D5 ヘッダーより列が多い行(引用されていない `1,234円` など)は修復せず「列数が多い」と報告
+D6 カテゴリ列が無ければ default_category、メモ列が無ければ空文字。空の行は黙って無視
+D7 空入力・ヘッダーだけは空の結果。必須列が無いときだけ ImportHeaderError
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+import unicodedata
+from dataclasses import dataclass, field
+
+from kakeibo.core import Expense
+from kakeibo.import_amount import parse_amount
+from kakeibo.import_columns import ColumnMap, map_columns
+from kakeibo.import_date import parse_date
+
+_BOM = "﻿"
+_NO_VALUE = {"", "-", "—", "–"}  # 出金/入金の列で「値なし」を表す書き方(NFKC 後)
+
+
+class ImportHeaderError(ValueError):
+    """必須の列(日付・金額)が見つからない。"""
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int  # レコードの開始行(1 始まり)
+    column: str  # 列名。行全体の誤りは「(行全体)」
+    value: str  # 元の値
+    reason: str
+
+    def __str__(self) -> str:
+        return f"{self.line} 行目 [{self.column}] {self.reason}"
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense] = field(default_factory=list)
+    errors: list[RowError] = field(default_factory=list)
+    skipped: list[int] = field(default_factory=list)  # 入金だけでスキップした行
+
+
+def _norm(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip()
+
+
+def _delimiter(text: str) -> str:
+    first = text.split("\n", 1)[0]
+    return "\t" if first.count("\t") > first.count(",") else ","
+
+
+def parse_statement(text: str, *, default_category: str = "未分類") -> ImportResult:
+    """CSV 文字列を取り込む。誤りは ImportResult.errors に集める。"""
+    text = text.removeprefix(_BOM)
+    if not text.strip():
+        return ImportResult()
+
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=_delimiter(text))
+    header: list[str] | None = None
+    cm: ColumnMap | None = None
+    result = ImportResult()
+    prev_end = 0
+    for row in reader:
+        line = prev_end + 1
+        prev_end = reader.line_num
+        if all(not c.strip() for c in row):
+            continue
+        if header is None:
+            header = [c.strip() for c in row]
+            try:
+                cm = map_columns(header)
+            except ValueError as e:
+                raise ImportHeaderError(str(e)) from None
+            continue
+        assert cm is not None
+        _read_row(result, row, line, header, cm, default_category)
+    return result
+
+
+def _read_row(
+    result: ImportResult,
+    row: list[str],
+    line: int,
+    header: list[str],
+    cm: ColumnMap,
+    default_category: str,
+) -> None:
+    if len(row) > len(header):
+        result.errors.append(
+            RowError(
+                line,
+                "(行全体)",
+                ",".join(row),
+                f"列数が多すぎます(ヘッダー {len(header)} 列に対して {len(row)} 列)",
+            )
+        )
+        return
+
+    def raw(i: int | None) -> str:
+        return row[i].strip() if i is not None and i < len(row) else ""
+
+    errors: list[RowError] = []
+
+    def fail(i: int, exc: ValueError) -> None:
+        errors.append(RowError(line, header[i], raw(i), str(exc)))
+
+    day = None
+    try:
+        day = parse_date(raw(cm.date))
+    except ValueError as e:
+        fail(cm.date, e)
+
+    amount: int | None = None
+    is_deposit_only = False
+    if cm.amount is not None:
+        try:
+            amount = parse_amount(raw(cm.amount))
+        except ValueError as e:
+            fail(cm.amount, e)
+    else:
+        assert cm.withdrawal is not None
+        w, d = _norm(raw(cm.withdrawal)), _norm(raw(cm.deposit))
+        w_value: int | None = None
+        w_failed = False
+        if w not in _NO_VALUE:
+            try:
+                w_value = parse_amount(w)
+            except ValueError as e:
+                fail(cm.withdrawal, e)
+                w_failed = True
+        if w_failed:
+            pass  # 誤りは報告済み
+        elif w_value is not None and not (w_value == 0 and d not in _NO_VALUE):
+            amount = w_value
+        elif d in _NO_VALUE:
+            errors.append(
+                RowError(
+                    line,
+                    header[cm.withdrawal],
+                    raw(cm.withdrawal),
+                    "出金も入金も空です",
+                )
+            )
+        else:
+            assert cm.deposit is not None
+            try:
+                parse_amount(d)
+                is_deposit_only = True
+            except ValueError as e:
+                fail(cm.deposit, e)
+
+    if errors:
+        result.errors.extend(errors)
+    elif is_deposit_only:
+        result.skipped.append(line)
+    else:
+        assert day is not None and amount is not None
+        result.expenses.append(
+            Expense(
+                day=day,
+                category=raw(cm.category) or default_category,
+                amount=amount,
+                memo=raw(cm.memo),
+            )
+        )
