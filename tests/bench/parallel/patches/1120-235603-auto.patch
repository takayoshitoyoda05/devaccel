--- /dev/null
+++ b/tests/test_import_date.py
@@ -0,0 +1,68 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.import_date import parse_date
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param("令和8年1月5日", date(2026, 1, 5), id="E2-1"),
+        pytest.param("2026/1/5 12:34:56", date(2026, 1, 5), id="E2-2"),
+        pytest.param("2025/2/29", None, id="E2-3"),
+    ],
+)
+def test_spec_examples(text, expected):
+    if expected is None:
+        with pytest.raises(ValueError):
+            parse_date(text)
+    else:
+        assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        ("2026.1.5", date(2026, 1, 5)),
+        ("2026年1月5日", date(2026, 1, 5)),
+        ("令和8年1月5日", date(2026, 1, 5)),
+        ("令和元年5月1日", date(2019, 5, 1)),
+        ("R8.1.5", date(2026, 1, 5)),
+        ("H31/4/30", date(2019, 4, 30)),
+        ("2026-01-05 12:34", date(2026, 1, 5)),
+        ("2026-01-05T12:34:56", date(2026, 1, 5)),
+        ("2024/2/29", date(2024, 2, 29)),
+        ("２０２６／１／５", date(2026, 1, 5)),
+        ("  2026/1/5  ", date(2026, 1, 5)),
+    ],
+)
+def test_accepted_forms(text, expected):
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026/1-5",  # R1 区切りの混在
+        "26/1/5",  # R4 2 桁西暦
+        "2026/1",  # R4 月だけ
+        "2026",  # R4 年だけ
+        "2026/13/1",  # R4 月が範囲外
+        "2026/2/30",  # R4 存在しない日
+        "2025/2/29",  # R4 閏年でない
+        "令和0年1月1日",  # R2 令和 0 年
+        "平成32年1月1日",  # R2 平成 32 年以上
+        "2026-01-05 25:00",  # R3 時刻が不正
+        "2026-01-05 12:60",  # R3 分が不正
+        "",  # R5 空文字
+        "   ",  # R5 空白だけ
+    ],
+)
+def test_rejected_forms_raise_value_error_with_repr(text):
+    with pytest.raises(ValueError) as ei:
+        parse_date(text)
+    assert repr(text.strip()) in str(ei.value) or repr(text) in str(ei.value)
+    assert "日付が不正です" in str(ei.value)
diff --git a/tests/test_importer.py b/tests/test_importer.py
new file mode 100644
index 0000000..6e30c35
--- /dev/null
+++ b/tests/test_importer.py
@@ -0,0 +1,109 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.importer import ImportHeaderError, parse_statement
+
+
+def test_card_csv_with_bom_and_aliases():
+    text = '﻿ご利用日,ご利用店名,ご利用金額\n2026/1/5,コンビニ,"1,234円"\n２０２６年１月６日,書店,￥500\n'
+    r = parse_statement(text)
+    assert r.errors == []
+    assert r.expenses == [
+        Expense(date(2026, 1, 5), "未分類", 1234, "コンビニ"),
+        Expense(date(2026, 1, 6), "未分類", 500, "書店"),
+    ]
+
+
+def test_refund_is_kept_negative():
+    r = parse_statement("日付,金額\n2026-01-05,▲300\n")
+    assert [e.amount for e in r.expenses] == [-300]
+
+
+def test_withdrawal_deposit_skips_deposit_only_rows():
+    text = '取引日,摘要,出金額,入金額\n2026/1/5,家賃,"80,000",\n2026/1/25,給与,,"300,000"\n2026/1/26,食費,1000,-\n'
+    r = parse_statement(text)
+    assert [e.amount for e in r.expenses] == [80000, 1000]
+    assert r.skipped == [3]
+    assert r.errors == []
+
+
+def test_withdrawal_deposit_both_empty_is_error():
+    r = parse_statement("日付,出金,入金\n2026/1/5,,\n")
+    assert r.expenses == []
+    assert [(e.line, e.column) for e in r.errors] == [(2, "出金")]
+
+
+def test_tab_delimited():
+    r = parse_statement("日付\t摘要\t金額\n2026-01-05\tカフェ\t450\n")
+    assert r.expenses == [Expense(date(2026, 1, 5), "未分類", 450, "カフェ")]
+
+
+def test_wareki_date():
+    r = parse_statement("日付,金額\n令和8年1月5日,100\n")
+    assert r.expenses[0].day == date(2026, 1, 5)
+
+
+def test_category_column_and_default_category():
+    r = parse_statement(
+        "日付,分類,金額\n2026-01-05,食費,100\n2026-01-06,,200\n",
+        default_category="その他",
+    )
+    assert [e.category for e in r.expenses] == ["食費", "その他"]
+
+
+def test_all_errors_in_a_row_reported_and_other_rows_imported():
+    text = "日付,摘要,金額\n2026/2/30,a,12a3\n2026/1/5,b,100\n"
+    r = parse_statement(text)
+    assert [e.amount for e in r.expenses] == [100]
+    assert [(e.line, e.column, e.value) for e in r.errors] == [
+        (2, "日付", "2026/2/30"),
+        (2, "金額", "12a3"),
+    ]
+    assert all(e.reason for e in r.errors)
+    assert str(r.errors[0]).startswith("2 行目 [日付]")
+
+
+def test_unquoted_thousands_separator_reports_column_count():
+    r = parse_statement("日付,摘要,金額\n2026/1/5,a,1,234円\n")
+    assert r.expenses == []
+    assert len(r.errors) == 1
+    assert (r.errors[0].line, r.errors[0].column) == (2, "(行全体)")
+    assert "列数" in r.errors[0].reason
+
+
+def test_line_number_is_record_start_with_quoted_newline():
+    text = '日付,摘要,金額\n2026/1/5,"a\nb",100\n2026/1/6,c,xx\n'
+    r = parse_statement(text)
+    assert len(r.expenses) == 1
+    assert r.expenses[0].memo == "a\nb"
+    assert [(e.line, e.column) for e in r.errors] == [(4, "金額")]
+
+
+def test_blank_lines_are_ignored():
+    r = parse_statement("日付,金額\n\n2026-01-05,100\n\n")
+    assert len(r.expenses) == 1
+    assert r.errors == []
+
+
+def test_short_row_missing_amount_is_error():
+    r = parse_statement("日付,摘要,金額\n2026-01-05,a\n")
+    assert [(e.line, e.column) for e in r.errors] == [(2, "金額")]
+
+
+@pytest.mark.parametrize("text", ["", "   \n", "日付,金額\n", "﻿日付,金額\r\n"])
+def test_empty_or_header_only_is_empty_result(text):
+    r = parse_statement(text)
+    assert (r.expenses, r.errors, r.skipped) == ([], [], [])
+
+
+def test_missing_required_columns_raises():
+    with pytest.raises(ImportHeaderError, match="必須"):
+        parse_statement("摘要,残高\na,1\n")
+
+
+def test_crlf_line_endings():
+    r = parse_statement("日付,金額\r\n2026-01-05,100\r\n2026-01-06,x\r\n")
+    assert len(r.expenses) == 1
+    assert [e.line for e in r.errors] == [3]
