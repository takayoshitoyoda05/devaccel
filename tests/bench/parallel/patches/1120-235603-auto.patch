@@ -0,0 +1,57 @@
+"""銀行・カード会社の CSV に書かれた金額文字列を円の整数に変換する。"""
+
+import re
+import unicodedata
+
+_INT_RE = re.compile(r"[0-9]+|[0-9]{1,3}(?:,[0-9]{3})+")
+_NEG_SIGNS = ("-", "−", "▲", "△")
+_POS_SIGNS = ("+",)
+
+
+def parse_amount(s: str) -> int:
+    """金額文字列を円の整数にする。負数は返金として負の値を返す。
+
+    受け付ける符号: 先頭の `-` `−` `▲` `△`、末尾の `-`、全体を囲む `(500)`、先頭の `+`。
+    符号は 1 つだけ。記号 `¥` `￥`(先頭)、`円` `JPY`(末尾)、桁区切り `,` `，` は
+    3 桁ごとのみ。小数は小数部が全部 0 の場合だけ受ける。
+    """
+    text = unicodedata.normalize("NFKC", s).strip()
+    signs: list[str] = []
+    if len(text) >= 2 and text[0] == "(" and text[-1] == ")":
+        signs.append("(")
+        text = text[1:-1].strip()
+
+    yen_seen = False
+    while True:
+        if text.startswith("¥") and not yen_seen:
+            yen_seen = True
+            text = text[1:].lstrip()
+        elif text[:1] in _NEG_SIGNS or text[:1] in _POS_SIGNS:
+            signs.append(text[0])
+            text = text[1:].lstrip()
+        else:
+            break
+
+    while True:
+        if text.endswith("円"):
+            text = text[:-1].rstrip()
+        elif text.endswith("JPY"):
+            text = text[:-3].rstrip()
+        elif text.endswith("-"):
+            signs.append("-")
+            text = text[:-1].rstrip()
+        else:
+            break
+
+    int_part, dot, frac = text.partition(".")
+    valid = (
+        len(signs) <= 1
+        and _INT_RE.fullmatch(int_part) is not None
+        and (not dot or (re.fullmatch(r"0+", frac) is not None))
+    )
+    if not valid:
+        raise ValueError(f"金額が整数ではありません: {s!r}")
+
+    value = int(int_part.replace(",", ""))
+    negative = len(signs) == 1 and signs[0] not in _POS_SIGNS
+    return -value if negative else value
