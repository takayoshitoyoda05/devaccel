index 0000000..9f3f106
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,121 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import (
+    QueryError,
+    amount_between,
+    category,
+    date_between,
+    filter_expenses,
+    match_all,
+    memo_contains,
+    parse_query,
+    search,
+)
+
+ROWS = [
+    Expense(date(2026, 10, 25), "rent", 80000, ""),
+    Expense(date(2026, 10, 31), "food", 500, "Coffee beans"),
+    Expense(date(2026, 11, 1), "food", 1200, "lunch"),
+    Expense(date(2026, 11, 2), "rent", 80000, ""),
+    Expense(date(2026, 11, 3), "food", 800, "coffee"),
+    Expense(date(2026, 11, 15), "hobby", 3000, "book store"),
+]
+
+
+def memos(rows):
+    return [(e.day.day, e.category, e.amount) for e in rows]
+
+
+def test_combinators():
+    q = (category("food") & amount_between(1000, None)) | memo_contains("book")
+    assert memos(filter_expenses(ROWS, q)) == [(1, "food", 1200), (15, "hobby", 3000)]
+    assert len(filter_expenses(ROWS, ~category("food"))) == 3
+    assert filter_expenses(ROWS, match_all()) == ROWS
+
+
+def test_amount_and_date_ranges_are_inclusive():
+    assert len(filter_expenses(ROWS, amount_between(800, 1200))) == 2
+    q = date_between(date(2026, 10, 31), date(2026, 11, 2))
+    assert len(filter_expenses(ROWS, q)) == 3
+
+
+def test_memo_case():
+    assert len(filter_expenses(ROWS, memo_contains("COFFEE"))) == 2
+    assert len(filter_expenses(ROWS, memo_contains("Coffee", case_sensitive=True))) == 1
+
+
+def test_bad_ranges_rejected():
+    with pytest.raises(ValueError):
+        amount_between(10, 1)
+    with pytest.raises(ValueError):
+        date_between(date(2026, 2, 1), date(2026, 1, 1))
+    with pytest.raises(ValueError):
+        category()
+
+
+@pytest.mark.parametrize(
+    ("text", "expected_days"),
+    [
+        ("", [25, 31, 1, 2, 3, 15]),
+        ("category:food", [31, 1, 3]),
+        ("cat:food,hobby", [31, 1, 3, 15]),
+        ("amount:800", [3]),
+        ("amount:1,000..5000", [1, 15]),
+        ("amount:..800", [31, 3]),
+        ("amount:3000..", [25, 2, 15]),
+        ("memo:coffee", [31, 3]),
+        ('memo:"book store"', [15]),
+        ("date:2026-11", [1, 2, 3, 15]),
+        ("date:2026-10-31", [31]),
+        ("date:2026-10-31..2026-11-02", [31, 1, 2]),
+        ("date:..2026-10", [25, 31]),
+        ("date:2026-11-03..", [3, 15]),
+        # implicit AND, explicit AND, OR, NOT, precedence, parentheses
+        ("cat:food date:2026-11", [1, 3]),
+        ("cat:food AND date:2026-11", [1, 3]),
+        ("cat:hobby or memo:lunch", [1, 15]),
+        ("not cat:rent", [31, 1, 3, 15]),
+        ("cat:food and amount:..800 or cat:hobby", [31, 3, 15]),
+        ("cat:food and (amount:..800 or memo:lunch) and date:2026-11", [1, 3]),
+        ("not (cat:food or cat:rent)", [15]),
+        ("NOT not cat:hobby", [15]),
+    ],
+)
+def test_parse_query(text, expected_days):
+    assert [e.day.day for e in search(ROWS, text)] == expected_days
+
+
+@pytest.mark.parametrize(
+    ("text", "pos"),
+    [
+        ("food", 0),
+        ("price:100", 0),
+        ("cat:food and", 12),
+        ("cat:food or or cat:rent", 12),
+        ("(cat:food", 9),
+        ("cat:food)", 8),
+        ("amount:abc", 7),
+        ("amount:..", 7),
+        ("amount:5000..10", 7),
+        ("date:2026-13", 5),
+        ("date:2026/11", 5),
+        ("date:2026-11-30..2026-11-01", 5),
+        ("memo:", 5),
+        ('memo:"open', 5),
+        ("and cat:food", 0),
+    ],
+)
+def test_parse_query_errors_have_position(text, pos):
+    with pytest.raises(QueryError) as ei:
+        parse_query(text)
+    assert ei.value.pos == pos
+
+
+def test_query_description():
+    q = parse_query("cat:food and not memo:x or amount:1..2")
+    assert str(q) == (
+        "((category in ['food'] AND NOT memo contains 'x' (i)) OR amount 1..2)"
+    )
