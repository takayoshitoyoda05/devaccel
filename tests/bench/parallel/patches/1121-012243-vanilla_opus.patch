+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import find_recurring, normalize_memo
+
+
+def E(y, m, d, cat, amount, memo=""):
+    return Expense(date(y, m, d), cat, amount, memo)
+
+
+def test_detects_subscription_and_predicts_next():
+    rows = [
+        E(2026, 8, 15, "subsc", 1490, "NETFLIX.COM"),
+        E(2026, 9, 15, "subsc", 1490, "NETFLIX.COM"),
+        E(2026, 10, 15, "subsc", 1490, "netflix.com"),
+        E(2026, 10, 3, "food", 800, "coffee"),
+        E(2026, 10, 9, "food", 1200, "lunch"),
+    ]
+    [r] = find_recurring(rows)
+    assert r.category == "subsc"
+    assert r.memo == "netflix.com"
+    assert r.amount == 1490
+    assert r.occurrences == 3
+    assert (r.first, r.last) == (date(2026, 8, 15), date(2026, 10, 15))
+    assert r.day_of_month == 15
+    assert r.next_date == date(2026, 11, 15)
+
+
+def test_rent_with_empty_memo_and_year_boundary():
+    rows = [E(2026, m, 27, "rent", 80000) for m in (10, 11, 12)]
+    [r] = find_recurring(rows)
+    assert r.next_date == date(2027, 1, 27)
+
+
+def test_digits_in_memo_are_ignored_for_grouping():
+    assert normalize_memo("Spotify  2026/10 ") == normalize_memo("SPOTIFY 2026/11")
+    rows = [
+        E(2026, 9, 1, "subsc", 980, "Spotify 0901"),
+        E(2026, 10, 1, "subsc", 980, "Spotify 1001"),
+        E(2026, 11, 1, "subsc", 980, "Spotify 1101"),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_month_end_payments_predict_month_end():
+    rows = [
+        E(2026, 11, 30, "rent", 80000),
+        E(2026, 12, 31, "rent", 80000),
+        E(2027, 1, 31, "rent", 80000),
+    ]
+    [r] = find_recurring(rows)
+    assert r.day_of_month == 31
+    assert r.next_date == date(2027, 2, 28)
+
+
+def test_day_drift_is_tolerated_and_median_day_used():
+    rows = [
+        E(2026, 8, 27, "utility", 3000, "water"),
+        E(2026, 9, 29, "utility", 3000, "water"),  # weekend shift
+        E(2026, 10, 27, "utility", 3000, "water"),
+    ]
+    [r] = find_recurring(rows)
+    assert r.day_of_month == 27
+    assert r.next_date == date(2026, 11, 27)
+
+
+def test_payment_slipped_into_next_month_predicts_same_month():
+    rows = [
+        E(2026, 7, 31, "rent", 80000),
+        E(2026, 8, 31, "rent", 80000),
+        E(2026, 10, 1, "rent", 80000),  # September's payment, slipped
+    ]
+    [r] = find_recurring(rows)
+    assert r.day_of_month == 31
+    assert r.next_date == date(2026, 10, 31)
+
+
+def test_too_few_occurrences():
+    rows = [E(2026, 9, 1, "subsc", 980, "x"), E(2026, 10, 1, "subsc", 980, "x")]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_occurrences=2)) == 1
+
+
+def test_irregular_intervals_are_not_recurring():
+    rows = [
+        E(2026, 9, 1, "food", 800, "coffee"),
+        E(2026, 9, 8, "food", 800, "coffee"),
+        E(2026, 10, 20, "food", 800, "coffee"),
+        E(2026, 11, 2, "food", 800, "coffee"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_only_trailing_monthly_run_counts():
+    rows = [
+        E(2026, 1, 10, "subsc", 500, "app"),  # old, then a gap
+        E(2026, 6, 10, "subsc", 500, "app"),
+        E(2026, 7, 10, "subsc", 500, "app"),
+        E(2026, 8, 10, "subsc", 500, "app"),
+    ]
+    [r] = find_recurring(rows)
+    assert r.occurrences == 3
+    assert r.first == date(2026, 6, 10)
+
+
+def test_unstable_amounts_rejected_but_small_changes_ok():
+    unstable = [
+        E(2026, m, 5, "card", a, "shop") for m, a in ((8, 1000), (9, 5000), (10, 1200))
+    ]
+    assert find_recurring(unstable) == []
+    price_up = [
+        E(2026, m, 5, "subsc", a, "video")
+        for m, a in ((8, 1000), (9, 1000), (10, 1080))
+    ]
+    [r] = find_recurring(price_up)
+    assert (r.amount, r.min_amount, r.max_amount) == (1080, 1000, 1080)
+    assert find_recurring(price_up, amount_tolerance=0.0) == []
+
+
+def test_as_of_drops_cancelled_subscriptions():
+    rows = [E(2026, m, 10, "subsc", 500, "app") for m in (5, 6, 7)]
+    assert len(find_recurring(rows, as_of=date(2026, 8, 1))) == 1
+    assert len(find_recurring(rows, as_of=date(2026, 8, 15))) == 1  # within drift
+    assert find_recurring(rows, as_of=date(2026, 11, 21)) == []
+
+
+def test_sorted_by_next_date():
+    rows = [E(2026, m, 25, "rent", 80000) for m in (8, 9, 10)] + [
+        E(2026, m, 3, "subsc", 980, "music") for m in (8, 9, 10)
+    ]
+    assert [r.category for r in find_recurring(rows)] == ["subsc", "rent"]
+
+
+def test_empty_and_bad_params():
+    assert find_recurring([]) == []
+    with pytest.raises(ValueError):
+        find_recurring([], min_occurrences=1)
+    with pytest.raises(ValueError):
+        find_recurring([], amount_tolerance=-0.1)
