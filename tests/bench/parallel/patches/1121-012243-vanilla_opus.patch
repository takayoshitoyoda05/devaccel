@@ -0,0 +1,197 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.importer import (
+    StatementError,
+    decode_statement,
+    import_statement,
+    parse_amount,
+    parse_date,
+)
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("1234", 1234),
+        ("1,234", 1234),
+        ("¥1,234", 1234),
+        ("￥1,234", 1234),
+        ("1,234円", 1234),
+        ("１，２３４", 1234),
+        (" 1234 ", 1234),
+        ("-1,234", -1234),
+        ("(1,234)", -1234),
+        ("△1,234", -1234),
+        ("▲1,234", -1234),
+        ("1234.00", 1234),
+        ("+500", 500),
+        ("0", 0),
+    ],
+)
+def test_parse_amount(text, expected):
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    ("text", "reason"),
+    [("", "空"), ("abc", "読めません"), ("12.5", "端数"), ("1,2a3", "読めません")],
+)
+def test_parse_amount_errors(text, reason):
+    with pytest.raises(ValueError, match=reason):
+        parse_amount(text)
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026-11-01",
+        "2026/11/01",
+        "2026/11/1",
+        "2026.11.01",
+        "20261101",
+        "2026年11月1日",
+        "２０２６/１１/０１",
+    ],
+)
+def test_parse_date(text):
+    assert parse_date(text) == date(2026, 11, 1)
+
+
+@pytest.mark.parametrize(
+    ("text", "reason"),
+    [
+        ("", "空"),
+        ("11/01", "読めません"),
+        ("2026/02/30", "存在しない"),
+        ("26/11/01", "読めません"),
+    ],
+)
+def test_parse_date_errors(text, reason):
+    with pytest.raises(ValueError, match=reason):
+        parse_date(text)
+
+
+def test_card_statement_japanese_headers():
+    text = (
+        "利用日,利用店名・商品名,利用者,利用金額,支払総額\n"
+        '2026/11/01,ＡＭＡＺＯＮ,本人,"1,980","1,980"\n'
+        "2026/11/03,コンビニ,本人,¥540,540\n"
+    )
+    res = import_statement(text, default_category="card")
+    assert res.errors == [] and res.skipped == []
+    assert res.expenses == [
+        Expense(date(2026, 11, 1), "card", 1980, "ＡＭＡＺＯＮ"),
+        Expense(date(2026, 11, 3), "card", 540, "コンビニ"),
+    ]
+
+
+def test_bank_statement_with_preamble_and_split_columns():
+    text = (
+        "口座番号,1234567\n"
+        "期間,2026/11/01～2026/11/30\n"
+        "\n"
+        "取引日,摘要,出金,入金,残高\n"
+        "2026/11/01,ﾔﾁﾝ,80000,,120000\n"
+        "2026/11/10,ｷﾕｳﾖ,,250000,370000\n"
+        '2026/11/12,ATM,"10,000",,360000\n'
+    )
+    res = import_statement(text)
+    assert [(e.day.day, e.amount, e.memo, e.category) for e in res.expenses] == [
+        (1, 80000, "ﾔﾁﾝ", "未分類"),
+        (12, 10000, "ATM", "未分類"),
+    ]
+    assert res.errors == []
+    [skip] = res.skipped
+    assert skip.line == 6
+    assert "入金" in skip.reason
+
+
+def test_bad_rows_report_line_column_value_and_reason():
+    text = (
+        "日付,内容,金額\n"
+        "2026-11-01,ok,100\n"
+        "2026-13-01,bad date,100\n"
+        "2026-11-03,bad amount,12.5\n"
+        "nope,both bad,xyz\n"
+        "2026-11-05,short\n"
+        "\n"
+        "2026-11-06,ok2,200\n"
+    )
+    res = import_statement(text)
+    assert [e.memo for e in res.expenses] == ["ok", "ok2"]
+    got = [(e.line, e.column, e.value) for e in res.errors]
+    assert got == [
+        (3, "日付", "2026-13-01"),
+        (4, "金額", "12.5"),
+        (5, "日付", "nope"),
+        (5, "金額", "xyz"),
+        (6, None, None),
+    ]
+    assert str(res.errors[1]) == "4行目 列「金額」: 円未満の端数があります: '12.5'"
+    assert "列が足りません" in str(res.errors[4])
+
+
+def test_line_numbers_account_for_multiline_quoted_cells():
+    text = 'date,memo,amount\n2026-11-01,"two\nlines",100\n2026-11-02,x,bad\n'
+    res = import_statement(text)
+    assert len(res.expenses) == 1
+    assert res.errors[0].line == 4
+
+
+def test_category_column_and_default():
+    text = "date,amount,category,memo\n2026-11-01,100,food,a\n2026-11-02,200,,b\n"
+    res = import_statement(text, default_category="misc")
+    assert [e.category for e in res.expenses] == ["food", "misc"]
+
+
+def test_explicit_column_mapping():
+    text = "決済日,決済額,加盟店\n2026-11-01,500,shop\n"
+    with pytest.raises(StatementError):
+        import_statement(text)
+    res = import_statement(
+        text, columns={"date": "決済日", "amount": "決済額", "memo": "加盟店"}
+    )
+    assert res.expenses == [Expense(date(2026, 11, 1), "未分類", 500, "shop")]
+
+
+def test_explicit_column_mapping_missing_column():
+    with pytest.raises(StatementError, match="指定された列"):
+        import_statement("a,b\n1,2\n", columns={"date": "日", "amount": "額"})
+
+
+def test_negative_expense_sign():
+    text = "Date,Amount,Description\n2026-11-01,-1500,shop\n2026-11-02,3000,salary\n"
+    res = import_statement(text, expense_sign="negative")
+    assert res.expenses == [Expense(date(2026, 11, 1), "未分類", 1500, "shop")]
+    assert [s.line for s in res.skipped] == [3]
+
+
+def test_refund_is_negative_expense_by_default():
+    res = import_statement("date,amount\n2026-11-01,-500\n")
+    assert res.expenses[0].amount == -500
+
+
+def test_split_columns_both_empty_is_error():
+    res = import_statement("日付,出金,入金\n2026-11-01,,\n2026-11-02,x,\n")
+    assert [(e.line, e.column) for e in res.errors] == [(2, "出金"), (3, "出金")]
+
+
+def test_no_header():
+    with pytest.raises(StatementError, match="ヘッダ"):
+        import_statement("foo,bar\n1,2\n")
+    with pytest.raises(StatementError):
+        import_statement("")
+
+
+def test_decode_statement():
+    text = "日付,金額\n2026/11/01,100\n"
+    assert decode_statement(text.encode("cp932")) == text
+    assert decode_statement(text.encode("utf-8-sig")) == text
+    assert decode_statement(text.encode("utf-8")) == text
+    res = import_statement(decode_statement(text.encode("utf-8-sig")))
+    assert res.expenses[0].amount == 100
+    with pytest.raises(StatementError):
+        decode_statement(b"\x81\x20")  # invalid in both UTF-8 and cp932
