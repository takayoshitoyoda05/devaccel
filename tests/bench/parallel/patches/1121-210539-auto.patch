--- /dev/null
+++ b/tests/test_budget_alerts.py
@@ -0,0 +1,76 @@
+import json
+
+import pytest
+
+from kakeibo import main
+from kakeibo.core import Budget, find_budget_alerts
+
+HEADER = "date,category,amount,memo\n"
+
+
+def _run(tmp_path, monkeypatch, capsys, body, budget):
+    c = tmp_path / "in.csv"
+    c.write_text(HEADER + body, encoding="utf-8")
+    b = tmp_path / "b.json"
+    b.write_text(json.dumps(budget), encoding="utf-8")
+    monkeypatch.setattr("sys.argv", ["kakeibo", str(c), "--budget", str(b)])
+    main()
+    return capsys.readouterr().err
+
+
+@pytest.mark.parametrize(
+    ("actual", "kind"),
+    [(899, None), (900, "near"), (999, "near"), (1000, "near"), (1001, "over")],
+)
+def test_alert_thresholds(actual, kind):
+    got = find_budget_alerts({"2026-11": {"food": actual}}, Budget({"food": 1000}, {}))
+    expected = [] if kind is None else [(kind, "2026-11", "food", 1000, actual)]
+    assert got == expected
+
+
+def test_zero_limit():
+    b = Budget({"food": 0}, {})
+    assert find_budget_alerts({"2026-11": {"food": 0}}, b) == []
+    assert find_budget_alerts({"2026-11": {"food": 5}}, b) == [
+        ("over", "2026-11", "food", 0, 5)
+    ]
+
+
+def test_cli_near_message(tmp_path, monkeypatch, capsys):
+    err = _run(
+        tmp_path,
+        monkeypatch,
+        capsys,
+        "2026-11-01,food,950,\n",
+        {"default": {"food": 1000}},
+    )
+    assert err == "注意: 2026-11 food 残り 50円 (予算 1,000 / 実績 950 / 95%)\n"
+
+
+def test_cli_percent_floored(tmp_path, monkeypatch, capsys):
+    err = _run(
+        tmp_path,
+        monkeypatch,
+        capsys,
+        "2026-11-01,food,1999,\n",
+        {"default": {"food": 1500}},
+    )
+    assert err == "警告: 2026-11 food 499円超過 (予算 1,500 / 実績 1,999 / 133%)\n"
+
+
+def test_cli_zero_limit_has_no_percent(tmp_path, monkeypatch, capsys):
+    err = _run(
+        tmp_path, monkeypatch, capsys, "2026-11-01,food,5,\n", {"default": {"food": 0}}
+    )
+    assert err == "警告: 2026-11 food 5円超過 (予算 0 / 実績 5)\n"
+
+
+def test_cli_order_follows_totals(tmp_path, monkeypatch, capsys):
+    body = "2026-11-01,rent,95000,\n2026-11-02,food,2000,\n"
+    err = _run(
+        tmp_path, monkeypatch, capsys, body, {"default": {"rent": 100000, "food": 1000}}
+    )
+    assert err.splitlines() == [
+        "注意: 2026-11 rent 残り 5,000円 (予算 100,000 / 実績 95,000 / 95%)",
+        "警告: 2026-11 food 1,000円超過 (予算 1,000 / 実績 2,000 / 200%)",
+    ]
