+"""import_expenses: 銀行・カード会社 CSV の取り込み(仕様の表 E1)。"""
+
+from __future__ import annotations
+
+import re
+from datetime import date
+
+import pytest
+
+from kakeibo.core import CsvError, Expense
+from kakeibo.import_rows import import_expenses
+
+
+def _parse_date(s: str) -> date:
+    m = re.fullmatch(r"(\d{4})[-/](\d{1,2})[-/](\d{1,2})", s)
+    if m is None:
+        raise ValueError(f"日付が不正です: {s!r}")
+    return date(int(m[1]), int(m[2]), int(m[3]))
+
+
+def test_E1_1_別名の列を使い_カテゴリ列が無ければ未分類() -> None:
+    # E1-1: R1 D4
+    text = "利用日,ご利用店名,利用金額\n2026/1/5,カフェ,500"
+    assert import_expenses(text, _parse_date, int) == [
+        Expense(date(2026, 1, 5), "未分類", 500, "カフェ")
+    ]
+
+
+def test_E1_2_入金のみの行は飛ばす() -> None:
+    # E1-2: D5
+    text = "日付,出金額,入金額\n2026-01-05,,1000\n2026-01-06,300,"
+    assert import_expenses(text, _parse_date, int) == [
+        Expense(date(2026, 1, 6), "未分類", 300, "")
+    ]
+
+
+def test_E1_3_誤りは行と列を全件報告する() -> None:
+    # E1-3: D1
+    text = "日付,金額\nx,abc\n2026-01-05,"
+    with pytest.raises(CsvError) as info:
+        import_expenses(text, _parse_date, int)
+    errors = info.value.errors
+    assert [line for line, _ in errors] == [2, 2, 3]
+    assert errors[0][1].startswith("日付 'x': ")
+    assert errors[1][1].startswith("金額 'abc': ")
+    assert errors[2] == (3, "金額 '': 空です")
+
+
+def test_text_が_str_でなければ_TypeError() -> None:
+    with pytest.raises(TypeError):
+        import_expenses(b"date,amount", _parse_date, int)  # type: ignore[arg-type]
+
+
+def test_解析関数が呼び出せなければ_TypeError() -> None:
+    with pytest.raises(TypeError):
+        import_expenses("日付,金額", None, int)  # type: ignore[arg-type]
