+"""銀行・カード CSV の日付文字列を date に解釈する(純粋関数・標準ライブラリのみ)。"""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from datetime import date
+
+# 和暦の元年 = 1 年。西暦 = 和暦年 + オフセット。
+_ERA_OFFSET = {"令和": 2018, "平成": 1988, "昭和": 1925}
+_ERA_LETTER = {"R": "令和", "H": "平成", "S": "昭和"}
+
+_TIME_SUFFIX = re.compile(r"[ T][0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?$")
+_WESTERN = re.compile(r"([0-9]{4})([-/.])([0-9]{1,2})\2([0-9]{1,2})")
+_COMPACT = re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})")
+_KANJI_WESTERN = re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日")
+_WAREKI_KANJI = re.compile(
+    r"(令和|平成|昭和)(元|[0-9]{1,2})年([0-9]{1,2})月([0-9]{1,2})日"
+)
+_WAREKI_LETTER = re.compile(r"([RHS])(元|[0-9]{1,2})([-/.])([0-9]{1,2})\3([0-9]{1,2})")
+
+
+def _year_of(era: str, year_text: str) -> int:
+    n = 1 if year_text == "元" else int(year_text)
+    return _ERA_OFFSET[era] + n
+
+
+def _split(s: str) -> tuple[int, int, int] | None:
+    """正規化済みの日付部分を (年, 月, 日) にする。どれにも合わなければ None。"""
+    m = _WESTERN.fullmatch(s)
+    if m:
+        return int(m[1]), int(m[3]), int(m[4])
+    m = _COMPACT.fullmatch(s)
+    if m:
+        return int(m[1]), int(m[2]), int(m[3])
+    m = _KANJI_WESTERN.fullmatch(s)
+    if m:
+        return int(m[1]), int(m[2]), int(m[3])
+    m = _WAREKI_KANJI.fullmatch(s)
+    if m:
+        return _year_of(m[1], m[2]), int(m[3]), int(m[4])
+    m = _WAREKI_LETTER.fullmatch(s)
+    if m:
+        return _year_of(_ERA_LETTER[m[1]], m[2]), int(m[4]), int(m[5])
+    return None
+
+
+def parse_date(s: str) -> date:
+    """日付文字列を date にする。時刻部分は捨てる。解釈できなければ ValueError。"""
+    if not isinstance(s, str):
+        raise TypeError(f"str が必要です: {type(s).__name__}")
+    original = s
+    text = unicodedata.normalize("NFKC", s.strip()).strip()
+    text = _TIME_SUFFIX.sub("", text)
+    parts = _split(text)
+    if parts is None:
+        raise ValueError(f"日付として解釈できません: {original!r}")
+    try:
+        return date(*parts)
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {original!r}") from None
diff --git a/src/kakeibo/import_rows.py b/src/kakeibo/import_rows.py
new file mode 100644
index 0000000..aa50dfb
--- /dev/null
+++ b/src/kakeibo/import_rows.py
@@ -0,0 +1,192 @@
+"""Import bank/card CSV text into Expense records (pure function, no I/O)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from collections.abc import Callable
+from datetime import date
+from typing import NamedTuple
+
+from kakeibo.core import CsvError, Expense
+
+
+def _norm(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip().casefold()
+
+
+def _aliases(*names: str) -> frozenset[str]:
+    return frozenset(_norm(n) for n in names)
+
+
+_DATE = _aliases("日付", "利用日", "取引日", "ご利用日", "date")
+_AMOUNT = _aliases("金額", "利用金額", "ご利用金額", "amount")
+_WITHDRAW = _aliases("出金額", "出金", "支払金額", "お支払金額")
+_DEPOSIT = _aliases("入金額", "入金", "預入金額", "お預り金額")
+_MEMO = _aliases(
+    "摘要", "メモ", "利用店名", "ご利用店名", "内容", "description", "memo"
+)
+_CATEGORY = _aliases("カテゴリ", "カテゴリー", "category")
+
+
+class _Cols(NamedTuple):
+    date: int | None
+    amount: int | None
+    withdraw: int | None
+    deposit: int | None
+    memo: int | None
+    category: int | None
+
+
+def _delimiter(text: str) -> str:
+    header_line = re.split(r"\r\n|\r|\n", text, maxsplit=1)[0]
+    return "\t" if "\t" in header_line and "," not in header_line else ","
+
+
+def _records(text: str, delimiter: str) -> list[tuple[int, list[str]]]:
+    """(開始行, セル列) の並び。開始行は引用内改行があっても先頭の物理行。"""
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delimiter)
+    out: list[tuple[int, list[str]]] = []
+    prev = 0
+    for row in reader:
+        out.append((prev + 1, row))
+        prev = reader.line_num
+    return out
+
+
+def _find_columns(header: list[str]) -> tuple[_Cols, list[tuple[int, str]]]:
+    names = [_norm(h) for h in header]
+
+    def find(aliases: frozenset[str]) -> int | None:
+        return next((i for i, n in enumerate(names) if n in aliases), None)
+
+    cols = _Cols(
+        find(_DATE),
+        find(_AMOUNT),
+        find(_WITHDRAW),
+        find(_DEPOSIT),
+        find(_MEMO),
+        find(_CATEGORY),
+    )
+    errors: list[tuple[int, str]] = []
+    if cols.date is None:
+        errors.append((1, "必須列 日付 がありません"))
+    if cols.amount is None and cols.withdraw is None and cols.deposit is None:
+        errors.append((1, "必須列 金額 がありません"))
+    return cols, errors
+
+
+def _cell(row: list[str], i: int | None) -> str:
+    return "" if i is None else row[i]
+
+
+def _convert[T](
+    ln: int,
+    i: int | None,
+    row: list[str],
+    header: list[str],
+    fn: Callable[[str], T],
+    errors: list[tuple[int, str]],
+) -> T | None:
+    assert i is not None
+    raw = row[i]
+    try:
+        return fn(raw.strip())
+    except ValueError as e:
+        errors.append((ln, f"{header[i].strip()} '{raw}': {e}"))
+        return None
+
+
+def _row_to_expense(
+    ln: int,
+    row: list[str],
+    header: list[str],
+    cols: _Cols,
+    parse_date: Callable[[str], date],
+    parse_amount: Callable[[str], int],
+    errors: list[tuple[int, str]],
+) -> Expense | None:
+    n_before = len(errors)
+    day = _convert(ln, cols.date, row, header, parse_date, errors)
+
+    amount: int | None = None
+    skip = False
+    if cols.amount is not None:
+        if row[cols.amount].strip() == "":
+            errors.append(
+                (ln, f"{header[cols.amount].strip()} '{row[cols.amount]}': 空です")
+            )
+        else:
+            amount = _convert(ln, cols.amount, row, header, parse_amount, errors)
+    else:
+        w = _cell(row, cols.withdraw).strip()
+        d = _cell(row, cols.deposit).strip()
+        ref = cols.withdraw if cols.withdraw is not None else cols.deposit
+        assert ref is not None
+        ref_name = header[ref].strip()
+        if w and d:
+            errors.append(
+                (ln, f"{ref_name} '{row[ref]}': 出金と入金の両方に値があります")
+            )
+        elif not w and not d:
+            errors.append((ln, f"{ref_name} '{row[ref]}': 出金と入金の両方が空です"))
+        elif d:
+            skip = True  # 入金のみ: 返金扱いでスキップ
+        else:
+            amount = _convert(ln, cols.withdraw, row, header, parse_amount, errors)
+
+    if skip or len(errors) > n_before:
+        return None
+    assert day is not None and amount is not None
+    category = (
+        _cell(row, cols.category).strip() if cols.category is not None else "未分類"
+    )
+    memo = _cell(row, cols.memo).strip()
+    return Expense(day, category, amount, memo)
+
+
+def import_expenses(
+    text: str,
+    parse_date: Callable[[str], date],
+    parse_amount: Callable[[str], int],
+) -> list[Expense]:
+    """銀行・カード会社の CSV 文字列を Expense の並び(入力の行順)にする。
+
+    誤りは全行を検査して 1 回の CsvError にまとめる。
+    """
+    if not isinstance(text, str):
+        raise TypeError("text は str である必要があります")
+    if not callable(parse_date) or not callable(parse_amount):
+        raise TypeError("parse_date と parse_amount は呼び出し可能である必要があります")
+
+    text = text.removeprefix("﻿")
+    delimiter = _delimiter(text)
+    records = [
+        (ln, row)
+        for ln, row in _records(text, delimiter)
+        if any(c.strip() for c in row)
+    ]
+    header = records[0][1] if records else []
+    cols, errors = _find_columns(header)
+    if errors:
+        raise CsvError(errors)
+
+    width = len(header)
+    out: list[Expense] = []
+    for ln, row in records[1:]:
+        if len(row) != width:
+            joined = delimiter.join(row)
+            errors.append(
+                (ln, f"行 '{joined}': 列数が {width} ではなく {len(row)} です")
+            )
+            continue
+        expense = _row_to_expense(
+            ln, row, header, cols, parse_date, parse_amount, errors
+        )
+        if expense is not None:
+            out.append(expense)
+    if errors:
+        raise CsvError(errors)
+    return out
diff --git a/tests/test_import_amount.py b/tests/test_import_amount.py
new file mode 100644
index 0000000..78bd3c9
--- /dev/null
+++ b/tests/test_import_amount.py
@@ -0,0 +1,31 @@
+import pytest
+
+from kakeibo.import_amount import parse_amount
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param("△１，２３４円", -1234, id="E2-1"),
+        pytest.param("¥(500)", -500, id="E2-2"),
+    ],
+)
+def test_parse_amount_examples(text, expected):
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        pytest.param("12.5", id="E2-3"),
+    ],
+)
+def test_parse_amount_rejects_decimal(text):
+    with pytest.raises(ValueError, match=r"12\.5"):
+        parse_amount(text)
+
+
+@pytest.mark.parametrize("value", [None, 500, 5.0, True])
+def test_parse_amount_rejects_non_str(value):
+    with pytest.raises(TypeError):
+        parse_amount(value)
