+"""銀行・カード会社の金額文字列を円の整数に解釈する。"""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+
+_CURRENCIES = ("¥", "円", "JPY")
+_NEGATIVE_MARKS = ("-", "−", "△", "▲")
+_POSITIVE_MARKS = ("+",)
+_DIGITS = re.compile(r"[0-9]+")
+
+
+def _strip_token(text: str, token: str) -> tuple[str, bool]:
+    """先頭または末尾の token を 1 つ取り除く。取り除いたかどうかも返す。"""
+    if text[: len(token)].upper() == token.upper():
+        return text[len(token) :].lstrip(), True
+    if text[len(text) - len(token) :].upper() == token.upper() and len(text) > len(
+        token
+    ):
+        return text[: len(text) - len(token)].rstrip(), True
+    return text, False
+
+
+def parse_amount(s: str) -> int:
+    """金額文字列を整数にする。負の書き方は負の整数になる(返金)。
+
+    受け付ける書き方: 前後の空白・全角記号、通貨記号 ¥ ￥ 円 JPY(前後どちら),
+    桁区切り , ，、負の印 - − △ ▲(先頭)・-(末尾)・括弧 (500)。
+    符号は 1 つだけ。小数・数字のない文字列・空欄は ValueError。
+    """
+    if not isinstance(s, str):
+        raise TypeError(f"金額は str で渡してください: {type(s).__name__}")
+
+    text = unicodedata.normalize("NFKC", s.strip()).strip()
+    signs: list[str] = []
+
+    changed = True
+    while changed:
+        changed = False
+        for cur in _CURRENCIES:
+            text, removed = _strip_token(text, cur)
+            if removed:
+                changed = True
+        for mark in _NEGATIVE_MARKS:
+            if text.startswith(mark):
+                signs.append("-")
+                text = text[len(mark) :].lstrip()
+                changed = True
+                break
+        for mark in _POSITIVE_MARKS:
+            if text.startswith(mark):
+                signs.append("+")
+                text = text[len(mark) :].lstrip()
+                changed = True
+                break
+        if text.endswith("-") and len(text) > 1:
+            signs.append("-")
+            text = text[:-1].rstrip()
+            changed = True
+        if text.startswith("(") and text.endswith(")"):
+            signs.append("-")
+            text = text[1:-1].strip()
+            changed = True
+
+    if len(signs) > 1:
+        raise ValueError(f"符号が重なっています: {s!r}")
+
+    body = text.replace(",", "")
+    if not _DIGITS.fullmatch(body):
+        raise ValueError(f"金額として解釈できません: {s!r}")
+
+    value = int(body)
+    if signs and signs[0] == "-":
+        return -value
+    return value
