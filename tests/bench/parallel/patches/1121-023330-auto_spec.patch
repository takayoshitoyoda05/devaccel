+from datetime import date, datetime
+
+import pytest
+
+from kakeibo.import_date import parse_date
+
+
+# 仕様の例の表(E3-1 〜 E3-3)を全行写す
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param("令和8年1月5日", date(2026, 1, 5), id="E3-1"),
+        pytest.param("２０２６/１/５ 10:30", date(2026, 1, 5), id="E3-2"),
+        pytest.param("2026-02-30", ValueError, id="E3-3"),
+    ],
+)
+def test_spec_examples(text, expected):
+    if expected is ValueError:
+        with pytest.raises(ValueError):
+            parse_date(text)
+    else:
+        assert parse_date(text) == expected
+
+
+# R2: 受け付ける書き方
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026.1.5",
+        "20260105",
+        "2026年1月5日",
+        "令和8年1月5日",
+        "R8.1.5",
+    ],
+)
+def test_r2_accepted_forms(text):
+    assert parse_date(text) == date(2026, 1, 5)
+
+
+def test_r2_heisei_and_showa_and_letters():
+    assert parse_date("平成31年4月30日") == date(2019, 4, 30)
+    assert parse_date("昭和64年1月7日") == date(1989, 1, 7)
+    assert parse_date("H31.4.30") == date(2019, 4, 30)
+    assert parse_date("S64.1.7") == date(1989, 1, 7)
+
+
+def test_r2_gannen_is_year_one():
+    assert parse_date("令和元年5月1日") == date(2019, 5, 1)
+    assert parse_date("R1.5.1") == date(2019, 5, 1)
+
+
+@pytest.mark.parametrize("text", ["2026-1/5", "2026/01-05"])
+def test_r2_mixed_separators_rejected(text):
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+# R3: 時刻は捨てる
+@pytest.mark.parametrize(
+    "text",
+    ["2026-01-05 10:30", "2026-01-05T10:30:00", "2026/1/5 10:30"],
+)
+def test_r3_time_is_dropped(text):
+    assert parse_date(text) == date(2026, 1, 5)
+
+
+# R1: 前後の空白を除き NFKC 正規化してから解釈する
+def test_r1_strips_and_normalizes():
+    assert parse_date("  ２０２６－０１－０５　 ") == date(2026, 1, 5)
+
+
+# R4: 存在しない日付・空欄・解釈できない文字列は ValueError(元の値を含む)
+@pytest.mark.parametrize("text", ["2026-02-30", "2025-02-29", "", "   ", "abc"])
+def test_r4_invalid_raises_value_error_with_original(text):
+    with pytest.raises(ValueError) as ei:
+        parse_date(text)
+    assert repr(text) in str(ei.value) or text in str(ei.value)
+
+
+def test_r4_leap_day_accepted():
+    assert parse_date("2024-02-29") == date(2024, 2, 29)
+
+
+# R5: str 以外は TypeError
+@pytest.mark.parametrize("value", [None, datetime(2026, 1, 5), 20260105])
+def test_r5_non_str_raises_type_error(value):
+    with pytest.raises(TypeError):
+        parse_date(value)
