+def test_break_in_chain_splits_into_separate_series() -> None:
+    rows = [
+        _e(date(2026, 1, 15)),
+        _e(date(2026, 2, 15)),
+        _e(date(2026, 3, 15)),
+        # gap: no payments April/May
+        _e(date(2026, 6, 15)),
+        _e(date(2026, 7, 15)),
+        _e(date(2026, 8, 15)),
