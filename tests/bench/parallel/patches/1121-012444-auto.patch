+
+def test_gap_within_tolerance_connects() -> None:
+    # expected 2026-02-15; 2026-02-18 is +3 days (= tolerance)
+    rows = [_e(date(2026, 1, 15)), _e(date(2026, 2, 18))]
+    result = find_recurring(rows, min_count=2, tolerance=3)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 3, 18)
+
+
+def test_early_within_tolerance_connects() -> None:
+    # expected 2026-02-15; 2026-02-12 is -3 days (abs = tolerance)
+    rows = [_e(date(2026, 1, 15)), _e(date(2026, 2, 12))]
+    assert len(find_recurring(rows, min_count=2, tolerance=3)) == 1
+
+
+def test_gap_beyond_tolerance_does_not_connect() -> None:
+    # expected 2026-02-15; 2026-02-19 is +4 days (> tolerance)
+    rows = [_e(date(2026, 1, 15)), _e(date(2026, 2, 19))]
+    assert find_recurring(rows, min_count=2, tolerance=3) == []
+
+
+def test_zero_tolerance_requires_exact_day() -> None:
+    rows = [_e(date(2026, 1, 15)), _e(date(2026, 2, 16))]
+    assert find_recurring(rows, min_count=2, tolerance=0) == []
+    rows = [_e(date(2026, 1, 15)), _e(date(2026, 2, 15))]
+    assert len(find_recurring(rows, min_count=2, tolerance=0)) == 1
+
+
+def test_month_end_clamp_connects() -> None:
+    # 01-31 -> expected 02-28; 02-28 -> expected 03-28; 03-31 is +3 days
+    rows = [_e(date(2026, 1, 31)), _e(date(2026, 2, 28)), _e(date(2026, 3, 31))]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 30)
+
