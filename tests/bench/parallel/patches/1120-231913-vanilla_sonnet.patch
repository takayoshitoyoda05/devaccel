@@ -0,0 +1,173 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.importer import (
+    RowError,
+    decode_csv,
+    import_csv,
+    import_csv_bytes,
+    parse_amount,
+    parse_date,
+)
+
+
+@pytest.mark.parametrize(
+    "text,want",
+    [
+        ("1200", 1200),
+        ("1,200", 1200),
+        ("¥1,200", 1200),
+        ("￥１，２００", 1200),
+        ("1,200円", 1200),
+        ("-500", -500),
+        ("−500", -500),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("+500", 500),
+        ("1200.00", 1200),
+        (" 80000 ", 80000),
+    ],
+)
+def test_parse_amount_ok(text, want):
+    assert parse_amount(text) == want
+
+
+@pytest.mark.parametrize("text", ["", "abc", "12.5", "1,23", "1,2,3", "--5", "¥"])
+def test_parse_amount_bad(text):
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026-11-01",
+        "2026/11/1",
+        "2026.11.01",
+        "20261101",
+        "2026年11月1日",
+        "２０２６/１１/０１",
+        "令和8年11月1日",
+        "R8.11.1",
+        "2026-11-01 12:30",
+    ],
+)
+def test_parse_date_ok(text):
+    assert parse_date(text) == date(2026, 11, 1)
+
+
+@pytest.mark.parametrize(
+    "text", ["", "11/01/2026", "2026-13-01", "2026-02-30", "hello"]
+)
+def test_parse_date_bad(text):
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+def test_card_csv_japanese_headers():
+    text = (
+        "ご利用日,ご利用店名,ご利用金額\n"
+        '2026/11/01,コンビニ,"1,234"\n'
+        "2026/11/02,書店,800\n"
+    )
+    r = import_csv(text)
+    assert r.ok
+    assert r.expenses == [
+        Expense(date(2026, 11, 1), "未分類", 1234, "コンビニ"),
+        Expense(date(2026, 11, 2), "未分類", 800, "書店"),
+    ]
+    assert r.mapping == {
+        "date": "ご利用日",
+        "memo": "ご利用店名",
+        "amount": "ご利用金額",
+    }
+
+
+def test_bank_withdrawal_deposit_columns():
+    text = "日付,摘要,出金,入金\n2026-11-01,家賃,80000,\n2026-11-05,給与,,300000\n"
+    r = import_csv(text)
+    assert [e.amount for e in r.expenses] == [80000, -300000]
+
+
+def test_amount_sign_expense_negative():
+    text = "date,description,amount\n2026-11-01,rent,-80000\n2026-11-02,refund,500\n"
+    r = import_csv(text, amount_sign="expense_negative")
+    assert [e.amount for e in r.expenses] == [80000, -500]
+
+
+def test_category_column_and_default():
+    text = "date,category,amount\n2026-11-01,food,100\n2026-11-02,,200\n"
+    r = import_csv(text, default_category="other")
+    assert [e.category for e in r.expenses] == ["food", "other"]
+
+
+def test_preamble_and_blank_lines_skipped():
+    text = "カード会員様\n\n利用明細\n日付,内容,金額\n2026-11-01,a,100\n\n2026-11-02,b,200\n"
+    r = import_csv(text)
+    assert r.ok and len(r.expenses) == 2
+
+
+def test_errors_have_line_column_reason_and_good_rows_kept():
+    text = (
+        "日付,内容,金額\n"
+        "2026-11-01,ok,100\n"
+        "xx,bad date,100\n"
+        "2026-11-03,bad amt,abc\n"
+        "yy,both,zz\n"
+    )
+    r = import_csv(text)
+    assert len(r.expenses) == 1
+    assert [(e.line, e.column) for e in r.errors] == [
+        (3, "date"),
+        (4, "amount"),
+        (5, "date"),
+        (5, "amount"),
+    ]
+    assert "xx" in r.errors[0].reason
+    assert str(r.errors[0]).startswith("3行目: [date]")
+
+
+def test_short_row_reported():
+    r = import_csv("date,memo,amount\n2026-11-01,a\n")
+    assert not r.expenses
+    assert r.errors[0].line == 2 and "列数" in r.errors[0].reason
+
+
+def test_line_number_counts_multiline_quoted_cells():
+    text = 'date,memo,amount\n2026-11-01,"a\nb",100\n2026-11-02,c,oops\n'
+    r = import_csv(text)
+    assert r.errors == [RowError(4, "amount", "金額として読めません: 'oops'")]
+
+
+def test_withdrawal_deposit_both_empty():
+    r = import_csv("日付,出金,入金\n2026-11-01,,\n")
+    assert r.errors[0].column == "amount"
+
+
+def test_no_header_found():
+    r = import_csv("foo,bar\n1,2\n")
+    assert not r.expenses and r.errors[0].line == 0
+    assert "ヘッダー" in r.errors[0].reason
+
+
+def test_header_variants_normalized():
+    r = import_csv("﻿ Date ,Amount\n2026-11-01,5\n")
+    assert r.ok and r.expenses[0].amount == 5
+
+
+def test_decode_utf8_bom_and_cp932():
+    assert decode_csv("﻿日付".encode()) == "日付"
+    assert decode_csv("日付,金額".encode("cp932")) == "日付,金額"
+    with pytest.raises(ValueError):
+        decode_csv(b"\x81")
+
+
+def test_import_csv_bytes_cp932_and_decode_failure():
+    data = "日付,内容,金額\n2026-11-01,昼食,900\n".encode("cp932")
+    assert import_csv_bytes(data).expenses[0].memo == "昼食"
+    r = import_csv_bytes(b"\x81")
+    assert r.errors and r.errors[0].line == 0
