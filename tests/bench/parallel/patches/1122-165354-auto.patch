diff --git a/tests/test_types/test_Choice.py b/tests/test_types/test_Choice.py
index c34f516..46a8521 100644
--- a/tests/test_types/test_Choice.py
+++ b/tests/test_types/test_Choice.py
@@ -1,3 +1,5 @@
+import pytest
+
 import click
 
 
@@ -5,3 +7,53 @@ def test_choice_get_invalid_choice_message():
     choice = click.Choice(["a", "b", "c"])
     message = choice.get_invalid_choice_message("d", ctx=None)
     assert message == "'d' is not one of 'a', 'b', 'c'."
+
+
+def test_choice_invalid_message_suggests_one_close_choice():
+    choice = click.Choice(["apple", "banana", "cherry"])
+    message = choice.get_invalid_choice_message("appel", ctx=None)
+    assert message.endswith("Did you mean 'apple'?")
+
+
+def test_choice_invalid_message_suggests_several_close_choices():
+    choice = click.Choice(["declare", "refine", "other"])
+    message = choice.get_invalid_choice_message("decline", ctx=None)
+    assert message.endswith("(Did you mean one of: 'declare', 'refine'?)")
+
+
+def test_choice_invalid_message_suggestion_ignores_case_when_insensitive():
+    choice = click.Choice(["Apple", "Banana"], case_sensitive=False)
+    message = choice.get_invalid_choice_message("APPEL", ctx=None)
+    assert message.endswith("Did you mean 'apple'?")
+
+
+def test_choice_invalid_message_no_suggestion_for_unrelated_value():
+    choice = click.Choice(["apple", "banana"])
+    message = choice.get_invalid_choice_message("zzz", ctx=None)
+    assert "Did you mean" not in message
+
+
+def test_choice_invalid_message_single_choice_suggestion():
+    choice = click.Choice(["apple"])
+    message = choice.get_invalid_choice_message("appel", ctx=None)
+    assert message == "'appel' is not 'apple'. Did you mean 'apple'?"
+
+
+def test_choice_option_error_shows_suggestion(runner):
+    @click.command()
+    @click.option("--fruit", type=click.Choice(["apple", "banana"]))
+    def cli(fruit):
+        pass
+
+    result = runner.invoke(cli, ["--fruit", "appel"])
+    assert result.exit_code == 2
+    assert "'appel' is not one of 'apple', 'banana'. Did you mean 'apple'?" in (
+        result.output
+    )
+
+
+@pytest.mark.parametrize("value", ["", "x" * 50])
+def test_choice_invalid_message_edge_values(value):
+    choice = click.Choice(["apple", "banana"])
+    message = choice.get_invalid_choice_message(value, ctx=None)
+    assert "Did you mean" not in message
