+++ b/tests/test_yen.py
@@ -0,0 +1,31 @@
+import pytest
+
+from kakeibo.yen import format_yen
+
+
+@pytest.mark.parametrize(
+    ("amount", "expected"),
+    [
+        (1234567, "¥1,234,567"),  # D4
+        (500, "¥500"),
+        (999, "¥999"),
+        (1000, "¥1,000"),
+        (0, "¥0"),  # D2
+        (-500, "-¥500"),  # D1
+        (-1234567, "-¥1,234,567"),
+        (-1, "-¥1"),
+    ],
+)
+def test_format_yen(amount, expected):
+    assert format_yen(amount) == expected
+
+
+def test_uses_halfwidth_yen_sign():  # D3
+    assert format_yen(1000).startswith("¥")
+    assert "￥" not in format_yen(1000)
+
+
+@pytest.mark.parametrize("bad", [12.5, "500", None, True])  # D5
+def test_rejects_non_int(bad):
+    with pytest.raises(TypeError):
+        format_yen(bad)
