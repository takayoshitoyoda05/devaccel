+"""Format yen amounts for display.
+
+D1: 負数は符号を ¥ の前に置く(-500 -> "-¥500")。△ ▲ ( ) 表記は使わない。
+D2: 0 は "¥0"(符号なし)。
+D3: 記号は半角の ¥(U+00A5)と半角カンマ。全角・円・JPY は出力しない。
+D4: 桁区切りは 3 桁ごと(1234567 -> "¥1,234,567")。
+D5: int 以外(float・str・bool)は TypeError。金額は円の整数という制約のため丸めない。
+"""
+
+from __future__ import annotations
+
+
+def format_yen(amount: int) -> str:
+    if isinstance(amount, bool) or not isinstance(amount, int):
+        raise TypeError(f"金額は int である必要があります: {amount!r}")
+    sign = "-" if amount < 0 else ""
+    return f"{sign}¥{abs(amount):,}"
diff --git a/tests/test_yen.py b/tests/test_yen.py
