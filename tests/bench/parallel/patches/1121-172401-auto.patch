diff --git a/src/kakeibo/core.py b/src/kakeibo/core.py
index 8c3cbab..63656b7 100644
--- a/src/kakeibo/core.py
+++ b/src/kakeibo/core.py
@@ -9,6 +9,8 @@ from dataclasses import dataclass
 from datetime import date
 from pathlib import Path
 
+from babel.numbers import format_currency
+
 
 @dataclass(frozen=True)
 class Expense:
@@ -18,6 +20,17 @@ class Expense:
     memo: str = ""
 
 
+def format_yen(amount: int) -> str:
+    """日本円の通貨表記(例: ￥1,234)。babel の ja_JP ロケールを使う。
+
+    D1: 記号は全角の ￥(ja_JP の既定)。桁区切りは半角 `,`、小数なし。
+    D2: 0 は `￥0`。負数(返金の集計など)は babel の既定どおり `-￥1,234`。
+    D3: 引数は CSV 読込で検証済みの int を前提とし、ここでは型・範囲を弾かない。
+    D4: 表示は既定出力と --total の text のみ。csv・--report・警告は数値のまま。
+    """
+    return format_currency(amount, "JPY", locale="ja_JP")
+
+
 class CsvError(ValueError):
     """Raised when a CSV has invalid rows. errors: list of (line_number, reason)."""
 
