+def test_break_splits_into_separate_runs() -> None:
+    rows = [
+        e(date(2026, 1, 15)),
+        e(date(2026, 2, 15)),
+        e(date(2026, 3, 15)),
+        # April skipped
+        e(date(2026, 5, 15)),
+        e(date(2026, 6, 15)),
+        e(date(2026, 7, 15)),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 2
+    assert result[0].days == (date(2026, 1, 15), date(2026, 2, 15), date(2026, 3, 15))
+    assert result[0].next_expected == date(2026, 4, 15)
+    assert result[1].days == (date(2026, 5, 15), date(2026, 6, 15), date(2026, 7, 15))
+    assert result[1].next_expected == date(2026, 8, 15)
+
