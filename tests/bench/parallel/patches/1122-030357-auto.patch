diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..3c6711e 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -188,3 +188,107 @@ def test_path_type(runner, cls, expect):
 
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
+
+
+@pytest.mark.parametrize(
+    "name", ["a.csv", "a.TSV", "A.Csv", "dir.csv/a.tsv", "a.b.csv", ".csv"]
+)
+def test_extensions_accepts(name):
+    type = click.Path(extensions=[".csv", ".tsv"])
+    assert type.convert(name, None, None) == name
+
+
+@pytest.mark.parametrize("name", ["a.txt", "a", "a.csv.bak", "csv", "a.csvx", ""])
+def test_extensions_rejects(name):
+    type = click.Path(extensions=[".csv", ".tsv"])
+
+    with pytest.raises(click.BadParameter, match="must have one of the extensions"):
+        type.convert(name, None, None)
+
+
+def test_extensions_message_lists_extensions():
+    type = click.Path(extensions=["CSV", ".tsv"])
+
+    with pytest.raises(click.BadParameter, match=r"\.csv, \.tsv"):
+        type.convert("a.txt", None, None)
+
+
+def test_extensions_dot_optional_and_single_string():
+    assert click.Path(extensions="csv").convert("a.CSV", None, None) == "a.CSV"
+    assert click.Path(extensions=("tar.gz",)).convert("a.TAR.GZ", None, None)
+
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions=".tar.gz").convert("a.gz", None, None)
+
+
+@pytest.mark.parametrize("extensions", [[], (), [""], ["."]])
+def test_extensions_invalid_spec(extensions):
+    with pytest.raises(ValueError, match="extensions"):
+        click.Path(extensions=extensions)
+
+
+def test_extensions_default_unchanged():
+    assert click.Path().extensions is None
+    assert click.Path().convert("a.txt", None, None) == "a.txt"
+
+
+def test_extensions_pathlike_and_bytes():
+    type = click.Path(extensions=[".csv"])
+    assert type.convert(pathlib.Path("a.CSV"), None, None) == pathlib.Path("a.CSV")
+    assert type.convert(b"a.csv", None, None) == b"a.csv"
+
+    with pytest.raises(click.BadParameter):
+        type.convert(b"a.txt", None, None)
+
+
+def test_extensions_existing_file_and_directory(tmp_path):
+    type = click.Path(exists=True, extensions=[".csv"])
+    good = tmp_path / "a.csv"
+    good.write_text("x")
+    bad = tmp_path / "a.txt"
+    bad.write_text("x")
+    folder = tmp_path / "data.txt"
+    folder.mkdir()
+
+    assert type.convert(os.fspath(good), None, None) == os.fspath(good)
+
+    with pytest.raises(click.BadParameter, match="extensions"):
+        type.convert(os.fspath(bad), None, None)
+
+    # Directories are not checked, whatever they are called.
+    assert type.convert(os.fspath(folder), None, None) == os.fspath(folder)
+
+
+def test_extensions_dash_not_checked():
+    type = click.Path(allow_dash=True, extensions=[".csv"])
+    assert type.convert("-", None, None) == "-"
+
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions=[".csv"]).convert("-", None, None)
+
+
+def test_extensions_checked_before_resolve_path(tmp_path):
+    target = tmp_path / "data.bin"
+    target.write_text("x")
+    link = tmp_path / "link.csv"
+
+    try:
+        link.symlink_to(target)
+    except (OSError, NotImplementedError):
+        pytest.skip("symlinks not supported")
+
+    type = click.Path(exists=True, resolve_path=True, extensions=[".csv"])
+    assert type.convert(os.fspath(link), None, None) == os.path.realpath(link)
+
+
+def test_extensions_cli(runner):
+    @click.command()
+    @click.option("--data", type=click.Path(extensions=[".csv", ".tsv"]))
+    def cli(data):
+        click.echo(data)
+
+    assert runner.invoke(cli, ["--data", "x.CSV"]).output == "x.CSV\n"
+
+    result = runner.invoke(cli, ["--data", "x.json"])
+    assert result.exit_code == 2
+    assert "Path 'x.json' must have one of the extensions: .csv, .tsv." in result.output
