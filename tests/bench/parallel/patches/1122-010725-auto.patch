+++ b/tests/test_importer.py
@@ -0,0 +1,169 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import CsvError, Expense
+from kakeibo.importer import parse_amount, parse_date, parse_statement
+
+
+def test_card_aliases_and_fullwidth():
+    text = '利用日,ご利用店名,利用金額\n2026/1/5,ＳＨＯＰ,"￥１，２３４円"\n'
+    assert parse_statement(text) == [
+        Expense(date(2026, 1, 5), "未分類", 1234, "ＳＨＯＰ")
+    ]
+
+
+def test_bom_tab_crlf_and_case_insensitive_header():
+    text = "﻿ Date \t Amount \t Category\r\n2026-01-05\t300\tfood\r\n"
+    assert parse_statement(text) == [Expense(date(2026, 1, 5), "food", 300, "")]
+
+
+@pytest.mark.parametrize(
+    "raw,want",
+    [
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("¥1,000", 1000),
+        ("1000 JPY", 1000),
+        ("0", 0),
+    ],
+)
+def test_amount_forms(raw, want):
+    assert parse_amount(raw) == want
+
+
+@pytest.mark.parametrize("raw", ["", "-", "—", "12.5", "12.0", "abc", "1,2,x", "()"])
+def test_amount_rejected(raw):
+    with pytest.raises(ValueError):
+        parse_amount(raw)
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026.1.5",
+        "2026年1月5日",
+        "20260105",
+        "２０２６/１/５",
+        "2026-01-05 12:30:00",
+        "2026/01/05 9:05",
+    ],
+)
+def test_date_forms(raw):
+    assert parse_date(raw) == date(2026, 1, 5)
+
+
+@pytest.mark.parametrize("raw", ["2026-02-30", "令和8年1月5日", "", "1/5"])
+def test_date_rejected(raw):
+    with pytest.raises(ValueError):
+        parse_date(raw)
+
+
+def test_leap_day():
+    assert parse_date("2024/2/29") == date(2024, 2, 29)
+    with pytest.raises(ValueError):
+        parse_date("2026/2/29")
+
+
+def test_refund_kept_negative():
+    rows = parse_statement("date,amount\n2026-01-05,△500\n")
+    assert rows[0].amount == -500
+
+
+def test_withdrawal_deposit_columns():
+    text = (
+        "取引日,摘要,出金額,入金額\n"
+        '2026/1/5,ATM,"10,000",\n'
+        "2026/1/6,給与,,300000\n"
+        "2026/1/7,コンビニ,0,\n"
+    )
+    rows = parse_statement(text)
+    assert [(r.day.day, r.amount) for r in rows] == [(5, 10000), (7, 0)]
+
+
+def test_withdrawal_and_deposit_both_is_error():
+    with pytest.raises(CsvError) as ei:
+        parse_statement("日付,出金,入金\n2026-01-05,100,200\n")
+    assert ei.value.errors[0][0] == 2 and "両方" in ei.value.errors[0][1]
+
+
+def test_both_blank_is_error():
+    with pytest.raises(CsvError) as ei:
+        parse_statement("日付,出金,入金\n2026-01-05,,\n")
+    assert "空欄" in ei.value.errors[0][1]
+
+
+def test_single_amount_column_wins_over_split():
+    rows = parse_statement("日付,金額,出金,入金\n2026-01-05,100,,500\n")
+    assert rows[0].amount == 100
+
+
+def test_all_errors_reported_with_line_and_value():
+    text = "日付,金額,摘要\n2026-02-30,abc,x\n2026-01-05,100,ok\n2026/1/6,12.5,y\n"
+    with pytest.raises(CsvError) as ei:
+        parse_statement(text)
+    assert ei.value.errors == [
+        (2, "日付が存在しません: '2026-02-30'"),
+        (2, "金額が整数ではありません: 'abc'"),
+        (4, "金額が整数ではありません: '12.5'"),
+    ]
+
+
+def test_unquoted_thousands_separator_is_column_count_error():
+    with pytest.raises(CsvError) as ei:
+        parse_statement("日付,金額\n2026-01-05,1,234円\n")
+    assert ei.value.errors == [(2, "列数が 3 です(ヘッダーは 2)")]
+
+
+def test_line_number_is_record_start_with_quoted_newline():
+    text = '日付,金額,摘要\n2026-01-05,100,"a\nb"\n2026-01-06,x,c\n'
+    with pytest.raises(CsvError) as ei:
+        parse_statement(text)
+    assert ei.value.errors[0][0] == 4
+
+
+def test_blank_lines_skipped_and_line_numbers_kept():
+    text = "日付,金額\n\n,\n2026-01-05,x\n"
+    with pytest.raises(CsvError) as ei:
+        parse_statement(text)
+    assert ei.value.errors[0][0] == 4
+
+
+def test_header_only_is_empty_list():
+    assert parse_statement("日付,金額\n") == []
+
+
+@pytest.mark.parametrize("text", ["", "  \n\n", "﻿"])
+def test_empty_input_is_error(text):
+    with pytest.raises(CsvError) as ei:
+        parse_statement(text)
+    assert ei.value.errors[0][0] == 1
+
+
+def test_missing_required_columns():
+    with pytest.raises(CsvError) as ei:
+        parse_statement("摘要,カテゴリ\nx,y\n")
+    assert [n for n, _ in ei.value.errors] == [1, 1]
+
+
+def test_duplicate_column_kind_is_error():
+    with pytest.raises(CsvError) as ei:
+        parse_statement("日付,利用日,金額\n2026-01-05,2026-01-05,1\n")
+    assert "複数" in ei.value.errors[0][1]
+
+
+@pytest.mark.parametrize("bad", [None, b"date,amount\n", 5])
+def test_non_str_is_type_error(bad):
+    with pytest.raises(TypeError):
+        parse_statement(bad)  # type: ignore[arg-type]
+
+
+def test_blank_category_defaults():
+    rows = parse_statement("date,category,amount\n2026-01-05, ,100\n")
+    assert rows[0].category == "未分類"
