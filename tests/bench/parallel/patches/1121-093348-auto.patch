+def test_raise_for_errors_raises_csv_error_with_line_and_reason():
+    result = parse_statement("date,amount\n2026-01-05,100\n2026-13-01,abc\n")
+    assert len(result.errors) == 2
+    assert all(isinstance(e, RowError) for e in result.errors)
+    with pytest.raises(CsvError) as ei:
+        result.raise_for_errors()
+    assert isinstance(ei.value, ValueError)
+    assert [n for n, _ in ei.value.errors] == [3, 3]
+    assert all(isinstance(n, int) for n, _ in ei.value.errors)
+    messages = " ".join(msg for _, msg in ei.value.errors)
+    for e in result.errors:
+        assert e.reason in messages
+        assert e.value in messages
