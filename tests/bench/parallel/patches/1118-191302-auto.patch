diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..7dbfa8f
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,289 @@
+from __future__ import annotations
+
+import dataclasses
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def e(y: int, m: int, cat: str, amount: int) -> Expense:
+    return Expense(day=date(y, m, 1), category=cat, amount=amount, memo="")
+
+
+def by_cat(diffs: list[DiffRow]) -> dict[str, DiffRow]:
+    return {d.category: d for d in diffs}
+
+
+# --- DiffRow ---------------------------------------------------------------
+
+
+def test_diffrow_field_order_and_frozen() -> None:
+    names = [f.name for f in dataclasses.fields(DiffRow)]
+    assert names == ["category", "prev", "curr", "delta", "pct", "status"]
+    row = DiffRow("食費", 1, 2, 1, 100.0, "up")
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        row.prev = 5  # type: ignore[misc]
+
+
+# --- month_diff: validation -------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        "2026-1",
+        "2026-13",
+        "2026-00",
+        "202601",
+        "2026/01",
+        "26-01",
+        " 2026-01",
+        "2026-01 ",
+    ],
+)
+def test_month_diff_rejects_bad_month_format(bad: str) -> None:
+    with pytest.raises(ValueError):
+        month_diff([], bad, "2026-02")
+    with pytest.raises(ValueError):
+        month_diff([], "2026-01", bad)
+
+
+def test_month_diff_accepts_valid_months_without_rows() -> None:
+    assert month_diff([], "2026-01", "2026-12") == []
+
+
+# --- month_diff: values -----------------------------------------------------
+
+
+def test_month_diff_union_of_categories_and_missing_is_zero() -> None:
+    rows = [e(2026, 1, "食費", 1000), e(2026, 2, "交通", 300)]
+    got = by_cat(month_diff(rows, "2026-01", "2026-02"))
+    assert set(got) == {"食費", "交通"}
+    assert got["食費"] == DiffRow("食費", 1000, 0, -1000, -100.0, "gone")
+    assert got["交通"] == DiffRow("交通", 0, 300, 300, None, "new")
+
+
+def test_month_diff_pct_rounded_to_one_decimal() -> None:
+    rows = [e(2026, 1, "食費", 3000), e(2026, 2, "食費", 4000)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row.delta == 1000
+    assert row.pct == round(1000 / 3000 * 100, 1) == 33.3
+
+
+def test_month_diff_sums_multiple_rows_per_month() -> None:
+    rows = [
+        e(2026, 1, "食費", 500),
+        e(2026, 1, "食費", 500),
+        e(2026, 2, "食費", 1200),
+    ]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert (row.prev, row.curr, row.delta) == (1000, 1200, 200)
+    assert row.pct == 20.0
+    assert row.status == "up"
+
+
+def test_month_diff_pct_none_when_prev_is_zero() -> None:
+    rows = [e(2026, 2, "食費", 500)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row.pct is None
+    assert row.status == "new"
+
+
+def test_month_diff_pct_none_when_prev_rows_sum_to_zero() -> None:
+    # prev has rows, but their total is 0: pct is None, status follows presence.
+    rows = [e(2026, 1, "食費", 100), e(2026, 1, "食費", -100), e(2026, 2, "食費", 500)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row.prev == 0
+    assert row.pct is None
+    assert row.status == "up"
+
+
+def test_month_diff_status_gone_when_curr_has_no_rows() -> None:
+    rows = [e(2026, 1, "食費", 800)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row.status == "gone"
+    assert row.curr == 0
+    assert row.pct == -100.0
+
+
+def test_month_diff_status_down() -> None:
+    rows = [e(2026, 1, "食費", 2000), e(2026, 2, "食費", 500)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row.delta == -1500
+    assert row.status == "down"
+
+
+def test_month_diff_status_same_when_delta_zero_with_rows_both_months() -> None:
+    rows = [e(2026, 1, "食費", 700), e(2026, 2, "食費", 700)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row.delta == 0
+    assert row.status == "same"
+    assert row.pct == 0.0
+
+
+def test_month_diff_status_same_by_presence_not_total() -> None:
+    # Both months have rows; sums are both 0 -> same, not new/gone.
+    rows = [e(2026, 1, "食費", 5), e(2026, 1, "食費", -5), e(2026, 2, "食費", 0)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row.status == "same"
+    assert row.pct is None
+
+
+def test_month_diff_ignores_other_months() -> None:
+    rows = [e(2026, 1, "食費", 100), e(2026, 2, "食費", 200), e(2026, 3, "食費", 9999)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row.curr == 200
+
+
+def test_month_diff_sort_by_abs_delta_desc_then_category_asc() -> None:
+    rows = [
+        e(2026, 1, "b", 100),
+        e(2026, 2, "b", 300),  # delta +200
+        e(2026, 1, "a", 500),
+        e(2026, 2, "a", 300),  # delta -200 (same abs, category 'a' first)
+        e(2026, 1, "c", 0),
+        e(2026, 2, "c", 1000),  # delta +1000 (largest)
+    ]
+    cats = [d.category for d in month_diff(rows, "2026-01", "2026-02")]
+    assert cats == ["c", "a", "b"]
+
+
+# --- top_movers -------------------------------------------------------------
+
+
+def _row(cat: str, delta: int, status: str) -> DiffRow:
+    return DiffRow(cat, 0, delta, delta, None, status)
+
+
+def test_top_movers_excludes_same_and_keeps_order() -> None:
+    diffs = [
+        _row("a", 500, "up"),
+        _row("b", 0, "same"),
+        _row("c", -300, "down"),
+        _row("d", 100, "up"),
+    ]
+    got = [d.category for d in top_movers(diffs)]
+    assert got == ["a", "c", "d"]
+
+
+def test_top_movers_default_n_is_three() -> None:
+    diffs = [_row(str(i), 10 - i, "up") for i in range(5)]
+    assert [d.category for d in top_movers(diffs)] == ["0", "1", "2"]
+
+
+def test_top_movers_n_counts_after_removing_same() -> None:
+    diffs = [_row("a", 0, "same"), _row("b", 5, "up"), _row("c", 4, "up")]
+    assert [d.category for d in top_movers(diffs, 1)] == ["b"]
+
+
+def test_top_movers_n_zero_returns_empty() -> None:
+    assert top_movers([_row("a", 1, "up")], 0) == []
+
+
+def test_top_movers_n_larger_than_count() -> None:
+    diffs = [_row("a", 1, "up")]
+    assert top_movers(diffs, 10) == diffs
+
+
+def test_top_movers_negative_n_raises() -> None:
+    with pytest.raises(ValueError):
+        top_movers([], -1)
+
+
+def test_top_movers_empty_input() -> None:
+    assert top_movers([]) == []
+
+
+# --- render_diff ------------------------------------------------------------
+
+
+def test_render_diff_header_and_signed_values() -> None:
+    diffs = [
+        DiffRow("食費", 1000, 1300, 300, 30.0, "up"),
+        DiffRow("住居", 2000, 0, -2000, -100.0, "gone"),
+        DiffRow("交通", 500, 500, 0, 0.0, "same"),
+    ]
+    text = render_diff(diffs)
+    assert text == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "食費\t1000\t1300\t+300\t+30.0%\n"
+        "住居\t2000\t0\t-2000\t-100.0%\n"
+        "交通\t500\t500\t+0\t+0.0%"
+    )
+
+
+def test_render_diff_none_pct_is_dash() -> None:
+    text = render_diff([DiffRow("食費", 0, 500, 500, None, "new")])
+    assert text.splitlines()[1] == "食費\t0\t500\t+500\t-"
+
+
+def test_render_diff_no_trailing_newline() -> None:
+    text = render_diff([DiffRow("食費", 1, 2, 1, 100.0, "up")])
+    assert not text.endswith("\n")
+    assert text.count("\n") == 1
+
+
+def test_render_diff_empty_is_header_only() -> None:
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_render_diff_small_negative_pct_keeps_sign() -> None:
+    text = render_diff([DiffRow("食費", 10000, 9999, -1, -0.0, "down")])
+    assert text.splitlines()[1] == "食費\t10000\t9999\t-1\t+0.0%"
+
+
+# --- available_months -------------------------------------------------------
+
+
+def test_available_months_sorted_unique() -> None:
+    rows = [
+        e(2026, 3, "食費", 1),
+        e(2026, 1, "食費", 1),
+        e(2026, 3, "交通", 1),
+        e(2025, 12, "食費", 1),
+    ]
+    assert available_months(rows) == ["2025-12", "2026-01", "2026-03"]
+
+
+def test_available_months_empty() -> None:
+    assert available_months([]) == []
+
+
+def test_available_months_zero_pads_month() -> None:
+    assert available_months([e(2026, 9, "食費", 1)]) == ["2026-09"]
+
+
+# --- latest_diff ------------------------------------------------------------
+
+
+def test_latest_diff_uses_last_two_months() -> None:
+    rows = [
+        e(2026, 1, "食費", 100),
+        e(2026, 2, "食費", 200),
+        e(2026, 3, "食費", 400),
+    ]
+    (row,) = latest_diff(rows)
+    assert (row.prev, row.curr, row.delta) == (200, 400, 200)
+
+
+def test_latest_diff_ignores_gaps_by_using_available_months() -> None:
+    rows = [e(2026, 1, "食費", 100), e(2026, 5, "食費", 300)]
+    (row,) = latest_diff(rows)
+    assert (row.prev, row.curr) == (100, 300)
+
+
+def test_latest_diff_requires_two_months() -> None:
+    with pytest.raises(ValueError):
+        latest_diff([])
+    with pytest.raises(ValueError):
+        latest_diff([e(2026, 1, "食費", 100), e(2026, 1, "交通", 50)])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..f120dd0
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,191 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def _e(category: str, memo: str = "", amount: int = 100) -> Expense:
+    return Expense(day=date(2026, 1, 1), category=category, amount=amount, memo=memo)
+
+
+# --- tokenize ---------------------------------------------------------------
+
+
+def test_tokenize_empty_and_whitespace_only_gives_no_tokens() -> None:
+    assert tokenize("") == []
+    assert tokenize("   \t ") == []
+
+
+def test_tokenize_splits_on_whitespace() -> None:
+    assert tokenize("  a   b ") == [("TERM", "a"), ("TERM", "b")]
+
+
+def test_tokenize_parens() -> None:
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+
+
+def test_tokenize_word_stops_at_paren_and_quote() -> None:
+    assert tokenize('a(b)"c"') == [
+        ("TERM", "a"),
+        ("LPAREN", "("),
+        ("TERM", "b"),
+        ("RPAREN", ")"),
+        ("TERM", "c"),
+    ]
+
+
+def test_tokenize_quote_keeps_spaces_and_parens() -> None:
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+
+
+def test_tokenize_unclosed_quote_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_operators_only_when_uppercase_exact() -> None:
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+    assert tokenize("and or not") == [
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+    assert tokenize("ANDx") == [("TERM", "ANDx")]
+
+
+def test_tokenize_quoted_operator_word_is_term() -> None:
+    assert tokenize('"AND"') == [("TERM", "AND")]
+
+
+def test_tokenize_cat_prefix() -> None:
+    assert tokenize("cat:食費") == [("CAT", "食費")]
+
+
+def test_tokenize_cat_with_empty_value_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_tokenize_cat_prefix_is_case_sensitive() -> None:
+    assert tokenize("CAT:x") == [("TERM", "CAT:x")]
+
+
+# --- parsing errors ----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    ["", "   ", "()", "a OR", "OR a", "AND a", "a AND", "(a", "a)", "NOT", "a (", ")"],
+)
+def test_invalid_syntax_raises(q: str) -> None:
+    with pytest.raises(QueryError):
+        matches(q, _e("食費"))
+
+
+def test_filter_rows_raises_on_invalid_query_even_with_no_rows() -> None:
+    with pytest.raises(QueryError):
+        filter_rows("a OR", [])
+
+
+# --- precedence and operators ------------------------------------------------
+
+
+def test_adjacent_terms_are_and() -> None:
+    e = _e("食費", "ランチ")
+    assert matches("食費 ランチ", e)
+    assert not matches("食費 交通", e)
+
+
+def test_explicit_and_equals_implicit() -> None:
+    e = _e("食費", "ランチ")
+    assert matches("食費 AND ランチ", e)
+    assert not matches("食費 AND 交通", e)
+
+
+def test_or_has_lower_precedence_than_and() -> None:
+    # "A OR B C" must parse as A OR (B AND C); as (A OR B) AND C it would be False here.
+    assert matches("A OR B C", _e("A", ""))
+    assert matches("X OR B C", _e("B", "c"))  # X false, B AND C true
+    assert not matches("X OR B C", _e("B", "z"))  # B AND C false
+
+
+def test_not_binds_tighter_than_and() -> None:
+    # (NOT a) AND b
+    assert matches("NOT 交通 食費", _e("食費"))
+    assert not matches("NOT 食費 食費", _e("食費"))
+
+
+def test_double_not() -> None:
+    assert matches("NOT NOT 食費", _e("食費"))
+    assert not matches("NOT NOT 食費", _e("交通"))
+
+
+def test_parens_override_precedence() -> None:
+    # (a OR b) c
+    assert matches("(A OR B) x", _e("A", "x"))
+    assert not matches("(A OR B) x", _e("A", "y"))
+
+
+def test_nested_parens() -> None:
+    assert matches("((食費))", _e("食費"))
+
+
+# --- term and cat evaluation -------------------------------------------------
+
+
+def test_term_matches_memo_substring() -> None:
+    assert matches("ラン", _e("食費", "ランチ"))
+
+
+def test_term_matches_category_substring() -> None:
+    assert matches("食", _e("食費", ""))
+
+
+def test_term_does_not_match_when_absent() -> None:
+    assert not matches("交通", _e("食費", "ランチ"))
+
+
+def test_term_is_case_insensitive() -> None:
+    assert matches("abc", _e("X", "ABCdef"))
+    assert matches("ABC", _e("x", "abcdef"))
+
+
+def test_cat_requires_exact_category() -> None:
+    assert matches("cat:食費", _e("食費", "ランチ"))
+    assert not matches("cat:食", _e("食費"))
+    assert not matches("cat:費", _e("食費"))
+
+
+def test_cat_does_not_match_memo() -> None:
+    assert not matches("cat:ランチ", _e("食費", "ランチ"))
+
+
+def test_cat_is_case_insensitive() -> None:
+    assert matches("cat:FOOD", _e("food"))
+
+
+def test_term_case_insensitive_uses_casefold() -> None:
+    assert matches("STRASSE", _e("x", "straße"))
+
+
+# --- filter_rows -------------------------------------------------------------
+
+
+def test_filter_rows_keeps_input_order() -> None:
+    rows = [_e("食費", "a"), _e("交通", "b"), _e("食費", "c")]
+    assert filter_rows("cat:食費", rows) == [rows[0], rows[2]]
+
+
+def test_filter_rows_empty_input_with_valid_query() -> None:
+    assert filter_rows("食費", []) == []
+
+
+def test_filter_rows_no_match_returns_empty() -> None:
+    assert filter_rows("cat:なし", [_e("食費")]) == []
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..b3b4d25
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,231 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def e(day: date, category: str = "通信", amount: int = 1000, memo: str = "") -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- add_month ---------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("src", "expected"),
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),  # clamp to short month
+        (date(2024, 1, 31), date(2024, 2, 29)),  # clamp in leap year
+        (date(2026, 12, 15), date(2027, 1, 15)),  # year rollover
+        (date(2026, 3, 10), date(2026, 4, 10)),  # plain case
+        (date(2026, 4, 30), date(2026, 5, 30)),  # 30 fits in May
+        (date(2026, 5, 31), date(2026, 6, 30)),  # 31 clamps in June
+    ],
+)
+def test_add_month(src: date, expected: date) -> None:
+    assert add_month(src) == expected
+
+
+# --- validation ----------------------------------------------------------------
+
+
+def test_min_count_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+
+
+def test_negative_tolerance_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_validation_applies_even_without_rows() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=0)
+
+
+def test_zero_tolerance_is_allowed() -> None:
+    rows = [e(date(2026, 1, 10)), e(date(2026, 2, 10)), e(date(2026, 3, 10))]
+    assert len(find_recurring(rows, tolerance=0)) == 1
+
+
+# --- basic detection -----------------------------------------------------------
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+def test_detects_monthly_series() -> None:
+    rows = [e(date(2026, 1, 10)), e(date(2026, 2, 10)), e(date(2026, 3, 10))]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="通信",
+            amount=1000,
+            days=(date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10)),
+            next_expected=date(2026, 4, 10),
+        )
+    ]
+
+
+def test_min_count_exact_length_is_included() -> None:
+    rows = [e(date(2026, 1, 10)), e(date(2026, 2, 10)), e(date(2026, 3, 10))]
+    assert len(find_recurring(rows, min_count=3)) == 1
+
+
+def test_run_shorter_than_min_count_is_excluded() -> None:
+    rows = [e(date(2026, 1, 10)), e(date(2026, 2, 10))]
+    assert find_recurring(rows, min_count=3) == []
+    assert len(find_recurring(rows, min_count=2)) == 1
+
+
+def test_memo_is_ignored_for_grouping() -> None:
+    rows = [
+        e(date(2026, 1, 10), memo="a"),
+        e(date(2026, 2, 10), memo="b"),
+        e(date(2026, 3, 10), memo=""),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_duplicate_dates_count_once() -> None:
+    rows = [e(date(2026, 1, 10)), e(date(2026, 1, 10)), e(date(2026, 2, 10))]
+    assert find_recurring(rows, min_count=3) == []
+    result = find_recurring(rows, min_count=2)
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 10))
+
+
+def test_input_order_does_not_matter() -> None:
+    rows = [e(date(2026, 3, 10)), e(date(2026, 1, 10)), e(date(2026, 2, 10))]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10))
+
+
+# --- grouping ------------------------------------------------------------------
+
+
+def test_different_amounts_in_same_category_are_not_merged() -> None:
+    rows = [
+        e(date(2026, 1, 10), amount=1000),
+        e(date(2026, 2, 10), amount=2000),
+        e(date(2026, 3, 10), amount=1000),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_different_categories_are_not_merged() -> None:
+    rows = [
+        e(date(2026, 1, 10), category="A"),
+        e(date(2026, 2, 10), category="B"),
+        e(date(2026, 3, 10), category="A"),
+    ]
+    assert find_recurring(rows) == []
+
+
+# --- tolerance -----------------------------------------------------------------
+
+
+def test_within_tolerance_is_connected() -> None:
+    # expected 2026-02-10; 2026-02-13 is +3 days
+    rows = [e(date(2026, 1, 10)), e(date(2026, 2, 13)), e(date(2026, 3, 13))]
+    # 2026-03-13 expected from 2026-02-13 -> 2026-03-13, exact
+    result = find_recurring(rows)
+    assert len(result) == 1
+
+
+def test_early_within_tolerance_is_connected() -> None:
+    # expected 2026-02-10; 2026-02-07 is -3 days
+    rows = [e(date(2026, 1, 10)), e(date(2026, 2, 7)), e(date(2026, 3, 7))]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_beyond_tolerance_breaks_the_series() -> None:
+    # expected 2026-02-10; 2026-02-14 is +4 days, beyond default tolerance 3
+    rows = [e(date(2026, 1, 10)), e(date(2026, 2, 14)), e(date(2026, 3, 14))]
+    assert find_recurring(rows) == []
+
+
+def test_chain_uses_actual_previous_date() -> None:
+    # 2026-02-13 (+3) connects; next expected is add_month(2026-02-13)=2026-03-13
+    rows = [e(date(2026, 1, 10)), e(date(2026, 2, 13)), e(date(2026, 3, 13))]
+    result = find_recurring(rows)
+    assert result[0].next_expected == date(2026, 4, 13)
+
+
+# --- splitting and month-end --------------------------------------------------
+
+
+def test_gap_splits_into_separate_runs() -> None:
+    rows = [
+        e(date(2026, 1, 10)),
+        e(date(2026, 2, 10)),
+        e(date(2026, 3, 10)),
+        # break: expected 2026-04-10, actual 2026-05-20
+        e(date(2026, 5, 20)),
+        e(date(2026, 6, 20)),
+        e(date(2026, 7, 20)),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 2
+    assert result[0].days[0] == date(2026, 1, 10)
+    assert result[1].days[0] == date(2026, 5, 20)
+
+
+def test_short_run_between_breaks_is_dropped_but_others_kept() -> None:
+    rows = [
+        e(date(2026, 1, 10)),
+        e(date(2026, 2, 10)),
+        e(date(2026, 3, 10)),
+        e(date(2026, 9, 1)),  # isolated
+        e(date(2026, 11, 1)),  # isolated
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days[-1] == date(2026, 3, 10)
+
+
+def test_month_end_series_connects_via_clamping() -> None:
+    rows = [e(date(2026, 1, 31)), e(date(2026, 2, 28)), e(date(2026, 3, 28))]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    # add_month(2026-03-28) = 2026-04-28
+    assert result[0].next_expected == date(2026, 4, 28)
+
+
+def test_next_expected_is_after_last_day() -> None:
+    rows = [e(date(2026, 10, 15)), e(date(2026, 11, 15)), e(date(2026, 12, 15))]
+    result = find_recurring(rows)
+    assert result[0].next_expected == date(2027, 1, 15)
+
+
+# --- ordering ------------------------------------------------------------------
+
+
+def test_output_sorted_by_category_amount_then_first_day() -> None:
+    rows = [
+        # category "b", amount 500, two runs
+        e(date(2026, 5, 1), category="b", amount=500),
+        e(date(2026, 6, 1), category="b", amount=500),
+        e(date(2026, 7, 1), category="b", amount=500),
+        e(date(2026, 1, 1), category="b", amount=500),
+        e(date(2026, 2, 1), category="b", amount=500),
+        e(date(2026, 3, 1), category="b", amount=500),
+        # category "a", amount 900
+        e(date(2026, 1, 5), category="a", amount=900),
+        e(date(2026, 2, 5), category="a", amount=900),
+        e(date(2026, 3, 5), category="a", amount=900),
+        # category "a", amount 100
+        e(date(2026, 1, 6), category="a", amount=100),
+        e(date(2026, 2, 6), category="a", amount=100),
+        e(date(2026, 3, 6), category="a", amount=100),
+    ]
+    result = find_recurring(rows)
+    keys = [(r.category, r.amount, r.days[0]) for r in result]
+    assert keys == [
+        ("a", 100, date(2026, 1, 6)),
+        ("a", 900, date(2026, 1, 5)),
+        ("b", 500, date(2026, 1, 1)),
+        ("b", 500, date(2026, 5, 1)),
+    ]
diff --git a/tests/test_split.py b/tests/test_split.py
new file mode 100644
index 0000000..396bcd0
--- /dev/null
+++ b/tests/test_split.py
@@ -0,0 +1,41 @@
+import pytest
+
+from kakeibo.split import split_evenly
+
+
+def test_divisible_amount_gives_equal_shares() -> None:
+    assert split_evenly(900, 3) == [300, 300, 300]
+
+
+def test_remainder_goes_to_leading_people_one_yen_each() -> None:
+    assert split_evenly(10, 3) == [4, 3, 3]
+
+
+def test_remainder_of_two_gives_first_two_extra_yen() -> None:
+    assert split_evenly(11, 4) == [3, 3, 3, 2]
+
+
+def test_amount_smaller_than_people_gives_trailing_zeros() -> None:
+    assert split_evenly(2, 3) == [1, 1, 0]
+
+
+def test_zero_amount_gives_all_zeros() -> None:
+    assert split_evenly(0, 4) == [0, 0, 0, 0]
+
+
+def test_single_person_gets_whole_amount() -> None:
+    assert split_evenly(1234, 1) == [1234]
+
+
+def test_sum_always_equals_amount() -> None:
+    for amount in range(50):
+        for people in range(1, 8):
+            shares = split_evenly(amount, people)
+            assert sum(shares) == amount
+            assert len(shares) == people
+
+
+@pytest.mark.parametrize("people", [0, -1])
+def test_people_below_one_raises_value_error(people: int) -> None:
+    with pytest.raises(ValueError):
+        split_evenly(100, people)
diff --git a/tests/test_stats.py b/tests/test_stats.py
new file mode 100644
index 0000000..3e2e461
--- /dev/null
+++ b/tests/test_stats.py
@@ -0,0 +1,88 @@
+"""Tests for kakeibo.stats."""
+
+from __future__ import annotations
+
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.stats import median_by_category
+
+
+def _e(category: str, amount: int, day: int = 1, memo: str = "") -> Expense:
+    return Expense(day=date(2026, 1, day), category=category, amount=amount, memo=memo)
+
+
+def test_empty_returns_empty_dict() -> None:
+    assert median_by_category([]) == {}
+
+
+def test_single_row_is_its_amount_as_float() -> None:
+    result = median_by_category([_e("食費", 500)])
+    assert result == {"食費": 500.0}
+    assert isinstance(result["食費"], float)
+
+
+def test_odd_count_takes_middle_value() -> None:
+    rows = [_e("食費", 300), _e("食費", 100), _e("食費", 200)]
+    assert median_by_category(rows) == {"食費": 200.0}
+
+
+def test_even_count_averages_two_middle_values() -> None:
+    rows = [_e("食費", 100), _e("食費", 400), _e("食費", 200), _e("食費", 300)]
+    # sorted: 100, 200, 300, 400 -> middle 200 and 300
+    assert median_by_category(rows) == {"食費": 250.0}
+
+
+def test_even_count_with_odd_sum_gives_fraction() -> None:
+    rows = [_e("食費", 1), _e("食費", 2)]
+    assert median_by_category(rows) == {"食費": 1.5}
+
+
+def test_equal_values_median_is_that_value() -> None:
+    rows = [_e("交通費", 120), _e("交通費", 120), _e("交通費", 120)]
+    assert median_by_category(rows) == {"交通費": 120.0}
+
+
+def test_each_category_computed_separately() -> None:
+    rows = [
+        _e("食費", 100),
+        _e("食費", 900),
+        _e("日用品", 50),
+        _e("日用品", 70),
+        _e("日用品", 1000),
+    ]
+    assert median_by_category(rows) == {"食費": 500.0, "日用品": 70.0}
+
+
+def test_keys_sorted_by_category_name_ascending() -> None:
+    rows = [_e("娯楽", 1), _e("医療", 2), _e("食費", 3), _e("医療", 4)]
+    result = median_by_category(rows)
+    assert list(result) == sorted(result)
+    assert list(result) == ["医療", "娯楽", "食費"]
+
+
+def test_keys_sorted_not_by_amount() -> None:
+    rows = [_e("b", 1), _e("a", 999)]
+    assert list(median_by_category(rows)) == ["a", "b"]
+
+
+def test_order_of_input_rows_does_not_matter() -> None:
+    rows = [_e("食費", 300), _e("食費", 100), _e("食費", 200), _e("食費", 400)]
+    assert median_by_category(rows) == median_by_category(list(reversed(rows)))
+
+
+def test_input_list_is_not_mutated() -> None:
+    rows = [_e("食費", 300), _e("食費", 100), _e("食費", 200)]
+    before = list(rows)
+    median_by_category(rows)
+    assert rows == before
+
+
+def test_memo_and_day_are_ignored() -> None:
+    rows = [_e("食費", 100, day=1, memo="a"), _e("食費", 300, day=28, memo="zz")]
+    assert median_by_category(rows) == {"食費": 200.0}
+
+
+def test_negative_amounts_are_handled_as_values() -> None:
+    rows = [_e("返金", -300), _e("返金", -100), _e("返金", 200)]
+    assert median_by_category(rows) == {"返金": -100.0}
diff --git a/tests/test_streak.py b/tests/test_streak.py
