index 0000000..5cf0c21
--- /dev/null
+++ b/tests/test_streak.py
@@ -0,0 +1,64 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.streak import longest_no_spend_streak
+
+
+def _e(day: date, amount: int = 100) -> Expense:
+    return Expense(day=day, category="food", amount=amount)
+
+
+def test_no_rows_returns_whole_period_length():
+    assert longest_no_spend_streak([], date(2026, 11, 1), date(2026, 11, 7)) == 7
+
+
+def test_single_day_period_without_spend_is_one():
+    assert longest_no_spend_streak([], date(2026, 11, 1), date(2026, 11, 1)) == 1
+
+
+def test_single_day_period_with_spend_is_zero():
+    rows = [_e(date(2026, 11, 1))]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 1)) == 0
+
+
+def test_spend_in_middle_splits_streak():
+    # 11/1..11/3 free (3), 11/4 spend, 11/5..11/7 free (3) -> 3
+    rows = [_e(date(2026, 11, 4))]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 7)) == 3
+
+
+def test_longest_of_several_runs_is_returned():
+    # runs: 11/1 (1 day), 11/3..11/6 (4 days), 11/8 (1 day)
+    rows = [_e(date(2026, 11, 2)), _e(date(2026, 11, 7))]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 8)) == 4
+
+
+def test_spend_on_start_and_end_are_excluded_from_streak():
+    rows = [_e(date(2026, 11, 1)), _e(date(2026, 11, 7))]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 7)) == 5
+
+
+def test_spend_on_both_ends_of_single_gap():
+    rows = [_e(date(2026, 11, 1)), _e(date(2026, 11, 3))]
+    # only 11/2 is free
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 3)) == 1
+
+
+def test_rows_outside_period_are_ignored():
+    rows = [_e(date(2026, 10, 31)), _e(date(2026, 11, 8))]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 7)) == 7
+
+
+def test_multiple_expenses_on_same_day_count_as_one_spend_day():
+    rows = [_e(date(2026, 11, 2)), _e(date(2026, 11, 2), amount=50)]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 4)) == 2
+
+
+def test_zero_amount_record_still_counts_as_spend_day():
+    # 明細が 1 件でもあれば、金額にかかわらずその日は使用日扱い
+    rows = [_e(date(2026, 11, 2), amount=0)]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 3)) == 1
+
+
+def test_start_after_end_returns_zero():
+    assert longest_no_spend_streak([], date(2026, 11, 7), date(2026, 11, 1)) == 0
diff --git a/tests/test_topn.py b/tests/test_topn.py
new file mode 100644
index 0000000..ffd080e
--- /dev/null
+++ b/tests/test_topn.py
@@ -0,0 +1,59 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.topn import top_expenses
+
+
+def _e(day: str, amount: int, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category="食費", amount=amount, memo=memo
+    )
+
+
+def test_returns_largest_amounts_first() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300), _e("2026-01-03", 200)]
+    assert [e.amount for e in top_expenses(rows, 2)] == [300, 200]
+
+
+def test_n_larger_than_rows_returns_all_sorted() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300)]
+    assert [e.amount for e in top_expenses(rows, 10)] == [300, 100]
+
+
+def test_same_amount_sorted_by_earlier_date() -> None:
+    rows = [_e("2026-03-01", 500), _e("2026-01-01", 500), _e("2026-02-01", 500)]
+    assert [e.day for e in top_expenses(rows, 3)] == [
+        date(2026, 1, 1),
+        date(2026, 2, 1),
+        date(2026, 3, 1),
+    ]
+
+
+def test_same_amount_and_date_keeps_input_order() -> None:
+    rows = [
+        _e("2026-01-01", 500, "a"),
+        _e("2026-01-01", 500, "b"),
+        _e("2026-01-01", 500, "c"),
+    ]
+    assert [e.memo for e in top_expenses(rows, 3)] == ["a", "b", "c"]
+
+
+def test_n_zero_returns_empty() -> None:
+    rows = [_e("2026-01-01", 100)]
+    assert top_expenses(rows, 0) == []
+
+
+def test_negative_n_returns_empty() -> None:
+    rows = [_e("2026-01-01", 100)]
+    assert top_expenses(rows, -3) == []
+
+
+def test_empty_rows_returns_empty() -> None:
+    assert top_expenses([], 5) == []
+
+
+def test_does_not_modify_input() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300)]
+    before = list(rows)
+    top_expenses(rows, 1)
+    assert rows == before
diff --git a/tests/test_weekday.py b/tests/test_weekday.py
new file mode 100644
index 0000000..19dd456
--- /dev/null
+++ b/tests/test_weekday.py
@@ -0,0 +1,83 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.weekday import total_by_weekday
+
+# 2024-01-01 は月曜日
+MON = date(2024, 1, 1)
+TUE = date(2024, 1, 2)
+WED = date(2024, 1, 3)
+THU = date(2024, 1, 4)
+FRI = date(2024, 1, 5)
+SAT = date(2024, 1, 6)
+SUN = date(2024, 1, 7)
+
+
+def _e(day: date, amount: int, category: str = "食費") -> Expense:
+    return Expense(day=day, category=category, amount=amount)
+
+
+def test_empty_rows_returns_empty_dict() -> None:
+    assert total_by_weekday([]) == {}
+
+
+def test_single_expense_gives_one_key() -> None:
+    assert total_by_weekday([_e(WED, 500)]) == {"Wed": 500}
+
+
+def test_same_weekday_is_summed() -> None:
+    rows = [_e(MON, 100), _e(MON, 250)]
+    assert total_by_weekday(rows) == {"Mon": 350}
+
+
+def test_same_weekday_in_different_weeks_is_summed() -> None:
+    rows = [_e(MON, 100), _e(date(2024, 1, 8), 200)]  # 2 つ目も月曜
+    assert total_by_weekday(rows) == {"Mon": 300}
+
+
+def test_weekdays_without_records_are_omitted() -> None:
+    rows = [_e(MON, 100), _e(FRI, 300)]
+    assert total_by_weekday(rows) == {"Mon": 100, "Fri": 300}
+
+
+def test_keys_are_in_monday_first_order_regardless_of_input_order() -> None:
+    rows = [_e(SUN, 7), _e(WED, 3), _e(MON, 1), _e(SAT, 6), _e(TUE, 2)]
+    result = total_by_weekday(rows)
+    assert list(result) == ["Mon", "Tue", "Wed", "Sat", "Sun"]
+    assert result == {"Mon": 1, "Tue": 2, "Wed": 3, "Sat": 6, "Sun": 7}
+
+
+def test_all_seven_days_in_order() -> None:
+    rows = [_e(d, i) for i, d in enumerate([SUN, SAT, FRI, THU, WED, TUE, MON], 1)]
+    result = total_by_weekday(rows)
+    assert list(result) == ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
+    assert result == {
+        "Mon": 7,
+        "Tue": 6,
+        "Wed": 5,
+        "Thu": 4,
+        "Fri": 3,
+        "Sat": 2,
+        "Sun": 1,
+    }
+
+
+def test_zero_amount_record_is_included() -> None:
+    assert total_by_weekday([_e(THU, 0)]) == {"Thu": 0}
+
+
+def test_negative_amounts_are_summed() -> None:
+    rows = [_e(TUE, 1000), _e(TUE, -300)]
+    assert total_by_weekday(rows) == {"Tue": 700}
+
+
+def test_categories_are_ignored() -> None:
+    rows = [_e(MON, 100, "食費"), _e(MON, 200, "交通費")]
+    assert total_by_weekday(rows) == {"Mon": 300}
+
+
+def test_input_list_is_not_mutated() -> None:
+    rows = [_e(SUN, 7), _e(MON, 1)]
+    snapshot = list(rows)
+    total_by_weekday(rows)
+    assert rows == snapshot
