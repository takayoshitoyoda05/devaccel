@@ -0,0 +1,16 @@
+"""Top-N expenses by amount."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def top_expenses(rows: list[Expense], n: int) -> list[Expense]:
+    """Return up to n expenses, largest amount first.
+
+    Ties on amount are broken by earlier date, then by input order (stable sort).
+    Returns [] when n <= 0.
+    """
+    if n <= 0:
+        return []
+    return sorted(rows, key=lambda e: (-e.amount, e.day))[:n]
