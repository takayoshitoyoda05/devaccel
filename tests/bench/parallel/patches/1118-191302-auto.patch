diff --git a/src/kakeibo/bankimport.py b/src/kakeibo/bankimport.py
new file mode 100644
index 0000000..f09c49b
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,112 @@
+"""Import expense rows from bank CSV exports."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"(-?)[¥￥]?([0-9][0-9,]*)円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    """Parse amounts like '¥1,234', '-300', '980円' into yen integers."""
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    sign, digits = m.groups()
+    value = int(digits.replace(",", ""))
+    return -value if sign else value
+
+
+def parse_date(s: str) -> date:
+    """Parse 'YYYY/M/D' or 'YYYY-M-D' (separator must not be mixed)."""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    year, _sep, month, day = m.groups()
+    try:
+        return date(int(year), int(month), int(day))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def _cell(row: list[str], index: dict[str, int], key: str) -> str:
+    """Stripped value of the column mapped to ``key``; "" if the row is short."""
+    i = index[key]
+    return row[i].strip() if i < len(row) else ""
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Convert a bank CSV (header on line 1) into expenses.
+
+    Returns (valid expenses in input order, [(physical line number, field)]).
+    Rows with any error are excluded from the expenses.
+    """
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping にキー {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    try:
+        header = next(reader)
+    except StopIteration:
+        header = []
+    for col in mapping.values():
+        if col not in header:
+            raise ValueError(f"ヘッダーに列 {col} がありません")
+    index = {key: header.index(col) for key, col in mapping.items()}
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    while True:
+        line_no = reader.line_num + 1
+        try:
+            row = next(reader)
+        except StopIteration:
+            break
+        if row == [] or (len(row) == 1 and row[0].strip() == ""):
+            continue
+
+        row_errors: list[tuple[int, str]] = []
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(_cell(row, index, "date"))
+        except ValueError:
+            row_errors.append((line_no, "date"))
+        try:
+            amount = parse_amount(_cell(row, index, "amount"))
+        except ValueError:
+            row_errors.append((line_no, "amount"))
+        category = _cell(row, index, "category")
+        if category == "":
+            row_errors.append((line_no, "category"))
+
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        assert day is not None and amount is not None
+        if category_map is not None:
+            category = category_map.get(category, category)
+        memo = _cell(row, index, "memo") if "memo" in index else ""
+        expenses.append(Expense(day=day, category=category, amount=amount, memo=memo))
+
+    return expenses, errors
