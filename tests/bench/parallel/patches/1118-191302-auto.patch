+"""Yen formatting helpers."""
+
+from __future__ import annotations
+
+
+def yen(n: int) -> str:
+    """Format an integer yen amount with thousands separators and a 円 suffix.
+
+    >>> yen(1234567)
+    '1,234,567円'
+    >>> yen(-1200)
+    '-1,200円'
+    """
+    return f"{n:,}円"
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
new file mode 100644
index 0000000..160e7a5
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,99 @@
+"""Month-over-month comparison of expenses by category."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def _month_of(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+
+    prev_totals: dict[str, int] = {}
+    curr_totals: dict[str, int] = {}
+    prev_seen: set[str] = set()
+    curr_seen: set[str] = set()
+    for e in rows:
+        m = _month_of(e)
+        if m == prev_month:
+            prev_totals[e.category] = prev_totals.get(e.category, 0) + e.amount
+            prev_seen.add(e.category)
+        elif m == curr_month:
+            curr_totals[e.category] = curr_totals.get(e.category, 0) + e.amount
+            curr_seen.add(e.category)
+
+    out: list[DiffRow] = []
+    for cat in prev_seen | curr_seen:
+        prev = prev_totals.get(cat, 0)
+        curr = curr_totals.get(cat, 0)
+        delta = curr - prev
+        pct = None if prev == 0 else round(delta / prev * 100, 1)
+        if cat not in prev_seen:
+            status = "new"
+        elif cat not in curr_seen:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+
+    out.sort(key=lambda d: (-abs(d.delta), d.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    moved = [d for d in diffs if d.status != "same"]
+    return moved[:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for d in diffs:
+        if d.pct is None:
+            pct = "-"
+        else:
+            # Avoid "-0.0%" for a value that rounds to zero.
+            value = 0.0 if d.pct == 0 else d.pct
+            pct = f"{value:+.1f}%"
+        lines.append(f"{d.category}\t{d.prev}\t{d.curr}\t{d.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month_of(e) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には 2 か月以上の明細が必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..3f17ca0
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,160 @@
+"""Search query language for Expense rows.
+
+Grammar (lowest precedence first):
+    or_expr  := and_expr ("OR" and_expr)*
+    and_expr := not_expr (["AND"] not_expr)*
+    not_expr := "NOT" not_expr | primary
+    primary  := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+class QueryError(ValueError):
+    """Raised when a search query is invalid."""
+
+
+Token = tuple[str, str]
+
+_OPERATORS = {"AND", "OR", "NOT"}
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    tokens: list[Token] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError("引用符が閉じていません")
+            body = q[i + 1 : end]
+            if body == "":
+                raise QueryError("空の引用符は使えません")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            j = i
+            while j < n and not q[j].isspace() and q[j] not in '()"':
+                j += 1
+            word = q[i:j]
+            i = j
+            if word in _OPERATORS:
+                tokens.append((word, word))
+            elif word.startswith("cat:"):
+                cat = word[len("cat:") :]
+                if cat == "":
+                    raise QueryError("cat: の後ろに値がありません")
+                tokens.append(("CAT", cat))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+# AST nodes: ("term", value) | ("cat", value) | ("not", node)
+#            | ("and", left, right) | ("or", left, right)
+_PRIMARY_START = {"TERM", "CAT", "LPAREN", "NOT"}
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self.tokens = tokens
+        self.pos = 0
+
+    def _peek_kind(self) -> str | None:
+        return self.tokens[self.pos][0] if self.pos < len(self.tokens) else None
+
+    def _take(self) -> Token:
+        tok = self.tokens[self.pos]
+        self.pos += 1
+        return tok
+
+    def parse(self) -> tuple:
+        if not self.tokens:
+            raise QueryError("クエリが空です")
+        node = self._or_expr()
+        if self.pos != len(self.tokens):
+            raise QueryError("構文が不正です(括弧が合っていない可能性があります)")
+        return node
+
+    def _or_expr(self) -> tuple:
+        node = self._and_expr()
+        while self._peek_kind() == "OR":
+            self._take()
+            node = ("or", node, self._and_expr())
+        return node
+
+    def _and_expr(self) -> tuple:
+        node = self._not_expr()
+        while True:
+            kind = self._peek_kind()
+            if kind == "AND":
+                self._take()
+                node = ("and", node, self._not_expr())
+            elif kind in _PRIMARY_START:
+                node = ("and", node, self._not_expr())
+            else:
+                return node
+
+    def _not_expr(self) -> tuple:
+        if self._peek_kind() == "NOT":
+            self._take()
+            return ("not", self._not_expr())
+        return self._primary()
+
+    def _primary(self) -> tuple:
+        kind = self._peek_kind()
+        if kind == "TERM":
+            return ("term", self._take()[1])
+        if kind == "CAT":
+            return ("cat", self._take()[1])
+        if kind == "LPAREN":
+            self._take()
+            node = self._or_expr()
+            if self._peek_kind() != "RPAREN":
+                raise QueryError("括弧が閉じていません")
+            self._take()
+            return node
+        if kind is None:
+            raise QueryError("項がありません")
+        raise QueryError(f"構文が不正です: {self.tokens[self.pos][1]!r}")
+
+
+def _parse(q: str) -> tuple:
+    return _Parser(tokenize(q)).parse()
+
+
+def _eval(node: tuple, e: Expense) -> bool:
+    kind = node[0]
+    if kind == "term":
+        v = node[1].casefold()
+        return v in e.memo.casefold() or v in e.category.casefold()
+    if kind == "cat":
+        return node[1].casefold() == e.category.casefold()
+    if kind == "not":
+        return not _eval(node[1], e)
+    if kind == "and":
+        return _eval(node[1], e) and _eval(node[2], e)
+    if kind == "or":
+        return _eval(node[1], e) or _eval(node[2], e)
+    raise AssertionError(f"unknown node: {kind!r}")
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _eval(_parse(q), e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    tree = _parse(q)
+    return [e for e in rows if _eval(tree, e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..1a4b32c
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,69 @@
+"""Detect recurring expenses (same category and amount, roughly monthly)."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day in the next month, clamped to that month's last day."""
+    year = d.year + d.month // 12
+    month = d.month % 12 + 1
+    last_day = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last_day))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def _connected(prev: date, nxt: date, tolerance: int) -> bool:
+    return abs((nxt - add_month(prev)).days) <= tolerance
+
+
+def _runs(days: list[date], tolerance: int) -> list[list[date]]:
+    """Split sorted, unique dates into maximal runs where neighbours are connected."""
+    runs: list[list[date]] = []
+    for d in days:
+        if runs and _connected(runs[-1][-1], d, tolerance):
+            runs[-1].append(d)
+        else:
+            runs.append([d])
+    return runs
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError(f"min_count は 2 以上である必要があります: {min_count}")
+    if tolerance < 0:
+        raise ValueError(f"tolerance は 0 以上である必要があります: {tolerance}")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    out: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        for run in _runs(sorted(day_set), tolerance):
+            if len(run) >= min_count:
+                out.append(
+                    Recurring(
+                        category=category,
+                        amount=amount,
+                        days=tuple(run),
+                        next_expected=add_month(run[-1]),
+                    )
+                )
+
+    out.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return out
