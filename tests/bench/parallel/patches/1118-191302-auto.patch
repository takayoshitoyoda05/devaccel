@@ -0,0 +1,72 @@
+import json
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.export import to_json
+
+
+def test_empty_list_gives_empty_array() -> None:
+    assert to_json([]) == "[]"
+
+
+def test_single_row_exact_output() -> None:
+    rows = [Expense(date(2024, 3, 5), "食費", 1200, "昼")]
+    assert to_json(rows) == (
+        '[{"date": "2024-03-05", "category": "食費", "amount": 1200, "memo": "昼"}]'
+    )
+
+
+def test_keys_in_fixed_order() -> None:
+    rows = [Expense(date(2024, 1, 1), "a", 1, "m")]
+    assert list(json.loads(to_json(rows))[0].keys()) == [
+        "date",
+        "category",
+        "amount",
+        "memo",
+    ]
+
+
+def test_preserves_input_order() -> None:
+    rows = [
+        Expense(date(2024, 2, 1), "b", 2),
+        Expense(date(2024, 1, 1), "a", 1),
+    ]
+    data = json.loads(to_json(rows))
+    assert [r["category"] for r in data] == ["b", "a"]
+
+
+def test_duplicate_amounts_are_kept() -> None:
+    rows = [
+        Expense(date(2024, 1, 1), "食費", 500),
+        Expense(date(2024, 1, 1), "食費", 500),
+    ]
+    assert len(json.loads(to_json(rows))) == 2
+
+
+def test_empty_memo_is_empty_string() -> None:
+    rows = [Expense(date(2024, 1, 1), "食費", 500)]
+    assert json.loads(to_json(rows))[0]["memo"] == ""
+
+
+def test_non_ascii_not_escaped() -> None:
+    rows = [Expense(date(2024, 1, 1), "交通費", 100, "電車")]
+    out = to_json(rows)
+    assert "交通費" in out
+    assert "\\u" not in out
+
+
+def test_no_indentation_or_newlines() -> None:
+    rows = [Expense(date(2024, 1, 1), "食費", 500, "x")]
+    assert "\n" not in to_json(rows)
+
+
+def test_date_is_zero_padded_iso() -> None:
+    rows = [Expense(date(2024, 1, 9), "食費", 500)]
+    assert json.loads(to_json(rows))[0]["date"] == "2024-01-09"
+
+
+def test_amount_is_integer_json_number() -> None:
+    rows = [Expense(date(2024, 1, 1), "食費", 1234)]
+    value = json.loads(to_json(rows))[0]["amount"]
+    assert value == 1234
+    assert isinstance(value, int)
