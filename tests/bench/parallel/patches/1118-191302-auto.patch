@@ -0,0 +1,16 @@
+"""Totals grouped by day of the week."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+WEEKDAYS = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
+
+
+def total_by_weekday(rows: list[Expense]) -> dict[str, int]:
+    """{"Mon".."Sun": yen}; weekdays without records are omitted, keys Mon-first."""
+    sums: dict[str, int] = {}
+    for e in rows:
+        name = WEEKDAYS[e.day.weekday()]
+        sums[name] = sums.get(name, 0) + e.amount
+    return {name: sums[name] for name in WEEKDAYS if name in sums}
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..d0e4db5
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,244 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import (
+    DEFAULT_MAPPING,
+    import_rows,
+    parse_amount,
+    parse_date,
+)
+from kakeibo.core import Expense
+
+# --- parse_amount ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥1200", 1200),
+        ("￥5", 5),
+        ("-980円", -980),
+        ("1,,2", 12),  # カンマの位置は検査しない
+        ("\t42\n", 42),
+    ],
+)
+def test_parse_amount_accepts(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "   ",
+        "円",
+        "12.5",
+        "1 200",
+        "--5",
+        "¥-5",
+        "１２３",
+        "+5",
+        "-円",
+        "¥",
+        ",5",
+        "5円円",
+        "5元",
+    ],
+)
+def test_parse_amount_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+# --- parse_date -----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        ("2026/01/05", date(2026, 1, 5)),
+        ("2026-1-5", date(2026, 1, 5)),
+        (" 2026/12/31 ", date(2026, 12, 31)),
+        ("2024/2/29", date(2024, 2, 29)),
+    ],
+)
+def test_parse_date_accepts(text: str, expected: date) -> None:
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026/1-5",
+        "2026-1/5",
+        "26/1/5",
+        "2026/02/30",
+        "2025/2/29",
+        "2026/13/1",
+        "2026/1/0",
+        "",
+        "2026",
+        "2026/1/5/1",
+        "２０２６/1/5",
+        "2026.1.5",
+        "2026/001/5",
+    ],
+)
+def test_parse_date_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+# --- import_rows ----------------------------------------------------------
+
+
+def test_default_mapping_values() -> None:
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_basic_import_with_default_mapping() -> None:
+    text = '利用日,分類,利用金額,利用店名\n2026/1/5,食費,"¥1,200",スーパー\n'
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 1200, "スーパー")]
+
+
+def test_quoted_comma_in_value() -> None:
+    text = '利用日,分類,利用金額,利用店名\n2026/1/5,食費,"1,200","A, B"\n'
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 1200, "A, B")]
+
+
+def test_extra_columns_ignored() -> None:
+    text = "x,利用日,分類,利用金額,利用店名,y\n1,2026/1/5,食費,100,店,2\n"
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "店")]
+
+
+def test_values_are_stripped_and_category_mapped() -> None:
+    text = "利用日,分類,利用金額,利用店名\n 2026/1/5 , 外食 , 300 ,  店  \n"
+    rows, errors = import_rows(text, category_map={"外食": "食費"})
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 300, "店")]
+
+
+def test_category_map_only_replaces_matching_keys() -> None:
+    text = "利用日,分類,利用金額,利用店名\n2026/1/5,交通,300,\n2026/1/6,食費,400,\n"
+    rows, errors = import_rows(text, category_map={"食費": "食料"})
+    assert errors == []
+    assert [r.category for r in rows] == ["交通", "食料"]
+
+
+def test_category_map_applied_after_strip() -> None:
+    text = "利用日,分類,利用金額,利用店名\n2026/1/5, 外食 ,300,\n"
+    rows, _ = import_rows(text, category_map={"外食": "食費"})
+    assert rows[0].category == "食費"
+
+
+def test_custom_mapping_and_memo_omitted() -> None:
+    text = "日付,費目,金額\n2026-1-5,食費,300\n"
+    mapping = {"date": "日付", "category": "費目", "amount": "金額"}
+    rows, errors = import_rows(text, mapping=mapping)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 300, "")]
+
+
+def test_memo_column_listed_but_missing_in_header_raises() -> None:
+    text = "日付,費目,金額\n2026-1-5,食費,300\n"
+    mapping = {"date": "日付", "category": "費目", "amount": "金額", "memo": "店"}
+    with pytest.raises(ValueError):
+        import_rows(text, mapping=mapping)
+
+
+@pytest.mark.parametrize("missing", ["date", "category", "amount"])
+def test_mapping_missing_required_key_raises(missing: str) -> None:
+    mapping = {k: v for k, v in DEFAULT_MAPPING.items() if k != missing}
+    with pytest.raises(ValueError):
+        import_rows("利用日,分類,利用金額,利用店名\n", mapping=mapping)
+
+
+def test_mapping_column_not_in_header_raises() -> None:
+    text = "利用日,分類,利用店名\n2026/1/5,食費,店\n"
+    with pytest.raises(ValueError):
+        import_rows(text)
+
+
+def test_error_per_field_collected_in_order() -> None:
+    text = "利用日,分類,利用金額,利用店名\n2026/02/30,,abc,店\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "date"), (2, "amount"), (2, "category")]
+
+
+def test_only_category_error_in_row() -> None:
+    text = "利用日,分類,利用金額,利用店名\n2026/1/5,   ,300,店\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "category")]
+
+
+def test_row_with_error_excluded_others_kept_in_order() -> None:
+    text = (
+        "利用日,分類,利用金額,利用店名\n"
+        "2026/1/5,食費,100,A\n"
+        "bad,食費,100,B\n"
+        "2026/1/7,交通,200,C\n"
+    )
+    rows, errors = import_rows(text)
+    assert errors == [(3, "date")]
+    assert [r.memo for r in rows] == ["A", "C"]
+
+
+def test_blank_lines_skipped_but_counted() -> None:
+    text = "利用日,分類,利用金額,利用店名\n\n2026/1/5,食費,100,A\n\nx,食費,100,B\n"
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "A")]
+    assert errors == [(5, "date")]
+
+
+def test_short_row_missing_values_treated_as_empty() -> None:
+    text = "利用日,分類,利用金額,利用店名\n2026/1/5,食費\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "amount")]
+
+
+def test_short_row_missing_memo_gives_empty_memo_when_memo_mapped() -> None:
+    text = "利用日,分類,利用金額,利用店名\n2026/1/5,食費,100\n"
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+def test_line_number_of_multiline_record_is_start_line() -> None:
+    text = '利用日,分類,利用金額,利用店名\n2026/1/5,食費,100,"A\nB"\nbad,食費,100,C\n'
+    rows, errors = import_rows(text)
+    assert [r.memo for r in rows] == ["A\nB"]
+    assert errors == [(4, "date")]
+
+
+def test_empty_text_with_mapping_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows("")
+
+
+def test_header_only_returns_empty() -> None:
+    rows, errors = import_rows("利用日,分類,利用金額,利用店名\n")
+    assert rows == []
+    assert errors == []
diff --git a/tests/test_dupes.py b/tests/test_dupes.py
