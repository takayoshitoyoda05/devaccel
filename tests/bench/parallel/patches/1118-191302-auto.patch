--- /dev/null
+++ b/tests/test_dupes.py
@@ -0,0 +1,69 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.dupes import find_duplicates
+
+D = date(2026, 1, 5)
+
+
+def _e(
+    day: date = D, category: str = "食費", amount: int = 500, memo: str = ""
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+def test_empty_list_has_no_duplicates() -> None:
+    assert find_duplicates([]) == []
+
+
+def test_single_row_has_no_duplicates() -> None:
+    assert find_duplicates([_e()]) == []
+
+
+def test_all_different_rows_have_no_duplicates() -> None:
+    rows = [_e(amount=100), _e(amount=200), _e(amount=300)]
+    assert find_duplicates(rows) == []
+
+
+def test_identical_pair_is_reported() -> None:
+    assert find_duplicates([_e(), _e()]) == [(0, 1)]
+
+
+def test_non_adjacent_pair_is_reported_with_input_indexes() -> None:
+    rows = [_e(amount=1), _e(amount=2), _e(amount=1)]
+    assert find_duplicates(rows) == [(0, 2)]
+
+
+def test_three_identical_rows_yield_all_pairs_in_order() -> None:
+    assert find_duplicates([_e(), _e(), _e()]) == [(0, 1), (0, 2), (1, 2)]
+
+
+def test_ordering_is_by_i_then_j_across_groups() -> None:
+    # 0 and 2 are one group, 1 and 3 another.
+    rows = [_e(amount=1), _e(amount=2), _e(amount=1), _e(amount=2)]
+    assert find_duplicates(rows) == [(0, 2), (1, 3)]
+
+
+def test_memo_difference_is_not_a_duplicate() -> None:
+    assert find_duplicates([_e(memo="a"), _e(memo="b")]) == []
+
+
+def test_empty_memo_matches_empty_memo() -> None:
+    assert find_duplicates([_e(memo=""), _e(memo="")]) == [(0, 1)]
+
+
+def test_day_difference_is_not_a_duplicate() -> None:
+    assert find_duplicates([_e(day=date(2026, 1, 5)), _e(day=date(2026, 1, 6))]) == []
+
+
+def test_category_difference_is_not_a_duplicate() -> None:
+    assert find_duplicates([_e(category="食費"), _e(category="日用品")]) == []
+
+
+def test_amount_difference_is_not_a_duplicate() -> None:
+    assert find_duplicates([_e(amount=500), _e(amount=501)]) == []
+
+
+def test_pairs_are_only_i_less_than_j() -> None:
+    for i, j in find_duplicates([_e(), _e(), _e(), _e()]):
+        assert i < j
