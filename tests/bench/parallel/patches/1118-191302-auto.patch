+++ b/src/kakeibo/stats.py
@@ -0,0 +1,22 @@
+"""Statistics over expense records."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def _median(values: list[int]) -> float:
+    s = sorted(values)
+    n = len(s)
+    mid = n // 2
+    if n % 2 == 1:
+        return float(s[mid])
+    return (s[mid - 1] + s[mid]) / 2
+
+
+def median_by_category(rows: list[Expense]) -> dict[str, float]:
+    """{category: median amount}; categories in ascending name order."""
+    by_cat: dict[str, list[int]] = {}
+    for e in rows:
+        by_cat.setdefault(e.category, []).append(e.amount)
+    return {cat: _median(by_cat[cat]) for cat in sorted(by_cat)}
