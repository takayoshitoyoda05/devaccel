+"""load_csv / monthly_totals の端のケース。実装の現状の振る舞いを固定し、不具合は xfail(strict)で記録する。"""
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import CsvError, Expense, load_csv, monthly_totals
+
+HEADER = "date,category,amount,memo\n"
+
+
+def _write(tmp_path, text, encoding="utf-8"):
+    p = tmp_path / "in.csv"
+    p.write_bytes(text.encode(encoding))
+    return p
+
+
+def _errors(tmp_path, body, header=HEADER):
+    with pytest.raises(CsvError) as ei:
+        load_csv(_write(tmp_path, header + body))
+    return ei.value.errors
+
+
+# ---- load_csv: 受け付ける入力 ----
+
+
+@pytest.mark.parametrize("text", ["", HEADER])
+def test_load_csv_empty_or_header_only_is_empty_list(tmp_path, text):
+    assert load_csv(_write(tmp_path, text)) == []
+
+
+def test_load_csv_crlf(tmp_path):
+    p = _write(tmp_path, HEADER.replace("\n", "\r\n") + "2026-11-01,food,1,x\r\n")
+    assert load_csv(p) == [Expense(date(2026, 11, 1), "food", 1, "x")]
+
+
+def test_load_csv_blank_line_skipped_and_line_numbers_still_physical(tmp_path):
+    p = _write(tmp_path, HEADER + "\n2026-11-01,food,1,\n")
+    assert load_csv(p) == [Expense(date(2026, 11, 1), "food", 1, "")]
+    assert _errors(tmp_path, "\nbad,food,1,\n")[0][0] == 3
+
+
+def test_load_csv_extra_column_ignored(tmp_path):
+    p = _write(tmp_path, HEADER + "2026-11-01,food,1,m,zzz\n")
+    assert load_csv(p) == [Expense(date(2026, 11, 1), "food", 1, "m")]
+
+
+def test_load_csv_memo_column_optional(tmp_path):
+    p = _write(tmp_path, "date,category,amount\n2026-11-01,food,1\n")
+    assert load_csv(p) == [Expense(date(2026, 11, 1), "food", 1, "")]
+
+
+def test_load_csv_category_is_stripped_but_memo_is_not(tmp_path):
+    p = _write(tmp_path, HEADER + "2026-11-01,  food ,1, m \n")
+    assert load_csv(p) == [Expense(date(2026, 11, 1), "food", 1, " m ")]
+
+
+def test_load_csv_negative_and_zero_amounts_kept(tmp_path):
+    p = _write(tmp_path, HEADER + "2026-11-01,food,-300,\n2026-11-02,food,0,\n")
+    assert [e.amount for e in load_csv(p)] == [-300, 0]
+
+
+def test_load_csv_quoted_comma_and_newline_in_fields(tmp_path):
+    p = _write(tmp_path, HEADER + '2026-11-01,"a,b",1,"x\ny"\n')
+    assert load_csv(p) == [Expense(date(2026, 11, 1), "a,b", 1, "x\ny")]
+
+
+def test_load_csv_multiline_record_error_line_is_following_record(tmp_path):
+    body = '2026-11-01,food,1,"a\nb"\n2026-11-02,food,x,\n'
+    assert [n for n, _ in _errors(tmp_path, body)] == [4]
+
+
+# ---- load_csv: 拒否する入力 ----
+
+
+@pytest.mark.parametrize("amount", ["12.5", "1,234", "", "abc", "5円"])
+def test_load_csv_rejects_non_integer_amount(tmp_path, amount):
+    body = f'2026-11-01,food,"{amount}",\n'
+    errs = _errors(tmp_path, body)
+    assert errs[0][0] == 2 and "金額" in errs[0][1]
+
+
+@pytest.mark.parametrize(
+    "day", ["2026/11/01", "2026-02-30", "2026-13-01", " 2026-11-01", "", "11-01"]
+)
+def test_load_csv_rejects_bad_date(tmp_path, day):
+    errs = _errors(tmp_path, f'"{day}",food,1,\n')
+    assert errs[0][0] == 2 and "日付" in errs[0][1]
+
+
+def test_load_csv_accepts_leap_day_only_in_leap_year(tmp_path):
+    assert load_csv(_write(tmp_path, HEADER + "2024-02-29,food,1,\n"))
+    assert _errors(tmp_path, "2026-02-29,food,1,\n")[0][0] == 2
+
+
+def test_load_csv_one_bad_row_reports_one_error_even_with_two_bad_fields(tmp_path):
+    assert len(_errors(tmp_path, "bad,food,abc,\n")) == 1
+
+
+@pytest.mark.parametrize("missing", ["date", "category", "amount"])
+def test_load_csv_missing_header_column_reported_per_row(tmp_path, missing):
+    cols = [c for c in ("date", "category", "amount") if c != missing]
+    header = ",".join(cols) + "\n"
+    errs = _errors(tmp_path, "2026-11-01,food\n2026-11-02,food\n", header=header)
+    assert [n for n, _ in errs] == [2, 3]
+    assert all(missing in why for _, why in errs)
+
+
+def test_load_csv_short_row_reports_missing_column(tmp_path):
+    errs = _errors(tmp_path, "2026-11-01,food\n")
+    assert errs[0][0] == 2 and "amount" in errs[0][1]
+
+
+# ---- load_csv: 既知の不具合(直さず xfail で記録) ----
+
+
+@pytest.mark.xfail(
+    strict=True, reason="BOM 付き UTF-8(Excel 出力)を読めない: 列 date がありません"
+)
+def test_load_csv_accepts_utf8_bom(tmp_path):
+    p = _write(tmp_path, "﻿" + HEADER + "2026-11-01,food,1,\n")
+    assert load_csv(p) == [Expense(date(2026, 11, 1), "food", 1, "")]
+
+
+@pytest.mark.xfail(
+    strict=True, reason="桁区切りの _ を含む 1_000 が 1000 として通る(int() の仕様)"
+)
+def test_load_csv_rejects_underscore_in_amount(tmp_path):
+    with pytest.raises(CsvError):
+        load_csv(_write(tmp_path, HEADER + "2026-11-01,food,1_000,\n"))
+
+
+@pytest.mark.xfail(
+    strict=True,
+    reason="UTF-8 以外(cp932)で CsvError でなく UnicodeDecodeError が漏れる",
+)
+def test_load_csv_non_utf8_is_csv_error(tmp_path):
+    p = _write(tmp_path, HEADER + "2026-11-01,食費,1,\n", encoding="cp932")
+    with pytest.raises(CsvError):
+        load_csv(p)
+
+
+# ---- monthly_totals ----
+
+
+def test_monthly_totals_empty():
+    assert monthly_totals([]) == {}
+
+
+def test_monthly_totals_year_boundary_sorted_ascending():
+    rows = [
+        Expense(date(2027, 1, 1), "food", 3),
+        Expense(date(2026, 12, 31), "food", 2),
+        Expense(date(2026, 2, 1), "food", 1),
+    ]
+    assert list(monthly_totals(rows)) == ["2026-02", "2026-12", "2027-01"]
+
+
+def test_monthly_totals_same_month_different_year_not_merged():
+    rows = [
+        Expense(date(2025, 11, 5), "food", 1),
+        Expense(date(2026, 11, 5), "food", 2),
+    ]
+    assert monthly_totals(rows) == {"2025-11": {"food": 1}, "2026-11": {"food": 2}}
+
+
+def test_monthly_totals_month_boundaries_and_leap_day():
+    rows = [
+        Expense(date(2024, 2, 29), "a", 1),
+        Expense(date(2024, 3, 1), "a", 10),
+        Expense(date(2024, 1, 31), "a", 100),
+    ]
+    assert monthly_totals(rows) == {
+        "2024-01": {"a": 100},
+        "2024-02": {"a": 1},
+        "2024-03": {"a": 10},
+    }
+
+
+def test_monthly_totals_missing_month_is_not_filled():
+    rows = [Expense(date(2026, 1, 1), "a", 1), Expense(date(2026, 3, 1), "a", 1)]
+    assert list(monthly_totals(rows)) == ["2026-01", "2026-03"]
+
+
+def test_monthly_totals_ties_keep_first_seen_order():
+    rows = [
+        Expense(date(2026, 11, 1), "b", 5),
+        Expense(date(2026, 11, 2), "a", 5),
+        Expense(date(2026, 11, 3), "c", 9),
+    ]
+    assert list(monthly_totals(rows)["2026-11"]) == ["c", "b", "a"]
+
+
+def test_monthly_totals_refund_nets_and_negative_total_sorts_last():
+    rows = [
+        Expense(date(2026, 11, 1), "food", 1000),
+        Expense(date(2026, 11, 2), "food", -300),
+        Expense(date(2026, 11, 3), "gift", -50),
+        Expense(date(2026, 11, 4), "zero", 0),
+    ]
+    out = monthly_totals(rows)["2026-11"]
+    assert out == {"food": 700, "zero": 0, "gift": -50}
+    assert list(out) == ["food", "zero", "gift"]
+
+
+def test_monthly_totals_does_not_mutate_input_order():
+    rows = [Expense(date(2026, 12, 1), "a", 1), Expense(date(2026, 1, 1), "a", 1)]
+    snapshot = list(rows)
+    monthly_totals(rows)
+    assert rows == snapshot
