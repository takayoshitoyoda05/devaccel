+"""Pure budget status evaluation: over-budget and near-limit alerts.
+
+Builds on ``core.Budget`` / ``core.monthly_totals``; performs no I/O.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Literal
+
+from kakeibo.core import Budget
+
+Status = Literal["over", "near"]
+
+DEFAULT_NEAR_PERCENT = 80
+
+
+@dataclass(frozen=True)
+class BudgetAlert:
+    month: str
+    category: str
+    status: Status
+    limit: int
+    actual: int
+
+    @property
+    def over(self) -> int:
+        """Yen over the limit (0 unless status == "over")."""
+        return max(0, self.actual - self.limit)
+
+    @property
+    def remaining(self) -> int:
+        """Yen left before the limit (0 once over)."""
+        return max(0, self.limit - self.actual)
+
+
+def classify(
+    actual: int, limit: int, near_percent: int = DEFAULT_NEAR_PERCENT
+) -> Status | None:
+    """"over" if actual > limit, "near" if actual >= near_percent% of limit.
+
+    Integer arithmetic only. A limit of 0 is "over" for any spend, never "near".
+    """
+    if not 0 < near_percent <= 100:
+        raise ValueError(f"near_percent は 1〜100 である必要があります: {near_percent}")
+    if actual > limit:
+        return "over"
+    if limit > 0 and actual * 100 >= limit * near_percent:
+        return "near"
+    return None
+
+
+def evaluate(
+    totals: dict[str, dict[str, int]],
+    budget: Budget,
+    near_percent: int = DEFAULT_NEAR_PERCENT,
+) -> list[BudgetAlert]:
+    """Alerts for every (month, category) that is over or near its limit.
+
+    Order follows ``totals`` (months, then categories). Categories without a
+    budget are ignored.
+    """
+    out: list[BudgetAlert] = []
+    for month, cats in totals.items():
+        limits = budget.for_month(month)
+        for cat, actual in cats.items():
+            if cat not in limits:
+                continue
+            status = classify(actual, limits[cat], near_percent)
+            if status is not None:
+                out.append(BudgetAlert(month, cat, status, limits[cat], actual))
+    return out
+
+
+def format_alert(a: BudgetAlert) -> str:
+    detail = f"予算 {a.limit:,} / 実績 {a.actual:,}"
+    if a.status == "over":
+        return f"警告: {a.month} {a.category} {a.over:,}円超過 ({detail})"
+    return f"注意: {a.month} {a.category} 予算まで残り {a.remaining:,}円 ({detail})"
diff --git a/tests/test_budget_status.py b/tests/test_budget_status.py
new file mode 100644
index 0000000..5fff26e
--- /dev/null
+++ b/tests/test_budget_status.py
@@ -0,0 +1,70 @@
+import pytest
+
+from kakeibo.budget_status import BudgetAlert, classify, evaluate, format_alert
+from kakeibo.core import Budget
+
+
+@pytest.mark.parametrize(
+    "actual,limit,expected",
+    [
+        (0, 1000, None),
+        (799, 1000, None),
+        (800, 1000, "near"),
+        (1000, 1000, "near"),  # ちょうどは超過ではない
+        (1001, 1000, "over"),
+        (0, 0, None),
+        (1, 0, "over"),
+    ],
+)
+def test_classify(actual, limit, expected):
+    assert classify(actual, limit) == expected
+
+
+def test_classify_custom_percent():
+    assert classify(500, 1000, 50) == "near"
+    assert classify(499, 1000, 50) is None
+    assert classify(999, 1000, 100) is None
+    assert classify(1000, 1000, 100) == "near"
+
+
+@pytest.mark.parametrize("pct", [0, -1, 101])
+def test_classify_rejects_bad_percent(pct):
+    with pytest.raises(ValueError):
+        classify(1, 10, pct)
+
+
+def test_evaluate():
+    b = Budget({"food": 1000, "rent": 80000, "fun": 500}, {"2026-11": {"fun": 100}})
+    totals = {
+        "2026-10": {"food": 900, "misc": 99999},
+        "2026-11": {"rent": 80000, "food": 1150, "fun": 90, "misc": 5},
+    }
+    assert evaluate(totals, b) == [
+        BudgetAlert("2026-10", "food", "near", 1000, 900),
+        BudgetAlert("2026-11", "rent", "near", 80000, 80000),
+        BudgetAlert("2026-11", "food", "over", 1000, 1150),
+        BudgetAlert("2026-11", "fun", "near", 100, 90),
+    ]
+
+
+def test_evaluate_empty_and_no_budget():
+    assert evaluate({}, Budget({"food": 1}, {})) == []
+    assert evaluate({"2026-11": {"food": 10**6}}, Budget({}, {})) == []
+
+
+def test_alert_amounts():
+    over = BudgetAlert("2026-11", "food", "over", 1000, 1150)
+    near = BudgetAlert("2026-11", "food", "near", 1000, 900)
+    assert (over.over, over.remaining) == (150, 0)
+    assert (near.over, near.remaining) == (0, 100)
+
+
+def test_format_alert():
+    assert (
+        format_alert(BudgetAlert("2026-11", "food", "over", 1000, 2000))
+        == "警告: 2026-11 food 1,000円超過 (予算 1,000 / 実績 2,000)"
+    )
+    assert (
+        format_alert(BudgetAlert("2026-11", "food", "near", 1000, 900))
+        == "注意: 2026-11 food 予算まで残り 100円 (予算 1,000 / 実績 900)"
+    )
