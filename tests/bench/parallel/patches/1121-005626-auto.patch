@@ -0,0 +1,278 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def E(y: int, m: int, cat: str, amount: int) -> Expense:
+    return Expense(date(y, m, 1), cat, amount)
+
+
+# --- D1: 月の形式 ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "prev, curr",
+    [
+        ("2026-1", "2026-02"),
+        ("2026-01", "2026/02"),
+        ("26-01", "2026-02"),
+        ("2026-00", "2026-02"),
+        ("2026-13", "2026-02"),
+        ("2026-01", "2026-1"),
+        ("2026-01", ""),
+        (" 2026-01", "2026-02"),
+    ],
+)
+def test_month_format_must_be_yyyy_mm(prev, curr):
+    with pytest.raises(ValueError):
+        month_diff([], prev, curr)
+
+
+def test_month_format_accepts_december_and_january():
+    assert (
+        month_diff([E(2025, 12, "food", 100)], "2025-12", "2026-01")[0].category
+        == "food"
+    )
+
+
+# --- D2 / D3 / D4: 行・status・pct ---------------------------------------
+
+
+def test_month_diff_empty_rows_gives_no_lines():
+    assert month_diff([], "2026-10", "2026-11") == []
+
+
+def test_month_diff_category_only_in_prev_is_gone_with_curr_zero():
+    rows = [E(2026, 10, "tax", 500)]
+    (r,) = month_diff(rows, "2026-10", "2026-11")
+    assert r == DiffRow("tax", 500, 0, -500, -100.0, "gone")
+
+
+def test_month_diff_category_only_in_curr_is_new_with_pct_none():
+    rows = [E(2026, 11, "gift", 3000)]
+    (r,) = month_diff(rows, "2026-10", "2026-11")
+    assert r == DiffRow("gift", 0, 3000, 3000, None, "new")
+
+
+def test_month_diff_zero_prev_with_curr_rows_is_new_not_div_by_zero():
+    rows = [E(2026, 10, "food", 0), E(2026, 11, "food", 300)]
+    (r,) = month_diff(rows, "2026-10", "2026-11")
+    assert r == DiffRow("food", 0, 300, 300, None, "up")
+
+
+def test_month_diff_zero_total_with_rows_is_same_not_gone():
+    # 明細はあるが合計 0: status は明細の有無で決まる。delta 0 なので same。
+    rows = [E(2026, 10, "food", 100), E(2026, 10, "food", -100), E(2026, 11, "food", 0)]
+    (r,) = month_diff(rows, "2026-10", "2026-11")
+    assert r.status == "same"
+    assert r.delta == 0
+    assert r.pct is None  # prev == 0
+
+
+def test_month_diff_up_and_down_statuses_and_pct():
+    rows = [
+        E(2026, 10, "food", 1000),
+        E(2026, 11, "food", 1200),
+        E(2026, 10, "rent", 2000),
+        E(2026, 11, "rent", 1000),
+    ]
+    by = {r.category: r for r in month_diff(rows, "2026-10", "2026-11")}
+    assert by["food"] == DiffRow("food", 1000, 1200, 200, 20.0, "up")
+    assert by["rent"] == DiffRow("rent", 2000, 1000, -1000, -50.0, "down")
+
+
+def test_month_diff_pct_is_rounded_to_one_decimal():
+    rows = [E(2026, 10, "food", 3), E(2026, 11, "food", 4)]
+    (r,) = month_diff(rows, "2026-10", "2026-11")
+    assert r.pct == round(1 / 3 * 100, 1)
+
+
+def test_month_diff_sums_multiple_rows_per_month():
+    rows = [
+        E(2026, 10, "food", 100),
+        E(2026, 10, "food", 200),
+        E(2026, 11, "food", 50),
+        E(2026, 11, "food", 50),
+    ]
+    (r,) = month_diff(rows, "2026-10", "2026-11")
+    assert (r.prev, r.curr, r.delta) == (300, 100, -200)
+
+
+def test_month_diff_ignores_other_months():
+    rows = [
+        E(2026, 9, "food", 9999),
+        E(2026, 10, "food", 100),
+        E(2026, 11, "food", 100),
+        E(2026, 12, "food", 7),
+    ]
+    (r,) = month_diff(rows, "2026-10", "2026-11")
+    assert r == DiffRow("food", 100, 100, 0, 0.0, "same")
+
+
+# --- D5: 並び ---------------------------------------------------------------
+
+
+def test_month_diff_sorted_by_abs_delta_desc_then_category_asc():
+    rows = [
+        E(2026, 10, "b", 100),
+        E(2026, 11, "b", 0),  # delta -100
+        E(2026, 10, "a", 500),
+        E(2026, 11, "a", 600),  # delta +100
+        E(2026, 10, "c", 1000),
+        E(2026, 11, "c", 1000),  # delta 0
+        E(2026, 11, "d", 300),  # delta +300 (new)
+    ]
+    cats = [r.category for r in month_diff(rows, "2026-10", "2026-11")]
+    assert cats == ["d", "a", "b", "c"]
+
+
+# --- D6: top_movers -------------------------------------------------------
+
+
+def _row(cat: str, delta: int, status: str) -> DiffRow:
+    return DiffRow(cat, 0, delta, delta, None, status)
+
+
+def test_top_movers_drops_same_and_keeps_order():
+    diffs = [
+        _row("a", 500, "up"),
+        _row("b", 0, "same"),
+        _row("c", -300, "down"),
+        _row("d", 100, "up"),
+    ]
+    assert [r.category for r in top_movers(diffs)] == ["a", "c", "d"]
+
+
+def test_top_movers_takes_first_n():
+    diffs = [_row("a", 5, "up"), _row("b", -4, "down"), _row("c", 3, "up")]
+    assert [r.category for r in top_movers(diffs, 2)] == ["a", "b"]
+
+
+def test_top_movers_n_zero_is_empty():
+    assert top_movers([_row("a", 5, "up")], 0) == []
+
+
+def test_top_movers_n_larger_than_list_returns_all_non_same():
+    diffs = [_row("a", 5, "up"), _row("b", 0, "same")]
+    assert [r.category for r in top_movers(diffs, 10)] == ["a"]
+
+
+def test_top_movers_empty_input():
+    assert top_movers([]) == []
+
+
+def test_top_movers_default_n_is_3():
+    diffs = [_row(str(i), i + 1, "up") for i in range(5)]
+    assert len(top_movers(diffs)) == 3
+
+
+def test_top_movers_negative_n_raises():
+    with pytest.raises(ValueError):
+        top_movers([_row("a", 5, "up")], -1)
+
+
+def test_top_movers_does_not_treat_gone_or_new_as_same():
+    diffs = [_row("a", -10, "gone"), _row("b", 10, "new")]
+    assert [r.status for r in top_movers(diffs)] == ["gone", "new"]
+
+
+# --- D7: render_diff -------------------------------------------------------
+
+
+def test_render_diff_header_and_signed_rows():
+    diffs = [
+        DiffRow("food", 1000, 1200, 200, 20.0, "up"),
+        DiffRow("rent", 2000, 1000, -1000, -50.0, "down"),
+        DiffRow("misc", 100, 100, 0, 0.0, "same"),
+        DiffRow("gift", 0, 3000, 3000, None, "new"),
+        DiffRow("tax", 500, 0, -500, -100.0, "gone"),
+    ]
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "food\t1000\t1200\t+200\t+20.0%\n"
+        "rent\t2000\t1000\t-1000\t-50.0%\n"
+        "misc\t100\t100\t+0\t+0.0%\n"
+        "gift\t0\t3000\t+3000\t-\n"
+        "tax\t500\t0\t-500\t-100.0%"
+    )
+
+
+def test_render_diff_empty_is_header_only_without_trailing_newline():
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_render_diff_no_trailing_newline():
+    assert not render_diff([DiffRow("a", 1, 2, 1, 100.0, "up")]).endswith("\n")
+
+
+def test_month_diff_tiny_negative_pct_rounds_to_plus_zero_not_minus_zero():
+    # -1 / 3000 * 100 = -0.033… → round で -0.0 になるが、符号なしの 0.0 に正規化する。
+    rows = [E(2026, 10, "food", 3000), E(2026, 11, "food", 2999)]
+    (r,) = month_diff(rows, "2026-10", "2026-11")
+    assert r.pct == 0.0
+    assert render_diff([r]).splitlines()[1].endswith("+0.0%")
+
+
+def test_render_diff_negative_zero_pct_shows_plus_zero():
+    assert (
+        render_diff([DiffRow("a", 1, 1, 0, 0.0, "same")])
+        .splitlines()[1]
+        .endswith("+0.0%")
+    )
+
+
+# --- D8: available_months -------------------------------------------------
+
+
+def test_available_months_sorted_unique_and_gaps_not_filled():
+    rows = [
+        E(2026, 11, "food", 1),
+        E(2026, 9, "food", 1),
+        E(2026, 9, "rent", 1),
+        E(2025, 12, "food", 1),
+    ]
+    assert available_months(rows) == ["2025-12", "2026-09", "2026-11"]
+
+
+def test_available_months_empty():
+    assert available_months([]) == []
+
+
+def test_available_months_single_row():
+    assert available_months([E(2026, 1, "food", 1)]) == ["2026-01"]
+
+
+# --- D9: latest_diff ------------------------------------------------------
+
+
+def test_latest_diff_compares_last_two_data_months_skipping_gaps():
+    rows = [
+        E(2026, 8, "food", 100),
+        E(2026, 10, "food", 300),
+        E(2026, 11, "food", 200),
+    ]
+    (r,) = latest_diff(rows)
+    assert r == DiffRow("food", 300, 200, -100, -33.3, "down")
+
+
+def test_latest_diff_uses_previous_data_month_not_calendar_month():
+    rows = [E(2026, 1, "food", 100), E(2026, 3, "food", 150)]
+    (r,) = latest_diff(rows)
+    assert (r.prev, r.curr, r.status) == (100, 150, "up")
+
+
+def test_latest_diff_fewer_than_two_months_raises():
+    with pytest.raises(ValueError):
+        latest_diff([])
+    with pytest.raises(ValueError):
+        latest_diff([E(2026, 1, "food", 1), E(2026, 1, "rent", 1)])
