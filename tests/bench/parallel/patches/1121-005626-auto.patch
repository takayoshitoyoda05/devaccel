@@ -0,0 +1,275 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def _e(
+    y: int, m: int, d: int, category: str = "家賃", amount: int = 80000, memo: str = ""
+) -> Expense:
+    return Expense(day=date(y, m, d), category=category, amount=amount, memo=memo)
+
+
+# --- add_month -------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("start", "expected"),
+    [
+        ("2026-01-31", "2026-02-28"),  # 月末 → 短い翌月の末日
+        ("2024-01-31", "2024-02-29"),  # 閏年の 2 月末
+        ("2025-01-31", "2025-02-28"),  # 非閏年の 2 月末
+        ("2026-03-31", "2026-04-30"),  # 30 日までの月
+        ("2024-02-29", "2024-03-29"),  # 閏日の翌月は同じ日
+        ("2026-12-15", "2027-01-15"),  # 12 月 → 翌年 1 月
+        ("2026-11-30", "2026-12-30"),  # 同じ日が翌月にある
+        ("2026-06-01", "2026-07-01"),  # 月初
+    ],
+    ids=[
+        "month-end-to-short",
+        "leap-feb-end",
+        "non-leap-feb-end",
+        "31-to-30-day-month",
+        "leap-day",
+        "dec-to-jan",
+        "nov-30-to-dec-30",
+        "first-of-month",
+    ],
+)
+def test_add_month(start: str, expected: str) -> None:
+    assert add_month(date.fromisoformat(start)) == date.fromisoformat(expected)
+
+
+# --- 引数の検査 -------------------------------------------------------------
+
+
+@pytest.mark.parametrize("min_count", [1, 0, -1])
+def test_min_count_below_two_raises(min_count: int) -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=min_count)
+
+
+def test_negative_tolerance_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_zero_tolerance_is_allowed() -> None:
+    rows = [_e(2026, 1, 5), _e(2026, 2, 5), _e(2026, 3, 5)]
+    assert len(find_recurring(rows, tolerance=0)) == 1
+
+
+# --- 基本動作 ---------------------------------------------------------------
+
+
+def test_empty_input_returns_empty() -> None:
+    assert find_recurring([]) == []
+
+
+def test_monthly_series_detected() -> None:
+    rows = [_e(2026, 1, 5), _e(2026, 2, 5), _e(2026, 3, 5)]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="家賃",
+            amount=80000,
+            days=(date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+            next_expected=date(2026, 4, 5),
+        )
+    ]
+
+
+def test_below_min_count_not_detected() -> None:
+    rows = [_e(2026, 1, 5), _e(2026, 2, 5)]
+    assert find_recurring(rows, min_count=3) == []
+
+
+def test_min_count_two_detects_pair() -> None:
+    rows = [_e(2026, 1, 5), _e(2026, 2, 5)]
+    result = find_recurring(rows, min_count=2)
+    assert [r.days for r in result] == [(date(2026, 1, 5), date(2026, 2, 5))]
+
+
+def test_input_order_does_not_matter() -> None:
+    rows = [_e(2026, 3, 5), _e(2026, 1, 5), _e(2026, 2, 5)]
+    assert find_recurring(rows)[0].days == (
+        date(2026, 1, 5),
+        date(2026, 2, 5),
+        date(2026, 3, 5),
+    )
+
+
+# --- D: 同一視・重複 ---------------------------------------------------------
+
+
+def test_same_day_duplicates_counted_once() -> None:
+    # 同じ日の 2 件は 1 日として数える。重複で件数が水増しされない。
+    rows = [_e(2026, 1, 5), _e(2026, 1, 5), _e(2026, 2, 5)]
+    assert find_recurring(rows, min_count=3) == []
+    assert find_recurring(rows, min_count=2)[0].days == (
+        date(2026, 1, 5),
+        date(2026, 2, 5),
+    )
+
+
+def test_memo_is_ignored_for_grouping() -> None:
+    rows = [
+        _e(2026, 1, 5, memo="1月分"),
+        _e(2026, 2, 5, memo=""),
+        _e(2026, 3, 5, memo="3月分(修正)"),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_different_category_same_amount_not_grouped() -> None:
+    rows = [
+        _e(2026, 1, 5, category="通信"),
+        _e(2026, 2, 5, category="保険"),
+        _e(2026, 3, 5, category="通信"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_amount_change_is_a_different_series() -> None:
+    # 値上げ(金額が変わる)は同じ系列とみなさない。
+    rows = [
+        _e(2026, 1, 5, amount=1000),
+        _e(2026, 2, 5, amount=1100),
+        _e(2026, 3, 5, amount=1100),
+    ]
+    result = find_recurring(rows, min_count=2)
+    assert [(r.amount, len(r.days)) for r in result] == [(1100, 2)]
+
+
+def test_negative_amount_grouped_by_value() -> None:
+    # 返金(負の金額)は、同じ値の負の系列としてだけ扱う。正の系列とは混ざらない。
+    rows = [
+        _e(2026, 1, 5, amount=-500),
+        _e(2026, 2, 5, amount=-500),
+        _e(2026, 3, 5, amount=-500),
+        _e(2026, 1, 5, amount=500),
+    ]
+    result = find_recurring(rows)
+    assert [(r.amount, len(r.days)) for r in result] == [(-500, 3)]
+
+
+# --- D: 同じカテゴリ・金額で日付の違う 2 系列 ------------------------------
+
+
+def test_same_category_and_amount_on_different_days_split_by_time() -> None:
+    # 同じ (category, amount) でも、期間を分けて続けば日付の連鎖で別の系列になる。
+    rows = [
+        _e(2026, 1, 5, category="サブスク", amount=980),
+        _e(2026, 2, 5, category="サブスク", amount=980),
+        _e(2026, 3, 5, category="サブスク", amount=980),
+        _e(2026, 4, 20, category="サブスク", amount=980),
+        _e(2026, 5, 20, category="サブスク", amount=980),
+        _e(2026, 6, 20, category="サブスク", amount=980),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 5), date(2026, 4, 20)]
+    assert [r.next_expected for r in result] == [date(2026, 4, 5), date(2026, 7, 20)]
+
+
+def test_interleaved_same_amount_series_are_not_detected() -> None:
+    # 5 日と 20 日の 2 系列が同じ月に混在すると、同じ (category, amount) の 1 グループ内で
+    # 連鎖が毎回切れ、どちらも検出されない(グループ化は (category, amount) のみという仕様どおり)。
+    rows = [
+        _e(2026, 1, 5, category="サブスク", amount=980),
+        _e(2026, 1, 20, category="サブスク", amount=980),
+        _e(2026, 2, 5, category="サブスク", amount=980),
+        _e(2026, 2, 20, category="サブスク", amount=980),
+        _e(2026, 3, 5, category="サブスク", amount=980),
+        _e(2026, 3, 20, category="サブスク", amount=980),
+    ]
+    assert find_recurring(rows) == []
+
+
+# --- D: 欠けた月・同じ月に 2 回 ---------------------------------------------
+
+
+def test_missing_month_breaks_series() -> None:
+    # 3 月が無い: 1/5,2/5 と 4/5,5/5 の 2 区間に切れる。
+    rows = [_e(2026, 1, 5), _e(2026, 2, 5), _e(2026, 4, 5), _e(2026, 5, 5)]
+    assert find_recurring(rows, min_count=3) == []
+    result = find_recurring(rows, min_count=2)
+    assert [r.days for r in result] == [
+        (date(2026, 1, 5), date(2026, 2, 5)),
+        (date(2026, 4, 5), date(2026, 5, 5)),
+    ]
+    assert result[0].next_expected == date(2026, 3, 5)
+
+
+def test_two_in_same_month_breaks_chain() -> None:
+    # 1/5 と 1/20 は連鎖しない。2/5 も直前の 1/20 から連鎖しないので 3 件に届かない。
+    rows = [_e(2026, 1, 5), _e(2026, 1, 20), _e(2026, 2, 5), _e(2026, 3, 5)]
+    assert find_recurring(rows, min_count=3) == []
+
+
+# --- D: 連鎖の基準(月末・閏年・年またぎ) --------------------------------------
+
+
+def test_month_end_chain_uses_previous_date() -> None:
+    # 1/31→2/28(月末に丸め)→3/28 と、直前の日付から連鎖を見る。
+    rows = [_e(2026, 1, 31), _e(2026, 2, 28), _e(2026, 3, 28), _e(2026, 4, 28)]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (
+        date(2026, 1, 31),
+        date(2026, 2, 28),
+        date(2026, 3, 28),
+        date(2026, 4, 28),
+    )
+    assert result[0].next_expected == date(2026, 5, 28)
+
+
+def test_next_expected_from_last_date_across_year() -> None:
+    rows = [_e(2026, 11, 15), _e(2026, 12, 15), _e(2027, 1, 15)]
+    result = find_recurring(rows)
+    assert result[0].next_expected == date(2027, 2, 15)
+
+
+def test_leap_day_series() -> None:
+    rows = [_e(2024, 1, 31), _e(2024, 2, 29), _e(2024, 3, 29)]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2024, 4, 29)
+
+
+# --- D: 許容差(tolerance)の境界 ----------------------------------------------
+
+
+def test_tolerance_boundary_inclusive() -> None:
+    # 2/8 は 2/5 から 3 日ずれ。tolerance=3 なら含み、2 なら切れる。
+    rows = [_e(2026, 1, 5), _e(2026, 2, 8), _e(2026, 3, 5)]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+    assert find_recurring(rows, tolerance=2) == []
+
+
+def test_drift_is_not_accumulated_beyond_tolerance_per_step() -> None:
+    # 各ステップで許容差内なら連鎖する。基準は直前の日付(累積ずれで切らない)。
+    rows = [_e(2026, 1, 5), _e(2026, 2, 8), _e(2026, 3, 11), _e(2026, 4, 14)]
+    result = find_recurring(rows, tolerance=3)
+    assert len(result) == 1
+    assert len(result[0].days) == 4
+
+
+# --- 並び順 ----------------------------------------------------------------
+
+
+def test_result_sorted_by_category_amount_then_first_day() -> None:
+    rows = [
+        _e(2026, 1, 5, category="通信", amount=100),
+        _e(2026, 2, 5, category="通信", amount=100),
+        _e(2026, 1, 5, category="家賃", amount=200),
+        _e(2026, 2, 5, category="家賃", amount=200),
+        _e(2026, 1, 5, category="家賃", amount=100),
+        _e(2026, 2, 5, category="家賃", amount=100),
+    ]
+    result = find_recurring(rows, min_count=2)
+    assert [(r.category, r.amount) for r in result] == [
+        ("家賃", 100),
+        ("家賃", 200),
+        ("通信", 100),
+    ]
