index 0000000..8ebf590
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,133 @@
+"""Import bank-statement CSV rows into Expense records (pure functions, stdlib only).
+
+Decisions for the points the spec leaves open:
+
+D1: 区切りは `,` 固定。csv 標準の引用規則に従う(引用内の区切り・改行を値として扱う)。タブ判定はしない。
+D2: 先頭の BOM(U+FEFF)は取り除く。ヘッダーの列名は前後の空白を除いて照合する(大文字小文字は区別する)。
+D3: 行番号は物理行(ヘッダーが 1)。引用符内の改行で複数行にまたがるレコードは、その開始行を報告する。
+    空行は読み飛ばすが行番号は数える。
+D4: 全セルが空白だけの行は空行として読み飛ばす。
+D5: データ行の列が足りないとき、欠けた値は空文字列として扱う。余分な列は無視する。
+D6: 金額は先頭の任意の `-` による負数(返金)を受け付ける。記号 `¥` `￥` `円` と桁区切り `,` は受け付ける。
+    全角数字・小数・空欄・`-` だけ・`—`・括弧や `△` 表記は拒否する。NFKC 正規化はしない。
+D7: 日付・金額の数字は ASCII のみ。日付は存在しない日を拒否する(うるう年は date が判定する)。
+D8: 1 行の誤りは date → amount → category の順にすべて記録する。誤りのある行は明細に含めない。
+D9: 区切りを含む値が引用されていない行は列数の誤りとして修復しない。列がずれた結果は
+    date/amount の誤りとして報告される。
+D10: 空文字列はヘッダーが無いので ValueError。ヘッダーだけの入力は ([], []) を返す。
+D11: category_map は前後の空白を除いた category に対して照合する。
+     mapping に memo が無ければ memo は ""。memo を指定して列が無い場合は ValueError。
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"(-?)[¥￥]?([0-9][0-9,]*)円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    """Parse a bank amount such as ``" ￥1,234 "`` or ``"-300"`` into yen."""
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    sign, digits = m.group(1), m.group(2)
+    value = int(digits.replace(",", ""))
+    return -value if sign else value
+
+
+def parse_date(s: str) -> date:
+    """Parse ``YYYY/M/D`` or ``YYYY-M-D`` (separator must not be mixed)."""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    try:
+        return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Convert a CSV text (header on line 1) into expenses and per-field errors.
+
+    Returns ``(expenses in input order, [(line_number, field), ...])``.
+    """
+    cols = DEFAULT_MAPPING if mapping is None else mapping
+    for key in ("date", "category", "amount"):
+        if key not in cols:
+            raise ValueError(f"mapping に {key} がありません")
+
+    text = text.lstrip("﻿")
+    reader = csv.reader(io.StringIO(text, newline=""))
+    records: list[tuple[int, list[str]]] = []
+    last_line = 0
+    for row in reader:
+        records.append((last_line + 1, row))
+        last_line = reader.line_num
+    if not records:
+        raise ValueError("ヘッダーがありません")
+
+    header = [h.strip() for h in records[0][1]]
+
+    def column(name: str) -> int:
+        if name not in header:
+            raise ValueError(f"CSV に列 {name!r} がありません")
+        return header.index(name)
+
+    idx = {field: column(cols[field]) for field in ("date", "category", "amount")}
+    memo_idx = column(cols["memo"]) if "memo" in cols else None
+    cats = category_map or {}
+
+    rows: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    for line, row in records[1:]:
+        if not any(cell.strip() for cell in row):
+            continue
+
+        def value(i: int | None, row: list[str] = row) -> str:
+            if i is None or i >= len(row):
+                return ""
+            return row[i]
+
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(value(idx["date"]))
+        except ValueError:
+            errors.append((line, "date"))
+        try:
+            amount = parse_amount(value(idx["amount"]))
+        except ValueError:
+            errors.append((line, "amount"))
+        category = value(idx["category"]).strip()
+        if not category:
+            errors.append((line, "category"))
+        if day is None or amount is None or not category:
+            continue
+
+        rows.append(
+            Expense(
+                day=day,
+                category=cats.get(category, category),
+                amount=amount,
+                memo=value(memo_idx).strip(),
+            )
+        )
+    return rows, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
