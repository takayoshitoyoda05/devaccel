index 0000000..d64127b
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,111 @@
+"""Month-over-month comparison of expenses.
+
+D1: 月は "YYYY-MM"(月は 01〜12 の 2 桁)のみ受け付ける。それ以外は ValueError。
+D2: 行は prev_month か curr_month のどちらかに明細があるカテゴリだけ。
+    片方にしか無いカテゴリは、無い側の合計を 0 として扱う。
+D3: status は明細の有無で決める(合計が 0 でも明細があれば new/gone ではない)。
+    prev に明細なし → "new"、curr に明細なし → "gone"、
+    それ以外は delta の符号で "up" / "down" / "same"。
+D4: pct は prev == 0(new を含む)なら None。それ以外は round(delta / prev * 100, 1)。
+    丸めた結果が -0.0 になる場合は 0.0 に正規化する(表示が "-0.0%" にならないように)。
+D5: 並びは abs(delta) の降順、同点は category の昇順。
+D6: top_movers は status == "same" を除き、順序を保って先頭 n 件。
+    n == 0 なら []、n < 0 は ValueError。
+D7: render_diff は空なら見出し行のみ。末尾に改行は付けない。pct が None なら "-"。
+D8: available_months はデータのある月だけを昇順・重複なしで返す。
+    データの無い月は埋めない(欠けた月は飛ばす)。
+D9: latest_diff は available_months の末尾 2 つを (prev, curr) として比べる。
+    間に欠けた月があっても、その隣のデータ月と比べる。データ月が 2 つ未満なら ValueError。
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not isinstance(month, str) or not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def _month_of(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+
+    prev_totals: dict[str, int] = {}
+    curr_totals: dict[str, int] = {}
+    for e in rows:
+        m = _month_of(e)
+        if m == prev_month:
+            prev_totals[e.category] = prev_totals.get(e.category, 0) + e.amount
+        elif m == curr_month:
+            curr_totals[e.category] = curr_totals.get(e.category, 0) + e.amount
+
+    out: list[DiffRow] = []
+    for cat in set(prev_totals) | set(curr_totals):
+        prev = prev_totals.get(cat, 0)
+        curr = curr_totals.get(cat, 0)
+        delta = curr - prev
+        pct: float | None
+        if prev == 0:
+            pct = None
+        else:
+            pct = round(delta / prev * 100, 1) + 0.0  # -0.0 → 0.0
+        if cat not in prev_totals:
+            status = "new"
+        elif cat not in curr_totals:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+
+    out.sort(key=lambda r: (-abs(r.delta), r.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [r for r in diffs if r.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for r in diffs:
+        pct = "-" if r.pct is None else f"{r.pct:+.1f}%"
+        lines.append(f"{r.category}\t{r.prev}\t{r.curr}\t{r.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month_of(e) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には明細のある月が 2 つ以上必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..d3315ec
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,172 @@
+"""Search query language for expenses.
+
+D1: 優先順位は低い順に OR < AND < NOT。NOT は直後の項にだけかかる。
+D2: AND は省略できる。項を空白で並べると AND になる(`a b` は `a AND b`)。
+D3: 空のクエリ・空白だけ・`()` は QueryError。空の AND(真)や空の OR(偽)は作らない。
+D4: 文字列の比較は大文字小文字を区別しない(casefold)。全角と半角は変換せず区別する。
+    TERM は memo か category の部分一致、CAT は category の完全一致。
+D5: 小文字の and / or / not と、cat: 以外の `key:value` 形式は演算子・キーではなく TERM。
+D6: 閉じていない引用、空の引用 `""`、`cat:` の後ろが空、括弧の不一致、演算子の欠落は QueryError。
+    不正なクエリは rows が空でも filter_rows で QueryError。
+D7: 引用の中の空白と括弧は TERM の値に含める。エスケープは無い。
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+
+from kakeibo.core import Expense
+
+__all__ = ["QueryError", "filter_rows", "matches", "tokenize"]
+
+
+class QueryError(ValueError):
+    """Raised when a search query is malformed."""
+
+
+Pred = Callable[[Expense], bool]
+
+_TERM_START = frozenset({"NOT", "TERM", "CAT", "LPAREN"})
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    tokens: list[tuple[str, str]] = []
+    i, n = 0, len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError(f"閉じていない引用があります: {q!r}")
+            body = q[i + 1 : end]
+            if body == "":
+                raise QueryError("空の引用は指定できません")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            j = i
+            while j < n and not (q[j].isspace() or q[j] in '()"'):
+                j += 1
+            word = q[i:j]
+            i = j
+            if word in ("AND", "OR", "NOT"):
+                tokens.append((word, word))
+            elif word.startswith("cat:"):
+                cat = word[len("cat:") :]
+                if cat == "":
+                    raise QueryError("cat: の後ろが空です")
+                tokens.append(("CAT", cat))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+def _term(value: str) -> Pred:
+    needle = value.casefold()
+
+    def pred(e: Expense) -> bool:
+        return needle in e.memo.casefold() or needle in e.category.casefold()
+
+    return pred
+
+
+def _cat(value: str) -> Pred:
+    needle = value.casefold()
+
+    def pred(e: Expense) -> bool:
+        return e.category.casefold() == needle
+
+    return pred
+
+
+def _or(a: Pred, b: Pred) -> Pred:
+    return lambda e: a(e) or b(e)
+
+
+def _and(a: Pred, b: Pred) -> Pred:
+    return lambda e: a(e) and b(e)
+
+
+def _not(a: Pred) -> Pred:
+    return lambda e: not a(e)
+
+
+class _Parser:
+    def __init__(self, tokens: list[tuple[str, str]]) -> None:
+        self.tokens = tokens
+        self.pos = 0
+
+    def peek(self) -> str | None:
+        return self.tokens[self.pos][0] if self.pos < len(self.tokens) else None
+
+    def or_expr(self) -> Pred:
+        left = self.and_expr()
+        while self.peek() == "OR":
+            self.pos += 1
+            left = _or(left, self.and_expr())
+        return left
+
+    def and_expr(self) -> Pred:
+        left = self.not_expr()
+        while True:
+            kind = self.peek()
+            if kind == "AND":
+                self.pos += 1
+            elif kind not in _TERM_START:
+                break
+            left = _and(left, self.not_expr())
+        return left
+
+    def not_expr(self) -> Pred:
+        if self.peek() == "NOT":
+            self.pos += 1
+            return _not(self.not_expr())
+        return self.primary()
+
+    def primary(self) -> Pred:
+        kind = self.peek()
+        if kind is None:
+            raise QueryError("項が必要です(末尾)")
+        _, value = self.tokens[self.pos]
+        if kind == "TERM":
+            self.pos += 1
+            return _term(value)
+        if kind == "CAT":
+            self.pos += 1
+            return _cat(value)
+        if kind == "LPAREN":
+            self.pos += 1
+            inner = self.or_expr()
+            if self.peek() != "RPAREN":
+                raise QueryError("括弧が閉じていません")
+            self.pos += 1
+            return inner
+        raise QueryError(f"項が必要です: {value!r}")
+
+
+def _parse(q: str) -> Pred:
+    tokens = tokenize(q)
+    if not tokens:
+        raise QueryError("クエリが空です")
+    parser = _Parser(tokens)
+    pred = parser.or_expr()
+    if parser.pos != len(tokens):
+        raise QueryError(f"解釈できない位置があります: {tokens[parser.pos][1]!r}")
+    return pred
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _parse(q)(e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    pred = _parse(q)
+    return [e for e in rows if pred(e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..20e3f37
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,79 @@
+"""Detect recurring (monthly) expenses.
+
+D1: add_month は翌月の同じ日を返す。翌月に同じ日が無ければ翌月の末日(閏年を含む)。
+D2: 同一視するのは (category, amount) の完全一致のみ。memo は無視し、
+    大文字小文字・NFKC 正規化はしない(category は core 側で strip 済みの値をそのまま使う)。
+D3: 金額が変わったもの(値上げ・数 % の揺れ)は別の系列とみなす。
+D4: 負の金額(返金)も、その値のまま (category, amount) で通常どおり扱う。正の系列とは混ぜない。
+D5: 同じ (category, amount) でも日付が連鎖しなければ別系列。期間を分けて続く 2 系列
+    (例: 1〜3 月の 5 日、4〜6 月の 20 日)は別の Recurring になる。同じ期間に 5 日と 20 日が
+    混在する場合は 1 グループ内で連鎖が毎回切れ、どちらも検出されない(仕様どおり)。
+D6: 同じ日の重複は 1 日として数える(件数を水増ししない)。
+D7: 連鎖の判定は、隣り合う日付 d_i と d_{i+1} について
+    abs((d_{i+1} - add_month(d_i)).days) <= tolerance(境界を含む)。基準は直前の日付で、
+    月末への丸め(31→28 など)を次の基準に持ち越さない。
+D8: 欠けた月がある・同じ月に 2 回ある場合は連鎖が切れ、系列が分かれる。
+    切れた区間のうち長さが min_count 以上のものだけを結果にする。
+D9: next_expected は区間の最後の日付の add_month(翌月の同じ日)。
+D10: min_count < 2 または tolerance < 0 は ValueError。
+D11: 結果は category 昇順、同じなら amount 昇順、同じなら days[0] 昇順。
+"""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """翌月の同じ日。翌月に無ければ翌月の末日(D1)。"""
+    year = d.year + (d.month == 12)
+    month = d.month % 12 + 1
+    last_day = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last_day))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError("min_count は 2 以上である必要があります")
+    if tolerance < 0:
+        raise ValueError("tolerance は 0 以上である必要があります")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    out: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        runs: list[list[date]] = []
+        for d in sorted(day_set):
+            if runs and abs((d - add_month(runs[-1][-1])).days) <= tolerance:
+                runs[-1].append(d)
+            else:
+                runs.append([d])
+        for run in runs:
+            if len(run) >= min_count:
+                out.append(
+                    Recurring(
+                        category=category,
+                        amount=amount,
+                        days=tuple(run),
+                        next_expected=add_month(run[-1]),
+                    )
+                )
+
+    out.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return out
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..027787c
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,244 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+# --- parse_amount -----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("s", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥0", 0),
+        ("￥5円", 5),
+        ("1,234", 1234),
+        ("1,,2", 12),  # カンマの位置は検査しない
+        ("-1,000円", -1000),
+        ("\t500\n", 500),
+    ],
+)
+def test_parse_amount_accepts(s: str, expected: int) -> None:
+    assert parse_amount(s) == expected
+
+
+@pytest.mark.parametrize(
+    "s",
+    [
+        "",
+        "   ",
+        "円",
+        "¥",
+        "-",
+        ",",
+        ",5",
+        "12.5",
+        "1 200",
+        "--5",
+        "¥-5",
+        "-,5",
+        "１２３",
+        "5¥",
+        "5円円",
+        "円5",
+        "JPY5",
+        "—",
+        "△500",
+        "(500)",
+    ],
+)
+def test_parse_amount_rejects(s: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(s)
+
+
+# --- parse_date -------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("s", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/12/31 ", date(2026, 12, 31)),
+        ("2026/1/05", date(2026, 1, 5)),
+        ("2026-1-5", date(2026, 1, 5)),
+        ("2024/2/29", date(2024, 2, 29)),
+    ],
+)
+def test_parse_date_accepts(s: str, expected: date) -> None:
+    assert parse_date(s) == expected
+
+
+@pytest.mark.parametrize(
+    "s",
+    [
+        "2026/1-5",
+        "2026-1/5",
+        "26/1/5",
+        "2026/02/30",
+        "2026/2/29",
+        "2026/13/1",
+        "2026/0/1",
+        "2026/1/",
+        "2026/1/5/",
+        "2026/1/123",
+        "2026.1.5",
+        "２０２６/1/5",
+        "",
+        "   ",
+        "2026",
+    ],
+)
+def test_parse_date_rejects(s: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(s)
+
+
+# --- import_rows ------------------------------------------------------------
+
+HEADER = "利用日,分類,利用金額,利用店名,余分"
+
+
+def test_default_mapping_basic() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,-300,スーパー,x\n2026-01-06,交通,1200,駅,y\n"
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [
+        Expense(date(2026, 1, 5), "食費", -300, "スーパー"),
+        Expense(date(2026, 1, 6), "交通", 1200, "駅"),
+    ]
+
+
+def test_default_mapping_is_documented_constant() -> None:
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_custom_mapping_without_memo_gives_empty_memo() -> None:
+    text = '取引日,カテゴリ,出金額\n2026/3/1,光熱費,"¥2,000"\n'
+    mapping = {"date": "取引日", "category": "カテゴリ", "amount": "出金額"}
+    rows, errors = import_rows(text, mapping)
+    assert errors == []
+    assert rows == [Expense(date(2026, 3, 1), "光熱費", 2000, "")]
+
+
+def test_mapping_missing_required_key_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows(f"{HEADER}\n", {"date": "利用日", "category": "分類"})
+
+
+def test_mapping_column_not_in_header_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows(
+            f"{HEADER}\n", {"date": "無い列", "category": "分類", "amount": "利用金額"}
+        )
+
+
+def test_memo_mapped_but_column_missing_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows(f"{HEADER}\n", {**DEFAULT_MAPPING, "memo": "無い列"})
+
+
+def test_extra_columns_ignored_and_headers_matched_after_strip() -> None:
+    text = "﻿ 利用日 , 分類 ,利用金額, 利用店名 ,余分\n2026/1/5,食費,100,店,zz\n"
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "店")]
+
+
+def test_quoted_comma_and_multiline_values() -> None:
+    text = f'{HEADER}\n2026/1/5,"外食, 飲み会",-3000,"店A,\n店B"\n2026/1/6,食費,100,x\n'
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows[0] == Expense(date(2026, 1, 5), "外食, 飲み会", -3000, "店A,\n店B")
+    assert rows[1] == Expense(date(2026, 1, 6), "食費", 100, "x")
+
+
+def test_error_line_number_is_start_line_of_multiline_record() -> None:
+    # 2 行目は引用符内改行で 2〜3 行目にまたがる。3 行目の正しい行は 4 行目。
+    text = f'{HEADER}\n2026/1/5,"a\nb",bad,m\n2026/1/6,食費,100,x\n'
+    rows, errors = import_rows(text)
+    assert errors == [(2, "amount")]
+    assert rows == [Expense(date(2026, 1, 6), "食費", 100, "x")]
+
+
+def test_blank_lines_skipped_but_counted() -> None:
+    text = f"{HEADER}\n\n2026/1/5,食費,100,x\n\n   \nbad,食費,100,x\n"
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "x")]
+    assert errors == [(6, "date")]
+
+
+def test_all_errors_in_a_row_reported_in_order() -> None:
+    text = f"{HEADER}\nxx,,yy,m\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "date"), (2, "amount"), (2, "category")]
+
+
+def test_row_with_error_excluded_but_others_kept() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,12.5,x\n2026/1/6,食費,10,x\n"
+    rows, errors = import_rows(text)
+    assert errors == [(2, "amount")]
+    assert rows == [Expense(date(2026, 1, 6), "食費", 10, "x")]
+
+
+def test_short_row_missing_values_treated_as_empty() -> None:
+    text = f"{HEADER}\n2026/1/5\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "amount"), (2, "category")]
+
+
+def test_whitespace_only_category_is_error() -> None:
+    text = f"{HEADER}\n2026/1/5,   ,100,x\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "category")]
+
+
+def test_category_stripped_and_mapped() -> None:
+    text = f"{HEADER}\n2026/1/5, 食費 ,100,x\n2026/1/6,交通,200,y\n"
+    rows, errors = import_rows(text, category_map={"食費": "食料品", "交通": "移動"})
+    assert errors == []
+    assert [r.category for r in rows] == ["食料品", "移動"]
+
+
+def test_category_map_unknown_key_left_as_is() -> None:
+    text = f"{HEADER}\n2026/1/5,娯楽,100,x\n"
+    rows, _ = import_rows(text, category_map={"食費": "食料品"})
+    assert rows[0].category == "娯楽"
+
+
+def test_memo_stripped() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,100,  店名  \n"
+    rows, _ = import_rows(text)
+    assert rows[0].memo == "店名"
+
+
+def test_negative_amount_accepted_as_refund() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,-500,返金\n"
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows[0].amount == -500
+
+
+def test_header_only_returns_empty() -> None:
+    assert import_rows(f"{HEADER}\n") == ([], [])
+
+
+def test_empty_text_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows("")
