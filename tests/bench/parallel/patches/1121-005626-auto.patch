+++ b/tests/test_query.py
@@ -0,0 +1,263 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def ex(category: str = "食費", memo: str = "", amount: int = 100) -> Expense:
+    return Expense(day=date(2026, 1, 1), category=category, amount=amount, memo=memo)
+
+
+# --- tokenize ---------------------------------------------------------------
+
+
+def test_tokenize_empty_and_whitespace_only() -> None:
+    assert tokenize("") == []
+    assert tokenize("   \t ") == []
+
+
+def test_tokenize_whitespace_is_separator_only() -> None:
+    assert tokenize("  a   b ") == [("TERM", "a"), ("TERM", "b")]
+
+
+def test_tokenize_parens() -> None:
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+
+
+def test_tokenize_quoted_keeps_spaces_and_parens() -> None:
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+
+
+def test_tokenize_quoted_whitespace_only_is_term() -> None:
+    assert tokenize('"  "') == [("TERM", "  ")]
+
+
+def test_tokenize_quoted_directly_after_word_splits() -> None:
+    assert tokenize('a"b c"') == [("TERM", "a"), ("TERM", "b c")]
+
+
+@pytest.mark.parametrize("q", ['"abc', '"', 'a "b', '""'])
+def test_tokenize_bad_quote_raises(q: str) -> None:
+    with pytest.raises(QueryError):
+        tokenize(q)
+
+
+def test_tokenize_operators_are_uppercase_only() -> None:
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+    assert tokenize("and or not Not") == [
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+        ("TERM", "Not"),
+    ]
+
+
+def test_tokenize_cat() -> None:
+    assert tokenize("cat:食費") == [("CAT", "食費")]
+
+
+def test_tokenize_cat_value_keeps_colons() -> None:
+    assert tokenize("cat:a:b") == [("CAT", "a:b")]
+
+
+@pytest.mark.parametrize("q", ["cat:", "cat: a", "(cat:)"])
+def test_tokenize_empty_cat_raises(q: str) -> None:
+    with pytest.raises(QueryError):
+        tokenize(q)
+
+
+def test_tokenize_other_colon_words_are_terms() -> None:
+    assert tokenize("x:y Cat:食費") == [("TERM", "x:y"), ("TERM", "Cat:食費")]
+
+
+def test_tokenize_cat_followed_by_quote_is_empty_cat() -> None:
+    # 語は引用符の手前で切れるので "cat:" が空のまま残る
+    with pytest.raises(QueryError):
+        tokenize('cat:"食費"')
+
+
+# --- matches: term / cat semantics -----------------------------------------
+
+
+def test_term_partial_match_on_memo() -> None:
+    assert matches("ラン", ex(memo="ランチセット"))
+
+
+def test_term_partial_match_on_category() -> None:
+    assert matches("食", ex(category="外食費"))
+
+
+def test_term_is_case_insensitive() -> None:
+    assert matches("coffee", ex(memo="Coffee"))
+    assert matches("COFFEE", ex(memo="coffee"))
+
+
+def test_term_does_not_normalize_width() -> None:
+    assert not matches("ABC", ex(memo="ＡＢＣ"))
+
+
+def test_term_not_found() -> None:
+    assert not matches("書籍", ex(category="食費", memo="ランチ"))
+
+
+def test_term_on_empty_memo() -> None:
+    assert not matches("a", ex(memo=""))
+
+
+def test_cat_exact_match() -> None:
+    assert matches("cat:食費", ex(category="食費"))
+
+
+def test_cat_is_not_partial() -> None:
+    assert not matches("cat:食", ex(category="食費"))
+
+
+def test_cat_is_case_insensitive() -> None:
+    assert matches("cat:Food", ex(category="food"))
+
+
+def test_cat_does_not_look_at_memo() -> None:
+    assert not matches("cat:食費", ex(category="雑費", memo="食費"))
+
+
+def test_quoted_term_with_space_matches_substring() -> None:
+    assert matches('"a b"', ex(memo="x a b y"))
+    assert not matches('"a b"', ex(memo="a  b"))
+
+
+# --- matches: operators and precedence -------------------------------------
+
+
+def test_implicit_and_requires_both() -> None:
+    assert matches("ラン 食", ex(category="食費", memo="ランチ"))
+    assert not matches("ラン 書籍", ex(category="食費", memo="ランチ"))
+
+
+def test_explicit_and_equals_implicit() -> None:
+    row = ex(category="食費", memo="ランチ")
+    assert matches("ラン AND 食", row) == matches("ラン 食", row) is True
+    assert matches("ラン AND 書籍", row) is False
+
+
+def test_and_chain() -> None:
+    assert matches("a AND b AND c", ex(memo="abc"))
+    assert not matches("a AND b AND c", ex(memo="ab"))
+
+
+def test_or_chain() -> None:
+    assert matches("x OR y OR z", ex(memo="z"))
+    assert not matches("x OR y OR z", ex(memo="w"))
+
+
+def test_not_binds_tighter_than_and() -> None:
+    # (NOT a) AND b。NOT (a AND b) なら真になってしまう行
+    row = ex(memo="a")
+    assert not matches("NOT a b", row)
+    assert matches("NOT a b", ex(memo="b"))
+
+
+def test_and_binds_tighter_than_or() -> None:
+    # a OR (b AND c)。(a OR b) AND c なら偽になる行
+    assert matches("a OR b c", ex(memo="a"))
+    assert not matches("a OR b c", ex(memo="b"))
+
+
+def test_or_is_lowest_with_explicit_and() -> None:
+    assert matches("a AND b OR c", ex(memo="c"))
+    assert not matches("a AND b OR c", ex(memo="a"))
+
+
+def test_parens_override_precedence() -> None:
+    assert matches("a AND (b OR c)", ex(memo="a c"))
+    assert not matches("a AND (b OR c)", ex(memo="b c"))
+    assert matches("(a OR b) AND c", ex(memo="b c"))
+
+
+def test_not_of_parens() -> None:
+    assert matches("NOT (a OR b)", ex(memo="c"))
+    assert not matches("NOT (a OR b)", ex(memo="a"))
+
+
+def test_double_not() -> None:
+    assert matches("NOT NOT a", ex(memo="a"))
+    assert not matches("NOT NOT a", ex(memo="b"))
+
+
+def test_not_cat() -> None:
+    assert matches("NOT cat:雑費", ex(category="食費"))
+
+
+def test_lowercase_and_is_a_term() -> None:
+    assert matches("a and b", ex(memo="a and b"))
+    assert not matches("a and b", ex(memo="a"))
+
+
+def test_nested_parens() -> None:
+    assert matches("((a))", ex(memo="a"))
+
+
+# --- matches: errors --------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "( )",
+        "a AND",
+        "AND a",
+        "a OR",
+        "OR a",
+        "a OR OR b",
+        "a AND AND b",
+        "NOT",
+        "a NOT",
+        "(a",
+        "a)",
+        "((a)",
+        "a ( )",
+        "AND",
+        "OR",
+    ],
+)
+def test_malformed_query_raises(q: str) -> None:
+    with pytest.raises(QueryError):
+        matches(q, ex(memo="a"))
+
+
+# --- filter_rows ------------------------------------------------------------
+
+
+def test_filter_rows_keeps_input_order() -> None:
+    rows = [ex(memo="a 1"), ex(memo="b"), ex(memo="a 2"), ex(memo="a 3")]
+    got = filter_rows("a", rows)
+    assert [e.memo for e in got] == ["a 1", "a 2", "a 3"]
+
+
+def test_filter_rows_empty_input_valid_query() -> None:
+    assert filter_rows("a", []) == []
+
+
+def test_filter_rows_no_match_returns_empty() -> None:
+    assert filter_rows("zzz", [ex(memo="a")]) == []
+
+
+@pytest.mark.parametrize("q", ["", "a AND", "cat:", '"x'])
+def test_filter_rows_invalid_query_raises_even_with_no_rows(q: str) -> None:
+    with pytest.raises(QueryError):
+        filter_rows(q, [])
+
+
+def test_filter_rows_invalid_query_raises_with_rows() -> None:
+    with pytest.raises(QueryError):
+        filter_rows("(a", [ex(memo="a")])
+
+
+def test_query_error_is_value_error() -> None:
+    assert issubclass(QueryError, ValueError)
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
