diff --git a/tests/test_types/test_Choice.py b/tests/test_types/test_Choice.py
index c34f516..0748a31 100644
--- a/tests/test_types/test_Choice.py
+++ b/tests/test_types/test_Choice.py
@@ -1,3 +1,7 @@
+import enum
+
+import pytest
+
 import click
 
 
@@ -5,3 +9,77 @@ def test_choice_get_invalid_choice_message():
     choice = click.Choice(["a", "b", "c"])
     message = choice.get_invalid_choice_message("d", ctx=None)
     assert message == "'d' is not one of 'a', 'b', 'c'."
+
+
+def test_choice_invalid_message_suggests_one_close_choice():
+    choice = click.Choice(["red", "green", "blue"])
+    message = choice.get_invalid_choice_message("gren", ctx=None)
+    assert message == (
+        "'gren' is not one of 'red', 'green', 'blue'. Did you mean 'green'?"
+    )
+
+
+def test_choice_invalid_message_suggests_several_close_choices():
+    choice = click.Choice(["declare", "refine", "push"])
+    message = choice.get_invalid_choice_message("decline", ctx=None)
+    assert message.endswith("(Did you mean one of: 'declare', 'refine'?)")
+
+
+def test_choice_invalid_message_no_suggestion_when_far():
+    choice = click.Choice(["foo", "bar", "baz"])
+    assert "Did you mean" not in choice.get_invalid_choice_message("meh", ctx=None)
+
+
+def test_choice_invalid_message_single_choice():
+    choice = click.Choice(["json"])
+    message = choice.get_invalid_choice_message("jsn", ctx=None)
+    assert message == "'jsn' is not 'json'. Did you mean 'json'?"
+
+
+def test_choice_invalid_message_suggests_normalized_choice():
+    # Case-insensitive: suggestions use the normalized (casefolded) spelling.
+    choice = click.Choice(["Red", "Green"], case_sensitive=False)
+    message = choice.get_invalid_choice_message("GREN", ctx=None)
+    assert message.endswith("Did you mean 'green'?")
+
+
+def test_choice_invalid_message_case_sensitive_is_not_folded():
+    choice = click.Choice(["Green"])
+    message = choice.get_invalid_choice_message("green", ctx=None)
+    assert "Did you mean 'Green'?" in message
+
+
+def test_choice_invalid_message_enum_and_non_str_value():
+    class Color(enum.Enum):
+        RED = 1
+        GREEN = 2
+
+    choice = click.Choice(Color)
+    assert "Did you mean 'GREEN'?" in choice.get_invalid_choice_message(
+        "GREN", ctx=None
+    )
+    # A non-str value is compared by its str() and does not crash.
+    assert "Did you mean" not in choice.get_invalid_choice_message(123, ctx=None)
+
+
+@pytest.mark.parametrize("value", ["", " "])
+def test_choice_invalid_message_empty_value(value):
+    choice = click.Choice(["a", "b"])
+    assert "Did you mean" not in choice.get_invalid_choice_message(value, ctx=None)
+
+
+def test_choice_suggestion_through_cli(runner):
+    @click.command()
+    @click.option("--color", type=click.Choice(["red", "green", "blue"]))
+    def cli(color):
+        click.echo(color)
+
+    result = runner.invoke(cli, ["--color", "gren"])
+    assert result.exit_code == 2
+    assert "'gren' is not one of 'red', 'green', 'blue'. Did you mean 'green'?" in (
+        result.output
+    )
+
+    result = runner.invoke(cli, ["--color", "green"])
+    assert result.exit_code == 0
+    assert result.output == "green\n"
