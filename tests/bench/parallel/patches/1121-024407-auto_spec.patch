@@ -0,0 +1,155 @@
+import re
+from datetime import date
+
+import pytest
+
+from kakeibo.bank_date import parse_bank_date
+
+
+# 例の表 (E3-1 〜 E3-3) の全行
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param("令和8年1月5日", date(2026, 1, 5), id="E3-1"),
+        pytest.param("2026/1/5 12:34", date(2026, 1, 5), id="E3-2"),
+        pytest.param("2026/2/30", ValueError, id="E3-3"),
+    ],
+)
+def test_example_table(text, expected):
+    if expected is ValueError:
+        with pytest.raises(ValueError):
+            parse_bank_date(text)
+    else:
+        assert parse_bank_date(text) == expected
+
+
+# R1: 受け付ける書式
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026-01-05", date(2026, 1, 5)),
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026.1.5", date(2026, 1, 5)),
+        ("20260105", date(2026, 1, 5)),
+        ("2026年1月5日", date(2026, 1, 5)),
+        ("R8.1.5", date(2026, 1, 5)),
+        ("令和8年1月5日", date(2026, 1, 5)),
+        ("  2026-01-05  ", date(2026, 1, 5)),
+        ("２０２６／１／５", date(2026, 1, 5)),
+        ("Ｒ８．１．５", date(2026, 1, 5)),
+    ],
+    ids=[
+        "R1-iso",
+        "R1-slash",
+        "R1-dot",
+        "R1-compact",
+        "R1-kanji",
+        "R1-wareki-dot",
+        "R1-wareki-kanji",
+        "R1-strip",
+        "R1-nfkc-fullwidth-digits-slash",
+        "R1-nfkc-fullwidth-wareki",
+    ],
+)
+def test_accepted_formats(text, expected):
+    assert parse_bank_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    ["2026-1/5", "2026/01-05", "2026.1-5"],
+    ids=["R1-mixed-1", "R1-mixed-2", "R1-mixed-3"],
+)
+def test_mixed_separators_rejected(text):
+    with pytest.raises(ValueError, match=re_escape(text)):
+        parse_bank_date(text)
+
+
+# R2: 和暦
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("令和元年5月1日", date(2019, 5, 1)),
+        ("R1.5.1", date(2019, 5, 1)),
+        ("令和1年5月1日", date(2019, 5, 1)),
+        ("平成31年4月30日", date(2019, 4, 30)),
+        ("H31.5.1", date(2019, 5, 1)),
+        ("平成元年1月8日", date(1989, 1, 8)),
+        ("昭和64年1月7日", date(1989, 1, 7)),
+        ("S1.12.25", date(1926, 12, 25)),
+        ("昭和2年1月1日", date(1927, 1, 1)),
+    ],
+    ids=[
+        "R2-reiwa-gannen",
+        "R2-reiwa-gannen-short",
+        "R2-reiwa-1",
+        "R2-heisei-31-before-reiwa",
+        "R2-heisei-31-short",
+        "R2-heisei-gannen",
+        "R2-showa-64",
+        "R2-showa-start",
+        "R2-showa-2",
+    ],
+)
+def test_wareki(text, expected):
+    assert parse_bank_date(text) == expected
+
+
+# R3: 時刻付きは時刻を捨てる
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026-01-05 12:34",
+        "2026/1/5 12:34:56",
+        "2026-01-05T12:34:56",
+    ],
+    ids=["R3-hm", "R3-hms-slash", "R3-iso-t"],
+)
+def test_time_is_dropped(text):
+    assert parse_bank_date(text) == date(2026, 1, 5)
+
+
+# R4: 拒否
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "   ",
+        "2026/2/30",
+        "2026-02-29",
+        "26/1/5",
+        "abc",
+        "2026年1月",
+        "2026-01-05 ほげ",
+    ],
+    ids=[
+        "R4-empty",
+        "R4-blank",
+        "R4-nonexistent-day",
+        "R4-non-leap-feb29",
+        "R4-two-digit-year",
+        "R4-non-digit",
+        "R4-no-day",
+        "R4-trailing-garbage",
+    ],
+)
+def test_rejected_values_include_original(text):
+    with pytest.raises(ValueError) as ei:
+        parse_bank_date(text)
+    assert repr(text) in str(ei.value)
+
+
+def test_leap_day_accepted():
+    assert parse_bank_date("2024-02-29") == date(2024, 2, 29)
+
+
+@pytest.mark.parametrize(
+    "value", [None, 20260105, date(2026, 1, 5)], ids=["none", "int", "date"]
+)
+def test_non_str_raises_type_error(value):
+    with pytest.raises(TypeError):
+        parse_bank_date(value)
+
+
+def re_escape(text):
+    return re.escape(repr(text))
