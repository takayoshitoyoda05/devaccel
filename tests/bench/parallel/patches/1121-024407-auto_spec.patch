@@ -0,0 +1,31 @@
+from datetime import date
+
+from kakeibo.bank_import import import_bank_csv
+from kakeibo.core import Expense
+
+
+def test_single_amount_column_and_refund():
+    text = (
+        '利用日,ご利用金額,ご利用店名\n令和8年1月5日,"1,200円",A店\n2026/1/6,△300,B店\n'
+    )
+    rows, issues = import_bank_csv(text, "カード")
+    assert issues == []
+    assert rows == [
+        Expense(date(2026, 1, 5), "カード", 1200, "A店"),
+        Expense(date(2026, 1, 6), "カード", -300, "B店"),
+    ]
+
+
+def test_withdrawal_deposit_columns():
+    text = "日付,摘要,出金,入金\n2026-01-05,X,500,\n2026-01-06,Y,,200\n"
+    rows, issues = import_bank_csv(text)
+    assert issues == []
+    assert [r.amount for r in rows] == [500, -200]
+
+
+def test_all_bad_cells_reported_with_line_and_column():
+    text = "日付,金額\n2026/2/30,abc\n2026-01-05,100\n"
+    rows, issues = import_bank_csv(text)
+    assert len(rows) == 1 and rows[0].amount == 100
+    assert [(i.line, i.column) for i in issues] == [(2, "日付"), (2, "金額")]
+    assert issues[1].value == "abc"
