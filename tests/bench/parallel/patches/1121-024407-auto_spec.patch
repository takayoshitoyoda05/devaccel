@@ -0,0 +1,76 @@
+"""銀行・カード会社の CSV に出てくる日付文字列を `datetime.date` に変換する。"""
+
+import re
+import unicodedata
+from datetime import date
+
+# 時刻の接尾辞 (` 12:34` `T12:34:56` など) は日付部分を取り出してから捨てる。
+_TIME_SUFFIX = re.compile(r"(.+?)[T ][0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?")
+
+# 西暦: 区切りは 1 種類だけ (\2 で揃える)。
+_WESTERN = re.compile(r"([0-9]{4})([-/.])([0-9]{1,2})\2([0-9]{1,2})")
+_WESTERN_KANJI = re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日")
+_COMPACT = re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})")
+
+# 和暦: 元号 + 年 (数字 or 元) + 区切り or 年月日。
+_ERA_BASE = {
+    "令和": 2018,
+    "R": 2018,
+    "平成": 1988,
+    "H": 1988,
+    "昭和": 1925,
+    "S": 1925,
+}
+_WAREKI_KANJI = re.compile(
+    r"(令和|平成|昭和|R|H|S)(元|[0-9]{1,2})年([0-9]{1,2})月([0-9]{1,2})日"
+)
+_WAREKI_SEP = re.compile(
+    r"(令和|平成|昭和|R|H|S)(元|[0-9]{1,2})([-/.])([0-9]{1,2})\3([0-9]{1,2})"
+)
+
+
+def _wareki_year(era: str, year_token: str, original: str) -> int:
+    n = 1 if year_token == "元" else int(year_token)
+    if n == 0:
+        raise ValueError(f"和暦の年が不正です: {original!r}")
+    return _ERA_BASE[era] + n
+
+
+def _build(year: int, month: int, day: int, original: str) -> date:
+    try:
+        return date(year, month, day)
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {original!r}") from None
+
+
+def parse_bank_date(s: str) -> date:
+    """銀行・カード会社の日付文字列を `date` にする。時刻は捨てる。
+
+    解釈できない値は `ValueError` (元の値を含む)、`str` 以外は `TypeError`。
+    """
+    if not isinstance(s, str):
+        raise TypeError(f"日付は str である必要があります: {s!r}")
+
+    original = s
+    text = unicodedata.normalize("NFKC", s).strip()
+    if not text:
+        raise ValueError(f"日付が空です: {original!r}")
+
+    m = _TIME_SUFFIX.fullmatch(text)
+    if m:
+        text = m.group(1)
+
+    if m := _WESTERN.fullmatch(text):
+        return _build(int(m.group(1)), int(m.group(3)), int(m.group(4)), original)
+    if m := _WESTERN_KANJI.fullmatch(text):
+        return _build(int(m.group(1)), int(m.group(2)), int(m.group(3)), original)
+    if m := _COMPACT.fullmatch(text):
+        return _build(int(m.group(1)), int(m.group(2)), int(m.group(3)), original)
+    if m := _WAREKI_KANJI.fullmatch(text):
+        year = _wareki_year(m.group(1), m.group(2), original)
+        return _build(year, int(m.group(3)), int(m.group(4)), original)
+    if m := _WAREKI_SEP.fullmatch(text):
+        year = _wareki_year(m.group(1), m.group(2), original)
+        return _build(year, int(m.group(4)), int(m.group(5)), original)
+
+    raise ValueError(f"日付として解釈できません: {original!r}")
diff --git a/src/kakeibo/bank_import.py b/src/kakeibo/bank_import.py
