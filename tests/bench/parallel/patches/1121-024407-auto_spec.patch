@@ -0,0 +1,120 @@
+"""Bank / card company CSV -> BankRow (structure only; values are kept as strings)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import unicodedata
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class BankRow:
+    line: int
+    date: str
+    amount: str
+    memo: str
+    withdrawal: str
+    deposit: str
+
+
+@dataclass(frozen=True)
+class RowIssue:
+    line: int
+    column: str
+    value: str
+    reason: str
+
+
+_DATE = ("日付", "利用日", "取引日", "ご利用日", "年月日", "date")
+_AMOUNT = ("金額", "利用金額", "ご利用金額", "amount")
+_MEMO = ("摘要", "メモ", "利用店名", "ご利用店名", "内容", "description", "memo")
+_WITHDRAWAL = ("出金", "出金額", "支払", "お支払金額", "withdrawal")
+_DEPOSIT = ("入金", "入金額", "預入", "deposit")
+
+
+def _key(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip().lower()
+
+
+def _find(headers: list[str], aliases: tuple[str, ...]) -> int | None:
+    """Index of the leftmost header matching one of the aliases, else None."""
+    keys = {_key(a) for a in aliases}
+    for i, h in enumerate(headers):
+        if _key(h) in keys:
+            return i
+    return None
+
+
+def _records(normalized: str, delim: str) -> list[tuple[int, str, list[str]]]:
+    """Non-blank records as (start line, raw text, stripped cells)."""
+    lines = normalized.split("\n")
+    reader = csv.reader(io.StringIO(normalized), delimiter=delim)
+    out: list[tuple[int, str, list[str]]] = []
+    prev = 0
+    for cells in reader:
+        end = reader.line_num
+        start = prev + 1
+        prev = end
+        if not cells or (len(cells) == 1 and cells[0].strip() == ""):
+            continue
+        raw = "\n".join(lines[start - 1 : end])
+        out.append((start, raw, [c.strip() for c in cells]))
+    return out
+
+
+def read_bank_csv(text: str) -> tuple[list[BankRow], list[RowIssue]]:
+    normalized = text.removeprefix("﻿").replace("\r\n", "\n").replace("\r", "\n")
+    first = normalized.split("\n", 1)[0]
+    delim = "\t" if first.count("\t") > first.count(",") else ","
+
+    records = _records(normalized, delim)
+    if not records:
+        return [], []
+    _, _, headers = records[0]
+
+    di = _find(headers, _DATE)
+    ai = _find(headers, _AMOUNT)
+    wi = _find(headers, _WITHDRAWAL)
+    pi = _find(headers, _DEPOSIT)
+    mi = _find(headers, _MEMO)
+    if di is None:
+        raise ValueError(f"日付列がありません(見つかった列: {headers!r})")
+    if ai is None and wi is None and pi is None:
+        raise ValueError(f"金額列も出金・入金列もありません(見つかった列: {headers!r})")
+
+    n = len(headers)
+    rows: list[BankRow] = []
+    issues: list[RowIssue] = []
+    for start, raw, cells in records[1:]:
+        if len(cells) != n:
+            issues.append(
+                RowIssue(start, "(列数)", raw, f"列数が {n} ではなく {len(cells)}")
+            )
+            continue
+
+        row_issues: list[RowIssue] = []
+        date = cells[di]
+        if date == "":
+            row_issues.append(RowIssue(start, headers[di], "", "空です"))
+
+        if ai is not None:
+            amount = cells[ai]
+            withdrawal = deposit = ""
+            if amount == "":
+                row_issues.append(RowIssue(start, headers[ai], "", "空です"))
+        else:
+            amount = ""
+            withdrawal = cells[wi] if wi is not None else ""
+            deposit = cells[pi] if pi is not None else ""
+            if withdrawal == "" and deposit == "":
+                names = "・".join(headers[i] for i in (wi, pi) if i is not None)
+                row_issues.append(RowIssue(start, names, "", "空です"))
+
+        memo = cells[mi] if mi is not None else ""
+
+        if row_issues:
+            issues.extend(row_issues)
+        else:
+            rows.append(BankRow(start, date, amount, memo, withdrawal, deposit))
+    return rows, issues
