@@ -0,0 +1,50 @@
+"""銀行・カード会社の金額表記を円の整数に変換する純粋関数。"""
+
+import unicodedata
+
+_DIGITS = "0123456789"
+_CURRENCY_TOKENS = ("JPY", "円", "¥", "\\")
+_NEG_LEADING = ("-", "△", "▲")
+_POS_LEADING = ("+",)
+
+
+def parse_amount(s: str) -> int:
+    """金額文字列を円の整数に変換する。支出は正、返金・入金は負。
+
+    受け付ける符号: `-300` `−300` `－300` `△500` `▲500` `(500)` `500-` は負、
+    `+300` `300` は正。通貨記号・桁区切り・空白は除去する。
+    不正な入力は ValueError、str 以外は TypeError。
+    """
+    if not isinstance(s, str):
+        raise TypeError(f"amount must be str, not {type(s).__name__}: {s!r}")
+
+    t = unicodedata.normalize("NFKC", s).replace("−", "-")
+    for token in _CURRENCY_TOKENS:
+        t = t.replace(token, "")
+    t = "".join(ch for ch in t if ch != "," and not ch.isspace())
+
+    neg = False
+    signs = 0
+    if t.startswith("(") and t.endswith(")"):
+        neg = True
+        signs += 1
+        t = t[1:-1]
+    if t[:1] in _NEG_LEADING + _POS_LEADING:
+        signs += 1
+        neg = t[0] in _NEG_LEADING
+        t = t[1:]
+    if t[-1:] == "-":
+        signs += 1
+        neg = True
+        t = t[:-1]
+    if signs > 1:
+        raise ValueError(f"amount {s!r}: 符号が重複している")
+
+    int_part, dot, frac = t.partition(".")
+    if dot and (not frac or frac.strip("0")):
+        raise ValueError(f"amount {s!r}: 小数は受け付けない")
+    if not int_part or any(c not in _DIGITS for c in int_part):
+        raise ValueError(f"amount {s!r}: 数字として解釈できない")
+
+    value = int(int_part)
+    return -value if neg else value
