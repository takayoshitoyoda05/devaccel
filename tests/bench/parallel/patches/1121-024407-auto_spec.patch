+++ b/tests/test_bank_csv.py
@@ -0,0 +1,96 @@
+import pytest
+
+from kakeibo.bank_csv import BankRow, RowIssue, read_bank_csv
+
+
+@pytest.mark.parametrize(
+    "text, rows, issues",
+    [
+        pytest.param(
+            '利用日,ご利用金額,ご利用店名\n2026/1/5,"1,200",A店',
+            [BankRow(2, "2026/1/5", "1,200", "A店", "", "")],
+            [],
+            id="E1-1",
+        ),
+        pytest.param(
+            "日付,金額\n2026-01-05,100,extra",
+            [],
+            [RowIssue(2, "(列数)", "2026-01-05,100,extra", "列数が 2 ではなく 3")],
+            id="E1-2",
+        ),
+    ],
+)
+def test_spec_table_rows(text, rows, issues):
+    assert read_bank_csv(text) == (rows, issues)
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        pytest.param("日付,メモ\n2026-01-05,x", id="E1-3"),
+    ],
+)
+def test_spec_table_missing_amount_raises(text):
+    with pytest.raises(ValueError, match="金額"):
+        read_bank_csv(text)
+
+
+def test_alias_leftmost_wins_and_nfkc_case_insensitive():
+    text = "ＤＡＴＥ,金額,AMOUNT\n2026-01-05,100,200"
+    rows, issues = read_bank_csv(text)
+    assert rows == [BankRow(2, "2026-01-05", "100", "", "", "")]
+    assert issues == []
+
+
+def test_two_column_withdrawal_deposit_form():
+    text = "日付,摘要,出金,入金\n2026-01-05,A店,300,\n2026-01-06,返金,,200"
+    rows, issues = read_bank_csv(text)
+    assert rows == [
+        BankRow(2, "2026-01-05", "", "A店", "300", ""),
+        BankRow(3, "2026-01-06", "", "返金", "", "200"),
+    ]
+    assert issues == []
+
+
+def test_empty_date_and_empty_amount_are_reported_per_row():
+    text = "日付,金額\n,100\n2026-01-05,"
+    rows, issues = read_bank_csv(text)
+    assert rows == []
+    assert issues == [
+        RowIssue(2, "日付", "", "空です"),
+        RowIssue(3, "金額", "", "空です"),
+    ]
+
+
+def test_both_withdrawal_and_deposit_empty_is_reported():
+    text = "日付,出金,入金\n2026-01-05,,"
+    rows, issues = read_bank_csv(text)
+    assert rows == []
+    assert issues == [RowIssue(2, "出金・入金", "", "空です")]
+
+
+def test_tab_delimiter_bom_crlf_and_blank_lines():
+    text = "﻿日付\t金額\r\n\r\n2026-01-05\t100\r\n"
+    rows, issues = read_bank_csv(text)
+    assert rows == [BankRow(3, "2026-01-05", "100", "", "", "")]
+    assert issues == []
+
+
+def test_quoted_newline_is_one_cell_and_line_is_record_start():
+    text = '日付,金額,摘要\n2026-01-05,100,"a\nb"\n2026-01-06,200,c'
+    rows, issues = read_bank_csv(text)
+    assert rows == [
+        BankRow(2, "2026-01-05", "100", "a\nb", "", ""),
+        BankRow(4, "2026-01-06", "200", "c", "", ""),
+    ]
+    assert issues == []
+
+
+def test_header_only_and_empty_input_return_empty():
+    assert read_bank_csv("日付,金額\n") == ([], [])
+    assert read_bank_csv("") == ([], [])
+
+
+def test_missing_date_column_raises_with_found_headers():
+    with pytest.raises(ValueError, match="日付"):
+        read_bank_csv("金額,摘要\n100,x")
