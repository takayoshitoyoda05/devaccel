@@ -0,0 +1,50 @@
+"""Glue: bank/card CSV text -> Expense list + row issues (pure function).
+
+D1: 支出は正、返金・入金は負。出金/入金の 2 列形式は 出金 - 入金。
+D2: 1 行の誤りは全部集める(日付・金額・出金・入金)。ほかの行は処理を続ける。
+D3: カテゴリは取り込み時点では決まらないので引数 category で一律に付ける。
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+
+from .bank_amount import parse_amount
+from .bank_csv import RowIssue, read_bank_csv
+from .bank_date import parse_bank_date
+from .core import Expense
+
+
+def _conv[T](
+    bad: list[RowIssue], line: int, column: str, value: str, fn: Callable[[str], T]
+) -> T | None:
+    try:
+        return fn(value)
+    except ValueError as e:
+        bad.append(RowIssue(line, column, value, str(e)))
+        return None
+
+
+def import_bank_csv(
+    text: str, category: str = "未分類"
+) -> tuple[list[Expense], list[RowIssue]]:
+    rows, issues = read_bank_csv(text)
+    out: list[Expense] = []
+    for r in rows:
+        bad: list[RowIssue] = []
+        day = _conv(bad, r.line, "日付", r.date, parse_bank_date)
+        if r.amount:
+            amount = _conv(bad, r.line, "金額", r.amount, parse_amount)
+        else:
+            w = (
+                _conv(bad, r.line, "出金", r.withdrawal, parse_amount)
+                if r.withdrawal
+                else 0
+            )
+            d = _conv(bad, r.line, "入金", r.deposit, parse_amount) if r.deposit else 0
+            amount = None if w is None or d is None else w - d
+        if bad or day is None or amount is None:
+            issues.extend(bad)
+            continue
+        out.append(Expense(day=day, category=category, amount=amount, memo=r.memo))
+    return out, sorted(issues, key=lambda i: i.line)
