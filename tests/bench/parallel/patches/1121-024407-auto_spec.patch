+import pytest
+
+from kakeibo.bank_amount import parse_amount
+
+
+@pytest.mark.parametrize(
+    "s,expected",
+    [
+        ("△１，２００円", -1200),  # E2-1
+        ("(500)", -500),  # E2-3
+    ],
+    ids=["E2-1", "E2-3"],
+)
+def test_parse_amount_examples(s, expected):
+    assert parse_amount(s) == expected
+
+
+@pytest.mark.parametrize("s", ["12.5"], ids=["E2-2"])
+def test_parse_amount_rejects_examples(s):
+    with pytest.raises(ValueError):
+        parse_amount(s)
