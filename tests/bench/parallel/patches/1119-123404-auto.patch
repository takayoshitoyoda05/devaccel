+)
+def test_positive_and_decoration_notations(raw: str, amount: int) -> None:
+    assert parse_bank_csv(f'日付,金額\n2026-01-05,"{raw}"')[0].amount == amount
+
+
+@pytest.mark.parametrize("raw", ["12.5", "abc", "1万"])
+def test_invalid_amount_is_error(raw: str) -> None:
+    with pytest.raises(BankCsvError) as ei:
+        parse_bank_csv(f"日付,金額\n2026-01-05,{raw}")
+    assert [(e.line, e.column, e.value) for e in ei.value.errors] == [(2, "金額", raw)]
+
+
+def test_empty_amount_in_single_column_is_error() -> None:
+    with pytest.raises(BankCsvError) as ei:
+        parse_bank_csv("日付,金額\n2026-01-05,")
+    assert [(e.line, e.column) for e in ei.value.errors] == [(2, "金額")]
+
+
+def test_single_column_negative_is_refund_kept() -> None:
+    assert parse_bank_csv("日付,金額,摘要\n2026-01-05,-300,返金") == [
+        Expense(date(2026, 1, 5), "未分類", -300, "返金")
+    ]
+
+
+def test_zero_amount_row_is_skipped() -> None:
+    assert parse_bank_csv("日付,金額\n2026-01-05,0") == []
+
+
+def test_two_column_withdrawal_minus_deposit() -> None:
+    assert parse_bank_csv("日付,出金,入金\n2026-01-05,500,200") == [
+        Expense(date(2026, 1, 5), "未分類", 300, "")
+    ]
+
+
+def test_two_column_blank_side_counts_as_zero() -> None:
+    assert parse_bank_csv("日付,出金,入金\n2026-01-05,500,") == [
+        Expense(date(2026, 1, 5), "未分類", 500, "")
+    ]
+
+
+def test_two_column_invalid_side_is_reported() -> None:
+    with pytest.raises(BankCsvError) as ei:
+        parse_bank_csv("日付,出金,入金\n2026-01-05,x,y")
+    assert [(e.line, e.column) for e in ei.value.errors] == [(2, "出金"), (2, "入金")]
+
+
+# --- R5 日付 ------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026.1.5",
+        "20260105",
+        "2026年1月5日",
+        "2026-01-05 12:34",
+        "2026-01-05T12:34:56",
+    ],
+)
+def test_date_notations(raw: str) -> None:
+    assert parse_bank_csv(f"日付,金額\n{raw},100") == [
+        Expense(date(2026, 1, 5), "未分類", 100, "")
+    ]
+
+
+@pytest.mark.parametrize("raw", ["2026-02-30", "2026-13-01", "令和8年1月5日", "x"])
+def test_invalid_date_is_error(raw: str) -> None:
+    with pytest.raises(BankCsvError) as ei:
+        parse_bank_csv(f"日付,金額\n{raw},100")
+    assert [(e.line, e.column) for e in ei.value.errors] == [(2, "日付")]
+
+
+# --- R6 空行・列数・誤りの収集 -----------------------------------------
+
+
+def test_blank_rows_are_ignored() -> None:
+    assert parse_bank_csv("日付,金額\n\n2026-01-05,100\n\n") == [
+        Expense(date(2026, 1, 5), "未分類", 100, "")
+    ]
+
+
+def test_wrong_column_count_is_row_error() -> None:
+    with pytest.raises(BankCsvError) as ei:
+        parse_bank_csv("日付,金額\n2026-01-05\n2026-01-06,100")
+    assert [(e.line, e.column) for e in ei.value.errors] == [(2, "(行)")]
+
+
+def test_all_errors_collected_in_line_order() -> None:
+    with pytest.raises(BankCsvError) as ei:
+        parse_bank_csv("日付,金額\n2026-01-05,abc\n2026-13-01,100\n2026-01-07\n")
+    assert [(e.line, e.column) for e in ei.value.errors] == [
+        (2, "金額"),
+        (3, "日付"),
