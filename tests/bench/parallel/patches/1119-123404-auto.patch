+
+def test_missing_both_reports_both_columns() -> None:
+    with pytest.raises(BankCsvError) as ei:
+        parse_bank_csv("メモ\nabc")
+    assert [(e.line, e.column) for e in ei.value.errors] == [(1, "日付"), (1, "金額")]
