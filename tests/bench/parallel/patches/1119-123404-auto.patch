--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,97 @@
+"""Detect recurring expenses (定期支出) from a list of Expense records."""
+
+from __future__ import annotations
+
+import calendar
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int
+    months: int
+    last_date: date
+    next_date: date
+
+
+def _normalize_memo(memo: str) -> str:
+    """NFKC・小文字化・空白除去・末尾の数字と # の除去。"""
+    s = "".join(unicodedata.normalize("NFKC", memo).lower().split())
+    return s.rstrip("0123456789#")
+
+
+def _lower_median(xs: list[int]) -> int:
+    s = sorted(xs)
+    return s[(len(s) - 1) // 2]
+
+
+def _detect(category: str, items: list[Expense], min_months: int) -> Recurring | None:
+    med = _lower_median([e.amount for e in items])
+    # R2: 中央値の ±10% 以内だけ残す(整数演算で判定)
+    kept = [e for e in items if abs(e.amount - med) * 10 <= med]
+
+    # D4: 同じ月は最も早い日の 1 件
+    by_month: dict[int, Expense] = {}
+    for e in kept:
+        idx = e.day.year * 12 + e.day.month
+        cur = by_month.get(idx)
+        if cur is None or e.day < cur.day:
+            by_month[idx] = e
+
+    # 直近の連続列
+    months = sorted(by_month)
+    run = [months[-1]]
+    for idx in reversed(months[:-1]):
+        if idx != run[-1] - 1:
+            break
+        run.append(idx)
+    if len(run) < min_months:
+        return None
+
+    series = [by_month[i] for i in reversed(run)]  # 古い順
+    last = series[-1]
+    amount = _lower_median([e.amount for e in series])
+
+    # D5: 系列の日の最大値を、最後の月の翌月に置く(月末に丸める)
+    base_day = max(e.day.day for e in series)
+    n = run[0] + 1  # 翌月の index (year * 12 + month)
+    year, month = (n - 1) // 12, (n - 1) % 12 + 1
+    next_day = min(base_day, calendar.monthrange(year, month)[1])
+
+    return Recurring(
+        category=category,
+        memo=last.memo,
+        amount=amount,
+        months=len(run),
+        last_date=last.day,
+        next_date=date(year, month, next_day),
+    )
+
+
+def find_recurring(expenses: list[Expense], min_months: int = 3) -> list[Recurring]:
+    if min_months < 2:
+        raise ValueError("min_months は 2 以上である必要があります")
+
+    # R1: グループは (カテゴリ, 正規化メモ)。正の金額だけ使う (R2)
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in expenses:
+        if e.amount <= 0:
+            continue
+        key = (e.category.strip(), _normalize_memo(e.memo))
+        groups.setdefault(key, []).append(e)
+
+    out: list[Recurring] = []
+    for (category, _norm), items in groups.items():
+        rec = _detect(category, items, min_months)
+        if rec is not None:
+            out.append(rec)
+
+    # R5: next_date 昇順、同点は金額の降順、さらにメモの昇順
+    out.sort(key=lambda r: (r.next_date, -r.amount, r.memo))
+    return out
