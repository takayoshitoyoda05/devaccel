@@ -0,0 +1,76 @@
+"""Month-over-month comparison of expenses by category."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class CategoryDiff:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    rate: float | None
+    status: str
+
+
+def _month_sums(expenses: list[Expense], year: int, month: int) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for e in expenses:
+        if e.day.year == year and e.day.month == month:
+            out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def monthly_diff(expenses: list[Expense], year: int, month: int) -> list[CategoryDiff]:
+    if not 1 <= month <= 12:
+        raise ValueError(f"month は 1〜12 である必要があります: {month}")
+    prev_year, prev_month = (year - 1, 12) if month == 1 else (year, month - 1)
+
+    current = _month_sums(expenses, year, month)
+    previous = _month_sums(expenses, prev_year, prev_month)
+
+    diffs: list[CategoryDiff] = []
+    for category in set(current) | set(previous):
+        prev_total = previous.get(category, 0)
+        cur_total = current.get(category, 0)
+        if prev_total == 0 and cur_total == 0:
+            continue
+        delta = cur_total - prev_total
+        rate = None if prev_total == 0 else delta / abs(prev_total)
+        if delta > 0:
+            status = "増"
+        elif delta < 0:
+            status = "減"
+        else:
+            status = "変化なし"
+        diffs.append(
+            CategoryDiff(
+                category=category,
+                previous=prev_total,
+                current=cur_total,
+                delta=delta,
+                rate=rate,
+                status=status,
+            )
+        )
+    diffs.sort(key=lambda d: (-abs(d.delta), d.category))
+    return diffs
+
+
+def format_diff(diffs: list[CategoryDiff]) -> str:
+    if not diffs:
+        return "差異なし"
+    lines: list[str] = []
+    for d in diffs:
+        if d.rate is None:
+            change = f"{d.delta:+d}円, 比較不可"
+        else:
+            change = f"{d.delta:+d}円, {d.rate:+.1%}"
+        lines.append(
+            f"{d.category}: {d.previous}円 → {d.current}円 ({change}) {d.status}"
+        )
+    return "\n".join(lines)
