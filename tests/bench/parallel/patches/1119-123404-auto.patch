+
+# --- 仕様の例の表(E1-*)をそのまま写す ---------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param(
+            '利用日,ご利用店名,利用金額\n2026/1/5,ＮＥＴＦＬＩＸ,"1,490円"',
+            [Expense(date(2026, 1, 5), "未分類", 1490, "NETFLIX")],
+            id="E1-1",
+        ),
+        pytest.param(
+            "日付,出金額,入金額\n2026-01-05,,3000",
+            [],
+            id="E1-2",
+        ),
+    ],
+)
+def test_example_table_success(text: str, expected: list[Expense]) -> None:
+    assert parse_bank_csv(text) == expected
+
+
+def test_E1_3() -> None:
+    with pytest.raises(BankCsvError) as ei:
+        parse_bank_csv("日付,金額\n2026-02-30,abc")
+    errs = ei.value.errors
+    assert [(e.line, e.column) for e in errs] == [(2, "日付"), (2, "金額")]
+    assert errs[0] == RowError(2, "日付", "2026-02-30", errs[0].reason)
+    assert errs[1].value == "abc"
+
+
+# --- R1 区切り・BOM・改行 ----------------------------------------------
+
+
+def test_tab_delimiter_is_detected() -> None:
+    assert parse_bank_csv("日付\t金額\n2026-01-05\t100") == [
+        Expense(date(2026, 1, 5), "未分類", 100, "")
+    ]
+
+
+@pytest.mark.parametrize("newline", ["\n", "\r\n", "\r"])
+def test_newline_variants(newline: str) -> None:
+    text = newline.join(["日付,金額", "2026-01-05,100", "2026-01-06,200", ""])
+    assert [e.amount for e in parse_bank_csv(text)] == [100, 200]
+
+
+def test_bom_is_removed() -> None:
+    assert parse_bank_csv("﻿日付,金額\n2026-01-05,100") == [
+        Expense(date(2026, 1, 5), "未分類", 100, "")
+    ]
+
+
+def test_quoted_newline_is_part_of_value() -> None:
+    assert parse_bank_csv('日付,摘要,金額\n2026-01-05,"a\nb",100') == [
+        Expense(date(2026, 1, 5), "未分類", 100, "a\nb")
+    ]
+
+
+# --- R2 ヘッダー別名 ----------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "header",
+    [" 日付 , 金額 ", "DATE,AMOUNT", "Date,Amount", "取引日,利用金額"],
+)
+def test_header_aliases_and_spacing(header: str) -> None:
+    assert parse_bank_csv(f"{header}\n2026-01-05,100") == [
+        Expense(date(2026, 1, 5), "未分類", 100, "")
+    ]
+
+
+def test_category_and_memo_are_read_when_present() -> None:
+    text = "日付,分類,金額,内容\n2026-01-05, ＳＵＢＷＡＹ ,100,  スーパー  "
+    assert parse_bank_csv(text) == [
+        Expense(date(2026, 1, 5), "SUBWAY", 100, "スーパー")
+    ]
+
+
+# --- R3 必須列・空入力 ---------------------------------------------------
+
+
+def test_missing_date_column_is_error_on_line_1() -> None:
+    with pytest.raises(BankCsvError) as ei:
+        parse_bank_csv("金額\n100")
+    assert ei.value.errors == [RowError(1, "日付", "", ei.value.errors[0].reason)]
+
+
+def test_missing_amount_columns_is_error_on_line_1() -> None:
+    with pytest.raises(BankCsvError) as ei:
+        parse_bank_csv("日付,摘要\n2026-01-05,x")
