@@ -0,0 +1,150 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthly_diff import CategoryDiff, format_diff, monthly_diff
+
+
+def _e(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+@pytest.mark.parametrize(
+    ("expenses", "year", "month", "expected"),
+    [
+        pytest.param(
+            [_e("2026-01-05", "食費", 3000), _e("2025-12-20", "食費", 2000)],
+            2026,
+            1,
+            [CategoryDiff("食費", 2000, 3000, 1000, 0.5, "増")],
+            id="E4-1",
+        ),
+        pytest.param(
+            [_e("2026-01-10", "趣味", 500)],
+            2026,
+            1,
+            [CategoryDiff("趣味", 0, 500, 500, None, "増")],
+            id="E4-2",
+        ),
+    ],
+)
+def test_monthly_diff_examples(
+    expenses: list[Expense],
+    year: int,
+    month: int,
+    expected: list[CategoryDiff],
+) -> None:
+    assert monthly_diff(expenses, year, month) == expected
+
+
+@pytest.mark.parametrize(
+    "month",
+    [
+        pytest.param(0, id="E4-3"),
+        pytest.param(13, id="E4-3-13"),
+    ],
+)
+def test_invalid_month_raises(month: int) -> None:
+    with pytest.raises(ValueError):
+        monthly_diff([], 2026, month)
+
+
+# --- 端のケース(仕様文面から) ---
+
+
+def test_january_previous_is_december_of_previous_year() -> None:
+    expenses = [
+        _e("2025-11-30", "食費", 999),
+        _e("2025-12-01", "食費", 100),
+        _e("2025-01-15", "食費", 777),
+        _e("2026-01-02", "食費", 200),
+    ]
+    assert monthly_diff(expenses, 2026, 1) == [
+        CategoryDiff("食費", 100, 200, 100, 1.0, "増")
+    ]
+
+
+def test_decrease_when_only_previous_month_has_category() -> None:
+    expenses = [_e("2025-12-03", "食費", 1000)]
+    assert monthly_diff(expenses, 2026, 1) == [
+        CategoryDiff("食費", 1000, 0, -1000, -1.0, "減")
+    ]
+
+
+def test_unchanged_amount_is_included_as_no_change() -> None:
+    expenses = [_e("2025-12-03", "食費", 800), _e("2026-01-03", "食費", 800)]
+    assert monthly_diff(expenses, 2026, 1) == [
+        CategoryDiff("食費", 800, 800, 0, 0.0, "変化なし")
+    ]
+
+
+def test_negative_previous_uses_abs_for_rate() -> None:
+    # 前月は返金のみで合計が -1000、今月は -500 → delta=+500, rate=500/1000
+    expenses = [_e("2025-12-03", "食費", -1000), _e("2026-01-03", "食費", -500)]
+    assert monthly_diff(expenses, 2026, 1) == [
+        CategoryDiff("食費", -1000, -500, 500, 0.5, "増")
+    ]
+
+
+def test_category_with_zero_totals_in_both_months_is_excluded() -> None:
+    expenses = [
+        _e("2026-01-03", "趣味", 100),
+        _e("2026-01-04", "趣味", -100),
+    ]
+    assert monthly_diff(expenses, 2026, 1) == []
+
+
+def test_empty_when_neither_month_has_records() -> None:
+    expenses = [_e("2026-03-03", "食費", 100)]
+    assert monthly_diff(expenses, 2026, 1) == []
+    assert monthly_diff([], 2026, 1) == []
+
+
+def test_sorted_by_abs_delta_desc_then_category_asc() -> None:
+    expenses = [
+        _e("2025-12-01", "b", 1000),
+        _e("2026-01-01", "b", 700),  # delta -300
+        _e("2025-12-01", "a", 0),
+        _e("2026-01-01", "a", 300),  # delta +300 (ties with b, a first)
+        _e("2026-01-01", "c", 100),  # delta +100
+    ]
+    names = [d.category for d in monthly_diff(expenses, 2026, 1)]
+    assert names == ["a", "b", "c"]
+
+
+# --- format_diff ---
+
+
+def test_format_diff_line_with_rate() -> None:
+    diffs = [CategoryDiff("食費", 2000, 3000, 1000, 0.5, "増")]
+    assert format_diff(diffs) == "食費: 2000円 → 3000円 (+1000円, +50.0%) 増"
+
+
+def test_format_diff_negative_delta_and_rate() -> None:
+    diffs = [CategoryDiff("食費", 1000, 800, -200, -0.2, "減")]
+    assert format_diff(diffs) == "食費: 1000円 → 800円 (-200円, -20.0%) 減"
+
+
+def test_format_diff_rate_none_is_not_comparable() -> None:
+    diffs = [CategoryDiff("趣味", 0, 500, 500, None, "増")]
+    assert format_diff(diffs) == "趣味: 0円 → 500円 (+500円, 比較不可) 増"
+
+
+def test_format_diff_joins_lines_without_trailing_newline() -> None:
+    diffs = [
+        CategoryDiff("a", 100, 200, 100, 1.0, "増"),
+        CategoryDiff("b", 100, 0, -100, -1.0, "減"),
+    ]
+    text = format_diff(diffs)
+    assert text.split("\n") == [
+        "a: 100円 → 200円 (+100円, +100.0%) 増",
+        "b: 100円 → 0円 (-100円, -100.0%) 減",
+    ]
+    assert not text.endswith("\n")
+
+
+def test_format_diff_empty_returns_no_difference_message() -> None:
+    assert format_diff([]) == "差異なし"
