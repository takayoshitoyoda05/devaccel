+
+
+def test_memo_empty_when_column_absent() -> None:
+    assert parse_bank_csv("日付,金額\n2026-01-05,100")[0].memo == ""
+
+
+def test_category_is_nfkc_and_stripped() -> None:
+    text = "日付,カテゴリ,金額\n2026-01-05,  食費　,100"
+    assert parse_bank_csv(text)[0].category == "食費"
diff --git a/tests/test_monthly_diff.py b/tests/test_monthly_diff.py
