@@ -0,0 +1,192 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    all_of,
+    amount_between,
+    any_of,
+    category_is,
+    date_between,
+    memo_contains,
+    not_,
+    search,
+)
+
+
+def _e(
+    day: date = date(2026, 1, 15),
+    category: str = "食費",
+    amount: int = 500,
+    memo: str = "",
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- 仕様の例の表 ---------------------------------------------------------
+
+
+def test_E3_1_amount_between_both_ends_inclusive() -> None:
+    # E3-1: amount_between(500, 500) を amount=500 に → True (R2)
+    assert amount_between(500, 500)(_e(amount=500)) is True
+
+
+def test_E3_2_memo_contains_nfkc_and_lowercase() -> None:
+    # E3-2: memo_contains("ｎｅｔ") を memo="Netflix" に → True (R3)
+    assert memo_contains("ｎｅｔ")(_e(memo="Netflix")) is True
+
+
+def test_E3_3_date_between_reversed_range_raises() -> None:
+    # E3-3: date_between(date(2026,2,1), date(2026,1,1)) → ValueError (R2)
+    with pytest.raises(ValueError):
+        date_between(date(2026, 2, 1), date(2026, 1, 1))
+
+
+# --- R1 category_is -------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("case_id", "names", "category", "expected"),
+    [
+        ("R1-1", ("食費",), "食費", True),
+        ("R1-2", ("ＦＯＯＤ",), "food", True),  # NFKC + 小文字化
+        ("R1-3", ("  食費  ",), "食費", True),  # 前後空白除去
+        ("R1-4", ("食",), "食費", False),  # 部分一致ではない
+        ("R1-5", ("食費", "雑費"), "雑費", True),  # どれか一致で真
+        ("R1-6", (), "食費", False),  # 名前 0 個は偽
+    ],
+    ids=lambda v: v if isinstance(v, str) and v.startswith("R1-") else None,
+)
+def test_category_is(case_id, names, category, expected) -> None:
+    assert category_is(*names)(_e(category=category)) is expected
+
+
+# --- R2 amount_between / date_between -------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("case_id", "low", "high", "amount", "expected"),
+    [
+        ("R2-1", 100, 500, 100, True),  # 下端含む
+        ("R2-2", 100, 500, 500, True),  # 上端含む
+        ("R2-3", 100, 500, 99, False),
+        ("R2-4", 100, 500, 501, False),
+        ("R2-5", None, 500, -10_000, True),  # None は無制限
+        ("R2-6", 100, None, 10_000_000, True),
+        ("R2-7", None, None, 0, True),
+    ],
+    ids=lambda v: v if isinstance(v, str) and v.startswith("R2-") else None,
+)
+def test_amount_between_bounds(case_id, low, high, amount, expected) -> None:
+    assert amount_between(low, high)(_e(amount=amount)) is expected
+
+
+def test_amount_between_low_greater_than_high_raises() -> None:
+    with pytest.raises(ValueError):
+        amount_between(501, 500)
+
+
+@pytest.mark.parametrize(
+    ("case_id", "start", "end", "day", "expected"),
+    [
+        ("R2-8", date(2026, 1, 1), date(2026, 1, 31), date(2026, 1, 1), True),
+        ("R2-9", date(2026, 1, 1), date(2026, 1, 31), date(2026, 1, 31), True),
+        ("R2-10", date(2026, 1, 1), date(2026, 1, 31), date(2025, 12, 31), False),
+        ("R2-11", date(2026, 1, 1), date(2026, 1, 31), date(2026, 2, 1), False),
+        ("R2-12", None, date(2026, 1, 31), date(1900, 1, 1), True),
+        ("R2-13", date(2026, 1, 1), None, date(9999, 12, 31), True),
+    ],
+    ids=lambda v: v if isinstance(v, str) and v.startswith("R2-") else None,
+)
+def test_date_between_bounds(case_id, start, end, day, expected) -> None:
+    assert date_between(start, end)(_e(day=day)) is expected
+
+
+def test_date_between_start_equal_end_is_allowed() -> None:
+    assert date_between(date(2026, 1, 1), date(2026, 1, 1))(_e(day=date(2026, 1, 1)))
+
+
+# --- R3 memo_contains -----------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("case_id", "text", "memo", "expected"),
+    [
+        ("R3-1", "", "anything", True),  # 空文字は常に真
+        ("R3-2", "", "", True),
+        ("R3-3", "net", "Netflix", True),  # 部分一致
+        ("R3-4", "NETFLIX", "netflix", True),  # 小文字化
+        ("R3-5", "ｎｅｔ", "NETFLIX", True),  # NFKC
+        ("R3-6", "spotify", "Netflix", False),
+        ("R3-7", "x", "", False),
+    ],
+    ids=lambda v: v if isinstance(v, str) and v.startswith("R3-") else None,
+)
+def test_memo_contains(case_id, text, memo, expected) -> None:
+    assert memo_contains(text)(_e(memo=memo)) is expected
+
+
+# --- R4 all_of / any_of / not_ --------------------------------------------
+
+
+def test_R4_all_of_empty_is_true() -> None:
+    assert all_of()(_e()) is True
+
+
+def test_R4_any_of_empty_is_false() -> None:
+    assert any_of()(_e()) is False
+
+
+def test_R4_all_of_requires_every_predicate() -> None:
+    p = all_of(category_is("食費"), amount_between(400, 600))
+    assert p(_e(category="食費", amount=500)) is True
+    assert p(_e(category="食費", amount=700)) is False
+    assert p(_e(category="雑費", amount=500)) is False
+
+
+def test_R4_any_of_requires_one_predicate() -> None:
+    p = any_of(category_is("食費"), category_is("雑費"))
+    assert p(_e(category="雑費")) is True
+    assert p(_e(category="交通費")) is False
+
+
+def test_R4_not_negates() -> None:
+    p = not_(memo_contains("net"))
+    assert p(_e(memo="Netflix")) is False
+    assert p(_e(memo="Spotify")) is True
+
+
+def test_R4_nested_composition() -> None:
+    p = all_of(
+        any_of(category_is("食費"), category_is("雑費")), not_(amount_between(0, 99))
+    )
+    assert p(_e(category="雑費", amount=100)) is True
+    assert p(_e(category="雑費", amount=50)) is False
+    assert p(_e(category="交通費", amount=500)) is False
+
+
+# --- R5 search ------------------------------------------------------------
+
+
+def test_R5_keeps_order_and_duplicates() -> None:
+    a = _e(amount=100, memo="a")
+    b = _e(amount=200, memo="b")
+    rows = [b, a, b, a]
+    out = search(rows, amount_between(0, None))
+    assert out == [b, a, b, a]
+
+
+def test_R5_returns_new_list_and_does_not_mutate_input() -> None:
+    rows = [_e(amount=100), _e(amount=900)]
+    snapshot = list(rows)
+    out = search(rows, amount_between(0, 500))
+    assert out is not rows
+    assert rows == snapshot
+    assert out == [rows[0]]
+
+
+def test_R5_empty_input_returns_empty_list() -> None:
+    assert search([], all_of()) == []
