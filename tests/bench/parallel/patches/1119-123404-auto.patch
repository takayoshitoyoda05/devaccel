index 0000000..721a71d
--- /dev/null
+++ b/src/kakeibo/bankcsv.py
@@ -0,0 +1,222 @@
+"""Parse bank statement CSV text into Expense records (pure, no file I/O)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str
+    value: str
+    reason: str
+
+
+class BankCsvError(ValueError):
+    """Raised when bank CSV text has invalid rows. errors: all RowError, by line."""
+
+    def __init__(self, errors: list[RowError]) -> None:
+        super().__init__(
+            "; ".join(f"{e.line}行 {e.column}: {e.reason}" for e in errors)
+        )
+        self.errors = errors
+
+
+class _CellError(ValueError):
+    pass
+
+
+_DATE_ALIASES = ("日付", "利用日", "取引日", "ご利用日", "date")
+_CATEGORY_ALIASES = ("カテゴリ", "分類", "category")
+_MEMO_ALIASES = (
+    "摘要",
+    "メモ",
+    "利用店名",
+    "ご利用店名",
+    "内容",
+    "description",
+    "memo",
+)
+_AMOUNT_ALIASES = ("金額", "利用金額", "ご利用金額", "amount")
+_OUT_ALIASES = ("出金額", "出金", "お支払金額", "支払")
+_IN_ALIASES = ("入金額", "入金", "お預入金額", "預入")
+
+_TIME_SUFFIX_RE = re.compile(r"(.+?)(?:\s+|T)[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?")
+_DATE_PATTERNS = (
+    re.compile(r"([0-9]{4})[-/.]([0-9]{1,2})[-/.]([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日"),
+    re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})"),
+)
+_YEN_NOISE_RE = re.compile(r"[\s¥円,]|JPY", re.IGNORECASE)
+_DIGITS_RE = re.compile(r"[0-9]+")
+
+
+def _nfkc(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip()
+
+
+def _parse_date(raw: str) -> date:
+    s = unicodedata.normalize("NFKC", raw).strip()
+    m = _TIME_SUFFIX_RE.fullmatch(s)
+    if m is not None:
+        s = m.group(1)
+    for pat in _DATE_PATTERNS:
+        dm = pat.fullmatch(s)
+        if dm is None:
+            continue
+        y, mo, d = (int(g) for g in dm.groups())
+        try:
+            return date(y, mo, d)
+        except ValueError:
+            raise _CellError("存在しない日付です") from None
+    if not s:
+        raise _CellError("日付が空欄です")
+    raise _CellError("日付として解釈できません")
+
+
+def _yen_body(raw: str) -> str:
+    return _YEN_NOISE_RE.sub("", unicodedata.normalize("NFKC", raw))
+
+
+def _parse_yen(raw: str) -> int:
+    s = _yen_body(raw)
+    if not s:
+        raise _CellError("金額が空欄です")
+    sign = 1
+    if s.startswith("+"):
+        s = s[1:]
+    elif s[0] in "-−△▲":
+        sign = -1
+        s = s[1:]
+    elif s.startswith("(") and s.endswith(")"):
+        sign = -1
+        s = s[1:-1]
+    elif s.endswith("-"):
+        sign = -1
+        s = s[:-1]
+    if not _DIGITS_RE.fullmatch(s):
+        raise _CellError("金額として解釈できません")
+    return sign * int(s)
+
+
+def _find(header: list[str], aliases: tuple[str, ...]) -> int | None:
+    for i, h in enumerate(header):
+        if h.strip().lower() in aliases:
+            return i
+    return None
+
+
+def _check_date(raw: str, line: int, errors: list[RowError]) -> date | None:
+    try:
+        return _parse_date(raw)
+    except _CellError as e:
+        errors.append(RowError(line, "日付", raw, str(e)))
+        return None
+
+
+def _check_yen(
+    raw: str, column: str, line: int, errors: list[RowError], *, blank_is_zero: bool
+) -> int | None:
+    if blank_is_zero and not _yen_body(raw):
+        return 0
+    try:
+        return _parse_yen(raw)
+    except _CellError as e:
+        errors.append(RowError(line, column, raw, str(e)))
+        return None
+
+
+def parse_bank_csv(text: str) -> list[Expense]:
+    text = text.removeprefix("﻿")
+    first_line = re.split(r"\r\n|\r|\n", text, maxsplit=1)[0]
+    delim = "\t" if first_line.count("\t") > first_line.count(",") else ","
+
+    records: list[tuple[int, list[str]]] = []
+    last_end = 0
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delim)
+    for row in reader:
+        records.append((last_end + 1, row))
+        last_end = reader.line_num
+
+    records = [(ln, r) for ln, r in records if any(c.strip() for c in r)]
+    if not records:
+        return []
+
+    _, raw_header = records[0]
+    header = [h.strip().lower() for h in raw_header]
+    body = records[1:]
+
+    date_i = _find(header, _DATE_ALIASES)
+    amount_i = _find(header, _AMOUNT_ALIASES)
+    out_i = _find(header, _OUT_ALIASES)
+    in_i = _find(header, _IN_ALIASES)
+    cat_i = _find(header, _CATEGORY_ALIASES)
+    memo_i = _find(header, _MEMO_ALIASES)
+
+    header_errors: list[RowError] = []
+    if date_i is None:
+        header_errors.append(RowError(1, "日付", "", "日付列がありません"))
+    if amount_i is None and out_i is None and in_i is None:
+        header_errors.append(
+            RowError(1, "金額", "", "金額列(または出金・入金列)がありません")
+        )
+    if header_errors:
+        raise BankCsvError(header_errors)
+    assert date_i is not None  # narrowed by the header check above
+
+    errors: list[RowError] = []
+    rows: list[Expense] = []
+    for line, row in body:
+        if len(row) != len(raw_header):
+            errors.append(
+                RowError(
+                    line,
+                    "(行)",
+                    delim.join(row),
+                    f"列数が合いません(ヘッダー {len(raw_header)} 列・行 {len(row)} 列)",
+                )
+            )
+            continue
+        before = len(errors)
+        day = _check_date(row[date_i], line, errors)
+        category = _nfkc(row[cat_i]) if cat_i is not None else "未分類"
+        memo = _nfkc(row[memo_i]) if memo_i is not None else ""
+
+        amount: int | None
+        if amount_i is not None:
+            amount = _check_yen(
+                row[amount_i], "金額", line, errors, blank_is_zero=False
+            )
+        else:
+            assert out_i is not None or in_i is not None
+            out_v = (
+                _check_yen(row[out_i], "出金", line, errors, blank_is_zero=True)
+                if out_i is not None
+                else 0
+            )
+            in_v = (
+                _check_yen(row[in_i], "入金", line, errors, blank_is_zero=True)
+                if in_i is not None
+                else 0
+            )
+            # 出金が無い行(入金のみ)は収入なのでスキップ
+            if out_v is None or in_v is None or out_v == 0:
+                amount = None
+            else:
+                amount = out_v - in_v
+
+        if len(errors) == before and day is not None and amount:
+            rows.append(Expense(day=day, category=category, amount=amount, memo=memo))
+
+    if errors:
+        errors.sort(key=lambda e: e.line)
+        raise BankCsvError(errors)
+    return rows
