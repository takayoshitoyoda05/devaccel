+"""Tests for kakeibo.recurring (定期支出の検出)."""
+
+from __future__ import annotations
+
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring
+
+
+def test_E2_1_rent_monthend_next_date() -> None:
+    """E2-1: 家賃 80000 を 2026-01-31, 02-28, 03-31 → 1 件、months=3、next_date=2026-04-30 (R4, D5)."""
+    rows = [
+        Expense(date(2026, 1, 31), "住居", 80000, "家賃"),
+        Expense(date(2026, 2, 28), "住居", 80000, "家賃"),
+        Expense(date(2026, 3, 31), "住居", 80000, "家賃"),
+    ]
+    result = find_recurring(rows)
+    assert result == [
+        Recurring(
+            category="住居",
+            memo="家賃",
+            amount=80000,
+            months=3,
+            last_date=date(2026, 3, 31),
+            next_date=date(2026, 4, 30),
+        )
+    ]
+
+
+def test_E2_2_gap_in_months_yields_nothing() -> None:
+    """E2-2: Netflix 1490 を 2025-10-05, 2025-11-05, 2026-01-05(12 月欠け) → []。連続列は直近の 1 件のみ (D4)."""
+    rows = [
+        Expense(date(2025, 10, 5), "通信", 1490, "Netflix"),
+        Expense(date(2025, 11, 5), "通信", 1490, "Netflix"),
+        Expense(date(2026, 1, 5), "通信", 1490, "Netflix"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_E2_3_memo_numbers_and_case_group_together() -> None:
+    """E2-3: `NETFLIX 1`(メモ) と `Netflix 2` は同じグループ (D3)."""
+    rows = [
+        Expense(date(2026, 1, 5), "通信", 1490, "NETFLIX 1"),
+        Expense(date(2026, 2, 5), "通信", 1490, "Netflix 2"),
+        Expense(date(2026, 3, 5), "通信", 1490, "NETFLIX 1"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].months == 3
+    assert result[0].memo == "NETFLIX 1"
