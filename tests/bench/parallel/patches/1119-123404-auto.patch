new file mode 100644
index 0000000..be44e11
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,82 @@
+"""Composable predicates for filtering Expense records."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable
+from datetime import date
+
+from kakeibo.core import Expense
+
+Predicate = Callable[[Expense], bool]
+
+
+def _norm(text: str) -> str:
+    return unicodedata.normalize("NFKC", text).lower()
+
+
+def category_is(*names: str) -> Predicate:
+    targets = {_norm(n).strip() for n in names}
+
+    def pred(e: Expense) -> bool:
+        return _norm(e.category).strip() in targets
+
+    return pred
+
+
+def amount_between(low: int | None = None, high: int | None = None) -> Predicate:
+    if low is not None and high is not None and low > high:
+        raise ValueError(f"金額の範囲が不正です: {low} > {high}")
+
+    def pred(e: Expense) -> bool:
+        if low is not None and e.amount < low:
+            return False
+        return high is None or e.amount <= high
+
+    return pred
+
+
+def memo_contains(text: str) -> Predicate:
+    needle = _norm(text)
+
+    def pred(e: Expense) -> bool:
+        return needle in _norm(e.memo)
+
+    return pred
+
+
+def date_between(start: date | None = None, end: date | None = None) -> Predicate:
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"期間の範囲が不正です: {start} > {end}")
+
+    def pred(e: Expense) -> bool:
+        if start is not None and e.day < start:
+            return False
+        return end is None or e.day <= end
+
+    return pred
+
+
+def all_of(*preds: Predicate) -> Predicate:
+    def pred(e: Expense) -> bool:
+        return all(p(e) for p in preds)
+
+    return pred
+
+
+def any_of(*preds: Predicate) -> Predicate:
+    def pred(e: Expense) -> bool:
+        return any(p(e) for p in preds)
+
+    return pred
+
+
+def not_(p: Predicate) -> Predicate:
+    def pred(e: Expense) -> bool:
+        return not p(e)
+
+    return pred
+
+
+def search(expenses: list[Expense], pred: Predicate) -> list[Expense]:
+    return [e for e in expenses if pred(e)]
