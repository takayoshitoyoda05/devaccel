index 0000000..a8c7df2
--- /dev/null
+++ b/tests/test_compare.py
@@ -0,0 +1,195 @@
+from __future__ import annotations
+
+import copy
+
+import pytest
+
+from kakeibo.compare import Change, format_report, month_over_month
+
+
+def _find(changes: list[Change], category: str) -> Change:
+    return next(c for c in changes if c.category == category)
+
+
+@pytest.mark.parametrize(
+    ("id_", "totals", "month", "category", "prev", "curr", "diff", "pct", "status"),
+    [
+        # E4-1: 増 (R3, R4)
+        (
+            "E4-1",
+            {"2026-10": {"食費": 30000}, "2026-11": {"食費": 36000}},
+            "2026-11",
+            "食費",
+            30000,
+            36000,
+            6000,
+            20.0,
+            "増",
+        ),
+        # E4-2: 消滅 (R2, R3)
+        (
+            "E4-2",
+            {"2026-10": {"交通費": 5000}, "2026-11": {}},
+            "2026-11",
+            "交通費",
+            5000,
+            0,
+            -5000,
+            -100.0,
+            "消滅",
+        ),
+        # E4-3: 新規 (R3, R4)
+        (
+            "E4-3",
+            {"2026-10": {}, "2026-11": {"趣味": 3000}},
+            "2026-11",
+            "趣味",
+            0,
+            3000,
+            3000,
+            None,
+            "新規",
+        ),
+        # E4-4: 1月は前年12月と比較 (R1)
+        (
+            "E4-4",
+            {"2025-12": {"食費": 1000}, "2026-01": {"食費": 2000}},
+            "2026-01",
+            "食費",
+            1000,
+            2000,
+            1000,
+            100.0,
+            "増",
+        ),
+        # E4-8: 同額 (R3)
+        (
+            "E4-8",
+            {"2026-10": {"食費": 4000}, "2026-11": {"食費": 4000}},
+            "2026-11",
+            "食費",
+            4000,
+            4000,
+            0,
+            0.0,
+            "変わらず",
+        ),
+        # 減 (R3) — 表には無いが status 3 値のうち「減」の確認
+        (
+            "R3-減",
+            {"2026-10": {"食費": 4000}, "2026-11": {"食費": 1000}},
+            "2026-11",
+            "食費",
+            4000,
+            1000,
+            -3000,
+            -75.0,
+            "減",
+        ),
+    ],
+    ids=["E4-1", "E4-2", "E4-3", "E4-4", "E4-8", "R3-減"],
+)
+def test_month_over_month_cases(
+    id_: str,
+    totals: dict[str, dict[str, int]],
+    month: str,
+    category: str,
+    prev: int,
+    curr: int,
+    diff: int,
+    pct: float | None,
+    status: str,
+) -> None:
+    changes = month_over_month(totals, month)
+    c = _find(changes, category)
+    assert (c.prev, c.curr, c.diff, c.pct, c.status) == (prev, curr, diff, pct, status)
+
+
+def test_E4_2_missing_side_is_zero() -> None:
+    # E4-2: 当月に無いカテゴリは curr=0
+    c = _find(
+        month_over_month({"2026-10": {"交通費": 5000}, "2026-11": {}}, "2026-11"),
+        "交通費",
+    )
+    assert c.curr == 0
+
+
+def test_E4_5_prev_month_absent_all_new() -> None:
+    # E4-5: 前月が totals に無ければ当月分は全て "新規"
+    changes = month_over_month({"2026-11": {"食費": 100, "住居": 200}}, "2026-11")
+    assert {c.status for c in changes} == {"新規"}
+    assert len(changes) == 2
+
+
+def test_E4_5_empty_totals_returns_empty() -> None:
+    # E4-5: totals が空なら空リスト
+    assert month_over_month({}, "2026-11") == []
+
+
+def test_E4_6_tie_sorted_by_category_name() -> None:
+    # E4-6: 増減 +500 と -500 と 食費/住居 の同点 → カテゴリ名昇順
+    totals = {
+        "2026-10": {"食費": 1000, "住居": 1000},
+        "2026-11": {"食費": 1500, "住居": 500},
+    }
+    changes = month_over_month(totals, "2026-11")
+    assert [c.diff for c in changes] == [-500, 500]
+    assert [c.category for c in changes] == ["住居", "食費"]
+
+
+def test_E4_7_invalid_month_raises() -> None:
+    # E4-7: month="2026-13" は ValueError
+    with pytest.raises(ValueError):
+        month_over_month({}, "2026-13")
+
+
+def test_E4_7_non_yyyy_mm_raises() -> None:
+    # R1: YYYY-MM でなければ ValueError
+    with pytest.raises(ValueError):
+        month_over_month({"2026-11": {"食費": 1}}, "2026/11")
+
+
+def test_P1_sum_of_diff_equals_total_difference() -> None:
+    totals = {
+        "2026-10": {"食費": 30000, "交通費": 5000, "住居": 80000},
+        "2026-11": {"食費": 36000, "趣味": 3000, "住居": 70000},
+    }
+    changes = month_over_month(totals, "2026-11")
+    assert sum(c.diff for c in changes) == sum(totals["2026-11"].values()) - sum(
+        totals["2026-10"].values()
+    )
+
+
+def test_P2_input_totals_not_mutated() -> None:
+    totals = {
+        "2026-10": {"食費": 30000, "交通費": 5000},
+        "2026-11": {"食費": 36000, "趣味": 3000},
+    }
+    snapshot = copy.deepcopy(totals)
+    month_over_month(totals, "2026-11")
+    assert totals == snapshot
+
+
+def test_R5_sorted_by_abs_diff_desc() -> None:
+    totals = {
+        "2026-10": {"A": 100, "B": 100, "C": 100},
+        "2026-11": {"A": 110, "B": 50, "C": 0},
+    }
+    changes = month_over_month(totals, "2026-11")
+    assert [c.category for c in changes] == ["C", "B", "A"]
+
+
+def test_format_report_line() -> None:
+    changes = month_over_month(
+        {"2026-10": {"食費": 30000}, "2026-11": {"食費": 36000}}, "2026-11"
+    )
+    assert format_report(changes) == "食費  30000→36000  (+6000円, +20.0%) 増"
+
+
+def test_format_report_omits_pct_when_none() -> None:
+    changes = month_over_month({"2026-11": {"趣味": 3000}}, "2026-11")
+    assert format_report(changes) == "趣味  0→3000  (+3000円) 新規"
+
+
+def test_format_report_empty() -> None:
+    assert format_report([]) == "比較できるデータがありません"
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..862b2cf
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,180 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import (
+    all_of,
+    amount_between,
+    any_of,
+    category_is,
+    date_between,
+    memo_contains,
+    not_,
+    search,
+)
+
+MONTH_START = date(2026, 3, 1)
+MONTH_END = date(2026, 3, 31)
+
+
+def _e(
+    amount: int,
+    category: str = "食費",
+    memo: str = "",
+    day: date = MONTH_START,
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# E3-1: amount_between は両端を含む
+@pytest.mark.parametrize(
+    ("amount", "expected"),
+    [
+        pytest.param(1000, True, id="E3-1-lo"),
+        pytest.param(2000, True, id="E3-1-hi"),
+        pytest.param(999, False, id="E3-1-below"),
+    ],
+)
+def test_amount_between_inclusive(amount: int, expected: bool) -> None:
+    assert amount_between(1000, 2000)(_e(amount)) is expected
+
+
+def test_E3_1_filters_rows_in_order() -> None:
+    rows = [_e(1000), _e(2000), _e(999)]
+    assert search(rows, amount_between(1000, 2000)) == [rows[0], rows[1]]
+
+
+# E3-2: date_between は月末日を含む
+def test_E3_2_month_end_included() -> None:
+    row = _e(100, day=MONTH_END)
+    assert date_between(MONTH_START, MONTH_END)(row) is True
+
+
+# E3-3: amount_between の lo > hi は ValueError
+def test_E3_3_amount_between_lo_gt_hi_raises() -> None:
+    with pytest.raises(ValueError):
+        amount_between(2000, 1000)
+
+
+# E3-4: memo_contains は大文字小文字を区別しない部分一致
+def test_E3_4_memo_contains_case_insensitive() -> None:
+    assert memo_contains("Coffee")(_e(300, memo="coffee shop")) is True
+
+
+# E3-5: all_of(食費, amount_between(hi=500)) は食費かつ 500 以下
+@pytest.mark.parametrize(
+    ("row", "expected"),
+    [
+        pytest.param(_e(500, "食費"), True, id="E3-5-match"),
+        pytest.param(_e(501, "食費"), False, id="E3-5-over"),
+        pytest.param(_e(100, "交通費"), False, id="E3-5-other-category"),
+    ],
+)
+def test_E3_5_all_of(row: Expense, expected: bool) -> None:
+    pred = all_of(category_is("食費"), amount_between(hi=500))
+    assert pred(row) is expected
+
+
+# E3-6: any_of(食費, memo_contains("家賃")) はどちらか
+@pytest.mark.parametrize(
+    ("row", "expected"),
+    [
+        pytest.param(_e(1000, "食費"), True, id="E3-6-category"),
+        pytest.param(_e(80000, "住居", memo="家賃 3月"), True, id="E3-6-memo"),
+        pytest.param(_e(1000, "交通費", memo="電車"), False, id="E3-6-neither"),
+    ],
+)
+def test_E3_6_any_of(row: Expense, expected: bool) -> None:
+    pred = any_of(category_is("食費"), memo_contains("家賃"))
+    assert pred(row) is expected
+
+
+# E3-7: not_(食費) は食費以外、category_is() は ValueError
+def test_E3_7_not_category() -> None:
+    pred = not_(category_is("食費"))
+    assert pred(_e(100, "食費")) is False
+    assert pred(_e(100, "交通費")) is True
+
+
+def test_E3_7_category_is_without_names_raises() -> None:
+    with pytest.raises(ValueError):
+        category_is()
+
+
+# E3-8: all_of() は全件、any_of() は 0 件、空の rows は空
+def test_E3_8_empty_all_of_matches_all() -> None:
+    rows = [_e(1), _e(2)]
+    assert search(rows, all_of()) == rows
+
+
+def test_E3_8_empty_any_of_matches_none() -> None:
+    rows = [_e(1), _e(2)]
+    assert search(rows, any_of()) == []
+
+
+def test_E3_8_empty_rows_returns_empty() -> None:
+    assert search([], amount_between(0, 10)) == []
+
+
+# E3-9: 負の金額(返金)は符号つきのまま比較する
+def test_E3_9_negative_amount_matches_hi_zero() -> None:
+    assert amount_between(hi=0)(_e(-500)) is True
+
+
+# R1 / R5 補助: date_between の端、start > end、入力不変
+@pytest.mark.parametrize(
+    ("day", "expected"),
+    [
+        pytest.param(MONTH_START, True, id="R1-start"),
+        pytest.param(MONTH_END, True, id="R1-end"),
+        pytest.param(date(2026, 2, 28), False, id="R1-before"),
+        pytest.param(date(2026, 4, 1), False, id="R1-after"),
+    ],
+)
+def test_date_between_inclusive(day: date, expected: bool) -> None:
+    assert date_between(MONTH_START, MONTH_END)(_e(1, day=day)) is expected
+
+
+def test_date_between_start_gt_end_raises() -> None:
+    with pytest.raises(ValueError):
+        date_between(MONTH_END, MONTH_START)
+
+
+def test_date_between_none_is_unbounded() -> None:
+    row = _e(1, day=date(1999, 1, 1))
+    assert date_between(end=MONTH_END)(row) is True
+    assert date_between(start=MONTH_START)(row) is False
+
+
+def test_amount_between_none_is_unbounded() -> None:
+    assert amount_between(lo=None, hi=None)(_e(-(10**9))) is True
+
+
+def test_R2_empty_memo_text_matches_all() -> None:
+    assert memo_contains("")(_e(1, memo="")) is True
+
+
+def test_R5_search_returns_new_list_and_keeps_input() -> None:
+    rows = [_e(1), _e(2000)]
+    snapshot = list(rows)
+    result = search(rows, amount_between(hi=1000))
+    assert result is not rows
+    assert rows == snapshot
+
+
+# P1: search の結果は入力の部分列
+def test_P1_result_is_subsequence() -> None:
+    rows = [_e(300), _e(100), _e(200), _e(50)]
+    result = search(rows, amount_between(lo=100))
+    it = iter(rows)
+    assert all(any(r is x for x in it) for r in result)
+
+
+# P2: not_(not_(p)) は p と同じ結果
+def test_P2_double_negation() -> None:
+    rows = [_e(100, "食費"), _e(200, "交通費"), _e(300, "食費")]
+    p = category_is("食費")
+    assert search(rows, not_(not_(p))) == search(rows, p)
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..fd3d37a
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,216 @@
+from __future__ import annotations
+
+import copy
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, next_month_date
+
+
+def ex(
+    day: date, amount: int, memo: str = "rent", category: str = "housing"
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# E1-1: 家賃 80000 を 1/25・2/25・3/25 -> 定期。next_due は 4/25 (R2, R4)
+def test_E1_1_monthly_rent_is_recurring() -> None:
+    rows = [
+        ex(date(2025, 1, 25), 80000),
+        ex(date(2025, 2, 25), 80000),
+        ex(date(2025, 3, 25), 80000),
+    ]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="housing",
+            memo="rent",
+            amount=80000,
+            count=3,
+            last=date(2025, 3, 25),
+            next_due=date(2025, 4, 25),
+        )
+    ]
+
+
+# E1-2: 動画 1,200 を 1/31・2/28・3/31 -> next_due は 4/30 (日は 31 を丸める) (R4)
+def test_E1_2_next_due_clips_day_to_month_end() -> None:
+    rows = [
+        ex(date(2025, 1, 31), 1200, memo="video"),
+        ex(date(2025, 2, 28), 1200, memo="video"),
+        ex(date(2025, 3, 31), 1200, memo="video"),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.next_due == date(2025, 4, 30)
+
+
+# E1-3: 同じ 3 件だが 2 月が欠ける -> 定期でない (R2)
+def test_E1_3_month_gap_is_not_recurring() -> None:
+    rows = [
+        ex(date(2025, 1, 25), 80000),
+        ex(date(2025, 3, 25), 80000),
+        ex(date(2025, 4, 25), 80000),
+    ]
+    assert find_recurring(rows) == []
+
+
