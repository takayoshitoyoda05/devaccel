@@ -0,0 +1,58 @@
+"""Filter expense records with composable predicates."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from datetime import date
+
+from kakeibo.core import Expense
+
+Predicate = Callable[[Expense], bool]
+
+
+def category_is(*names: str) -> Predicate:
+    """カテゴリが names のどれかに完全一致する。names が空なら ValueError。"""
+    if not names:
+        raise ValueError("category_is には少なくとも 1 つのカテゴリ名が必要です")
+    allowed = frozenset(names)
+    return lambda e: e.category in allowed
+
+
+def amount_between(lo: int | None = None, hi: int | None = None) -> Predicate:
+    """lo <= amount <= hi(両端を含む)。None は無制限。lo > hi は ValueError。"""
+    if lo is not None and hi is not None and lo > hi:
+        raise ValueError(f"lo({lo}) > hi({hi})")
+    return lambda e: (lo is None or e.amount >= lo) and (hi is None or e.amount <= hi)
+
+
+def memo_contains(text: str) -> Predicate:
+    """メモに text を大文字小文字を区別せず部分一致で含む。空文字は全件一致。"""
+    needle = text.casefold()
+    return lambda e: needle in e.memo.casefold()
+
+
+def date_between(start: date | None = None, end: date | None = None) -> Predicate:
+    """start <= day <= end(両端を含む)。None は無制限。start > end は ValueError。"""
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"start({start}) > end({end})")
+    return lambda e: (start is None or e.day >= start) and (end is None or e.day <= end)
+
+
+def all_of(*preds: Predicate) -> Predicate:
+    """全部真なら真。引数が空なら常に真。"""
+    return lambda e: all(p(e) for p in preds)
+
+
+def any_of(*preds: Predicate) -> Predicate:
+    """どれか真なら真。引数が空なら常に偽。"""
+    return lambda e: any(p(e) for p in preds)
+
+
+def not_(pred: Predicate) -> Predicate:
+    """pred の否定。"""
+    return lambda e: not pred(e)
+
+
+def search(rows: list[Expense], pred: Predicate) -> list[Expense]:
+    """pred が真の行を入力順に並べた新しいリストを返す。入力は変更しない。"""
+    return [e for e in rows if pred(e)]
