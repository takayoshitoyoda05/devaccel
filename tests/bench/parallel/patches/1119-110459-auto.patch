+"""Import bank / credit-card CSV text with varying headers and amount styles."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_DATE_KEYS = {"date", "日付", "利用日", "取引日"}
+_AMOUNT_KEYS = {"amount", "金額", "利用金額"}
+_OUT_KEYS = {"出金", "出金額"}
+_IN_KEYS = {"入金", "入金額"}
+_MEMO_KEYS = {"memo", "摘要", "内容", "利用店名"}
+_CATEGORY_KEYS = {"category", "カテゴリ"}
+
+_DATE_RES = (
+    re.compile(r"(\d{4})-(\d{1,2})-(\d{1,2})"),
+    re.compile(r"(\d{4})/(\d{1,2})/(\d{1,2})"),
+    re.compile(r"(\d{4})年(\d{1,2})月(\d{1,2})日"),
+)
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    rows: list[Expense]
+    errors: list[tuple[int, str]]
+
+
+def _norm(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip().casefold()
+
+
+def _parse_date(raw: str) -> date:
+    text = unicodedata.normalize("NFKC", raw).strip()
+    for rx in _DATE_RES:
+        m = rx.fullmatch(text)
+        if m:
+            try:
+                return date(int(m[1]), int(m[2]), int(m[3]))
+            except ValueError:
+                break
+    raise ValueError(f"日付が不正です: {raw!r}")
+
+
+def _parse_amount(raw: str) -> int:
+    """Signed yen; '(1,000)' and a leading '-' are negative. Empty -> ValueError."""
+    text = unicodedata.normalize("NFKC", raw)
+    text = re.sub(r"[\s,¥￥円]", "", text)
+    negative = False
+    if text.startswith("(") and text.endswith(")"):
+        negative, text = True, text[1:-1]
+    if text.startswith("-"):
+        negative, text = not negative, text[1:]
+    if not text.isascii() or not text.isdigit():
+        raise ValueError(f"金額が整数ではありません: {raw!r}")
+    value = int(text)
+    return -value if negative else value
+
+
+def _find(header: list[str], keys: set[str]) -> int | None:
+    for i, h in enumerate(header):
+        if _norm(h) in keys:
+            return i
+    return None
+
+
+def _cell(row: list[str], idx: int | None) -> str:
+    if idx is None or idx >= len(row):
+        return ""
+    return row[idx]
+
+
+def parse_bank_csv(text: str, default_category: str = "未分類") -> ImportResult:
+    text = text.removeprefix("﻿")
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header: list[str] | None = None
+    cols: dict[str, int | None] = {}
+    rows: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+
+    for fields in reader:
+        line = reader.line_num
+        if header is None:
+            header = fields
+            cols = {
+                "date": _find(header, _DATE_KEYS),
+                "amount": _find(header, _AMOUNT_KEYS),
+                "out": _find(header, _OUT_KEYS),
+                "in": _find(header, _IN_KEYS),
+                "memo": _find(header, _MEMO_KEYS),
+                "category": _find(header, _CATEGORY_KEYS),
+            }
+            has_amount = cols["amount"] is not None or (
+                cols["out"] is not None or cols["in"] is not None
+            )
+            if cols["date"] is None or not has_amount:
+                missing = []
+                if cols["date"] is None:
+                    missing.append("日付")
+                if not has_amount:
+                    missing.append("金額")
+                return ImportResult(
+                    [], [(1, f"必須列がありません: {', '.join(missing)}")]
+                )
+            continue
+        if not any(f.strip() for f in fields):
+            continue
+        # csv.reader reports the line *after* a record; report where it started.
+        start = line - sum(f.count("\n") for f in fields)
+        try:
+            day = _parse_date(_cell(fields, cols["date"]))
+            if cols["amount"] is not None:
+                amount = _parse_amount(_cell(fields, cols["amount"]))
+            else:
+                out_raw = _cell(fields, cols["out"]).strip()
+                in_raw = _cell(fields, cols["in"]).strip()
+                if not out_raw and not in_raw:
+                    raise ValueError("金額が空です")
+                out = _parse_amount(out_raw) if out_raw else 0
+                inc = _parse_amount(in_raw) if in_raw else 0
+                amount = out - inc
+            if amount == 0:
+                raise ValueError("金額が 0 円です")
+        except ValueError as e:
+            errors.append((start, str(e)))
+            continue
+        category = _cell(fields, cols["category"]).strip() or default_category
+        rows.append(Expense(day, category, amount, _cell(fields, cols["memo"])))
+
+    if header is None:
+        return ImportResult([], [(1, "必須列がありません: ヘッダ行がありません")])
+    return ImportResult(rows, errors)
