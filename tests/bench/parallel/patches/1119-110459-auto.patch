+"""Month-over-month comparison of category totals (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class Change:
+    category: str
+    prev: int
+    curr: int
+    diff: int
+    pct: float | None
+    status: str
+
+
+def _prev_month(month: str) -> str:
+    year, mon = int(month[:4]), int(month[5:])
+    if mon == 1:
+        return f"{year - 1}-12"
+    return f"{year}-{mon - 1:02d}"
+
+
+def _status(prev: int, curr: int, diff: int) -> str:
+    if prev == 0 and curr > 0:
+        return "新規"
+    if curr == 0 and prev > 0:
+        return "消滅"
+    if diff > 0:
+        return "増"
+    if diff < 0:
+        return "減"
+    return "変わらず"
+
+
+def month_over_month(totals: dict[str, dict[str, int]], month: str) -> list[Change]:
+    """Compare `month` with its calendar previous month.
+
+    totals is the shape returned by core.monthly_totals. A category missing on
+    either side counts as 0. A missing previous month counts as all zeros.
+    """
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+    prev_month = _prev_month(month)
+    curr_cats = totals.get(month, {})
+    prev_cats = totals.get(prev_month, {})
+
+    changes: list[Change] = []
+    for cat in set(curr_cats) | set(prev_cats):
+        prev = prev_cats.get(cat, 0)
+        curr = curr_cats.get(cat, 0)
+        diff = curr - prev
+        pct = None if prev == 0 else round(diff / prev * 100, 1)
+        changes.append(
+            Change(
+                category=cat,
+                prev=prev,
+                curr=curr,
+                diff=diff,
+                pct=pct,
+                status=_status(prev, curr, diff),
+            )
+        )
+    changes.sort(key=lambda c: (-abs(c.diff), c.category))
+    return changes
+
+
+def format_report(changes: list[Change]) -> str:
+    if not changes:
+        return "比較できるデータがありません"
+    lines: list[str] = []
+    for c in changes:
+        if c.pct is None:
+            delta = f"({c.diff:+d}円)"
+        else:
+            delta = f"({c.diff:+d}円, {c.pct:+.1f}%)"
+        lines.append(f"{c.category}  {c.prev}→{c.curr}  {delta} {c.status}")
+    return "\n".join(lines)
