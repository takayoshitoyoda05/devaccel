+# R5: amount 降順、同点は memo 昇順
+def test_R5_sort_order() -> None:
+    rows: list[Expense] = []
+    for memo, amount in [("b", 500), ("a", 500), ("c", 900)]:
+        for m in (1, 2, 3):
+            rows.append(ex(date(2025, m, 5), amount, memo=memo))
+    result = find_recurring(rows)
+    assert [(r.memo, r.amount) for r in result] == [("c", 900), ("a", 500), ("b", 500)]
