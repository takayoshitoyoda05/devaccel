+"""Detect recurring expenses and predict their next due date (pure functions)."""
+
+from __future__ import annotations
+
+import calendar
+import itertools
+from collections import defaultdict
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str  # normalized (stripped, lowercased) memo used as the key
+    amount: int  # median amount, yen
+    count: int
+    last: date
+    next_due: date
+
+
+def next_month_date(last: date, day: int) -> date:
+    """Date in the month after `last` on `day`, clipped to that month's last day."""
+    if last.month == 12:
+        year, month = last.year + 1, 1
+    else:
+        year, month = last.year, last.month + 1
+    last_day = calendar.monthrange(year, month)[1]
+    return date(year, month, min(day, last_day))
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month - 1
+
+
+def find_recurring(rows: list[Expense], min_count: int = 3) -> list[Recurring]:
+    groups: dict[tuple[str, str], list[Expense]] = defaultdict(list)
+    for e in rows:
+        memo = e.memo.strip().lower()
+        if memo:
+            groups[(e.category, memo)].append(e)
+
+    found: list[Recurring] = []
+    for (category, memo), items in groups.items():
+        items = sorted(items, key=lambda e: e.day)  # copy; input is not mutated
+        months = [_month_index(e.day) for e in items]
+        if len(set(months)) != len(months):  # two or more in the same month
+            continue
+        if len(items) < min_count:
+            continue
+        if any(b - a != 1 for a, b in itertools.pairwise(months)):  # gap in months
+            continue
+        amounts = sorted(e.amount for e in items)
+        median = amounts[(len(amounts) - 1) // 2]  # lower median for even counts
+        if any(abs(a - median) * 10 > abs(median) for a in amounts):  # beyond ±10%
+            continue
+        last = items[-1].day
+        found.append(
+            Recurring(
+                category=category,
+                memo=memo,
+                amount=median,
+                count=len(items),
+                last=last,
+                next_due=next_month_date(last, items[0].day.day),
+            )
+        )
+    found.sort(key=lambda r: (-r.amount, r.memo, r.category))
+    return found
