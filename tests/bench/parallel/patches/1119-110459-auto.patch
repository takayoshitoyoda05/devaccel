+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankcsv import parse_bank_csv
+from kakeibo.core import Expense
+
+
+def test_e2_1_aliases_and_yen_symbol() -> None:
+    r = parse_bank_csv('日付,金額,摘要\n2026/11/03,"¥1,200",コンビニ\n')
+    assert r.errors == []
+    assert r.rows == [Expense(date(2026, 11, 3), "未分類", 1200, "コンビニ")]
+
+
+def test_e2_2_deposit_column_is_refund() -> None:
+    r = parse_bank_csv("利用日,出金,入金\n2026年11月3日,,500\n")
+    assert r.errors == []
+    assert [e.amount for e in r.rows] == [-500]
+    assert r.rows[0].day == date(2026, 11, 3)
+
+
+def test_withdrawal_column() -> None:
+    r = parse_bank_csv("利用日,出金,入金\n2026-11-03,800,\n")
+    assert [e.amount for e in r.rows] == [800]
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [("(1,000)", -1000), ("-300", -300), ("１，２００円", 1200)],
+)
+def test_e2_3_amount_styles(raw: str, expected: int) -> None:
+    r = parse_bank_csv(f'date,amount\n2026-01-01,"{raw}"\n')
+    assert r.errors == []
+    assert [e.amount for e in r.rows] == [expected]
+
+
+@pytest.mark.parametrize("raw", ["0", "abc", "12.5", ""])
+def test_e2_4_bad_amounts(raw: str) -> None:
+    r = parse_bank_csv(f"date,amount\n2026-01-01,{raw}\n")
+    assert r.rows == []
+    assert len(r.errors) == 1
+    assert r.errors[0][0] == 2
+
+
+def test_e2_5_bad_date_keeps_other_rows() -> None:
+    r = parse_bank_csv("date,amount\n2026-13-01,100\n2026-01-02,200\n")
+    assert [e.amount for e in r.rows] == [200]
+    assert r.errors[0][0] == 2
+    assert "日付" in r.errors[0][1]
+
+
+def test_e2_6_bom_blank_lines_and_quoted_newline() -> None:
+    text = '﻿date,amount,memo\n\n2026-01-01,100,"a,b\nc"\n2026-01-02,xx,m\n'
+    r = parse_bank_csv(text)
+    assert r.rows == [Expense(date(2026, 1, 1), "未分類", 100, "a,b\nc")]
+    # physical line of the bad record: header=1, blank=2, record=3-4, bad=5
+    assert [n for n, _ in r.errors] == [5]
+
+
+def test_e2_7_missing_required_column() -> None:
