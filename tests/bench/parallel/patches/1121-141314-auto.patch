@@ -0,0 +1,162 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import import_statement, parse_amount, parse_date
+
+# --- spec example table (ids must stay in the test) ---
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        pytest.param("△1,500円", -1500, id="E2-1-a"),
+        pytest.param("(500)", -500, id="E2-1-b"),
+        pytest.param("500-", -500, id="E2-1-c"),
+    ],
+)
+def test_E2_1_parse_amount_sign_forms(raw: str, expected: int) -> None:
+    assert parse_amount(raw) == expected
+
+
+def test_E2_2_deposit_only_row_is_negative() -> None:
+    text = "日付,摘要,出金,入金\n2026-01-05,ATM,,3000\n"
+    result = import_statement(text)
+    assert result.errors == []
+    assert len(result.expenses) == 1
+    assert result.expenses[0].amount == -3000
+
+
+def test_E2_3_bad_date_and_bad_amount_report_two_errors() -> None:
+    text = "日付,金額\n2026/2/30,abc\n"
+    result = import_statement(text)
+    assert result.expenses == []
+    assert [(e.line, e.column) for e in result.errors] == [(2, "日付"), (2, "金額")]
+
+
+# --- edge cases derived from the rules ---
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        pytest.param("2026-01-05", date(2026, 1, 5), id="D5-iso"),
+        pytest.param("2026/1/5", date(2026, 1, 5), id="D5-slash"),
+        pytest.param("2026.1.5", date(2026, 1, 5), id="D5-dot"),
+        pytest.param("20260105", date(2026, 1, 5), id="D5-compact"),
+        pytest.param("2026年1月5日", date(2026, 1, 5), id="D5-kanji"),
+        pytest.param("2026-01-05 12:34", date(2026, 1, 5), id="D5-time"),
+        pytest.param("２０２６－０１－０５", date(2026, 1, 5), id="D5-fullwidth"),
+    ],
+)
+def test_parse_date_accepted_forms(raw: str, expected: date) -> None:
+    assert parse_date(raw) == expected
+
+
+@pytest.mark.parametrize("raw", ["2026/2/30", "令和8年1月5日", "2026-13-01", "abc"])
+def test_parse_date_rejects(raw: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(raw)
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        pytest.param("1,234円", 1234, id="R3-yen"),
+        pytest.param("¥1,234", 1234, id="R3-yen-sign"),
+        pytest.param("−200", -200, id="R3-unicode-minus"),
+        pytest.param("▲200", -200, id="R3-triangle"),
+        pytest.param("+200", 200, id="R3-plus"),
+        pytest.param("12.00", 12, id="R3-dot-zero"),
+        pytest.param(" 1 000 ", 1000, id="R3-spaces"),
+    ],
+)
+def test_parse_amount_accepted(raw: str, expected: int) -> None:
+    assert parse_amount(raw) == expected
+
+
+@pytest.mark.parametrize(
+    "raw", ["12.5", "", "-", "—", "abc", "--5", "(-5)", "1.", "JPY"]
+)
+def test_parse_amount_rejects(raw: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(raw)
+
+
+def test_bom_crlf_and_tab_delimiter() -> None:
+    text = "﻿日付\t摘要\t金額\r\n2026-01-05\tコンビニ\t500\r\n"
+    result = import_statement(text)
+    assert result.errors == []
+    assert [e.amount for e in result.expenses] == [500]
+    assert result.expenses[0].memo == "コンビニ"
+
+
+def test_quoted_comma_and_multiline_memo_keep_record_line() -> None:
+    text = '日付,摘要,金額\n2026-01-05,"A,B\nC",100\n2026-01-06,x,(200)\n'
+    result = import_statement(text)
+    assert result.errors == []
+    assert [e.memo for e in result.expenses] == ["A,B\nC", "x"]
+    assert [e.amount for e in result.expenses] == [100, -200]
+
+
+def test_column_count_mismatch_is_reported_with_empty_column() -> None:
+    text = "日付,摘要,金額\n2026-01-05,店,1,234円\n2026-01-06,店,300\n"
+    result = import_statement(text)
+    assert [(e.line, e.column) for e in result.errors] == [(2, "")]
+    assert [e.amount for e in result.expenses] == [300]
+
+
+def test_blank_and_zero_rows_skipped_order_kept() -> None:
+    text = "日付,金額\n2026-01-03,300\n\n2026-01-01,100\n"
+    result = import_statement(text)
+    assert result.errors == []
+    assert [e.day for e in result.expenses] == [date(2026, 1, 3), date(2026, 1, 1)]
+
+
+def test_withdrawal_and_deposit_both_set_is_error() -> None:
+    text = "日付,出金,入金\n2026-01-05,100,100\n"
+    result = import_statement(text)
+    assert result.expenses == []
+    assert len(result.errors) == 1
+    assert result.errors[0].line == 2
+
+
+def test_category_column_and_default_category() -> None:
+    text = "date,category,amount\n2026-01-05,食費,100\n2026-01-06,,200\n"
+    result = import_statement(text, default_category="その他")
+    assert [e.category for e in result.expenses] == ["食費", "その他"]
+
+
+def test_header_aliases_are_nfkc_and_case_insensitive() -> None:
+    text = (
+        "ＤＡＴＥ , 利用店名 , Ｃａｔｅｇｏｒｙ , ご利用金額\n2026-01-05,店,食費,100\n"
+    )
+    result = import_statement(text)
+    assert result.errors == []
+    assert result.expenses[0].memo == "店"
+    assert result.expenses[0].category == "食費"
+
+
+@pytest.mark.parametrize("text", ["", "  \n", "日付,金額\n", "日付,金額"])
+def test_empty_or_header_only_is_empty_result(text: str) -> None:
+    result = import_statement(text)
+    assert result.expenses == []
+    assert result.errors == []
+
+
+def test_missing_required_columns_is_whole_error() -> None:
+    with pytest.raises(ValueError, match="金額"):
+        import_statement("日付,摘要\n2026-01-05,店\n")
+
+
+def test_empty_header_line_is_error() -> None:
+    with pytest.raises(ValueError):
+        import_statement("\n2026-01-05,100\n")
+
+
+def test_negative_withdrawal_is_error() -> None:
+    result = import_statement("日付,出金\n2026-01-05,-100\n")
+    assert result.expenses == []
+    assert [e.column for e in result.errors] == ["出金"]
