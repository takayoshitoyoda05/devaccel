+++ b/src/kakeibo/month_compare.py
@@ -0,0 +1,101 @@
+"""Month-over-month category comparison and report formatting."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    delta: int  # current - previous
+    ratio: float | None  # delta / previous。previous == 0 なら None
+    status: str  # "increased" | "decreased" | "unchanged" | "new" | "gone"
+
+
+def _parse_month(month: object) -> tuple[int, int]:
+    if not isinstance(month, str):
+        raise TypeError(f"month は str である必要があります: {type(month).__name__}")
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"month は YYYY-MM 形式である必要があります: {month!r}")
+    return int(month[:4]), int(month[5:7])
+
+
+def _previous(year: int, month: int) -> tuple[int, int]:
+    return (year - 1, 12) if month == 1 else (year, month - 1)
+
+
+def _net_by_category(rows: list[Expense], year: int, month: int) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for e in rows:
+        if e.day.year == year and e.day.month == month:
+            out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def compare_months(rows: list[Expense], month: str) -> list[CategoryChange]:
+    year, mon = _parse_month(month)
+    prev_year, prev_mon = _previous(year, mon)
+    prev = _net_by_category(rows, prev_year, prev_mon)
+    cur = _net_by_category(rows, year, mon)
+
+    changes: list[CategoryChange] = []
+    for cat in set(prev) | set(cur):
+        p = prev.get(cat, 0)
+        c = cur.get(cat, 0)
+        delta = c - p
+        ratio = None if p == 0 else delta / p
+        if p == 0 and c != 0:
+            status = "new"
+        elif c == 0 and p != 0:
+            status = "gone"
+        elif delta > 0:
+            status = "increased"
+        elif delta < 0:
+            status = "decreased"
+        else:
+            status = "unchanged"
+        changes.append(CategoryChange(cat, p, c, delta, ratio, status))
+
+    changes.sort(key=lambda ch: (-abs(ch.delta), ch.category))
+    return changes
+
+
+def _delta_text(delta: int) -> str:
+    if delta == 0:
+        return "±0"
+    if delta > 0:
+        return f"+{delta:,}"
+    return f"{delta:,}"
+
+
+def _ratio_text(ratio: float | None) -> str:
+    if ratio is None:
+        return "-"
+    text = f"{ratio * 100:.1f}"
+    if float(text) == 0:
+        return "±0.0%"
+    sign = "+" if ratio > 0 else ""
+    return f"{sign}{text}%"
+
+
+_STATUS_NOTE = {"new": " (新規)", "gone": " (なくなった)"}
+
+
+def _line(ch: CategoryChange) -> str:
+    note = _STATUS_NOTE.get(ch.status, "")
+    return (
+        f"{ch.category}  {ch.previous:,}→{ch.current:,}  "
+        f"{_delta_text(ch.delta)}円  ({_ratio_text(ch.ratio)}){note}"
+    )
+
+
+def format_report(changes: list[CategoryChange]) -> str:
+    return "\n".join(_line(ch) for ch in changes)
