+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, predict_next
+
+
+def ex(day: str, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+def test_e1_1_rent_month_end_clamp_and_next_date() -> None:
+    """E1-1: 家賃 80000 を 1/31・2/28・3/31 → 1 系列、day=31、next_date=2026-04-30 (D3)。"""
+    rows = [
+        ex("2026-01-31", "家賃", 80000, "家賃"),
+        ex("2026-02-28", "家賃", 80000, "家賃"),
+        ex("2026-03-31", "家賃", 80000, "家賃"),
+    ]
+    found = find_recurring(rows)
+    assert len(found) == 1
+    r = found[0]
+    assert r.day == 31
+    assert r.next_date == date(2026, 4, 30)
+    assert r.months == ("2026-01", "2026-02", "2026-03")
+    assert r.amount == 80000
+
+
+def test_e1_2_two_months_below_min_months_is_empty() -> None:
+    """E1-2: Netflix 1490 が 1・2 月だけ (min_months=3) → 空リスト (R3)。"""
+    rows = [
+        ex("2026-01-05", "動画", 1490, "Netflix"),
+        ex("2026-02-05", "動画", 1490, "Netflix"),
+    ]
+    assert find_recurring(rows, min_months=3) == []
+
+
+def test_e1_3_two_rows_same_month_count_once() -> None:
+    """E1-3: 同じ月に Netflix 1490 が 2 回 → その月は 1 回として数える (R2)。"""
+    rows = [
+        ex("2026-01-05", "動画", 1490, "Netflix"),
+        ex("2026-01-20", "動画", 1490, "Netflix"),
+        ex("2026-02-05", "動画", 1490, "Netflix"),
+        ex("2026-03-05", "動画", 1490, "Netflix"),
+    ]
+    found = find_recurring(rows)
+    assert len(found) == 1
+    assert found[0].months == ("2026-01", "2026-02", "2026-03")
+    # 基準日は系列の最大の日 (1 月は最後の 1/20 を採用) → 20
+    assert found[0].day == 20
+    assert found[0].next_date == date(2026, 4, 20)
+
+
+def test_refund_rows_are_excluded_from_series() -> None:
+    """R2 / D1: amount <= 0 は系列に入れない。"""
+    rows = [
+        ex("2026-01-05", "動画", 1490, "Netflix"),
+        ex("2026-02-05", "動画", 1490, "Netflix"),
+        ex("2026-03-05", "動画", 1490, "Netflix"),
+        ex("2026-04-05", "動画", -1490, "Netflix"),
+        ex("2026-05-05", "動画", 0, "Netflix"),
+    ]
+    found = find_recurring(rows)
+    assert len(found) == 1
+    assert found[0].months == ("2026-01", "2026-02", "2026-03")
+    assert found[0].next_date == date(2026, 4, 5)
+
+
+def test_gap_splits_series_and_last_run_is_evaluated() -> None:
+    """R3: 欠けた月で切り、最後の連続区間だけを評価する。"""
+    rows = [
+        ex("2026-01-05", "動画", 1490, "Netflix"),
+        ex("2026-02-05", "動画", 1490, "Netflix"),
+        ex("2026-04-05", "動画", 1490, "Netflix"),
+        ex("2026-05-05", "動画", 1490, "Netflix"),
+    ]
+    assert find_recurring(rows, min_months=3) == []
+    found = find_recurring(rows, min_months=2)
+    assert len(found) == 1
+    assert found[0].months == ("2026-04", "2026-05")
+
+
+def test_last_run_is_used_when_earlier_run_is_longer() -> None:
+    """R3: 最後の連続区間を使う (先頭の長い区間は使わない)。"""
+    rows = [ex(f"2026-{m:02d}-05", "動画", 1490, "Netflix") for m in (1, 2, 3, 5, 6, 7)]
+    found = find_recurring(rows, min_months=3)
+    assert len(found) == 1
+    assert found[0].months == ("2026-05", "2026-06", "2026-07")
+
+
+def test_price_increase_drops_old_months_outside_tolerance() -> None:
+    """R4: 最頻金額 (1200) から外れた古い月は区間から外す。"""
+    rows = [ex(f"2026-{m:02d}-03", "動画", 1000, "Hulu") for m in (1, 2)]
+    rows += [ex(f"2026-{m:02d}-03", "動画", 1200, "Hulu") for m in (3, 4, 5, 6)]
+    found = find_recurring(rows)
+    assert len(found) == 1
+    assert found[0].amount == 1200
+    assert found[0].months == ("2026-03", "2026-04", "2026-05", "2026-06")
+
+
+def test_amount_within_tolerance_is_same_series() -> None:
+    """R4: 最頻金額の ±10% 以内なら同じ系列。"""
+    rows = [
+        ex("2026-01-10", "光熱費", 1000, "電気"),
+        ex("2026-02-10", "光熱費", 1050, "電気"),
+        ex("2026-03-10", "光熱費", 1000, "電気"),
+    ]
+    found = find_recurring(rows)
+    assert len(found) == 1
+    assert found[0].amount == 1000
+    assert found[0].months == ("2026-01", "2026-02", "2026-03")
+
+
+def test_zero_tolerance_requires_exact_amount() -> None:
+    """R6: amount_tolerance=0 は金額完全一致 (有効)。"""
+    rows = [
+        ex("2026-01-10", "光熱費", 1000, "電気"),
+        ex("2026-02-10", "光熱費", 1050, "電気"),
+        ex("2026-03-10", "光熱費", 1000, "電気"),
+    ]
+    assert find_recurring(rows, amount_tolerance=0) == []
+    exact = [ex(f"2026-{m:02d}-10", "光熱費", 1000, "電気") for m in (1, 2, 3)]
+    found = find_recurring(exact, amount_tolerance=0)
+    assert len(found) == 1
+    assert found[0].amount == 1000
+
+
+def test_different_memos_are_separate_series() -> None:
+    """同じカテゴリでもメモが違えば別系列 (混ぜない)。"""
+    rows = [ex(f"2026-{m:02d}-05", "サブスク", 500, "A サービス") for m in (1, 2, 3)]
+    rows += [ex(f"2026-{m:02d}-20", "サブスク", 500, "B サービス") for m in (1, 2, 3)]
+    found = find_recurring(rows)
+    assert len(found) == 2
+    assert {r.memo for r in found} == {"a サービス", "b サービス"}
+
+
+def test_memo_normalization_merges_variants() -> None:
+    """D4 / R1: NFKC・小文字化・連続空白・末尾番号を除いて同一系列にする。"""
+    rows = [
+        ex("2026-01-05", "動画", 1490, "Netflix  #12"),
+        ex("2026-02-05", "動画", 1490, "ｎｅｔｆｌｉｘ"),
+        ex("2026-03-05", "動画", 1490, "NETFLIX 3"),
+    ]
+    found = find_recurring(rows)
+    assert len(found) == 1
+    assert found[0].memo == "netflix"
+
+
+def test_empty_memo_is_identified_by_category_only() -> None:
+    """R1: メモが空の行はカテゴリだけで同一視する。"""
+    rows = [
+        ex("2026-01-05", "通信", 4000, ""),
+        ex("2026-02-05", "通信", 4000, "  "),
+        ex("2026-03-05", "通信", 4000),
+    ]
+    found = find_recurring(rows)
+    assert len(found) == 1
+    assert found[0].memo == ""
+    assert found[0].months == ("2026-01", "2026-02", "2026-03")
+
+
+def test_category_is_stripped() -> None:
+    """R1: カテゴリは前後空白を除いて比較する。"""
+    rows = [
+        ex("2026-01-05", " 動画 ", 1490, "Netflix"),
+        ex("2026-02-05", "動画", 1490, "Netflix"),
+        ex("2026-03-05", "動画", 1490, "Netflix"),
+    ]
+    found = find_recurring(rows)
+    assert len(found) == 1
+    assert found[0].category == "動画"
+
+
+def test_mode_tie_prefers_newer_amount() -> None:
+    """Recurring.amount: 同数なら新しい方。"""
+    rows = [
+        ex("2026-01-05", "動画", 1000, "X"),
+        ex("2026-02-05", "動画", 1100, "X"),
+        ex("2026-03-05", "動画", 1100, "X"),
+        ex("2026-04-05", "動画", 1000, "X"),
+    ]
+    # 1000 と 1100 が 2 回ずつ。最後に出た 1000 が新しい → 1000 が最頻。
+    found = find_recurring(rows, amount_tolerance=0.2)
+    assert len(found) == 1
+    assert found[0].amount == 1000
+
+
+def test_day_is_max_day_of_series() -> None:
+    """D3: 基準日は系列の最大の日。"""
+    rows = [
+        ex("2026-01-31", "家賃", 80000, "家賃"),
+        ex("2026-02-28", "家賃", 80000, "家賃"),
+        ex("2026-03-31", "家賃", 80000, "家賃"),
+    ]
+    assert find_recurring(rows)[0].day == 31
+
+
+def test_result_sorted_by_next_date_then_amount_desc_then_name() -> None:
+    """R5: next_date 昇順、同点は金額降順、さらに (category, memo) 昇順。"""
+    rows: list[Expense] = []
+    for m in (1, 2, 3):
+        rows.append(ex(f"2026-{m:02d}-05", "B", 100, "x"))
+        rows.append(ex(f"2026-{m:02d}-05", "A", 300, "y"))
+        rows.append(ex(f"2026-{m:02d}-05", "C", 200, "z"))
+        rows.append(ex(f"2026-{m:02d}-20", "D", 50, "w"))
+    found = find_recurring(rows)
+    assert [(r.category, r.next_date) for r in found] == [
+        ("A", date(2026, 4, 5)),  # 300
+        ("C", date(2026, 4, 5)),  # 200
+        ("B", date(2026, 4, 5)),  # 100
+        ("D", date(2026, 4, 20)),
+    ]
+
+
+def test_sort_tie_breaks_by_amount_desc_then_category_memo() -> None:
+    rows: list[Expense] = []
+    for m in (1, 2, 3):
+        rows.append(ex(f"2026-{m:02d}-05", "B", 100, "x"))
+        rows.append(ex(f"2026-{m:02d}-05", "A", 100, "y"))
+        rows.append(ex(f"2026-{m:02d}-05", "C", 300, "z"))
+    found = find_recurring(rows)
+    assert [r.category for r in found] == ["C", "A", "B"]
+
+
+def test_empty_rows_return_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+def test_min_months_below_two_is_value_error() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_months=1)
+
+
+def test_negative_tolerance_is_value_error() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], amount_tolerance=-0.1)
+
+
+def test_bool_arguments_are_type_error() -> None:
+    with pytest.raises(TypeError):
+        find_recurring([], min_months=True)  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        find_recurring([], amount_tolerance=True)  # type: ignore[arg-type]
+
+
+def test_predict_next_december_rolls_to_january() -> None:
+    r = Recurring("x", "", 1, ("2026-11", "2026-12"), 15, date(2027, 1, 15))
+    assert predict_next(r) == date(2027, 1, 15)
+
+
+def test_predict_next_clamps_to_month_end_and_leap_year() -> None:
+    # 1/31 の翌月は 2/28 (平年)
+    r = Recurring("x", "", 1, ("2027-01",), 31, date(2027, 2, 28))
+    assert predict_next(r) == date(2027, 2, 28)
+    # 1/31 の翌月は 2/29 (閏年)
+    leap = Recurring("x", "", 1, ("2028-01",), 31, date(2028, 2, 29))
+    assert predict_next(leap) == date(2028, 2, 29)
+    # 12 月の 31 日の翌月は 1/31
+    dec = Recurring("x", "", 1, ("2026-12",), 31, date(2027, 1, 31))
+    assert predict_next(dec) == date(2027, 1, 31)
+    # 30 日基準は 2 月で 28 日にクランプ
+    r3 = Recurring("x", "", 1, ("2027-01",), 30, date(2027, 2, 28))
+    assert predict_next(r3) == date(2027, 2, 28)
