+++ b/src/kakeibo/search.py
@@ -0,0 +1,135 @@
+"""Condition search over Expense records (pure functions, no I/O)."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable
+from datetime import date, datetime
+
+from kakeibo.core import Expense
+
+Predicate = Callable[[Expense], bool]
+
+
+def _nfkc(text: str) -> str:
+    return unicodedata.normalize("NFKC", text)
+
+
+def _check_str(value: object, where: str) -> str:
+    if not isinstance(value, str):
+        raise TypeError(f"{where} は str である必要があります: {type(value).__name__}")
+    return value
+
+
+def _check_int_or_none(value: object, where: str) -> int | None:
+    if value is None:
+        return None
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{where} は int か None である必要があります: {value!r}")
+    return value
+
+
+def _check_date_or_none(value: object, where: str) -> date | None:
+    if value is None:
+        return None
+    if isinstance(value, datetime) or not isinstance(value, date):
+        raise TypeError(f"{where} は date か None である必要があります: {value!r}")
+    return value
+
+
+def _check_pred(pred: object, where: str) -> Predicate:
+    if not callable(pred):
+        raise TypeError(f"{where} は callable である必要があります: {pred!r}")
+    return pred  # type: ignore[return-value]
+
+
+def category_is(*names: str) -> Predicate:
+    """Category exact match (strip + NFKC) against any of the names."""
+    if not names:
+        raise ValueError("category_is には 1 つ以上のカテゴリ名が必要です")
+    targets = frozenset(
+        _nfkc(_check_str(n, "category_is の引数")).strip() for n in names
+    )
+
+    def pred(e: Expense) -> bool:
+        return _nfkc(e.category).strip() in targets
+
+    return pred
+
+
+def amount_between(low: int | None = None, high: int | None = None) -> Predicate:
+    """Inclusive amount range; None means unbounded."""
+    lo = _check_int_or_none(low, "low")
+    hi = _check_int_or_none(high, "high")
+    if lo is not None and hi is not None and lo > hi:
+        raise ValueError(f"low({lo}) が high({hi}) より大きい値です")
+
+    def pred(e: Expense) -> bool:
+        return (lo is None or e.amount >= lo) and (hi is None or e.amount <= hi)
+
+    return pred
+
+
+def _fold(text: str) -> str:
+    return _nfkc(text).casefold()
+
+
+def memo_contains(text: str) -> Predicate:
+    """Substring match ignoring NFKC form and case. Empty string always matches."""
+    needle = _fold(_check_str(text, "memo_contains の引数"))
+
+    def pred(e: Expense) -> bool:
+        return needle in _fold(e.memo)
+
+    return pred
+
+
+def between_dates(start: date | None = None, end: date | None = None) -> Predicate:
+    """Inclusive date range; None means unbounded."""
+    s = _check_date_or_none(start, "start")
+    en = _check_date_or_none(end, "end")
+    if s is not None and en is not None and s > en:
+        raise ValueError(f"start({s}) が end({en}) より後の日付です")
+
+    def pred(e: Expense) -> bool:
+        return (s is None or e.day >= s) and (en is None or e.day <= en)
+
+    return pred
+
+
+def all_of(*preds: Predicate) -> Predicate:
+    """True when every predicate is true; no arguments gives True."""
+    checked = [_check_pred(p, "all_of の引数") for p in preds]
+
+    def pred(e: Expense) -> bool:
+        return all(p(e) for p in checked)
+
+    return pred
+
+
+def any_of(*preds: Predicate) -> Predicate:
+    """True when any predicate is true; no arguments gives False."""
+    checked = [_check_pred(p, "any_of の引数") for p in preds]
+
+    def pred(e: Expense) -> bool:
+        return any(p(e) for p in checked)
+
+    return pred
+
+
+def not_(pred: Predicate) -> Predicate:
+    """Negation of a predicate."""
+    inner = _check_pred(pred, "not_ の引数")
+
+    def negated(e: Expense) -> bool:
+        return not inner(e)
+
+    return negated
+
+
+def search(rows: list[Expense], pred: Predicate | None = None) -> list[Expense]:
+    """Rows matching pred, in input order. pred=None returns a copy of all rows."""
+    if pred is None:
+        return list(rows)
+    checked = _check_pred(pred, "search の pred")
+    return [e for e in rows if checked(e)]
diff --git a/tests/test_bank_import.py b/tests/test_bank_import.py
