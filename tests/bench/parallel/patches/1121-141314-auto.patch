@@ -0,0 +1,132 @@
+"""Detect recurring expenses (subscriptions, rent) and predict their next date."""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from collections import Counter
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str  # normalized memo
+    amount: int  # most frequent amount in the series (tie: newer)
+    months: tuple[str, ...]  # "YYYY-MM" ascending
+    day: int  # base day (D3)
+    next_date: date  # base day in the month after the last month (clamped)
+
+
+_TRAILING_NUMBER = re.compile(r"\s+#?[0-9]+$")
+
+
+def _normalize_memo(memo: str) -> str:
+    """D4: NFKC, lowercase, collapse whitespace, drop trailing numbers like ' #12'."""
+    s = " ".join(unicodedata.normalize("NFKC", memo).lower().split())
+    while True:
+        t = _TRAILING_NUMBER.sub("", s)
+        if t == s:
+            return s
+        s = t
+
+
+def _month_index(month: str) -> int:
+    return int(month[:4]) * 12 + int(month[5:7]) - 1
+
+
+def _resolve(year: int, month: int, day: int) -> date:
+    """D3: clamp the day to the last day of the month."""
+    return date(year, month, min(day, calendar.monthrange(year, month)[1]))
+
+
+def _next_date(last_month: str, day: int) -> date:
+    idx = _month_index(last_month) + 1
+    return _resolve(idx // 12, idx % 12 + 1, day)
+
+
+def predict_next(r: Recurring) -> date:
+    """Base day of the month after the last month in ``r.months`` (D3)."""
+    if not r.months:
+        raise ValueError("months が空です")
+    if not 1 <= r.day <= 31:
+        raise ValueError(f"day は 1〜31 である必要があります: {r.day}")
+    return _next_date(r.months[-1], r.day)
+
+
+def _detect(
+    category: str,
+    memo: str,
+    by_month: dict[str, tuple[date, int]],
+    min_months: int,
+    tolerance: float,
+) -> Recurring | None:
+    ordered = sorted(by_month.items())  # "YYYY-MM" sorts chronologically
+    counts: Counter[int] = Counter(amount for _, (_, amount) in ordered)
+    last_seen: dict[int, int] = {}
+    for i, (_, (_, amount)) in enumerate(ordered):
+        last_seen[amount] = i
+    mode = max(counts, key=lambda a: (counts[a], last_seen[a]))
+
+    # R3: the last run of consecutive months.
+    start = len(ordered) - 1
+    while start > 0 and (
+        _month_index(ordered[start - 1][0]) + 1 == _month_index(ordered[start][0])
+    ):
+        start -= 1
+    run = ordered[start:]
+
+    # R4: keep the trailing part of the run whose amounts are within tolerance of the mode.
+    cut = len(run)
+    while cut > 0 and abs(run[cut - 1][1][1] - mode) <= tolerance * mode:
+        cut -= 1
+    tail = run[cut:]
+    if len(tail) < min_months:
+        return None
+
+    months = tuple(m for m, _ in tail)
+    day = max(d.day for _, (d, _) in tail)
+    return Recurring(category, memo, mode, months, day, _next_date(months[-1], day))
+
+
+def find_recurring(
+    rows: list[Expense], *, min_months: int = 3, amount_tolerance: float = 0.1
+) -> list[Recurring]:
+    if isinstance(min_months, bool) or not isinstance(min_months, int):
+        raise TypeError("min_months は int である必要があります")
+    if min_months < 2:
+        raise ValueError(f"min_months は 2 以上である必要があります: {min_months}")
+    if isinstance(amount_tolerance, bool) or not isinstance(
+        amount_tolerance, (int, float)
+    ):
+        raise TypeError("amount_tolerance は数値である必要があります")
+    if not amount_tolerance >= 0:  # also rejects NaN
+        raise ValueError(
+            f"amount_tolerance は 0 以上である必要があります: {amount_tolerance}"
+        )
+
+    series: dict[tuple[str, str], dict[str, tuple[date, int]]] = {}
+    for e in rows:
+        if not isinstance(e, Expense):
+            raise TypeError("rows は Expense のリストである必要があります")
+        if e.amount <= 0:  # R2 / D1: refunds and income are not part of a series
+            continue
+        key = (e.category.strip(), _normalize_memo(e.memo))
+        month = f"{e.day.year:04d}-{e.day.month:02d}"
+        by_month = series.setdefault(key, {})
+        prev = by_month.get(month)
+        if prev is None or e.day >= prev[0]:  # R2: one per month, the latest day
+            by_month[month] = (e.day, e.amount)
+
+    found: list[Recurring] = []
+    for (category, memo), by_month in series.items():
+        r = _detect(category, memo, by_month, min_months, amount_tolerance)
+        if r is not None:
+            found.append(r)
+    # R5
+    found.sort(key=lambda r: (r.next_date, -r.amount, r.category, r.memo))
+    return found
