+++ b/tests/test_month_compare.py
@@ -0,0 +1,209 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.month_compare import CategoryChange, compare_months, format_report
+
+
+def e(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+def by_cat(changes: list[CategoryChange]) -> dict[str, CategoryChange]:
+    return {c.category: c for c in changes}
+
+
+# --- 例の表 (E4-*) ---
+
+
+def test_E4_1_increased_with_ratio() -> None:
+    # E4-1: 2026-01 を比較、2025-12 に 食費 3000、2026-01 に 食費 4500 | R1 R5
+    rows = [e("2025-12-10", "食費", 3000), e("2026-01-05", "食費", 4500)]
+    (c,) = compare_months(rows, "2026-01")
+    assert (c.category, c.previous, c.current, c.delta) == ("食費", 3000, 4500, 1500)
+    assert c.ratio == 0.5
+    assert c.status == "increased"
+
+
+def test_E4_2_new_category_ratio_none() -> None:
+    # E4-2: 前月に無く今月だけある 交通費 800 | R3
+    rows = [e("2026-03-02", "交通費", 800)]
+    (c,) = compare_months(rows, "2026-03")
+    assert c.status == "new"
+    assert c.ratio is None
+    assert c.delta == 800
+
+
+def test_E4_3_gone_category() -> None:
+    # E4-3: 前月にだけ 娯楽 2000(今月 0) | R3
+    rows = [e("2026-02-14", "娯楽", 2000)]
+    (c,) = compare_months(rows, "2026-03")
+    assert c.status == "gone"
+    assert c.delta == -2000
+    assert c.ratio == -1.0
+
+
+# --- 規則のテスト ---
+
+
+@pytest.mark.parametrize(
+    "month",
+    ["2026-3", "2026/03", "2026-13", "2026-00", "202603", "2026-03-01", ""],
+    ids=[
+        "R1-no-zero-pad",
+        "R1-slash",
+        "R1-month13",
+        "R1-month00",
+        "R1-no-dash",
+        "R1-with-day",
+        "R1-empty",
+    ],
+)
+def test_R1_invalid_month_value_error(month: str) -> None:
+    with pytest.raises(ValueError):
+        compare_months([], month)
+
+
+def test_R1_non_str_type_error() -> None:
+    with pytest.raises(TypeError):
+        compare_months([], 202603)  # type: ignore[arg-type]
+
+
+def test_R1_january_compares_with_previous_december() -> None:
+    rows = [e("2025-12-01", "食費", 1000), e("2026-01-01", "食費", 1500)]
+    (c,) = compare_months(rows, "2026-01")
+    assert c.previous == 1000
+    assert c.current == 1500
+
+
+def test_R1_no_previous_month_rows_treated_as_zero() -> None:
+    rows = [e("2026-03-01", "食費", 700)]
+    (c,) = compare_months(rows, "2026-03")
+    assert c.previous == 0
+    assert c.status == "new"
+
+
+def test_R2_refund_is_netted_in_category() -> None:
+    # 返金(負)は合算した純額。D1
+    rows = [
+        e("2026-02-01", "食費", 5000),
+        e("2026-03-01", "食費", 4000),
+        e("2026-03-05", "食費", -1000),
+    ]
+    (c,) = compare_months(rows, "2026-03")
+    assert c.current == 3000
+    assert c.delta == -2000
+    assert c.status == "decreased"
+
+
+def test_R2_category_in_only_one_month_with_zero_net_is_listed() -> None:
+    rows = [e("2026-02-01", "雑費", 500), e("2026-02-02", "雑費", -500)]
+    changes = by_cat(compare_months(rows, "2026-03"))
+    assert "雑費" in changes
+    assert changes["雑費"].previous == 0
+    assert changes["雑費"].current == 0
+
+
+def test_R3_both_months_zero_net_is_unchanged() -> None:
+    rows = [
+        e("2026-02-01", "雑費", 500),
+        e("2026-02-02", "雑費", -500),
+        e("2026-03-01", "雑費", 300),
+        e("2026-03-02", "雑費", -300),
+    ]
+    (c,) = compare_months(rows, "2026-03")
+    assert c.status == "unchanged"
+    assert c.delta == 0
+
+
+def test_R3_equal_amounts_unchanged() -> None:
+    rows = [e("2026-02-01", "食費", 2000), e("2026-03-01", "食費", 2000)]
+    (c,) = compare_months(rows, "2026-03")
+    assert c.status == "unchanged"
+    assert c.ratio == 0.0
+
+
+def test_R3_decreased() -> None:
+    rows = [e("2026-02-01", "食費", 2000), e("2026-03-01", "食費", 1700)]
+    (c,) = compare_months(rows, "2026-03")
+    assert c.status == "decreased"
+    assert c.delta == -300
+
+
+def test_R4_sorted_by_abs_delta_desc_then_category() -> None:
+    rows = [
+        e("2026-02-01", "B", 1000),
+        e("2026-03-01", "B", 1500),  # |+500|
+        e("2026-02-01", "A", 1000),
+        e("2026-03-01", "A", 1500),  # |+500| 同点
+        e("2026-02-01", "C", 5000),
+        e("2026-03-01", "C", 4000),  # |-1000|
+    ]
+    cats = [c.category for c in compare_months(rows, "2026-03")]
+    assert cats == ["C", "A", "B"]
+
+
+def test_R5_ratio_none_when_previous_zero_and_not_rounded() -> None:
+    rows = [e("2026-02-01", "食費", 3), e("2026-03-01", "食費", 1)]
+    (c,) = compare_months(rows, "2026-03")
+    assert c.ratio == pytest.approx(-2 / 3)
+    assert c.ratio == -2 / 3  # 丸めない
+
+
+def test_R5_negative_previous_uses_formula() -> None:
+    # previous が負の純額でも式どおり: delta / previous
+    rows = [e("2026-02-01", "食費", -1000), e("2026-03-01", "食費", 500)]
+    (c,) = compare_months(rows, "2026-03")
+    assert c.previous == -1000
+    assert c.delta == 1500
+    assert c.ratio == -1.5
+
+
+# --- format_report (R6) ---
+
+
+def test_R6_empty_list_gives_empty_string() -> None:
+    assert format_report([]) == ""
+
+
+def test_R6_increased_line() -> None:
+    rows = [e("2025-12-10", "食費", 3000), e("2026-01-05", "食費", 4500)]
+    assert (
+        format_report(compare_months(rows, "2026-01"))
+        == "食費  3,000→4,500  +1,500円  (+50.0%)"
+    )
+
+
+def test_R6_new_line_ratio_dash_and_suffix() -> None:
+    rows = [e("2026-03-02", "交通費", 800)]
+    assert (
+        format_report(compare_months(rows, "2026-03"))
+        == "交通費  0→800  +800円  (-) (新規)"
+    )
+
+
+def test_R6_gone_line_suffix() -> None:
+    rows = [e("2026-02-14", "娯楽", 2000)]
+    assert (
+        format_report(compare_months(rows, "2026-03"))
+        == "娯楽  2,000→0  -2,000円  (-100.0%) (なくなった)"
+    )
+
+
+def test_R6_zero_delta_shows_plus_minus() -> None:
+    rows = [e("2026-02-01", "食費", 2000), e("2026-03-01", "食費", 2000)]
+    assert (
+        format_report(compare_months(rows, "2026-03"))
+        == "食費  2,000→2,000  ±0円  (±0.0%)"
+    )
+
+
+def test_R6_negative_previous_zero_ratio_no_negative_zero() -> None:
+    rows = [e("2026-02-01", "食費", -300), e("2026-03-01", "食費", -300)]
+    assert (
+        format_report(compare_months(rows, "2026-03"))
+        == "食費  -300→-300  ±0円  (±0.0%)"
+    )
