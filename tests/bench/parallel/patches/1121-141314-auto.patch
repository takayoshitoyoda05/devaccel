@@ -0,0 +1,128 @@
+from __future__ import annotations
+
+from datetime import date, datetime
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    all_of,
+    amount_between,
+    any_of,
+    between_dates,
+    category_is,
+    memo_contains,
+    not_,
+    search,
+)
+
+ROWS = [
+    Expense(date(2026, 1, 5), "食費", 1000, "Netflix"),
+    Expense(date(2026, 1, 9), "交通", 250, "電車"),
+    Expense(date(2026, 2, 1), "食費", -500, "返金"),
+]
+
+
+# 例の表 (E3-*) の全行。
+@pytest.mark.parametrize(
+    ("case_id", "pred", "row", "expected"),
+    [
+        # E3-1: 端を含む (R2)
+        ("E3-1", amount_between(1000, 1000), ROWS[0], True),
+        # E3-2: 全角半角・大文字小文字を同一視 (R3)
+        ("E3-2", memo_contains("ｎｅｔｆｌｉｘ"), ROWS[0], True),
+        # E3-3: 引数ゼロの all_of は真、any_of は偽 (R5)
+        ("E3-3", all_of(), ROWS[0], True),
+        ("E3-3", any_of(), ROWS[0], False),
+    ],
+    ids=["E3-1", "E3-2", "E3-3-all_of", "E3-3-any_of"],
+)
+def test_spec_examples(
+    case_id: str, pred: object, row: Expense, expected: bool
+) -> None:
+    assert case_id
+    assert pred(row) is expected  # type: ignore[operator]
+
+
+# R1: category_is は完全一致(前後空白除去・NFKC)、複数名は OR、名前ゼロは ValueError
+def test_category_is_matches_any_name_after_normalization() -> None:
+    pred = category_is("  食費  ", "交通")
+    assert pred(ROWS[0]) is True
+    assert pred(ROWS[1]) is True
+    assert category_is("ショクヒ")(ROWS[0]) is False
+    assert category_is("ｼｮｸﾋ")(ROWS[0]) is False  # NFKC 後も「ショクヒ」≠「食費」
+    assert category_is("食費")(ROWS[0]) is True
+    assert category_is("食")(ROWS[0]) is False  # 部分一致しない
+
+
+def test_category_is_requires_a_name() -> None:
+    with pytest.raises(ValueError):
+        category_is()
+
+
+# R2: None は無制限、両方 None は常に真、low > high は ValueError、bool は TypeError
+def test_amount_between_unbounded_and_negative() -> None:
+    assert amount_between()(ROWS[2]) is True
+    assert amount_between(high=0)(ROWS[2]) is True  # 返金(負)を受ける
+    assert amount_between(low=0)(ROWS[2]) is False
+    assert amount_between(low=-500, high=-500)(ROWS[2]) is True
+
+
+def test_amount_between_rejects_bad_arguments() -> None:
+    with pytest.raises(ValueError):
+        amount_between(1000, 999)
+    with pytest.raises(TypeError):
+        amount_between(True, None)  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        amount_between(None, False)  # type: ignore[arg-type]
+
+
+# R3: 部分一致、空文字は常に真
+def test_memo_contains_partial_and_empty() -> None:
+    assert memo_contains("flix")(ROWS[0]) is True
+    assert memo_contains("NETFLIX")(ROWS[0]) is True
+    assert memo_contains("")(ROWS[2]) is True
+    assert memo_contains("Hulu")(ROWS[0]) is False
+
+
+# R4: 両端を含む、None は無制限、start > end は ValueError、datetime は TypeError
+def test_between_dates_inclusive_and_unbounded() -> None:
+    assert between_dates(date(2026, 1, 5), date(2026, 1, 5))(ROWS[0]) is True
+    assert between_dates(date(2026, 1, 6))(ROWS[0]) is False
+    assert between_dates(end=date(2026, 1, 9))(ROWS[1]) is True
+    assert between_dates()(ROWS[2]) is True
+
+
+def test_between_dates_rejects_bad_arguments() -> None:
+    with pytest.raises(ValueError):
+        between_dates(date(2026, 2, 1), date(2026, 1, 1))
+    with pytest.raises(TypeError):
+        between_dates(datetime(2026, 1, 1))
+    with pytest.raises(TypeError):
+        between_dates(end=datetime(2026, 1, 1))
+
+
+# R5: 入れ子は関数合成
+def test_not_and_nested_composition() -> None:
+    pred = all_of(category_is("食費"), not_(amount_between(low=0)))
+    assert [e.memo for e in search(ROWS, pred)] == ["返金"]
+    assert not_(any_of(category_is("交通")))(ROWS[1]) is False
+
+
+# R6: 順序保持、pred=None は全件のコピー、入力は変更しない
+def test_search_keeps_order_and_copies() -> None:
+    original = list(ROWS)
+    copied = search(ROWS)
+    assert copied == ROWS
+    assert copied is not ROWS
+    assert search(ROWS, any_of(category_is("食費"))) == [ROWS[0], ROWS[2]]
+    assert ROWS == original
+
+
+def test_predicate_must_be_callable() -> None:
+    with pytest.raises(TypeError):
+        search(ROWS, "食費")  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        all_of(category_is("食費"), 1)  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        not_(None)  # type: ignore[arg-type]
