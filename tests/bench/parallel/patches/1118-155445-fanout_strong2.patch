new file mode 100644
index 0000000..d34be4b
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,89 @@
+"""Import CSV exports from other banks / card issuers."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"(-?)[¥￥]?([0-9][0-9,]*)円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額が不正です: {s!r}")
+    return int(m.group(1) + m.group(2).replace(",", ""))
+
+
+def parse_date(s: str) -> date:
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付が不正です: {s!r}")
+    return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header = next(reader, None)
+    if header is None:
+        raise ValueError("ヘッダー行がありません")
+    index: dict[str, int] = {}
+    for field, col in mapping.items():
+        if col not in header:
+            raise ValueError(f"列 {col} がヘッダーにありません")
+        index[field] = header.index(col)
+
+    def cell(row: list[str], field: str) -> str:
+        i = index.get(field)
+        return row[i] if i is not None and i < len(row) else ""
+
+    rows: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    prev = reader.line_num
+    for row in reader:
+        lineno = prev + 1
+        prev = reader.line_num
+        if not row:
+            continue
+        bad: list[str] = []
+        day = None
+        amount = 0
+        try:
+            day = parse_date(cell(row, "date"))
+        except ValueError:
+            bad.append("date")
+        try:
+            amount = parse_amount(cell(row, "amount"))
+        except ValueError:
+            bad.append("amount")
+        category = cell(row, "category").strip()
+        if not category:
+            bad.append("category")
+        if bad:
+            errors.extend((lineno, f) for f in bad)
+            continue
+        assert day is not None
+        category = (category_map or {}).get(category, category)
+        rows.append(Expense(day, category, amount, cell(row, "memo").strip()))
+    return rows, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
new file mode 100644
index 0000000..c008f8e
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,82 @@
+"""Month-over-month category diff report."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not isinstance(month, str) or not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+    prev: dict[str, int] = {}
+    curr: dict[str, int] = {}
+    for e in rows:
+        m = e.day.strftime("%Y-%m")
+        if m == prev_month:
+            prev[e.category] = prev.get(e.category, 0) + e.amount
+        if m == curr_month:
+            curr[e.category] = curr.get(e.category, 0) + e.amount
+    out: list[DiffRow] = []
+    for cat in set(prev) | set(curr):
+        p = prev.get(cat, 0)
+        c = curr.get(cat, 0)
+        delta = c - p
+        pct = None if p == 0 else round(delta / p * 100, 1)
+        if cat not in prev:
+            status = "new"
+        elif cat not in curr:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, p, c, delta, pct, status))
+    out.sort(key=lambda r: (-abs(r.delta), r.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError("n は 0 以上である必要があります")
+    return [d for d in diffs if d.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for d in diffs:
+        pct = "-" if d.pct is None else f"{d.pct:+.1f}%"
+        lines.append(f"{d.category}\t{d.prev}\t{d.curr}\t{d.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({e.day.strftime("%Y-%m") for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("比較できる月が 2 つ未満です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..f360f5f
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,187 @@
+"""Boolean search queries over Expense rows.
+
+Grammar (lowest to highest precedence: OR < AND < NOT):
+
+    or_expr  := and_expr ("OR" and_expr)*
+    and_expr := not_expr (["AND"] not_expr)*
+    not_expr := "NOT" not_expr | primary
+    primary  := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_SPACE = " \t\r\n\f\v"
+_SPECIAL = '()"'
+
+Token = tuple[str, str]
+
+
+class QueryError(ValueError):
+    """Raised when a search query is malformed."""
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    tokens: list[tuple[str, str]] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        c = q[i]
+        if c in _SPACE:
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError("閉じていない引用符があります")
+            body = q[i + 1 : end]
+            if body == "":
+                raise QueryError("空の引用符は使えません")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            start = i
+            while i < n and q[i] not in _SPACE and q[i] not in _SPECIAL:
+                i += 1
+            word = q[start:i]
+            if word == "AND":
+                tokens.append(("AND", "AND"))
+            elif word == "OR":
+                tokens.append(("OR", "OR"))
+            elif word == "NOT":
+                tokens.append(("NOT", "NOT"))
+            elif word.startswith("cat:"):
+                cat = word[len("cat:") :]
+                if cat == "":
+                    raise QueryError("cat: の後ろにカテゴリ名がありません")
+                tokens.append(("CAT", cat))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+@dataclass(frozen=True)
+class _Leaf:
+    kind: str  # "TERM" or "CAT"
+    value: str
+
+
+@dataclass(frozen=True)
+class _Not:
+    operand: _Node
+
+
+@dataclass(frozen=True)
+class _And:
+    left: _Node
+    right: _Node
+
+
+@dataclass(frozen=True)
+class _Or:
+    left: _Node
+    right: _Node
+
+
+_Node = _Leaf | _Not | _And | _Or
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self._tokens = tokens
+        self._pos = 0
+
+    def _peek(self) -> str | None:
+        if self._pos < len(self._tokens):
+            return self._tokens[self._pos][0]
+        return None
+
+    def _next(self) -> Token:
+        tok = self._tokens[self._pos]
+        self._pos += 1
+        return tok
+
+    def parse(self) -> _Node:
+        if not self._tokens:
+            raise QueryError("検索条件が空です")
+        node = self._or_expr()
+        if self._pos != len(self._tokens):
+            raise QueryError(
+                f"予期しないトークンがあります: {self._tokens[self._pos][1]!r}"
+            )
+        return node
+
+    def _or_expr(self) -> _Node:
+        node = self._and_expr()
+        while self._peek() == "OR":
+            self._next()
+            node = _Or(node, self._and_expr())
+        return node
+
+    def _and_expr(self) -> _Node:
+        node = self._not_expr()
+        while True:
+            kind = self._peek()
+            if kind == "AND":
+                self._next()
+                node = _And(node, self._not_expr())
+            elif kind in ("TERM", "CAT", "LPAREN", "NOT"):
+                node = _And(node, self._not_expr())
+            else:
+                return node
+
+    def _not_expr(self) -> _Node:
+        if self._peek() == "NOT":
+            self._next()
+            return _Not(self._not_expr())
+        return self._primary()
+
+    def _primary(self) -> _Node:
+        kind = self._peek()
+        if kind in ("TERM", "CAT"):
+            k, v = self._next()
+            return _Leaf(k, v)
+        if kind == "LPAREN":
+            self._next()
+            node = self._or_expr()
+            if self._peek() != "RPAREN":
+                raise QueryError("括弧が閉じていません")
+            self._next()
+            return node
+        if kind is None:
+            raise QueryError("項がありません")
+        raise QueryError(f"項が必要な位置に {self._tokens[self._pos][1]!r} があります")
+
+
+def _parse(q: str) -> _Node:
+    return _Parser(tokenize(q)).parse()
+
+
+def _eval(node: _Node, e: Expense) -> bool:
+    if isinstance(node, _Leaf):
+        v = node.value.casefold()
+        if node.kind == "CAT":
+            return v == e.category.casefold()
+        return v in e.memo.casefold() or v in e.category.casefold()
+    if isinstance(node, _Not):
+        return not _eval(node.operand, e)
+    if isinstance(node, _And):
+        return _eval(node.left, e) and _eval(node.right, e)
+    return _eval(node.left, e) or _eval(node.right, e)
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _eval(_parse(q), e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    node = _parse(q)
+    return [e for e in rows if _eval(node, e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..fd9cd34
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,65 @@
+"""Detect recurring expenses (same category and amount at a roughly monthly interval)."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+from itertools import pairwise
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day in the next month, clamped to that month's last day."""
+    year, month = (d.year + 1, 1) if d.month == 12 else (d.year, d.month + 1)
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def _runs(days: list[date], tolerance: int) -> list[list[date]]:
+    """Split sorted, unique dates into maximal runs where neighbours are connected."""
+    runs: list[list[date]] = [[days[0]]]
+    for prev, nxt in pairwise(days):
+        if abs((nxt - add_month(prev)).days) <= tolerance:
+            runs[-1].append(nxt)
+        else:
+            runs.append([nxt])
+    return runs
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError(f"min_count は 2 以上である必要があります: {min_count}")
+    if tolerance < 0:
+        raise ValueError(f"tolerance は 0 以上である必要があります: {tolerance}")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    result: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        for run in _runs(sorted(day_set), tolerance):
+            if len(run) >= min_count:
+                result.append(
+                    Recurring(
+                        category=category,
+                        amount=amount,
+                        days=tuple(run),
+                        next_expected=add_month(run[-1]),
+                    )
+                )
+
+    result.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return result
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..bb0162d
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,105 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+
+@pytest.mark.parametrize(
+    "s,want",
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥1,2,3円", 123),
+        ("-5", -5),
+    ],
+)
+def test_parse_amount_ok(s, want):
+    assert parse_amount(s) == want
+
+
+@pytest.mark.parametrize(
+    "s", ["", "円", "12.5", "1 200", "--5", "¥-5", "１２３", ",5", "¥", "5円円", "¥¥5"]
+)
+def test_parse_amount_bad(s):
+    with pytest.raises(ValueError):
+        parse_amount(s)
+
+
+@pytest.mark.parametrize(
+    "s,want",
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        (" 2026-01-05 ", date(2026, 1, 5)),
+        ("2026/12/31", date(2026, 12, 31)),
+    ],
+)
+def test_parse_date_ok(s, want):
+    assert parse_date(s) == want
+
+
+@pytest.mark.parametrize(
+    "s",
+    [
+        "2026/1-5",
+        "26/1/5",
+        "2026/02/30",
+        "2026年1月5日",
+        "２０２６/1/5",
+        "2026/001/5",
+        "",
+    ],
+)
+def test_parse_date_bad(s):
+    with pytest.raises(ValueError):
+        parse_date(s)
+
+
+HEADER = "利用日,分類,利用金額,利用店名\n"
+
+
+def test_import_basic_and_category_map():
+    text = HEADER + '2026/1/5,食費 ,"¥1,200", コンビニ \n'
+    rows, errs = import_rows(text, category_map={"食費": "食"})
+    assert errs == []
+    assert rows == [Expense(date(2026, 1, 5), "食", 1200, "コンビニ")]
+
+
+def test_import_errors_order_and_lines():
+    text = HEADER + "\n" + "bad,,x,m\n" + "2026/1/1,食,100,ok\n" + "2026/1/2,食\n"
+    rows, errs = import_rows(text)
+    assert errs == [(3, "date"), (3, "amount"), (3, "category"), (5, "amount")]
+    assert [r.amount for r in rows] == [100]
+
+
+def test_import_multiline_quoted_physical_line():
+    text = HEADER + '2026/1/1,食,100,"a\nb"\nbad,食,1,m\n'
+    rows, errs = import_rows(text)
+    assert len(rows) == 1
+    assert errs == [(4, "date")]
+
+
+def test_import_custom_mapping_without_memo():
+    m = {"date": "d", "category": "c", "amount": "a"}
+    rows, errs = import_rows("d,x,c,a\n2026-1-2,z,食,5\n", m)
+    assert errs == []
+    assert rows == [Expense(date(2026, 1, 2), "食", 5, "")]
+
+
+def test_import_mapping_errors():
+    with pytest.raises(ValueError):
+        import_rows(HEADER, {"date": "利用日", "category": "分類"})
+    with pytest.raises(ValueError):
+        import_rows("a,b\n", {"date": "a", "category": "b", "amount": "c"})
+    with pytest.raises(ValueError):
+        import_rows(
+            HEADER,
+            {"date": "利用日", "category": "分類", "amount": "利用金額", "memo": "x"},
+        )
+
+
+def test_import_empty_result():
+    assert import_rows(HEADER) == ([], [])
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..5f1ae53
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,112 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def E(d: str, cat: str, amt: int) -> Expense:
+    return Expense(date.fromisoformat(d), cat, amt)
+
+
+ROWS = [
+    E("2024-01-05", "food", 1000),
+    E("2024-01-06", "food", 500),
+    E("2024-02-01", "food", 1800),
+    E("2024-01-10", "rent", 2000),
+    E("2024-02-10", "new", 700),
+    E("2024-02-11", "same", 100),
+    E("2024-01-11", "same", 100),
+    E("2024-01-12", "down", 1000),
+    E("2024-02-12", "down", 900),
+]
+
+
+@pytest.mark.parametrize(
+    "bad", ["2024-1", "2024-13", "2024-00", "202401", "2024-01-01", "", "２０２４-01"]
+)
+def test_bad_month(bad):
+    with pytest.raises(ValueError):
+        month_diff(ROWS, bad, "2024-02")
+    with pytest.raises(ValueError):
+        month_diff(ROWS, "2024-01", bad)
+
+
+def test_month_diff():
+    r = month_diff(ROWS, "2024-01", "2024-02")
+    assert [x.category for x in r] == ["rent", "new", "food", "down", "same"]
+    by = {x.category: x for x in r}
+    assert by["food"] == DiffRow("food", 1500, 1800, 300, 20.0, "up")
+    assert by["rent"] == DiffRow("rent", 2000, 0, -2000, -100.0, "gone")
+    assert by["new"] == DiffRow("new", 0, 700, 700, None, "new")
+    assert by["down"].status == "down"
+    assert by["same"] == DiffRow("same", 100, 100, 0, 0.0, "same")
+
+
+def test_order_abs_desc_then_category():
+    rows = [
+        E("2024-01-01", "b", 100),
+        E("2024-02-01", "a", 100),
+        E("2024-01-02", "c", 5),
+    ]
+    r = month_diff(rows, "2024-01", "2024-02")
+    assert [x.category for x in r] == ["a", "b", "c"]
+
+
+def test_status_by_presence_not_total():
+    rows = [E("2024-01-01", "x", 0), E("2024-02-01", "x", 0), E("2024-02-02", "y", 0)]
+    by = {x.category: x for x in month_diff(rows, "2024-01", "2024-02")}
+    assert by["x"].status == "same"
+    assert by["y"].status == "new"
+    rows = [E("2024-01-01", "x", 0)]
+    assert month_diff(rows, "2024-01", "2024-02")[0].status == "gone"
+    assert month_diff(rows, "2024-01", "2024-02")[0].pct is None
+
+
+def test_empty():
+    assert month_diff([], "2024-01", "2024-02") == []
+
+
+def test_top_movers():
+    r = month_diff(ROWS, "2024-01", "2024-02")
+    t = top_movers(r)
+    assert len(t) == 3 and all(x.status != "same" for x in t)
+    assert t == [x for x in r if x.status != "same"][:3]
+    assert top_movers(r, 0) == []
+    assert len(top_movers(r, 100)) == 4
+    with pytest.raises(ValueError):
+        top_movers(r, -1)
+
+
+def test_render():
+    r = month_diff(ROWS, "2024-01", "2024-02")
+    out = render_diff(r)
+    lines = out.split("\n")
+    assert lines[0] == "category\tprev\tcurr\tdelta\tpct"
+    assert "food\t1500\t1800\t+300\t+20.0%" in lines
+    assert "rent\t2000\t0\t-2000\t-100.0%" in lines
+    assert "new\t0\t700\t+700\t-" in lines
+    assert "same\t100\t100\t+0\t+0.0%" in lines
+    assert not out.endswith("\n")
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_available_and_latest():
+    assert available_months(ROWS) == ["2024-01", "2024-02"]
+    assert available_months([]) == []
+    assert latest_diff(ROWS) == month_diff(ROWS, "2024-01", "2024-02")
+    rows = ROWS + [E("2024-04-01", "food", 1)]
+    assert available_months(rows) == ["2024-01", "2024-02", "2024-04"]
+    assert latest_diff(rows) == month_diff(rows, "2024-02", "2024-04")
+    with pytest.raises(ValueError):
+        latest_diff([E("2024-01-01", "a", 1)])
+    with pytest.raises(ValueError):
+        latest_diff([])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..5406d83
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,290 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def _e(category: str, memo: str = "", amount: int = 100) -> Expense:
+    return Expense(day=date(2026, 11, 1), category=category, amount=amount, memo=memo)
+
+
+ROWS = [
+    _e("food", "lunch", 1200),
+    _e("rent", "", 80000),
+    _e("food", "coffee", 800),
+    _e("food", "lunch with friends", 500),
+    _e("foodie", "magazine", 300),
+]
+
+
+# --- tokenize -------------------------------------------------------------
+
+
+def test_tokenize_whitespace_only_is_empty():
+    assert tokenize("   \t ") == []
+
+
+def test_tokenize_empty_string_is_empty():
+    assert tokenize("") == []
+
+
+def test_tokenize_parens():
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+
+
+def test_tokenize_parens_without_spaces_split_words():
+    assert tokenize("a(b)c") == [
+        ("TERM", "a"),
+        ("LPAREN", "("),
+        ("TERM", "b"),
+        ("RPAREN", ")"),
+        ("TERM", "c"),
+    ]
+
+
+def test_tokenize_quoted_keeps_spaces_and_parens():
+    assert tokenize('"lunch (x) y"') == [("TERM", "lunch (x) y")]
+
+
+def test_tokenize_quoted_has_no_escape():
+    # A backslash is an ordinary character; the quote closes at the next quote.
+    assert tokenize('"a\\"') == [("TERM", "a\\")]
+
+
+def test_tokenize_unclosed_quote_raises():
+    with pytest.raises(QueryError):
+        tokenize('"lunch')
+
+
+def test_tokenize_empty_quote_raises():
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_uppercase_operators():
+    assert tokenize("a AND b OR NOT c") == [
+        ("TERM", "a"),
+        ("AND", "AND"),
+        ("TERM", "b"),
+        ("OR", "OR"),
+        ("NOT", "NOT"),
+        ("TERM", "c"),
+    ]
+
+
+def test_tokenize_lowercase_operators_are_terms():
+    assert tokenize("a and or not") == [
+        ("TERM", "a"),
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_quoted_operator_is_term():
+    assert tokenize('"AND" "NOT"') == [("TERM", "AND"), ("TERM", "NOT")]
+
+
+def test_tokenize_cat_prefix():
+    assert tokenize("cat:food") == [("CAT", "food")]
+
+
+def test_tokenize_cat_with_empty_value_raises():
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_tokenize_quoted_cat_is_term():
+    assert tokenize('"cat:food"') == [("TERM", "cat:food")]
+
+
+def test_tokenize_cat_is_case_sensitive_prefix():
+    assert tokenize("CAT:food") == [("TERM", "CAT:food")]
+
+
+# --- parsing errors -------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(a",
+        "a)",
+        ")a(",
+        "a AND",
+        "AND a",
+        "a OR",
+        "OR a",
+        "a OR OR b",
+        "a AND OR b",
+        "NOT",
+        "a NOT",
+        "( )",
+        "(a OR)",
+        "()a",
+    ],
+)
+def test_invalid_queries_raise(q):
+    with pytest.raises(QueryError):
+        filter_rows(q, [])
+
+
+def test_invalid_query_raises_even_with_matching_rows():
+    with pytest.raises(QueryError):
+        filter_rows("a AND", ROWS)
+
+
+def test_invalid_query_raises_in_matches():
+    with pytest.raises(QueryError):
+        matches("(", ROWS[0])
+
+
+# --- evaluation -----------------------------------------------------------
+
+
+def test_term_matches_memo_substring():
+    assert matches("lunch", ROWS[0])
+    assert not matches("lunch", ROWS[2])
+
+
+def test_term_matches_category_substring():
+    assert matches("foo", ROWS[0])
+    assert matches("foo", ROWS[4])
+
+
+def test_term_is_substring_not_word():
+    assert matches("unch", ROWS[0])
+
+
+def test_term_is_case_insensitive():
+    assert matches("LUNCH", ROWS[0])
+    assert matches("Food", ROWS[0])
+
+
+def test_casefold_handles_sharp_s():
+    e = _e("food", "STRASSE")
+    assert matches('"straße"', e)
+
+
+def test_quoted_term_with_spaces():
+    assert matches('"lunch with"', ROWS[3])
+    assert not matches('"lunch with"', ROWS[0])
+
+
+def test_cat_is_exact_match():
+    assert matches("cat:food", ROWS[0])
+    assert not matches("cat:food", ROWS[4])
+
+
+def test_cat_is_case_insensitive():
+    assert matches("cat:FOOD", ROWS[0])
+
+
+def test_cat_does_not_match_memo():
+    assert not matches("cat:lunch", ROWS[0])
+
+
+def test_term_matches_partial_category_of_rent_row():
+    assert matches("ren", ROWS[1])
+    assert not matches("oo", ROWS[1])
+
+
+def test_implicit_and_between_terms():
+    assert matches("food lunch", ROWS[0])
+    assert not matches("food coffee", ROWS[0])
+
+
+def test_explicit_and():
+    assert matches("food AND lunch", ROWS[0])
+    assert not matches("food AND rent", ROWS[0])
+
+
+def test_or():
+    assert matches("rent OR lunch", ROWS[0])
+    assert matches("rent OR lunch", ROWS[1])
+    assert not matches("rent OR lunch", ROWS[2])
+
+
+def test_not():
+    assert matches("NOT rent", ROWS[0])
+    assert not matches("NOT rent", ROWS[1])
+
+
+def test_not_binds_tighter_than_and():
+    # (NOT rent) AND lunch
+    assert matches("NOT rent lunch", ROWS[0])
+    assert not matches("NOT rent lunch", ROWS[2])
+
+
+def test_and_binds_tighter_than_or():
+    # coffee OR (rent AND lunch)
+    assert matches("coffee OR rent lunch", ROWS[2])
+    assert not matches("coffee OR rent lunch", ROWS[0])
+    assert not matches("coffee OR rent lunch", ROWS[1])
+
+
+def test_or_is_lowest_precedence_with_not():
+    # NOT (a OR b): NOT binds tighter than OR, so (NOT a) OR b
+    assert matches("NOT rent OR rent", ROWS[0])
+    assert not matches("NOT food OR lunch", ROWS[2])
+
+
+def test_parentheses_override_precedence():
+    # (coffee OR rent) lunch
+    assert not matches("(coffee OR rent) lunch", ROWS[2])
+    assert matches("(coffee OR rent) food", ROWS[2])
+
+
+def test_double_not():
+    assert matches("NOT NOT lunch", ROWS[0])
+    assert not matches("NOT NOT lunch", ROWS[2])
+
+
+def test_nested_parens():
+    assert matches("((lunch))", ROWS[0])
+
+
+def test_not_with_parens():
+    assert matches("NOT (rent OR coffee)", ROWS[0])
+    assert not matches("NOT (rent OR coffee)", ROWS[2])
+
+
+def test_quoted_term_with_parens_is_literal():
+    e = _e("food", "(x)")
+    assert matches('"(x)"', e)
+
+
+# --- filter_rows ----------------------------------------------------------
+
+
+def test_filter_rows_keeps_input_order():
+    out = filter_rows("food", ROWS)
+    assert out == [ROWS[0], ROWS[2], ROWS[3], ROWS[4]]
+
+
+def test_filter_rows_cat_exact():
+    assert filter_rows("cat:food", ROWS) == [ROWS[0], ROWS[2], ROWS[3]]
+
+
+def test_filter_rows_no_match_is_empty_list():
+    assert filter_rows("zzz", ROWS) == []
+
+
+def test_filter_rows_empty_input_valid_query():
+    assert filter_rows("food", []) == []
+
+
+def test_filter_rows_empty_input_invalid_query_raises():
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
+
+
+def test_filter_rows_does_not_mutate_input():
+    rows = list(ROWS)
+    filter_rows("food", rows)
+    assert rows == ROWS
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..7fe1280
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,291 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def _e(
+    day: str, category: str = "rent", amount: int = 80000, memo: str = ""
+) -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+# --- add_month ---------------------------------------------------------------
+
+
+def test_add_month_same_day():
+    assert add_month(date(2026, 3, 10)) == date(2026, 4, 10)
+
+
+def test_add_month_clamps_to_end_of_short_month():
+    assert add_month(date(2026, 1, 31)) == date(2026, 2, 28)
+
+
+def test_add_month_clamps_to_leap_february():
+    assert add_month(date(2024, 1, 31)) == date(2024, 2, 29)
+
+
+def test_add_month_30_day_month_clamps_31():
+    assert add_month(date(2026, 8, 31)) == date(2026, 9, 30)
+
+
+def test_add_month_rolls_over_year():
+    assert add_month(date(2026, 12, 15)) == date(2027, 1, 15)
+
+
+def test_add_month_dec_31_to_jan_31():
+    assert add_month(date(2026, 12, 31)) == date(2027, 1, 31)
+
+
+# --- find_recurring: argument validation -------------------------------------
+
+
+@pytest.mark.parametrize("min_count", [1, 0, -3])
+def test_min_count_below_two_raises(min_count):
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=min_count)
+
+
+def test_negative_tolerance_raises():
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_min_count_two_is_allowed():
+    assert find_recurring([_e("2026-01-01"), _e("2026-02-01")], min_count=2) == [
+        Recurring("rent", 80000, (date(2026, 1, 1), date(2026, 2, 1)), date(2026, 3, 1))
+    ]
+
+
+def test_zero_tolerance_is_allowed():
+    assert find_recurring([], tolerance=0) == []
+
+
+# --- find_recurring: basic detection -----------------------------------------
+
+
+def test_empty_input_returns_empty_list():
+    assert find_recurring([]) == []
+
+
+def test_three_monthly_payments_detected():
+    rows = [_e("2026-01-25"), _e("2026-02-25"), _e("2026-03-25")]
+    assert find_recurring(rows) == [
+        Recurring(
+            "rent",
+            80000,
+            (date(2026, 1, 25), date(2026, 2, 25), date(2026, 3, 25)),
+            date(2026, 4, 25),
+        )
+    ]
+
+
+def test_two_payments_below_default_min_count_not_detected():
+    rows = [_e("2026-01-25"), _e("2026-02-25")]
+    assert find_recurring(rows) == []
+
+
+def test_run_of_exactly_min_count_is_detected():
+    rows = [_e("2026-01-25"), _e("2026-02-25"), _e("2026-03-25")]
+    assert len(find_recurring(rows, min_count=3)) == 1
+
+
+def test_run_shorter_than_min_count_is_dropped():
+    rows = [_e("2026-01-25"), _e("2026-02-25"), _e("2026-03-25")]
+    assert find_recurring(rows, min_count=4) == []
+
+
+def test_next_expected_uses_add_month_clamp_on_last_date():
+    rows = [_e("2026-11-30"), _e("2026-12-30"), _e("2027-01-30")]
+    result = find_recurring(rows)
+    assert result[0].next_expected == date(2027, 2, 28)
+
+
+def test_memo_is_ignored_for_grouping():
+    rows = [
+        _e("2026-01-25", memo="a"),
+        _e("2026-02-25", memo="b"),
+        _e("2026-03-25", memo=""),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 25), date(2026, 2, 25), date(2026, 3, 25))
+
+
+def test_duplicate_dates_are_collapsed():
+    rows = [
+        _e("2026-01-25"),
+        _e("2026-01-25"),
+        _e("2026-02-25"),
+        _e("2026-02-25"),
+        _e("2026-03-25"),
+    ]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 25), date(2026, 2, 25), date(2026, 3, 25))
+
+
+def test_input_order_does_not_matter():
+    rows = [_e("2026-03-25"), _e("2026-01-25"), _e("2026-02-25")]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 25), date(2026, 2, 25), date(2026, 3, 25))
+
+
+# --- find_recurring: grouping -------------------------------------------------
+
+
+def test_different_amounts_in_same_category_are_separate_groups():
+    rows = [
+        _e("2026-01-25", amount=1000),
+        _e("2026-02-25", amount=1000),
+        _e("2026-03-25", amount=1000),
+        _e("2026-01-26", amount=2000),
+        _e("2026-02-26", amount=2000),
+    ]
+    result = find_recurring(rows)
+    assert [(r.amount, len(r.days)) for r in result] == [(1000, 3)]
+
+
+def test_same_amount_in_different_categories_are_separate_groups():
+    rows = [
+        _e("2026-01-25", category="b"),
+        _e("2026-02-25", category="b"),
+        _e("2026-03-25", category="b"),
+        _e("2026-01-25", category="a"),
+        _e("2026-02-25", category="a"),
+        _e("2026-03-25", category="a"),
+    ]
+    result = find_recurring(rows)
+    assert [r.category for r in result] == ["a", "b"]
+
+
+# --- find_recurring: tolerance -----------------------------------------------
+
+
+def test_gap_exactly_at_tolerance_is_connected():
+    # 2026-01-25 -> add_month = 2026-02-25; actual 2026-02-28 is +3 days.
+    rows = [_e("2026-01-25"), _e("2026-02-28"), _e("2026-03-28")]
+    result = find_recurring(rows, tolerance=3)
+    assert len(result) == 1
+
+
+def test_gap_one_beyond_tolerance_breaks_run():
+    # expected 2026-03-25; actual 2026-03-29 is 4 days off -> break, so the
+    # first two form a run of 2 (< 3) and are dropped.
+    rows = [_e("2026-01-25"), _e("2026-02-25"), _e("2026-03-29")]
+    assert find_recurring(rows, tolerance=3) == []
+
+
+def test_early_payment_within_tolerance_is_connected():
+    # expected 2026-02-25; actual 2026-02-22 is -3 days.
+    rows = [_e("2026-01-25"), _e("2026-02-22"), _e("2026-03-25")]
+    result = find_recurring(rows, tolerance=3)
+    assert len(result) == 1
+
+
+def test_zero_tolerance_requires_exact_day():
+    rows = [_e("2026-01-25"), _e("2026-02-26"), _e("2026-03-26")]
+    assert find_recurring(rows, tolerance=0) == []
+
+
+def test_tolerance_is_measured_from_add_month_not_previous_date():
+    # 2026-01-31 -> expected 2026-02-28, so 2026-03-03 is +3 (connected).
+    # Measured from the raw previous date it would be +31 (broken).
+    rows = [_e("2026-01-31"), _e("2026-03-03"), _e("2026-04-03")]
+    result = find_recurring(rows, tolerance=3)
+    assert [r.days for r in result] == [
+        (date(2026, 1, 31), date(2026, 3, 3), date(2026, 4, 3))
+    ]
+
+
+# --- find_recurring: run splitting -------------------------------------------
+
+
+def test_chain_break_splits_into_separate_recurring_entries():
+    rows = [
+        _e("2026-01-25"),
+        _e("2026-02-25"),
+        _e("2026-03-25"),
+        # break: nothing in April
+        _e("2026-06-25"),
+        _e("2026-07-25"),
+        _e("2026-08-25"),
+    ]
+    result = find_recurring(rows)
+    assert [r.days for r in result] == [
+        (date(2026, 1, 25), date(2026, 2, 25), date(2026, 3, 25)),
+        (date(2026, 6, 25), date(2026, 7, 25), date(2026, 8, 25)),
+    ]
+    assert result[1].next_expected == date(2026, 9, 25)
+
+
+def test_short_run_before_break_is_dropped_but_later_run_kept():
+    rows = [
+        _e("2026-01-25"),
+        _e("2026-02-25"),
+        _e("2026-06-25"),
+        _e("2026-07-25"),
+        _e("2026-08-25"),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 6, 25)]
+
+
+def test_run_with_a_break_in_the_middle_is_not_merged():
+    # 3 + 3 contiguous pieces; a break between them must not join them.
+    rows = [
+        _e("2026-01-25"),
+        _e("2026-02-25"),
+        _e("2026-03-25"),
+        _e("2026-09-25"),
+        _e("2026-10-25"),
+        _e("2026-11-25"),
+    ]
+    result = find_recurring(rows, min_count=4)
+    assert result == []
+
+
+# --- find_recurring: output ordering -----------------------------------------
+
+
+def test_results_sorted_by_category_then_amount_then_first_day():
+    rows = [
+        _e("2026-01-05", category="z", amount=100),
+        _e("2026-02-05", category="z", amount=100),
+        _e("2026-03-05", category="z", amount=100),
+        _e("2026-01-10", category="a", amount=900),
+        _e("2026-02-10", category="a", amount=900),
+        _e("2026-03-10", category="a", amount=900),
+        _e("2026-01-20", category="a", amount=300),
+        _e("2026-02-20", category="a", amount=300),
+        _e("2026-03-20", category="a", amount=300),
+    ]
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [
+        ("a", 300),
+        ("a", 900),
+        ("z", 100),
+    ]
+
+
+def test_same_category_and_amount_ordered_by_first_day():
+    rows = [
+        # run starting 2026-06
+        _e("2026-06-01"),
+        _e("2026-07-01"),
+        _e("2026-08-01"),
+        # run starting 2026-01 (same group, later in list)
+        _e("2026-01-01"),
+        _e("2026-02-01"),
+        _e("2026-03-01"),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 1), date(2026, 6, 1)]
+
+
+def test_group_with_no_qualifying_run_contributes_nothing():
+    rows = [_e("2026-01-01", category="x"), _e("2026-02-01", category="x")]
+    assert find_recurring(rows) == []
