+"""Month-over-month change of per-category spending (pure functions).
+
+入力は kakeibo.core.monthly_totals の戻り値 {"YYYY-MM": {category: yen}}。
+
+D1: 比較は隣の月どうし。各月を直前の月と比べる。1000→1500 は previous=1000, current=1500, diff=500, increased, rate=0.5。
+D2: 減ったら decreased、diff・rate は負。1500→1200 は diff=-300, rate=-0.2。
+D3: 前月に無い(または 0 円)で当月に 0 以外 → new、previous=0、rate=None。
+D4: 前月に 0 以外で当月に無い(または 0 円)→ removed、current=0、diff=-previous、rate=-1.0。
+D5: 同額(0 以外)→ unchanged、diff=0、rate=0.0。両月とも無い/0 円のカテゴリは出さない。
+D6: 最初の月は空の月と比べる(0 以外のカテゴリはすべて new)。
+D7: データに無い月は空の月として補い、結果にも現れる(1月・3月だけなら 2月は全部 removed、3月は new)。
+D8: 月ごとの並びは abs(diff) 降順、同点はカテゴリ名昇順。
+D9: 入力の月キーの並びに依らず、結果は昇順。
+D10: 年またぎは 12 月の次が 1 月(補完も同じ)。
+D11: 負の合計も受ける。rate は previous > 0 のときだけ(それ以外は None)。status は new/removed 以外 diff の符号。
+D12: 空の totals → {}。1 か月だけ → 全カテゴリ new。
+D13: 入力は書き換えない。
+
+不正な月キー(YYYY-MM でない)は ValueError、金額が int でない/bool・dict でない入力は TypeError。
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    month: str
+    category: str
+    previous: int
+    current: int
+    diff: int
+    status: str  # "increased" | "decreased" | "new" | "removed" | "unchanged"
+    rate: float | None  # diff / previous, only when previous > 0
+
+
+def _month_index(month: object) -> int:
+    if not isinstance(month, str):
+        raise TypeError(f"月のキーは文字列である必要があります: {month!r}")
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+    return int(month[:4]) * 12 + int(month[5:]) - 1
+
+
+def _month_name(index: int) -> str:
+    return f"{index // 12:04d}-{index % 12 + 1:02d}"
+
+
+def _validate(totals: object) -> dict[int, dict[str, int]]:
+    if not isinstance(totals, dict):
+        raise TypeError("totals は dict である必要があります")
+    out: dict[int, dict[str, int]] = {}
+    for month, cats in totals.items():
+        idx = _month_index(month)
+        if not isinstance(cats, dict):
+            raise TypeError(f"{month} の値は dict である必要があります")
+        for cat, yen in cats.items():
+            if isinstance(yen, bool) or not isinstance(yen, int):
+                raise TypeError(f"{month}.{cat} は int である必要があります: {yen!r}")
+        out[idx] = cats
+    return out
+
+
+def _change(month: str, cat: str, previous: int, current: int) -> CategoryChange | None:
+    if previous == 0 and current == 0:
+        return None
+    diff = current - previous
+    if previous == 0:
+        status = "new"
+    elif current == 0:
+        status = "removed"
+    elif diff > 0:
+        status = "increased"
+    elif diff < 0:
+        status = "decreased"
+    else:
+        status = "unchanged"
+    rate = diff / previous if previous > 0 else None
+    return CategoryChange(month, cat, previous, current, diff, status, rate)
+
+
+def month_over_month(
+    totals: dict[str, dict[str, int]],
+) -> dict[str, list[CategoryChange]]:
+    """Compare each month with the previous calendar month (gaps filled as empty)."""
+    by_index = _validate(totals)
+    if not by_index:
+        return {}
+    result: dict[str, list[CategoryChange]] = {}
+    prev: dict[str, int] = {}
+    for idx in range(min(by_index), max(by_index) + 1):
+        cur = by_index.get(idx, {})
+        month = _month_name(idx)
+        changes = [
+            c
+            for cat in prev.keys() | cur.keys()
+            if (c := _change(month, cat, prev.get(cat, 0), cur.get(cat, 0)))
+        ]
+        changes.sort(key=lambda c: (-abs(c.diff), c.category))
+        result[month] = changes
+        prev = cur
+    return result
diff --git a/tests/test_trend.py b/tests/test_trend.py
new file mode 100644
index 0000000..b9b774c
