+++ b/tests/test_trend.py
@@ -0,0 +1,171 @@
+import copy
+import re
+
+import pytest
+
+from kakeibo.trend import CategoryChange, month_over_month
+
+
+def test_d1_adjacent_months_increase():
+    """D1: 隣の月どうしを比べる。1000 -> 1500 は increased, rate 0.5。"""
+    result = month_over_month({"2026-01": {"食費": 1000}, "2026-02": {"食費": 1500}})
+    assert result["2026-02"] == [
+        CategoryChange("2026-02", "食費", 1000, 1500, 500, "increased", 0.5)
+    ]
+
+
+def test_d2_decreased():
+    """D2: 1500 -> 1200 は decreased, diff -300, rate -0.2。"""
+    result = month_over_month({"2026-01": {"食費": 1500}, "2026-02": {"食費": 1200}})
+    (change,) = result["2026-02"]
+    assert change.status == "decreased"
+    assert change.diff == -300
+    assert change.rate == pytest.approx(-0.2)
+
+
+def test_d3_new_category():
+    """D3: 前月に無く当月にある -> new, previous=0, rate None。"""
+    result = month_over_month({"2026-01": {}, "2026-02": {"趣味": 800}})
+    assert result["2026-02"] == [
+        CategoryChange("2026-02", "趣味", 0, 800, 800, "new", None)
+    ]
+
+
+def test_d4_removed_category():
+    """D4: 前月にあり当月に無い -> removed, current=0, diff=-800, rate=-1.0。"""
+    result = month_over_month({"2026-01": {"趣味": 800}, "2026-02": {}})
+    assert result["2026-02"] == [
+        CategoryChange("2026-02", "趣味", 800, 0, -800, "removed", -1.0)
+    ]
+
+
+def test_d5_unchanged_and_zero_omitted():
+    """D5: 同額は unchanged (diff 0, rate 0.0)。両月 0 円のカテゴリは出さない。"""
+    result = month_over_month(
+        {
+            "2026-01": {"食費": 1000, "趣味": 0},
+            "2026-02": {"食費": 1000, "趣味": 0},
+        }
+    )
+    assert result["2026-02"] == [
+        CategoryChange("2026-02", "食費", 1000, 1000, 0, "unchanged", 0.0)
+    ]
+
+
+def test_d6_first_month_all_new():
+    """D6: 最初の月は空の月と比べ、0 以外のカテゴリはすべて new。"""
+    result = month_over_month({"2026-01": {"食費": 1000}})
+    assert result["2026-01"] == [
+        CategoryChange("2026-01", "食費", 0, 1000, 1000, "new", None)
+    ]
+
+
+def test_d7_missing_month_is_filled():
+    """D7: 1月と3月だけ -> 2月は空の月として補完され、removed/new が出る。"""
+    result = month_over_month({"2026-01": {"食費": 1000}, "2026-03": {"食費": 900}})
+    assert list(result) == ["2026-01", "2026-02", "2026-03"]
+    assert result["2026-02"] == [
+        CategoryChange("2026-02", "食費", 1000, 0, -1000, "removed", -1.0)
+    ]
+    assert result["2026-03"] == [
+        CategoryChange("2026-03", "食費", 0, 900, 900, "new", None)
+    ]
+
+
+def test_d8_sorted_by_abs_diff_then_name():
+    """D8: abs(diff) 降順、同点はカテゴリ名の昇順。"""
+    result = month_over_month(
+        {
+            "2026-01": {"食費": 1000, "交通": 1000},
+            "2026-02": {"食費": 1500, "交通": 500, "趣味": 900},
+        }
+    )
+    assert [c.category for c in result["2026-02"]] == ["趣味", "交通", "食費"]
+
+
+def test_d9_unsorted_input_months():
+    """D9: 入力の月が昇順でなくても、結果は昇順に比較される。"""
+    result = month_over_month({"2026-02": {"食費": 1500}, "2026-01": {"食費": 1000}})
+    assert list(result) == ["2026-01", "2026-02"]
+    assert result["2026-02"] == [
+        CategoryChange("2026-02", "食費", 1000, 1500, 500, "increased", 0.5)
+    ]
+
+
+def test_d10_year_boundary():
+    """D10: 2025-12 の次は 2026-01。2025-11 と 2026-01 の間に 2025-12 が補完される。"""
+    result = month_over_month({"2025-11": {"食費": 1}, "2026-01": {"食費": 2}})
+    assert list(result) == ["2025-11", "2025-12", "2026-01"]
+    assert result["2025-12"][0].status == "removed"
+    assert result["2026-01"][0].status == "new"
+
+
+def test_d10_year_boundary_adjacent():
+    """D10: 2025-12 -> 2026-01 は隣どうしとして比べる(100 -> 300, rate 2.0)。"""
+    result = month_over_month({"2025-12": {"食費": 100}, "2026-01": {"食費": 300}})
+    assert result["2026-01"] == [
+        CategoryChange("2026-01", "食費", 100, 300, 200, "increased", 2.0)
+    ]
+
+
+def test_d11_negative_previous_rate_none():
+    """D11: previous=-100 -> current=200 は increased。rate は previous<=0 で None。"""
+    result = month_over_month({"2026-01": {"返金": -100}, "2026-02": {"返金": 200}})
+    assert result["2026-02"] == [
+        CategoryChange("2026-02", "返金", -100, 200, 300, "increased", None)
+    ]
+
+
+def test_d11_zero_previous_negative_current_is_new():
+    """D11: previous=0 で current=-50 は new、rate None。"""
+    result = month_over_month({"2026-01": {}, "2026-02": {"返金": -50}})
+    assert result["2026-02"] == [
+        CategoryChange("2026-02", "返金", 0, -50, -50, "new", None)
+    ]
+
+
+def test_d12_empty_totals():
+    """D12: 空の totals は空の dict。"""
+    assert month_over_month({}) == {}
+
+
+def test_d12_single_month_all_new():
+    """D12: 1 か月だけなら、その月の全カテゴリは new。"""
+    result = month_over_month({"2026-01": {"食費": 1000}})
+    assert list(result) == ["2026-01"]
+    assert all(c.status == "new" for c in result["2026-01"])
+
+
+def test_d13_input_not_mutated():
+    """D13: 入力 dict を書き換えない。"""
+    totals = {"2026-02": {"食費": 1500}, "2026-01": {"食費": 1000, "趣味": 0}}
+    before = copy.deepcopy(totals)
+    month_over_month(totals)
+    assert totals == before
+
+
+@pytest.mark.parametrize("key", ["2026-13", "2026-1", "abc"])
+def test_invalid_month_key_raises_value_error(key):
+    """月キーが YYYY-MM でない -> ValueError、メッセージに月キーを含む。"""
+    with pytest.raises(ValueError, match=re.escape(key)):
+        month_over_month({key: {"食費": 1000}})
+
+
+@pytest.mark.parametrize("amount", [1.0, "100", None, True])
+def test_non_int_amount_raises_type_error(amount):
+    """金額が int でない / bool -> TypeError。"""
+    with pytest.raises(TypeError):
+        month_over_month({"2026-01": {"食費": amount}})
+
+
+@pytest.mark.parametrize("bad", [[1000], []])
+def test_non_dict_month_value_raises_type_error(bad):
+    """各月の値が dict でない -> TypeError。"""
+    with pytest.raises(TypeError):
+        month_over_month({"2026-01": bad})
+
+
+def test_non_dict_totals_raises_type_error():
+    """totals 自体が dict でない -> TypeError。"""
+    with pytest.raises(TypeError):
+        month_over_month([])  # type: ignore[arg-type]
