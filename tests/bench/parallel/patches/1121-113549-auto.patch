@@ -0,0 +1,209 @@
+"""Import bank/card CSV text into Expense records (pure: str in, result out)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from collections.abc import Callable, Iterator
+from dataclasses import dataclass
+from datetime import date
+from typing import Any
+
+from kakeibo.core import Expense
+
+UNCATEGORIZED = "未分類"
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str
+    value: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+
+
+_ALIASES: dict[str, tuple[str, ...]] = {
+    "日付": ("date", "日付", "利用日", "取引日", "ご利用日", "年月日"),
+    "金額": ("amount", "金額", "利用金額", "ご利用金額"),
+    "出金": ("出金", "出金額", "支払", "お支払金額"),
+    "入金": ("入金", "入金額", "預入", "お預り金額"),
+    "メモ": ("memo", "摘要", "メモ", "利用店名", "ご利用店名", "内容", "備考"),
+    "カテゴリ": ("category", "カテゴリ", "分類", "費目"),
+}
+
+
+def _norm(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip()
+
+
+def _key(s: str) -> str:
+    return _norm(s).lower()
+
+
+_ALIAS_TO_CANON: dict[str, str] = {
+    _key(alias): canon for canon, aliases in _ALIASES.items() for alias in aliases
+}
+
+_DATE_PATTERNS = (
+    re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日"),
+    re.compile(r"([0-9]{4})[-/.]([0-9]{1,2})[-/.]([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})"),
+)
+_CURRENCY_RE = re.compile(r"¥|円|JPY", re.IGNORECASE)
+
+
+def _parse_date(raw: str) -> date:
+    s = _norm(raw)
+    if not s:
+        raise ValueError("日付が空です")
+    s = s.split()[0]  # 時刻を捨てる
+    for pat in _DATE_PATTERNS:
+        m = pat.fullmatch(s)
+        if m:
+            y, mo, d = (int(g) for g in m.groups())
+            try:
+                return date(y, mo, d)
+            except ValueError:
+                raise ValueError(f"存在しない日付です: {raw.strip()!r}") from None
+    raise ValueError(f"日付の形式が不正です: {raw.strip()!r}")
+
+
+def _parse_amount(raw: str) -> int:
+    """Signed yen. 負の表記: 先頭の - − △ ▲、末尾の -、括弧。"""
+    s = _norm(raw).replace("−", "-")
+    s = _CURRENCY_RE.sub("", s)
+    s = re.sub(r"\s", "", s).replace(",", "")
+    if not s:
+        raise ValueError("金額が空です")
+    neg = False
+    if s.startswith("(") and s.endswith(")"):
+        neg, s = True, s[1:-1]
+    elif s[:1] in ("-", "△", "▲"):
+        neg, s = True, s[1:]
+    elif s.endswith("-"):
+        neg, s = True, s[:-1]
+    if not re.fullmatch(r"[0-9]+", s):
+        raise ValueError(f"金額が整数ではありません: {raw.strip()!r}")
+    value = int(s)
+    return -value if neg else value
+
+
+def _guard[T](
+    errs: list[RowError],
+    line: int,
+    column: str,
+    raw: str,
+    parse: Callable[[str], T],
+) -> T | None:
+    try:
+        return parse(raw)
+    except ValueError as e:
+        errs.append(RowError(line, column, raw, str(e)))
+        return None
+
+
+def _records(
+    reader: Any,
+) -> Iterator[tuple[int, list[str]]]:  # csv.reader(line_num を持つ)
+    """(レコード開始行, 行の値)。空行は読み飛ばす。"""
+    while True:
+        start = reader.line_num + 1
+        try:
+            row = next(reader)
+        except StopIteration:
+            return
+        if not any(cell.strip() for cell in row):
+            continue
+        yield start, row
+
+
+def _convert_row(
+    line: int, row: list[str], cols: dict[str, int]
+) -> tuple[Expense | None, list[RowError]]:
+    def cell(name: str) -> str:
+        i = cols.get(name)
+        return row[i] if i is not None else ""
+
+    errs: list[RowError] = []
+    day = _guard(errs, line, "日付", cell("日付"), _parse_date)
+
+    amount: int | None = None
+    if "金額" in cols:
+        amount = _guard(errs, line, "金額", cell("金額"), _parse_amount)
+    else:
+        out_raw, in_raw = cell("出金"), cell("入金")
+        out_blank, in_blank = _norm(out_raw) == "", _norm(in_raw) == ""
+        if out_blank and in_blank:
+            errs.append(RowError(line, "出金/入金", "", "出金・入金がどちらも空です"))
+        elif not out_blank and not in_blank:
+            errs.append(
+                RowError(
+                    line,
+                    "出金/入金",
+                    f"{out_raw}/{in_raw}",
+                    "出金・入金の両方に値があります",
+                )
+            )
+        elif not out_blank:
+            v = _guard(errs, line, "出金", out_raw, _parse_amount)
+            amount = abs(v) if v is not None else None  # 出金は正
+        else:
+            v = _guard(errs, line, "入金", in_raw, _parse_amount)
+            amount = -abs(v) if v is not None else None  # 入金は負
+
+    if errs or day is None or amount is None:
+        return None, errs
+    category = _norm(cell("カテゴリ")) or UNCATEGORIZED
+    return Expense(
+        day=day, category=category, amount=amount, memo=_norm(cell("メモ"))
+    ), []
+
+
+def import_csv(text: str) -> ImportResult:
+    text = text.removeprefix("﻿")
+    first_line = re.split(r"\r\n|\r|\n", text, maxsplit=1)[0]
+    delim = "\t" if "\t" in first_line else ","
+    records = _records(csv.reader(io.StringIO(text, newline=""), delimiter=delim))
+
+    header_rec = next(records, None)
+    if header_rec is None:
+        return ImportResult([], [])
+    _, header = header_rec
+
+    cols: dict[str, int] = {}
+    for i, name in enumerate(header):
+        canon = _ALIAS_TO_CANON.get(_key(name))
+        if canon is not None:
+            cols.setdefault(canon, i)
+
+    if "日付" not in cols:
+        return ImportResult([], [RowError(1, "日付", "", "必須列がありません")])
+    if not ({"金額", "出金", "入金"} & cols.keys()):
+        return ImportResult([], [RowError(1, "金額", "", "必須列がありません")])
+
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    for line, row in records:
+        if len(row) != len(header):
+            errors.append(
+                RowError(
+                    line,
+                    "(行)",
+                    delim.join(row),
+                    f"列数が {len(row)} 列です(ヘッダーは {len(header)} 列)",
+                )
+            )
+            continue
+        expense, row_errors = _convert_row(line, row, cols)
+        errors.extend(row_errors)
+        if expense is not None:
+            expenses.append(expense)
+    return ImportResult(expenses, errors)
