@@ -0,0 +1,84 @@
+"""Month-over-month category comparison (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryDelta:
+    category: str
+    previous: int
+    current: int
+    diff: int
+    pct: float | None
+
+
+def _check_month(value: object, name: str) -> str:
+    if not isinstance(value, str):
+        raise TypeError(f"{name} は str である必要があります")
+    if not _MONTH_RE.fullmatch(value):
+        raise ValueError(f"{name} は YYYY-MM 形式である必要があります: {value!r}")
+    return value
+
+
+def _prev_month(month: str) -> str:
+    year, mon = int(month[:4]), int(month[5:])
+    if mon > 1:
+        return f"{year:04d}-{mon - 1:02d}"
+    if year == 0:
+        raise ValueError(f"month の前月が範囲外です: {month!r}")
+    return f"{year - 1:04d}-12"
+
+
+def _totals(rows: list[Expense], month: str) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for e in rows:
+        if e.amount < 0:  # D1: 返金は集計に混ぜない
+            continue
+        if f"{e.day.year:04d}-{e.day.month:02d}" != month:
+            continue
+        out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def compare_months(
+    rows: list[Expense], month: str, previous: str | None = None
+) -> list[CategoryDelta]:
+    cur_month = _check_month(month, "month")
+    if previous is None:
+        prev_month = _prev_month(cur_month)
+    else:
+        prev_month = _check_month(previous, "previous")
+
+    cur = _totals(rows, cur_month)
+    prev = _totals(rows, prev_month)
+
+    deltas: list[CategoryDelta] = []
+    for cat in set(cur) | set(prev):
+        p = prev.get(cat, 0)
+        c = cur.get(cat, 0)
+        diff = c - p
+        pct = None if p == 0 else diff / p * 100
+        deltas.append(CategoryDelta(cat, p, c, diff, pct))
+
+    deltas.sort(key=lambda d: (-abs(d.diff), d.category))
+    return deltas
+
+
+def format_report(deltas: list[CategoryDelta]) -> str:
+    if not deltas:
+        return "対象なし"
+    lines: list[str] = []
+    for d in deltas:
+        delta_text = f"{d.diff:+d}" if d.diff != 0 else "±0"
+        pct_text = "新規" if d.pct is None else f"{d.pct:+.1f}%"
+        lines.append(
+            f"{d.category}: {d.previous} → {d.current} ({delta_text}, {pct_text})"
+        )
+    return "\n".join(lines)
