+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthly_diff import CategoryDelta, compare_months, format_report
+
+
+def _e(day: date, category: str, amount: int) -> Expense:
+    return Expense(day=day, category=category, amount=amount)
+
+
+OCT = date(2026, 10, 5)
+NOV = date(2026, 11, 5)
+
+
+@pytest.mark.parametrize(
+    ("rows", "month", "expected"),
+    [
+        pytest.param(
+            [_e(OCT, "食費", 30000), _e(NOV, "食費", 36000)],
+            "2026-11",
+            [CategoryDelta("食費", 30000, 36000, 6000, 20.0)],
+            id="E4-1",
+        ),
+        pytest.param(
+            [_e(OCT, "交通", 5000)],
+            "2026-11",
+            [CategoryDelta("交通", 5000, 0, -5000, -100.0)],
+            id="E4-2",
+        ),
+    ],
+)
+def test_example_table(rows, month, expected):
+    assert compare_months(rows, month) == expected
+
+
+def test_E4_3_invalid_month_13():
+    with pytest.raises(ValueError):
+        compare_months([], "2026-13")
+
+
+# --- edge cases from the spec ---
+
+
+@pytest.mark.parametrize("bad", ["2026-1", "2026/01", "2026-00", "26-01"])
+def test_month_format_rejected(bad):
+    with pytest.raises(ValueError):
+        compare_months([], bad)
+
+
+def test_previous_format_rejected():
+    with pytest.raises(ValueError):
+        compare_months([], "2026-11", previous="2026/10")
+
+
+def test_non_str_month_is_type_error():
+    with pytest.raises(TypeError):
+        compare_months([], 202611)  # type: ignore[arg-type]
+
+
+def test_default_previous_is_prior_month():
+    rows = [_e(OCT, "食費", 100), _e(NOV, "食費", 150)]
+    assert compare_months(rows, "2026-11") == [
+        CategoryDelta("食費", 100, 150, 50, 50.0)
+    ]
+
+
+def test_january_previous_is_prior_december():
+    rows = [_e(date(2025, 12, 1), "食費", 200), _e(date(2026, 1, 1), "食費", 100)]
+    assert compare_months(rows, "2026-01") == [
+        CategoryDelta("食費", 200, 100, -100, -50.0)
+    ]
+
+
+def test_explicit_previous_is_used():
+    rows = [
+        _e(OCT, "食費", 100),
+        _e(NOV, "食費", 400),
+        _e(date(2026, 9, 1), "食費", 200),
+    ]
+    assert compare_months(rows, "2026-11", previous="2026-09") == [
+        CategoryDelta("食費", 200, 400, 200, 100.0)
+    ]
+
+
+def test_negative_amounts_are_ignored():
+    rows = [_e(OCT, "食費", 1000), _e(NOV, "食費", 1000), _e(NOV, "食費", -300)]
+    assert compare_months(rows, "2026-11") == [
+        CategoryDelta("食費", 1000, 1000, 0, 0.0)
+    ]
+
+
+def test_category_only_in_negative_rows_is_absent():
+    rows = [_e(NOV, "返金", -500)]
+    assert compare_months(rows, "2026-11") == []
+
+
+def test_new_category_has_none_pct():
+    rows = [_e(NOV, "娯楽", 800)]
+    assert compare_months(rows, "2026-11") == [CategoryDelta("娯楽", 0, 800, 800, None)]
+
+
+def test_zero_diff_is_included():
+    rows = [_e(OCT, "光熱費", 4000), _e(NOV, "光熱費", 4000)]
+    assert compare_months(rows, "2026-11") == [
+        CategoryDelta("光熱費", 4000, 4000, 0, 0.0)
+    ]
+
+
+def test_sorted_by_abs_diff_desc_then_category_asc():
+    rows = [
+        _e(OCT, "b", 1000),
+        _e(NOV, "b", 1000 - 300),  # diff -300
+        _e(OCT, "a", 100),
+        _e(NOV, "a", 100 + 300),  # diff +300 (tie with b)
+        _e(NOV, "c", 1000),  # diff +1000 (largest)
+    ]
+    names = [d.category for d in compare_months(rows, "2026-11")]
+    assert names == ["c", "a", "b"]
+
+
+def test_pct_is_not_rounded():
+    rows = [_e(OCT, "食費", 3000), _e(NOV, "食費", 4000)]
+    (d,) = compare_months(rows, "2026-11")
+    assert d.pct == pytest.approx(1000 / 3000 * 100)
+    assert isinstance(d.pct, float)
+
+
+def test_both_months_empty_returns_empty_list():
+    assert compare_months([], "2026-11") == []
+
+
+def test_format_report_empty():
+    assert format_report([]) == "対象なし"
+
+
+def test_format_report_marks_increase_decrease_unchanged_new():
+    deltas = [
+        CategoryDelta("食費", 30000, 36000, 6000, 20.0),
+        CategoryDelta("交通", 5000, 0, -5000, -100.0),
+        CategoryDelta("光熱費", 4000, 4000, 0, 0.0),
+        CategoryDelta("娯楽", 0, 800, 800, None),
+    ]
+    lines = format_report(deltas).split("\n")
+    assert len(lines) == 4
+    assert lines[0].startswith("食費:") and "+6000" in lines[0] and "+20.0%" in lines[0]
+    assert "-5000" in lines[1] and "-100.0%" in lines[1]
+    assert "±0" in lines[2]
+    assert "新規" in lines[3]
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
