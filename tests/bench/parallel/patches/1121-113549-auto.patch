@@ -0,0 +1,126 @@
+"""Detect recurring (monthly) expenses. Pure functions; no file I/O."""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from collections import Counter
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+# 末尾の数字(`#12`・`2026年11月`・`2026-11`・連番)を除くための規則
+_SUFFIX_RE = re.compile(r"(?:#\d+|\d{4}年\d{1,2}月|\d{4}-\d{1,2}|\d+)$")
+_SPACE_RE = re.compile(r"\s+")
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int  # 最新の金額(円)
+    count: int  # 連続した月の数
+    last_day: date
+    next_day: date
+
+
+def _memo_key(memo: str) -> str:
+    """D2: NFKC → 小文字化 → 空白除去 → 末尾の数字を除去。"""
+    s = unicodedata.normalize("NFKC", memo).lower()
+    s = _SPACE_RE.sub("", s)
+    while True:
+        t = _SUFFIX_RE.sub("", s)
+        if t == s:
+            return s
+        s = t
+
+
+def _check_number(name: str, value: object, *, is_int: bool) -> None:
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        raise TypeError(f"{name} は数値である必要があります")
+    if is_int and not isinstance(value, int):
+        raise TypeError(f"{name} は整数である必要があります")
+
+
+def _split_series(rows: list[Expense], tolerance: float) -> list[list[Expense]]:
+    """日付順に並んだ行を、金額が前行から tolerance(割合)以内で続く系列に分ける。"""
+    series: list[list[Expense]] = []
+    cur: list[Expense] = [rows[0]]
+    for e in rows[1:]:
+        prev = cur[-1].amount
+        if abs(e.amount - prev) <= tolerance * abs(prev):
+            cur.append(e)
+        else:
+            series.append(cur)
+            cur = [e]
+    series.append(cur)
+    return series
+
+
+def _next_day(base_day: int, last_ord: int) -> date:
+    """last_ord(year*12 + month-1)の翌月に、月末にクランプした base_day を当てる。"""
+    year, month0 = divmod(last_ord + 1, 12)
+    month = month0 + 1
+    days_in_month = calendar.monthrange(year, month)[1]
+    return date(year, month, min(base_day, days_in_month))
+
+
+def find_recurring(
+    rows: list[Expense],
+    *,
+    min_count: int = 3,
+    amount_tolerance: float = 0.0,
+) -> list[Recurring]:
+    _check_number("min_count", min_count, is_int=True)
+    if min_count < 2:
+        raise ValueError(f"min_count は 2 以上である必要があります: {min_count}")
+    _check_number("amount_tolerance", amount_tolerance, is_int=False)
+    if not 0 <= amount_tolerance < 1:
+        raise ValueError(
+            f"amount_tolerance は 0 以上 1 未満である必要があります: {amount_tolerance}"
+        )
+
+    # D1: 返金(負の金額)は検出の対象外
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        if e.amount < 0:
+            continue
+        groups.setdefault((e.category, _memo_key(e.memo)), []).append(e)
+
+    out: list[Recurring] = []
+    for (category, _key), members in groups.items():
+        members = sorted(members, key=lambda e: e.day)  # 同日は入力順を保つ
+        for series in _split_series(members, amount_tolerance):
+            # R2: 月ごとに最初の日を採用し、末尾の月から連続した月だけを数える
+            first_by_ord: dict[int, date] = {}
+            for e in series:
+                first_by_ord.setdefault(e.day.year * 12 + e.day.month - 1, e.day)
+            ords = sorted(first_by_ord)
+            run = [ords[-1]]
+            for o in reversed(ords[:-1]):
+                if o == run[-1] - 1:
+                    run.append(o)
+                else:
+                    break
+            if len(run) < min_count:
+                continue
+            run_days = [first_by_ord[o] for o in run]
+            # D3: 最頻の日(同数なら大きい日)を基準日にする
+            counts = Counter(d.day for d in run_days)
+            base_day = max(counts, key=lambda d: (counts[d], d))
+            last = series[-1]
+            out.append(
+                Recurring(
+                    category=category,
+                    memo=last.memo,
+                    amount=last.amount,
+                    count=len(run),
+                    last_day=last.day,
+                    next_day=_next_day(base_day, run[0]),
+                )
+            )
+
+    out.sort(key=lambda r: (r.next_day, r.category, r.memo))
+    return out
