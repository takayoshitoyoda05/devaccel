@@ -0,0 +1,131 @@
+"""Condition-based search over Expense rows (pure functions)."""
+
+from __future__ import annotations
+
+import unicodedata
+from dataclasses import dataclass
+from datetime import date, datetime
+
+from kakeibo.core import Expense
+
+
+def _norm(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).casefold()
+
+
+def _check_int(value: object, name: str) -> None:
+    if value is None:
+        return
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{name} は int である必要があります")
+
+
+def _check_date(value: object, name: str) -> None:
+    if value is None:
+        return
+    if not isinstance(value, date) or isinstance(value, datetime):
+        raise TypeError(f"{name} は date である必要があります")
+
+
+def _check_str(value: object, name: str) -> None:
+    if value is not None and not isinstance(value, str):
+        raise TypeError(f"{name} は str である必要があります")
+
+
+@dataclass(frozen=True)
+class Cond:
+    """Matches when every specified field matches (AND). ``Cond()`` matches everything."""
+
+    category: str | None = None
+    min_amount: int | None = None
+    max_amount: int | None = None
+    memo_contains: str | None = None
+    start: date | None = None
+    end: date | None = None
+
+    def __post_init__(self) -> None:
+        _check_str(self.category, "category")
+        _check_str(self.memo_contains, "memo_contains")
+        _check_int(self.min_amount, "min_amount")
+        _check_int(self.max_amount, "max_amount")
+        _check_date(self.start, "start")
+        _check_date(self.end, "end")
+        if (
+            self.min_amount is not None
+            and self.max_amount is not None
+            and self.min_amount > self.max_amount
+        ):
+            raise ValueError("min_amount は max_amount 以下である必要があります")
+        if self.start is not None and self.end is not None and self.start > self.end:
+            raise ValueError("start は end 以下である必要があります")
+
+
+@dataclass(frozen=True, init=False)
+class And:
+    queries: tuple[Query, ...]
+
+    def __init__(self, *queries: Query) -> None:
+        object.__setattr__(self, "queries", tuple(queries))
+
+
+@dataclass(frozen=True, init=False)
+class Or:
+    queries: tuple[Query, ...]
+
+    def __init__(self, *queries: Query) -> None:
+        object.__setattr__(self, "queries", tuple(queries))
+
+
+@dataclass(frozen=True)
+class Not:
+    query: Query
+
+
+Query = Cond | And | Or | Not
+
+
+def _check_query(q: object) -> None:
+    if isinstance(q, Cond):
+        return
+    if isinstance(q, (And, Or)):
+        for sub in q.queries:
+            _check_query(sub)
+        return
+    if isinstance(q, Not):
+        _check_query(q.query)
+        return
+    raise TypeError(f"未知のクエリ型です: {type(q).__name__}")
+
+
+def _cond_matches(e: Expense, c: Cond) -> bool:
+    if c.category is not None and _norm(e.category) != _norm(c.category):
+        return False
+    if c.min_amount is not None and e.amount < c.min_amount:
+        return False
+    if c.max_amount is not None and e.amount > c.max_amount:
+        return False
+    if c.memo_contains is not None and _norm(c.memo_contains) not in _norm(e.memo):
+        return False
+    if c.start is not None and e.day < c.start:
+        return False
+    return c.end is None or e.day <= c.end
+
+
+def _matches(e: Expense, q: Query) -> bool:
+    if isinstance(q, Cond):
+        return _cond_matches(e, q)
+    if isinstance(q, And):
+        return all(_matches(e, sub) for sub in q.queries)
+    if isinstance(q, Or):
+        return any(_matches(e, sub) for sub in q.queries)
+    return not _matches(e, q.query)
+
+
+def matches(e: Expense, query: Query) -> bool:
+    _check_query(query)
+    return _matches(e, query)
+
+
+def search(rows: list[Expense], query: Query) -> list[Expense]:
+    _check_query(query)
+    return [e for e in rows if _matches(e, query)]
