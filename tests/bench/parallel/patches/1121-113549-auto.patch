+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.importer import ImportResult, RowError, import_csv
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param(
+            '利用日,ご利用店名,利用金額\n2026/1/5,ＡＢＣ店,"1,234円"\n',
+            ImportResult([Expense(date(2026, 1, 5), "未分類", 1234, "ABC店")], []),
+            id="E2-1",
+        ),
+        pytest.param(
+            "日付,出金,入金\n2026-01-05,,3000\n",
+            ImportResult([Expense(date(2026, 1, 5), "未分類", -3000, "")], []),
+            id="E2-3",
+        ),
+    ],
+)
+def test_example_table(text: str, expected: ImportResult) -> None:
+    assert import_csv(text) == expected
+
+
+def test_E2_2_invalid_date_and_amount_are_both_reported() -> None:
+    result = import_csv("日付,金額\n2026/2/30,abc\n")
+    assert result.expenses == []
+    assert [(e.line, e.column, e.value) for e in result.errors] == [
+        (2, "日付", "2026/2/30"),
+        (2, "金額", "abc"),
+    ]
+
+
+def test_tab_delimiter_is_detected() -> None:
+    result = import_csv("日付\t金額\t摘要\n2026-01-05\t100\tcafe\n")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "cafe")]
+
+
+def test_bom_and_newline_variants_are_accepted() -> None:
+    body = "日付,金額\n2026-01-05,100\n2026-01-06,200\n"
+    for text in (
+        "﻿" + body,
+        body.replace("\n", "\r\n"),
+        body.replace("\n", "\r"),
+    ):
+        assert [e.amount for e in import_csv(text).expenses] == [100, 200]
+
+
+def test_error_line_is_record_start_for_quoted_newline() -> None:
+    text = '日付,金額,摘要\n2026-01-05,100,"a\nb"\n2026-01-06,abc,x\n'
+    result = import_csv(text)
+    assert [(e.line, e.column) for e in result.errors] == [(4, "金額")]
+    assert [e.amount for e in result.expenses] == [100]
+
+
+def test_missing_date_column_reports_line1_only() -> None:
+    assert import_csv("金額\n100\n") == ImportResult(
+        [], [RowError(1, "日付", "", "必須列がありません")]
+    )
+
+
+def test_missing_amount_column_reports_line1_only() -> None:
+    assert import_csv("日付,摘要\n2026-01-05,x\n") == ImportResult(
+        [], [RowError(1, "金額", "", "必須列がありません")]
+    )
+
+
+@pytest.mark.parametrize("text", ["", "日付,金額\n", "日付,金額"])
+def test_empty_or_header_only_input(text: str) -> None:
+    assert import_csv(text) == ImportResult([], [])
+
+
+def test_ragged_and_blank_rows() -> None:
+    text = "日付,金額\n2026-01-05,100\n\n2026-01-06\n2026-01-07,300,extra\n"
+    result = import_csv(text)
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+    assert [(e.line, e.column) for e in result.errors] == [(4, "(行)"), (5, "(行)")]
+
+
+def test_category_column_and_memo_aliases() -> None:
+    result = import_csv("年月日,金額,費目,備考\n2026-01-05,100,食費,昼\n")
+    assert result.expenses == [Expense(date(2026, 1, 5), "食費", 100, "昼")]
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026.1.5",
+        "2026年1月5日",
+        "20260105",
+        "２０２６－０１－０５",
+        "2026-01-05 12:30",
+    ],
+)
+def test_date_forms(raw: str) -> None:
+    assert import_csv(f"日付,金額\n{raw},100\n").expenses[0].day == date(2026, 1, 5)
+
+
+@pytest.mark.parametrize("raw", ["2026-02-30", "2026/13/1", ""])
+def test_invalid_date_is_row_error(raw: str) -> None:
+    result = import_csv(f"日付,金額\n{raw},100\n")
+    assert result.expenses == []
+    assert [(e.line, e.column) for e in result.errors] == [(2, "日付")]
+
+
+@pytest.mark.parametrize(
+    ("raw", "amount"),
+    [
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("¥1,000", 1000),
+        ("￥1，000", 1000),
+        ("1000円", 1000),
+        ("1000JPY", 1000),
+        ("１　０００", 1000),
+    ],
+)
+def test_amount_forms(raw: str, amount: int) -> None:
+    assert import_csv(f'日付,金額\n2026-01-05,"{raw}"\n').expenses[0].amount == amount
+
+
+@pytest.mark.parametrize("raw", ["12.5", "", "-", "—"])
+def test_invalid_amount_is_row_error(raw: str) -> None:
+    result = import_csv(f"日付,金額\n2026-01-05,{raw}\n")
+    assert result.expenses == []
+    assert [(e.line, e.column) for e in result.errors] == [(2, "金額")]
+
+
+def test_two_columns_both_empty_is_error() -> None:
+    result = import_csv("日付,出金,入金\n2026-01-05,,\n")
+    assert result.expenses == []
+    assert [e.column for e in result.errors] == ["出金/入金"]
+
+
+def test_two_columns_withdrawal_is_positive() -> None:
+    result = import_csv("日付,出金,入金\n2026-01-05,500,\n")
+    assert [e.amount for e in result.expenses] == [500]
+
+
+def test_good_rows_are_kept_next_to_bad_rows() -> None:
+    text = "日付,金額\n2026-01-05,100\n2026-01-06,abc\n2026-01-07,300\n"
+    result = import_csv(text)
+    assert [e.amount for e in result.expenses] == [100, 300]
+    assert [(e.line, e.column) for e in result.errors] == [(3, "金額")]
