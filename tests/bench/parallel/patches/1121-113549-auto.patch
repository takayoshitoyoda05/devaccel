+++ b/tests/test_recurring.py
@@ -0,0 +1,161 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring
+
+
+def _e(day: str, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+@pytest.mark.parametrize(
+    ("case_id", "rows", "expected_next"),
+    [
+        # E1-1: 家賃 80000 を 9/27・10/27・11/27 → 次回 12/27
+        (
+            "E1-1",
+            [
+                _e("2026-09-27", "家賃", 80000, "家賃"),
+                _e("2026-10-27", "家賃", 80000, "家賃"),
+                _e("2026-11-27", "家賃", 80000, "家賃"),
+            ],
+            date(2026, 12, 27),
+        ),
+        # E1-2: サブスク 1/31・2/28・3/31 → 次回 4/30(D3 月末クランプ)
+        (
+            "E1-2",
+            [
+                _e("2026-01-31", "通信", 1000, "サブスク"),
+                _e("2026-02-28", "通信", 1000, "サブスク"),
+                _e("2026-03-31", "通信", 1000, "サブスク"),
+            ],
+            date(2026, 4, 30),
+        ),
+    ],
+    ids=["E1-1", "E1-2"],
+)
+def test_recurring_next_day(case_id, rows, expected_next):
+    result = find_recurring(rows)
+    assert len(result) == 1, case_id
+    assert result[0].next_day == expected_next, case_id
+
+
+def test_E1_3_min_count_bool_is_type_error():
+    # E1-3: min_count=True → TypeError
+    with pytest.raises(TypeError):
+        find_recurring([], min_count=True)
+
+
+# --- 規則に沿った追加の確認 ---
+
+
+def test_result_fields_and_latest_amount():
+    rows = [
+        _e("2026-09-05", "家賃", 80000, "家賃"),
+        _e("2026-10-05", "家賃", 80500, "家賃"),
+        _e("2026-11-05", "家賃", 81000, "家賃"),
+    ]
+    result = find_recurring(rows, amount_tolerance=0.02)
+    assert result == [
+        Recurring(
+            category="家賃",
+            memo="家賃",
+            amount=81000,
+            count=3,
+            last_day=date(2026, 11, 5),
+            next_day=date(2026, 12, 5),
+        )
+    ]
+
+
+def test_tolerance_zero_splits_changed_amounts():
+    rows = [
+        _e("2026-09-05", "家賃", 80000, "家賃"),
+        _e("2026-10-05", "家賃", 80500, "家賃"),
+        _e("2026-11-05", "家賃", 81000, "家賃"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_same_month_counts_once_with_first_day():
+    rows = [
+        _e("2026-09-10", "食費", 500, "x"),
+        _e("2026-09-20", "食費", 500, "x"),
+        _e("2026-10-10", "食費", 500, "x"),
+    ]
+    assert find_recurring(rows, min_count=2)[0].count == 2
+
+
+def test_month_gap_is_not_detected():
+    rows = [
+        _e("2026-08-27", "家賃", 80000, "家賃"),
+        _e("2026-09-27", "家賃", 80000, "家賃"),
+        _e("2026-11-27", "家賃", 80000, "家賃"),
+    ]
+    assert find_recurring(rows, min_count=2) == []
+
+
+def test_refund_negative_amount_is_ignored():
+    rows = [
+        _e("2026-09-27", "家賃", 80000, "家賃"),
+        _e("2026-10-27", "家賃", -80000, "家賃"),
+        _e("2026-10-28", "家賃", 80000, "家賃"),
+        _e("2026-11-27", "家賃", 80000, "家賃"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].count == 3
+
+
+def test_memo_key_ignores_case_space_and_trailing_number():
+    rows = [
+        _e("2026-09-01", "雑誌", 300, "Magazine #1"),
+        _e("2026-10-01", "雑誌", 300, "ｍａｇａｚｉｎｅ #2"),
+        _e("2026-11-01", "雑誌", 300, "MAGAZINE 2026年11月"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].count == 3
+
+
+def test_sorted_by_next_day_then_category_then_memo():
+    rows = [
+        _e("2026-09-15", "B", 100, "m"),
+        _e("2026-10-15", "B", 100, "m"),
+        _e("2026-11-15", "B", 100, "m"),
+        _e("2026-09-10", "A", 200, "m"),
+        _e("2026-10-10", "A", 200, "m"),
+        _e("2026-11-10", "A", 200, "m"),
+    ]
+    result = find_recurring(rows)
+    assert [(r.category, r.next_day) for r in result] == [
+        ("A", date(2026, 12, 10)),
+        ("B", date(2026, 12, 15)),
+    ]
+
+
+def test_empty_input_returns_empty_list():
+    assert find_recurring([]) == []
+
+
+@pytest.mark.parametrize("value", [1, 0])
+def test_min_count_below_two_is_value_error(value):
+    with pytest.raises(ValueError, match="min_count"):
+        find_recurring([], min_count=value)
+
+
+@pytest.mark.parametrize("value", [-0.1, 1.0])
+def test_tolerance_out_of_range_is_value_error(value):
+    with pytest.raises(ValueError, match="amount_tolerance"):
+        find_recurring([], amount_tolerance=value)
+
+
+def test_tolerance_bool_is_type_error():
