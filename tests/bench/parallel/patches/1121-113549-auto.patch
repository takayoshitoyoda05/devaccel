@@ -0,0 +1,129 @@
+from __future__ import annotations
+
+from datetime import date, datetime
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import And, Cond, Not, Or, matches, search
+
+
+def _e(day: date, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+ROWS = [
+    _e(date(2026, 1, 3), "食費", 5000),  # 0
+    _e(date(2026, 1, 5), "交通", 20000),  # 1
+    _e(date(2026, 1, 9), "食費", 300),  # 2
+    _e(date(2026, 2, 1), "娯楽", 12000),  # 3
+    _e(date(2026, 2, 2), "日用品", 499),  # 4
+    _e(date(2026, 2, 3), "日用品", 500),  # 5
+    _e(date(2026, 2, 4), "日用品", 501),  # 6
+]
+
+
+# E3-1: Or(Cond(category="食費"), Cond(min_amount=10000)) -> どちらかに合う行だけ、元の順
+def test_e3_1_or_keeps_original_order() -> None:
+    q = Or(Cond(category="食費"), Cond(min_amount=10000))
+    assert search(ROWS, q) == [ROWS[0], ROWS[1], ROWS[2], ROWS[3]]
+
+
+# E3-2: Cond(min_amount=500, max_amount=500) -> 500 円ちょうどの行が一致
+def test_e3_2_amount_bounds_are_inclusive() -> None:
+    assert search(ROWS, Cond(min_amount=500, max_amount=500)) == [ROWS[5]]
+
+
+# E3-3: Cond(min_amount=900, max_amount=100) -> ValueError
+def test_e3_3_reversed_amount_range_raises() -> None:
+    with pytest.raises(ValueError, match="min_amount"):
+        Cond(min_amount=900, max_amount=100)
+
+
+# R1: 指定した項目すべての AND。Cond() は真。
+def test_r1_empty_cond_matches_everything() -> None:
+    assert search(ROWS, Cond()) == ROWS
+
+
+def test_r1_multiple_fields_are_anded() -> None:
+    q = Cond(category="食費", max_amount=1000)
+    assert search(ROWS, q) == [ROWS[2]]
+
+
+def test_r1_category_is_nfkc_and_case_insensitive_exact() -> None:
+    rows = [_e(date(2026, 1, 1), "ＡＢＣ", 1), _e(date(2026, 1, 1), "abcd", 1)]
+    assert search(rows, Cond(category="abc")) == [rows[0]]
+
+
+def test_r1_memo_contains_is_nfkc_casefold_substring() -> None:
+    rows = [
+        _e(date(2026, 1, 1), "x", 1, "ＬＵＮＣＨ代"),
+        _e(date(2026, 1, 1), "x", 1, "dinner"),
+    ]
+    assert search(rows, Cond(memo_contains="lunch")) == [rows[0]]
+
+
+def test_r1_empty_memo_contains_always_matches() -> None:
+    rows = [_e(date(2026, 1, 1), "x", 1, ""), _e(date(2026, 1, 1), "x", 1, "a")]
+    assert search(rows, Cond(memo_contains="")) == rows
+
+
+def test_r1_period_bounds_are_inclusive() -> None:
+    q = Cond(start=date(2026, 1, 5), end=date(2026, 2, 1))
+    assert search(ROWS, q) == [ROWS[1], ROWS[2], ROWS[3]]
+
+
+# D4: 逆順は ValueError
+def test_d4_reversed_period_raises() -> None:
+    with pytest.raises(ValueError, match="start"):
+        Cond(start=date(2026, 2, 1), end=date(2026, 1, 1))
+
+
+# R2 / D5: 空の And は真、空の Or は偽、入れ子可能
+def test_d5_empty_and_is_true_and_empty_or_is_false() -> None:
+    assert search(ROWS, And()) == ROWS
+    assert search(ROWS, Or()) == []
+
+
+def test_r2_not_and_nesting() -> None:
+    q = And(
+        Not(Cond(category="食費")), Or(Cond(min_amount=10000), Cond(max_amount=499))
+    )
+    assert search(ROWS, q) == [ROWS[1], ROWS[3], ROWS[4]]
+
+
+def test_matches_single_row() -> None:
+    assert matches(ROWS[0], Cond(category="食費")) is True
+    assert matches(ROWS[1], Cond(category="食費")) is False
+
+
+# R3: 型違反
+def test_r3_bool_amount_raises_type_error() -> None:
+    with pytest.raises(TypeError, match="min_amount"):
+        Cond(min_amount=True)
+    with pytest.raises(TypeError, match="max_amount"):
+        Cond(max_amount=1.0)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad", ["2026-01-01", datetime(2026, 1, 1)])
+def test_r3_non_date_period_raises_type_error(bad: object) -> None:
+    with pytest.raises(TypeError, match="start"):
+        Cond(start=bad)  # type: ignore[arg-type]
+    with pytest.raises(TypeError, match="end"):
+        Cond(end=bad)  # type: ignore[arg-type]
+
+
+def test_r3_unknown_query_type_raises_type_error() -> None:
+    with pytest.raises(TypeError):
+        search(ROWS, "食費")  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        search([], Or(42))  # type: ignore[arg-type]
+
+
+# R4: 入力を変更せず、新しい list を返す
+def test_r4_returns_new_list_and_does_not_mutate_input() -> None:
+    rows = list(ROWS)
+    result = search(rows, Cond(category="日用品"))
+    assert result == [ROWS[4], ROWS[5], ROWS[6]]
+    assert result is not rows
+    assert rows == ROWS
