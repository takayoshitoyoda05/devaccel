diff --git a/tests/test_types/test_FloatRange.py b/tests/test_types/test_FloatRange.py
index 53fd429..bd6054f 100644
--- a/tests/test_types/test_FloatRange.py
+++ b/tests/test_types/test_FloatRange.py
@@ -31,6 +31,21 @@ def test_range_fail(type, value, expect):
     assert expect in exc_info.value.message
 
 
+@pytest.mark.parametrize(
+    ("type", "expect"),
+    [
+        (click.FloatRange(1.5), "x>=1.5"),
+        (click.FloatRange(1.5, min_open=True), "x>1.5"),
+        (click.FloatRange(max=2.5), "x<=2.5"),
+        (click.FloatRange(max=2.5, max_open=True), "x<2.5"),
+        (click.FloatRange(0.5, 1.5), "0.5<=x<=1.5"),
+        (click.FloatRange(0.5, 1.5, min_open=True, max_open=True), "0.5<x<1.5"),
+    ],
+)
+def test_describe_range(type, expect):
+    assert type._describe_range() == expect
+
+
 def test_float_range_no_clamp_open():
     with pytest.raises(TypeError):
         click.FloatRange(0, 1, max_open=True, clamp=True)
