+def test_results_sorted_by_category_then_amount_then_first_day() -> None:
+    rows: list[Expense] = []
+    # 保険 / 500 with a later series starting 2026-02
+    for d in (date(2026, 2, 1), date(2026, 3, 1), date(2026, 4, 1)):
+        rows.append(e(d, category="保険", amount=500))
+    # 通信 / 2000
+    for d in (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)):
+        rows.append(e(d, category="通信", amount=2000))
+    # 通信 / 1000 (amount smaller -> comes before 2000)
+    for d in (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)):
+        rows.append(e(d, category="通信", amount=1000))
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [
+        ("保険", 500),
+        ("通信", 1000),
+        ("通信", 2000),
+    ]
+
