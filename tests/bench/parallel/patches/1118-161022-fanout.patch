+def test_short_run_after_break_is_dropped_but_long_run_kept() -> None:
+    rows = [
+        e(date(2026, 1, 10)),
+        e(date(2026, 2, 10)),
+        e(date(2026, 5, 10)),
+        e(date(2026, 6, 10)),
+        e(date(2026, 7, 10)),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days[0] == date(2026, 5, 10)
