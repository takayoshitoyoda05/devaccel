+def test_month_end_series_connects_and_next_expected_clamped() -> None:
+    # 1/31 -> 2/28 (clamped) -> 3/31 (3 days from 3/28, within tolerance)
+    rows = [e(date(2026, 1, 31)), e(date(2026, 2, 28)), e(date(2026, 3, 31))]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 30)
