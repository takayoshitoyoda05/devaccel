+def test_break_splits_into_separate_runs() -> None:
+    rows = [
+        e(date(2026, 1, 10)),
+        e(date(2026, 2, 10)),
+        e(date(2026, 3, 10)),
+        # gap: 4/10 missing, 5/10 is 2 months after 3/10 -> break
+        e(date(2026, 5, 10)),
+        e(date(2026, 6, 10)),
+        e(date(2026, 7, 10)),
+    ]
+    result = find_recurring(rows)
+    assert [r.days for r in result] == [
+        (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10)),
+        (date(2026, 5, 10), date(2026, 6, 10), date(2026, 7, 10)),
+    ]
+    assert [r.next_expected for r in result] == [date(2026, 4, 10), date(2026, 8, 10)]
+
