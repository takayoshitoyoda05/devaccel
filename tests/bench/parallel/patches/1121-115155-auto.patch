new file mode 100644
index 0000000..e45c8f5
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,128 @@
+"""Detect recurring expenses (subscriptions, rent, gym fees) from the detail rows."""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+from fractions import Fraction
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo_key: str
+    amount: int  # yen, amount of the latest occurrence in the run
+    months: tuple[str, ...]  # "YYYY-MM", ascending
+    day_of_month: int
+    next_due: date
+
+
+def next_due(r: Recurring) -> date:
+    return r.next_due
+
+
+def _norm(s: str) -> str:
+    """D2: NFKC, case-insensitive, surrounding whitespace removed."""
+    return unicodedata.normalize("NFKC", s).strip().casefold()
+
+
+# Trailing counters such as " 2026-01", " 3月", " #5", " No.5" (after NFKC + casefold).
+_TRAILING_NUMBER = re.compile(r"(?:(?:\s*#|\s*(?<!\w)no\.?)\s*|\s*)\d+(?:[-/]\d+)*月?$")
+
+
+def _memo_key(memo: str) -> str:
+    s = re.sub(r"\s+", " ", _norm(memo))
+    while True:
+        t = _TRAILING_NUMBER.sub("", s).rstrip()
+        if t == s:
+            break
+        s = t
+    return s.strip()
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + (d.month - 1)
+
+
+def _month_label(idx: int) -> str:
+    return f"{idx // 12:04d}-{idx % 12 + 1:02d}"
+
+
+def _drop_outliers(items: list[Expense]) -> list[Expense]:
+    """R2: drop amounts more than 10 % away from the series median (exact arithmetic)."""
+    amounts = sorted(e.amount for e in items)
+    n = len(amounts)
+    if n % 2:
+        med = Fraction(amounts[n // 2])
+    else:
+        med = Fraction(amounts[n // 2 - 1] + amounts[n // 2], 2)
+    return [e for e in items if abs(e.amount - med) * 10 <= med]
+
+
+def _detect(
+    items: list[Expense], memo_key: str, min_occurrences: int
+) -> Recurring | None:
+    # R3: one occurrence per month, the last one (stable sort keeps input order on ties).
+    chosen: dict[int, Expense] = {}
+    for e in sorted(items, key=lambda e: e.day):
+        chosen[_month_index(e.day)] = e
+
+    idxs = sorted(chosen)
+    run = [idxs[-1]]
+    for i in reversed(idxs[:-1]):
+        if run[0] - i == 1:
+            run.insert(0, i)
+        else:
+            break
+    if len(run) < min_occurrences:
+        return None
+
+    last = chosen[run[-1]]
+    day_of_month = max(chosen[i].day.day for i in run)  # R4
+    nxt = run[-1] + 1  # R5: month after the last month of the run
+    year, month = nxt // 12, nxt % 12 + 1
+    last_day = calendar.monthrange(year, month)[1]
+    return Recurring(
+        category=last.category,
+        memo_key=memo_key,
+        amount=last.amount,
+        months=tuple(_month_label(i) for i in run),
+        day_of_month=day_of_month,
+        next_due=date(year, month, min(day_of_month, last_day)),
+    )
+
+
+def find_recurring(rows: list[Expense], *, min_occurrences: int = 3) -> list[Recurring]:
+    if type(min_occurrences) is not int:  # exact int: rejects bool too
+        raise ValueError(
+            f"min_occurrences は整数である必要があります: {min_occurrences!r}"
+        )
+    if min_occurrences < 2:
+        raise ValueError(
+            f"min_occurrences は 2 以上である必要があります: {min_occurrences}"
+        )
+
+    series: dict[tuple[str, str, int | None], list[Expense]] = {}
+    for e in rows:
+        if e.amount <= 0:  # R2: refunds and zero amounts are not recurring
+            continue
+        cat = _norm(e.category)
+        mk = _memo_key(e.memo)
+        # R1: without a memo, the series is identified by (category, amount).
+        key = (cat, mk, None) if mk else (cat, "", e.amount)
+        series.setdefault(key, []).append(e)
+
+    out: list[Recurring] = []
+    for (_cat, mk, _amt), items in series.items():
+        found = _detect(_drop_outliers(items), mk, min_occurrences)
+        if found is not None:
+            out.append(found)
+    out.sort(
+        key=lambda r: (r.next_due, r.category, r.memo_key, r.months, r.amount)
+    )  # D4
+    return out
diff --git a/src/kakeibo/search.py b/src/kakeibo/search.py
new file mode 100644
index 0000000..f129d62
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,123 @@
+"""Condition-based search over Expense records (pure functions)."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Iterable, Mapping
+from datetime import date, datetime
+
+from kakeibo.core import Expense
+
+_LEAF_KEYS = frozenset(
+    {"category", "min_amount", "max_amount", "memo_contains", "date_from", "date_to"}
+)
+_COMBINATOR_KEYS = frozenset({"and", "or", "not"})
+
+
+def _norm(s: str) -> str:
+    """D2: NFKC normalize, ignore case, strip surrounding whitespace."""
+    return unicodedata.normalize("NFKC", s).casefold().strip()
+
+
+def _check_int(value: object, key: str) -> int:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise ValueError(f"{key} は整数である必要があります: {value!r}")  # noqa: TRY004  # 型違いも ValueError(仕様)
+    return value
+
+
+def _check_date(value: object, key: str) -> date:
+    if not isinstance(value, date) or isinstance(value, datetime):
+        raise ValueError(f"{key} は datetime.date である必要があります: {value!r}")  # noqa: TRY004  # 型違いも ValueError(仕様)
+    return value
+
+
+def _validate(cond: object, where: str) -> None:
+    """R3: reject malformed conditions before any evaluation."""
+    if not isinstance(cond, Mapping):
+        raise ValueError(f"{where} は dict である必要があります: {cond!r}")  # noqa: TRY004  # 型違いも ValueError(仕様)
+    for key, value in cond.items():
+        if key in _COMBINATOR_KEYS:
+            if key == "not":
+                _validate(value, f"{where}.not")
+            else:
+                if not isinstance(value, list):
+                    raise ValueError(f"{where}.{key} はリストである必要があります")
+                for i, sub in enumerate(value):
+                    _validate(sub, f"{where}.{key}[{i}]")
+        elif key in _LEAF_KEYS:
+            _check_leaf(key, value, where)
+        else:
+            raise ValueError(f"未知の条件キーです: {key!r} ({where})")
+    if "min_amount" in cond and "max_amount" in cond:
+        lo = _check_int(cond["min_amount"], "min_amount")
+        hi = _check_int(cond["max_amount"], "max_amount")
+        if lo > hi:
+            raise ValueError(f"min_amount({lo}) > max_amount({hi}) ({where})")
+    if "date_from" in cond and "date_to" in cond:
+        lo_d = _check_date(cond["date_from"], "date_from")
+        hi_d = _check_date(cond["date_to"], "date_to")
+        if lo_d > hi_d:
+            raise ValueError(f"date_from({lo_d}) > date_to({hi_d}) ({where})")
+
+
+def _check_leaf(key: str, value: object, where: str) -> None:
+    if key == "category":
+        if isinstance(value, str):
+            return
+        if isinstance(value, list) and all(isinstance(v, str) for v in value):
+            return
+        raise ValueError(
+            f"category は文字列または文字列のリストである必要があります ({where})"
+        )
+    if key == "memo_contains":
+        if not isinstance(value, str):
+            raise ValueError(f"memo_contains は文字列である必要があります ({where})")
+    elif key in ("min_amount", "max_amount"):
+        _check_int(value, key)
+    else:  # date_from / date_to
+        _check_date(value, key)
+
+
+def _eval(e: Expense, cond: Mapping[str, object]) -> bool:
+    # All keys in one dict are ANDed; an empty dict is true.
+    for key, value in cond.items():
+        if key == "and":
+            assert isinstance(value, list)
+            ok = all(_eval(e, sub) for sub in value)  # type: ignore[arg-type]
+        elif key == "or":
+            assert isinstance(value, list)
+            ok = any(_eval(e, sub) for sub in value)  # type: ignore[arg-type]
+        elif key == "not":
+            ok = not _eval(e, value)  # type: ignore[arg-type]
+        elif key == "category":
+            cats = [value] if isinstance(value, str) else value
+            assert isinstance(cats, list)
+            target = _norm(e.category)
+            ok = any(target == _norm(c) for c in cats)  # type: ignore[union-attr]
+        elif key == "min_amount":
+            ok = e.amount >= value  # type: ignore[operator]
+        elif key == "max_amount":
+            ok = e.amount <= value  # type: ignore[operator]
+        elif key == "memo_contains":
+            ok = _norm(str(value)) in _norm(e.memo)
+        elif key == "date_from":
+            ok = e.day >= value  # type: ignore[operator]
+        elif key == "date_to":
+            ok = e.day <= value  # type: ignore[operator]
+        else:  # pragma: no cover - rejected by _validate
+            raise ValueError(f"未知の条件キーです: {key!r}")
+        if not ok:
+            return False
+    return True
+
+
+def matches(e: Expense, cond: Mapping[str, object]) -> bool:
+    """Return True if ``e`` satisfies the condition ``cond``."""
+    _validate(cond, "cond")
+    return _eval(e, cond)
+
+
+def search(rows: Iterable[Expense], cond: Mapping[str, object]) -> list[Expense]:
+    """Return the rows matching ``cond``, preserving input order."""
+    _validate(cond, "cond")
+    return [e for e in rows if _eval(e, cond)]
