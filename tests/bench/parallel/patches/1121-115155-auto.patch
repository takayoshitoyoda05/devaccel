+"""Month-over-month category comparison (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense, monthly_totals
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(value: object, name: str) -> str:
+    if not isinstance(value, str) or not _MONTH_RE.fullmatch(value):
+        raise ValueError(f"{name} は YYYY-MM 形式である必要があります: {value!r}")
+    return value
+
+
+def _previous_month(month: str) -> str:
+    year, mon = int(month[:4]), int(month[5:])
+    if mon == 1:
+        year, mon = year - 1, 12
+    else:
+        mon -= 1
+    if year < 1:
+        raise ValueError(f"month の前月が存在しません: {month!r}")
+    return f"{year:04d}-{mon:02d}"
+
+
+def _status(previous: int, current: int, delta: int) -> str:
+    if previous == 0 and current != 0:
+        return "new"
+    if current == 0 and previous != 0:
+        return "gone"
+    if delta > 0:
+        return "up"
+    if delta < 0:
+        return "down"
+    return "same"
+
+
+def compare_months(
+    rows: list[Expense], month: str, *, prev: str | None = None
+) -> list[CategoryChange]:
+    """Compare category totals of `month` against `prev` (default: calendar previous month)."""
+    _check_month(month, "month")
+    if prev is None:
+        prev = _previous_month(month)
+    else:
+        _check_month(prev, "prev")
+    if prev == month:
+        raise ValueError(f"prev と month が同じです: {month!r}")
+
+    totals = monthly_totals(rows)
+    before = totals.get(prev, {})
+    after = totals.get(month, {})
+
+    changes: list[CategoryChange] = []
+    for cat in set(before) | set(after):
+        previous = before.get(cat, 0)
+        current = after.get(cat, 0)
+        delta = current - previous
+        pct = None if previous == 0 else delta / abs(previous) * 100
+        changes.append(
+            CategoryChange(
+                cat, previous, current, delta, pct, _status(previous, current, delta)
+            )
+        )
+    changes.sort(key=lambda c: (-abs(c.delta), c.category))
+    return changes
+
+
+def _format_line(c: CategoryChange) -> str:
+    head = f"{c.category}: {c.previous:,} → {c.current:,}"
+    if c.status == "new":
+        return f"{head} ({c.delta:+,}, 新規)"
+    if c.status == "gone":
+        return f"{head} ({c.delta:+,}, 解消)"
+    if c.status == "same":
+        return f"{head} (±0)"
+    assert c.pct is not None
+    return f"{head} ({c.delta:+,}, {c.pct:+.1f}%)"
+
+
+def format_report(changes: list[CategoryChange]) -> str:
+    if not changes:
+        return "変化なし"
+    return "\n".join(_format_line(c) for c in changes)
