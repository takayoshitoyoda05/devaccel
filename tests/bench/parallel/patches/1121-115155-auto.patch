+from datetime import date
+
+import pytest
+
+from kakeibo.compare import CategoryChange, compare_months, format_report
+from kakeibo.core import Expense
+
+
+def _e(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+@pytest.mark.parametrize(
+    ("rows", "month", "kwargs", "expected"),
+    [
+        pytest.param(
+            [_e("2026-02-10", "食費", 30000), _e("2026-03-05", "食費", 45000)],
+            "2026-03",
+            {},
+            [CategoryChange("食費", 30000, 45000, 15000, 50.0, "up")],
+            id="E4-1",
+        ),
+        pytest.param(
+            [_e("2026-02-10", "食費", 1000), _e("2026-03-05", "交通費", 8000)],
+            "2026-03",
+            {},
+            [
+                CategoryChange("交通費", 0, 8000, 8000, None, "new"),
+                CategoryChange("食費", 1000, 0, -1000, -100.0, "gone"),
+            ],
+            id="E4-2",
+        ),
+        pytest.param(
+            [_e("2025-12-20", "食費", 20000), _e("2026-01-03", "食費", 25000)],
+            "2026-01",
+            {},
+            [CategoryChange("食費", 20000, 25000, 5000, 25.0, "up")],
+            id="E4-3",
+        ),
+    ],
+)
+def test_compare_months_examples(rows, month, kwargs, expected) -> None:
+    assert compare_months(rows, month, **kwargs) == expected
+
+
+def test_default_prev_wraps_year() -> None:
+    rows = [_e("2025-12-01", "食費", 100), _e("2026-01-01", "食費", 100)]
+    assert compare_months(rows, "2026-01") == [
+        CategoryChange("食費", 100, 100, 0, 0.0, "same")
+    ]
+
+
+def test_explicit_prev_used() -> None:
+    rows = [
+        _e("2026-01-01", "食費", 10),
+        _e("2026-02-01", "食費", 99),
+        _e("2026-03-01", "食費", 30),
+    ]
+    assert compare_months(rows, "2026-03", prev="2026-01") == [
+        CategoryChange("食費", 10, 30, 20, 200.0, "up")
+    ]
+
+
+def test_empty_month_treated_as_zero_d5() -> None:
+    rows = [_e("2026-02-01", "食費", 500)]
+    assert compare_months(rows, "2026-03") == [
+        CategoryChange("食費", 500, 0, -500, -100.0, "gone")
+    ]
+
+
+def test_both_months_empty_returns_empty() -> None:
+    assert compare_months([], "2026-03") == []
+
+
+def test_same_status_and_zero_pct_none() -> None:
+    rows = [_e("2026-02-01", "食費", 0), _e("2026-03-01", "食費", 0)]
+    assert compare_months(rows, "2026-03") == [
+        CategoryChange("食費", 0, 0, 0, None, "same")
+    ]
+
+
+def test_negative_previous_uses_abs_denominator_r4() -> None:
+    # 返金で前月合計が負。分母は abs(previous)、符号は delta に従う。
+    rows = [_e("2026-02-01", "食費", -1000), _e("2026-03-01", "食費", 500)]
+    assert compare_months(rows, "2026-03") == [
+        CategoryChange("食費", -1000, 500, 1500, 150.0, "up")
+    ]
+
+
+def test_sort_by_abs_delta_then_category() -> None:
+    rows = [
+        _e("2026-02-01", "B", 100),
+        _e("2026-02-01", "A", 100),
+        _e("2026-02-01", "C", 1000),
+        _e("2026-03-01", "B", 150),  # delta +50
+        _e("2026-03-01", "A", 50),  # delta -50
+        _e("2026-03-01", "C", 700),  # delta -300
+    ]
+    result = compare_months(rows, "2026-03")
+    assert [c.category for c in result] == ["C", "A", "B"]
+
+
+@pytest.mark.parametrize(
+    ("month", "prev"),
+    [
+        ("2026-13", None),
+        ("2026-00", None),
+        ("26-03", None),
+        ("2026-3", None),
+        ("2026-03", "2026-3"),
+        ("2026-03", "2026-02-01"),
+        ("2026-03", "2026-03"),
+    ],
+)
+def test_invalid_month_or_prev_raises(month, prev) -> None:
+    with pytest.raises(ValueError):
+        compare_months([], month, prev=prev)
+
+
+def test_prev_equal_month_raises_value_error() -> None:
+    with pytest.raises(ValueError, match="prev"):
+        compare_months([], "2026-03", prev="2026-03")
+
+
+def test_format_report_lines() -> None:
+    changes = [
+        CategoryChange("食費", 30000, 45000, 15000, 50.0, "up"),
+        CategoryChange("交通費", 0, 8000, 8000, None, "new"),
+        CategoryChange("娯楽", 5000, 0, -5000, -100.0, "gone"),
+        CategoryChange("日用品", 1000, 1000, 0, 0.0, "same"),
+        CategoryChange("光熱費", 20000, 10000, -10000, -50.0, "down"),
+    ]
+    assert format_report(changes) == (
+        "食費: 30,000 → 45,000 (+15,000, +50.0%)\n"
+        "交通費: 0 → 8,000 (+8,000, 新規)\n"
+        "娯楽: 5,000 → 0 (-5,000, 解消)\n"
+        "日用品: 1,000 → 1,000 (±0)\n"
+        "光熱費: 20,000 → 10,000 (-10,000, -50.0%)"
+    )
+
+
+def test_format_report_empty() -> None:
+    assert format_report([]) == "変化なし"
