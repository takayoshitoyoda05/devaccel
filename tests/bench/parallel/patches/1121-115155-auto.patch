@@ -0,0 +1,130 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import matches, search
+
+FOOD = Expense(date(2026, 1, 5), "食費", 3000, "ランチ")
+RENT = Expense(date(2026, 1, 25), "住居", 120000, "家賃")
+NETFLIX = Expense(date(2026, 2, 1), "通信", 1490, "netflix 月額")
+REFUND = Expense(date(2026, 2, 3), "食費", -500, "返金")
+ROWS = [FOOD, RENT, NETFLIX, REFUND]
+
+
+# --- 例の表 (E3) ---
+
+
+@pytest.mark.parametrize(
+    ("cond", "expected"),
+    [
+        pytest.param(
+            {"or": [{"category": "食費"}, {"min_amount": 10000}]},
+            [FOOD, RENT, REFUND],
+            id="E3-1",
+        ),
+        pytest.param({"memo_contains": "ＮＥＴｆｌｉｘ"}, [NETFLIX], id="E3-2"),
+        pytest.param({"or": []}, [], id="E3-3a-empty-or"),
+    ],
+)
+def test_search_table_cases(cond, expected):
+    assert search(ROWS, cond) == expected
+
+
+def test_e3_2_matches_single_row():
+    assert matches(NETFLIX, {"memo_contains": "ＮＥＴｆｌｉｘ"}) is True
+
+
+@pytest.mark.parametrize(
+    "cond",
+    [
+        {"foo": 1},  # E3-3b unknown key
+        {"min_amount": 5, "max_amount": 1},  # E3-3c min > max
+    ],
+    ids=["E3-3b-unknown-key", "E3-3c-min-gt-max"],
+)
+def test_e3_3_invalid_raises(cond):
+    with pytest.raises(ValueError):
+        search(ROWS, cond)
+    with pytest.raises(ValueError):
+        matches(FOOD, cond)
+
+
+# --- 規則の端のケース ---
+
+
+def test_empty_dict_is_true_and_empty_and_is_true():
+    assert matches(FOOD, {}) is True
+    assert matches(FOOD, {"and": []}) is True
+
+
+def test_multiple_keys_in_one_dict_are_anded():
+    assert search(ROWS, {"category": "食費", "min_amount": 1000}) == [FOOD]
+
+
+def test_category_list_matches_any():
+    assert search(ROWS, {"category": ["住居", "通信"]}) == [RENT, NETFLIX]
+
+
+def test_category_is_nfkc_casefold_and_strip_insensitive():
+    e = Expense(date(2026, 1, 1), "Food", 1, "")
+    assert matches(e, {"category": "  ｆｏｏｄ "}) is True
+
+
+def test_memo_contains_empty_string_is_always_true():
+    assert matches(RENT, {"memo_contains": ""}) is True
+
+
+def test_amount_bounds_are_inclusive():
+    assert matches(FOOD, {"min_amount": 3000}) is True
+    assert matches(FOOD, {"max_amount": 3000}) is True
+    assert matches(FOOD, {"min_amount": 3001}) is False
+
+
+def test_date_bounds_are_inclusive():
+    assert matches(RENT, {"date_from": date(2026, 1, 25)}) is True
+    assert matches(RENT, {"date_to": date(2026, 1, 25)}) is True
+    assert matches(RENT, {"date_to": date(2026, 1, 24)}) is False
+
+
+def test_negative_amount_compared_as_plain_value():
+    assert search(ROWS, {"max_amount": 0}) == [REFUND]
+
+
+def test_not_combinator():
+    assert search(ROWS, {"not": {"category": "食費"}}) == [RENT, NETFLIX]
+
+
+def test_and_combinator_with_leaf_mix():
+    cond = {"and": [{"category": "食費"}, {"not": {"max_amount": 0}}]}
+    assert search(ROWS, cond) == [FOOD]
+
+
+def test_search_preserves_input_order():
+    reordered = [NETFLIX, FOOD, RENT]
+    assert search(reordered, {"min_amount": 0}) == [NETFLIX, FOOD, RENT]
+
+
+def test_search_validates_even_with_empty_rows():
+    with pytest.raises(ValueError):
+        search([], {"min_amount": "100"})
+
+
+@pytest.mark.parametrize(
+    "cond",
+    [
+        {"min_amount": "100"},
+        {"min_amount": True},
+        {"date_from": "2026-01-01"},
+        {"date_to": 20260101},
+        {"and": {"category": "食費"}},
+        {"or": ({"category": "食費"},)},
+        {"not": "食費"},
+        {"category": 1},
+        {"memo_contains": None},
+        {"date_from": date(2026, 2, 1), "date_to": date(2026, 1, 1)},
+    ],
+)
+def test_malformed_conditions_raise(cond):
+    with pytest.raises(ValueError):
+        matches(FOOD, cond)
