@@ -0,0 +1,193 @@
+"""Bank / card company CSV text -> Expense list (pure, no file I/O)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from datetime import date
+
+from kakeibo.core import CsvError, Expense
+
+_ALIASES: dict[str, tuple[str, ...]] = {
+    "date": ("日付", "利用日", "取引日", "ご利用日", "date"),
+    "amount": ("金額", "利用金額", "ご利用金額", "amount"),
+    "out": ("出金", "出金額", "お支払金額", "支払"),
+    "in": ("入金", "入金額", "預入"),
+    "memo": ("摘要", "メモ", "利用店名", "ご利用店名", "内容", "description", "memo"),
+    "category": ("カテゴリ", "分類", "category"),
+}
+
+
+def _norm(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip().casefold()
+
+
+_ERAS = {"令和": 2018, "平成": 1988}
+_TIME = r"(?:[T ]+[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?)?"
+_DATE_RES = [
+    re.compile(r"([0-9]{4})[-/.]([0-9]{1,2})[-/.]([0-9]{1,2})" + _TIME),
+    re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日" + _TIME),
+    re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})" + _TIME),
+]
+_ERA_RE = re.compile(
+    r"(令和|平成)([0-9]{1,2}|元)年([0-9]{1,2})月([0-9]{1,2})日" + _TIME
+)
+
+
+def _parse_date(raw: str) -> date | None:
+    s = unicodedata.normalize("NFKC", raw).strip()
+    try:
+        for rx in _DATE_RES:
+            m = rx.fullmatch(s)
+            if m:
+                return date(int(m[1]), int(m[2]), int(m[3]))
+        m = _ERA_RE.fullmatch(s)
+        if m:
+            n = 1 if m[2] == "元" else int(m[2])
+            return date(_ERAS[m[1]] + n, int(m[3]), int(m[4]))
+    except ValueError:
+        return None
+    return None
+
+
+_NEG = "-−△▲"
+_NUM_RE = re.compile(
+    rf"([{_NEG}])?(?:¥|円|JPY)?([{_NEG}])?([0-9][0-9,]*)(?:\.(0+))?(?:円)?(-)?",
+    re.IGNORECASE,
+)
+_EMPTY = {"", "-", "—"}
+
+
+class _Bad(Exception):
+    pass
+
+
+def _parse_amount(raw: str) -> int | None:
+    """None for an empty amount; _Bad for garbage."""
+    s = re.sub(r"\s+", "", unicodedata.normalize("NFKC", raw))
+    if s in _EMPTY:
+        return None
+    neg = False
+    if len(s) > 2 and s[0] == "(" and s[-1] == ")":
+        neg = True
+        s = s[1:-1]
+    m = _NUM_RE.fullmatch(s)
+    if not m:
+        raise _Bad
+    signs = [g for g in (m[1], m[2], m[5]) if g]
+    if len(signs) + neg > 1:
+        raise _Bad
+    digits = m[3].replace(",", "")
+    if not digits.isdigit() or m[3].endswith(","):
+        raise _Bad
+    value = int(digits)
+    return -value if (signs or neg) else value
+
+
+def _require_str(value: object, name: str) -> None:
+    # The spec asks for ValueError (not TypeError) on any bad argument.
+    if not isinstance(value, str):
+        raise ValueError(f"{name} は文字列である必要があります")  # noqa: TRY004
+
+
+def import_bank_csv(text: str, *, default_category: str = "未分類") -> list[Expense]:
+    _require_str(text, "text")
+    _require_str(default_category, "default_category")
+    text = text.removeprefix("﻿")
+    if not text.strip():
+        return []
+    first = re.split(r"\r\n|\n|\r", text, maxsplit=1)[0]
+    delim = "\t" if first.count("\t") > first.count(",") else ","
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delim)
+    try:
+        header = next(reader)
+    except StopIteration:
+        return []
+    names = [h.strip() for h in header]
+    normed = [_norm(h) for h in header]
+    idx: dict[str, int] = {}
+    for key, aliases in _ALIASES.items():
+        wanted = {_norm(a) for a in aliases}
+        for i, h in enumerate(normed):
+            if h in wanted:
+                idx[key] = i
+                break
+    missing: list[str] = []
+    if "date" not in idx:
+        missing.append("日付")
+    if "amount" not in idx and "out" not in idx:
+        missing.append("金額")
+    if missing:
+        raise CsvError([(1, "列がありません: " + ", ".join(missing))])
+
+    out: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    prev_end = reader.line_num
+    for row in reader:
+        start = prev_end + 1
+        prev_end = reader.line_num
+        if all(not c.strip() for c in row):
+            continue
+        if len(row) != len(header):
+            errors.append(
+                (start, f"列数が不正です(期待 {len(header)}, 実際 {len(row)})")
+            )
+            continue
+        reasons: list[str] = []
+
+        def cell(key: str, row: list[str] = row) -> str:
+            return row[idx[key]]
+
+        def col(key: str) -> str:
+            return names[idx[key]]
+
+        day = _parse_date(cell("date"))
+        if day is None:
+            reasons.append(f"日付が不正です: {col('date')}={cell('date')!r}")
+
+        amount: int | None = None
+        skip = False
+        if "amount" in idx:
+            try:
+                amount = _parse_amount(cell("amount"))
+                if amount is None:
+                    reasons.append("金額が空です")
+            except _Bad:
+                reasons.append(f"金額が不正です: {col('amount')}={cell('amount')!r}")
+        else:
+            outv: int | None = None
+            inv: int | None = None
+            bad = False
+            try:
+                outv = _parse_amount(cell("out"))
+            except _Bad:
+                bad = True
+                reasons.append(f"金額が不正です: {col('out')}={cell('out')!r}")
+            if "in" in idx:
+                try:
+                    inv = _parse_amount(cell("in"))
+                except _Bad:
+                    bad = True
+                    reasons.append(f"金額が不正です: {col('in')}={cell('in')!r}")
+            if not bad:
+                if outv is not None and inv is not None:
+                    reasons.append("出金と入金の両方が入っています")
+                elif outv is None and inv is None:
+                    reasons.append("金額が空です")
+                elif outv is None:
+                    skip = True
+                else:
+                    amount = outv
+        if reasons:
+            errors.append((start, "; ".join(reasons)))
+            continue
+        if skip or day is None or amount is None:
+            continue
+        cat = cell("category").strip() if "category" in idx else ""
+        memo = cell("memo") if "memo" in idx else ""
+        out.append(Expense(day, cat or default_category, amount, memo))
+    if errors:
+        raise CsvError(errors)
+    return out
