new file mode 100644
index 0000000..395d080
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,176 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import find_recurring, next_due
+
+
+def E(d: str, amount: int, memo: str = "", category: str = "住居") -> Expense:
+    return Expense(
+        day=date.fromisoformat(d), category=category, amount=amount, memo=memo
+    )
+
+
+# --- 例の表(ID は仕様の表どおり) ---
+
+
+@pytest.mark.parametrize(
+    "rows",
+    [
+        pytest.param(
+            [
+                E("2025-12-31", 80000, "家賃"),
+                E("2026-01-31", 80000, "家賃"),
+                E("2026-02-28", 80000, "家賃"),
+            ],
+            id="E1-1",
+        ),
+    ],
+)
+def test_E1_1_month_end_clipping_uses_max_day(rows: list[Expense]) -> None:
+    [r] = find_recurring(rows)
+    assert r.day_of_month == 31
+    assert r.next_due == date(2026, 3, 31)
+    assert r.months == ("2025-12", "2026-01", "2026-02")
+    assert next_due(r) == date(2026, 3, 31)
+
+
+@pytest.mark.parametrize(
+    "rows",
+    [
+        pytest.param(
+            [
+                E("2026-01-05", 500, "ジム"),
+                E("2026-03-05", 500, "ジム"),
+                E("2026-04-05", 500, "ジム"),
+            ],
+            id="E1-2",
+        ),
+    ],
+)
+def test_E1_2_gap_breaks_run_below_minimum(rows: list[Expense]) -> None:
+    assert find_recurring(rows) == []
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [pytest.param(1, id="E1-3-min1"), pytest.param(True, id="E1-3-True")],
+)
+def test_E1_3_min_occurrences_must_be_int_at_least_2(bad: object) -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_occurrences=bad)  # type: ignore[arg-type]
+
+
+# --- 規則の補足テスト ---
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+def test_refunds_and_zero_are_excluded_from_series() -> None:
+    rows = [
+        E("2026-01-05", 500),
+        E("2026-02-05", -500),
+        E("2026-03-05", 0),
+        E("2026-04-05", 500),
+        E("2026-05-05", 500),
+    ]
+    # 1,4,5 月 の 500 円 は連続しない(2・3 月は除外)ので定期なし
+    assert find_recurring(rows) == []
+    rows2 = [
+        E("2026-01-05", 500),
+        E("2026-02-05", -500),
+        E("2026-03-05", 500),
+        E("2026-04-05", 500),
+    ]
+    [r] = find_recurring(rows2, min_occurrences=2)
+    assert r.months == ("2026-03", "2026-04")
+
+
+def test_outlier_beyond_10_percent_is_dropped() -> None:
+    rows = [
+        E("2025-10-10", 1000, "サブスク"),
+        E("2025-11-10", 1000, "サブスク"),
+        E("2025-12-10", 1000, "サブスク"),
+        E("2026-01-10", 1000, "サブスク"),
+        E("2026-02-10", 1100, "サブスク"),  # 中央値 1050 から 4.8 % → 残す
+        E("2026-03-10", 1500, "サブスク"),  # 中央値から 43 % 外れる → 除外
+    ]
+    [r] = find_recurring(rows)
+    assert r.amount == 1100
+    assert r.months[-1] == "2026-02"
+    assert r.next_due == date(2026, 3, 10)
+
+
+def test_memo_normalization_groups_series() -> None:
+    rows = [
+        E("2026-01-03", 1200, "Netflix 2026-01"),
+        E("2026-02-03", 1200, "netflix 2026-02"),
+        E("2026-03-03", 1200, "NETFLIX　２０２６-０３"),
+    ]
+    [r] = find_recurring(rows)
+    assert r.memo_key == "netflix"
+
+
+def test_gym_memo_with_month_number_is_grouped() -> None:
+    rows = [
+        E("2026-01-01", 8000, "ジム　１月"),
+        E("2026-02-01", 8000, "ジム 2月"),
+        E("2026-03-01", 8000, "ジム３月"),
+    ]
+    [r] = find_recurring(rows)
+    assert r.memo_key == "ジム"
+
+
+def test_same_month_counts_only_last_occurrence() -> None:
+    rows = [
+        E("2026-01-02", 300, "A"),
+        E("2026-01-20", 300, "A"),
+        E("2026-02-02", 300, "A"),
+    ]
+    assert find_recurring(rows) == []  # 2 か月ぶんしか無い
+    rows.append(E("2026-03-02", 300, "A"))
+    [r] = find_recurring(rows)
+    assert r.months == ("2026-01", "2026-02", "2026-03")
+
+
+def test_no_memo_uses_category_and_amount() -> None:
+    rows = [
+        E("2026-01-04", 700, ""),
+        E("2026-02-04", 700, ""),
+        E("2026-03-04", 700, ""),
+        E("2026-01-09", 333, ""),
+        E("2026-02-09", 333, ""),
+        E("2026-03-09", 333, ""),
+    ]
+    out = find_recurring(rows)
+    assert sorted(r.amount for r in out) == [333, 700]
+    assert all(r.memo_key == "" for r in out)
+
+
+def test_next_due_clipped_to_february_in_leap_year() -> None:
+    rows = [E("2023-11-30", 900), E("2023-12-31", 900), E("2024-01-31", 900)]
+    [r] = find_recurring(rows)
+    assert r.next_due == date(2024, 2, 29)
+
+
+def test_next_due_rolls_over_year_end() -> None:
+    rows = [E("2025-10-15", 900), E("2025-11-15", 900), E("2025-12-15", 900)]
+    [r] = find_recurring(rows)
+    assert r.next_due == date(2026, 1, 15)
+
+
+def test_output_sorted_by_next_due_then_category() -> None:
+    rows = [
+        E("2026-01-20", 100, "b", category="通信"),
+        E("2026-02-20", 100, "b", category="通信"),
+        E("2026-03-20", 100, "b", category="通信"),
+        E("2026-01-05", 200, "a", category="住居"),
+        E("2026-02-05", 200, "a", category="住居"),
+        E("2026-03-05", 200, "a", category="住居"),
+    ]
+    out = find_recurring(rows)
+    assert [r.category for r in out] == ["住居", "通信"]
+    assert [r.next_due for r in out] == [date(2026, 4, 5), date(2026, 4, 20)]
