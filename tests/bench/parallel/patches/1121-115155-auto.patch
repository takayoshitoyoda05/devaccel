+from datetime import date
+
+import pytest
+
+from kakeibo.bankcsv import import_bank_csv
+from kakeibo.core import CsvError, Expense
+
+
+def test_e2_1_alias_nfkc_amount():
+    text = '利用日,ご利用店名,利用金額\n2026/1/5,ＡＢＣ商店,"1,234円"'
+    assert import_bank_csv(text) == [
+        Expense(date(2026, 1, 5), "未分類", 1234, "ＡＢＣ商店")
+    ]
+
+
+def test_e2_2_all_errors_in_one_row():
+    text = "日付,金額\n2026/2/30,12.5"
+    with pytest.raises(CsvError) as ei:
+        import_bank_csv(text)
+    assert len(ei.value.errors) == 1
+    n, why = ei.value.errors[0]
+    assert n == 2 and "日付" in why and "金額" in why
+
+
+def test_e2_3_deposit_only_skipped():
+    text = "日付,出金,入金\n2026-01-05,,1000\n2026-01-06,300,"
+    assert import_bank_csv(text) == [Expense(date(2026, 1, 6), "未分類", 300, "")]
+
+
+@pytest.mark.parametrize(
+    ("d", "want"),
+    [
+        ("2026-01-05", date(2026, 1, 5)),
+        ("2026年1月5日", date(2026, 1, 5)),
+        ("20260105", date(2026, 1, 5)),
+        ("令和8年1月5日", date(2026, 1, 5)),
+        ("平成30年1月5日", date(2018, 1, 5)),
+        ("2026/01/05 12:34", date(2026, 1, 5)),
+        ("2026-01-05T12:34:56", date(2026, 1, 5)),
+        ("2026.1.5", date(2026, 1, 5)),
+    ],
+)
+def test_date_formats(d, want):
+    assert import_bank_csv(f"日付,金額\n{d},1")[0].day == want
+
+
+@pytest.mark.parametrize(
+    ("a", "want"),
+    [
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("¥1，000", 1000),
+        ("JPY 12.0", 12),
+        ("円5", 5),
+    ],
+)
+def test_amounts(a, want):
+    assert import_bank_csv(f'日付,金額\n2026-01-05,"{a}"')[0].amount == want
+
+
+@pytest.mark.parametrize("a", ["", "-", "—"])
+def test_empty_amount_error(a):
+    with pytest.raises(CsvError) as ei:
+        import_bank_csv(f"日付,金額\n2026-01-05,{a}")
+    assert "金額が空です" in ei.value.errors[0][1]
+
+
+def test_missing_columns_and_empty():
+    with pytest.raises(CsvError) as ei:
+        import_bank_csv("a,b\n1,2")
+    assert ei.value.errors[0][0] == 1 and "日付" in ei.value.errors[0][1]
+    assert import_bank_csv("") == []
+    assert import_bank_csv("日付,金額\n") == []
+
+
+def test_tab_bom_crlf_quotes_and_lines():
+    text = '﻿日付\t金額\tメモ\r\n2026-01-05\t100\t"a\nb"\r2026-01-06\t1.5\tx'
+    with pytest.raises(CsvError) as ei:
+        import_bank_csv(text)
+    assert [n for n, _ in ei.value.errors] == [4]
+
+
+def test_column_count_and_both_filled():
+    with pytest.raises(CsvError) as ei:
+        import_bank_csv("日付,出金,入金\n2026-01-05,1,2\n\n2026-01-05,1,234円,x")
+    assert [n for n, _ in ei.value.errors] == [2, 4]
+    assert "列数が不正です(期待 3, 実際 4)" in ei.value.errors[1][1]
