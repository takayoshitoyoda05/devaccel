diff --git a/src/kakeibo/core.py b/src/kakeibo/core.py
index 8c3cbab..71721d8 100644
--- a/src/kakeibo/core.py
+++ b/src/kakeibo/core.py
@@ -133,3 +133,28 @@ def find_overruns(
             if cat in limits and actual > limits[cat]:
                 out.append((month, cat, actual - limits[cat], limits[cat], actual))
     return out
+
+
+def find_near_limit(
+    totals: dict[str, dict[str, int]], budget: Budget
+) -> list[tuple[str, str, int, int]]:
+    """(month, category, limit, actual) for 90% <= actual/limit <= 100%.
+
+    Exactly 100% is included (not an overrun). A limit of 0 is never reported.
+    """
+    out: list[tuple[str, str, int, int]] = []
+    for month, cats in totals.items():
+        limits = budget.for_month(month)
+        for cat, actual in cats.items():
+            limit = limits.get(cat)
+            if limit and actual * 10 >= limit * 9 and actual <= limit:
+                out.append((month, cat, limit, actual))
+    return out
+
+
+def usage_percent(limit: int, actual: int) -> str | None:
+    """actual/limit as "95.0%" (one decimal, truncated); None when limit is 0."""
+    if limit <= 0:
+        return None
+    tenths = actual * 1000 // limit
+    return f"{tenths // 10}.{tenths % 10}%"
