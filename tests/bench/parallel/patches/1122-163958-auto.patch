+@pytest.mark.parametrize(
+    ("type", "expect"),
+    [
+        (click.FloatRange(0.5, 2.5), "0.5<=x<=2.5"),
+        (click.FloatRange(0.5, 2.5, min_open=True, max_open=True), "0.5<x<2.5"),
+        (click.FloatRange(0.5), "x>=0.5"),
+        (click.FloatRange(0.5, min_open=True), "x>0.5"),
+        (click.FloatRange(max=2.5), "x<=2.5"),
+        (click.FloatRange(max=2.5, max_open=True), "x<2.5"),
+        (click.IntRange(1, min_open=True), "x>1"),
+        (click.IntRange(max=32, max_open=True), "x<32"),
+    ],
+)
+def test_range_help_text_bounds(type, expect):
+    option = click.Option(["--num"], type=type)
+    context = click.Context(click.Command("test"))
+    assert option.get_help_extra(context) == {"range": expect}
