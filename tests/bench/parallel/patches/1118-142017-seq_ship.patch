+"""Export expenses."""
+
+from __future__ import annotations
+
+import json
+
+from kakeibo.core import Expense
+
+
+def to_json(rows: list[Expense]) -> str:
+    return json.dumps(
+        [
+            {
+                "date": r.day.isoformat(),
+                "category": r.category,
+                "amount": r.amount,
+                "memo": r.memo,
+            }
+            for r in rows
+        ],
+        ensure_ascii=False,
+    )
