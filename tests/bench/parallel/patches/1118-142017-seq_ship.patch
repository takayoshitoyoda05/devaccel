@@ -0,0 +1,19 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.dupes import find_duplicates
+
+A = Expense(date(2025, 1, 1), "食費", 100, "x")
+
+
+def test_none():
+    assert find_duplicates([]) == []
+    assert find_duplicates([A, Expense(date(2025, 1, 1), "食費", 100, "y")]) == []
+
+
+def test_pairs_ordered():
+    assert find_duplicates([A, A, Expense(date(2025, 1, 2), "食費", 1), A]) == [
+        (0, 1),
+        (0, 3),
+        (1, 3),
+    ]
