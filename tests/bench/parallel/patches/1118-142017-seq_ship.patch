+import json
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.export import to_json
+
+
+def test_empty():
+    assert to_json([]) == "[]"
+
+
+def test_exact_output():
+    rows = [
+        Expense(date(2025, 1, 2), "食費", 500, "昼"),
+        Expense(date(2025, 1, 1), "交通", 200),
+    ]
+    assert to_json(rows) == (
+        '[{"date": "2025-01-02", "category": "食費", "amount": 500, "memo": "昼"}, '
+        '{"date": "2025-01-01", "category": "交通", "amount": 200, "memo": ""}]'
+    )
+    assert json.loads(to_json(rows))[0]["memo"] == "昼"
