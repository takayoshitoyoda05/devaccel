@@ -0,0 +1,15 @@
+"""Totals by weekday."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+_NAMES = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
+
+
+def total_by_weekday(rows: list[Expense]) -> dict[str, int]:
+    totals: dict[str, int] = {}
+    for r in rows:
+        name = _NAMES[r.day.weekday()]
+        totals[name] = totals.get(name, 0) + r.amount
+    return {n: totals[n] for n in _NAMES if n in totals}
