+"""Statistics over expenses."""
+
+from __future__ import annotations
+
+from statistics import median
+
+from kakeibo.core import Expense
+
+
+def median_by_category(rows: list[Expense]) -> dict[str, float]:
+    groups: dict[str, list[int]] = {}
+    for r in rows:
+        groups.setdefault(r.category, []).append(r.amount)
+    return {c: float(median(groups[c])) for c in sorted(groups)}
