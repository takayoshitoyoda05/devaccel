+import pytest
+
+from kakeibo.split import split_evenly
+
+
+def test_even():
+    assert split_evenly(900, 3) == [300, 300, 300]
+
+
+def test_remainder_to_first():
+    assert split_evenly(1000, 3) == [334, 333, 333]
+    assert sum(split_evenly(1001, 4)) == 1001
+
+
+def test_zero_and_one():
+    assert split_evenly(0, 2) == [0, 0]
+    assert split_evenly(5, 1) == [5]
+
+
+@pytest.mark.parametrize("p", [0, -1])
+def test_invalid(p):
+    with pytest.raises(ValueError):
+        split_evenly(100, p)
