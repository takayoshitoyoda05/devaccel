+"""Largest expenses."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def top_expenses(rows: list[Expense], n: int) -> list[Expense]:
+    if n <= 0:
+        return []
+    return sorted(rows, key=lambda r: (-r.amount, r.day))[:n]
