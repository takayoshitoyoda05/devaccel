@@ -0,0 +1,20 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.topn import top_expenses
+
+A = Expense(date(2025, 1, 3), "a", 100, "first")
+B = Expense(date(2025, 1, 1), "a", 100)
+C = Expense(date(2025, 1, 3), "a", 100, "second")
+D = Expense(date(2025, 1, 2), "a", 500)
+
+
+def test_order_and_ties():
+    assert top_expenses([A, B, C, D], 4) == [D, B, A, C]
+
+
+def test_limits():
+    assert top_expenses([A, D], 1) == [D]
+    assert top_expenses([A], 5) == [A]
+    assert top_expenses([A], 0) == []
+    assert top_expenses([A], -1) == []
