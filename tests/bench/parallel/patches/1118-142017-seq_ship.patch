@@ -0,0 +1,20 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.weekday import total_by_weekday
+
+
+def test_empty():
+    assert total_by_weekday([]) == {}
+
+
+def test_totals_and_order():
+    rows = [
+        Expense(date(2025, 1, 5), "a", 10),  # Sun
+        Expense(date(2025, 1, 6), "a", 20),  # Mon
+        Expense(date(2025, 1, 13), "a", 5),  # Mon
+        Expense(date(2025, 1, 8), "a", 7),  # Wed
+    ]
+    result = total_by_weekday(rows)
+    assert result == {"Mon": 25, "Wed": 7, "Sun": 10}
+    assert list(result) == ["Mon", "Wed", "Sun"]
