@@ -0,0 +1,25 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.stats import median_by_category
+
+
+def e(cat: str, amount: int) -> Expense:
+    return Expense(date(2025, 1, 1), cat, amount)
+
+
+def test_empty():
+    assert median_by_category([]) == {}
+
+
+def test_odd_even_and_order():
+    rows = [
+        e("食費", 300),
+        e("交通", 100),
+        e("食費", 100),
+        e("食費", 200),
+        e("交通", 201),
+    ]
+    result = median_by_category(rows)
+    assert result == {"交通": 150.5, "食費": 200.0}
+    assert list(result) == sorted(result)
diff --git a/tests/test_streak.py b/tests/test_streak.py
new file mode 100644
index 0000000..a685cd3
--- /dev/null
+++ b/tests/test_streak.py
@@ -0,0 +1,28 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.streak import longest_no_spend_streak
+
+
+def e(d: int) -> Expense:
+    return Expense(date(2025, 1, d), "a", 1)
+
+
+def test_no_rows():
+    assert longest_no_spend_streak([], date(2025, 1, 1), date(2025, 1, 10)) == 10
+
+
+def test_gaps_and_inclusive_ends():
+    rows = [e(1), e(5), e(6), e(10)]
+    assert longest_no_spend_streak(rows, date(2025, 1, 1), date(2025, 1, 10)) == 3
+
+
+def test_rows_outside_range_ignored_and_all_spent():
+    assert longest_no_spend_streak([e(20)], date(2025, 1, 1), date(2025, 1, 3)) == 3
+    assert (
+        longest_no_spend_streak([e(1), e(2)], date(2025, 1, 1), date(2025, 1, 2)) == 0
+    )
+
+
+def test_empty_range():
+    assert longest_no_spend_streak([], date(2025, 1, 5), date(2025, 1, 1)) == 0
