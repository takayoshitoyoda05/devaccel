+import json
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.export import to_json
+
+
+def test_empty_list_gives_empty_json_array() -> None:
+    assert to_json([]) == "[]"
+
+
+def test_single_row_has_keys_in_order_and_no_indent() -> None:
+    rows = [Expense(date(2024, 3, 5), "食費", 1200, "昼食")]
+    assert to_json(rows) == (
+        '[{"date": "2024-03-05", "category": "食費", "amount": 1200, "memo": "昼食"}]'
+    )
+
+
+def test_keeps_input_order() -> None:
+    rows = [
+        Expense(date(2024, 2, 1), "B", 2),
+        Expense(date(2024, 1, 1), "A", 1),
+    ]
+    parsed = json.loads(to_json(rows))
+    assert [r["date"] for r in parsed] == ["2024-02-01", "2024-01-01"]
+
+
+def test_non_ascii_is_not_escaped() -> None:
+    rows = [Expense(date(2024, 1, 1), "交通費", 100, "電車")]
+    out = to_json(rows)
+    assert "交通費" in out
+    assert "\\u" not in out
+
+
+def test_empty_memo_is_kept_as_empty_string() -> None:
+    rows = [Expense(date(2024, 1, 1), "食費", 500)]
+    assert json.loads(to_json(rows))[0]["memo"] == ""
+
+
+def test_date_is_zero_padded_iso_format() -> None:
+    rows = [Expense(date(2024, 1, 9), "食費", 500)]
+    assert json.loads(to_json(rows))[0]["date"] == "2024-01-09"
+
+
+def test_amount_is_integer_and_zero_is_kept() -> None:
+    rows = [Expense(date(2024, 1, 1), "食費", 0)]
+    amount = json.loads(to_json(rows))[0]["amount"]
+    assert amount == 0
+    assert isinstance(amount, int)
