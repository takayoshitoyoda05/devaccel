+++ b/src/kakeibo/dupes.py
@@ -0,0 +1,26 @@
+"""Detect duplicate expense rows."""
+
+from __future__ import annotations
+
+from collections import defaultdict
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def find_duplicates(rows: list[Expense]) -> list[tuple[int, int]]:
+    """(i, j) pairs with i < j where day, category, amount and memo all match.
+
+    Sorted by i ascending, then j ascending.
+    """
+    groups: dict[tuple[date, str, int, str], list[int]] = defaultdict(list)
+    for idx, e in enumerate(rows):
+        groups[(e.day, e.category, e.amount, e.memo)].append(idx)
+
+    pairs: list[tuple[int, int]] = []
+    for indices in groups.values():
+        for x in range(len(indices)):
+            for y in range(x + 1, len(indices)):
+                pairs.append((indices[x], indices[y]))
+    pairs.sort()
+    return pairs
