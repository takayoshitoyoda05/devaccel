+"""Formatting helpers for yen amounts."""
+
+from __future__ import annotations
+
+
+def yen(n: int) -> str:
+    """Format an integer yen amount with thousands separators and a 円 suffix.
+
+    >>> yen(1234567)
+    '1,234,567円'
+    >>> yen(-1200)
+    '-1,200円'
+    """
+    return f"{n:,}円"
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
new file mode 100644
index 0000000..05024fd
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,86 @@
+"""Month-over-month category comparison."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense, total_by_category
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def _month_rows(rows: list[Expense], month: str) -> list[Expense]:
+    return [e for e in rows if e.day.strftime("%Y-%m") == month]
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+    prev_rows = _month_rows(rows, prev_month)
+    curr_rows = _month_rows(rows, curr_month)
+    prev_totals = total_by_category(prev_rows)
+    curr_totals = total_by_category(curr_rows)
+    prev_cats = {e.category for e in prev_rows}
+    curr_cats = {e.category for e in curr_rows}
+
+    out: list[DiffRow] = []
+    for cat in prev_cats | curr_cats:
+        prev = prev_totals.get(cat, 0)
+        curr = curr_totals.get(cat, 0)
+        delta = curr - prev
+        pct = None if prev == 0 else round(delta / prev * 100, 1) + 0.0
+        if cat not in prev_cats:
+            status = "new"
+        elif cat not in curr_cats:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+
+    out.sort(key=lambda r: (-abs(r.delta), r.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [d for d in diffs if d.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for d in diffs:
+        pct = "-" if d.pct is None else f"{d.pct:+.1f}%"
+        lines.append(f"{d.category}\t{d.prev}\t{d.curr}\t{d.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({e.day.strftime("%Y-%m") for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("比較には 2 か月以上の明細が必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..9e3e5cb
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,182 @@
+"""Search query language for filtering expenses.
+
+Grammar (lowest precedence first)::
+
+    or_expr  := and_expr ("OR" and_expr)*
+    and_expr := not_expr (["AND"] not_expr)*
+    not_expr := "NOT" not_expr | primary
+    primary  := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+
+from kakeibo.core import Expense
+
+
+class QueryError(ValueError):
+    """Raised when a search query is malformed."""
+
+
+_Pred = Callable[[Expense], bool]
+
+_KEYWORDS = ("AND", "OR", "NOT")
+# Token kinds that can begin a not_expr (i.e. an implicit AND operand).
+_OPERAND_START = ("NOT", "TERM", "CAT", "LPAREN")
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    tokens: list[tuple[str, str]] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end < 0:
+                raise QueryError("引用符が閉じていません")
+            body = q[i + 1 : end]
+            if body == "":
+                raise QueryError("空の引用符は使えません")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            j = i
+            while j < n and not (q[j].isspace() or q[j] in '()"'):
+                j += 1
+            word = q[i:j]
+            i = j
+            if word in _KEYWORDS:
+                tokens.append((word, word))
+            elif word.startswith("cat:"):
+                value = word[len("cat:") :]
+                if value == "":
+                    raise QueryError("cat: の後ろに値がありません")
+                tokens.append(("CAT", value))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+def _term_pred(value: str) -> _Pred:
+    needle = value.casefold()
+
+    def pred(e: Expense) -> bool:
+        return needle in e.memo.casefold() or needle in e.category.casefold()
+
+    return pred
+
+
+def _cat_pred(value: str) -> _Pred:
+    target = value.casefold()
+
+    def pred(e: Expense) -> bool:
+        return target == e.category.casefold()
+
+    return pred
+
+
+def _not_pred(inner: _Pred) -> _Pred:
+    def pred(e: Expense) -> bool:
+        return not inner(e)
+
+    return pred
+
+
+def _and_pred(left: _Pred, right: _Pred) -> _Pred:
+    def pred(e: Expense) -> bool:
+        return left(e) and right(e)
+
+    return pred
+
+
+def _or_pred(left: _Pred, right: _Pred) -> _Pred:
+    def pred(e: Expense) -> bool:
+        return left(e) or right(e)
+
+    return pred
+
+
+class _Parser:
+    def __init__(self, tokens: list[tuple[str, str]]) -> None:
+        self._tokens = tokens
+        self._pos = 0
+
+    def _peek_kind(self) -> str | None:
+        if self._pos < len(self._tokens):
+            return self._tokens[self._pos][0]
+        return None
+
+    def parse(self) -> _Pred:
+        if not self._tokens:
+            raise QueryError("検索条件が空です")
+        pred = self._or_expr()
+        if self._pos != len(self._tokens):
+            raise QueryError(
+                f"余分なトークンがあります: {self._tokens[self._pos][1]!r}"
+            )
+        return pred
+
+    def _or_expr(self) -> _Pred:
+        left = self._and_expr()
+        while self._peek_kind() == "OR":
+            self._pos += 1
+            left = _or_pred(left, self._and_expr())
+        return left
+
+    def _and_expr(self) -> _Pred:
+        left = self._not_expr()
+        while True:
+            kind = self._peek_kind()
+            if kind == "AND":
+                self._pos += 1
+            elif kind not in _OPERAND_START:
+                break
+            left = _and_pred(left, self._not_expr())
+        return left
+
+    def _not_expr(self) -> _Pred:
+        if self._peek_kind() == "NOT":
+            self._pos += 1
+            return _not_pred(self._not_expr())
+        return self._primary()
+
+    def _primary(self) -> _Pred:
+        kind = self._peek_kind()
+        if kind is None:
+            raise QueryError("演算子の後ろに項がありません")
+        kind, value = self._tokens[self._pos]
+        self._pos += 1
+        if kind == "TERM":
+            return _term_pred(value)
+        if kind == "CAT":
+            return _cat_pred(value)
+        if kind == "LPAREN":
+            inner = self._or_expr()
+            if self._peek_kind() != "RPAREN":
+                raise QueryError("括弧が閉じていません")
+            self._pos += 1
+            return inner
+        raise QueryError(f"予期しないトークンです: {value!r}")
+
+
+def _compile(q: str) -> _Pred:
+    return _Parser(tokenize(q)).parse()
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _compile(q)(e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    pred = _compile(q)
+    return [e for e in rows if pred(e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..45d6619
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,62 @@
+"""Detect recurring expenses (same category and amount at a regular monthly interval)."""
+
+from __future__ import annotations
+
+import calendar
+import itertools
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day in the next month, clamped to that month's last day."""
+    year = d.year + (1 if d.month == 12 else 0)
+    month = 1 if d.month == 12 else d.month + 1
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError("min_count は 2 以上である必要があります")
+    if tolerance < 0:
+        raise ValueError("tolerance は 0 以上である必要があります")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    result: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        days = sorted(day_set)
+        runs: list[list[date]] = [[days[0]]]
+        for prev, nxt in itertools.pairwise(days):
+            if abs((nxt - add_month(prev)).days) <= tolerance:
+                runs[-1].append(nxt)
+            else:
+                runs.append([nxt])
+        for run in runs:
+            if len(run) >= min_count:
+                result.append(
+                    Recurring(
+                        category=category,
+                        amount=amount,
+                        days=tuple(run),
+                        next_expected=add_month(run[-1]),
+                    )
+                )
+
+    result.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return result
