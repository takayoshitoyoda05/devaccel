diff --git a/src/kakeibo/bankimport.py b/src/kakeibo/bankimport.py
new file mode 100644
index 0000000..2d3bea8
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,106 @@
+"""Import bank-statement CSV (他行の明細) into Expense records."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+_AMOUNT_RE = re.compile(r"(-)?[¥￥]?([0-9][0-9,]*)円?")
+
+
+def parse_amount(s: str) -> int:
+    """Parse amounts like ``-¥300``, ``980円`` or ``￥1,234,567`` into yen."""
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額が不正です: {s!r}")
+    value = int(m.group(2).replace(",", ""))
+    return -value if m.group(1) else value
+
+
+def parse_date(s: str) -> date:
+    """Parse ``YYYY/M/D`` or ``YYYY-M-D`` (separator must not be mixed)."""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付が不正です: {s!r}")
+    try:
+        return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+    except ValueError:
+        raise ValueError(f"日付が不正です: {s!r}") from None
+
+
+def _cell(row: list[str], idx: int | None) -> str:
+    if idx is None or idx >= len(row):
+        return ""
+    return row[idx]
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Convert a bank CSV (first line = header) into expenses.
+
+    Returns ``(valid expenses in input order, [(physical line number, field)])``.
+    Rows with any error are excluded from the expenses.
+    """
+    cols = DEFAULT_MAPPING if mapping is None else mapping
+    for key in ("date", "category", "amount"):
+        if key not in cols:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header: list[str] = next(reader, [])
+    index: dict[str, int] = {}
+    for field, col in cols.items():
+        if col not in header:
+            raise ValueError(f"ヘッダーに列 {col!r} がありません")
+        index[field] = header.index(col)
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    while True:
+        line = reader.line_num + 1
+        row = next(reader, None)
+        if row is None:
+            break
+        if not row or (len(row) == 1 and not row[0].strip()):
+            continue  # blank line: skipped, but still counted above
+
+        row_errors: list[tuple[int, str]] = []
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(_cell(row, index["date"]))
+        except ValueError:
+            row_errors.append((line, "date"))
+        try:
+            amount = parse_amount(_cell(row, index["amount"]))
+        except ValueError:
+            row_errors.append((line, "amount"))
+        category = _cell(row, index["category"]).strip()
+        if not category:
+            row_errors.append((line, "category"))
+
+        if row_errors or day is None or amount is None:
+            errors.extend(row_errors)
+            continue
+
+        if category_map and category in category_map:
+            category = category_map[category]
+        memo = _cell(row, index.get("memo")).strip()
+        expenses.append(Expense(day=day, category=category, amount=amount, memo=memo))
+
+    return expenses, errors
diff --git a/src/kakeibo/dupes.py b/src/kakeibo/dupes.py
