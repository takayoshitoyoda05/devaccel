@@ -0,0 +1,17 @@
+"""Totals grouped by day of the week."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+# Monday-first order; keys are English 3-letter abbreviations.
+_WEEKDAYS = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
+
+
+def total_by_weekday(rows: list[Expense]) -> dict[str, int]:
+    """{"Mon".."Sun": yen}, Monday-first. Weekdays without any expense are omitted."""
+    totals: dict[str, int] = {}
+    for e in rows:
+        name = _WEEKDAYS[e.day.weekday()]
+        totals[name] = totals.get(name, 0) + e.amount
+    return {name: totals[name] for name in _WEEKDAYS if name in totals}
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..061bafb
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,259 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+HDR = "利用日,分類,利用金額,利用店名"
+
+
+# --- parse_amount -----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("-0", 0),
+        ("¥1000", 1000),
+        ("￥5", 5),
+        ("1,,000", 1000),  # comma positions are not checked
+        ("1000,", 1000),
+        ("1,000円 ", 1000),
+    ],
+)
+def test_parse_amount_accepts(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "円",
+        "12.5",
+        "1 200",
+        "--5",
+        "¥-5",
+        "１２３",
+        "-",
+        "-円",
+        "¥円",
+        ",5",
+        "5円円",
+        "￥¥5",
+        "-¥-5",
+        "¥ 5",
+        "- 5",
+        "5 円",
+    ],
+)
+def test_parse_amount_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+# --- parse_date -------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/1/5 ", date(2026, 1, 5)),
+        ("2026/12/31", date(2026, 12, 31)),
+        ("2028/2/29", date(2028, 2, 29)),
+    ],
+)
+def test_parse_date_accepts(text: str, expected: date) -> None:
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026/1-5",
+        "2026-1/5",
+        "26/1/5",
+        "2026/02/30",
+        "2026/2/29",
+        "2026/13/1",
+        "2026/0/1",
+        "20260105",
+        "2026/001/5",
+        "２０２６/1/5",
+        "2026/1/",
+        "",
+        "2026.1.5",
+        "2026/1/5/",
+    ],
+)
+def test_parse_date_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+# --- import_rows: mapping ---------------------------------------------------
+
+
+def test_default_mapping_reads_bank_columns_and_ignores_extra() -> None:
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+    text = '利用日,分類,利用金額,利用店名,カード番号\n2026/1/5,食費,"1,200",スーパーA,1234\n'
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 1200, "スーパーA")]
+
+
+def test_default_mapping_same_as_none() -> None:
+    text = f"{HDR}\n2026/1/5,食費,300,店\n"
+    assert import_rows(text, None) == import_rows(text, DEFAULT_MAPPING)
+
+
+def test_quoted_comma_in_memo_is_kept() -> None:
+    text = f'{HDR}\n2026/1/5,食費,300,"ABC, Inc"\n'
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows[0].memo == "ABC, Inc"
+
+
+@pytest.mark.parametrize("missing", ["date", "category", "amount"])
+def test_mapping_missing_required_key_raises(missing: str) -> None:
+    mapping = {k: v for k, v in DEFAULT_MAPPING.items() if k != missing}
+    with pytest.raises(ValueError):
+        import_rows(f"{HDR}\n", mapping)
+
+
+def test_memo_key_may_be_omitted() -> None:
+    mapping = {"date": "利用日", "category": "分類", "amount": "利用金額"}
+    rows, errors = import_rows(f"{HDR}\n2026/1/5,食費,300,店\n", mapping)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 300, "")]
+
+
+def test_mapped_column_missing_from_header_raises() -> None:
+    mapping = {"date": "日付", "category": "分類", "amount": "利用金額"}
+    with pytest.raises(ValueError):
+        import_rows(f"{HDR}\n2026/1/5,食費,300,店\n", mapping)
+
+
+def test_memo_column_missing_from_header_raises() -> None:
+    mapping = {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "店名",
+    }
+    with pytest.raises(ValueError):
+        import_rows(f"{HDR}\n2026/1/5,食費,300,店\n", mapping)
+
+
+def test_custom_mapping_uses_given_column_names() -> None:
+    mapping = {"date": "日付", "category": "区分", "amount": "金額", "memo": "摘要"}
+    text = "日付,区分,金額,摘要\n2026-02-03,交通,¥450,駅\n"
+    rows, errors = import_rows(text, mapping)
+    assert errors == []
+    assert rows == [Expense(date(2026, 2, 3), "交通", 450, "駅")]
+
+
+# --- import_rows: values ----------------------------------------------------
+
+
+def test_values_are_stripped_and_memo_defaults_to_empty_string() -> None:
+    mapping = {"date": "利用日", "category": "分類", "amount": "利用金額"}
+    rows, errors = import_rows(f"{HDR}\n 2026/1/5 ,  食費 , 300 ,x\n", mapping)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 300, "")]
+
+
+def test_memo_is_stripped() -> None:
+    rows, errors = import_rows(f"{HDR}\n2026/1/5,食費,300,  店名  \n")
+    assert errors == []
+    assert rows[0].memo == "店名"
+
+
+def test_category_map_replaces_stripped_category_only() -> None:
+    text = f"{HDR}\n2026/1/5, 食費 ,300,食費\n2026/1/6,交通費,200,店\n"
+    rows, errors = import_rows(text, category_map={"食費": "食料品"})
+    assert errors == []
+    assert [r.category for r in rows] == ["食料品", "交通費"]
+    assert rows[0].memo == "食費"  # memo is not mapped
+
+
+def test_rows_keep_input_order() -> None:
+    text = f"{HDR}\n2026/3/1,C,3,\n2026/1/1,A,1,\n2026/2/1,B,2,\n"
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert [r.category for r in rows] == ["C", "A", "B"]
+
+
+def test_short_row_missing_memo_gives_empty_memo() -> None:
+    text = f"{HDR}\n2026/1/5,食費,300\n"
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 300, "")]
+
+
+# --- import_rows: errors ----------------------------------------------------
+
+
+def test_bad_date_is_reported_and_row_excluded() -> None:
+    text = f"{HDR}\n2026/13/1,食費,300,店\n2026/1/5,食費,300,店\n"
+    rows, errors = import_rows(text)
+    assert errors == [(2, "date")]
+    assert rows == [Expense(date(2026, 1, 5), "食費", 300, "店")]
+
+
+def test_bad_amount_is_reported() -> None:
+    rows, errors = import_rows(f"{HDR}\n2026/1/5,食費,12.5,店\n")
+    assert errors == [(2, "amount")]
+    assert rows == []
+
+
+def test_empty_category_is_reported() -> None:
+    rows, errors = import_rows(f"{HDR}\n2026/1/5,   ,300,店\n")
+    assert errors == [(2, "category")]
+    assert rows == []
+
+
+def test_multiple_errors_in_one_row_are_all_recorded_in_order() -> None:
+    rows, errors = import_rows(f"{HDR}\n不正,,abc,店\n")
+    assert errors == [(2, "date"), (2, "amount"), (2, "category")]
+    assert rows == []
+
+
+def test_short_row_missing_values_are_errors() -> None:
+    mapping = {"date": "利用日", "category": "分類", "amount": "利用金額"}
+    rows, errors = import_rows(f"{HDR}\n2026/1/5,食費\n", mapping)
+    assert errors == [(2, "amount")]
+    assert rows == []
+
+
+def test_blank_lines_are_skipped_but_counted() -> None:
+    text = f"{HDR}\n\n2026/1/5,食費,300,店\n   \n2026/13/1,食費,300,店\n"
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 300, "店")]
+    assert errors == [(5, "date")]
+
+
+def test_errors_are_listed_by_line_number_across_rows() -> None:
+    text = f"{HDR}\n2026/1/5,,300,店\n2026/1/6,食費,abc,店\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "category"), (3, "amount")]
+
+
+def test_empty_text_with_default_mapping_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows("")
