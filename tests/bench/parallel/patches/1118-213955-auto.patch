@@ -0,0 +1,70 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.dupes import find_duplicates
+
+
+def _e(
+    day: str = "2024-01-02", category: str = "食費", amount: int = 500, memo: str = ""
+) -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_duplicates([]) == []
+
+
+def test_single_row_has_no_duplicates() -> None:
+    assert find_duplicates([_e()]) == []
+
+
+def test_no_duplicates_when_all_rows_differ() -> None:
+    rows = [_e(amount=100), _e(amount=200), _e(category="交通費", amount=100)]
+    assert find_duplicates(rows) == []
+
+
+def test_identical_pair_is_reported() -> None:
+    assert find_duplicates([_e(), _e()]) == [(0, 1)]
+
+
+def test_pair_is_reported_with_indices_in_input_order_not_adjacent() -> None:
+    rows = [_e(amount=1), _e(amount=2), _e(amount=1)]
+    assert find_duplicates(rows) == [(0, 2)]
+
+
+def test_differing_day_is_not_duplicate() -> None:
+    assert find_duplicates([_e(day="2024-01-02"), _e(day="2024-01-03")]) == []
+
+
+def test_differing_category_is_not_duplicate() -> None:
+    assert find_duplicates([_e(category="食費"), _e(category="日用品")]) == []
+
+
+def test_differing_amount_is_not_duplicate() -> None:
+    assert find_duplicates([_e(amount=500), _e(amount=501)]) == []
+
+
+def test_differing_memo_is_not_duplicate() -> None:
+    assert find_duplicates([_e(memo="a"), _e(memo="b")]) == []
+
+
+def test_empty_memo_versus_nonempty_memo_is_not_duplicate() -> None:
+    assert find_duplicates([_e(memo=""), _e(memo="x")]) == []
+
+
+def test_three_identical_rows_yield_all_pairs_sorted() -> None:
+    rows = [_e(), _e(), _e()]
+    assert find_duplicates(rows) == [(0, 1), (0, 2), (1, 2)]
+
+
+def test_result_sorted_by_i_then_j() -> None:
+    # 0 and 3 match; 1 and 2 match. Expect (0,3) before (1,2).
+    rows = [_e(amount=1), _e(amount=2), _e(amount=2), _e(amount=1)]
+    assert find_duplicates(rows) == [(0, 3), (1, 2)]
+
+
+def test_only_equal_groups_are_paired_across_mixed_rows() -> None:
+    rows = [_e(amount=1), _e(amount=1), _e(amount=2), _e(amount=1), _e(amount=2)]
+    assert find_duplicates(rows) == [(0, 1), (0, 3), (1, 3), (2, 4)]
