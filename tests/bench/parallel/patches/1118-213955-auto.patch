index 0000000..76cb4e9
--- /dev/null
+++ b/tests/test_streak.py
@@ -0,0 +1,77 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.streak import longest_no_spend_streak
+
+
+def _exp(day: date, amount: int = 100) -> Expense:
+    return Expense(day=day, category="food", amount=amount, memo="")
+
+
+def test_no_rows_returns_whole_period_length() -> None:
+    assert longest_no_spend_streak([], date(2024, 1, 1), date(2024, 1, 5)) == 5
+
+
+def test_every_day_has_spend_returns_zero() -> None:
+    rows = [_exp(date(2024, 1, d)) for d in range(1, 6)]
+    assert longest_no_spend_streak(rows, date(2024, 1, 1), date(2024, 1, 5)) == 0
+
+
+def test_longest_run_in_middle_of_period() -> None:
+    # spend on day 2 only -> no-spend runs: [1] and [3,4,5]
+    rows = [_exp(date(2024, 1, 2))]
+    assert longest_no_spend_streak(rows, date(2024, 1, 1), date(2024, 1, 5)) == 3
+
+
+def test_multiple_expenses_on_same_day_count_as_one_spending_day() -> None:
+    # spend on days 1 and 3 (day 1 twice) -> no-spend runs: [2] and [4,5]
+    rows = [_exp(date(2024, 1, 1)), _exp(date(2024, 1, 1), 200), _exp(date(2024, 1, 3))]
+    assert longest_no_spend_streak(rows, date(2024, 1, 1), date(2024, 1, 5)) == 2
+
+
+def test_rows_outside_period_are_ignored() -> None:
+    rows = [_exp(date(2023, 12, 31)), _exp(date(2024, 1, 6))]
+    assert longest_no_spend_streak(rows, date(2024, 1, 1), date(2024, 1, 5)) == 5
+
+
+def test_single_day_period_without_spend_returns_one() -> None:
+    assert longest_no_spend_streak([], date(2024, 1, 1), date(2024, 1, 1)) == 1
+
+
+def test_single_day_period_with_spend_returns_zero() -> None:
+    rows = [_exp(date(2024, 1, 1))]
+    assert longest_no_spend_streak(rows, date(2024, 1, 1), date(2024, 1, 1)) == 0
+
+
+def test_start_after_end_returns_zero() -> None:
+    assert longest_no_spend_streak([], date(2024, 1, 5), date(2024, 1, 1)) == 0
+
+
+def test_start_and_end_days_are_included() -> None:
+    # spend on both ends -> only the middle three days are no-spend
+    rows = [_exp(date(2024, 1, 1)), _exp(date(2024, 1, 5))]
+    assert longest_no_spend_streak(rows, date(2024, 1, 1), date(2024, 1, 5)) == 3
+
+
+def test_ties_return_the_common_length() -> None:
+    # spend on day 3 -> runs [1,2] and [4,5], both length 2
+    rows = [_exp(date(2024, 1, 3))]
+    assert longest_no_spend_streak(rows, date(2024, 1, 1), date(2024, 1, 5)) == 2
+
+
+def test_unsorted_rows_give_same_result() -> None:
+    # spend on 1, 2, 4 -> no-spend days 3 and 5, so longest run is 1
+    rows = [_exp(date(2024, 1, 4)), _exp(date(2024, 1, 1)), _exp(date(2024, 1, 2))]
+    assert longest_no_spend_streak(rows, date(2024, 1, 1), date(2024, 1, 5)) == 1
+
+
+def test_zero_amount_record_still_counts_as_spending_day() -> None:
+    # a 明細 with amount 0 is still a record on that day
+    rows = [_exp(date(2024, 1, 2), amount=0)]
+    assert longest_no_spend_streak(rows, date(2024, 1, 1), date(2024, 1, 5)) == 3
+
+
+def test_run_crosses_month_boundary() -> None:
+    # spend on 2024-01-31 -> no-spend: Jan 30 (1 day), Feb 1-2 (2 days)
+    rows = [_exp(date(2024, 1, 31))]
+    assert longest_no_spend_streak(rows, date(2024, 1, 30), date(2024, 2, 2)) == 2
diff --git a/tests/test_topn.py b/tests/test_topn.py
new file mode 100644
index 0000000..b06498c
--- /dev/null
+++ b/tests/test_topn.py
@@ -0,0 +1,61 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.topn import top_expenses
+
+
+def _e(day: str, amount: int, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category="食費", amount=amount, memo=memo
+    )
+
+
+def test_empty_input_returns_empty() -> None:
+    assert top_expenses([], 3) == []
+
+
+def test_returns_largest_amounts_first() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 500), _e("2026-01-03", 300)]
+    assert [e.amount for e in top_expenses(rows, 2)] == [500, 300]
+
+
+def test_n_larger_than_input_returns_all_sorted() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 500)]
+    assert [e.amount for e in top_expenses(rows, 10)] == [500, 100]
+
+
+def test_n_zero_returns_empty() -> None:
+    rows = [_e("2026-01-01", 100)]
+    assert top_expenses(rows, 0) == []
+
+
+def test_negative_n_returns_empty() -> None:
+    rows = [_e("2026-01-01", 100)]
+    assert top_expenses(rows, -1) == []
+
+
+def test_same_amount_orders_by_earlier_date() -> None:
+    late = _e("2026-03-01", 500, "late")
+    early = _e("2026-01-01", 500, "early")
+    assert top_expenses([late, early], 2) == [early, late]
+
+
+def test_same_amount_and_date_keeps_input_order() -> None:
+    first = _e("2026-01-01", 500, "first")
+    second = _e("2026-01-01", 500, "second")
+    assert top_expenses([first, second], 2) == [first, second]
+    assert top_expenses([second, first], 2) == [second, first]
+
+
+def test_does_not_modify_input_list() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 500)]
+    snapshot = list(rows)
+    top_expenses(rows, 1)
+    assert rows == snapshot
+
+
+def test_n_limits_result_length() -> None:
+    rows = [_e(f"2026-01-{d:02d}", d * 10) for d in range(1, 6)]
+    result = top_expenses(rows, 3)
+    assert len(result) == 3
+    assert [e.amount for e in result] == [50, 40, 30]
diff --git a/tests/test_weekday.py b/tests/test_weekday.py
new file mode 100644
index 0000000..57b98a4
--- /dev/null
+++ b/tests/test_weekday.py
@@ -0,0 +1,76 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.weekday import total_by_weekday
+
+
+def _e(day: date, amount: int, category: str = "food") -> Expense:
+    return Expense(day=day, category=category, amount=amount)
+
+
+def test_empty_rows_returns_empty_dict() -> None:
+    assert total_by_weekday([]) == {}
+
+
+def test_single_row_maps_to_its_weekday() -> None:
+    # 2026-11-16 is a Monday
+    assert total_by_weekday([_e(date(2026, 11, 16), 500)]) == {"Mon": 500}
+
+
+def test_same_weekday_across_weeks_is_summed() -> None:
+    rows = [_e(date(2026, 11, 16), 500), _e(date(2026, 11, 23), 300)]
+    assert total_by_weekday(rows) == {"Mon": 800}
+
+
+def test_amounts_on_same_day_are_summed_regardless_of_category() -> None:
+    rows = [
+        _e(date(2026, 11, 20), 100, "food"),
+        _e(date(2026, 11, 20), 250, "travel"),
+    ]
+    assert total_by_weekday(rows) == {"Fri": 350}
+
+
+def test_weekdays_without_expenses_are_omitted() -> None:
+    rows = [_e(date(2026, 11, 16), 500), _e(date(2026, 11, 18), 200)]
+    result = total_by_weekday(rows)
+    assert result == {"Mon": 500, "Wed": 200}
+    assert "Tue" not in result
+    assert "Sun" not in result
+
+
+def test_keys_are_in_monday_first_order_regardless_of_input_order() -> None:
+    rows = [
+        _e(date(2026, 11, 22), 1),  # Sun
+        _e(date(2026, 11, 18), 2),  # Wed
+        _e(date(2026, 11, 16), 3),  # Mon
+        _e(date(2026, 11, 21), 4),  # Sat
+    ]
+    result = total_by_weekday(rows)
+    assert list(result) == ["Mon", "Wed", "Sat", "Sun"]
+    assert result == {"Mon": 3, "Wed": 2, "Sat": 4, "Sun": 1}
+
+
+def test_all_seven_weekdays_present() -> None:
+    rows = [_e(date(2026, 11, 16 + i), 10 * (i + 1)) for i in range(7)]
+    result = total_by_weekday(rows)
+    assert list(result) == ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
+    assert result == {
+        "Mon": 10,
+        "Tue": 20,
+        "Wed": 30,
+        "Thu": 40,
+        "Fri": 50,
+        "Sat": 60,
+        "Sun": 70,
+    }
+
+
+def test_zero_amount_rows_still_appear() -> None:
+    # The weekday has a 明細 (row), so it is not omitted even though its total is 0.
+    assert total_by_weekday([_e(date(2026, 11, 17), 0)]) == {"Tue": 0}
+
+
+def test_input_list_is_not_modified() -> None:
+    rows = [_e(date(2026, 11, 16), 5)]
+    total_by_weekday(rows)
+    assert rows == [_e(date(2026, 11, 16), 5)]
