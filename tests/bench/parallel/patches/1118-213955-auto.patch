+"""Tests for kakeibo.fmt.yen."""
+
+from __future__ import annotations
+
+import pytest
+
+from kakeibo.fmt import yen
+
+
+def test_thousands_separator_and_suffix() -> None:
+    assert yen(1234567) == "1,234,567円"
+
+
+def test_zero() -> None:
+    assert yen(0) == "0円"
+
+
+def test_negative_keeps_sign_outside_grouping() -> None:
+    assert yen(-1200) == "-1,200円"
+
+
+def test_below_one_thousand_has_no_separator() -> None:
+    assert yen(999) == "999円"
+
+
+def test_exactly_one_thousand() -> None:
+    assert yen(1000) == "1,000円"
+
+
+def test_negative_below_one_thousand() -> None:
+    assert yen(-999) == "-999円"
+
+
+@pytest.mark.parametrize(
+    ("n", "expected"),
+    [
+        (1, "1円"),
+        (10, "10円"),
+        (100, "100円"),
+        (10_000, "10,000円"),
+        (1_000_000, "1,000,000円"),
+        (-1_000_000, "-1,000,000円"),
+    ],
+)
+def test_grouping_boundaries(n: int, expected: str) -> None:
+    assert yen(n) == expected
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..bd5b786
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,230 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def E(d: str, cat: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(d), category=cat, amount=amount)
+
+
+ROWS = [
+    E("2026-01-05", "食費", 1000),
+    E("2026-01-20", "食費", 500),
+    E("2026-01-10", "交通", 300),
+    E("2026-01-11", "娯楽", 0),
+    E("2026-02-03", "食費", 1800),
+    E("2026-02-04", "日用品", 400),
+    E("2026-02-05", "交通", 300),
+    E("2026-02-06", "娯楽", 0),
+]
+
+
+def _by_cat(diffs: list[DiffRow]) -> dict[str, DiffRow]:
+    return {d.category: d for d in diffs}
+
+
+# --- month_diff ------------------------------------------------------------
+
+
+def test_month_diff_values_and_status() -> None:
+    got = _by_cat(month_diff(ROWS, "2026-01", "2026-02"))
+    assert got["食費"] == DiffRow("食費", 1500, 1800, 300, 20.0, "up")
+    assert got["日用品"] == DiffRow("日用品", 0, 400, 400, None, "new")
+    assert got["交通"] == DiffRow("交通", 300, 300, 0, 0.0, "same")
+
+
+def test_month_diff_gone_and_down() -> None:
+    rows = [
+        E("2026-01-01", "食費", 1000),
+        E("2026-01-02", "娯楽", 500),
+        E("2026-02-01", "食費", 200),
+    ]
+    got = _by_cat(month_diff(rows, "2026-01", "2026-02"))
+    assert got["娯楽"] == DiffRow("娯楽", 500, 0, -500, -100.0, "gone")
+    assert got["食費"] == DiffRow("食費", 1000, 200, -800, -80.0, "down")
+
+
+def test_status_uses_presence_not_zero_sum() -> None:
+    # 明細はあるが合計 0: prev に明細があるので new にはならない
+    rows = [E("2026-01-01", "娯楽", 0), E("2026-02-01", "娯楽", 0)]
+    got = month_diff(rows, "2026-01", "2026-02")
+    assert got == [DiffRow("娯楽", 0, 0, 0, None, "same")]
+
+
+def test_zero_prev_with_curr_but_prev_has_zero_entries_is_not_new() -> None:
+    rows = [E("2026-01-01", "娯楽", 0), E("2026-02-01", "娯楽", 300)]
+    got = month_diff(rows, "2026-01", "2026-02")
+    assert got == [DiffRow("娯楽", 0, 300, 300, None, "up")]
+
+
+def test_pct_rounded_to_one_decimal() -> None:
+    rows = [E("2026-01-01", "食費", 3), E("2026-02-01", "食費", 4)]
+    got = month_diff(rows, "2026-01", "2026-02")
+    assert got[0].pct == round(1 / 3 * 100, 1)
+
+
+def test_pct_zero_delta_is_positive_zero() -> None:
+    rows = [E("2026-01-01", "食費", 100), E("2026-02-01", "食費", 100)]
+    (row,) = month_diff(rows, "2026-01", "2026-02")
+    assert row.pct == 0.0
+    assert str(row.pct) == "0.0"
+
+
+def test_empty_rows_gives_empty_list() -> None:
+    assert month_diff([], "2026-01", "2026-02") == []
+
+
+def test_same_month_both_sides_is_all_same() -> None:
+    got = month_diff(ROWS, "2026-01", "2026-01")
+    assert all(r.status == "same" and r.delta == 0 for r in got)
+
+
+def test_sort_by_abs_delta_desc_then_category_asc() -> None:
+    rows = [
+        E("2026-01-01", "b", 100),
+        E("2026-01-01", "a", 300),
+        E("2026-02-01", "c", 200),  # new, abs 200
+        E("2026-02-01", "b", 0),  # 100 -> 0 : abs 100 (same key as a? no)
+    ]
+    got = [r.category for r in month_diff(rows, "2026-01", "2026-02")]
+    # a: |-300|, c: |200|, b: |-100|
+    assert got == ["a", "c", "b"]
+
+
+def test_sort_tie_breaks_by_category() -> None:
+    rows = [
+        E("2026-01-01", "z", 100),
+        E("2026-02-01", "a", 100),  # new 100
+        E("2026-02-01", "z", 200),  # up 100 -> abs 100
+    ]
+    got = [r.category for r in month_diff(rows, "2026-01", "2026-02")]
+    assert got == ["a", "z"]
+
+
+@pytest.mark.parametrize(
+    "prev,curr",
+    [
+        ("2026-1", "2026-02"),
+        ("2026-13", "2026-02"),
+        ("2026-00", "2026-02"),
+        ("2026-01", "2026/02"),
+        ("26-01", "2026-02"),
+        ("2026-01", ""),
+        ("2026-01-01", "2026-02"),
+    ],
+)
+def test_invalid_month_format_raises(prev: str, curr: str) -> None:
+    with pytest.raises(ValueError):
+        month_diff(ROWS, prev, curr)
+
+
+# --- top_movers ------------------------------------------------------------
+
+
+def test_top_movers_excludes_same_and_keeps_order() -> None:
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    got = top_movers(diffs, 10)
+    assert [r.category for r in got] == ["日用品", "食費"]
+    assert all(r.status != "same" for r in got)
+
+
+def test_top_movers_default_n_is_three() -> None:
+    diffs = [DiffRow(f"c{i}", 0, 1, 1, None, "new") for i in range(5)]
+    assert len(top_movers(diffs)) == 3
+
+
+def test_top_movers_takes_first_n() -> None:
+    diffs = [DiffRow(f"c{i}", 0, 1, 1, None, "new") for i in range(5)]
+    assert [r.category for r in top_movers(diffs, 2)] == ["c0", "c1"]
+
+
+def test_top_movers_zero_n_is_empty() -> None:
+    diffs = [DiffRow("a", 0, 1, 1, None, "new")]
+    assert top_movers(diffs, 0) == []
+
+
+def test_top_movers_negative_n_raises() -> None:
+    with pytest.raises(ValueError):
+        top_movers([], -1)
+
+
+def test_top_movers_n_larger_than_list() -> None:
+    diffs = [DiffRow("a", 0, 1, 1, None, "new")]
+    assert top_movers(diffs, 99) == diffs
+
+
+# --- render_diff -----------------------------------------------------------
+
+
+def test_render_header_and_rows() -> None:
+    diffs = [
+        DiffRow("食費", 1500, 1800, 300, 20.0, "up"),
+        DiffRow("娯楽", 500, 0, -500, -100.0, "gone"),
+        DiffRow("交通", 300, 300, 0, 0.0, "same"),
+        DiffRow("日用品", 0, 400, 400, None, "new"),
+    ]
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "食費\t1500\t1800\t+300\t+20.0%\n"
+        "娯楽\t500\t0\t-500\t-100.0%\n"
+        "交通\t300\t300\t+0\t+0.0%\n"
+        "日用品\t0\t400\t+400\t-"
+    )
+
+
+def test_render_no_trailing_newline() -> None:
+    out = render_diff([DiffRow("a", 1, 2, 1, 100.0, "up")])
+    assert not out.endswith("\n")
+
+
+def test_render_empty_is_header_only() -> None:
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_render_zero_pct_sign_when_prev_negative() -> None:
+    # 負の prev で delta 0 でも pct は -0.0 にならず +0.0% と出る
+    rows = [E("2026-01-01", "a", -5), E("2026-02-01", "a", -5)]
+    diffs = month_diff(rows, "2026-01", "2026-02")
+    assert render_diff(diffs).splitlines()[1].endswith("\t+0.0%")
+
+
+# --- available_months / latest_diff ---------------------------------------
+
+
+def test_available_months_sorted_unique() -> None:
+    rows = [
+        E("2026-03-01", "a", 1),
+        E("2026-01-01", "a", 1),
+        E("2026-03-09", "b", 1),
+        E("2025-12-31", "a", 1),
+    ]
+    assert available_months(rows) == ["2025-12", "2026-01", "2026-03"]
+
+
+def test_available_months_empty() -> None:
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months() -> None:
+    rows = ROWS + [E("2026-03-01", "食費", 900)]
+    got = latest_diff(rows)
+    assert got == month_diff(rows, "2026-02", "2026-03")
+
+
+def test_latest_diff_fewer_than_two_months_raises() -> None:
+    with pytest.raises(ValueError):
+        latest_diff([E("2026-01-01", "a", 1), E("2026-01-02", "a", 2)])
+    with pytest.raises(ValueError):
+        latest_diff([])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..01c4a67
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,213 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+ROWS = [
+    Expense(date(2026, 1, 5), "食費", 1200, "ランチ 定食"),
+    Expense(date(2026, 1, 6), "交通費", 300, "電車"),
+    Expense(date(2026, 2, 1), "Food", 800, "coffee"),
+    Expense(date(2026, 2, 2), "食費", 0, ""),
+]
+
+
+# --- tokenize ---------------------------------------------------------------
+
+
+def test_tokenize_empty_and_whitespace_only_gives_no_tokens() -> None:
+    assert tokenize("") == []
+    assert tokenize(" \t\n ") == []
+
+
+def test_tokenize_parens_and_words() -> None:
+    assert tokenize("a(b)") == [
+        ("TERM", "a"),
+        ("LPAREN", "("),
+        ("TERM", "b"),
+        ("RPAREN", ")"),
+    ]
+
+
+def test_tokenize_operators_are_uppercase_only() -> None:
+    assert tokenize("AND OR NOT and or not") == [
+        ("AND", "AND"),
+        ("OR", "OR"),
+        ("NOT", "NOT"),
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_quoted_keeps_spaces_and_parens() -> None:
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+
+
+def test_tokenize_quoted_keyword_is_plain_term() -> None:
+    assert tokenize('"AND"') == [("TERM", "AND")]
+
+
+def test_tokenize_unclosed_quote_raises() -> None:
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_raises() -> None:
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_cat_prefix() -> None:
+    assert tokenize("cat:食費") == [("CAT", "食費")]
+
+
+def test_tokenize_cat_with_empty_value_raises() -> None:
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+    with pytest.raises(QueryError):
+        tokenize("cat:)")
+
+
+def test_tokenize_cat_prefix_is_case_sensitive() -> None:
+    assert tokenize("CAT:食費") == [("TERM", "CAT:食費")]
+
+
+def test_tokenize_word_stops_at_quote() -> None:
+    assert tokenize('ab"cd"') == [("TERM", "ab"), ("TERM", "cd")]
+
+
+def test_tokenize_cat_followed_by_quote_is_error() -> None:
+    # 語は引用符の手前で終わるので "cat:" の値が空になる
+    with pytest.raises(QueryError):
+        tokenize('cat:"食費"')
+
+
+# --- syntax errors ----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "( )",
+        "(a",
+        "a)",
+        ")",
+        "a ) b",
+        "a (b",
+        "a OR",
+        "OR a",
+        "a OR OR b",
+        "a AND",
+        "AND a",
+        "a AND AND b",
+        "NOT",
+        "NOT )",
+        "a ()",
+        "(a OR)",
+        '"ab',
+        "cat:",
+    ],
+)
+def test_syntax_errors_raise(q: str) -> None:
+    with pytest.raises(QueryError):
+        matches(q, ROWS[0])
+
+
+def test_filter_rows_with_invalid_query_raises_even_when_rows_empty() -> None:
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
+
+
+def test_filter_rows_with_valid_query_and_empty_rows_is_empty() -> None:
+    assert filter_rows("食費", []) == []
+
+
+# --- matching ---------------------------------------------------------------
+
+
+def test_matches_returns_bool() -> None:
+    assert matches("電車", ROWS[1]) is True
+    assert matches("電車", ROWS[0]) is False
+
+
+def test_term_matches_memo_substring() -> None:
+    assert filter_rows("ランチ", ROWS) == [ROWS[0]]
+
+
+def test_term_matches_category_substring() -> None:
+    assert filter_rows("交通", ROWS) == [ROWS[1]]
+
+
+def test_term_is_case_insensitive() -> None:
+    assert filter_rows("COFFEE", ROWS) == [ROWS[2]]
+
+
+def test_term_on_empty_memo_only_matches_category() -> None:
+    assert filter_rows("食費", ROWS) == [ROWS[0], ROWS[3]]
+
+
+def test_cat_is_exact_full_match_on_category() -> None:
+    assert filter_rows("cat:食費", ROWS) == [ROWS[0], ROWS[3]]
+    assert filter_rows("cat:食", ROWS) == []
+    assert filter_rows("cat:ランチ", ROWS) == []
+
+
+def test_cat_is_case_insensitive() -> None:
+    assert filter_rows("cat:food", ROWS) == [ROWS[2]]
+    assert filter_rows("cat:FOOD", ROWS) == [ROWS[2]]
+
+
+def test_quoted_term_with_space_matches_memo() -> None:
+    assert filter_rows('"ランチ 定食"', ROWS) == [ROWS[0]]
+
+
+def test_quoted_keyword_matches_literal_text() -> None:
+    row = Expense(date(2026, 3, 1), "雑費", 10, "x OR y")
+    assert matches('"OR"', row) is True
+    assert matches('"AND"', row) is False
+
+
+def test_implicit_and_between_terms() -> None:
+    assert filter_rows("食費 ランチ", ROWS) == [ROWS[0]]
+
+
+def test_explicit_and() -> None:
+    assert filter_rows("食費 AND 定食", ROWS) == [ROWS[0]]
+
+
+def test_or_keeps_input_order() -> None:
+    assert filter_rows("電車 OR coffee", ROWS) == [ROWS[1], ROWS[2]]
+
+
+def test_not_negates_cat() -> None:
+    assert filter_rows("NOT cat:食費", ROWS) == [ROWS[1], ROWS[2]]
+
+
+def test_double_not() -> None:
+    assert filter_rows("NOT NOT cat:食費", ROWS) == [ROWS[0], ROWS[3]]
+
+
+def test_not_binds_tighter_than_and() -> None:
+    # (NOT 電車) AND 食費
+    assert filter_rows("NOT 電車 食費", ROWS) == [ROWS[0], ROWS[3]]
+
+
+def test_and_binds_tighter_than_or() -> None:
+    # 電車 OR (coffee AND ランチ)
+    assert filter_rows("電車 OR coffee ランチ", ROWS) == [ROWS[1]]
+
+
+def test_parentheses_override_precedence() -> None:
+    # (電車 OR coffee) AND NOT cat:Food
+    assert filter_rows("(電車 OR coffee) NOT cat:Food", ROWS) == [ROWS[1]]
+
+
+def test_not_applies_to_parenthesized_group() -> None:
+    assert filter_rows("NOT (電車 OR coffee)", ROWS) == [ROWS[0], ROWS[3]]
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..55f06fb
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,221 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def _e(
+    day: date, category: str = "通信", amount: int = 1000, memo: str = ""
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- add_month ---
+
+
+def test_add_month_same_day_next_month() -> None:
+    assert add_month(date(2026, 1, 15)) == date(2026, 2, 15)
+
+
+def test_add_month_wraps_year_from_december() -> None:
+    assert add_month(date(2026, 12, 15)) == date(2027, 1, 15)
+
+
+def test_add_month_clamps_to_end_of_short_month() -> None:
+    assert add_month(date(2026, 1, 31)) == date(2026, 2, 28)
+
+
+def test_add_month_clamps_to_leap_day() -> None:
+    assert add_month(date(2024, 1, 31)) == date(2024, 2, 29)
+
+
+def test_add_month_clamps_from_31_to_30_day_month() -> None:
+    assert add_month(date(2026, 3, 31)) == date(2026, 4, 30)
+
+
+# --- find_recurring: argument validation ---
+
+
+def test_min_count_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+
+
+def test_negative_tolerance_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_tolerance_zero_is_allowed() -> None:
+    rows = [_e(date(2026, 1, 15)), _e(date(2026, 2, 15)), _e(date(2026, 3, 15))]
+    assert len(find_recurring(rows, min_count=3, tolerance=0)) == 1
+
+
+def test_min_count_two_is_allowed() -> None:
+    rows = [_e(date(2026, 1, 15)), _e(date(2026, 2, 15))]
+    assert len(find_recurring(rows, min_count=2)) == 1
+
+
+# --- find_recurring: basic behavior ---
+
+
+def test_empty_input_returns_empty() -> None:
+    assert find_recurring([]) == []
+
+
+def test_monthly_series_detected() -> None:
+    rows = [_e(date(2026, 1, 15)), _e(date(2026, 2, 15)), _e(date(2026, 3, 15))]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="通信",
+            amount=1000,
+            days=(date(2026, 1, 15), date(2026, 2, 15), date(2026, 3, 15)),
+            next_expected=date(2026, 4, 15),
+        )
+    ]
+
+
+def test_next_expected_uses_add_month_of_last_day() -> None:
+    rows = [_e(date(2026, 1, 31)), _e(date(2026, 2, 28)), _e(date(2026, 3, 31))]
+    (r,) = find_recurring(rows)
+    assert r.next_expected == date(2026, 4, 30)
+
+
+def test_memo_is_ignored_for_grouping() -> None:
+    rows = [
+        _e(date(2026, 1, 15), memo="a"),
+        _e(date(2026, 2, 15), memo="b"),
+        _e(date(2026, 3, 15), memo=""),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_below_min_count_returns_empty() -> None:
+    rows = [_e(date(2026, 1, 15)), _e(date(2026, 2, 15))]
+    assert find_recurring(rows, min_count=3) == []
+
+
+def test_duplicate_dates_are_counted_once() -> None:
+    rows = [_e(date(2026, 1, 15)), _e(date(2026, 1, 15)), _e(date(2026, 2, 15))]
+    assert find_recurring(rows, min_count=3) == []
+
+
+def test_unsorted_input_is_sorted_into_days() -> None:
+    rows = [_e(date(2026, 3, 15)), _e(date(2026, 1, 15)), _e(date(2026, 2, 15))]
+    (r,) = find_recurring(rows)
+    assert r.days == (date(2026, 1, 15), date(2026, 2, 15), date(2026, 3, 15))
+
+
+def test_different_amounts_are_separate_groups() -> None:
+    rows = [
+        _e(date(2026, 1, 15), amount=1000),
+        _e(date(2026, 2, 15), amount=1000),
+        _e(date(2026, 3, 15), amount=1000),
+        _e(date(2026, 1, 20), amount=500),
+        _e(date(2026, 2, 20), amount=500),
+    ]
+    result = find_recurring(rows)
+    assert [r.amount for r in result] == [1000]
+
+
+def test_different_categories_are_separate_groups() -> None:
+    rows = [
+        _e(date(2026, 1, 15), category="家賃"),
+        _e(date(2026, 2, 15), category="家賃"),
+        _e(date(2026, 3, 15), category="通信"),
+    ]
+    assert find_recurring(rows) == []
+
+
+# --- find_recurring: runs and gaps ---
+
+
+def test_gap_splits_series_into_runs() -> None:
+    # Jan-Mar と May-Jul の 2 区間に分かれる(Apr が抜けている)
+    rows = [
+        _e(date(2026, 1, 15)),
+        _e(date(2026, 2, 15)),
+        _e(date(2026, 3, 15)),
+        _e(date(2026, 5, 15)),
+        _e(date(2026, 6, 15)),
+        _e(date(2026, 7, 15)),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 15), date(2026, 5, 15)]
+    assert result[0].next_expected == date(2026, 4, 15)
+    assert result[1].next_expected == date(2026, 8, 15)
+
+
+def test_run_shorter_than_min_count_is_dropped_but_others_kept() -> None:
+    rows = [
+        _e(date(2026, 1, 15)),
+        _e(date(2026, 2, 15)),
+        _e(date(2026, 4, 15)),
+        _e(date(2026, 5, 15)),
+        _e(date(2026, 6, 15)),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 4, 15)]
+
+
+def test_tolerance_allows_small_drift() -> None:
+    # 1/31 → 2/28(月末補正) → 3/31: 2/28 から見た翌月は 3/28 で、3/31 とは 3 日ずれる
+    rows = [_e(date(2026, 1, 31)), _e(date(2026, 2, 28)), _e(date(2026, 3, 31))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+
+
+def test_drift_beyond_tolerance_breaks_run() -> None:
+    rows = [_e(date(2026, 1, 31)), _e(date(2026, 2, 28)), _e(date(2026, 3, 31))]
+    assert find_recurring(rows, tolerance=2) == []
+
+
+def test_chain_compares_against_add_month_not_previous_day() -> None:
+    # 2/28 の翌月は 3/28。3/31 との差は 3 日なので tolerance=3 で連続扱い。
+    # 比較が「前の日付そのもの」基準だと 2/28→3/31 は 31 日差で切れてしまう。
+    rows = [_e(date(2026, 1, 28)), _e(date(2026, 2, 28)), _e(date(2026, 3, 31))]
+    (r,) = find_recurring(rows, tolerance=3)
+    assert r.days == (date(2026, 1, 28), date(2026, 2, 28), date(2026, 3, 31))
+
+
+def test_run_of_exactly_min_count_is_kept() -> None:
+    rows = [_e(date(2026, 1, 15)), _e(date(2026, 2, 15)), _e(date(2026, 3, 15))]
+    assert len(find_recurring(rows, min_count=3)) == 1
+
+
+# --- find_recurring: ordering ---
+
+
+def test_results_sorted_by_category_amount_then_first_day() -> None:
+    rows: list[Expense] = []
+    # 通信 500 (2 本目の区間が早い日付から始まる)
+    for d in (date(2026, 4, 1), date(2026, 5, 1), date(2026, 6, 1)):
+        rows.append(_e(d, category="通信", amount=500))
+    # 家賃 1000
+    for d in (date(2026, 1, 1), date(2026, 2, 1), date(2026, 3, 1)):
+        rows.append(_e(d, category="家賃", amount=1000))
+    # 通信 300
+    for d in (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)):
+        rows.append(_e(d, category="通信", amount=300))
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [
+        ("家賃", 1000),
+        ("通信", 300),
+        ("通信", 500),
+    ]
+
+
+def test_same_group_multiple_runs_sorted_by_first_day() -> None:
+    rows = [
+        _e(date(2026, 5, 15)),
+        _e(date(2026, 6, 15)),
+        _e(date(2026, 7, 15)),
+        _e(date(2026, 1, 15)),
+        _e(date(2026, 2, 15)),
+        _e(date(2026, 3, 15)),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 15), date(2026, 5, 15)]
diff --git a/tests/test_split.py b/tests/test_split.py
new file mode 100644
index 0000000..da66aa5
--- /dev/null
+++ b/tests/test_split.py
@@ -0,0 +1,46 @@
+import pytest
+
+from kakeibo.split import split_evenly
+
+
+def test_even_split_has_no_remainder() -> None:
+    assert split_evenly(900, 3) == [300, 300, 300]
+
+
+def test_remainder_goes_to_first_people_one_yen_each() -> None:
+    assert split_evenly(10, 3) == [4, 3, 3]
+    assert split_evenly(11, 3) == [4, 4, 3]
+
+
+def test_single_person_gets_everything() -> None:
+    assert split_evenly(1234, 1) == [1234]
+
+
+def test_zero_amount_gives_all_zeros() -> None:
+    assert split_evenly(0, 4) == [0, 0, 0, 0]
+
+
+def test_more_people_than_yen_gives_ones_then_zeros() -> None:
+    assert split_evenly(2, 5) == [1, 1, 0, 0, 0]
+
+
+def test_amount_equal_to_people_gives_all_ones() -> None:
+    assert split_evenly(4, 4) == [1, 1, 1, 1]
+
+
+@pytest.mark.parametrize("amount", [0, 1, 7, 999, 10_000])
+@pytest.mark.parametrize("people", [1, 2, 3, 7])
+def test_sum_always_equals_amount_and_shares_differ_by_at_most_one(
+    amount: int, people: int
+) -> None:
+    shares = split_evenly(amount, people)
+    assert len(shares) == people
+    assert sum(shares) == amount
+    assert max(shares) - min(shares) <= 1
+    assert shares == sorted(shares, reverse=True)
+
+
+@pytest.mark.parametrize("people", [0, -1])
+def test_people_below_one_raises_value_error(people: int) -> None:
+    with pytest.raises(ValueError):
+        split_evenly(100, people)
diff --git a/tests/test_stats.py b/tests/test_stats.py
new file mode 100644
index 0000000..a0f0f81
--- /dev/null
+++ b/tests/test_stats.py
@@ -0,0 +1,64 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.stats import median_by_category
+
+
+def _e(category: str, amount: int) -> Expense:
+    return Expense(day=date(2026, 11, 1), category=category, amount=amount)
+
+
+def test_empty_rows_returns_empty_dict():
+    assert median_by_category([]) == {}
+
+
+def test_single_row_median_is_its_amount():
+    assert median_by_category([_e("food", 500)]) == {"food": 500.0}
+
+
+def test_odd_count_takes_middle_value_regardless_of_input_order():
+    rows = [_e("food", 300), _e("food", 100), _e("food", 200)]
+    assert median_by_category(rows) == {"food": 200.0}
+
+
+def test_even_count_averages_two_middle_values():
+    rows = [_e("food", 100), _e("food", 300)]
+    result = median_by_category(rows)
+    assert result == {"food": 200.0}
+    assert isinstance(result["food"], float)
+
+
+def test_even_count_with_four_values_averages_middle_two():
+    rows = [_e("food", 400), _e("food", 100), _e("food", 300), _e("food", 200)]
+    assert median_by_category(rows) == {"food": 250.0}
+
+
+def test_identical_values_give_that_value():
+    rows = [_e("food", 700), _e("food", 700), _e("food", 700)]
+    assert median_by_category(rows) == {"food": 700.0}
+
+
+def test_each_category_is_computed_separately():
+    rows = [
+        _e("food", 100),
+        _e("rent", 90000),
+        _e("food", 300),
+        _e("rent", 90000),
+        _e("transport", 50),
+    ]
+    assert median_by_category(rows) == {
+        "food": 200.0,
+        "rent": 90000.0,
+        "transport": 50.0,
+    }
+
+
+def test_keys_are_sorted_by_category_name_ascending():
+    rows = [_e("transport", 50), _e("food", 100), _e("rent", 90000)]
+    result = median_by_category(rows)
+    assert list(result) == ["food", "rent", "transport"]
+
+
+def test_keys_sorted_ascending_not_by_amount():
+    rows = [_e("b", 1), _e("a", 999)]
+    assert list(median_by_category(rows)) == ["a", "b"]
