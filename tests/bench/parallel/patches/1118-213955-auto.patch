@@ -0,0 +1,27 @@
+"""No-spend streak calculation."""
+
+from __future__ import annotations
+
+from datetime import date, timedelta
+
+from kakeibo.core import Expense
+
+
+def longest_no_spend_streak(rows: list[Expense], start: date, end: date) -> int:
+    """Longest run of consecutive days in [start, end] with no expense record.
+
+    Both ends are inclusive. Rows outside the period are ignored.
+    Returns 0 when start is after end.
+    """
+    spend_days = {e.day for e in rows if start <= e.day <= end}
+    longest = 0
+    current = 0
+    day = start
+    while day <= end:
+        if day in spend_days:
+            current = 0
+        else:
+            current += 1
+            longest = max(longest, current)
+        day += timedelta(days=1)
+    return longest
