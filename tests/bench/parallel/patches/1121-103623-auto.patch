+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import BankImportError, import_bank_csv
+from kakeibo.core import Expense
+
+
+# 仕様の例の表 (E1-1 .. E1-3)
+@pytest.mark.parametrize(
+    ("text", "expected_expenses", "expected_errors"),
+    [
+        pytest.param(
+            '利用日,ご利用店名,利用金額\n2026/1/5,ＮＥＴＦＬＩＸ,"1,490円"',
+            [Expense(date(2026, 1, 5), "未分類", 1490, "NETFLIX")],
+            [],
+            id="E1-1",
+        ),
+        pytest.param("日付\t出金\t入金\n2026-01-05\t\t50000", [], [], id="E1-2"),
+        pytest.param(
+            "date,amount\n2026-02-30,12.5",
+            [],
+            [(2, "date"), (2, "amount")],
+            id="E1-3",
+        ),
+    ],
+)
+def test_spec_examples(
+    text: str,
+    expected_expenses: list[Expense],
+    expected_errors: list[tuple[int, str]],
+) -> None:
+    result = import_bank_csv(text)
+    assert result.expenses == expected_expenses
+    assert [(e.line, e.column) for e in result.errors] == expected_errors
+
+
+# R1: BOM・改行・区切り・引用・空行・ヘッダーのみ
+def test_r1_bom_is_removed_before_header_is_read() -> None:
+    result = import_bank_csv("﻿date,amount\n2026-01-05,100")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+@pytest.mark.parametrize("newline", ["\n", "\r\n", "\r"], ids=["LF", "CRLF", "CR"])
+def test_r1_line_endings(newline: str) -> None:
+    text = newline.join(["date,amount", "2026-01-05,100", "2026-01-06,200"])
+    result = import_bank_csv(text)
+    assert [e.amount for e in result.expenses] == [100, 200]
+
+
+def test_r1_tab_is_chosen_when_first_line_has_tab() -> None:
+    result = import_bank_csv("date\tamount\tmemo\n2026-01-05\t100\tx")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "x")]
+    assert result.errors == []
+
+
+def test_r1_quoted_newline_and_record_start_line() -> None:
+    text = 'date,amount,memo\n\n2026-01-05,100,"a\nb"\n2026-02-30,1,x'
+    result = import_bank_csv(text)
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "a\nb")]
+    # 1 行目ヘッダー、2 行目空行、3-4 行目が引用改行を含むレコード、5 行目が不正日付
+    assert [(e.line, e.column) for e in result.errors] == [(5, "date")]
+
+
+def test_r1_blank_lines_are_skipped() -> None:
+    result = import_bank_csv("date,amount\n\n2026-01-05,100\n\n")
+    assert len(result.expenses) == 1
+    assert result.errors == []
+
+
+def test_r1_header_only_gives_empty_result() -> None:
+    result = import_bank_csv("date,amount\n")
+    assert result.expenses == []
+    assert result.errors == []
+
+
+def test_r1_empty_input_raises() -> None:
+    with pytest.raises(BankImportError):
+        import_bank_csv("")
+
+
+# R2: 列名の別名・大文字小文字・既定カテゴリ
+@pytest.mark.parametrize(
+    "header",
+    ["Date,AMOUNT", "取引日,金額", " ご利用日 , ご利用金額 ", "日付,利用金額"],
+    ids=["english-case", "jp-plain", "jp-spaces", "mixed"],
+)
+def test_r2_header_aliases(header: str) -> None:
+    result = import_bank_csv(f"{header}\n2026-01-05,100")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+def test_r2_memo_and_category_columns_and_default_category() -> None:
+    text = "date,amount,摘要,カテゴリ\n2026-01-05,100,コンビニ,食費\n2026-01-06,200,,"
+    result = import_bank_csv(text, default_category="その他")
+    assert result.expenses == [
+        Expense(date(2026, 1, 5), "食費", 100, "コンビニ"),
+        Expense(date(2026, 1, 6), "その他", 200, ""),
+    ]
+
+
+def test_r2_missing_memo_and_category_columns_use_defaults() -> None:
+    result = import_bank_csv("date,amount\n2026-01-05,100", default_category="雑費")
+    assert result.expenses == [Expense(date(2026, 1, 5), "雑費", 100, "")]
+
+
+# R3: 金額の書き方
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        ("-300", -300),
+        ("−300", -300),  # U+2212 マイナス
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("+300", 300),
+        ("¥1,000", 1000),
+        ("￥1，000", 1000),
+        ("1,000円", 1000),
+        ("JPY 1,000", 1000),
+        ("12.0", 12),
+        ("12.00", 12),
+        ("１２３", 123),
+    ],
+    ids=[
+        "minus",
+        "u2212",
+        "triangle",
+        "black-triangle",
+        "parens",
+        "trailing-minus",
+        "plus",
+        "yen-mark",
+        "fullwidth-yen-and-comma",
+        "en-suffix",
+        "jpy",
+        "decimal-zero",
+        "decimal-00",
+        "fullwidth-digits",
+    ],
+)
+def test_r3_amount_forms(raw: str, expected: int) -> None:
+    # 「,」を含む値は引用して 1 列として渡す
+    result = import_bank_csv(f'date,amount\n2026-01-05,"{raw}"')
+    assert [e.amount for e in result.expenses] == [expected]
+    assert result.errors == []
+
+
+@pytest.mark.parametrize("raw", ["12.5", "abc", "--300", "(500-)"])
+def test_r3_invalid_amount_is_row_error(raw: str) -> None:
+    result = import_bank_csv(f"date,amount\n2026-01-05,{raw}")
+    assert result.expenses == []
+    assert [(e.line, e.column) for e in result.errors] == [(2, "amount")]
+
+
+@pytest.mark.parametrize("raw", ["", "-", "—"], ids=["empty", "hyphen", "em-dash"])
+def test_r3_empty_amount_is_row_error(raw: str) -> None:
+    result = import_bank_csv(f"date,amount\n2026-01-05,{raw}")
+    assert result.expenses == []
+    assert [e.column for e in result.errors] == ["amount"]
+
+
+# R4: 1 列 / 2 列 (出金・入金) の扱い
+def test_r4_single_column_negative_is_refund() -> None:
+    result = import_bank_csv("date,amount\n2026-01-05,-300")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", -300, "")]
+
+
+def test_r4_withdrawal_only_is_expense() -> None:
+    result = import_bank_csv("date,出金,入金\n2026-01-05,300,")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 300, "")]
+
+
+def test_r4_deposit_only_is_skipped_without_error() -> None:
+    result = import_bank_csv("date,出金,入金\n2026-01-05,,50000")
+    assert result.expenses == []
+    assert result.errors == []
+
+
+def test_r4_both_withdrawal_and_deposit_is_error() -> None:
+    result = import_bank_csv("date,出金,入金\n2026-01-05,300,50000")
+    assert result.expenses == []
+    assert [e.column for e in result.errors] == ["出金"]
+
+
+def test_r4_both_empty_is_error() -> None:
+    result = import_bank_csv("date,出金,入金\n2026-01-05,,")
+    assert result.expenses == []
+    assert len(result.errors) == 1
+
+
+def test_r4_amount_column_takes_precedence_over_withdrawal() -> None:
+    result = import_bank_csv("date,amount,出金\n2026-01-05,100,999")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+# R5: 日付の書き方
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026.1.5",
+        "20260105",
+        "2026年1月5日",
+        "2026-01-05 12:30",
+    ],
+    ids=["dash", "slash", "dot", "compact", "japanese", "with-time"],
+)
+def test_r5_date_forms(raw: str) -> None:
+    result = import_bank_csv(f"date,amount\n{raw},100")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+    assert result.errors == []
+
+
+@pytest.mark.parametrize(
+    "raw", ["2026-02-30", "令和8年1月5日"], ids=["no-such-day", "wareki"]
+)
+def test_r5_invalid_date_is_row_error(raw: str) -> None:
+    result = import_bank_csv(f"date,amount\n{raw},100")
+    assert result.expenses == []
+    assert [(e.line, e.column) for e in result.errors] == [(2, "date")]
+
+
+# R6: 列数の不一致と、1 行の複数エラー・正常行の継続
+def test_r6_column_count_mismatch_is_single_row_error() -> None:
+    result = import_bank_csv("date,amount\n2026-01-05,1,234円\n2026-01-06,300")
+    assert [(e.line, e.column) for e in result.errors] == [(2, "(行)")]
+    assert [e.amount for e in result.expenses] == [300]
+
+
+def test_r6_one_row_reports_every_field_error_separately() -> None:
+    result = import_bank_csv("date,amount\n2026-02-30,12.5")
+    assert [(e.line, e.column) for e in result.errors] == [(2, "date"), (2, "amount")]
+    assert result.expenses == []
+
+
+def test_r6_errors_do_not_stop_valid_rows() -> None:
+    text = "date,amount\n2026-02-30,1\n2026-01-05,100\nbad,2"
+    result = import_bank_csv(text)
+    assert [e.amount for e in result.expenses] == [100]
+    assert [(e.line, e.column) for e in result.errors] == [(2, "date"), (4, "date")]
+
+
+# ヘッダーが読めない場合
+@pytest.mark.parametrize(
+    ("text", "missing"),
+    [("memo,amount\n x,1", "日付"), ("date,memo\n2026-01-05,x", "金額")],
+    ids=["no-date", "no-amount"],
+)
+def test_missing_required_column_raises_with_column_name(
+    text: str, missing: str
+) -> None:
+    with pytest.raises(BankImportError, match=missing):
+        import_bank_csv(text)
