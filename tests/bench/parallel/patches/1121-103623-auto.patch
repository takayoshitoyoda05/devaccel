+++ b/tests/test_month_report.py
@@ -0,0 +1,124 @@
+from __future__ import annotations
+
+import pytest
+
+from kakeibo.month_report import CategoryChange, compare_months, format_report
+
+
+# E4-1: 前月 食費のみ、今月 食費+交通 -> 交通=new、食費=up (pct 10.0)
+# E4-2: 2026-01 にだけデータがあり month=2026-03 -> 前月 2026-02 は空、今月も空なら空リスト
+# E4-3: month=2026-13 -> ValueError
+@pytest.mark.parametrize(
+    ("case_id", "totals", "month", "expected"),
+    [
+        (
+            "E4-1",
+            {"2026-02": {"食費": 30000}, "2026-03": {"食費": 33000, "交通": 2000}},
+            "2026-03",
+            [
+                CategoryChange("食費", 30000, 33000, 3000, 10.0, "up"),
+                CategoryChange("交通", 0, 2000, 2000, None, "new"),
+            ],
+        ),
+        (
+            "E4-2",
+            {"2026-01": {"食費": 1000}},
+            "2026-03",
+            [],
+        ),
+    ],
+    ids=["E4-1", "E4-2"],
+)
+def test_example_table(case_id, totals, month, expected):
+    assert compare_months(totals, month) == expected
+
+
+def test_E4_3_invalid_month_raises():
+    with pytest.raises(ValueError):
+        compare_months({}, "2026-13")
+
+
+@pytest.mark.parametrize("bad", ["2026-1", "2026/03", "26-03", "2026-00", "2026-03 "])
+def test_R1_month_format_is_checked(bad):
+    with pytest.raises(ValueError):
+        compare_months({}, bad)
+
+
+def test_R1_january_compares_with_previous_december():
+    totals = {"2025-12": {"食費": 10000}, "2026-01": {"食費": 12000}}
+    [c] = compare_months(totals, "2026-01")
+    assert (c.previous, c.current, c.diff, c.status) == (10000, 12000, 2000, "up")
+    assert c.pct == 20.0
+
+
+def test_R1_both_months_empty_returns_empty_list():
+    assert compare_months({"2026-01": {"食費": 1}}, "2026-05") == []
+
+
+def test_R1_all_zero_categories_return_empty_list():
+    totals = {"2026-02": {"食費": 0}, "2026-03": {"食費": 0}}
+    assert compare_months(totals, "2026-03") == []
+
+
+def test_R2_zero_in_both_months_is_omitted():
+    totals = {
+        "2026-02": {"食費": 0, "家賃": 5000},
+        "2026-03": {"食費": 0, "家賃": 5000},
+    }
+    result = compare_months(totals, "2026-03")
+    assert [c.category for c in result] == ["家賃"]
+    assert result[0].status == "same"
+
+
+def test_R2_gone_category():
+    totals = {"2026-02": {"娯楽": 4000}, "2026-03": {}}
+    [c] = compare_months(totals, "2026-03")
+    assert (c.diff, c.pct, c.status) == (-4000, -100.0, "gone")
+
+
+def test_R2_sorted_by_abs_diff_then_name():
+    totals = {
+        "2026-02": {"b": 100, "a": 100, "c": 500},
+        "2026-03": {"b": 200, "a": 0, "c": 500},
+    }
+    names = [c.category for c in compare_months(totals, "2026-03")]
+    # abs(diff): a=100, b=100 (tie -> name asc), c=0 (same, last)
+    assert names == ["a", "b", "c"]
+
+
+def test_D6_pct_none_when_previous_is_negative():
+    totals = {"2026-02": {"返金": -500}, "2026-03": {"返金": 500}}
+    [c] = compare_months(totals, "2026-03")
+    assert c.pct is None
+    assert c.status == "up"
+
+
+def test_R3_format_report_lines():
+    changes = [
+        CategoryChange("食費", 30000, 33000, 3000, 10.0, "up"),
+        CategoryChange("交通", 0, 2000, 2000, None, "new"),
+        CategoryChange("娯楽", 4000, 0, -4000, -100.0, "gone"),
+        CategoryChange("家賃", 1000, 1000, 0, 0.0, "same"),
+        CategoryChange("返金", -500, 500, 1000, None, "up"),
+    ]
+    text = format_report(changes, "2026-03")
+    expected = (
+        "2026-03 の前月比\n"
+        "食費: 30,000円 → 33,000円 (+3,000円, +10.0%)\n"
+        "交通: 0円 → 2,000円 (+2,000円, 新規)\n"
+        "娯楽: 4,000円 → 0円 (-4,000円, -100.0%)\n"
+        "家賃: 1,000円 → 1,000円 (+0円, +0.0%)\n"
+        "返金: -500円 → 500円 (+1,000円, -)"
+    )
+    assert text == expected
+
+
+def test_R3_gone_without_pct_shows_gone_label():
+    text = format_report(
+        [CategoryChange("娯楽", 4000, 0, -4000, None, "gone")], "2026-03"
+    )
+    assert text.splitlines()[1] == "娯楽: 4,000円 → 0円 (-4,000円, 消滅)"
+
+
+def test_R3_empty_changes_says_no_change_without_trailing_newline():
+    assert format_report([], "2026-03") == "2026-03 の前月比\n変化なし"
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..f8ac6e8
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,303 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import RecurringCharge, find_recurring, next_due_after
+
+
+def e(d: str, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(date.fromisoformat(d), category, amount, memo)
+
+
+# --- 例の表 (E2-*) -------------------------------------------------------
+
+E2_CASES = [
+    (
+        "E2-1",
+        [
+            e("2025-01-31", "サブスク", 980, "Netflix"),
+            e("2025-02-28", "サブスク", 980, "Netflix"),
+            e("2025-03-31", "サブスク", 980, "Netflix"),
+        ],
+        [
+            RecurringCharge(
+                category="サブスク",
+                memo="Netflix",
+                amount=980,
+                day=31,
+                months=3,
+                last_seen=date(2025, 3, 31),
+                next_due=date(2025, 4, 30),
+            )
+        ],
+    ),
+    (
+        "E2-2",
+        [
+            e("2025-01-10", "サブスク", 980, "Netflix"),
+            e("2025-02-10", "サブスク", 980, "Netflix"),
+            e("2025-04-10", "サブスク", 980, "Netflix"),
+        ],
+        [],
+    ),
+    (
+        "E2-3",
+        [
+            e("2025-01-27", "住居", 80000, "家賃"),
+            e("2025-02-27", "住居", 80000, "家賃"),
+            e("2025-03-27", "住居", 80000, "家賃"),
+            e("2025-02-05", "住居", 5000, "ジム"),
+        ],
+        [
+            RecurringCharge(
+                category="住居",
+                memo="家賃",
+                amount=80000,
+                day=27,
+                months=3,
+                last_seen=date(2025, 3, 27),
+                next_due=date(2025, 4, 27),
+            )
+        ],
+    ),
+]
+
+
+@pytest.mark.parametrize(
+    "case_id, rows, expected",
+    E2_CASES,
+    ids=[c[0] for c in E2_CASES],
+)
+def test_example_table(
+    case_id: str, rows: list[Expense], expected: list[RecurringCharge]
+) -> None:
+    assert find_recurring(rows) == expected
+
+
+# --- R1: 入力・引数の検証 -------------------------------------------------
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+def test_no_recurring_returns_empty_list() -> None:
+    rows = [e("2025-01-01", "食費", 1234, "スーパー")]
+    assert find_recurring(rows) == []
+
+
+def test_min_occurrences_below_two_raises_value_error() -> None:
+    with pytest.raises(ValueError, match="min_occurrences"):
+        find_recurring([], min_occurrences=1)
+
+
+def test_min_occurrences_two_is_accepted() -> None:
+    rows = [
+        e("2025-01-10", "サブスク", 980, "A"),
+        e("2025-02-10", "サブスク", 980, "A"),
+    ]
+    assert [c.months for c in find_recurring(rows, min_occurrences=2)] == [2]
+
+
+@pytest.mark.parametrize("bad", [True, 3.0, "3"])
+def test_min_occurrences_non_int_raises_type_error(bad: object) -> None:
+    with pytest.raises(TypeError, match="min_occurrences"):
+        find_recurring([], min_occurrences=bad)  # type: ignore[arg-type]
+
+
+def test_negative_tolerance_raises_value_error() -> None:
+    with pytest.raises(ValueError, match="amount_tolerance"):
+        find_recurring([], amount_tolerance=-0.1)
+
+
+# --- D1: 返金・0 円の除外 --------------------------------------------------
+
+
+def test_refund_and_zero_yen_are_excluded() -> None:
+    rows = [
+        e("2025-01-10", "サブスク", 980, "A"),
+        e("2025-02-10", "サブスク", 980, "A"),
+        e("2025-03-10", "サブスク", 980, "A"),
+        e("2025-04-10", "サブスク", -980, "A"),
+        e("2025-05-10", "サブスク", 0, "A"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].months == 3
+    assert result[0].last_seen == date(2025, 3, 10)
+
+
+# --- D2: メモの正規化 ------------------------------------------------------
+
+
+def test_memo_normalization_groups_variants_into_one_series() -> None:
+    rows = [
+        e("2025-01-05", "サブスク", 980, "Netflix #1"),
+        e("2025-02-05", "サブスク", 980, "ＮＥＴＦＬＩＸ"),
+        e("2025-03-05", "サブスク", 980, "netflix  2"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].months == 3
+    assert result[0].memo == "netflix  2"
+
+
+def test_empty_memo_groups_by_category_and_amount() -> None:
+    rows = [
+        e("2025-01-05", "雑費", 500),
+        e("2025-02-05", "雑費", 500),
+        e("2025-03-05", "雑費", 500),
+        e("2025-01-06", "雑費", 700),
+        e("2025-02-06", "雑費", 700),
+    ]
+    result = find_recurring(rows)
+    assert [(c.amount, c.months) for c in result] == [(500, 3)]
+
+
+def test_same_amount_different_memo_are_separate_series() -> None:
+    rows = []
+    for m in (1, 2, 3):
+        rows.append(e(f"2025-{m:02d}-05", "サブスク", 980, "A"))
+        rows.append(e(f"2025-{m:02d}-20", "サブスク", 980, "B"))
+    result = find_recurring(rows)
+    assert [(c.memo, c.day) for c in result] == [("A", 5), ("B", 20)]
+
+
+# --- D3: 月の 1 件化・連続月・金額の許容 ----------------------------------
+
+
+def test_same_month_duplicates_collapse_to_latest_day() -> None:
+    rows = [
+        e("2025-01-05", "サブスク", 980, "A"),
+        e("2025-01-20", "サブスク", 980, "A"),
+        e("2025-02-10", "サブスク", 980, "A"),
+        e("2025-03-10", "サブスク", 980, "A"),
+    ]
+    result = find_recurring(rows)
+    assert result[0].months == 3
+    assert result[0].last_seen == date(2025, 3, 10)
+    assert result[0].day == 20
+
+
+def test_missing_month_keeps_only_trailing_consecutive_run() -> None:
+    rows = [
+        e("2025-01-10", "サブスク", 980, "A"),
+        e("2025-02-10", "サブスク", 980, "A"),
+        e("2025-04-10", "サブスク", 980, "A"),
+        e("2025-05-10", "サブスク", 980, "A"),
+        e("2025-06-10", "サブスク", 980, "A"),
+    ]
+    result = find_recurring(rows)
+    assert result[0].months == 3
+    assert result[0].last_seen == date(2025, 6, 10)
+
+
+def test_trailing_run_shorter_than_min_is_not_recurring() -> None:
+    rows = [
+        e("2025-01-10", "サブスク", 980, "A"),
+        e("2025-02-10", "サブスク", 980, "A"),
+        e("2025-04-10", "サブスク", 980, "A"),
+        e("2025-05-10", "サブスク", 980, "A"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_amount_outside_tolerance_is_not_recurring() -> None:
+    rows = [
+        e("2025-01-10", "通信", 1000, "A"),
+        e("2025-02-10", "通信", 1000, "A"),
+        e("2025-03-10", "通信", 1200, "A"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_amount_within_custom_tolerance_is_recurring() -> None:
+    rows = [
+        e("2025-01-10", "通信", 1000, "A"),
+        e("2025-02-10", "通信", 1000, "A"),
+        e("2025-03-10", "通信", 1200, "A"),
+    ]
+    result = find_recurring(rows, amount_tolerance=0.25)
+    assert [(c.amount, c.months) for c in result] == [(1000, 3)]
+
+
+# --- D4 / R3: 次回の日 ------------------------------------------------------
+
+
+def test_day_is_max_observed_and_next_due_is_clipped() -> None:
+    rows = [
+        e("2024-12-31", "サブスク", 980, "A"),
+        e("2025-01-31", "サブスク", 980, "A"),
+        e("2025-02-28", "サブスク", 980, "A"),
+    ]
+    result = find_recurring(rows)
+    assert result[0].day == 31
+    assert result[0].next_due == date(2025, 3, 31)
+
+
+def test_next_due_rolls_over_year_end() -> None:
+    rows = [
+        e("2024-10-15", "サブスク", 980, "A"),
+        e("2024-11-15", "サブスク", 980, "A"),
+        e("2024-12-15", "サブスク", 980, "A"),
+    ]
+    assert find_recurring(rows)[0].next_due == date(2025, 1, 15)
+
+
+def test_next_due_after_excludes_today() -> None:
+    charge = RecurringCharge(
+        "サブスク", "A", 980, 31, 3, date(2025, 3, 31), date(2025, 4, 30)
+    )
+    assert next_due_after(charge, date(2025, 4, 30)) == date(2025, 5, 31)
+
+
+def test_next_due_after_returns_next_due_when_still_future() -> None:
+    charge = RecurringCharge(
+        "サブスク", "A", 980, 31, 3, date(2025, 3, 31), date(2025, 4, 30)
+    )
+    assert next_due_after(charge, date(2025, 4, 1)) == date(2025, 4, 30)
+
+
+def test_next_due_after_uses_leap_year_clipping_from_day() -> None:
+    charge = RecurringCharge(
+        "サブスク", "A", 980, 31, 3, date(2024, 1, 31), date(2024, 2, 29)
+    )
+    assert next_due_after(charge, date(2024, 2, 29)) == date(2024, 3, 31)
+
+
+def test_next_due_after_rolls_over_year_end() -> None:
+    charge = RecurringCharge(
+        "サブスク", "A", 980, 15, 3, date(2024, 11, 15), date(2024, 12, 15)
+    )
+    assert next_due_after(charge, date(2024, 12, 20)) == date(2025, 1, 15)
+
+
+# --- R2 / R4: 並び・入力順 -------------------------------------------------
+
+
+def test_input_order_does_not_matter() -> None:
+    rows = [
+        e("2025-01-10", "サブスク", 980, "A"),
+        e("2025-02-10", "サブスク", 980, "A"),
+        e("2025-03-10", "サブスク", 980, "A"),
+    ]
+    assert find_recurring(rows) == find_recurring(list(reversed(rows)))
+
+
+def test_result_sorted_by_amount_desc_then_category_then_memo() -> None:
+    rows = []
+    for m in (1, 2, 3):
+        rows.append(e(f"2025-{m:02d}-01", "B", 500, "y"))
+        rows.append(e(f"2025-{m:02d}-02", "A", 500, "z"))
+        rows.append(e(f"2025-{m:02d}-03", "A", 500, "x"))
+        rows.append(e(f"2025-{m:02d}-04", "C", 900, "q"))
+    result = find_recurring(rows)
+    assert [(c.amount, c.category, c.memo) for c in result] == [
+        (900, "C", "q"),
+        (500, "A", "x"),
+        (500, "A", "z"),
+        (500, "B", "y"),
+    ]
diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..e40c2b9
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,185 @@
+from __future__ import annotations
+
+from datetime import date, datetime
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    all_of,
+    amount_between,
+    any_of,
+    between_dates,
+    category_is,
+    memo_contains,
+    not_,
+    search,
+)
+
+
+def _e(day: date, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+ROWS = [
+    _e(date(2026, 1, 5), "食費", 999, "スーパー"),
+    _e(date(2026, 1, 10), "食費", 1000, "ランチ"),
+    _e(date(2026, 2, 1), "娯楽", 1001, "NETFLIX 月額"),
+    _e(date(2026, 2, 15), "交通費", -500, "返金"),
+    _e(date(2026, 3, 31), "ＳＵＢＳＣＲ", 1500, "Spotify"),
+]
+
+
+# --- 例の表 (E3) ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "predicate, expected_amounts",
+    [
+        pytest.param(amount_between(1000, 1000), [1000], id="E3-1"),
+    ],
+)
+def test_example_table_amount(predicate, expected_amounts):
+    # E3-1: 1000 円ちょうどの明細だけが入る
+    assert [e.amount for e in search(ROWS, predicate)] == expected_amounts
+
+
+def test_E3_2_memo_contains_fullwidth_query_matches_ascii_memo():
+    # E3-2: メモ "NETFLIX 月額" に一致
+    result = search(ROWS, memo_contains("ｎｅｔｆｌｉｘ"))
+    assert [e.memo for e in result] == ["NETFLIX 月額"]
+
+
+def test_E3_3_any_of_empty_excludes_all():
+    # E3-3: any_of() は全件除外
+    assert search(ROWS, any_of()) == []
+
+
+def test_E3_3_all_of_empty_passes_all():
+    # E3-3: all_of() は全件通過
+    assert search(ROWS, all_of()) == ROWS
+
+
+# --- D5: 範囲・文字列・bool -----------------------------------------------
+
+
+def test_D5_amount_between_is_inclusive_on_both_ends():
+    result = search(ROWS, amount_between(999, 1000))
+    assert [e.amount for e in result] == [999, 1000]
+
+
+def test_D5_amount_between_none_is_unbounded():
+    assert len(search(ROWS, amount_between(None, None))) == len(ROWS)
+    assert [e.amount for e in search(ROWS, amount_between(lo=1500))] == [1500]
+    assert [e.amount for e in search(ROWS, amount_between(hi=-1))] == [-500]
+
+
+def test_D5_amount_between_lo_greater_than_hi_raises():
+    with pytest.raises(ValueError):
+        amount_between(10, 9)
+
+
+@pytest.mark.parametrize("bad", [True, False])
+def test_D5_amount_between_bool_raises_type_error(bad):
+    with pytest.raises(TypeError):
+        amount_between(bad, None)
+    with pytest.raises(TypeError):
+        amount_between(None, bad)
+
+
+def test_D5_memo_contains_empty_matches_everything():
+    assert search(ROWS, memo_contains("")) == ROWS
+
+
+def test_D5_memo_contains_casefold_and_nfkc():
+    assert [e.memo for e in search(ROWS, memo_contains("spotify"))] == ["Spotify"]
+
+
