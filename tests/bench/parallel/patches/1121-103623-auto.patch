+def test_R2_all_of_short_circuits():
+    calls: list[int] = []
+
+    def first(e: Expense) -> bool:
+        return False
+
+    def second(e: Expense) -> bool:
+        calls.append(e.amount)
+        return True
+
+    assert search(ROWS, all_of(first, second)) == []
+    assert calls == []
