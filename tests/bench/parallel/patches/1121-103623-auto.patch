index 0000000..bac7b31
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,127 @@
+"""Recurring expense detection and next-due calculation (pure functions)."""
+
+from __future__ import annotations
+
+import calendar
+import re
+import statistics
+import unicodedata
+from collections import defaultdict
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_HASH_NUM_RE = re.compile(r"\s*#\d+$")
+_TRAILING_NUM_RE = re.compile(r"\s*\d+$")
+_WS_RE = re.compile(r"\s+")
+
+
+@dataclass(frozen=True)
+class RecurringCharge:
+    category: str
+    memo: str
+    amount: int  # yen, median of the run
+    day: int  # max observed day-of-month
+    months: int  # length of the trailing consecutive-month run
+    last_seen: date
+    next_due: date
+
+
+def _normalize_memo(memo: str) -> str:
+    s = unicodedata.normalize("NFKC", memo).casefold()
+    s = _WS_RE.sub(" ", s).strip()
+    s = _HASH_NUM_RE.sub("", s)
+    s = _TRAILING_NUM_RE.sub("", s)
+    return s.strip()
+
+
+def _month_date(year: int, month: int, day: int) -> date:
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(day, last))
+
+
+def _advance_month(year: int, month: int) -> tuple[int, int]:
+    return (year + 1, 1) if month == 12 else (year, month + 1)
+
+
+def _detect(
+    items: list[Expense], min_occurrences: int, amount_tolerance: float
+) -> RecurringCharge | None:
+    # D3: one entry per calendar month, the latest day in that month.
+    latest_by_month: dict[tuple[int, int], Expense] = {}
+    for e in sorted(items, key=lambda x: x.day):
+        latest_by_month[(e.day.year, e.day.month)] = e
+    months = sorted(latest_by_month)
+
+    # D3: keep only the trailing run of consecutive months.
+    idx = [y * 12 + (m - 1) for y, m in months]
+    start = len(idx) - 1
+    while start > 0 and idx[start - 1] == idx[start] - 1:
+        start -= 1
+    run = [latest_by_month[ym] for ym in months[start:]]
+    if len(run) < min_occurrences:
+        return None
+
+    amounts = [e.amount for e in run]
+    med = statistics.median(amounts)
+    if any(abs(a - med) > med * amount_tolerance for a in amounts):
+        return None
+
+    last = run[-1]
+    day = max(e.day.day for e in run)  # D4
+    y, m = _advance_month(last.day.year, last.day.month)
+    return RecurringCharge(
+        category=last.category,
+        memo=last.memo,
+        amount=round(med),
+        day=day,
+        months=len(run),
+        last_seen=last.day,
+        next_due=_month_date(y, m, day),
+    )
+
+
+def find_recurring(
+    rows: list[Expense], *, min_occurrences: int = 3, amount_tolerance: float = 0.1
+) -> list[RecurringCharge]:
+    if isinstance(min_occurrences, bool) or not isinstance(min_occurrences, int):
+        raise TypeError("min_occurrences は int である必要があります")
+    if min_occurrences < 2:
+        raise ValueError(
+            f"min_occurrences は 2 以上である必要があります: {min_occurrences}"
+        )
+    if amount_tolerance < 0:
+        raise ValueError(
+            f"amount_tolerance は 0 以上である必要があります: {amount_tolerance}"
+        )
+
+    # D1: refunds (negative) and zero yen are excluded from detection.
+    # D2: series key is (category, normalized memo); empty memo -> (category, amount).
+    series: dict[tuple[str, str, int | None], list[Expense]] = defaultdict(list)
+    for e in rows:
+        if e.amount <= 0:
+            continue
+        norm = _normalize_memo(e.memo)
+        key = (e.category, norm, None if norm else e.amount)
+        series[key].append(e)
+
+    out: list[RecurringCharge] = []
+    for items in series.values():
+        charge = _detect(items, min_occurrences, amount_tolerance)
+        if charge is not None:
+            out.append(charge)
+    out.sort(key=lambda c: (-c.amount, c.category, c.memo))  # R4
+    return out
+
+
+def next_due_after(charge: RecurringCharge, today: date) -> date:
+    """First due date strictly after `today`, stepping monthly from charge.next_due."""
+    due = charge.next_due
+    if due > today:
+        return due
+    y, m = due.year, due.month
+    while due <= today:
+        y, m = _advance_month(y, m)
+        due = _month_date(y, m, charge.day)  # R3: clip to month end, from `day`
+    return due
diff --git a/src/kakeibo/search.py b/src/kakeibo/search.py
new file mode 100644
index 0000000..2c1e7f0
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,124 @@
+"""Pure predicate-based search over Expense records."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable
+from datetime import date, datetime
+
+from kakeibo.core import Expense
+
+Predicate = Callable[[Expense], bool]
+
+
+def _nfkc(text: str) -> str:
+    return unicodedata.normalize("NFKC", text)
+
+
+def _fold(text: str) -> str:
+    return unicodedata.normalize("NFKC", text).casefold()
+
+
+def _check_callable(pred: object) -> None:
+    if not callable(pred):
+        raise TypeError(f"述語は callable である必要があります: {pred!r}")
+
+
+def _check_int_or_none(value: object, name: str) -> None:
+    if value is None:
+        return
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{name} は int か None である必要があります: {value!r}")
+
+
+def _check_date_or_none(value: object, name: str) -> None:
+    if value is None:
+        return
+    if isinstance(value, datetime) or not isinstance(value, date):
+        raise TypeError(f"{name} は date か None である必要があります: {value!r}")
+
+
+def category_is(*names: str) -> Predicate:
+    """Match if the category equals any of ``names`` after NFKC and strip."""
+    if not names:
+        raise ValueError("category_is には 1 つ以上のカテゴリが必要です")
+    targets = frozenset(_nfkc(n).strip() for n in names)
+
+    def pred(e: Expense) -> bool:
+        return _nfkc(e.category).strip() in targets
+
+    return pred
+
+
+def amount_between(lo: int | None = None, hi: int | None = None) -> Predicate:
+    """Match ``lo <= amount <= hi`` (both inclusive; None is unbounded)."""
+    _check_int_or_none(lo, "lo")
+    _check_int_or_none(hi, "hi")
+    if lo is not None and hi is not None and lo > hi:
+        raise ValueError(f"下限 {lo} が上限 {hi} を超えています")
+
+    def pred(e: Expense) -> bool:
+        return (lo is None or e.amount >= lo) and (hi is None or e.amount <= hi)
+
+    return pred
+
+
+def memo_contains(text: str) -> Predicate:
+    """Substring match on memo after NFKC + casefold. Empty text matches all."""
+    needle = _fold(text)
+
+    def pred(e: Expense) -> bool:
+        return needle in _fold(e.memo)
+
+    return pred
+
+
+def between_dates(start: date | None = None, end: date | None = None) -> Predicate:
+    """Match ``start <= day <= end`` (both inclusive; None is unbounded)."""
+    _check_date_or_none(start, "start")
+    _check_date_or_none(end, "end")
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"開始 {start} が終了 {end} を超えています")
+
+    def pred(e: Expense) -> bool:
+        return (start is None or e.day >= start) and (end is None or e.day <= end)
+
+    return pred
+
+
+def all_of(*preds: Predicate) -> Predicate:
+    """True if every predicate is true (short-circuits; empty is True)."""
+    for p in preds:
+        _check_callable(p)
+
+    def pred(e: Expense) -> bool:
+        return all(bool(p(e)) for p in preds)
+
+    return pred
+
+
+def any_of(*preds: Predicate) -> Predicate:
+    """True if any predicate is true (short-circuits; empty is False)."""
+    for p in preds:
+        _check_callable(p)
+
+    def pred(e: Expense) -> bool:
+        return any(bool(p(e)) for p in preds)
+
+    return pred
+
+
+def not_(pred: Predicate) -> Predicate:
+    """Negate a predicate."""
+    _check_callable(pred)
+
+    def negated(e: Expense) -> bool:
+        return not bool(pred(e))
+
+    return negated
+
+
+def search(rows: list[Expense], predicate: Predicate) -> list[Expense]:
+    """Return a new list of matching rows, preserving input order."""
+    _check_callable(predicate)
+    return [e for e in rows if bool(predicate(e))]
diff --git a/tests/test_bank_import.py b/tests/test_bank_import.py
