@@ -0,0 +1,84 @@
+"""Month-over-month category comparison (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    diff: int
+    pct: float | None
+    status: str  # "up" | "down" | "same" | "new" | "gone"
+
+
+def _previous_month(month: str) -> str:
+    year, mm = int(month[:4]), int(month[5:7])
+    if mm == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mm - 1:02d}"
+
+
+def compare_months(
+    totals: dict[str, dict[str, int]], month: str
+) -> list[CategoryChange]:
+    """Compare `month` with the calendar month before it.
+
+    Categories with 0 yen in both months are omitted. The result is sorted by
+    abs(diff) descending, then by category name ascending.
+    """
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"month は YYYY-MM 形式である必要があります: {month!r}")
+    prev_month = _previous_month(month)
+    prev_cats = totals.get(prev_month, {})
+    cur_cats = totals.get(month, {})
+
+    changes: list[CategoryChange] = []
+    for category in set(prev_cats) | set(cur_cats):
+        previous = prev_cats.get(category, 0)
+        current = cur_cats.get(category, 0)
+        if previous == 0 and current == 0:
+            continue
+        diff = current - previous
+        pct = round(diff / previous * 100, 1) if previous > 0 else None
+        if previous == 0 and current > 0:
+            status = "new"
+        elif previous > 0 and current == 0:
+            status = "gone"
+        elif diff > 0:
+            status = "up"
+        elif diff < 0:
+            status = "down"
+        else:
+            status = "same"
+        changes.append(CategoryChange(category, previous, current, diff, pct, status))
+
+    changes.sort(key=lambda c: (-abs(c.diff), c.category))
+    return changes
+
+
+def format_report(changes: list[CategoryChange], month: str) -> str:
+    """Render the comparison as text. No trailing newline."""
+    lines = [f"{month} の前月比"]
+    if not changes:
+        lines.append("変化なし")
+    for c in changes:
+        if c.pct is not None:
+            pct_text = f"{c.pct:+.1f}%"
+        elif c.status == "new":
+            pct_text = "新規"
+        elif c.status == "gone":
+            pct_text = "消滅"
+        else:
+            pct_text = "-"
+        lines.append(
+            f"{c.category}: {c.previous:,}円 → {c.current:,}円 "
+            f"({c.diff:+,}円, {pct_text})"
+        )
+    return "\n".join(lines)
