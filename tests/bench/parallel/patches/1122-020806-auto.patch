diff --git a/tests/test_types/test_Choice.py b/tests/test_types/test_Choice.py
index c34f516..7ab818b 100644
--- a/tests/test_types/test_Choice.py
+++ b/tests/test_types/test_Choice.py
@@ -1,3 +1,7 @@
+import enum
+
+import pytest
+
 import click
 
 
@@ -5,3 +9,59 @@ def test_choice_get_invalid_choice_message():
     choice = click.Choice(["a", "b", "c"])
     message = choice.get_invalid_choice_message("d", ctx=None)
     assert message == "'d' is not one of 'a', 'b', 'c'."
+
+
+@pytest.mark.parametrize(
+    ("value", "suggestion"),
+    [
+        ("deplyo", "Did you mean 'deploy'?"),
+        ("dploy", "Did you mean 'deploy'?"),
+        ("sttus", "(Did you mean one of: 'start', 'status'?)"),
+    ],
+)
+def test_choice_invalid_choice_suggests_close_matches(value, suggestion):
+    choice = click.Choice(["deploy", "status", "start", "restart"])
+    message = choice.get_invalid_choice_message(value, ctx=None)
+    assert message.endswith(f" {suggestion}")
+
+
+def test_choice_invalid_choice_no_suggestion_when_nothing_is_close():
+    choice = click.Choice(["start", "stop"])
+    message = choice.get_invalid_choice_message("zzzzzz", ctx=None)
+    assert "Did you mean" not in message
+
+
+def test_choice_invalid_choice_suggestion_case_insensitive():
+    choice = click.Choice(["Start", "Stop"], case_sensitive=False)
+    message = choice.get_invalid_choice_message("STAT", ctx=None)
+    assert "Did you mean 'start'?" in message
+
+
+def test_choice_invalid_choice_suggestion_enum():
+    class Mode(enum.Enum):
+        FAST = 1
+        SLOW = 2
+
+    choice = click.Choice(Mode)
+    message = choice.get_invalid_choice_message("FAS", ctx=None)
+    assert "Did you mean 'FAST'?" in message
+
+
+def test_choice_invalid_choice_suggestion_non_str_value():
+    choice = click.Choice([1, 22])
+    message = choice.get_invalid_choice_message(2, ctx=None)
+    assert "Did you mean '22'?" in message
+
+
+def test_choice_cli_error_includes_suggestion(runner):
+    @click.command()
+    @click.option("--action", type=click.Choice(["start", "stop"]))
+    def cli(action):
+        pass
+
+    result = runner.invoke(cli, ["--action", "strt"])
+    assert result.exit_code == 2
+    assert (
+        "Invalid value for '--action': 'strt' is not one of 'start', 'stop'."
+        " Did you mean 'start'?"
+    ) in result.output
