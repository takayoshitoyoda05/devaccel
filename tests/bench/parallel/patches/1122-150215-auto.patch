diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..9959f65 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -188,3 +188,113 @@ def test_path_type(runner, cls, expect):
 
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
+
+
+@pytest.mark.parametrize(
+    "name",
+    ["a.csv", "a.TSV", "dir/A.Csv", "a.b.tsv"],
+)
+def test_path_extensions_accepts(name):
+    type = click.Path(extensions=[".csv", ".tsv"])
+    assert type.convert(name, None, None) == name
+
+
+@pytest.mark.parametrize("name", ["a.txt", "a", "a.csv.bak", "csv", ".csv", "a.csv/b"])
+def test_path_extensions_rejects(name):
+    type = click.Path(extensions=[".csv", ".tsv"])
+
+    with pytest.raises(click.BadParameter, match="must have one of these extensions"):
+        type.convert(name, None, None)
+
+
+def test_path_extensions_message_lists_allowed():
+    type = click.Path(extensions=["CSV", "tsv"])
+
+    with pytest.raises(click.BadParameter, match=r"extensions: \.csv, \.tsv\."):
+        type.convert("a.txt", None, None)
+
+
+def test_path_extensions_dot_optional_and_multipart():
+    type = click.Path(extensions=["gz", ".tar.gz"])
+    assert type.convert("x.TAR.GZ", None, None) == "x.TAR.GZ"
+    assert type.convert("x.gz", None, None) == "x.gz"
+
+
+def test_path_extensions_bytes_and_pathlib():
+    type = click.Path(extensions=[".csv"], path_type=pathlib.Path)
+    assert click.Path(extensions=[".csv"]).convert(b"a.CSV", None, None) == b"a.CSV"
+    assert type.convert(pathlib.Path("a.csv"), None, None) == pathlib.Path("a.csv")
+
+    with pytest.raises(click.BadParameter):
+        type.convert(b"a.txt", None, None)
+
+
+def test_path_extensions_checks_existing_file(tmp_path):
+    good = tmp_path / "a.CSV"
+    bad = tmp_path / "a.txt"
+    good.touch()
+    bad.touch()
+    type = click.Path(exists=True, extensions=[".csv"])
+
+    assert type.convert(os.fspath(good), None, None) == os.fspath(good)
+
+    with pytest.raises(click.BadParameter, match="must have one of these extensions"):
+        type.convert(os.fspath(bad), None, None)
+
+
+def test_path_extensions_skips_directory_and_dash(tmp_path):
+    directory = tmp_path / "data.d"
+    directory.mkdir()
+    type = click.Path(extensions=[".csv"], allow_dash=True)
+
+    assert type.convert(os.fspath(directory), None, None) == os.fspath(directory)
+    assert type.convert("-", None, None) == "-"
+
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions=[".csv"]).convert("-", None, None)
+
+
+def test_path_extensions_default_allows_anything():
+    type = click.Path()
+    assert type.extensions is None
+    assert type.convert("a.txt", None, None) == "a.txt"
+    assert type.convert("noext", None, None) == "noext"
+
+
+@pytest.mark.parametrize(
+    ("extensions", "error"),
+    [
+        ([], ValueError),
+        ([""], ValueError),
+        ([".", ".csv"], ValueError),
+        (".csv", TypeError),
+        (b".csv", TypeError),
+        ([1], TypeError),
+        ([None], TypeError),
+    ],
+)
+def test_path_extensions_invalid_argument(extensions, error):
+    with pytest.raises(error, match="extensions"):
+        click.Path(extensions=extensions)
+
+
+def test_path_extensions_info_dict():
+    assert click.Path(extensions=("CSV", ".tsv")).to_info_dict()["extensions"] == [
+        ".csv",
+        ".tsv",
+    ]
+
+
+def test_path_extensions_option(runner):
+    @click.command()
+    @click.option("--data", type=click.Path(extensions=[".csv", ".tsv"]))
+    def cli(data):
+        click.echo(data)
+
+    ok = runner.invoke(cli, ["--data", "x.TSV"])
+    assert ok.exit_code == 0
+    assert ok.output == "x.TSV\n"
+
+    bad = runner.invoke(cli, ["--data", "x.json"])
+    assert bad.exit_code == 2
+    assert "must have one of these extensions: .csv, .tsv." in bad.output
