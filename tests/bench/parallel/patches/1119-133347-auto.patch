+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,113 @@
+"""Detect recurring monthly expenses. Pure functions (no I/O)."""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from collections import Counter
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_HASH_NUMBER_RE = re.compile(r"#\d+")
+_TRAILING_DIGITS_RE = re.compile(r"\d+$")
+
+
+@dataclass(frozen=True)
+class RecurringCharge:
+    category: str
+    memo: str  # memo of the first row in the series
+    amount: int  # amount of the latest row in the series
+    count: int
+    last_date: date
+    next_date: date
+
+
+def next_due(last: date, day_of_month: int) -> date:
+    """Day `day_of_month` of the month after `last`, rounded down to month end."""
+    index = last.year * 12 + last.month  # 1-based month, shifted by one below
+    year, month0 = divmod(index, 12)
+    month = month0 + 1
+    last_day = calendar.monthrange(year, month)[1]
+    return date(year, month, min(day_of_month, last_day))
+
+
+def _memo_key(memo: str) -> str:
+    """NFKC + lowercase + whitespace removed, then `#12` and trailing digits dropped."""
+    text = unicodedata.normalize("NFKC", memo).lower()
+    text = "".join(text.split())
+    text = _HASH_NUMBER_RE.sub("", text)
+    return _TRAILING_DIGITS_RE.sub("", text)
+
+
+def _judge(series: list[Expense], min_count: int) -> RecurringCharge | None:
+    """`series` is one (category, memo key) group sorted by day ascending."""
+    latest = series[-1]
+    ref = latest.amount
+
+    # R2: walk back from the latest row while amounts stay within ±10% of it.
+    kept: list[Expense] = []
+    for e in reversed(series):
+        if abs(e.amount - ref) * 10 > ref:
+            break
+        kept.append(e)
+    kept.reverse()
+
+    # R3: at most one row per month (the earliest day).
+    by_month: dict[int, Expense] = {}
+    for e in kept:
+        by_month.setdefault(e.day.year * 12 + e.day.month, e)
+
+    # R3: only the last run of consecutive months is judged.
+    months = sorted(by_month)
+    run = [months[-1]]
+    for idx in reversed(months[:-1]):
+        if idx != run[-1] - 1:
+            break
+        run.append(idx)
+    if len(run) < min_count:
+        return None
+
+    chosen = [by_month[idx] for idx in reversed(run)]  # ascending
+    first, last = chosen[0], chosen[-1]
+
+    # R4: most common day of month; on a tie, the larger day wins.
+    day_counts = Counter(e.day.day for e in chosen)
+    top = max(day_counts.values())
+    mode_day = max(day for day, c in day_counts.items() if c == top)
+
+    return RecurringCharge(
+        category=first.category,
+        memo=first.memo,
+        amount=ref,
+        count=len(chosen),
+        last_date=last.day,
+        next_date=next_due(last.day, mode_day),
+    )
+
+
+def find_recurring(rows: list[Expense], min_count: int = 3) -> list[RecurringCharge]:
+    """Series that recur monthly at least `min_count` times, sorted by next_date."""
+    if min_count < 2:
+        raise ValueError("min_count は 2 以上である必要があります")
+
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        if e.amount < 0 or not e.memo.strip():
+            continue  # R1: refunds and blank memos never form a series
+        key = _memo_key(e.memo)
+        if not key:
+            continue
+        groups.setdefault((e.category, key), []).append(e)
+
+    out: list[RecurringCharge] = []
+    for series in groups.values():
+        charge = _judge(sorted(series, key=lambda e: e.day), min_count)
+        if charge is not None:
+            out.append(charge)
+
+    # R5: next_date asc, amount desc, memo asc.
+    out.sort(key=lambda c: (c.next_date, -c.amount, c.memo))
+    return out
diff --git a/src/kakeibo/search.py b/src/kakeibo/search.py
new file mode 100644
index 0000000..d06baea
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,125 @@
+"""Search expenses with a composable, pure query tree."""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date, datetime
+
+from kakeibo.core import Expense
+
+_WS_RE = re.compile(r"\s+")
+
+
+class QueryError(ValueError):
+    """Raised when a query is malformed (unknown node, wrong type, empty range)."""
+
+
+@dataclass(frozen=True)
+class Cond:
+    category: str | None = None
+    min_amount: int | None = None
+    max_amount: int | None = None
+    memo_contains: str | None = None
+    start: date | None = None
+    end: date | None = None
+
+
+@dataclass(frozen=True)
+class And:
+    items: tuple[Query, ...]
+
+
+@dataclass(frozen=True)
+class Or:
+    items: tuple[Query, ...]
+
+
+@dataclass(frozen=True)
+class Not:
+    item: Query
+
+
+Query = Cond | And | Or | Not
+
+
+def _norm_memo(text: str) -> str:
+    """D6: NFKC, lowercase, drop all whitespace."""
+    return _WS_RE.sub("", unicodedata.normalize("NFKC", text).lower())
+
+
+def _is_int(v: object) -> bool:
+    return isinstance(v, int) and not isinstance(v, bool)
+
+
+def _check_cond(c: Cond) -> None:
+    if c.category is not None and not isinstance(c.category, str):
+        raise QueryError("category は str または None である必要があります")
+    if c.memo_contains is not None and not isinstance(c.memo_contains, str):
+        raise QueryError("memo_contains は str または None である必要があります")
+    for name in ("min_amount", "max_amount"):
+        v = getattr(c, name)
+        if v is not None and not _is_int(v):
+            raise QueryError(f"{name} は int または None である必要があります")
+    for name in ("start", "end"):
+        v = getattr(c, name)
+        if v is not None and (not isinstance(v, date) or isinstance(v, datetime)):
+            raise QueryError(f"{name} は date または None である必要があります")
+    if (
+        c.min_amount is not None
+        and c.max_amount is not None
+        and c.min_amount > c.max_amount
+    ):
+        raise QueryError("min_amount が max_amount より大きくなっています")
+    if c.start is not None and c.end is not None and c.start > c.end:
+        raise QueryError("start が end より後になっています")
+
+
+def _check(q: object) -> None:
+    if isinstance(q, Cond):
+        _check_cond(q)
+    elif isinstance(q, (And, Or)):
+        if not isinstance(q.items, tuple):
+            raise QueryError("And/Or の items は tuple である必要があります")
+        for item in q.items:
+            _check(item)
+    elif isinstance(q, Not):
+        _check(q.item)
+    else:
+        raise QueryError(f"Query ではありません: {q!r}")
+
+
+def _match_cond(e: Expense, c: Cond) -> bool:
+    if (
+        c.category is not None
+        and e.category.strip().lower() != c.category.strip().lower()
+    ):
+        return False
+    if c.min_amount is not None and e.amount < c.min_amount:
+        return False
+    if c.max_amount is not None and e.amount > c.max_amount:
+        return False
+    if c.memo_contains is not None and _norm_memo(c.memo_contains) not in _norm_memo(
+        e.memo
+    ):
+        return False
+    if c.start is not None and e.day < c.start:
+        return False
+    return not (c.end is not None and e.day > c.end)
+
+
+def _match(e: Expense, q: Query) -> bool:
+    if isinstance(q, Cond):
+        return _match_cond(e, q)
+    if isinstance(q, And):
+        return all(_match(e, item) for item in q.items)
+    if isinstance(q, Or):
+        return any(_match(e, item) for item in q.items)
+    return not _match(e, q.item)
+
+
+def search(rows: list[Expense], query: Query) -> list[Expense]:
+    """Return the rows matching ``query``, in input order. Raises ValueError on bad queries."""
+    _check(query)
+    return [e for e in rows if _match(e, query)]
diff --git a/tests/test_compare.py b/tests/test_compare.py
new file mode 100644
index 0000000..4224be2
