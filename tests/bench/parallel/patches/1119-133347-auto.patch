@@ -0,0 +1,234 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import RecurringCharge, find_recurring, next_due
+
+
+def ex(day: date, amount: int, memo: str, category: str = "固定費") -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- 仕様の例の表 (E2-*) ---
+
+
+def _rent() -> list[Expense]:
+    return [
+        ex(date(2026, 1, 25), 80000, "家賃"),
+        ex(date(2026, 2, 25), 80000, "家賃"),
+        ex(date(2026, 3, 25), 80000, "家賃"),
+    ]
+
+
+def _netflix() -> list[Expense]:
+    return [
+        ex(date(2026, 1, 31), 1490, "Netflix"),
+        ex(date(2026, 2, 28), 1490, "Netflix"),
+        ex(date(2026, 3, 31), 1490, "Netflix"),
+    ]
+
+
+def _gym() -> list[Expense]:
+    return [
+        ex(date(2026, 1, 10), 5000, "Gym #1"),
+        ex(date(2026, 2, 10), 5000, "Gym #2"),
+        ex(date(2026, 3, 10), 5000, "Gym #3"),
+    ]
+
+
+@pytest.mark.parametrize(
+    ("rows", "expected"),
+    [
+        pytest.param(
+            _rent(),
+            [
+                RecurringCharge(
+                    category="固定費",
+                    memo="家賃",
+                    amount=80000,
+                    count=3,
+                    last_date=date(2026, 3, 25),
+                    next_date=date(2026, 4, 25),
+                )
+            ],
+            id="E2-1",
+        ),
+        pytest.param(
+            _netflix(),
+            [
+                RecurringCharge(
+                    category="固定費",
+                    memo="Netflix",
+                    amount=1490,
+                    count=3,
+                    last_date=date(2026, 3, 31),
+                    next_date=date(2026, 4, 30),
+                )
+            ],
+            id="E2-2",
+        ),
+        pytest.param(
+            _gym(),
+            [
+                RecurringCharge(
+                    category="固定費",
+                    memo="Gym #1",
+                    amount=5000,
+                    count=3,
+                    last_date=date(2026, 3, 10),
+                    next_date=date(2026, 4, 10),
+                )
+            ],
+            id="E2-3",
+        ),
+    ],
+)
+def test_example_table(rows: list[Expense], expected: list[RecurringCharge]) -> None:
+    assert find_recurring(rows) == expected
+
+
+# --- next_due (D2) ---
+
+
+@pytest.mark.parametrize(
+    ("last", "day", "expected"),
+    [
+        (date(2026, 1, 31), 31, date(2026, 2, 28)),  # 月末丸め
+        (date(2024, 1, 31), 31, date(2024, 2, 29)),  # 閏年
+        (date(2026, 12, 15), 25, date(2027, 1, 25)),  # 年またぎ
+        (date(2026, 1, 25), 25, date(2026, 2, 25)),
+    ],
+    ids=["month-end", "leap-year", "year-wrap", "plain"],
+)
+def test_next_due(last: date, day: int, expected: date) -> None:
+    assert next_due(last, day) == expected
+
+
+# --- 境界・規則 ---
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+@pytest.mark.parametrize("min_count", [1, 0, -1])
+def test_min_count_below_two_raises(min_count: int) -> None:
+    with pytest.raises(ValueError):
+        find_recurring(_rent(), min_count=min_count)
+
+
+def test_min_count_is_respected() -> None:
+    two = _rent()[:2]
+    assert find_recurring(two) == []
+    assert [c.count for c in find_recurring(two, min_count=2)] == [2]
+
+
+def test_refunds_are_not_part_of_a_series() -> None:
+    rows = [
+        ex(date(2026, 1, 5), 3000, "返金"),
+        ex(date(2026, 2, 5), -3000, "返金"),
+        ex(date(2026, 3, 5), 3000, "返金"),
+        ex(date(2026, 4, 5), -3000, "返金"),
+    ]
+    # 正の 2 件は連続しない月(1 月と 3 月の間に 2 月がある)ので、2 件の塊のみ
+    assert find_recurring(rows) == []
+
+
+def test_blank_memo_is_not_a_series() -> None:
+    rows = [ex(date(2026, m, 1), 1000, "") for m in (1, 2, 3)]
+    rows += [ex(date(2026, m, 1), 1000, "   ") for m in (1, 2, 3)]
+    assert find_recurring(rows) == []
+
+
+def test_price_increase_follows_latest_within_ten_percent() -> None:
+    rows = [
+        ex(date(2026, 1, 1), 80000, "ジム"),
+        ex(date(2026, 2, 1), 80000, "ジム"),
+        ex(date(2026, 3, 1), 80000, "ジム"),
+        ex(date(2026, 4, 1), 88000, "ジム"),
+        ex(date(2026, 5, 1), 88000, "ジム"),
+        ex(date(2026, 6, 1), 88000, "ジム"),
+    ]
+    [charge] = find_recurring(rows)
+    assert charge.amount == 88000
+    assert charge.count == 6
+
+
+def test_jump_beyond_ten_percent_cuts_series() -> None:
+    rows = [
+        ex(date(2026, 1, 1), 80000, "ジム"),
+        ex(date(2026, 2, 1), 80000, "ジム"),
+        ex(date(2026, 3, 1), 80000, "ジム"),
+        ex(date(2026, 4, 1), 100000, "ジム"),
+        ex(date(2026, 5, 1), 100000, "ジム"),
+        ex(date(2026, 6, 1), 100000, "ジム"),
+    ]
+    [charge] = find_recurring(rows)
+    assert charge.amount == 100000
+    assert charge.count == 3
+    assert charge.last_date == date(2026, 6, 1)
+
+
+def test_gap_in_months_judges_only_last_run() -> None:
+    rows = [ex(date(2026, m, 20), 1200, "水道") for m in (1, 2, 3, 5, 6, 7)]
+    [charge] = find_recurring(rows)
+    assert charge.count == 3
+    assert charge.last_date == date(2026, 7, 20)
+
+
+def test_gap_leaves_short_last_run_not_recurring() -> None:
+    rows = [ex(date(2026, m, 20), 1200, "水道") for m in (1, 2, 3, 5, 6)]
+    assert find_recurring(rows) == []
+
+
+def test_same_month_keeps_earliest_row() -> None:
+    rows = [
+        ex(date(2026, 1, 10), 500, "ガス"),
+        ex(date(2026, 1, 20), 500, "ガス"),
+        ex(date(2026, 2, 10), 500, "ガス"),
+        ex(date(2026, 3, 10), 500, "ガス"),
+    ]
+    [charge] = find_recurring(rows)
+    assert charge.count == 3
+    assert charge.last_date == date(2026, 3, 10)
+
+
+def test_memo_normalization_ignores_case_width_and_spaces() -> None:
+    rows = [
+        ex(date(2026, 1, 3), 1490, "NETFLIX"),
+        ex(date(2026, 2, 3), 1490, "ｎｅｔｆｌｉｘ "),
+        ex(date(2026, 3, 3), 1490, " Netflix"),
+    ]
+    [charge] = find_recurring(rows)
+    assert charge.count == 3
+    assert charge.memo == "NETFLIX"
+
+
+def test_different_categories_are_separate_series() -> None:
+    rows = [
+        ex(date(2026, m, 1), 1000, "通信", category=c)
+        for c in ("A", "B")
+        for m in (1, 2, 3)
+    ]
+    result = find_recurring(rows)
+    assert sorted(c.category for c in result) == ["A", "B"]
+
+
+def test_output_sorted_by_next_date_then_amount_desc_then_memo() -> None:
+    rows = [
+        ex(date(2026, 1, 15), 900, "b", category="x"),
+        ex(date(2026, 2, 15), 900, "b", category="x"),
+        ex(date(2026, 3, 15), 900, "b", category="x"),
+        ex(date(2026, 1, 15), 1200, "a", category="x"),
+        ex(date(2026, 2, 15), 1200, "a", category="x"),
+        ex(date(2026, 3, 15), 1200, "a", category="x"),
+        ex(date(2026, 1, 1), 300, "c", category="x"),
+        ex(date(2026, 2, 1), 300, "c", category="x"),
+        ex(date(2026, 3, 1), 300, "c", category="x"),
+    ]
+    memos = [c.memo for c in find_recurring(rows)]
+    # c: next 4/1 / a,b: next 4/15 (amount 1200 > 900)
+    assert memos == ["c", "a", "b"]
