+"""Import bank/card statement CSV text into Expense records (pure functions).
+
+The input is a string; this module never reads or writes files or stdio.
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_UNCATEGORIZED = "未分類"
+
+# Header aliases per logical column kind (normalized with _norm_header on use).
+_ALIASES: dict[str, tuple[str, ...]] = {
+    "日付": ("日付", "利用日", "取引日", "ご利用日", "date"),
+    "金額": ("金額", "利用金額", "ご利用金額", "amount"),
+    "出金": ("出金額", "出金", "支払", "お支払金額"),
+    "入金": ("入金額", "入金", "預入", "お預り金額"),
+    "メモ": ("摘要", "メモ", "利用店名", "ご利用店名", "内容", "description", "memo"),
+    "カテゴリ": ("カテゴリ", "カテゴリー", "category"),
+}
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str
+    value: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+    skipped: int
+
+
+def _norm_header(s: str) -> str:
+    return unicodedata.normalize("NFKC", s.strip().lower())
+
+
+_ALIAS_NORM: dict[str, frozenset[str]] = {
+    kind: frozenset(_norm_header(a) for a in aliases)
+    for kind, aliases in _ALIASES.items()
+}
+
+
+def _find(header_norm: list[str], kind: str) -> int | None:
+    for i, h in enumerate(header_norm):
+        if h in _ALIAS_NORM[kind]:
+            return i
+    return None
+
+
+@dataclass(frozen=True)
+class _Cols:
+    date: int
+    amount: int | None
+    out: int | None
+    inn: int | None
+    category: int | None
+    memo: int | None
+
+
+_DATE_PATTERNS = (
+    re.compile(r"(?P<y>[0-9]{4})(?P<s>[-/.])(?P<m>[0-9]{1,2})(?P=s)(?P<d>[0-9]{1,2})"),
+    re.compile(r"(?P<y>[0-9]{4})年(?P<m>[0-9]{1,2})月(?P<d>[0-9]{1,2})日"),
+    re.compile(r"(?P<y>[0-9]{4})(?P<m>[0-9]{2})(?P<d>[0-9]{2})"),
+)
+_TIME_RE = re.compile(
+    r"(?:\s+|T)(?P<h>[0-9]{1,2}):(?P<mi>[0-9]{2})(?::(?P<sec>[0-9]{2}))?"
+)
+_WAREKI_RE = re.compile(
+    r"令和|平成|昭和|大正|明治|[MTSHR][0-9]{1,2}[.\-/年]", re.IGNORECASE
+)
+
+
+def _parse_date(raw: str) -> date:
+    s = unicodedata.normalize("NFKC", raw).strip()
+    if not s:
+        raise ValueError("日付が空です")
+    if _WAREKI_RE.match(s):
+        raise ValueError("和暦は未対応です")
+    for pat in _DATE_PATTERNS:
+        m = pat.match(s)
+        if m is not None:
+            break
+    else:
+        raise ValueError("日付の形式が不正です")
+    rest = s[m.end() :]
+    if rest:
+        t = _TIME_RE.fullmatch(rest)
+        if (
+            t is None
+            or int(t["h"]) > 23
+            or int(t["mi"]) > 59
+            or int(t["sec"] or 0) > 59
+        ):
+            raise ValueError("日付の形式が不正です")
+    try:
+        return date(int(m["y"]), int(m["m"]), int(m["d"]))
+    except ValueError:
+        raise ValueError("存在しない日付です") from None
+
+
+_CURRENCY_RE = re.compile(r"¥|円|JPY", re.IGNORECASE)
+
+
+def _parse_yen(raw: str) -> int | None:
+    """Return the signed yen amount, or None when the cell is blank ("", "-", "—").
+
+    Raises ValueError when the cell is not a valid amount.
+    """
+    s = unicodedata.normalize("NFKC", raw)
+    s = _CURRENCY_RE.sub("", s).replace(",", "").strip()
+    if s in ("", "-", "—"):
+        return None
+    neg = False
+    if len(s) >= 2 and s[0] == "(" and s[-1] == ")":
+        neg, s = True, s[1:-1].strip()
+    elif len(s) >= 2 and s.endswith("-"):
+        neg, s = True, s[:-1].strip()
+    elif s[:1] in ("-", "−", "△", "▲"):
+        neg, s = True, s[1:].strip()
+    m = re.fullmatch(r"([0-9]+)(?:\.([0-9]+))?", s)
+    if m is None:
+        raise ValueError("金額の形式が不正です")
+    if m.group(2) is not None and set(m.group(2)) != {"0"}:
+        raise ValueError("小数は未対応です")
+    value = int(m.group(1))
+    return -value if neg else value
+
+
+def _delimiter(text: str) -> str:
+    first = text.split("\n", 1)[0]
+    return "\t" if first.count("\t") > first.count(",") else ","
+
+
+def _date_cell(
+    line: int, row: list[str], idx: int, errs: list[RowError]
+) -> date | None:
+    raw = row[idx]
+    try:
+        return _parse_date(raw)
+    except ValueError as e:
+        errs.append(RowError(line, "日付", raw, str(e)))
+        return None
+
+
+def _amount_cell(
+    line: int, row: list[str], idx: int | None, kind: str, errs: list[RowError]
+) -> tuple[bool, int | None]:
+    """(ok, value). A missing column counts as blank."""
+    if idx is None:
+        return True, None
+    raw = row[idx]
+    try:
+        return True, _parse_yen(raw)
+    except ValueError as e:
+        errs.append(RowError(line, kind, raw, str(e)))
+        return False, None
+
+
+def _convert(
+    line: int, row: list[str], cols: _Cols
+) -> tuple[list[RowError], Expense | None]:
+    """Return (errors, expense). expense is None with no errors means the row is skipped."""
+    errs: list[RowError] = []
+    day = _date_cell(line, row, cols.date, errs)
+
+    amount: int | None
+    if cols.amount is not None:
+        _, amount = _amount_cell(line, row, cols.amount, "金額", errs)
+    else:
+        ok_out, out_v = _amount_cell(line, row, cols.out, "出金", errs)
+        ok_in, in_v = _amount_cell(line, row, cols.inn, "入金", errs)
+        amount = None
+        if ok_out and ok_in:
+            out_on = bool(out_v)
+            in_on = bool(in_v)
+            if out_on and in_on:
+                errs.append(
+                    RowError(
+                        line,
+                        "出金/入金",
+                        f"{row[cols.out]} / {row[cols.inn]}",  # type: ignore[index]
+                        "出金と入金の両方に金額があります",
+                    )
+                )
+            elif out_on:
+                amount = out_v
+            elif in_on:
+                amount = -in_v  # type: ignore[operator]
+
+    if errs:
+        return errs, None
+    if day is None or not amount:
+        return [], None
+
+    category = row[cols.category].strip() if cols.category is not None else ""
+    memo = row[cols.memo].strip() if cols.memo is not None else ""
+    return [], Expense(
+        day=day,
+        category=category or _UNCATEGORIZED,
+        amount=amount,
+        memo=unicodedata.normalize("NFKC", memo),
+    )
+
+
+def import_statement(text: str) -> ImportResult:
+    text = text.removeprefix("﻿")
+    delim = _delimiter(text)
+
+    errors: list[RowError] = []
+    records: list[tuple[int, list[str]]] = []
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delim)
+    start = 1  # line number where the next record begins
+    try:
+        for row in reader:
+            records.append((start, row))
+            start = reader.line_num + 1
+    except csv.Error as e:
+        errors.append(RowError(start, "(行)", "", f"CSV として読めません: {e}"))
+
+    # Blank lines are ignored silently (not counted as skipped).
+    records = [(ln, r) for ln, r in records if any(c.strip() for c in r)]
+    if not records:
+        return ImportResult([], errors, 0)
+
+    _, header = records[0]
+    hn = [_norm_header(c) for c in header]
+    date_i = _find(hn, "日付")
+    amount_i = _find(hn, "金額")
+    out_i = _find(hn, "出金")
+    in_i = _find(hn, "入金")
+
+    missing: list[RowError] = []
+    if date_i is None:
+        missing.append(RowError(1, "日付", "", "日付列がありません"))
+    if amount_i is None and out_i is None and in_i is None:
+        missing.append(
+            RowError(1, "金額", "", "金額列（金額、または出金・入金）がありません")
+        )
+    if missing:
+        return ImportResult([], errors + missing, 0)
+
+    cols = _Cols(
+        date=date_i,  # type: ignore[arg-type]
+        amount=amount_i,
+        out=out_i,
+        inn=in_i,
+        category=_find(hn, "カテゴリ"),
+        memo=_find(hn, "メモ"),
+    )
+    n = len(header)
+    expenses: list[Expense] = []
+    skipped = 0
+    for line, row in records[1:]:
+        if len(row) != n:
+            errors.append(
+                RowError(
+                    line,
+                    "(行)",
+                    delim.join(row),
+                    f"列数が見出しと一致しません（見出し {n} 列、行 {len(row)} 列）",
+                )
+            )
+            continue
+        row_errs, expense = _convert(line, row, cols)
+        if row_errs:
+            errors.extend(row_errs)
+        elif expense is None:
+            skipped += 1
+        else:
+            expenses.append(expense)
+    return ImportResult(expenses, errors, skipped)
