+"""Month-over-month comparison of expenses by category (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+_TOTAL = "合計"
+
+
+@dataclass(frozen=True)
+class CategoryDelta:
+    category: str
+    prev_amount: int
+    amount: int
+    diff: int
+    ratio: float | None
+    status: str
+
+
+@dataclass(frozen=True)
+class MonthComparison:
+    month: str
+    prev: str
+    items: list[CategoryDelta]
+    total: CategoryDelta
+
+
+def _check_month(s: str) -> None:
+    if not _MONTH_RE.fullmatch(s):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {s!r}")
+
+
+def _previous_month(month: str) -> str:
+    y, m = int(month[:4]), int(month[5:])
+    if m == 1:
+        return f"{y - 1}-12"
+    return f"{y}-{m - 1:02d}"
+
+
+def _sums(rows: list[Expense], month: str) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for e in rows:
+        if e.day.strftime("%Y-%m") == month:
+            out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def _status(prev_amount: int, amount: int) -> str:
+    if prev_amount == 0 and amount != 0:
+        return "新規"
+    if amount == 0 and prev_amount != 0:
+        return "消滅"
+    diff = amount - prev_amount
+    if diff > 0:
+        return "増"
+    if diff < 0:
+        return "減"
+    return "変化なし"
+
+
+def _delta(category: str, prev_amount: int, amount: int) -> CategoryDelta:
+    diff = amount - prev_amount
+    ratio = None if prev_amount == 0 else diff / abs(prev_amount)
+    return CategoryDelta(
+        category=category,
+        prev_amount=prev_amount,
+        amount=amount,
+        diff=diff,
+        ratio=ratio,
+        status=_status(prev_amount, amount),
+    )
+
+
+def compare_months(
+    rows: list[Expense], month: str, prev: str | None = None
+) -> MonthComparison:
+    """Compare `month` (YYYY-MM) with `prev` (default: the calendar month before)."""
+    _check_month(month)
+    if prev is None:
+        prev = _previous_month(month)
+    else:
+        _check_month(prev)
+
+    cur = _sums(rows, month)
+    old = _sums(rows, prev)
+    items = [
+        _delta(cat, old.get(cat, 0), cur.get(cat, 0)) for cat in set(cur) | set(old)
+    ]
+    items.sort(key=lambda d: (-abs(d.diff), d.category))
+    total = _delta(_TOTAL, sum(old.values()), sum(cur.values()))
+    return MonthComparison(month=month, prev=prev, items=items, total=total)
+
+
+def _line(d: CategoryDelta) -> str:
+    ratio = "-" if d.ratio is None else f"{d.ratio:+.1%}"
+    return (
+        f"{d.category}: {d.prev_amount}円 → {d.amount}円 "
+        f"({d.diff:+d}円, {ratio}, {d.status})"
+    )
+
+
+def format_comparison(c: MonthComparison) -> str:
+    lines = [f"{c.prev} → {c.month}"]
+    lines.extend(_line(d) for d in c.items)
+    lines.append(_line(c.total))
+    return "\n".join(lines)
