@@ -0,0 +1,231 @@
+from __future__ import annotations
+
+from datetime import date, datetime
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import And, Cond, Not, Or, search
+
+ROWS = [
+    Expense(date(2024, 1, 5), "食費", 100, "NETFLIX"),
+    Expense(date(2024, 1, 10), "交通費", 2000, "電車"),
+    Expense(date(2024, 2, 1), "食費", -500, "返金 スーパー"),
+    Expense(date(2024, 2, 29), "Food", 3000, "ＮＥＴ ｓｈｏｐ"),
+    Expense(date(2024, 3, 31), " 食費 ", 0, ""),
+]
+
+
+def _days(rows: list[Expense]) -> list[date]:
+    return [r.day for r in rows]
+
+
+ALL_DAYS = _days(ROWS)
+
+
+# --- 表の全行 (E3-1 〜 E3-3) ---
+
+
+@pytest.mark.parametrize(
+    ("rows", "query", "expected"),
+    [
+        pytest.param(
+            [Expense(date(2024, 1, 1), "食費", 100, "")],
+            Cond(min_amount=100, max_amount=100),
+            [date(2024, 1, 1)],
+            id="E3-1",
+        ),
+        pytest.param(ROWS, Or(()), [], id="E3-2"),
+        pytest.param(
+            ROWS,
+            Cond(memo_contains="ｎｅｔ"),
+            [date(2024, 1, 5), date(2024, 2, 29)],
+            id="E3-3",
+        ),
+    ],
+)
+def test_spec_table(rows, query, expected):
+    assert _days(search(rows, query)) == expected
+
+
+# --- R1: Cond の項目は AND、カテゴリ・メモの比較 ---
+
+
+@pytest.mark.parametrize(
+    ("query", "expected"),
+    [
+        pytest.param(
+            Cond(category="  food "),
+            [date(2024, 2, 29)],
+            id="R1-category-case-and-space",
+        ),
+        pytest.param(Cond(category="食"), [], id="R1-category-exact-not-partial"),
+        pytest.param(
+            Cond(category="食費"),
+            [date(2024, 1, 5), date(2024, 2, 1), date(2024, 3, 31)],
+            id="R1-category-row-trimmed",
+        ),
+        pytest.param(Cond(memo_contains=""), ALL_DAYS, id="R1-memo-empty-always-true"),
+        pytest.param(
+            Cond(memo_contains="netshop"),
+            [date(2024, 2, 29)],
+            id="R1-memo-whitespace-and-width",
+        ),
+        pytest.param(
+            Cond(memo_contains="netflix"),
+            [date(2024, 1, 5)],
+            id="R1-memo-case-insensitive",
+        ),
+        pytest.param(
+            Cond(category="食費", memo_contains="返金", min_amount=-500),
+            [date(2024, 2, 1)],
+            id="R1-fields-and",
+        ),
+        pytest.param(
+            Cond(category="食費", min_amount=1000), [], id="R1-fields-and-no-match"
+        ),
+        pytest.param(Cond(), ALL_DAYS, id="R1-empty-cond-matches-all"),
+    ],
+)
+def test_r1_cond_fields(query, expected):
+    assert _days(search(ROWS, query)) == expected
+
+
+# --- R2: 範囲は両端を含む、負の金額、不正な範囲は ValueError ---
+
+
+@pytest.mark.parametrize(
+    ("query", "expected_amounts"),
+    [
+        pytest.param(
+            Cond(min_amount=2000, max_amount=2000), [2000], id="R2-amount-min-eq-max"
+        ),
+        pytest.param(
+            Cond(min_amount=-500, max_amount=100),
+            [100, -500, 0],
+            id="R2-amount-both-ends-inclusive",
+        ),
+        pytest.param(Cond(max_amount=-1), [-500], id="R2-amount-negative-range"),
+        pytest.param(Cond(min_amount=3000), [3000], id="R2-amount-open-max"),
+        pytest.param(Cond(max_amount=-501), [], id="R2-amount-no-match"),
+    ],
+)
+def test_r2_amount_range(query, expected_amounts):
+    assert sorted(r.amount for r in search(ROWS, query)) == sorted(expected_amounts)
+
+
+@pytest.mark.parametrize(
+    ("query", "expected"),
+    [
+        pytest.param(
+            Cond(start=date(2024, 2, 1), end=date(2024, 2, 1)),
+            [date(2024, 2, 1)],
+            id="R2-date-start-eq-end",
+        ),
+        pytest.param(
+            Cond(end=date(2024, 1, 10)),
+            [date(2024, 1, 5), date(2024, 1, 10)],
+            id="R2-date-end-inclusive",
+        ),
+        pytest.param(
+            Cond(start=date(2024, 3, 31)),
+            [date(2024, 3, 31)],
+            id="R2-date-start-inclusive",
+        ),
+    ],
+)
+def test_r2_date_range(query, expected):
+    assert _days(search(ROWS, query)) == expected
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        pytest.param(Cond(min_amount=2, max_amount=1), id="R2-amount-min-gt-max"),
+        pytest.param(
+            Cond(start=date(2024, 2, 2), end=date(2024, 2, 1)),
+            id="R2-date-start-gt-end",
+        ),
+        pytest.param(
