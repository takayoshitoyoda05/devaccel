+def test_r4_keeps_input_order_and_does_not_mutate():
+    rows = [
+        Expense(date(2024, 3, 1), "食費", 300, "b"),
+        Expense(date(2024, 1, 1), "食費", 100, "a"),
+        Expense(date(2024, 2, 1), "食費", 200, "c"),
+    ]
+    snapshot = list(rows)
+    result = search(rows, Cond(category="食費"))
+    assert result == rows
+    assert rows == snapshot
+    assert result is not rows
