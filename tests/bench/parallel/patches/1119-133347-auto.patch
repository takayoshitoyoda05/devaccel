+++ b/tests/test_compare.py
@@ -0,0 +1,209 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.compare import compare_months, format_comparison
+from kakeibo.core import Expense
+
+
+def _e(y: int, m: int, category: str, amount: int) -> Expense:
+    return Expense(day=date(y, m, 10), category=category, amount=amount)
+
+
+def _item(c, category: str):  # type: ignore[no-untyped-def]
+    return next(i for i in c.items if i.category == category)
+
+
+# 例の表 E4-1 / E4-2 / E4-3 はここに ID を付けて写す。
+
+
+@pytest.mark.parametrize(
+    ("rows", "month", "prev", "category", "expected"),
+    [
+        pytest.param(
+            [_e(2026, 1, "食費", 10000), _e(2026, 2, "食費", 12500)],
+            "2026-02",
+            "2026-01",
+            "食費",
+            (10000, 12500, 2500, 0.25, "増"),
+            id="E4-1",
+        ),
+        pytest.param(
+            [_e(2026, 2, "交通費", 3000)],
+            "2026-02",
+            "2026-01",
+            "交通費",
+            (0, 3000, 3000, None, "新規"),
+            id="E4-2",
+        ),
+    ],
+)
+def test_example_table(rows, month, prev, category, expected) -> None:  # type: ignore[no-untyped-def]
+    c = compare_months(rows, month, prev)
+    i = _item(c, category)
+    prev_amount, amount, diff, ratio, status = expected
+    assert (i.prev_amount, i.amount, i.diff, i.status) == (
+        prev_amount,
+        amount,
+        diff,
+        status,
+    )
+    if ratio is None:
+        assert i.ratio is None
+    else:
+        assert i.ratio == pytest.approx(ratio)
+
+
+@pytest.mark.parametrize(
+    ("month", "expected_prev"),
+    [
+        pytest.param("2026-01", "2025-12", id="E4-3"),
+        pytest.param("2026-03", "2026-02", id="default-prev-same-year"),
+    ],
+)
+def test_prev_defaults_to_calendar_previous_month(
+    month: str, expected_prev: str
+) -> None:
+    assert compare_months([], month).prev == expected_prev
+
+
+@pytest.mark.parametrize(
+    ("month", "prev"),
+    [
+        ("2026-13", None),
+        ("2026-00", None),
+        ("2026-1", None),
+        ("abc", None),
+        ("2026-02", "2026-1"),
+        ("2026-02", "2026-00"),
+        ("2026-02", "202601"),
+    ],
+)
+def test_invalid_month_raises(month: str, prev: str | None) -> None:
+    with pytest.raises(ValueError):
+        compare_months([], month, prev)
+
+
+def test_sums_include_negative_amounts() -> None:
+    rows = [
+        _e(2026, 1, "雑費", -1000),
+        _e(2026, 1, "雑費", 300),
+        _e(2026, 2, "雑費", -500),
+    ]
+    i = _item(compare_months(rows, "2026-02", "2026-01"), "雑費")
+    assert (i.prev_amount, i.amount) == (-700, -500)
+
+
+def test_negative_prev_ratio_uses_absolute_value() -> None:
+    rows = [_e(2026, 1, "雑費", -1000), _e(2026, 2, "雑費", -500)]
+    i = _item(compare_months(rows, "2026-02", "2026-01"), "雑費")
+    assert i.diff == 500
+    assert i.ratio == pytest.approx(0.5)
+    assert i.status == "増"
+
+
+def test_other_months_are_excluded() -> None:
+    rows = [
+        _e(2025, 12, "食費", 999),
+        _e(2026, 1, "食費", 100),
+        _e(2026, 2, "食費", 200),
+        _e(2026, 3, "食費", 999),
+    ]
+    i = _item(compare_months(rows, "2026-02", "2026-01"), "食費")
+    assert (i.prev_amount, i.amount) == (100, 200)
+
+
+def test_disappeared_category_is_消滅() -> None:
+    rows = [_e(2026, 1, "食費", 1000)]
+    i = _item(compare_months(rows, "2026-02", "2026-01"), "食費")
+    assert (i.amount, i.diff, i.ratio, i.status) == (0, -1000, -1.0, "消滅")
+
+
+def test_decrease_is_減() -> None:
+    rows = [_e(2026, 1, "食費", 1000), _e(2026, 2, "食費", 500)]
+    i = _item(compare_months(rows, "2026-02", "2026-01"), "食費")
+    assert (i.diff, i.ratio, i.status) == (-500, -0.5, "減")
+
+
+def test_no_change_is_変化なし() -> None:
+    rows = [_e(2026, 1, "食費", 1000), _e(2026, 2, "食費", 1000)]
+    i = _item(compare_months(rows, "2026-02", "2026-01"), "食費")
+    assert (i.diff, i.ratio, i.status) == (0, 0.0, "変化なし")
+
+
+def test_offsetting_rows_within_month_are_変化なし() -> None:
+    # 前月は +1000 と -1000 が相殺して 0、今月も 0
+    rows = [
+        _e(2026, 1, "食費", 1000),
+        _e(2026, 1, "食費", -1000),
+        _e(2026, 2, "食費", 500),
+        _e(2026, 2, "食費", -500),
+    ]
+    i = _item(compare_months(rows, "2026-02", "2026-01"), "食費")
+    assert (i.prev_amount, i.amount, i.diff) == (0, 0, 0)
+    assert i.ratio is None
+    assert i.status == "変化なし"
+
+
+def test_items_sorted_by_abs_diff_then_category() -> None:
+    rows = [
+        _e(2026, 1, "A", 1000),
+        _e(2026, 2, "A", 1100),  # diff 100
+        _e(2026, 1, "B", 1000),
+        _e(2026, 2, "B", 900),  # diff -100
+        _e(2026, 1, "C", 0),
+        _e(2026, 2, "C", 500),  # diff 500
+    ]
+    c = compare_months(rows, "2026-02", "2026-01")
+    assert [i.category for i in c.items] == ["C", "A", "B"]
+
+
+def test_items_empty_and_total_zero_when_no_rows() -> None:
+    c = compare_months([], "2026-02", "2026-01")
+    assert c.items == []
+    assert c.total.category == "合計"
+    assert (c.total.prev_amount, c.total.amount, c.total.diff) == (0, 0, 0)
+    assert c.total.ratio is None
+    assert c.total.status == "変化なし"
+
+
+def test_total_sums_all_categories() -> None:
+    rows = [
+        _e(2026, 1, "食費", 10000),
+        _e(2026, 1, "交通費", 2000),
+        _e(2026, 2, "食費", 12500),
+        _e(2026, 2, "娯楽", 500),
+    ]
+    c = compare_months(rows, "2026-02", "2026-01")
+    t = c.total
+    assert (t.category, t.prev_amount, t.amount, t.diff) == (
+        "合計",
+        12000,
+        13000,
+        1000,
+    )
+    assert t.ratio == pytest.approx(1000 / 12000)
+    assert t.status == "増"
+
+
+def test_comparison_is_frozen() -> None:
+    c = compare_months([], "2026-02", "2026-01")
+    with pytest.raises(AttributeError):
+        c.month = "2026-03"  # type: ignore[misc]
+
+
+def test_format_comparison_lines() -> None:
+    rows = [
+        _e(2026, 1, "食費", 10000),
+        _e(2026, 2, "食費", 12500),
+        _e(2026, 2, "交通費", 3000),
+    ]
+    text = format_comparison(compare_months(rows, "2026-02", "2026-01"))
+    assert text.splitlines() == [
+        "2026-01 → 2026-02",
+        "交通費: 0円 → 3000円 (+3000円, -, 新規)",
+        "食費: 10000円 → 12500円 (+2500円, +25.0%, 増)",
+        "合計: 10000円 → 15500円 (+5500円, +55.0%, 増)",
+    ]
diff --git a/tests/test_importer.py b/tests/test_importer.py
new file mode 100644
index 0000000..5a76489
--- /dev/null
+++ b/tests/test_importer.py
@@ -0,0 +1,242 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.importer import ImportResult, RowError, import_statement
+
+
+def _one_amount(raw: str) -> ImportResult:
+    """Single amount column, one data row."""
+    return import_statement(f'date,amount\n2026-01-05,"{raw}"')
+
+
+# --- 例の表 (E1) -------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param(
+            '利用日,ご利用店名,利用金額\n2026/1/5,ＮＥＴＦＬＩＸ,"1,490円"',
+            ImportResult([Expense(date(2026, 1, 5), "未分類", 1490, "NETFLIX")], [], 0),
+            id="E1-1",
+        ),
+        pytest.param(
+            "日付,出金額,入金額,摘要\n2026-01-06,,5000,返金",
+            ImportResult([Expense(date(2026, 1, 6), "未分類", -5000, "返金")], [], 0),
+            id="E1-2",
+        ),
+        pytest.param(
+            "date,amount\n2026-02-30,abc",
+            ImportResult(
+                [],
+                [
+                    RowError(2, "日付", "2026-02-30", "存在しない日付です"),
+                    RowError(2, "金額", "abc", "金額の形式が不正です"),
+                ],
+                0,
+            ),
+            id="E1-3",
+        ),
+    ],
+)
+def test_example_table(text: str, expected: ImportResult) -> None:
+    assert import_statement(text) == expected
+
+
+# --- R1 入力・区切り・行番号 ---------------------------------------------------
+
+
+def test_bom_is_stripped() -> None:
+    result = import_statement("﻿date,amount\n2026-01-05,100")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+    assert result.errors == []
+
+
+def test_tab_delimiter_chosen_when_more_tabs_than_commas() -> None:
+    result = import_statement("日付\t金額\t摘要\n2026-01-05\t100\ta,b")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "a,b")]
+
+
+def test_same_count_uses_comma() -> None:
+    result = import_statement("date,amount\t\n2026-01-05,100\t")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+def test_quoted_newline_reports_record_start_line() -> None:
+    # Record 2 spans physical lines 2-3; the bad record starts on line 4.
+    text = 'date,amount,memo\n2026-01-05,100,"a\nb"\n2026-02-30,5,x'
+    result = import_statement(text)
+    assert result.errors == [RowError(4, "日付", "2026-02-30", "存在しない日付です")]
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "a\nb")]
+
+
+def test_blank_lines_are_ignored_and_not_counted_as_skipped() -> None:
+    result = import_statement("date,amount\n\n2026-01-05,100\n\n")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+    assert result.skipped == 0
+
+
+# --- R2 列名・カテゴリ ---------------------------------------------------------
+
+
+def test_header_matching_ignores_case_spaces_and_width() -> None:
+    result = import_statement(" ＤＡＴＥ , AMOUNT ,Memo\n2026-01-05,100,x")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "x")]
+
+
+def test_category_column_is_used_and_blank_becomes_uncategorized() -> None:
+    result = import_statement(
+        "日付,金額,カテゴリー\n2026-01-05,100,食費\n2026-01-06,200,"
+    )
+    assert [e.category for e in result.expenses] == ["食費", "未分類"]
+
+
+# --- R3 ヘッダーの誤り ----------------------------------------------------------
+
+
+def test_missing_date_column_is_header_error() -> None:
+    result = import_statement("金額,摘要\n100,x")
+    assert result.expenses == []
+    assert result.errors == [RowError(1, "日付", "", "日付列がありません")]
+
+
+def test_missing_amount_columns_is_header_error() -> None:
+    result = import_statement("日付,摘要\n2026-01-05,x")
+    assert result.expenses == []
+    assert [e.column for e in result.errors] == ["金額"]
+    assert result.errors[0].line == 1
+
+
+def test_empty_input_returns_empty_result() -> None:
+    assert import_statement("") == ImportResult([], [], 0)
+
+
+def test_header_only_returns_empty_result() -> None:
+    assert import_statement("日付,金額\n") == ImportResult([], [], 0)
+
+
+# --- R4 日付 -------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026.1.5",
+        "20260105",
+        "2026年1月5日",
+        "2026-01-05 12:34",
+        "2026-01-05T12:34:56",
+        "２０２６／１／５",
+    ],
+)
+def test_accepted_date_formats(raw: str) -> None:
+    result = import_statement(f"date,amount\n{raw},100")
+    assert result.errors == []
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+@pytest.mark.parametrize(
+    ("raw", "reason"),
+    [
+        ("2026-02-30", "存在しない日付です"),
+        ("令和8年1月5日", "和暦は未対応です"),
+        ("R8.1.5", "和暦は未対応です"),
+        ("2026-01-05 25:00", "日付の形式が不正です"),
+        ("", "日付が空です"),
+    ],
+)
+def test_invalid_dates(raw: str, reason: str) -> None:
+    result = import_statement(f"date,amount\n{raw},100")
+    assert result.expenses == []
+    assert result.errors == [RowError(2, "日付", raw, reason)]
+
+
+# --- R5 金額 -------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("raw", "amount"),
+    [
+        ("1,490円", 1490),
+        ("¥1,490", 1490),
+        ("￥1,490", 1490),
+        ("JPY 300", 300),
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("12.0", 12),
+        ("12.00", 12),
+    ],
+)
+def test_accepted_amounts(raw: str, amount: int) -> None:
+    result = _one_amount(raw)
+    assert result.errors == []
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", amount, "")]
+
+
+@pytest.mark.parametrize("raw", ["12.5", "abc", "1,2.3.4", "(-5)"])
+def test_invalid_amounts(raw: str) -> None:
+    result = _one_amount(raw)
+    assert result.expenses == []
+    assert len(result.errors) == 1
+    assert result.errors[0].column == "金額"
+    assert result.errors[0].value == raw
+
+
+@pytest.mark.parametrize("raw", ["", "-", "—", "0"])
+def test_blank_or_zero_single_amount_is_skipped(raw: str) -> None:
+    result = _one_amount(raw)
+    assert result == ImportResult([], [], 1)
+
+
+# --- R6 2 列形式 ---------------------------------------------------------------
+
+
+def test_two_column_both_filled_is_error() -> None:
+    result = import_statement("日付,出金額,入金額\n2026-01-05,100,200")
+    assert result.expenses == []
+    assert [e.column for e in result.errors] == ["出金/入金"]
+
+
+def test_two_column_both_empty_or_zero_is_skipped() -> None:
+    result = import_statement("日付,出金額,入金額\n2026-01-05,,\n2026-01-06,0,0")
+    assert result == ImportResult([], [], 2)
+
+
+def test_two_column_withdrawal_is_positive() -> None:
+    result = import_statement("日付,出金額,入金額\n2026-01-05,1200,")
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 1200, "")]
+
+
+# --- R7 列数の不一致 -------------------------------------------------------------
+
+
+def test_column_count_mismatch_is_row_error() -> None:
+    result = import_statement("日付,金額\n2026-01-05,1,234円")
+    assert result.expenses == []
+    assert len(result.errors) == 1
+    assert result.errors[0].column == "(行)"
+    assert result.errors[0].line == 2
+    assert "列数" in result.errors[0].reason
+
+
+# --- R8 行内の全誤り・順序 -------------------------------------------------------
+
+
+def test_order_preserved_and_valid_rows_kept() -> None:
+    text = "date,amount\n2026-01-05,100\n2026-13-01,x\n2026-01-07,300"
+    result = import_statement(text)
+    assert result.expenses == [
+        Expense(date(2026, 1, 5), "未分類", 100, ""),
+        Expense(date(2026, 1, 7), "未分類", 300, ""),
+    ]
+    assert [e.line for e in result.errors] == [3, 3]
