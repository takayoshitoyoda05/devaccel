index 0000000..e1c7747
--- /dev/null
+++ b/tests/test_importer.py
@@ -0,0 +1,224 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.importer import ImportResult, import_statement
+
+
+def test_spec_example_full_width_quoted_amount():
+    text = '利用日,利用店名,利用金額\n2024/3/5,コンビニ,"1,200円"\n'
+    assert import_statement(text) == ImportResult(
+        expenses=[Expense(date(2024, 3, 5), "未分類", 1200, "コンビニ")],
+        errors=[],
+    )
+
+
+def test_empty_string_returns_nothing():
+    assert import_statement("") == ImportResult(expenses=[], errors=[])
+
+
+def test_whitespace_or_blank_only_returns_nothing():
+    assert import_statement("\n  \n\t\n") == ImportResult(expenses=[], errors=[])
+
+
+def test_bom_is_ignored():
+    text = "﻿date,amount\n2024-03-05,100\n"
+    assert import_statement(text).expenses == [
+        Expense(date(2024, 3, 5), "未分類", 100, "")
+    ]
+
+
+@pytest.mark.parametrize("sep", [",", "\t", ";"])
+def test_delimiters_autodetected(sep):
+    text = (
+        sep.join(["date", "amount", "memo"])
+        + "\n"
+        + sep.join(["2024-03-05", "300", "x"])
+        + "\n"
+    )
+    assert import_statement(text) == ImportResult(
+        expenses=[Expense(date(2024, 3, 5), "未分類", 300, "x")], errors=[]
+    )
+
+
+@pytest.mark.parametrize(
+    "header",
+    [
+        "date,amount",
+        " Date , AMOUNT ",
+        "日付,金額",
+        "利用日,利用金額",
+        "取引日,支払金額",
+        "年月日,出金額",
+        "transaction date,支出",
+        "取引日,引出",
+    ],
+)
+def test_column_aliases_accepted(header):
+    text = header + "\n2024-03-05,100\n"
+    result = import_statement(text)
+    assert result.errors == []
+    assert result.expenses == [Expense(date(2024, 3, 5), "未分類", 100, "")]
+
+
+@pytest.mark.parametrize("name", ["category", "カテゴリ", "分類", "費目", " Category "])
+def test_category_column_aliases(name):
+    text = f"date,{name},amount\n2024-03-05,食費,100\n"
+    result = import_statement(text)
+    assert result.errors == []
+    assert result.expenses[0].category == "食費"
+
+
+def test_category_and_memo_aliases():
+    text = "日付,費目,金額,摘要\n2024-03-05,食費,100,ランチ\n"
+    assert import_statement(text).expenses == [
+        Expense(date(2024, 3, 5), "食費", 100, "ランチ")
+    ]
+    text = "date,amount,店名\n2024-03-05,100,ABC\n"
+    assert import_statement(text).expenses[0].memo == "ABC"
+    text = "date,amount,利用店名\n2024-03-05,100,DEF\n"
+    assert import_statement(text).expenses[0].memo == "DEF"
+
+
+def test_missing_date_column():
+    result = import_statement("amount,memo\n100,x\n")
+    assert result.expenses == []
+    assert result.errors == [(1, "列 date がありません")]
+
+
+def test_missing_amount_column():
+    result = import_statement("date,memo\n2024-03-05,x\n")
+    assert result.expenses == []
+    assert result.errors == [(1, "列 amount がありません")]
+
+
+def test_missing_both_columns_reports_two_errors():
+    result = import_statement("memo,category\n2024-03-05,x\n")
+    assert result.expenses == []
+    assert result.errors == [
+        (1, "列 date がありません"),
+        (1, "列 amount がありません"),
+    ]
+
+
+@pytest.mark.parametrize(
+    "value, expected",
+    [
+        ("2024-03-05", date(2024, 3, 5)),
+        ("2024/03/05", date(2024, 3, 5)),
+        ("2024/3/5", date(2024, 3, 5)),
+        ("20240305", date(2024, 3, 5)),
+        ("2024年3月5日", date(2024, 3, 5)),
+        ("2024年12月31日", date(2024, 12, 31)),
+        (" 2024-03-05 ", date(2024, 3, 5)),
+    ],
+)
+def test_date_formats_accepted(value, expected):
+    result = import_statement(f"date,amount\n{value},100\n")
+    assert result.errors == []
+    assert result.expenses[0].day == expected
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["2024-02-30", "2023-02-29", "2024-13-01", "2024-3-5", "24-03-05", "abc", ""],
+)
+def test_invalid_dates_reported(value):
+    result = import_statement(f"date,amount\n{value},100\n")
+    assert result.expenses == []
+    assert result.errors == [(2, f"日付が不正です: {value!r}")]
+
+
+@pytest.mark.parametrize(
+    "value, expected",
+    [
+        ("1,234", 1234),
+        ("¥1,234", 1234),
+        ("￥1,234", 1234),
+        ("1234円", 1234),
+        ("1,234円", 1234),
+        (" 1234 ", 1234),
+        ("１２３４", 1234),
+        ("-500", -500),
+        ("(500)", -500),
+        ("▲500", -500),
+        ("0", 0),
+        ("-0", 0),
+        ("1,234,567", 1234567),
+    ],
+)
+def test_amount_formats(value, expected):
+    result = import_statement(f'date,amount\n2024-03-05,"{value}"\n')
+    assert result.errors == []
+    assert result.expenses[0].amount == expected
+    assert type(result.expenses[0].amount) is int
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["12.5", "", "   ", "abc", "1,23", "1234,567", "+500", "¥-500", "1 234", "(500"],
+)
+def test_invalid_amounts_reported(value):
+    result = import_statement(f'date,amount\n2024-03-05,"{value}"\n')
+    assert result.expenses == []
+    assert result.errors == [(2, f"金額が不正です: {value!r}")]
+
+
+def test_missing_category_column_uses_default():
+    result = import_statement("date,amount\n2024-03-05,100\n", default_category="雑費")
+    assert result.expenses[0].category == "雑費"
+
+
+def test_empty_category_cell_uses_default():
+    result = import_statement("date,category,amount\n2024-03-05,  ,100\n")
+    assert result.expenses[0].category == "未分類"
+
+
+def test_category_value_is_stripped():
+    result = import_statement("date,category,amount\n2024-03-05, 食費 ,100\n")
+    assert result.expenses[0].category == "食費"
+
+
+def test_missing_memo_column_gives_empty_string():
+    result = import_statement("date,amount\n2024-03-05,100\n")
+    assert result.expenses[0].memo == ""
+
+
+def test_input_order_is_kept():
+    text = "date,amount\n2024-03-10,1\n2024-01-01,2\n2024-02-05,3\n"
+    assert [e.amount for e in import_statement(text).expenses] == [1, 2, 3]
+
+
+def test_line_numbers_are_physical_and_blank_lines_skipped():
+    text = "date,amount\n\n2024-03-05,100\n\n2024-03-06,oops\n"
+    result = import_statement(text)
+    assert result.expenses == [Expense(date(2024, 3, 5), "未分類", 100, "")]
+    assert result.errors == [(5, "金額が不正です: 'oops'")]
+
+
+def test_bad_rows_do_not_stop_good_rows():
+    text = (
+        "date,amount\n2024-02-30,100\n2024-03-05,200\n2024-03-06,x\n2024-03-07,-300\n"
+    )
+    result = import_statement(text)
+    assert result.expenses == [
+        Expense(date(2024, 3, 5), "未分類", 200, ""),
+        Expense(date(2024, 3, 7), "未分類", -300, ""),
+    ]
+    assert result.errors == [
+        (2, "日付が不正です: '2024-02-30'"),
+        (4, "金額が不正です: 'x'"),
+    ]
+
+
+def test_short_row_is_reported_not_raised():
+    result = import_statement("date,category,amount\n2024-03-05\n")
+    assert result.expenses == []
+    assert result.errors == [(2, "金額が不正です: ''")]
+
+
+def test_only_header_gives_no_expenses():
+    assert import_statement("date,amount\n") == ImportResult(expenses=[], errors=[])
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..668f1eb
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,258 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, detect_recurring, predict_next
+
+
+def ex(day: str, amount: int, category: str = "住居", memo: str = "家賃") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+def trio(
+    category: str, memo: str, amount: int, days: tuple[str, str, str] | None = None
+) -> list[Expense]:
+    d1, d2, d3 = days or ("2024-01-05", "2024-02-05", "2024-03-05")
+    return [ex(d, amount, category, memo) for d in (d1, d2, d3)]
+
+
+# --- predict_next ---------------------------------------------------------
+
+
+def test_predict_next_same_day_in_next_month() -> None:
+    assert predict_next(date(2024, 3, 25)) == date(2024, 4, 25)
+
+
+def test_predict_next_clamps_to_month_end_in_leap_year() -> None:
+    assert predict_next(date(2024, 1, 31)) == date(2024, 2, 29)
+
+
+def test_predict_next_clamps_to_month_end_in_non_leap_year() -> None:
+    assert predict_next(date(2025, 1, 31)) == date(2025, 2, 28)
+
+
+def test_predict_next_rolls_over_year_end() -> None:
+    assert predict_next(date(2024, 12, 15)) == date(2025, 1, 15)
+
+
+def test_predict_next_hint_overrides_last_day() -> None:
+    assert predict_next(date(2024, 3, 24), 25) == date(2024, 4, 25)
+
+
+def test_predict_next_hint_clamped_to_month_end() -> None:
+    assert predict_next(date(2024, 1, 10), 31) == date(2024, 2, 29)
+
+
+def test_predict_next_hint_rolls_over_year_end() -> None:
+    assert predict_next(date(2024, 12, 5), 31) == date(2025, 1, 31)
+
+
+# --- detect_recurring: basics ---------------------------------------------
+
+
+def test_basic_example_detected() -> None:
+    rows = trio("住居", "家賃", 80000, ("2024-01-25", "2024-02-25", "2024-03-25"))
+    assert detect_recurring(rows) == [
+        Recurring(
+            category="住居",
+            memo="家賃",
+            amount=80000,
+            count=3,
+            last_date=date(2024, 3, 25),
+            next_date=date(2024, 4, 25),
+        )
+    ]
+
+
+def test_empty_rows_returns_empty_list() -> None:
+    assert detect_recurring([]) == []
+
+
+def test_min_occurrences_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        detect_recurring([], min_occurrences=1)
+
+
+def test_min_occurrences_zero_raises() -> None:
+    with pytest.raises(ValueError):
+        detect_recurring([], min_occurrences=0)
+
+
+def test_two_occurrences_excluded_by_default_min_of_three() -> None:
+    rows = trio("住居", "家賃", 80000)[:2]
+    assert detect_recurring(rows) == []
+
+
+def test_two_occurrences_detected_when_min_is_two() -> None:
+    rows = trio("住居", "家賃", 80000)[:2]
+    result = detect_recurring(rows, min_occurrences=2)
+    assert [(r.count, r.last_date) for r in result] == [(2, date(2024, 2, 5))]
+
+
+def test_fewer_occurrences_than_higher_min_excluded() -> None:
+    assert detect_recurring(trio("住居", "家賃", 80000), min_occurrences=4) == []
+
+
+# --- detect_recurring: month structure ------------------------------------
+
+
+def test_same_month_twice_excludes_group() -> None:
+    rows = [
+        ex("2024-01-05", 1000),
+        ex("2024-01-20", 1000),
+        ex("2024-02-05", 1000),
+        ex("2024-03-05", 1000),
+    ]
+    assert detect_recurring(rows, min_occurrences=2) == []
+
+
+def test_missing_month_excludes_group() -> None:
+    rows = [ex("2024-01-05", 1000), ex("2024-02-05", 1000), ex("2024-04-05", 1000)]
+    assert detect_recurring(rows) == []
+
+
+def test_consecutive_months_across_year_boundary_detected() -> None:
+    rows = trio("通信", "携帯", 3000, ("2024-11-10", "2024-12-10", "2025-01-10"))
+    result = detect_recurring(rows)
+    assert result == [
+        Recurring(
+            category="通信",
+            memo="携帯",
+            amount=3000,
+            count=3,
+            last_date=date(2025, 1, 10),
+            next_date=date(2025, 2, 10),
+        )
+    ]
+
+
+def test_unsorted_input_is_handled() -> None:
+    rows = trio("住居", "家賃", 80000)
+    result = detect_recurring(list(reversed(rows)))
+    assert [r.last_date for r in result] == [date(2024, 3, 5)]
+
+
+def test_duplicate_month_does_not_hide_other_groups() -> None:
+    rows = [
+        ex("2024-01-05", 1000, "食費", "a"),
+        ex("2024-01-06", 1000, "食費", "a"),
+        ex("2024-02-05", 1000, "食費", "a"),
+        *trio("住居", "家賃", 80000),
+    ]
+    assert [(r.category, r.memo) for r in detect_recurring(rows)] == [("住居", "家賃")]
+
+
+# --- detect_recurring: amount tolerance -----------------------------------
+
+
+def test_amount_within_ten_percent_of_mode_included() -> None:
+    rows = [
+        ex("2024-01-05", 10000),
+        ex("2024-02-05", 10000),
+        ex("2024-03-05", 9500),
+    ]
+    result = detect_recurring(rows)
+    assert [r.amount for r in result] == [10000]
+
+
+def test_amount_exactly_ten_percent_off_included() -> None:
+    rows = [
+        ex("2024-01-05", 10000),
+        ex("2024-02-05", 10000),
+        ex("2024-03-05", 9000),
+        ex("2024-04-05", 11000),
+    ]
+    result = detect_recurring(rows)
+    assert [(r.amount, r.count) for r in result] == [(10000, 4)]
+
+
+def test_amount_beyond_ten_percent_excluded() -> None:
+    rows = [
+        ex("2024-01-05", 10000),
+        ex("2024-02-05", 10000),
+        ex("2024-03-05", 11100),
+    ]
+    assert detect_recurring(rows) == []
+
+
+def test_amount_tie_takes_larger_value() -> None:
+    rows = [
+        ex("2024-01-05", 10000),
+        ex("2024-02-05", 10000),
+        ex("2024-03-05", 11000),
+        ex("2024-04-05", 11000),
+    ]
+    result = detect_recurring(rows)
+    assert [(r.amount, r.count) for r in result] == [(11000, 4)]
+
+
+# --- detect_recurring: grouping keys --------------------------------------
+
+
+def test_same_memo_different_category_are_separate_groups() -> None:
+    rows = trio("住居", "家賃", 80000) + trio("食費", "家賃", 5000)
+    assert [(r.category, r.amount) for r in detect_recurring(rows)] == [
+        ("住居", 80000),
+        ("食費", 5000),
+    ]
+
+
+def test_memo_whitespace_is_ignored_for_grouping() -> None:
+    rows = [
+        ex("2024-01-05", 80000, memo=" 家賃 "),
+        ex("2024-02-05", 80000, memo="家賃"),
+        ex("2024-03-05", 80000, memo="家賃 "),
+    ]
+    result = detect_recurring(rows)
+    assert [(r.memo, r.count) for r in result] == [("家賃", 3)]
+
+
+# --- detect_recurring: next_date ------------------------------------------
+
+
+def test_next_date_uses_most_common_day_not_last_day() -> None:
+    rows = trio("住居", "家賃", 80000, ("2024-01-25", "2024-02-25", "2024-03-24"))
+    result = detect_recurring(rows)
+    assert result[0].last_date == date(2024, 3, 24)
+    assert result[0].next_date == date(2024, 4, 25)
+
+
+def test_next_date_day_tie_takes_larger_day() -> None:
+    rows = [
+        ex("2024-01-10", 1000),
+        ex("2024-02-20", 1000),
+        ex("2024-03-10", 1000),
+        ex("2024-04-20", 1000),
+    ]
+    result = detect_recurring(rows)
+    assert result[0].next_date == date(2024, 5, 20)
+
+
+def test_next_date_clamped_to_month_end() -> None:
+    rows = trio("住居", "家賃", 80000, ("2024-01-31", "2024-02-29", "2024-03-31"))
+    result = detect_recurring(rows)
+    assert result[0].next_date == date(2024, 4, 30)
+
+
+# --- detect_recurring: ordering -------------------------------------------
+
+
+def test_results_sorted_by_amount_desc_then_category_then_memo() -> None:
+    rows = (
+        trio("食費", "b", 5000)
+        + trio("食費", "a", 5000)
+        + trio("交通", "z", 5000)
+        + trio("住居", "家賃", 80000)
+    )
+    result = detect_recurring(rows)
+    assert [(r.category, r.memo) for r in result] == [
+        ("住居", "家賃"),
+        ("交通", "z"),
+        ("食費", "a"),
+        ("食費", "b"),
+    ]
diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..37751be
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,267 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    all_of,
+    amount_between,
+    any_of,
+    category_is,
+    date_between,
+    memo_contains,
+    not_,
+    search,
+)
+
+
+def e(
+    day: date = date(2026, 1, 15),
+    category: str = "食費",
+    amount: int = 500,
+    memo: str = "",
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# category_is ---------------------------------------------------------------
+
+
+def test_category_is_matches_exact_name_only() -> None:
+    p = category_is("食費")
+    assert p(e(category="食費"))
+    assert not p(e(category="食"))  # 部分一致ではない
+    assert not p(e(category="食費2"))
+
+
+def test_category_is_matches_any_of_given_names() -> None:
+    p = category_is("食費", "交通")
+    assert p(e(category="食費"))
+    assert p(e(category="交通"))
+    assert not p(e(category="娯楽"))
+
+
+def test_category_is_without_names_raises() -> None:
+    with pytest.raises(ValueError):
+        category_is()
+
+
+# amount_between ------------------------------------------------------------
+
+
+def test_amount_between_includes_both_ends() -> None:
+    p = amount_between(100, 200)
+    assert p(e(amount=100))
+    assert p(e(amount=200))
+    assert p(e(amount=150))
+    assert not p(e(amount=99))
+    assert not p(e(amount=201))
+
+
+def test_amount_between_equal_bounds_matches_that_value() -> None:
+    p = amount_between(300, 300)
+    assert p(e(amount=300))
+    assert not p(e(amount=299))
+
+
+def test_amount_between_low_only() -> None:
+    p = amount_between(low=1000)
+    assert p(e(amount=1000))
+    assert p(e(amount=999999))
+    assert not p(e(amount=999))
+
+
+def test_amount_between_high_only() -> None:
+    p = amount_between(high=1000)
+    assert p(e(amount=1000))
+    assert p(e(amount=0))
+    assert not p(e(amount=1001))
+
+
+def test_amount_between_both_none_is_always_true() -> None:
+    p = amount_between()
+    assert p(e(amount=-5))
+    assert p(e(amount=0))
+    assert p(e(amount=10**9))
+
+
+def test_amount_between_low_greater_than_high_raises() -> None:
+    with pytest.raises(ValueError):
+        amount_between(low=200, high=100)
+
+
+# memo_contains -------------------------------------------------------------
+
+
+def test_memo_contains_partial_match() -> None:
+    p = memo_contains("カフェ")
+    assert p(e(memo="駅前のカフェ代"))
+    assert not p(e(memo="ランチ"))
+
+
+def test_memo_contains_ignores_case_by_default() -> None:
+    p = memo_contains("cafe")
+    assert p(e(memo="Cafe Latte"))
+    assert p(e(memo="CAFE"))
+
+
+def test_memo_contains_case_sensitive_when_requested() -> None:
+    p = memo_contains("cafe", ignore_case=False)
+    assert not p(e(memo="Cafe Latte"))
+    assert p(e(memo="my cafe visit"))
+
+
+def test_memo_contains_empty_text_is_always_true() -> None:
+    assert memo_contains("")(e(memo=""))
+    assert memo_contains("", ignore_case=False)(e(memo="anything"))
+
+
+def test_memo_contains_does_not_match_empty_memo_for_nonempty_text() -> None:
+    assert not memo_contains("カフェ")(e(memo=""))
+
+
+# date_between --------------------------------------------------------------
+
+
+def test_date_between_includes_both_ends() -> None:
+    p = date_between(date(2026, 1, 1), date(2026, 1, 31))
+    assert p(e(day=date(2026, 1, 1)))
+    assert p(e(day=date(2026, 1, 31)))
+    assert p(e(day=date(2026, 1, 15)))
+    assert not p(e(day=date(2025, 12, 31)))
+    assert not p(e(day=date(2026, 2, 1)))
+
+
+def test_date_between_equal_bounds_matches_that_day() -> None:
+    p = date_between(date(2026, 3, 3), date(2026, 3, 3))
+    assert p(e(day=date(2026, 3, 3)))
+    assert not p(e(day=date(2026, 3, 4)))
+
+
+def test_date_between_start_only() -> None:
+    p = date_between(start=date(2026, 6, 1))
+    assert p(e(day=date(2026, 6, 1)))
+    assert p(e(day=date(2030, 1, 1)))
+    assert not p(e(day=date(2026, 5, 31)))
+
+
+def test_date_between_end_only() -> None:
+    p = date_between(end=date(2026, 6, 1))
+    assert p(e(day=date(2026, 6, 1)))
+    assert p(e(day=date(2000, 1, 1)))
+    assert not p(e(day=date(2026, 6, 2)))
+
+
+def test_date_between_both_none_is_always_true() -> None:
+    p = date_between()
+    assert p(e(day=date(1900, 1, 1)))
+    assert p(e(day=date(2999, 12, 31)))
+
+
+def test_date_between_start_after_end_raises() -> None:
+    with pytest.raises(ValueError):
+        date_between(date(2026, 2, 1), date(2026, 1, 1))
+
+
+# all_of / any_of / not_ ---------------------------------------------------
+
+
+def test_all_of_requires_every_predicate() -> None:
+    p = all_of(category_is("食費"), amount_between(high=1000))
+    assert p(e(category="食費", amount=1000))
+    assert not p(e(category="食費", amount=1001))
+    assert not p(e(category="交通", amount=500))
+
+
+def test_all_of_without_arguments_is_always_true() -> None:
+    assert all_of()(e())
+
+
+def test_any_of_requires_at_least_one_predicate() -> None:
+    p = any_of(category_is("食費"), category_is("交通"))
+    assert p(e(category="食費"))
+    assert p(e(category="交通"))
+    assert not p(e(category="娯楽"))
+
+
+def test_any_of_without_arguments_is_always_false() -> None:
+    assert not any_of()(e())
+
+
+def test_not_inverts_predicate() -> None:
+    p = not_(category_is("食費"))
+    assert not p(e(category="食費"))
+    assert p(e(category="交通"))
+
+
+def test_all_of_any_of_and_not_compose() -> None:
+    p = all_of(
+        any_of(category_is("食費"), category_is("交通")),
+        not_(memo_contains("返金")),
+    )
+    assert p(e(category="交通", memo="定期"))
+    assert not p(e(category="交通", memo="返金分"))
+    assert not p(e(category="娯楽", memo="定期"))
+
