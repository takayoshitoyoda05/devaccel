@@ -0,0 +1,90 @@
+"""Month-over-month comparison of expenses by category."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryDiff:
+    category: str
+    previous: int
+    current: int
+    diff: int
+    ratio: float | None
+    status: str
+
+
+def _previous_month(year: int, month: int) -> tuple[int, int]:
+    if month == 1:
+        return year - 1, 12
+    return year, month - 1
+
+
+def _status(previous: int, current: int, diff: int) -> str:
+    if previous == 0 and current > 0:
+        return "新規"
+    if previous > 0 and current == 0:
+        return "なし"
+    if diff > 0:
+        return "増"
+    if diff < 0:
+        return "減"
+    return "変化なし"
+
+
+def _totals(rows: list[Expense], year: int, month: int) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for e in rows:
+        if e.day.year == year and e.day.month == month:
+            out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def compare_months(rows: list[Expense], month: str) -> list[CategoryDiff]:
+    """Compare each category's total in ``month`` ("YYYY-MM") with the calendar month before it."""
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+    year, mon = int(month[:4]), int(month[5:7])
+    prev_year, prev_mon = _previous_month(year, mon)
+    current_totals = _totals(rows, year, mon)
+    previous_totals = _totals(rows, prev_year, prev_mon)
+
+    diffs: list[CategoryDiff] = []
+    for cat in set(current_totals) | set(previous_totals):
+        previous = previous_totals.get(cat, 0)
+        current = current_totals.get(cat, 0)
+        diff = current - previous
+        ratio = None if previous == 0 else diff / previous
+        diffs.append(
+            CategoryDiff(
+                category=cat,
+                previous=previous,
+                current=current,
+                diff=diff,
+                ratio=ratio,
+                status=_status(previous, current, diff),
+            )
+        )
+    diffs.sort(key=lambda d: (-abs(d.diff), d.category))
+    return diffs
+
+
+def format_report(diffs: list[CategoryDiff]) -> str:
+    if not diffs:
+        return "データがありません"
+    lines: list[str] = []
+    for d in diffs:
+        head = f"{d.category}: {d.previous:,}円 → {d.current:,}円"
+        sign = "+" if d.diff >= 0 else ""
+        if d.ratio is None:
+            detail = f"({sign}{d.diff:,}円)"
+        else:
+            detail = f"({sign}{d.diff:,}円, {d.ratio * 100:+.1f}%)"
+        lines.append(f"{head} {detail} {d.status}")
+    return "\n".join(lines)
