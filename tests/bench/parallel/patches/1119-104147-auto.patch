@@ -0,0 +1,129 @@
+"""Import bank/card statement CSV text into Expense records (pure functions)."""
+
+from __future__ import annotations
+
+import csv
+import re
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_DATE_PATTERNS = (
+    re.compile(r"([0-9]{4})-([0-9]{2})-([0-9]{2})"),
+    re.compile(r"([0-9]{4})/([0-9]{1,2})/([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})"),
+    re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日"),
+)
+
+_AMOUNT_BODY_RE = re.compile(r"[0-9]{1,3}(?:,[0-9]{3})+|[0-9]+")
+_FULL_WIDTH_DIGITS = str.maketrans("０１２３４５６７８９", "0123456789")
+
+_ALIASES = {
+    "date": ("date", "日付", "利用日", "取引日", "年月日", "transaction date"),
+    "amount": ("amount", "金額", "利用金額", "支払金額", "出金額", "支出", "引出"),
+    "category": ("category", "カテゴリ", "分類", "費目"),
+    "memo": ("memo", "摘要", "内容", "利用店名", "備考", "description", "店名"),
+}
+
+_DELIMITERS = (",", "\t", ";")
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[tuple[int, str]]  # (physical line number, reason)
+
+
+class _BadRow(ValueError):
+    pass
+
+
+def _detect_delimiter(header: str) -> str:
+    counts = {d: header.count(d) for d in _DELIMITERS}
+    best = max(_DELIMITERS, key=lambda d: counts[d])  # ties keep "," first
+    return best if counts[best] else ","
+
+
+def _find_column(headers: list[str], aliases: tuple[str, ...]) -> int | None:
+    for i, name in enumerate(headers):
+        if name.strip().lower() in aliases:
+            return i
+    return None
+
+
+def _cell(cells: list[str], idx: int | None) -> str:
+    if idx is None or idx >= len(cells):
+        return ""
+    return cells[idx]
+
+
+def _parse_date(raw: str) -> date:
+    text = raw.strip()
+    for pattern in _DATE_PATTERNS:
+        m = pattern.fullmatch(text)
+        if m:
+            try:
+                return date(int(m[1]), int(m[2]), int(m[3]))
+            except ValueError:
+                break
+    raise _BadRow(f"日付が不正です: '{raw}'")
+
+
+def _parse_amount(raw: str) -> int:
+    s = raw.strip().translate(_FULL_WIDTH_DIGITS)
+    negative = False
+    if s.startswith("(") and s.endswith(")"):
+        negative, s = True, s[1:-1]
+    elif s.startswith(("▲", "-")):
+        negative, s = True, s[1:]
+    if s[:1] in ("¥", "￥"):
+        s = s[1:]
+    s = s.removesuffix("円")
+    if not _AMOUNT_BODY_RE.fullmatch(s):
+        raise _BadRow(f"金額が不正です: '{raw}'")
+    value = int(s.replace(",", ""))
+    return -value if negative else value
+
+
+def import_statement(text: str, default_category: str = "未分類") -> ImportResult:
+    """Parse statement CSV text. Never raises; bad rows go to ``errors``."""
+    text = text.removeprefix("﻿")
+    lines = text.splitlines()
+    header_idx = next((i for i, line in enumerate(lines) if line.strip()), None)
+    if header_idx is None:
+        return ImportResult(expenses=[], errors=[])
+
+    header_line = lines[header_idx]
+    delimiter = _detect_delimiter(header_line)
+    headers = next(csv.reader([header_line], delimiter=delimiter))
+
+    date_idx = _find_column(headers, _ALIASES["date"])
+    amount_idx = _find_column(headers, _ALIASES["amount"])
+    category_idx = _find_column(headers, _ALIASES["category"])
+    memo_idx = _find_column(headers, _ALIASES["memo"])
+
+    missing: list[tuple[int, str]] = []
+    if date_idx is None:
+        missing.append((1, "列 date がありません"))
+    if amount_idx is None:
+        missing.append((1, "列 amount がありません"))
+    if missing:
+        return ImportResult(expenses=[], errors=missing)
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    for offset, line in enumerate(lines[header_idx + 1 :], start=header_idx + 2):
+        if not line.strip():
+            continue
+        cells = next(csv.reader([line], delimiter=delimiter))
+        try:
+            day = _parse_date(_cell(cells, date_idx))
+            amount = _parse_amount(_cell(cells, amount_idx))
+        except _BadRow as e:
+            errors.append((offset, str(e)))
+            continue
+        category = _cell(cells, category_idx).strip() or default_category
+        memo = _cell(cells, memo_idx).strip()
+        expenses.append(Expense(day, category, amount, memo))
+    return ImportResult(expenses=expenses, errors=errors)
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..663bdeb
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,81 @@
+"""Detect recurring (monthly) expenses. Pure functions, standard library only."""
+
+from __future__ import annotations
+
+import calendar
+import itertools
+from collections import Counter
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int  # yen
+    count: int
+    last_date: date
+    next_date: date
+
+
+def predict_next(last: date, today_day_hint: int | None = None) -> date:
+    """Same day in the month after ``last``, clamped to that month's last day.
+
+    ``today_day_hint`` replaces the day-of-month used (also clamped).
+    """
+    if last.month == 12:
+        year, month = last.year + 1, 1
+    else:
+        year, month = last.year, last.month + 1
+    day = last.day if today_day_hint is None else today_day_hint
+    last_day = calendar.monthrange(year, month)[1]
+    return date(year, month, min(day, last_day))
+
+
+def _mode_high(values: list[int]) -> int:
+    """Most frequent value; on a tie, the larger value."""
+    counts = Counter(values)
+    top = max(counts.values())
+    return max(v for v, c in counts.items() if c == top)
+
+
+def detect_recurring(rows: list[Expense], min_occurrences: int = 3) -> list[Recurring]:
+    if min_occurrences < 2:
+        raise ValueError("min_occurrences は 2 以上である必要があります")
+
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.memo.strip()), []).append(e)
+
+    out: list[Recurring] = []
+    for (category, memo), items in groups.items():
+        if len(items) < min_occurrences:
+            continue
+        # Months as consecutive integers: any duplicate (diff 0) or gap (diff > 1)
+        # breaks the run.
+        month_idx = sorted(e.day.year * 12 + e.day.month for e in items)
+        if any(b - a != 1 for a, b in itertools.pairwise(month_idx)):
+            continue
+
+        mode = _mode_high([e.amount for e in items])
+        if any(abs(e.amount - mode) * 10 > abs(mode) for e in items):
+            continue
+
+        hint = _mode_high([e.day.day for e in items])
+        last = max(e.day for e in items)
+        out.append(
+            Recurring(
+                category=category,
+                memo=memo,
+                amount=mode,
+                count=len(items),
+                last_date=last,
+                next_date=predict_next(last, hint),
+            )
+        )
+
+    out.sort(key=lambda r: (-r.amount, r.category, r.memo))
+    return out
diff --git a/src/kakeibo/search.py b/src/kakeibo/search.py
new file mode 100644
index 0000000..65ca43f
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,67 @@
+"""Filter expense records with composable predicates."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from datetime import date
+
+from kakeibo.core import Expense
+
+Predicate = Callable[[Expense], bool]
+
+
+def category_is(*names: str) -> Predicate:
+    """Match if the category equals any of the given names (exact match)."""
+    if not names:
+        raise ValueError("カテゴリ名を 1 つ以上指定してください")
+    wanted = frozenset(names)
+    return lambda e: e.category in wanted
+
+
+def amount_between(low: int | None = None, high: int | None = None) -> Predicate:
+    """Match if low <= amount <= high. A None bound is open-ended."""
+    if low is not None and high is not None and low > high:
+        raise ValueError(f"下限 {low} が上限 {high} を超えています")
+    return lambda e: (
+        (low is None or e.amount >= low) and (high is None or e.amount <= high)
+    )
+
+
+def memo_contains(text: str, ignore_case: bool = True) -> Predicate:
+    """Match if the memo contains text. An empty text always matches."""
+    if text == "":
+        return lambda _e: True
+    needle = text.lower() if ignore_case else text
+
+    def pred(e: Expense) -> bool:
+        haystack = e.memo.lower() if ignore_case else e.memo
+        return needle in haystack
+
+    return pred
+
+
+def date_between(start: date | None = None, end: date | None = None) -> Predicate:
+    """Match if start <= day <= end. A None bound is open-ended."""
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"開始日 {start} が終了日 {end} より後です")
+    return lambda e: (start is None or e.day >= start) and (end is None or e.day <= end)
+
+
+def all_of(*preds: Predicate) -> Predicate:
+    """AND of the predicates. With no predicates, always True."""
+    return lambda e: all(p(e) for p in preds)
+
+
+def any_of(*preds: Predicate) -> Predicate:
+    """OR of the predicates. With no predicates, always False."""
+    return lambda e: any(p(e) for p in preds)
+
+
+def not_(pred: Predicate) -> Predicate:
+    """Negate a predicate."""
+    return lambda e: not pred(e)
+
+
+def search(rows: list[Expense], pred: Predicate) -> list[Expense]:
+    """Return the rows matching pred, in input order. The input list is not modified."""
+    return [r for r in rows if pred(r)]
