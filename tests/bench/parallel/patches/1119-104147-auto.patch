@@ -0,0 +1,147 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.compare import CategoryDiff, compare_months, format_report
+from kakeibo.core import Expense
+
+
+def e(d: str, cat: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(d), category=cat, amount=amount)
+
+
+def test_example_increase() -> None:
+    rows = [e("2024-02-10", "食費", 30000), e("2024-03-05", "食費", 35000)]
+    result = compare_months(rows, "2024-03")
+    assert len(result) == 1
+    d = result[0]
+    assert d.category == "食費"
+    assert (d.previous, d.current, d.diff, d.status) == (30000, 35000, 5000, "増")
+    assert d.ratio == pytest.approx(5000 / 30000)
+
+
+def test_january_uses_previous_december() -> None:
+    rows = [e("2023-12-01", "食費", 10000), e("2024-01-01", "食費", 8000)]
+    result = compare_months(rows, "2024-01")
+    assert [(d.previous, d.current, d.status) for d in result] == [(10000, 8000, "減")]
+
+
+def test_previous_month_missing_from_data_still_calendar_based() -> None:
+    rows = [e("2024-01-01", "食費", 500), e("2024-03-01", "食費", 700)]
+    result = compare_months(rows, "2024-03")
+    assert [(d.previous, d.current) for d in result] == [(0, 700)]
+
+
+def test_new_category_status_and_ratio_none() -> None:
+    rows = [e("2024-03-01", "娯楽", 1200)]
+    result = compare_months(rows, "2024-03")
+    d = result[0]
+    assert (d.previous, d.current, d.diff, d.ratio, d.status) == (
+        0,
+        1200,
+        1200,
+        None,
+        "新規",
+    )
+
+
+def test_vanished_category_status_and_ratio_minus_one() -> None:
+    rows = [e("2024-02-01", "交通", 4000)]
+    result = compare_months(rows, "2024-03")
+    d = result[0]
+    assert (d.previous, d.current, d.diff, d.status) == (4000, 0, -4000, "なし")
+    assert d.ratio == pytest.approx(-1.0)
+
+
+def test_unchanged_amount_is_no_change() -> None:
+    rows = [e("2024-02-01", "食費", 900), e("2024-03-01", "食費", 900)]
+    result = compare_months(rows, "2024-03")
+    assert [(d.diff, d.ratio, d.status) for d in result] == [(0, 0.0, "変化なし")]
+
+
+def test_decrease_status() -> None:
+    rows = [e("2024-02-01", "食費", 900), e("2024-03-01", "食費", 600)]
+    result = compare_months(rows, "2024-03")
+    assert result[0].status == "減"
+    assert result[0].diff == -300
+
+
+def test_zero_amount_new_category_is_no_change_not_new() -> None:
+    # 新規 requires current > 0
+    rows = [e("2024-03-01", "雑費", 0)]
+    result = compare_months(rows, "2024-03")
+    assert [(d.previous, d.current, d.status) for d in result] == [(0, 0, "変化なし")]
+
+
+def test_other_months_are_excluded() -> None:
+    rows = [
+        e("2024-01-15", "食費", 999),
+        e("2024-02-15", "食費", 100),
+        e("2024-03-15", "食費", 200),
+        e("2024-04-15", "食費", 777),
+    ]
+    result = compare_months(rows, "2024-03")
+    assert [(d.previous, d.current) for d in result] == [(100, 200)]
+
+
+def test_sorted_by_abs_diff_desc_then_category() -> None:
+    rows = [
+        e("2024-02-01", "A", 1000),
+        e("2024-03-01", "A", 1000),  # diff 0
+        e("2024-02-01", "B", 5000),
+        e("2024-03-01", "B", 2000),  # diff -3000
+        e("2024-02-01", "C", 1000),
+        e("2024-03-01", "C", 4000),  # diff +3000
+        e("2024-03-01", "D", 500),  # new, diff +500
+    ]
+    result = compare_months(rows, "2024-03")
+    assert [d.category for d in result] == ["B", "C", "D", "A"]
+
+
+def test_empty_rows_returns_empty_list() -> None:
+    assert compare_months([], "2024-03") == []
+
+
+@pytest.mark.parametrize(
+    "bad", ["2024-13", "2024-00", "2024/03", "2024-3", "24-03", ""]
+)
+def test_invalid_month_raises(bad: str) -> None:
+    with pytest.raises(ValueError):
+        compare_months([], bad)
+
+
+def test_format_increase_with_ratio() -> None:
+    d = CategoryDiff("食費", 30000, 35000, 5000, 5000 / 30000, "増")
+    assert format_report([d]) == "食費: 30,000円 → 35,000円 (+5,000円, +16.7%) 増"
+
+
+def test_format_decrease_uses_minus() -> None:
+    d = CategoryDiff("食費", 35000, 30000, -5000, -5000 / 35000, "減")
+    assert format_report([d]) == "食費: 35,000円 → 30,000円 (-5,000円, -14.3%) 減"
+
+
+def test_format_new_omits_ratio() -> None:
+    d = CategoryDiff("娯楽", 0, 5000, 5000, None, "新規")
+    assert format_report([d]) == "娯楽: 0円 → 5,000円 (+5,000円) 新規"
+
+
+def test_format_none_status() -> None:
+    d = CategoryDiff("交通", 4000, 0, -4000, -1.0, "なし")
+    assert format_report([d]) == "交通: 4,000円 → 0円 (-4,000円, -100.0%) なし"
+
+
+def test_format_empty_list() -> None:
+    assert format_report([]) == "データがありません"
+
+
+def test_format_lines_joined_without_trailing_newline() -> None:
+    a = CategoryDiff("食費", 30000, 35000, 5000, 5000 / 30000, "増")
+    b = CategoryDiff("娯楽", 0, 5000, 5000, None, "新規")
+    out = format_report([a, b])
+    assert out.split("\n") == [
+        "食費: 30,000円 → 35,000円 (+5,000円, +16.7%) 増",
+        "娯楽: 0円 → 5,000円 (+5,000円) 新規",
+    ]
+    assert not out.endswith("\n")
