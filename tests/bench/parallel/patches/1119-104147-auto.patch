+# search --------------------------------------------------------------------
+
+
+def test_search_keeps_input_order() -> None:
+    rows = [
+        e(category="食費", amount=300, memo="a"),
+        e(category="娯楽", amount=300, memo="b"),
+        e(category="食費", amount=100, memo="c"),
+    ]
+    result = search(rows, category_is("食費"))
+    assert [r.memo for r in result] == ["a", "c"]
+
+
+def test_search_does_not_modify_input_list() -> None:
+    rows = [e(category="食費"), e(category="娯楽")]
+    snapshot = list(rows)
+    result = search(rows, category_is("食費"))
+    assert rows == snapshot
+    assert result is not rows
+
+
+def test_search_returns_empty_list_when_nothing_matches() -> None:
+    rows = [e(category="食費")]
+    assert search(rows, category_is("娯楽")) == []
+
+
+def test_search_on_empty_input_returns_empty_list() -> None:
+    assert search([], category_is("食費")) == []
+
+
+def test_search_with_always_true_predicate_returns_all_rows_in_order() -> None:
+    rows = [e(memo="x"), e(memo="y")]
+    result = search(rows, all_of())
+    assert result == rows
+    assert result is not rows
+
+
+def test_search_with_always_false_predicate_returns_empty() -> None:
+    rows = [e(), e()]
+    assert search(rows, any_of()) == []
+
+
+def test_search_combined_example() -> None:
+    rows = [
+        e(category="食費", amount=800, memo="駅前カフェ"),
+        e(category="交通", amount=1500, memo="カフェ経由"),
+        e(category="食費", amount=900, memo="スーパー"),
+        e(category="交通", amount=300, memo="カフェ"),
+    ]
+    pred = all_of(
+        category_is("食費", "交通"),
+        amount_between(high=1000),
+        memo_contains("カフェ"),
+    )
+    result = search(rows, pred)
+    assert [(r.category, r.amount, r.memo) for r in result] == [
+        ("食費", 800, "駅前カフェ"),
+        ("交通", 300, "カフェ"),
+    ]
