+from __future__ import annotations
+
+from dataclasses import FrozenInstanceError
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def ex(
+    day: date, category: str = "家賃", amount: int = 80000, memo: str = ""
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+@pytest.mark.parametrize(
+    ("src", "expected"),
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2024, 1, 31), date(2024, 2, 29)),
+        (date(2026, 12, 15), date(2027, 1, 15)),
+        (date(2026, 12, 31), date(2027, 1, 31)),
+        (date(2024, 2, 29), date(2024, 3, 29)),
+        (date(2025, 2, 28), date(2025, 3, 28)),
+        (date(2026, 3, 31), date(2026, 4, 30)),
+        (date(2024, 12, 15), date(2025, 1, 15)),
+    ],
+)
+def test_add_month(src: date, expected: date) -> None:
+    assert add_month(src) == expected
+
+
+def test_recurring_is_frozen_with_field_order() -> None:
+    r = Recurring("家賃", 80000, (date(2026, 1, 1),), date(2026, 2, 1))
+    assert [f for f in r.__dataclass_fields__] == [
+        "category",
+        "amount",
+        "days",
+        "next_expected",
+    ]
+    with pytest.raises(FrozenInstanceError):
+        r.amount = 1  # type: ignore[misc]
+
+
+@pytest.mark.parametrize("min_count", [1, 0, -1])
+def test_min_count_below_two_raises(min_count: int) -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=min_count)
+
+
+def test_negative_tolerance_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_empty_input_returns_empty() -> None:
+    assert find_recurring([]) == []
+
+
+def test_basic_monthly_series() -> None:
+    rows = [ex(date(2026, 1, 5)), ex(date(2026, 2, 5)), ex(date(2026, 3, 5))]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="家賃",
+            amount=80000,
+            days=(date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+            next_expected=date(2026, 4, 5),
+        )
+    ]
+
+
+def test_min_count_boundary() -> None:
+    rows = [ex(date(2026, 1, 5)), ex(date(2026, 2, 5))]
+    assert find_recurring(rows, min_count=3) == []
+    got = find_recurring(rows, min_count=2)
+    assert len(got) == 1
+    assert got[0].days == (date(2026, 1, 5), date(2026, 2, 5))
+
+
+@pytest.mark.parametrize(
+    ("second", "tolerance", "linked"),
+    [
+        (date(2026, 2, 8), 3, True),  # exactly +3 from expected 02-05
+        (date(2026, 2, 8), 2, False),  # +3 exceeds tolerance 2
+        (date(2026, 2, 2), 3, True),  # exactly -3
+        (date(2026, 2, 1), 3, False),  # -4 exceeds tolerance 3
+        (date(2026, 2, 5), 0, True),  # tolerance 0 exact match
+        (date(2026, 2, 6), 0, False),
+    ],
+)
+def test_tolerance_boundary(second: date, tolerance: int, linked: bool) -> None:
+    # first link (01-05 -> second) varies; second -> third is exact
+    rows = [ex(date(2026, 1, 5)), ex(second), ex(add_month(second))]
+    got = find_recurring(rows, min_count=3, tolerance=tolerance)
+    assert (len(got) == 1) is linked
+
+
+def test_month_end_clamp_links() -> None:
+    # expected after 02-28 is 03-28; 03-31 is +3 -> linked with tolerance 3
+    rows = [ex(date(2026, 1, 31)), ex(date(2026, 2, 28)), ex(date(2026, 3, 31))]
+    got = find_recurring(rows)
+    assert len(got) == 1
+    assert got[0].next_expected == date(2026, 4, 30)
+
+
+def test_duplicate_dates_collapse() -> None:
+    rows = [ex(date(2026, 1, 5)), ex(date(2026, 1, 5)), ex(date(2026, 2, 5))]
+    assert find_recurring(rows) == []
+    rows.append(ex(date(2026, 3, 5)))
+    got = find_recurring(rows)
+    assert got[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_memo_is_ignored_for_grouping() -> None:
+    rows = [
+        ex(date(2026, 1, 5), memo="a"),
+        ex(date(2026, 2, 5), memo="b"),
+        ex(date(2026, 3, 5), memo=""),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_different_amount_is_separate_group() -> None:
+    rows = [
+        ex(date(2026, 1, 5), amount=1000),
+        ex(date(2026, 2, 5), amount=1000),
+        ex(date(2026, 3, 5), amount=2000),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_different_category_is_separate_group() -> None:
+    rows = [
+        ex(date(2026, 1, 5), category="A"),
+        ex(date(2026, 2, 5), category="B"),
+        ex(date(2026, 3, 5), category="A"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_unsorted_input_is_sorted() -> None:
+    rows = [ex(date(2026, 3, 5)), ex(date(2026, 1, 5)), ex(date(2026, 2, 5))]
+    got = find_recurring(rows)
+    assert got[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_break_splits_runs_and_keeps_only_long_ones() -> None:
+    # 01,02 | 05,06,07 : the break after 02-05 makes a short run (dropped) and a long run
+    rows = [
+        ex(date(2026, 1, 5)),
+        ex(date(2026, 2, 5)),
+        ex(date(2026, 5, 5)),
+        ex(date(2026, 6, 5)),
+        ex(date(2026, 7, 5)),
+    ]
+    got = find_recurring(rows)
+    assert got == [
+        Recurring(
+            category="家賃",
+            amount=80000,
+            days=(date(2026, 5, 5), date(2026, 6, 5), date(2026, 7, 5)),
+            next_expected=date(2026, 8, 5),
+        )
+    ]
+
+
+def test_two_long_runs_in_one_group() -> None:
+    rows = [
+        ex(date(2026, 1, 5)),
+        ex(date(2026, 2, 5)),
+        ex(date(2026, 3, 5)),
+        ex(date(2026, 6, 5)),
+        ex(date(2026, 7, 5)),
+        ex(date(2026, 8, 5)),
+    ]
+    got = find_recurring(rows)
+    assert [r.days[0] for r in got] == [date(2026, 1, 5), date(2026, 6, 5)]
+
+
+def test_result_ordering_category_amount_first_day() -> None:
+    rows: list[Expense] = []
+    for cat, amt in [("B", 100), ("A", 200), ("A", 100)]:
+        for m in (1, 2, 3):
+            rows.append(ex(date(2026, m, 5), category=cat, amount=amt))
+    got = [(r.category, r.amount) for r in find_recurring(rows)]
+    assert got == [("A", 100), ("A", 200), ("B", 100)]
