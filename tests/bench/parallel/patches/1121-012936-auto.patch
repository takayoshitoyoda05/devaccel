@@ -0,0 +1,107 @@
+"""Import bank-statement CSV rows as Expense records (pure functions)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+# 任意の "-"、任意の "¥"/"￥"、数字で始まる数字とカンマの列、任意の "円"
+_AMOUNT_RE = re.compile(r"(-?)[¥￥]?([0-9][0-9,]*)円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    value = int(m.group(2).replace(",", ""))
+    return -value if m.group(1) else value
+
+
+def parse_date(s: str) -> date:
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    try:
+        return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def _cell(row: list[str], index: int) -> str:
+    return row[index] if index < len(row) else ""
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Parse a CSV text (header on line 1) into expenses and per-row errors.
+
+    Returns (expenses in input order, [(physical line number, field name)]).
+    Rows with any error are excluded from the expenses.
+    """
+    cols = DEFAULT_MAPPING if mapping is None else mapping
+    for key in ("date", "category", "amount"):
+        if key not in cols:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header: list[str] = next(reader, [])
+    index: dict[str, int] = {}
+    for field, name in cols.items():
+        if field not in ("date", "category", "amount", "memo"):
+            continue
+        if name not in header:
+            raise ValueError(f"列 {name!r} がヘッダーにありません")
+        index[field] = header.index(name)
+
+    cmap = category_map or {}
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    while True:
+        start = reader.line_num + 1  # physical line where this record begins
+        row = next(reader, None)
+        if row is None:
+            break
+        if row == [] or (len(row) == 1 and not row[0].strip()):
+            continue  # blank line: skipped, but still counted above
+
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(_cell(row, index["date"]))
+        except ValueError:
+            errors.append((start, "date"))
+        try:
+            amount = parse_amount(_cell(row, index["amount"]))
+        except ValueError:
+            errors.append((start, "amount"))
+        category = _cell(row, index["category"]).strip()
+        if not category:
+            errors.append((start, "category"))
+        if day is None or amount is None or not category:
+            continue
+
+        memo = _cell(row, index["memo"]).strip() if "memo" in index else ""
+        expenses.append(
+            Expense(
+                day=day,
+                category=cmap.get(category, category),
+                amount=amount,
+                memo=memo,
+            )
+        )
+    return expenses, errors
