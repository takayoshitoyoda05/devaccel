+import pytest
+
+from kakeibo.split import split_evenly
+
+
+def test_exact_division_gives_equal_shares() -> None:
+    assert split_evenly(900, 3) == [300, 300, 300]
+
+
+def test_remainder_goes_to_first_people_one_yen_each() -> None:
+    assert split_evenly(10, 3) == [4, 3, 3]
+    assert split_evenly(11, 3) == [4, 4, 3]
+
+
+def test_single_person_gets_everything() -> None:
+    assert split_evenly(1234, 1) == [1234]
+
+
+def test_zero_amount_gives_all_zeros() -> None:
+    assert split_evenly(0, 4) == [0, 0, 0, 0]
+
+
+def test_amount_smaller_than_people_gives_ones_then_zeros() -> None:
+    assert split_evenly(2, 5) == [1, 1, 0, 0, 0]
+
+
+def test_result_length_equals_people_and_sums_to_amount() -> None:
+    parts = split_evenly(12345, 7)
+    assert len(parts) == 7
+    assert sum(parts) == 12345
+    assert max(parts) - min(parts) <= 1
+
+
+@pytest.mark.parametrize("people", [0, -1])
+def test_people_less_than_one_raises(people: int) -> None:
+    with pytest.raises(ValueError):
+        split_evenly(100, people)
