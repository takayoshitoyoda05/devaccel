new file mode 100644
index 0000000..e01703c
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,122 @@
+"""Import expenses from bank CSV exports with arbitrary column names."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"-?[¥￥]?[0-9][0-9,]*円?")
+_DATE_RE = re.compile(r"[0-9]{4}/[0-9]{1,2}/[0-9]{1,2}|[0-9]{4}-[0-9]{1,2}-[0-9]{1,2}")
+
+
+def parse_amount(s: str) -> int:
+    """Parse an amount like ``-¥1,234円`` into an int of yen.
+
+    Raises ValueError when the string does not match the accepted shape.
+    """
+    text = s.strip()
+    if not _AMOUNT_RE.fullmatch(text):
+        raise ValueError(f"金額が不正です: {s!r}")
+    digits = text.replace("¥", "").replace("￥", "").replace("円", "")
+    return int(digits.replace(",", ""))
+
+
+def parse_date(s: str) -> date:
+    """Parse ``YYYY/M/D`` or ``YYYY-M-D`` (separators must not be mixed)."""
+    text = s.strip()
+    if not _DATE_RE.fullmatch(text):
+        raise ValueError(f"日付が不正です: {s!r}")
+    parts = re.split(r"[/-]", text)
+    try:
+        return date(int(parts[0]), int(parts[1]), int(parts[2]))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def _cell(row: list[str], idx: int | None) -> str:
+    if idx is None or idx >= len(row):
+        return ""
+    return row[idx]
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Read a CSV whose first line is a header and return (expenses, errors).
+
+    errors are ``(physical_line_number, field)`` with the header on line 1.
+    Rows containing any error are left out of the expenses.
+    """
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    try:
+        header = next(reader)
+    except StopIteration:
+        raise ValueError("ヘッダー行がありません") from None
+
+    index: dict[str, int | None] = {}
+    for field, column in mapping.items():
+        if column not in header:
+            raise ValueError(f"列 {column} がヘッダーにありません")
+        index[field] = header.index(column)
+    index.setdefault("memo", None)
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    line = reader.line_num  # header is the last line consumed so far
+    for row in reader:
+        start = line + 1
+        line = reader.line_num
+        if not row:
+            continue
+        day_text = _cell(row, index["date"])
+        amount_text = _cell(row, index["amount"])
+        category_text = _cell(row, index["category"]).strip()
+
+        row_errors: list[tuple[int, str]] = []
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(day_text)
+        except ValueError:
+            row_errors.append((start, "date"))
+        try:
+            amount = parse_amount(amount_text)
+        except ValueError:
+            row_errors.append((start, "amount"))
+        if not category_text:
+            row_errors.append((start, "category"))
+
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        assert day is not None and amount is not None
+        if category_map and category_text in category_map:
+            category_text = category_map[category_text]
+        expenses.append(
+            Expense(
+                day=day,
+                category=category_text,
+                amount=amount,
+                memo=_cell(row, index["memo"]).strip(),
+            )
+        )
+    return expenses, errors
