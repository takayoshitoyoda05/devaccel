@@ -0,0 +1,62 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.dupes import find_duplicates
+
+D = date(2026, 1, 5)
+
+
+def _e(day=D, category="food", amount=100, memo="") -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+def test_empty_list_has_no_duplicates() -> None:
+    assert find_duplicates([]) == []
+
+
+def test_single_row_has_no_duplicates() -> None:
+    assert find_duplicates([_e()]) == []
+
+
+def test_no_duplicates_returns_empty() -> None:
+    rows = [_e(amount=100), _e(amount=200), _e(category="rent", amount=100)]
+    assert find_duplicates(rows) == []
+
+
+def test_identical_pair_is_reported_once() -> None:
+    assert find_duplicates([_e(), _e()]) == [(0, 1)]
+
+
+def test_triple_reports_all_pairs_in_order() -> None:
+    rows = [_e(), _e(amount=5), _e(), _e()]
+    assert find_duplicates(rows) == [(0, 2), (0, 3), (2, 3)]
+
+
+def test_non_adjacent_duplicates_use_input_indices() -> None:
+    rows = [_e(amount=1), _e(amount=2), _e(amount=3), _e(amount=2)]
+    assert find_duplicates(rows) == [(1, 3)]
+
+
+def test_result_sorted_by_i_then_j() -> None:
+    rows = [_e(amount=1), _e(amount=2), _e(amount=1), _e(amount=2), _e(amount=1)]
+    assert find_duplicates(rows) == [(0, 2), (0, 4), (1, 3), (2, 4)]
+
+
+def test_different_day_is_not_duplicate() -> None:
+    assert find_duplicates([_e(), _e(day=date(2026, 1, 6))]) == []
+
+
+def test_different_category_is_not_duplicate() -> None:
+    assert find_duplicates([_e(), _e(category="transport")]) == []
+
+
+def test_different_amount_is_not_duplicate() -> None:
+    assert find_duplicates([_e(), _e(amount=101)]) == []
+
+
+def test_different_memo_is_not_duplicate() -> None:
+    assert find_duplicates([_e(memo="a"), _e(memo="b")]) == []
+
+
+def test_memo_empty_vs_filled_is_not_duplicate() -> None:
+    assert find_duplicates([_e(memo=""), _e(memo="lunch")]) == []
