+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.streak import longest_no_spend_streak
+
+
+def _e(day: date, amount: int = 100) -> Expense:
+    return Expense(day=day, category="食費", amount=amount)
+
+
+def test_no_rows_counts_whole_period_inclusive() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 1), date(2026, 1, 7)) == 7
+
+
+def test_single_day_period_without_rows_is_one() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 1), date(2026, 1, 1)) == 1
+
+
+def test_single_day_period_with_row_is_zero() -> None:
+    rows = [_e(date(2026, 1, 1))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 1)) == 0
+
+
+def test_spend_day_splits_streak_and_longest_is_kept() -> None:
+    # Days 1..7, spend on day 3 -> runs of 2 (1-2) and 4 (4-7).
+    rows = [_e(date(2026, 1, 3))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 7)) == 4
+
+
+def test_longest_run_in_the_middle() -> None:
+    # Spend on 1, 5 and 6 -> runs: 2-4 (3 days), 7 (1 day).
+    rows = [_e(date(2026, 1, 1)), _e(date(2026, 1, 5)), _e(date(2026, 1, 6))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 7)) == 3
+
+
+def test_spend_on_start_and_end_are_excluded_from_streak() -> None:
+    rows = [_e(date(2026, 1, 1)), _e(date(2026, 1, 7))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 7)) == 5
+
+
+def test_rows_outside_period_are_ignored() -> None:
+    rows = [_e(date(2025, 12, 31)), _e(date(2026, 1, 8))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 7)) == 7
+
+
+def test_multiple_rows_on_same_day_count_as_one_spend_day() -> None:
+    rows = [_e(date(2026, 1, 2)), _e(date(2026, 1, 2), amount=500)]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 3)) == 1
+
+
+def test_zero_amount_record_still_counts_as_a_record() -> None:
+    rows = [_e(date(2026, 1, 2), amount=0)]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 3)) == 1
+
+
+def test_start_after_end_returns_zero() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 7), date(2026, 1, 1)) == 0
+
+
+def test_streak_crosses_month_boundary() -> None:
+    rows = [_e(date(2026, 1, 30))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 28), date(2026, 2, 3)) == 4
diff --git a/tests/test_topn.py b/tests/test_topn.py
