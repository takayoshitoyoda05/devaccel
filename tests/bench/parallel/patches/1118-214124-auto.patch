+"""Yen formatting helpers."""
+
+from __future__ import annotations
+
+
+def yen(n: int) -> str:
+    """Format an integer yen amount with thousands separators and a 円 suffix.
+
+    >>> yen(1234567)
+    '1,234,567円'
+    >>> yen(-1200)
+    '-1,200円'
+    """
+    return f"{n:,}円"
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
new file mode 100644
index 0000000..98cc6f2
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,89 @@
+"""Month-over-month comparison of expenses by category."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+
+    prev_totals: dict[str, int] = {}
+    curr_totals: dict[str, int] = {}
+    prev_seen: set[str] = set()
+    curr_seen: set[str] = set()
+    for e in rows:
+        m = e.day.strftime("%Y-%m")
+        if m == prev_month:
+            prev_totals[e.category] = prev_totals.get(e.category, 0) + e.amount
+            prev_seen.add(e.category)
+        if m == curr_month:
+            curr_totals[e.category] = curr_totals.get(e.category, 0) + e.amount
+            curr_seen.add(e.category)
+
+    out: list[DiffRow] = []
+    for cat in prev_seen | curr_seen:
+        prev = prev_totals.get(cat, 0)
+        curr = curr_totals.get(cat, 0)
+        delta = curr - prev
+        pct = None if prev == 0 else round(delta / prev * 100, 1)
+        if cat not in prev_seen:
+            status = "new"
+        elif cat not in curr_seen:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+
+    out.sort(key=lambda r: (-abs(r.delta), r.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [r for r in diffs if r.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for r in diffs:
+        pct = "-" if r.pct is None else f"{r.pct:+.1f}%"
+        lines.append(f"{r.category}\t{r.prev}\t{r.curr}\t{r.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({e.day.strftime("%Y-%m") for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には月が 2 つ以上必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..9e94b91
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,160 @@
+"""Search query language for Expense rows.
+
+Grammar (lowest precedence first)::
+
+    or_expr  := and_expr ("OR" and_expr)*
+    and_expr := not_expr (["AND"] not_expr)*
+    not_expr := "NOT" not_expr | primary
+    primary  := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+from kakeibo.core import Expense
+
+
+class QueryError(ValueError):
+    """Raised when a search query is invalid."""
+
+
+Token = tuple[str, str]
+
+# AST nodes: ("term", v) | ("cat", v) | ("not", node) | ("and", l, r) | ("or", l, r)
+Node = tuple[Any, ...]
+
+_OPERATORS = {"AND", "OR", "NOT"}
+_SPECIAL = ' \t\r\n\f\v()"'
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    tokens: list[tuple[str, str]] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError("閉じていない引用符があります")
+            content = q[i + 1 : end]
+            if content == "":
+                raise QueryError("空の引用符は使えません")
+            tokens.append(("TERM", content))
+            i = end + 1
+        else:
+            j = i
+            while j < n and q[j] not in _SPECIAL and not q[j].isspace():
+                j += 1
+            word = q[i:j]
+            i = j
+            if word in _OPERATORS:
+                tokens.append((word, word))
+            elif word.startswith("cat:"):
+                value = word[len("cat:") :]
+                if value == "":
+                    raise QueryError("cat: の後ろに値がありません")
+                tokens.append(("CAT", value))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self.tokens = tokens
+        self.pos = 0
+
+    def _peek(self) -> str | None:
+        return self.tokens[self.pos][0] if self.pos < len(self.tokens) else None
+
+    def _next(self) -> Token:
+        tok = self.tokens[self.pos]
+        self.pos += 1
+        return tok
+
+    def parse(self) -> Node:
+        if not self.tokens:
+            raise QueryError("検索条件が空です")
+        node = self._or()
+        if self.pos != len(self.tokens):
+            raise QueryError("構文が不正です")
+        return node
+
+    def _or(self) -> Node:
+        node = self._and()
+        while self._peek() == "OR":
+            self._next()
+            node = ("or", node, self._and())
+        return node
+
+    _NOT_START = ("TERM", "CAT", "NOT", "LPAREN")
+
+    def _and(self) -> Node:
+        node = self._not()
+        while True:
+            kind = self._peek()
+            if kind == "AND":
+                self._next()
+                if self._peek() not in self._NOT_START:
+                    raise QueryError("AND の後ろに項がありません")
+            elif kind not in self._NOT_START:
+                return node
+            node = ("and", node, self._not())
+
+    def _not(self) -> Node:
+        if self._peek() == "NOT":
+            self._next()
+            return ("not", self._not())
+        return self._primary()
+
+    def _primary(self) -> Node:
+        kind = self._peek()
+        if kind == "TERM":
+            return ("term", self._next()[1])
+        if kind == "CAT":
+            return ("cat", self._next()[1])
+        if kind == "LPAREN":
+            self._next()
+            node = self._or()
+            if self._peek() != "RPAREN":
+                raise QueryError("括弧が閉じられていません")
+            self._next()
+            return node
+        raise QueryError("項がありません")
+
+
+def _parse(q: str) -> Node:
+    return _Parser(tokenize(q)).parse()
+
+
+def _eval(node: Node, e: Expense) -> bool:
+    op = node[0]
+    if op == "term":
+        needle = node[1].casefold()
+        return needle in e.memo.casefold() or needle in e.category.casefold()
+    if op == "cat":
+        return node[1].casefold() == e.category.casefold()
+    if op == "not":
+        return not _eval(node[1], e)
+    if op == "and":
+        return _eval(node[1], e) and _eval(node[2], e)
+    return _eval(node[1], e) or _eval(node[2], e)
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _eval(_parse(q), e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    node = _parse(q)
+    return [e for e in rows if _eval(node, e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..3a4bd2f
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,60 @@
+"""Detect recurring expenses (same category and amount, roughly monthly)."""
+
+from __future__ import annotations
+
+import calendar
+from collections import defaultdict
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day in the next month, clamped to that month's last day."""
+    year, month = (d.year + 1, 1) if d.month == 12 else (d.year, d.month + 1)
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError("min_count は 2 以上である必要があります")
+    if tolerance < 0:
+        raise ValueError("tolerance は 0 以上である必要があります")
+
+    groups: dict[tuple[str, int], set[date]] = defaultdict(set)
+    for e in rows:
+        groups[(e.category, e.amount)].add(e.day)
+
+    out: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        runs: list[list[date]] = []
+        for d in sorted(day_set):
+            if runs and abs((d - add_month(runs[-1][-1])).days) <= tolerance:
+                runs[-1].append(d)
+            else:
+                runs.append([d])
+        for run in runs:
+            if len(run) >= min_count:
+                out.append(
+                    Recurring(
+                        category=category,
+                        amount=amount,
+                        days=tuple(run),
+                        next_expected=add_month(run[-1]),
+                    )
+                )
+
+    out.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return out
