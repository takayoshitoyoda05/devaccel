@@ -0,0 +1,74 @@
+"""Tests for kakeibo.export.to_json."""
+
+from __future__ import annotations
+
+import json
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.export import to_json
+
+
+def test_empty_list_gives_empty_json_array() -> None:
+    assert to_json([]) == "[]"
+
+
+def test_single_row_has_fields_in_order() -> None:
+    rows = [Expense(date(2026, 3, 5), "食費", 1200, "昼")]
+    assert to_json(rows) == (
+        '[{"date": "2026-03-05", "category": "食費", "amount": 1200, "memo": "昼"}]'
+    )
+
+
+def test_keys_are_ordered_date_category_amount_memo() -> None:
+    rows = [Expense(date(2026, 1, 2), "交通費", 300, "電車")]
+    parsed = json.loads(to_json(rows))
+    assert list(parsed[0].keys()) == ["date", "category", "amount", "memo"]
+
+
+def test_input_order_is_preserved() -> None:
+    rows = [
+        Expense(date(2026, 2, 1), "B", 2, ""),
+        Expense(date(2026, 1, 1), "A", 1, ""),
+        Expense(date(2026, 3, 1), "C", 3, ""),
+    ]
+    parsed = json.loads(to_json(rows))
+    assert [r["category"] for r in parsed] == ["B", "A", "C"]
+
+
+def test_date_is_zero_padded_iso() -> None:
+    rows = [Expense(date(2026, 1, 9), "食費", 1, "")]
+    assert json.loads(to_json(rows))[0]["date"] == "2026-01-09"
+
+
+def test_amount_is_integer_not_string() -> None:
+    rows = [Expense(date(2026, 1, 1), "食費", 980, "")]
+    amount = json.loads(to_json(rows))[0]["amount"]
+    assert amount == 980
+    assert isinstance(amount, int)
+
+
+def test_empty_memo_is_kept_as_empty_string() -> None:
+    rows = [Expense(date(2026, 1, 1), "食費", 100, "")]
+    assert json.loads(to_json(rows))[0]["memo"] == ""
+
+
+def test_non_ascii_is_not_escaped() -> None:
+    rows = [Expense(date(2026, 1, 1), "日用品", 500, "洗剤・石けん")]
+    text = to_json(rows)
+    assert "日用品" in text
+    assert "洗剤・石けん" in text
+    assert "\\u" not in text
+
+
+def test_output_has_no_indentation() -> None:
+    rows = [
+        Expense(date(2026, 1, 1), "食費", 100, "a"),
+        Expense(date(2026, 1, 2), "食費", 200, "b"),
+    ]
+    assert "\n" not in to_json(rows)
+
+
+def test_special_characters_in_memo_are_escaped_validly() -> None:
+    rows = [Expense(date(2026, 1, 1), "食費", 100, 'say "hi"\\n')]
+    assert json.loads(to_json(rows))[0]["memo"] == 'say "hi"\\n'
