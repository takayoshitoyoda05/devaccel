+"""Top-N expenses by amount."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def top_expenses(rows: list[Expense], n: int) -> list[Expense]:
+    """Return up to n expenses, largest amount first.
+
+    Ties are broken by earlier date, then by input order. n <= 0 returns [].
+    The input list is not modified.
+    """
+    if n <= 0:
+        return []
+    ordered = sorted(rows, key=lambda e: (-e.amount, e.day))  # sorted() is stable
+    return ordered[:n]
