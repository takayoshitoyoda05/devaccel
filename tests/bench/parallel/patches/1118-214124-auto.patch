+++ b/tests/test_topn.py
@@ -0,0 +1,60 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.topn import top_expenses
+
+
+def _e(day: str, amount: int, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category="食費", amount=amount, memo=memo
+    )
+
+
+def test_sorted_by_amount_desc() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300), _e("2026-01-03", 200)]
+    assert [e.amount for e in top_expenses(rows, 3)] == [300, 200, 100]
+
+
+def test_takes_only_n() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300), _e("2026-01-03", 200)]
+    assert [e.amount for e in top_expenses(rows, 2)] == [300, 200]
+
+
+def test_n_larger_than_rows_returns_all() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300)]
+    assert [e.amount for e in top_expenses(rows, 10)] == [300, 100]
+
+
+def test_n_zero_returns_empty() -> None:
+    rows = [_e("2026-01-01", 100)]
+    assert top_expenses(rows, 0) == []
+
+
+def test_negative_n_returns_empty() -> None:
+    rows = [_e("2026-01-01", 100)]
+    assert top_expenses(rows, -1) == []
+
+
+def test_empty_input_returns_empty() -> None:
+    assert top_expenses([], 3) == []
+
+
+def test_ties_broken_by_earlier_date() -> None:
+    late = _e("2026-03-01", 500, "late")
+    early = _e("2026-01-01", 500, "early")
+    result = top_expenses([late, early], 2)
+    assert [e.memo for e in result] == ["early", "late"]
+
+
+def test_full_ties_keep_input_order() -> None:
+    a = _e("2026-01-01", 500, "a")
+    b = _e("2026-01-01", 500, "b")
+    c = _e("2026-01-01", 500, "c")
+    assert top_expenses([b, a, c], 3) == [b, a, c]
+
+
+def test_does_not_mutate_input() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300)]
+    snapshot = list(rows)
+    top_expenses(rows, 1)
+    assert rows == snapshot
diff --git a/tests/test_weekday.py b/tests/test_weekday.py
new file mode 100644
index 0000000..a123ec9
--- /dev/null
+++ b/tests/test_weekday.py
@@ -0,0 +1,72 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.weekday import total_by_weekday
+
+# 2026-11-16 は月曜日
+MON = date(2026, 11, 16)
+TUE = date(2026, 11, 17)
+WED = date(2026, 11, 18)
+THU = date(2026, 11, 19)
+FRI = date(2026, 11, 20)
+SAT = date(2026, 11, 21)
+SUN = date(2026, 11, 22)
+
+
+def _e(day: date, amount: int, category: str = "food") -> Expense:
+    return Expense(day=day, category=category, amount=amount)
+
+
+def test_empty_rows_returns_empty_dict() -> None:
+    assert total_by_weekday([]) == {}
+
+
+def test_single_expense_maps_to_its_weekday() -> None:
+    assert total_by_weekday([_e(WED, 500)]) == {"Wed": 500}
+
+
+def test_each_weekday_name_is_three_letter_english() -> None:
+    rows = [_e(d, 1) for d in (MON, TUE, WED, THU, FRI, SAT, SUN)]
+    assert total_by_weekday(rows) == {
+        "Mon": 1,
+        "Tue": 1,
+        "Wed": 1,
+        "Thu": 1,
+        "Fri": 1,
+        "Sat": 1,
+        "Sun": 1,
+    }
+
+
+def test_keys_are_in_monday_first_order_regardless_of_input_order() -> None:
+    rows = [_e(SUN, 7), _e(FRI, 5), _e(TUE, 2), _e(MON, 1)]
+    result = total_by_weekday(rows)
+    assert list(result) == ["Mon", "Tue", "Fri", "Sun"]
+    assert result == {"Mon": 1, "Tue": 2, "Fri": 5, "Sun": 7}
+
+
+def test_weekdays_without_expenses_are_omitted() -> None:
+    result = total_by_weekday([_e(MON, 100), _e(SAT, 200)])
+    assert result == {"Mon": 100, "Sat": 200}
+    assert "Tue" not in result
+    assert "Sun" not in result
+
+
+def test_same_weekday_in_different_weeks_is_summed() -> None:
+    next_monday = date(2026, 11, 23)
+    result = total_by_weekday([_e(MON, 300), _e(next_monday, 450)])
+    assert result == {"Mon": 750}
+
+
+def test_multiple_expenses_on_same_day_are_summed() -> None:
+    rows = [_e(THU, 100), _e(THU, 250, "transport"), _e(THU, 50, "food")]
+    assert total_by_weekday(rows) == {"Thu": 400}
+
+
+def test_categories_are_ignored_when_grouping_by_weekday() -> None:
+    rows = [_e(FRI, 1000, "food"), _e(FRI, 2000, "rent")]
+    assert total_by_weekday(rows) == {"Fri": 3000}
+
+
+def test_zero_amount_is_still_a_weekday_entry() -> None:
+    assert total_by_weekday([_e(SUN, 0)]) == {"Sun": 0}
