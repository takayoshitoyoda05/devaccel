+"""Split an amount of yen evenly among people."""
+
+from __future__ import annotations
+
+
+def split_evenly(amount: int, people: int) -> list[int]:
+    """Split ``amount`` yen among ``people``.
+
+    The remainder is distributed one yen at a time starting from the first
+    person, so the parts always sum to ``amount``.
+    Raises ``ValueError`` if ``people`` is less than 1.
+    """
+    if people < 1:
+        raise ValueError(f"人数は 1 以上である必要があります: {people}")
+    base, remainder = divmod(amount, people)
+    return [base + 1 if i < remainder else base for i in range(people)]
