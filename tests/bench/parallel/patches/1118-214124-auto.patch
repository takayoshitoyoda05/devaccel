new file mode 100644
index 0000000..823dfdb
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,152 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def E(y, m, d, cat, amt):
+    return Expense(date(y, m, d), cat, amt)
+
+
+ROWS = [
+    E(2026, 10, 1, "food", 1000),
+    E(2026, 10, 2, "food", 500),
+    E(2026, 10, 3, "rent", 80000),
+    E(2026, 10, 4, "fun", 300),
+    E(2026, 11, 1, "food", 1200),
+    E(2026, 11, 2, "rent", 80000),
+    E(2026, 11, 3, "misc", 700),
+    E(2026, 11, 4, "fun", 0),  # 合計 0 でも明細はあるので gone ではない
+]
+
+
+def test_month_diff_rows_statuses_and_order():
+    assert month_diff(ROWS, "2026-10", "2026-11") == [
+        DiffRow("misc", 0, 700, 700, None, "new"),
+        DiffRow("food", 1500, 1200, -300, -20.0, "down"),
+        DiffRow("fun", 300, 0, -300, -100.0, "down"),
+        DiffRow("rent", 80000, 80000, 0, 0.0, "same"),
+    ]
+
+
+def test_month_diff_gone_when_no_curr_rows():
+    rows = [E(2026, 10, 1, "old", 400)]
+    assert month_diff(rows, "2026-10", "2026-11") == [
+        DiffRow("old", 400, 0, -400, -100.0, "gone"),
+    ]
+
+
+def test_month_diff_up_with_prev_zero_sum_has_no_pct():
+    rows = [E(2026, 10, 1, "x", 0), E(2026, 11, 1, "x", 500)]
+    assert month_diff(rows, "2026-10", "2026-11") == [
+        DiffRow("x", 0, 500, 500, None, "up"),
+    ]
+
+
+def test_month_diff_zero_prev_zero_curr_is_same_not_new():
+    rows = [E(2026, 10, 1, "x", 0), E(2026, 11, 1, "x", 0)]
+    assert month_diff(rows, "2026-10", "2026-11") == [
+        DiffRow("x", 0, 0, 0, None, "same"),
+    ]
+
+
+def test_month_diff_pct_rounded_to_one_decimal():
+    rows = [E(2026, 10, 1, "a", 3), E(2026, 11, 1, "a", 4)]
+    (row,) = month_diff(rows, "2026-10", "2026-11")
+    assert row.pct == round(1 / 3 * 100, 1) == 33.3
+
+
+def test_month_diff_same_month_twice():
+    rows = [E(2026, 10, 1, "a", 3)]
+    assert month_diff(rows, "2026-10", "2026-10") == [
+        DiffRow("a", 3, 3, 0, 0.0, "same"),
+    ]
+
+
+def test_month_diff_ignores_other_months_and_empty_input():
+    assert month_diff([], "2026-10", "2026-11") == []
+    rows = [E(2025, 10, 1, "a", 9)]
+    assert month_diff(rows, "2026-10", "2026-11") == []
+
+
+@pytest.mark.parametrize(
+    "prev, curr",
+    [
+        ("2026-1", "2026-11"),
+        ("2026-11", "2026-00"),
+        ("2026-13", "2026-11"),
+        ("2026/10", "2026-11"),
+        ("202610", "2026-11"),
+        ("2026-11\n", "2026-12"),
+        ("2026-10", "2026-1"),
+        ("2026-10", ""),
+    ],
+)
+def test_month_diff_rejects_bad_month(prev, curr):
+    with pytest.raises(ValueError):
+        month_diff(ROWS, prev, curr)
+
+
+def test_top_movers_excludes_same_keeps_order_and_limits():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    assert [r.category for r in top_movers(diffs)] == ["misc", "food", "fun"]
+    assert [r.category for r in top_movers(diffs, 1)] == ["misc"]
+    assert [r.category for r in top_movers(diffs, 10)] == ["misc", "food", "fun"]
+    assert top_movers(diffs, 0) == []
+    assert top_movers([], 3) == []
+
+
+def test_top_movers_negative_n_raises():
+    with pytest.raises(ValueError):
+        top_movers(month_diff(ROWS, "2026-10", "2026-11"), -1)
+
+
+def test_render_diff_format():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "misc\t0\t700\t+700\t-\n"
+        "food\t1500\t1200\t-300\t-20.0%\n"
+        "fun\t300\t0\t-300\t-100.0%\n"
+        "rent\t80000\t80000\t+0\t+0.0%"
+    )
+
+
+def test_render_diff_positive_pct_and_empty():
+    rows = [DiffRow("a", 100, 120, 20, 20.0, "up")]
+    assert render_diff(rows) == (
+        "category\tprev\tcurr\tdelta\tpct\na\t100\t120\t+20\t+20.0%"
+    )
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_available_months_sorted_unique():
+    rows = [
+        E(2026, 11, 1, "a", 1),
+        E(2026, 9, 30, "a", 1),
+        E(2026, 11, 2, "b", 1),
+        E(2025, 12, 31, "a", 1),
+    ]
+    assert available_months(rows) == ["2025-12", "2026-09", "2026-11"]
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months():
+    rows = ROWS + [E(2026, 12, 1, "food", 100)]
+    assert latest_diff(rows) == month_diff(rows, "2026-11", "2026-12")
+
+
+def test_latest_diff_needs_two_months():
+    with pytest.raises(ValueError):
+        latest_diff([])
+    with pytest.raises(ValueError):
+        latest_diff([E(2026, 10, 1, "a", 1), E(2026, 10, 2, "a", 1)])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..ea1ff2d
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,274 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+E1 = Expense(date(2026, 11, 1), "food", 1200, "lunch")
+E2 = Expense(date(2026, 11, 2), "rent", 80000, "")
+E3 = Expense(date(2026, 11, 3), "Food", 800, "coffee")
+E4 = Expense(date(2026, 11, 4), "transport", 300, "lunch bus")
+ROWS = [E1, E2, E3, E4]
+
+
+# --- tokenize ---
+
+
+def test_tokenize_whitespace_only_is_empty():
+    assert tokenize("   \t ") == []
+
+
+def test_tokenize_empty_string_is_empty():
+    assert tokenize("") == []
+
+
+def test_tokenize_parens():
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+
+
+def test_tokenize_quoted_keeps_spaces_and_parens():
+    assert tokenize('"a (b) c"') == [("TERM", "a (b) c")]
+
+
+def test_tokenize_quoted_whitespace_only_is_term():
+    assert tokenize('" "') == [("TERM", " ")]
+
+
+def test_tokenize_empty_quote_is_error():
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_unclosed_quote_is_error():
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_quoted_operator_is_term():
+    assert tokenize('"AND"') == [("TERM", "AND")]
+
+
+def test_tokenize_quoted_cat_prefix_is_term():
+    assert tokenize('"cat:food"') == [("TERM", "cat:food")]
+
+
+def test_tokenize_uppercase_operators():
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+
+
+def test_tokenize_lowercase_operators_are_terms():
+    assert tokenize("and or not") == [
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_operator_must_be_whole_word():
+    assert tokenize("ANDx") == [("TERM", "ANDx")]
+
+
+def test_tokenize_cat_prefix():
+    assert tokenize("cat:food") == [("CAT", "food")]
+
+
+def test_tokenize_cat_empty_is_error():
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_tokenize_cat_prefix_is_case_sensitive():
+    assert tokenize("CAT:food") == [("TERM", "CAT:food")]
+
+
+def test_tokenize_word_stops_at_quote():
+    assert tokenize('ab"cd"') == [("TERM", "ab"), ("TERM", "cd")]
+
+
+def test_tokenize_word_stops_at_paren():
+    assert tokenize("ab(cd)") == [
+        ("TERM", "ab"),
+        ("LPAREN", "("),
+        ("TERM", "cd"),
+        ("RPAREN", ")"),
+    ]
+
+
+# --- parse errors (via filter_rows / matches) ---
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(a",
+        "a)",
+        ")a(",
+        "AND",
+        "OR a",
+        "a OR",
+        "a AND",
+        "AND a",
+        "NOT",
+        "a OR OR b",
+        "(a OR)",
+        "cat:",
+        '"abc',
+        '""',
+    ],
+)
+def test_invalid_query_raises(q):
+    with pytest.raises(QueryError):
+        filter_rows(q, ROWS)
+
+
+def test_invalid_query_raises_even_with_no_rows():
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
+
+
+def test_invalid_query_raises_in_matches():
+    with pytest.raises(QueryError):
+        matches("a OR", E1)
+
+
+# --- evaluation ---
+
+
+def test_term_matches_memo_substring():
+    assert matches("lunch", E1)
+    assert not matches("lunch", E2)
+
+
+def test_term_matches_category_substring():
+    assert matches("ood", E1)
+
+
+def test_term_is_case_insensitive():
+    assert matches("COFFEE", E3)
+    assert matches("food", E3)
+
+
+def test_term_casefold_handles_sharp_s():
+    # 'ß'.casefold() == 'ss', so both sides compare as 'strasse'
+    e = Expense(date(2026, 11, 5), "Straße", 1, "")
+    assert matches("STRASSE", e)
+    assert matches("straße", e)
+
+
+def test_term_whitespace_inside_quotes():
+    assert matches('"lunch bus"', E4)
+    assert not matches('"lunch bus"', E1)
+
+
+def test_term_space_matches_memo_with_space():
+    assert matches('" "', E4)
+    assert not matches('" "', E1)
+
+
+def test_cat_exact_match():
+    assert matches("cat:food", E1)
+    assert matches("cat:FOOD", E1)
+
+
+def test_cat_is_not_substring():
+    assert not matches("cat:foo", E1)
+
+
+def test_cat_does_not_match_memo():
+    assert not matches("cat:lunch", E1)
+
+
+def test_term_does_not_match_nonexistent_empty_memo():
+    assert not matches("x", E2)
+
+
+def test_and_implicit():
+    assert matches("food lunch", E1)
+    assert not matches("food coffee", E1)
+
+
+def test_and_explicit():
+    assert matches("food AND lunch", E1)
+    assert not matches("food AND coffee", E1)
+
+
+def test_or():
+    assert matches("rent OR lunch", E1)
+    assert not matches("rent OR coffee", E1)
+
+
+def test_not():
+    assert matches("NOT rent", E1)
+    assert not matches("NOT food", E1)
+
+
+def test_not_binds_tighter_than_and():
+    # (NOT rent) AND lunch
+    assert matches("NOT rent lunch", E1)
+    assert not matches("NOT rent lunch", E2)
+
+
+def test_and_binds_tighter_than_or():
+    # food OR (rent AND lunch)
+    assert matches("food OR rent lunch", E1)
+    assert matches("food OR rent lunch", E3)  # food
+    assert not matches("rent OR transport coffee", E3)
+
+
+def test_or_lower_than_and_unparenthesized():
+    # a OR b c  ==  a OR (b AND c)
+    assert matches("rent OR food lunch", E1)
+    assert not matches("rent OR food coffee", E1)
+
+
+def test_parens_override_precedence():
+    assert not matches("(rent OR food) coffee", E1)
+    assert matches("(rent OR food) lunch", E1)
+
+
+def test_double_not():
+    assert matches("NOT NOT food", E1)
+    assert not matches("NOT NOT rent", E1)
+
+
+def test_nested_parens():
+    assert matches("((food))", E1)
+
+
+def test_lowercase_and_is_term_not_operator():
+    e = Expense(date(2026, 11, 6), "x", 1, "and")
+    assert matches("and", e)
+    assert not matches("and", E1)
+
+
+def test_quoted_and_is_term():
+    e = Expense(date(2026, 11, 6), "x", 1, "AND")
+    assert matches('"AND"', e)
+
+
+def test_cat_combined_with_term():
+    assert matches("cat:food lunch", E1)
+    assert not matches("cat:food coffee", E1)
+
+
+# --- filter_rows ---
+
+
+def test_filter_rows_preserves_order():
+    assert filter_rows("food", ROWS) == [E1, E3]
+
+
+def test_filter_rows_returns_new_list_on_empty_match():
+    assert filter_rows("zzz", ROWS) == []
+
+
+def test_filter_rows_empty_input():
+    assert filter_rows("food", []) == []
+
+
+def test_filter_rows_valid_query_on_empty_input():
+    assert filter_rows("cat:food", []) == []
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..a595058
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,244 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def e(day: date, category: str = "通信", amount: int = 1000, memo: str = "") -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- add_month ---------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("src", "expected"),
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2024, 1, 31), date(2024, 2, 29)),
+        (date(2026, 12, 15), date(2027, 1, 15)),
+        (date(2026, 3, 31), date(2026, 4, 30)),
+        (date(2026, 11, 30), date(2026, 12, 30)),
+        (date(2026, 2, 28), date(2026, 3, 28)),
+    ],
+)
+def test_add_month(src: date, expected: date) -> None:
+    assert add_month(src) == expected
+
+
+# --- find_recurring: argument validation -------------------------------------
+
+
+def test_min_count_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+
+
+def test_negative_tolerance_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_min_count_two_and_zero_tolerance_allowed() -> None:
+    rows = [e(date(2026, 1, 10)), e(date(2026, 2, 10))]
+    assert find_recurring(rows, min_count=2, tolerance=0) == [
+        Recurring(
+            "通信", 1000, (date(2026, 1, 10), date(2026, 2, 10)), date(2026, 3, 10)
+        )
+    ]
+
+
+# --- find_recurring: basic behaviour -----------------------------------------
+
+
+def test_empty_input_returns_empty() -> None:
+    assert find_recurring([]) == []
+
+
+def test_three_monthly_occurrences_detected() -> None:
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 5)), e(date(2026, 3, 5))]
+    assert find_recurring(rows) == [
+        Recurring(
+            "通信",
+            1000,
+            (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+            date(2026, 4, 5),
+        )
+    ]
+
+
+def test_fewer_than_min_count_is_not_recurring() -> None:
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 5))]
+    assert find_recurring(rows, min_count=3) == []
+    assert len(find_recurring(rows, min_count=2)) == 1
+
+
+def test_memo_is_ignored_for_grouping() -> None:
+    rows = [
+        e(date(2026, 1, 5), memo="a"),
+        e(date(2026, 2, 5), memo="b"),
+        e(date(2026, 3, 5), memo=""),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_different_amounts_are_separate_groups() -> None:
+    rows = [
+        e(date(2026, 1, 5), amount=1000),
+        e(date(2026, 2, 5), amount=1001),
+        e(date(2026, 3, 5), amount=1000),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_different_categories_are_separate_groups() -> None:
+    rows = [
+        e(date(2026, 1, 5), category="A"),
+        e(date(2026, 2, 5), category="B"),
+        e(date(2026, 3, 5), category="A"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_same_day_duplicates_count_once() -> None:
+    rows = [
+        e(date(2026, 1, 5)),
+        e(date(2026, 1, 5)),
+        e(date(2026, 2, 5)),
+    ]
+    assert find_recurring(rows, min_count=3) == []
+    result = find_recurring(rows, min_count=2)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5))
+
+
+def test_input_order_does_not_matter() -> None:
+    rows = [e(date(2026, 3, 5)), e(date(2026, 1, 5)), e(date(2026, 2, 5))]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+    assert isinstance(result[0].days, tuple)
+
+
+# --- find_recurring: tolerance ----------------------------------------------
+
+
+def test_gap_equal_to_tolerance_connects() -> None:
+    # expected 2026-02-10, actual 2026-02-13 -> diff 3 == tolerance
+    rows = [e(date(2026, 1, 10)), e(date(2026, 2, 13)), e(date(2026, 3, 13))]
+    # 02-13 -> expected 03-13, diff 0: connected
+    assert len(find_recurring(rows)) == 1
+
+
+def test_gap_beyond_tolerance_splits() -> None:
+    # expected 2026-02-10, actual 2026-02-14 -> diff 4 > 3
+    rows = [e(date(2026, 1, 10)), e(date(2026, 2, 14)), e(date(2026, 3, 14))]
+    assert find_recurring(rows) == []
+
+
+def test_early_drift_connects_within_tolerance() -> None:
+    # expected 2026-02-10, actual 2026-02-07 -> diff -3, abs 3 == tolerance
+    rows = [e(date(2026, 1, 10)), e(date(2026, 2, 7)), e(date(2026, 3, 7))]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_larger_tolerance_connects_wider_gap() -> None:
+    rows = [e(date(2026, 1, 10)), e(date(2026, 2, 18)), e(date(2026, 3, 18))]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, tolerance=8)) == 1
+
+
+def test_zero_tolerance_requires_exact_day() -> None:
+    rows = [e(date(2026, 1, 10)), e(date(2026, 2, 11)), e(date(2026, 3, 11))]
+    assert find_recurring(rows, tolerance=0) == []
+
+
+def test_month_end_clamp_chain() -> None:
+    # 01-31 -> expected 02-28; 02-28 -> expected 03-28; 03-31 is diff 3 from 03-28
+    rows = [e(date(2026, 1, 31)), e(date(2026, 2, 28)), e(date(2026, 3, 31))]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 30)
+
+
+# --- find_recurring: run splitting ------------------------------------------
+
+
+def test_break_splits_into_separate_runs() -> None:
+    rows = [
+        e(date(2026, 1, 5)),
+        e(date(2026, 2, 5)),
+        e(date(2026, 3, 5)),
+        e(date(2026, 6, 5)),  # break: expected 04-05 / 05-05 missing
+        e(date(2026, 7, 5)),
+        e(date(2026, 8, 5)),
+    ]
+    result = find_recurring(rows)
+    assert [r.days for r in result] == [
+        (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+        (date(2026, 6, 5), date(2026, 7, 5), date(2026, 8, 5)),
+    ]
+
+
+def test_short_run_after_break_is_dropped() -> None:
+    rows = [
+        e(date(2026, 1, 5)),
+        e(date(2026, 2, 5)),
+        e(date(2026, 3, 5)),
+        e(date(2026, 6, 5)),
+        e(date(2026, 7, 5)),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days[0] == date(2026, 1, 5)
+
+
+def test_next_expected_uses_last_day_of_run() -> None:
+    rows = [
+        e(date(2026, 1, 5)),
+        e(date(2026, 2, 5)),
+        e(date(2026, 3, 5)),
+        e(date(2026, 4, 5)),
+    ]
+    result = find_recurring(rows)
+    assert result[0].next_expected == date(2026, 5, 5)
+
+
+# --- find_recurring: result ordering ----------------------------------------
+
+
+def test_results_sorted_by_category_amount_then_first_day() -> None:
+    rows = [
+        e(date(2026, 1, 5), category="B", amount=100),
+        e(date(2026, 2, 5), category="B", amount=100),
+        e(date(2026, 3, 5), category="B", amount=100),
+        e(date(2026, 1, 9), category="A", amount=200),
+        e(date(2026, 2, 9), category="A", amount=200),
+        e(date(2026, 3, 9), category="A", amount=200),
+        e(date(2026, 1, 9), category="A", amount=100),
+        e(date(2026, 2, 9), category="A", amount=100),
+        e(date(2026, 3, 9), category="A", amount=100),
+    ]
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [
+        ("A", 100),
+        ("A", 200),
+        ("B", 100),
+    ]
+
+
+def test_same_category_and_amount_sorted_by_first_day() -> None:
+    # Two separate runs in one group; the earlier-starting run must come first.
+    rows = [
+        e(date(2026, 6, 5)),
+        e(date(2026, 7, 5)),
+        e(date(2026, 8, 5)),
+        e(date(2026, 1, 5)),
+        e(date(2026, 2, 5)),
+        e(date(2026, 3, 5)),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 5), date(2026, 6, 5)]
