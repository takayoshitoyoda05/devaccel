@@ -0,0 +1,22 @@
+"""Detect duplicate expense records."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def find_duplicates(rows: list[Expense]) -> list[tuple[int, int]]:
+    """Return index pairs (i, j), i < j, of rows that are identical in all fields.
+
+    Sorted by i ascending, then j ascending.
+    """
+    groups: dict[Expense, list[int]] = {}
+    for idx, e in enumerate(rows):
+        groups.setdefault(e, []).append(idx)
+    pairs = [
+        (i, j)
+        for idxs in groups.values()
+        for k, i in enumerate(idxs)
+        for j in idxs[k + 1 :]
+    ]
+    return sorted(pairs)
