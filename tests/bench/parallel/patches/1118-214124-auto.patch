@@ -0,0 +1,16 @@
+"""Weekday aggregation."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+_WEEKDAYS = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
+
+
+def total_by_weekday(rows: list[Expense]) -> dict[str, int]:
+    """{"Mon".."Sun": yen}; weekdays without expenses are omitted, Monday first."""
+    totals: dict[str, int] = {}
+    for e in rows:
+        name = _WEEKDAYS[e.day.weekday()]  # Monday == 0
+        totals[name] = totals.get(name, 0) + e.amount
+    return {w: totals[w] for w in _WEEKDAYS if w in totals}
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..967b7b1
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,181 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+HEADER = "利用日,分類,利用金額,利用店名,カード番号\n"
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥5", 5),
+        ("-0", 0),
+        ("1,,2", 12),  # comma positions are not checked
+        ("1234円", 1234),
+    ],
+)
+def test_parse_amount_accepts(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    ["", "円", "12.5", "1 200", "--5", "¥-5", "１２３", ",5", "5円円", "円5", "-", "¥"],
+)
+def test_parse_amount_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        ("2026/12/31", date(2026, 12, 31)),
+        ("  2026-1-5  ", date(2026, 1, 5)),
+    ],
+)
+def test_parse_date_accepts(text: str, expected: date) -> None:
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    ["2026/1-5", "26/1/5", "2026/02/30", "", "2026.1.5", "２０２６/1/5", "2026/13/1"],
+)
+def test_parse_date_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+def test_default_mapping_values() -> None:
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_import_basic_uses_default_mapping_and_ignores_extra_columns() -> None:
+    text = HEADER + '2026/1/5,食費,"1,200",スーパーA,1234\n'
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 1200, "スーパーA")]
+
+
+def test_import_keeps_input_order_and_strips_fields() -> None:
+    text = HEADER + " 2026-01-02 , 交通費 , -300 , 駅 \n2026/1/1,食費,100,\n"
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [
+        Expense(date(2026, 1, 2), "交通費", -300, "駅"),
+        Expense(date(2026, 1, 1), "食費", 100, ""),
+    ]
+
+
+def test_quoted_comma_in_value() -> None:
+    text = HEADER + '2026/1/5,"食費, 外食","980円","A, B店",\n'
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows[0].category == "食費, 外食"
+    assert rows[0].memo == "A, B店"
+
+
+def test_custom_mapping_and_optional_memo() -> None:
+    text = "when,what,how much\n2026/3/3,給与,¥10\n"
+    mapping = {"date": "when", "category": "what", "amount": "how much"}
+    rows, errors = import_rows(text, mapping)
+    assert errors == []
+    assert rows == [Expense(date(2026, 3, 3), "給与", 10, "")]
+
+
+@pytest.mark.parametrize("missing", ["date", "category", "amount"])
+def test_mapping_missing_required_key_raises(missing: str) -> None:
+    mapping = {k: v for k, v in DEFAULT_MAPPING.items() if k != missing}
+    with pytest.raises(ValueError):
+        import_rows(HEADER, mapping)
+
+
+def test_mapping_column_not_in_header_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows("日付,分類,金額\n", None)
+
+
+def test_mapping_memo_column_not_in_header_raises() -> None:
+    mapping = {**DEFAULT_MAPPING, "memo": "存在しない"}
+    with pytest.raises(ValueError):
+        import_rows(HEADER, mapping)
+
+
+def test_empty_text_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows("")
+
+
+def test_blank_lines_are_skipped_but_counted() -> None:
+    text = HEADER + "\n2026/1/5,食費,100,A\n\n2026/1/6,食費,oops,B\n"
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "A")]
+    assert errors == [(5, "amount")]
+
+
+def test_errors_report_physical_line_numbers_and_all_fields_in_order() -> None:
+    text = HEADER + (
+        "2026/1/5,食費,100,A\n"  # line 2 ok
+        "bad,,xx,B\n"  # line 3: date, amount, category
+        "2026/1/7,   ,100,C\n"  # line 4: category blank
+    )
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "A")]
+    assert errors == [
+        (3, "date"),
+        (3, "amount"),
+        (3, "category"),
+        (4, "category"),
+    ]
+
+
+def test_row_with_errors_is_excluded_entirely() -> None:
+    text = HEADER + "2026/1/5,食費,xx,A\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "amount")]
+
+
+def test_short_row_treats_missing_values_as_empty() -> None:
+    text = HEADER + "2026/1/5\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "amount"), (2, "category")]
+
+
+def test_short_row_missing_memo_is_empty_memo() -> None:
+    text = "利用日,分類,利用金額,利用店名\n2026/1/5,食費,100\n"
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+def test_category_map_replaces_stripped_category() -> None:
+    text = HEADER + "2026/1/5, 食料品 ,100,A\n2026/1/6,交通,200,B\n"
+    rows, errors = import_rows(text, category_map={"食料品": "食費"})
+    assert errors == []
+    assert [r.category for r in rows] == ["食費", "交通"]
+
+
+def test_category_map_does_not_apply_to_empty_category_error() -> None:
+    text = HEADER + "2026/1/5,,100,A\n"
+    rows, errors = import_rows(text, category_map={"": "食費"})
+    assert rows == []
+    assert errors == [(2, "category")]
