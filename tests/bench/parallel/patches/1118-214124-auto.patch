+++ b/src/kakeibo/stats.py
@@ -0,0 +1,28 @@
+"""Per-category statistics over Expense records."""
+
+from __future__ import annotations
+
+from collections import defaultdict
+
+from kakeibo.core import Expense
+
+
+def median_by_category(rows: list[Expense]) -> dict[str, float]:
+    """{category: median yen}; categories sorted by name ascending.
+
+    Even counts average the two middle values. Returns {} for no rows.
+    """
+    by_cat: dict[str, list[int]] = defaultdict(list)
+    for e in rows:
+        by_cat[e.category].append(e.amount)
+
+    out: dict[str, float] = {}
+    for cat in sorted(by_cat):
+        values = sorted(by_cat[cat])
+        n = len(values)
+        mid = n // 2
+        if n % 2:
+            out[cat] = float(values[mid])
+        else:
+            out[cat] = (values[mid - 1] + values[mid]) / 2
+    return out
