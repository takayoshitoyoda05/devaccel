+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.stats import median_by_category
+
+
+def _e(category: str, amount: int, day: int = 1) -> Expense:
+    return Expense(date(2026, 11, day), category, amount)
+
+
+def test_empty_rows_returns_empty_dict():
+    assert median_by_category([]) == {}
+
+
+def test_single_row_returns_its_amount_as_float():
+    out = median_by_category([_e("food", 1200)])
+    assert out == {"food": 1200.0}
+    assert isinstance(out["food"], float)
+
+
+def test_odd_count_returns_middle_value_regardless_of_input_order():
+    rows = [_e("food", 300), _e("food", 100), _e("food", 200)]
+    assert median_by_category(rows) == {"food": 200.0}
+
+
+def test_even_count_returns_mean_of_two_middle_values():
+    rows = [_e("food", 300), _e("food", 100), _e("food", 200), _e("food", 400)]
+    assert median_by_category(rows) == {"food": 250.0}
+
+
+def test_two_values_returns_their_mean():
+    rows = [_e("rent", 100), _e("rent", 300)]
+    assert median_by_category(rows) == {"rent": 200.0}
+
+
+def test_duplicate_values_are_counted():
+    rows = [_e("food", 500), _e("food", 500)]
+    assert median_by_category(rows) == {"food": 500.0}
+
+
+def test_each_category_uses_only_its_own_rows():
+    rows = [
+        _e("food", 100),
+        _e("rent", 80000),
+        _e("food", 300),
+        _e("rent", 90000),
+        _e("food", 200),
+    ]
+    assert median_by_category(rows) == {"food": 200.0, "rent": 85000.0}
+
+
+def test_keys_are_sorted_by_category_name_ascending():
+    rows = [_e("rent", 1), _e("food", 2), _e("transport", 3), _e("books", 4)]
+    out = median_by_category(rows)
+    assert list(out) == ["books", "food", "rent", "transport"]
+
+
+def test_key_order_is_by_name_not_by_amount():
+    rows = [_e("zzz", 1), _e("aaa", 9999)]
+    assert list(median_by_category(rows)) == ["aaa", "zzz"]
+
+
+def test_input_list_is_not_mutated():
+    rows = [_e("food", 300), _e("food", 100), _e("food", 200)]
+    before = list(rows)
+    median_by_category(rows)
+    assert rows == before
