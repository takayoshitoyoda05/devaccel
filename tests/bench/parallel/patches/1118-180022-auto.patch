@@ -0,0 +1,29 @@
+"""Longest run of days without any expense record."""
+
+from __future__ import annotations
+
+from datetime import date, timedelta
+
+from kakeibo.core import Expense
+
+
+def longest_no_spend_streak(rows: list[Expense], start: date, end: date) -> int:
+    """Longest run of consecutive days in [start, end] with no record.
+
+    Both ends are inclusive. Records outside the period are ignored.
+    Returns 0 when start is after end (the period is empty).
+    """
+    if start > end:
+        return 0
+    spend_days = {e.day for e in rows if start <= e.day <= end}
+    best = 0
+    current = 0
+    day = start
+    while day <= end:
+        if day in spend_days:
+            current = 0
+        else:
+            current += 1
+            best = max(best, current)
+        day += timedelta(days=1)
+    return best
