+++ b/src/kakeibo/topn.py
@@ -0,0 +1,17 @@
+"""Top-N expense selection."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def top_expenses(rows: list[Expense], n: int) -> list[Expense]:
+    """Return up to n expenses, largest amount first.
+
+    Ties are broken by earlier date, then by input order (sort is stable).
+    Returns [] when n <= 0. The input list is not modified.
+    """
+    if n <= 0:
+        return []
+    ordered = sorted(rows, key=lambda x: (-x.amount, x.day))
+    return ordered[:n]
