@@ -0,0 +1,72 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.dupes import find_duplicates
+
+
+def _e(
+    day: str = "2024-01-02", category: str = "食費", amount: int = 500, memo: str = ""
+) -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+def test_empty_list_has_no_duplicates() -> None:
+    assert find_duplicates([]) == []
+
+
+def test_single_row_has_no_duplicates() -> None:
+    assert find_duplicates([_e()]) == []
+
+
+def test_no_identical_rows() -> None:
+    rows = [
+        _e(),
+        _e(amount=501),
+        _e(category="交通費"),
+        _e(memo="x"),
+        _e(day="2024-01-03"),
+    ]
+    assert find_duplicates(rows) == []
+
+
+def test_identical_pair() -> None:
+    assert find_duplicates([_e(), _e()]) == [(0, 1)]
+
+
+def test_non_adjacent_pair_returns_input_indices() -> None:
+    rows = [_e(amount=1), _e(amount=2), _e(amount=1)]
+    assert find_duplicates(rows) == [(0, 2)]
+
+
+def test_three_identical_rows_yields_all_pairs_in_order() -> None:
+    rows = [_e(), _e(), _e()]
+    assert find_duplicates(rows) == [(0, 1), (0, 2), (1, 2)]
+
+
+def test_order_is_by_i_then_j() -> None:
+    # 0 と 3 が一致、1 と 2 が一致
+    rows = [_e(amount=1), _e(amount=2), _e(amount=2), _e(amount=1)]
+    assert find_duplicates(rows) == [(0, 3), (1, 2)]
+
+
+def test_memo_difference_is_not_duplicate() -> None:
+    assert find_duplicates([_e(memo="a"), _e(memo="b")]) == []
+
+
+def test_category_difference_is_not_duplicate() -> None:
+    assert find_duplicates([_e(category="食費"), _e(category="日用品")]) == []
+
+
+def test_amount_difference_is_not_duplicate() -> None:
+    assert find_duplicates([_e(amount=500), _e(amount=600)]) == []
+
+
+def test_day_difference_is_not_duplicate() -> None:
+    assert find_duplicates([_e(day="2024-01-02"), _e(day="2024-01-03")]) == []
+
+
+def test_only_identical_members_are_paired_across_groups() -> None:
+    rows = [_e(amount=1), _e(amount=1, memo="m"), _e(amount=1), _e(amount=1, memo="m")]
+    assert find_duplicates(rows) == [(0, 2), (1, 3)]
