+++ b/tests/test_bankimport.py
@@ -0,0 +1,146 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+HEADER = "利用日,分類,利用金額,利用店名\n"
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥1", 1),
+        ("1,,2", 12),  # comma positions are not checked
+        ("-￥5円", -5),
+    ],
+)
+def test_parse_amount_accepts(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    ["", "円", "12.5", "1 200", "--5", "¥-5", "１２３", "-", "¥", "円980", ",1"],
+)
+def test_parse_amount_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/1/5 ", date(2026, 1, 5)),
+        ("2026-1-5", date(2026, 1, 5)),
+        ("2024/2/29", date(2024, 2, 29)),
+    ],
+)
+def test_parse_date_accepts(text: str, expected: date) -> None:
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    ["2026/1-5", "26/1/5", "2026/02/30", "", "2026.1.5", "２０２６/1/5", "2026/13/1"],
+)
+def test_parse_date_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+def test_default_mapping() -> None:
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_import_basic_in_order() -> None:
+    text = HEADER + '2026/1/5,食費,"1,200",  スーパー  \n2026-01-06,交通,300,電車\n'
+    expenses, errors = import_rows(text)
+    assert errors == []
+    assert expenses == [
+        Expense(date(2026, 1, 5), "食費", 1200, "スーパー"),
+        Expense(date(2026, 1, 6), "交通", 300, "電車"),
+    ]
+
+
+def test_extra_columns_ignored_and_missing_values_empty() -> None:
+    text = "利用日,分類,利用金額,利用店名,余分\n2026/1/5,食費,100\n"
+    expenses, errors = import_rows(text)
+    assert errors == []
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+def test_quoted_comma_and_multiline_line_numbers() -> None:
+    text = HEADER + '2026/1/5,食費,100,"a,\nb"\n\n2026/1/x,食費,100,z\n'
+    expenses, errors = import_rows(text)
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "a,\nb")]
+    # header line 1; record spans lines 2-3; blank line 4; bad row on line 5
+    assert errors == [(5, "date")]
+
+
+def test_blank_lines_counted_but_skipped() -> None:
+    text = HEADER + "\n2026/1/5,食費,100,\n\n"
+    expenses, errors = import_rows(text)
+    assert errors == []
+    assert len(expenses) == 1
+
+
+def test_errors_recorded_in_order_and_row_excluded() -> None:
+    text = HEADER + "x,,y,z\n2026/1/5,食費,100,ok\n2026/1/5,  ,abc,z\n"
+    expenses, errors = import_rows(text)
+    assert errors == [
+        (2, "date"),
+        (2, "amount"),
+        (2, "category"),
+        (4, "amount"),
+        (4, "category"),
+    ]
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "ok")]
+
+
+def test_short_row_missing_values_are_empty() -> None:
+    text = HEADER + "2026/1/5\n"
+    expenses, errors = import_rows(text)
+    assert expenses == []
+    assert errors == [(2, "amount"), (2, "category")]
+
+
+def test_category_map_applied_after_strip() -> None:
+    text = HEADER + "2026/1/5, 食費 ,100,\n2026/1/6,交通,200,\n"
+    expenses, errors = import_rows(text, category_map={"食費": "Food"})
+    assert errors == []
+    assert [e.category for e in expenses] == ["Food", "交通"]
+
+
+def test_custom_mapping_and_memo_optional() -> None:
+    text = "日付,科目,額\n2026/1/5,食費,100\n"
+    mapping = {"date": "日付", "category": "科目", "amount": "額"}
+    expenses, errors = import_rows(text, mapping)
+    assert errors == []
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+@pytest.mark.parametrize("missing", ["date", "category", "amount"])
+def test_mapping_missing_required_key_raises(missing: str) -> None:
+    mapping = {k: v for k, v in DEFAULT_MAPPING.items() if k != missing}
+    with pytest.raises(ValueError):
+        import_rows(HEADER, mapping)
+
+
+def test_mapping_column_not_in_header_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows("利用日,分類\n", None)
