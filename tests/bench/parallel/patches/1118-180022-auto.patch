@@ -0,0 +1,16 @@
+"""Totals by day of the week."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+_WEEKDAYS = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
+
+
+def total_by_weekday(rows: list[Expense]) -> dict[str, int]:
+    """{"Mon".."Sun": yen}; weekdays with no expense rows are omitted, Mon first."""
+    by_index: dict[int, int] = {}
+    for e in rows:
+        idx = e.day.weekday()  # Monday == 0
+        by_index[idx] = by_index.get(idx, 0) + e.amount
+    return {_WEEKDAYS[i]: by_index[i] for i in range(len(_WEEKDAYS)) if i in by_index}
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..7b35414
