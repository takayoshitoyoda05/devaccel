+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.stats import median_by_category
+
+
+def _e(category: str, amount: int) -> Expense:
+    return Expense(day=date(2026, 1, 1), category=category, amount=amount)
+
+
+def test_empty_returns_empty_dict() -> None:
+    assert median_by_category([]) == {}
+
+
+def test_single_row_median_is_its_amount_as_float() -> None:
+    result = median_by_category([_e("food", 100)])
+    assert result == {"food": 100.0}
+    assert isinstance(result["food"], float)
+
+
+def test_odd_count_uses_middle_value() -> None:
+    rows = [_e("food", 300), _e("food", 100), _e("food", 200)]
+    assert median_by_category(rows) == {"food": 200.0}
+
+
+def test_even_count_averages_two_middle_values() -> None:
+    rows = [_e("food", 100), _e("food", 400), _e("food", 200), _e("food", 300)]
+    assert median_by_category(rows) == {"food": 250.0}
+
+
+def test_even_count_with_equal_middle_values() -> None:
+    rows = [_e("food", 100), _e("food", 100)]
+    assert median_by_category(rows) == {"food": 100.0}
+
+
+def test_all_same_values() -> None:
+    rows = [_e("food", 500) for _ in range(5)]
+    assert median_by_category(rows) == {"food": 500.0}
+
+
+def test_zero_amount_is_counted() -> None:
+    rows = [_e("food", 0), _e("food", 0), _e("food", 300)]
+    assert median_by_category(rows) == {"food": 0.0}
+
+
+def test_categories_are_computed_separately() -> None:
+    rows = [
+        _e("food", 100),
+        _e("rent", 90000),
+        _e("food", 300),
+        _e("rent", 80000),
+        _e("food", 200),
+    ]
+    assert median_by_category(rows) == {"food": 200.0, "rent": 85000.0}
+
+
+def test_keys_are_sorted_ascending_by_category_name() -> None:
+    rows = [_e("transport", 1), _e("food", 2), _e("rent", 3), _e("food", 4)]
+    result = median_by_category(rows)
+    assert list(result) == ["food", "rent", "transport"]
+
+
+def test_input_order_does_not_change_result() -> None:
+    rows = [_e("food", 100), _e("food", 400), _e("food", 200), _e("food", 300)]
+    assert median_by_category(rows) == median_by_category(list(reversed(rows)))
+
+
+def test_input_list_is_not_mutated() -> None:
+    rows = [_e("food", 300), _e("food", 100), _e("food", 200)]
+    before = list(rows)
+    median_by_category(rows)
+    assert rows == before
