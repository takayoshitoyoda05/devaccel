@@ -0,0 +1,64 @@
+import json
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.export import to_json
+
+
+def test_empty_list_gives_empty_array() -> None:
+    assert to_json([]) == "[]"
+
+
+def test_single_row_exact_output() -> None:
+    rows = [Expense(date(2024, 3, 5), "食費", 1200, "昼")]
+    assert to_json(rows) == (
+        '[{"date": "2024-03-05", "category": "食費", "amount": 1200, "memo": "昼"}]'
+    )
+
+
+def test_key_order_is_date_category_amount_memo() -> None:
+    rows = [Expense(date(2024, 1, 1), "a", 1, "m")]
+    assert list(json.loads(to_json(rows))[0].keys()) == [
+        "date",
+        "category",
+        "amount",
+        "memo",
+    ]
+
+
+def test_input_order_is_preserved() -> None:
+    rows = [
+        Expense(date(2024, 2, 1), "b", 2),
+        Expense(date(2024, 1, 1), "a", 1),
+    ]
+    dates = [item["date"] for item in json.loads(to_json(rows))]
+    assert dates == ["2024-02-01", "2024-01-01"]
+
+
+def test_non_ascii_is_not_escaped() -> None:
+    rows = [Expense(date(2024, 1, 1), "外食", 500, "ラーメン")]
+    out = to_json(rows)
+    assert "外食" in out
+    assert "ラーメン" in out
+    assert "\\u" not in out
+
+
+def test_empty_memo_is_empty_string() -> None:
+    rows = [Expense(date(2024, 1, 1), "食費", 100)]
+    assert json.loads(to_json(rows))[0]["memo"] == ""
+
+
+def test_date_is_zero_padded_iso() -> None:
+    rows = [Expense(date(2024, 1, 9), "食費", 100, "")]
+    assert json.loads(to_json(rows))[0]["date"] == "2024-01-09"
+
+
+def test_amount_is_integer_not_string() -> None:
+    rows = [Expense(date(2024, 1, 1), "食費", 980, "")]
+    assert json.loads(to_json(rows))[0]["amount"] == 980
+    assert isinstance(json.loads(to_json(rows))[0]["amount"], int)
+
+
+def test_no_indentation() -> None:
+    rows = [Expense(date(2024, 1, 1), "食費", 100, "")]
+    assert "\n" not in to_json(rows)
