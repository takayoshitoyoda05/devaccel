index 0000000..fccd208
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,122 @@
+"""Import bank-statement CSV text into Expense records."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_DATE_RE = re.compile(r"[0-9]{4}/[0-9]{1,2}/[0-9]{1,2}|[0-9]{4}-[0-9]{1,2}-[0-9]{1,2}")
+_AMOUNT_RE = re.compile(r"-?[¥￥]?[0-9][0-9,]*円?")
+
+
+def parse_amount(s: str) -> int:
+    """Parse a bank amount such as ``￥1,234`` or ``-300円`` into yen."""
+    text = s.strip()
+    if not _AMOUNT_RE.fullmatch(text):
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    digits = re.sub(r"[¥￥円,]", "", text)
+    return int(digits)
+
+
+def parse_date(s: str) -> date:
+    """Parse ``YYYY/M/D`` or ``YYYY-M-D`` (separator must be consistent)."""
+    text = s.strip()
+    if not _DATE_RE.fullmatch(text):
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    sep = "/" if "/" in text else "-"
+    year, month, day = (int(p) for p in text.split(sep))
+    return date(year, month, day)  # raises ValueError for nonexistent dates
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Read bank CSV text (header on line 1).
+
+    Returns ``(expenses, errors)`` where errors are ``(line_number, field)``.
+    Rows with any error are excluded from expenses.
+    """
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text))
+    prev_line = 0
+
+    def next_record() -> tuple[int, list[str] | None]:
+        nonlocal prev_line
+        start = prev_line + 1
+        try:
+            row = next(reader)
+        except StopIteration:
+            return start, None
+        prev_line = reader.line_num
+        return start, row
+
+    _, header = next_record()
+    if header is None:
+        raise ValueError("ヘッダーがありません")
+    index: dict[str, int] = {}
+    for field, column in mapping.items():
+        if column not in header:
+            raise ValueError(f"列 {column!r} がヘッダーにありません")
+        index[field] = header.index(column)
+
+    def cell(row: list[str], field: str) -> str:
+        if field not in index:
+            return ""
+        i = index[field]
+        return row[i] if i < len(row) else ""
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    while True:
+        line, row = next_record()
+        if row is None:
+            break
+        if row == [] or (len(row) == 1 and row[0].strip() == ""):
+            continue  # blank line: skipped but still counted
+        row_errors: list[tuple[int, str]] = []
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(cell(row, "date"))
+        except ValueError:
+            row_errors.append((line, "date"))
+        try:
+            amount = parse_amount(cell(row, "amount"))
+        except ValueError:
+            row_errors.append((line, "amount"))
+        category = cell(row, "category").strip()
+        if not category:
+            row_errors.append((line, "category"))
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        assert day is not None and amount is not None
+        if category_map is not None and category in category_map:
+            category = category_map[category]
+        expenses.append(
+            Expense(
+                day=day,
+                category=category,
+                amount=amount,
+                memo=cell(row, "memo").strip(),
+            )
+        )
+    return expenses, errors
diff --git a/src/kakeibo/dupes.py b/src/kakeibo/dupes.py
