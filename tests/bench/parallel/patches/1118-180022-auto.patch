diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..34b7d36
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,167 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def E(y, m, cat, amount, d=1):
+    return Expense(date(y, m, d), cat, amount)
+
+
+ROWS = [
+    E(2026, 10, "food", 1000),
+    E(2026, 10, "food", 500, d=2),  # 同じカテゴリの複数明細は合算
+    E(2026, 10, "rent", 80000),
+    E(2026, 10, "gift", 300),  # gone
+    E(2026, 11, "food", 1500),
+    E(2026, 11, "rent", 80000),
+    E(2026, 11, "fun", 900),  # new
+    E(2026, 11, "misc", 0),  # 金額 0 でも明細はある
+    E(2026, 9, "old", 10),  # 比較対象外の月
+]
+
+
+def _by_cat(diffs):
+    return {r.category: r for r in diffs}
+
+
+def test_month_diff_values_and_status():
+    diffs = _by_cat(month_diff(ROWS, "2026-10", "2026-11"))
+    assert diffs["food"] == DiffRow("food", 1500, 1500, 0, 0.0, "same")
+    assert diffs["rent"] == DiffRow("rent", 80000, 80000, 0, 0.0, "same")
+    assert diffs["gift"] == DiffRow("gift", 300, 0, -300, -100.0, "gone")
+    assert diffs["fun"] == DiffRow("fun", 0, 900, 900, None, "new")
+    assert diffs["misc"] == DiffRow("misc", 0, 0, 0, None, "new")
+    assert "old" not in diffs
+
+
+def test_up_down_and_pct_rounding():
+    rows = [
+        E(2026, 10, "a", 3),
+        E(2026, 11, "a", 4),  # 33.3...% -> 33.3, up
+        E(2026, 10, "b", 300),
+        E(2026, 11, "b", 200),  # -33.3, down
+    ]
+    d = _by_cat(month_diff(rows, "2026-10", "2026-11"))
+    assert d["a"].status == "up"
+    assert d["a"].pct == 33.3
+    assert d["b"].status == "down"
+    assert d["b"].pct == -33.3
+
+
+def test_zero_prev_with_items_is_new_not_same():
+    rows = [E(2026, 10, "x", 0), E(2026, 11, "x", 0)]
+    (r,) = month_diff(rows, "2026-10", "2026-11")
+    assert r.status == "same"
+    assert r.pct is None
+
+
+def test_zero_prev_nonzero_curr_pct_none():
+    rows = [E(2026, 11, "x", 5)]
+    (r,) = month_diff(rows, "2026-10", "2026-11")
+    assert r == DiffRow("x", 0, 5, 5, None, "new")
+
+
+def test_empty_rows_and_no_matching_month():
+    assert month_diff([], "2026-10", "2026-11") == []
+    assert month_diff(ROWS, "2025-01", "2025-02") == []
+
+
+def test_order_by_abs_delta_then_category():
+    rows = [
+        E(2026, 10, "b", 100),
+        E(2026, 11, "b", 0),  # delta -100
+        E(2026, 10, "a", 50),
+        E(2026, 11, "a", 150),  # delta +100
+        E(2026, 11, "c", 100),  # delta +100, new
+        E(2026, 11, "d", 500),
+    ]
+    cats = [r.category for r in month_diff(rows, "2026-10", "2026-11")]
+    assert cats == ["d", "a", "b", "c"]
+
+
+def test_month_diff_rejects_bad_month_format():
+    for bad in [
+        "2026-1",
+        "2026-13",
+        "2026-00",
+        "2026/10",
+        "26-10",
+        "2026-010",
+        " 2026-10",
+    ]:
+        with pytest.raises(ValueError):
+            month_diff(ROWS, bad, "2026-11")
+        with pytest.raises(ValueError):
+            month_diff(ROWS, "2026-10", bad)
+
+
+def test_top_movers_excludes_same_and_keeps_order():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    movers = top_movers(diffs)
+    assert [r.category for r in movers] == [
+        r.category for r in diffs if r.status != "same"
+    ][:3]
+    assert all(r.status != "same" for r in movers)
+
+
+def test_top_movers_n_edges():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    assert top_movers(diffs, 0) == []
+    assert top_movers(diffs, 100) == [r for r in diffs if r.status != "same"]
+    assert top_movers([], 3) == []
+    with pytest.raises(ValueError):
+        top_movers(diffs, -1)
+
+
+def test_render_diff_format():
+    diffs = [
+        DiffRow("food", 1000, 1200, 200, 20.0, "up"),
+        DiffRow("rent", 80000, 0, -80000, -100.0, "gone"),
+        DiffRow("same", 5, 5, 0, 0.0, "same"),
+        DiffRow("fun", 0, 900, 900, None, "new"),
+        DiffRow("x", 1, 1, 0, -0.0, "same"),
+    ]
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "food\t1000\t1200\t+200\t+20.0%\n"
+        "rent\t80000\t0\t-80000\t-100.0%\n"
+        "same\t5\t5\t+0\t+0.0%\n"
+        "fun\t0\t900\t+900\t-\n"
+        "x\t1\t1\t+0\t+0.0%"
+    )
+
+
+def test_render_diff_empty_is_header_only_without_trailing_newline():
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_available_months_sorted_unique():
+    rows = [
+        E(2026, 11, "a", 1),
+        E(2026, 9, "a", 1),
+        E(2026, 11, "b", 1),
+        E(2025, 12, "a", 1),
+    ]
+    assert available_months(rows) == ["2025-12", "2026-09", "2026-11"]
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months():
+    assert latest_diff(ROWS) == month_diff(ROWS, "2026-10", "2026-11")
+
+
+def test_latest_diff_needs_two_months():
+    with pytest.raises(ValueError):
+        latest_diff([])
+    with pytest.raises(ValueError):
+        latest_diff([E(2026, 11, "a", 1), E(2026, 11, "b", 2)])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..11b32cf
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,236 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def _e(category: str, memo: str = "", day: date = date(2026, 11, 1)) -> Expense:
+    return Expense(day, category, 100, memo)
+
+
+ROWS = [
+    _e("food", "lunch at Cafe"),
+    _e("Food", "dinner"),
+    _e("rent", ""),
+    _e("transport", "bus pass (monthly)"),
+    _e("misc", "food truck"),
+]
+
+
+def _memos(rows):
+    return [r.memo or r.category for r in rows]
+
+
+# --- tokenize -------------------------------------------------------------
+
+
+def test_tokenize_whitespace_only_gives_no_tokens():
+    assert tokenize("") == []
+    assert tokenize("   \t ") == []
+
+
+def test_tokenize_parens_and_terms():
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+    assert tokenize("a(b") == [("TERM", "a"), ("LPAREN", "("), ("TERM", "b")]
+
+
+def test_tokenize_quoted_term_keeps_spaces_and_parens():
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+
+
+def test_tokenize_quote_ends_word():
+    assert tokenize('x"y z"') == [("TERM", "x"), ("TERM", "y z")]
+
+
+def test_tokenize_unclosed_quote_is_error():
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_is_error():
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_quoted_space_is_a_term_not_empty():
+    assert tokenize('" "') == [("TERM", " ")]
+
+
+def test_tokenize_operators_must_be_uppercase():
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+    assert tokenize("and or not") == [
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_quoted_operator_is_term():
+    assert tokenize('"AND"') == [("TERM", "AND")]
+
+
+def test_tokenize_cat_prefix_is_case_sensitive_and_needs_value():
+    assert tokenize("cat:food") == [("CAT", "food")]
+    assert tokenize("cat:食費 x") == [("CAT", "食費"), ("TERM", "x")]
+    assert tokenize("CAT:food") == [("TERM", "CAT:food")]
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_tokenize_cat_value_keeps_colons_and_stops_at_paren():
+    assert tokenize("cat:a:b)") == [("CAT", "a:b"), ("RPAREN", ")")]
+
+
+def test_tokenize_word_stops_at_special_chars():
+    assert tokenize("ab(cd)") == [
+        ("TERM", "ab"),
+        ("LPAREN", "("),
+        ("TERM", "cd"),
+        ("RPAREN", ")"),
+    ]
+
+
+# --- parse errors ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(",
+        ")",
+        "a)",
+        "(a",
+        "((a)",
+        "a OR",
+        "OR a",
+        "AND a",
+        "a AND",
+        "a AND AND b",
+        "a OR OR b",
+        "NOT",
+        "a NOT",
+        "NOT )",
+        "a OR (b",
+        "a ()",
+    ],
+)
+def test_bad_queries_raise(q):
+    with pytest.raises(QueryError):
+        matches(q, _e("food"))
+
+
+def test_query_error_is_value_error():
+    assert issubclass(QueryError, ValueError)
+
+
+# --- evaluation -----------------------------------------------------------
+
+
+def test_term_matches_memo_or_category_substring_casefold():
+    assert filter_rows("LUNCH", ROWS) == [ROWS[0]]
+    assert filter_rows("food", ROWS) == [ROWS[0], ROWS[1], ROWS[4]]
+    assert filter_rows("ren", ROWS) == [ROWS[2]]
+
+
+def test_term_matches_category_substring():
+    assert matches("sport", _e("transport"))
+    assert not matches("sport", _e("food"))
+
+
+def test_cat_is_exact_casefold_match():
+    assert filter_rows("cat:FOOD", ROWS) == [ROWS[0], ROWS[1]]
+    assert filter_rows("cat:foo", ROWS) == []
+    assert filter_rows("cat:food", [_e("food ")]) == []  # no trimming beyond load
+
+
+def test_cat_does_not_match_memo():
+    assert not matches("cat:lunch", _e("food", "lunch"))
+
+
+def test_term_with_spaces_is_substring():
+    assert filter_rows('"bus pass"', ROWS) == [ROWS[3]]
+
+
+def test_quoted_term_with_parens_matches_literally():
+    assert filter_rows('"(monthly)"', ROWS) == [ROWS[3]]
+
+
+def test_implicit_and():
+    assert filter_rows("food lunch", ROWS) == [ROWS[0]]
+    assert filter_rows("cat:food lunch", ROWS) == [ROWS[0]]
+
+
+def test_explicit_and_same_as_implicit():
+    assert filter_rows("food AND lunch", ROWS) == filter_rows("food lunch", ROWS)
+
+
+def test_or():
+    assert filter_rows("rent OR bus", ROWS) == [ROWS[2], ROWS[3]]
+
+
+def test_not_binds_tighter_than_and():
+    # (NOT rent) AND food
+    assert filter_rows("NOT rent food", ROWS) == [ROWS[0], ROWS[1], ROWS[4]]
+
+
+def test_and_binds_tighter_than_or():
+    # rent OR (bus AND food) -> only rent row; "bus pass" has no food
+    assert filter_rows("rent OR bus food", ROWS) == [ROWS[2]]
+    # food AND lunch OR rent -> lunch row and rent row
+    assert filter_rows("food lunch OR rent", ROWS) == [ROWS[0], ROWS[2]]
+
+
+def test_parens_override_precedence():
+    assert filter_rows("(rent OR bus) food", ROWS) == []
+    assert filter_rows("rent OR (bus food)", ROWS) == [ROWS[2]]
+
+
+def test_double_not():
+    assert filter_rows("NOT NOT rent", ROWS) == [ROWS[2]]
+
+
+def test_not_applies_to_parenthesized_group():
+    assert filter_rows("NOT (food OR rent)", ROWS) == [ROWS[3]]
+
+
+def test_not_is_uppercase_only_so_lowercase_is_a_term():
+    assert filter_rows("not", [_e("food", "not here")]) == [_e("food", "not here")]
+    assert filter_rows("not", [_e("food")]) == []
+
+
+def test_operator_words_as_terms_inside_quotes():
+    rows = [_e("food", "AND OR")]
+    assert filter_rows('"AND"', rows) == rows
+
+
+def test_filter_rows_keeps_input_order_and_returns_new_list():
+    rows = [_e("b", "x"), _e("a", "x"), _e("c", "x")]
+    out = filter_rows("x", rows)
+    assert out == rows
+    assert out is not rows
+
+
+def test_filter_rows_empty_input_still_is_valid():
+    assert filter_rows("food", []) == []
+
+
+def test_filter_rows_empty_input_with_bad_query_raises():
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
+    with pytest.raises(QueryError):
+        filter_rows("", [])
+
+
+def test_filter_rows_bad_query_raises_with_rows():
+    with pytest.raises(QueryError):
+        filter_rows("food OR", ROWS)
+
+
+def test_empty_memo_matches_only_by_category():
+    assert matches("rent", _e("rent", ""))
+    assert not matches("x", _e("rent", ""))
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..66a8cb6
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,205 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def e(day: date, category: str = "通信", amount: int = 1000, memo: str = "") -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# add_month
+
+
+def test_add_month_normal() -> None:
+    assert add_month(date(2026, 3, 10)) == date(2026, 4, 10)
+
+
+def test_add_month_year_rollover() -> None:
+    assert add_month(date(2026, 12, 15)) == date(2027, 1, 15)
+
+
+def test_add_month_clamps_to_end_of_short_month() -> None:
+    assert add_month(date(2026, 1, 31)) == date(2026, 2, 28)
+
+
+def test_add_month_clamps_to_leap_february() -> None:
+    assert add_month(date(2024, 1, 31)) == date(2024, 2, 29)
+
+
+def test_add_month_clamps_30_to_february_non_leap() -> None:
+    assert add_month(date(2026, 3, 30)) == date(2026, 4, 30)
+    assert add_month(date(2026, 1, 30)) == date(2026, 2, 28)
+
+
+# find_recurring: validation
+
+
+@pytest.mark.parametrize(
+    "kwargs", [{"min_count": 1}, {"min_count": 0}, {"tolerance": -1}]
+)
+def test_invalid_arguments_raise(kwargs: dict[str, int]) -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], **kwargs)
+
+
+def test_min_count_two_and_tolerance_zero_are_allowed() -> None:
+    assert find_recurring([], min_count=2, tolerance=0) == []
+
+
+# find_recurring: basics
+
+
+def test_empty_input_returns_empty() -> None:
+    assert find_recurring([]) == []
+
+
+def test_monthly_series_detected() -> None:
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 5)), e(date(2026, 3, 5))]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="通信",
+            amount=1000,
+            days=(date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+            next_expected=date(2026, 4, 5),
+        )
+    ]
+
+
+def test_below_min_count_not_reported() -> None:
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 5))]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_count=2)) == 1
+
+
+def test_memo_is_ignored_for_grouping() -> None:
+    rows = [
+        e(date(2026, 1, 5), memo="a"),
+        e(date(2026, 2, 5), memo="b"),
+        e(date(2026, 3, 5), memo=""),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_different_amount_or_category_grouped_separately() -> None:
+    rows = [
+        e(date(2026, 1, 5), amount=1000),
+        e(date(2026, 2, 5), amount=1000),
+        e(date(2026, 3, 5), amount=1001),
+        e(date(2026, 4, 5), amount=1001),
+        e(date(2026, 5, 5), amount=1001),
+        e(date(2026, 1, 6), category="食費", amount=1000),
+    ]
+    result = find_recurring(rows, min_count=3)
+    assert [(r.category, r.amount) for r in result] == [("通信", 1001)]
+
+
+def test_same_day_duplicates_are_removed() -> None:
+    rows = [
+        e(date(2026, 1, 5)),
+        e(date(2026, 1, 5)),
+        e(date(2026, 2, 5)),
+        e(date(2026, 3, 5)),
+    ]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_duplicates_alone_do_not_meet_min_count() -> None:
+    rows = [e(date(2026, 1, 5)), e(date(2026, 1, 5)), e(date(2026, 1, 5))]
+    assert find_recurring(rows) == []
+
+
+def test_input_order_does_not_matter() -> None:
+    rows = [e(date(2026, 3, 5)), e(date(2026, 1, 5)), e(date(2026, 2, 5))]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+# find_recurring: tolerance and month-end
+
+
+def test_within_tolerance_is_connected() -> None:
+    # expected 2026-02-05; actual 2026-02-08 is 3 days later (<= 3)
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 8)), e(date(2026, 3, 5))]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_beyond_tolerance_splits_series() -> None:
+    # expected 2026-02-05; actual 2026-02-09 is 4 days later (> 3)
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 9)), e(date(2026, 3, 9))]
+    assert find_recurring(rows) == []
+
+
+def test_early_payment_within_tolerance_connects() -> None:
+    # expected 2026-02-05; actual 2026-02-02 is 3 days earlier (abs <= 3)
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 2)), e(date(2026, 3, 2))]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_tolerance_zero_requires_exact_day() -> None:
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 6)), e(date(2026, 3, 5))]
+    assert find_recurring(rows, tolerance=0) == []
+    assert len(find_recurring(rows, tolerance=1)) == 1
+
+
+def test_month_end_series_connects_via_clamped_date() -> None:
+    rows = [e(date(2026, 1, 31)), e(date(2026, 2, 28)), e(date(2026, 3, 31))]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 30)
+
+
+def test_split_series_only_long_runs_reported() -> None:
+    # run A: Jan-Mar (3 items); gap; run B: Jul-Aug (2 items, below min_count)
+    rows = [
+        e(date(2026, 1, 5)),
+        e(date(2026, 2, 5)),
+        e(date(2026, 3, 5)),
+        e(date(2026, 7, 5)),
+        e(date(2026, 8, 5)),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+    assert result[0].next_expected == date(2026, 4, 5)
+
+
+def test_two_long_runs_split_into_two_results() -> None:
+    rows = [
+        e(date(2026, 1, 5)),
+        e(date(2026, 2, 5)),
+        e(date(2026, 3, 5)),
+        e(date(2026, 8, 5)),
+        e(date(2026, 9, 5)),
+        e(date(2026, 10, 5)),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 5), date(2026, 8, 5)]
+
+
+# find_recurring: ordering
+
+
+def test_result_sorted_by_category_amount_then_first_day() -> None:
+    rows = [
+        e(date(2026, 1, 5), category="通信", amount=500),
+        e(date(2026, 2, 5), category="通信", amount=500),
+        e(date(2026, 3, 5), category="通信", amount=500),
+        e(date(2026, 1, 1), category="家賃", amount=900),
+        e(date(2026, 2, 1), category="家賃", amount=900),
+        e(date(2026, 3, 1), category="家賃", amount=900),
+        e(date(2026, 1, 2), category="家賃", amount=100),
+        e(date(2026, 2, 2), category="家賃", amount=100),
+        e(date(2026, 3, 2), category="家賃", amount=100),
+    ]
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [
+        ("家賃", 100),
+        ("家賃", 900),
+        ("通信", 500),
+    ]
