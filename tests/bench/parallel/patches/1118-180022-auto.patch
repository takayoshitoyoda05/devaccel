+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.streak import longest_no_spend_streak
+
+
+def _e(day: date, amount: int = 100) -> Expense:
+    return Expense(day=day, category="food", amount=amount)
+
+
+def test_no_rows_returns_whole_period_length() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 1), date(2026, 1, 10)) == 10
+
+
+def test_single_day_without_spend_is_one() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 5), date(2026, 1, 5)) == 1
+
+
+def test_single_day_with_spend_is_zero() -> None:
+    rows = [_e(date(2026, 1, 5))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 5), date(2026, 1, 5)) == 0
+
+
+def test_spend_splits_streak_and_longest_is_chosen() -> None:
+    # 1/1 空, 1/2 空, 1/3 支出, 1/4 空, 1/5 空, 1/6 空, 1/7 支出, 1/8 空
+    rows = [_e(date(2026, 1, 3)), _e(date(2026, 1, 7))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 8)) == 3
+
+
+def test_spend_on_start_day_excluded_from_streak() -> None:
+    rows = [_e(date(2026, 1, 1))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 4)) == 3
+
+
+def test_spend_on_end_day_excluded_from_streak() -> None:
+    rows = [_e(date(2026, 1, 4))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 4)) == 3
+
+
+def test_every_day_has_spend_returns_zero() -> None:
+    rows = [_e(date(2026, 1, d)) for d in range(1, 4)]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 3)) == 0
+
+
+def test_rows_outside_period_are_ignored() -> None:
+    rows = [_e(date(2025, 12, 31)), _e(date(2026, 1, 11))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 10)) == 10
+
+
+def test_multiple_rows_same_day_count_as_one_spend_day() -> None:
+    rows = [
+        _e(date(2026, 1, 2), 100),
+        _e(date(2026, 1, 2), 200),
+        _e(date(2026, 1, 2), 300),
+    ]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 4)) == 2
+
+
+def test_zero_amount_row_still_counts_as_spend_day() -> None:
+    rows = [_e(date(2026, 1, 2), 0)]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 3)) == 1
+
+
+def test_start_after_end_returns_zero() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 10), date(2026, 1, 1)) == 0
diff --git a/tests/test_topn.py b/tests/test_topn.py
new file mode 100644
index 0000000..c9932bf
--- /dev/null
+++ b/tests/test_topn.py
@@ -0,0 +1,63 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.topn import top_expenses
+
+
+def e(day: str, amount: int, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category="food", amount=amount, memo=memo
+    )
+
+
+def test_empty_input_returns_empty() -> None:
+    assert top_expenses([], 3) == []
+
+
+def test_orders_by_amount_desc() -> None:
+    rows = [e("2026-01-01", 100), e("2026-01-02", 300), e("2026-01-03", 200)]
+    assert [x.amount for x in top_expenses(rows, 3)] == [300, 200, 100]
+
+
+def test_takes_only_n_items() -> None:
+    rows = [e("2026-01-01", 100), e("2026-01-02", 300), e("2026-01-03", 200)]
+    assert [x.amount for x in top_expenses(rows, 2)] == [300, 200]
+
+
+def test_n_larger_than_input_returns_all() -> None:
+    rows = [e("2026-01-01", 100), e("2026-01-02", 300)]
+    assert [x.amount for x in top_expenses(rows, 10)] == [300, 100]
+
+
+def test_n_zero_returns_empty() -> None:
+    rows = [e("2026-01-01", 100)]
+    assert top_expenses(rows, 0) == []
+
+
+def test_negative_n_returns_empty() -> None:
+    rows = [e("2026-01-01", 100)]
+    assert top_expenses(rows, -1) == []
+
+
+def test_equal_amounts_ordered_by_earlier_date() -> None:
+    rows = [e("2026-03-01", 500), e("2026-01-15", 500), e("2026-02-10", 500)]
+    assert [x.day for x in top_expenses(rows, 3)] == [
+        date(2026, 1, 15),
+        date(2026, 2, 10),
+        date(2026, 3, 1),
+    ]
+
+
+def test_equal_amount_and_date_keeps_input_order() -> None:
+    a = e("2026-01-01", 500, "first")
+    b = e("2026-01-01", 500, "second")
+    c = e("2026-01-01", 500, "third")
+    assert top_expenses([a, b, c], 3) == [a, b, c]
+    assert top_expenses([c, a, b], 3) == [c, a, b]
+
+
+def test_does_not_mutate_input() -> None:
+    rows = [e("2026-01-01", 100), e("2026-01-02", 300)]
+    snapshot = list(rows)
+    top_expenses(rows, 1)
+    assert rows == snapshot
diff --git a/tests/test_weekday.py b/tests/test_weekday.py
new file mode 100644
index 0000000..93aa0e9
--- /dev/null
+++ b/tests/test_weekday.py
@@ -0,0 +1,59 @@
+from datetime import date, timedelta
+
+from kakeibo.core import Expense
+from kakeibo.weekday import total_by_weekday
+
+# 2026-11-16 is a Monday.
+MON = date(2026, 11, 16)
+TUE = date(2026, 11, 17)
+WED = date(2026, 11, 18)
+FRI = date(2026, 11, 20)
+SAT = date(2026, 11, 21)
+SUN = date(2026, 11, 22)
+
+
+def _e(day: date, amount: int) -> Expense:
+    return Expense(day=day, category="food", amount=amount)
+
+
+def test_empty_rows_gives_empty_dict() -> None:
+    assert total_by_weekday([]) == {}
+
+
+def test_single_row_maps_to_its_weekday() -> None:
+    assert total_by_weekday([_e(MON, 100)]) == {"Mon": 100}
+
+
+def test_same_weekday_amounts_are_summed_across_weeks() -> None:
+    rows = [_e(MON, 100), _e(MON + timedelta(days=7), 250), _e(MON, 50)]
+    assert total_by_weekday(rows) == {"Mon": 400}
+
+
+def test_weekdays_without_rows_are_omitted() -> None:
+    rows = [_e(FRI, 300), _e(MON, 100)]
+    assert list(total_by_weekday(rows)) == ["Mon", "Fri"]
+    assert total_by_weekday(rows) == {"Mon": 100, "Fri": 300}
+
+
+def test_keys_are_in_monday_first_order_regardless_of_input_order() -> None:
+    rows = [_e(SUN, 7), _e(WED, 3), _e(MON, 1), _e(SAT, 6), _e(TUE, 2)]
+    result = total_by_weekday(rows)
+    assert list(result) == ["Mon", "Tue", "Wed", "Sat", "Sun"]
+    assert result == {"Mon": 1, "Tue": 2, "Wed": 3, "Sat": 6, "Sun": 7}
+
+
+def test_all_seven_weekdays_present() -> None:
+    rows = [_e(MON + timedelta(days=i), (i + 1) * 10) for i in range(7)]
+    assert total_by_weekday(rows) == {
+        "Mon": 10,
+        "Tue": 20,
+        "Wed": 30,
+        "Thu": 40,
+        "Fri": 50,
+        "Sat": 60,
+        "Sun": 70,
+    }
+
+
+def test_zero_amount_row_still_counts_its_weekday() -> None:
+    assert total_by_weekday([_e(MON, 0)]) == {"Mon": 0}
