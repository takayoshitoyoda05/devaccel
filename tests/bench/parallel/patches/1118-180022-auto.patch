@@ -0,0 +1,16 @@
+"""Split an amount in yen evenly among people."""
+
+from __future__ import annotations
+
+
+def split_evenly(amount: int, people: int) -> list[int]:
+    """Split ``amount`` yen among ``people``.
+
+    Each person gets ``amount // people``; the remainder is handed out one yen
+    at a time starting from the first person. The result always sums to
+    ``amount``.
+    """
+    if people < 1:
+        raise ValueError(f"人数は 1 以上である必要があります: {people}")
+    base, remainder = divmod(amount, people)
+    return [base + 1 if i < remainder else base for i in range(people)]
diff --git a/src/kakeibo/stats.py b/src/kakeibo/stats.py
