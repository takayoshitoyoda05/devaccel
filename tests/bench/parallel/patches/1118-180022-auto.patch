@@ -0,0 +1,42 @@
+import pytest
+
+from kakeibo.split import split_evenly
+
+
+def test_exact_division() -> None:
+    assert split_evenly(10, 5) == [2, 2, 2, 2, 2]
+
+
+def test_remainder_goes_to_first_people_one_yen_each() -> None:
+    assert split_evenly(10, 3) == [4, 3, 3]
+
+
+def test_remainder_of_two_goes_to_first_two() -> None:
+    assert split_evenly(11, 4) == [3, 3, 3, 2]
+
+
+def test_single_person_gets_whole_amount() -> None:
+    assert split_evenly(1234, 1) == [1234]
+
+
+def test_zero_amount() -> None:
+    assert split_evenly(0, 3) == [0, 0, 0]
+
+
+def test_amount_smaller_than_people() -> None:
+    assert split_evenly(2, 5) == [1, 1, 0, 0, 0]
+
+
+def test_sum_and_length_always_match() -> None:
+    for amount in range(50):
+        for people in range(1, 9):
+            parts = split_evenly(amount, people)
+            assert len(parts) == people
+            assert sum(parts) == amount
+            assert max(parts) - min(parts) <= 1
+
+
+@pytest.mark.parametrize("people", [0, -1])
+def test_people_below_one_raises(people: int) -> None:
+    with pytest.raises(ValueError):
+        split_evenly(100, people)
