+"""Month-over-month category comparison (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"([0-9]{4})-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryDiff:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    rate: float | None
+    trend: str
+
+
+def _previous_month(month: str) -> str:
+    year, mon = int(month[:4]), int(month[5:7])
+    if mon == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mon - 1:02d}"
+
+
+def _totals_for(expenses: list[Expense], month: str) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for e in expenses:
+        if e.day.strftime("%Y-%m") == month:
+            out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def _trend(delta: int) -> str:
+    if delta > 0:
+        return "増"
+    if delta < 0:
+        return "減"
+    return "変わらず"
+
+
+def compare_months(expenses: list[Expense], month: str) -> list[CategoryDiff]:
+    if not isinstance(month, str) or not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"month は YYYY-MM 形式である必要があります: {month!r}")
+    prev_month = _previous_month(month)
+    prev = _totals_for(expenses, prev_month)
+    curr = _totals_for(expenses, month)
+
+    diffs: list[CategoryDiff] = []
+    for cat in set(prev) | set(curr):
+        previous = prev.get(cat, 0)
+        current = curr.get(cat, 0)
+        delta = current - previous
+        rate = None if previous == 0 else delta / previous
+        diffs.append(
+            CategoryDiff(
+                category=cat,
+                previous=previous,
+                current=current,
+                delta=delta,
+                rate=rate,
+                trend=_trend(delta),
+            )
+        )
+    diffs.sort(key=lambda d: (-abs(d.delta), d.category))
+    return diffs
