+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthly_diff import CategoryDiff, compare_months
+
+
+def exp(day: date, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(day, category, amount, memo)
+
+
+# 例の表 E4-1 / E4-2 / E4-3 (ID をそのまま pytest の id に使う)
+
+
+@pytest.mark.parametrize(
+    ("expenses", "month", "expected"),
+    [
+        pytest.param(
+            [exp(date(2026, 2, 3), "食費", 3000)],
+            "2026-02",
+            [CategoryDiff("食費", 0, 3000, 3000, None, "増")],
+            id="E4-1",
+        ),
+        pytest.param(
+            [exp(date(2025, 12, 20), "交通", 1000)],
+            "2026-01",
+            [CategoryDiff("交通", 1000, 0, -1000, -1.0, "減")],
+            id="E4-2",
+        ),
+    ],
+)
+def test_example_rows(expenses, month, expected):
+    assert compare_months(expenses, month) == expected
+
+
+@pytest.mark.parametrize(
+    "month",
+    [
+        pytest.param("2026/01", id="E4-3"),
+    ],
+)
+def test_invalid_month_raises(month):
+    with pytest.raises(ValueError):
+        compare_months([], month)
+
+
+# R1: month は YYYY-MM。不正は ValueError。
+
+
+@pytest.mark.parametrize(
+    "month",
+    ["2026-1", "26-01", "2026-13", "202601", "2026-01-01", ""],
+    ids=["short-month", "short-year", "month-13", "no-hyphen", "with-day", "empty"],
+)
+def test_r1_malformed_month_raises(month):
+    with pytest.raises(ValueError):
+        compare_months([], month)
+
+
+def test_r1_previous_month_of_february_is_january():
+    expenses = [
+        exp(date(2026, 1, 10), "食費", 2000),
+        exp(date(2026, 2, 10), "食費", 2500),
+    ]
+    result = compare_months(expenses, "2026-02")
+    assert result == [CategoryDiff("食費", 2000, 2500, 500, 0.25, "増")]
+
+
+# R1: 各月はカテゴリ別の合計。負の返金も合算する。
+
+
+def test_r1_refunds_are_summed_into_month_total():
+    expenses = [
+        exp(date(2026, 1, 5), "食費", 4000),
+        exp(date(2026, 1, 9), "食費", -500),
+        exp(date(2026, 2, 5), "食費", 3000),
+    ]
+    result = compare_months(expenses, "2026-02")
+    # 前月 4000 - 500 = 3500、今月 3000
+    assert result == [CategoryDiff("食費", 3500, 3000, -500, -500 / 3500, "減")]
+
+
+# R2: delta = current - previous, rate = delta / previous (D6), trend.
+
+
+def test_r2_trend_unchanged_when_delta_is_zero():
+    expenses = [
+        exp(date(2026, 1, 5), "食費", 1200),
+        exp(date(2026, 2, 5), "食費", 1200),
+    ]
+    result = compare_months(expenses, "2026-02")
+    assert result == [CategoryDiff("食費", 1200, 1200, 0, 0.0, "変わらず")]
+
+
+def test_r2_rate_is_delta_over_previous():
+    expenses = [
+        exp(date(2026, 1, 5), "娯楽", 4000),
+        exp(date(2026, 2, 5), "娯楽", 5000),
+    ]
+    result = compare_months(expenses, "2026-02")
+    assert result == [CategoryDiff("娯楽", 4000, 5000, 1000, 0.25, "増")]
+
+
+# R3: 並びは delta の絶対値の降順、同点は category 昇順。
+
+
+def test_r3_sorted_by_absolute_delta_descending():
+    expenses = [
+        exp(date(2026, 1, 1), "A", 100),
+        exp(date(2026, 2, 1), "A", 150),  # delta +50
+        exp(date(2026, 1, 1), "B", 1000),
+        exp(date(2026, 2, 1), "B", 700),  # delta -300
+        exp(date(2026, 1, 1), "C", 500),
+        exp(date(2026, 2, 1), "C", 500),  # delta 0
+    ]
+    result = compare_months(expenses, "2026-02")
+    assert [r.category for r in result] == ["B", "A", "C"]
+
+
+def test_r3_ties_on_abs_delta_are_ordered_by_category():
+    expenses = [
+        exp(date(2026, 1, 1), "Z", 1000),
+        exp(date(2026, 2, 1), "Z", 1200),  # delta +200
+        exp(date(2026, 1, 1), "M", 1000),
+        exp(date(2026, 2, 1), "M", 800),  # delta -200 (同じ絶対値)
+    ]
+    result = compare_months(expenses, "2026-02")
+    assert [r.category for r in result] == ["M", "Z"]
+
+
+# R4: 両月とも明細が無ければ空リスト。
+
+
+def test_r4_no_expenses_in_either_month_returns_empty_list():
+    expenses = [
+        exp(date(2025, 6, 1), "食費", 1000),
+        exp(date(2026, 4, 1), "食費", 1000),
+    ]
+    assert compare_months(expenses, "2026-02") == []
+
+
+def test_r4_empty_input_returns_empty_list():
+    assert compare_months([], "2026-02") == []
