@@ -0,0 +1,67 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import add_months, find_recurring, next_due
+
+
+def test_E2_1_rent_on_month_end_clamps_next_due() -> None:
+    # E2-1: 家賃 80000 が 1/31, 2/28, 3/31 → day_of_month=31, next_date=2026-04-30
+    rows = [
+        Expense(date(2026, 1, 31), "住居", 80000, "家賃"),
+        Expense(date(2026, 2, 28), "住居", 80000, "家賃"),
+        Expense(date(2026, 3, 31), "住居", 80000, "家賃"),
+    ]
+    [rec] = find_recurring(rows)
+    assert rec.day_of_month == 31
+    assert rec.next_date == date(2026, 4, 30)
+    assert next_due(rec) == date(2026, 4, 30)
+
+
+def test_E2_2_same_subscription_with_numbered_memos_is_one_series() -> None:
+    # E2-2: 動画 `Netflix #1` `Netflix #2` `Netflix #3` が毎月 5 日・1490 → 系列 1 つ(memo_key="netflix")
+    rows = [
+        Expense(date(2026, 1, 5), "動画", 1490, "Netflix #1"),
+        Expense(date(2026, 2, 5), "動画", 1490, "Netflix #2"),
+        Expense(date(2026, 3, 5), "動画", 1490, "Netflix #3"),
+    ]
+    [rec] = find_recurring(rows)
+    assert rec.memo_key == "netflix"
+    assert rec.months == ("2026-01", "2026-02", "2026-03")
+
+
+def test_E2_3_gap_of_two_months_is_not_recurring() -> None:
+    # E2-3: 1 月と 3 月だけに同じ支出 → [](min_months=3 に足りない)
+    rows = [
+        Expense(date(2026, 1, 10), "雑費", 500, "文具"),
+        Expense(date(2026, 3, 10), "雑費", 500, "文具"),
+    ]
+    assert find_recurring(rows, min_months=3) == []
+
+
+def test_find_recurring_rejects_min_months_below_two() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_months=1)
+
+
+def test_find_recurring_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+@pytest.mark.parametrize(
+    ("start", "n", "day", "expected"),
+    [
+        (date(2026, 1, 31), 1, None, date(2026, 2, 28)),
+        (date(2028, 1, 31), 1, None, date(2028, 2, 29)),
+        (date(2026, 12, 5), 1, None, date(2027, 1, 5)),
+        (date(2026, 1, 5), -1, None, date(2025, 12, 5)),
+        (date(2026, 1, 1), 2, 31, date(2026, 3, 31)),
+    ],
+)
+def test_add_months_clamps_to_month_end(
+    start: date, n: int, day: int | None, expected: date
+) -> None:
+    assert add_months(start, n, day) == expected
diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..d219e4e
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,262 @@
+from __future__ import annotations
+
+from datetime import date, datetime
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    all_of,
+    amount_between,
+    any_of,
+    build_query,
+    category_is,
+    date_between,
+    memo_contains,
+    not_,
+    search,
+)
+
+
+def ex(
+    day: date = date(2026, 1, 5),
+    category: str = "食費",
+    amount: int = 500,
+    memo: str = "",
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- 例の表 (E3) ---
+
+
+@pytest.mark.parametrize(
+    ("spec", "row", "expected"),
+    [
+        # E3-1: OR の中の memo は NFKC・大文字小文字を区別せず部分一致
+        (
+            {"or": [{"category": "食費"}, {"memo": "ｎｅｔｆｌｉｘ"}]},
+            ex(category="交通費", memo="Netflix"),
+            True,
+        ),
+        # E3-2: 下限と上限が同じ値なら端を含む
+        ({"amount_min": 1000, "amount_max": 1000}, ex(amount=1000), True),
+    ],
+    ids=["E3-1", "E3-2"],
+)
+def test_example_table_matches(
+    spec: dict[str, object], row: Expense, expected: bool
+) -> None:
+    assert build_query(spec)(row) is expected
+
+
+def test_E3_2_amount_between_inclusive_ends() -> None:
+    assert amount_between(1000, 1000)(ex(amount=1000)) is True
+
+
+@pytest.mark.parametrize(
+    "spec",
+    [{"amount": 5}],
+    ids=["E3-3"],
+)
+def test_example_table_error(spec: dict[str, object]) -> None:
+    with pytest.raises(ValueError, match="amount"):
+        build_query(spec)
+
+
+# --- R1 category_is ---
+
+
+def test_category_is_exact_match_ignores_outer_space_and_case_and_nfkc() -> None:
+    pred = category_is("Food")
+    assert pred(ex(category=" ｆｏｏｄ ")) is True
+    assert pred(ex(category="food pantry")) is False  # 部分一致ではない
+
+
+def test_category_is_multiple_names_is_or() -> None:
+    pred = category_is("食費", "交通費")
+    assert pred(ex(category="交通費")) is True
+    assert pred(ex(category="娯楽")) is False
+
+
+def test_category_is_requires_at_least_one_name() -> None:
+    with pytest.raises(ValueError):
+        category_is()
+
+
+# --- R2 amount_between ---
+
+
+def test_amount_between_both_none_is_always_true() -> None:
+    pred = amount_between()
+    assert pred(ex(amount=-300)) is True
+    assert pred(ex(amount=0)) is True
+
+
+def test_amount_between_only_low_or_only_high() -> None:
+    assert amount_between(low=100)(ex(amount=100)) is True
+    assert amount_between(low=100)(ex(amount=99)) is False
+    assert amount_between(high=100)(ex(amount=100)) is True
+    assert amount_between(high=100)(ex(amount=101)) is False
+
+
+def test_amount_between_low_greater_than_high_raises() -> None:
+    with pytest.raises(ValueError):
+        amount_between(1001, 1000)
+
+
+def test_amount_between_compares_negative_refunds() -> None:
+    pred = amount_between(-500, -100)
+    assert pred(ex(amount=-200)) is True
+    assert pred(ex(amount=-50)) is False
+
+
+# --- R3 memo_contains ---
+
+
+@pytest.mark.parametrize(
+    ("text", "memo", "expected"),
+    [
+        ("net", "Netflix", True),
+        ("NETFLIX", "netflix", True),
+        ("ｎｅｔ", "Netflix", True),
+        ("", "anything", True),
+        ("x", "", False),
+    ],
+)
+def test_memo_contains(text: str, memo: str, expected: bool) -> None:
+    assert memo_contains(text)(ex(memo=memo)) is expected
+
+
+# --- R4 date_between ---
+
+
+def test_date_between_inclusive_ends() -> None:
+    pred = date_between(date(2026, 1, 1), date(2026, 1, 31))
+    assert pred(ex(day=date(2026, 1, 1))) is True
+    assert pred(ex(day=date(2026, 1, 31))) is True
+    assert pred(ex(day=date(2025, 12, 31))) is False
+    assert pred(ex(day=date(2026, 2, 1))) is False
+
+
+def test_date_between_none_is_unbounded() -> None:
+    assert date_between()(ex(day=date(1900, 1, 1))) is True
+    assert date_between(start=date(2026, 1, 1))(ex(day=date(2999, 1, 1))) is True
+    assert date_between(end=date(2026, 1, 1))(ex(day=date(1900, 1, 1))) is True
+
+
+def test_date_between_start_after_end_raises() -> None:
+    with pytest.raises(ValueError):
+        date_between(date(2026, 2, 1), date(2026, 1, 1))
+
+
+# --- combinators ---
+
+
+def test_all_of_empty_is_true_and_any_of_empty_is_false() -> None:
+    assert all_of()(ex()) is True
+    assert any_of()(ex()) is False
+
+
+def test_all_of_and_any_of_and_not() -> None:
+    row = ex(category="食費", amount=500)
+    assert all_of(category_is("食費"), amount_between(500, 500))(row) is True
+    assert all_of(category_is("食費"), amount_between(501, None))(row) is False
+    assert any_of(category_is("娯楽"), amount_between(500, 500))(row) is True
+    assert not_(category_is("食費"))(row) is False
+
+
+# --- R5 search ---
+
+
+def test_search_none_returns_copy_of_all_rows_in_order() -> None:
+    rows = [ex(amount=3), ex(amount=1), ex(amount=2)]
+    out = search(rows)
+    assert out == rows
+    assert out is not rows
+
+
+def test_search_filters_keeping_order_and_does_not_mutate_input() -> None:
+    rows = [ex(amount=3), ex(amount=1), ex(amount=2)]
+    snapshot = list(rows)
+    out = search(rows, amount_between(low=2))
+    assert [e.amount for e in out] == [3, 2]
+    assert rows == snapshot
+
+
+# --- R6 build_query ---
+
+
+def test_build_query_empty_dict_is_always_true() -> None:
+    assert build_query({})(ex()) is True
+
+
+def test_build_query_multiple_keys_are_and() -> None:
+    pred = build_query({"category": "食費", "amount_max": 100})
+    assert pred(ex(category="食費", amount=100)) is True
+    assert pred(ex(category="食費", amount=101)) is False
+    assert pred(ex(category="交通費", amount=50)) is False
+
+
+def test_build_query_category_list_is_or() -> None:
+    pred = build_query({"category": ["食費", "交通費"]})
+    assert pred(ex(category="交通費")) is True
+    assert pred(ex(category="娯楽")) is False
+
+
+def test_build_query_empty_category_list_raises() -> None:
+    with pytest.raises(ValueError, match="category"):
+        build_query({"category": []})
+
+
+def test_build_query_date_strings_and_date_objects() -> None:
+    pred = build_query({"date_from": "2026-01-05", "date_to": date(2026, 1, 10)})
+    assert pred(ex(day=date(2026, 1, 5))) is True
+    assert pred(ex(day=date(2026, 1, 10))) is True
+    assert pred(ex(day=date(2026, 1, 4))) is False
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["2026/01/05", "20260105", "2026-1-5", "2026-02-30", datetime(2026, 1, 5)],
+)
+def test_build_query_rejects_bad_dates(value: object) -> None:
+    with pytest.raises(ValueError, match="date_from"):
+        build_query({"date_from": value})
+
+
+def test_build_query_and_or_not_nesting() -> None:
+    pred = build_query({"not": {"or": [{"memo": "x"}, {"and": []}]}})
+    # {"and": []} は常に真なので or は真、not で偽になる
+    assert pred(ex(memo="abc")) is False
+    # 空の and は真、空の or は偽 → 全体は偽
+    assert build_query({"and": [], "or": []})(ex()) is False
+
+
+@pytest.mark.parametrize(
+    "spec",
+    [
+        {"amount_min": True},
+        {"amount_max": "100"},
+        {"category": 1},
+        {"category": ["食費", 2]},
+        {"memo": None},
+        {"and": {"memo": "x"}},
+        {"or": ["not a mapping"]},
+        {"not": [{"memo": "x"}]},
+        {"date_to": 20260105},
+    ],
+)
+def test_build_query_type_mismatch_raises(spec: dict[str, object]) -> None:
+    with pytest.raises(ValueError):
+        build_query(spec)
+
+
+def test_build_query_unknown_key_names_key() -> None:
+    with pytest.raises(ValueError, match="bogus"):
+        build_query({"bogus": 1})
+
+
+def test_build_query_nested_unknown_key_raises() -> None:
+    with pytest.raises(ValueError, match="amount"):
+        build_query({"or": [{"amount": 5}]})
