+from __future__ import annotations
+
+from datetime import date
+
+from kakeibo.bank_import import import_bank_csv, parse_yen
+from kakeibo.core import Expense
+
+
+def test_E1_1_parse_yen_fullwidth_triangle_minus_with_yen_suffix() -> None:
+    # E1-1: parse_yen("▲1，５００円") == -1500 (R4)
+    assert parse_yen("▲1，５００円") == -1500
+
+
+def test_E1_2_bank_csv_slash_date_quoted_amount_default_category() -> None:
+    # E1-2: 日付形式 2026/1/5、引用符付き金額、カテゴリ列なしで既定カテゴリ (R2 R4)
+    text = '利用日,ご利用店名,ご利用金額\n2026/1/5,ネットフリックス,"1,490"\n'
+    result = import_bank_csv(text)
+    assert result.expenses == [
+        Expense(
+            day=date(2026, 1, 5),
+            category="未分類",
+            amount=1490,
+            memo="ネットフリックス",
+        )
+    ]
+    assert result.errors == []
+
+
+def test_E1_3_bank_csv_income_only_row_is_skipped() -> None:
+    # E1-3: 出金が空で入金だけの行は取り込まず skipped に数える (R3)
+    text = "日付,出金額,入金額,摘要\n2026-01-05,,50000,給与\n"
+    result = import_bank_csv(text)
+    assert result.expenses == []
+    assert result.skipped == 1
diff --git a/tests/test_month_compare.py b/tests/test_month_compare.py
new file mode 100644
index 0000000..838fe1b
--- /dev/null
+++ b/tests/test_month_compare.py
@@ -0,0 +1,193 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.month_compare import (
+    CategoryChange,
+    compare_months,
+    format_report,
+    previous_month,
+)
+
+
+def ex(day: str, category: str, amount: int) -> Expense:
+    y, m, d = (int(x) for x in day.split("-"))
+    return Expense(date(y, m, d), category, amount)
+
+
+# E4-3
+def test_E4_3_previous_month_of_january_wraps_to_december() -> None:
+    assert previous_month("2026-01") == "2025-12"
+
+
+@pytest.mark.parametrize(
+    "bad",
+    ["2026-1", "2026/01", "2026-13"],
+    ids=["R1-bad-1", "R1-bad-2", "R1-bad-3"],
+)
+def test_previous_month_rejects_bad_format(bad: str) -> None:
+    with pytest.raises(ValueError):
+        previous_month(bad)
+
+
+def test_R1_previous_month_regular() -> None:
+    assert previous_month("2026-03") == "2026-02"
+
+
+def test_R1_compare_rejects_bad_month() -> None:
+    with pytest.raises(ValueError):
+        compare_months([], "2026-1")
+
+
+def test_R1_compare_rejects_bad_previous() -> None:
+    with pytest.raises(ValueError):
+        compare_months([], "2026-02", "2026/01")
+
+
+# E4-1
+def test_E4_1_increase_percent_and_status() -> None:
+    rows = [ex("2025-12-10", "食費", 10000), ex("2026-01-10", "食費", 12500)]
+    (c,) = compare_months(rows, "2026-01")
+    assert c == CategoryChange(
+        category="食費",
+        previous=10000,
+        current=12500,
+        delta=2500,
+        percent=25.0,
+        status="increased",
+    )
+
+
+# E4-2
+def test_E4_2_gone_category() -> None:
+    rows = [ex("2025-12-10", "交通費", 3000)]
+    (c,) = compare_months(rows, "2026-01")
+    assert c.previous == 3000
+    assert c.current == 0
+    assert c.delta == -3000
+    assert c.percent == -100.0
+    assert c.status == "gone"
+
+
+def test_R2_new_category_has_no_percent() -> None:
+    rows = [ex("2026-01-02", "娯楽", 4000)]
+    (c,) = compare_months(rows, "2026-01")
+    assert (c.previous, c.current, c.delta) == (0, 4000, 4000)
+    assert c.percent is None
+    assert c.status == "new"
+
+
+def test_R2_unchanged_same_amount() -> None:
+    rows = [ex("2025-12-01", "食費", 500), ex("2026-01-01", "食費", 500)]
+    (c,) = compare_months(rows, "2026-01")
+    assert c.delta == 0
+    assert c.percent == 0.0
+    assert c.status == "unchanged"
+
+
+def test_R2_decreased() -> None:
+    rows = [ex("2025-12-01", "食費", 2000), ex("2026-01-01", "食費", 1500)]
+    (c,) = compare_months(rows, "2026-01")
+    assert c.delta == -500
+    assert c.percent == -25.0
+    assert c.status == "decreased"
+
+
+def test_R2_refund_negative_amount_is_summed() -> None:
+    rows = [ex("2025-12-01", "食費", 3000), ex("2025-12-02", "食費", -1000)]
+    rows += [ex("2026-01-01", "食費", 2000)]
+    (c,) = compare_months(rows, "2026-01")
+    assert c.previous == 2000
+    assert c.current == 2000
+    assert c.status == "unchanged"
+
+
+def test_R2_previous_nonpositive_gives_none_percent() -> None:
+    rows = [ex("2025-12-01", "雑費", -500), ex("2026-01-01", "雑費", 1000)]
+    (c,) = compare_months(rows, "2026-01")
+    assert c.delta == 1500
+    assert c.percent is None
+    assert c.status == "increased"
+
+
+def test_R2_previous_zero_increase_has_no_percent() -> None:
+    rows = [ex("2025-12-01", "雑費", 0), ex("2026-01-01", "雑費", 1000)]
+    (c,) = compare_months(rows, "2026-01")
+    assert c.percent is None
+    assert c.status == "increased"
+
+
+def test_R3_percent_rounded_to_one_decimal() -> None:
+    rows = [ex("2025-12-01", "食費", 3), ex("2026-01-01", "食費", 4)]
+    (c,) = compare_months(rows, "2026-01")
+    assert c.percent == 33.3
+
+
+def test_R4_sorted_by_abs_delta_then_category() -> None:
+    rows = [
+        ex("2025-12-01", "b", 1000),
+        ex("2026-01-01", "b", 1000),  # delta 0
+        ex("2025-12-01", "a", 1000),
+        ex("2026-01-01", "a", 1000),  # delta 0
+        ex("2025-12-01", "c", 5000),
+        ex("2026-01-01", "c", 2000),  # delta -3000
+        ex("2026-01-01", "d", 3000),  # delta +3000 (new)
+    ]
+    changes = compare_months(rows, "2026-01")
+    assert [c.category for c in changes] == ["c", "d", "a", "b"]
+
+
+def test_R4_no_expenses_in_either_month_returns_empty() -> None:
+    rows = [ex("2026-03-01", "食費", 100)]
+    assert compare_months(rows, "2026-01") == []
+
+
+def test_R1_explicit_previous_is_used() -> None:
+    rows = [ex("2025-06-01", "食費", 1000), ex("2026-01-01", "食費", 1500)]
+    (c,) = compare_months(rows, "2026-01", "2025-06")
+    assert c.delta == 500
+    assert c.status == "increased"
+
+
+# format_report
+def test_R5_report_lines() -> None:
+    changes = [
+        CategoryChange("食費", 25000, 28000, 3000, 12.0, "increased"),
+        CategoryChange("交通費", 3000, 0, -3000, -100.0, "gone"),
+        CategoryChange("娯楽", 0, 4000, 4000, None, "new"),
+    ]
+    text = format_report(changes, "2026-01", "2025-12")
+    lines = text.split("\n")
+    assert lines[0] == "2026-01 vs 2025-12"
+    assert lines[1] == "食費  +3,000円 (+12.0%) 25,000円 -> 28,000円"
+    assert lines[2] == "交通費  -3,000円 (-100.0%) 3,000円 -> 0円 (なくなった)"
+    assert lines[3] == "娯楽  +4,000円 (n/a) 0円 -> 4,000円 (新規)"
+    assert lines[4] == "合計  +4,000円"
+
+
+def test_R5_unchanged_zero_delta_and_total() -> None:
+    changes = [CategoryChange("食費", 500, 500, 0, 0.0, "unchanged")]
+    lines = format_report(changes, "2026-01", "2025-12").split("\n")
+    assert lines[1] == "食費  ±0 (+0.0%) 500円 -> 500円"
+    assert lines[2] == "合計  ±0円"
+
+
+def test_R5_decreased_sign() -> None:
+    changes = [CategoryChange("食費", 2000, 1500, -500, -25.0, "decreased")]
+    lines = format_report(changes, "2026-01", "2025-12").split("\n")
+    assert lines[1] == "食費  -500円 (-25.0%) 2,000円 -> 1,500円"
+
+
+def test_R5_none_percent_shows_na() -> None:
+    changes = [CategoryChange("雑費", -500, 1000, 1500, None, "increased")]
+    lines = format_report(changes, "2026-01", "2025-12").split("\n")
+    assert lines[1] == "雑費  +1,500円 (n/a) -500円 -> 1,000円"
+
+
+def test_R5_empty_changes() -> None:
+    assert (
+        format_report([], "2026-01", "2025-12") == "2026-01 vs 2025-12 明細がありません"
+    )
