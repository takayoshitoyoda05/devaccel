--- /dev/null
+++ b/src/kakeibo/month_compare.py
@@ -0,0 +1,105 @@
+"""Category-wise comparison of two months (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    delta: int  # current - previous
+    percent: float | None  # delta / previous * 100; None when previous <= 0
+    status: str  # "increased" | "decreased" | "unchanged" | "new" | "gone"
+
+
+def _check_month(month: str) -> None:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def previous_month(month: str) -> str:
+    _check_month(month)
+    year, mon = (int(x) for x in month.split("-"))
+    if mon == 1:
+        return f"{year - 1}-12"
+    return f"{year}-{mon - 1:02d}"
+
+
+def _totals(rows: list[Expense], month: str) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for e in rows:
+        if e.day.strftime("%Y-%m") == month:
+            out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def compare_months(
+    rows: list[Expense], month: str, previous: str | None = None
+) -> list[CategoryChange]:
+    _check_month(month)
+    if previous is None:
+        previous = previous_month(month)
+    else:
+        _check_month(previous)
+
+    cur = _totals(rows, month)
+    prev = _totals(rows, previous)
+
+    changes: list[CategoryChange] = []
+    for cat in set(cur) | set(prev):
+        p = prev.get(cat, 0)
+        c = cur.get(cat, 0)
+        delta = c - p
+        if cat not in cur:
+            status = "gone"
+        elif cat not in prev:
+            status = "new"
+        elif delta == 0:
+            status = "unchanged"
+        elif delta > 0:
+            status = "increased"
+        else:
+            status = "decreased"
+        percent = None if p <= 0 else round(delta / p * 100, 1)
+        changes.append(CategoryChange(cat, p, c, delta, percent, status))
+
+    changes.sort(key=lambda ch: (-abs(ch.delta), ch.category))
+    return changes
+
+
+def _signed_yen(n: int) -> str:
+    if n == 0:
+        return "±0"
+    return f"{n:+,}円"
+
+
+def format_report(changes: list[CategoryChange], month: str, previous: str) -> str:
+    header = f"{month} vs {previous}"
+    if not changes:
+        return f"{header} 明細がありません"
+
+    lines = [header]
+    for ch in changes:
+        pct = "n/a" if ch.percent is None else f"{ch.percent:+.1f}%"
+        line = (
+            f"{ch.category}  {_signed_yen(ch.delta)} ({pct}) "
+            f"{ch.previous:,}円 -> {ch.current:,}円"
+        )
+        if ch.status == "new":
+            line += " (新規)"
+        elif ch.status == "gone":
+            line += " (なくなった)"
+        lines.append(line)
+
+    total = sum(ch.delta for ch in changes)
+    total_text = "±0円" if total == 0 else f"{total:+,}円"
+    lines.append(f"合計  {total_text}")
+    return "\n".join(lines)
