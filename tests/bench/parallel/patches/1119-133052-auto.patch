+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,133 @@
+"""Find monthly recurring expenses and forecast their next due date."""
+
+from __future__ import annotations
+
+import calendar
+import re
+import statistics
+import unicodedata
+from collections import Counter
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class RecurringExpense:
+    category: str
+    memo_key: str  # 正規化したメモ
+    amount: int  # 系列の最新の金額
+    day_of_month: int  # 系列の日(最頻の日。同数なら大きいほう)
+    months: tuple[str, ...]  # "YYYY-MM" 昇順
+    last_date: date
+    next_date: date
+
+
+_TRAILING_RE = re.compile(r"\s*(?:#\d+|no\.\d+|\d+月分|\d{4}[/.-]\d{1,2}|\d+)\s*$")
+_WS_RE = re.compile(r"\s+")
+
+
+def _memo_key(memo: str) -> str:
+    s = _WS_RE.sub(" ", unicodedata.normalize("NFKC", memo).lower()).strip()
+    while True:
+        t = _TRAILING_RE.sub("", s).strip()
+        if t == s:
+            return s
+        s = t
+
+
+def add_months(d: date, n: int, day: int | None = None) -> date:
+    """d から n か月進める。日は day(省略時は d.day)、その月に無ければ月末。"""
+    total = d.year * 12 + (d.month - 1) + n
+    year, month0 = divmod(total, 12)
+    month = month0 + 1
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day if day is None else day, last))
+
+
+def _next_after(last_month: str, day: int) -> date:
+    base = date(int(last_month[:4]), int(last_month[5:7]), 1)
+    return add_months(base, 1, day)
+
+
+def next_due(rec: RecurringExpense) -> date:
+    return _next_after(rec.months[-1], rec.day_of_month)
+
+
+def _split(items: list[Expense], tol: float) -> list[list[Expense]]:
+    """金額の近いものをまとめる。同じ金額で日の差が 10 日を超えるものは別系列。"""
+    groups: list[list[Expense]] = []
+    for e in sorted(items, key=lambda e: (e.amount, e.day.day, e.day)):
+        if groups:
+            prev = groups[-1][-1]
+            near = e.amount <= prev.amount * (1 + tol)
+            same_amount_close = e.amount != prev.amount or (
+                abs(e.day.day - prev.day.day) <= 10
+            )
+            if near and same_amount_close:
+                groups[-1].append(e)
+                continue
+        groups.append([e])
+    return groups
+
+
+def _evaluate(
+    items: list[Expense], key: tuple[str, str], min_months: int
+) -> RecurringExpense | None:
+    med = statistics.median(e.day.day for e in items)
+    by_month: dict[str, list[Expense]] = {}
+    for e in items:
+        by_month.setdefault(e.day.strftime("%Y-%m"), []).append(e)
+    kept = {
+        m: min(es, key=lambda e: (abs(e.day.day - med), e.day.day))
+        for m, es in by_month.items()
+    }
+
+    months = sorted(kept)
+    ordinals = [int(m[:4]) * 12 + int(m[5:7]) for m in months]
+    span = ordinals[-1] - ordinals[0] + 1
+    if span - len(months) >= 2:
+        # 欠けた月が 2 つ以上 → 末尾の連続部分だけを見る
+        run = [len(ordinals) - 1]
+        for i in range(len(ordinals) - 2, -1, -1):
+            if ordinals[i + 1] - ordinals[i] != 1:
+                break
+            run.append(i)
+        months = [months[i] for i in sorted(run)]
+    if len(months) < min_months:
+        return None
+
+    counted = [kept[m] for m in months]
+    counts = Counter(e.day.day for e in counted)
+    day_of_month = max(counts, key=lambda d: (counts[d], d))
+    latest = max(counted, key=lambda e: e.day)
+    return RecurringExpense(
+        category=key[0],
+        memo_key=key[1],
+        amount=latest.amount,
+        day_of_month=day_of_month,
+        months=tuple(months),
+        last_date=latest.day,
+        next_date=_next_after(months[-1], day_of_month),
+    )
+
+
+def find_recurring(
+    rows: list[Expense], min_months: int = 3, amount_tolerance: float = 0.1
+) -> list[RecurringExpense]:
+    if min_months < 2:
+        raise ValueError("min_months は 2 以上である必要があります")
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        if e.amount <= 0:  # 系列には正の金額だけを入れる
+            continue
+        groups.setdefault((e.category, _memo_key(e.memo)), []).append(e)
+    out: list[RecurringExpense] = []
+    for key, items in groups.items():
+        for series in _split(items, amount_tolerance):
+            rec = _evaluate(series, key, min_months)
+            if rec is not None:
+                out.append(rec)
+    out.sort(key=lambda r: (r.next_date, -r.amount, r.category, r.memo_key))
+    return out
diff --git a/src/kakeibo/search.py b/src/kakeibo/search.py
new file mode 100644
index 0000000..0adb6e6
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,194 @@
+"""Filter expense records by conditions (pure functions)."""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from collections.abc import Callable, Mapping
+from datetime import date, datetime
+
+from kakeibo.core import Expense
+
+Predicate = Callable[[Expense], bool]
+
+_ISO_DATE_RE = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}")
+_QUERY_KEYS = frozenset(
+    {
+        "category",
+        "amount_min",
+        "amount_max",
+        "memo",
+        "date_from",
+        "date_to",
+        "and",
+        "or",
+        "not",
+    }
+)
+
+
+def _fold(text: str) -> str:
+    """NFKC 正規化 + 大文字小文字の区別をなくす。"""
+    return unicodedata.normalize("NFKC", text).casefold()
+
+
+def _fold_name(text: str) -> str:
+    """カテゴリ名用: 前後の空白を除いてから _fold する。"""
+    return unicodedata.normalize("NFKC", text).strip().casefold()
+
+
+def category_is(*names: str) -> Predicate:
+    if not names:
+        raise ValueError("カテゴリ名を 1 つ以上指定してください")
+    targets = {_fold_name(n) for n in names}
+
+    def pred(e: Expense) -> bool:
+        return _fold_name(e.category) in targets
+
+    return pred
+
+
+def amount_between(low: int | None = None, high: int | None = None) -> Predicate:
+    if low is not None and high is not None and low > high:
+        raise ValueError(f"下限 {low} が上限 {high} より大きくなっています")
+
+    def pred(e: Expense) -> bool:
+        if low is not None and e.amount < low:
+            return False
+        return not (high is not None and e.amount > high)
+
+    return pred
+
+
+def memo_contains(text: str) -> Predicate:
+    needle = _fold(text)
+
+    def pred(e: Expense) -> bool:
+        return needle in _fold(e.memo)
+
+    return pred
+
+
+def date_between(start: date | None = None, end: date | None = None) -> Predicate:
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"開始日 {start} が終了日 {end} より後になっています")
+
+    def pred(e: Expense) -> bool:
+        if start is not None and e.day < start:
+            return False
+        return not (end is not None and e.day > end)
+
+    return pred
+
+
+def all_of(*preds: Predicate) -> Predicate:
+    return lambda e: all(p(e) for p in preds)
+
+
+def any_of(*preds: Predicate) -> Predicate:
+    return lambda e: any(p(e) for p in preds)
+
+
+def not_(pred: Predicate) -> Predicate:
+    return lambda e: not pred(e)
+
+
+def search(rows: list[Expense], pred: Predicate | None = None) -> list[Expense]:
+    if pred is None:
+        return list(rows)
+    return [e for e in rows if pred(e)]
+
+
+def _require_int(key: str, value: object) -> int:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise ValueError(f"{key} は整数である必要があります: {value!r}")  # noqa: TRY004 — 仕様どおり ValueError
+    return value
+
+
+def _require_str(key: str, value: object) -> str:
+    if not isinstance(value, str):
+        raise ValueError(f"{key} は文字列である必要があります: {value!r}")  # noqa: TRY004 — 仕様どおり ValueError
+    return value
+
+
+def _to_date(key: str, value: object) -> date:
+    if isinstance(value, datetime):
+        raise ValueError(  # noqa: TRY004 — 仕様どおり ValueError
+            f"{key} は date または YYYY-MM-DD の文字列である必要があります"
+        )
+    if isinstance(value, date):
+        return value
+    if isinstance(value, str) and _ISO_DATE_RE.fullmatch(value):
+        try:
+            return date.fromisoformat(value)
+        except ValueError:
+            pass
+    raise ValueError(f"{key} は日付として不正です: {value!r}")
+
+
+def _to_list(key: str, value: object) -> list[object]:
+    if not isinstance(value, list):
+        raise ValueError(f"{key} はリストである必要があります: {value!r}")  # noqa: TRY004 — 仕様どおり ValueError
+    return list(value)
+
+
+def _to_mapping(key: str, value: object) -> Mapping[str, object]:
+    if not isinstance(value, Mapping):
+        raise ValueError(f"{key} は辞書である必要があります: {value!r}")  # noqa: TRY004 — 仕様どおり ValueError
+    return value
+
+
+def build_query(spec: Mapping[str, object]) -> Predicate:
+    for key in spec:
+        if key not in _QUERY_KEYS:
+            raise ValueError(f"未知のキーです: {key!r}")
+
+    preds: list[Predicate] = []
+    if "category" in spec:
+        value = spec["category"]
+        if isinstance(value, str):
+            preds.append(category_is(value))
+        else:
+            names = [_require_str("category", n) for n in _to_list("category", value)]
+            if not names:
+                raise ValueError("category には 1 つ以上のカテゴリ名が必要です")
+            preds.append(category_is(*names))
+    if "amount_min" in spec or "amount_max" in spec:
+        low = (
+            _require_int("amount_min", spec["amount_min"])
+            if "amount_min" in spec
+            else None
+        )
+        high = (
+            _require_int("amount_max", spec["amount_max"])
+            if "amount_max" in spec
+            else None
+        )
+        preds.append(amount_between(low, high))
+    if "memo" in spec:
+        preds.append(memo_contains(_require_str("memo", spec["memo"])))
+    if "date_from" in spec or "date_to" in spec:
+        start = (
+            _to_date("date_from", spec["date_from"]) if "date_from" in spec else None
+        )
+        end = _to_date("date_to", spec["date_to"]) if "date_to" in spec else None
+        preds.append(date_between(start, end))
+    if "and" in spec:
+        preds.append(
+            all_of(
+                *(
+                    build_query(_to_mapping("and", s))
+                    for s in _to_list("and", spec["and"])
+                )
+            )
+        )
+    if "or" in spec:
+        preds.append(
+            any_of(
+                *(build_query(_to_mapping("or", s)) for s in _to_list("or", spec["or"]))
+            )
+        )
+    if "not" in spec:
+        preds.append(not_(build_query(_to_mapping("not", spec["not"]))))
+
+    return all_of(*preds)
