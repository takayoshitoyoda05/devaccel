diff --git a/tests/test_types/test_Choice.py b/tests/test_types/test_Choice.py
index c34f516..6346beb 100644
--- a/tests/test_types/test_Choice.py
+++ b/tests/test_types/test_Choice.py
@@ -1,3 +1,5 @@
+import pytest
+
 import click
 
 
@@ -5,3 +7,55 @@ def test_choice_get_invalid_choice_message():
     choice = click.Choice(["a", "b", "c"])
     message = choice.get_invalid_choice_message("d", ctx=None)
     assert message == "'d' is not one of 'a', 'b', 'c'."
+
+
+@pytest.mark.parametrize(
+    ("value", "suggestion"),
+    [
+        ("chekout", "Did you mean 'checkout'?"),
+        ("pul", "Did you mean 'pull'?"),
+        ("pusl", "(Did you mean one of: 'pull', 'push'?)"),
+    ],
+)
+def test_choice_invalid_choice_suggests_close_matches(value, suggestion):
+    choice = click.Choice(["checkout", "pull", "push"])
+    message = choice.get_invalid_choice_message(value, ctx=None)
+    assert message.endswith(f". {suggestion}")
+
+
+def test_choice_invalid_choice_no_suggestion_when_far():
+    choice = click.Choice(["checkout", "pull", "push"])
+    message = choice.get_invalid_choice_message("zzz", ctx=None)
+    assert "Did you mean" not in message
+
+
+def test_choice_invalid_choice_single_choice_suggests():
+    choice = click.Choice(["json"])
+    message = choice.get_invalid_choice_message("jsn", ctx=None)
+    assert message == "'jsn' is not 'json'. Did you mean 'json'?"
+
+
+def test_choice_invalid_choice_suggestion_is_case_insensitive():
+    choice = click.Choice(["Checkout", "Push"], case_sensitive=False)
+    message = choice.get_invalid_choice_message("CHEKOUT", ctx=None)
+    assert message.endswith(" Did you mean 'checkout'?")
+
+
+def test_choice_invalid_choice_non_str_value():
+    choice = click.Choice(["100", "101"])
+    message = choice.get_invalid_choice_message(102, ctx=None)
+    assert message.endswith("(Did you mean one of: '100', '101'?)")
+
+
+def test_choice_cli_error_shows_suggestion(runner):
+    @click.command()
+    @click.option("--mode", type=click.Choice(["fast", "slow"]))
+    def cli(mode):
+        click.echo(mode)
+
+    result = runner.invoke(cli, ["--mode", "fats"])
+    assert result.exit_code == 2
+    assert (
+        "Invalid value for '--mode': 'fats' is not one of 'fast', 'slow'. "
+        "Did you mean 'fast'?"
+    ) in result.output
