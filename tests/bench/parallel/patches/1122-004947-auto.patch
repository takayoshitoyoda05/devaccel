diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..fffbad0 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -188,3 +188,144 @@ def test_path_type(runner, cls, expect):
 
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
+
+
+@pytest.mark.parametrize(
+    "name", ["a.csv", "a.tsv", "A.CSV", "b.Tsv", "dir/x.csv", "a.b.csv", ".x.csv"]
+)
+def test_path_extensions_accepted(name):
+    type = click.Path(extensions=[".csv", ".tsv"])
+    assert type.convert(name, None, None) == name
+
+
+@pytest.mark.parametrize("name", ["a.txt", "a", "a.csv.bak", "csv", "a.csvx", ".csv"])
+def test_path_extensions_rejected(name):
+    type = click.Path(extensions=[".csv", ".tsv"])
+
+    with pytest.raises(click.BadParameter, match="must have one of the extensions"):
+        type.convert(name, None, None)
+
+
+def test_path_extensions_message_lists_extensions():
+    type = click.Path(extensions=["CSV", ".tsv"])
+
+    with pytest.raises(click.BadParameter, match=r"\.csv, \.tsv"):
+        type.convert("a.txt", None, None)
+
+
+def test_path_extensions_dot_optional_and_case_insensitive():
+    type = click.Path(extensions=("CSV",))
+    assert type.extensions == (".csv",)
+    assert type.convert("a.csv", None, None) == "a.csv"
+
+
+def test_path_extensions_multi_part(tmp_path):
+    type = click.Path(extensions=[".tar.gz"])
+    assert type.convert("a.tar.gz", None, None) == "a.tar.gz"
+
+    with pytest.raises(click.BadParameter):
+        type.convert("a.gz", None, None)
+
+
+def test_path_extensions_existing_file(tmp_path):
+    good = tmp_path / "a.CSV"
+    bad = tmp_path / "a.txt"
+    good.write_text("x")
+    bad.write_text("x")
+    type = click.Path(exists=True, extensions=[".csv"])
+
+    assert type.convert(os.fspath(good), None, None) == os.fspath(good)
+
+    with pytest.raises(click.BadParameter, match="must have one of the extensions"):
+        type.convert(os.fspath(bad), None, None)
+
+
+def test_path_extensions_checked_when_missing_and_not_exists(tmp_path):
+    type = click.Path(extensions=[".csv"])
+
+    with pytest.raises(click.BadParameter, match="must have one of the extensions"):
+        type.convert(os.fspath(tmp_path / "out.txt"), None, None)
+
+
+def test_path_extensions_missing_file_with_exists_reports_missing(tmp_path):
+    type = click.Path(exists=True, extensions=[".csv"])
+
+    with pytest.raises(click.BadParameter, match="does not exist"):
+        type.convert(os.fspath(tmp_path / "out.csv"), None, None)
+
+
+def test_path_extensions_not_applied_to_directory(tmp_path):
+    directory = tmp_path / "data.txt"
+    directory.mkdir()
+    type = click.Path(extensions=[".csv"])
+
+    assert type.convert(os.fspath(directory), None, None) == os.fspath(directory)
+
+
+def test_path_extensions_not_applied_to_dash():
+    type = click.Path(allow_dash=True, extensions=[".csv"])
+    assert type.convert("-", None, None) == "-"
+    assert type.convert(b"-", None, None) == b"-"
+
+
+def test_path_extensions_dash_rejected_without_allow_dash():
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions=[".csv"]).convert("-", None, None)
+
+
+def test_path_extensions_bytes_and_pathlib():
+    type = click.Path(extensions=[".csv"])
+    assert type.convert(b"a.CSV", None, None) == b"a.CSV"
+    assert type.convert(pathlib.Path("a.csv"), None, None) == pathlib.Path("a.csv")
+
+    with pytest.raises(click.BadParameter):
+        type.convert(b"a.txt", None, None)
+
+
+def test_path_extensions_with_path_type():
+    type = click.Path(extensions=[".csv"], path_type=pathlib.Path)
+    assert type.convert("a.csv", None, None) == pathlib.Path("a.csv")
+
+
+def test_path_extensions_default_accepts_anything():
+    type = click.Path()
+    assert type.extensions is None
+    assert type.convert("a.whatever", None, None) == "a.whatever"
+    assert type.to_info_dict()["extensions"] is None
+
+
+def test_path_extensions_info_dict():
+    type = click.Path(extensions=["CSV", ".tsv"])
+    assert type.to_info_dict()["extensions"] == [".csv", ".tsv"]
+
+
+@pytest.mark.parametrize(
+    ("extensions", "error"),
+    [
+        (".csv", TypeError),
+        ([], ValueError),
+        ([""], ValueError),
+        (["."], ValueError),
+        ([1], TypeError),
+        ([None], TypeError),
+    ],
+)
+def test_path_extensions_invalid_argument(extensions, error):
+    with pytest.raises(error, match="extensions"):
+        click.Path(extensions=extensions)
+
+
+def test_path_extensions_in_command(runner):
+    @click.command()
+    @click.option("--data", type=click.Path(extensions=[".csv", ".tsv"]))
+    def cli(data):
+        click.echo(data)
+
+    ok = runner.invoke(cli, ["--data", "a.TSV"])
+    assert ok.exit_code == 0
+    assert ok.output == "a.TSV\n"
+
+    bad = runner.invoke(cli, ["--data", "a.json"])
+    assert bad.exit_code == 2
+    assert "Invalid value for '--data'" in bad.output
+    assert "must have one of the extensions: .csv, .tsv." in bad.output
