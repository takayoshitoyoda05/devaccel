diff --git a/tests/test_types/test_Choice.py b/tests/test_types/test_Choice.py
index c34f516..bddad26 100644
--- a/tests/test_types/test_Choice.py
+++ b/tests/test_types/test_Choice.py
@@ -1,3 +1,5 @@
+import pytest
+
 import click
 
 
@@ -5,3 +7,64 @@ def test_choice_get_invalid_choice_message():
     choice = click.Choice(["a", "b", "c"])
     message = choice.get_invalid_choice_message("d", ctx=None)
     assert message == "'d' is not one of 'a', 'b', 'c'."
+
+
+def test_choice_invalid_message_suggests_one_close_choice():
+    choice = click.Choice(["push", "pull", "commit"])
+    message = choice.get_invalid_choice_message("pus", ctx=None)
+    assert message == (
+        "'pus' is not one of 'push', 'pull', 'commit'. Did you mean 'push'?"
+    )
+
+
+def test_choice_invalid_message_suggests_several_close_choices():
+    choice = click.Choice(["declare", "refine", "push"])
+    message = choice.get_invalid_choice_message("decline", ctx=None)
+    assert message.endswith("(Did you mean one of: 'declare', 'refine'?)")
+
+
+def test_choice_invalid_message_no_suggestion_when_far():
+    choice = click.Choice(["red", "green"])
+    message = choice.get_invalid_choice_message("zzzzzz", ctx=None)
+    assert "Did you mean" not in message
+
+
+def test_choice_invalid_message_single_choice_suggestion():
+    choice = click.Choice(["json"])
+    message = choice.get_invalid_choice_message("jsno", ctx=None)
+    assert message == "'jsno' is not 'json'. Did you mean 'json'?"
+
+
+def test_choice_invalid_message_case_insensitive_suggestion():
+    choice = click.Choice(["Push", "Pull"], case_sensitive=False)
+    message = choice.get_invalid_choice_message("PUS", ctx=None)
+    # Suggestions use the normalized (casefolded) choices shown in the message.
+    assert message.endswith("Did you mean 'push'?")
+
+
+def test_choice_invalid_message_non_string_value():
+    choice = click.Choice(["1", "2"])
+    message = choice.get_invalid_choice_message(3, ctx=None)
+    assert message == "3 is not one of '1', '2'."
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        ("pus", "Did you mean 'push'?"),
+        ("zzz", None),
+    ],
+)
+def test_choice_option_error_output(runner, value, expected):
+    @click.command()
+    @click.option("--action", type=click.Choice(["push", "pull"]))
+    def cli(action):
+        pass
+
+    result = runner.invoke(cli, ["--action", value])
+    assert result.exit_code == 2
+    assert "is not one of 'push', 'pull'." in result.output
+    if expected is None:
+        assert "Did you mean" not in result.output
+    else:
+        assert expected in result.output
