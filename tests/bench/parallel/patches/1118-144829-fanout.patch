@@ -0,0 +1,17 @@
+"""Expense totals grouped by weekday."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+# date.weekday() の 0 が月曜。strftime("%a") はロケール依存なので使わない。
+WEEKDAYS: tuple[str, ...] = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
+
+
+def total_by_weekday(rows: list[Expense]) -> dict[str, int]:
+    """{"Mon".."Sun": yen}。明細のない曜日は含めず、キーは月曜始まりの順。"""
+    totals: dict[str, int] = {}
+    for e in rows:
+        name = WEEKDAYS[e.day.weekday()]
+        totals[name] = totals.get(name, 0) + e.amount
+    return {name: totals[name] for name in WEEKDAYS if name in totals}
