index 0000000..edef2dd
--- /dev/null
+++ b/src/kakeibo/streak.py
@@ -0,0 +1,26 @@
+"""No-spend streak: longest run of consecutive days without any expense."""
+
+from __future__ import annotations
+
+from datetime import date, timedelta
+
+from kakeibo.core import Expense
+
+
+def longest_no_spend_streak(rows: list[Expense], start: date, end: date) -> int:
+    """start〜end(両端含む)で明細が 1 件もない日の最長連続日数。
+
+    start > end の場合は 0 を返す。範囲外の明細は無視する。
+    """
+    spent = {e.day for e in rows if start <= e.day <= end}
+    best = 0
+    run = 0
+    day = start
+    while day <= end:
+        if day in spent:
+            run = 0
+        else:
+            run += 1
+            best = max(best, run)
+        day += timedelta(days=1)
+    return best
