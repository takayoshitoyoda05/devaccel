@@ -0,0 +1,61 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.streak import longest_no_spend_streak
+
+
+def _e(d: int, amount: int = 100) -> Expense:
+    return Expense(day=date(2026, 11, d), category="food", amount=amount)
+
+
+def test_no_rows_whole_range_counts():
+    assert longest_no_spend_streak([], date(2026, 11, 1), date(2026, 11, 5)) == 5
+
+
+def test_single_day_range_without_spend():
+    assert longest_no_spend_streak([], date(2026, 11, 3), date(2026, 11, 3)) == 1
+
+
+def test_single_day_range_with_spend():
+    rows = [_e(3)]
+    assert longest_no_spend_streak(rows, date(2026, 11, 3), date(2026, 11, 3)) == 0
+
+
+def test_longest_gap_between_spends():
+    # 11/1 spend, 11/2-11/4 empty (3 days), 11/5 spend, 11/6 empty (1 day)
+    rows = [_e(1), _e(5)]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 6)) == 3
+
+
+def test_trailing_streak_counts():
+    rows = [_e(1), _e(2)]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 10)) == 8
+
+
+def test_leading_streak_counts():
+    rows = [_e(5)]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 5)) == 4
+
+
+def test_multiple_expenses_same_day_count_once():
+    rows = [_e(2, 100), _e(2, 200), _e(4)]
+    # 11/1 (1), 11/2 spend, 11/3 (1), 11/4 spend, 11/5 (1)
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 5)) == 1
+
+
+def test_rows_outside_range_are_ignored():
+    rows = [_e(1), _e(20)]
+    # only 11/2-11/5 is in range, and nothing there is spent
+    assert longest_no_spend_streak(rows, date(2026, 11, 2), date(2026, 11, 5)) == 4
+
+
+def test_start_after_end_returns_zero():
+    assert longest_no_spend_streak([], date(2026, 11, 5), date(2026, 11, 1)) == 0
+
+
+def test_range_crosses_month_boundary():
+    rows = [
+        Expense(day=date(2026, 10, 31), category="food", amount=1),
+        Expense(day=date(2026, 11, 3), category="food", amount=1),
+    ]
+    assert longest_no_spend_streak(rows, date(2026, 10, 30), date(2026, 11, 5)) == 2
