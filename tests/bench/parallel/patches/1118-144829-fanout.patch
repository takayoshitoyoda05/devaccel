@@ -0,0 +1,15 @@
+"""Split an amount evenly among people."""
+
+from __future__ import annotations
+
+
+def split_evenly(amount: int, people: int) -> list[int]:
+    """Split ``amount`` yen among ``people``.
+
+    The remainder is distributed one yen at a time from the first person, so the
+    shares always sum to ``amount``.
+    """
+    if people < 1:
+        raise ValueError(f"人数は 1 以上である必要があります: {people}")
+    base, remainder = divmod(amount, people)
+    return [base + (1 if i < remainder else 0) for i in range(people)]
