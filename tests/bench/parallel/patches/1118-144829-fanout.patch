@@ -0,0 +1,48 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.weekday import total_by_weekday
+
+
+def test_empty_rows_returns_empty_dict():
+    assert total_by_weekday([]) == {}
+
+
+def test_sums_amounts_per_weekday():
+    rows = [
+        Expense(date(2026, 11, 16), "food", 1200),  # Mon
+        Expense(date(2026, 11, 23), "food", 800),  # Mon
+        Expense(date(2026, 11, 21), "book", 500),  # Sat
+    ]
+    assert total_by_weekday(rows) == {"Mon": 2000, "Sat": 500}
+
+
+def test_missing_weekdays_are_omitted():
+    rows = [Expense(date(2026, 11, 18), "rent", 80000)]  # Wed
+    assert total_by_weekday(rows) == {"Wed": 80000}
+
+
+def test_keys_are_in_monday_first_order_regardless_of_input_order():
+    rows = [
+        Expense(date(2026, 11, 22), "a", 1),  # Sun
+        Expense(date(2026, 11, 18), "b", 2),  # Wed
+        Expense(date(2026, 11, 16), "c", 3),  # Mon
+        Expense(date(2026, 11, 20), "d", 4),  # Fri
+    ]
+    result = total_by_weekday(rows)
+    assert list(result) == ["Mon", "Wed", "Fri", "Sun"]
+    assert result == {"Mon": 3, "Wed": 2, "Fri": 4, "Sun": 1}
+
+
+def test_all_seven_days_in_order():
+    rows = [Expense(date(2026, 11, 16 + i), "x", i + 1) for i in range(7)]
+    result = total_by_weekday(rows)
+    assert list(result) == ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
+    assert list(result.values()) == [1, 2, 3, 4, 5, 6, 7]
+
+
+def test_does_not_mutate_input():
+    rows = [Expense(date(2026, 11, 16), "food", 1200, "memo")]
+    snapshot = list(rows)
+    total_by_weekday(rows)
+    assert rows == snapshot
