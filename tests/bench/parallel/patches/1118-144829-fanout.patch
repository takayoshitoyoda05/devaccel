+import json
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.export import to_json
+
+
+def test_to_json_empty():
+    assert to_json([]) == "[]"
+
+
+def test_to_json_fields_and_order():
+    rows = [
+        Expense(date(2026, 11, 2), "rent", 80000, "11月分"),
+        Expense(date(2026, 10, 31), "food", 500),
+    ]
+    out = to_json(rows)
+    assert out == (
+        '[{"date": "2026-11-02", "category": "rent", "amount": 80000, "memo": "11月分"}, '
+        '{"date": "2026-10-31", "category": "food", "amount": 500, "memo": ""}]'
+    )
+    assert [list(o) for o in json.loads(out)] == [
+        ["date", "category", "amount", "memo"],
+        ["date", "category", "amount", "memo"],
+    ]
+
+
+def test_to_json_keeps_non_ascii():
+    out = to_json([Expense(date(2026, 1, 5), "食費", 1200, "スーパー")])
+    assert "食費" in out and "スーパー" in out
+    assert "\\u" not in out
