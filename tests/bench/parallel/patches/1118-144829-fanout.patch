@@ -0,0 +1,15 @@
+"""Top-N expenses by amount."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def top_expenses(rows: list[Expense], n: int) -> list[Expense]:
+    """金額の大きい順に n 件。同額は日付の早い順、それも同じなら入力順。
+
+    n が 0 以下なら空リスト。sorted は安定ソートなので入力順が保たれる。
+    """
+    if n <= 0:
+        return []
+    return sorted(rows, key=lambda e: (-e.amount, e.day))[:n]
