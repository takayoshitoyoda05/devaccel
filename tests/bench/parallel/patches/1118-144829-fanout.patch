@@ -0,0 +1,38 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.dupes import find_duplicates
+
+
+def _e(day=1, category="food", amount=100, memo=""):
+    return Expense(date(2026, 11, day), category, amount, memo)
+
+
+def test_empty_and_no_duplicates():
+    assert find_duplicates([]) == []
+    assert find_duplicates([_e(1), _e(2), _e(1, amount=200)]) == []
+
+
+def test_simple_pair():
+    assert find_duplicates([_e(1), _e(2), _e(1)]) == [(0, 2)]
+
+
+def test_all_fields_must_match():
+    rows = [_e(1, memo="a"), _e(1, memo="b"), _e(1, category="rent"), _e(1, amount=101)]
+    assert find_duplicates(rows) == []
+
+
+def test_group_of_three_gives_all_pairs_in_order():
+    rows = [_e(1), _e(2), _e(1), _e(1)]
+    assert find_duplicates(rows) == [(0, 2), (0, 3), (2, 3)]
+
+
+def test_interleaved_groups_sorted_by_i_then_j():
+    a, b = _e(1), _e(2)
+    rows = [a, b, b, a, b]
+    assert find_duplicates(rows) == [(0, 3), (1, 2), (1, 4), (2, 4)]
+
+
+def test_pairs_are_i_less_than_j():
+    rows = [_e(5), _e(5)]
+    assert all(i < j for i, j in find_duplicates(rows))
