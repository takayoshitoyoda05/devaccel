+"""Per-category statistics over Expense records."""
+
+from __future__ import annotations
+
+import statistics
+
+from kakeibo.core import Expense
+
+
+def median_by_category(rows: list[Expense]) -> dict[str, float]:
+    """{category: median amount (yen)}; keys ascending, {} for no rows.
+
+    偶数個のときは中央 2 つの平均を返す。
+    """
+    by_cat: dict[str, list[int]] = {}
+    for e in rows:
+        by_cat.setdefault(e.category, []).append(e.amount)
+    return {cat: float(statistics.median(by_cat[cat])) for cat in sorted(by_cat)}
