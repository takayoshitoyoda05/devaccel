@@ -0,0 +1,24 @@
+"""Detect duplicate expense records."""
+
+from __future__ import annotations
+
+from collections import defaultdict
+
+from kakeibo.core import Expense
+
+
+def find_duplicates(rows: list[Expense]) -> list[tuple[int, int]]:
+    """Index pairs (i, j), i < j, of rows with identical day/category/amount/memo.
+
+    Sorted by i ascending, then j ascending.
+    """
+    groups: dict[Expense, list[int]] = defaultdict(list)
+    for idx, row in enumerate(rows):
+        groups[row].append(idx)
+
+    pairs: list[tuple[int, int]] = []
+    for i, row in enumerate(rows):
+        for j in groups[row]:
+            if j > i:
+                pairs.append((i, j))
+    return pairs
