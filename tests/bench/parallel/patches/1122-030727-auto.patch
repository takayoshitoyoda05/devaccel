+
+
+@pytest.mark.parametrize(
+    ("type", "expect"),
+    [
+        (click.IntRange(1), "x>=1"),
+        (click.IntRange(1, min_open=True), "x>1"),
+        (click.IntRange(max=5), "x<=5"),
+        (click.IntRange(max=5, max_open=True), "x<5"),
+        (click.FloatRange(1.5), "x>=1.5"),
+        (click.FloatRange(1.5, min_open=True), "x>1.5"),
+        (click.FloatRange(max=5.5), "x<=5.5"),
+        (click.FloatRange(max=5.5, max_open=True), "x<5.5"),
+    ],
+)
+def test_range_help_text(runner, type, expect):
+    @click.command()
+    @click.option("--n", type=type, show_default=False, help="N.")
+    def cli(n):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert f"[{expect}]" in result.output
