new file mode 100644
index 0000000..305e20e
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,108 @@
+"""Import bank CSV exports (other-bank format) into Expense records."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_REQUIRED_FIELDS = ("date", "category", "amount")
+
+# 任意の "-" / 任意の "¥" か "￥" 1 文字 / ASCII 数字で始まる数字とカンマ / 任意の "円"
+_AMOUNT_RE = re.compile(r"(-?)([¥￥]?)([0-9][0-9,]*)(円?)")
+# 区切りは最初に現れたものと同じものに揃える(混在を拒否する)
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    """Parse a bank amount such as ``￥1,234`` or ``980円`` into yen."""
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    sign, _yen_mark, digits, _suffix = m.groups()
+    return int(sign + digits.replace(",", ""))
+
+
+def parse_date(s: str) -> date:
+    """Parse ``YYYY/M/D`` or ``YYYY-M-D`` into a date."""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    year, _sep, month, day = m.groups()
+    try:
+        return date(int(year), int(month), int(day))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def _field(record: list[str], idx: dict[str, int], field: str) -> str:
+    i = idx.get(field)
+    if i is None or i >= len(record):
+        return ""
+    return record[i]
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Read a CSV string (header on line 1) into expenses.
+
+    Returns ``(expenses, errors)``; each error is ``(physical line, field name)``.
+    Rows with any error are left out of the expenses.
+    """
+    cols = DEFAULT_MAPPING if mapping is None else mapping
+    for field in _REQUIRED_FIELDS:
+        if field not in cols:
+            raise ValueError(f"mapping に {field} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header = next(reader, [])
+    for name in cols.values():
+        if name not in header:
+            raise ValueError(f"ヘッダーに列 {name!r} がありません")
+    idx = {field: header.index(name) for field, name in cols.items()}
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    for record in reader:
+        if not record:  # 空行は読み飛ばす(行番号は数える)
+            continue
+        line = reader.line_num
+
+        day: date | None
+        try:
+            day = parse_date(_field(record, idx, "date"))
+        except ValueError:
+            day = None
+            errors.append((line, "date"))
+
+        amount: int | None
+        try:
+            amount = parse_amount(_field(record, idx, "amount"))
+        except ValueError:
+            amount = None
+            errors.append((line, "amount"))
+
+        category = _field(record, idx, "category").strip()
+        if not category:
+            errors.append((line, "category"))
+
+        if day is None or amount is None or not category:
+            continue
+        if category_map:
+            category = category_map.get(category, category)
+        memo = _field(record, idx, "memo").strip()
+        expenses.append(Expense(day=day, category=category, amount=amount, memo=memo))
+    return expenses, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
