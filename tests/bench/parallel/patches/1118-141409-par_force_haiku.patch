new file mode 100644
index 0000000..fccfb62
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,117 @@
+"""Import expenses from other-bank CSV exports."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"-?[¥￥]?[0-9][0-9,]*円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    """Parse an amount such as ' ￥1,234 ', '-¥300' or '980円' into yen.
+
+    Raises ValueError for anything else.
+    """
+    text = s.strip()
+    if not _AMOUNT_RE.fullmatch(text):
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    body = text.replace(",", "")
+    for mark in ("¥", "￥", "円"):
+        body = body.replace(mark, "")
+    return int(body)
+
+
+def parse_date(s: str) -> date:
+    """Parse 'YYYY/M/D' or 'YYYY-M-D' (separators must match).
+
+    Raises ValueError for other forms and for non-existent dates.
+    """
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    year, _sep, month, day = m.group(1), m.group(2), m.group(3), m.group(4)
+    return date(int(year), int(month), int(day))
+
+
+def _is_blank(row: list[str]) -> bool:
+    return not row or (len(row) == 1 and not row[0].strip())
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Read a CSV whose first line is a header.
+
+    Returns (expenses in input order, errors as (physical line number, field)).
+    Rows with any error are left out of the expenses.
+    """
+    cols = DEFAULT_MAPPING if mapping is None else mapping
+    for key in ("date", "category", "amount"):
+        if key not in cols:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header = next(reader, None) or []
+    index = {name: i for i, name in enumerate(header)}
+    for field, col in cols.items():
+        if col not in index:
+            raise ValueError(f"列 {col!r}({field}) がヘッダーにありません")
+    cmap = category_map or {}
+
+    def value(row: list[str], field: str) -> str:
+        i = index[cols[field]]
+        return row[i] if i < len(row) else ""
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    while True:
+        start = reader.line_num + 1
+        row = next(reader, None)
+        if row is None:
+            break
+        if _is_blank(row):
+            continue
+
+        row_errors: list[tuple[int, str]] = []
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(value(row, "date"))
+        except ValueError:
+            row_errors.append((start, "date"))
+        try:
+            amount = parse_amount(value(row, "amount"))
+        except ValueError:
+            row_errors.append((start, "amount"))
+        category = value(row, "category").strip()
+        if not category:
+            row_errors.append((start, "category"))
+
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        assert day is not None and amount is not None
+        expenses.append(
+            Expense(
+                day=day,
+                category=cmap.get(category, category),
+                amount=amount,
+                memo=value(row, "memo").strip() if "memo" in cols else "",
+            )
+        )
+    return expenses, errors
