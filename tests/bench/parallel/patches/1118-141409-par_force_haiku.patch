+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,89 @@
+"""Month-over-month expense comparison by category."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+
+    prev_totals: dict[str, int] = {}
+    curr_totals: dict[str, int] = {}
+    prev_count: dict[str, int] = {}
+    curr_count: dict[str, int] = {}
+    for e in rows:
+        m = e.day.strftime("%Y-%m")
+        if m == prev_month:
+            prev_totals[e.category] = prev_totals.get(e.category, 0) + e.amount
+            prev_count[e.category] = prev_count.get(e.category, 0) + 1
+        elif m == curr_month:
+            curr_totals[e.category] = curr_totals.get(e.category, 0) + e.amount
+            curr_count[e.category] = curr_count.get(e.category, 0) + 1
+
+    out: list[DiffRow] = []
+    for cat in set(prev_count) | set(curr_count):
+        prev = prev_totals.get(cat, 0)
+        curr = curr_totals.get(cat, 0)
+        delta = curr - prev
+        pct = None if prev == 0 else round(delta / prev * 100, 1)
+        if cat not in prev_count:
+            status = "new"
+        elif cat not in curr_count:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+
+    out.sort(key=lambda r: (-abs(r.delta), r.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [d for d in diffs if d.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for d in diffs:
+        pct = "-" if d.pct is None else f"{d.pct:+.1f}%"
+        lines.append(f"{d.category}\t{d.prev}\t{d.curr}\t{d.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({e.day.strftime("%Y-%m") for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には明細のある月が 2 つ以上必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..b93b89e
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,157 @@
+"""Search query language for expenses.
+
+Grammar (lowest precedence first: OR < AND < NOT):
+    or_expr  := and_expr ("OR" and_expr)*
+    and_expr := not_expr (["AND"] not_expr)*
+    not_expr := "NOT" not_expr | primary
+    primary  := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+
+from kakeibo.core import Expense
+
+Token = tuple[str, str]
+Predicate = Callable[[Expense], bool]
+
+_SPECIAL = frozenset(' \t\r\n()"')
+
+
+class QueryError(ValueError):
+    """Raised when a search query is malformed."""
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    tokens: list[Token] = []
+    i, n = 0, len(q)
+    while i < n:
+        ch = q[i]
+        if ch.isspace():
+            i += 1
+        elif ch == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif ch == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif ch == '"':
+            end = q.find('"', i + 1)
+            if end < 0:
+                raise QueryError("引用符が閉じていません")
+            body = q[i + 1 : end]
+            if not body:
+                raise QueryError("空の引用は使えません")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            start = i
+            while i < n and q[i] not in _SPECIAL:
+                i += 1
+            word = q[start:i]
+            if word == "AND":
+                tokens.append(("AND", "AND"))
+            elif word == "OR":
+                tokens.append(("OR", "OR"))
+            elif word == "NOT":
+                tokens.append(("NOT", "NOT"))
+            elif word.startswith("cat:"):
+                cat = word[len("cat:") :]
+                if not cat:
+                    raise QueryError("cat: の後ろに値がありません")
+                tokens.append(("CAT", cat))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self._tokens = tokens
+        self._pos = 0
+
+    def _peek(self) -> str | None:
+        return self._tokens[self._pos][0] if self._pos < len(self._tokens) else None
+
+    def _next(self) -> Token:
+        if self._pos >= len(self._tokens):
+            raise QueryError("クエリが途中で終わっています")
+        tok = self._tokens[self._pos]
+        self._pos += 1
+        return tok
+
+    def parse(self) -> Predicate:
+        if not self._tokens:
+            raise QueryError("クエリが空です")
+        pred = self._or_expr()
+        if self._pos != len(self._tokens):
+            raise QueryError(
+                f"解釈できない位置があります: {self._tokens[self._pos][1]!r}"
+            )
+        return pred
+
+    def _or_expr(self) -> Predicate:
+        left = self._and_expr()
+        while self._peek() == "OR":
+            self._next()
+            right = self._and_expr()
+            left = _or(left, right)
+        return left
+
+    def _and_expr(self) -> Predicate:
+        left = self._not_expr()
+        while True:
+            kind = self._peek()
+            if kind == "AND":
+                self._next()
+            elif kind not in ("TERM", "CAT", "LPAREN", "NOT"):
+                break
+            left = _and(left, self._not_expr())
+        return left
+
+    def _not_expr(self) -> Predicate:
+        if self._peek() == "NOT":
+            self._next()
+            inner = self._not_expr()
+            return lambda e: not inner(e)
+        return self._primary()
+
+    def _primary(self) -> Predicate:
+        kind, value = self._next()
+        if kind == "TERM":
+            needle = value.casefold()
+            return lambda e: (
+                needle in e.memo.casefold() or needle in e.category.casefold()
+            )
+        if kind == "CAT":
+            target = value.casefold()
+            return lambda e: e.category.casefold() == target
+        if kind == "LPAREN":
+            inner = self._or_expr()
+            if self._peek() != "RPAREN":
+                raise QueryError("括弧が閉じていません")
+            self._next()
+            return inner
+        raise QueryError(f"項がありません: {value!r}")
+
+
+def _and(a: Predicate, b: Predicate) -> Predicate:
+    return lambda e: a(e) and b(e)
+
+
+def _or(a: Predicate, b: Predicate) -> Predicate:
+    return lambda e: a(e) or b(e)
+
+
+def _compile(q: str) -> Predicate:
+    return _Parser(tokenize(q)).parse()
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _compile(q)(e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    pred = _compile(q)
+    return [e for e in rows if pred(e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..2e37e20
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,64 @@
+"""Detect recurring expenses (same category and amount, roughly monthly)."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day in the next month, clamped to that month's last day."""
+    year, month = (d.year + 1, 1) if d.month == 12 else (d.year, d.month + 1)
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def _runs(days: list[date], tolerance: int) -> list[list[date]]:
+    """Split sorted unique dates into maximal runs where neighbours are linked."""
+    runs: list[list[date]] = []
+    for d in days:
+        if runs and abs((d - add_month(runs[-1][-1])).days) <= tolerance:
+            runs[-1].append(d)
+        else:
+            runs.append([d])
+    return runs
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError(f"min_count は 2 以上である必要があります: {min_count}")
+    if tolerance < 0:
+        raise ValueError(f"tolerance は 0 以上である必要があります: {tolerance}")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    found: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        for run in _runs(sorted(day_set), tolerance):
+            if len(run) >= min_count:
+                found.append(
+                    Recurring(
+                        category=category,
+                        amount=amount,
+                        days=tuple(run),
+                        next_expected=add_month(run[-1]),
+                    )
+                )
+
+    found.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return found
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..64e73cb
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,151 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+HEADER = "利用日,分類,利用金額,利用店名\n"
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥1200", 1200),
+        ("1,000", 1000),
+        ("-1,000円", -1000),
+    ],
+)
+def test_parse_amount_accepts(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    ["", "円", "12.5", "1 200", "--5", "¥-5", "１２３", "abc", "5円円", "$5"],
+)
+def test_parse_amount_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/12/31 ", date(2026, 12, 31)),
+        ("2026-1-5", date(2026, 1, 5)),
+    ],
+)
+def test_parse_date_accepts(text: str, expected: date) -> None:
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    ["2026/1-5", "26/1/5", "2026/02/30", "2026.1.5", "2026/13/1", "", "２０２６/1/5"],
+)
+def test_parse_date_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+def test_default_mapping_values() -> None:
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_import_rows_basic_and_extra_columns() -> None:
+    text = (
+        "利用日,分類,利用金額,利用店名,備考\n"
+        '2026/1/5,食費,"1,200",  コンビニ  ,x\n'
+        "2026-01-06,交通費,-¥300,駅,\n"
+    )
+    expenses, errors = import_rows(text)
+    assert errors == []
+    assert expenses == [
+        Expense(date(2026, 1, 5), "食費", 1200, "コンビニ"),
+        Expense(date(2026, 1, 6), "交通費", -300, "駅"),
+    ]
+
+
+def test_quoted_comma_in_memo() -> None:
+    text = HEADER + '2026/1/5,食費,500,"A, B"\n'
+    expenses, errors = import_rows(text)
+    assert errors == []
+    assert expenses[0].memo == "A, B"
+
+
+def test_blank_lines_skipped_but_counted() -> None:
+    text = HEADER + "\n2026/1/5,食費,100,\n\n,食費,x,\n"
+    expenses, errors = import_rows(text)
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "")]
+    assert errors == [(5, "date"), (5, "amount")]
+
+
+def test_errors_recorded_in_order_per_row() -> None:
+    text = HEADER + "2026/1/5,,abc,\n2026/1/6,食費,5,\n"
+    expenses, errors = import_rows(text)
+    assert errors == [(2, "amount"), (2, "category")]
+    assert expenses == [Expense(date(2026, 1, 6), "食費", 5, "")]
+
+
+def test_error_row_excluded_and_all_fields_reported() -> None:
+    text = HEADER + "xx,   ,1,\n"
+    expenses, errors = import_rows(text)
+    assert expenses == []
+    assert errors == [(2, "date"), (2, "category")]
+
+
+def test_short_row_missing_values_are_empty() -> None:
+    text = HEADER + "2026/1/5,食費\n"
+    expenses, errors = import_rows(text)
+    assert expenses == []
+    assert errors == [(2, "amount")]
+
+
+def test_short_row_missing_memo_is_empty_string() -> None:
+    text = HEADER + "2026/1/5,食費,100\n"
+    expenses, _ = import_rows(text)
+    assert expenses[0].memo == ""
+
+
+def test_category_map_applied_after_strip() -> None:
+    text = HEADER + "2026/1/5,  スーパー  ,100,\n2026/1/6,食費,200,\n"
+    expenses, errors = import_rows(text, category_map={"スーパー": "食費"})
+    assert errors == []
+    assert [e.category for e in expenses] == ["食費", "食費"]
+
+
+def test_custom_mapping_without_memo() -> None:
+    text = "day,kind,yen\n2026/3/1,外食,980円\n"
+    mapping = {"date": "day", "category": "kind", "amount": "yen"}
+    expenses, errors = import_rows(text, mapping=mapping)
+    assert errors == []
+    assert expenses == [Expense(date(2026, 3, 1), "外食", 980, "")]
+
+
+def test_mapping_missing_required_key_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows("a,b\n", mapping={"date": "a", "amount": "b"})
+
+
+def test_mapping_column_absent_from_header_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows("利用日,分類,利用金額\n2026/1/5,食費,100\n")
+
+
+def test_empty_input_with_default_mapping_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows("")
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..31aac09
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,132 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def E(d: str, cat: str, amount: int) -> Expense:
+    return Expense(date.fromisoformat(d), cat, amount, "")
+
+
+ROWS = [
+    E("2026-01-05", "food", 1000),
+    E("2026-01-20", "food", 1000),
+    E("2026-01-10", "rent", 5000),
+    E("2026-01-11", "fun", 500),
+    E("2026-02-03", "food", 2300),
+    E("2026-02-10", "rent", 5000),
+    E("2026-02-12", "tax", 0),
+    E("2026-02-15", "book", 700),
+]
+
+
+def test_month_diff_basic_fields_and_status() -> None:
+    got = {r.category: r for r in month_diff(ROWS, "2026-01", "2026-02")}
+    assert got["food"] == DiffRow("food", 2000, 2300, 300, 15.0, "up")
+    assert got["rent"] == DiffRow("rent", 5000, 5000, 0, 0.0, "same")
+    assert got["fun"] == DiffRow("fun", 500, 0, -500, -100.0, "gone")
+    assert got["book"] == DiffRow("book", 0, 700, 700, None, "new")
+    assert got["tax"] == DiffRow("tax", 0, 0, 0, None, "new")
+
+
+def test_month_diff_sort_by_abs_delta_then_category() -> None:
+    rows = [
+        E("2026-01-01", "b", 100),
+        E("2026-01-01", "a", 100),
+        E("2026-02-01", "c", 100),  # new, delta 100
+        E("2026-02-01", "d", 100),  # new, delta 100
+        E("2026-01-01", "e", 1000),  # gone, delta -1000
+    ]
+    cats = [r.category for r in month_diff(rows, "2026-01", "2026-02")]
+    assert cats == ["e", "a", "b", "c", "d"]
+
+
+def test_month_diff_status_uses_presence_not_sum() -> None:
+    rows = [E("2026-01-01", "x", 0), E("2026-02-01", "x", 0)]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    assert r.status == "same"
+    assert r.pct is None
+
+
+def test_month_diff_zero_amount_prev_is_new_not_gone() -> None:
+    rows = [E("2026-01-01", "x", 0), E("2026-03-01", "y", 1)]
+    out = {r.category: r.status for r in month_diff(rows, "2026-01", "2026-03")}
+    assert out == {"x": "gone", "y": "new"}
+
+
+def test_month_diff_empty_months() -> None:
+    assert month_diff(ROWS, "2025-01", "2025-02") == []
+
+
+def test_month_diff_rejects_bad_month_format() -> None:
+    for bad in ["2026-1", "2026-13", "2026-00", "202601", "2026/01", "26-01"]:
+        with pytest.raises(ValueError):
+            month_diff(ROWS, bad, "2026-02")
+        with pytest.raises(ValueError):
+            month_diff(ROWS, "2026-01", bad)
+
+
+def test_pct_rounding_and_negative() -> None:
+    rows = [E("2026-01-01", "x", 300), E("2026-02-01", "x", 200)]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    assert r.delta == -100
+    assert r.pct == -33.3
+
+
+def test_top_movers_excludes_same_and_keeps_order() -> None:
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    top = top_movers(diffs, n=2)
+    assert [r.category for r in top] == ["book", "fun"]
+    assert all(r.status != "same" for r in top_movers(diffs, n=100))
+    assert top_movers(diffs, n=0) == []
+
+
+def test_top_movers_default_n_and_negative() -> None:
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    assert len(top_movers(diffs)) == 3
+    with pytest.raises(ValueError):
+        top_movers(diffs, n=-1)
+
+
+def test_render_diff_format() -> None:
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    text = render_diff(diffs)
+    lines = text.split("\n")
+    assert lines[0] == "category\tprev\tcurr\tdelta\tpct"
+    assert "fun\t500\t0\t-500\t-100.0%" in lines
+    assert "book\t0\t700\t+700\t-" in lines
+    assert "rent\t5000\t5000\t+0\t+0.0%" in lines
+    assert "food\t2000\t2300\t+300\t+15.0%" in lines
+    assert not text.endswith("\n")
+
+
+def test_render_diff_empty() -> None:
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_available_months_sorted_unique() -> None:
+    assert available_months(ROWS) == ["2026-01", "2026-02"]
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months() -> None:
+    rows = ROWS + [E("2025-12-01", "food", 9999)]
+    assert latest_diff(rows) == month_diff(ROWS, "2026-01", "2026-02")
+
+
+def test_latest_diff_needs_two_months() -> None:
+    with pytest.raises(ValueError):
+        latest_diff([E("2026-01-01", "x", 1)])
+    with pytest.raises(ValueError):
+        latest_diff([])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..e7d453e
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,140 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+ROWS = [
+    Expense(date(2026, 11, 1), "food", 1200, "Lunch with Ann"),
+    Expense(date(2026, 11, 2), "rent", 80000, ""),
+    Expense(date(2026, 11, 3), "Books", 2500, "manga (vol 3)"),
+    Expense(date(2026, 11, 4), "food", 800, "coffee"),
+]
+
+
+def _memo(rows):
+    return [e.memo for e in rows]
+
+
+def test_tokenize_basic():
+    assert tokenize(" (food  OR rent) ") == [
+        ("LPAREN", "("),
+        ("TERM", "food"),
+        ("OR", "OR"),
+        ("TERM", "rent"),
+        ("RPAREN", ")"),
+    ]
+
+
+def test_tokenize_quote_and_cat_and_case():
+    assert tokenize('"a b (c)" cat:food and NOT not') == [
+        ("TERM", "a b (c)"),
+        ("CAT", "food"),
+        ("TERM", "and"),
+        ("NOT", "NOT"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_word_stops_at_quote():
+    assert tokenize('ab"cd"') == [("TERM", "ab"), ("TERM", "cd")]
+
+
+def test_tokenize_whitespace_only_is_empty():
+    assert tokenize("   ") == []
+
+
+@pytest.mark.parametrize("q", ['"abc', '""', "cat:"])
+def test_tokenize_errors(q):
+    with pytest.raises(QueryError):
+        tokenize(q)
+
+
+def test_term_matches_memo_or_category_case_insensitive():
+    assert _memo(filter_rows("ANN", ROWS)) == ["Lunch with Ann"]
+    assert [e.category for e in filter_rows("books", ROWS)] == ["Books"]
+    assert len(filter_rows("food", ROWS)) == 2
+
+
+def test_cat_is_exact_match():
+    assert len(filter_rows("cat:FOOD", ROWS)) == 2
+    assert filter_rows("cat:foo", ROWS) == []
+    assert filter_rows("cat:rent", ROWS)[0].amount == 80000
+
+
+def test_implicit_and_and_explicit_and():
+    assert _memo(filter_rows("cat:food coffee", ROWS)) == ["coffee"]
+    assert _memo(filter_rows("cat:food AND coffee", ROWS)) == ["coffee"]
+    assert filter_rows("cat:rent coffee", ROWS) == []
+
+
+def test_or_and_precedence():
+    # OR is lowest: "rent OR food coffee" == rent OR (food AND coffee)
+    got = filter_rows("rent OR food coffee", ROWS)
+    assert [e.category for e in got] == ["rent", "food"]
+    assert _memo(got) == ["", "coffee"]
+
+
+def test_not_binds_tighter_than_and():
+    got = filter_rows("food NOT coffee", ROWS)
+    assert _memo(got) == ["Lunch with Ann"]
+    assert _memo(filter_rows("NOT cat:food", ROWS)) == ["", "manga (vol 3)"]
+
+
+def test_parentheses_override_precedence():
+    got = filter_rows("(rent OR food) coffee", ROWS)
+    assert _memo(got) == ["coffee"]
+    assert len(filter_rows("NOT (cat:food OR cat:rent)", ROWS)) == 1
+
+
+def test_quoted_term_with_parens_and_spaces():
+    assert _memo(filter_rows('"(vol 3)"', ROWS)) == ["manga (vol 3)"]
+    assert _memo(filter_rows('"with ann"', ROWS)) == ["Lunch with Ann"]
+
+
+def test_filter_preserves_order():
+    assert _memo(filter_rows("cat:food OR cat:Books", ROWS)) == [
+        "Lunch with Ann",
+        "manga (vol 3)",
+        "coffee",
+    ]
+
+
+def test_matches_single_row():
+    assert matches("cat:rent", ROWS[1]) is True
+    assert matches("cat:rent", ROWS[0]) is False
+    assert matches("NOT cat:rent", ROWS[1]) is False
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(food",
+        "food)",
+        ")food(",
+        "food OR",
+        "OR food",
+        "AND food",
+        "NOT",
+        "food AND )",
+        "(food OR)",
+        "NOT )",
+        '"unclosed',
+        "cat:",
+    ],
+)
+def test_malformed_queries_raise(q):
+    with pytest.raises(QueryError):
+        filter_rows(q, ROWS)
+    with pytest.raises(QueryError):
+        matches(q, ROWS[0])
+
+
+def test_malformed_query_raises_even_with_no_rows():
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
+    assert filter_rows("food", []) == []
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..8004640
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,149 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def _e(day: str, category: str = "通信", amount: int = 3000, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+@pytest.mark.parametrize(
+    ("src", "expected"),
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2024, 1, 31), date(2024, 2, 29)),
+        (date(2026, 12, 15), date(2027, 1, 15)),
+        (date(2026, 11, 30), date(2026, 12, 30)),
+        (date(2026, 3, 31), date(2026, 4, 30)),
+    ],
+)
+def test_add_month_clamps_to_month_end(src, expected):
+    assert add_month(src) == expected
+
+
+def test_monthly_series_detected_with_next_expected():
+    rows = [_e("2026-01-10"), _e("2026-02-10"), _e("2026-03-10")]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="通信",
+            amount=3000,
+            days=(date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10)),
+            next_expected=date(2026, 4, 10),
+        )
+    ]
+
+
+def test_memo_is_ignored_in_grouping():
+    rows = [_e("2026-01-10", memo="a"), _e("2026-02-10", memo="b"), _e("2026-03-10")]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert len(result[0].days) == 3
+
+
+def test_duplicate_dates_are_collapsed():
+    rows = [_e("2026-01-10"), _e("2026-01-10"), _e("2026-02-10"), _e("2026-03-10")]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10))
+
+
+def test_different_amount_or_category_is_separate_group():
+    rows = [
+        _e("2026-01-10", amount=3000),
+        _e("2026-02-10", amount=3000),
+        _e("2026-03-10", amount=3001),
+        _e("2026-01-10", category="食費", amount=3000),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_below_min_count_is_not_reported():
+    rows = [_e("2026-01-10"), _e("2026-02-10")]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_count=2)) == 1
+
+
+def test_gap_beyond_tolerance_splits_runs():
+    # Jan 10 -> Feb 10 -> Mar 10 is one run; Apr 20 breaks it (expected Apr 10).
+    rows = [
+        _e("2026-01-10"),
+        _e("2026-02-10"),
+        _e("2026-03-10"),
+        _e("2026-04-20"),
+        _e("2026-05-20"),
+    ]
+    result = find_recurring(rows, min_count=3)
+    assert [r.days for r in result] == [
+        (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10)),
+    ]
+
+
+def test_tolerance_allows_small_drift():
+    rows = [_e("2026-01-10"), _e("2026-02-13"), _e("2026-03-10")]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+    assert find_recurring(rows, tolerance=2) == []
+
+
+def test_zero_tolerance_requires_exact_day():
+    rows = [_e("2026-01-10"), _e("2026-02-10"), _e("2026-03-10")]
+    assert len(find_recurring(rows, tolerance=0)) == 1
+
+
+def test_month_end_day_links_via_clamped_add_month():
+    rows = [_e("2026-01-31"), _e("2026-02-28"), _e("2026-03-31")]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 30)
+
+
+def test_next_expected_uses_last_date_of_run():
+    rows = [_e("2026-01-10"), _e("2026-02-10"), _e("2026-03-10"), _e("2026-04-10")]
+    result = find_recurring(rows, min_count=3)
+    assert result[0].next_expected == date(2026, 5, 10)
+
+
+def test_results_sorted_by_category_amount_then_first_day():
+    rows = [
+        _e("2026-01-05", category="通信", amount=3000),
+        _e("2026-02-05", category="通信", amount=3000),
+        _e("2026-03-05", category="通信", amount=3000),
+        _e("2026-01-01", category="家賃", amount=80000),
+        _e("2026-02-01", category="家賃", amount=80000),
+        _e("2026-03-01", category="家賃", amount=80000),
+        _e("2026-01-02", category="家賃", amount=10000),
+        _e("2026-02-02", category="家賃", amount=10000),
+        _e("2026-03-02", category="家賃", amount=10000),
+    ]
+    keys = [(r.category, r.amount) for r in find_recurring(rows)]
+    assert keys == [("家賃", 10000), ("家賃", 80000), ("通信", 3000)]
+
+
+def test_same_group_two_separate_runs_both_reported():
+    rows = [
+        _e("2026-01-10"),
+        _e("2026-02-10"),
+        _e("2026-03-10"),
+        _e("2026-08-10"),
+        _e("2026-09-10"),
+        _e("2026-10-10"),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 10), date(2026, 8, 10)]
+
+
+def test_empty_input_returns_empty_list():
+    assert find_recurring([]) == []
+
+
+def test_invalid_min_count_raises():
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+
+
+def test_invalid_tolerance_raises():
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
