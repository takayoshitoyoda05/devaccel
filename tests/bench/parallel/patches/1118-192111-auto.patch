@@ -0,0 +1,57 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.dupes import find_duplicates
+
+A = Expense(date(2026, 11, 1), "food", 1200, "lunch")
+B = Expense(date(2026, 11, 2), "rent", 80000, "")
+
+
+def test_empty_list_has_no_pairs():
+    assert find_duplicates([]) == []
+
+
+def test_single_record_has_no_pairs():
+    assert find_duplicates([A]) == []
+
+
+def test_distinct_records_have_no_pairs():
+    assert find_duplicates([A, B]) == []
+
+
+def test_one_duplicate_pair():
+    assert find_duplicates([A, B, A]) == [(0, 2)]
+
+
+def test_three_identical_records_give_all_pairs_in_order():
+    assert find_duplicates([A, A, A]) == [(0, 1), (0, 2), (1, 2)]
+
+
+def test_interleaved_groups_sorted_by_i_then_j():
+    assert find_duplicates([A, B, A, B]) == [(0, 2), (1, 3)]
+
+
+def test_mixed_groups_sorted_by_i_then_j():
+    assert find_duplicates([A, A, B, A]) == [(0, 1), (0, 3), (1, 3)]
+
+
+@pytest.mark.parametrize(
+    "other",
+    [
+        Expense(date(2026, 11, 2), "food", 1200, "lunch"),  # day differs
+        Expense(date(2026, 11, 1), "rent", 1200, "lunch"),  # category differs
+        Expense(date(2026, 11, 1), "food", 1300, "lunch"),  # amount differs
+        Expense(date(2026, 11, 1), "food", 1200, "dinner"),  # memo differs
+        Expense(date(2026, 11, 1), "food", 1200, ""),  # memo empty vs set
+    ],
+)
+def test_any_differing_field_is_not_duplicate(other):
+    assert find_duplicates([A, other]) == []
+
+
+def test_pairs_are_index_pairs_with_i_less_than_j():
+    pairs = find_duplicates([B, A, B, A, A])
+    assert pairs == [(0, 2), (1, 3), (1, 4), (3, 4)]
+    assert all(i < j for i, j in pairs)
