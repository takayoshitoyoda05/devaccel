+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.stats import median_by_category
+
+
+def _e(category: str, amount: int) -> Expense:
+    return Expense(day=date(2026, 11, 1), category=category, amount=amount)
+
+
+def test_empty_returns_empty_dict():
+    assert median_by_category([]) == {}
+
+
+def test_single_expense_is_its_own_median():
+    assert median_by_category([_e("food", 350)]) == {"food": 350.0}
+
+
+def test_odd_count_returns_middle_value_regardless_of_input_order():
+    rows = [_e("food", 300), _e("food", 100), _e("food", 200)]
+    assert median_by_category(rows) == {"food": 200.0}
+
+
+def test_even_count_returns_mean_of_two_middle_values():
+    rows = [_e("food", 100), _e("food", 400), _e("food", 300), _e("food", 200)]
+    # sorted: 100, 200, 300, 400 -> middle 200 and 300 -> 250
+    assert median_by_category(rows) == {"food": 250.0}
+
+
+def test_even_count_with_two_values_averages_them():
+    rows = [_e("food", 100), _e("food", 301)]
+    assert median_by_category(rows) == {"food": 200.5}
+
+
+def test_identical_values_return_that_value():
+    rows = [_e("rent", 80000), _e("rent", 80000), _e("rent", 80000)]
+    assert median_by_category(rows) == {"rent": 80000.0}
+
+
+def test_result_values_are_floats():
+    result = median_by_category([_e("food", 100), _e("food", 200)])
+    assert isinstance(result["food"], float)
+
+
+def test_categories_are_computed_independently():
+    rows = [
+        _e("food", 100),
+        _e("food", 900),
+        _e("food", 500),
+        _e("transport", 50),
+        _e("transport", 70),
+    ]
+    assert median_by_category(rows) == {"food": 500.0, "transport": 60.0}
+
+
+def test_keys_are_sorted_by_category_name_ascending():
+    rows = [_e("zeta", 1), _e("alpha", 999), _e("mid", 5)]
+    result = median_by_category(rows)
+    assert list(result) == ["alpha", "mid", "zeta"]
+
+
+def test_keys_sorted_by_name_not_by_median_or_first_appearance():
+    rows = [_e("b", 10), _e("a", 1000), _e("c", 500)]
+    assert list(median_by_category(rows)) == ["a", "b", "c"]
