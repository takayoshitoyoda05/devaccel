@@ -0,0 +1,17 @@
+"""Top-N expenses by amount."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def top_expenses(rows: list[Expense], n: int) -> list[Expense]:
+    """Return up to n expenses, largest amount first.
+
+    Ties on amount are broken by earlier date, then by input order.
+    Returns [] when n <= 0. Does not modify rows.
+    """
+    if n <= 0:
+        return []
+    ordered = sorted(rows, key=lambda e: (-e.amount, e.day))
+    return ordered[:n]
