diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..0368172
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,205 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def e(day: str, cat: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=cat, amount=amount)
+
+
+ROWS = [
+    e("2024-01-05", "food", 1000),
+    e("2024-01-20", "food", 500),
+    e("2024-01-10", "rent", 5000),
+    e("2024-01-11", "books", 2000),
+    e("2024-02-03", "food", 1800),
+    e("2024-02-08", "rent", 5000),
+    e("2024-02-09", "fun", 300),
+    e("2024-02-12", "zero", 0),
+    e("2023-12-31", "old", 999),  # outside the compared months
+]
+
+
+def by_cat(rows: list[DiffRow]) -> dict[str, DiffRow]:
+    return {r.category: r for r in rows}
+
+
+# --- month format ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "bad", ["2024-1", "2024-13", "2024-00", "24-01", "2024/01", "2024-01-01", ""]
+)
+def test_invalid_month_raises(bad: str) -> None:
+    with pytest.raises(ValueError):
+        month_diff(ROWS, bad, "2024-02")
+    with pytest.raises(ValueError):
+        month_diff(ROWS, "2024-01", bad)
+
+
+# --- month_diff -----------------------------------------------------------
+
+
+def test_values_delta_pct_and_status() -> None:
+    d = by_cat(month_diff(ROWS, "2024-01", "2024-02"))
+    assert d["food"] == DiffRow("food", 1500, 1800, 300, 20.0, "up")
+    assert d["rent"] == DiffRow("rent", 5000, 5000, 0, 0.0, "same")
+    assert d["books"] == DiffRow("books", 2000, 0, -2000, -100.0, "gone")
+    assert d["fun"] == DiffRow("fun", 0, 300, 300, None, "new")
+
+
+def test_down_status_and_pct() -> None:
+    rows = [e("2024-01-01", "a", 1000), e("2024-02-01", "a", 750)]
+    (r,) = month_diff(rows, "2024-01", "2024-02")
+    assert (r.delta, r.pct, r.status) == (-250, -25.0, "down")
+
+
+def test_only_categories_in_either_month_and_other_months_ignored() -> None:
+    cats = {r.category for r in month_diff(ROWS, "2024-01", "2024-02")}
+    assert cats == {"food", "rent", "books", "fun", "zero"}
+    assert "old" not in cats
+
+
+def test_zero_total_with_entries_counts_as_present_and_pct_is_none() -> None:
+    rows = [e("2024-01-01", "z", 0), e("2024-02-01", "z", 0)]
+    (r,) = month_diff(rows, "2024-01", "2024-02")
+    assert r == DiffRow("z", 0, 0, 0, None, "same")
+
+
+def test_zero_total_prev_with_entries_then_curr_has_amount_is_new_status_by_presence() -> (
+    None
+):
+    rows = [e("2024-01-01", "z", 0), e("2024-02-01", "z", 400)]
+    (r,) = month_diff(rows, "2024-01", "2024-02")
+    # prev has entries (sum 0), so this is not "new"; delta>0 -> up, pct undefined
+    assert (r.status, r.pct, r.delta) == ("up", None, 400)
+
+
+def test_gone_when_curr_has_no_entries_even_if_sum_is_zero() -> None:
+    rows = [e("2024-01-01", "z", 300), e("2024-02-01", "z", 0)]
+    (r,) = month_diff(rows, "2024-01", "2024-02")
+    assert (r.status, r.delta, r.pct) == ("down", -300, -100.0)
+
+
+def test_sorted_by_abs_delta_desc_then_category_asc() -> None:
+    rows = [
+        e("2024-01-01", "b", 100),
+        e("2024-02-01", "b", 200),  # delta +100
+        e("2024-01-01", "a", 500),
+        e("2024-02-01", "a", 400),  # delta -100
+        e("2024-02-01", "c", 1000),  # delta +1000
+    ]
+    names = [r.category for r in month_diff(rows, "2024-01", "2024-02")]
+    assert names == ["c", "a", "b"]
+
+
+def test_negative_zero_pct_is_not_rendered_as_negative_zero() -> None:
+    rows = [e("2024-01-01", "a", 10000), e("2024-02-01", "a", 9999)]
+    (r,) = month_diff(rows, "2024-01", "2024-02")
+    assert r.status == "down"
+    assert render_diff([r]).splitlines()[1].endswith("\t+0.0%")
+
+
+def test_empty_rows_gives_empty_list() -> None:
+    assert month_diff([], "2024-01", "2024-02") == []
+
+
+# --- top_movers -----------------------------------------------------------
+
+
+def test_top_movers_excludes_same_and_keeps_order() -> None:
+    d = month_diff(ROWS, "2024-01", "2024-02")
+    got = [r.category for r in top_movers(d, 10)]
+    # books(|-2000|), food(300), fun(300, tie broken by name), zero(new, delta 0)
+    assert got == ["books", "food", "fun", "zero"]
+    assert "rent" not in got
+
+
+def test_top_movers_default_is_three() -> None:
+    d = month_diff(ROWS, "2024-01", "2024-02")
+    assert len(top_movers(d)) == 3
+    assert top_movers(d) == [r for r in d if r.status != "same"][:3]
+
+
+def test_top_movers_zero_and_large_n() -> None:
+    d = month_diff(ROWS, "2024-01", "2024-02")
+    assert top_movers(d, 0) == []
+    assert top_movers(d, 100) == [r for r in d if r.status != "same"]
+
+
+def test_top_movers_negative_n_raises() -> None:
+    with pytest.raises(ValueError):
+        top_movers([], -1)
+
+
+# --- render_diff ----------------------------------------------------------
+
+
+def test_render_format() -> None:
+    d = [
+        DiffRow("food", 1500, 1800, 300, 20.0, "up"),
+        DiffRow("books", 2000, 0, -2000, -100.0, "gone"),
+        DiffRow("rent", 5000, 5000, 0, 0.0, "same"),
+        DiffRow("fun", 0, 300, 300, None, "new"),
+    ]
+    assert render_diff(d) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "food\t1500\t1800\t+300\t+20.0%\n"
+        "books\t2000\t0\t-2000\t-100.0%\n"
+        "rent\t5000\t5000\t+0\t+0.0%\n"
+        "fun\t0\t300\t+300\t-"
+    )
+
+
+def test_render_empty_is_header_only_without_trailing_newline() -> None:
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+# --- available_months / latest_diff --------------------------------------
+
+
+def test_available_months_sorted_unique_across_years() -> None:
+    rows = [
+        e("2024-02-01", "a", 1),
+        e("2023-12-31", "a", 1),
+        e("2024-02-28", "b", 1),
+        e("2024-01-01", "a", 1),
+    ]
+    assert available_months(rows) == ["2023-12", "2024-01", "2024-02"]
+
+
+def test_available_months_empty() -> None:
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months() -> None:
+    assert latest_diff(ROWS) == month_diff(ROWS, "2024-01", "2024-02")
+
+
+def test_latest_diff_uses_last_two_when_more_months_exist() -> None:
+    rows = ROWS + [e("2024-03-01", "food", 100)]
+    assert latest_diff(rows) == month_diff(rows, "2024-02", "2024-03")
+
+
+@pytest.mark.parametrize(
+    "rows",
+    [
+        [],
+        [e("2024-01-01", "a", 1), e("2024-01-02", "b", 2)],
+    ],
+)
+def test_latest_diff_needs_two_months(rows: list[Expense]) -> None:
+    with pytest.raises(ValueError):
+        latest_diff(rows)
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..e46ae97
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,241 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def _e(category: str = "食費", memo: str = "", amount: int = 500) -> Expense:
+    return Expense(day=date(2026, 1, 5), category=category, amount=amount, memo=memo)
+
+
+# --- tokenize ---------------------------------------------------------------
+
+
+def test_tokenize_splits_on_whitespace() -> None:
+    assert tokenize("  食費   ランチ ") == [("TERM", "食費"), ("TERM", "ランチ")]
+
+
+def test_tokenize_only_whitespace_gives_no_tokens() -> None:
+    assert tokenize("   ") == []
+
+
+def test_tokenize_parens() -> None:
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+
+
+def test_tokenize_quoted_term_keeps_spaces_and_parens() -> None:
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+
+
+def test_tokenize_unclosed_quote_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_uppercase_operators() -> None:
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+
+
+def test_tokenize_lowercase_operators_are_terms() -> None:
+    assert tokenize("and or not") == [
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_quoted_operator_is_term() -> None:
+    assert tokenize('"AND"') == [("TERM", "AND")]
+
+
+def test_tokenize_cat_prefix() -> None:
+    assert tokenize("cat:食費 x") == [("CAT", "食費"), ("TERM", "x")]
+
+
+def test_tokenize_empty_cat_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_tokenize_cat_prefix_is_case_sensitive() -> None:
+    assert tokenize("Cat:x") == [("TERM", "Cat:x")]
+
+
+def test_tokenize_word_stops_at_paren_and_quote() -> None:
+    assert tokenize('a)b"c"') == [
+        ("TERM", "a"),
+        ("RPAREN", ")"),
+        ("TERM", "b"),
+        ("TERM", "c"),
+    ]
+
+
+# --- matches: TERM / CAT -----------------------------------------------------
+
+
+def test_term_matches_memo_substring() -> None:
+    assert matches("ランチ", _e(memo="駅前ランチ"))
+
+
+def test_term_matches_category_substring() -> None:
+    assert matches("食", _e(category="食費"))
+
+
+def test_term_does_not_match_amount_or_date() -> None:
+    assert not matches("500", _e(amount=500, memo="x"))
+    assert not matches("2026", _e(memo="x"))
+
+
+def test_term_is_case_insensitive() -> None:
+    assert matches("lunch", _e(memo="LUNCH"))
+
+
+def test_term_uses_casefold() -> None:
+    assert matches("STRASSE", _e(memo="straße"))
+
+
+def test_cat_exact_match_on_category() -> None:
+    assert matches("cat:食費", _e(category="食費"))
+
+
+def test_cat_is_not_substring() -> None:
+    assert not matches("cat:食", _e(category="食費"))
+
+
+def test_cat_is_case_insensitive() -> None:
+    assert matches("cat:FOOD", _e(category="food"))
+
+
+def test_cat_does_not_match_memo() -> None:
+    assert not matches("cat:ランチ", _e(category="食費", memo="ランチ"))
+
+
+# --- matches: operators and precedence ---------------------------------------
+
+
+def test_implicit_and_requires_all_terms() -> None:
+    e = _e(memo="ランチ")
+    assert matches("食費 ランチ", e)
+    assert not matches("食費 ディナー", e)
+
+
+def test_explicit_and() -> None:
+    e = _e(memo="ランチ")
+    assert matches("食費 AND ランチ", e)
+    assert not matches("食費 AND ディナー", e)
+
+
+def test_or() -> None:
+    e = _e(memo="ランチ")
+    assert matches("ディナー OR ランチ", e)
+    assert not matches("ディナー OR 朝食", e)
+
+
+def test_not() -> None:
+    assert matches("NOT ランチ", _e(memo="朝食"))
+    assert not matches("NOT ランチ", _e(memo="ランチ"))
+
+
+def test_double_not() -> None:
+    assert matches("NOT NOT ランチ", _e(memo="ランチ"))
+
+
+def test_and_binds_tighter_than_or() -> None:
+    # a OR (b AND c)
+    assert matches("a OR b c", _e(memo="a"))
+    assert matches("a OR b c", _e(memo="b c"))
+    assert not matches("a OR b c", _e(memo="b"))
+
+
+def test_not_binds_tighter_than_and() -> None:
+    # (NOT a) AND b
+    assert matches("NOT a b", _e(memo="b"))
+    assert not matches("NOT a b", _e(memo="a b"))
+
+
+def test_not_binds_tighter_than_or() -> None:
+    # (NOT a) OR b
+    assert matches("NOT a OR b", _e(memo="z"))
+    assert matches("NOT a OR b", _e(memo="a b"))
+    assert not matches("NOT a OR b", _e(memo="a"))
+
+
+def test_explicit_and_with_not() -> None:
+    assert matches("食費 AND NOT ランチ", _e(memo="朝食"))
+    assert not matches("食費 AND NOT ランチ", _e(memo="ランチ"))
+
+
+def test_parens_override_precedence() -> None:
+    # (a OR b) AND c
+    assert not matches("(a OR b) c", _e(memo="a"))
+    assert matches("(a OR b) c", _e(memo="a c"))
+
+
+def test_quoted_term_with_space() -> None:
+    assert matches('"駅前 ランチ"', _e(memo="駅前 ランチ"))
+    assert not matches('"駅前 ランチ"', _e(memo="駅前"))
+
+
+def test_term_matches_quoted_operator_text() -> None:
+    assert matches('"AND"', _e(memo="A AND B"))
+
+
+# --- filter_rows -------------------------------------------------------------
+
+
+def test_filter_rows_keeps_input_order() -> None:
+    rows = [
+        _e(memo="ランチ", amount=1),
+        _e(memo="朝食", amount=2),
+        _e(memo="ランチ 夜", amount=3),
+    ]
+    assert [r.amount for r in filter_rows("ランチ", rows)] == [1, 3]
+
+
+def test_filter_rows_empty_input_returns_empty() -> None:
+    assert filter_rows("ランチ", []) == []
+
+
+def test_filter_rows_invalid_query_with_empty_rows_raises() -> None:
+    with pytest.raises(QueryError):
+        filter_rows("a AND", [])
+
+
+def test_matches_invalid_query_raises() -> None:
+    with pytest.raises(QueryError):
+        matches("(a", _e())
+
+
+# --- grammar errors ----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "a AND",
+        "AND a",
+        "a OR",
+        "OR a",
+        "NOT",
+        "a OR OR b",
+        "a AND AND b",
+        "a AND OR b",
+        "()",
+        "a ()",
+        "(a",
+        "a)",
+        "((a)",
+    ],
+)
+def test_grammar_errors(q: str) -> None:
+    with pytest.raises(QueryError):
+        matches(q, _e())
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..6c63f36
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,238 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def _e(day: str, category: str = "通信", amount: int = 1000, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+# --- add_month -------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("src", "expected"),
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),  # 月末に clamp(平年)
+        (date(2024, 1, 31), date(2024, 2, 29)),  # 月末に clamp(閏年)
+        (date(2026, 12, 15), date(2027, 1, 15)),  # 年またぎ
+        (date(2026, 3, 31), date(2026, 4, 30)),  # 30 日までの月に clamp
+        (date(2026, 11, 30), date(2026, 12, 30)),  # 同日がある通常ケース
+    ],
+)
+def test_add_month(src: date, expected: date) -> None:
+    assert add_month(src) == expected
+
+
+# --- find_recurring: 引数検査 -------------------------------------------------
+
+
+def test_min_count_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+
+
+def test_negative_tolerance_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_min_count_two_and_zero_tolerance_are_allowed() -> None:
+    assert find_recurring([], min_count=2, tolerance=0) == []
+
+
+def test_empty_input_returns_empty() -> None:
+    assert find_recurring([]) == []
+
+
+# --- find_recurring: 基本 -----------------------------------------------------
+
+
+def test_monthly_series_detected() -> None:
+    rows = [_e("2026-01-10"), _e("2026-02-10"), _e("2026-03-10")]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="通信",
+            amount=1000,
+            days=(date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10)),
+            next_expected=date(2026, 4, 10),
+        )
+    ]
+
+
+def test_memo_is_ignored_when_grouping() -> None:
+    rows = [
+        _e("2026-01-10", memo="a"),
+        _e("2026-02-10", memo="b"),
+        _e("2026-03-10", memo=""),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10))
+
+
+def test_input_order_does_not_matter() -> None:
+    rows = [_e("2026-03-10"), _e("2026-01-10"), _e("2026-02-10")]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10))
+
+
+def test_different_amounts_are_separate_groups() -> None:
+    rows = [
+        _e("2026-01-10", amount=1000),
+        _e("2026-02-10", amount=1000),
+        _e("2026-03-10", amount=1000),
+        _e("2026-01-10", amount=500),
+        _e("2026-02-10", amount=500),
+    ]
+    result = find_recurring(rows)
+    # 金額 500 は 2 件しかないので min_count=3 に届かない
+    assert [(r.category, r.amount) for r in result] == [("通信", 1000)]
+
+
+def test_different_categories_are_separate_groups() -> None:
+    rows = [
+        _e("2026-01-10", category="家賃"),
+        _e("2026-02-10", category="家賃"),
+        _e("2026-03-10", category="家賃"),
+        _e("2026-01-10", category="通信"),
+        _e("2026-02-10", category="通信"),
+        _e("2026-03-10", category="通信"),
+    ]
+    result = find_recurring(rows)
+    assert [r.category for r in result] == ["家賃", "通信"]
+
+
+# --- find_recurring: min_count の境界 ----------------------------------------
+
+
+def test_run_shorter_than_min_count_is_dropped() -> None:
+    rows = [_e("2026-01-10"), _e("2026-02-10")]
+    assert find_recurring(rows, min_count=3) == []
+
+
+def test_run_equal_to_min_count_is_kept() -> None:
+    rows = [_e("2026-01-10"), _e("2026-02-10")]
+    result = find_recurring(rows, min_count=2)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 10))
+
+
+# --- find_recurring: 日付の重複 -----------------------------------------------
+
+
+def test_duplicate_dates_are_counted_once() -> None:
+    # 2026-02-10 が 2 件あっても distinct 日付は 2 つだけ → min_count=3 に届かない
+    rows = [_e("2026-01-10"), _e("2026-02-10"), _e("2026-02-10")]
+    assert find_recurring(rows, min_count=3) == []
+
+
+def test_duplicate_dates_do_not_break_chain() -> None:
+    rows = [
+        _e("2026-01-10"),
+        _e("2026-01-10"),
+        _e("2026-02-10"),
+        _e("2026-03-10"),
+    ]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10))
+
+
+# --- find_recurring: tolerance ------------------------------------------------
+
+
+def test_gap_within_tolerance_is_connected() -> None:
+    # add_month(2026-02-10)=2026-03-10。+3 日ずれは tolerance=3 で許容
+    rows = [_e("2026-01-10"), _e("2026-02-10"), _e("2026-03-13")]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days[-1] == date(2026, 3, 13)
+
+
+def test_gap_just_over_tolerance_splits_series() -> None:
+    # +4 日ずれは tolerance=3 を超える → 切れる(後半 2 件は min_count=3 に届かない)
+    rows = [_e("2026-01-10"), _e("2026-02-10"), _e("2026-03-14"), _e("2026-04-14")]
+    assert find_recurring(rows) == []
+
+
+def test_negative_gap_within_tolerance_is_connected() -> None:
+    # add_month(2026-02-10)=2026-03-10。-3 日ずれも許容
+    rows = [_e("2026-01-10"), _e("2026-02-10"), _e("2026-03-07")]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_zero_tolerance_requires_exact_day() -> None:
+    rows = [_e("2026-01-10"), _e("2026-02-10"), _e("2026-03-11")]
+    assert find_recurring(rows, tolerance=0) == []
+
+
+def test_month_end_chain_uses_clamped_expectation() -> None:
+    # add_month(01-31)=02-28、add_month(02-28)=03-28。03-31 は +3 日で許容
+    rows = [_e("2026-01-31"), _e("2026-02-28"), _e("2026-03-31")]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 30)
+
+
+# --- find_recurring: 区間の分割 ----------------------------------------------
+
+
+def test_series_split_into_two_runs_by_gap() -> None:
+    rows = [
+        _e("2026-01-10"),
+        _e("2026-02-10"),
+        _e("2026-03-10"),
+        # 2026-04-10 が抜けて 2026-06-10 → 切れる
+        _e("2026-06-10"),
+        _e("2026-07-10"),
+        _e("2026-08-10"),
+    ]
+    result = find_recurring(rows)
+    assert [r.days for r in result] == [
+        (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10)),
+        (date(2026, 6, 10), date(2026, 7, 10), date(2026, 8, 10)),
+    ]
+    assert [r.next_expected for r in result] == [date(2026, 4, 10), date(2026, 9, 10)]
+
+
+def test_short_run_after_split_is_dropped_but_long_one_kept() -> None:
+    rows = [
+        _e("2026-01-10"),
+        _e("2026-02-10"),
+        _e("2026-06-10"),
+        _e("2026-07-10"),
+        _e("2026-08-10"),
+    ]
+    result = find_recurring(rows, min_count=3)
+    assert len(result) == 1
+    assert result[0].days[0] == date(2026, 6, 10)
+
+
+# --- find_recurring: 出力の並び -----------------------------------------------
+
+
+def test_output_sorted_by_category_then_amount_then_first_day() -> None:
+    rows = [
+        _e("2026-01-10", category="通信", amount=500),
+        _e("2026-02-10", category="通信", amount=500),
+        _e("2026-03-10", category="通信", amount=500),
+        _e("2026-01-05", category="家賃", amount=900),
+        _e("2026-02-05", category="家賃", amount=900),
+        _e("2026-03-05", category="家賃", amount=900),
+        _e("2026-01-20", category="家賃", amount=100),
+        _e("2026-02-20", category="家賃", amount=100),
+        _e("2026-03-20", category="家賃", amount=100),
+    ]
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [
+        ("家賃", 100),
+        ("家賃", 900),
+        ("通信", 500),
+    ]
