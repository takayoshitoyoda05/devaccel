@@ -0,0 +1,190 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+HEADER = "利用日,分類,利用金額,利用店名"
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("-980円", -980),
+        ("¥5", 5),
+        ("￥5", 5),
+        ("1,2,3", 123),  # comma positions are not checked
+    ],
+)
+def test_parse_amount_valid(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "   ",
+        "円",
+        "¥",
+        "-",
+        "12.5",
+        "1 200",
+        "--5",
+        "¥-5",
+        "１２３",
+        ",5",
+        "5円円",
+        "円5",
+        "5 円",
+    ],
+)
+def test_parse_amount_invalid(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/12/31 ", date(2026, 12, 31)),
+        ("2026-1-05", date(2026, 1, 5)),
+    ],
+)
+def test_parse_date_valid(text: str, expected: date) -> None:
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026/1-5",
+        "26/1/5",
+        "2026/02/30",
+        "2026.1.5",
+        "2026/1/5/",
+        "２０２６/1/5",
+        "",
+        "2026/13/1",
+    ],
+)
+def test_parse_date_invalid(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+def test_default_mapping_values() -> None:
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_import_basic_keeps_order_and_ignores_extra_columns() -> None:
+    text = (
+        HEADER + ',備考\n2026/1/5,食費,"1,200",スーパー,x\n2026/1/6,交通費,300,駅,y\n'
+    )
+    expenses, errors = import_rows(text)
+    assert errors == []
+    assert expenses == [
+        Expense(date(2026, 1, 5), "食費", 1200, "スーパー"),
+        Expense(date(2026, 1, 6), "交通費", 300, "駅"),
+    ]
+
+
+def test_quoted_comma_in_memo() -> None:
+    text = HEADER + '\n2026/1/5,食費,100,"A, B"\n'
+    expenses, _ = import_rows(text)
+    assert expenses[0].memo == "A, B"
+
+
+def test_custom_mapping_and_category_map() -> None:
+    text = "日付,費目,金額,店\n2026/1/5, 食費 ,¥100,店A\n"
+    mapping = {"date": "日付", "category": "費目", "amount": "金額", "memo": "店"}
+    expenses, errors = import_rows(text, mapping, {"食費": "Food"})
+    assert errors == []
+    assert expenses == [Expense(date(2026, 1, 5), "Food", 100, "店A")]
+
+
+def test_category_map_only_replaces_keys_present() -> None:
+    text = HEADER + "\n2026/1/5,交通費,100,x\n"
+    expenses, _ = import_rows(text, category_map={"食費": "Food"})
+    assert expenses[0].category == "交通費"
+
+
+def test_memo_is_stripped() -> None:
+    text = HEADER + "\n2026/1/5,食費,100,  店  \n"
+    expenses, _ = import_rows(text)
+    assert expenses[0].memo == "店"
+
+
+def test_mapping_missing_required_key_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows(HEADER + "\n", {"date": "利用日", "amount": "利用金額"})
+
+
+def test_mapping_without_memo_gives_empty_memo() -> None:
+    text = HEADER + "\n2026/1/5,食費,100,店\n"
+    expenses, errors = import_rows(
+        text, {"date": "利用日", "category": "分類", "amount": "利用金額"}
+    )
+    assert errors == []
+    assert expenses[0].memo == ""
+
+
+def test_mapping_column_missing_from_header_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows(HEADER + "\n", {**DEFAULT_MAPPING, "memo": "存在しない列"})
+
+
+def test_header_only_returns_nothing() -> None:
+    assert import_rows(HEADER + "\n") == ([], [])
+
+
+def test_blank_lines_skipped_but_counted() -> None:
+    text = "利用日,分類,利用金額\n\n2026/1/5,食費,100\n,x,abc\n"
+    expenses, errors = import_rows(
+        text, {"date": "利用日", "category": "分類", "amount": "利用金額"}
+    )
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "")]
+    assert errors == [(4, "date"), (4, "amount")]
+
+
+def test_empty_category_is_error() -> None:
+    text = HEADER + "\n2026/1/5, ,100,x\n"
+    expenses, errors = import_rows(text)
+    assert expenses == []
+    assert errors == [(2, "category")]
+
+
+def test_all_errors_in_a_row_reported_in_order() -> None:
+    text = HEADER + "\nbad, ,abc,x\n"
+    expenses, errors = import_rows(text)
+    assert expenses == []
+    assert errors == [(2, "date"), (2, "amount"), (2, "category")]
+
+
+def test_short_row_treats_missing_values_as_empty() -> None:
+    text = HEADER + "\n2026/1/5,食費,100\n2026/1/5,食費\n"
+    expenses, errors = import_rows(text)
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "")]
+    assert errors == [(3, "amount")]
+
+
+def test_error_rows_excluded_and_line_numbers_are_physical() -> None:
+    # Row 2 spans two physical lines (quoted newline); the bad row is on line 4.
+    text = HEADER + '\n2026/1/5,食費,100,"a\nb"\nbad,食費,100,x\n2026/1/7,食費,200,c\n'
+    expenses, errors = import_rows(text)
+    assert errors == [(4, "date")]
+    assert [e.amount for e in expenses] == [100, 200]
