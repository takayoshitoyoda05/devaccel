+"""Statistics over expense records."""
+
+from __future__ import annotations
+
+from statistics import median
+
+from kakeibo.core import Expense
+
+
+def median_by_category(rows: list[Expense]) -> dict[str, float]:
+    """{category: median amount}; categories ascending by name, {} if rows is empty."""
+    by_cat: dict[str, list[int]] = {}
+    for e in rows:
+        by_cat.setdefault(e.category, []).append(e.amount)
+    return {cat: float(median(by_cat[cat])) for cat in sorted(by_cat)}
