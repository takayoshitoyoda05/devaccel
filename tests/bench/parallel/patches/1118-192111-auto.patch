+"""Yen formatting helpers."""
+
+from __future__ import annotations
+
+
+def yen(n: int) -> str:
+    """Format an integer yen amount with thousands separators and a 円 suffix.
+
+    >>> yen(1234567)
+    '1,234,567円'
+    >>> yen(-1200)
+    '-1,200円'
+    """
+    return f"{n:,}円"
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
new file mode 100644
index 0000000..f3632ea
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,97 @@
+"""Month-over-month category comparison."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def _month_of(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+    # A key is present in these dicts iff the category has at least one expense
+    # in that month (presence is decided by records, not by the sum).
+    prev_sum: dict[str, int] = {}
+    curr_sum: dict[str, int] = {}
+    for e in rows:
+        m = _month_of(e)
+        if m == prev_month:
+            prev_sum[e.category] = prev_sum.get(e.category, 0) + e.amount
+        elif m == curr_month:
+            curr_sum[e.category] = curr_sum.get(e.category, 0) + e.amount
+
+    out: list[DiffRow] = []
+    for cat in prev_sum.keys() | curr_sum.keys():
+        prev = prev_sum.get(cat, 0)
+        curr = curr_sum.get(cat, 0)
+        delta = curr - prev
+        pct = round(delta / prev * 100, 1) if prev != 0 else None
+        if cat not in prev_sum:
+            status = "new"
+        elif cat not in curr_sum:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+    out.sort(key=lambda r: (-abs(r.delta), r.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [d for d in diffs if d.status != "same"][:n]
+
+
+def _fmt_pct(pct: float | None) -> str:
+    if pct is None:
+        return "-"
+    # +0.0 turns a negative zero (e.g. -0.01 rounded) into a plain zero.
+    return f"{pct + 0.0:+.1f}%"
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for d in diffs:
+        lines.append(
+            f"{d.category}\t{d.prev}\t{d.curr}\t{d.delta:+d}\t{_fmt_pct(d.pct)}"
+        )
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month_of(e) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には明細のある月が 2 つ以上必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..204978e
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,181 @@
+"""Search query language over Expense rows.
+
+Grammar (lowest precedence first):
+    or_expr  := and_expr ("OR" and_expr)*
+    and_expr := not_expr (["AND"] not_expr)*
+    not_expr := "NOT" not_expr | primary
+    primary  := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+
+class QueryError(ValueError):
+    """Raised when a search query is invalid."""
+
+
+@dataclass(frozen=True)
+class _Term:
+    value: str
+
+
+@dataclass(frozen=True)
+class _Cat:
+    value: str
+
+
+@dataclass(frozen=True)
+class _Not:
+    operand: _Node
+
+
+@dataclass(frozen=True)
+class _And:
+    left: _Node
+    right: _Node
+
+
+@dataclass(frozen=True)
+class _Or:
+    left: _Node
+    right: _Node
+
+
+_Node = _Term | _Cat | _Not | _And | _Or
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    tokens: list[tuple[str, str]] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end < 0:
+                raise QueryError("閉じていない引用符があります")
+            body = q[i + 1 : end]
+            if body == "":
+                raise QueryError("空の引用符は使えません")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            j = i
+            while j < n and not (q[j].isspace() or q[j] in '()"'):
+                j += 1
+            word = q[i:j]
+            i = j
+            if word in ("AND", "OR", "NOT"):
+                tokens.append((word, word))
+            elif word.startswith("cat:"):
+                value = word[len("cat:") :]
+                if value == "":
+                    raise QueryError("cat: の後ろが空です")
+                tokens.append(("CAT", value))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+class _Parser:
+    def __init__(self, tokens: list[tuple[str, str]]) -> None:
+        self.tokens = tokens
+        self.pos = 0
+
+    def _peek(self) -> str | None:
+        if self.pos < len(self.tokens):
+            return self.tokens[self.pos][0]
+        return None
+
+    def _take(self) -> tuple[str, str]:
+        tok = self.tokens[self.pos]
+        self.pos += 1
+        return tok
+
+    def parse(self) -> _Node:
+        if not self.tokens:
+            raise QueryError("検索式が空です")
+        node = self._or()
+        if self.pos != len(self.tokens):
+            raise QueryError(f"想定外のトークンです: {self.tokens[self.pos][1]!r}")
+        return node
+
+    def _or(self) -> _Node:
+        node = self._and()
+        while self._peek() == "OR":
+            self._take()
+            node = _Or(node, self._and())
+        return node
+
+    def _and(self) -> _Node:
+        node = self._not()
+        while True:
+            kind = self._peek()
+            if kind == "AND":
+                self._take()
+                node = _And(node, self._not())
+            elif kind in ("NOT", "TERM", "CAT", "LPAREN"):
+                node = _And(node, self._not())
+            else:
+                return node
+
+    def _not(self) -> _Node:
+        if self._peek() == "NOT":
+            self._take()
+            return _Not(self._not())
+        return self._primary()
+
+    def _primary(self) -> _Node:
+        kind = self._peek()
+        if kind == "TERM":
+            return _Term(self._take()[1])
+        if kind == "CAT":
+            return _Cat(self._take()[1])
+        if kind == "LPAREN":
+            self._take()
+            node = self._or()
+            if self._peek() != "RPAREN":
+                raise QueryError("閉じ括弧がありません")
+            self._take()
+            return node
+        if kind is None:
+            raise QueryError("検索式が途中で終わっています")
+        raise QueryError(f"項がありません: {self.tokens[self.pos][1]!r}")
+
+
+def _parse(q: str) -> _Node:
+    return _Parser(tokenize(q)).parse()
+
+
+def _eval(node: _Node, e: Expense) -> bool:
+    if isinstance(node, _Term):
+        v = node.value.casefold()
+        return v in e.memo.casefold() or v in e.category.casefold()
+    if isinstance(node, _Cat):
+        return node.value.casefold() == e.category.casefold()
+    if isinstance(node, _Not):
+        return not _eval(node.operand, e)
+    if isinstance(node, _And):
+        return _eval(node.left, e) and _eval(node.right, e)
+    return _eval(node.left, e) or _eval(node.right, e)
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _eval(_parse(q), e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    node = _parse(q)  # validate even when rows is empty
+    return [e for e in rows if _eval(node, e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..361378a
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,63 @@
+"""Detect recurring (periodic) expenses by (category, amount)."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import date, timedelta
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day in the next month, clamped to that month's last day."""
+    year = d.year + d.month // 12
+    month = d.month % 12 + 1
+    next_month_first = date(year + month // 12, month % 12 + 1, 1)
+    last_day = (next_month_first - timedelta(days=1)).day
+    return date(year, month, min(d.day, last_day))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError("min_count は 2 以上である必要があります")
+    if tolerance < 0:
+        raise ValueError("tolerance は 0 以上である必要があります")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    out: list[Recurring] = []
+
+    def flush(run: list[date]) -> None:
+        if len(run) >= min_count:
+            out.append(
+                Recurring(
+                    category=category,
+                    amount=amount,
+                    days=tuple(run),
+                    next_expected=add_month(run[-1]),
+                )
+            )
+
+    for (category, amount), dates in groups.items():
+        run: list[date] = []
+        for d in sorted(dates):
+            if run and abs((d - add_month(run[-1])).days) > tolerance:
+                flush(run)
+                run = []
+            run.append(d)
+        flush(run)
+
+    out.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return out
