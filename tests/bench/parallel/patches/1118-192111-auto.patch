diff --git a/src/kakeibo/bankimport.py b/src/kakeibo/bankimport.py
new file mode 100644
index 0000000..cd8b203
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,98 @@
+"""Import rows from a bank's CSV export into Expense records."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+# 任意の "-" → 任意の "¥"/"￥" → ASCII 数字で始まる数字・カンマ列 → 任意の "円"
+_AMOUNT_RE = re.compile(r"-?[¥￥]?[0-9][0-9,]*円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    """Parse a bank amount such as ``￥1,234`` or ``980円`` into yen."""
+    text = s.strip()
+    if not _AMOUNT_RE.fullmatch(text):
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    return int(re.sub(r"[¥￥円,]", "", text))
+
+
+def parse_date(s: str) -> date:
+    """Parse ``YYYY/M/D`` or ``YYYY-M-D`` (separator must be consistent)."""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Convert bank CSV text (header on line 1) into expenses.
+
+    Returns ``(expenses, errors)`` where each error is ``(line_number, field)``.
+    Rows with any error are left out of ``expenses``.
+    """
+    cols = DEFAULT_MAPPING if mapping is None else mapping
+    for key in ("date", "category", "amount"):
+        if key not in cols:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header = next(reader, [])
+    for name in cols.values():
+        if name not in header:
+            raise ValueError(f"CSV に列 {name!r} がありません")
+    positions = {field: header.index(name) for field, name in cols.items()}
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    prev_line = reader.line_num
+    for row in reader:
+        start = prev_line + 1  # physical line where this record begins
+        prev_line = reader.line_num
+        if all(not cell.strip() for cell in row):  # blank line
+            continue
+
+        def get(field: str, row: list[str] = row) -> str:
+            i = positions.get(field)
+            if i is None or i >= len(row):
+                return ""
+            return row[i]
+
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(get("date"))
+        except ValueError:
+            errors.append((start, "date"))
+        try:
+            amount = parse_amount(get("amount"))
+        except ValueError:
+            errors.append((start, "amount"))
+        category = get("category").strip()
+        if not category:
+            errors.append((start, "category"))
+
+        if day is None or amount is None or not category:
+            continue
+        if category_map:
+            category = category_map.get(category, category)
+        expenses.append(
+            Expense(day=day, category=category, amount=amount, memo=get("memo").strip())
+        )
+    return expenses, errors
