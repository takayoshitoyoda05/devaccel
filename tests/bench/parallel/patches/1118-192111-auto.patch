+"""Totals grouped by day of the week."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+# Index matches date.weekday(): Monday == 0.
+_WEEKDAYS = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
+
+
+def total_by_weekday(rows: list[Expense]) -> dict[str, int]:
+    """{"Mon".."Sun": yen}; weekdays without any expense are omitted, Monday first."""
+    sums: dict[int, int] = {}
+    for e in rows:
+        idx = e.day.weekday()
+        sums[idx] = sums.get(idx, 0) + e.amount
+    return {_WEEKDAYS[i]: sums[i] for i in sorted(sums)}
