@@ -0,0 +1,69 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.streak import longest_no_spend_streak
+
+
+def _e(day: date, amount: int = 100) -> Expense:
+    return Expense(day=day, category="food", amount=amount)
+
+
+def test_no_rows_means_whole_range_is_streak():
+    assert longest_no_spend_streak([], date(2026, 11, 1), date(2026, 11, 5)) == 5
+
+
+def test_single_day_range_without_spend_is_one():
+    assert longest_no_spend_streak([], date(2026, 11, 1), date(2026, 11, 1)) == 1
+
+
+def test_single_day_range_with_spend_is_zero():
+    rows = [_e(date(2026, 11, 1))]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 1)) == 0
+
+
+def test_every_day_has_spend_is_zero():
+    rows = [_e(date(2026, 11, d)) for d in range(1, 4)]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 3)) == 0
+
+
+def test_longest_run_in_the_middle():
+    rows = [_e(date(2026, 11, 1)), _e(date(2026, 11, 5))]
+    # 11/2〜11/4 が連続 3 日で最長
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 5)) == 3
+
+
+def test_run_at_start_boundary_is_included():
+    rows = [_e(date(2026, 11, 3))]
+    # 11/1〜11/2 が 2 日
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 5)) == 2
+
+
+def test_run_at_end_boundary_is_included():
+    rows = [_e(date(2026, 11, 2))]
+    # 11/3〜11/5 が 3 日
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 5)) == 3
+
+
+def test_multiple_expenses_on_same_day_count_once():
+    rows = [_e(date(2026, 11, 2)), _e(date(2026, 11, 2), amount=500)]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 3)) == 1
+
+
+def test_zero_amount_record_still_counts_as_spend():
+    # 明細が 1 件でもあれば「使った日」扱い(金額 0 でも)
+    rows = [_e(date(2026, 11, 2), amount=0)]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 3)) == 1
+
+
+def test_rows_outside_range_are_ignored():
+    rows = [_e(date(2026, 10, 31)), _e(date(2026, 11, 10))]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 3)) == 3
+
+
+def test_start_after_end_is_zero():
+    assert longest_no_spend_streak([], date(2026, 11, 5), date(2026, 11, 1)) == 0
+
+
+def test_rows_order_does_not_matter():
+    rows = [_e(date(2026, 11, 5)), _e(date(2026, 11, 1))]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 6)) == 3
diff --git a/tests/test_topn.py b/tests/test_topn.py
new file mode 100644
index 0000000..c5c6a2f
--- /dev/null
+++ b/tests/test_topn.py
@@ -0,0 +1,62 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.topn import top_expenses
+
+
+def _e(day: str, amount: int, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category="食費", amount=amount, memo=memo
+    )
+
+
+def test_orders_by_amount_descending() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300), _e("2026-01-03", 200)]
+    assert [e.amount for e in top_expenses(rows, 3)] == [300, 200, 100]
+
+
+def test_returns_only_first_n() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300), _e("2026-01-03", 200)]
+    assert [e.amount for e in top_expenses(rows, 2)] == [300, 200]
+
+
+def test_n_larger_than_rows_returns_all() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300)]
+    assert [e.amount for e in top_expenses(rows, 10)] == [300, 100]
+
+
+def test_n_zero_returns_empty() -> None:
+    assert top_expenses([_e("2026-01-01", 100)], 0) == []
+
+
+def test_negative_n_returns_empty() -> None:
+    assert top_expenses([_e("2026-01-01", 100)], -3) == []
+
+
+def test_empty_rows_returns_empty() -> None:
+    assert top_expenses([], 5) == []
+
+
+def test_equal_amounts_ordered_by_earlier_date() -> None:
+    late = _e("2026-03-01", 500, "late")
+    early = _e("2026-01-01", 500, "early")
+    assert top_expenses([late, early], 2) == [early, late]
+
+
+def test_equal_amount_and_date_keeps_input_order() -> None:
+    first = _e("2026-01-01", 500, "first")
+    second = _e("2026-01-01", 500, "second")
+    assert top_expenses([first, second], 2) == [first, second]
+    assert top_expenses([second, first], 2) == [second, first]
+
+
+def test_does_not_mutate_input() -> None:
+    rows = [_e("2026-01-01", 100), _e("2026-01-02", 300)]
+    snapshot = list(rows)
+    top_expenses(rows, 2)
+    assert rows == snapshot
+
+
+def test_returns_expense_objects_unchanged() -> None:
+    row = _e("2026-01-01", 700, "memo")
+    assert top_expenses([row], 1) == [row]
diff --git a/tests/test_weekday.py b/tests/test_weekday.py
new file mode 100644
index 0000000..644eb6f
--- /dev/null
+++ b/tests/test_weekday.py
@@ -0,0 +1,79 @@
+from datetime import date, timedelta
+
+from kakeibo.core import Expense
+from kakeibo.weekday import total_by_weekday
+
+# 2024-01-01 は月曜日。MON + n 日で各曜日の日付を得る。
+MON = date(2024, 1, 1)
+
+
+def _day(offset: int) -> date:
+    return MON + timedelta(days=offset)
+
+
+def _e(offset: int, amount: int) -> Expense:
+    return Expense(day=_day(offset), category="food", amount=amount)
+
+
+def test_empty_returns_empty_dict():
+    assert total_by_weekday([]) == {}
+
+
+def test_single_expense_gives_only_its_weekday():
+    assert total_by_weekday([_e(2, 500)]) == {"Wed": 500}
+
+
+def test_same_weekday_is_summed_across_weeks():
+    rows = [_e(0, 100), _e(7, 250), _e(14, 50)]  # 3 つの月曜
+    assert total_by_weekday(rows) == {"Mon": 400}
+
+
+def test_same_day_entries_are_summed():
+    rows = [_e(4, 300), _e(4, 200)]
+    assert total_by_weekday(rows) == {"Fri": 500}
+
+
+def test_keys_are_ordered_monday_first_regardless_of_input_order():
+    rows = [_e(6, 1), _e(3, 2), _e(0, 3), _e(5, 4)]  # Sun, Thu, Mon, Sat
+    result = total_by_weekday(rows)
+    assert list(result) == ["Mon", "Thu", "Sat", "Sun"]
+    assert result == {"Mon": 3, "Thu": 2, "Sat": 4, "Sun": 1}
+
+
+def test_all_seven_weekdays_present_in_order():
+    rows = [_e(i, (i + 1) * 10) for i in range(7)]
+    result = total_by_weekday(rows)
+    assert list(result) == ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
+    assert result == {
+        "Mon": 10,
+        "Tue": 20,
+        "Wed": 30,
+        "Thu": 40,
+        "Fri": 50,
+        "Sat": 60,
+        "Sun": 70,
+    }
+
+
+def test_weekdays_without_entries_are_omitted():
+    rows = [_e(1, 100), _e(5, 200)]  # Tue, Sat のみ
+    result = total_by_weekday(rows)
+    assert result == {"Tue": 100, "Sat": 200}
+    assert "Mon" not in result and "Sun" not in result
+
+
+def test_zero_total_weekday_is_still_included():
+    rows = [_e(2, 500), _e(2, -500)]  # 合計 0 でも明細はあるので含める
+    assert total_by_weekday(rows) == {"Wed": 0}
+
+
+def test_negative_amount_is_summed_as_is():
+    rows = [_e(0, 1000), _e(0, -300)]
+    assert total_by_weekday(rows) == {"Mon": 700}
+
+
+def test_does_not_modify_input_rows():
+    rows = [_e(3, 10), _e(0, 20)]
+    before = list(rows)
+    total_by_weekday(rows)
+    assert rows == before
