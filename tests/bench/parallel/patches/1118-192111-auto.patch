@@ -0,0 +1,40 @@
+import pytest
+
+from kakeibo.split import split_evenly
+
+
+def test_exact_division() -> None:
+    assert split_evenly(300, 3) == [100, 100, 100]
+
+
+def test_remainder_goes_to_first_people() -> None:
+    assert split_evenly(10, 3) == [4, 3, 3]
+
+
+def test_fewer_yen_than_people() -> None:
+    assert split_evenly(2, 5) == [1, 1, 0, 0, 0]
+
+
+def test_zero_amount() -> None:
+    assert split_evenly(0, 3) == [0, 0, 0]
+
+
+def test_single_person_gets_all() -> None:
+    assert split_evenly(12345, 1) == [12345]
+
+
+def test_result_length_equals_people() -> None:
+    assert len(split_evenly(10, 4)) == 4
+
+
+@pytest.mark.parametrize("amount,people", [(1, 2), (100, 7), (999, 4), (5000, 13)])
+def test_sum_equals_amount(amount: int, people: int) -> None:
+    parts = split_evenly(amount, people)
+    assert sum(parts) == amount
+    assert max(parts) - min(parts) <= 1
+
+
+@pytest.mark.parametrize("people", [0, -1])
+def test_people_below_one_raises(people: int) -> None:
+    with pytest.raises(ValueError):
+        split_evenly(100, people)
