+import json
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.export import to_json
+
+
+def test_empty_list_gives_empty_json_array():
+    assert to_json([]) == "[]"
+
+
+def test_single_row_exact_output():
+    rows = [Expense(date(2026, 11, 1), "food", 1200, "lunch")]
+    assert to_json(rows) == (
+        '[{"date": "2026-11-01", "category": "food", "amount": 1200, "memo": "lunch"}]'
+    )
+
+
+def test_keys_are_in_date_category_amount_memo_order():
+    rows = [Expense(date(2026, 1, 2), "rent", 80000, "")]
+    assert list(json.loads(to_json(rows))[0]) == ["date", "category", "amount", "memo"]
+
+
+def test_input_order_is_preserved():
+    rows = [
+        Expense(date(2026, 11, 3), "b", 3),
+        Expense(date(2026, 11, 1), "a", 1),
+        Expense(date(2026, 11, 2), "c", 2),
+    ]
+    dates = [item["date"] for item in json.loads(to_json(rows))]
+    assert dates == ["2026-11-03", "2026-11-01", "2026-11-02"]
+
+
+def test_duplicate_rows_are_kept():
+    row = Expense(date(2026, 11, 1), "food", 100, "")
+    assert len(json.loads(to_json([row, row]))) == 2
+
+
+def test_empty_memo_is_empty_string():
+    rows = [Expense(date(2026, 11, 1), "food", 100)]
+    assert json.loads(to_json(rows))[0]["memo"] == ""
+
+
+def test_non_ascii_is_not_escaped():
+    rows = [Expense(date(2026, 11, 1), "食費", 100, "ランチ")]
+    out = to_json(rows)
+    assert "食費" in out and "ランチ" in out
+    assert "\\u" not in out
+
+
+def test_output_has_no_newlines_or_indentation():
+    rows = [Expense(date(2026, 11, 1), "food", 100, "x")]
+    out = to_json(rows)
+    assert "\n" not in out
+    assert "\n" not in to_json([])
+
+
+def test_date_is_zero_padded_iso():
+    rows = [Expense(date(2026, 1, 5), "food", 100, "")]
+    assert json.loads(to_json(rows))[0]["date"] == "2026-01-05"
+
+
+def test_amount_is_integer_not_string():
+    rows = [Expense(date(2026, 11, 1), "food", 0, "")]
+    assert json.loads(to_json(rows))[0]["amount"] == 0
+    assert isinstance(json.loads(to_json(rows))[0]["amount"], int)
