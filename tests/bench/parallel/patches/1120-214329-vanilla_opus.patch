+"""Budget status per month x category: OK / NEAR (もうすぐ超えそう) / OVER (超過).
+
+Pure functions only (no I/O). Budgets come from ``kakeibo.core.Budget`` and
+monthly totals from ``kakeibo.core.monthly_totals``.
+
+Rules (integer arithmetic, no float rounding):
+  - OVER: actual > limit  (ちょうど予算は超過ではない。core.find_overruns と同じ)
+  - NEAR: not OVER, actual > 0 and actual * 100 >= limit * warn_percent
+  - OK:   otherwise
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from enum import Enum
+
+from kakeibo.core import Budget
+
+DEFAULT_WARN_PERCENT = 80
+
+
+class Level(Enum):
+    OK = "ok"
+    NEAR = "near"
+    OVER = "over"
+
+
+_SEVERITY = {Level.OVER: 0, Level.NEAR: 1, Level.OK: 2}
+
+
+@dataclass(frozen=True)
+class BudgetStatus:
+    month: str  # "YYYY-MM"
+    category: str
+    limit: int  # yen
+    actual: int  # yen
+    level: Level
+
+    @property
+    def remaining(self) -> int:
+        """Yen left in the budget; negative when over."""
+        return self.limit - self.actual
+
+    @property
+    def over(self) -> int:
+        """Yen over the budget; 0 when not over."""
+        return max(0, self.actual - self.limit)
+
+
+def _check_percent(warn_percent: int) -> None:
+    if isinstance(warn_percent, bool) or not isinstance(warn_percent, int):
+        raise TypeError("warn_percent は整数である必要があります")
+    if not 0 <= warn_percent <= 100:
+        raise ValueError("warn_percent は 0〜100 である必要があります")
+
+
+def classify(
+    actual: int, limit: int, warn_percent: int = DEFAULT_WARN_PERCENT
+) -> Level:
+    """Classify spending ``actual`` against ``limit`` (both yen)."""
+    _check_percent(warn_percent)
+    if actual > limit:
+        return Level.OVER
+    if actual > 0 and actual * 100 >= limit * warn_percent:
+        return Level.NEAR
+    return Level.OK
+
+
+def budget_statuses(
+    totals: dict[str, dict[str, int]],
+    budget: Budget,
+    warn_percent: int = DEFAULT_WARN_PERCENT,
+) -> list[BudgetStatus]:
+    """Status for every budgeted category in every month of ``totals``.
+
+    Categories with a budget but no spending appear with actual=0. Categories
+    without a budget are skipped. Order: month ascending, then OVER, NEAR, OK,
+    then category name ascending.
+    """
+    _check_percent(warn_percent)
+    out: list[BudgetStatus] = []
+    for month in sorted(totals):
+        spent = totals[month]
+        limits = budget.for_month(month)
+        rows = [
+            BudgetStatus(
+                month,
+                cat,
+                limit,
+                spent.get(cat, 0),
+                classify(spent.get(cat, 0), limit, warn_percent),
+            )
+            for cat, limit in limits.items()
+        ]
+        rows.sort(key=lambda s: (_SEVERITY[s.level], s.category))
+        out.extend(rows)
+    return out
+
+
+def budget_alerts(
+    totals: dict[str, dict[str, int]],
+    budget: Budget,
+    warn_percent: int = DEFAULT_WARN_PERCENT,
+) -> list[BudgetStatus]:
+    """Only the OVER / NEAR entries of :func:`budget_statuses` (same order)."""
+    return [
+        s
+        for s in budget_statuses(totals, budget, warn_percent)
+        if s.level is not Level.OK
+    ]
diff --git a/tests/test_budget_status.py b/tests/test_budget_status.py
new file mode 100644
index 0000000..3593549
--- /dev/null
+++ b/tests/test_budget_status.py
@@ -0,0 +1,112 @@
+import pytest
+
+from kakeibo.budget_status import (
+    BudgetStatus,
+    Level,
+    budget_alerts,
+    budget_statuses,
+    classify,
+)
+from kakeibo.core import Budget
+
+
+@pytest.mark.parametrize(
+    ("actual", "limit", "expected"),
+    [
+        (0, 1000, Level.OK),
+        (799, 1000, Level.OK),
+        (800, 1000, Level.NEAR),  # ちょうど 80% は NEAR
+        (1000, 1000, Level.NEAR),  # ちょうど予算は超過ではない
+        (1001, 1000, Level.OVER),
+        (0, 0, Level.OK),  # 予算 0 で未使用は OK
+        (1, 0, Level.OVER),
+    ],
+)
+def test_classify_default(actual, limit, expected):
+    assert classify(actual, limit) is expected
+
+
+def test_classify_exact_integer_threshold():
+    # float だと 100 * 0.7 = 70.00000000000001 で取りこぼす境界
+    assert classify(70, 100, warn_percent=70) is Level.NEAR
+    assert classify(69, 100, warn_percent=70) is Level.OK
+
+
+def test_classify_percent_edges():
+    assert classify(999, 1000, warn_percent=100) is Level.OK
+    assert classify(1000, 1000, warn_percent=100) is Level.NEAR
+    assert classify(1, 1000, warn_percent=0) is Level.NEAR
+    assert classify(0, 1000, warn_percent=0) is Level.OK
+
+
+@pytest.mark.parametrize("bad", [-1, 101])
+def test_classify_rejects_out_of_range(bad):
+    with pytest.raises(ValueError):
+        classify(1, 1, warn_percent=bad)
+
+
+@pytest.mark.parametrize("bad", [0.8, True, "80"])
+def test_classify_rejects_non_int(bad):
+    with pytest.raises(TypeError):
+        classify(1, 1, warn_percent=bad)
+
+
+def test_status_properties():
+    s = BudgetStatus("2026-11", "food", 1000, 1200, Level.OVER)
+    assert s.remaining == -200
+    assert s.over == 200
+    s = BudgetStatus("2026-11", "food", 1000, 300, Level.OK)
+    assert s.remaining == 700
+    assert s.over == 0
+
+
+BUDGET = Budget(
+    default={"food": 1000, "rent": 80000, "fun": 5000},
+    months={"2026-11": {"food": 3000}},
+)
+
+
+def test_budget_statuses_order_and_override():
+    totals = {
+        "2026-11": {"rent": 90000, "food": 2500, "misc": 50},
+        "2026-10": {"food": 500},
+    }
+    assert budget_statuses(totals, BUDGET) == [
+        # 月昇順。予算あり・支出なしの rent/fun も actual=0 で出る
+        BudgetStatus("2026-10", "food", 1000, 500, Level.OK),
+        BudgetStatus("2026-10", "fun", 5000, 0, Level.OK),
+        BudgetStatus("2026-10", "rent", 80000, 0, Level.OK),
+        # 月内は OVER → NEAR → OK、同レベルはカテゴリ名昇順。misc は予算なしで除外
+        BudgetStatus("2026-11", "rent", 80000, 90000, Level.OVER),
+        BudgetStatus("2026-11", "food", 3000, 2500, Level.NEAR),  # 月別上書き
+        BudgetStatus("2026-11", "fun", 5000, 0, Level.OK),
+    ]
+
+
+def test_budget_alerts_filters_ok():
+    totals = {"2026-11": {"rent": 90000, "food": 2500, "fun": 100}}
+    alerts = budget_alerts(totals, BUDGET)
+    assert [(a.category, a.level) for a in alerts] == [
+        ("rent", Level.OVER),
+        ("food", Level.NEAR),
+    ]
+
+
+def test_budget_alerts_custom_percent():
+    totals = {"2026-11": {"food": 2500}}
+    assert budget_alerts(totals, BUDGET, warn_percent=90) == []
+    with pytest.raises(ValueError):
+        budget_alerts(totals, BUDGET, warn_percent=150)
+
+
+def test_empty_inputs():
+    assert budget_statuses({}, BUDGET) == []
+    assert budget_statuses({"2026-11": {"food": 1}}, Budget({}, {})) == []
+
+
+def test_inputs_not_mutated():
+    totals = {"2026-11": {"food": 2500}}
+    before = {"2026-11": {"food": 2500}}
+    budget_statuses(totals, BUDGET)
+    assert totals == before
+    assert BUDGET.default == {"food": 1000, "rent": 80000, "fun": 5000}
