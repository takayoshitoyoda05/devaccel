+def _format_alert(a: BudgetAlert) -> str:
+    detail = f"予算 {a.limit:,}円 / 実績 {a.actual:,}円"
+    if a.percent is not None:
+        detail += f" ({a.percent:,}%)"
+    if a.over:
+        return f"警告: {a.month} {a.category} {a.actual - a.limit:,}円超過 {detail}"
+    return f"注意: {a.month} {a.category} 残り {a.limit - a.actual:,}円 {detail}"
diff --git a/src/kakeibo/core.py b/src/kakeibo/core.py
index 8c3cbab..2fc40e7 100644
--- a/src/kakeibo/core.py
+++ b/src/kakeibo/core.py
@@ -133,3 +133,45 @@ def find_overruns(
             if cat in limits and actual > limits[cat]:
                 out.append((month, cat, actual - limits[cat], limits[cat], actual))
     return out
+
+
+CAUTION_RATIO = (9, 10)  # 予算の 90% 以上で「注意」
+
+
+@dataclass(frozen=True)
+class BudgetAlert:
+    month: str
+    category: str
+    limit: int
+    actual: int
+
+    @property
+    def over(self) -> bool:
+        return self.actual > self.limit
+
+    @property
+    def percent(self) -> int | None:
+        """予算に対する実績の割合(%、切り捨て)。予算 0 のときは None。"""
+        if self.limit == 0:
+            return None
+        return self.actual * 100 // self.limit
+
+
+def find_budget_alerts(
+    totals: dict[str, dict[str, int]], budget: Budget
+) -> list[BudgetAlert]:
+    """予算超過、または予算の 90% 以上を使った (month, category) を返す。
+
+    判定は整数演算(actual * 10 >= limit * 9)。予算 0 で実績 0 は対象外。
+    """
+    num, den = CAUTION_RATIO
+    out: list[BudgetAlert] = []
+    for month, cats in totals.items():
+        limits = budget.for_month(month)
+        for cat, actual in cats.items():
+            if cat not in limits:
+                continue
+            limit = limits[cat]
+            if actual > limit or (limit > 0 and actual * den >= limit * num):
+                out.append(BudgetAlert(month, cat, limit, actual))
+    return out
