@@ -0,0 +1,94 @@
+"""Month-over-month comparison of expenses by category."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not isinstance(month, str) or not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def _month_of(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+
+    prev_totals: dict[str, int] = {}
+    curr_totals: dict[str, int] = {}
+    for e in rows:
+        m = _month_of(e)
+        if m == prev_month:
+            prev_totals[e.category] = prev_totals.get(e.category, 0) + e.amount
+        elif m == curr_month:
+            curr_totals[e.category] = curr_totals.get(e.category, 0) + e.amount
+
+    diffs: list[DiffRow] = []
+    for cat in set(prev_totals) | set(curr_totals):
+        prev = prev_totals.get(cat, 0)
+        curr = curr_totals.get(cat, 0)
+        delta = curr - prev
+        pct = None if prev == 0 else round(delta / prev * 100, 1)
+        if cat not in prev_totals:
+            status = "new"
+        elif cat not in curr_totals:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        diffs.append(DiffRow(cat, prev, curr, delta, pct, status))
+
+    diffs.sort(key=lambda d: (-abs(d.delta), d.category))
+    return diffs
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [d for d in diffs if d.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for d in diffs:
+        if d.pct is None:
+            pct = "-"
+        elif d.pct == 0:
+            pct = "+0.0%"  # avoid rendering -0.0
+        else:
+            pct = f"{d.pct:+.1f}%"
+        lines.append(f"{d.category}\t{d.prev}\t{d.curr}\t{d.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month_of(e) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には明細のある月が 2 つ以上必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..c04b98a
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,160 @@
+"""Search query language for expense rows.
+
+Grammar (lowest precedence first):
+    or_expr   := and_expr ("OR" and_expr)*
+    and_expr  := not_expr (["AND"] not_expr)*
+    not_expr  := "NOT" not_expr | primary
+    primary   := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from .core import Expense
+
+Token = tuple[str, str]
+
+_OPERATOR_WORDS = {"AND": "AND", "OR": "OR", "NOT": "NOT"}
+_CAT_PREFIX = "cat:"
+
+
+class QueryError(ValueError):
+    """Raised when a search query is malformed."""
+
+
+def tokenize(q: str) -> list[Token]:
+    tokens: list[Token] = []
+    i, n = 0, len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError("閉じていない引用符があります")
+            body = q[i + 1 : end]
+            if body == "":
+                raise QueryError("空の引用符は使えません")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            start = i
+            while i < n and not (q[i].isspace() or q[i] in '()"'):
+                i += 1
+            word = q[start:i]
+            if word in _OPERATOR_WORDS:
+                tokens.append((_OPERATOR_WORDS[word], word))
+            elif word.startswith(_CAT_PREFIX):
+                value = word[len(_CAT_PREFIX) :]
+                if value == "":
+                    raise QueryError("cat: の後ろにカテゴリ名がありません")
+                tokens.append(("CAT", value))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+@dataclass(frozen=True)
+class _Node:
+    kind: str  # "or", "and", "not", "term", "cat"
+    children: tuple[_Node, ...] = ()
+    value: str = ""
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self._tokens = tokens
+        self._pos = 0
+
+    def _peek(self) -> str | None:
+        return self._tokens[self._pos][0] if self._pos < len(self._tokens) else None
+
+    def _take(self) -> Token:
+        tok = self._tokens[self._pos]
+        self._pos += 1
+        return tok
+
+    def parse(self) -> _Node:
+        if not self._tokens:
+            raise QueryError("検索条件が空です")
+        node = self._or()
+        if self._peek() is not None:
+            raise QueryError(f"想定外のトークンです: {self._tokens[self._pos][1]!r}")
+        return node
+
+    def _or(self) -> _Node:
+        children = [self._and()]
+        while self._peek() == "OR":
+            self._take()
+            children.append(self._and())
+        return children[0] if len(children) == 1 else _Node("or", tuple(children))
+
+    def _and(self) -> _Node:
+        children = [self._not()]
+        while True:
+            kind = self._peek()
+            if kind == "AND":
+                self._take()
+                children.append(self._not())
+            elif kind in ("NOT", "TERM", "CAT", "LPAREN"):
+                children.append(self._not())
+            else:
+                break
+        return children[0] if len(children) == 1 else _Node("and", tuple(children))
+
+    def _not(self) -> _Node:
+        if self._peek() == "NOT":
+            self._take()
+            return _Node("not", (self._not(),))
+        return self._primary()
+
+    def _primary(self) -> _Node:
+        kind = self._peek()
+        if kind == "TERM":
+            return _Node("term", value=self._take()[1])
+        if kind == "CAT":
+            return _Node("cat", value=self._take()[1])
+        if kind == "LPAREN":
+            self._take()
+            node = self._or()
+            if self._peek() != "RPAREN":
+                raise QueryError("括弧が閉じていません")
+            self._take()
+            return node
+        if kind is None:
+            raise QueryError("演算子の後ろに項がありません")
+        raise QueryError(f"項が必要な位置に {self._tokens[self._pos][1]!r} があります")
+
+
+def _parse(q: str) -> _Node:
+    return _Parser(tokenize(q)).parse()
+
+
+def _eval(node: _Node, e: Expense) -> bool:
+    if node.kind == "or":
+        return any(_eval(c, e) for c in node.children)
+    if node.kind == "and":
+        return all(_eval(c, e) for c in node.children)
+    if node.kind == "not":
+        return not _eval(node.children[0], e)
+    needle = node.value.casefold()
+    if node.kind == "term":
+        return needle in e.memo.casefold() or needle in e.category.casefold()
+    return needle == e.category.casefold()  # "cat"
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _eval(_parse(q), e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    node = _parse(q)  # validates even when rows is empty
+    return [e for e in rows if _eval(node, e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..657e1f6
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,68 @@
+"""Detect recurring expenses (same category and amount, roughly monthly)."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+from itertools import pairwise
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day of the next month, clamped to that month's last day."""
+    year, month = (d.year + 1, 1) if d.month == 12 else (d.year, d.month + 1)
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def _connected(prev: date, nxt: date, tolerance: int) -> bool:
+    return abs((nxt - add_month(prev)).days) <= tolerance
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError(f"min_count は 2 以上である必要があります: {min_count}")
+    if tolerance < 0:
+        raise ValueError(f"tolerance は 0 以上である必要があります: {tolerance}")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    found: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        days = sorted(day_set)
+        runs: list[list[date]] = []
+        run: list[date] = [days[0]]
+        for prev, nxt in pairwise(days):
+            if _connected(prev, nxt, tolerance):
+                run.append(nxt)
+            else:
+                runs.append(run)
+                run = [nxt]
+        runs.append(run)
+        for r in runs:
+            if len(r) >= min_count:
+                found.append(
+                    Recurring(
+                        category=category,
+                        amount=amount,
+                        days=tuple(r),
+                        next_expected=add_month(r[-1]),
+                    )
+                )
+
+    found.sort(key=lambda x: (x.category, x.amount, x.days[0]))
+    return found
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..2dd8b8e
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,162 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥1,000", 1000),
+        ("-1,000円", -1000),
+    ],
+)
+def test_parse_amount_accepts(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    ["", "円", "12.5", "1 200", "--5", "¥-5", "１２３", "円5", "abc", "-"],
+)
+def test_parse_amount_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/12/31 ", date(2026, 12, 31)),
+        ("2026-1-5", date(2026, 1, 5)),
+    ],
+)
+def test_parse_date_accepts(text: str, expected: date) -> None:
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    ["2026/1-5", "26/1/5", "2026/02/30", "2026.1.5", "", "2026/13/1", "２０２６/1/5"],
+)
+def test_parse_date_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+def test_default_mapping() -> None:
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_import_basic_with_default_mapping() -> None:
+    text = '利用日,分類,利用金額,利用店名,備考\n2026/1/5,食費,"1,200",スーパー,x\n2026-01-06,交通,-300,駅,\n'
+    expenses, errors = import_rows(text)
+    assert errors == []
+    assert expenses == [
+        Expense(date(2026, 1, 5), "食費", 1200, "スーパー"),
+        Expense(date(2026, 1, 6), "交通", -300, "駅"),
+    ]
+
+
+def test_import_reports_errors_with_physical_line_numbers() -> None:
+    text = (
+        "利用日,分類,利用金額,利用店名\n"
+        "2026/1/5,食費,100,a\n"
+        "\n"
+        "bad,,abc,b\n"
+        "2026/1/7,  ,200,c\n"
+        "2026/1/8,娯楽\n"
+    )
+    expenses, errors = import_rows(text)
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "a")]
+    assert errors == [
+        (4, "date"),
+        (4, "amount"),
+        (4, "category"),
+        (5, "category"),
+        (6, "amount"),
+    ]
+
+
+def test_import_quoted_multiline_row_counts_physical_lines() -> None:
+    text = 'a,b,c,d\n"x\ny",,1,m\n2026/1/1,食費,2,n\n'
+    # mapping to the real columns
+    mapping = {"date": "a", "category": "b", "amount": "c", "memo": "d"}
+    expenses, errors = import_rows(text, mapping)
+    assert expenses == [Expense(date(2026, 1, 1), "食費", 2, "n")]
+    assert errors == [(2, "date"), (2, "category")]
+
+
+def test_import_missing_cells_are_empty_strings() -> None:
+    text = "利用日,分類,利用金額,利用店名\n2026/1/5,食費\n"
+    expenses, errors = import_rows(text)
+    assert expenses == []
+    assert errors == [(2, "amount")]
+
+
+def test_import_category_map_and_strip() -> None:
+    text = (
+        "利用日,分類,利用金額,利用店名\n2026/1/5, 食費 ,100,  店  \n2026/1/6,娯楽,50,\n"
+    )
+    expenses, errors = import_rows(text, category_map={"食費": "Food", "娯楽": "Fun"})
+    assert errors == []
+    assert expenses == [
+        Expense(date(2026, 1, 5), "Food", 100, "店"),
+        Expense(date(2026, 1, 6), "Fun", 50, ""),
+    ]
+
+
+def test_import_custom_mapping_without_memo() -> None:
+    text = 'D,C,A,Extra\n2026/2/1,光熱,"5,000円",ignored\n'
+    mapping = {"date": "D", "category": "C", "amount": "A"}
+    expenses, errors = import_rows(text, mapping)
+    assert errors == []
+    assert expenses == [Expense(date(2026, 2, 1), "光熱", 5000, "")]
+
+
+def test_import_mapping_missing_required_key_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows("D,C,A\n", {"date": "D", "category": "C"})
+
+
+def test_import_mapping_column_not_in_header_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows("利用日,分類,利用金額\n", DEFAULT_MAPPING)
+
+
+def test_import_memo_column_missing_raises() -> None:
+    mapping = {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "無い列",
+    }
+    with pytest.raises(ValueError):
+        import_rows("利用日,分類,利用金額\n2026/1/1,食費,1\n", mapping)
+
+
+def test_import_blank_lines_are_skipped_but_counted() -> None:
+    text = "利用日,分類,利用金額,利用店名\n\n\n2026/1/1,食費,1,\n,,,\n"
+    expenses, errors = import_rows(text)
+    assert expenses == [Expense(date(2026, 1, 1), "食費", 1, "")]
+    assert errors == [(5, "date"), (5, "amount"), (5, "category")]
+
+
+def test_import_empty_text_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows("")
