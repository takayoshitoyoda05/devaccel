+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,109 @@
+"""Import bank statement CSV text into Expense records (pure functions, stdlib only)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"(-?)([¥￥]?)([0-9][0-9,]*)(円?)")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    """Parse '-¥1,234円'-style amounts into int yen. Raises ValueError otherwise."""
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    sign, _yen, digits, _suffix = m.groups()
+    value = int(digits.replace(",", ""))
+    return -value if sign else value
+
+
+def parse_date(s: str) -> date:
+    """Parse 'YYYY/M/D' or 'YYYY-M-D' (separator must not mix). Raises ValueError otherwise."""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    year, _sep, month, day = m.groups()
+    try:
+        return date(int(year), int(month), int(day))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Convert bank CSV text (header on line 1) into expenses.
+
+    Returns (valid expenses in input order, [(physical line number, field name)]).
+    Rows with any error are excluded from the expenses.
+    """
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text))
+    records: list[tuple[int, list[str]]] = []
+    prev = 0
+    for row in reader:
+        start = prev + 1
+        prev = reader.line_num
+        records.append((start, row))
+    if not records:
+        raise ValueError("ヘッダー行がありません")
+
+    header = records[0][1]
+    columns: dict[str, int] = {}
+    for key, col in mapping.items():
+        if col not in header:
+            raise ValueError(f"列 {col!r} がヘッダーにありません")
+        columns[key] = header.index(col)
+
+    def cell(row: list[str], key: str) -> str:
+        idx = columns[key]
+        return row[idx] if idx < len(row) else ""
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    for line, row in records[1:]:
+        if not row:  # blank line: skipped, but counted in line numbers
+            continue
+        row_errors: list[tuple[int, str]] = []
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(cell(row, "date"))
+        except ValueError:
+            row_errors.append((line, "date"))
+        try:
+            amount = parse_amount(cell(row, "amount"))
+        except ValueError:
+            row_errors.append((line, "amount"))
+        category = cell(row, "category").strip()
+        if not category:
+            row_errors.append((line, "category"))
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        assert day is not None and amount is not None  # guaranteed by no errors
+        if category_map and category in category_map:
+            category = category_map[category]
+        memo = cell(row, "memo").strip() if "memo" in columns else ""
+        expenses.append(Expense(day=day, category=category, amount=amount, memo=memo))
+    return expenses, errors
