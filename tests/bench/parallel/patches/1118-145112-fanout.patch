+++ b/tests/test_monthdiff.py
@@ -0,0 +1,142 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def _e(day: str, cat: str, amount: int) -> Expense:
+    return Expense(date.fromisoformat(day), cat, amount, "")
+
+
+ROWS = [
+    _e("2026-10-03", "food", 1000),
+    _e("2026-10-20", "food", 500),
+    _e("2026-10-05", "rent", 2000),
+    _e("2026-10-09", "fun", 300),
+    _e("2026-11-02", "food", 1800),
+    _e("2026-11-08", "rent", 2000),
+    _e("2026-11-12", "travel", 700),
+    _e("2026-11-15", "gift", 0),
+]
+
+
+def _by_cat(diffs):
+    return {d.category: d for d in diffs}
+
+
+def test_month_diff_statuses_and_values():
+    d = _by_cat(month_diff(ROWS, "2026-10", "2026-11"))
+    assert d["food"] == DiffRow("food", 1500, 1800, 300, 20.0, "up")
+    assert d["rent"] == DiffRow("rent", 2000, 2000, 0, 0.0, "same")
+    assert d["fun"] == DiffRow("fun", 300, 0, -300, -100.0, "gone")
+    assert d["travel"] == DiffRow("travel", 0, 700, 700, None, "new")
+
+
+def test_month_diff_status_uses_presence_not_totals():
+    rows = [_e("2026-10-01", "x", 0), _e("2026-11-01", "x", 0)]
+    (d,) = month_diff(rows, "2026-10", "2026-11")
+    assert d.status == "same"
+    rows = [_e("2026-10-01", "x", 0), _e("2026-11-01", "x", 5)]
+    (d,) = month_diff(rows, "2026-10", "2026-11")
+    assert d.status == "up"
+    assert d.pct is None
+
+
+def test_month_diff_includes_zero_total_category_present_in_month():
+    rows = [_e("2026-10-01", "x", 100), _e("2026-11-01", "x", -100)]
+    (d,) = month_diff(rows, "2026-10", "2026-11")
+    assert (d.prev, d.curr, d.delta, d.pct, d.status) == (
+        100,
+        -100,
+        -200,
+        -200.0,
+        "down",
+    )
+
+
+def test_month_diff_sort_by_abs_delta_then_category():
+    rows = [
+        _e("2026-10-01", "b", 100),
+        _e("2026-11-01", "b", 200),  # +100
+        _e("2026-10-01", "a", 300),
+        _e("2026-11-01", "a", 0),  # -300
+        _e("2026-11-01", "c", 100),  # +100 new
+    ]
+    cats = [d.category for d in month_diff(rows, "2026-10", "2026-11")]
+    assert cats == ["a", "b", "c"]
+
+
+def test_month_diff_ignores_other_months():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    assert _by_cat(diffs)["food"].prev == 1500
+
+
+def test_month_diff_rejects_bad_month_format():
+    for bad in ["2026-1", "2026-13", "2026-00", "202611", "2026/11", "26-11"]:
+        with pytest.raises(ValueError):
+            month_diff(ROWS, bad, "2026-11")
+        with pytest.raises(ValueError):
+            month_diff(ROWS, "2026-10", bad)
+
+
+def test_top_movers_excludes_same_and_keeps_order():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    got = [d.category for d in top_movers(diffs, 2)]
+    assert got == ["travel", "food"]  # |delta| tie (300) broken by category
+    assert "rent" not in [d.category for d in top_movers(diffs, 10)]
+
+
+def test_top_movers_default_and_negative_n():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    assert len(top_movers(diffs)) == 3
+    assert top_movers(diffs, 0) == []
+    with pytest.raises(ValueError):
+        top_movers(diffs, -1)
+
+
+def test_render_diff_format():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    text = render_diff(diffs)
+    lines = text.split("\n")
+    assert lines[0] == "category\tprev\tcurr\tdelta\tpct"
+    assert "travel\t0\t700\t+700\t-" in lines
+    assert "fun\t300\t0\t-300\t-100.0%" in lines
+    assert "rent\t2000\t2000\t+0\t+0.0%" in lines
+    assert "food\t1500\t1800\t+300\t+20.0%" in lines
+    assert not text.endswith("\n")
+
+
+def test_render_diff_rounds_to_zero_pct_without_minus_sign():
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+    rows = [_e("2026-10-01", "x", 1000000), _e("2026-11-01", "x", 999999)]
+    text = render_diff(month_diff(rows, "2026-10", "2026-11"))
+    assert text.split("\n")[1] == "x\t1000000\t999999\t-1\t+0.0%"
+
+
+def test_available_months_sorted_unique():
+    assert available_months(ROWS) == ["2026-10", "2026-11"]
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months():
+    rows = ROWS + [_e("2026-12-01", "food", 100)]
+    d = _by_cat(latest_diff(rows))
+    assert d["food"].prev == 1800
+    assert d["food"].curr == 100
+    assert "fun" not in d
+
+
+def test_latest_diff_needs_two_months():
+    with pytest.raises(ValueError):
+        latest_diff([])
+    with pytest.raises(ValueError):
+        latest_diff([_e("2026-10-01", "x", 1)])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..24b48e7
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,200 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+ROWS = [
+    Expense(date(2026, 11, 1), "food", 1200, "lunch"),
+    Expense(date(2026, 11, 2), "rent", 80000, ""),
+    Expense(date(2026, 11, 3), "Food", 800, "Coffee shop"),
+    Expense(date(2026, 11, 4), "transport", 300, "train lunch trip"),
+]
+
+
+def _memos(rows):
+    return [e.memo for e in rows]
+
+
+# --- tokenize ---
+
+
+def test_tokenize_basic_words_and_operators():
+    assert tokenize("food AND lunch OR NOT x") == [
+        ("TERM", "food"),
+        ("AND", "AND"),
+        ("TERM", "lunch"),
+        ("OR", "OR"),
+        ("NOT", "NOT"),
+        ("TERM", "x"),
+    ]
+
+
+def test_tokenize_parens_and_whitespace():
+    assert tokenize("  (a)\tb  ") == [
+        ("LPAREN", "("),
+        ("TERM", "a"),
+        ("RPAREN", ")"),
+        ("TERM", "b"),
+    ]
+
+
+def test_tokenize_quoted_keeps_spaces_and_parens():
+    assert tokenize('"train lunch" "(x)"') == [("TERM", "train lunch"), ("TERM", "(x)")]
+
+
+def test_tokenize_lowercase_operators_are_terms():
+    assert tokenize("and or not") == [("TERM", "and"), ("TERM", "or"), ("TERM", "not")]
+
+
+def test_tokenize_cat_prefix():
+    assert tokenize("cat:food") == [("CAT", "food")]
+
+
+def test_tokenize_cat_is_case_sensitive_prefix_only():
+    assert tokenize("CAT:food") == [("TERM", "CAT:food")]
+
+
+def test_tokenize_unclosed_quote_raises():
+    with pytest.raises(QueryError):
+        tokenize('"lunch')
+
+
+def test_tokenize_empty_quote_raises():
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_empty_cat_raises():
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_tokenize_word_stops_at_quote():
+    assert tokenize('ab"cd"') == [("TERM", "ab"), ("TERM", "cd")]
+
+
+# --- parsing errors ---
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(",
+        ")",
+        "(a",
+        "a)",
+        "a AND",
+        "a OR",
+        "OR a",
+        "AND a",
+        "a OR OR b",
+        "a AND AND b",
+        "NOT",
+        "a NOT",
+        "a AND OR b",
+        "(a OR)",
+    ],
+)
+def test_invalid_queries_raise(q):
+    with pytest.raises(QueryError):
+        filter_rows(q, ROWS)
+
+
+def test_invalid_query_raises_even_with_no_rows():
+    with pytest.raises(QueryError):
+        filter_rows("a AND", [])
+
+
+def test_invalid_query_raises_in_matches():
+    with pytest.raises(QueryError):
+        matches("(", ROWS[0])
+
+
+# --- evaluation ---
+
+
+def test_term_matches_memo_or_category_case_insensitive():
+    assert _memos(filter_rows("lunch", ROWS)) == ["lunch", "train lunch trip"]
+    assert _memos(filter_rows("FOOD", ROWS)) == ["lunch", "Coffee shop"]
+
+
+def test_term_matches_substring():
+    assert _memos(filter_rows("coff", ROWS)) == ["Coffee shop"]
+
+
+def test_cat_is_exact_match_case_insensitive():
+    assert _memos(filter_rows("cat:food", ROWS)) == ["lunch", "Coffee shop"]
+    assert filter_rows("cat:foo", ROWS) == []
+
+
+def test_cat_does_not_match_substring():
+    assert filter_rows("cat:lunch", ROWS) == []
+
+
+def test_implicit_and():
+    assert _memos(filter_rows("food lunch", ROWS)) == ["lunch"]
+
+
+def test_explicit_and_same_as_implicit():
+    assert filter_rows("food AND lunch", ROWS) == filter_rows("food lunch", ROWS)
+
+
+def test_or():
+    assert _memos(filter_rows("rent OR transport", ROWS)) == ["", "train lunch trip"]
+
+
+def test_not():
+    assert _memos(filter_rows("NOT cat:food", ROWS)) == ["", "train lunch trip"]
+
+
+def test_not_binds_tighter_than_and():
+    # (NOT coffee) AND lunch
+    assert _memos(filter_rows("NOT coffee lunch", ROWS)) == [
+        "lunch",
+        "train lunch trip",
+    ]
+
+
+def test_and_binds_tighter_than_or():
+    # food AND coffee  OR  rent
+    assert _memos(filter_rows("food coffee OR rent", ROWS)) == ["", "Coffee shop"]
+
+
+def test_parentheses_override_precedence():
+    # food AND (coffee OR rent) -> only Coffee shop
+    assert _memos(filter_rows("food (coffee OR rent)", ROWS)) == ["Coffee shop"]
+
+
+def test_double_not():
+    assert filter_rows("NOT NOT rent", ROWS) == [ROWS[1]]
+
+
+def test_quoted_term_with_space():
+    assert _memos(filter_rows('"train lunch"', ROWS)) == ["train lunch trip"]
+
+
+def test_quoted_term_with_paren_is_literal():
+    assert filter_rows('"(x)"', ROWS) == []
+
+
+def test_lowercase_and_is_a_term_not_operator():
+    assert filter_rows("lunch and", ROWS) == []
+
+
+def test_preserves_input_order():
+    assert filter_rows("cat:food OR cat:transport", ROWS) == [ROWS[0], ROWS[2], ROWS[3]]
+
+
+def test_empty_rows_valid_query():
+    assert filter_rows("food", []) == []
+
+
+def test_matches_single_row():
+    assert matches("cat:rent", ROWS[1])
+    assert not matches("cat:rent", ROWS[0])
+    assert matches("NOT food", ROWS[1])
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..b9cfb54
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,130 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def e(day: str, category: str = "通信", amount: int = 1000, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+@pytest.mark.parametrize(
+    ("start", "expected"),
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2024, 1, 31), date(2024, 2, 29)),
+        (date(2026, 12, 15), date(2027, 1, 15)),
+        (date(2026, 3, 31), date(2026, 4, 30)),
+    ],
+)
+def test_add_month_clamps_to_month_end(start: date, expected: date) -> None:
+    assert add_month(start) == expected
+
+
+def test_detects_monthly_run() -> None:
+    rows = [e("2026-01-05"), e("2026-02-05"), e("2026-03-05")]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="通信",
+            amount=1000,
+            days=(date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+            next_expected=date(2026, 4, 5),
+        )
+    ]
+
+
+def test_tolerance_allows_small_drift() -> None:
+    rows = [e("2026-01-05"), e("2026-02-07"), e("2026-03-04")]
+    result = find_recurring(rows, tolerance=3)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 7), date(2026, 3, 4))
+
+
+def test_gap_beyond_tolerance_splits_runs() -> None:
+    rows = [
+        e("2026-01-05"),
+        e("2026-02-05"),
+        e("2026-03-05"),
+        e("2026-05-05"),
+        e("2026-06-05"),
+    ]
+    assert find_recurring(rows, min_count=3) == [
+        Recurring(
+            category="通信",
+            amount=1000,
+            days=(date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+            next_expected=date(2026, 4, 5),
+        )
+    ]
+    assert find_recurring(rows, min_count=2)[1].days == (
+        date(2026, 5, 5),
+        date(2026, 6, 5),
+    )
+
+
+def test_short_run_below_min_count_is_dropped() -> None:
+    rows = [e("2026-01-05"), e("2026-02-05")]
+    assert find_recurring(rows, min_count=3) == []
+    assert len(find_recurring(rows, min_count=2)) == 1
+
+
+def test_groups_by_category_and_amount_ignoring_memo() -> None:
+    rows = [
+        e("2026-01-05", amount=1000, memo="a"),
+        e("2026-02-05", amount=1000, memo="b"),
+        e("2026-03-05", amount=1000),
+        e("2026-01-05", amount=500),
+        e("2026-02-05", category="食費", amount=1000),
+    ]
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [("通信", 1000)]
+
+
+def test_duplicate_dates_are_collapsed() -> None:
+    rows = [e("2026-01-05"), e("2026-01-05"), e("2026-02-05"), e("2026-03-05")]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_results_sorted_by_category_amount_then_first_day() -> None:
+    rows = [
+        e("2026-01-10", category="通信", amount=300),
+        e("2026-02-10", category="通信", amount=300),
+        e("2026-03-10", category="通信", amount=300),
+        e("2026-01-01", category="家賃", amount=80000),
+        e("2026-02-01", category="家賃", amount=80000),
+        e("2026-03-01", category="家賃", amount=80000),
+        e("2026-01-20", category="通信", amount=100),
+        e("2026-02-20", category="通信", amount=100),
+        e("2026-03-20", category="通信", amount=100),
+    ]
+    keys = [(r.category, r.amount) for r in find_recurring(rows)]
+    assert keys == [("家賃", 80000), ("通信", 100), ("通信", 300)]
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+def test_next_expected_uses_last_day_clamp() -> None:
+    rows = [e("2026-11-30"), e("2026-12-30"), e("2027-01-30")]
+    result = find_recurring(rows)
+    assert result[0].next_expected == date(2027, 2, 28)
+
+
+@pytest.mark.parametrize(
+    ("kwargs", "message"),
+    [
+        ({"min_count": 1}, "min_count"),
+        ({"tolerance": -1}, "tolerance"),
+    ],
+)
+def test_invalid_parameters_raise_value_error(
+    kwargs: dict[str, int], message: str
+) -> None:
+    with pytest.raises(ValueError, match=message):
+        find_recurring([], **kwargs)
