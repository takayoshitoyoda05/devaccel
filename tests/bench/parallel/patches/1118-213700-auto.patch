new file mode 100644
index 0000000..f215fd3
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,222 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def E(y: int, m: int, cat: str, amount: int) -> Expense:
+    return Expense(date(y, m, 1), cat, amount)
+
+
+PREV = "2026-10"
+CURR = "2026-11"
+
+
+def test_basic_rows_and_pct():
+    rows = [
+        E(2026, 10, "food", 1000),
+        E(2026, 11, "food", 1300),
+        E(2026, 10, "rent", 80000),
+        E(2026, 11, "rent", 80000),
+    ]
+    assert month_diff(rows, PREV, CURR) == [
+        DiffRow("food", 1000, 1300, 300, 30.0, "up"),
+        DiffRow("rent", 80000, 80000, 0, 0.0, "same"),
+    ]
+
+
+def test_pct_rounds_to_one_decimal():
+    rows = [E(2026, 10, "a", 3), E(2026, 11, "a", 1)]
+    (r,) = month_diff(rows, PREV, CURR)
+    assert r == DiffRow("a", 3, 1, -2, -66.7, "down")
+
+
+def test_new_category_has_no_pct():
+    rows = [E(2026, 11, "misc", 500)]
+    assert month_diff(rows, PREV, CURR) == [DiffRow("misc", 0, 500, 500, None, "new")]
+
+
+def test_gone_category_is_minus_100():
+    rows = [E(2026, 10, "misc", 300)]
+    assert month_diff(rows, PREV, CURR) == [
+        DiffRow("misc", 300, 0, -300, -100.0, "gone")
+    ]
+
+
+def test_down_status():
+    rows = [E(2026, 10, "food", 2000), E(2026, 11, "food", 500)]
+    (r,) = month_diff(rows, PREV, CURR)
+    assert r.status == "down"
+    assert r.delta == -1500
+    assert r.pct == -75.0
+
+
+def test_presence_not_sum_zero_entries_are_same():
+    # 0 円の明細があれば「明細あり」: new/gone にはならず same
+    rows = [E(2026, 10, "fee", 0), E(2026, 11, "fee", 0)]
+    assert month_diff(rows, PREV, CURR) == [DiffRow("fee", 0, 0, 0, None, "same")]
+
+
+def test_presence_not_sum_zero_sum_prev_is_not_new():
+    # prev の合計は 0 でも明細はあるので "new" ではなく "up"
+    rows = [
+        E(2026, 10, "x", 100),
+        E(2026, 10, "x", -100),
+        E(2026, 11, "x", 200),
+    ]
+    assert month_diff(rows, PREV, CURR) == [DiffRow("x", 0, 200, 200, None, "up")]
+
+
+def test_presence_not_sum_zero_sum_curr_is_not_gone():
+    rows = [E(2026, 10, "x", 200), E(2026, 11, "x", 100), E(2026, 11, "x", -100)]
+    assert month_diff(rows, PREV, CURR) == [DiffRow("x", 200, 0, -200, -100.0, "down")]
+
+
+def test_other_months_ignored():
+    rows = [
+        E(2026, 9, "food", 999),
+        E(2026, 10, "food", 100),
+        E(2026, 11, "food", 100),
+        E(2026, 12, "food", 5000),
+        E(2026, 12, "new", 1),
+    ]
+    assert month_diff(rows, PREV, CURR) == [DiffRow("food", 100, 100, 0, 0.0, "same")]
+
+
+def test_empty_inputs():
+    assert month_diff([], PREV, CURR) == []
+    assert month_diff([E(2026, 10, "a", 1)], "2026-08", "2026-09") == []
+
+
+def test_same_month_compares_to_itself():
+    rows = [E(2026, 11, "a", 10), E(2026, 11, "b", 20)]
+    assert month_diff(rows, CURR, CURR) == [
+        DiffRow("a", 10, 10, 0, 0.0, "same"),
+        DiffRow("b", 20, 20, 0, 0.0, "same"),
+    ]
+
+
+def test_sort_by_abs_delta_desc_then_category_asc():
+    rows = [
+        E(2026, 10, "zeta", 1000),
+        E(2026, 11, "zeta", 1000),  # delta 0
+        E(2026, 10, "beta", 500),
+        E(2026, 11, "beta", 200),  # delta -300
+        E(2026, 10, "alpha", 100),
+        E(2026, 11, "alpha", 400),  # delta +300
+        E(2026, 11, "big", 5000),  # delta +5000 (new)
+    ]
+    cats = [r.category for r in month_diff(rows, PREV, CURR)]
+    assert cats == ["big", "alpha", "beta", "zeta"]
+
+
+@pytest.mark.parametrize(
+    "prev, curr",
+    [
+        ("2026-1", "2026-11"),
+        ("2026-11", "2026-13"),
+        ("2026-00", "2026-11"),
+        ("2026/11", "2026-11"),
+        ("2026-11\n", "2026-11"),
+        ("２０２６-11", "2026-11"),
+        ("", "2026-11"),
+        ("2026-11", "2026-1"),
+        ("2026-11", "26-11"),
+    ],
+)
+def test_bad_month_format_raises(prev, curr):
+    with pytest.raises(ValueError):
+        month_diff([], prev, curr)
+
+
+def test_top_movers_excludes_same_and_keeps_order():
+    diffs = [
+        DiffRow("a", 1, 2, 1, 100.0, "up"),
+        DiffRow("b", 5, 5, 0, 0.0, "same"),
+        DiffRow("c", 9, 3, -6, -66.7, "down"),
+        DiffRow("d", 0, 4, 4, None, "new"),
+        DiffRow("e", 2, 2, 0, 0.0, "same"),
+        DiffRow("f", 1, 0, -1, -100.0, "gone"),
+    ]
+    assert [r.category for r in top_movers(diffs)] == ["a", "c", "d"]
+    assert [r.category for r in top_movers(diffs, 2)] == ["a", "c"]
+    assert [r.category for r in top_movers(diffs, 0)] == []
+    assert [r.category for r in top_movers(diffs, 99)] == ["a", "c", "d", "f"]
+
+
+def test_top_movers_negative_n_raises():
+    with pytest.raises(ValueError):
+        top_movers([], -1)
+
+
+def test_top_movers_default_is_three():
+    diffs = [DiffRow(str(i), 0, 1, 1, None, "new") for i in range(5)]
+    assert len(top_movers(diffs)) == 3
+
+
+def test_render_format():
+    diffs = [
+        DiffRow("food", 1000, 1300, 300, 30.0, "up"),
+        DiffRow("rent", 2000, 0, -2000, -100.0, "gone"),
+        DiffRow("misc", 0, 500, 500, None, "new"),
+        DiffRow("same", 7, 7, 0, 0.0, "same"),
+    ]
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "food\t1000\t1300\t+300\t+30.0%\n"
+        "rent\t2000\t0\t-2000\t-100.0%\n"
+        "misc\t0\t500\t+500\t-\n"
+        "same\t7\t7\t+0\t+0.0%"
+    )
+
+
+def test_render_no_trailing_newline_and_header_only_when_empty():
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+    out = render_diff([DiffRow("a", 1, 1, 0, 0.0, "same")])
+    assert not out.endswith("\n")
+
+
+def test_render_negative_zero_pct_shows_plus_zero():
+    # prev が負のとき delta 0 で pct が -0.0 になっても "+0.0%" と出す
+    out = render_diff([DiffRow("a", -5, -5, 0, -0.0, "same")])
+    assert out.splitlines()[1].endswith("\t+0\t+0.0%")
+
+
+def test_available_months_sorted_unique():
+    rows = [
+        E(2026, 11, "a", 1),
+        E(2026, 9, "a", 1),
+        E(2026, 11, "b", 1),
+        E(2025, 12, "a", 1),
+    ]
+    assert available_months(rows) == ["2025-12", "2026-09", "2026-11"]
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months():
+    rows = [
+        E(2026, 8, "food", 9999),
+        E(2026, 9, "food", 100),
+        E(2026, 10, "food", 150),
+        E(2026, 10, "rent", 80000),
+    ]
+    assert latest_diff(rows) == [
+        DiffRow("rent", 0, 80000, 80000, None, "new"),
+        DiffRow("food", 100, 150, 50, 50.0, "up"),
+    ]
+
+
+def test_latest_diff_needs_two_months():
+    with pytest.raises(ValueError):
+        latest_diff([])
+    with pytest.raises(ValueError):
+        latest_diff([E(2026, 10, "food", 1), E(2026, 10, "rent", 2)])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..d173d4f
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,286 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def _e(category: str, memo: str = "", amount: int = 100, day: int = 1) -> Expense:
+    return Expense(day=date(2026, 11, day), category=category, amount=amount, memo=memo)
+
+
+# --- tokenize ---------------------------------------------------------------
+
+
+def test_tokenize_whitespace_only_gives_no_tokens():
+    assert tokenize("   \t ") == []
+
+
+def test_tokenize_parens():
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+
+
+def test_tokenize_operators_only_when_uppercase():
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+    assert tokenize("and or not") == [
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_word_containing_operator_is_term():
+    assert tokenize("ANDx") == [("TERM", "ANDx")]
+
+
+def test_tokenize_quoted_term_keeps_spaces_and_parens():
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+
+
+def test_tokenize_quoted_operator_is_term():
+    assert tokenize('"AND"') == [("TERM", "AND")]
+
+
+def test_tokenize_quoted_cat_prefix_is_term():
+    assert tokenize('"cat:food"') == [("TERM", "cat:food")]
+
+
+def test_tokenize_unclosed_quote_is_error():
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_is_error():
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_cat_token():
+    assert tokenize("cat:food") == [("CAT", "food")]
+
+
+def test_tokenize_cat_with_empty_value_is_error():
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_tokenize_uppercase_cat_prefix_is_term():
+    assert tokenize("CAT:food") == [("TERM", "CAT:food")]
+
+
+def test_tokenize_word_stops_at_paren_and_quote():
+    assert tokenize("ab(cd)") == [
+        ("TERM", "ab"),
+        ("LPAREN", "("),
+        ("TERM", "cd"),
+        ("RPAREN", ")"),
+    ]
+
+
+# --- parsing errors -----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(a",
+        "a)",
+        "a AND",
+        "AND a",
+        "a OR",
+        "OR a",
+        "a OR OR b",
+        "a AND AND b",
+        "NOT",
+        "a NOT",
+        "(a OR)",
+    ],
+)
+def test_malformed_query_is_error(q):
+    with pytest.raises(QueryError):
+        filter_rows(q, [])
+
+
+def test_malformed_query_is_error_in_matches():
+    with pytest.raises(QueryError):
+        matches("a AND", _e("food"))
+
+
+def test_empty_query_is_error_even_with_rows():
+    with pytest.raises(QueryError):
+        filter_rows("", [_e("food")])
+
+
+# --- grammar / precedence -----------------------------------------------------
+
+
+def test_implicit_and_between_terms():
+    e = _e("food", memo="lunch coffee")
+    assert matches("lunch coffee", e)
+    assert not matches("lunch tea", e)
+
+
+def test_explicit_and_equals_implicit():
+    e = _e("food", memo="lunch coffee")
+    assert matches("lunch AND coffee", e)
+    assert not matches("lunch AND tea", e)
+
+
+def test_or_binds_loosest():
+    # a OR (b AND c)
+    q = "tea OR lunch coffee"
+    assert not matches(q, _e("food", memo="lunch"))
+    assert matches(q, _e("food", memo="lunch coffee"))
+    assert matches(q, _e("food", memo="tea"))
+
+
+def test_and_binds_tighter_than_or_both_sides():
+    # (a AND b) OR c
+    q = "food AND lunch OR rent"
+    assert matches(q, _e("rent"))
+    assert matches(q, _e("food", memo="lunch"))
+    assert not matches(q, _e("food"))
+
+
+def test_not_binds_tighter_than_and():
+    # (NOT a) AND b
+    q = "NOT lunch AND food"
+    assert matches(q, _e("food", memo="dinner"))
+    assert not matches(q, _e("food", memo="lunch"))
+
+
+def test_not_chains():
+    assert matches("NOT NOT lunch", _e("food", memo="lunch"))
+    assert not matches("NOT NOT lunch", _e("food", memo="dinner"))
+
+
+def test_implicit_and_with_not():
+    # a AND (NOT b)
+    q = "food NOT lunch"
+    assert matches(q, _e("food", memo="dinner"))
+    assert not matches(q, _e("food", memo="lunch"))
+
+
+def test_parens_override_precedence():
+    # (a OR b) AND c
+    q = "(tea OR lunch) food"
+    assert matches(q, _e("food", memo="lunch"))
+    assert not matches(q, _e("rent", memo="lunch"))
+
+
+def test_not_applies_to_parenthesized_group():
+    q = "NOT (tea OR lunch)"
+    assert matches(q, _e("food", memo="dinner"))
+    assert not matches(q, _e("food", memo="lunch"))
+
+
+def test_nested_parens():
+    q = "((lunch))"
+    assert matches(q, _e("food", memo="lunch"))
+
+
+def test_parens_adjacent_to_terms_without_spaces():
+    assert matches("(lunch)food", _e("food", memo="lunch"))
+
+
+# --- evaluation -----------------------------------------------------------------
+
+
+def test_term_matches_memo_substring():
+    assert matches("unch", _e("food", memo="lunch"))
+
+
+def test_term_matches_category_substring():
+    assert matches("foo", _e("food"))
+
+
+def test_term_does_not_match_amount_or_date():
+    e = _e("food", memo="memo", amount=12345, day=7)
+    assert not matches("12345", e)
+    assert not matches("2026", e)
+
+
+def test_term_is_case_insensitive():
+    assert matches("LUNCH", _e("food", memo="lunch"))
+    assert matches("food", _e("FOOD"))
+
+
+def test_term_matches_empty_memo_only_via_category():
+    assert not matches("lunch", _e("food", memo=""))
+    assert matches("food", _e("food", memo=""))
+
+
+def test_term_with_quoted_spaces_substring():
+    assert matches('"fresh fish"', _e("food", memo="buy fresh fish today"))
+
+
+def test_cat_is_exact_match_on_category():
+    assert matches("cat:food", _e("food"))
+    assert not matches("cat:foo", _e("food"))
+
+
+def test_cat_does_not_match_memo():
+    assert not matches("cat:lunch", _e("food", memo="lunch"))
+
+
+def test_cat_is_case_insensitive():
+    assert matches("cat:FOOD", _e("food"))
+    assert matches("cat:food", _e("Food"))
+
+
+def test_cat_combined_with_term():
+    assert matches("cat:food lunch", _e("food", memo="lunch"))
+    assert not matches("cat:rent lunch", _e("food", memo="lunch"))
+
+
+def test_quoted_cat_prefix_is_plain_term_not_cat():
+    # "cat:food" quoted → TERM; substring of category "cat:food"? no → False
+    assert not matches('"cat:food"', _e("food"))
+
+
+def test_not_cat():
+    assert matches("NOT cat:rent", _e("food"))
+    assert not matches("NOT cat:food", _e("food"))
+
+
+def test_casefold_used_for_comparison():
+    # casefold maps ß to ss
+    assert matches("STRASSE", _e("travel", memo="Straße"))
+
+
+# --- filter_rows ----------------------------------------------------------------
+
+
+def test_filter_rows_keeps_input_order():
+    rows = [
+        _e("food", memo="lunch", day=3),
+        _e("rent", day=1),
+        _e("food", memo="dinner", day=2),
+        _e("food", memo="lunch", day=4),
+    ]
+    out = filter_rows("food lunch", rows)
+    assert [r.day.day for r in out] == [3, 4]
+
+
+def test_filter_rows_empty_input_with_valid_query_returns_empty():
+    assert filter_rows("food", []) == []
+
+
+def test_filter_rows_no_match_returns_empty():
+    assert filter_rows("cat:nothing", [_e("food")]) == []
+
+
+def test_filter_rows_returns_new_list():
+    rows = [_e("food")]
+    out = filter_rows("food", rows)
+    assert out == rows
+    assert out is not rows
+
+
+def test_filter_rows_duplicates_preserved():
+    rows = [_e("food", memo="a"), _e("food", memo="a")]
+    assert len(filter_rows("a", rows)) == 2
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..958e0c2
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,222 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def ex(
+    day: date, category: str = "家賃", amount: int = 80000, memo: str = ""
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- add_month ---------------------------------------------------------------
+
+
+def test_add_month_same_day() -> None:
+    assert add_month(date(2026, 3, 10)) == date(2026, 4, 10)
+
+
+def test_add_month_clamps_to_end_of_next_month() -> None:
+    assert add_month(date(2026, 1, 31)) == date(2026, 2, 28)
+    assert add_month(date(2024, 1, 31)) == date(2024, 2, 29)
+    assert add_month(date(2026, 3, 31)) == date(2026, 4, 30)
+
+
+def test_add_month_does_not_clamp_when_day_fits() -> None:
+    assert add_month(date(2026, 4, 30)) == date(2026, 5, 30)
+
+
+def test_add_month_year_rollover() -> None:
+    assert add_month(date(2026, 12, 15)) == date(2027, 1, 15)
+
+
+# --- argument validation -----------------------------------------------------
+
+
+@pytest.mark.parametrize("min_count", [1, 0, -3])
+def test_min_count_below_two_raises(min_count: int) -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=min_count)
+
+
+def test_negative_tolerance_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_min_count_two_is_allowed() -> None:
+    rows = [ex(date(2026, 1, 5)), ex(date(2026, 2, 5))]
+    result = find_recurring(rows, min_count=2)
+    assert len(result) == 1
+
+
+def test_zero_tolerance_is_allowed() -> None:
+    rows = [ex(date(2026, 1, 5)), ex(date(2026, 2, 5)), ex(date(2026, 3, 5))]
+    assert len(find_recurring(rows, tolerance=0)) == 1
+
