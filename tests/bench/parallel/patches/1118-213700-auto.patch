+# --- tolerance ---------------------------------------------------------------
+
+
+def test_gap_exactly_at_tolerance_is_connected() -> None:
+    # add_month(Jan 1) = Feb 1; Feb 4 is 3 days later (= tolerance).
+    rows = [ex(date(2026, 1, 1)), ex(date(2026, 2, 4)), ex(date(2026, 3, 4))]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_gap_beyond_tolerance_is_not_connected() -> None:
+    # Feb 5 is 4 days after Feb 1 (> tolerance 3), so the chain breaks.
+    rows = [ex(date(2026, 1, 1)), ex(date(2026, 2, 5)), ex(date(2026, 3, 5))]
+    assert find_recurring(rows) == []
+
+
+def test_early_payment_within_tolerance_is_connected() -> None:
+    # Feb 7 is 3 days before the expected Feb 10; Mar 10 is 3 days after the expected Mar 7 (Feb 7 + 1 month).
+    rows = [ex(date(2026, 1, 10)), ex(date(2026, 2, 7)), ex(date(2026, 3, 10))]
+    (r,) = find_recurring(rows)
+    assert r.days == (date(2026, 1, 10), date(2026, 2, 7), date(2026, 3, 10))
+    assert r.next_expected == date(2026, 4, 10)
+
+
+def test_custom_tolerance_widens_connection() -> None:
+    rows = [ex(date(2026, 1, 1)), ex(date(2026, 2, 5)), ex(date(2026, 3, 5))]
+    assert len(find_recurring(rows, tolerance=4)) == 1
+
+
+# --- runs and splitting ------------------------------------------------------
+
+
+def test_run_shorter_than_min_count_is_dropped() -> None:
+    rows = [ex(date(2026, 1, 5)), ex(date(2026, 2, 5))]
+    assert find_recurring(rows) == []
+
+
+def test_gap_splits_into_separate_runs() -> None:
+    rows = [
+        ex(date(2026, 1, 5)),
+        ex(date(2026, 2, 5)),
+        ex(date(2026, 3, 5)),
+        ex(date(2026, 6, 5)),
+        ex(date(2026, 7, 5)),
+        ex(date(2026, 8, 5)),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 5), date(2026, 6, 5)]
+    assert [r.next_expected for r in result] == [date(2026, 4, 5), date(2026, 9, 5)]
+
+
+def test_short_run_dropped_while_long_run_kept() -> None:
+    rows = [
+        ex(date(2026, 1, 5)),
+        ex(date(2026, 2, 5)),
+        ex(date(2026, 6, 5)),
+        ex(date(2026, 7, 5)),
+        ex(date(2026, 8, 5)),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 6, 5), date(2026, 7, 5), date(2026, 8, 5))
+
+
+def test_min_count_larger_than_run_yields_nothing() -> None:
+    rows = [ex(date(2026, 1, 5)), ex(date(2026, 2, 5)), ex(date(2026, 3, 5))]
+    assert find_recurring(rows, min_count=4) == []
