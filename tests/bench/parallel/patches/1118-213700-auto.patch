+# --- basic detection ---------------------------------------------------------
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+def test_monthly_run_detected_with_fields() -> None:
+    rows = [ex(date(2026, 1, 5)), ex(date(2026, 2, 5)), ex(date(2026, 3, 5))]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="家賃",
+            amount=80000,
+            days=(date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+            next_expected=date(2026, 4, 5),
+        )
+    ]
+
+
+def test_next_expected_clamps_month_end() -> None:
+    rows = [ex(date(2026, 1, 31)), ex(date(2026, 2, 28)), ex(date(2026, 3, 31))]
+    (r,) = find_recurring(rows)
+    assert r.next_expected == date(2026, 4, 30)
+
+
+def test_memo_is_ignored_for_grouping() -> None:
+    rows = [
+        ex(date(2026, 1, 5), memo="1月"),
+        ex(date(2026, 2, 5), memo=""),
+        ex(date(2026, 3, 5), memo="3月分"),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_different_amount_or_category_not_grouped() -> None:
+    rows = [
+        ex(date(2026, 1, 5), amount=1000),
+        ex(date(2026, 2, 5), amount=2000),
+        ex(date(2026, 3, 5), amount=3000),
+        ex(date(2026, 1, 5), category="通信費", amount=1000),
+        ex(date(2026, 2, 5), category="通信費", amount=1000),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_duplicate_dates_are_removed_before_counting() -> None:
+    rows = [ex(date(2026, 1, 5)), ex(date(2026, 1, 5)), ex(date(2026, 2, 5))]
+    assert find_recurring(rows) == []
+
+
+def test_duplicate_dates_collapse_in_days() -> None:
+    rows = [
+        ex(date(2026, 1, 5)),
+        ex(date(2026, 1, 5)),
+        ex(date(2026, 2, 5)),
+        ex(date(2026, 3, 5)),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_unsorted_input_gives_same_result() -> None:
+    ordered = [ex(date(2026, 1, 5)), ex(date(2026, 2, 5)), ex(date(2026, 3, 5))]
+    shuffled = [ordered[2], ordered[0], ordered[1]]
+    assert find_recurring(shuffled) == find_recurring(ordered)
