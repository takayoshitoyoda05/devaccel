new file mode 100644
index 0000000..49d5bc5
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,119 @@
+"""Import bank CSV exports (他行の明細) into Expense records."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"-?[¥￥]?[0-9][0-9,]*円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    """Parse 「-¥1,234円」のような金額文字列を円の整数にする。"""
+    text = s.strip()
+    if not _AMOUNT_RE.fullmatch(text):
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    digits = text.replace(",", "").replace("¥", "").replace("￥", "").replace("円", "")
+    return int(digits)
+
+
+def parse_date(s: str) -> date:
+    """Parse 「YYYY/M/D」または「YYYY-M-D」を date にする。"""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    year, _, month, day = m.groups()
+    try:
+        return date(int(year), int(month), int(day))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def _cell(cells: list[str], index: dict[str, int], field: str) -> str:
+    """Value of `field` in this row; "" if unmapped or the row is short."""
+    i = index.get(field)
+    if i is None or i >= len(cells):
+        return ""
+    return cells[i]
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Read a bank CSV (1行目がヘッダー) and return (rows, errors).
+
+    errors is a list of (physical line number, field name); lines are
+    numbered from the header as 1. Rows with any error are not included.
+    """
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header = next(reader, None)
+    if header is None:
+        header = []
+
+    index: dict[str, int] = {}
+    for field, column in mapping.items():
+        if column not in header:
+            raise ValueError(f"列 {column!r} がヘッダーにありません")
+        index[field] = header.index(column)
+
+    rows: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    while True:
+        line = reader.line_num + 1  # 物理行番号(この行の先頭)
+        cells = next(reader, None)
+        if cells is None:
+            break
+        if not cells:  # 空行は読み飛ばす(行番号は数える)
+            continue
+
+        row_errors: list[tuple[int, str]] = []
+        day: date | None = None
+        amount: int | None = None
+
+        try:
+            day = parse_date(_cell(cells, index, "date"))
+        except ValueError:
+            row_errors.append((line, "date"))
+        try:
+            amount = parse_amount(_cell(cells, index, "amount"))
+        except ValueError:
+            row_errors.append((line, "amount"))
+        category = _cell(cells, index, "category").strip()
+        if not category:
+            row_errors.append((line, "category"))
+
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        assert day is not None and amount is not None
+        if category_map is not None:
+            category = category_map.get(category, category)
+        rows.append(
+            Expense(
+                day=day,
+                category=category,
+                amount=amount,
+                memo=_cell(cells, index, "memo").strip(),
+            )
+        )
+    return rows, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
new file mode 100644
index 0000000..c8203f5
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,96 @@
+"""Month-over-month category comparison (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def _month_of(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+    # presence is tracked by dict key, so a category whose amounts sum to 0
+    # still counts as having entries in that month.
+    totals: dict[str, dict[str, int]] = {prev_month: {}, curr_month: {}}
+    for e in rows:
+        m = _month_of(e)
+        if m in totals:
+            totals[m][e.category] = totals[m].get(e.category, 0) + e.amount
+    prev_t = totals[prev_month]
+    curr_t = totals[curr_month]
+
+    out: list[DiffRow] = []
+    for cat in set(prev_t) | set(curr_t):
+        prev = prev_t.get(cat, 0)
+        curr = curr_t.get(cat, 0)
+        delta = curr - prev
+        pct = None if prev == 0 else round(delta / prev * 100, 1)
+        if cat not in prev_t:
+            status = "new"
+        elif cat not in curr_t:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+    out.sort(key=lambda r: (-abs(r.delta), r.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [r for r in diffs if r.status != "same"][:n]
+
+
+def _fmt_pct(pct: float | None) -> str:
+    if pct is None:
+        return "-"
+    # + 0.0 turns -0.0 into 0.0 so it never renders as "-0.0%"
+    return f"{pct + 0.0:+.1f}%"
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for r in diffs:
+        lines.append(
+            f"{r.category}\t{r.prev}\t{r.curr}\t{r.delta:+d}\t{_fmt_pct(r.pct)}"
+        )
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month_of(e) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には 2 か月以上の明細が必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..21658e3
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,160 @@
+"""Search query language for expense rows.
+
+Grammar (lowest precedence first)::
+
+    or_expr  := and_expr ("OR" and_expr)*
+    and_expr := not_expr (["AND"] not_expr)*
+    not_expr := "NOT" not_expr | primary
+    primary  := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+Token = tuple[str, str]
+
+
+class QueryError(ValueError):
+    """Raised when a search query is malformed."""
+
+
+def tokenize(q: str) -> list[Token]:
+    tokens: list[Token] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError(f"閉じていない引用符があります: {q[i:]!r}")
+            body = q[i + 1 : end]
+            if body == "":
+                raise QueryError("空の引用符は使えません")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            start = i
+            while i < n and not (q[i].isspace() or q[i] in '()"'):
+                i += 1
+            word = q[start:i]
+            if word == "AND":
+                tokens.append(("AND", "AND"))
+            elif word == "OR":
+                tokens.append(("OR", "OR"))
+            elif word == "NOT":
+                tokens.append(("NOT", "NOT"))
+            elif word.startswith("cat:"):
+                value = word[len("cat:") :]
+                if value == "":
+                    raise QueryError("cat: の後ろが空です")
+                tokens.append(("CAT", value))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+# AST nodes: ("term", str) | ("cat", str) | ("not", node) | ("and", a, b) | ("or", a, b)
+Node = tuple
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self.tokens = tokens
+        self.pos = 0
+
+    def _peek(self) -> str | None:
+        return self.tokens[self.pos][0] if self.pos < len(self.tokens) else None
+
+    def _take(self) -> Token:
+        tok = self.tokens[self.pos]
+        self.pos += 1
+        return tok
+
+    def parse(self) -> Node:
+        if not self.tokens:
+            raise QueryError("検索条件が空です")
+        node = self._or_expr()
+        if self.pos != len(self.tokens):
+            raise QueryError(f"想定外のトークンです: {self.tokens[self.pos][1]!r}")
+        return node
+
+    def _or_expr(self) -> Node:
+        node = self._and_expr()
+        while self._peek() == "OR":
+            self._take()
+            node = ("or", node, self._and_expr())
+        return node
+
+    def _and_expr(self) -> Node:
+        node = self._not_expr()
+        while True:
+            kind = self._peek()
+            if kind == "AND":
+                self._take()
+                node = ("and", node, self._not_expr())
+            elif kind in ("NOT", "TERM", "CAT", "LPAREN"):
+                node = ("and", node, self._not_expr())
+            else:
+                return node
+
+    def _not_expr(self) -> Node:
+        if self._peek() == "NOT":
+            self._take()
+            return ("not", self._not_expr())
+        return self._primary()
+
+    def _primary(self) -> Node:
+        kind = self._peek()
+        if kind == "TERM":
+            return ("term", self._take()[1])
+        if kind == "CAT":
+            return ("cat", self._take()[1])
+        if kind == "LPAREN":
+            self._take()
+            node = self._or_expr()
+            if self._peek() != "RPAREN":
+                raise QueryError("括弧が閉じられていません")
+            self._take()
+            return node
+        if kind is None:
+            raise QueryError("演算子の後ろに項がありません")
+        raise QueryError(f"項が必要な位置に {self.tokens[self.pos][1]!r} があります")
+
+
+def _parse(q: str) -> Node:
+    return _Parser(tokenize(q)).parse()
+
+
+def _eval(node: Node, e: Expense) -> bool:
+    kind = node[0]
+    if kind == "term":
+        needle = node[1].casefold()
+        return needle in e.memo.casefold() or needle in e.category.casefold()
+    if kind == "cat":
+        return node[1].casefold() == e.category.casefold()
+    if kind == "not":
+        return not _eval(node[1], e)
+    if kind == "and":
+        return _eval(node[1], e) and _eval(node[2], e)
+    if kind == "or":
+        return _eval(node[1], e) or _eval(node[2], e)
+    raise AssertionError(f"unknown node: {kind!r}")  # pragma: no cover
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _eval(_parse(q), e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    node = _parse(q)
+    return [e for e in rows if _eval(node, e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..31ef294
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,73 @@
+"""Detect recurring (monthly) expenses. Pure functions, stdlib only."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day of the next month, clamped to that month's last day."""
+    year = d.year + d.month // 12
+    month = d.month % 12 + 1
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def _connected(prev: date, nxt: date, tolerance: int) -> bool:
+    return abs((nxt - add_month(prev)).days) <= tolerance
+
+
+def _run_to_recurring(
+    category: str, amount: int, run: list[date], min_count: int
+) -> Recurring | None:
+    if len(run) < min_count:
+        return None
+    return Recurring(
+        category=category,
+        amount=amount,
+        days=tuple(run),
+        next_expected=add_month(run[-1]),
+    )
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    """Find (category, amount) groups that repeat monthly on roughly the same day."""
+    if min_count < 2:
+        raise ValueError(f"min_count は 2 以上である必要があります: {min_count}")
+    if tolerance < 0:
+        raise ValueError(f"tolerance は 0 以上である必要があります: {tolerance}")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    out: list[Recurring] = []
+    for (category, amount), dates in groups.items():
+        run: list[date] = []
+        for d in sorted(dates):
+            if run and not _connected(run[-1], d, tolerance):
+                found = _run_to_recurring(category, amount, run, min_count)
+                if found is not None:
+                    out.append(found)
+                run = []
+            run.append(d)
+        found = _run_to_recurring(category, amount, run, min_count)
+        if found is not None:
+            out.append(found)
+
+    out.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return out
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..22d967b
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,268 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import (
+    DEFAULT_MAPPING,
+    import_rows,
+    parse_amount,
+    parse_date,
+)
+from kakeibo.core import Expense
+
+HEADER = "利用日,分類,利用金額,利用店名"
+
+
+# --- parse_amount -----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("-0", 0),
+        ("¥1", 1),
+        ("￥1", 1),
+        ("-980円", -980),
+        ("1,000円", 1000),
+        ("12,34", 1234),  # カンマの位置は検査しない
+        ("1,", 1),
+    ],
+)
+def test_parse_amount_accepts(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "   ",
+        "円",
+        "¥",
+        "-",
+        "12.5",
+        "1 200",
+        "--5",
+        "¥-5",
+        "１２３",
+        ",5",
+        "¥¥5",
+        "円5",
+        "5円円",
+        "1¥",
+        "+5",
+        "-円5",
+    ],
+)
+def test_parse_amount_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+# --- parse_date -------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/1/5 ", date(2026, 1, 5)),
+        ("2026-1-5", date(2026, 1, 5)),
+        ("2026/01/5", date(2026, 1, 5)),
+        ("2026/12/31", date(2026, 12, 31)),
+        ("2024/02/29", date(2024, 2, 29)),
+    ],
+)
+def test_parse_date_accepts(text: str, expected: date) -> None:
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "2026/1-5",
+        "2026-1/5",
+        "26/1/5",
+        "2026/02/30",
+        "2026/02/29",
+        "2026/13/1",
+        "2026/1/0",
+        "2026/1/5/",
+        "2026.1.5",
+        "２０２６/1/5",
+        "2026/1",
+        "2026//5",
+    ],
+)
+def test_parse_date_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+# --- DEFAULT_MAPPING --------------------------------------------------------
+
+
+def test_default_mapping() -> None:
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+# --- import_rows: 正常系 -----------------------------------------------------
+
+
+def test_import_rows_default_mapping() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,-¥300, セブン  \n"
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", -300, "セブン")]
+    assert errors == []
+
+
+def test_import_rows_none_mapping_equals_default() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,980円,店\n"
+    assert import_rows(text, None) == import_rows(text, DEFAULT_MAPPING)
+
+
+def test_import_rows_quoted_comma_in_value() -> None:
+    text = f'{HEADER}\n2026/1/5,食費,"1,200円","Shop, Inc"\n'
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 1200, "Shop, Inc")]
+    assert errors == []
+
+
+def test_import_rows_keeps_input_order_and_skips_bad_rows() -> None:
+    text = f"{HEADER}\n2026/1/5,A,100,a\nbad,B,200,b\n2026/1/7,C,300,c\n"
+    rows, errors = import_rows(text)
+    assert [e.category for e in rows] == ["A", "C"]
+    assert errors == [(3, "date")]
+
+
+def test_import_rows_extra_columns_ignored() -> None:
+    text = "x,利用日,分類,利用金額,利用店名,y\n1,2026/1/5,食費,100,店,2\n"
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "店")]
+    assert errors == []
+
+
+def test_import_rows_custom_mapping_without_memo() -> None:
+    text = "日付,科目,額\n2026/1/5,食費,100\n"
+    mapping = {"date": "日付", "category": "科目", "amount": "額"}
+    rows, errors = import_rows(text, mapping)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "")]
+    assert errors == []
+
+
+def test_import_rows_header_only_returns_empty() -> None:
+    assert import_rows(f"{HEADER}\n") == ([], [])
+
+
+def test_import_rows_category_map_replaces_after_strip() -> None:
+    text = f"{HEADER}\n2026/1/5, 食費 ,100,店\n2026/1/6,交通,200,駅\n"
+    rows, errors = import_rows(text, category_map={"食費": "食"})
+    assert [e.category for e in rows] == ["食", "交通"]
+    assert errors == []
+
+
+def test_import_rows_category_map_value_not_remapped() -> None:
+    text = f"{HEADER}\n2026/1/5,A,100,店\n"
+    rows, _ = import_rows(text, category_map={"A": "B", "B": "C"})
+    assert rows[0].category == "B"
+
+
+# --- import_rows: 異常系・検査順 ----------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "mapping",
+    [
+        {"category": "分類", "amount": "利用金額"},
+        {"date": "利用日", "amount": "利用金額"},
+        {"date": "利用日", "category": "分類"},
+        {},
+    ],
+)
+def test_import_rows_mapping_missing_required_key(mapping: dict[str, str]) -> None:
+    with pytest.raises(ValueError):
+        import_rows(f"{HEADER}\n", mapping)
+
+
+def test_import_rows_mapping_column_missing_from_header() -> None:
+    with pytest.raises(ValueError):
+        import_rows(f"{HEADER}\n", {**DEFAULT_MAPPING, "amount": "金額"})
+
+
+def test_import_rows_memo_column_missing_from_header() -> None:
+    with pytest.raises(ValueError):
+        import_rows(f"{HEADER}\n", {**DEFAULT_MAPPING, "memo": "無い列"})
+
+
+def test_import_rows_empty_text_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows("")
+
+
+def test_import_rows_bad_date_error() -> None:
+    rows, errors = import_rows(f"{HEADER}\n2026/02/30,食費,100,店\n")
+    assert rows == []
+    assert errors == [(2, "date")]
+
+
+def test_import_rows_bad_amount_error() -> None:
+    rows, errors = import_rows(f"{HEADER}\n2026/1/5,食費,12.5,店\n")
+    assert rows == []
+    assert errors == [(2, "amount")]
+
+
+def test_import_rows_empty_category_error() -> None:
+    rows, errors = import_rows(f"{HEADER}\n2026/1/5,   ,100,店\n")
+    assert rows == []
+    assert errors == [(2, "category")]
+
+
+def test_import_rows_records_all_errors_in_order() -> None:
+    rows, errors = import_rows(f"{HEADER}\nbad,  ,x,店\n")
+    assert rows == []
+    assert errors == [(2, "date"), (2, "amount"), (2, "category")]
+
+
+def test_import_rows_date_and_category_errors_only() -> None:
+    _, errors = import_rows(f"{HEADER}\nbad,,100,店\n")
+    assert errors == [(2, "date"), (2, "category")]
+
+
+def test_import_rows_short_row_missing_values_are_empty() -> None:
+    # 列が足りない: 欠けた amount と category は "" として扱われ、エラーになる
+    rows, errors = import_rows(f"{HEADER}\n2026/1/5\n")
+    assert rows == []
+    assert errors == [(2, "amount"), (2, "category")]
+
+
+def test_import_rows_short_row_missing_memo_is_empty_string() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,100\n"
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "")]
+    assert errors == []
+
+
+def test_import_rows_blank_lines_counted_in_line_numbers() -> None:
+    text = f"{HEADER}\n\n2026/1/5,食費,100,店\n\nbad,食費,100,店\n"
+    rows, errors = import_rows(text)
+    assert [e.amount for e in rows] == [100]
+    assert errors == [(5, "date")]
+
+
+def test_import_rows_multiline_quoted_field_uses_physical_line() -> None:
+    text = f'{HEADER}\n2026/1/5,食費,100,"店\n改行"\nbad,食費,100,店\n'
+    rows, errors = import_rows(text)
+    assert len(rows) == 1
+    assert rows[0].memo == "店\n改行"
+    assert errors == [(4, "date")]
