+"""Month-over-month comparison per category."""
+
+from __future__ import annotations
+
+from collections import defaultdict
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class CategoryDiff:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    rate: float | None
+    trend: str
+
+
+def month_over_month(
+    expenses: list[Expense], year: int, month: int
+) -> list[CategoryDiff]:
+    if not 1 <= month <= 12:
+        raise ValueError(f"month は 1〜12 です: {month}")
+    prev_year, prev_month = (year - 1, 12) if month == 1 else (year, month - 1)
+    prev: dict[str, int] = defaultdict(int)
+    cur: dict[str, int] = defaultdict(int)
+    for e in expenses:
+        if (e.day.year, e.day.month) == (year, month):
+            cur[e.category] += e.amount
+        elif (e.day.year, e.day.month) == (prev_year, prev_month):
+            prev[e.category] += e.amount
+
+    diffs: list[CategoryDiff] = []
+    for cat in set(prev) | set(cur):
+        p, c = prev.get(cat, 0), cur.get(cat, 0)
+        delta = c - p
+        trend = "増" if delta > 0 else "減" if delta < 0 else "変化なし"
+        diffs.append(CategoryDiff(cat, p, c, delta, delta / p if p else None, trend))
+    diffs.sort(key=lambda d: (-abs(d.delta), d.category))
+    return diffs
+
+
+def format_report(diffs: list[CategoryDiff]) -> str:
+    if not diffs:
+        return "差分なし"
+    lines = []
+    for d in diffs:
+        rate = "新規" if d.rate is None else f"{d.rate * 100:+.1f}%"
+        lines.append(
+            f"{d.category}: {d.previous} → {d.current} ({d.delta:+d}円, {rate})"
+        )
+    return "\n".join(lines)
