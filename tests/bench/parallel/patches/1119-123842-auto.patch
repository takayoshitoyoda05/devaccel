@@ -0,0 +1,103 @@
+"""Detect monthly recurring expenses and predict the next due date."""
+
+from __future__ import annotations
+
+import calendar
+import re
+import statistics
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_TOLERANCE = 0.10
+_TRAILING_NUMBER = re.compile(r"\s*#?\d+$")
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int
+    days: tuple[date, ...]
+    next_due: date
+
+
+def _normalize_memo(memo: str) -> str:
+    s = unicodedata.normalize("NFKC", memo).lower().strip()
+    s = re.sub(r"\s+", " ", s)
+    return _TRAILING_NUMBER.sub("", s).strip()
+
+
+def _cluster_amounts(items: list[Expense]) -> list[list[Expense]]:
+    """Group by amount: every member stays within ±10% of the cluster median."""
+    clusters: list[list[Expense]] = []
+    current: list[Expense] = []
+    for e in sorted(items, key=lambda x: x.amount):
+        candidate = [*current, e]
+        med = statistics.median(x.amount for x in candidate)
+        if all(abs(x.amount - med) <= med * _TOLERANCE for x in candidate):
+            current = candidate
+        else:
+            clusters.append(current)
+            current = [e]
+    if current:
+        clusters.append(current)
+    return clusters
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month
+
+
+def next_due(days: list[date]) -> date:
+    """Day after the last month at the median day-of-month (clamped to month end)."""
+    if not days:
+        raise ValueError("days が空です")
+    last = max(days)
+    idx = last.year * 12 + (last.month - 1) + 1
+    year, month = divmod(idx, 12)
+    month += 1
+    typical = int(statistics.median(d.day for d in days))
+    day = min(typical, calendar.monthrange(year, month)[1])
+    return date(year, month, day)
+
+
+def find_recurring(expenses: list[Expense], min_months: int = 3) -> list[Recurring]:
+    if min_months < 2:
+        raise ValueError("min_months は 2 以上にしてください")
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in expenses:
+        if e.amount <= 0:
+            continue
+        groups.setdefault((e.category, _normalize_memo(e.memo)), []).append(e)
+
+    found: list[Recurring] = []
+    for (category, memo), items in groups.items():
+        for cluster in _cluster_amounts(items):
+            first_of_month: dict[int, Expense] = {}
+            for e in sorted(cluster, key=lambda x: x.day):
+                first_of_month.setdefault(_month_index(e.day), e)
+            months = sorted(first_of_month)
+            run = [months[0]]
+            for m in months[1:]:
+                if m == run[-1] + 1:
+                    run.append(m)
+                else:
+                    run = [m]
+            if len(run) < min_months:
+                continue
+            picked = [first_of_month[m] for m in run]
+            days = tuple(e.day for e in picked)
+            found.append(
+                Recurring(
+                    category=category,
+                    memo=memo,
+                    amount=int(statistics.median(e.amount for e in picked)),
+                    days=days,
+                    next_due=next_due(list(days)),
+                )
+            )
+    found.sort(key=lambda r: (r.next_due, -r.amount, r.memo))
+    return found
