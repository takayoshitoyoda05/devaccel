@@ -0,0 +1,103 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import import_bank_csv
+from kakeibo.core import Expense
+
+
+def test_card_csv_with_quoted_amount():
+    r = import_bank_csv('利用日,ご利用店名,利用金額\n2026/1/5,コンビニ,"1,234円"\n')
+    assert r.errors == []
+    assert r.expenses == [Expense(date(2026, 1, 5), "未分類", 1234, "コンビニ")]
+
+
+def test_multiple_errors_same_row():
+    r = import_bank_csv("date,amount\n2026/2/30,△500\n")
+    assert r.expenses == []
+    assert [(e.line, e.column) for e in r.errors] == [(2, "date"), (2, "amount")]
+    assert r.errors[1].value == "△500"
+
+
+def test_deposit_only_row_skipped():
+    r = import_bank_csv(
+        "取引日,出金額,入金額,摘要\n2026-01-05,,10000,給与\n2026-01-06,300,,パン\n"
+    )
+    assert r.errors == []
+    assert [e.memo for e in r.expenses] == ["パン"]
+
+
+def test_both_empty_is_error():
+    r = import_bank_csv("取引日,出金額,入金額\n2026-01-05,,\n")
+    assert len(r.errors) == 1 and r.errors[0].column == "amount"
+
+
+@pytest.mark.parametrize("raw", ["-300", "−300", "△300", "▲300", "(300)", "300-"])
+def test_negative_styles_rejected_as_refund(raw: str):
+    r = import_bank_csv(f"date,amount\n2026-01-01,{raw}\n")
+    assert r.expenses == [] and "返金" in r.errors[0].reason
+
+
+@pytest.mark.parametrize(
+    "raw", ["¥1,200", "￥１，２００", "1200円", "JPY 1200", "1200.00"]
+)
+def test_amount_styles(raw: str):
+    r = import_bank_csv(f'date,amount\n2026-01-01,"{raw}"\n')
+    assert r.errors == [] and r.expenses[0].amount == 1200
+
+
+def test_decimal_and_zero_rejected():
+    r = import_bank_csv("date,amount\n2026-01-01,12.5\n2026-01-02,0\n")
+    assert [e.line for e in r.errors] == [2, 3]
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026.1.5",
+        "20260105",
+        "2026年1月5日",
+        "2026-01-05 12:30",
+        "2026-01-05T12:30:00",
+        "２０２６/１/５",
+    ],
+)
+def test_date_styles(raw: str):
+    r = import_bank_csv(f"date,amount\n{raw},100\n")
+    assert r.errors == [] and r.expenses[0].day == date(2026, 1, 5)
+
+
+def test_bom_tab_crlf_and_category():
+    r = import_bank_csv("﻿日付\t金額\t費目\t内容\r\n2026-01-05\t100\t食費\tパン\r\n")
+    assert r.expenses == [Expense(date(2026, 1, 5), "食費", 100, "パン")]
+
+
+def test_unquoted_comma_amount_reports_column_count():
+    r = import_bank_csv("date,amount,memo\n2026-01-05,1,234円,x\n")
+    assert len(r.errors) == 1
+    assert r.errors[0].line == 2 and r.errors[0].column == "(行全体)"
+
+
+def test_line_number_is_record_start_with_quoted_newline():
+    r = import_bank_csv('date,amount,memo\n2026-01-05,100,"a\nb"\n2026-13-01,100,x\n')
+    assert len(r.expenses) == 1 and r.expenses[0].memo == "a\nb"
+    assert r.errors[0].line == 4
+
+
+def test_missing_required_column():
+    r = import_bank_csv("foo,bar\n1,2\n")
+    assert r.expenses == [] and r.errors[0].line == 1
+
+
+def test_empty_and_header_only_and_blank_lines():
+    assert import_bank_csv("").expenses == []
+    assert import_bank_csv("date,amount\n").errors == []
+    r = import_bank_csv("date,amount\n\n2026-01-01,5\n")
+    assert len(r.expenses) == 1 and r.errors == []
+
+
+def test_header_case_and_spaces():
+    r = import_bank_csv(" Date , AMOUNT \n2026-01-01,5\n", default_category="他")
+    assert r.expenses[0].category == "他"
diff --git a/tests/test_monthly_diff.py b/tests/test_monthly_diff.py
new file mode 100644
index 0000000..810882f
--- /dev/null
+++ b/tests/test_monthly_diff.py
@@ -0,0 +1,80 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthly_diff import format_report, month_over_month
+
+
+def E(d: str, cat: str, amount: int) -> Expense:
+    return Expense(date.fromisoformat(d), cat, amount)
+
+
+def test_increase_across_year_boundary():
+    (d,) = month_over_month(
+        [E("2026-12-10", "食費", 10000), E("2027-01-10", "食費", 12000)], 2027, 1
+    )
+    assert (d.previous, d.current, d.delta, d.rate, d.trend) == (
+        10000,
+        12000,
+        2000,
+        0.2,
+        "増",
+    )
+
+
+def test_new_category_has_no_rate():
+    (d,) = month_over_month([E("2026-03-01", "交通", 3000)], 2026, 3)
+    assert d.previous == 0 and d.rate is None and d.trend == "増"
+
+
+def test_vanished_category():
+    (d,) = month_over_month([E("2026-02-01", "娯楽", 5000)], 2026, 3)
+    assert (d.current, d.delta, d.trend) == (0, -5000, "減")
+
+
+def test_refund_included_and_zero_kept():
+    ex = [
+        E("2026-02-01", "a", 1000),
+        E("2026-02-02", "a", -1000),
+        E("2026-03-01", "a", 0),
+    ]
+    (d,) = month_over_month(ex, 2026, 3)
+    assert d.previous == 0 and d.trend == "変化なし"
+
+
+def test_other_months_ignored_and_sorted():
+    ex = [
+        E("2026-01-01", "x", 9999),
+        E("2026-02-01", "b", 100),
+        E("2026-03-01", "b", 200),
+        E("2026-02-01", "a", 100),
+        E("2026-03-01", "a", 200),
+        E("2026-03-01", "c", 5000),
+    ]
+    assert [d.category for d in month_over_month(ex, 2026, 3)] == ["c", "a", "b"]
+
+
+def test_validation_and_empty():
+    with pytest.raises(ValueError):
+        month_over_month([], 2026, 13)
+    assert month_over_month([], 2026, 3) == []
+
+
+def test_format_report():
+    ex = [
+        E("2026-02-01", "食費", 8000),
+        E("2026-03-01", "食費", 9000),
+        E("2026-03-02", "交通", 300),
+        E("2026-02-03", "娯楽", 1000),
+        E("2026-03-03", "娯楽", 500),
+    ]
+    assert format_report(month_over_month(ex, 2026, 3)) == (
+        "食費: 8000 → 9000 (+1000円, +12.5%)\n"
+        "娯楽: 1000 → 500 (-500円, -50.0%)\n"
+        "交通: 0 → 300 (+300円, 新規)"
+    )
+
+
+def test_format_empty():
+    assert format_report([]) == "差分なし"
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..553252b
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,105 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import find_recurring, next_due
+
+
+def E(d: str, amount: int, memo: str = "家賃", cat: str = "住居") -> Expense:
+    return Expense(date.fromisoformat(d), cat, amount, memo)
+
+
+def test_rent_detected_with_next_due():
+    r = find_recurring(
+        [E("2026-01-25", 50000), E("2026-02-25", 50000), E("2026-03-25", 50000)]
+    )
+    assert len(r) == 1
+    assert r[0].amount == 50000
+    assert r[0].next_due == date(2026, 4, 25)
+
+
+def test_missing_month_breaks_run():
+    assert (
+        find_recurring(
+            [E("2026-01-10", 1000), E("2026-02-10", 1000), E("2026-04-10", 1000)]
+        )
+        == []
+    )
+
+
+def test_last_run_after_gap_counts():
+    ex = [E("2026-01-10", 1000)] + [E(f"2026-0{m}-10", 1000) for m in (3, 4, 5)]
+    r = find_recurring(ex)
+    assert len(r) == 1 and r[0].next_due == date(2026, 6, 10)
+
+
+def test_different_memos_are_separate_series():
+    ex = []
+    for m in (1, 2, 3):
+        ex += [E(f"2026-0{m}-05", 980, "A"), E(f"2026-0{m}-20", 980, "B")]
+    assert len(find_recurring(ex)) == 2
+
+
+def test_memo_normalization_trailing_number_and_width():
+    ex = [
+        E("2026-01-05", 980, "Ｎetflix 1"),
+        E("2026-02-05", 980, "netflix #2"),
+        E("2026-03-05", 980, "NETFLIX"),
+    ]
+    r = find_recurring(ex)
+    assert len(r) == 1 and r[0].memo == "netflix"
+
+
+def test_amount_wobble_within_ten_percent():
+    ex = [E("2026-01-05", 1000), E("2026-02-05", 1050), E("2026-03-05", 950)]
+    assert len(find_recurring(ex)) == 1
+
+
+def test_big_amount_change_splits():
+    ex = [E("2026-01-05", 1000), E("2026-02-05", 2000), E("2026-03-05", 1000)]
+    assert find_recurring(ex) == []
+
+
+def test_refunds_and_zero_ignored():
+    ex = [E("2026-01-05", -1000), E("2026-02-05", -1000), E("2026-03-05", 0)]
+    assert find_recurring(ex) == []
+
+
+def test_twice_in_month_counts_once():
+    ex = [E("2026-01-05", 1000), E("2026-01-20", 1000), E("2026-02-05", 1000)]
+    assert find_recurring(ex) == []
+    assert len(find_recurring(ex, min_months=2)) == 1
+
+
+def test_sort_by_next_due_then_amount():
+    ex = []
+    for m in (1, 2, 3):
+        ex += [
+            E(f"2026-0{m}-25", 100, "a"),
+            E(f"2026-0{m}-05", 100, "b"),
+            E(f"2026-0{m}-05", 300, "c"),
+        ]
+    assert [r.memo for r in find_recurring(ex)] == ["c", "b", "a"]
+
+
+def test_min_months_validation_and_empty():
+    assert find_recurring([]) == []
+    with pytest.raises(ValueError):
+        find_recurring([], min_months=1)
+
+
+def test_next_due_month_end_clamp():
+    assert next_due([date(2026, 1, 31), date(2026, 2, 28), date(2026, 3, 31)]) == date(
+        2026, 4, 30
+    )
+
+
+def test_next_due_year_wrap_and_leap():
+    assert next_due([date(2026, 12, 15)]) == date(2027, 1, 15)
+    assert next_due([date(2024, 1, 31)]) == date(2024, 2, 29)
+
+
+def test_next_due_empty():
+    with pytest.raises(ValueError):
+        next_due([])
diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..4860f60
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,65 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import Amount, And, Category, Memo, Not, Or, Period, matches, search
+
+A = Expense(date(2026, 1, 5), "食費", 1000, "Coffee ＳＨＯＰ")
+B = Expense(date(2026, 1, 20), "交通", 500, "電車")
+C = Expense(date(2026, 2, 1), "食費", 3000, "")
+ALL = [A, B, C]
+
+
+def test_category():
+    assert search(ALL, Category("食費")) == [A, C]
+
+
+def test_memo_substring_case_and_width_insensitive():
+    assert search(ALL, Memo("shop")) == [A]
+    assert search(ALL, Memo("ｃｏｆｆ")) == [A]
+
+
+def test_empty_memo_matches_all_empty_category_only_empty():
+    assert search(ALL, Memo("")) == ALL
+    assert search(ALL, Category("")) == []
+
+
+def test_amount_range_inclusive_and_open():
+    assert search(ALL, Amount(min=500, max=1000)) == [A, B]
+    assert search(ALL, Amount(min=1001)) == [C]
+    assert search(ALL, Amount(max=500)) == [B]
+
+
+def test_period_inclusive():
+    assert search(ALL, Period(date(2026, 1, 20), date(2026, 2, 1))) == [B, C]
+
+
+def test_and_or_not():
+    assert search(ALL, And(Category("食費"), Amount(min=2000))) == [C]
+    assert search(ALL, Or(Category("交通"), Amount(min=2000))) == [B, C]
+    assert search(ALL, Not(Category("食費"))) == [B]
+    assert search(ALL, Not(Or(Category("交通"), Memo("coffee")))) == [C]
+
+
+def test_empty_and_or():
+    assert search(ALL, And()) == ALL
+    assert search(ALL, Or()) == []
+
+
+def test_invalid_ranges():
+    with pytest.raises(ValueError):
+        search(ALL, Amount(min=1000, max=500))
+    with pytest.raises(ValueError):
+        matches(A, And(Period(date(2026, 2, 1), date(2026, 1, 1))))
+
+
+def test_unknown_term():
+    with pytest.raises(TypeError):
+        search(ALL, "食費")  # type: ignore[arg-type]
+
+
+def test_order_preserved_and_input_unchanged():
+    src = [C, A, B]
+    assert search(src, Amount()) == [C, A, B]
+    assert src == [C, A, B]
