+"""Small composable query language for filtering expenses."""
+
+from __future__ import annotations
+
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Category:
+    name: str
+
+
+@dataclass(frozen=True)
+class Amount:
+    min: int | None = None
+    max: int | None = None
+
+
+@dataclass(frozen=True)
+class Memo:
+    text: str
+
+
+@dataclass(frozen=True)
+class Period:
+    start: date | None = None
+    end: date | None = None
+
+
+@dataclass(frozen=True, init=False)
+class And:
+    terms: tuple[Query, ...]
+
+    def __init__(self, *terms: Query) -> None:
+        object.__setattr__(self, "terms", tuple(terms))
+
+
+@dataclass(frozen=True, init=False)
+class Or:
+    terms: tuple[Query, ...]
+
+    def __init__(self, *terms: Query) -> None:
+        object.__setattr__(self, "terms", tuple(terms))
+
+
+@dataclass(frozen=True)
+class Not:
+    term: Query
+
+
+Query = Category | Amount | Memo | Period | And | Or | Not
+
+
+def _norm(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).casefold()
+
+
+def _validate(q: object) -> None:
+    if isinstance(q, Amount):
+        if q.min is not None and q.max is not None and q.min > q.max:
+            raise ValueError(f"Amount の min が max より大きいです: {q.min} > {q.max}")
+    elif isinstance(q, Period):
+        if q.start is not None and q.end is not None and q.start > q.end:
+            raise ValueError(f"Period の start が end より後です: {q.start} > {q.end}")
+    elif isinstance(q, (And, Or)):
+        for t in q.terms:
+            _validate(t)
+    elif isinstance(q, Not):
+        _validate(q.term)
+    elif not isinstance(q, (Category, Memo)):
+        raise TypeError(f"未知の条件です: {q!r}")
+
+
+def _match(e: Expense, q: Query) -> bool:
+    if isinstance(q, Category):
+        return _norm(e.category) == _norm(q.name)
+    if isinstance(q, Memo):
+        return _norm(q.text) in _norm(e.memo)
+    if isinstance(q, Amount):
+        return (q.min is None or e.amount >= q.min) and (
+            q.max is None or e.amount <= q.max
+        )
+    if isinstance(q, Period):
+        return (q.start is None or e.day >= q.start) and (
+            q.end is None or e.day <= q.end
+        )
+    if isinstance(q, And):
+        return all(_match(e, t) for t in q.terms)
+    if isinstance(q, Or):
+        return any(_match(e, t) for t in q.terms)
+    return not _match(e, q.term)
+
+
+def matches(e: Expense, query: Query) -> bool:
+    _validate(query)
+    return _match(e, query)
+
+
+def search(expenses: list[Expense], query: Query) -> list[Expense]:
+    _validate(query)
+    return [e for e in expenses if _match(e, query)]
