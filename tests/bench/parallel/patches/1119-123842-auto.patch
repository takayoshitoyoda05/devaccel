@@ -0,0 +1,145 @@
+"""Import bank / credit-card CSV text with varied headers and amount styles."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str
+    value: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+
+
+_ALIASES = {
+    "date": ["date", "日付", "利用日", "取引日", "ご利用日", "年月日"],
+    "amount": ["amount", "金額", "利用金額", "ご利用金額", "出金額", "お支払金額"],
+    "memo": ["memo", "description", "摘要", "メモ", "利用店名", "ご利用店名", "内容"],
+    "category": ["category", "カテゴリ", "分類", "費目"],
+    "income": ["入金額", "預入", "入金"],
+}
+_FIELD_BY_NAME = {name: field for field, names in _ALIASES.items() for name in names}
+
+_DATE_YMD = re.compile(
+    r"(\d{4})[-/.年]\s*(\d{1,2})[-/.月]\s*(\d{1,2})日?(?:[T\s]\s*\d{1,2}:\d{2}(?::\d{2})?.*)?"
+)
+_DATE_COMPACT = re.compile(r"(\d{4})(\d{2})(\d{2})")
+_INTEGER = re.compile(r"\d+(?:\.0+)?")
+
+
+def _norm_header(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip().lower()
+
+
+def _parse_date(raw: str) -> date:
+    s = unicodedata.normalize("NFKC", raw).strip()
+    m = _DATE_YMD.fullmatch(s) or _DATE_COMPACT.fullmatch(s)
+    if not m:
+        raise ValueError(f"日付の書式が不正です: {raw!r}")
+    try:
+        return date(int(m[1]), int(m[2]), int(m[3]))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {raw!r}") from None
+
+
+def _parse_amount(raw: str) -> int:
+    s = unicodedata.normalize("NFKC", raw)
+    s = re.sub(r"(?i)jpy", "", s)
+    s = re.sub(r"[¥円,\s]", "", s)
+    negative = False
+    if len(s) >= 2 and s[0] == "(" and s[-1] == ")":
+        negative, s = True, s[1:-1]
+    elif s and s[0] in "-−△▲":
+        negative, s = True, s[1:]
+    elif s and s[-1] in "-−":
+        negative, s = True, s[:-1]
+    if not _INTEGER.fullmatch(s):
+        raise ValueError(f"金額が整数ではありません: {raw!r}")
+    value = int(float(s))
+    if negative or value == 0:
+        raise ValueError(f"返金・0 円は取り込めません: {raw!r}")
+    return value
+
+
+def import_bank_csv(text: str, default_category: str = "未分類") -> ImportResult:
+    text = text.lstrip("﻿")
+    first = text.splitlines()[0] if text.strip() else ""
+    delimiter = "\t" if first.count("\t") > first.count(",") else ","
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delimiter)
+
+    header: list[str] | None = None
+    cols: dict[str, int] = {}
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    prev_end = 0
+    for row in reader:
+        line = prev_end + 1
+        prev_end = reader.line_num
+        if not any(c.strip() for c in row):
+            continue
+        if header is None:
+            header = row
+            for i, name in enumerate(row):
+                field = _FIELD_BY_NAME.get(_norm_header(name))
+                if field and field not in cols:
+                    cols[field] = i
+            missing = [f for f in ("date", "amount") if f not in cols]
+            if missing:
+                return ImportResult(
+                    [], [RowError(1, f, "", "列が見つかりません") for f in missing]
+                )
+            continue
+        if len(row) != len(header):
+            errors.append(
+                RowError(
+                    line,
+                    "(行全体)",
+                    delimiter.join(row),
+                    f"列数が見出し({len(header)})と違います: {len(row)}",
+                )
+            )
+            continue
+
+        out_raw = row[cols["amount"]].strip()
+        in_idx = cols.get("income")
+        in_raw = row[in_idx].strip() if in_idx is not None else ""
+        if not out_raw and in_raw:
+            continue  # deposit-only row
+        row_errors: list[RowError] = []
+        day = amount = None
+        try:
+            day = _parse_date(row[cols["date"]])
+        except ValueError as e:
+            row_errors.append(RowError(line, "date", row[cols["date"]], str(e)))
+        if not out_raw:
+            reason = (
+                "出金・入金がともに空です" if in_idx is not None else "金額が空です"
+            )
+            row_errors.append(RowError(line, "amount", row[cols["amount"]], reason))
+        else:
+            try:
+                amount = _parse_amount(out_raw)
+            except ValueError as e:
+                row_errors.append(RowError(line, "amount", row[cols["amount"]], str(e)))
+        if row_errors or day is None or amount is None:
+            errors.extend(row_errors)
+            continue
+        category = row[cols["category"]].strip() if "category" in cols else ""
+        memo = row[cols["memo"]].strip() if "memo" in cols else ""
+        expenses.append(Expense(day, category or default_category, amount, memo))
+    return ImportResult(expenses, errors)
