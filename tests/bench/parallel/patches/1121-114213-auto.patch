@@ -0,0 +1,43 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankcsv import BankFormatError, parse_bank_csv
+from kakeibo.core import Expense
+
+
+def test_e2_1() -> None:  # E2-1
+    r = parse_bank_csv('利用日,ご利用店名,利用金額\n２０２６/１/５,ｽﾀﾊﾞ,"1,234円"\n')
+    assert r.errors == []
+    assert r.expenses == [Expense(date(2026, 1, 5), "未分類", 1234, "スタバ")]
+
+
+def test_e2_2() -> None:  # E2-2
+    r = parse_bank_csv("date,amount\n2026/02/30,abc\n")
+    assert r.expenses == []
+    assert [(e.line, e.column) for e in r.errors] == [(2, "日付"), (2, "金額")]
+
+
+def test_e2_3() -> None:  # E2-3
+    r = parse_bank_csv("日付,出金,入金\n2026-01-05,,1000\n2026-01-06,300,\n")
+    assert r.errors == []
+    assert [e.amount for e in r.expenses] == [300]
+
+
+@pytest.mark.parametrize(
+    ("raw", "want"),
+    [("-300", -300), ("△500", -500), ("(500)", -500), ("500-", -500), ("12.0", 12)],
+    ids=["neg", "triangle", "paren", "trail", "dot0"],
+)
+def test_amount_forms(raw: str, want: int) -> None:
+    r = parse_bank_csv(f"date,amount\n2026-01-01,{raw}\n")
+    assert r.expenses[0].amount == want
+
+
+def test_missing_columns() -> None:
+    with pytest.raises(BankFormatError):
+        parse_bank_csv("date,memo\n")
+    with pytest.raises(BankFormatError):
+        parse_bank_csv("")
diff --git a/tests/test_monthcompare.py b/tests/test_monthcompare.py
new file mode 100644
index 0000000..3949e21
--- /dev/null
+++ b/tests/test_monthcompare.py
@@ -0,0 +1,149 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthcompare import CategoryChange, category_changes, month_over_month
+
+
+def e(day: str, category: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(day), category=category, amount=amount)
+
+
+# E4-1: 1 月 食費 3000、3 月 食費 4000 → 2 月は食費 gone、3 月は食費 new
+@pytest.mark.parametrize("case_id", ["E4-1"])
+def test_E4_1_gone_then_new(case_id: str) -> None:
+    rows = [e("2026-01-10", "食費", 3000), e("2026-03-10", "食費", 4000)]
+    result = month_over_month(rows)
+    assert list(result) == ["2026-02", "2026-03"]
+    assert result["2026-02"] == [
+        CategoryChange(
+            category="食費",
+            previous=3000,
+            current=0,
+            diff=-3000,
+            pct=-100.0,
+            status="gone",
+        )
+    ]
+    assert result["2026-03"] == [
+        CategoryChange(
+            category="食費", previous=0, current=4000, diff=4000, pct=None, status="new"
+        )
+    ]
+
+
+# E4-2: 前月 食費 2000 → 今月 2500 → diff 500, pct 25.0, up
+@pytest.mark.parametrize("case_id", ["E4-2"])
+def test_E4_2_up(case_id: str) -> None:
+    rows = [e("2026-04-01", "食費", 2000), e("2026-05-01", "食費", 2500)]
+    assert category_changes(rows, "2026-05") == [
+        CategoryChange(
+            category="食費",
+            previous=2000,
+            current=2500,
+            diff=500,
+            pct=25.0,
+            status="up",
+        )
+    ]
+
+
+# E4-3: 食費 -500(返金)→ 食費 500 → previous -500, diff 1000, pct -200.0, up
+@pytest.mark.parametrize("case_id", ["E4-3"])
+def test_E4_3_negative_previous(case_id: str) -> None:
+    rows = [e("2026-04-01", "食費", -500), e("2026-05-01", "食費", 500)]
+    assert category_changes(rows, "2026-05") == [
+        CategoryChange(
+            category="食費",
+            previous=-500,
+            current=500,
+            diff=1000,
+            pct=-200.0,
+            status="up",
+        )
+    ]
+
+
+def test_month_validation_rejects_bad_format() -> None:
+    with pytest.raises(ValueError):
+        category_changes([], "2026-13")
+    with pytest.raises(ValueError):
+        category_changes([], "2026/05")
+
+
+def test_january_compares_with_previous_december() -> None:
+    rows = [e("2025-12-01", "食費", 1000), e("2026-01-01", "食費", 1000)]
+    assert category_changes(rows, "2026-01") == [
+        CategoryChange(
+            category="食費", previous=1000, current=1000, diff=0, pct=0.0, status="same"
+        )
+    ]
+
+
+def test_empty_rows_give_empty_list() -> None:
+    assert category_changes([], "2026-05") == []
+    assert month_over_month([]) == {}
+
+
+def test_single_month_gives_empty_dict() -> None:
+    assert month_over_month([e("2026-05-01", "食費", 100)]) == {}
+
+
+def test_both_zero_is_omitted() -> None:
+    rows = [
+        e("2026-04-01", "保険", 0),
+        e("2026-05-01", "保険", 0),
+        e("2026-05-01", "食費", 100),
+    ]
+    assert [c.category for c in category_changes(rows, "2026-05")] == ["食費"]
+
+
+def test_sorted_by_abs_diff_then_category() -> None:
+    rows = [
+        e("2026-04-01", "通信", 100),
+        e("2026-04-01", "娯楽", 300),
+        e("2026-05-01", "光熱費", 50),
+        e("2026-05-01", "食費", 200),
+    ]
+    # diff: 娯楽 -300, 食費 +200, 通信 -100, 光熱費 +50 → |diff| 降順
+    assert [(c.category, c.diff) for c in category_changes(rows, "2026-05")] == [
+        ("娯楽", -300),
+        ("食費", 200),
+        ("通信", -100),
+        ("光熱費", 50),
+    ]
+
+
+def test_same_diff_sorted_by_category_ascending() -> None:
+    rows = [
+        e("2026-04-01", "食費", 100),
+        e("2026-04-01", "通信", 100),
+        e("2026-05-01", "食費", 200),
+        e("2026-05-01", "通信", 0),
+    ]
+    # 食費 +100 / 通信 -100 は |diff| 同点 → category 昇順
+    assert [c.category for c in category_changes(rows, "2026-05")] == ["通信", "食費"]
+
+
+def test_same_status_when_diff_zero_and_down_when_negative() -> None:
+    rows = [
+        e("2026-04-01", "食費", 500),
+        e("2026-04-01", "住居", 800),
+        e("2026-05-01", "食費", 500),
+        e("2026-05-01", "住居", 300),
+    ]
+    by_cat = {c.category: c for c in category_changes(rows, "2026-05")}
+    assert by_cat["食費"].status == "same"
+    assert by_cat["住居"].status == "down"
+    assert by_cat["住居"].pct == -62.5
+
+
+def test_middle_empty_month_is_included_as_zero() -> None:
+    rows = [e("2026-01-01", "食費", 1000), e("2026-03-01", "食費", 1000)]
+    result = month_over_month(rows)
+    assert list(result) == ["2026-02", "2026-03"]
+    assert result["2026-02"][0].status == "gone"
+    assert result["2026-03"][0].status == "new"
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
