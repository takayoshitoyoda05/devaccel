@@ -0,0 +1,166 @@
+"""Parse bank / card statement CSV text into Expense records."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass, field
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str
+    value: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense] = field(default_factory=list)
+    errors: list[RowError] = field(default_factory=list)
+
+
+class BankFormatError(ValueError):
+    """Raised when the table as a whole cannot be read."""
+
+
+_DATE = ("date", "日付", "利用日", "取引日", "ご利用日", "年月日")
+_AMOUNT = ("amount", "金額", "利用金額", "ご利用金額", "支払金額")
+_OUT = ("出金", "出金額", "支払", "お支払金額")
+_IN = ("入金", "入金額", "預入", "お預り金額")
+_MEMO = ("memo", "摘要", "メモ", "利用店名", "ご利用店名", "内容", "description")
+_CATEGORY = ("category", "カテゴリ", "分類", "費目")
+
+
+def _norm(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip().casefold()
+
+
+def _find(header: list[str], names: tuple[str, ...]) -> int | None:
+    wanted = {_norm(n) for n in names}
+    for i, h in enumerate(header):
+        if h in wanted:
+            return i
+    return None
+
+
+_DATE_RE = re.compile(
+    r"(\d{4})[-/.年](\d{1,2})[-/.月](\d{1,2})日?(?:[ T]+\d{1,2}:\d{2}(?::\d{2})?)?"
+)
+_NUM_RE = re.compile(r"(\d+)(?:\.(\d+))?")
+
+
+def _parse_date(raw: str) -> date | None:
+    s = unicodedata.normalize("NFKC", raw).strip()
+    m = _DATE_RE.fullmatch(s)
+    if not m:
+        return None
+    try:
+        return date(int(m[1]), int(m[2]), int(m[3]))
+    except ValueError:
+        return None
+
+
+def _parse_amount(raw: str) -> int | None:
+    s = unicodedata.normalize("NFKC", raw).replace("−", "-")
+    s = re.sub(r"JPY", "", s, flags=re.IGNORECASE)
+    s = re.sub(r"[¥円,\s]", "", s)
+    neg = False
+    if s and s[0] in "△▲":
+        neg, s = True, s[1:]
+    elif s.startswith("(") and s.endswith(")"):
+        neg, s = True, s[1:-1]
+    elif s.startswith("-"):
+        neg, s = True, s[1:]
+    elif s.endswith("-"):
+        neg, s = True, s[:-1]
+    m = _NUM_RE.fullmatch(s)
+    if not m:
+        return None
+    if m[2] and m[2].strip("0"):
+        return None
+    n = int(m[1])
+    return -n if neg else n
+
+
+def parse_bank_csv(text: str) -> ImportResult:
+    text = text.removeprefix("﻿").replace("\r\n", "\n").replace("\r", "\n")
+    first = text.split("\n", 1)[0]
+    if not text.strip():
+        raise BankFormatError("ヘッダー行がありません")
+    delim = "\t" if first.count("\t") > first.count(",") else ","
+    reader = csv.reader(io.StringIO(text), delimiter=delim)
+    try:
+        header_row = next(reader)
+    except StopIteration:
+        raise BankFormatError("ヘッダー行がありません") from None
+    header = [_norm(h) for h in header_row]
+    i_date = _find(header, _DATE)
+    i_amt = _find(header, _AMOUNT)
+    i_out = _find(header, _OUT)
+    i_in = _find(header, _IN)
+    i_memo = _find(header, _MEMO)
+    i_cat = _find(header, _CATEGORY)
+    if i_date is None:
+        raise BankFormatError(f"日付列がありません(候補: {', '.join(_DATE)})")
+    if i_amt is None and i_out is None:
+        raise BankFormatError(f"金額列がありません(候補: {', '.join(_AMOUNT + _OUT)})")
+
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    prev_end = reader.line_num
+    for row in reader:
+        line = prev_end + 1
+        prev_end = reader.line_num
+        if not row:
+            continue
+        if len(row) != len(header):
+            errors.append(
+                RowError(
+                    line,
+                    "(行)",
+                    delim.join(row),
+                    f"列数が {len(row)} 個です(ヘッダーは {len(header)} 個)",
+                )
+            )
+            continue
+        bad = False
+        day = _parse_date(row[i_date])
+        if day is None:
+            bad = True
+            errors.append(RowError(line, "日付", row[i_date], "日付を解釈できません"))
+        if i_amt is not None:
+            a_col, a_raw = "金額", row[i_amt]
+        else:
+            assert i_out is not None
+            out_raw = row[i_out]
+            if out_raw.strip():
+                a_col, a_raw = "出金", out_raw
+            elif i_in is not None and row[i_in].strip():
+                if not bad:
+                    continue
+                a_col, a_raw = "", ""
+            else:
+                a_col, a_raw = "金額", ""
+        amount = None
+        if a_col:
+            amount = _parse_amount(a_raw)
+            if amount is None:
+                bad = True
+                errors.append(RowError(line, a_col, a_raw, "金額を解釈できません"))
+        if bad or day is None or amount is None:
+            continue
+        category = row[i_cat].strip() if i_cat is not None else ""
+        memo = (
+            unicodedata.normalize("NFKC", row[i_memo]).strip()
+            if i_memo is not None
+            else ""
+        )
+        expenses.append(Expense(day, category or "未分類", amount, memo))
+    return ImportResult(expenses, errors)
