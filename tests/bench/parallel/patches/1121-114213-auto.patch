@@ -0,0 +1,111 @@
+"""Detect recurring expenses (subscriptions, rent, ...) from Expense rows."""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from collections import Counter, defaultdict
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_TRAILING_RE = re.compile(r"\s*(?:#\d+|\d+)$")
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str  # original memo of the latest entry in the series
+    amount: int  # amount of the latest entry in the series
+    months: int  # consecutive months ending at the latest month
+    last_day: date
+    next_day: date
+
+
+def _normalize_memo(memo: str) -> str:
+    """D1: NFKC -> casefold -> collapse whitespace -> drop a trailing number or #number."""
+    s = unicodedata.normalize("NFKC", memo).casefold()
+    s = " ".join(s.split())
+    return _TRAILING_RE.sub("", s).strip()
+
+
+def _check_int(name: str, value: object) -> int:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{name} は整数である必要があります: {value!r}")
+    return value
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month - 1
+
+
+def _judge(
+    category: str, entries: list[Expense], min_months: int, tolerance: float
+) -> Recurring | None:
+    entries = sorted(entries, key=lambda e: e.day)
+    present = {_month_index(e.day) for e in entries}
+    latest = max(present)
+    # R2: count consecutive months backwards from the latest month.
+    run_len = 0
+    while latest - run_len in present:
+        run_len += 1
+    if run_len < min_months:
+        return None
+    start = latest - run_len + 1
+    run = [e for e in entries if _month_index(e.day) >= start]
+    # R3: two or more entries in one month make the series ambiguous.
+    if any(c > 1 for c in Counter(_month_index(e.day) for e in run).values()):
+        return None
+    # R4: amounts may drift within tolerance (relative to the max).
+    amounts = [e.amount for e in run]
+    hi, lo = max(amounts), min(amounts)
+    if (hi - lo) / hi > tolerance:
+        return None
+    last = run[-1]
+    # R5: next month, using the max day of the series clipped to that month's end.
+    next_year, next_month0 = divmod(latest + 1, 12)
+    next_month = next_month0 + 1
+    month_len = calendar.monthrange(next_year, next_month)[1]
+    max_day = max(e.day.day for e in run)
+    return Recurring(
+        category=category,
+        memo=last.memo,
+        amount=last.amount,
+        months=run_len,
+        last_day=last.day,
+        next_day=date(next_year, next_month, min(max_day, month_len)),
+    )
+
+
+def find_recurring(
+    rows: list[Expense], *, min_months: int = 3, tolerance: float = 0.1
+) -> list[Recurring]:
+    """Find expenses that repeat monthly at (nearly) the same amount.
+
+    Refunds and zero amounts are ignored (D3). Results are sorted by
+    next_day, category, memo.
+    """
+    min_months = _check_int("min_months", min_months)
+    if min_months < 2:
+        raise ValueError(f"min_months は 2 以上である必要があります: {min_months}")
+    if isinstance(tolerance, bool) or not isinstance(tolerance, (int, float)):
+        raise TypeError(f"tolerance は数値である必要があります: {tolerance!r}")
+    if not 0 <= tolerance <= 1:
+        raise ValueError(f"tolerance は 0 以上 1 以下である必要があります: {tolerance}")
+
+    # R1: series key is (category, normalized memo).
+    groups: dict[tuple[str, str], list[Expense]] = defaultdict(list)
+    for e in rows:
+        if e.amount > 0:
+            groups[(e.category, _normalize_memo(e.memo))].append(e)
+
+    out: list[Recurring] = []
+    for (category, _key), entries in groups.items():
+        rec = _judge(category, entries, min_months, float(tolerance))
+        if rec is not None:
+            out.append(rec)
+    # R6
+    out.sort(key=lambda r: (r.next_day, r.category, r.memo))
+    return out
diff --git a/src/kakeibo/search.py b/src/kakeibo/search.py
new file mode 100644
index 0000000..58e652f
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,129 @@
+"""Composable search conditions over Expense records (pure functions)."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable
+from datetime import date
+
+from kakeibo.core import Expense
+
+Condition = Callable[[Expense], bool]
+
+
+def _nfkc(text: str) -> str:
+    return unicodedata.normalize("NFKC", text)
+
+
+def _check_int(value: object, name: str) -> int | None:
+    if value is None:
+        return None
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{name} は int である必要があります: {value!r}")
+    return value
+
+
+def _check_date(value: object, name: str) -> date | None:
+    if value is None:
+        return None
+    if not isinstance(value, date) or type(value) is not date:
+        raise TypeError(f"{name} は date である必要があります: {value!r}")
+    return value
+
+
+def _check_condition(cond: object, name: str = "condition") -> Condition:
+    if not callable(cond):
+        raise TypeError(f"{name} は呼び出し可能である必要があります: {cond!r}")
+    return cond  # type: ignore[return-value]
+
+
+def category_is(*names: str) -> Condition:
+    """カテゴリが names のいずれかに完全一致(NFKC・前後空白除去後、大文字小文字は区別)。"""
+    if not names:
+        raise ValueError("category_is には少なくとも 1 つの名前が必要です")
+    targets: set[str] = set()
+    for name in names:
+        if not isinstance(name, str):
+            raise TypeError(f"カテゴリ名は str である必要があります: {name!r}")
+        targets.add(_nfkc(name).strip())
+
+    def cond(e: Expense) -> bool:
+        return _nfkc(e.category).strip() in targets
+
+    return cond
+
+
+def amount_between(low: int | None = None, high: int | None = None) -> Condition:
+    """low <= amount <= high(両端を含む)。None は無制限。"""
+    lo = _check_int(low, "low")
+    hi = _check_int(high, "high")
+    if lo is not None and hi is not None and lo > hi:
+        raise ValueError(f"low ({lo}) は high ({hi}) 以下である必要があります")
+
+    def cond(e: Expense) -> bool:
+        return (lo is None or e.amount >= lo) and (hi is None or e.amount <= hi)
+
+    return cond
+
+
+def date_between(start: date | None = None, end: date | None = None) -> Condition:
+    """start <= day <= end(両端を含む)。None は無制限。"""
+    s = _check_date(start, "start")
+    t = _check_date(end, "end")
+    if s is not None and t is not None and s > t:
+        raise ValueError(f"start ({s}) は end ({t}) 以前である必要があります")
+
+    def cond(e: Expense) -> bool:
+        return (s is None or e.day >= s) and (t is None or e.day <= t)
+
+    return cond
+
+
+def memo_contains(text: str) -> Condition:
+    """メモに text を部分一致(NFKC・大文字小文字無視)。空文字列は ValueError。"""
+    if not isinstance(text, str):
+        raise TypeError(f"text は str である必要があります: {text!r}")
+    needle = _nfkc(text).casefold()
+    if needle == "":
+        raise ValueError("memo_contains の text は空にできません")
+
+    def cond(e: Expense) -> bool:
+        return needle in _nfkc(e.memo).casefold()
+
+    return cond
+
+
+def and_(*conds: Condition) -> Condition:
+    """全てが真なら真。引数なしは常に真。"""
+    checked = [_check_condition(c) for c in conds]
+
+    def cond(e: Expense) -> bool:
+        return all(c(e) for c in checked)
+
+    return cond
+
+
+def or_(*conds: Condition) -> Condition:
+    """どれかが真なら真。引数なしは常に偽。"""
+    checked = [_check_condition(c) for c in conds]
+
+    def cond(e: Expense) -> bool:
+        return any(c(e) for c in checked)
+
+    return cond
+
+
+def not_(c: Condition) -> Condition:
+    """条件の否定。"""
+    inner = _check_condition(c)
+
+    def cond(e: Expense) -> bool:
+        return not inner(e)
+
+    return cond
+
+
+def search(rows: list[Expense], condition: Condition) -> list[Expense]:
+    """condition が真の明細を入力順のまま新しいリストで返す(入力は変更しない)。"""
+    check = _check_condition(condition)
+    return [e for e in rows if check(e)]
