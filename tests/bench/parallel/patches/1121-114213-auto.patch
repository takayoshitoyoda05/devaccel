+"""Month-over-month comparison of category totals (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense, monthly_totals
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    diff: int
+    pct: float | None
+    status: str  # "up" | "down" | "same" | "new" | "gone"
+
+
+def _check_month(month: str) -> None:
+    if not isinstance(month, str) or not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"month は YYYY-MM 形式である必要があります: {month!r}")
+
+
+def _previous_month(month: str) -> str:
+    year, mon = int(month[:4]), int(month[5:])
+    if mon == 1:
+        return f"{year - 1:04d}-12"
+    return f"{year:04d}-{mon - 1:02d}"
+
+
+def _changes(totals: dict[str, dict[str, int]], month: str) -> list[CategoryChange]:
+    previous_cats = totals.get(_previous_month(month), {})
+    current_cats = totals.get(month, {})
+    out: list[CategoryChange] = []
+    for cat in set(previous_cats) | set(current_cats):
+        previous = previous_cats.get(cat, 0)
+        current = current_cats.get(cat, 0)
+        if previous == 0 and current == 0:
+            continue
+        diff = current - previous
+        pct = None if previous == 0 else diff / previous * 100
+        if previous == 0 and current > 0:
+            status = "new"
+        elif previous > 0 and current == 0:
+            status = "gone"
+        elif diff > 0:
+            status = "up"
+        elif diff < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(CategoryChange(cat, previous, current, diff, pct, status))
+    out.sort(key=lambda c: (-abs(c.diff), c.category))
+    return out
+
+
+def category_changes(rows: list[Expense], month: str) -> list[CategoryChange]:
+    """Compare `month` (YYYY-MM) with the calendar month before it."""
+    _check_month(month)
+    return _changes(monthly_totals(rows), month)
+
+
+def month_over_month(rows: list[Expense]) -> dict[str, list[CategoryChange]]:
+    """Changes for every month after the first data month, through the last.
+
+    Months with no data in between are included and treated as empty.
+    """
+    if not rows:
+        return {}
+    totals = monthly_totals(rows)
+    first = min(e.day for e in rows)
+    last = max(e.day for e in rows)
+    months: list[str] = []
+    year, mon = first.year, first.month
+    while (year, mon) <= (last.year, last.month):
+        months.append(f"{year:04d}-{mon:02d}")
+        year, mon = (year + 1, 1) if mon == 12 else (year, mon + 1)
+    return {m: _changes(totals, m) for m in months[1:]}
