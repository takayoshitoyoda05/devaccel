+from __future__ import annotations
+
+from datetime import date, datetime
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    amount_between,
+    and_,
+    category_is,
+    date_between,
+    memo_contains,
+    not_,
+    or_,
+    search,
+)
+
+
+def _e(
+    day: date = date(2026, 3, 10),
+    category: str = "食費",
+    amount: int = 1000,
+    memo: str = "",
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- 例の表 (E3-*) ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("case_id", "expense", "cond", "expected"),
+    [
+        ("E3-1", _e(amount=1000), amount_between(1000, 1000), True),
+        ("E3-2", _e(memo="スタバ 渋谷"), memo_contains("ｽﾀﾊﾞ"), True),
+        ("E3-3a", _e(), or_(), False),
+        ("E3-3b", _e(), and_(), True),
+    ],
+    ids=["E3-1", "E3-2", "E3-3a", "E3-3b"],
+)
+def test_example_table(case_id: str, expense: Expense, cond, expected: bool) -> None:
+    assert cond(expense) is expected
+
+
+# --- 端のケース (仕様から書き出したもの) ------------------------------------
+
+
+def test_search_preserves_order_and_returns_new_list() -> None:
+    rows = [_e(amount=300), _e(amount=100), _e(amount=200)]
+    snapshot = list(rows)
+    out = search(rows, amount_between(0, 1000))
+    assert out == rows
+    assert out is not rows
+    assert rows == snapshot
+
+
+def test_search_does_not_mutate_input_when_nothing_matches() -> None:
+    rows = [_e(amount=5)]
+    out = search(rows, amount_between(100, None))
+    assert out == []
+    assert rows == [_e(amount=5)]
+
+
+def test_search_rejects_non_callable_condition() -> None:
+    with pytest.raises(TypeError):
+        search([_e()], None)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("name", ["食費", " 食費 ", "　食費　"])
+def test_category_is_matches_after_nfkc_and_strip(name: str) -> None:
+    assert category_is(name)(_e(category="食費")) is True
+
+
+def test_category_is_is_case_sensitive() -> None:
+    assert category_is("food")(_e(category="Food")) is False
+    assert category_is("Food")(_e(category="Food")) is True
+
+
+def test_category_is_or_over_multiple_names() -> None:
+    cond = category_is("食費", "外食")
+    assert cond(_e(category="外食")) is True
+    assert cond(_e(category="交通")) is False
+
+
+def test_category_is_requires_at_least_one_name() -> None:
+    with pytest.raises(ValueError):
+        category_is()
+
+
+def test_category_is_rejects_non_str() -> None:
+    with pytest.raises(TypeError):
+        category_is(1)  # type: ignore[arg-type]
+
+
+def test_amount_between_is_inclusive_on_both_ends() -> None:
+    cond = amount_between(100, 200)
+    assert cond(_e(amount=100)) is True
+    assert cond(_e(amount=200)) is True
+    assert cond(_e(amount=99)) is False
+    assert cond(_e(amount=201)) is False
+
+
+def test_amount_between_open_ends() -> None:
+    assert amount_between(low=500)(_e(amount=10**9)) is True
+    assert amount_between(low=500)(_e(amount=499)) is False
+    assert amount_between(high=500)(_e(amount=-10)) is True
+    assert amount_between(high=500)(_e(amount=501)) is False
+
+
+def test_amount_between_both_none_is_always_true() -> None:
+    cond = amount_between()
+    assert cond(_e(amount=-5)) is True
+    assert cond(_e(amount=0)) is True
+
+
+def test_amount_between_low_greater_than_high_is_value_error() -> None:
+    with pytest.raises(ValueError):
+        amount_between(200, 100)
+
+
+@pytest.mark.parametrize(
+    "args",
+    [(True, None), (None, False), (1.5, None), ("100", None)],
+)
+def test_amount_between_rejects_non_int(args: tuple) -> None:
+    with pytest.raises(TypeError):
+        amount_between(*args)
+
+
+def test_date_between_is_inclusive_on_both_ends() -> None:
+    cond = date_between(date(2026, 3, 1), date(2026, 3, 31))
+    assert cond(_e(day=date(2026, 3, 1))) is True
+    assert cond(_e(day=date(2026, 3, 31))) is True
+    assert cond(_e(day=date(2026, 2, 28))) is False
+    assert cond(_e(day=date(2026, 4, 1))) is False
+
+
+def test_date_between_open_ends_and_both_none() -> None:
+    assert date_between(start=date(2026, 3, 1))(_e(day=date(2030, 1, 1))) is True
+    assert date_between(end=date(2026, 3, 1))(_e(day=date(2000, 1, 1))) is True
+    assert date_between()(_e(day=date(1999, 12, 31))) is True
+
+
+def test_date_between_start_after_end_is_value_error() -> None:
+    with pytest.raises(ValueError):
+        date_between(date(2026, 4, 1), date(2026, 3, 1))
+
+
+def test_date_between_rejects_datetime() -> None:
+    with pytest.raises(TypeError):
+        date_between(datetime(2026, 3, 1))  # type: ignore[arg-type]
+
+
+def test_memo_contains_is_partial_and_case_insensitive() -> None:
+    assert memo_contains("coffee")(_e(memo="Blue Bottle COFFEE 豆")) is True
+    assert memo_contains("tea")(_e(memo="coffee")) is False
+
+
+def test_memo_contains_empty_string_is_value_error() -> None:
+    with pytest.raises(ValueError):
+        memo_contains("")
+
+
+def test_and_or_not_compose() -> None:
+    cond = and_(category_is("食費"), not_(amount_between(low=5000)))
+    assert cond(_e(category="食費", amount=1000)) is True
+    assert cond(_e(category="食費", amount=6000)) is False
+    assert cond(_e(category="交通", amount=1000)) is False
+
+    either = or_(category_is("交通"), memo_contains("ランチ"))
+    assert either(_e(category="食費", memo="ランチ")) is True
+    assert either(_e(category="食費", memo="夕食")) is False
+
+
+@pytest.mark.parametrize(
+    "factory",
+    [
+        lambda: and_(None),  # type: ignore[arg-type]
+        lambda: or_(None),  # type: ignore[arg-type]
+        lambda: not_(None),  # type: ignore[arg-type]
+    ],
+)
+def test_combinators_reject_non_callable(factory) -> None:
+    with pytest.raises(TypeError):
+        factory()
