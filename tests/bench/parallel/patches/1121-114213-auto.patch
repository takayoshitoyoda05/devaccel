@@ -0,0 +1,190 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring
+
+
+def _e(
+    y: int,
+    m: int,
+    d: int,
+    amount: int = 1490,
+    memo: str = "Netflix",
+    category: str = "サブスク",
+) -> Expense:
+    return Expense(day=date(y, m, d), category=category, amount=amount, memo=memo)
+
+
+_E1_1_ROWS = [_e(2026, 1, 31), _e(2026, 2, 28), _e(2026, 3, 31)]
+_E1_1_EXPECTED = [
+    Recurring(
+        category="サブスク",
+        memo="Netflix",
+        amount=1490,
+        months=3,
+        last_day=date(2026, 3, 31),
+        next_day=date(2026, 4, 30),
+    )
+]
+
+_E1_2_ROWS = [_e(2026, 1, 10), _e(2026, 2, 10), _e(2026, 4, 10)]
+
+_E1_3_ROWS = [
+    *[_e(2026, m, 5, amount=3000, memo="ジム", category="通信") for m in (1, 2, 3)],
+    *[_e(2026, m, 20, amount=3000, memo="ヨガ", category="通信") for m in (1, 2, 3)],
+]
+_E1_3_EXPECTED = [
+    Recurring(
+        category="通信",
+        memo="ジム",
+        amount=3000,
+        months=3,
+        last_day=date(2026, 3, 5),
+        next_day=date(2026, 4, 5),
+    ),
+    Recurring(
+        category="通信",
+        memo="ヨガ",
+        amount=3000,
+        months=3,
+        last_day=date(2026, 3, 20),
+        next_day=date(2026, 4, 20),
+    ),
+]
+
+
+@pytest.mark.parametrize(
+    ("rows", "expected"),
+    [
+        pytest.param(_E1_1_ROWS, _E1_1_EXPECTED, id="E1-1"),
+        pytest.param(_E1_2_ROWS, [], id="E1-2"),
+        pytest.param(_E1_3_ROWS, _E1_3_EXPECTED, id="E1-3"),
+    ],
+)
+def test_example_table(rows: list[Expense], expected: list[Recurring]) -> None:
+    assert find_recurring(rows) == expected
+
+
+def test_empty_input() -> None:
+    assert find_recurring([]) == []
+
+
+def test_memo_normalization_merges_series() -> None:
+    rows = [
+        _e(2026, 1, 1, memo="Netflix"),
+        _e(2026, 2, 1, memo="ｎｅｔｆｌｉｘ #2"),
+        _e(2026, 3, 1, memo="NETFLIX  3"),
+    ]
+    [rec] = find_recurring(rows)
+    assert rec.memo == "NETFLIX  3"
+    assert rec.months == 3
+
+
+def test_run_is_cut_at_first_missing_month() -> None:
+    # Dec 2025 is missing, so the older 500-yen entries are ignored.
+    rows = [
+        _e(2025, 10, 1, amount=500),
+        _e(2025, 11, 1, amount=500),
+        _e(2026, 1, 1, amount=1000),
+        _e(2026, 2, 1, amount=1000),
+        _e(2026, 3, 1, amount=1000),
+    ]
+    [rec] = find_recurring(rows)
+    assert rec.months == 3
+    assert rec.amount == 1000
+
+
+def test_duplicate_month_in_run_is_not_recurring() -> None:
+    rows = [_e(2026, 1, 1), _e(2026, 2, 1), _e(2026, 2, 15), _e(2026, 3, 1)]
+    assert find_recurring(rows) == []
+
+
+def test_refund_and_zero_amounts_are_excluded() -> None:
+    rows = [
+        _e(2026, 1, 1),
+        _e(2026, 2, 1),
+        _e(2026, 2, 1, amount=0),
+        _e(2026, 3, 1),
+        _e(2026, 3, 1, amount=-1490),
+    ]
+    [rec] = find_recurring(rows)
+    assert rec.months == 3
+    assert rec.amount == 1490
+    assert rec.next_day == date(2026, 4, 1)
+
+
+def test_amount_drift_beyond_tolerance_is_not_recurring() -> None:
+    rows = [
+        _e(2026, 1, 1, amount=1000),
+        _e(2026, 2, 1, amount=1000),
+        _e(2026, 3, 1, amount=1200),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_amount_drift_within_tolerance_is_recurring() -> None:
+    rows = [
+        _e(2026, 1, 1, amount=1000),
+        _e(2026, 2, 1, amount=1000),
+        _e(2026, 3, 1, amount=1100),
+    ]
+    [rec] = find_recurring(rows)
+    assert rec.amount == 1100
+
+
+def test_tolerance_boundary_is_inclusive() -> None:
+    rows = [
+        _e(2026, 1, 1, amount=1000),
+        _e(2026, 2, 1, amount=1000),
+        _e(2026, 3, 1, amount=900),
+    ]
+    [rec] = find_recurring(rows, tolerance=0.1)
+    assert rec.amount == 900
+
+
+def test_next_day_rolls_over_year_end() -> None:
+    rows = [_e(2025, 10, 31), _e(2025, 11, 30), _e(2025, 12, 31)]
+    [rec] = find_recurring(rows)
+    assert rec.next_day == date(2026, 1, 31)
+
+
+def test_next_day_clipped_to_february_end() -> None:
+    rows = [_e(2025, 11, 30), _e(2025, 12, 31), _e(2026, 1, 31)]
+    [rec] = find_recurring(rows)
+    assert rec.next_day == date(2026, 2, 28)
+
+
+def test_next_day_clipped_to_leap_february() -> None:
+    rows = [_e(2027, 11, 30), _e(2027, 12, 31), _e(2028, 1, 31)]
+    [rec] = find_recurring(rows)
+    assert rec.next_day == date(2028, 2, 29)
+
+
+def test_results_sorted_by_next_day() -> None:
+    rows = [
+        *[_e(2026, m, 10, memo="A") for m in (1, 2, 3)],
+        *[_e(2026, m, 5, memo="B") for m in (1, 2, 3)],
+    ]
+    assert [r.memo for r in find_recurring(rows)] == ["B", "A"]
+
+
+@pytest.mark.parametrize("min_months", [1, 0, -3])
+def test_min_months_below_two_is_value_error(min_months: int) -> None:
+    with pytest.raises(ValueError, match="min_months"):
+        find_recurring([], min_months=min_months)
+
+
+@pytest.mark.parametrize("min_months", [True, 3.0, "3"])
+def test_min_months_non_int_is_type_error(min_months: object) -> None:
+    with pytest.raises(TypeError, match="min_months"):
+        find_recurring([], min_months=min_months)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("tolerance", [-0.1, 1.5])
+def test_tolerance_out_of_range_is_value_error(tolerance: float) -> None:
+    with pytest.raises(ValueError, match="tolerance"):
+        find_recurring([], tolerance=tolerance)
