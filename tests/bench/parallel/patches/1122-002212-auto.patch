--- a/src/click/types.py
+++ b/src/click/types.py
@@ -464,13 +464,25 @@ class Choice(ParamType[_ValueT_co], t.Generic[_ValueT_co]):
 
         .. versionadded:: 8.2
         """
-        choices_str = ", ".join(map(repr, self._normalized_mapping(ctx=ctx).values()))
-        return ngettext(
+        # Imported lazily to keep ``import click`` light; only needed on error.
+        import difflib
+
+        normalized = list(self._normalized_mapping(ctx=ctx).values())
+        choices_str = ", ".join(map(repr, normalized))
+        message = ngettext(
             "{value!r} is not {choice}.",
             "{value!r} is not one of {choices}.",
             len(self.choices),
         ).format(value=value, choice=choices_str, choices=choices_str)
 
+        normed_value = self.normalize_choice(choice=value, ctx=ctx)
+        matches = difflib.get_close_matches(normed_value, normalized, n=1)
+
+        if matches:
+            message += " " + _("Did you mean {choice!r}?").format(choice=matches[0])
+
+        return message
+
     def __repr__(self) -> str:
         return _("Choice({choices})").format(choices=list(self.choices))
 
diff --git a/tests/test_types/test_Choice.py b/tests/test_types/test_Choice.py
index c34f516..4b04d37 100644
--- a/tests/test_types/test_Choice.py
+++ b/tests/test_types/test_Choice.py
@@ -1,7 +1,78 @@
+import enum
+
 import click
+from click.testing import CliRunner
 
 
 def test_choice_get_invalid_choice_message():
     choice = click.Choice(["a", "b", "c"])
     message = choice.get_invalid_choice_message("d", ctx=None)
     assert message == "'d' is not one of 'a', 'b', 'c'."
+
+
+def test_invalid_choice_suggests_close_match():
+    choice = click.Choice(["red", "green", "blue"])
+    message = choice.get_invalid_choice_message("grean", ctx=None)
+    assert message == (
+        "'grean' is not one of 'red', 'green', 'blue'. Did you mean 'green'?"
+    )
+
+
+def test_invalid_choice_no_suggestion_when_far():
+    choice = click.Choice(["red", "green", "blue"])
+    message = choice.get_invalid_choice_message("purple", ctx=None)
+    assert "Did you mean" not in message
+
+
+def test_invalid_choice_single_choice_suggestion():
+    choice = click.Choice(["json"])
+    message = choice.get_invalid_choice_message("jsno", ctx=None)
+    assert message == "'jsno' is not 'json'. Did you mean 'json'?"
+
+
+def test_invalid_choice_suggestion_case_sensitive():
+    # Case differences are a real mismatch when case sensitive; the suggestion
+    # is the exact spelling to type.
+    choice = click.Choice(["Debug", "Info"])
+    message = choice.get_invalid_choice_message("debug", ctx=None)
+    assert message.endswith("Did you mean 'Debug'?")
+
+
+def test_invalid_choice_suggestion_case_insensitive():
+    choice = click.Choice(["Debug", "Info"], case_sensitive=False)
+    message = choice.get_invalid_choice_message("DEBUGG", ctx=None)
+    # Suggestions use the normalized spelling shown in the choices list.
+    assert message.endswith("Did you mean 'debug'?")
+
+
+def test_invalid_choice_suggestion_enum():
+    class Color(enum.Enum):
+        RED = 1
+        GREEN = 2
+
+    choice = click.Choice(Color)
+    message = choice.get_invalid_choice_message("GREN", ctx=None)
+    assert message.endswith("Did you mean 'GREEN'?")
+
+
+def test_invalid_choice_non_str_value():
+    choice = click.Choice(["1", "2"])
+    message = choice.get_invalid_choice_message(3, ctx=None)
+    assert "Did you mean" not in message
+
+
+def test_invalid_choice_empty_value():
+    choice = click.Choice(["a", "b"])
+    message = choice.get_invalid_choice_message("", ctx=None)
+    assert "Did you mean" not in message
+
+
+def test_invalid_choice_suggestion_via_cli():
+    @click.command()
+    @click.option("--color", type=click.Choice(["red", "green", "blue"]))
+    def cli(color):
+        pass
+
+    result = CliRunner().invoke(cli, ["--color", "grean"])
+    assert result.exit_code == 2
+    assert "Did you mean 'green'?" in result.output
