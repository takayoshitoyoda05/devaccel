diff --git a/tests/test_types/test_Choice.py b/tests/test_types/test_Choice.py
index c34f516..0ceb366 100644
--- a/tests/test_types/test_Choice.py
+++ b/tests/test_types/test_Choice.py
@@ -5,3 +5,47 @@ def test_choice_get_invalid_choice_message():
     choice = click.Choice(["a", "b", "c"])
     message = choice.get_invalid_choice_message("d", ctx=None)
     assert message == "'d' is not one of 'a', 'b', 'c'."
+
+
+def test_choice_invalid_message_suggests_close_match():
+    choice = click.Choice(["apple", "banana", "cherry"])
+    message = choice.get_invalid_choice_message("appel", ctx=None)
+    assert message == (
+        "'appel' is not one of 'apple', 'banana', 'cherry'. Did you mean 'apple'?"
+    )
+
+
+def test_choice_invalid_message_suggests_multiple():
+    choice = click.Choice(["build", "built", "zzz"])
+    message = choice.get_invalid_choice_message("buil", ctx=None)
+    assert message.endswith("(Did you mean one of: 'build', 'built'?)")
+
+
+def test_choice_invalid_message_no_suggestion_when_far():
+    choice = click.Choice(["a", "b", "c"])
+    assert "Did you mean" not in choice.get_invalid_choice_message("xyz", ctx=None)
+
+
+def test_choice_invalid_message_suggests_case_insensitive():
+    choice = click.Choice(["Apple", "Banana"], case_sensitive=False)
+    message = choice.get_invalid_choice_message("APPEL", ctx=None)
+    assert message.endswith("Did you mean 'apple'?")
+
+
+def test_choice_invalid_message_single_choice_suggestion():
+    choice = click.Choice(["json"])
+    message = choice.get_invalid_choice_message("jsno", ctx=None)
+    assert message == "'jsno' is not 'json'. Did you mean 'json'?"
+
+
+def test_choice_option_error_includes_suggestion():
+    from click.testing import CliRunner
+
+    @click.command()
+    @click.option("--fmt", type=click.Choice(["json", "yaml"]))
+    def cli(fmt):
+        pass
+
+    result = CliRunner().invoke(cli, ["--fmt", "jsn"])
+    assert result.exit_code == 2
+    assert "'jsn' is not one of 'json', 'yaml'. Did you mean 'json'?" in result.output
