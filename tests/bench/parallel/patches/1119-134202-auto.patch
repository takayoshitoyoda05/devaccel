+        [],
+        [RowError(1, "日付", "", "日付列が見つかりません")],
+    )
+
+
+def test_missing_amount_columns_returns_single_error() -> None:
+    assert parse_bank_csv("日付,摘要\n2026/1/5,カフェ\n") == (
+        [],
+        [RowError(1, "金額", "", "金額列が見つかりません")],
+    )
+
+
+def test_column_count_mismatch_is_one_error_without_value_checks() -> None:
+    text = "日付,金額\n2026/2/30,abc,extra\n"
+    expenses, errors = parse_bank_csv(text)
+    assert expenses == []
+    assert [(e.line, e.column) for e in errors] == [(2, "")]
+
+
+def test_good_rows_kept_when_other_rows_fail() -> None:
+    text = "日付,金額\n2026/1/5,100\n2026/1/6,abc\n2026/1/7,200\n"
+    expenses, errors = parse_bank_csv(text)
+    assert [e.amount for e in expenses] == [100, 200]
+    assert [(e.line, e.column) for e in errors] == [(3, "金額")]
+
+
+def test_tab_delimiter_bom_and_crlf() -> None:
+    text = "﻿日付\t摘要\t金額\r\n2026/1/5\tカフェ\t1,000\r\n"
+    expenses, errors = parse_bank_csv(text)
+    assert errors == []
+    assert expenses == [Expense(date(2026, 1, 5), "未分類", 1000, "カフェ")]
+
+
+def test_quoted_comma_and_newline_preserved() -> None:
+    text = '日付,摘要,金額\r2026/1/5,"a,b\nc",100\r'
+    expenses, _ = parse_bank_csv(text)
