@@ -0,0 +1,108 @@
+"""Month-over-month category comparison report (pure functions)."""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class CategoryDiff:
+    category: str
+    previous: int
+    current: int
+    delta: int  # current - previous
+    pct: float | None  # delta / previous * 100。previous == 0 なら None
+    status: str  # "increase" | "decrease" | "same" | "new" | "gone"
+
+
+def _check_int(name: str, value: object) -> int:
+    # D3 requires ValueError (not TypeError) for type mismatches.
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise ValueError(f"{name} は整数である必要があります: {value!r}")  # noqa: TRY004
+    return value
+
+
+def _month_totals(expenses: Sequence[Expense], year: int, month: int) -> dict[str, int]:
+    """Sum of positive amounts per category for the given (year, month)."""
+    out: dict[str, int] = {}
+    for e in expenses:
+        if e.amount <= 0:  # D1: negative amounts (refunds) are excluded
+            continue
+        if e.day.year == year and e.day.month == month:
+            out[e.category] = out.get(e.category, 0) + e.amount
+    return out
+
+
+def _status(previous: int, current: int, delta: int) -> str:
+    if previous == 0 and current > 0:
+        return "new"
+    if previous > 0 and current == 0:
+        return "gone"
+    if delta > 0:
+        return "increase"
+    if delta < 0:
+        return "decrease"
+    return "same"
+
+
+def compare_months(
+    expenses: Sequence[Expense], year: int, month: int
+) -> list[CategoryDiff]:
+    """Compare (year, month) with the previous calendar month, per category."""
+    year = _check_int("year", year)
+    month = _check_int("month", month)
+    if not 1 <= month <= 12:
+        raise ValueError(f"month は 1〜12 である必要があります: {month}")
+
+    if month == 1:
+        prev_year, prev_month = year - 1, 12
+    else:
+        prev_year, prev_month = year, month - 1
+
+    current_totals = _month_totals(expenses, year, month)
+    previous_totals = _month_totals(expenses, prev_year, prev_month)
+
+    diffs: list[CategoryDiff] = []
+    for cat in set(current_totals) | set(previous_totals):  # D6: missing side is 0
+        previous = previous_totals.get(cat, 0)
+        current = current_totals.get(cat, 0)
+        if previous == 0 and current == 0:
+            continue
+        delta = current - previous
+        pct = round(delta / previous * 100, 1) if previous else None
+        diffs.append(
+            CategoryDiff(
+                category=cat,
+                previous=previous,
+                current=current,
+                delta=delta,
+                pct=pct,
+                status=_status(previous, current, delta),
+            )
+        )
+
+    # R3: abs(delta) descending, ties broken by category ascending (D4)
+    diffs.sort(key=lambda d: (-abs(d.delta), d.category))
+    return diffs
+
+
+def _format_line(d: CategoryDiff) -> str:
+    head = f"{d.category}  {d.previous:,} → {d.current:,}"
+    if d.status == "new":
+        return f"{head}  (新規)"
+    if d.status == "gone":
+        return f"{head}  (なし)"
+    if d.status == "same":
+        return f"{head}  (変化なし)"
+    pct = d.pct if d.pct is not None else 0.0
+    return f"{head}  ({d.delta:+,}, {pct:+.1f}%)"
+
+
+def format_diff(diffs: Sequence[CategoryDiff]) -> str:
+    """One line per category. Returns '差分なし' when empty; no trailing newline."""
+    if not diffs:
+        return "差分なし"
+    return "\n".join(_format_line(d) for d in diffs)
