@@ -0,0 +1,152 @@
+"""Detect recurring expenses and predict their next due date (pure functions)."""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from collections import Counter
+from collections.abc import Sequence
+from dataclasses import dataclass
+from datetime import date
+from typing import NoReturn
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str  # 正規化後のメモ
+    amount: int  # 系列で最も新しい金額
+    day_of_month: int  # 系列の日の最頻値(同数なら小さい方)
+    count: int  # 数えた月の数
+    last_seen: date
+    next_expected: date
+
+
+_NUMBER_SUFFIX_RE = re.compile(r"\s*(?:#\s*)?\d+$")
+
+
+def _normalize_memo(memo: str) -> str:
+    # NFKC は № を "No" に変えてしまうため、先に "#" へ置き換える。
+    text = unicodedata.normalize("NFKC", memo.replace("№", "#")).lower()
+    text = " ".join(text.split())
+    return _NUMBER_SUFFIX_RE.sub("", text).strip()
+
+
+def _is_int(value: object) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + (d.month - 1)
+
+
+def next_due(last: date, day_of_month: int) -> date:
+    """last の翌月の day_of_month 日(存在しない日は月末に丸める)。"""
+    if not isinstance(last, date):
+        _invalid("last は date である必要があります")
+    if not _is_int(day_of_month) or not 1 <= day_of_month <= 31:
+        raise ValueError(
+            f"day_of_month は 1〜31 の整数である必要があります: {day_of_month!r}"
+        )
+    year, month = (
+        (last.year + 1, 1) if last.month == 12 else (last.year, last.month + 1)
+    )
+    last_day = calendar.monthrange(year, month)[1]
+    return date(year, month, min(day_of_month, last_day))
+
+
+def _invalid(message: str) -> NoReturn:
+    raise ValueError(message)
+
+
+def _check_expense(e: Expense) -> None:
+    # 型違いは仕様どおり ValueError(D3)。
+    if not isinstance(e, Expense):
+        _invalid(f"Expense ではありません: {e!r}")
+    if not isinstance(e.day, date):
+        _invalid(f"day は date である必要があります: {e.day!r}")
+    if not isinstance(e.category, str) or not isinstance(e.memo, str):
+        _invalid("category と memo は str である必要があります")
+    if not _is_int(e.amount):
+        _invalid(f"amount は整数である必要があります: {e.amount!r}")
+
+
+def _detect(
+    category: str,
+    memo: str,
+    items: list[Expense],
+    min_months: int,
+    tolerance: float,
+) -> Recurring | None:
+    # 直近の金額に合うものだけを系列とする。合わないものは捨てる(R2)。
+    anchor = max(items, key=lambda e: (e.day, e.amount)).amount
+    members = [e for e in items if abs(e.amount - anchor) <= tolerance * anchor + 1e-9]
+
+    # 月ごとに最も新しい明細を1つ使う(R3)。
+    rep: dict[int, Expense] = {}
+    for e in members:
+        k = _month_index(e.day)
+        cur = rep.get(k)
+        if cur is None or (e.day, e.amount) > (cur.day, cur.amount):
+            rep[k] = e
+
+    # 欠けた月が1つまでなら連続とみなし、2か月以上空いたら切る(R3)。
+    runs: list[list[int]] = []
+    for k in sorted(rep):
+        if runs and k - runs[-1][-1] <= 2:
+            runs[-1].append(k)
+        else:
+            runs.append([k])
+    run = runs[-1]
+    if len(run) < min_months:
+        return None
+
+    chosen = [rep[k] for k in run]
+    last_seen = max(e.day for e in chosen)
+    counts = Counter(e.day.day for e in chosen)
+    top = max(counts.values())
+    day_of_month = min(d for d, c in counts.items() if c == top)
+    return Recurring(
+        category=category,
+        memo=memo,
+        amount=anchor,
+        day_of_month=day_of_month,
+        count=len(chosen),
+        last_seen=last_seen,
+        next_expected=next_due(last_seen, day_of_month),
+    )
+
+
+def find_recurring(
+    expenses: Sequence[Expense], min_months: int = 3, amount_tolerance: float = 0.1
+) -> list[Recurring]:
+    if not _is_int(min_months) or min_months < 2:
+        raise ValueError(
+            f"min_months は 2 以上の整数である必要があります: {min_months!r}"
+        )
+    if (
+        isinstance(amount_tolerance, bool)
+        or not isinstance(amount_tolerance, (int, float))
+        or amount_tolerance < 0
+    ):
+        raise ValueError(
+            f"amount_tolerance は 0 以上の数である必要があります: {amount_tolerance!r}"
+        )
+
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in expenses:
+        _check_expense(e)
+        if e.amount <= 0:  # 負の金額は返金として除く(D1)
+            continue
+        groups.setdefault((e.category, _normalize_memo(e.memo)), []).append(e)
+
+    found: list[Recurring] = []
+    for (category, memo), items in groups.items():
+        r = _detect(category, memo, items, min_months, float(amount_tolerance))
+        if r is not None:
+            found.append(r)
+    found.sort(key=lambda r: (r.next_expected, -r.amount, r.category, r.memo))
+    return found
