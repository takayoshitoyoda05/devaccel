@@ -0,0 +1,194 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import find_recurring, next_due
+
+
+def E(
+    day: str, amount: int = 80000, memo: str = "家賃", category: str = "住居"
+) -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+def _e1_1_rows() -> list[Expense]:
+    return [E("2026-01-31"), E("2026-02-28"), E("2026-03-31")]
+
+
+def _e1_2_rows() -> list[Expense]:
+    rows = []
+    for m in (1, 2, 3):
+        rows.append(E(f"2026-{m:02d}-05", amount=3000, memo="電気", category="光熱費"))
+        rows.append(E(f"2026-{m:02d}-20", amount=3000, memo="ガス", category="光熱費"))
+    return rows
+
+
+def _e1_3_rows() -> list[Expense]:
+    return [E("2026-01-05"), E("2026-02-05"), E("2026-05-05")]
+
+
+@pytest.mark.parametrize(
+    ("rows", "check"),
+    [
+        pytest.param(
+            _e1_1_rows(),
+            lambda r: (
+                len(r) == 1
+                and r[0].day_of_month == 31
+                and r[0].next_expected == date(2026, 4, 30)
+            ),
+            id="E1-1",
+        ),
+        pytest.param(
+            _e1_2_rows(),
+            lambda r: len(r) == 2 and {x.day_of_month for x in r} == {5, 20},
+            id="E1-2",
+        ),
+        pytest.param(_e1_3_rows(), lambda r: r == [], id="E1-3"),
+    ],
+)
+def test_example_table(rows: list[Expense], check) -> None:
+    assert check(find_recurring(rows))
+
+
+def test_R1_memo_normalization_merges_variants() -> None:
+    rows = [
+        E("2026-01-10", amount=1000, memo="Netflix 2"),
+        E("2026-02-10", amount=1000, memo="ＮＥＴＦＬＩＸ"),
+        E("2026-03-10", amount=1000, memo=" netflix  #3"),
+        E("2026-04-10", amount=1000, memo="Netflix №4"),
+    ]
+    r = find_recurring(rows)
+    assert len(r) == 1
+    assert r[0].memo == "netflix"
+    assert r[0].count == 4
+
+
+def test_R1_empty_memos_form_one_series_per_category() -> None:
+    rows = [E(f"2026-0{m}-01", amount=500, memo="") for m in (1, 2, 3)]
+    r = find_recurring(rows)
+    assert len(r) == 1 and r[0].memo == ""
+
+
+def test_R2_tolerance_is_inclusive_and_outliers_are_dropped() -> None:
+    rows = [
+        E("2026-01-10", amount=1000),
+        E("2026-02-10", amount=1100),  # 上限ちょうど: 含む
+        E("2026-03-10", amount=899),  # 下限を外れる: 捨てる
+        E("2026-04-10", amount=1000),
+    ]
+    r = find_recurring(rows)
+    assert len(r) == 1
+    assert r[0].amount == 1000
+    assert r[0].count == 3  # Jan, Feb, Apr(Mar は捨てた明細のため1か月欠け)
+
+
+def test_R2_price_increase_uses_latest_amount() -> None:
+    rows = [
+        E("2026-01-10", amount=1000),
+        E("2026-02-10", amount=1000),
+        E("2026-03-10", amount=2000),
+        E("2026-04-10", amount=2000),
+        E("2026-05-10", amount=2000),
+    ]
+    r = find_recurring(rows)
+    assert len(r) == 1
+    assert r[0].amount == 2000
+    assert r[0].count == 3
+
+
+def test_R3_same_month_uses_latest_day() -> None:
+    rows = [E("2026-01-05"), E("2026-01-20"), E("2026-02-05"), E("2026-03-05")]
+    r = find_recurring(rows)
+    assert len(r) == 1
+    assert r[0].count == 3
+    assert r[0].day_of_month == 5
+    assert r[0].last_seen == date(2026, 3, 5)
+
+
+def test_R3_one_missing_month_is_continuous() -> None:
+    rows = [E("2026-01-10"), E("2026-02-10"), E("2026-04-10")]
+    r = find_recurring(rows)
+    assert len(r) == 1 and r[0].count == 3
+
+
+def test_R3_gap_of_two_months_keeps_only_last_run() -> None:
+    rows = [
+        E("2026-01-10"),
+        E("2026-02-10"),
+        E("2026-03-10"),
+        E("2026-06-10"),
+        E("2026-07-10"),
+    ]
+    assert find_recurring(rows) == []  # 最後の連続部分は 6,7 月の2か月
+
+
+def test_R3_gap_of_two_months_then_long_last_run() -> None:
+    rows = [
+        E("2026-01-10"),
+        E("2026-06-10"),
+        E("2026-07-10"),
+        E("2026-08-10"),
+    ]
+    r = find_recurring(rows)
+    assert len(r) == 1
+    assert r[0].count == 3
+    assert r[0].last_seen == date(2026, 8, 10)
+
+
+def test_R3_min_months_below_two_is_error() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_months=1)
+
+
+def test_R4_next_due_rolls_over_december() -> None:
+    assert next_due(date(2026, 12, 15), 10) == date(2027, 1, 10)
+
+
+def test_R4_next_due_clamps_to_month_end() -> None:
+    assert next_due(date(2026, 1, 31), 31) == date(2026, 2, 28)
+    assert next_due(date(2028, 1, 31), 31) == date(2028, 2, 29)
+
+
+def test_R5_sorted_by_next_expected_then_amount_desc() -> None:
+    rows = []
+    for m in (1, 2, 3):
+        rows.append(E(f"2026-{m:02d}-10", amount=1000, memo="a", category="x"))
+        rows.append(E(f"2026-{m:02d}-10", amount=5000, memo="b", category="y"))
+    rows.append(E("2026-03-20", amount=700, memo="c", category="z"))
+    rows.append(E("2026-02-20", amount=700, memo="c", category="z"))
+    rows.append(E("2026-01-20", amount=700, memo="c", category="z"))
+    r = find_recurring(rows)
+    assert [x.memo for x in r] == ["b", "a", "c"]
+
+
+def test_D1_negative_amounts_are_ignored() -> None:
+    rows = [
+        E("2026-01-10"),
+        E("2026-02-10", amount=-80000),
+        E("2026-02-11"),
+        E("2026-03-10"),
+    ]
+    r = find_recurring(rows)
+    assert len(r) == 1 and r[0].count == 3
+
+
+def test_D3_invalid_input_raises() -> None:
+    with pytest.raises(ValueError):
+        next_due(date(2026, 1, 1), 0)
+    with pytest.raises(ValueError):
+        find_recurring([E("2026-01-10", amount=True)])  # type: ignore[arg-type]
+
+
+def test_D3_empty_input_returns_empty() -> None:
+    assert find_recurring([]) == []
+
+
+def test_D4_input_is_not_mutated() -> None:
+    rows = [E("2026-03-10"), E("2026-01-10"), E("2026-02-10")]
+    snapshot = list(rows)
+    find_recurring(rows)
+    assert rows == snapshot
diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..6772a90
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,234 @@
+"""Tests for kakeibo.search: predicates and search()."""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    all_of,
+    amount_between,
+    any_of,
+    between_dates,
+    category_is,
+    memo_contains,
+    not_,
+    search,
+)
+
+
+def ex(
+    amount: int = 100,
+    category: str = "食費",
+    memo: str = "",
+    day: date = date(2026, 1, 15),
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- 例の表 (E3-*) -------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("case_id", "pred", "expense", "expected"),
+    [
+        # E3-1: 端を含む (R1)
+        ("E3-1", amount_between(100, 100), ex(amount=100), True),
+        # E3-2: 全角英字の NFKC 正規化 + 大文字小文字の無視 (R2)
+        ("E3-2", memo_contains("ＳＵＢ"), ex(memo="sub"), True),
+        # E3-3: 引数なしの any_of は常に偽 (R4)
+        ("E3-3", any_of(), ex(), False),
+    ],
+    ids=["E3-1", "E3-2", "E3-3"],
+)
+def test_spec_examples(case_id, pred, expense, expected):
+    assert pred(expense) is expected
+
+
+# --- R1: amount_between / between_dates ---------------------------------
+
+
+@pytest.mark.parametrize(
+    ("low", "high", "amount", "expected"),
+    [
+        (100, 200, 100, True),
+        (100, 200, 200, True),
+        (100, 200, 99, False),
+        (100, 200, 201, False),
+        (None, 200, -10_000, True),
+        (100, None, 10_000, True),
+        (100, None, 99, False),
+        (None, None, -5, True),
+    ],
+)
+def test_amount_between_bounds_inclusive_and_unbounded(low, high, amount, expected):
+    assert amount_between(low, high)(ex(amount=amount)) is expected
+
+
+def test_amount_between_reversed_range_raises():
+    with pytest.raises(ValueError):
+        amount_between(200, 100)
+
+
+@pytest.mark.parametrize(
+    ("start", "end", "day", "expected"),
+    [
+        (date(2026, 1, 1), date(2026, 1, 31), date(2026, 1, 1), True),
+        (date(2026, 1, 1), date(2026, 1, 31), date(2026, 1, 31), True),
+        (date(2026, 1, 1), date(2026, 1, 31), date(2025, 12, 31), False),
+        (date(2026, 1, 1), date(2026, 1, 31), date(2026, 2, 1), False),
+        (None, date(2026, 1, 31), date(1900, 1, 1), True),
+        (date(2026, 1, 1), None, date(2999, 1, 1), True),
+        (date(2026, 1, 1), None, date(2025, 12, 31), False),
+    ],
+)
+def test_between_dates_bounds_inclusive_and_unbounded(start, end, day, expected):
+    assert between_dates(start, end)(ex(day=day)) is expected
+
+
+def test_between_dates_reversed_range_raises():
+    with pytest.raises(ValueError):
+        between_dates(date(2026, 2, 1), date(2026, 1, 1))
+
+
+# --- R2: memo_contains ----------------------------------------------------
+
+
+def test_memo_contains_is_partial_match():
+    assert memo_contains("ub")(ex(memo="sub"))
+    assert not memo_contains("xyz")(ex(memo="sub"))
+
+
+def test_memo_contains_case_insensitive_by_default():
+    assert memo_contains("SUB")(ex(memo="sub"))
+    assert memo_contains("sub")(ex(memo="SUB"))
+
+
+def test_memo_contains_case_sensitive_option():
+    assert not memo_contains("SUB", case_sensitive=True)(ex(memo="sub"))
+    assert memo_contains("sub", case_sensitive=True)(ex(memo="sub"))
+
+
+def test_memo_contains_empty_text_always_true():
+    assert memo_contains("")(ex(memo=""))
+    assert memo_contains("", case_sensitive=True)(ex(memo="anything"))
+
+
+def test_memo_contains_non_str_raises():
+    with pytest.raises(ValueError):
+        memo_contains(1)  # type: ignore[arg-type]
+
+
+# --- R3: category_is ------------------------------------------------------
+
+
+def test_category_is_exact_match():
+    assert category_is("食費")(ex(category="食費"))
+    assert not category_is("食")(ex(category="食費"))
+
+
+def test_category_is_ignores_surrounding_whitespace_and_nfkc():
+    assert category_is("  食費 ")(ex(category="食費"))
+    assert category_is("ＡＢＣ")(ex(category="abc")) is False  # case is kept
+    assert category_is("ＡＢＣ")(ex(category="ABC"))
+
+
+def test_category_is_multiple_names_is_or():
+    pred = category_is("食費", "日用品")
+    assert pred(ex(category="日用品"))
+    assert pred(ex(category="食費"))
+    assert not pred(ex(category="交通費"))
+
+
+def test_category_is_no_names_raises():
+    with pytest.raises(ValueError):
+        category_is()
+
+
+def test_category_is_non_str_raises():
+    with pytest.raises(ValueError):
+        category_is("食費", 3)  # type: ignore[arg-type]
+
+
+# --- R4: combinators ------------------------------------------------------
+
+
+def test_all_of_empty_is_true():
+    assert all_of()(ex())
+
+
+def test_any_of_empty_is_false():
+    assert not any_of()(ex())
+
+
+def test_all_of_and_any_of_combine():
+    big = amount_between(1000, None)
+    food = category_is("食費")
+    assert all_of(big, food)(ex(amount=1000, category="食費"))
+    assert not all_of(big, food)(ex(amount=999, category="食費"))
+    assert any_of(big, food)(ex(amount=1, category="食費"))
+    assert not any_of(big, food)(ex(amount=1, category="交通費"))
+
+
+def test_not_inverts():
+    assert not_(category_is("食費"))(ex(category="交通費"))
+    assert not not_(category_is("食費"))(ex(category="食費"))
+
+
+def test_nested_combinators():
+    pred = all_of(
+        not_(memo_contains("返金")),
+        any_of(category_is("食費"), amount_between(5000, None)),
+    )
+    assert pred(ex(category="食費", memo="昼食"))
+    assert not pred(ex(category="食費", memo="返金"))
+    assert pred(ex(category="交通費", amount=5000))
+    assert not pred(ex(category="交通費", amount=4999))
+
+
+# --- R5: search -----------------------------------------------------------
+
+
+def test_search_none_predicate_returns_all_in_order():
+    rows = [ex(amount=3), ex(amount=1), ex(amount=2)]
+    assert search(rows) == rows
+    assert search(rows) is not rows
+
+
+def test_search_keeps_input_order():
+    rows = [ex(amount=300), ex(amount=100), ex(amount=200)]
+    assert [e.amount for e in search(rows, amount_between(100, 300))] == [300, 100, 200]
+
+
+def test_search_does_not_mutate_input():
+    rows = [ex(amount=1), ex(amount=2)]
+    snapshot = list(rows)
+    search(rows, amount_between(2, None))
+    assert rows == snapshot
+
+
+def test_search_empty_input_returns_empty_list():
+    assert search([]) == []
+    assert search([], category_is("食費")) == []
+
+
+# --- R6: type errors ------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "factory",
+    [
+        lambda: amount_between("1"),  # type: ignore[arg-type]
+        lambda: amount_between(1, 2.0),  # type: ignore[arg-type]
+        lambda: amount_between(True, None),  # type: ignore[arg-type]
+        lambda: between_dates("2026-01-01"),  # type: ignore[arg-type]
+        lambda: all_of("not a predicate"),  # type: ignore[arg-type]
+        lambda: any_of(1),  # type: ignore[arg-type]
+        lambda: not_(None),  # type: ignore[arg-type]
+    ],
+)
+def test_wrong_types_raise_value_error(factory):
+    with pytest.raises(ValueError):
+        factory()
