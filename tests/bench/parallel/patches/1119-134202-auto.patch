--- /dev/null
+++ b/src/kakeibo/bank_import.py
@@ -0,0 +1,217 @@
+"""Parse bank / card statement CSV text into Expense records (pure functions)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int  # そのレコードの開始行(1始まり、ヘッダーが1行目)
+    column: str  # 列名(列の不足・過剰は "")
+    value: str  # 元の値
+    reason: str
+
+
+# 別名はすべて小文字(照合時にヘッダーを strip + lower する)。
+_DATE_ALIASES = ("日付", "利用日", "取引日", "ご利用日", "date")
+_AMOUNT_ALIASES = ("金額", "利用金額", "ご利用金額", "出金額", "支払金額", "amount")
+_DEPOSIT_ALIASES = ("入金", "入金額", "預入金額", "預入")  # 「入金」は表 E2-3 の列名
+_WITHDRAW_ALIASES = ("出金", "支払")
+_MEMO_ALIASES = (
+    "摘要",
+    "メモ",
+    "利用店名",
+    "ご利用店名",
+    "内容",
+    "description",
+    "memo",
+)
+_CATEGORY_ALIASES = ("カテゴリ", "category")
+
+_TIME_SUFFIX = r"(?:\s+[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?)?"
+_DATE_PATTERNS = (
+    re.compile(
+        r"(?P<y>[0-9]{4})(?P<sep>[-/.])(?P<m>[0-9]{1,2})(?P=sep)(?P<d>[0-9]{1,2})"
+        + _TIME_SUFFIX
+    ),
+    re.compile(
+        r"(?P<y>[0-9]{4})年(?P<m>[0-9]{1,2})月(?P<d>[0-9]{1,2})日" + _TIME_SUFFIX
+    ),
+    re.compile(r"(?P<y>[0-9]{4})(?P<m>[0-9]{2})(?P<d>[0-9]{2})" + _TIME_SUFFIX),
+)
+
+# 符号付きの形式。fullmatch で判定する(符号は 1 つだけ)。
+_AMOUNT_FORMS = (
+    (re.compile(r"[-−△▲]([0-9]+)"), -1),  # -500 / △500 / ▲500
+    (re.compile(r"\(([0-9]+)\)"), -1),  # (500)
+    (re.compile(r"([0-9]+)-"), -1),  # 500-
+    (re.compile(r"([0-9]+)"), 1),  # 500
+)
+_IGNORED_IN_AMOUNT = re.compile(r"[\s,¥円]|JPY", re.IGNORECASE)
+_NO_AMOUNT = frozenset({"", "-", "—"})
+
+
+def _parse_date(raw: str) -> date:
+    s = unicodedata.normalize("NFKC", raw).strip()
+    if not s:
+        raise ValueError("日付が空です")
+    for pat in _DATE_PATTERNS:
+        m = pat.fullmatch(s)
+        if m:
+            try:
+                return date(int(m["y"]), int(m["m"]), int(m["d"]))
+            except ValueError:
+                raise ValueError("存在しない日付です") from None
+    raise ValueError("日付の形式が不正です")
+
+
+def _parse_amount(raw: str) -> int | None:
+    """金額。金額なし(空欄・-・—)は None。形式が不正なら ValueError。"""
+    s = _IGNORED_IN_AMOUNT.sub("", unicodedata.normalize("NFKC", raw))
+    if s in _NO_AMOUNT:
+        return None
+    for pat, sign in _AMOUNT_FORMS:
+        m = pat.fullmatch(s)
+        if m:
+            return sign * int(m.group(1))
+    raise ValueError("金額の形式が不正です")
+
+
+def _row_amount(
+    row: list[str],
+    header: list[str],
+    line: int,
+    amount_i: int | None,
+    withdraw_i: int | None,
+    deposit_i: int | None,
+) -> tuple[int | None, list[RowError]]:
+    """行の金額。None は「スキップ」(金額なし・0円・入金のみ)を表す。"""
+    if amount_i is not None:
+        raw = row[amount_i]
+        try:
+            return _parse_amount(raw), []
+        except ValueError as e:
+            return None, [RowError(line, header[amount_i], raw, str(e))]
+
+    # 出金/入金の2列形式: 出金を正、入金を負にする。
+    errors: list[RowError] = []
+    values: dict[str, int | None] = {"out": None, "in": None}
+    for key, idx in (("out", withdraw_i), ("in", deposit_i)):
+        if idx is None:
+            continue
+        raw = row[idx]
+        try:
+            values[key] = _parse_amount(raw)
+        except ValueError as e:
+            errors.append(RowError(line, header[idx], raw, str(e)))
+    if errors:
+        return None, errors
+    out, deposit = values["out"], values["in"]
+    if out is None:  # 出金が空(入金のみの行を含む)はスキップ
+        return None, []
+    if deposit is None:
+        return out, []
+    return out - deposit, []
+
+
+def parse_bank_csv(
+    text: str, default_category: str = "未分類"
+) -> tuple[list[Expense], list[RowError]]:
+    text = text.removeprefix("﻿")
+
+    first = next((ln for ln in text.splitlines() if ln.strip()), "")
+    delim = "\t" if first.count("\t") > first.count(",") else ","
+
+    # 物理行の開始行を保ったままレコードを集める。
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delim)
+    records: list[tuple[int, list[str]]] = []
+    errors: list[RowError] = []
+    while True:
+        start = reader.line_num + 1
+        try:
+            row = next(reader)
+        except StopIteration:
+            break
+        except csv.Error as e:
+            errors.append(RowError(start, "", "", f"CSV として読めません: {e}"))
+            break
+        if not any(cell.strip() for cell in row):  # 空行はスキップ
+            continue
+        records.append((start, row))
+
+    if not records:
+        return [], errors
+
+    _, raw_header = records[0]
+    header = [cell.strip() for cell in raw_header]
+
+    def find(aliases: tuple[str, ...]) -> int | None:
+        for i, name in enumerate(header):
+            if name.lower() in aliases:
+                return i
+        return None
+
+    date_i = find(_DATE_ALIASES)
+    amount_i = find(_AMOUNT_ALIASES)
+    withdraw_i = find(_WITHDRAW_ALIASES)
+    deposit_i = find(_DEPOSIT_ALIASES)
+    memo_i = find(_MEMO_ALIASES)
+    category_i = find(_CATEGORY_ALIASES)
+
+    if date_i is None:
+        return [], [RowError(1, "日付", "", "日付列が見つかりません")]
+    if amount_i is None and withdraw_i is None and deposit_i is None:
+        return [], [RowError(1, "金額", "", "金額列が見つかりません")]
+    if amount_i is None and withdraw_i is None:
+        return [], [RowError(1, "出金", "", "出金列が見つかりません")]
+    if amount_i is None and deposit_i is None:
+        return [], [RowError(1, "入金", "", "入金列が見つかりません")]
+
+    expenses: list[Expense] = []
+    for line, row in records[1:]:
+        if len(row) != len(header):
+            errors.append(
+                RowError(
+                    line,
+                    "",
+                    delim.join(row),
+                    f"列数が合いません(期待 {len(header)}、実際 {len(row)})",
+                )
+            )
+            continue
+
+        row_errors: list[RowError] = []
+        day: date | None = None
+        try:
+            day = _parse_date(row[date_i])
+        except ValueError as e:
+            row_errors.append(RowError(line, header[date_i], row[date_i], str(e)))
+        amount, amount_errors = _row_amount(
+            row, header, line, amount_i, withdraw_i, deposit_i
+        )
+        row_errors.extend(amount_errors)
+
+        errors.extend(row_errors)
+        if row_errors or day is None or amount is None or amount == 0:
+            continue
+        category = row[category_i].strip() if category_i is not None else ""
+        memo = row[memo_i].strip() if memo_i is not None else ""
+        expenses.append(
+            Expense(
+                day=day,
+                category=category or default_category,
+                amount=amount,
+                memo=memo,
+            )
+        )
+
+    errors.sort(key=lambda e: e.line)  # 安定ソート: 同じ行は 日付→金額 の順を保つ
+    return expenses, errors
