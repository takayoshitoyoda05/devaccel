+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import RowError, parse_bank_csv
+from kakeibo.core import Expense
+
+
+# 表 E2 の全行(ID はテスト ID に保持する)
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param(
+            '利用日,ご利用店名,ご利用金額\n2026/1/5,カフェ,"1,234円"\n',
+            ([Expense(date(2026, 1, 5), "未分類", 1234, "カフェ")], []),
+            id="E2-1",
+        ),
+        pytest.param(
+            "利用日,ご利用店名,ご利用金額\n2026/2/30,カフェ,abc\n",
+            (
+                [],
+                [
+                    RowError(2, "利用日", "2026/2/30", "存在しない日付です"),
+                    RowError(2, "ご利用金額", "abc", "金額の形式が不正です"),
+                ],
+            ),
+            id="E2-2",
+        ),
+        pytest.param(
+            '日付,出金,入金\n2026/1/5,,"5,000"\n',
+            ([], []),
+            id="E2-3",
+        ),
+    ],
+)
+def test_table_e2(text: str, expected: tuple[list[Expense], list[RowError]]) -> None:
+    assert parse_bank_csv(text) == expected
+
+
+# R3 日付の書式
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026.1.5",
+        "2026年1月5日",
+        "20260105",
+        "２０２６／１／５",
+        "2026-01-05 12:34",
+    ],
+)
+def test_date_formats_accepted(raw: str) -> None:
+    expenses, errors = parse_bank_csv(f"日付,金額\n{raw},100\n")
+    assert errors == []
+    assert expenses == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+
+
+@pytest.mark.parametrize("raw", ["令和8年1月5日", "2026-13-01", "2026-1-5-1"])
+def test_invalid_dates_reported(raw: str) -> None:
+    expenses, errors = parse_bank_csv(f"日付,金額\n{raw},100\n")
+    assert expenses == []
+    assert [(e.line, e.column, e.value) for e in errors] == [(2, "日付", raw)]
+
+
+# R4 金額の書式
+@pytest.mark.parametrize(
+    ("raw", "amount"),
+    [
+        ("1,234", 1234),
+        ("¥1,234", 1234),
+        ("1,234 JPY", 1234),
+        ("−500", -500),
+        ("-500", -500),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("３，０００", 3000),
+    ],
+)
+def test_amount_formats(raw: str, amount: int) -> None:
+    expenses, errors = parse_bank_csv(f'日付,金額\n2026/1/5,"{raw}"\n')
+    assert errors == []
+    assert [e.amount for e in expenses] == [amount]
+
+
+@pytest.mark.parametrize("raw", ["12.5", "abc"])
+def test_invalid_amounts_reported(raw: str) -> None:
+    _, errors = parse_bank_csv(f"日付,金額\n2026/1/5,{raw}\n")
+    assert [(e.line, e.column, e.value) for e in errors] == [(2, "金額", raw)]
+
+
+# R5 / R6 / R7 / D5 / D7 の端のケース
+def test_zero_and_blank_amounts_are_skipped() -> None:
