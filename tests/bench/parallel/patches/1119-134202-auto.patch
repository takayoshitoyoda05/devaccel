diff --git a/tests/test_monthly_diff.py b/tests/test_monthly_diff.py
new file mode 100644
index 0000000..cc03d71
--- /dev/null
+++ b/tests/test_monthly_diff.py
@@ -0,0 +1,173 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthly_diff import CategoryDiff, compare_months, format_diff
+
+
+def exp(day: str, category: str, amount: int) -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=""
+    )
+
+
+def by_cat(diffs: list[CategoryDiff]) -> dict[str, CategoryDiff]:
+    return {d.category: d for d in diffs}
+
+
+# E4-1 / E4-2: comparison rules (R2, R4)
+@pytest.mark.parametrize(
+    ("expenses", "category", "expected"),
+    [
+        pytest.param(
+            [exp("2026-03-05", "食費", 1000), exp("2026-04-02", "食費", 1500)],
+            "食費",
+            {
+                "previous": 1000,
+                "current": 1500,
+                "delta": 500,
+                "pct": 50.0,
+                "status": "increase",
+            },
+            id="E4-1",
+        ),
+        pytest.param(
+            [exp("2026-03-10", "交通", 800)],
+            "交通",
+            {
+                "previous": 800,
+                "current": 0,
+                "delta": -800,
+                "pct": -100.0,
+                "status": "gone",
+            },
+            id="E4-2",
+        ),
+    ],
+)
+def test_compare_example_rows(expenses, category, expected):
+    diffs = by_cat(compare_months(expenses, 2026, 4))
+    d = diffs[category]
+    assert d.previous == expected["previous"]
+    assert d.current == expected["current"]
+    assert d.delta == expected["delta"]
+    assert d.pct == expected["pct"]
+    assert d.status == expected["status"]
+
+
+# E4-3: format (R5)
+@pytest.mark.parametrize(
+    ("diffs", "expected"),
+    [
+        pytest.param(
+            [CategoryDiff("食費", 1000, 1500, 500, 50.0, "increase")],
+            "食費  1,000 → 1,500  (+500, +50.0%)",
+            id="E4-3",
+        ),
+    ],
+)
+def test_format_example_rows(diffs, expected):
+    assert format_diff(diffs) == expected
+
+
+# R1: previous month wraps to December of the previous year
+def test_january_compares_with_previous_december():
+    expenses = [exp("2025-12-20", "食費", 2000), exp("2026-01-03", "食費", 1000)]
+    d = by_cat(compare_months(expenses, 2026, 1))["食費"]
+    assert (d.previous, d.current, d.status) == (2000, 1000, "decrease")
+
+
+# R1: month out of range is ValueError
+@pytest.mark.parametrize("month", [0, 13, -1])
+def test_invalid_month_raises(month):
+    with pytest.raises(ValueError):
+        compare_months([], 2026, month)
+
+
+# R1/D3: type mismatch is ValueError
+def test_non_int_month_raises():
+    with pytest.raises(ValueError):
+        compare_months([], 2026, "4")  # type: ignore[arg-type]
+
+
+# R6: empty input gives empty result, no exception
+def test_empty_expenses_gives_empty_result():
+    assert compare_months([], 2026, 4) == []
+
+
+# D1 / R2: negative amounts (refunds) are excluded from the comparison
+def test_negative_amounts_are_excluded():
+    expenses = [exp("2026-03-05", "食費", 1000), exp("2026-04-02", "食費", -500)]
+    assert compare_months(expenses, 2026, 4) == [
+        CategoryDiff("食費", 1000, 0, -1000, -100.0, "gone")
+    ]
+
+
+# R2: a category only in the current month is "new" with pct None (D6)
+def test_new_category_has_no_pct():
+    d = by_cat(compare_months([exp("2026-04-02", "娯楽", 700)], 2026, 4))["娯楽"]
+    assert (d.previous, d.current, d.delta, d.pct, d.status) == (
+        0,
+        700,
+        700,
+        None,
+        "new",
+    )
+
+
+# R2: equal totals are "same"
+def test_same_status():
+    expenses = [exp("2026-03-05", "食費", 900), exp("2026-04-05", "食費", 900)]
+    d = by_cat(compare_months(expenses, 2026, 4))["食費"]
+    assert (d.delta, d.pct, d.status) == (0, 0.0, "same")
+
+
+# R3 / D4: sort by abs(delta) desc, ties by category asc
+def test_sort_order_and_tie_break():
+    expenses = [
+        exp("2026-03-01", "B", 1000),
+        exp("2026-04-01", "B", 1500),  # +500
+        exp("2026-03-01", "A", 2000),
+        exp("2026-04-01", "A", 1500),  # -500
+        exp("2026-04-01", "C", 2000),  # +2000
+    ]
+    assert [d.category for d in compare_months(expenses, 2026, 4)] == ["C", "A", "B"]
+
+
+# R4: pct rounded to one decimal place
+def test_pct_rounded_to_one_decimal():
+    expenses = [exp("2026-03-01", "食費", 3000), exp("2026-04-01", "食費", 3100)]
+    d = by_cat(compare_months(expenses, 2026, 4))["食費"]
+    assert d.pct == 3.3
+
+
+# R5: decrease, new, gone, same lines and sign formatting
+def test_format_statuses():
+    diffs = [
+        CategoryDiff("食費", 1500, 1000, -500, -33.3, "decrease"),
+        CategoryDiff("娯楽", 0, 700, 700, None, "new"),
+        CategoryDiff("交通", 800, 0, -800, -100.0, "gone"),
+        CategoryDiff("日用品", 300, 300, 0, 0.0, "same"),
+    ]
+    assert format_diff(diffs).split("\n") == [
+        "食費  1,500 → 1,000  (-500, -33.3%)",
+        "娯楽  0 → 700  (新規)",
+        "交通  800 → 0  (なし)",
+        "日用品  300 → 300  (変化なし)",
+    ]
+
+
+# R5: empty -> "差分なし", no trailing newline
+def test_format_empty_and_no_trailing_newline():
+    assert format_diff([]) == "差分なし"
+    out = format_diff([CategoryDiff("食費", 1000, 1500, 500, 50.0, "increase")])
+    assert not out.endswith("\n")
+
+
+# Input must not be mutated (D4)
+def test_input_not_mutated():
+    expenses = [exp("2026-03-05", "食費", 1000), exp("2026-04-02", "食費", 1500)]
+    snapshot = list(expenses)
+    compare_months(expenses, 2026, 4)
+    assert expenses == snapshot
