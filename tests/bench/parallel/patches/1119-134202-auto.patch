index 0000000..c07b44c
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,127 @@
+"""Filter expenses with composable pure predicates."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable, Iterable
+from datetime import date, datetime
+from typing import NoReturn
+
+from kakeibo.core import Expense
+
+Predicate = Callable[[Expense], bool]
+
+
+def _invalid(msg: str) -> NoReturn:
+    # 型違い・不正な引数はすべて ValueError (R6)。
+    raise ValueError(msg)
+
+
+def _nfkc(text: str) -> str:
+    return unicodedata.normalize("NFKC", text)
+
+
+def _check_int(value: object, name: str) -> None:
+    if value is not None and (isinstance(value, bool) or not isinstance(value, int)):
+        _invalid(f"{name} は int か None である必要があります: {value!r}")
+
+
+def _check_date(value: object, name: str) -> None:
+    if value is not None and (
+        not isinstance(value, date) or isinstance(value, datetime)
+    ):
+        _invalid(f"{name} は date か None である必要があります: {value!r}")
+
+
+def _check_preds(preds: tuple[object, ...]) -> None:
+    for p in preds:
+        if not callable(p):
+            _invalid(f"述語ではありません: {p!r}")
+
+
+def category_is(*names: str) -> Predicate:
+    if not names:
+        _invalid("カテゴリ名を 1 つ以上指定してください")
+    for n in names:
+        if not isinstance(n, str):
+            _invalid(f"カテゴリ名は str である必要があります: {n!r}")
+    wanted = frozenset(_nfkc(n).strip() for n in names)
+
+    def pred(e: Expense) -> bool:
+        return _nfkc(e.category).strip() in wanted
+
+    return pred
+
+
+def amount_between(low: int | None = None, high: int | None = None) -> Predicate:
+    _check_int(low, "low")
+    _check_int(high, "high")
+    if low is not None and high is not None and low > high:
+        raise ValueError(f"範囲が逆転しています: {low} > {high}")
+
+    def pred(e: Expense) -> bool:
+        return (low is None or e.amount >= low) and (high is None or e.amount <= high)
+
+    return pred
+
+
+def memo_contains(text: str, *, case_sensitive: bool = False) -> Predicate:
+    if not isinstance(text, str):
+        _invalid(f"text は str である必要があります: {text!r}")
+    needle = _nfkc(text)
+    if not case_sensitive:
+        needle = needle.casefold()
+
+    def pred(e: Expense) -> bool:
+        hay = _nfkc(e.memo)
+        if not case_sensitive:
+            hay = hay.casefold()
+        return needle in hay
+
+    return pred
+
+
+def between_dates(start: date | None = None, end: date | None = None) -> Predicate:
+    _check_date(start, "start")
+    _check_date(end, "end")
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"期間が逆転しています: {start} > {end}")
+
+    def pred(e: Expense) -> bool:
+        return (start is None or e.day >= start) and (end is None or e.day <= end)
+
+    return pred
+
+
+def all_of(*preds: Predicate) -> Predicate:
+    _check_preds(preds)
+
+    def pred(e: Expense) -> bool:
+        return all(p(e) for p in preds)
+
+    return pred
+
+
+def any_of(*preds: Predicate) -> Predicate:
+    _check_preds(preds)
+
+    def pred(e: Expense) -> bool:
+        return any(p(e) for p in preds)
+
+    return pred
+
+
+def not_(p: Predicate) -> Predicate:
+    _check_preds((p,))
+
+    def pred(e: Expense) -> bool:
+        return not p(e)
+
+    return pred
+
+
+def search(expenses: Iterable[Expense], pred: Predicate | None = None) -> list[Expense]:
+    """Return matching expenses in input order (a new list; input untouched)."""
+    if pred is None:
+        return list(expenses)
+    return [e for e in expenses if pred(e)]
