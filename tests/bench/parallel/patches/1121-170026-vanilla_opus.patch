+def _format_alert(a: BudgetAlert) -> str:
+    detail = f"予算 {a.limit:,} / 実績 {a.actual:,}"
+    if a.percent is not None:
+        detail += f" / {a.percent}%"
+    if a.level == "over":
+        return f"警告: {a.month} {a.category} {a.actual - a.limit:,}円超過 ({detail})"
+    return f"注意: {a.month} {a.category} 残り {a.limit - a.actual:,}円 ({detail})"
diff --git a/src/kakeibo/core.py b/src/kakeibo/core.py
index 8c3cbab..68ed7c1 100644
--- a/src/kakeibo/core.py
+++ b/src/kakeibo/core.py
@@ -133,3 +133,54 @@ def find_overruns(
             if cat in limits and actual > limits[cat]:
                 out.append((month, cat, actual - limits[cat], limits[cat], actual))
     return out
+
+
+CAUTION_RATIO = (9, 10)  # 予算の 90% 以上で「注意」
+
+
+def usage_percent(limit: int, actual: int) -> int | None:
+    """予算に対する実績の割合(%、切り捨て)。予算 0 なら None。
+
+    切り捨てにより、超過していない行が 100% と表示されることはない。
+    """
+    if limit == 0:
+        return None
+    return actual * 100 // limit
+
+
+@dataclass(frozen=True)
+class BudgetAlert:
+    level: str  # "over"(超過) または "caution"(90% 以上・超過なし)
+    month: str
+    category: str
+    limit: int
+    actual: int
+
+    @property
+    def percent(self) -> int | None:
+        return usage_percent(self.limit, self.actual)
+
+
+def find_budget_alerts(
+    totals: dict[str, dict[str, int]], budget: Budget
+) -> list[BudgetAlert]:
+    """超過(actual > limit)と注意(limit の 90% 以上で超過なし)を集計順に返す。
+
+    予算 0 のカテゴリは、実績が正のときだけ超過として扱う(注意は出さない)。
+    """
+    num, den = CAUTION_RATIO
+    out: list[BudgetAlert] = []
+    for month, cats in totals.items():
+        limits = budget.for_month(month)
+        for cat, actual in cats.items():
+            if cat not in limits:
+                continue
+            limit = limits[cat]
+            if actual > limit:
+                level = "over"
+            elif limit > 0 and actual * den >= limit * num:
+                level = "caution"
+            else:
+                continue
+            out.append(BudgetAlert(level, month, cat, limit, actual))
+    return out
