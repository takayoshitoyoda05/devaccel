diff --git a/src/kakeibo/bankimport.py b/src/kakeibo/bankimport.py
new file mode 100644
index 0000000..31e2a94
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,123 @@
+"""Import bank statement CSV text into Expense records."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+_AMOUNT_RE = re.compile(r"-?[¥￥]?([0-9][0-9,]*)円?")
+
+
+def parse_amount(s: str) -> int:
+    """Parse a yen amount such as "￥1,234", "-¥300" or "980円" into an int."""
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    value = int(m.group(1).replace(",", ""))
+    return -value if s.strip().startswith("-") else value
+
+
+def parse_date(s: str) -> date:
+    """Parse "YYYY/M/D" or "YYYY-M-D" (separator must be the same throughout)."""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    try:
+        return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Convert CSV text (header on line 1) into expenses.
+
+    Returns (valid expenses in input order, [(physical line number, field name)]).
+    Rows with any error are excluded from the expenses.
+    """
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header: list[str] | None = None
+    index: dict[str, int] = {}
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    while True:
+        line = reader.line_num + 1  # physical line where this record starts
+        try:
+            row = next(reader)
+        except StopIteration:
+            break
+        if header is None:
+            header = row
+            for field, column in mapping.items():
+                if column not in header:
+                    raise ValueError(f"列 {column!r} がヘッダーにありません")
+                index[field] = header.index(column)
+            continue
+        if _is_blank(row):
+            continue
+
+        row_errors: list[tuple[int, str]] = []
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(_cell(row, index, "date"))
+        except ValueError:
+            row_errors.append((line, "date"))
+        try:
+            amount = parse_amount(_cell(row, index, "amount"))
+        except ValueError:
+            row_errors.append((line, "amount"))
+        category = _cell(row, index, "category").strip()
+        if not category:
+            row_errors.append((line, "category"))
+
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        assert day is not None and amount is not None
+        if category_map and category in category_map:
+            category = category_map[category]
+        expenses.append(
+            Expense(
+                day=day,
+                category=category,
+                amount=amount,
+                memo=_cell(row, index, "memo").strip(),
+            )
+        )
+    if header is None:
+        raise ValueError("ヘッダー行がありません")
+    return expenses, errors
+
+
+def _cell(row: list[str], index: dict[str, int], field: str) -> str:
+    """Value of `field` in `row`; a missing column or short row gives ""."""
+    i = index.get(field)
+    if i is None or i >= len(row):
+        return ""
+    return row[i]
+
+
+def _is_blank(row: list[str]) -> bool:
+    return not row or (len(row) == 1 and not row[0].strip())
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
new file mode 100644
index 0000000..8f152f1
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,97 @@
+"""Month-over-month category diff report (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not isinstance(month, str) or not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def _month_of(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+
+    prev_sum: dict[str, int] = {}
+    curr_sum: dict[str, int] = {}
+    prev_n: dict[str, int] = {}
+    curr_n: dict[str, int] = {}
+    for e in rows:
+        m = _month_of(e)
+        if m == prev_month:
+            prev_sum[e.category] = prev_sum.get(e.category, 0) + e.amount
+            prev_n[e.category] = prev_n.get(e.category, 0) + 1
+        if m == curr_month:
+            curr_sum[e.category] = curr_sum.get(e.category, 0) + e.amount
+            curr_n[e.category] = curr_n.get(e.category, 0) + 1
+
+    out: list[DiffRow] = []
+    for cat in set(prev_n) | set(curr_n):
+        prev = prev_sum.get(cat, 0)
+        curr = curr_sum.get(cat, 0)
+        delta = curr - prev
+        pct = None if prev == 0 else round(delta / prev * 100, 1)
+        if cat not in prev_n:
+            status = "new"
+        elif cat not in curr_n:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+
+    out.sort(key=lambda r: (-abs(r.delta), r.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [r for r in diffs if r.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for r in diffs:
+        if r.pct is None:
+            pct = "-"
+        else:
+            value = 0.0 if r.pct == 0 else r.pct  # -0.0 を +0.0 として表示する
+            pct = f"{value:+.1f}%"
+        lines.append(f"{r.category}\t{r.prev}\t{r.curr}\t{r.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month_of(e) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には明細のある月が 2 つ以上必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..b67a822
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,170 @@
+"""Search query language: tokenize, parse, and evaluate against Expense rows."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+
+from kakeibo.core import Expense
+
+Token = tuple[str, str]
+Predicate = Callable[[Expense], bool]
+
+_SPACE = " \t\r\n\f\v"
+_PAREN_AND_QUOTE = '()"'
+
+
+class QueryError(ValueError):
+    """Raised when a search query is invalid."""
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    tokens: list[Token] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        ch = q[i]
+        if ch in _SPACE:
+            i += 1
+        elif ch == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif ch == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif ch == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError("閉じていない引用があります")
+            body = q[i + 1 : end]
+            if body == "":
+                raise QueryError("空の引用は使えません")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            start = i
+            while i < n and q[i] not in _SPACE and q[i] not in _PAREN_AND_QUOTE:
+                i += 1
+            word = q[start:i]
+            if word == "AND":
+                tokens.append(("AND", "AND"))
+            elif word == "OR":
+                tokens.append(("OR", "OR"))
+            elif word == "NOT":
+                tokens.append(("NOT", "NOT"))
+            elif word.startswith("cat:"):
+                value = word[len("cat:") :]
+                if value == "":
+                    raise QueryError("cat: の後ろにカテゴリ名がありません")
+                tokens.append(("CAT", value))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self._tokens = tokens
+        self._pos = 0
+
+    def _peek(self) -> str | None:
+        if self._pos < len(self._tokens):
+            return self._tokens[self._pos][0]
+        return None
+
+    def _next(self) -> Token:
+        if self._pos >= len(self._tokens):
+            raise QueryError("クエリが途中で終わっています")
+        tok = self._tokens[self._pos]
+        self._pos += 1
+        return tok
+
+    def parse(self) -> Predicate:
+        if not self._tokens:
+            raise QueryError("クエリが空です")
+        pred = self._or_expr()
+        if self._pos != len(self._tokens):
+            raise QueryError(f"予期しないトークンです: {self._tokens[self._pos][1]!r}")
+        return pred
+
+    def _or_expr(self) -> Predicate:
+        left = self._and_expr()
+        while self._peek() == "OR":
+            self._next()
+            left = _or(left, self._and_expr())
+        return left
+
+    def _and_expr(self) -> Predicate:
+        left = self._not_expr()
+        while True:
+            kind = self._peek()
+            if kind == "AND":
+                self._next()
+                left = _and(left, self._not_expr())
+            elif kind in ("TERM", "CAT", "LPAREN", "NOT"):
+                # 演算子を省略した AND
+                left = _and(left, self._not_expr())
+            else:
+                return left
+
+    def _not_expr(self) -> Predicate:
+        if self._peek() == "NOT":
+            self._next()
+            return _not(self._not_expr())
+        return self._primary()
+
+    def _primary(self) -> Predicate:
+        kind, value = self._next()
+        if kind == "TERM":
+            return _term(value)
+        if kind == "CAT":
+            return _cat(value)
+        if kind == "LPAREN":
+            inner = self._or_expr()
+            if self._peek() != "RPAREN":
+                raise QueryError("対応する ')' がありません")
+            self._next()
+            return inner
+        raise QueryError(f"項が必要です: {value!r}")
+
+
+def _or(a: Predicate, b: Predicate) -> Predicate:
+    return lambda e: a(e) or b(e)
+
+
+def _and(a: Predicate, b: Predicate) -> Predicate:
+    return lambda e: a(e) and b(e)
+
+
+def _not(a: Predicate) -> Predicate:
+    return lambda e: not a(e)
+
+
+def _term(value: str) -> Predicate:
+    needle = value.casefold()
+
+    def pred(e: Expense) -> bool:
+        return needle in e.memo.casefold() or needle in e.category.casefold()
+
+    return pred
+
+
+def _cat(value: str) -> Predicate:
+    wanted = value.casefold()
+
+    def pred(e: Expense) -> bool:
+        return e.category.casefold() == wanted
+
+    return pred
+
+
+def _compile(q: str) -> Predicate:
+    return _Parser(tokenize(q)).parse()
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _compile(q)(e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    pred = _compile(q)
+    return [e for e in rows if pred(e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..50d2266
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,67 @@
+"""Detect recurring expenses (same category and amount at roughly monthly intervals)."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+from itertools import pairwise
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day in the next month, clamped to that month's last day."""
+    year, month = (d.year + 1, 1) if d.month == 12 else (d.year, d.month + 1)
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    """Find (category, amount) series that recur about monthly.
+
+    Consecutive dates d_i, d_{i+1} are linked when
+    abs((d_{i+1} - add_month(d_i)).days) <= tolerance. Each maximal linked run
+    with at least ``min_count`` dates yields one ``Recurring``.
+    """
+    if min_count < 2:
+        raise ValueError(f"min_count は 2 以上である必要があります: {min_count}")
+    if tolerance < 0:
+        raise ValueError(f"tolerance は 0 以上である必要があります: {tolerance}")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    found: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        days = sorted(day_set)
+        runs: list[list[date]] = [[days[0]]]
+        for prev, cur in pairwise(days):
+            if abs((cur - add_month(prev)).days) <= tolerance:
+                runs[-1].append(cur)
+            else:
+                runs.append([cur])
+        for run in runs:
+            if len(run) >= min_count:
+                found.append(
+                    Recurring(
+                        category=category,
+                        amount=amount,
+                        days=tuple(run),
+                        next_expected=add_month(run[-1]),
+                    )
+                )
+
+    found.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return found
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..aaa4823
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,231 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥5", 5),
+        ("￥5", 5),
+        ("-980円", -980),
+        ("1234", 1234),
+        ("1,2", 12),
+    ],
+    ids=[
+        "fullwidth-yen-with-commas-and-spaces",
+        "negative-yen",
+        "yen-suffix",
+        "zero",
+        "halfwidth-yen",
+        "fullwidth-yen",
+        "negative-with-suffix",
+        "plain-digits",
+        "comma-position-not-checked",
+    ],
+)
+def test_parse_amount_accepts(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "   ",
+        "円",
+        "12.5",
+        "1 200",
+        "--5",
+        "¥-5",
+        "１２３",
+        "-",
+        "¥",
+        ",",
+        "5円円",
+        "円5",
+        "5 円",
+        ",5",
+    ],
+)
+def test_parse_amount_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        ("2026/01/05", date(2026, 1, 5)),
+        ("2026-1-5", date(2026, 1, 5)),
+        (" 2026/12/31 ", date(2026, 12, 31)),
+        ("2024/2/29", date(2024, 2, 29)),
+    ],
+)
+def test_parse_date_accepts(text: str, expected: date) -> None:
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026/1-5",
+        "2026-1/5",
+        "26/1/5",
+        "2026/02/30",
+        "2025/2/29",
+        "2026/13/1",
+        "2026/1/0",
+        "２０２６/1/5",
+        "2026.1.5",
+        "2026/1/5/",
+        "",
+        "2026/1",
+        "20260105",
+    ],
+)
+def test_parse_date_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+def test_default_mapping_values() -> None:
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+HEADER = "利用日,分類,利用金額,利用店名,余分\n"
+
+
+def test_import_rows_basic_with_default_mapping() -> None:
+    text = HEADER + '2026/1/5,食費,"￥1,200",コンビニ,x\n2026-01-06,交通,-300,駅,y\n'
+    expenses, errors = import_rows(text)
+    assert errors == []
+    assert expenses == [
+        Expense(date(2026, 1, 5), "食費", 1200, "コンビニ"),
+        Expense(date(2026, 1, 6), "交通", -300, "駅"),
+    ]
+
+
+def test_import_rows_quoted_comma_in_value() -> None:
+    text = HEADER + '2026/1/5,食費,100,"A, B店",\n'
+    expenses, errors = import_rows(text)
+    assert errors == []
+    assert expenses[0].memo == "A, B店"
+
+
+def test_import_rows_strips_whitespace_and_applies_category_map() -> None:
+    text = HEADER + " 2026/1/5 , 食費 , 100 ,  店  ,\n"
+    expenses, errors = import_rows(text, category_map={"食費": "Food"})
+    assert errors == []
+    assert expenses == [Expense(date(2026, 1, 5), "Food", 100, "店")]
+
+
+def test_category_map_missing_key_keeps_category() -> None:
+    text = HEADER + "2026/1/5,食費,100,店,\n"
+    expenses, _ = import_rows(text, category_map={"交通": "Transit"})
+    assert expenses[0].category == "食費"
+
+
+def test_import_rows_custom_mapping_and_memo_omitted() -> None:
+    text = "日,カテゴリ,金額\n2026/1/5,食費,100\n"
+    mapping = {"date": "日", "category": "カテゴリ", "amount": "金額"}
+    expenses, errors = import_rows(text, mapping=mapping)
+    assert errors == []
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+def test_import_rows_short_row_treats_missing_as_empty() -> None:
+    text = HEADER + "2026/1/5,食費,100\n"
+    expenses, errors = import_rows(text)
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "")]
+    assert errors == []
+
+
+def test_import_rows_short_row_missing_category_is_error() -> None:
+    text = HEADER + "2026/1/5\n"
+    expenses, errors = import_rows(text)
+    assert expenses == []
+    assert errors == [(2, "amount"), (2, "category")]
+
+
+def test_import_rows_records_all_errors_in_order_and_excludes_row() -> None:
+    text = HEADER + "bad,  ,abc,x,\n2026/1/5,食費,100,x,\n"
+    expenses, errors = import_rows(text)
+    assert errors == [(2, "date"), (2, "amount"), (2, "category")]
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "x")]
+
+
+def test_import_rows_error_row_only_excluded_not_neighbours() -> None:
+    text = HEADER + "2026/1/5,食費,100,a,\n2026/1/6,,100,b,\n2026/1/7,交通,100,c,\n"
+    expenses, errors = import_rows(text)
+    assert errors == [(3, "category")]
+    assert [e.memo for e in expenses] == ["a", "c"]
+
+
+def test_import_rows_blank_lines_are_skipped_but_counted() -> None:
+    text = HEADER + "\n2026/1/5,食費,100,a,\n\n2026/1/6,,100,b,\n"
+    expenses, errors = import_rows(text)
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "a")]
+    assert errors == [(5, "category")]
+
+
+def test_import_rows_line_number_counts_multiline_quoted_record() -> None:
+    text = HEADER + '"2026/1/5\n",食費,100,a,\n2026/1/6,,100,b,\n'
+    expenses, errors = import_rows(text)
+    # the first record spans physical lines 2-3 and is valid; the bad row is line 4
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "a")]
+    assert errors == [(4, "category")]
+
+
+def test_import_rows_empty_category_after_strip_is_error() -> None:
+    text = HEADER + "2026/1/5,   ,100,a,\n"
+    expenses, errors = import_rows(text)
+    assert expenses == []
+    assert errors == [(2, "category")]
+
+
+def test_import_rows_header_only_returns_empty() -> None:
+    assert import_rows(HEADER) == ([], [])
+
+
+def test_import_rows_empty_text_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows("")
+
+
+def test_import_rows_mapping_missing_required_key_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows(HEADER, mapping={"date": "利用日", "amount": "利用金額"})
+
+
+def test_import_rows_mapping_column_not_in_header_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows(HEADER, mapping={**DEFAULT_MAPPING, "amount": "存在しない列"})
+
+
+def test_import_rows_mapping_memo_column_missing_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows(HEADER, mapping={**DEFAULT_MAPPING, "memo": "無い列"})
+
+
+def test_import_rows_memo_is_optional_in_mapping() -> None:
+    text = "日,分類,金額\n2026/1/5,食費,100\n"
+    mapping = {"date": "日", "category": "分類", "amount": "金額"}
+    expenses, _ = import_rows(text, mapping=mapping)
+    assert expenses[0].memo == ""
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..373b523
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,223 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def E(d: str, cat: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(d), category=cat, amount=amount)
+
+
+PREV = "2026-10"
+CURR = "2026-11"
+
+
+def test_basic_statuses_and_pct():
+    rows = [
+        E("2026-10-05", "food", 1000),
+        E("2026-11-05", "food", 1300),  # up +300 (+30.0%)
+        E("2026-10-06", "rent", 5000),
+        E("2026-11-06", "rent", 3000),  # down -2000 (-40.0%)
+        E("2026-10-07", "fun", 500),
+        E("2026-11-07", "fun", 500),  # same
+        E("2026-11-08", "tax", 700),  # new
+        E("2026-10-09", "gift", 900),  # gone
+    ]
+    got = {r.category: r for r in month_diff(rows, PREV, CURR)}
+    assert got["food"] == DiffRow("food", 1000, 1300, 300, 30.0, "up")
+    assert got["rent"] == DiffRow("rent", 5000, 3000, -2000, -40.0, "down")
+    assert got["fun"] == DiffRow("fun", 500, 500, 0, 0.0, "same")
+    assert got["tax"] == DiffRow("tax", 0, 700, 700, None, "new")
+    assert got["gift"] == DiffRow("gift", 900, 0, -900, -100.0, "gone")
+    assert len(got) == 5
+
+
+def test_only_categories_present_in_either_month_and_other_months_ignored():
+    rows = [
+        E("2026-09-01", "old", 100),  # other month: ignored
+        E("2026-12-01", "later", 100),  # other month: ignored
+        E("2026-10-01", "food", 10),
+    ]
+    got = month_diff(rows, PREV, CURR)
+    assert [r.category for r in got] == ["food"]
+    assert got[0].status == "gone"
+
+
+def test_empty_rows_gives_empty_list():
+    assert month_diff([], PREV, CURR) == []
+
+
+def test_pct_none_when_prev_sum_is_zero_even_with_entries():
+    rows = [E("2026-10-01", "food", 0), E("2026-11-01", "food", 300)]
+    (r,) = month_diff(rows, PREV, CURR)
+    assert r == DiffRow("food", 0, 300, 300, None, "up")
+
+
+def test_status_uses_entry_presence_not_sum():
+    # prev has entries summing to 0 -> not "new"; curr sums to 0 with entries -> not "gone"
+    rows = [
+        E("2026-10-01", "a", 500),
+        E("2026-10-02", "a", -500),
+        E("2026-11-01", "b", 100),
+        E("2026-11-02", "b", -100),
+    ]
+    got = {r.category: r for r in month_diff(rows, PREV, CURR)}
+    assert got["a"].status == "gone"
+    assert got["a"].prev == 0 and got["a"].pct is None
+    assert got["b"].status == "new"
+
+
+def test_status_same_when_both_sides_have_entries_and_delta_zero_with_nonzero_sums():
+    rows = [
+        E("2026-10-01", "x", 100),
+        E("2026-11-01", "x", 100),
+    ]
+    (r,) = month_diff(rows, PREV, CURR)
+    assert r.status == "same"
+    assert r.pct == 0.0
+
+
+def test_pct_rounding_to_one_decimal():
+    rows = [E("2026-10-01", "x", 3), E("2026-11-01", "x", 4)]  # 1/3*100 = 33.33
+    (r,) = month_diff(rows, PREV, CURR)
+    assert r.pct == 33.3
+
+
+def test_sorted_by_abs_delta_desc_then_category_asc():
+    rows = [
+        E("2026-10-01", "b", 100),
+        E("2026-11-01", "b", 0),  # delta -100
+        E("2026-10-01", "a", 0),
+        E("2026-11-01", "a", 100),  # delta +100 (tie -> "a" first)
+        E("2026-11-01", "c", 500),  # new, delta 500 -> first
+        E("2026-10-01", "d", 50),  # gone, delta -50 -> last
+    ]
+    got = [r.category for r in month_diff(rows, PREV, CURR)]
+    assert got == ["c", "a", "b", "d"]
+
+
+def test_same_month_both_sides_gives_all_same():
+    rows = [E("2026-10-01", "x", 10)]
+    (r,) = month_diff(rows, PREV, PREV)
+    assert r.status == "same" and r.delta == 0
+
+
+@pytest.mark.parametrize(
+    "prev, curr",
+    [
+        ("2026-1", CURR),
+        ("2026-13", CURR),
+        ("2026-00", CURR),
+        ("2026/10", CURR),
+        ("202610", CURR),
+        ("26-10", CURR),
+        (" 2026-10", CURR),
+        ("2026-10 ", CURR),
+        ("", CURR),
+        (PREV, "2026-1"),
+        (PREV, "2026-11-01"),
+        (PREV, "２０２６-11"),
+    ],
+)
+def test_invalid_month_raises(prev, curr):
+    with pytest.raises(ValueError):
+        month_diff([], prev, curr)
+
+
+def test_top_movers_excludes_same_keeps_order_and_limits():
+    diffs = [
+        DiffRow("a", 0, 900, 900, None, "new"),
+        DiffRow("b", 100, 100, 0, 0.0, "same"),
+        DiffRow("c", 500, 0, -500, -100.0, "gone"),
+        DiffRow("d", 10, 20, 10, 100.0, "up"),
+        DiffRow("e", 5, 6, 1, 20.0, "up"),
+    ]
+    assert [r.category for r in top_movers(diffs)] == ["a", "c", "d"]
+    assert [r.category for r in top_movers(diffs, 2)] == ["a", "c"]
+    assert [r.category for r in top_movers(diffs, 10)] == ["a", "c", "d", "e"]
+
+
+def test_top_movers_zero_and_default():
+    diffs = [DiffRow("a", 0, 1, 1, None, "new")]
+    assert top_movers(diffs, 0) == []
+    assert top_movers([]) == []
+    assert top_movers(diffs) == diffs
+
+
+def test_top_movers_negative_n_raises():
+    with pytest.raises(ValueError):
+        top_movers([], -1)
+
+
+def test_render_diff_format():
+    diffs = [
+        DiffRow("food", 1000, 1300, 300, 30.0, "up"),
+        DiffRow("rent", 5000, 3000, -2000, -40.0, "down"),
+        DiffRow("fun", 500, 500, 0, 0.0, "same"),
+        DiffRow("tax", 0, 700, 700, None, "new"),
+        DiffRow("gift", 900, 0, -900, -100.0, "gone"),
+    ]
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "food\t1000\t1300\t+300\t+30.0%\n"
+        "rent\t5000\t3000\t-2000\t-40.0%\n"
+        "fun\t500\t500\t+0\t+0.0%\n"
+        "tax\t0\t700\t+700\t-\n"
+        "gift\t900\t0\t-900\t-100.0%"
+    )
+
+
+def test_render_diff_no_trailing_newline_and_empty():
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+    s = render_diff([DiffRow("a", 1, 1, 0, 0.0, "same")])
+    assert not s.endswith("\n")
+
+
+def test_render_diff_negative_tiny_pct_shows_plus_zero():
+    # delta=-1 on prev=100000 -> pct rounds to -0.0; shown as +0.0%
+    (r,) = month_diff(
+        [E("2026-10-01", "x", 100000), E("2026-11-01", "x", 99999)], PREV, CURR
+    )
+    assert r.status == "down" and r.delta == -1
+    assert render_diff([r]).split("\t")[-1] == "+0.0%"
+
+
+def test_available_months_sorted_unique_across_years():
+    rows = [
+        E("2026-11-01", "x", 1),
+        E("2025-12-31", "x", 1),
+        E("2026-01-01", "x", 1),
+        E("2026-11-30", "y", 1),
+        E("2025-02-01", "x", 1),
+    ]
+    assert available_months(rows) == ["2025-02", "2025-12", "2026-01", "2026-11"]
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months():
+    rows = [
+        E("2026-08-01", "x", 999),  # not among the last two
+        E("2026-10-01", "food", 100),
+        E("2026-11-01", "food", 150),
+        E("2026-12-01", "food", 10),  # latest -> curr is 2026-12
+    ]
+    got = latest_diff(rows)
+    assert got == month_diff(rows, "2026-11", "2026-12")
+    assert [r.category for r in got] == ["food"]
+    assert got[0].prev == 150 and got[0].curr == 10
+
+
+def test_latest_diff_needs_two_months():
+    with pytest.raises(ValueError):
+        latest_diff([])
+    with pytest.raises(ValueError):
+        latest_diff([E("2026-10-01", "x", 1), E("2026-10-02", "x", 2)])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..994451c
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,208 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+E1 = Expense(date(2026, 11, 1), "food", 1200, "lunch with Ann")
+E2 = Expense(date(2026, 11, 2), "rent", 80000, "")
+E3 = Expense(date(2026, 11, 3), "Food", 800, "Coffee (large)")
+E4 = Expense(date(2026, 11, 4), "book", 500, "manga")
+ROWS = [E1, E2, E3, E4]
+
+
+# --- tokenize -------------------------------------------------------------
+
+
+def test_tokenize_empty_and_spaces_only():
+    assert tokenize("") == []
+    assert tokenize("   \t ") == []
+
+
+def test_tokenize_parens():
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+
+
+def test_tokenize_quoted_keeps_spaces_and_parens():
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+
+
+def test_tokenize_quoted_operator_word_is_term():
+    assert tokenize('"AND"') == [("TERM", "AND")]
+
+
+def test_tokenize_unclosed_quote_rejected():
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_rejected():
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_operators_uppercase_only():
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+    assert tokenize("and or not") == [
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_cat_prefix():
+    assert tokenize("cat:food") == [("CAT", "food")]
+
+
+def test_tokenize_cat_empty_rejected():
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_tokenize_word_stops_at_paren_and_quote():
+    assert tokenize('ab(cd)"ef"') == [
+        ("TERM", "ab"),
+        ("LPAREN", "("),
+        ("TERM", "cd"),
+        ("RPAREN", ")"),
+        ("TERM", "ef"),
+    ]
+
+
+# --- matches / filter_rows: evaluation -----------------------------------
+
+
+def test_term_matches_memo_substring():
+    assert matches("lunch", E1)
+    assert not matches("lunch", E2)
+
+
+def test_term_matches_category_substring():
+    assert matches("oo", E4)  # "book"
+    assert not matches("oo", E2)  # "rent" with empty memo
+
+
+def test_term_is_case_insensitive():
+    assert matches("LUNCH", E1)
+    assert matches("food", E3)  # category "Food"
+
+
+def test_cat_requires_exact_category():
+    assert matches("cat:food", E1)
+    assert matches("cat:FOOD", E1)
+    assert not matches("cat:foo", E1)  # substring is not enough
+    assert not matches("cat:food", E2)
+
+
+def test_implicit_and_between_terms():
+    assert matches("coffee large", E3)
+    assert not matches("coffee rent", E3)
+
+
+def test_explicit_and():
+    assert matches("food AND lunch", E1)
+    assert not matches("food AND rent", E1)
+
+
+def test_or():
+    assert matches("rent OR lunch", E1)
+    assert matches("rent OR lunch", E2)
+    assert not matches("rent OR lunch", E4)
+
+
+def test_not():
+    assert matches("NOT rent", E1)
+    assert not matches("NOT rent", E2)
+
+
+def test_double_not():
+    assert matches("NOT NOT lunch", E1)
+
+
+def test_precedence_not_binds_tighter_than_and():
+    # (NOT rent) AND lunch
+    assert matches("NOT rent lunch", E1)
+    assert not matches("NOT rent lunch", E2)
+
+
+def test_precedence_and_binds_tighter_than_or():
+    # rent OR (food AND lunch)
+    assert matches("rent OR food AND lunch", E1)
+    assert matches("rent OR food AND lunch", E2)
+    assert not matches("rent OR food AND lunch", E3)
+
+
+def test_parentheses_override_precedence():
+    # (rent OR food) AND lunch
+    assert matches("(rent OR food) AND lunch", E1)
+    assert not matches("(rent OR food) AND lunch", E2)
+
+
+def test_quoted_term_with_space():
+    assert matches('"with Ann"', E1)
+    assert not matches('"with Ann"', E3)
+
+
+def test_quoted_term_with_parens():
+    assert matches('"(large)"', E3)
+
+
+def test_quoted_operator_word_is_plain_term():
+    assert not matches('"AND"', E1)
+    assert matches('"AND"', Expense(date(2026, 1, 1), "x", 1, "a AND b"))
+
+
+def test_lowercase_and_is_a_term():
+    assert not matches("food and lunch", E1)  # "and" must appear literally
+    assert matches("food and", Expense(date(2026, 1, 1), "food", 1, "and"))
+
+
+def test_filter_rows_keeps_input_order():
+    assert filter_rows("food", ROWS) == [E1, E3]
+
+
+def test_filter_rows_empty_result():
+    assert filter_rows("nothing", ROWS) == []
+
+
+def test_filter_rows_empty_input():
+    assert filter_rows("food", []) == []
+
+
+def test_filter_rows_invalid_query_raises_even_with_no_rows():
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
+
+
+# --- syntax errors --------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(",
+        ")",
+        "a)",
+        "(a",
+        "(a))",
+        "a OR",
+        "OR a",
+        "a AND",
+        "AND a",
+        "NOT",
+        "a NOT",
+        "a OR OR b",
+        "a AND OR b",
+        "NOT OR a",
+        "(a OR)",
+    ],
+)
+def test_syntax_errors(q):
+    with pytest.raises(QueryError):
+        matches(q, E1)
+    with pytest.raises(QueryError):
+        filter_rows(q, ROWS)
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..3a7d16f
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,182 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+@pytest.mark.parametrize(
+    ("src", "expected"),
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2024, 1, 31), date(2024, 2, 29)),
+        (date(2026, 12, 15), date(2027, 1, 15)),
+        (date(2026, 11, 30), date(2026, 12, 30)),
+        (date(2026, 3, 31), date(2026, 4, 30)),
+        (date(2026, 2, 28), date(2026, 3, 28)),
+    ],
+    ids=[
+        "jan31-to-feb28",
+        "jan31-leap",
+        "dec-to-jan",
+        "nov30",
+        "mar31-to-apr30",
+        "feb28",
+    ],
+)
+def test_add_month(src, expected):
+    assert add_month(src) == expected
+
+
+def _e(day, category="rent", amount=80000, memo=""):
+    return Expense(day, category, amount, memo)
+
+
+def test_rejects_bad_parameters():
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_empty_and_no_match():
+    assert find_recurring([]) == []
+    rows = [_e(date(2026, 1, 5)), _e(date(2026, 2, 5))]  # only 2 < min_count 3
+    assert find_recurring(rows) == []
+
+
+def test_basic_monthly_series():
+    rows = [
+        _e(date(2026, 1, 5)),
+        _e(date(2026, 2, 5)),
+        _e(date(2026, 3, 5)),
+    ]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="rent",
+            amount=80000,
+            days=(date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+            next_expected=date(2026, 4, 5),
+        )
+    ]
+
+
+def test_duplicate_days_removed_and_memo_ignored():
+    rows = [
+        _e(date(2026, 1, 5), memo="a"),
+        _e(date(2026, 1, 5), memo="b"),
+        _e(date(2026, 2, 5), memo="c"),
+        _e(date(2026, 3, 5)),
+    ]
+    (r,) = find_recurring(rows, min_count=3)
+    assert r.days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_min_count_boundary():
+    rows = [_e(date(2026, 1, 5)), _e(date(2026, 2, 5)), _e(date(2026, 3, 5))]
+    assert len(find_recurring(rows, min_count=3)) == 1
+    assert find_recurring(rows, min_count=4) == []
+    assert len(find_recurring(rows, min_count=2)) == 1
+
+
+def test_tolerance_boundary_inclusive():
+    # add_month(2026-01-10) == 2026-02-10; 2026-02-13 is 3 days off.
+    rows = [_e(date(2026, 1, 10)), _e(date(2026, 2, 13)), _e(date(2026, 3, 13))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+    assert find_recurring(rows, tolerance=2) == []
+    # earlier side: 2026-02-07 is 3 days before add_month
+    rows_early = [_e(date(2026, 1, 10)), _e(date(2026, 2, 7)), _e(date(2026, 3, 7))]
+    assert len(find_recurring(rows_early, tolerance=3)) == 1
+
+
+def test_tolerance_zero_requires_exact_month():
+    rows = [_e(date(2026, 1, 10)), _e(date(2026, 2, 10)), _e(date(2026, 3, 10))]
+    assert len(find_recurring(rows, tolerance=0)) == 1
+    rows_off = [_e(date(2026, 1, 10)), _e(date(2026, 2, 11)), _e(date(2026, 3, 11))]
+    assert find_recurring(rows_off, tolerance=0) == []
+
+
+def test_gap_splits_runs():
+    # Jan-Mar linked, then a break, then Jun-Aug linked: two runs of 3.
+    rows = [
+        _e(date(2026, 1, 5)),
+        _e(date(2026, 2, 5)),
+        _e(date(2026, 3, 5)),
+        _e(date(2026, 6, 5)),
+        _e(date(2026, 7, 5)),
+        _e(date(2026, 8, 5)),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 5), date(2026, 6, 5)]
