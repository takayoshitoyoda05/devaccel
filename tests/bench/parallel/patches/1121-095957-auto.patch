@@ -0,0 +1,129 @@
+"""Detect monthly recurring expenses (subscriptions, rent, ...) and predict the next one.
+
+Pure functions only; no I/O.
+
+Decisions:
+D1: 系列のキー=(category, 正規化した memo)。正規化=NFKC・casefold・前後の空白除去・連続空白を 1 つに。
+    "Netflix" と "ＮＥＴＦＬＩＸ " と "netflix" は同じ系列。末尾の数字は取り除かない("Gym 1" と "Gym 2" は別系列)。
+D2: 同じカテゴリでも memo が違えば別系列。memo が空でも系列になる(Recurring.memo は "")。
+    カテゴリが違えば memo が同じでも別系列。
+D3: amount <= 0 の明細(返金・0 円)は系列から除外。
+D4: 系列の最新の金額 L に対し abs(a-L)*100 <= L*tolerance_pct を満たす明細だけが候補(超えたものは捨てる)。
+    1000,1050,1000 は tolerance 10 で系列。1000,1000,1000,1500(最新)は 1500 の 1 か月だけ → 系列なし。
+    L=1000: a=900 は含む、a=899 は捨てる。tolerance_pct=0 は完全一致のみ。
+D5: 同じ月に同じキーの明細が複数あれば 1 か月として数え、日付が最大(同日なら入力で後ろ)の明細を代表にする。
+D6: 系列は「最新の月で終わる、暦月が連続した部分」。月が抜けたらそこで切れ、古い側は捨てる。
+    1,2,4,5,6 月 → 4,5,6 月。連続した月が min_months 未満なら系列ではない。D4 で捨てた月も抜けとして数える。
+D7: next_day は最新の月の翌月(12 月なら翌年 1 月)で、日は系列の日の最頻値(同数なら大きい日)を
+    その月の末日に切り詰めたもの。1/31,2/28,3/31 → 4/30。2/15,3/15,4/16 → 5/15。
+D8: as_of を渡したとき、最新の月が as_of の前月より前の系列は解約済みとして除外。as_of=None なら除外しない。
+    next_day が as_of より過去でも除外しない。
+D9: 戻り値は next_day 昇順、同日なら category、さらに memo。空の入力 → []。rows は変更しない。
+D10: months は昇順の tuple、last_day は系列の最新の明細の日付。Recurring は frozen。
+引数: min_months / tolerance_pct は int のみ(bool・float・str・None は TypeError)。
+    min_months < 2 → ValueError、tolerance_pct が 0..100 の外 → ValueError。
+"""
+
+from __future__ import annotations
+
+import calendar
+import unicodedata
+from collections import Counter
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str  # latest memo, stripped
+    amount: int  # latest amount (yen)
+    months: tuple[str, ...]  # "YYYY-MM", ascending
+    last_day: date
+    next_day: date
+
+
+def _check_int(value: object, name: str) -> int:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{name} は int である必要があります: {value!r}")
+    return value
+
+
+def _normalize(memo: str) -> str:
+    return " ".join(unicodedata.normalize("NFKC", memo).casefold().split())
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month - 1
+
+
+def find_recurring(
+    rows: list[Expense],
+    *,
+    min_months: int = 3,
+    tolerance_pct: int = 10,
+    as_of: date | None = None,
+) -> list[Recurring]:
+    """Find monthly recurring expenses in ``rows``. See module docstring (D1-D10)."""
+    _check_int(min_months, "min_months")
+    _check_int(tolerance_pct, "tolerance_pct")
+    if min_months < 2:
+        raise ValueError(f"min_months は 2 以上である必要があります: {min_months}")
+    if not 0 <= tolerance_pct <= 100:
+        raise ValueError(
+            f"tolerance_pct は 0〜100 である必要があります: {tolerance_pct}"
+        )
+
+    # key -> month index -> (day, position, expense): latest entry of each month
+    groups: dict[tuple[str, str], dict[int, tuple[date, int, Expense]]] = {}
+    for pos, e in enumerate(rows):
+        if e.amount <= 0:
+            continue
+        key = (e.category, _normalize(e.memo))
+        month = groups.setdefault(key, {})
+        mi = _month_index(e.day)
+        cur = month.get(mi)
+        if cur is None or (e.day, pos) >= (cur[0], cur[1]):
+            month[mi] = (e.day, pos, e)
+
+    out: list[Recurring] = []
+    for by_month in groups.values():
+        last_mi = max(by_month)
+        latest = by_month[last_mi][2]
+        limit = latest.amount
+
+        run: list[int] = []
+        mi = last_mi
+        while mi in by_month:
+            amount = by_month[mi][2].amount
+            if abs(amount - limit) * 100 > limit * tolerance_pct:
+                break
+            run.append(mi)
+            mi -= 1
+        run.reverse()
+        if len(run) < min_months:
+            continue
+        if as_of is not None and last_mi < _month_index(as_of) - 1:
+            continue
+
+        counts = Counter(by_month[m][0].day for m in run)
+        anchor = max(counts, key=lambda d: (counts[d], d))
+        ny, nm0 = divmod(last_mi + 1, 12)
+        nm = nm0 + 1
+        next_day = date(ny, nm, min(anchor, calendar.monthrange(ny, nm)[1]))
+
+        out.append(
+            Recurring(
+                category=latest.category,
+                memo=latest.memo.strip(),
+                amount=latest.amount,
+                months=tuple(f"{m // 12:04d}-{m % 12 + 1:02d}" for m in run),
+                last_day=latest.day,
+                next_day=next_day,
+            )
+        )
+
+    out.sort(key=lambda r: (r.next_day, r.category, r.memo))
+    return out
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
