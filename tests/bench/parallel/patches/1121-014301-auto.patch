+def test_chain_break_splits_into_separate_runs():
+    rows = [
+        _e(date(2026, 1, 5)),
+        _e(date(2026, 2, 5)),
+        _e(date(2026, 3, 5)),
+        _e(date(2026, 6, 5)),  # gap: no link from 03-05
+        _e(date(2026, 7, 5)),
+        _e(date(2026, 8, 5)),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 5), date(2026, 6, 5)]
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+    assert result[1].days == (date(2026, 6, 5), date(2026, 7, 5), date(2026, 8, 5))
