@@ -0,0 +1,94 @@
+"""Detect fixed monthly expenses and predict their next date (pure functions)."""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_TRAILING_RE = re.compile(r"[0-9#\s]+\Z")
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str  # original memo of the last month in the series
+    amount: int  # yen, amount of the last month in the series
+    months: tuple[str, ...]  # "YYYY-MM", ascending
+    next_date: date
+
+
+def _normalize_memo(memo: str) -> str:
+    s = unicodedata.normalize("NFKC", memo).casefold().strip()
+    s = _TRAILING_RE.sub("", s)
+    return " ".join(s.split())
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month - 1
+
+
+def _format_month(idx: int) -> str:
+    return f"{idx // 12:04d}-{idx % 12 + 1:02d}"
+
+
+def _series(
+    category: str, group: list[Expense], tolerance: float, min_months: int
+) -> Recurring | None:
+    amounts = sorted(e.amount for e in group)
+    median = amounts[(len(amounts) - 1) // 2]  # lower median for even counts
+    # 境界を含む。比率は 2 つの金額のうち大きい方を基準にする(E3-3 を満たすため)。
+    inliers = [
+        e for e in group if abs(e.amount - median) <= tolerance * max(e.amount, median)
+    ]
+    by_month: dict[int, list[Expense]] = {}
+    for e in inliers:
+        by_month.setdefault(_month_index(e.day), []).append(e)
+    if not by_month:
+        return None
+    last = max(by_month)
+    # 末尾から、各月ちょうど 1 件が続く範囲だけを数える
+    run: list[int] = []
+    idx = last
+    while idx in by_month and len(by_month[idx]) == 1:
+        run.append(idx)
+        idx -= 1
+    if len(run) < min_months:
+        return None
+    run.reverse()
+    last_entry = by_month[last][0]
+    max_day = max(by_month[i][0].day.day for i in run)
+    next_idx = last + 1
+    ny, nm = next_idx // 12, next_idx % 12 + 1
+    day = min(max_day, calendar.monthrange(ny, nm)[1])
+    return Recurring(
+        category=category,
+        memo=last_entry.memo,
+        amount=last_entry.amount,
+        months=tuple(_format_month(i) for i in run),
+        next_date=date(ny, nm, day),
+    )
+
+
+def find_recurring(
+    expenses: list[Expense], min_months: int = 3, tolerance: float = 0.1
+) -> list[Recurring]:
+    if min_months < 2:
+        raise ValueError("min_months は 2 以上である必要があります")
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in expenses:
+        if e.amount <= 0:
+            continue
+        key = (e.category.strip(), _normalize_memo(e.memo))
+        groups.setdefault(key, []).append(e)
+    found: list[Recurring] = []
+    for (category, _), group in groups.items():
+        rec = _series(category, group, tolerance, min_months)
+        if rec is not None:
+            found.append(rec)
+    found.sort(key=lambda r: (r.next_date, r.category, r.memo))
+    return found
