+++ b/src/kakeibo/search.py
@@ -0,0 +1,101 @@
+"""Filter expenses with composable predicates."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable, Iterable
+from datetime import date
+
+from kakeibo.core import Expense
+
+Predicate = Callable[[Expense], bool]
+
+
+def _check_predicate(pred: object) -> Predicate:
+    if not callable(pred):
+        raise TypeError(f"predicate は callable である必要があります: {pred!r}")
+    return pred  # type: ignore[return-value]
+
+
+def category_is(*names: str) -> Predicate:
+    if not names:
+        raise ValueError("category_is には名前が 1 つ以上必要です")
+    wanted = frozenset(n.strip() for n in names)
+
+    def pred(e: Expense) -> bool:
+        return e.category in wanted
+
+    return pred
+
+
+def amount_between(lo: int | None = None, hi: int | None = None) -> Predicate:
+    if lo is not None and hi is not None and lo > hi:
+        raise ValueError(f"lo({lo}) は hi({hi}) 以下である必要があります")
+
+    def pred(e: Expense) -> bool:
+        if lo is not None and e.amount < lo:
+            return False
+        return hi is None or e.amount <= hi
+
+    return pred
+
+
+def _fold(text: str) -> str:
+    return unicodedata.normalize("NFKC", text).casefold()
+
+
+def memo_contains(text: str) -> Predicate:
+    needle = _fold(text)
+
+    def pred(e: Expense) -> bool:
+        return needle in _fold(e.memo)
+
+    return pred
+
+
+def date_between(start: date | None = None, end: date | None = None) -> Predicate:
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"start({start}) は end({end}) 以下である必要があります")
+
+    def pred(e: Expense) -> bool:
+        if start is not None and e.day < start:
+            return False
+        return end is None or e.day <= end
+
+    return pred
+
+
+def all_of(*preds: Predicate) -> Predicate:
+    checked = [_check_predicate(p) for p in preds]
+
+    def pred(e: Expense) -> bool:
+        return all(p(e) for p in checked)
+
+    return pred
+
+
+def any_of(*preds: Predicate) -> Predicate:
+    checked = [_check_predicate(p) for p in preds]
+
+    def pred(e: Expense) -> bool:
+        return any(p(e) for p in checked)
+
+    return pred
+
+
+def negate(pred: Predicate) -> Predicate:
+    inner = _check_predicate(pred)
+
+    def out(e: Expense) -> bool:
+        return not inner(e)
+
+    return out
+
+
+def search(
+    expenses: Iterable[Expense], predicate: Predicate | None = None
+) -> list[Expense]:
+    if predicate is None:
+        return list(expenses)
+    checked = _check_predicate(predicate)
+    return [e for e in expenses if checked(e)]
