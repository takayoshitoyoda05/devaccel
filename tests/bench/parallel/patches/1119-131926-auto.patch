@@ -0,0 +1,171 @@
+"""Import bank / card CSV exports into Expense records (pure functions).
+
+入力は文字列のみ。ファイル I/O は行わない。
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from collections.abc import Callable
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str
+    value: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+
+
+# 役割 -> 受け付ける列名(小文字・前後空白なしで比較)
+_ROLE_ALIASES: dict[str, tuple[str, ...]] = {
+    "date": ("date", "日付", "利用日", "取引日", "ご利用日"),
+    "amount": ("amount", "金額", "利用金額", "ご利用金額"),
+    "out": ("出金", "出金額", "支払", "お支払金額"),
+    "in": ("入金", "入金額", "預入"),
+    "memo": ("memo", "description", "摘要", "メモ", "利用店名", "ご利用店名"),
+    "category": ("category", "カテゴリ", "分類"),
+}
+
+# エラー表示に使う列名
+_COLUMN_LABEL = {"date": "日付", "amount": "金額", "out": "出金", "in": "入金"}
+
+_TIME_SUFFIX = r"(?:\s+\d{1,2}:\d{2}(?::\d{2})?)?"
+_DATE_RES = [
+    re.compile(p + _TIME_SUFFIX)
+    for p in (
+        r"(\d{4})-(\d{1,2})-(\d{1,2})",
+        r"(\d{4})/(\d{1,2})/(\d{1,2})",
+        r"(\d{4})\.(\d{1,2})\.(\d{1,2})",
+        r"(\d{4})年(\d{1,2})月(\d{1,2})日",
+    )
+]
+
+
+def _parse_date(text: str) -> date:
+    if not text:
+        raise ValueError("日付が空です")
+    for pat in _DATE_RES:
+        m = pat.fullmatch(text)
+        if m:
+            year, month, day = (int(g) for g in m.groups())
+            try:
+                return date(year, month, day)
+            except ValueError:
+                raise ValueError("存在しない日付です") from None
+    raise ValueError("日付の形式が不正です")
+
+
+def _resolve_parser(
+    amount_parser: Callable[[str], int] | None,
+) -> Callable[[str], int]:
+    if amount_parser is not None:
+        return amount_parser
+    # 遅延 import (D1)。money.py は別単位が作るため、この単位の作業ツリーでは未解決になりうる。
+    from kakeibo.money import parse_amount  # pyright: ignore[reportMissingImports]
+
+    return parse_amount
+
+
+def import_bank_csv(
+    text: str, amount_parser: Callable[[str], int] | None = None
+) -> ImportResult:
+    text = text.removeprefix("﻿")
+    first_line = text.split("\n", 1)[0]
+    delimiter = "\t" if first_line.count("\t") >= first_line.count(",") else ","
+
+    # レコードごとの開始行(1 始まり)を控える
+    records: list[tuple[int, list[str]]] = []
+    reader = csv.reader(io.StringIO(text), delimiter=delimiter)
+    start = 1
+    for row in reader:
+        records.append((start, row))
+        start = reader.line_num + 1
+
+    # 空行(全セルが空)は読み飛ばす
+    nonblank = [(ln, row) for ln, row in records if any(c.strip() for c in row)]
+    if not nonblank:
+        return ImportResult([], [])
+
+    _, header = nonblank[0]
+    body = nonblank[1:]
+
+    cols: dict[str, int] = {}
+    for i, name in enumerate(header):
+        key = name.strip().lower()
+        for role, aliases in _ROLE_ALIASES.items():
+            if key in aliases and role not in cols:
+                cols[role] = i
+
+    errors: list[RowError] = []
+    if "date" not in cols:
+        errors.append(RowError(1, "日付", "", "必須列がありません"))
+    if "amount" not in cols and "out" not in cols:
+        errors.append(RowError(1, "金額", "", "必須列がありません"))
+    if errors:
+        return ImportResult([], errors)
+
+    expenses: list[Expense] = []
+    for line, row in body:
+        if len(row) != len(header):
+            errors.append(RowError(line, "", "", "列数が一致しません"))
+            continue
+
+        def raw(role: str, row: list[str] = row) -> str:
+            return row[cols[role]] if role in cols else ""
+
+        row_errors: list[RowError] = []
+        # 金額の取り出し元: (列の役割, 生の値)。None なら金額なし。
+        source: tuple[str, str] | None = None
+        if "amount" in cols and raw("amount").strip():
+            source = ("amount", raw("amount"))
+        elif "out" in cols:
+            out_val, in_val = raw("out"), raw("in")
+            if out_val.strip() and in_val.strip():
+                row_errors.append(
+                    RowError(line, "出金", out_val, "出金と入金の両方に値があります")
+                )
+            elif not out_val.strip():
+                continue  # 入金だけ・両方空の行は黙ってスキップ
+            else:
+                source = ("out", out_val)
+        else:
+            row_errors.append(RowError(line, "金額", raw("amount"), "金額が空です"))
+
+        day: date | None = None
+        try:
+            day = _parse_date(raw("date").strip())
+        except ValueError as e:
+            row_errors.append(RowError(line, "日付", raw("date"), str(e)))
+
+        amount: int | None = None
+        if source is not None:
+            role, val = source
+            try:
+                parsed = _resolve_parser(amount_parser)(val.strip())
+            except ValueError as e:
+                row_errors.append(RowError(line, _COLUMN_LABEL[role], val, str(e)))
+            else:
+                amount = abs(parsed) if role == "out" else parsed
+
+        if row_errors or day is None or amount is None:
+            errors.extend(row_errors)
+            continue
+
+        category = raw("category").strip() if "category" in cols else ""
+        memo = raw("memo").strip() if "memo" in cols else ""
+        expenses.append(Expense(day, category or "未分類", amount, memo))
+
+    return ImportResult(expenses, errors)
