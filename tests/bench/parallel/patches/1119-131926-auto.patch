@@ -0,0 +1,46 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthly_diff import CategoryDiff, compare_months, format_diff
+
+
+@pytest.mark.parametrize(
+    ("expenses", "month", "expected"),
+    [
+        # E5-1: 12 月に食費 1000、1 月に食費 1500 → prev 省略で 2025-12 と比較
+        pytest.param(
+            [
+                Expense(date(2025, 12, 10), "食費", 1000),
+                Expense(date(2026, 1, 10), "食費", 1500),
+            ],
+            "2026-01",
+            [CategoryDiff("食費", 1000, 1500, 500, 50.0)],
+            id="E5-1",
+        ),
+        # E5-2: 前月 0・今月 800 の交通費 → pct は None
+        pytest.param(
+            [Expense(date(2026, 3, 5), "交通費", 800)],
+            "2026-03",
+            [CategoryDiff("交通費", 0, 800, 800, None)],
+            id="E5-2",
+        ),
+    ],
+)
+def test_compare_months_table(
+    expenses: list[Expense], month: str, expected: list[CategoryDiff]
+) -> None:
+    assert compare_months(expenses, month) == expected
+
+
+def test_E5_3_format_diff_lines() -> None:
+    diffs = [
+        CategoryDiff("食費", 1000, 1500, 500, 50.0),
+        CategoryDiff("交通費", 0, 800, 800, None),
+    ]
+    assert format_diff(diffs) == (
+        "食費: 1,000 → 1,500 (+500, +50.0%)\n交通費: 0 → 800 (+800, -)"
+    )
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..f3d5448
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,185 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring
+
+
+def E(day: str, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(date.fromisoformat(day), category, amount, memo)
+
+
+# --- 例の表 (E3-1 〜 E3-3) ---
+
+
+def test_E3_1_rent_month_end_rounding() -> None:
+    """E3-1 (R4 R6)"""
+    rows = [
+        E("2026-01-31", "家賃", 80000, "家賃"),
+        E("2026-02-28", "家賃", 80000, "家賃"),
+        E("2026-03-31", "家賃", 80000, "家賃"),
+    ]
+    [rec] = find_recurring(rows)
+    assert rec.next_date == date(2026, 4, 30)
+    assert rec.months == ("2026-01", "2026-02", "2026-03")
+
+
+def test_E3_2_duplicate_month_is_not_fixed() -> None:
+    """E3-2 (R4)"""
+    rows = [
+        E("2025-10-05", "通信", 1000, "回線"),
+        E("2025-11-05", "通信", 1000, "回線"),
+        E("2025-12-05", "通信", 1000, "回線"),
+        E("2025-12-20", "通信", 1000, "回線"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_E3_3_memo_normalization_and_price_change() -> None:
+    """E3-3 (R1 R3 R5)"""
+    rows = [
+        E("2026-01-10", "娯楽", 990, "Netflix 1"),
+        E("2026-02-10", "娯楽", 990, "NETFLIX"),
+        E("2026-03-10", "娯楽", 1090, "Netflix 3"),
+    ]
+    [rec] = find_recurring(rows)
+    assert rec.amount == 1090
+    assert rec.memo == "Netflix 3"
+    assert rec.months == ("2026-01", "2026-02", "2026-03")
+
+
+# --- 端のケース ---
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+def test_min_months_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_months=1)
+
+
+def test_fewer_than_min_months_is_not_fixed() -> None:
+    rows = [E("2026-01-10", "通信", 1000), E("2026-02-10", "通信", 1000)]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_months=2)) == 1
+
+
+def test_non_positive_amounts_are_ignored() -> None:
+    rows = [
+        E("2026-01-10", "返金", -1000),
+        E("2026-02-10", "返金", -1000),
+        E("2026-03-10", "返金", -1000),
+        E("2026-04-10", "返金", 0),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_outlier_amount_breaks_the_run() -> None:
+    rows = [
+        E("2026-01-10", "通信", 1000),
+        E("2026-02-10", "通信", 5000),
+        E("2026-03-10", "通信", 1000),
+        E("2026-04-10", "通信", 1000),
+    ]
+    # 中央値 1000 に対する外れ値 5000 は系列から外れ、末尾の連続は 3-4 月の 2 か月
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_months=2)) == 1
+
+
+def test_tolerance_boundary_is_included() -> None:
+    rows = [
+        E("2026-01-10", "通信", 1000),
+        E("2026-02-10", "通信", 1000),
+        E("2026-03-10", "通信", 1100),
+    ]
+    [rec] = find_recurring(rows)
+    assert rec.amount == 1100
+
+
+def test_next_date_rounds_to_next_month_end_leap_year() -> None:
+    rows = [
+        E("2027-11-30", "保険", 500),
+        E("2027-12-31", "保険", 500),
+        E("2028-01-31", "保険", 500),
+    ]
+    [rec] = find_recurring(rows)
+    assert rec.next_date == date(2028, 2, 29)
+
+
+def test_december_rolls_over_to_january() -> None:
+    rows = [
+        E("2026-10-15", "通信", 500),
+        E("2026-11-15", "通信", 500),
+        E("2026-12-15", "通信", 500),
+    ]
+    [rec] = find_recurring(rows)
+    assert rec.next_date == date(2027, 1, 15)
+
+
+def test_gap_before_trailing_run_is_ignored() -> None:
+    rows = [
+        E("2026-01-10", "通信", 500),
+        E("2026-03-10", "通信", 500),
+        E("2026-04-10", "通信", 500),
+        E("2026-05-10", "通信", 500),
+    ]
+    [rec] = find_recurring(rows)
+    assert rec.months == ("2026-03", "2026-04", "2026-05")
+
+
+def test_non_consecutive_months_are_not_fixed() -> None:
+    rows = [
+        E("2026-01-10", "通信", 500),
+        E("2026-02-10", "通信", 500),
+        E("2026-04-10", "通信", 500),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_category_and_memo_are_separate_groups() -> None:
+    rows = [
+        E("2026-01-10", "通信", 500, "a"),
+        E("2026-02-10", "通信", 500, "a"),
+        E("2026-03-10", "通信", 500, "a"),
+        E("2026-01-10", "食費", 500, "a"),
+        E("2026-02-10", "食費", 500, "b"),
+        E("2026-03-10", "食費", 500, "a"),
+    ]
+    recs = find_recurring(rows)
+    assert [(r.category, r.memo) for r in recs] == [("通信", "a")]
+
+
+def test_memo_normalization_nfkc_and_whitespace() -> None:
+    rows = [
+        E("2026-01-10", "通信", 500, "ＮＨＫ  受信料 #2"),
+        E("2026-02-10", "通信", 500, "nhk 受信料"),
+        E("2026-03-10", "通信", 500, " NHK  受信料 "),
+    ]
+    [rec] = find_recurring(rows)
+    assert rec.months == ("2026-01", "2026-02", "2026-03")
+
+
+def test_results_sorted_by_next_date_then_category_and_memo() -> None:
+    rows = [
+        E("2026-01-10", "B", 100, "x"),
+        E("2026-02-10", "B", 100, "x"),
+        E("2026-03-10", "B", 100, "x"),
+        E("2026-01-05", "A", 200, "y"),
+        E("2026-02-05", "A", 200, "y"),
+        E("2026-03-05", "A", 200, "y"),
+        E("2026-01-20", "A", 300, "z"),
+        E("2026-02-20", "A", 300, "z"),
+        E("2026-03-20", "A", 300, "z"),
+    ]
+    recs = find_recurring(rows)
+    assert [(r.category, r.memo) for r in recs] == [
+        ("A", "y"),
+        ("B", "x"),
+        ("A", "z"),
+    ]
+    assert all(isinstance(r, Recurring) for r in recs)
diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..445a7f2
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,173 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    all_of,
+    amount_between,
+    any_of,
+    category_is,
+    date_between,
+    memo_contains,
+    negate,
+    search,
+)
+
+ROWS = [
+    Expense(date(2024, 1, 5), "食費", 800, "スーパー"),
+    Expense(date(2024, 1, 10), "食費", 1500, "外食"),
+    Expense(date(2024, 2, 1), "住居", 80000, "家賃"),
+    Expense(date(2024, 2, 3), "交通費", 300, "電車"),
+    Expense(date(2024, 2, 3), "交通費", 300, "電車"),  # duplicate on purpose
+    Expense(date(2024, 3, 1), "食費", -500, "返金 ABC"),
+]
+
+
+# --- 表の例 (E4-*) ---------------------------------------------------------
+
+
+def test_E4_1_any_of_all_of_category_amount_and_memo() -> None:
+    pred = any_of(
+        all_of(category_is("食費"), amount_between(hi=1000)),
+        memo_contains("家賃"),
+    )
+    assert search(ROWS, pred) == [ROWS[0], ROWS[2], ROWS[5]]
+
+
+def test_E4_2_any_of_no_args_returns_empty() -> None:
+    assert search(ROWS, any_of()) == []
+
+
+def test_E4_3_amount_between_lo_greater_than_hi_raises() -> None:
+    with pytest.raises(ValueError):
+        amount_between(500, 100)
+
+
+# --- 端のケース ------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "rows, pred, expected",
+    [
+        pytest.param([], category_is("食費"), [], id="R6-empty-input"),
+    ],
+)
+def test_empty_input_returns_empty(rows, pred, expected) -> None:  # type: ignore[no-untyped-def]
+    assert search(rows, pred) == expected
+
+
+def test_R6_none_predicate_returns_all_in_order_with_duplicates() -> None:
+    result = search(ROWS, None)
+    assert result == ROWS
+    assert result is not ROWS
+
+
+def test_R6_default_predicate_returns_all() -> None:
+    assert search(ROWS) == ROWS
+
+
+def test_R6_result_keeps_input_order_and_duplicates() -> None:
+    assert search(ROWS, category_is("交通費")) == [ROWS[3], ROWS[4]]
+
+
+def test_R1_category_is_strips_names_and_matches_exactly() -> None:
+    assert search(ROWS, category_is("  住居 ")) == [ROWS[2]]
+    assert search(ROWS, category_is("住")) == []
+
+
+def test_R1_category_is_multiple_names_is_or() -> None:
+    assert search(ROWS, category_is("住居", "交通費")) == [
+        ROWS[2],
+        ROWS[3],
+        ROWS[4],
+    ]
+
+
+def test_R1_category_is_zero_names_raises() -> None:
+    with pytest.raises(ValueError):
+        category_is()
+
+
+@pytest.mark.parametrize(
+    "lo, hi, expected_idx",
+    [
+        pytest.param(800, 1500, [0, 1], id="R2-both-inclusive"),
+        pytest.param(800, 800, [0], id="R2-equal-bounds-inclusive"),
+        pytest.param(None, 300, [3, 4, 5], id="R2-lo-unbounded"),
+        pytest.param(1500, None, [1, 2], id="R2-hi-unbounded"),
+        pytest.param(None, None, [0, 1, 2, 3, 4, 5], id="R2-both-unbounded"),
+    ],
+)
+def test_R2_amount_between_bounds(lo, hi, expected_idx) -> None:  # type: ignore[no-untyped-def]
+    assert search(ROWS, amount_between(lo, hi)) == [ROWS[i] for i in expected_idx]
+
+
+def test_R2_amount_uses_signed_value() -> None:
+    assert search(ROWS, amount_between(hi=-1)) == [ROWS[5]]
+
+
+def test_R2_amount_between_equal_bounds_ok() -> None:
+    amount_between(5, 5)  # must not raise
+
+
+@pytest.mark.parametrize(
+    "text, expected_idx",
+    [
+        pytest.param("abc", [5], id="R3-casefold-ascii"),
+        pytest.param("ＡＢＣ", [5], id="R3-nfkc-fullwidth"),
+        pytest.param("スーパー", [0], id="R3-substring"),
+        pytest.param("", [0, 1, 2, 3, 4, 5], id="R3-empty-always-true"),
+        pytest.param("存在しない", [], id="R3-no-match"),
+    ],
+)
+def test_R3_memo_contains(text, expected_idx) -> None:  # type: ignore[no-untyped-def]
+    assert search(ROWS, memo_contains(text)) == [ROWS[i] for i in expected_idx]
+
+
+def test_R4_date_between_inclusive_and_unbounded() -> None:
+    assert search(ROWS, date_between(date(2024, 1, 10), date(2024, 2, 1))) == [
+        ROWS[1],
+        ROWS[2],
+    ]
+    assert search(ROWS, date_between(start=date(2024, 3, 1))) == [ROWS[5]]
+    assert search(ROWS, date_between(end=date(2024, 1, 5))) == [ROWS[0]]
+    assert search(ROWS, date_between()) == ROWS
+
+
+def test_R4_date_between_start_after_end_raises() -> None:
+    with pytest.raises(ValueError):
+        date_between(date(2024, 2, 1), date(2024, 1, 1))
+
+
+def test_R5_all_of_no_args_is_true() -> None:
+    assert search(ROWS, all_of()) == ROWS
+
+
+def test_R5_any_of_no_args_is_false() -> None:
+    assert search(ROWS, any_of()) == []
+
+
+def test_R5_negate_inverts() -> None:
+    assert search(ROWS, negate(category_is("食費"))) == [ROWS[2], ROWS[3], ROWS[4]]
+
+
+def test_R5_nested_composition() -> None:
+    pred = negate(any_of(memo_contains("電車"), all_of(amount_between(lo=10000))))
+    assert search(ROWS, pred) == [ROWS[0], ROWS[1], ROWS[5]]
+
+
+def test_R7_non_callable_predicate_to_search_raises_type_error() -> None:
+    with pytest.raises(TypeError):
+        search(ROWS, "not callable")  # type: ignore[arg-type]
+
+
+def test_R7_non_callable_inside_combinator_raises_type_error() -> None:
+    with pytest.raises(TypeError):
+        all_of(category_is("食費"), 42)  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        any_of(None)  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        negate("x")  # type: ignore[arg-type]
