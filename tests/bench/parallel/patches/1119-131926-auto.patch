+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bank_csv import ImportResult, RowError, import_bank_csv
+from kakeibo.core import Expense
+
+
+def _parse(s: str) -> int:
+    """テスト用の金額解析(money.py には依存しない)。"""
+    try:
+        return int(s.replace(",", ""))
+    except ValueError:
+        raise ValueError("数字ではありません") from None
+
+
+# --- 例の表 (E2-*) ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "parser", "expected"),
+    [
+        pytest.param(
+            '利用日,ご利用店名,利用金額\n2026/1/5,ABC店,"1,200"\n',
+            _parse,
+            ImportResult([Expense(date(2026, 1, 5), "未分類", 1200, "ABC店")], []),
+            id="E2-1",
+        ),
+        pytest.param(
+            "日付,出金,入金\n2026-01-05,,5000\n",
+            _parse,
+            ImportResult([], []),
+            id="E2-2",
+        ),
+        pytest.param(
+            "日付,金額\n2026-02-30,abc\n",
+            _parse,
+            None,  # 件数・行・列だけを下で検査する
+            id="E2-3",
+        ),
+    ],
+)
+def test_example_table(text: str, parser, expected: ImportResult | None) -> None:
+    result = import_bank_csv(text, parser)
+    if expected is not None:
+        assert result == expected
+    else:
+        assert result.expenses == []
+        assert [(e.line, e.column) for e in result.errors] == [(2, "日付"), (2, "金額")]
+
+
+# --- 規則 R1〜R8 ------------------------------------------------------------
+
+
+def test_R1_bom_is_removed_from_header() -> None:
+    text = "﻿日付,金額\n2026-01-05,100\n"
+    assert import_bank_csv(text, _parse).expenses == [
+        Expense(date(2026, 1, 5), "未分類", 100, "")
+    ]
+
+
+def test_R1_tab_delimited_when_tabs_at_least_commas() -> None:
+    text = "日付\t金額\t摘要\n2026-01-05\t300\tカフェ\n"
+    assert import_bank_csv(text, _parse).expenses == [
+        Expense(date(2026, 1, 5), "未分類", 300, "カフェ")
+    ]
+
+
+def test_R1_quoted_field_with_embedded_newline_and_start_line() -> None:
+    text = '日付,金額,摘要\n2026-01-05,100,"a\nb"\n2026-01-06,x,y\n'
+    result = import_bank_csv(text, _parse)
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "a\nb")]
+    assert [(e.line, e.column) for e in result.errors] == [(4, "金額")]
+
+
+@pytest.mark.parametrize(
+    "header",
+    ["  Date  ,金額", "DATE,金額", "日付,amount"],
+)
+def test_R2_column_names_are_case_and_space_insensitive(header: str) -> None:
+    text = f"{header}\n2026-01-05,100\n"
+    assert len(import_bank_csv(text, _parse).expenses) == 1
+
+
+def test_R2_category_column_and_blank_category_become_unmatched() -> None:
+    text = "日付,金額,分類\n2026-01-05,100,食費\n2026-01-06,200,  \n"
+    result = import_bank_csv(text, _parse)
+    assert [e.category for e in result.expenses] == ["食費", "未分類"]
+
+
+@pytest.mark.parametrize(
+    "day",
+    ["2026-01-05", "2026/1/5", "2026.1.5", "2026年1月5日", "2026/1/5 12:30"],
+)
+def test_R3_accepted_date_formats(day: str) -> None:
+    text = f"日付,金額\n{day},100\n"
+    assert import_bank_csv(text, _parse).expenses[0].day == date(2026, 1, 5)
+
+
+def test_R4_withdrawal_column_is_positive_expense() -> None:
+    text = '日付,出金\n2026-01-05,"1,500"\n'
+    assert import_bank_csv(text, _parse).expenses == [
+        Expense(date(2026, 1, 5), "未分類", 1500, "")
+    ]
+
+
+def test_R4_both_withdrawal_and_deposit_is_error() -> None:
+    text = "日付,出金,入金\n2026-01-05,100,200\n"
+    result = import_bank_csv(text, _parse)
+    assert result.expenses == []
+    assert result.errors == [
+        RowError(2, "出金", "100", "出金と入金の両方に値があります")
+    ]
+
+
+def test_R5_missing_date_column_returns_error_without_raising() -> None:
+    result = import_bank_csv("金額\n100\n", _parse)
+    assert result == ImportResult([], [RowError(1, "日付", "", "必須列がありません")])
+
+
+def test_R5_missing_amount_columns_returns_error_without_raising() -> None:
+    result = import_bank_csv("日付,メモ\n2026-01-05,x\n", _parse)
+    assert result == ImportResult([], [RowError(1, "金額", "", "必須列がありません")])
+
+
+def test_R6_blank_rows_are_skipped_and_wrong_width_is_reported() -> None:
+    text = "日付,金額\n\n,,\n2026-01-05,100\n2026-01-06\n"
+    result = import_bank_csv(text, _parse)
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+    assert result.errors == [RowError(5, "", "", "列数が一致しません")]
+
+
+def test_R6_header_only_and_empty_input() -> None:
+    assert import_bank_csv("日付,金額\n", _parse) == ImportResult([], [])
+    assert import_bank_csv("", _parse) == ImportResult([], [])
+
+
+def test_R7_all_column_errors_reported_for_one_row() -> None:
+    result = import_bank_csv("日付,金額\n2026-02-30,abc\n", _parse)
+    assert result.expenses == []
+    assert [e.column for e in result.errors] == ["日付", "金額"]
+    assert all(e.line == 2 for e in result.errors)
+    assert result.errors[1].value == "abc"
+    assert result.errors[1].reason == "数字ではありません"
+
+
+def test_R8_expenses_keep_input_order() -> None:
+    text = "日付,金額\n2026-01-09,3\n2026-01-01,1\n2026-01-05,2\n"
+    assert [e.amount for e in import_bank_csv(text, _parse).expenses] == [3, 1, 2]
