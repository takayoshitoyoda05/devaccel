+"""Parse amount strings such as "¥1,234" or "▲500" into yen integers."""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+
+# 小数部は 0 だけのときに限り受ける(丸めない)。桁区切りは 3 桁ごとのときだけ。
+_NUM = r"(?:[0-9]{1,3}(?:,[0-9]{3})+|[0-9]+)(?:\.0+)?"
+# 通貨記号は前か後ろのどちらか一方だけ。記号と数字の間の空白は可。
+_BODY_RE = re.compile(rf"(?:(?:¥|JPY)\s*{_NUM}|{_NUM}(?:\s*(?:円|JPY))?)")
+_PAREN_RE = re.compile(r"\((.*)\)", re.DOTALL)
+_LEADING_NEGATIVE = ("-", "−", "△", "▲")
+
+
+def parse_amount(text: str) -> int:
+    """Return the yen amount in ``text`` as an int.
+
+    Raises ValueError (with the original text repr'd in the message) when the
+    text is not a recognizable amount.
+    """
+    s = unicodedata.normalize("NFKC", text).strip()
+    negative = False
+
+    paren = _PAREN_RE.fullmatch(s)
+    if paren is not None:
+        negative = True
+        s = paren.group(1).strip()
+    elif s[:1] in _LEADING_NEGATIVE:
+        negative = True
+        s = s[1:]
+    elif s.endswith("-"):
+        negative = True
+        s = s[:-1]
+
+    if _BODY_RE.fullmatch(s) is None:
+        raise ValueError(f"金額として解析できません: {text!r}")
+
+    digits = re.search(r"[0-9][0-9,]*", s)
+    assert digits is not None  # _BODY_RE guarantees digits are present
+    value = int(digits.group(0).split(".")[0].replace(",", ""))
+    return -value if negative else value
