@@ -0,0 +1,91 @@
+"""Month-over-month expense comparison by category (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from collections.abc import Iterable
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class CategoryDiff:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    pct: float | None
+
+
+def _check_month(value: str, name: str) -> None:
+    if not isinstance(value, str) or not _MONTH_RE.fullmatch(value):
+        raise ValueError(f"{name} は YYYY-MM 形式で指定してください: {value!r}")
+
+
+def _previous_month(month: str) -> str:
+    year, mon = int(month[:4]), int(month[5:])
+    if mon == 1:
+        return f"{year - 1}-12"
+    return f"{year}-{mon - 1:02d}"
+
+
+def compare_months(
+    expenses: Iterable[Expense], month: str, prev: str | None = None
+) -> list[CategoryDiff]:
+    """Compare per-category signed totals of `prev` and `month`.
+
+    `prev` defaults to the calendar month before `month`. Sorted by
+    abs(delta) descending, then category ascending.
+    """
+    _check_month(month, "month")
+    if prev is None:
+        prev = _previous_month(month)
+    else:
+        _check_month(prev, "prev")
+
+    previous_totals: dict[str, int] = {}
+    current_totals: dict[str, int] = {}
+    for e in expenses:
+        key = f"{e.day.year:04d}-{e.day.month:02d}"
+        if key == prev:
+            previous_totals[e.category] = previous_totals.get(e.category, 0) + e.amount
+        elif key == month:
+            current_totals[e.category] = current_totals.get(e.category, 0) + e.amount
+
+    diffs: list[CategoryDiff] = []
+    for category in set(previous_totals) | set(current_totals):
+        before = previous_totals.get(category, 0)
+        after = current_totals.get(category, 0)
+        delta = after - before
+        pct = None if before == 0 else delta / before * 100
+        diffs.append(CategoryDiff(category, before, after, delta, pct))
+    diffs.sort(key=lambda d: (-abs(d.delta), d.category))
+    return diffs
+
+
+def _signed_yen(n: int) -> str:
+    if n == 0:
+        return "±0"
+    return f"+{n:,}" if n > 0 else f"-{-n:,}"
+
+
+def _pct_text(pct: float | None) -> str:
+    if pct is None:
+        return "-"
+    rounded = round(pct, 1)
+    if rounded == 0:
+        return "0.0%"
+    return f"{rounded:+.1f}%"
+
+
+def format_diff(diffs: list[CategoryDiff]) -> str:
+    """One line per category, in the given order, joined by newlines."""
+    lines = [
+        f"{d.category}: {d.previous:,} → {d.current:,} "
+        f"({_signed_yen(d.delta)}, {_pct_text(d.pct)})"
+        for d in diffs
+    ]
+    return "\n".join(lines)
