+from __future__ import annotations
+
+import pytest
+
+from kakeibo.money import parse_amount
+
+
+# 例の表 E1-*(仕様の ID をそのまま ids に書く)
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param("▲1,500円", -1500, id="E1-1"),
+        pytest.param("（500）", -500, id="E1-3"),
+    ],
+)
+def test_spec_examples(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize("text", [pytest.param("12.5", id="E1-2")])
+def test_spec_example_error(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+# R1: 先頭末尾の空白(半角・全角)を除き、NFKC で正規化してから解析する
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param("  1234  ", 1234, id="R1-half-width-spaces"),
+        pytest.param("　1234　", 1234, id="R1-ideographic-spaces"),
+        pytest.param("１，２３４", 1234, id="R1-fullwidth-digits-and-comma"),
+    ],
+)
+def test_r1_whitespace_and_nfkc(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+# R2: 受け付ける書き方
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param("1234", 1234, id="R2-plain"),
+        pytest.param("1,234", 1234, id="R2-comma"),
+        pytest.param("1，234", 1234, id="R2-fullwidth-comma"),
+        pytest.param("¥1,234", 1234, id="R2-yen-prefix"),
+        pytest.param("￥1,234", 1234, id="R2-fullwidth-yen-prefix"),
+        pytest.param("1,234円", 1234, id="R2-en-suffix"),
+        pytest.param("JPY 1,234", 1234, id="R2-jpy-prefix"),
+        pytest.param("1234 JPY", 1234, id="R2-jpy-suffix"),
+        pytest.param("¥ 1,234", 1234, id="R2-space-after-symbol"),
+    ],
+)
+def test_r2_accepted_forms(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+# R3: 負数
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param("-300", -300, id="R3-hyphen"),
+        pytest.param("−300", -300, id="R3-minus-sign"),
+        pytest.param("△500", -500, id="R3-triangle"),
+        pytest.param("▲500", -500, id="R3-black-triangle"),
+        pytest.param("(500)", -500, id="R3-parentheses"),
+        pytest.param("500-", -500, id="R3-trailing-hyphen"),
+        pytest.param("(¥1,500)", -1500, id="R3-parentheses-with-yen"),
+    ],
+)
+def test_r3_negative(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+# R4: 0 は 0。空・空白だけ・記号だけは ValueError
+@pytest.mark.parametrize(
+    "text",
+    [
+        pytest.param("", id="R4-empty"),
+        pytest.param("   ", id="R4-spaces-only"),
+        pytest.param("　", id="R4-ideographic-space-only"),
+        pytest.param("-", id="R4-hyphen-only"),
+        pytest.param("—", id="R4-em-dash-only"),
+    ],
+)
+def test_r4_empty_or_sign_only_is_rejected(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+def test_r4_zero() -> None:
+    assert parse_amount("0") == 0
+
+
+# R5: 小数部がすべて 0 のときだけ整数として受ける
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param("12.0", 12, id="R5-point-zero"),
+        pytest.param("1,234.00", 1234, id="R5-point-zeros-with-comma"),
+    ],
+)
+def test_r5_integral_decimal_accepted(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+# R6: 桁区切りは 3 桁ごとに正しい位置のときだけ。符号の二重は ValueError
+@pytest.mark.parametrize(
+    "text",
+    [
+        pytest.param("1,23,4", id="R6-bad-grouping"),
+        pytest.param("1,2345", id="R6-short-group-then-long"),
+        pytest.param("1234,567", id="R6-long-first-group"),
+        pytest.param("--5", id="R6-double-hyphen"),
+        pytest.param("△-5", id="R6-triangle-then-hyphen"),
+        pytest.param("(-500)", id="R6-parentheses-then-hyphen"),
+        pytest.param("-500-", id="R6-hyphen-both-sides"),
+    ],
+)
+def test_r6_invalid_grouping_and_double_sign(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+# R7: ValueError のメッセージに元の文字列を repr で含める
+@pytest.mark.parametrize(
+    "text",
+    [
+        pytest.param("12.5", id="R7-decimal"),
+        pytest.param("", id="R7-empty"),
+        pytest.param("--5", id="R7-double-sign"),
+    ],
+)
+def test_r7_error_message_contains_repr(text: str) -> None:
+    with pytest.raises(ValueError) as info:
+        parse_amount(text)
+    assert repr(text) in str(info.value)
