index 0000000..3f00dd2
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,116 @@
+"""Import bank statement CSV rows (other-bank format) as Expense records."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+# 任意の "-"、任意の "¥"/"￥"、ASCII 数字で始まる数字とカンマの列、任意の "円"
+_AMOUNT_RE = re.compile(r"-?[¥￥]?[0-9][0-9,]*円?")
+# YYYY/M/D または YYYY-M-D(区切りは揃える)
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    """Parse a bank amount string such as "￥1,234" or "-300円" into yen."""
+    text = s.strip()
+    if _AMOUNT_RE.fullmatch(text) is None:
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    cleaned = text.replace(",", "").replace("¥", "").replace("￥", "").replace("円", "")
+    return int(cleaned)
+
+
+def parse_date(s: str) -> date:
+    """Parse "YYYY/M/D" or "YYYY-M-D" into a date."""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    try:
+        return date(int(m[1]), int(m[3]), int(m[4]))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Convert a header-first CSV text into Expenses.
+
+    Returns (valid expenses in input order, errors as (physical line, field)).
+    Rows with any error are excluded from the expenses.
+    """
+    cols = DEFAULT_MAPPING if mapping is None else mapping
+    for key in ("date", "category", "amount"):
+        if key not in cols:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header: list[str] = next(reader, [])
+    index: dict[str, int] = {}
+    for field in ("date", "category", "amount", "memo"):
+        if field not in cols:
+            continue
+        col = cols[field]
+        if col not in header:
+            raise ValueError(f"列 {col!r} がヘッダーにありません")
+        index[field] = header.index(col)
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    consumed = reader.line_num  # lines read so far (header included)
+    for row in reader:
+        start = consumed + 1
+        consumed = reader.line_num
+        if len(row) == 0 or (len(row) == 1 and row[0].strip() == ""):
+            continue  # 空行は読み飛ばす(行番号は数える)
+
+        def cell(field: str, row: list[str] = row) -> str:
+            i = index.get(field)
+            if i is None or i >= len(row):
+                return ""
+            return row[i]
+
+        day: date | None
+        try:
+            day = parse_date(cell("date"))
+        except ValueError:
+            errors.append((start, "date"))
+            day = None
+
+        amount: int | None
+        try:
+            amount = parse_amount(cell("amount"))
+        except ValueError:
+            errors.append((start, "amount"))
+            amount = None
+
+        category = cell("category").strip()
+        if not category:
+            errors.append((start, "category"))
+
+        if day is None or amount is None or not category:
+            continue
+        if category_map is not None:
+            category = category_map.get(category, category)
+        expenses.append(
+            Expense(
+                day=day,
+                category=category,
+                amount=amount,
+                memo=cell("memo").strip(),
+            )
+        )
+    return expenses, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
