+"""予算判定の結果行から、表示用の警告文を作る純粋関数。
+
+標準ライブラリのみ。`kakeibo.core` には依存しない。
+"""
+
+_STATUSES = ("over", "warn", "ok")
+
+
+def _check_amount(name: str, value: object) -> None:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{name} は int である必要があります: {value!r}")
+    if value < 0:
+        raise ValueError(f"{name} は 0 以上である必要があります: {value!r}")
+
+
+def format_alerts(rows: list[tuple[str, str, int, int]]) -> list[str]:
+    """(category, status, limit, actual) の行から警告文のリストを作る。
+
+    - ok の行は出さない。残りは入力の順で出す。
+    - over: 予算超過額を、warn: 残り額を表示する。
+    - 未知の status は ValueError。limit・actual は 0 以上の int のみ許す。
+    """
+    checked: list[tuple[str, str, int, int]] = []
+    for category, status, limit, actual in rows:
+        if status not in _STATUSES:
+            raise ValueError(status)
+        _check_amount("limit", limit)
+        _check_amount("actual", actual)
+        checked.append((category, status, limit, actual))
+
+    out: list[str] = []
+    for category, status, limit, actual in checked:
+        if status == "over":
+            over = actual - limit
+            out.append(
+                f"{category}: 予算超過 {over:,}円(上限 {limit:,}円 / 実績 {actual:,}円)"
+            )
+        elif status == "warn":
+            rest = limit - actual
+            out.append(
+                f"{category}: もうすぐ予算 残り {rest:,}円"
+                f"(上限 {limit:,}円 / 実績 {actual:,}円)"
+            )
+    return out
