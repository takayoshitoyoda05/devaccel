@@ -0,0 +1,170 @@
+"""Tests for kakeibo.budget_status.evaluate_budget."""
+
+from __future__ import annotations
+
+import pytest
+
+from kakeibo.budget_status import BudgetStatus, evaluate_budget
+
+
+# 仕様の例表 (E1-*) をそのまま写したテスト
+@pytest.mark.parametrize(
+    ("limits", "actuals", "expected"),
+    [
+        pytest.param(
+            {"食費": 10000},
+            {"食費": 8000},
+            [BudgetStatus("食費", 10000, 8000, 2000, "warn")],
+            id="E1-1",
+        ),
+        pytest.param(
+            {"食費": 10000},
+            {"食費": 10000},
+            [BudgetStatus("食費", 10000, 10000, 0, "warn")],
+            id="E1-2",
+        ),
+        pytest.param(
+            {"食費": 0},
+            {"食費": 1},
+            [BudgetStatus("食費", 0, 1, -1, "over")],
+            id="E1-3",
+        ),
+    ],
+)
+def test_spec_examples(limits, actuals, expected):
+    assert evaluate_budget(limits, actuals) == expected
+
+
+# R1: remaining = limit - actual(超過なら負)
+def test_remaining_is_negative_when_over():
+    (s,) = evaluate_budget({"食費": 1000}, {"食費": 1500})
+    assert s.remaining == -500
+    assert s.status == "over"
+
+
+# D1: 超過は over、ちょうど上限は warn、warn_pct 未満は ok
+def test_just_over_limit_is_over():
+    (s,) = evaluate_budget({"食費": 10000}, {"食費": 10001})
+    assert s.status == "over"
+
+
+def test_below_default_threshold_is_ok():
+    # 80% は 8000。7999 は ok
+    (s,) = evaluate_budget({"食費": 10000}, {"食費": 7999})
+    assert s.status == "ok"
+
+
+def test_exactly_default_threshold_is_warn():
+    (s,) = evaluate_budget({"食費": 10000}, {"食費": 8000})
+    assert s.status == "warn"
+
+
+# R2: しきい値は整数のみで比較する(浮動小数誤差を使わない)
+def test_threshold_comparison_is_exact_integer():
+    # 300 * 67 = 20100。201 * 100 = 20100 なので warn
+    (s,) = evaluate_budget({"食費": 300}, {"食費": 201}, warn_pct=67)
+    assert s.status == "warn"
+    (s,) = evaluate_budget({"食費": 300}, {"食費": 200}, warn_pct=67)
+    assert s.status == "ok"
+
+
+# D2: warn_pct の境界値 1 と 100 は有効
+def test_warn_pct_100_warns_only_at_limit():
+    (s,) = evaluate_budget({"食費": 10000}, {"食費": 9999}, warn_pct=100)
+    assert s.status == "ok"
+    (s,) = evaluate_budget({"食費": 10000}, {"食費": 10000}, warn_pct=100)
+    assert s.status == "warn"
+
+
+def test_warn_pct_1_is_valid():
+    (s,) = evaluate_budget({"食費": 100}, {"食費": 1}, warn_pct=1)
+    assert s.status == "warn"
+
+
+@pytest.mark.parametrize("bad", [0, -1, 101])
+def test_warn_pct_out_of_range_is_value_error(bad):
+    with pytest.raises(ValueError, match="warn_pct"):
+        evaluate_budget({"食費": 1}, {}, warn_pct=bad)
+
+
+@pytest.mark.parametrize("bad", [True, False, 80.0, "80", None])
