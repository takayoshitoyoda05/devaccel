+import pytest
+
+from kakeibo.budget_report import format_alerts
+
+
+@pytest.mark.parametrize(
+    "rows, expected",
+    [
+        pytest.param(
+            [("食費", "over", 10000, 12500)],
+            ["食費: 予算超過 2,500円(上限 10,000円 / 実績 12,500円)"],
+            id="E3-1",
+        ),
+        pytest.param(
+            [("食費", "ok", 10000, 100)],
+            [],
+            id="E3-2",
+        ),
+        pytest.param(
+            [("食費", "bad", 1, 1)],
+            ValueError,
+            id="E3-3",
+        ),
+    ],
+)
+def test_format_alerts_table(rows, expected):
+    if expected is ValueError:
+        with pytest.raises(ValueError):
+            format_alerts(rows)
+    else:
+        assert format_alerts(rows) == expected
+
+
+def test_warn_shows_remaining_amount():
+    assert format_alerts([("住居", "warn", 80000, 72000)]) == [
+        "住居: もうすぐ予算 残り 8,000円(上限 80,000円 / 実績 72,000円)"
+    ]
+
+
+def test_ok_rows_skipped_and_input_order_kept():
+    rows = [
+        ("rent", "warn", 80000, 72000),
+        ("food", "ok", 10000, 100),
+        ("misc", "over", 1000, 1500),
+        ("fun", "ok", 5000, 0),
+        ("cafe", "warn", 3000, 2900),
+    ]
+    assert format_alerts(rows) == [
+        "rent: もうすぐ予算 残り 8,000円(上限 80,000円 / 実績 72,000円)",
+        "misc: 予算超過 500円(上限 1,000円 / 実績 1,500円)",
+        "cafe: もうすぐ予算 残り 100円(上限 3,000円 / 実績 2,900円)",
+    ]
+
+
+def test_empty_input_gives_empty_list():
+    assert format_alerts([]) == []
+
+
+@pytest.mark.parametrize(
+    "row",
+    [
+        ("食費", "over", -1, 100),
+        ("食費", "over", 100, -1),
+    ],
+)
+def test_negative_amount_is_value_error(row):
+    with pytest.raises(ValueError):
+        format_alerts([row])
+
+
+@pytest.mark.parametrize(
+    "row",
+    [
+        ("食費", "over", True, 100),
+        ("食費", "over", 100, False),
+        ("食費", "over", 100.0, 100),
+        ("食費", "over", 100, "100"),
+        ("食費", "over", None, 100),
+    ],
+)
+def test_non_int_amount_is_type_error(row):
+    with pytest.raises(TypeError):
+        format_alerts([row])
