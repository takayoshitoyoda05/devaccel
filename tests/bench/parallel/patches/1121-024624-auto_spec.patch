@@ -0,0 +1,58 @@
+"""Per-category budget evaluation (pure functions).
+
+Takes plain ``dict[str, int]`` amounts so it does not depend on ``kakeibo.core``.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+_RANK = {"over": 0, "warn": 1, "ok": 2}
+
+
+@dataclass(frozen=True)
+class BudgetStatus:
+    category: str
+    limit: int
+    actual: int
+    remaining: int  # limit - actual; negative when over
+    status: str  # "over" | "warn" | "ok"
+
+
+def _check_amounts(amounts: dict[str, int], where: str) -> None:
+    for cat, yen in amounts.items():
+        if isinstance(yen, bool) or not isinstance(yen, int):
+            raise TypeError(f"{where}.{cat} は整数である必要があります")
+        if yen < 0:
+            raise ValueError(f"{where}.{cat} は 0 以上である必要があります")
+
+
+def evaluate_budget(
+    limits: dict[str, int],
+    actuals: dict[str, int],
+    warn_pct: int = 80,
+) -> list[BudgetStatus]:
+    """Evaluate each budgeted category against its actual spending.
+
+    Only categories present in ``limits`` are reported. Categories with a limit
+    but no actual are treated as spending 0.
+    """
+    if isinstance(warn_pct, bool) or not isinstance(warn_pct, int):
+        raise TypeError("warn_pct は int である必要があります")
+    if not 1 <= warn_pct <= 100:
+        raise ValueError(f"warn_pct は 1〜100 である必要があります: {warn_pct}")
+    _check_amounts(limits, "limits")
+    _check_amounts(actuals, "actuals")
+
+    out: list[BudgetStatus] = []
+    for cat, limit in limits.items():
+        actual = actuals.get(cat, 0)
+        if actual > limit:
+            status = "over"
+        elif limit > 0 and actual * 100 >= limit * warn_pct:
+            status = "warn"
+        else:
+            status = "ok"
+        out.append(BudgetStatus(cat, limit, actual, limit - actual, status))
+    out.sort(key=lambda s: (_RANK[s.status], s.category))
+    return out
diff --git a/tests/test_budget_forecast.py b/tests/test_budget_forecast.py
