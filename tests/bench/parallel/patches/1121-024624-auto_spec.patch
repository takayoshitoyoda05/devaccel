+# D6: 並びは over → warn → ok、同じ状態内はカテゴリ名の昇順
+def test_order_is_over_then_warn_then_ok_then_name():
+    limits = {"b": 100, "a": 100, "c": 100, "d": 100}
+    actuals = {"a": 150, "b": 90, "c": 10, "d": 200}
+    result = evaluate_budget(limits, actuals)
+    assert [(s.category, s.status) for s in result] == [
+        ("a", "over"),
+        ("d", "over"),
+        ("b", "warn"),
+        ("c", "ok"),
+    ]
