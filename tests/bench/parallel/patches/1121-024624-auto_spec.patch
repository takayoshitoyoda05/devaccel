@@ -0,0 +1,33 @@
+"""月末予測(ペース按分)。標準ライブラリのみ。"""
+
+
+def _check_int(name: str, value: object, lo: int, hi: int) -> None:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{name} は int で指定してください: {value!r}")
+    if not lo <= value <= hi:
+        raise ValueError(f"{name} は {lo}〜{hi} で指定してください: {value}")
+
+
+def forecast_month_end(
+    actuals: dict[str, int], elapsed_days: int, days_in_month: int
+) -> dict[str, int]:
+    """経過日数までの実績から、カテゴリごとの月末予測を返す。
+
+    予測 = 実績 * days_in_month // elapsed_days(整数の切り捨て)。
+    elapsed_days が days_in_month(月末)のときは実績をそのまま返す。
+    """
+    _check_int("days_in_month", days_in_month, 28, 31)
+    _check_int("elapsed_days", elapsed_days, 1, days_in_month)
+
+    for category, actual in actuals.items():
+        if isinstance(actual, bool) or not isinstance(actual, int):
+            raise TypeError(f"{category} の実績は int で指定してください: {actual!r}")
+        if actual < 0:
+            raise ValueError(f"{category} の実績は 0 以上で指定してください: {actual}")
+
+    if elapsed_days == days_in_month:
+        return dict(actuals)
+    return {
+        category: actual * days_in_month // elapsed_days
+        for category, actual in actuals.items()
+    }
