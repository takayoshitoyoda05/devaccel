+++ b/tests/test_budget_forecast.py
@@ -0,0 +1,78 @@
+import pytest
+
+from kakeibo.budget_forecast import forecast_month_end
+
+
+# 例の表(E2-1〜E2-3)
+@pytest.mark.parametrize(
+    ("actuals", "elapsed", "days", "expected"),
+    [
+        pytest.param({"食費": 5000}, 10, 30, {"食費": 15000}, id="E2-1"),
+        pytest.param({"食費": 1000}, 7, 30, {"食費": 4285}, id="E2-2"),
+    ],
+)
+def test_spec_examples(actuals, elapsed, days, expected):
+    assert forecast_month_end(actuals, elapsed, days) == expected
+
+
+def test_spec_example_E2_3_elapsed_zero():
+    with pytest.raises(ValueError, match="elapsed_days"):
+        forecast_month_end({"食費": 1}, 0, 30)
+
+
+# R1: ペース按分(整数の切り捨て)
+def test_r1_floor_division():
+    assert forecast_month_end({"食費": 1}, 2, 31) == {"食費": 15}  # 31 // 2
+
+
+# R2: 月末(elapsed == days)は実績そのまま
+@pytest.mark.parametrize("days", [28, 29, 30, 31])
+def test_r2_month_end_returns_actuals(days):
+    assert forecast_month_end({"食費": 1234, "家賃": 0}, days, days) == {
+        "食費": 1234,
+        "家賃": 0,
+    }
+
+
+# R3: 引数の範囲と型
+@pytest.mark.parametrize("elapsed", [0, -1, 31])
+def test_r3_elapsed_out_of_range(elapsed):
+    with pytest.raises(ValueError, match="elapsed_days"):
+        forecast_month_end({"食費": 1}, elapsed, 30)
+
+
+@pytest.mark.parametrize("days", [27, 32, 0])
+def test_r3_days_out_of_range(days):
+    with pytest.raises(ValueError, match="days_in_month"):
+        forecast_month_end({"食費": 1}, 1, days)
+
+
+@pytest.mark.parametrize("bad", [True, 1.0, "1", None])
+def test_r3_elapsed_wrong_type(bad):
+    with pytest.raises(TypeError, match="elapsed_days"):
+        forecast_month_end({"食費": 1}, bad, 30)
+
+
+@pytest.mark.parametrize("bad", [True, 30.0, "30", None])
+def test_r3_days_wrong_type(bad):
+    with pytest.raises(TypeError, match="days_in_month"):
+        forecast_month_end({"食費": 1}, 1, bad)
+
+
+# R4: 実績は 0 以上の int
+def test_r4_negative_actual_names_category():
+    with pytest.raises(ValueError, match="食費"):
+        forecast_month_end({"食費": -1}, 10, 30)
+
+
+@pytest.mark.parametrize("bad", [True, 1.5, "100", None])
+def test_r4_actual_wrong_type_names_category(bad):
+    with pytest.raises(TypeError, match="食費"):
+        forecast_month_end({"食費": bad}, 10, 30)
+
+
+# R5: 並びは入力のまま、空は空
+def test_r5_preserves_order_and_empty():
+    result = forecast_month_end({"家賃": 1, "食費": 2, "光熱費": 3}, 10, 30)
+    assert list(result) == ["家賃", "食費", "光熱費"]
+    assert forecast_month_end({}, 10, 30) == {}
