@@ -0,0 +1,211 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bank_csv import (
+    BankCsvError,
+    RowError,
+    format_row_error,
+    import_bank_csv,
+)
+from kakeibo.core import Expense
+
+# 銀行系: 日付・摘要・入金金額・出金金額・残高 (前置き行あり、出金のみ取り込む)
+BANK = (
+    "お取引明細\n"
+    "口座番号,1234567\n"
+    "\n"
+    "取引日,摘要,入金金額,出金金額,残高\n"
+    '2026/11/01,ATM出金,,"1,200","98,800"\n'
+    '2026/11/02,振込手数料,,220,"98,580"\n'
+)
+
+# カード系: 利用日・利用店名・商品名・区分・支払金額 (BOM付き)
+CARD = (
+    "﻿利用日,利用店名・商品名,区分,支払金額\n"
+    '2026.11.03,スーパーA,食費,"3,450"\n'
+    "20261104,コンビニB,,¥780\n"
+    '2026年11月5日,書店C,書籍,"2,000円"\n'
+)
+
+
+def test_bank_style_skips_preamble_and_uses_withdrawal_column():
+    result = import_bank_csv(BANK)
+    assert result.errors == []
+    assert result.rows == [
+        Expense(date(2026, 11, 1), "未分類", 1200, "ATM出金"),
+        Expense(date(2026, 11, 2), "未分類", 220, "振込手数料"),
+    ]
+
+
+def test_bank_income_row_without_withdrawal_is_reported():
+    text = "取引日,摘要,入金金額,出金金額\n2026/11/02,給与振込,300000,\n"
+    result = import_bank_csv(text)
+    assert result.rows == []
+    assert [(e.line, e.column, e.reason) for e in result.errors] == [
+        (2, "出金金額", "金額が空です")
+    ]
+
+
+def test_card_style_with_category_and_bom():
+    result = import_bank_csv(CARD)
+    assert result.errors == []
+    assert result.rows == [
+        Expense(date(2026, 11, 3), "食費", 3450, "スーパーA"),
+        Expense(date(2026, 11, 4), "未分類", 780, "コンビニB"),
+        Expense(date(2026, 11, 5), "書籍", 2000, "書店C"),
+    ]
+
+
+def test_default_category_argument_and_memo_missing():
+    text = "日付,金額\n2026-11-01,500\n"
+    result = import_bank_csv(text, default_category="雑費")
+    assert result.rows == [Expense(date(2026, 11, 1), "雑費", 500, "")]
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-11-01",
+        "2026/11/01",
+        "2026.11.01",
+        "2026年11月1日",
+        "20261101",
+        "2026-11-01 12:34",
+        "２０２６－１１－０１",
+    ],
+)
+def test_date_formats(raw):
+    result = import_bank_csv(f"日付,金額\n{raw},100\n")
+    assert result.errors == []
+    assert result.rows[0].day == date(2026, 11, 1)
+
+
+@pytest.mark.parametrize(
+    "raw, expected",
+    [
+        ("1200", 1200),
+        ("1,200", 1200),
+        ("¥1,200", 1200),
+        ("￥1,200", 1200),
+        ("1,200円", 1200),
+        ("１，２００", 1200),
+        (" 1,200 ", 1200),
+        ("0", 0),
+    ],
+)
+def test_amount_formats(raw, expected):
+    result = import_bank_csv(f'日付,金額\n2026-11-01,"{raw}"\n')
+    assert result.errors == []
+    assert result.rows[0].amount == expected
+
+
+def test_each_bad_cell_is_reported_with_line_and_column():
+    text = (
+        "日付,摘要,金額\n"  # line 1
+        "2026-11-01,ok,100\n"  # line 2 ok
+        "2026-13-01,月がない,100\n"  # line 3 存在しない日付
+        "2026-11-02,負,-500\n"  # line 4 負の金額
+        "2026-11-03,小数,12.5\n"  # line 5 整数ではない
+        "2026-11-04,空,\n"  # line 6 金額が空
+        "11/05,二桁年,100\n"  # line 7 日付の形式
+        "2026-11-06,ok3\n"  # line 8 列数不一致
+        "2026-11-07,ok2,1,000\n"  # line 9 列数不一致(区切りの ,)
+    )
+    result = import_bank_csv(text)
+    assert [r.amount for r in result.rows] == [100]
+    got = [(e.line, e.column, e.value, e.reason) for e in result.errors]
+    assert got == [
+        (3, "日付", "2026-13-01", "存在しない日付です"),
+        (4, "金額", "-500", "負の金額は取り込めません(返金・取消は未対応)"),
+        (5, "金額", "12.5", "金額が整数ではありません"),
+        (6, "金額", "", "金額が空です"),
+        (
+            7,
+            "日付",
+            "11/05",
+            "日付の形式が不正です(例: 2026-11-01, 2026/11/01, 2026年11月1日)",
+        ),
+        (8, None, "2026-11-06,ok3", "列数が一致しません(ヘッダー 3 列、この行 2 列)"),
+        (
+            9,
+            None,
+            "2026-11-07,ok2,1,000",
+            "列数が一致しません(ヘッダー 3 列、この行 4 列)",
+        ),
+    ]
+
+
+def test_multiple_bad_cells_in_one_row_are_all_reported():
+    text = "日付,金額\nxxxx,yyy\n2026-11-01,100\n"
+    result = import_bank_csv(text)
+    assert result.rows == [Expense(date(2026, 11, 1), "未分類", 100, "")]
+    assert [(e.line, e.column) for e in result.errors] == [(2, "日付"), (2, "金額")]
+
+
+def test_bad_row_is_excluded_but_good_rows_kept():
+    text = "日付,金額\n2026-11-01,100\n2026-11-02,abc\n2026-11-03,300\n"
+    result = import_bank_csv(text)
+    assert [r.amount for r in result.rows] == [100, 300]
+    assert [e.line for e in result.errors] == [3]
+
+
+def test_blank_lines_are_skipped_and_line_numbers_stay_physical():
+    text = "日付,金額\n\n2026-11-01,100\n\n2026-11-02,x\n"
+    result = import_bank_csv(text)
+    assert len(result.rows) == 1
+    assert [e.line for e in result.errors] == [5]
+
+
+def test_quoted_memo_with_comma_and_newline():
+    text = '日付,摘要,金額\n2026-11-01,"a,b\nc",100\n'
+    result = import_bank_csv(text)
+    assert result.errors == []
+    assert result.rows[0].memo == "a,b\nc"
+
+
+def test_column_map_overrides_aliases():
+    text = "ご利用日時,店,請求額\n2026-11-01,X,700\n"
+    result = import_bank_csv(
+        text, column_map={"date": "ご利用日時", "memo": "店", "amount": "請求額"}
+    )
+    assert result.rows == [Expense(date(2026, 11, 1), "未分類", 700, "X")]
+
+
+def test_column_map_replaces_alias_for_that_field():
+    # amount を列マップで指定したら、別名「金額」は使われない
+    text = "日付,金額,請求額\n2026-11-01,1,700\n"
+    result = import_bank_csv(text, column_map={"amount": "請求額"})
+    assert [r.amount for r in result.rows] == [700]
+
+
+def test_ambiguous_columns_raise_and_ask_for_column_map():
+    text = "日付,利用金額,支払金額\n2026-11-01,1,2\n"
+    with pytest.raises(BankCsvError, match="column_map"):
+        import_bank_csv(text)
+
+
+def test_no_header_raises():
+    with pytest.raises(BankCsvError, match="ヘッダー行が見つかりません"):
+        import_bank_csv("foo,bar\n1,2\n")
+
+
+def test_empty_text_raises():
+    with pytest.raises(BankCsvError, match="ヘッダー行が見つかりません"):
+        import_bank_csv("")
+
+
+def test_unknown_column_map_key_raises():
+    with pytest.raises(BankCsvError, match="不明"):
+        import_bank_csv("日付,金額\n", column_map={"shop": "店"})
+
+
+def test_format_row_error_shows_where_and_what():
+    err = RowError(
+        line=6, column="金額", value="1,2", reason="金額が整数ではありません"
+    )
+    assert (
+        format_row_error(err) == "行 6 列「金額」: 金額が整数ではありません (値: '1,2')"
+    )
+    whole = RowError(line=7, column=None, value="", reason="列数が一致しません")
+    assert format_row_error(whole) == "行 7: 列数が一致しません"
