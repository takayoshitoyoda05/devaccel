diff --git a/tests/test_types/test_Choice.py b/tests/test_types/test_Choice.py
index c34f516..e4a6ea3 100644
--- a/tests/test_types/test_Choice.py
+++ b/tests/test_types/test_Choice.py
@@ -1,3 +1,5 @@
+import pytest
+
 import click
 
 
@@ -5,3 +7,48 @@ def test_choice_get_invalid_choice_message():
     choice = click.Choice(["a", "b", "c"])
     message = choice.get_invalid_choice_message("d", ctx=None)
     assert message == "'d' is not one of 'a', 'b', 'c'."
+
+
+@pytest.mark.parametrize(
+    ("value", "suggestion"),
+    [
+        ("gren", "Did you mean 'green'?"),
+        ("bleu", "Did you mean 'blue'?"),
+    ],
+)
+def test_choice_suggests_close_match(value, suggestion):
+    choice = click.Choice(["red", "green", "blue"])
+    message = choice.get_invalid_choice_message(value, ctx=None)
+    assert message.endswith(suggestion)
+
+
+def test_choice_suggests_several_close_matches():
+    choice = click.Choice(["red", "grey", "gray2"])
+    message = choice.get_invalid_choice_message("gray", ctx=None)
+    assert message.endswith("(Did you mean one of: 'gray2', 'grey'?)")
+
+
+def test_choice_suggestion_case_insensitive():
+    choice = click.Choice(["Green", "Blue"], case_sensitive=False)
+    message = choice.get_invalid_choice_message("GREN", ctx=None)
+    assert message.endswith("Did you mean 'green'?")
+
+
+def test_choice_no_suggestion_when_far():
+    choice = click.Choice(["red", "green", "blue"])
+    message = choice.get_invalid_choice_message("zzz", ctx=None)
+    assert "Did you mean" not in message
+
+
+def test_choice_suggestion_through_cli(runner):
+    @click.command()
+    @click.option("--color", type=click.Choice(["red", "green", "blue"]))
+    def cli(color):
+        click.echo(color)
+
+    result = runner.invoke(cli, ["--color=gren"])
+    assert result.exit_code == 2
+    assert (
+        "Invalid value for '--color': 'gren' is not one of 'red', 'green', 'blue'."
+        " Did you mean 'green'?"
+    ) in result.output
