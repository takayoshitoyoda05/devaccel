+"""Month-over-month change per category (pure functions).
+
+Decisions:
+D1: 月は Expense.day の年月 "YYYY-MM"。結果は月の昇順。空の rows → []。
+D2: 最初の月から最後の月までの間に行が無い月は空の月として含める(totals={}、
+    changes は前月の全カテゴリが "gone")。例: 1月 食費 1000、3月 食費 500 →
+    2月は食費 gone(1000→0, rate=-1.0)、3月は食費 new(0→500, rate=None)。
+D3: 最初の月は比べる相手が無いので changes=()。
+D4: カテゴリがその月に 1 行以上あれば「ある」(合計が 0 や負でも「ある」)。
+    前月に無く今月にある → "new"、前月にあり今月に無い → "gone"。
+    例: 前月に食費 0 円の行があり今月 300 → "up"(new ではない)。
+D5: 両方にある場合は delta の符号で、正 "up"、負 "down"、0 "same"。"same" も含める。
+D6: rate = delta / previous(float、丸めない)。previous <= 0 のときは None。
+    例: 1000→1500 は 0.5、1000→750 は -0.25。
+D7: changes は |delta| の大きい順、同点はカテゴリ名の昇順。
+D8: 負の金額(返金)はそのまま合計に足す。例: 食費 1000 と -300 → 700。
+D9: 同月同カテゴリの複数行は合計する。カテゴリ名は正規化しない。
+D10: 年またぎ(2025-12 → 2026-01)は連続した月として比べる。
+D11: 入力の rows は変更しない。入力順は結果に影響しない。
+D12: rows が list でない、または要素が Expense でないとき TypeError。
+D13: MonthReport.totals は core.monthly_totals(rows) と一致する(空の月だけ {} が加わる)。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Literal
+
+from kakeibo.core import Expense, monthly_totals
+
+Status = Literal["up", "down", "same", "new", "gone"]
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    status: Status
+    rate: float | None
+
+
+@dataclass(frozen=True)
+class MonthReport:
+    month: str
+    totals: dict[str, int]
+    changes: tuple[CategoryChange, ...]
+
+
+def _next_month(month: str) -> str:
+    y, m = int(month[:4]), int(month[5:7])
+    y, m = (y + 1, 1) if m == 12 else (y, m + 1)
+    return f"{y:04d}-{m:02d}"
+
+
+def _compare(prev: dict[str, int], cur: dict[str, int]) -> tuple[CategoryChange, ...]:
+    out: list[CategoryChange] = []
+    for cat in prev.keys() | cur.keys():
+        p, c = prev.get(cat, 0), cur.get(cat, 0)
+        delta = c - p
+        status: Status
+        if cat not in prev:
+            status = "new"
+        elif cat not in cur:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        rate = delta / p if p > 0 else None
+        out.append(CategoryChange(cat, p, c, delta, status, rate))
+    out.sort(key=lambda ch: (-abs(ch.delta), ch.category))
+    return tuple(out)
+
+
+def monthly_changes(rows: list[Expense]) -> list[MonthReport]:
+    """Per-month category totals with month-over-month changes."""
+    if not isinstance(rows, list) or not all(isinstance(e, Expense) for e in rows):
+        raise TypeError("rows は Expense のリストである必要があります")
+    totals = monthly_totals(rows)
+    if not totals:
+        return []
+    months = sorted(totals)
+    reports: list[MonthReport] = []
+    prev: dict[str, int] | None = None
+    month = months[0]
+    while month <= months[-1]:
+        cur = totals.get(month, {})
+        reports.append(
+            MonthReport(month, cur, () if prev is None else _compare(prev, cur))
+        )
+        prev = cur
+        month = _next_month(month)
+    return reports
diff --git a/tests/test_trend.py b/tests/test_trend.py
new file mode 100644
index 0000000..faf6819
--- /dev/null
+++ b/tests/test_trend.py
@@ -0,0 +1,200 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense, monthly_totals
+from kakeibo.trend import CategoryChange, MonthReport, monthly_changes
+
+
+def E(y, m, d, cat, amt):
+    return Expense(date(y, m, d), cat, amt)
+
+
+def _by_cat(report: MonthReport) -> dict[str, CategoryChange]:
+    return {c.category: c for c in report.changes}
+
+
+def test_d1_months_ascending(  # D1: 月は年月で昇順
+):
+    rows = [E(2026, 2, 1, "食費", 100), E(2026, 1, 5, "食費", 200)]
+    reports = monthly_changes(rows)
+    assert [r.month for r in reports] == ["2026-01", "2026-02"]
+
+
+def test_d1_empty_rows_returns_empty_list():  # D1: 空の rows は []
+    assert monthly_changes([]) == []
+
+
+def test_d2_gap_month_is_included_with_gone_and_new():  # D2: 行の無い月も含める
+    rows = [E(2026, 1, 10, "食費", 1000), E(2026, 3, 10, "食費", 500)]
+    _jan, feb, mar = monthly_changes(rows)
+    assert feb.month == "2026-02"
+    assert feb.totals == {}
+    gone = _by_cat(feb)["食費"]
+    assert (gone.previous, gone.current, gone.delta, gone.status, gone.rate) == (
+        1000,
+        0,
+        -1000,
+        "gone",
+        -1.0,
+    )
+    new = _by_cat(mar)["食費"]
+    assert (new.previous, new.current, new.delta, new.status, new.rate) == (
+        0,
+        500,
+        500,
+        "new",
+        None,
+    )
+
+
+def test_d3_first_month_has_no_changes():  # D3: 最初の月の changes は ()
+    rows = [E(2026, 1, 1, "食費", 1000), E(2026, 2, 1, "食費", 1500)]
+    jan, feb = monthly_changes(rows)
+    assert jan.changes == ()
+    assert len(feb.changes) == 1
+
+
+def test_d4_zero_amount_row_counts_as_present():  # D4: 合計 0 の行でも「ある」、前月 0 は rate None
+    rows = [E(2026, 1, 1, "食費", 0), E(2026, 2, 1, "食費", 300)]
+    _, feb = monthly_changes(rows)
+    c = _by_cat(feb)["食費"]
+    assert (c.previous, c.current, c.delta, c.status, c.rate) == (
+        0,
+        300,
+        300,
+        "up",
+        None,
+    )
+
+
+def test_d5_d6_up_down_same_and_rate():  # D5/D6: up/down/same の判定と rate = delta / previous
+    rows = [
+        E(2026, 1, 1, "食費", 1000),
+        E(2026, 1, 1, "住居", 1000),
+        E(2026, 1, 1, "光熱費", 1000),
+        E(2026, 2, 1, "食費", 1500),
+        E(2026, 2, 1, "住居", 750),
+        E(2026, 2, 1, "光熱費", 1000),
+    ]
+    _, feb = monthly_changes(rows)
+    cats = _by_cat(feb)
+    assert (cats["食費"].status, cats["食費"].rate) == ("up", 0.5)
+    assert (cats["住居"].status, cats["住居"].rate) == ("down", -0.25)
+    assert (cats["光熱費"].status, cats["光熱費"].delta, cats["光熱費"].rate) == (
+        "same",
+        0,
+        0.0,
+    )
+
+
+def test_d6_non_positive_previous_rate_is_none():  # D6: 前月合計が負なら rate None
+    rows = [E(2026, 1, 1, "食費", -300), E(2026, 2, 1, "食費", 100)]
+    _, feb = monthly_changes(rows)
+    c = _by_cat(feb)["食費"]
+    assert (c.previous, c.current, c.delta, c.status, c.rate) == (
+        -300,
+        100,
+        400,
+        "up",
+        None,
+    )
+
+
+def test_d7_sorted_by_abs_delta_then_category():  # D7: |delta| 降順、同点はカテゴリ名昇順
+    rows = [
+        E(2026, 1, 1, "A", 1000),
+        E(2026, 1, 1, "B", 500),
+        E(2026, 1, 1, "C", 200),
+        E(2026, 2, 1, "A", 1000),
+        E(2026, 2, 1, "D", 500),
+    ]
+    _, feb = monthly_changes(rows)
+    assert [c.category for c in feb.changes] == ["B", "D", "C", "A"]
+
+
+def test_d8_negative_amount_is_added():  # D8: 負の金額(返金)はそのまま足す
+    rows = [E(2026, 1, 1, "食費", 1000), E(2026, 1, 2, "食費", -300)]
+    (jan,) = monthly_changes(rows)
+    assert jan.totals == {"食費": 700}
+
+
+def test_d9_same_category_rows_summed_and_not_normalized():  # D9: 同カテゴリは合計、名前は正規化しない
+    rows = [
+        E(2026, 1, 1, "食費", 100),
+        E(2026, 1, 2, "食費", 200),
+        E(2026, 1, 3, "food ", 50),
+    ]
+    (jan,) = monthly_changes(rows)
+    assert jan.totals == {"食費": 300, "food ": 50}
+
+
+@pytest.mark.parametrize(
+    "rows, months",
+    [
+        (
+            [E(2024, 2, 29, "食費", 100), E(2024, 3, 31, "食費", 100)],
+            ["2024-02", "2024-03"],
+        ),
+        (
+            [E(2025, 12, 31, "食費", 1000), E(2026, 1, 31, "食費", 1500)],
+            ["2025-12", "2026-01"],
+        ),
+    ],
+)
+def test_d10_leap_and_year_boundary_consecutive(
+    rows, months
+):  # D10: 閏年・月末・年またぎは連続した月
+    reports = monthly_changes(rows)
+    assert [r.month for r in reports] == months
+    assert len(reports) == 2
+    assert _by_cat(reports[1])["食費"].status in ("up", "same", "down")
+
+
+def test_d10_year_boundary_rate():  # D10: 2025-12 → 2026-01 は間に空の月を入れない
+    rows = [E(2025, 12, 1, "食費", 1000), E(2026, 1, 1, "食費", 1500)]
+    reports = monthly_changes(rows)
+    assert [r.month for r in reports] == ["2025-12", "2026-01"]
+    c = _by_cat(reports[1])["食費"]
+    assert (c.status, c.rate) == ("up", 0.5)
+
+
+def test_d11_input_not_mutated_and_order_independent():  # D11: rows は変更せず、順序に依らない
+    rows = [
+        E(2026, 2, 1, "食費", 1500),
+        E(2026, 1, 1, "食費", 1000),
+        E(2026, 1, 2, "住居", 300),
+    ]
+    snapshot = list(rows)
+    forward = monthly_changes(rows)
+    assert rows == snapshot
+    assert monthly_changes(list(reversed(rows))) == forward
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        (E(2026, 1, 1, "食費", 100),),
+        None,
+        [{"day": date(2026, 1, 1), "category": "食費", "amount": 100}],
+        ["2026-01-01,食費,100"],
+    ],
+)
+def test_d12_non_list_or_non_expense_raises_type_error(
+    bad,
+):  # D12: tuple/None/非 Expense 要素で TypeError
+    with pytest.raises(TypeError):
+        monthly_changes(bad)
+
+
+def test_d13_totals_match_monthly_totals_with_empty_gap():  # D13: totals は monthly_totals と一致、空月は {}
+    rows = [
+        E(2026, 1, 1, "食費", 1000),
+        E(2026, 1, 2, "住居", 300),
+        E(2026, 3, 1, "食費", 500),
+    ]
+    expected = monthly_totals(rows)
+    reports = monthly_changes(rows)
+    assert reports[0].totals == expected["2026-01"]
+    assert reports[1].totals == {}
+    assert reports[2].totals == expected["2026-03"]
