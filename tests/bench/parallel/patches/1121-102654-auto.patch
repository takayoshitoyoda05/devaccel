+++ b/tests/test_recurring.py
@@ -0,0 +1,197 @@
+from datetime import date, datetime
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring
+
+
+def E(ymd: str, cat: str, amount: int, memo: str = "") -> Expense:
+    return Expense(date.fromisoformat(ymd), cat, amount, memo)
+
+
+def monthly(cat: str, amount: int, memo: str, months: list[str], day: int = 5):
+    return [E(f"{m}-{day:02d}", cat, amount, memo) for m in months]
+
+
+def test_basic_monthly_and_next_date():
+    rows = monthly("サブスク", 1490, "Netflix", ["2026-01", "2026-02", "2026-03"])
+    assert find_recurring(rows) == [
+        Recurring("サブスク", "Netflix", 1490, 3, date(2026, 3, 5), date(2026, 4, 5))
+    ]
+
+
+def test_empty_input():
+    assert find_recurring([]) == []
+
+
+def test_too_few_months_not_recurring():
+    rows = monthly("家賃", 80000, "家賃", ["2026-01", "2026-02"])
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_months=2)) == 1
+
+
+def test_gap_resets_run():
+    rows = monthly("a", 500, "x", ["2026-01", "2026-02", "2026-04", "2026-05"])
+    assert find_recurring(rows) == []
+    rows += monthly("a", 500, "x", ["2026-06"])
+    (r,) = find_recurring(rows)
+    assert r.months == 3 and r.next_date == date(2026, 7, 5)
+
+
+def test_month_end_clamped_and_anchor_is_max_day():
+    rows = [
+        E("2026-01-31", "c", 100, "m"),
+        E("2026-02-28", "c", 100, "m"),
+        E("2026-03-31", "c", 100, "m"),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.next_date == date(2026, 4, 30)
+    rows = [
+        E("2023-12-30", "c", 100),
+        E("2024-01-31", "c", 100),
+        E("2024-02-29", "c", 100),
+        E("2023-11-30", "c", 100),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.next_date == date(2024, 3, 31)
+
+
+def test_leap_february():
+    rows = [E("2023-12-30", "c", 1), E("2024-01-30", "c", 1), E("2024-02-29", "c", 1)]
+    (r,) = find_recurring(rows)
+    assert r.next_date == date(2024, 3, 30)
+    rows = [
+        E("2024-10-31", "c", 1),
+        E("2024-11-30", "c", 1),
+        E("2024-12-31", "c", 1),
+        E("2025-01-31", "c", 1),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.next_date == date(2025, 2, 28)
+
+
+def test_december_to_january():
+    rows = monthly("c", 100, "m", ["2025-10", "2025-11", "2025-12"])
+    (r,) = find_recurring(rows)
+    assert r.next_date == date(2026, 1, 5)
+
+
+def test_memo_normalization():
+    rows = [
+        E("2026-01-05", "c", 100, "ＮＥＴＦＬＩＸ  #1"),
+        E("2026-02-05", "c", 100, "netflix 2"),
+        E("2026-03-05", "c", 100, "Netflix"),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.months == 3 and r.memo == "Netflix"
+
+
+def test_same_category_different_memo_are_separate():
+    rows = monthly("サブスク", 1000, "A", ["2026-01", "2026-02", "2026-03"]) + monthly(
+        "サブスク", 1000, "B", ["2026-01", "2026-02", "2026-03"], day=20
+    )
+    res = find_recurring(rows)
+    assert [(r.memo, r.next_date) for r in res] == [
+        ("A", date(2026, 4, 5)),
+        ("B", date(2026, 4, 20)),
+    ]
+
+
+def test_same_memo_same_month_split_by_amount():
+    months = ["2026-01", "2026-02", "2026-03"]
+    rows = monthly("c", 1000, "", months) + monthly("c", 5000, "", months, day=20)
+    res = find_recurring(rows)
+    assert sorted(r.amount for r in res) == [1000, 5000]
+
+
+def test_two_in_same_month_similar_amount_become_two_series():
+    months = ["2026-01", "2026-02", "2026-03"]
+    rows = monthly("c", 1000, "m", months) + monthly("c", 1050, "m", months, day=20)
+    assert len(find_recurring(rows)) == 2
+
+
+def test_price_increase_within_tolerance_same_series():
+    rows = [
+        E("2026-01-05", "c", 1000, "m"),
+        E("2026-02-05", "c", 1000, "m"),
+        E("2026-03-05", "c", 1080, "m"),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.amount == 1080 and r.months == 3
+
+
+def test_big_change_breaks_series():
+    rows = [
+        E("2026-01-05", "c", 1000, "m"),
+        E("2026-02-05", "c", 1000, "m"),
+        E("2026-03-05", "c", 3000, "m"),
+    ]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, amount_tolerance=0.0)) == 0
+
+
+def test_refund_and_zero_ignored():
+    rows = monthly("c", 100, "m", ["2026-01", "2026-02", "2026-03"]) + [
+        E("2026-04-05", "c", -100, "m"),
+        E("2026-04-06", "c", 0, "m"),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.last_date == date(2026, 3, 5)
+
+
+def test_as_of_drops_lapsed_inclusive():
+    rows = monthly("c", 100, "m", ["2026-01", "2026-02", "2026-03"])
+    assert find_recurring(rows, as_of=date(2026, 4, 5)) != []
+    assert find_recurring(rows, as_of=date(2026, 4, 6)) == []
+    assert find_recurring(rows, as_of=None) != []
+
+
+def test_sort_by_next_date_then_category():
+    months = ["2026-01", "2026-02", "2026-03"]
+    rows = (
+        monthly("b", 1, "x", months, day=10)
+        + monthly("z", 1, "x", months, day=3)
+        + monthly("a", 1, "x", months, day=10)
+    )
+    assert [r.category for r in find_recurring(rows)] == ["z", "a", "b"]
+
+
+def test_accepts_iterable_and_unsorted():
+    rows = monthly("c", 100, "m", ["2026-03", "2026-01", "2026-02"])
+    assert len(find_recurring(iter(rows))) == 1
+
+
+@pytest.mark.parametrize("bad", [True, 3.0, "3", None])
+def test_min_months_type(bad):
+    with pytest.raises(TypeError, match="min_months"):
+        find_recurring([], min_months=bad)
+
+
+@pytest.mark.parametrize("bad", [1, 0, -1])
+def test_min_months_range(bad):
+    with pytest.raises(ValueError, match="min_months"):
+        find_recurring([], min_months=bad)
+
+
+@pytest.mark.parametrize("bad", [True, "0.1", None])
+def test_tolerance_type(bad):
+    with pytest.raises(TypeError, match="amount_tolerance"):
+        find_recurring([], amount_tolerance=bad)
+
+
+@pytest.mark.parametrize("bad", [-0.1, 1, 1.5, float("nan")])
+def test_tolerance_range(bad):
+    with pytest.raises(ValueError, match="amount_tolerance"):
+        find_recurring([], amount_tolerance=bad)
+
+
+@pytest.mark.parametrize("bad", ["2026-01-01", datetime(2026, 1, 1)])
+def test_as_of_type(bad):
+    with pytest.raises(TypeError, match="as_of"):
+        find_recurring([], as_of=bad)
+
+
+def test_row_type():
+    with pytest.raises(TypeError, match="Expense"):
+        find_recurring([("2026-01-01", "c", 1)])  # type: ignore[list-item]
