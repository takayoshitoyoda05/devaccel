@@ -0,0 +1,147 @@
+"""毎月決まって出ていく支出(サブスク・家賃など)の検出と、次回予定日の推定。
+
+純粋な関数のみ。入力は core.Expense(新しい型は作らない)。
+
+判断(D):
+D1: 同一の系列 = 同じカテゴリ + 正規化したメモ。正規化は NFKC・大文字小文字無視・
+    空白の畳み込み・末尾の番号(`#12` `3`)の除去。メモが空ならカテゴリだけで束ねる。
+D2: 金額が 0 以下(返金・0 円)の明細は系列に混ぜず無視する。
+D3: 同じ系列でも金額が前回から `amount_tolerance`(既定 10%)以内なら同じ系列
+    (値上げ・端数の揺れを許す)。超えるものは別系列(5 日と 20 日の別サブスクを分離)。
+D4: 同じ月に 2 回あるものは同一系列に入れず、別系列に振り分ける。
+D5: 繰り返しとみなす条件 = 末尾から連続した月が `min_months`(既定 3、下限 2)以上。
+    途中で月が欠けたら、欠けた後の連続部分だけを数える。
+D6: 基準日 = 末尾の連続部分の日の最大値。次回 = 最後の月の翌月のその日。
+    翌月に存在しない日は月末に丸める(31 日 → 2/28 または閏年 2/29)。12 月の次は翌年 1 月。
+D7: `as_of` を渡すと、次回予定日が `as_of` より前のもの(解約済みとみなす)を除く。
+    当日は含める。None なら除かない。
+D8: 引数の検査: `min_months` は bool 不可の int で 2 以上、`amount_tolerance` は
+    bool 不可・nan 不可の 0 以上 1 未満の数、`as_of` は date(datetime 不可)か None、
+    rows の要素は Expense。違反は TypeError(型)/ ValueError(範囲)。
+D9: 金額は円の整数のまま扱う。系列の金額・メモは最新の明細のもの。
+D10: 並びは次回予定日 → カテゴリ → メモ の昇順(安定)。空入力は空リスト。
+"""
+
+from __future__ import annotations
+
+import calendar
+import math
+import re
+import unicodedata
+from collections.abc import Iterable
+from dataclasses import dataclass
+from datetime import date
+
+from .core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str  # 最新の明細のメモ(元の表記)
+    amount: int  # 最新の金額(円)
+    months: int  # 末尾の連続した月の数
+    last_date: date
+    next_date: date
+
+
+_TRAILING_NO = re.compile(r"[\s#]*[0-9]+$")
+
+
+def _normalize_memo(memo: str) -> str:
+    s = unicodedata.normalize("NFKC", memo).casefold()
+    s = " ".join(s.split())
+    s = _TRAILING_NO.sub("", s)
+    return s.strip()
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month - 1
+
+
+def _next_month_date(last: date, day: int) -> date:
+    idx = _month_index(last) + 1
+    year, month = divmod(idx, 12)
+    month += 1
+    return date(year, month, min(day, calendar.monthrange(year, month)[1]))
+
+
+def _validate(
+    min_months: object, amount_tolerance: object, as_of: object
+) -> tuple[int, float, date | None]:
+    if isinstance(min_months, bool) or not isinstance(min_months, int):
+        raise TypeError("min_months は int である必要があります")
+    if min_months < 2:
+        raise ValueError("min_months は 2 以上である必要があります")
+    if isinstance(amount_tolerance, bool) or not isinstance(
+        amount_tolerance, (int, float)
+    ):
+        raise TypeError("amount_tolerance は数値である必要があります")
+    if math.isnan(amount_tolerance) or not 0 <= amount_tolerance < 1:
+        raise ValueError("amount_tolerance は 0 以上 1 未満である必要があります")
+    if as_of is not None and (not isinstance(as_of, date) or hasattr(as_of, "hour")):
+        raise TypeError("as_of は date か None である必要があります")
+    return min_months, float(amount_tolerance), as_of
+
+
+def find_recurring(
+    rows: Iterable[Expense],
+    *,
+    min_months: int = 3,
+    amount_tolerance: float = 0.1,
+    as_of: date | None = None,
+) -> list[Recurring]:
+    """毎月繰り返す支出を見つけ、次回予定日つきで返す(D1〜D10)。"""
+    min_months, tol, as_of = _validate(min_months, amount_tolerance, as_of)
+    items = list(rows)
+    for e in items:
+        if not isinstance(e, Expense):
+            raise TypeError("rows の要素は Expense である必要があります")
+
+    # D1/D2: カテゴリ+メモで束ねる(返金・0 円は除く)
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in sorted(items, key=lambda x: x.day):
+        if e.amount <= 0:
+            continue
+        groups.setdefault((e.category, _normalize_memo(e.memo)), []).append(e)
+
+    found: list[Recurring] = []
+    for entries in groups.values():
+        # D3/D4: 金額の近さと月の重複で系列に振り分ける
+        series: list[list[Expense]] = []
+        for e in entries:
+            for s in series:
+                last = s[-1]
+                if _month_index(e.day) != _month_index(last.day) and (
+                    abs(e.amount - last.amount) <= tol * last.amount
+                ):
+                    s.append(e)
+                    break
+            else:
+                series.append([e])
+        for s in series:
+            # D5: 末尾から連続した月だけを数える
+            run = [s[-1]]
+            for e in reversed(s[:-1]):
+                if _month_index(run[0].day) - _month_index(e.day) == 1:
+                    run.insert(0, e)
+                else:
+                    break
+            if len(run) < min_months:
+                continue
+            latest = run[-1]
+            nxt = _next_month_date(latest.day, max(x.day.day for x in run))
+            if as_of is not None and nxt < as_of:  # D7
+                continue
+            found.append(
+                Recurring(
+                    category=latest.category,
+                    memo=latest.memo,
+                    amount=latest.amount,
+                    months=len(run),
+                    last_date=latest.day,
+                    next_date=nxt,
+                )
+            )
+    found.sort(key=lambda r: (r.next_date, r.category, r.memo))
+    return found
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
