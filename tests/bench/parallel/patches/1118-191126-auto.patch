diff --git a/src/kakeibo/bankimport.py b/src/kakeibo/bankimport.py
new file mode 100644
index 0000000..cbc3d0b
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,111 @@
+"""Import rows from other banks' CSV exports into Expense records."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"(-?)[¥￥]?([0-9][0-9,]*)円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    sign, digits = m.group(1), m.group(2).replace(",", "")
+    return int(sign + digits)
+
+
+def parse_date(s: str) -> date:
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    year, month, day = int(m.group(1)), int(m.group(3)), int(m.group(4))
+    return date(year, month, day)  # raises ValueError for nonexistent dates
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+
+    # (physical line number, cells) for every CSV record; line numbers start at 1.
+    reader = csv.reader(io.StringIO(text, newline=""))
+    records: list[tuple[int, list[str]]] = []
+    prev_end = 0
+    for row in reader:
+        records.append((prev_end + 1, row))
+        prev_end = reader.line_num
+    if not records:
+        raise ValueError("ヘッダー行がありません")
+
+    _, header = records[0]
+    index: dict[str, int] = {}
+    for field, col in mapping.items():
+        if col not in header:
+            raise ValueError(f"列 {col} がヘッダーにありません")
+        index[field] = header.index(col)
+
+    def cell(row: list[str], field: str) -> str:
+        if field not in index:
+            return ""
+        i = index[field]
+        return row[i] if i < len(row) else ""
+
+    rows: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    for line_no, row in records[1:]:
+        if row == [] or (len(row) == 1 and row[0].strip() == ""):
+            continue  # blank line: skipped, but its line number was counted
+        row_errors: list[tuple[int, str]] = []
+
+        day: date | None = None
+        try:
+            day = parse_date(cell(row, "date"))
+        except ValueError:
+            row_errors.append((line_no, "date"))
+
+        amount: int | None = None
+        try:
+            amount = parse_amount(cell(row, "amount"))
+        except ValueError:
+            row_errors.append((line_no, "amount"))
+
+        category = cell(row, "category").strip()
+        if category == "":
+            row_errors.append((line_no, "category"))
+
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+
+        assert day is not None and amount is not None
+        if category_map is not None and category in category_map:
+            category = category_map[category]
+        rows.append(
+            Expense(
+                day=day,
+                category=category,
+                amount=amount,
+                memo=cell(row, "memo").strip(),
+            )
+        )
+    return rows, errors
diff --git a/src/kakeibo/dupes.py b/src/kakeibo/dupes.py
