@@ -0,0 +1,70 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.stats import median_by_category
+
+
+def _e(category: str, amount: int) -> Expense:
+    return Expense(day=date(2026, 11, 1), category=category, amount=amount)
+
+
+def test_empty_rows_returns_empty_dict():
+    assert median_by_category([]) == {}
+
+
+def test_single_row_is_its_own_median():
+    assert median_by_category([_e("food", 500)]) == {"food": 500.0}
+
+
+def test_odd_count_takes_middle_value():
+    rows = [_e("food", 300), _e("food", 100), _e("food", 200)]
+    assert median_by_category(rows) == {"food": 200.0}
+
+
+def test_even_count_averages_middle_two():
+    rows = [_e("food", 100), _e("food", 300)]
+    assert median_by_category(rows) == {"food": 200.0}
+
+
+def test_even_count_with_four_values_averages_middle_two():
+    rows = [_e("food", 10), _e("food", 40), _e("food", 20), _e("food", 30)]
+    assert median_by_category(rows) == {"food": 25.0}
+
+
+def test_all_same_values():
+    rows = [_e("food", 700), _e("food", 700), _e("food", 700)]
+    assert median_by_category(rows) == {"food": 700.0}
+
+
+def test_median_is_computed_per_category_not_globally():
+    rows = [
+        _e("food", 100),
+        _e("food", 200),
+        _e("food", 300),
+        _e("rent", 90000),
+    ]
+    assert median_by_category(rows) == {"food": 200.0, "rent": 90000.0}
+
+
+def test_keys_are_sorted_by_category_name_ascending():
+    rows = [_e("transport", 1), _e("food", 2), _e("rent", 3), _e("entertainment", 4)]
+    result = median_by_category(rows)
+    assert list(result) == ["entertainment", "food", "rent", "transport"]
+
+
+def test_input_order_does_not_change_result():
+    forward = [_e("food", 100), _e("food", 300), _e("food", 200), _e("food", 400)]
+    backward = list(reversed(forward))
+    assert median_by_category(forward) == median_by_category(backward)
+
+
+def test_values_are_float_even_for_integer_median():
+    result = median_by_category([_e("food", 100), _e("food", 100)])
+    assert isinstance(result["food"], float)
+
+
+def test_input_rows_are_not_modified():
+    rows = [_e("food", 300), _e("food", 100)]
+    before = list(rows)
+    median_by_category(rows)
+    assert rows == before
diff --git a/tests/test_streak.py b/tests/test_streak.py
new file mode 100644
