@@ -0,0 +1,42 @@
+import pytest
+
+from kakeibo.split import split_evenly
+
+
+def test_exact_division_gives_equal_shares() -> None:
+    assert split_evenly(900, 3) == [300, 300, 300]
+
+
+def test_remainder_goes_one_yen_each_to_first_people() -> None:
+    assert split_evenly(100, 3) == [34, 33, 33]
+    assert split_evenly(10, 4) == [3, 3, 2, 2]
+
+
+def test_single_person_gets_whole_amount() -> None:
+    assert split_evenly(1234, 1) == [1234]
+
+
+def test_zero_amount_gives_all_zeros() -> None:
+    assert split_evenly(0, 3) == [0, 0, 0]
+
+
+def test_amount_less_than_people_gives_zeros_at_the_end() -> None:
+    assert split_evenly(2, 5) == [1, 1, 0, 0, 0]
+
+
+def test_result_length_equals_people() -> None:
+    assert len(split_evenly(100, 7)) == 7
+
+
+@pytest.mark.parametrize("amount", [0, 1, 99, 100, 101, 12345])
+@pytest.mark.parametrize("people", [1, 2, 3, 7])
+def test_sum_always_equals_amount(amount: int, people: int) -> None:
+    shares = split_evenly(amount, people)
+    assert sum(shares) == amount
+    assert max(shares) - min(shares) <= 1
+
+
+@pytest.mark.parametrize("people", [0, -1])
+def test_people_less_than_one_raises_value_error(people: int) -> None:
+    with pytest.raises(ValueError):
+        split_evenly(100, people)
