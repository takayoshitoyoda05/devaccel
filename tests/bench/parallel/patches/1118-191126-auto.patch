+++ b/tests/test_streak.py
@@ -0,0 +1,80 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.streak import longest_no_spend_streak
+
+
+def _e(day: date, amount: int = 100) -> Expense:
+    return Expense(day=day, category="food", amount=amount)
+
+
+def test_no_rows_gives_whole_period_length():
+    assert longest_no_spend_streak([], date(2026, 11, 1), date(2026, 11, 7)) == 7
+
+
+def test_every_day_has_a_row_gives_zero():
+    rows = [_e(date(2026, 11, d)) for d in range(1, 4)]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 3)) == 0
+
+
+def test_single_day_period_without_rows_is_one():
+    assert longest_no_spend_streak([], date(2026, 11, 5), date(2026, 11, 5)) == 1
+
+
+def test_single_day_period_with_row_is_zero():
+    rows = [_e(date(2026, 11, 5))]
+    assert longest_no_spend_streak(rows, date(2026, 11, 5), date(2026, 11, 5)) == 0
+
+
+def test_longest_run_in_the_middle_is_found():
+    # 11/1 spent, 11/2-11/4 free (3 days), 11/5 spent, 11/6 free (1 day)
+    rows = [_e(date(2026, 11, 1)), _e(date(2026, 11, 5))]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 6)) == 3
+
+
+def test_run_at_end_of_period_counts():
+    rows = [_e(date(2026, 11, 1))]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 4)) == 3
+
+
+def test_spend_on_start_and_end_days_are_both_boundaries():
+    rows = [_e(date(2026, 11, 1)), _e(date(2026, 11, 4))]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 4)) == 2
+
+
+def test_multiple_expenses_on_same_day_count_as_one_spent_day():
+    rows = [
+        _e(date(2026, 11, 2), 100),
+        _e(date(2026, 11, 2), 200),
+        _e(date(2026, 11, 2), 300),
+    ]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 3)) == 1
+
+
+def test_zero_amount_row_still_counts_as_spending():
+    # 明細が 1 件でもあれば使った日扱い(金額 0 でも)
+    rows = [_e(date(2026, 11, 2), 0)]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 3)) == 1
+
+
+def test_rows_outside_period_are_ignored():
+    rows = [
+        _e(date(2026, 10, 31)),  # before start: must not break the streak
+        _e(date(2026, 11, 8)),  # after end: must not break the streak
+    ]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 7)) == 7
+
+
+def test_row_order_does_not_matter():
+    rows = [_e(date(2026, 11, 5)), _e(date(2026, 11, 2)), _e(date(2026, 11, 9))]
+    # free days 11/1, 11/3-11/4, 11/6-11/8, 11/10 -> longest is 3
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 10)) == 3
+
+
+def test_run_crosses_month_boundary():
+    rows = [_e(date(2026, 10, 30))]
+    assert longest_no_spend_streak(rows, date(2026, 10, 31), date(2026, 11, 3)) == 4
+
+
+def test_start_after_end_gives_zero():
+    assert longest_no_spend_streak([], date(2026, 11, 5), date(2026, 11, 1)) == 0
diff --git a/tests/test_topn.py b/tests/test_topn.py
new file mode 100644
index 0000000..3e759cf
--- /dev/null
+++ b/tests/test_topn.py
@@ -0,0 +1,70 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.topn import top_expenses
+
+
+def _e(day: str, amount: int, category: str = "food", memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+def test_returns_n_largest_by_amount_desc():
+    rows = [_e("2026-11-01", 1200), _e("2026-11-02", 80000), _e("2026-11-03", 500)]
+    assert top_expenses(rows, 2) == [rows[1], rows[0]]
+
+
+def test_amount_compared_numerically_not_lexically():
+    rows = [_e("2026-11-01", 9000), _e("2026-11-02", 10000)]
+    assert top_expenses(rows, 1) == [rows[1]]
+
+
+def test_equal_amount_sorted_by_earlier_date_first():
+    late = _e("2026-11-05", 700, memo="late")
+    early = _e("2026-11-01", 700, memo="early")
+    assert top_expenses([late, early], 2) == [early, late]
+
+
+def test_equal_amount_and_date_keeps_input_order():
+    first = _e("2026-11-01", 700, memo="first")
+    second = _e("2026-11-01", 700, memo="second")
+    assert top_expenses([first, second], 2) == [first, second]
+    assert top_expenses([second, first], 2) == [second, first]
+
+
+def test_date_is_only_a_tiebreak_not_primary_key():
+    big_late = _e("2026-11-30", 5000)
+    small_early = _e("2026-11-01", 100)
+    assert top_expenses([small_early, big_late], 1) == [big_late]
+
+
+def test_n_zero_returns_empty():
+    rows = [_e("2026-11-01", 100)]
+    assert top_expenses(rows, 0) == []
+
+
+def test_negative_n_returns_empty():
+    rows = [_e("2026-11-01", 100)]
+    assert top_expenses(rows, -3) == []
+
+
+def test_n_larger_than_rows_returns_all_sorted():
+    rows = [_e("2026-11-01", 100), _e("2026-11-02", 300), _e("2026-11-03", 200)]
+    assert top_expenses(rows, 10) == [rows[1], rows[2], rows[0]]
+
+
+def test_n_equal_to_rows_returns_all_sorted():
+    rows = [_e("2026-11-01", 100), _e("2026-11-02", 300)]
+    assert top_expenses(rows, 2) == [rows[1], rows[0]]
+
+
+def test_empty_input_returns_empty():
+    assert top_expenses([], 3) == []
+
+
+def test_input_list_not_mutated():
+    rows = [_e("2026-11-01", 100), _e("2026-11-02", 300)]
+    snapshot = list(rows)
+    top_expenses(rows, 2)
+    assert rows == snapshot
diff --git a/tests/test_weekday.py b/tests/test_weekday.py
new file mode 100644
index 0000000..1b36c31
--- /dev/null
+++ b/tests/test_weekday.py
@@ -0,0 +1,52 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.weekday import total_by_weekday
+
+# 2026-11-16 is a Monday.
+MON = date(2026, 11, 16)
+
+
+def _e(day: date, amount: int) -> Expense:
+    return Expense(day=day, category="food", amount=amount)
+
+
+def test_empty_returns_empty_dict():
+    assert total_by_weekday([]) == {}
+
+
+def test_single_expense():
+    assert total_by_weekday([_e(MON, 1200)]) == {"Mon": 1200}
+
+
+def test_same_weekday_in_different_weeks_is_summed():
+    rows = [_e(MON, 1000), _e(date(2026, 11, 23), 2500)]
+    assert total_by_weekday(rows) == {"Mon": 3500}
+
+
+def test_absent_weekdays_are_omitted():
+    rows = [_e(date(2026, 11, 22), 300), _e(MON, 100)]  # Sun and Mon only
+    assert total_by_weekday(rows) == {"Mon": 100, "Sun": 300}
+
+
+def test_keys_are_monday_first_regardless_of_input_order():
+    rows = [
+        _e(date(2026, 11, 22), 7),  # Sun
+        _e(date(2026, 11, 18), 4),  # Wed
+        _e(MON, 1),  # Mon
+        _e(date(2026, 11, 20), 5),  # Fri
+    ]
+    result = total_by_weekday(rows)
+    assert list(result) == ["Mon", "Wed", "Fri", "Sun"]
+    assert result == {"Mon": 1, "Wed": 4, "Fri": 5, "Sun": 7}
+
+
+def test_all_seven_weekdays():
+    rows = [_e(date(2026, 11, 16 + i), (i + 1) * 10) for i in range(7)]
+    result = total_by_weekday(rows)
+    assert list(result) == ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
+    assert list(result.values()) == [10, 20, 30, 40, 50, 60, 70]
+
+
+def test_zero_amount_expense_still_counts_its_weekday():
+    assert total_by_weekday([_e(MON, 0)]) == {"Mon": 0}
