new file mode 100644
index 0000000..e69fd3d
--- /dev/null
+++ b/src/kakeibo/streak.py
@@ -0,0 +1,29 @@
+"""Longest run of days without any expense."""
+
+from __future__ import annotations
+
+from datetime import date, timedelta
+
+from kakeibo.core import Expense
+
+
+def longest_no_spend_streak(rows: list[Expense], start: date, end: date) -> int:
+    """Longest run of consecutive days in [start, end] with no expense row.
+
+    Both ends are inclusive. Rows outside the period are ignored. Multiple rows
+    on the same day count as one spending day. If start is after end, returns 0.
+    """
+    if start > end:
+        return 0
+    spent = {e.day for e in rows if start <= e.day <= end}
+    best = 0
+    run = 0
+    day = start
+    while day <= end:
+        if day in spent:
+            run = 0
+        else:
+            run += 1
+            best = max(best, run)
+        day += timedelta(days=1)
+    return best
diff --git a/src/kakeibo/topn.py b/src/kakeibo/topn.py
new file mode 100644
index 0000000..f05537e
--- /dev/null
+++ b/src/kakeibo/topn.py
@@ -0,0 +1,18 @@
+"""Top-N expenses by amount."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def top_expenses(rows: list[Expense], n: int) -> list[Expense]:
+    """Return up to n expenses, largest amount first.
+
+    Ties on amount go to the earlier date; ties on both keep input order.
+    Returns [] when n <= 0. The input list is not modified.
+    """
+    if n <= 0:
+        return []
+    # sorted() is stable, so equal (amount, day) keys keep input order.
+    ordered = sorted(rows, key=lambda e: (-e.amount, e.day))
+    return ordered[:n]
