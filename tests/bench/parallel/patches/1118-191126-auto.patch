--- /dev/null
+++ b/src/kakeibo/split.py
@@ -0,0 +1,14 @@
+"""Split an amount in yen evenly among people."""
+
+from __future__ import annotations
+
+
+def split_evenly(amount: int, people: int) -> list[int]:
+    """Split ``amount`` yen among ``people``; the remainder goes 1 yen each to the first people.
+
+    The result always sums to ``amount``. Raises ``ValueError`` if ``people`` < 1.
+    """
+    if people < 1:
+        raise ValueError("people は 1 以上である必要があります")
+    base, remainder = divmod(amount, people)
+    return [base + 1 if i < remainder else base for i in range(people)]
diff --git a/src/kakeibo/stats.py b/src/kakeibo/stats.py
new file mode 100644
index 0000000..c1a56c3
--- /dev/null
+++ b/src/kakeibo/stats.py
@@ -0,0 +1,25 @@
+"""Per-category statistics over Expense records."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def median_by_category(rows: list[Expense]) -> dict[str, float]:
+    """{category: median amount}; keys ascending. Empty input gives {}.
+
+    For an even number of amounts, the median is the mean of the two middle values.
+    """
+    by_cat: dict[str, list[int]] = {}
+    for e in rows:
+        by_cat.setdefault(e.category, []).append(e.amount)
+    out: dict[str, float] = {}
+    for cat in sorted(by_cat):
+        vals = sorted(by_cat[cat])
+        n = len(vals)
+        mid = n // 2
+        if n % 2:
+            out[cat] = float(vals[mid])
+        else:
+            out[cat] = (vals[mid - 1] + vals[mid]) / 2
+    return out
