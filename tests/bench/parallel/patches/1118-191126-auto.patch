@@ -0,0 +1,16 @@
+"""Totals grouped by day of the week."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+WEEKDAYS = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
+
+
+def total_by_weekday(rows: list[Expense]) -> dict[str, int]:
+    """{"Mon".."Sun": yen}; only weekdays with at least one expense, Mon first."""
+    sums: dict[int, int] = {}
+    for e in rows:
+        idx = e.day.weekday()  # Monday == 0
+        sums[idx] = sums.get(idx, 0) + e.amount
+    return {WEEKDAYS[i]: sums[i] for i in range(7) if i in sums}
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..837c92f
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,231 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+# --- parse_amount -----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥1234", 1234),
+        ("￥1,2,3", 123),  # カンマの位置は検査しない
+        ("-980円", -980),
+        ("-0", 0),
+        ("1,,2", 12),
+    ],
+)
+def test_parse_amount_accepts(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "   ",
+        "円",
+        "¥",
+        "-",
+        "12.5",
+        "1 200",
+        "--5",
+        "¥-5",
+        "１２３",
+        ",123",
+        "123 円",
+        "円123",
+        "5円円",
+        "+5",
+        "¥¥5",
+    ],
+)
+def test_parse_amount_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+# --- parse_date -------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/12/31 ", date(2026, 12, 31)),
+        ("2026-1-5", date(2026, 1, 5)),
+        ("2024/02/29", date(2024, 2, 29)),
+    ],
+)
+def test_parse_date_accepts(text: str, expected: date) -> None:
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026/1-5",
+        "2026-1/5",
+        "26/1/5",
+        "2026/02/30",
+        "2025/02/29",
+        "2026/13/1",
+        "2026/1/0",
+        "2026/1/5/1",
+        "2026/1",
+        "",
+        "２０２６/1/5",
+        "2026.1.5",
+        "20260105",
+        "2026/123/1",
+    ],
+)
+def test_parse_date_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+# --- import_rows ------------------------------------------------------------
+
+
+def test_default_mapping_values() -> None:
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_import_rows_basic_with_default_mapping() -> None:
+    text = '利用日,分類,利用金額,利用店名\n2026/1/5,食費,"￥1,200",スーパー\n'
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 1200, "スーパー")]
+    assert errors == []
+
+
+def test_quoted_comma_in_memo_and_extra_columns_ignored() -> None:
+    text = (
+        'x,利用日,分類,利用金額,利用店名,余分\n1,2026-01-05,食費,"980円","A, B",zzz\n'
+    )
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 980, "A, B")]
+    assert errors == []
+
+
+def test_custom_mapping_and_memo_optional() -> None:
+    text = "d,c,a\n2026/2/1,  交通  ,-300\n"
+    mapping = {"date": "d", "category": "c", "amount": "a"}
+    rows, errors = import_rows(text, mapping)
+    assert rows == [Expense(date(2026, 2, 1), "交通", -300, "")]
+    assert errors == []
+
+
+def test_mapping_missing_required_key_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows("d,c\n2026/1/1,x\n", {"date": "d", "category": "c"})
+
+
+def test_mapping_column_absent_from_header_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows(
+            "d,c,a\n2026/1/1,x,1\n", {"date": "d", "category": "c", "amount": "zz"}
+        )
+
+
+def test_mapping_memo_column_absent_from_header_raises() -> None:
+    mapping = {"date": "d", "category": "c", "amount": "a", "memo": "m"}
+    with pytest.raises(ValueError):
+        import_rows("d,c,a\n2026/1/1,x,1\n", mapping)
+
+
+def test_default_mapping_none_uses_default() -> None:
+    text = "利用日,分類,利用金額,利用店名\n2026/1/5,食費,100,x\n"
+    assert import_rows(text, None)[0] == import_rows(text, DEFAULT_MAPPING)[0]
+
+
+def test_blank_lines_skipped_but_counted_in_line_numbers() -> None:
+    text = "d,c,a\n\n2026/1/1,食費,1\n\n2026/x/1,食費,2\n"
+    rows, errors = import_rows(text, {"date": "d", "category": "c", "amount": "a"})
+    assert rows == [Expense(date(2026, 1, 1), "食費", 1, "")]
+    assert errors == [(5, "date")]
+
+
+def test_multiple_errors_in_one_row_recorded_in_order_and_row_dropped() -> None:
+    text = "d,c,a\n2026/13/1,  ,abc\n"
+    rows, errors = import_rows(text, {"date": "d", "category": "c", "amount": "a"})
+    assert rows == []
+    assert errors == [(2, "date"), (2, "amount"), (2, "category")]
+
+
+def test_category_error_only_when_blank_after_strip() -> None:
+    text = "d,c,a\n2026/1/1,   ,5\n"
+    rows, errors = import_rows(text, {"date": "d", "category": "c", "amount": "a"})
+    assert rows == []
+    assert errors == [(2, "category")]
+
+
+def test_short_row_missing_values_treated_as_empty() -> None:
+    text = "d,c,a,m\n2026/1/1,食費\n"
+    rows, errors = import_rows(
+        text, {"date": "d", "category": "c", "amount": "a", "memo": "m"}
+    )
+    assert rows == []
+    assert errors == [(2, "amount")]
+
+
+def test_short_row_memo_missing_becomes_empty_string() -> None:
+    text = "d,c,a,m\n2026/1/1,食費,7\n"
+    rows, errors = import_rows(
+        text, {"date": "d", "category": "c", "amount": "a", "memo": "m"}
+    )
+    assert rows == [Expense(date(2026, 1, 1), "食費", 7, "")]
+    assert errors == []
+
+
+def test_order_of_valid_rows_preserved_and_errors_separate() -> None:
+    text = "利用日,分類,利用金額,利用店名\n2026/1/2,b,2,x\nbad,b,1,x\n2026/1/1,a,1,y\n"
+    rows, errors = import_rows(text)
+    assert rows == [
+        Expense(date(2026, 1, 2), "b", 2, "x"),
+        Expense(date(2026, 1, 1), "a", 1, "y"),
+    ]
+    assert errors == [(3, "date")]
+
+
+def test_category_map_replaces_stripped_category() -> None:
+    text = "d,c,a\n2026/1/1, コンビニ ,3\n2026/1/2,食費,4\n"
+    mapping = {"date": "d", "category": "c", "amount": "a"}
+    rows, errors = import_rows(text, mapping, {"コンビニ": "食費"})
+    assert rows == [
+        Expense(date(2026, 1, 1), "食費", 3, ""),
+        Expense(date(2026, 1, 2), "食費", 4, ""),
+    ]
+    assert errors == []
+
+
+def test_memo_is_stripped() -> None:
+    text = "d,c,a,m\n2026/1/1,食費,1,  店  \n"
+    rows, _ = import_rows(
+        text, {"date": "d", "category": "c", "amount": "a", "memo": "m"}
+    )
+    assert rows[0].memo == "店"
+
+
+def test_multiline_quoted_value_line_numbers_use_physical_lines() -> None:
+    text = 'd,c,a,m\n2026/1/1,食費,1,"a\nb"\n2026/x/1,食費,2,z\n'
+    rows, errors = import_rows(
+        text, {"date": "d", "category": "c", "amount": "a", "memo": "m"}
+    )
+    assert rows == [Expense(date(2026, 1, 1), "食費", 1, "a\nb")]
+    assert errors == [(4, "date")]
diff --git a/tests/test_dupes.py b/tests/test_dupes.py
new file mode 100644
index 0000000..d9d8e74
--- /dev/null
+++ b/tests/test_dupes.py
@@ -0,0 +1,58 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.dupes import find_duplicates
+
+A = Expense(date(2026, 11, 1), "food", 1200, "lunch")
+B = Expense(date(2026, 11, 2), "rent", 80000, "")
+
+
+def test_empty_list_has_no_duplicates():
+    assert find_duplicates([]) == []
+
+
+def test_single_row_has_no_duplicates():
+    assert find_duplicates([A]) == []
+
+
+def test_distinct_rows_have_no_duplicates():
+    assert find_duplicates([A, B]) == []
+
+
+def test_identical_pair_is_reported():
+    assert find_duplicates([A, A]) == [(0, 1)]
+
+
+def test_three_identical_rows_report_all_pairs_in_order():
+    assert find_duplicates([A, A, A]) == [(0, 1), (0, 2), (1, 2)]
+
+
+def test_non_adjacent_duplicates_are_found():
+    assert find_duplicates([A, B, A]) == [(0, 2)]
+
+
+def test_pairs_sorted_by_i_then_j():
+    rows = [B, A, B, A]
+    assert find_duplicates(rows) == [(0, 2), (1, 3)]
+
+
+def test_equal_value_objects_are_duplicates():
+    # Expense は値で比較される(同じ 4 項目なら別オブジェクトでも重複)
+    assert find_duplicates([Expense(date(2026, 11, 1), "food", 1200, "lunch"), A]) == [
+        (0, 1)
+    ]
+
+
+@pytest.mark.parametrize(
+    "other",
+    [
+        Expense(date(2026, 11, 2), "food", 1200, "lunch"),  # day differs
+        Expense(date(2026, 11, 1), "book", 1200, "lunch"),  # category differs
+        Expense(date(2026, 11, 1), "food", 1300, "lunch"),  # amount differs
+        Expense(date(2026, 11, 1), "food", 1200, ""),  # memo differs
+    ],
+)
+def test_differing_in_any_one_field_is_not_duplicate(other):
+    assert find_duplicates([A, other]) == []
