@@ -0,0 +1,68 @@
+import json
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.export import to_json
+
+
+def test_empty_list_gives_empty_array():
+    assert to_json([]) == "[]"
+
+
+def test_single_row_exact_output():
+    rows = [Expense(date(2026, 11, 1), "food", 1200, "lunch")]
+    assert to_json(rows) == (
+        '[{"date": "2026-11-01", "category": "food", "amount": 1200, "memo": "lunch"}]'
+    )
+
+
+def test_input_order_is_preserved_not_sorted():
+    rows = [
+        Expense(date(2026, 11, 9), "b", 2, ""),
+        Expense(date(2026, 11, 1), "a", 1, ""),
+    ]
+    dates = [item["date"] for item in json.loads(to_json(rows))]
+    assert dates == ["2026-11-09", "2026-11-01"]
+
+
+def test_key_order_is_date_category_amount_memo():
+    out = to_json([Expense(date(2026, 1, 5), "food", 100, "x")])
+    positions = [out.index(f'"{k}"') for k in ("date", "category", "amount", "memo")]
+    assert positions == sorted(positions)
+
+
+def test_non_ascii_is_not_escaped():
+    out = to_json([Expense(date(2026, 11, 1), "食費", 500, "ランチ")])
+    assert "食費" in out
+    assert "ランチ" in out
+    assert "\\u" not in out
+
+
+def test_output_has_no_indentation_or_newlines():
+    rows = [
+        Expense(date(2026, 11, 1), "food", 1, "a"),
+        Expense(date(2026, 11, 2), "food", 2, "b"),
+    ]
+    assert "\n" not in to_json(rows)
+
+
+def test_date_is_zero_padded_iso():
+    out = json.loads(to_json([Expense(date(2026, 1, 5), "food", 1)]))
+    assert out[0]["date"] == "2026-01-05"
+
+
+def test_amount_is_json_number_not_string():
+    out = json.loads(to_json([Expense(date(2026, 11, 1), "food", 980, "")]))
+    assert out[0]["amount"] == 980
+    assert isinstance(out[0]["amount"], int)
+
+
+def test_empty_memo_is_empty_string():
+    out = json.loads(to_json([Expense(date(2026, 11, 1), "food", 980)]))
+    assert out[0]["memo"] == ""
+
+
+def test_special_characters_in_memo_round_trip():
+    memo = 'say "hi"\nline2 \\ backslash'
+    out = json.loads(to_json([Expense(date(2026, 11, 1), "food", 1, memo)]))
+    assert out[0]["memo"] == memo
