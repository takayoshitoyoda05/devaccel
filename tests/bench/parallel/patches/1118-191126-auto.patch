+"""Formatting helpers for yen amounts."""
+
+from __future__ import annotations
+
+
+def yen(n: int) -> str:
+    """Format an integer yen amount with thousands separators and a 円 suffix.
+
+    >>> yen(1234567)
+    '1,234,567円'
+    >>> yen(-1200)
+    '-1,200円'
+    """
+    return f"{n:,}円"
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
new file mode 100644
index 0000000..421e22e
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,94 @@
+"""Month-over-month comparison of expenses by category."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def _month_of(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+
+    prev_total: dict[str, int] = {}
+    curr_total: dict[str, int] = {}
+    prev_seen: set[str] = set()
+    curr_seen: set[str] = set()
+    for e in rows:
+        m = _month_of(e)
+        if m == prev_month:
+            prev_total[e.category] = prev_total.get(e.category, 0) + e.amount
+            prev_seen.add(e.category)
+        elif m == curr_month:
+            curr_total[e.category] = curr_total.get(e.category, 0) + e.amount
+            curr_seen.add(e.category)
+
+    out: list[DiffRow] = []
+    for cat in prev_seen | curr_seen:
+        prev = prev_total.get(cat, 0)
+        curr = curr_total.get(cat, 0)
+        delta = curr - prev
+        pct = None if prev == 0 else round(delta / prev * 100, 1)
+        if cat not in prev_seen:
+            status = "new"
+        elif cat not in curr_seen:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+
+    out.sort(key=lambda d: (-abs(d.delta), d.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [d for d in diffs if d.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for d in diffs:
+        # + 0.0 で -0.0 を 0.0 にそろえる
+        pct = "-" if d.pct is None else f"{d.pct + 0.0:+.1f}%"
+        lines.append(f"{d.category}\t{d.prev}\t{d.curr}\t{d.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month_of(e) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には 2 か月以上の明細が必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..66494d7
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,187 @@
+"""Search query language for Expense rows.
+
+Grammar (lowest to highest precedence: OR < AND < NOT)::
+
+    or_expr  := and_expr ("OR" and_expr)*
+    and_expr := not_expr (["AND"] not_expr)*
+    not_expr := "NOT" not_expr | primary
+    primary  := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+
+class QueryError(ValueError):
+    """Raised when a search query is invalid."""
+
+
+Token = tuple[str, str]
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    tokens: list[Token] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        ch = q[i]
+        if ch.isspace():
+            i += 1
+        elif ch == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif ch == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif ch == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError("引用符が閉じていません")
+            content = q[i + 1 : end]
+            if content == "":
+                raise QueryError("空の引用は使えません")
+            tokens.append(("TERM", content))
+            i = end + 1
+        else:
+            j = i
+            while j < n and not q[j].isspace() and q[j] not in '()"':
+                j += 1
+            word = q[i:j]
+            i = j
+            if word in ("AND", "OR", "NOT"):
+                tokens.append((word, word))
+            elif word.startswith("cat:"):
+                value = word[len("cat:") :]
+                if value == "":
+                    raise QueryError("cat: の後ろに値がありません")
+                tokens.append(("CAT", value))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+@dataclass(frozen=True)
+class _Term:
+    value: str
+
+
+@dataclass(frozen=True)
+class _Cat:
+    value: str
+
+
+@dataclass(frozen=True)
+class _Not:
+    operand: _Node
+
+
+@dataclass(frozen=True)
+class _And:
+    items: tuple[_Node, ...]
+
+
+@dataclass(frozen=True)
+class _Or:
+    items: tuple[_Node, ...]
+
+
+_Node = _Term | _Cat | _Not | _And | _Or
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self._tokens = tokens
+        self._pos = 0
+
+    def _peek(self) -> str | None:
+        if self._pos < len(self._tokens):
+            return self._tokens[self._pos][0]
+        return None
+
+    def _advance(self) -> Token:
+        tok = self._tokens[self._pos]
+        self._pos += 1
+        return tok
+
+    def parse(self) -> _Node:
+        node = self._or()
+        if self._pos != len(self._tokens):
+            raise QueryError("構文エラー: 余分なトークンがあります")
+        return node
+
+    def _or(self) -> _Node:
+        items = [self._and()]
+        while self._peek() == "OR":
+            self._advance()
+            items.append(self._and())
+        return items[0] if len(items) == 1 else _Or(tuple(items))
+
+    def _and(self) -> _Node:
+        items = [self._not()]
+        while True:
+            kind = self._peek()
+            if kind == "AND":
+                self._advance()
+                items.append(self._not())
+            elif kind in ("NOT", "TERM", "CAT", "LPAREN"):
+                items.append(self._not())
+            else:
+                break
+        return items[0] if len(items) == 1 else _And(tuple(items))
+
+    def _not(self) -> _Node:
+        if self._peek() == "NOT":
+            self._advance()
+            return _Not(self._not())
+        return self._primary()
+
+    def _primary(self) -> _Node:
+        kind = self._peek()
+        if kind == "TERM":
+            return _Term(self._advance()[1])
+        if kind == "CAT":
+            return _Cat(self._advance()[1])
+        if kind == "LPAREN":
+            self._advance()
+            node = self._or()
+            if self._peek() != "RPAREN":
+                raise QueryError("括弧が閉じていません")
+            self._advance()
+            return node
+        if kind is None:
+            raise QueryError("項が必要です")
+        raise QueryError(f"構文エラー: 想定外のトークンです: {kind}")
+
+
+def _parse(q: str) -> _Node:
+    tokens = tokenize(q)
+    if not tokens:
+        raise QueryError("検索クエリが空です")
+    return _Parser(tokens).parse()
+
+
+def _eval(node: _Node, e: Expense) -> bool:
+    memo = e.memo.casefold()
+    category = e.category.casefold()
+    if isinstance(node, _Term):
+        needle = node.value.casefold()
+        return needle in memo or needle in category
+    if isinstance(node, _Cat):
+        return node.value.casefold() == category
+    if isinstance(node, _Not):
+        return not _eval(node.operand, e)
+    if isinstance(node, _And):
+        return all(_eval(item, e) for item in node.items)
+    return any(_eval(item, e) for item in node.items)
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _eval(_parse(q), e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    node = _parse(q)
+    return [e for e in rows if _eval(node, e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..2d78843
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,56 @@
+"""Detect recurring (monthly) expenses."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+from itertools import pairwise
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day in the next month, clamped to that month's last day."""
+    year, month = (d.year + 1, 1) if d.month == 12 else (d.year, d.month + 1)
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    """Find (category, amount) series whose dates recur roughly monthly."""
+    if min_count < 2 or tolerance < 0:
+        raise ValueError("min_count は 2 以上、tolerance は 0 以上である必要があります")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    out: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        days = sorted(day_set)
+        runs: list[list[date]] = []
+        run = [days[0]]
+        for prev, cur in pairwise(days):
+            if abs((cur - add_month(prev)).days) <= tolerance:
+                run.append(cur)
+            else:
+                runs.append(run)
+                run = [cur]
+        runs.append(run)
+        for r in runs:
+            if len(r) >= min_count:
+                out.append(Recurring(category, amount, tuple(r), add_month(r[-1])))
+
+    out.sort(key=lambda x: (x.category, x.amount, x.days[0]))
+    return out
