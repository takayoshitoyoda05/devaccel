diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..a9e7746
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,222 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def E(y, m, cat, amount, d=1):
+    return Expense(date(y, m, d), cat, amount)
+
+
+ROWS = [
+    E(2026, 10, "food", 1000),
+    E(2026, 10, "rent", 80000),
+    E(2026, 10, "fun", 500),
+    E(2026, 11, "food", 1300),
+    E(2026, 11, "rent", 80000),
+    E(2026, 11, "tax", 3000),
+]
+
+
+# --- month_diff: 基本 ---------------------------------------------------------
+
+
+def test_month_diff_basic_values_and_sort():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    assert diffs == [
+        DiffRow("tax", 0, 3000, 3000, None, "new"),
+        DiffRow("fun", 500, 0, -500, -100.0, "gone"),
+        DiffRow("food", 1000, 1300, 300, 30.0, "up"),
+        DiffRow("rent", 80000, 80000, 0, 0.0, "same"),
+    ]
+
+
+def test_month_diff_status_down_and_pct_rounding():
+    rows = [E(2026, 10, "a", 3000), E(2026, 11, "a", 1000)]
+    (d,) = month_diff(rows, "2026-10", "2026-11")
+    assert d == DiffRow("a", 3000, 1000, -2000, -66.7, "down")
+
+
+def test_month_diff_prev_zero_pct_is_none_but_status_by_presence():
+    rows = [E(2026, 10, "a", 0), E(2026, 11, "a", 500)]
+    (d,) = month_diff(rows, "2026-10", "2026-11")
+    assert d.prev == 0
+    assert d.pct is None
+    assert d.status == "up"
+
+
+def test_month_diff_status_is_by_presence_not_total():
+    # prev にはあるが合計 0 → "gone"、curr にはあるが合計 0 → "gone" ではなく "down"
+    rows = [E(2026, 10, "a", 100), E(2026, 11, "a", 50), E(2026, 11, "a", -50)]
+    (d,) = month_diff(rows, "2026-10", "2026-11")
+    assert d.curr == 0
+    assert d.delta == -100
+    assert d.status == "down"
+
+
+def test_month_diff_present_with_zero_total_in_both_is_same():
+    rows = [E(2026, 10, "a", 0), E(2026, 11, "a", 0)]
+    (d,) = month_diff(rows, "2026-10", "2026-11")
+    assert d == DiffRow("a", 0, 0, 0, None, "same")
+
+
+def test_month_diff_gone_when_only_prev_has_entries_with_zero_sum():
+    rows = [E(2026, 10, "a", 0)]
+    (d,) = month_diff(rows, "2026-10", "2026-11")
+    assert d == DiffRow("a", 0, 0, 0, None, "gone")
+
+
+def test_month_diff_ignores_other_months():
+    rows = [E(2026, 9, "x", 999), E(2026, 10, "a", 1), E(2026, 11, "a", 1)]
+    diffs = month_diff(rows, "2026-10", "2026-11")
+    assert [d.category for d in diffs] == ["a"]
+
+
+def test_month_diff_empty_rows_returns_empty():
+    assert month_diff([], "2026-10", "2026-11") == []
+
+
+def test_month_diff_sort_abs_delta_desc_then_category_asc():
+    rows = [
+        E(2026, 10, "b", 100),
+        E(2026, 11, "b", 0),  # delta -100
+        E(2026, 10, "a", 200),
+        E(2026, 11, "a", 0),  # delta -200
+        E(2026, 10, "c", 100),
+        E(2026, 11, "c", 300),  # delta +200
+    ]
+    diffs = month_diff(rows, "2026-10", "2026-11")
+    assert [d.category for d in diffs] == ["a", "c", "b"]
+
+
+@pytest.mark.parametrize(
+    "prev, curr",
+    [
+        ("2026-1", "2026-11"),
+        ("2026-10", "2026-1"),
+        ("2026-13", "2026-11"),
+        ("2026-00", "2026-11"),
+        ("2026-10", "2026-00"),
+        ("2026-10", "2026-11-01"),
+        ("202610", "2026-11"),
+        ("abc", "2026-11"),
+        ("", "2026-11"),
+    ],
+)
+def test_month_diff_invalid_month_raises(prev, curr):
+    with pytest.raises(ValueError):
+        month_diff(ROWS, prev, curr)
+
+
+# --- top_movers ----------------------------------------------------------------
+
+
+def test_top_movers_excludes_same_and_keeps_order():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    got = top_movers(diffs)
+    assert [d.category for d in got] == ["tax", "fun", "food"]
+    assert all(d.status != "same" for d in got)
+
+
+def test_top_movers_limits_to_n():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    assert [d.category for d in top_movers(diffs, 1)] == ["tax"]
+    assert [d.category for d in top_movers(diffs, 2)] == ["tax", "fun"]
+
+
+def test_top_movers_n_zero_is_empty():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    assert top_movers(diffs, 0) == []
+
+
+def test_top_movers_n_larger_than_available_returns_all_non_same():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    assert len(top_movers(diffs, 100)) == 3
+
+
+def test_top_movers_default_n_is_3():
+    diffs = [DiffRow(f"c{i}", 0, 1, 1, None, "new") for i in range(5)]
+    assert len(top_movers(diffs)) == 3
+
+
+def test_top_movers_negative_n_raises():
+    with pytest.raises(ValueError):
+        top_movers([], -1)
+
+
+def test_top_movers_empty_input():
+    assert top_movers([]) == []
+
+
+# --- render_diff ---------------------------------------------------------------
+
+
+def test_render_diff_format():
+    diffs = [
+        DiffRow("tax", 0, 3000, 3000, None, "new"),
+        DiffRow("fun", 500, 0, -500, -100.0, "gone"),
+        DiffRow("food", 1000, 1300, 300, 20.0, "up"),
+        DiffRow("rent", 80000, 80000, 0, 0.0, "same"),
+    ]
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "tax\t0\t3000\t+3000\t-\n"
+        "fun\t500\t0\t-500\t-100.0%\n"
+        "food\t1000\t1300\t+300\t+20.0%\n"
+        "rent\t80000\t80000\t+0\t+0.0%"
+    )
+
+
+def test_render_diff_no_trailing_newline_and_header_only_when_empty():
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+    out = render_diff([DiffRow("a", 1, 2, 1, 100.0, "up")])
+    assert not out.endswith("\n")
+    assert out.count("\n") == 1
+
+
+def test_render_diff_negative_tiny_pct_has_no_negative_zero():
+    d = DiffRow("a", 10000, 9999, -1, -0.0, "down")
+    line = render_diff([d]).splitlines()[1]
+    assert line == "a\t10000\t9999\t-1\t+0.0%"
+
+
+# --- available_months / latest_diff --------------------------------------------
+
+
+def test_available_months_sorted_unique():
+    rows = [
+        E(2026, 11, "a", 1),
+        E(2026, 9, "a", 1),
+        E(2026, 11, "b", 1, d=20),
+        E(2025, 12, "a", 1),
+    ]
+    assert available_months(rows) == ["2025-12", "2026-09", "2026-11"]
+
+
+def test_available_months_empty():
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months():
+    rows = ROWS + [E(2026, 12, "food", 50)]
+    assert latest_diff(rows) == month_diff(rows, "2026-11", "2026-12")
+
+
+def test_latest_diff_with_exactly_two_months():
+    assert latest_diff(ROWS) == month_diff(ROWS, "2026-10", "2026-11")
+
+
+def test_latest_diff_fewer_than_two_months_raises():
+    with pytest.raises(ValueError):
+        latest_diff([E(2026, 11, "a", 1)])
+    with pytest.raises(ValueError):
+        latest_diff([])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..1ed103b
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,252 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def _e(category: str, memo: str = "", amount: int = 100) -> Expense:
+    return Expense(day=date(2026, 1, 1), category=category, amount=amount, memo=memo)
+
+
+ROWS = [
+    _e("食費", "ランチ 駅前"),
+    _e("Food", "dinner"),
+    _e("交通", "電車 定期"),
+    _e("日用品", ""),
+]
+
+
+# --- tokenize ---------------------------------------------------------------
+
+
+def test_tokenize_whitespace_only_is_empty() -> None:
+    assert tokenize("   \t ") == []
+
+
+def test_tokenize_splits_on_whitespace() -> None:
+    assert tokenize("a  b") == [("TERM", "a"), ("TERM", "b")]
+
+
+def test_tokenize_parens() -> None:
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+
+
+def test_tokenize_quote_keeps_spaces_and_parens() -> None:
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+
+
+def test_tokenize_quote_has_no_escape() -> None:
+    assert tokenize('"a\\"') == [("TERM", "a\\")]
+
+
+def test_tokenize_unclosed_quote_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_word_stops_at_quote() -> None:
+    assert tokenize('ab"cd"') == [("TERM", "ab"), ("TERM", "cd")]
+
+
+def test_tokenize_operators_uppercase_only() -> None:
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+    assert tokenize("and or not") == [
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_quoted_operator_is_term() -> None:
+    assert tokenize('"AND"') == [("TERM", "AND")]
+
+
+def test_tokenize_cat_prefix() -> None:
+    assert tokenize("cat:食費") == [("CAT", "食費")]
+
+
+def test_tokenize_cat_prefix_is_case_sensitive() -> None:
+    assert tokenize("CAT:食費") == [("TERM", "CAT:食費")]
+
+
+def test_tokenize_cat_empty_value_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_tokenize_cat_value_stops_at_paren() -> None:
+    assert tokenize("cat:食費)") == [("CAT", "食費"), ("RPAREN", ")")]
+
+
+# --- parsing errors ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(a",
+        "a)",
+        ")",
+        "a AND",
+        "a OR",
+        "NOT",
+        "AND a",
+        "OR a",
+        "a OR OR b",
+        "a AND AND b",
+        "(a OR)",
+        "NOT )",
+    ],
+)
+def test_invalid_query_raises(q: str) -> None:
+    with pytest.raises(QueryError):
+        filter_rows(q, ROWS)
+
+
+def test_invalid_query_raises_even_with_no_rows() -> None:
+    with pytest.raises(QueryError):
+        filter_rows("(a", [])
+
+
+def test_valid_query_with_no_rows_returns_empty() -> None:
+    assert filter_rows("a", []) == []
+
+
+def test_matches_raises_on_invalid_query() -> None:
+    with pytest.raises(QueryError):
+        matches("a AND", ROWS[0])
+
+
+# --- evaluation -------------------------------------------------------------
+
+
+def test_term_matches_memo_substring() -> None:
+    assert matches("ランチ", ROWS[0])
+
+
+def test_term_matches_category_substring() -> None:
+    assert matches("食", ROWS[0])
+
+
+def test_term_does_not_match_when_absent() -> None:
+    assert not matches("電車", ROWS[0])
+
+
+def test_term_is_case_insensitive() -> None:
+    assert matches("DINNER", ROWS[1])
+    assert matches("food", ROWS[1])
+
+
+def test_term_empty_memo_does_not_match_everything() -> None:
+    assert not matches("dinner", ROWS[3])
+
+
+def test_cat_requires_exact_category() -> None:
+    assert matches("cat:食費", ROWS[0])
+    assert not matches("cat:食", ROWS[0])
+    assert not matches("cat:食費", ROWS[2])
+
+
+def test_cat_is_case_insensitive() -> None:
+    assert matches("cat:food", ROWS[1])
+    assert matches("cat:FOOD", ROWS[1])
+
+
+def test_cat_does_not_match_memo() -> None:
+    assert not matches("cat:dinner", ROWS[1])
+
+
+def test_term_quoted_with_space_matches_memo() -> None:
+    assert matches('"駅前"', ROWS[0])
+    assert matches('"ランチ 駅前"', ROWS[0])
+    assert not matches('"ランチ 電車"', ROWS[0])
+
+
+# --- operators and precedence -----------------------------------------------
+
+
+def test_implicit_and() -> None:
+    assert matches("ランチ 駅前", ROWS[0])
+    assert not matches("ランチ 電車", ROWS[0])
+
+
+def test_explicit_and() -> None:
+    assert matches("ランチ AND 駅前", ROWS[0])
+    assert not matches("ランチ AND 電車", ROWS[0])
+
+
+def test_or() -> None:
+    assert matches("電車 OR ランチ", ROWS[0])
+    assert not matches("電車 OR 定期", ROWS[0])
+
+
+def test_and_binds_tighter_than_or() -> None:
+    # a OR (b AND c)
+    q = "cat:日用品 OR ランチ 電車"
+    assert matches(q, ROWS[3])
+    assert not matches(q, ROWS[0])
+    assert filter_rows(q, ROWS) == [ROWS[3]]
+
+
+def test_not_binds_tighter_than_and() -> None:
+    # (NOT a) AND b: NOT applies to cat:交通 only, not to the whole conjunction.
+    assert filter_rows("NOT cat:交通 駅前", ROWS) == [ROWS[0]]
+    # If NOT applied to the whole "cat:交通 定期", ROWS[0], ROWS[1], ROWS[3] would match.
+    assert filter_rows("NOT cat:交通 定期", ROWS) == []
+
+
+def test_not() -> None:
+    assert matches("NOT 電車", ROWS[0])
+    assert not matches("NOT ランチ", ROWS[0])
+
+
+def test_double_not() -> None:
+    assert matches("NOT NOT ランチ", ROWS[0])
+    assert not matches("NOT NOT 電車", ROWS[0])
+
+
+def test_parens_override_precedence() -> None:
+    assert filter_rows("(cat:食費 OR cat:交通) 定期", ROWS) == [ROWS[2]]
+    assert filter_rows("cat:食費 OR (cat:交通 定期)", ROWS) == [ROWS[0], ROWS[2]]
+
+
+def test_nested_parens() -> None:
+    assert matches("((ランチ))", ROWS[0])
+    assert filter_rows("NOT (cat:食費 OR cat:交通)", ROWS) == [ROWS[1], ROWS[3]]
+
+
+def test_not_applies_to_parenthesized_group() -> None:
+    assert filter_rows("NOT (電車 OR ランチ)", ROWS) == [ROWS[1], ROWS[3]]
+
+
+def test_and_with_not_operand_and_explicit_and() -> None:
+    assert filter_rows("cat:交通 AND NOT 定期", ROWS) == []
+    assert filter_rows("cat:食費 AND NOT 電車", ROWS) == [ROWS[0]]
+
+
+# --- filter_rows ------------------------------------------------------------
+
+
+def test_filter_rows_keeps_input_order() -> None:
+    rows = [_e("A", "x"), _e("B", "x"), _e("C", "y")]
+    assert filter_rows("x", rows) == [rows[0], rows[1]]
+
+
+def test_filter_rows_returns_new_list() -> None:
+    result = filter_rows("ランチ", ROWS)
+    assert result == [ROWS[0]]
+    assert result is not ROWS
+
+
+def test_filter_rows_no_match_returns_empty() -> None:
+    assert filter_rows("存在しない", ROWS) == []
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..3360f3f
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,154 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def E(day, category="rent", amount=80000, memo=""):
+    return Expense(day, category, amount, memo)
+
+
+# add_month
+
+
+@pytest.mark.parametrize(
+    "src, expected",
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2024, 1, 31), date(2024, 2, 29)),
+        (date(2026, 12, 15), date(2027, 1, 15)),
+        (date(2026, 11, 30), date(2026, 12, 30)),
+        (date(2026, 3, 31), date(2026, 4, 30)),
+    ],
+)
+def test_add_month_clamps_to_month_end_and_rolls_year(src, expected):
+    assert add_month(src) == expected
+
+
+# find_recurring: argument validation
+
+
+@pytest.mark.parametrize(
+    "kwargs", [{"min_count": 1}, {"min_count": 0}, {"tolerance": -1}]
+)
+def test_invalid_arguments_raise(kwargs):
+    with pytest.raises(ValueError):
+        find_recurring([], **kwargs)
+
+
+def test_empty_input_returns_empty_list():
+    assert find_recurring([]) == []
+
+
+def test_min_count_2_accepts_exactly_two_dates():
+    rows = [E(date(2026, 1, 1)), E(date(2026, 2, 1))]
+    assert find_recurring(rows, min_count=2) == [
+        Recurring("rent", 80000, (date(2026, 1, 1), date(2026, 2, 1)), date(2026, 3, 1))
+    ]
+
+
+def test_run_shorter_than_min_count_is_dropped():
+    rows = [E(date(2026, 1, 1)), E(date(2026, 2, 1))]
+    assert find_recurring(rows) == []
+
+
+def test_monthly_series_detected_with_next_expected():
+    rows = [E(date(2026, 1, 31)), E(date(2026, 2, 28)), E(date(2026, 3, 31))]
+    # 2026-01-31 -> 2026-02-28 (clamp); 2026-02-28 -> 2026-03-28 vs 03-31: diff 3 <= 3
+    assert find_recurring(rows) == [
+        Recurring(
+            "rent",
+            80000,
+            (date(2026, 1, 31), date(2026, 2, 28), date(2026, 3, 31)),
+            add_month(date(2026, 3, 31)),
+        )
+    ]
+
+
+def test_tolerance_boundary_is_inclusive():
+    # 2026-01-01 -> expected 2026-02-01; 2026-02-04 is diff 3 (connected)
+    rows = [E(date(2026, 1, 1)), E(date(2026, 2, 4)), E(date(2026, 3, 4))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+    # with tolerance 2 the 3-day gap splits the series into runs of length 1 and 2
+    assert find_recurring(rows, min_count=3, tolerance=2) == []
+
+
+def test_tolerance_zero_requires_exact_month_day():
+    rows = [E(date(2026, 1, 1)), E(date(2026, 2, 2)), E(date(2026, 3, 2))]
+    assert find_recurring(rows, tolerance=0) == []
+
+
+def test_duplicate_dates_are_collapsed():
+    rows = [
+        E(date(2026, 1, 1)),
+        E(date(2026, 1, 1), memo="dup"),
+        E(date(2026, 2, 1)),
+        E(date(2026, 3, 1)),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 1), date(2026, 2, 1), date(2026, 3, 1))
+
+
+def test_memo_is_ignored_when_grouping():
+    rows = [
+        E(date(2026, 1, 1), memo="a"),
+        E(date(2026, 2, 1), memo="b"),
+        E(date(2026, 3, 1), memo="c"),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_different_amounts_are_separate_groups():
+    rows = [
+        E(date(2026, 1, 1), amount=100),
+        E(date(2026, 2, 1), amount=200),
+        E(date(2026, 3, 1), amount=100),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_break_splits_series_and_keeps_only_long_runs():
+    rows = [
+        E(date(2026, 1, 1)),
+        E(date(2026, 2, 1)),
+        E(date(2026, 3, 1)),
+        E(date(2026, 6, 1)),  # gap: breaks the series
+        E(date(2026, 7, 1)),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days[0] == date(2026, 1, 1)
+    assert result[0].days[-1] == date(2026, 3, 1)
+
+
+def test_two_long_runs_both_reported():
+    rows = [
+        E(date(2026, 1, 1)),
+        E(date(2026, 2, 1)),
+        E(date(2026, 3, 1)),
+        E(date(2026, 8, 1)),
+        E(date(2026, 9, 1)),
+        E(date(2026, 10, 1)),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 1), date(2026, 8, 1)]
+
+
+def test_output_sorted_by_category_amount_then_first_day():
+    rows = []
+    for cat, amt in [("util", 500), ("rent", 900), ("rent", 100)]:
+        for m in (1, 2, 3):
+            rows.append(E(date(2026, m, 1), category=cat, amount=amt))
+    # second rent/100 series starting later
+    for m in (5, 6, 7):
+        rows.append(E(date(2026, m, 10), category="rent", amount=100))
+    result = [(r.category, r.amount, r.days[0]) for r in find_recurring(rows)]
+    assert result == [
+        ("rent", 100, date(2026, 1, 1)),
+        ("rent", 100, date(2026, 5, 10)),
+        ("rent", 900, date(2026, 1, 1)),
+        ("util", 500, date(2026, 1, 1)),
+    ]
