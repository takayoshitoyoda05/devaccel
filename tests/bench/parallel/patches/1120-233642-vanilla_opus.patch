@@ -0,0 +1,129 @@
+"""Budget status per month x category: OK / WARNING (nearly over) / OVER.
+
+Pure functions only (no I/O). Inputs are the outputs of
+``core.monthly_totals`` and ``core.load_budget``.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from enum import IntEnum
+
+from kakeibo.core import Budget
+
+DEFAULT_WARN_PERCENT = 80
+
+
+class Level(IntEnum):
+    """Severity; larger is worse."""
+
+    OK = 0
+    WARNING = 1  # 予算の warn_percent% 以上に到達(ちょうど予算も含む)
+    OVER = 2  # 予算を超過
+
+
+@dataclass(frozen=True)
+class BudgetStatus:
+    month: str  # "YYYY-MM"
+    category: str
+    limit: int  # yen
+    actual: int  # yen
+    level: Level
+
+    @property
+    def remaining(self) -> int:
+        """Yen left before the limit; negative when over."""
+        return self.limit - self.actual
+
+    @property
+    def percent(self) -> int | None:
+        """Usage as an integer percent (floored); None when limit is 0."""
+        if self.limit == 0:
+            return None
+        return self.actual * 100 // self.limit
+
+
+def _check_warn_percent(warn_percent: int) -> None:
+    if isinstance(warn_percent, bool) or not isinstance(warn_percent, int):
+        raise TypeError("warn_percent は整数である必要があります")
+    if not 0 < warn_percent <= 100:
+        raise ValueError("warn_percent は 1 以上 100 以下である必要があります")
+
+
+def classify(
+    actual: int, limit: int, warn_percent: int = DEFAULT_WARN_PERCENT
+) -> Level:
+    """Classify spending against a limit.
+
+    - OVER: actual > limit (ちょうど予算は超過ではない。core.find_overruns と同じ基準)
+    - WARNING: actual > 0 かつ actual >= limit * warn_percent / 100
+    - OK: それ以外(支出 0 以下は常に OK)
+
+    Integer arithmetic only, so no float rounding at the boundary.
+    """
+    _check_warn_percent(warn_percent)
+    if limit < 0:
+        raise ValueError("limit は 0 以上である必要があります")
+    if actual > limit:
+        return Level.OVER
+    if actual > 0 and actual * 100 >= limit * warn_percent:
+        return Level.WARNING
+    return Level.OK
+
+
+def budget_statuses(
+    totals: dict[str, dict[str, int]],
+    budget: Budget,
+    warn_percent: int = DEFAULT_WARN_PERCENT,
+) -> list[BudgetStatus]:
+    """Status for every budgeted category in every month present in ``totals``.
+
+    - 予算のないカテゴリは対象外。
+    - 予算はあるがその月に支出がないカテゴリは actual=0 として含める。
+    - 並び順: 月昇順 → 深刻度降順(OVER, WARNING, OK) → 使用率降順 → カテゴリ名昇順。
+    """
+    _check_warn_percent(warn_percent)
+    out: list[BudgetStatus] = []
+    for month in sorted(totals):
+        cats = totals[month]
+        for cat, limit in budget.for_month(month).items():
+            actual = cats.get(cat, 0)
+            out.append(
+                BudgetStatus(
+                    month, cat, limit, actual, classify(actual, limit, warn_percent)
+                )
+            )
+    out.sort(key=_sort_key)
+    return out
+
+
+def _sort_key(s: BudgetStatus) -> tuple[str, int, int, int, str]:
+    # limit 0 で支出ありは使用率無限大とみなし、同じ月・同じ深刻度の先頭に置く。
+    pct = s.percent if s.percent is not None else (10**18 if s.actual > 0 else 0)
+    return (s.month, -s.level, -pct, -s.actual, s.category)
+
+
+def alerts(
+    totals: dict[str, dict[str, int]],
+    budget: Budget,
+    warn_percent: int = DEFAULT_WARN_PERCENT,
+) -> list[BudgetStatus]:
+    """Only the statuses that need attention (WARNING or OVER)."""
+    return [
+        s
+        for s in budget_statuses(totals, budget, warn_percent)
+        if s.level is not Level.OK
+    ]
+
+
+def format_alert(s: BudgetStatus) -> str:
+    """Human-readable one-line message (Japanese)."""
+    head = f"{s.month} {s.category}"
+    figures = f"(予算 {s.limit:,} / 実績 {s.actual:,})"
+    if s.level is Level.OVER:
+        return f"超過: {head} {-s.remaining:,}円超過 {figures}"
+    if s.level is Level.WARNING:  # WARNING は limit > 0 のときだけ起こる
+        return (
+            f"注意: {head} 予算の {s.percent}% 使用・残り {s.remaining:,}円 {figures}"
+        )
+    return f"OK: {head} 残り {s.remaining:,}円 {figures}"
diff --git a/tests/test_alerts.py b/tests/test_alerts.py
new file mode 100644
index 0000000..e99bc18
--- /dev/null
+++ b/tests/test_alerts.py
@@ -0,0 +1,146 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.alerts import (
+    BudgetStatus,
+    Level,
+    alerts,
+    budget_statuses,
+    classify,
+    format_alert,
+)
+from kakeibo.core import Budget, Expense, find_overruns, monthly_totals
+
+
+@pytest.mark.parametrize(
+    ("actual", "limit", "expected"),
+    [
+        (0, 1000, Level.OK),
+        (799, 1000, Level.OK),
+        (800, 1000, Level.WARNING),  # ちょうど 80%
+        (999, 1000, Level.WARNING),
+        (1000, 1000, Level.WARNING),  # ちょうど予算は超過ではない
+        (1001, 1000, Level.OVER),
+        (-500, 1000, Level.OK),  # 返金などで負
+        (0, 0, Level.OK),
+        (1, 0, Level.OVER),
+        (2, 3, Level.OK),  # 66%: float 誤差なしで判定
+        (3, 3, Level.WARNING),
+    ],
+)
+def test_classify(actual, limit, expected):
+    assert classify(actual, limit) == expected
+
+
+def test_classify_warn_percent():
+    assert classify(500, 1000, warn_percent=50) == Level.WARNING
+    assert classify(499, 1000, warn_percent=50) == Level.OK
+    assert classify(999, 1000, warn_percent=100) == Level.OK
+    assert classify(1000, 1000, warn_percent=100) == Level.WARNING
+    # 1円単位の境界: 1001 * 0.8 = 800.8 → 801 から WARNING
+    assert classify(800, 1001) == Level.OK
+    assert classify(801, 1001) == Level.WARNING
+
+
+@pytest.mark.parametrize("bad", [0, -1, 101])
+def test_classify_rejects_bad_warn_percent(bad):
+    with pytest.raises(ValueError):
+        classify(1, 10, warn_percent=bad)
+
+
+@pytest.mark.parametrize("bad", [0.8, True, "80"])
+def test_classify_rejects_non_int_warn_percent(bad):
+    with pytest.raises(TypeError):
+        classify(1, 10, warn_percent=bad)
+
+
+def test_classify_rejects_negative_limit():
+    with pytest.raises(ValueError):
+        classify(1, -1)
+
+
+def test_budget_statuses_and_sort_order():
+    budget = Budget(
+        default={"food": 1000, "rent": 80000, "fun": 5000, "book": 3000},
+        months={"2026-11": {"food": 3000}},
+    )
+    totals = {
+        "2026-11": {"rent": 80000, "food": 2500, "misc": 999999},
+        "2026-10": {"food": 1200, "fun": 4000, "book": 2400},
+    }
+    got = budget_statuses(totals, budget)
+    assert [(s.month, s.category, s.level, s.limit, s.actual) for s in got] == [
+        ("2026-10", "food", Level.OVER, 1000, 1200),
+        # WARNING 同士は使用率降順(fun 80% と book 80% は同率 → 金額降順)
+        ("2026-10", "fun", Level.WARNING, 5000, 4000),
+        ("2026-10", "book", Level.WARNING, 3000, 2400),
+        ("2026-10", "rent", Level.OK, 80000, 0),  # 支出なしでも予算があれば含む
+        # 2026-11 は food が月別上書きで 3000
+        ("2026-11", "rent", Level.WARNING, 80000, 80000),
+        ("2026-11", "food", Level.WARNING, 3000, 2500),
+        ("2026-11", "book", Level.OK, 3000, 0),
+        ("2026-11", "fun", Level.OK, 5000, 0),
+    ]  # misc は予算がないので対象外
+
+
+def test_alerts_filters_ok_and_respects_warn_percent():
+    budget = Budget(default={"food": 1000, "rent": 80000}, months={})
+    totals = {"2026-11": {"food": 900, "rent": 40000}}
+    assert [s.category for s in alerts(totals, budget)] == ["food"]
+    assert [s.category for s in alerts(totals, budget, warn_percent=50)] == [
+        "food",
+        "rent",
+    ]
+    assert alerts(totals, budget, warn_percent=100) == []
+    assert alerts({}, budget) == []
+    assert alerts(totals, Budget({}, {})) == []
+
+
+def test_over_matches_core_find_overruns():
+    rows = [
+        Expense(date(2026, 10, 31), "food", 500),
+        Expense(date(2026, 11, 1), "food", 1200),
+        Expense(date(2026, 11, 2), "rent", 80000),
+        Expense(date(2026, 11, 3), "food", 800),
+    ]
+    budget = Budget(default={"food": 1000, "rent": 80000}, months={})
+    totals = monthly_totals(rows)
+    over = [
+        (s.month, s.category, -s.remaining, s.limit, s.actual)
+        for s in budget_statuses(totals, budget)
+        if s.level is Level.OVER
+    ]
+    assert over == find_overruns(totals, budget)
+
+
+def test_status_properties():
+    s = BudgetStatus("2026-11", "food", 1000, 1250, Level.OVER)
+    assert s.remaining == -250
+    assert s.percent == 125
+    assert BudgetStatus("2026-11", "food", 3, 2, Level.OK).percent == 66
+    assert BudgetStatus("2026-11", "food", 0, 5, Level.OVER).percent is None
+
+
+def test_limit_zero_with_spending_sorts_first_within_level():
+    budget = Budget(default={"a": 0, "b": 100}, months={})
+    got = budget_statuses({"2026-11": {"a": 1, "b": 500}}, budget)
+    assert [(s.category, s.level) for s in got] == [
+        ("a", Level.OVER),
+        ("b", Level.OVER),
+    ]
+
+
+def test_format_alert():
+    over = BudgetStatus("2026-11", "food", 1000, 2500, Level.OVER)
+    warn = BudgetStatus("2026-11", "food", 3000, 2500, Level.WARNING)
+    ok = BudgetStatus("2026-11", "rent", 90000, 80000, Level.OK)
+    assert format_alert(over) == (
+        "超過: 2026-11 food 1,500円超過 (予算 1,000 / 実績 2,500)"
+    )
+    assert format_alert(warn) == (
+        "注意: 2026-11 food 予算の 83% 使用・残り 500円 (予算 3,000 / 実績 2,500)"
+    )
+    assert format_alert(ok) == (
+        "OK: 2026-11 rent 残り 10,000円 (予算 90,000 / 実績 80,000)"
+    )
