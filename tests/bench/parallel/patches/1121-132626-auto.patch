@@ -0,0 +1,73 @@
+"""Budget alerts: flag categories that are over budget or close to it.
+
+Pure functions only. Reuses ``Budget`` and the ``monthly_totals`` shape from
+``kakeibo.core`` (``{"YYYY-MM": {category: yen}}``).
+
+Decisions:
+D1: Budget / for_month / monthly_totals are reused from core, not redefined.
+D2: actual > limit is "over"; limit * warn_percent / 100 <= actual <= limit is "near".
+    actual == limit is "near" (not yet exceeded).
+D3: Comparison uses integers only (actual * 100 >= limit * warn_percent), no float rounding.
+D4: warn_percent must be an int with 1 <= warn_percent <= 100. bool / float / str / None
+    raise TypeError; out-of-range raises ValueError naming the argument.
+D5: limit 0: any positive spending is "over"; spending of 0 raises no alert.
+D6: Zero or negative actuals (refunds, net negative) never alert.
+D7: Categories without a limit are skipped; budgeted categories with no spending in a
+    month and months absent from totals produce no alert.
+D8: A negative limit in a Budget raises ValueError (names month and category).
+D9: Output order: month ascending, "over" before "near", then category name ascending.
+D10: ``amount`` is how far over for "over", and the remaining budget for "near".
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Literal
+
+from kakeibo.core import Budget
+
+Status = Literal["over", "near"]
+
+
+@dataclass(frozen=True)
+class Alert:
+    month: str
+    category: str
+    status: Status
+    limit: int
+    actual: int
+    amount: int  # over: actual - limit; near: limit - actual
+
+
+def _check_percent(warn_percent: object) -> int:
+    if isinstance(warn_percent, bool) or not isinstance(warn_percent, int):
+        raise TypeError("warn_percent は int である必要があります")
+    if not 1 <= warn_percent <= 100:
+        raise ValueError("warn_percent は 1 以上 100 以下である必要があります")
+    return warn_percent
+
+
+def check_budget(
+    totals: dict[str, dict[str, int]],
+    budget: Budget,
+    warn_percent: int = 80,
+) -> list[Alert]:
+    """Return alerts for every (month, category) that is over or near its limit."""
+    pct = _check_percent(warn_percent)
+    out: list[Alert] = []
+    for month, cats in totals.items():
+        limits = budget.for_month(month)
+        for cat, actual in cats.items():
+            if cat not in limits:
+                continue
+            limit = limits[cat]
+            if limit < 0:
+                raise ValueError(f"予算が負です: {month} {cat}")
+            if actual <= 0:
+                continue
+            if actual > limit:
+                out.append(Alert(month, cat, "over", limit, actual, actual - limit))
+            elif actual * 100 >= limit * pct:
+                out.append(Alert(month, cat, "near", limit, actual, limit - actual))
+    out.sort(key=lambda a: (a.month, a.status != "over", a.category))
+    return out
diff --git a/tests/test_budget_alerts.py b/tests/test_budget_alerts.py
new file mode 100644
index 0000000..1ec26df
--- /dev/null
+++ b/tests/test_budget_alerts.py
@@ -0,0 +1,83 @@
+from __future__ import annotations
+
+import pytest
+
+from kakeibo.budget_alerts import Alert, check_budget
+from kakeibo.core import Budget
+
+B = Budget(default={"食費": 1000, "交通": 500}, months={"2026-02": {"食費": 2000}})
+
+
+def test_over_and_near_and_ok() -> None:
+    totals = {"2026-01": {"食費": 1200, "交通": 400, "娯楽": 99999}}
+    assert check_budget(totals, B) == [
+        Alert("2026-01", "食費", "over", 1000, 1200, 200),
+        Alert("2026-01", "交通", "near", 500, 400, 100),
+    ]
+
+
+def test_exactly_at_limit_is_near_not_over() -> None:
+    (a,) = check_budget({"2026-01": {"食費": 1000}}, B)
+    assert (a.status, a.amount) == ("near", 0)
+
+
+def test_threshold_boundary_inclusive() -> None:
+    assert check_budget({"2026-01": {"食費": 800}}, B)[0].status == "near"
+    assert check_budget({"2026-01": {"食費": 799}}, B) == []
+
+
+def test_custom_percent_and_100() -> None:
+    assert check_budget({"2026-01": {"食費": 500}}, B, warn_percent=50)
+    assert check_budget({"2026-01": {"食費": 999}}, B, warn_percent=100) == []
+    assert check_budget({"2026-01": {"食費": 1000}}, B, warn_percent=100)
+
+
+def test_month_override() -> None:
+    assert check_budget({"2026-02": {"食費": 1500}}, B) == []
+    assert check_budget({"2026-02": {"食費": 1600}}, B)[0].status == "near"
+
+
+def test_zero_limit() -> None:
+    b = Budget(default={"食費": 0}, months={})
+    assert check_budget({"2026-01": {"食費": 0}}, b) == []
+    assert check_budget({"2026-01": {"食費": 1}}, b)[0].status == "over"
+
+
+def test_refund_or_zero_never_alerts() -> None:
+    assert check_budget({"2026-01": {"食費": -500, "交通": 0}}, B) == []
+
+
+def test_unbudgeted_and_missing_months() -> None:
+    assert check_budget({}, B) == []
+    assert check_budget({"2026-01": {"娯楽": 10**6}}, B) == []
+
+
+def test_order_month_status_category() -> None:
+    totals = {
+        "2026-03": {"食費": 1100},
+        "2026-01": {"交通": 450, "食費": 1100},
+    }
+    got = [(a.month, a.status, a.category) for a in check_budget(totals, B)]
+    assert got == [
+        ("2026-01", "over", "食費"),
+        ("2026-01", "near", "交通"),
+        ("2026-03", "over", "食費"),
+    ]
+
+
+@pytest.mark.parametrize("bad", [True, 80.0, "80", None])
+def test_percent_type_rejected(bad: object) -> None:
+    with pytest.raises(TypeError):
+        check_budget({}, B, warn_percent=bad)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad", [0, -1, 101])
+def test_percent_range_rejected(bad: int) -> None:
+    with pytest.raises(ValueError, match="warn_percent"):
+        check_budget({}, B, warn_percent=bad)
+
+
+def test_negative_limit_rejected() -> None:
+    b = Budget(default={"食費": -1}, months={})
+    with pytest.raises(ValueError, match="食費"):
+        check_budget({"2026-01": {"食費": 5}}, b)
