@@ -0,0 +1,97 @@
+"""Detect recurring monthly expenses (subscriptions, rent, and the like)."""
+
+from __future__ import annotations
+
+import calendar
+import re
+import statistics
+import unicodedata
+from collections import defaultdict
+from dataclasses import dataclass
+from datetime import date
+from itertools import pairwise
+
+from kakeibo.core import Expense
+
+_TRAILING_RE = re.compile(r"(#\d+|\d+)$")
+_SPACE_RE = re.compile(r"\s+")
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int  # yen
+    count: int
+    last_day: date
+    day_of_month: int
+
+
+def _normalize_memo(memo: str) -> str:
+    s = unicodedata.normalize("NFKC", memo).lower()
+    s = _SPACE_RE.sub("", s)
+    return _TRAILING_RE.sub("", s)
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: float = 0.0
+) -> list[Recurring]:
+    if isinstance(min_count, bool) or not isinstance(min_count, int):
+        raise TypeError("min_count は int である必要があります")
+    if min_count < 2:
+        raise ValueError(f"min_count は 2 以上である必要があります: {min_count}")
+    if isinstance(tolerance, bool) or not isinstance(tolerance, (int, float)):
+        raise TypeError("tolerance は数値である必要があります")
+    if not 0 <= tolerance <= 1:
+        raise ValueError(f"tolerance は 0〜1 の範囲である必要があります: {tolerance}")
+
+    groups: dict[tuple[str, str], list[Expense]] = defaultdict(list)
+    for i, e in enumerate(rows):
+        if not isinstance(e, Expense):
+            raise TypeError(f"rows[{i}] は Expense である必要があります")
+        if isinstance(e.amount, bool) or not isinstance(e.amount, int):
+            raise TypeError(f"rows[{i}].amount は int である必要があります")
+        if e.amount < 0:  # D1: refunds / negative amounts are not recurring
+            continue
+        groups[(e.category, _normalize_memo(e.memo))].append(e)
+
+    out: list[Recurring] = []
+    for (category, _), items in groups.items():
+        center = statistics.median_low([e.amount for e in items])
+        kept = [e for e in items if abs(e.amount - center) <= tolerance * center]
+
+        # R2: one occurrence per month (the earliest), months must be consecutive.
+        first_per_month: dict[tuple[int, int], Expense] = {}
+        for e in sorted(kept, key=lambda e: e.day):
+            first_per_month.setdefault((e.day.year, e.day.month), e)
+        months = sorted(first_per_month)
+        if len(months) < min_count:
+            continue
+        indexes = [y * 12 + m for y, m in months]
+        if any(b - a != 1 for a, b in pairwise(indexes)):
+            continue
+
+        picked = [first_per_month[k] for k in months]
+        out.append(
+            Recurring(
+                category=category,
+                memo=picked[0].memo,
+                amount=statistics.median_low([e.amount for e in picked]),
+                count=len(picked),
+                last_day=picked[-1].day,
+                day_of_month=max(e.day.day for e in picked),
+            )
+        )
+
+    out.sort(key=lambda r: (-r.amount, r.category, r.memo))
+    return out
+
+
+def next_due(r: Recurring) -> date:
+    """The day-of-month in the month after last_day, clamped to that month's end."""
+    if r.last_day.month == 12:
+        year, month = r.last_day.year + 1, 1
+    else:
+        year, month = r.last_day.year, r.last_day.month + 1
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(r.day_of_month, last))
