@@ -0,0 +1,86 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    all_of,
+    amount_between,
+    any_of,
+    between_dates,
+    category,
+    memo_contains,
+    not_,
+    search,
+)
+
+ROWS = [
+    Expense(date(2026, 1, 5), "食費", 1200, "ＮＥＴＦＬＩＸ"),
+    Expense(date(2026, 1, 10), "交通", 300, "電車"),
+    Expense(date(2026, 2, 1), "食費", 800, "スーパー #2"),
+    Expense(date(2026, 2, 3), "娯楽", 1500, "Netflix 2"),
+]
+
+
+# 表 E3 (ID はテスト名・ids に残す)
+@pytest.mark.parametrize(
+    ("query", "expected_count"),
+    [
+        pytest.param(all_of(), 4, id="E3-1"),
+        pytest.param(memo_contains("netflix"), 2, id="E3-3"),
+    ],
+)
+def test_spec_table_rows(query, expected_count):
+    assert len(search(ROWS, query)) == expected_count
+
+
+def test_E3_2_reversed_amount_range_raises():
+    with pytest.raises(ValueError):
+        amount_between(1000, 500)
+
+
+# 端のケース(R1〜R5)
+def test_category_exact_match_ignores_surrounding_spaces_and_is_or():
+    assert [e.amount for e in search(ROWS, category(" 食費 ", "交通"))] == [
+        1200,
+        300,
+        800,
+    ]
+
+
+def test_category_without_names_raises():
+    with pytest.raises(TypeError):
+        category()
+
+
+def test_amount_between_is_inclusive_and_open_ended():
+    assert [e.amount for e in search(ROWS, amount_between(300, 800))] == [300, 800]
+    assert [e.amount for e in search(ROWS, amount_between(lo=1200))] == [1200, 1500]
+
+
+@pytest.mark.parametrize("bad", [True, 1.5, "100"])
+def test_amount_between_rejects_non_int(bad):
+    with pytest.raises(TypeError):
+        amount_between(bad, None)
+
+
+def test_memo_empty_string_matches_all():
+    assert len(search(ROWS, memo_contains(""))) == 4
+
+
+def test_between_dates_inclusive_and_reversed_raises():
+    assert len(search(ROWS, between_dates(date(2026, 1, 10), date(2026, 2, 1)))) == 2
+    with pytest.raises(ValueError):
+        between_dates(date(2026, 2, 1), date(2026, 1, 1))
+
+
+def test_any_of_empty_is_false_and_not_negates():
+    assert search(ROWS, any_of()) == []
+    assert len(search(ROWS, not_(category("食費")))) == 2
+
+
+def test_search_keeps_order_and_does_not_mutate_input():
+    rows = list(ROWS)
+    out = search(rows, category("食費"))
+    assert out == [ROWS[0], ROWS[2]]
+    assert rows == ROWS
