+"""前月比レポート(純粋関数)。
+
+各月を直前の月と比べる。途中の月が無い場合は空の月(全カテゴリ 0)として扱う。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from itertools import pairwise
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    diff: int
+    rate: float | None
+    status: str  # "up" "down" "same" "new" "gone"
+
+
+@dataclass(frozen=True)
+class MonthReport:
+    month: str  # YYYY-MM
+    changes: list[CategoryChange]
+
+
+def _month_key(d: object) -> str:
+    return f"{d.year:04d}-{d.month:02d}"  # type: ignore[attr-defined]
+
+
+def _check_rows(rows: object) -> list[Expense]:
+    if not isinstance(rows, list):
+        raise TypeError("rows は list[Expense] で渡してください")
+    for i, r in enumerate(rows):
+        if not isinstance(r, Expense):
+            raise TypeError(f"rows[{i}] は Expense ではありません")
+        if isinstance(r.amount, bool) or not isinstance(r.amount, int):
+            raise TypeError(f"rows[{i}].amount は整数(円)で渡してください")
+    return rows
+
+
+def _month_range(first: str, last: str) -> list[str]:
+    y, m = int(first[:4]), int(first[5:])
+    ly, lm = int(last[:4]), int(last[5:])
+    months: list[str] = []
+    while (y, m) <= (ly, lm):
+        months.append(f"{y:04d}-{m:02d}")
+        m += 1
+        if m == 13:
+            y, m = y + 1, 1
+    return months
+
+
+def _compare(category: str, previous: int, current: int) -> CategoryChange | None:
+    if previous == 0 and current == 0:
+        return None
+    diff = current - previous
+    rate = None if previous == 0 else diff / abs(previous)
+    if previous == 0:
+        status = "new"
+    elif current == 0:
+        status = "gone"
+    elif diff > 0:
+        status = "up"
+    elif diff < 0:
+        status = "down"
+    else:
+        status = "same"
+    return CategoryChange(category, previous, current, diff, rate, status)
+
+
+def month_over_month(rows: list[Expense]) -> list[MonthReport]:
+    """各月(最初の月を除く)を直前の月と比べたレポートを返す。"""
+    rows = _check_rows(rows)
+    if not rows:
+        return []
+
+    totals: dict[str, dict[str, int]] = {}
+    for r in rows:
+        bucket = totals.setdefault(_month_key(r.day), {})
+        bucket[r.category] = bucket.get(r.category, 0) + r.amount
+
+    months = _month_range(min(totals), max(totals))
+    reports: list[MonthReport] = []
+    for prev_m, cur_m in pairwise(months):
+        prev_t = totals.get(prev_m, {})
+        cur_t = totals.get(cur_m, {})
+        changes: list[CategoryChange] = []
+        for cat in sorted(set(prev_t) | set(cur_t)):
+            change = _compare(cat, prev_t.get(cat, 0), cur_t.get(cat, 0))
+            if change is not None:
+                changes.append(change)
+        changes.sort(key=lambda c: (-abs(c.diff), c.category))
+        reports.append(MonthReport(cur_m, changes))
+    return reports
