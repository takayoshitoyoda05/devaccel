@@ -0,0 +1,203 @@
+"""銀行・カードの明細 CSV を Expense 行に変換する(文字列を受け、ファイル I/O はしない)。"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_DATE_COLS = ("date", "日付", "利用日", "取引日", "ご利用日")
+_AMOUNT_COLS = ("amount", "金額", "利用金額", "ご利用金額", "出金額")
+_WITHDRAW_COLS = ("出金額", "支払")
+_DEPOSIT_COLS = ("入金額", "預入")
+_CATEGORY_COLS = ("category", "カテゴリ", "分類")
+_MEMO_COLS = ("memo", "摘要", "メモ", "利用店名", "ご利用店名", "description")
+
+_CURRENCY_RE = re.compile(r"¥|円|JPY", re.IGNORECASE)
+_YEN_RE = re.compile(r"[0-9]{1,3}(?:,[0-9]{3})+|[0-9]+")
+_DATE_RES = (
+    re.compile(r"([0-9]{4})-([0-9]{2})-([0-9]{2})"),
+    re.compile(r"([0-9]{4})/([0-9]{1,2})/([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})\.([0-9]{1,2})\.([0-9]{1,2})"),
+    re.compile(r"([0-9]{4})年([0-9]{1,2})月([0-9]{1,2})日"),
+)
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int
+    column: str
+    value: str
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    rows: list[Expense]
+    errors: list[RowError]
+
+
+@dataclass(frozen=True)
+class _Layout:
+    date_col: int
+    out_col: int  # 金額列、または 2 列形式の出金列
+    deposit_col: int | None  # 2 列形式(出金/入金)のときだけ
+    category_col: int | None
+    memo_col: int | None
+
+
+def _find(index: dict[str, int], aliases: tuple[str, ...]) -> int | None:
+    for alias in aliases:
+        if alias in index:
+            return index[alias]
+    return None
+
+
+def _resolve_columns(header: list[str]) -> _Layout:
+    index: dict[str, int] = {}
+    for i, name in enumerate(header):
+        index.setdefault(name, i)
+    date_col = _find(index, _DATE_COLS)
+    if date_col is None:
+        raise ValueError(f"必須列 date(日付)がありません: {' / '.join(_DATE_COLS)}")
+    deposit_col = _find(index, _DEPOSIT_COLS)
+    if deposit_col is None:
+        out_col = _find(index, _AMOUNT_COLS + _WITHDRAW_COLS)
+    else:
+        out_col = _find(index, _WITHDRAW_COLS + _AMOUNT_COLS)
+    if out_col is None:
+        names = " / ".join(_AMOUNT_COLS + _WITHDRAW_COLS)
+        raise ValueError(f"必須列 amount(金額または出金)がありません: {names}")
+    return _Layout(
+        date_col=date_col,
+        out_col=out_col,
+        deposit_col=deposit_col,
+        category_col=_find(index, _CATEGORY_COLS),
+        memo_col=_find(index, _MEMO_COLS),
+    )
+
+
+def _cell(record: list[str], col: int | None) -> str:
+    return record[col] if col is not None else ""
+
+
+def _parse_date(raw: str) -> date:
+    s = unicodedata.normalize("NFKC", raw).strip()
+    s = re.split(r"[ T]", s, maxsplit=1)[0]  # 時刻は無視
+    if not s:
+        raise ValueError("日付が空です")
+    matches = [m for m in (p.fullmatch(s) for p in _DATE_RES) if m is not None]
+    if not matches:
+        raise ValueError("日付の形式が不正です")
+    year, month, day = (int(g) for g in matches[0].groups())
+    try:
+        return date(year, month, day)
+    except ValueError:
+        raise ValueError("存在しない日付です") from None
+
+
+def _parse_amount(raw: str) -> int:
+    s = unicodedata.normalize("NFKC", raw)
+    s = re.sub(r"\s", "", _CURRENCY_RE.sub("", s))
+    if not s:
+        raise ValueError("金額が空です")
+    negative = False
+    if s.startswith("(") and s.endswith(")"):
+        negative, s = True, s[1:-1]
+    elif s[0] in "-−△▲":
+        negative, s = True, s[1:]
+    elif s.endswith("-"):
+        negative, s = True, s[:-1]
+    if not _YEN_RE.fullmatch(s):
+        raise ValueError("金額の形式が不正です")
+    value = int(s.replace(",", ""))
+    return -value if negative else value
+
+
+def _row_amount(
+    record: list[str], layout: _Layout, line: int
+) -> tuple[int | None, list[RowError]]:
+    if layout.deposit_col is None:
+        raw = record[layout.out_col]
+        try:
+            return _parse_amount(raw), []
+        except ValueError as e:
+            return None, [RowError(line, "amount", raw, str(e))]
+    withdraw = record[layout.out_col]
+    deposit = _cell(record, layout.deposit_col)
+    if withdraw.strip() and deposit.strip():
+        reason = "出金と入金の両方に値があります"
+        return None, [
+            RowError(line, "withdrawal/deposit", f"{withdraw}/{deposit}", reason)
+        ]
+    if withdraw.strip():
+        column, raw, sign = "withdrawal", withdraw, 1
+    else:
+        column, raw, sign = "deposit", deposit, -1
+    try:
+        return sign * _parse_amount(raw), []
+    except ValueError as e:
+        return None, [RowError(line, column, raw, str(e))]
+
+
+def import_statement(text: str, default_category: str = "未分類") -> ImportResult:
+    if not isinstance(text, str):
+        raise TypeError(f"text は str である必要があります: {type(text).__name__}")
+    if not isinstance(default_category, str):
+        raise TypeError(
+            f"default_category は str である必要があります: {type(default_category).__name__}"
+        )
+    text = text.removeprefix("﻿")
+    lines = text.splitlines()
+    first = lines[0] if lines else ""
+    delimiter = "\t" if first.count("\t") > first.count(",") else ","
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delimiter)
+
+    rows: list[Expense] = []
+    errors: list[RowError] = []
+    layout: _Layout | None = None
+    width = 0
+    consumed = 0
+    for record in reader:
+        start = consumed + 1  # レコードの開始行
+        consumed = reader.line_num
+        if all(not cell.strip() for cell in record):
+            continue
+        if layout is None:
+            header = [cell.strip().lower() for cell in record]
+            layout = _resolve_columns(header)
+            width = len(header)
+            continue
+        if len(record) != width:
+            reason = (
+                f"列数が合いません(ヘッダーは {width} 列、この行は {len(record)} 列)"
+            )
+            errors.append(RowError(start, "(row)", delimiter.join(record), reason))
+            continue
+        if (
+            layout.deposit_col is not None
+            and not record[layout.out_col].strip()
+            and not _cell(record, layout.deposit_col).strip()
+        ):
+            continue
+
+        problems: list[RowError] = []
+        day: date | None = None
+        try:
+            day = _parse_date(record[layout.date_col])
+        except ValueError as e:
+            problems.append(RowError(start, "date", record[layout.date_col], str(e)))
+        amount, amount_errors = _row_amount(record, layout, start)
+        problems.extend(amount_errors)
+        if problems or day is None or amount is None:
+            errors.extend(problems)
+            continue
+        category = _cell(record, layout.category_col).strip() or default_category
+        memo = unicodedata.normalize("NFKC", _cell(record, layout.memo_col)).strip()
+        rows.append(Expense(day=day, category=category, amount=amount, memo=memo))
+    return ImportResult(rows=rows, errors=errors)
