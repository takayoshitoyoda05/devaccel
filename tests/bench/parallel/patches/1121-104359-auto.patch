+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.importer import RowError, import_statement
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param(
+            '利用日,ご利用店名,利用金額\n2026/1/5,ｽﾀｰﾊﾞ,"1,234円"\n',
+            [Expense(date(2026, 1, 5), "未分類", 1234, "スターバ")],
+            id="E2-1",
+        ),
+        pytest.param(
+            "日付,出金額,入金額\n2026/1/5,,500\n",
+            [Expense(date(2026, 1, 5), "未分類", -500, "")],
+            id="E2-3",
+        ),
+    ],
+)
+def test_example_rows(text: str, expected: list[Expense]) -> None:
+    result = import_statement(text)
+    assert result.rows == expected
+    assert result.errors == []
+
+
+def test_E2_2_invalid_date_and_amount_are_two_row_errors() -> None:
+    result = import_statement("利用日,ご利用店名,利用金額\n2026/13/45,スタバ,abc\n")
+    assert result.rows == []
+    assert [(e.line, e.column) for e in result.errors] == [(2, "date"), (2, "amount")]
+    assert [e.value for e in result.errors] == ["2026/13/45", "abc"]
+
+
+def test_tab_bom_crlf_quoted_newline_and_blank_line_numbers() -> None:
+    text = '﻿date\tmemo\tamount\r\n2026-01-02\t"a\nb"\t300\r\n\r\n2026-02-30\tx\t100\r\n'
+    result = import_statement(text)
+    assert result.rows == [Expense(date(2026, 1, 2), "未分類", 300, "a\nb")]
+    assert result.errors == [RowError(5, "date", "2026-02-30", "存在しない日付です")]
+
+
+def test_category_column_and_default_category() -> None:
+    with_col = import_statement("日付,金額,カテゴリ\n2026/1/5,100,食費\n")
+    assert with_col.rows[0].category == "食費"
+    without_col = import_statement("日付,金額\n2026/1/5,100\n", default_category="雑費")
+    assert without_col.rows[0].category == "雑費"
+
+
+def test_two_column_both_set_is_error_and_both_empty_is_skipped() -> None:
+    result = import_statement("日付,出金額,入金額\n2026/1/5,,\n2026/1/6,100,200\n")
+    assert result.rows == []
+    assert result.errors == [
+        RowError(3, "withdrawal/deposit", "100/200", result.errors[0].reason)
+    ]
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        pytest.param("-300", -300, id="ascii-minus"),
+        pytest.param("−300", -300, id="U+2212-minus"),
+        pytest.param("△500", -500, id="triangle"),
+        pytest.param("▲500", -500, id="black-triangle"),
+        pytest.param("(500)", -500, id="parentheses"),
+        pytest.param("500-", -500, id="trailing-minus"),
+        pytest.param("￥1,000", 1000, id="fullwidth-yen"),
+        pytest.param("1,000円", 1000, id="yen-suffix"),
+        pytest.param("JPY 1 000", 1000, id="jpy-with-space"),
+        pytest.param("１，２３４", 1234, id="fullwidth-digits-and-comma"),
+    ],
+)
+def test_amount_forms(raw: str, expected: int) -> None:
+    result = import_statement(f'日付,金額\n2026/1/5,"{raw}"\n')
+    assert [e.amount for e in result.rows] == [expected]
+    assert result.errors == []
+
+
+@pytest.mark.parametrize("raw", ["12.5", "1,23", "(-500)"])
+def test_amount_invalid_forms_are_row_errors(raw: str) -> None:
+    result = import_statement(f'日付,金額\n2026/1/5,"{raw}"\n')
+    assert result.rows == []
+    assert [(e.line, e.column) for e in result.errors] == [(2, "amount")]
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        pytest.param("2026-01-05", date(2026, 1, 5), id="dash"),
+        pytest.param("2026/1/5", date(2026, 1, 5), id="slash"),
+        pytest.param("2026.1.5", date(2026, 1, 5), id="dot"),
+        pytest.param("2026年1月5日", date(2026, 1, 5), id="japanese"),
+        pytest.param("2026-01-05 10:30:00", date(2026, 1, 5), id="time-ignored"),
+    ],
+)
+def test_date_forms(raw: str, expected: date) -> None:
+    result = import_statement(f"日付,金額\n{raw},100\n")
+    assert [e.day for e in result.rows] == [expected]
+
+
+@pytest.mark.parametrize("raw", ["2026-02-30", "2026/13/1"])
+def test_nonexistent_or_bad_date_is_row_error(raw: str) -> None:
+    result = import_statement(f"日付,金額\n{raw},100\n")
+    assert result.rows == []
+    assert [(e.line, e.column) for e in result.errors] == [(2, "date")]
+
+
+@pytest.mark.parametrize(
+    ("header", "missing"),
+    [
+        pytest.param("金額,メモ", "date", id="no-date"),
+        pytest.param("日付,メモ", "amount", id="no-amount"),
+    ],
+)
+def test_missing_required_column_raises(header: str, missing: str) -> None:
+    with pytest.raises(ValueError, match=missing):
+        import_statement(f"{header}\n")
+
+
+@pytest.mark.parametrize("text", ["", "﻿", "日付,金額\n"])
+def test_empty_and_header_only_give_empty_result(text: str) -> None:
+    result = import_statement(text)
+    assert result.rows == []
+    assert result.errors == []
+
+
+def test_column_count_mismatch_is_row_error() -> None:
+    result = import_statement("日付,金額,メモ\n2026/1/5,1,234円,x\n")
+    assert result.rows == []
+    assert [(e.line, e.column) for e in result.errors] == [(2, "(row)")]
+
+
+def test_wrong_argument_types_raise_type_error() -> None:
+    with pytest.raises(TypeError):
+        import_statement(123)  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        import_statement("", default_category=None)  # type: ignore[arg-type]
