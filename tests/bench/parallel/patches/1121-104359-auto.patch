index 0000000..b856852
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,117 @@
+"""Filter expense rows with composable predicates (pure functions)."""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from collections.abc import Callable
+from datetime import date
+
+from kakeibo.core import Expense
+
+Query = Callable[[Expense], bool]
+
+_TRAILING_RE = re.compile(r"(?:#\d+|\d+)$")
+_SPACE_RE = re.compile(r"\s+")
+
+
+def _normalize(text: str) -> str:
+    """D2: NFKC -> lower -> remove whitespace -> remove trailing number / #number."""
+    s = unicodedata.normalize("NFKC", text).lower()
+    s = _SPACE_RE.sub("", s)
+    return _TRAILING_RE.sub("", s)
+
+
+def _check_int_or_none(value: object, name: str) -> None:
+    if value is not None and (isinstance(value, bool) or not isinstance(value, int)):
+        raise TypeError(f"{name} は int か None である必要があります: {value!r}")
+
+
+def category(*names: str) -> Query:
+    """R1: exact match on category (surrounding whitespace ignored); multiple names are OR."""
+    if not names:
+        raise TypeError("category() には少なくとも 1 つの名前が必要です")
+    for n in names:
+        if not isinstance(n, str):
+            raise TypeError(f"category の引数は str である必要があります: {n!r}")
+    wanted = frozenset(n.strip() for n in names)
+
+    def pred(e: Expense) -> bool:
+        return e.category.strip() in wanted
+
+    return pred
+
+
+def amount_between(lo: int | None = None, hi: int | None = None) -> Query:
+    """R1: inclusive range on amount; None means unbounded on that side."""
+    _check_int_or_none(lo, "lo")
+    _check_int_or_none(hi, "hi")
+    if lo is not None and hi is not None and lo > hi:
+        raise ValueError(f"下限 lo={lo} が上限 hi={hi} より大きいです")
+
+    def pred(e: Expense) -> bool:
+        if lo is not None and e.amount < lo:
+            return False
+        return hi is None or e.amount <= hi
+
+    return pred
+
+
+def memo_contains(text: str) -> Query:
+    """R2: partial match on normalized memo (D2). Empty text matches everything."""
+    if not isinstance(text, str):
+        raise TypeError(f"memo_contains の引数は str である必要があります: {text!r}")
+    needle = _normalize(text)
+
+    def pred(e: Expense) -> bool:
+        return needle in _normalize(e.memo)
+
+    return pred
+
+
+def between_dates(start: date | None = None, end: date | None = None) -> Query:
+    """R3: inclusive date range; None means unbounded on that side."""
+    for name, v in (("start", start), ("end", end)):
+        if v is not None and not isinstance(v, date):
+            raise TypeError(f"{name} は date か None である必要があります: {v!r}")
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"開始 start={start} が終了 end={end} より後です")
+
+    def pred(e: Expense) -> bool:
+        if start is not None and e.day < start:
+            return False
+        return end is None or e.day <= end
+
+    return pred
+
+
+def all_of(*qs: Query) -> Query:
+    """R4: true when every query is true; no queries -> true."""
+
+    def pred(e: Expense) -> bool:
+        return all(q(e) for q in qs)
+
+    return pred
+
+
+def any_of(*qs: Query) -> Query:
+    """R4: true when any query is true; no queries -> false."""
+
+    def pred(e: Expense) -> bool:
+        return any(q(e) for q in qs)
+
+    return pred
+
+
+def not_(q: Query) -> Query:
+    """R4: logical negation."""
+
+    def pred(e: Expense) -> bool:
+        return not q(e)
+
+    return pred
+
+
+def search(rows: list[Expense], query: Query) -> list[Expense]:
+    """R5: return matching rows in input order; does not modify rows."""
+    return [e for e in rows if query(e)]
