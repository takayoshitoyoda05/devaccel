+++ b/tests/test_recurring.py
@@ -0,0 +1,128 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, next_due
+
+
+def _e(d: str, category: str, amount: int, memo: str) -> Expense:
+    return Expense(
+        day=date.fromisoformat(d), category=category, amount=amount, memo=memo
+    )
+
+
+def test_E1_1_same_amount_same_memo_detected_and_next_due_clamped() -> None:
+    # E1-1: 1/31, 2/28, 3/31 の同額・同メモ -> 検出、next_due は 4/30 (R4)
+    rows = [
+        _e("2024-01-31", "住居", 80000, "家賃"),
+        _e("2024-02-28", "住居", 80000, "家賃"),
+        _e("2024-03-31", "住居", 80000, "家賃"),
+    ]
+    found = find_recurring(rows)
+    assert found == [
+        Recurring(
+            category="住居",
+            memo="家賃",
+            amount=80000,
+            count=3,
+            last_day=date(2024, 3, 31),
+            day_of_month=31,
+        )
+    ]
+    assert next_due(found[0]) == date(2024, 4, 30)
+
+
+def test_E1_2_same_category_and_amount_different_memo_split_into_two_series() -> None:
+    # E1-2: 5 日と 20 日に来る同カテゴリ同額・別メモ 2 系列 -> 2 件に分かれる (R1)
+    rows = [
+        _e("2024-01-05", "通信", 5000, "スマホ"),
+        _e("2024-02-05", "通信", 5000, "スマホ"),
+        _e("2024-03-05", "通信", 5000, "スマホ"),
+        _e("2024-01-20", "通信", 5000, "光回線"),
+        _e("2024-02-20", "通信", 5000, "光回線"),
+        _e("2024-03-20", "通信", 5000, "光回線"),
+    ]
+    found = find_recurring(rows)
+    assert [(r.memo, r.day_of_month) for r in found] == [("スマホ", 5), ("光回線", 20)]
+
+
+def test_E1_3_gap_month_is_not_recurring() -> None:
+    # E1-3: 1 月と 3 月だけ(2 月欠け) -> 検出しない (R2)
+    rows = [
+        _e("2024-01-10", "娯楽", 1200, "動画"),
+        _e("2024-03-10", "娯楽", 1200, "動画"),
+    ]
+    assert find_recurring(rows) == []
+
+
+@pytest.mark.parametrize(
+    ("days", "expected"),
+    [
+        # leap year: 31 clamps to 2024-02-29 (R4, D4 boundary check)
+        (["2023-11-30", "2023-12-31", "2024-01-31"], date(2024, 2, 29)),
+        # December -> January rollover
+        (["2023-10-15", "2023-11-15", "2023-12-15"], date(2024, 1, 15)),
+    ],
+    ids=["leap-clamp", "december-rollover"],
+)
+def test_next_due_handles_clamp_and_year_rollover(
+    days: list[str], expected: date
+) -> None:
+    rows = [_e(d, "住居", 100, "x") for d in days]
+    assert next_due(find_recurring(rows)[0]) == expected
+
+
+def test_refunds_and_negative_amounts_are_excluded() -> None:
+    # D1: 負の金額は系列から除外
+    rows = [_e(f"2024-0{m}-01", "返金", -300, "返金") for m in (1, 2, 3)]
+    assert find_recurring(rows) == []
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+def test_results_sorted_by_amount_desc_then_category_then_memo() -> None:
+    rows = [
+        _e("2024-01-01", "B", 100, "m"),
+        _e("2024-02-01", "B", 100, "m"),
+        _e("2024-03-01", "B", 100, "m"),
+        _e("2024-01-02", "A", 100, "m"),
+        _e("2024-02-02", "A", 100, "m"),
+        _e("2024-03-02", "A", 100, "m"),
+        _e("2024-01-03", "C", 900, "m"),
+        _e("2024-02-03", "C", 900, "m"),
+        _e("2024-03-03", "C", 900, "m"),
+    ]
+    assert [(r.category, r.amount) for r in find_recurring(rows)] == [
+        ("C", 900),
+        ("A", 100),
+        ("B", 100),
+    ]
+
+
+@pytest.mark.parametrize(
+    ("kwargs", "exc"),
+    [
+        ({"min_count": 1}, ValueError),
+        ({"tolerance": -0.1}, ValueError),
+        ({"tolerance": 1.5}, ValueError),
+        ({"min_count": "3"}, TypeError),
+        ({"tolerance": True}, TypeError),
+    ],
+    ids=[
+        "min_count-too-small",
+        "tolerance-below-0",
+        "tolerance-above-1",
+        "min_count-str",
+        "tolerance-bool",
+    ],
+)
+def test_invalid_arguments_raise(
+    kwargs: dict[str, object], exc: type[Exception]
+) -> None:
+    with pytest.raises(exc):
+        find_recurring([], **kwargs)  # type: ignore[arg-type]
