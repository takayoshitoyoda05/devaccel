@@ -0,0 +1,104 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthly_report import CategoryChange, MonthReport, month_over_month
+
+
+def e(d: str, cat: str, amount: int) -> Expense:
+    return Expense(day=date.fromisoformat(d), category=cat, amount=amount)
+
+
+@pytest.mark.parametrize(
+    ("rows", "expected"),
+    [
+        # E4-1: 2 月なし → 2 月は食費 gone、3 月は食費 new
+        (
+            [e("2026-01-10", "食費", 1000), e("2026-03-10", "食費", 1500)],
+            [
+                MonthReport(
+                    "2026-02", [CategoryChange("食費", 1000, 0, -1000, -1.0, "gone")]
+                ),
+                MonthReport(
+                    "2026-03", [CategoryChange("食費", 0, 1500, 1500, None, "new")]
+                ),
+            ],
+        ),
+        # E4-2: 前月 1000 → 今月 1200
+        (
+            [e("2026-01-10", "食費", 1000), e("2026-02-10", "食費", 1200)],
+            [
+                MonthReport(
+                    "2026-02", [CategoryChange("食費", 1000, 1200, 200, 0.2, "up")]
+                )
+            ],
+        ),
+        # E4-3: 前月 0 → 今月 500(家賃は 0 になる)。並びは abs(diff) 降順
+        (
+            [e("2026-01-10", "家賃", 100), e("2026-02-10", "食費", 500)],
+            [
+                MonthReport(
+                    "2026-02",
+                    [
+                        CategoryChange("食費", 0, 500, 500, None, "new"),
+                        CategoryChange("家賃", 100, 0, -100, -1.0, "gone"),
+                    ],
+                )
+            ],
+        ),
+    ],
+    ids=["E4-1", "E4-2", "E4-3"],
+)
+def test_example_table(rows, expected):
+    assert month_over_month(rows) == expected
+
+
+def test_rate_uses_absolute_previous_and_same_status_and_sort_tie():
+    rows = [
+        e("2026-01-05", "A", -500),
+        e("2026-01-05", "B", 300),
+        e("2026-02-05", "A", -200),
+        e("2026-02-05", "B", 0),
+        e("2026-02-05", "C", 300),
+    ]
+    (report,) = month_over_month(rows)
+    assert report.month == "2026-02"
+    a, b, c = report.changes
+    # A: 負の前月は絶対値で割る → 300 / 500 = 0.6, up
+    assert (a.category, a.diff, a.status) == ("A", 300, "up")
+    assert a.rate == pytest.approx(0.6)
+    # B: 300 → 0 は gone、C: 0 → 300 は new。diff の絶対値が同点なら category 昇順
+    assert [x.category for x in (b, c)] == ["B", "C"]
+    assert (b.status, c.status) == ("gone", "new")
+
+
+@pytest.mark.parametrize(
+    ("rows", "expected_months"),
+    [
+        ([], []),
+        ([e("2026-05-01", "食費", 100)], []),
+        # 2 か月空いた場合、間の 2 か月も空の月として出す
+        (
+            [e("2026-01-01", "食費", 100), e("2026-04-01", "食費", 100)],
+            ["2026-02", "2026-03", "2026-04"],
+        ),
+    ],
+    ids=["empty", "one-month", "gap-months"],
+)
+def test_months_cover_first_to_last(rows, expected_months):
+    assert [r.month for r in month_over_month(rows)] == expected_months
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        [Expense(day=date(2026, 1, 1), category="食費", amount=True)],
+        [Expense(day=date(2026, 1, 1), category="食費", amount=1.5)],  # type: ignore[arg-type]
+        [Expense(day=date(2026, 1, 1), category="食費", amount="100")],  # type: ignore[arg-type]
+    ],
+    ids=["bool", "float", "str"],
+)
+def test_non_int_amount_raises_type_error(bad):
+    with pytest.raises(TypeError, match="amount"):
+        month_over_month(bad)
