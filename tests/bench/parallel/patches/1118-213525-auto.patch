+++ b/tests/test_recurring.py
@@ -0,0 +1,104 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def e(d: str, cat: str = "家賃", amt: int = 1000, memo: str = "") -> Expense:
+    return Expense(date.fromisoformat(d), cat, amt, memo)
+
+
+@pytest.mark.parametrize(
+    ("src", "want"),
+    [
+        ("2026-01-31", "2026-02-28"),
+        ("2024-01-31", "2024-02-29"),
+        ("2026-12-15", "2027-01-15"),
+        ("2026-03-31", "2026-04-30"),
+        ("2026-05-10", "2026-06-10"),
+    ],
+)
+def test_add_month(src: str, want: str) -> None:
+    assert add_month(date.fromisoformat(src)) == date.fromisoformat(want)
+
+
+def test_invalid_args() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_empty() -> None:
+    assert find_recurring([]) == []
+
+
+def test_basic() -> None:
+    rows = [e("2026-01-10", memo="a"), e("2026-02-10", memo="b"), e("2026-03-11")]
+    assert find_recurring(rows) == [
+        Recurring(
+            "家賃",
+            1000,
+            (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 11)),
+            date(2026, 4, 11),
+        )
+    ]
+
+
+def test_below_min_count() -> None:
+    assert find_recurring([e("2026-01-10"), e("2026-02-10")]) == []
+    assert len(find_recurring([e("2026-01-10"), e("2026-02-10")], min_count=2)) == 1
+
+
+def test_tolerance_boundary() -> None:
+    ok = [e("2026-01-10"), e("2026-02-13"), e("2026-03-16")]
+    assert len(find_recurring(ok)) == 1
+    ng = [e("2026-01-10"), e("2026-02-14"), e("2026-03-14")]
+    assert find_recurring(ng) == []
+    assert len(find_recurring(ng, tolerance=4)) == 1
+
+
+def test_gap_splits_runs() -> None:
+    rows = [
+        e("2026-01-10"),
+        e("2026-02-10"),
+        e("2026-03-10"),
+        e("2026-06-10"),
+        e("2026-07-10"),
+        e("2026-08-10"),
+    ]
+    got = find_recurring(rows)
+    assert [r.days[0] for r in got] == [date(2026, 1, 10), date(2026, 6, 10)]
+    assert got[0].next_expected == date(2026, 4, 10)
+
+
+def test_duplicates_removed_and_groups_split() -> None:
+    rows = [
+        e("2026-01-10"),
+        e("2026-01-10"),
+        e("2026-02-10"),
+        e("2026-03-10"),
+        e("2026-01-10", amt=2000),
+        e("2026-02-10", amt=2000),
+    ]
+    got = find_recurring(rows)
+    assert len(got) == 1 and len(got[0].days) == 3
+
+
+def test_month_end_chain_and_order() -> None:
+    rows = [
+        e("2026-01-31", "b", 1),
+        e("2026-02-28", "b", 1),
+        e("2026-03-31", "b", 1),
+        e("2026-01-05", "a", 9),
+        e("2026-02-05", "a", 9),
+        e("2026-03-05", "a", 9),
+        e("2026-01-05", "a", 3),
+        e("2026-02-05", "a", 3),
+        e("2026-03-05", "a", 3),
+    ]
+    got = find_recurring(rows)
+    assert [(r.category, r.amount) for r in got] == [("a", 3), ("a", 9), ("b", 1)]
+    assert got[2].next_expected == date(2026, 4, 30)
