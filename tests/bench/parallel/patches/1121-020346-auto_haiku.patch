+"""Recurring monthly expenses: find them in the history and project the next charge.
+
+純粋な関数だけを持つ(I/O なし)。入力は core.Expense のリスト。
+
+判断(D は全部テストで確かめる):
+D1: 同じカテゴリ・同じ金額の支出を 1 つの系列とみなす。メモは見ない。
+D2: 系列を日付順に並べ、末尾から「1 か月ずつ途切れず続く」区間を取る。各月ちょうど 1 件で、
+    1 か月でも抜けたら、そこより前は採用しない。同じ月に 2 件あれば、その月より前は見ない。
+D3: 区間の長さが min_occurrences(既定 3)以上で、区間の最終月が、入力全体の最終月の前月以降
+    (直近も続いている)なら定期支出とする。解約されたサブスクを出さないための条件。
+D4: 区間内の「日(day of month)」は、中央値(下側)から day_tolerance(既定 3)日以内に収まること。
+    外れが 1 つでもあれば採用しない。28/30/31 日のような月末払いも許容差に収まる。
+D5: 次回予定日 = 区間の最終月の翌月。日は中央値で、その月の末日を超える場合は末日にする。
+D6: 金額が 0 以下の行は対象外(返金など)。
+D7: 入力の順序には依らない。空入力は空リスト。min_occurrences < 2 は ValueError。
+D8: 基準日は入力の最終日(現在時刻は使わない)。結果は次回予定日・カテゴリ・金額の順。
+"""
+
+from __future__ import annotations
+
+import calendar
+from collections import defaultdict
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class RecurringExpense:
+    category: str
+    amount: int  # yen
+    months: int  # 途切れず続いている月数
+    day: int  # 典型的な支払日(日)
+    last_day: date  # 直近の実際の支払日
+    next_day: date  # 次回の予定日
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + (d.month - 1)
+
+
+def _trailing_run(days: list[date]) -> list[date]:
+    """昇順の日付から、末尾側の「毎月ちょうど 1 件・途切れなし」の区間を昇順で返す。"""
+    run: list[date] = []
+    for d in reversed(days):
+        if run and _month_index(run[-1]) - _month_index(d) != 1:
+            break
+        run.append(d)
+    return run[::-1]
+
+
+def find_recurring(
+    rows: list[Expense],
+    *,
+    min_occurrences: int = 3,
+    day_tolerance: int = 3,
+) -> list[RecurringExpense]:
+    """明細から毎月決まって出ていく支出を見つけ、次回の予定日を付けて返す。"""
+    if min_occurrences < 2:
+        raise ValueError("min_occurrences は 2 以上である必要があります")
+    if not rows:
+        return []
+
+    latest_month = _month_index(max(e.day for e in rows))
+    series: dict[tuple[str, int], list[date]] = defaultdict(list)
+    for e in rows:
+        if e.amount > 0:
+            series[(e.category, e.amount)].append(e.day)
+
+    found: list[RecurringExpense] = []
+    for (category, amount), days in series.items():
+        days.sort()
+        run = _trailing_run(days)
+        if len(run) < min_occurrences:
+            continue
+        if _month_index(run[-1]) < latest_month - 1:
+            continue
+        dom = sorted(d.day for d in run)
+        anchor = dom[(len(dom) - 1) // 2]  # 中央値(下側)
+        if any(abs(x - anchor) > day_tolerance for x in dom):
+            continue
+        last = run[-1]
+        year, month0 = divmod(_month_index(last) + 1, 12)
+        month = month0 + 1
+        last_dom = calendar.monthrange(year, month)[1]
+        found.append(
+            RecurringExpense(
+                category=category,
+                amount=amount,
+                months=len(run),
+                day=anchor,
+                last_day=last,
+                next_day=date(year, month, min(anchor, last_dom)),
+            )
+        )
+
+    found.sort(key=lambda r: (r.next_day, r.category, -r.amount))
+    return found
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..34149e8
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,210 @@
+import random
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import RecurringExpense, find_recurring
+
+
+def _e(day: str, category: str, amount: int, memo: str = "") -> Expense:
+    return Expense(
+        day=date.fromisoformat(day), category=category, amount=amount, memo=memo
+    )
+
+
+def test_empty_input_returns_empty():
+    assert find_recurring([]) == []
+
+
+def test_monthly_rent_is_detected_with_next_day():
+    rows = [
+        _e("2026-08-25", "rent", 80000),
+        _e("2026-09-25", "rent", 80000),
+        _e("2026-10-25", "rent", 80000),
+    ]
+    assert find_recurring(rows) == [
+        RecurringExpense(
+            category="rent",
+            amount=80000,
+            months=3,
+            day=25,
+            last_day=date(2026, 10, 25),
+            next_day=date(2026, 11, 25),
+        )
+    ]
+
+
+def test_fewer_than_min_occurrences_is_not_recurring():
+    rows = [_e("2026-09-25", "rent", 80000), _e("2026-10-25", "rent", 80000)]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_occurrences=2)) == 1
+
+
+def test_min_occurrences_below_two_is_rejected():
+    with pytest.raises(ValueError):
+        find_recurring([], min_occurrences=1)
+
+
+def test_missing_month_breaks_the_run_and_only_trailing_run_counts():
+    # 1,2 月 → 3 月なし → 4,5,6 月: 直近の 3 か月だけが採用される
+    rows = [
+        _e("2026-01-10", "subscription", 1000),
+        _e("2026-02-10", "subscription", 1000),
+        _e("2026-04-10", "subscription", 1000),
+        _e("2026-05-10", "subscription", 1000),
+        _e("2026-06-10", "subscription", 1000),
+    ]
+    [found] = find_recurring(rows)
+    assert found.months == 3
+    assert found.last_day == date(2026, 6, 10)
+    assert found.next_day == date(2026, 7, 10)
+
+
+def test_run_interrupted_by_missing_month_is_not_recurring():
+    rows = [
+        _e("2026-01-10", "subscription", 1000),
+        _e("2026-02-10", "subscription", 1000),
+        _e("2026-04-10", "subscription", 1000),
+        _e("2026-05-10", "subscription", 1000),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_cancelled_series_is_not_reported():
+    # 1〜3 月で止まり、データは 6 月まである → 解約済みとみなす
+    rows = [
+        _e("2026-01-10", "subscription", 1000),
+        _e("2026-02-10", "subscription", 1000),
+        _e("2026-03-10", "subscription", 1000),
+        _e("2026-06-01", "food", 500),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_series_ending_in_previous_month_is_still_current():
+    # 直近の支払いが前月(まだ今月分が来ていない)なら採用し、次回は今月
+    rows = [
+        _e("2026-08-15", "phone", 4000),
+        _e("2026-09-15", "phone", 4000),
+        _e("2026-10-15", "phone", 4000),
+        _e("2026-11-01", "food", 300),
+    ]
+    [found] = find_recurring(rows)
+    assert found.next_day == date(2026, 11, 15)
+
+
+def test_day_drift_within_tolerance_is_recurring_with_median_day():
+    rows = [
+        _e("2026-08-14", "phone", 4000),
+        _e("2026-09-15", "phone", 4000),
+        _e("2026-10-16", "phone", 4000),
+    ]
+    [found] = find_recurring(rows)
+    assert found.day == 15
+    assert found.next_day == date(2026, 11, 15)
+
+
+def test_day_outside_tolerance_is_not_recurring():
+    rows = [
+        _e("2026-08-05", "phone", 4000),
+        _e("2026-09-20", "phone", 4000),
+        _e("2026-10-05", "phone", 4000),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_month_end_billing_is_recurring():
+    rows = [
+        _e("2026-08-31", "cloud", 2000),
+        _e("2026-09-30", "cloud", 2000),
+        _e("2026-10-31", "cloud", 2000),
+    ]
+    [found] = find_recurring(rows)
+    assert found.day == 31
+    assert found.next_day == date(2026, 11, 30)  # 11 月は 30 日まで
+
+
+def test_weekly_spending_is_not_monthly():
+    rows = [_e(f"2026-10-{d:02d}", "food", 800) for d in (1, 8, 15, 22, 29)]
+    assert find_recurring(rows) == []
+
+
+def test_same_category_different_amounts_are_separate_series():
+    rows = []
+    for m in (8, 9, 10):
+        rows.append(_e(f"2026-{m:02d}-03", "subscription", 1200))
+        rows.append(_e(f"2026-{m:02d}-20", "subscription", 800))
+    found = find_recurring(rows)
+    assert {(r.amount, r.next_day) for r in found} == {
+        (1200, date(2026, 11, 3)),
+        (800, date(2026, 11, 20)),
+    }
+
+
+def test_memo_is_ignored_when_grouping():
+    rows = [
+        _e("2026-08-01", "subscription", 990, "video"),
+        _e("2026-09-01", "subscription", 990, ""),
+        _e("2026-10-01", "subscription", 990, "VIDEO plus"),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_extra_charge_in_latest_month_hides_the_series():
+    # 最終月に同額が 2 件あると、その月より前は見ない(D2)ので連続 1 か月しか残らない
+    rows = [
+        _e("2026-08-25", "rent", 80000),
+        _e("2026-09-25", "rent", 80000),
+        _e("2026-10-25", "rent", 80000),
+        _e("2026-10-26", "rent", 80000),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_non_positive_amounts_are_ignored():
+    rows = [
+        _e("2026-08-01", "refund", -5000),
+        _e("2026-09-01", "refund", -5000),
+        _e("2026-10-01", "refund", -5000),
+        _e("2026-08-01", "zero", 0),
+        _e("2026-09-01", "zero", 0),
+        _e("2026-10-01", "zero", 0),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_result_is_independent_of_input_order():
+    rows = [
+        _e("2026-08-25", "rent", 80000),
+        _e("2026-09-25", "rent", 80000),
+        _e("2026-10-25", "rent", 80000),
+        _e("2026-08-03", "phone", 4000),
+        _e("2026-09-03", "phone", 4000),
+        _e("2026-10-03", "phone", 4000),
+        _e("2026-10-12", "food", 1200),
+    ]
+    expected = find_recurring(rows)
+    assert [r.category for r in expected] == ["phone", "rent"]  # 次回日の順
+    shuffled = rows[:]
+    random.Random(0).shuffle(shuffled)
+    assert find_recurring(shuffled) == expected
+
+
+def test_next_day_is_after_the_latest_month_even_across_year_end():
+    rows = [
+        _e("2026-10-10", "gym", 6000),
+        _e("2026-11-10", "gym", 6000),
+        _e("2026-12-10", "gym", 6000),
+    ]
+    [found] = find_recurring(rows)
+    assert found.next_day == date(2027, 1, 10)
+
+
+def test_sample_csv_has_no_recurring_expenses():
+    from pathlib import Path
+
+    from kakeibo.core import load_csv
+
+    sample = Path(__file__).resolve().parent.parent / "data" / "sample.csv"
+    assert find_recurring(load_csv(sample)) == []
