@@ -0,0 +1,60 @@
+import json
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.export import to_json
+
+
+def test_empty_list_gives_empty_json_array() -> None:
+    assert to_json([]) == "[]"
+
+
+def test_single_row_fields_in_order_with_iso_date() -> None:
+    rows = [Expense(day=date(2026, 3, 5), category="食費", amount=1200, memo="昼")]
+    assert to_json(rows) == (
+        '[{"date": "2026-03-05", "category": "食費", "amount": 1200, "memo": "昼"}]'
+    )
+
+
+def test_keys_are_in_date_category_amount_memo_order() -> None:
+    rows = [Expense(day=date(2026, 1, 2), category="x", amount=1, memo="m")]
+    (obj,) = json.loads(to_json(rows))
+    assert list(obj.keys()) == ["date", "category", "amount", "memo"]
+
+
+def test_input_order_is_preserved() -> None:
+    rows = [
+        Expense(day=date(2026, 2, 1), category="b", amount=2),
+        Expense(day=date(2026, 1, 1), category="a", amount=1),
+    ]
+    parsed = json.loads(to_json(rows))
+    assert [o["category"] for o in parsed] == ["b", "a"]
+
+
+def test_empty_memo_is_kept_as_empty_string() -> None:
+    rows = [Expense(day=date(2026, 1, 1), category="a", amount=0, memo="")]
+    assert json.loads(to_json(rows))[0]["memo"] == ""
+
+
+def test_non_ascii_is_not_escaped() -> None:
+    rows = [Expense(day=date(2026, 1, 1), category="交通費", amount=300, memo="電車")]
+    text = to_json(rows)
+    assert "交通費" in text
+    assert "\\u" not in text
+
+
+def test_special_characters_in_memo_are_escaped_and_round_trip() -> None:
+    memo = 'say "hi"\nline2\\'
+    rows = [Expense(day=date(2026, 1, 1), category="a", amount=5, memo=memo)]
+    assert json.loads(to_json(rows))[0]["memo"] == memo
+
+
+def test_output_has_no_indentation_or_newlines() -> None:
+    rows = [Expense(day=date(2026, 1, 1), category="a", amount=5)]
+    assert "\n" not in to_json(rows)
+
+
+def test_amount_is_emitted_as_integer() -> None:
+    rows = [Expense(day=date(2026, 1, 1), category="a", amount=1500)]
+    assert json.loads(to_json(rows))[0]["amount"] == 1500
+    assert isinstance(json.loads(to_json(rows))[0]["amount"], int)
