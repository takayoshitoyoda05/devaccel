+++ b/src/kakeibo/stats.py
@@ -0,0 +1,22 @@
+"""Per-category statistics over Expense records."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def _median(values: list[int]) -> float:
+    ordered = sorted(values)
+    n = len(ordered)
+    mid = n // 2
+    if n % 2 == 1:
+        return float(ordered[mid])
+    return (ordered[mid - 1] + ordered[mid]) / 2
+
+
+def median_by_category(rows: list[Expense]) -> dict[str, float]:
+    """{category: median amount}; categories in ascending name order."""
+    grouped: dict[str, list[int]] = {}
+    for e in rows:
+        grouped.setdefault(e.category, []).append(e.amount)
+    return {cat: _median(grouped[cat]) for cat in sorted(grouped)}
