+++ b/tests/test_weekday.py
@@ -0,0 +1,60 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.weekday import total_by_weekday
+
+# 2024-01-01 is a Monday.
+MON = date(2024, 1, 1)
+TUE = date(2024, 1, 2)
+SUN = date(2024, 1, 7)
+
+
+def _e(day: date, amount: int, category: str = "food") -> Expense:
+    return Expense(day=day, category=category, amount=amount)
+
+
+def test_empty_rows_returns_empty_dict() -> None:
+    assert total_by_weekday([]) == {}
+
+
+def test_single_row_maps_to_its_weekday() -> None:
+    assert total_by_weekday([_e(MON, 500)]) == {"Mon": 500}
+
+
+def test_same_weekday_amounts_are_summed_across_weeks_and_categories() -> None:
+    rows = [
+        _e(MON, 100, "food"),
+        _e(MON, 200, "transport"),
+        _e(date(2024, 1, 8), 300),  # the following Monday
+    ]
+    assert total_by_weekday(rows) == {"Mon": 600}
+
+
+def test_weekdays_without_rows_are_omitted() -> None:
+    result = total_by_weekday([_e(MON, 100), _e(SUN, 50)])
+    assert result == {"Mon": 100, "Sun": 50}
+    assert "Tue" not in result
+
+
+def test_keys_are_in_monday_first_order_regardless_of_input_order() -> None:
+    rows = [_e(SUN, 1), _e(TUE, 2), _e(MON, 3)]
+    assert list(total_by_weekday(rows)) == ["Mon", "Tue", "Sun"]
+
+
+def test_all_seven_weekdays_present_in_order() -> None:
+    rows = [_e(date(2024, 1, d), d) for d in range(1, 8)]
+    result = total_by_weekday(list(reversed(rows)))
+    assert list(result) == ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
+    assert result == {
+        "Mon": 1,
+        "Tue": 2,
+        "Wed": 3,
+        "Thu": 4,
+        "Fri": 5,
+        "Sat": 6,
+        "Sun": 7,
+    }
+
+
+def test_zero_amount_row_still_counts_its_weekday() -> None:
+    assert total_by_weekday([_e(MON, 0)]) == {"Mon": 0}
