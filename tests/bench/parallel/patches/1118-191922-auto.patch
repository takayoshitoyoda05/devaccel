+++ b/src/kakeibo/dupes.py
@@ -0,0 +1,21 @@
+"""Detect duplicate expense rows."""
+
+from __future__ import annotations
+
+from collections import defaultdict
+from itertools import combinations
+
+from kakeibo.core import Expense
+
+
+def find_duplicates(rows: list[Expense]) -> list[tuple[int, int]]:
+    """Index pairs (i, j), i < j, of rows identical in day, category, amount and memo.
+
+    Sorted by i ascending, then j ascending.
+    """
+    groups: dict[Expense, list[int]] = defaultdict(list)
+    for idx, e in enumerate(rows):
+        groups[e].append(idx)
+    pairs = [p for idxs in groups.values() for p in combinations(idxs, 2)]
+    pairs.sort()
+    return pairs
