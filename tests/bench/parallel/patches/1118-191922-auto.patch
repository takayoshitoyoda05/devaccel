+++ b/tests/test_topn.py
@@ -0,0 +1,66 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.topn import top_expenses
+
+
+def _e(day: date, amount: int, memo: str = "") -> Expense:
+    return Expense(day=day, category="food", amount=amount, memo=memo)
+
+
+def test_returns_largest_first() -> None:
+    rows = [
+        _e(date(2026, 1, 1), 100),
+        _e(date(2026, 1, 2), 300),
+        _e(date(2026, 1, 3), 200),
+    ]
+    assert [e.amount for e in top_expenses(rows, 3)] == [300, 200, 100]
+
+
+def test_takes_only_n() -> None:
+    rows = [
+        _e(date(2026, 1, 1), 100),
+        _e(date(2026, 1, 2), 300),
+        _e(date(2026, 1, 3), 200),
+    ]
+    assert [e.amount for e in top_expenses(rows, 2)] == [300, 200]
+
+
+def test_n_larger_than_count_returns_all() -> None:
+    rows = [_e(date(2026, 1, 1), 100), _e(date(2026, 1, 2), 300)]
+    assert [e.amount for e in top_expenses(rows, 10)] == [300, 100]
+
+
+def test_n_zero_returns_empty() -> None:
+    rows = [_e(date(2026, 1, 1), 100)]
+    assert top_expenses(rows, 0) == []
+
+
+def test_negative_n_returns_empty() -> None:
+    rows = [_e(date(2026, 1, 1), 100)]
+    assert top_expenses(rows, -1) == []
+
+
+def test_empty_input_returns_empty() -> None:
+    assert top_expenses([], 3) == []
+
+
+def test_equal_amounts_ordered_by_earlier_date() -> None:
+    rows = [_e(date(2026, 1, 5), 500, "late"), _e(date(2026, 1, 2), 500, "early")]
+    assert [e.memo for e in top_expenses(rows, 2)] == ["early", "late"]
+
+
+def test_equal_amount_and_date_keeps_input_order() -> None:
+    rows = [
+        _e(date(2026, 1, 2), 500, "first"),
+        _e(date(2026, 1, 2), 500, "second"),
+        _e(date(2026, 1, 2), 500, "third"),
+    ]
+    assert [e.memo for e in top_expenses(rows, 3)] == ["first", "second", "third"]
+
+
+def test_does_not_mutate_input() -> None:
+    rows = [_e(date(2026, 1, 1), 100), _e(date(2026, 1, 2), 300)]
