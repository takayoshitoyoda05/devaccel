+"""Totals by day of week."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+WEEKDAYS: tuple[str, ...] = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
+
+
+def total_by_weekday(rows: list[Expense]) -> dict[str, int]:
+    """{"Mon".."Sun": yen}; weekdays with no rows are omitted, keys in Mon-first order."""
+    totals: dict[str, int] = {}
+    for e in rows:
+        name = WEEKDAYS[e.day.weekday()]
+        totals[name] = totals.get(name, 0) + e.amount
+    return {name: totals[name] for name in WEEKDAYS if name in totals}
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..548820c
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,201 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+HEADER = "利用日,分類,利用金額,利用店名\n"
+
+
+# --- parse_amount -------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "value"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥1200", 1200),
+        ("1,2", 12),  # カンマの位置は検査しない
+        ("-0", 0),
+    ],
+)
+def test_parse_amount_accepts(text, value):
+    assert parse_amount(text) == value
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "   ",
+        "円",
+        "12.5",
+        "1 200",
+        "--5",
+        "¥-5",
+        "１２３",
+        ",",
+        "-",
+        "¥",
+        "5円円",
+        "円5",
+    ],
+)
+def test_parse_amount_rejects(text):
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+# --- parse_date ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "value"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/12/31 ", date(2026, 12, 31)),
+        ("2026-1-5", date(2026, 1, 5)),
+        ("2024/02/29", date(2024, 2, 29)),
+    ],
+)
+def test_parse_date_accepts(text, value):
+    assert parse_date(text) == value
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026/1-5",
+        "26/1/5",
+        "2026/02/30",
+        "",
+        "2026.1.5",
+        "2026/13/1",
+        "２０２６/1/5",
+        "2026/1/5/1",
+    ],
+)
+def test_parse_date_rejects(text):
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+# --- import_rows --------------------------------------------------------
+
+
+def test_default_mapping_values():
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_import_basic_in_input_order():
+    text = HEADER + '2026/1/5,食費,"￥1,200",スーパー\n2026-01-06,交通,-300円,駅\n'
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [
+        Expense(date(2026, 1, 5), "食費", 1200, "スーパー"),
+        Expense(date(2026, 1, 6), "交通", -300, "駅"),
+    ]
+
+
+def test_quoted_comma_in_memo_and_extra_columns_ignored():
+    text = '余分,利用日,分類,利用金額,利用店名,備考\nx,2026/1/5,食費,100,"A, B",y\n'
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "A, B")]
+
+
+def test_memo_and_category_are_stripped():
+    text = HEADER + "2026/1/5, 食費 ,100, 店 \n"
+    rows, _ = import_rows(text)
+    assert rows[0].category == "食費"
+    assert rows[0].memo == "店"
+
+
+def test_custom_mapping_and_missing_memo_gives_empty_string():
+    text = "日付,カテゴリ,額\n2026/1/5,食費,100\n"
+    mapping = {"date": "日付", "category": "カテゴリ", "amount": "額"}
+    rows, errors = import_rows(text, mapping)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+def test_category_map_applied_after_strip():
+    text = HEADER + "2026/1/5, 外食 ,100,\n"
+    rows, _ = import_rows(text, category_map={"外食": "食費"})
+    assert rows[0].category == "食費"
+
+
+def test_category_map_not_applied_to_unlisted():
+    text = HEADER + "2026/1/5,交通,100,\n"
+    rows, _ = import_rows(text, category_map={"外食": "食費"})
+    assert rows[0].category == "交通"
+
+
+def test_mapping_missing_required_key_raises():
+    with pytest.raises(ValueError):
+        import_rows(HEADER, {"date": "利用日", "amount": "利用金額"})
+
+
+def test_mapping_column_absent_from_header_raises():
+    with pytest.raises(ValueError):
+        import_rows(
+            "利用日,分類,利用金額\n",
+            {"date": "利用日", "category": "分類", "amount": "無い"},
+        )
+
+
+def test_blank_lines_skipped_but_counted():
+    text = HEADER + "\n2026/1/5,食費,100,\n\n2026/x,食費,100,\n"
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "")]
+    assert errors == [(5, "date")]
+
+
+def test_error_order_and_all_errors_recorded():
+    text = HEADER + "bad,   ,1.5,\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "date"), (2, "amount"), (2, "category")]
+
+
+def test_errored_row_excluded_others_kept():
+    text = HEADER + "2026/1/5,食費,100,a\n2026/1/6,,100,b\n2026/1/7,交通,200,c\n"
+    rows, errors = import_rows(text)
+    assert [r.memo for r in rows] == ["a", "c"]
+    assert errors == [(3, "category")]
+
+
+def test_short_row_missing_values_are_empty():
+    text = HEADER + "2026/1/5,食費\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "amount")]
+
+
+def test_short_row_missing_memo_ok():
+    text = HEADER + "2026/1/5,食費,100\n"
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+def test_line_number_of_multiline_quoted_record_is_start_line():
+    text = HEADER + '2026/1/5,食費,100,"a\nb"\n2026/x,食費,1,\n'
+    rows, errors = import_rows(text)
+    assert [r.memo for r in rows] == ["a\nb"]
+    assert errors == [(4, "date")]
+
+
+def test_empty_text_raises_for_missing_columns():
+    with pytest.raises(ValueError):
+        import_rows("")
