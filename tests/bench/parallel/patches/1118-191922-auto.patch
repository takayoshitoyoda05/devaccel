diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..482156a
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,148 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def E(y, m, d, cat, amount):
+    return Expense(date(y, m, d), cat, amount)
+
+
+ROWS = [
+    E(2026, 10, 1, "food", 1000),
+    E(2026, 10, 2, "food", 500),
+    E(2026, 10, 3, "rent", 80000),
+    E(2026, 10, 4, "misc", 300),
+    E(2026, 11, 1, "food", 1800),
+    E(2026, 11, 2, "rent", 80000),
+    E(2026, 11, 3, "fun", 2000),
+    E(2026, 11, 4, "misc", 0),
+]
+
+
+def _by_cat(diffs):
+    return {d.category: d for d in diffs}
+
+
+def test_month_diff_basic_fields_and_order():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    assert [d.category for d in diffs] == ["fun", "food", "misc", "rent"]
+    food = _by_cat(diffs)["food"]
+    assert food == DiffRow("food", 1500, 1800, 300, 20.0, "up")
+    assert _by_cat(diffs)["fun"] == DiffRow("fun", 0, 2000, 2000, None, "new")
+    assert _by_cat(diffs)["misc"] == DiffRow("misc", 300, 0, -300, -100.0, "down")
+    assert _by_cat(diffs)["rent"] == DiffRow("rent", 80000, 80000, 0, 0.0, "same")
+
+
+def test_status_gone_and_new():
+    diffs = _by_cat(month_diff([E(2026, 10, 1, "x", 5)], "2026-10", "2026-11"))
+    assert diffs["x"] == DiffRow("x", 5, 0, -5, -100.0, "gone")
+
+
+def test_zero_total_with_rows_is_not_gone_or_new():
+    # 明細はあるが合計 0: 判定は明細の有無で行う
+    rows = [E(2026, 10, 1, "a", 0), E(2026, 11, 1, "a", 0)]
+    (d,) = month_diff(rows, "2026-10", "2026-11")
+    assert d == DiffRow("a", 0, 0, 0, None, "same")
+
+
+def test_zero_total_prev_with_rows_pct_none_and_up():
+    rows = [E(2026, 10, 1, "a", 0), E(2026, 11, 1, "a", 50)]
+    (d,) = month_diff(rows, "2026-10", "2026-11")
+    assert d == DiffRow("a", 0, 50, 50, None, "up")
+
+
+def test_pct_is_rounded_to_one_decimal():
+    rows = [E(2026, 10, 1, "a", 3), E(2026, 11, 1, "a", 4)]
+    (d,) = month_diff(rows, "2026-10", "2026-11")
+    assert d.pct == round(1 / 3 * 100, 1)  # 33.3
+
+
+def test_order_ties_by_category_ascending():
+    rows = [E(2026, 10, 1, "b", 100), E(2026, 11, 1, "a", 100)]
+    diffs = month_diff(rows, "2026-10", "2026-11")
+    assert [d.category for d in diffs] == ["a", "b"]
+
+
+def test_no_rows_in_either_month_gives_empty():
+    assert month_diff(ROWS, "2025-01", "2025-02") == []
+    assert month_diff([], "2026-10", "2026-11") == []
+
+
+@pytest.mark.parametrize(
+    "bad",
+    ["2026-1", "2026-13", "2026-00", "26-10", "2026/10", "2026-10 ", "２０２６-10"],
+)
+def test_bad_month_format_raises(bad):
+    with pytest.raises(ValueError):
+        month_diff(ROWS, bad, "2026-11")
+    with pytest.raises(ValueError):
+        month_diff(ROWS, "2026-10", bad)
+
+
+def test_top_movers_excludes_same_and_keeps_order():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    movers = top_movers(diffs)
+    assert [d.category for d in movers] == ["fun", "food", "misc"]
+    assert top_movers(diffs, 1) == [diffs[0]]
+    assert top_movers(diffs, 0) == []
+    assert all(d.status != "same" for d in top_movers(diffs, 10))
+
+
+def test_top_movers_negative_n_raises():
+    with pytest.raises(ValueError):
+        top_movers([], -1)
+
+
+def test_render_diff_format():
+    diffs = [
+        DiffRow("fun", 0, 2000, 2000, None, "new"),
+        DiffRow("food", 1500, 1800, 300, 20.0, "up"),
+        DiffRow("misc", 300, 0, -300, -100.0, "down"),
+        DiffRow("rent", 80000, 80000, 0, 0.0, "same"),
+    ]
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "fun\t0\t2000\t+2000\t-\n"
+        "food\t1500\t1800\t+300\t+20.0%\n"
+        "misc\t300\t0\t-300\t-100.0%\n"
+        "rent\t80000\t80000\t+0\t+0.0%"
+    )
+
+
+def test_render_diff_has_no_trailing_newline_and_header_only_when_empty():
+    out = render_diff([])
+    assert out == "category\tprev\tcurr\tdelta\tpct"
+    assert not render_diff([DiffRow("a", 1, 2, 1, 100.0, "up")]).endswith("\n")
+
+
+def test_render_diff_negative_zero_pct_shows_plus():
+    d = DiffRow("a", 5, 5, 0, -0.0, "same")
+    assert render_diff([d]).splitlines()[1].endswith("\t+0.0%")
+
+
+def test_available_months_sorted_unique():
+    rows = [E(2026, 11, 5, "a", 1), E(2026, 9, 1, "a", 1), E(2026, 11, 1, "b", 1)]
+    assert available_months(rows) == ["2026-09", "2026-11"]
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months():
+    rows = ROWS + [E(2026, 12, 1, "food", 100)]
+    assert latest_diff(rows) == month_diff(rows, "2026-11", "2026-12")
+
+
+def test_latest_diff_needs_two_months():
+    with pytest.raises(ValueError):
+        latest_diff([E(2026, 10, 1, "a", 1), E(2026, 10, 2, "a", 1)])
+    with pytest.raises(ValueError):
+        latest_diff([])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..6b9b335
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,259 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def _e(category: str, memo: str = "", amount: int = 100) -> Expense:
+    return Expense(day=date(2026, 1, 1), category=category, amount=amount, memo=memo)
+
+
+# --- tokenize ---------------------------------------------------------------
+
+
+def test_tokenize_whitespace_only_gives_no_tokens() -> None:
+    assert tokenize("   \t ") == []
+
+
+def test_tokenize_parens_and_words() -> None:
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+
+
+def test_tokenize_word_stops_at_paren_and_quote() -> None:
+    assert tokenize('a(b"c"') == [
+        ("TERM", "a"),
+        ("LPAREN", "("),
+        ("TERM", "b"),
+        ("TERM", "c"),
+    ]
+
+
+def test_tokenize_quoted_term_keeps_spaces_and_parens() -> None:
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+
+
+def test_tokenize_quoted_operator_is_term() -> None:
+    assert tokenize('"AND"') == [("TERM", "AND")]
+
+
+def test_tokenize_unclosed_quote_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_quote_of_spaces_is_term() -> None:
+    # 中身が空でなければ(空白だけでも)TERM になる
+    assert tokenize('" "') == [("TERM", " ")]
+
+
+def test_tokenize_only_uppercase_operators() -> None:
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+    assert tokenize("and or not") == [
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_note_is_term_not_operator() -> None:
+    assert tokenize("NOTE") == [("TERM", "NOTE")]
+
+
+def test_tokenize_cat_prefix() -> None:
+    assert tokenize("cat:food") == [("CAT", "food")]
+
+
+def test_tokenize_cat_value_may_look_like_operator() -> None:
+    assert tokenize("cat:AND") == [("CAT", "AND")]
+
+
+def test_tokenize_cat_without_value_is_error() -> None:
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_tokenize_cat_is_case_sensitive_prefix() -> None:
+    # 接頭辞 cat: は小文字のみ。大文字は通常の語
+    assert tokenize("CAT:food") == [("TERM", "CAT:food")]
+
+
+# --- parsing errors ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(",
+        ")",
+        "(a",
+        "a)",
+        "(a))",
+        "a AND",
+        "AND a",
+        "a OR",
+        "OR a",
+        "a AND AND b",
+        "a OR OR b",
+        "NOT",
+        "a OR (",
+        "(a OR)",
+    ],
+)
+def test_malformed_query_raises(q: str) -> None:
+    with pytest.raises(QueryError):
+        matches(q, _e("food"))
+
+
+def test_filter_rows_empty_query_raises_even_with_no_rows() -> None:
+    with pytest.raises(QueryError):
+        filter_rows("", [])
+
+
+def test_filter_rows_malformed_query_raises_even_with_no_rows() -> None:
+    with pytest.raises(QueryError):
+        filter_rows("a AND", [])
+
+
+def test_filter_rows_valid_query_with_no_rows_returns_empty() -> None:
+    assert filter_rows("a", []) == []
+
+
+# --- evaluation -------------------------------------------------------------
+
+
+def test_term_matches_memo_substring() -> None:
+    assert matches("lunch", _e("food", memo="ランチ lunch set"))
+
+
+def test_term_matches_category_substring() -> None:
+    assert matches("foo", _e("food"))
+
+
+def test_term_is_substring_not_word() -> None:
+    assert matches("oo", _e("food"))
+
+
+def test_term_no_match() -> None:
+    assert not matches("rent", _e("food", memo="lunch"))
+
+
+def test_term_is_case_insensitive() -> None:
+    assert matches("LUNCH", _e("food", memo="lunch"))
+    assert matches("lunch", _e("food", memo="LUNCH"))
+
+
+def test_term_casefold_handles_sharp_s() -> None:
+    assert matches("STRASSE", _e("x", memo="straße"))
+
+
+def test_cat_requires_exact_category() -> None:
+    assert matches("cat:food", _e("food"))
+    assert not matches("cat:foo", _e("food"))
+
+
+def test_cat_does_not_match_memo() -> None:
+    assert not matches("cat:lunch", _e("food", memo="lunch"))
+
+
+def test_cat_is_case_insensitive() -> None:
+    assert matches("cat:FOOD", _e("food"))
+
+
+def test_cat_value_ends_at_whitespace() -> None:
+    # cat: の値は空白で区切られる(引用不可)。"cat:a b" は CAT a と TERM b
+    assert matches("cat:food b", _e("food", memo="b"))
+    assert not matches("cat:food b", _e("food", memo="x"))
+
+
+def test_quoted_term_with_spaces() -> None:
+    assert matches('"hot pot"', _e("food", memo="hot pot"))
+    assert not matches('"hot pot"', _e("food", memo="hot  pot"))
+
+
+def test_and_explicit_and_implicit_are_same() -> None:
+    e = _e("food", memo="lunch")
+    assert matches("food lunch", e)
+    assert matches("food AND lunch", e)
+    assert not matches("food rent", e)
+    assert not matches("food AND rent", e)
+
+
+def test_or_precedence_lower_than_and() -> None:
+    # a OR b AND c == a OR (b AND c)
+    assert matches("rent OR food lunch", _e("rent"))
+    assert matches("rent OR food lunch", _e("food", memo="lunch"))
+    assert not matches("rent OR food lunch", _e("food", memo="dinner"))
+
+
+def test_not_binds_tighter_than_and() -> None:
+    # NOT a b == (NOT a) AND b
+    assert matches("NOT rent food", _e("food"))
+    assert not matches("NOT rent food", _e("rent"))
+    assert not matches("NOT rent food", _e("other"))
+
+
+def test_not_not_is_double_negation() -> None:
+    assert matches("NOT NOT food", _e("food"))
+    assert not matches("NOT NOT food", _e("rent"))
+
+
+def test_parens_override_precedence() -> None:
+    e = _e("food", memo="dinner")
+    assert matches("(rent OR food) dinner", e)
+    assert not matches("NOT (rent OR food)", e)
+
+
+def test_nested_parens() -> None:
+    assert matches("((food))", _e("food"))
+
+
+def test_not_applies_to_parenthesised_group() -> None:
+    assert matches("NOT (rent OR tax)", _e("food"))
+    assert not matches("NOT (rent OR food)", _e("food"))
+
+
+def test_operators_are_not_case_insensitive() -> None:
+    # 小文字の or は演算子ではなく TERM。両方の語を含む明細にだけ真
+    assert matches("food or lunch", _e("food", memo="or lunch"))
+    assert not matches("food or lunch", _e("food", memo="lunch"))
+
+
+def test_cat_and_term_combined() -> None:
+    assert matches("cat:food lunch", _e("food", memo="lunch"))
+    assert not matches("cat:food lunch", _e("rent", memo="lunch"))
+
+
+# --- filter_rows ------------------------------------------------------------
+
+
+def test_filter_rows_keeps_input_order() -> None:
+    rows = [
+        _e("food", memo="a", amount=1),
+        _e("rent", memo="a", amount=2),
+        _e("food", memo="a", amount=3),
+    ]
+    out = filter_rows("cat:food", rows)
+    assert [e.amount for e in out] == [1, 3]
+
+
+def test_filter_rows_no_match_returns_empty_list() -> None:
+    assert filter_rows("zzz", [_e("food")]) == []
+
+
+def test_filter_rows_does_not_mutate_input() -> None:
+    rows = [_e("food"), _e("rent")]
+    before = list(rows)
+    filter_rows("food", rows)
+    assert rows == before
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..f9a499a
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,210 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def _e(day, category="rent", amount=50000, memo=""):
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- add_month ---------------------------------------------------------------
+
+
+def test_add_month_same_day():
+    assert add_month(date(2026, 11, 15)) == date(2026, 12, 15)
+
+
+def test_add_month_clamps_to_end_of_short_month():
+    assert add_month(date(2026, 1, 31)) == date(2026, 2, 28)
+
+
+def test_add_month_clamps_to_leap_day():
+    assert add_month(date(2024, 1, 31)) == date(2024, 2, 29)
+
+
+def test_add_month_year_rollover_keeps_day():
+    assert add_month(date(2026, 12, 15)) == date(2027, 1, 15)
+
+
+def test_add_month_dec_31_to_jan_31_no_clamp():
+    assert add_month(date(2026, 12, 31)) == date(2027, 1, 31)
+
+
+def test_add_month_30_to_february_clamps():
+    assert add_month(date(2026, 3, 30)) == date(2026, 4, 30)
+    assert add_month(date(2026, 1, 30)) == date(2026, 2, 28)
+
+
+# --- find_recurring: argument validation ------------------------------------
+
+
+def test_min_count_below_two_raises():
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+
+
+def test_negative_tolerance_raises():
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_tolerance_zero_is_allowed():
+    rows = [_e(date(2026, 1, 31)), _e(date(2026, 2, 28)), _e(date(2026, 3, 28))]
+    # 2026-02-28 == add_month(2026-01-31) exactly, so tolerance 0 keeps it.
+    # 2026-03-28 vs add_month(2026-02-28)=2026-03-28, also exact.
+    result = find_recurring(rows, min_count=3, tolerance=0)
+    assert len(result) == 1
+
+
+# --- find_recurring: basic behaviour ----------------------------------------
+
+
+def test_empty_input_returns_empty_list():
+    assert find_recurring([]) == []
+
+
+def test_regular_monthly_series_is_detected():
+    rows = [_e(date(2026, m, 10)) for m in (1, 2, 3)]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="rent",
+            amount=50000,
+            days=(date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10)),
+            next_expected=date(2026, 4, 10),
+        )
+    ]
+
+
+def test_memo_is_ignored_for_grouping():
+    rows = [
+        _e(date(2026, 1, 10), memo="a"),
+        _e(date(2026, 2, 10), memo="b"),
+        _e(date(2026, 3, 10), memo=""),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_different_amount_is_a_different_group():
+    rows = [
+        _e(date(2026, 1, 10), amount=500),
+        _e(date(2026, 2, 10), amount=501),
+        _e(date(2026, 3, 10), amount=500),
+    ]
+    # Each group has only 2 entries, below min_count=3.
+    assert find_recurring(rows) == []
+
+
+def test_different_category_is_a_different_group():
+    rows = [
+        _e(date(2026, 1, 10), category="a"),
+        _e(date(2026, 2, 10), category="b"),
+        _e(date(2026, 3, 10), category="a"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_duplicate_dates_are_collapsed():
+    rows = [
+        _e(date(2026, 1, 10)),
+        _e(date(2026, 1, 10), memo="dup"),
+        _e(date(2026, 2, 10)),
+        _e(date(2026, 3, 10)),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10))
+
+
+def test_unsorted_input_is_sorted_into_days():
+    rows = [_e(date(2026, 3, 10)), _e(date(2026, 1, 10)), _e(date(2026, 2, 10))]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10))
+    assert result[0].next_expected == date(2026, 4, 10)
+
+
+def test_run_shorter_than_min_count_is_dropped():
+    rows = [_e(date(2026, 1, 10)), _e(date(2026, 2, 10))]
+    assert find_recurring(rows, min_count=3) == []
+
+
+def test_run_of_exactly_min_count_is_kept():
+    rows = [_e(date(2026, 1, 10)), _e(date(2026, 2, 10))]
+    result = find_recurring(rows, min_count=2)
+    assert len(result) == 1
+
+
+def test_next_expected_uses_last_date_of_run():
+    rows = [_e(date(2026, 1, 31)), _e(date(2026, 2, 28)), _e(date(2026, 3, 31))]
+    result = find_recurring(rows)
+    assert result[0].next_expected == date(2026, 4, 30)
+
+
+# --- find_recurring: tolerance and splitting --------------------------------
+
+
+def test_gap_within_tolerance_is_linked():
+    # add_month(2026-01-10)=2026-02-10; 2026-02-13 is 3 days off -> linked at tol=3
+    rows = [_e(date(2026, 1, 10)), _e(date(2026, 2, 13)), _e(date(2026, 3, 13))]
+    result = find_recurring(rows, tolerance=3)
+    assert len(result) == 1
+
+
+def test_gap_beyond_tolerance_splits_run():
+    # 2026-02-14 is 4 days off -> not linked at tol=3
+    rows = [_e(date(2026, 1, 10)), _e(date(2026, 2, 14)), _e(date(2026, 3, 14))]
+    assert find_recurring(rows, tolerance=3) == []
+
+
+def test_early_deviation_is_also_checked():
+    # 2026-02-07 is 3 days early -> linked; 2026-02-06 is 4 days early -> not.
+    linked = [_e(date(2026, 1, 10)), _e(date(2026, 2, 7)), _e(date(2026, 3, 7))]
+    assert len(find_recurring(linked, tolerance=3)) == 1
+    broken = [_e(date(2026, 1, 10)), _e(date(2026, 2, 6)), _e(date(2026, 3, 6))]
+    assert find_recurring(broken, tolerance=3) == []
+
+
+def test_break_splits_into_two_runs_and_drops_short_one():
+    rows = [
+        _e(date(2026, 1, 10)),
+        _e(date(2026, 2, 10)),
+        _e(date(2026, 3, 10)),
+        _e(date(2026, 6, 10)),  # break: gap from 2026-03-10 is too long
+        _e(date(2026, 7, 10)),
+    ]
+    result = find_recurring(rows, min_count=3)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10))
+
+
+def test_break_yields_two_qualifying_runs():
+    rows = [
+        _e(date(2026, 1, 10)),
+        _e(date(2026, 2, 10)),
+        _e(date(2026, 3, 10)),
+        _e(date(2026, 7, 10)),
+        _e(date(2026, 8, 10)),
+        _e(date(2026, 9, 10)),
+    ]
+    result = find_recurring(rows, min_count=3)
+    assert [r.days[0] for r in result] == [date(2026, 1, 10), date(2026, 7, 10)]
+    assert [r.next_expected for r in result] == [date(2026, 4, 10), date(2026, 10, 10)]
+
+
+# --- find_recurring: ordering ------------------------------------------------
+
+
+def test_results_sorted_by_category_amount_then_first_day():
+    rows = []
+    for m in (1, 2, 3):
+        rows.append(_e(date(2026, m, 5), category="b", amount=100))
+        rows.append(_e(date(2026, m, 6), category="a", amount=300))
+        rows.append(_e(date(2026, m, 7), category="a", amount=200))
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [
+        ("a", 200),
+        ("a", 300),
+        ("b", 100),
+    ]
