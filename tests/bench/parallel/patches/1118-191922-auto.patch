@@ -0,0 +1,42 @@
+import pytest
+
+from kakeibo.split import split_evenly
+
+
+def test_even_division():
+    assert split_evenly(300, 3) == [100, 100, 100]
+
+
+def test_remainder_goes_to_first_people_one_yen_each():
+    assert split_evenly(10, 3) == [4, 3, 3]
+    assert split_evenly(11, 3) == [4, 4, 3]
+
+
+def test_sum_always_equals_amount():
+    for amount in range(50):
+        for people in range(1, 8):
+            parts = split_evenly(amount, people)
+            assert sum(parts) == amount
+            assert len(parts) == people
+
+
+def test_one_person_gets_everything():
+    assert split_evenly(1234, 1) == [1234]
+
+
+def test_zero_amount():
+    assert split_evenly(0, 4) == [0, 0, 0, 0]
+
+
+def test_amount_less_than_people():
+    assert split_evenly(2, 5) == [1, 1, 0, 0, 0]
+
+
+def test_people_zero_raises():
+    with pytest.raises(ValueError):
+        split_evenly(100, 0)
+
+
+def test_people_negative_raises():
+    with pytest.raises(ValueError):
+        split_evenly(100, -1)
