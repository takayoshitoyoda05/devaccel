@@ -0,0 +1,71 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.dupes import find_duplicates
+
+A = Expense(date(2024, 1, 5), "food", 500, "lunch")
+B = Expense(date(2024, 1, 6), "food", 500, "lunch")
+
+
+def test_empty_input_has_no_duplicates() -> None:
+    assert find_duplicates([]) == []
+
+
+def test_single_row_has_no_duplicates() -> None:
+    assert find_duplicates([A]) == []
+
+
+def test_two_identical_rows_form_one_pair() -> None:
+    assert find_duplicates([A, A]) == [(0, 1)]
+
+
+def test_non_adjacent_duplicates_are_found() -> None:
+    assert find_duplicates([A, B, A]) == [(0, 2)]
+
+
+def test_rows_differing_in_day_are_not_duplicates() -> None:
+    assert find_duplicates([A, B]) == []
+
+
+def test_rows_differing_in_category_are_not_duplicates() -> None:
+    other = Expense(A.day, "rent", A.amount, A.memo)
+    assert find_duplicates([A, other]) == []
+
+
+def test_rows_differing_in_amount_are_not_duplicates() -> None:
+    other = Expense(A.day, A.category, 501, A.memo)
+    assert find_duplicates([A, other]) == []
+
+
+def test_rows_differing_in_memo_are_not_duplicates() -> None:
+    other = Expense(A.day, A.category, A.amount, "dinner")
+    assert find_duplicates([A, other]) == []
+
+
+def test_empty_memos_compare_equal() -> None:
+    x = Expense(date(2024, 2, 1), "misc", 100)
+    y = Expense(date(2024, 2, 1), "misc", 100, "")
+    assert find_duplicates([x, y]) == [(0, 1)]
+
+
+def test_triple_yields_all_three_pairs_in_order() -> None:
+    assert find_duplicates([A, A, A]) == [(0, 1), (0, 2), (1, 2)]
+
+
+def test_output_is_sorted_by_i_then_j_across_groups() -> None:
+    # group A at indices 0, 2, 3; group B at indices 1, 4
+    rows = [A, B, A, A, B]
+    assert find_duplicates(rows) == [(0, 2), (0, 3), (1, 4), (2, 3)]
+
+
+def test_pairs_satisfy_i_less_than_j_and_no_self_pairs() -> None:
+    result = find_duplicates([A, A])
+    assert all(i < j for i, j in result)
+    assert (0, 0) not in result and (1, 1) not in result
+
+
+def test_input_list_is_not_modified() -> None:
+    rows = [A, B, A]
+    snapshot = list(rows)
+    find_duplicates(rows)
+    assert rows == snapshot
