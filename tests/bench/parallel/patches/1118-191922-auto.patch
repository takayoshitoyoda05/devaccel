+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.stats import median_by_category
+
+
+def _e(category: str, amount: int) -> Expense:
+    return Expense(day=date(2026, 1, 1), category=category, amount=amount)
+
+
+def test_empty_returns_empty_dict() -> None:
+    assert median_by_category([]) == {}
+
+
+def test_single_row() -> None:
+    assert median_by_category([_e("食費", 500)]) == {"食費": 500.0}
+
+
+def test_odd_count_takes_middle_value() -> None:
+    rows = [_e("食費", 300), _e("食費", 100), _e("食費", 200)]
+    assert median_by_category(rows) == {"食費": 200.0}
+
+
+def test_even_count_averages_middle_two() -> None:
+    rows = [_e("食費", 100), _e("食費", 400), _e("食費", 200), _e("食費", 300)]
+    assert median_by_category(rows) == {"食費": 250.0}
+
+
+def test_even_count_with_odd_sum_gives_half_yen() -> None:
+    rows = [_e("食費", 100), _e("食費", 201)]
+    assert median_by_category(rows) == {"食費": 150.5}
+
+
+def test_all_equal_values() -> None:
+    rows = [_e("食費", 700), _e("食費", 700), _e("食費", 700)]
+    assert median_by_category(rows) == {"食費": 700.0}
+
+
+def test_duplicates_counted_in_median() -> None:
+    rows = [_e("食費", 100), _e("食費", 100), _e("食費", 900)]
+    assert median_by_category(rows) == {"食費": 100.0}
+
+
+def test_categories_are_computed_separately() -> None:
+    rows = [
+        _e("食費", 100),
+        _e("交通費", 1000),
+        _e("食費", 300),
+        _e("交通費", 3000),
+        _e("食費", 200),
+    ]
+    assert median_by_category(rows) == {"交通費": 2000.0, "食費": 200.0}
+
+
+def test_keys_sorted_by_category_name_ascending() -> None:
+    rows = [_e("娯楽", 1), _e("食費", 2), _e("交通費", 3), _e("光熱費", 4)]
+    result = median_by_category(rows)
+    assert list(result) == ["交通費", "光熱費", "娯楽", "食費"]
+
+
+def test_input_order_does_not_matter() -> None:
+    rows = [_e("食費", 500), _e("食費", 100), _e("食費", 300)]
+    assert median_by_category(rows) == median_by_category(list(reversed(rows)))
+
+
+def test_negative_amounts_are_allowed() -> None:
+    rows = [_e("返金", -300), _e("返金", -100), _e("返金", 200)]
+    assert median_by_category(rows) == {"返金": -100.0}
+
+
+def test_does_not_mutate_input() -> None:
+    rows = [_e("食費", 300), _e("食費", 100)]
+    before = list(rows)
+    median_by_category(rows)
+    assert rows == before
