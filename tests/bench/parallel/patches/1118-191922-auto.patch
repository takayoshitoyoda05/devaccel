index 0000000..b9c0fc7
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,120 @@
+"""Import expense rows from bank statement CSV text."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+# 任意の '-' / 任意の '¥' か '￥' 1 文字 / ASCII 数字で始まる数字とカンマの列 / 任意の '円'
+_AMOUNT_RE = re.compile(r"(-?)([¥￥]?)([0-9][0-9,]*)(円?)")
+
+
+def parse_amount(s: str) -> int:
+    """Parse a bank amount string such as '￥1,234' or '-300円' into yen."""
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    sign, _yen, digits, _suffix = m.groups()
+    value = int(digits.replace(",", ""))
+    return -value if sign == "-" else value
+
+
+def parse_date(s: str) -> date:
+    """Parse 'YYYY/M/D' or 'YYYY-M-D' (separator must be consistent)."""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    year, _sep, month, day = m.group(1), m.group(2), m.group(3), m.group(4)
+    try:
+        return date(int(year), int(month), int(day))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def _cell(row: list[str], index: dict[str, int], field: str) -> str:
+    """Value of ``field`` in ``row``; missing (short row) counts as ''."""
+    i = index[field]
+    return row[i] if i < len(row) else ""
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Convert bank CSV text (header on line 1) into expenses.
+
+    Returns (valid expenses in input order, [(line_number, field), ...]).
+    Line numbers are physical lines in ``text`` (header is 1). Blank lines
+    are skipped but still counted. Rows with any error are excluded.
+    """
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    try:
+        header = next(reader)
+    except StopIteration:
+        header = []
+
+    index: dict[str, int] = {}
+    for field, column in mapping.items():
+        if column not in header:
+            raise ValueError(f"CSV に列 {column!r} がありません")
+        index[field] = header.index(column)
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    # reader.line_num is the last physical line consumed; the next record
+    # starts on the line after it.
+    while True:
+        start = reader.line_num + 1
+        try:
+            row = next(reader)
+        except StopIteration:
+            break
+        if not row or (len(row) == 1 and not row[0].strip()):
+            continue
+
+        row_errors: list[tuple[int, str]] = []
+        day: date | None = None
+        amount: int | None = None
+
+        try:
+            day = parse_date(_cell(row, index, "date"))
+        except ValueError:
+            row_errors.append((start, "date"))
+        try:
+            amount = parse_amount(_cell(row, index, "amount"))
+        except ValueError:
+            row_errors.append((start, "amount"))
+        category = _cell(row, index, "category").strip()
+        if not category:
+            row_errors.append((start, "category"))
+
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+
+        assert day is not None and amount is not None
+        if category_map is not None and category in category_map:
+            category = category_map[category]
+        memo = _cell(row, index, "memo").strip() if "memo" in index else ""
+        expenses.append(Expense(day=day, category=category, amount=amount, memo=memo))
+
+    return expenses, errors
