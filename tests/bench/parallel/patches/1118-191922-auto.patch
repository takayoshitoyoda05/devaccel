+from __future__ import annotations
+
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.streak import longest_no_spend_streak
+
+
+def _e(day: date, amount: int = 100) -> Expense:
+    return Expense(day=day, category="食費", amount=amount)
+
+
+def test_no_rows_counts_whole_range() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 1), date(2026, 1, 7)) == 7
+
+
+def test_single_day_without_spend_is_one() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 5), date(2026, 1, 5)) == 1
+
+
+def test_single_day_with_spend_is_zero() -> None:
+    rows = [_e(date(2026, 1, 5))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 5), date(2026, 1, 5)) == 0
+
+
+def test_every_day_has_spend_is_zero() -> None:
+    rows = [_e(date(2026, 1, d)) for d in range(1, 4)]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 3)) == 0
+
+
+def test_spend_in_middle_splits_run() -> None:
+    rows = [_e(date(2026, 1, 3))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 5)) == 2
+
+
+def test_spend_on_start_day_excluded_from_run() -> None:
+    rows = [_e(date(2026, 1, 1))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 4)) == 3
+
+
+def test_spend_on_end_day_excluded_from_run() -> None:
+    rows = [_e(date(2026, 1, 4))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 4)) == 3
+
+
+def test_longest_of_multiple_runs_is_chosen() -> None:
+    rows = [_e(date(2026, 1, 2)), _e(date(2026, 1, 6))]
+    # runs: 1 (day 1), 3 (days 3-5), 2 (days 7-8)
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 8)) == 3
+
+
+def test_multiple_expenses_same_day_count_as_one_spend_day() -> None:
+    rows = [_e(date(2026, 1, 2), 100), _e(date(2026, 1, 2), 200)]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 3)) == 1
+
+
+def test_expenses_outside_range_are_ignored() -> None:
+    rows = [_e(date(2025, 12, 31)), _e(date(2026, 1, 10))]
+    assert longest_no_spend_streak(rows, date(2026, 1, 1), date(2026, 1, 5)) == 5
+
+
+def test_start_after_end_returns_zero() -> None:
+    assert longest_no_spend_streak([], date(2026, 1, 5), date(2026, 1, 1)) == 0
diff --git a/tests/test_topn.py b/tests/test_topn.py
