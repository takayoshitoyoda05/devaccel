diff --git a/tests/test_types/test_Choice.py b/tests/test_types/test_Choice.py
index c34f516..53e6243 100644
--- a/tests/test_types/test_Choice.py
+++ b/tests/test_types/test_Choice.py
@@ -5,3 +5,46 @@ def test_choice_get_invalid_choice_message():
     choice = click.Choice(["a", "b", "c"])
     message = choice.get_invalid_choice_message("d", ctx=None)
     assert message == "'d' is not one of 'a', 'b', 'c'."
+
+
+def test_choice_suggests_single_close_match():
+    choice = click.Choice(["apple", "banana", "cherry"])
+    message = choice.get_invalid_choice_message("appel", ctx=None)
+    assert message == (
+        "'appel' is not one of 'apple', 'banana', 'cherry'. Did you mean 'apple'?"
+    )
+
+
+def test_choice_suggests_multiple_close_matches():
+    choice = click.Choice(["declare", "refine", "push"])
+    message = choice.get_invalid_choice_message("decline", ctx=None)
+    assert message.endswith("(Did you mean one of: 'declare', 'refine'?)")
+
+
+def test_choice_no_suggestion_when_nothing_close():
+    choice = click.Choice(["a", "b", "c"])
+    assert "Did you mean" not in choice.get_invalid_choice_message("zzz", ctx=None)
+
+
+def test_choice_suggestion_ignores_case_when_insensitive():
+    choice = click.Choice(["Apple", "Banana"], case_sensitive=False)
+    message = choice.get_invalid_choice_message("APPEL", ctx=None)
+    assert message.endswith("Did you mean 'apple'?")
+
+
+def test_choice_suggestion_non_str_value():
+    choice = click.Choice(["10", "20"])
+    assert "Did you mean '10'?" in choice.get_invalid_choice_message(101, ctx=None)
+
+
+def test_choice_suggestion_in_cli():
+    @click.command()
+    @click.option("--fruit", type=click.Choice(["apple", "banana"]))
+    def cli(fruit):
+        pass
+
+    from click.testing import CliRunner
+
+    result = CliRunner().invoke(cli, ["--fruit", "bananna"])
+    assert result.exit_code == 2
+    assert "Did you mean 'banana'?" in result.output
