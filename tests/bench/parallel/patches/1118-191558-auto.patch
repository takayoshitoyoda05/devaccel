+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,93 @@
+"""Month-over-month comparison of expenses by category (pure functions)."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not isinstance(month, str) or not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def _month_of(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+
+    prev_totals: dict[str, int] = {}
+    curr_totals: dict[str, int] = {}
+    prev_seen: set[str] = set()
+    curr_seen: set[str] = set()
+    for e in rows:
+        m = _month_of(e)
+        if m == prev_month:
+            prev_totals[e.category] = prev_totals.get(e.category, 0) + e.amount
+            prev_seen.add(e.category)
+        elif m == curr_month:
+            curr_totals[e.category] = curr_totals.get(e.category, 0) + e.amount
+            curr_seen.add(e.category)
+
+    out: list[DiffRow] = []
+    for cat in prev_seen | curr_seen:
+        prev = prev_totals.get(cat, 0)
+        curr = curr_totals.get(cat, 0)
+        delta = curr - prev
+        pct = None if prev == 0 else round(delta / prev * 100, 1) + 0.0
+        if cat not in prev_seen:
+            status = "new"
+        elif cat not in curr_seen:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+
+    out.sort(key=lambda r: (-abs(r.delta), r.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [r for r in diffs if r.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for r in diffs:
+        pct = "-" if r.pct is None else f"{r.pct:+.1f}%"
+        lines.append(f"{r.category}\t{r.prev}\t{r.curr}\t{r.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month_of(e) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には月が 2 つ以上必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..ccd2969
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,187 @@
+"""Search query language for expense rows.
+
+Grammar (lowest precedence first)::
+
+    or_expr  := and_expr ("OR" and_expr)*
+    and_expr := not_expr (["AND"] not_expr)*
+    not_expr := "NOT" not_expr | primary
+    primary  := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+Token = tuple[str, str]
+
+_WORD_STOPS = frozenset(' \t\r\n\f\v()"')
+_OPERATORS = {"AND": "AND", "OR": "OR", "NOT": "NOT"}
+
+
+class QueryError(ValueError):
+    """Raised when a search query cannot be tokenized or parsed."""
+
+
+def tokenize(q: str) -> list[Token]:
+    tokens: list[Token] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError(f"閉じられていない引用符があります: {q!r}")
+            body = q[i + 1 : end]
+            if body == "":
+                raise QueryError("空の引用符は使えません")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            start = i
+            while i < n and q[i] not in _WORD_STOPS:
+                i += 1
+            word = q[start:i]
+            if word in _OPERATORS:
+                tokens.append((_OPERATORS[word], word))
+            elif word.startswith("cat:"):
+                value = word[len("cat:") :]
+                if value == "":
+                    raise QueryError("cat: の後ろにカテゴリ名がありません")
+                tokens.append(("CAT", value))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+@dataclass(frozen=True)
+class _Term:
+    value: str
+
+
+@dataclass(frozen=True)
+class _Cat:
+    value: str
+
+
+@dataclass(frozen=True)
+class _Not:
+    operand: _Node
+
+
+@dataclass(frozen=True)
+class _And:
+    left: _Node
+    right: _Node
+
+
+@dataclass(frozen=True)
+class _Or:
+    left: _Node
+    right: _Node
+
+
+_Node = _Term | _Cat | _Not | _And | _Or
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self._tokens = tokens
+        self._pos = 0
+
+    def _peek_kind(self) -> str | None:
+        if self._pos < len(self._tokens):
+            return self._tokens[self._pos][0]
+        return None
+
+    def _next(self) -> Token:
+        tok = self._tokens[self._pos]
+        self._pos += 1
+        return tok
+
+    def parse(self) -> _Node:
+        if not self._tokens:
+            raise QueryError("検索条件が空です")
+        node = self._or_expr()
+        if self._pos != len(self._tokens):
+            raise QueryError(
+                f"想定外のトークンがあります: {self._tokens[self._pos][1]!r}"
+            )
+        return node
+
+    def _or_expr(self) -> _Node:
+        node = self._and_expr()
+        while self._peek_kind() == "OR":
+            self._next()
+            node = _Or(node, self._and_expr())
+        return node
+
+    def _and_expr(self) -> _Node:
+        node = self._not_expr()
+        while True:
+            kind = self._peek_kind()
+            if kind == "AND":
+                self._next()
+                node = _And(node, self._not_expr())
+            elif kind in ("TERM", "CAT", "NOT", "LPAREN"):
+                node = _And(node, self._not_expr())
+            else:
+                return node
+
+    def _not_expr(self) -> _Node:
+        if self._peek_kind() == "NOT":
+            self._next()
+            return _Not(self._not_expr())
+        return self._primary()
+
+    def _primary(self) -> _Node:
+        kind = self._peek_kind()
+        if kind == "TERM":
+            return _Term(self._next()[1].casefold())
+        if kind == "CAT":
+            return _Cat(self._next()[1].casefold())
+        if kind == "LPAREN":
+            self._next()
+            node = self._or_expr()
+            if self._peek_kind() != "RPAREN":
+                raise QueryError("対応する ')' がありません")
+            self._next()
+            return node
+        if kind is None:
+            raise QueryError("演算子の後ろに項がありません")
+        raise QueryError(f"項が必要な位置に {self._tokens[self._pos][1]!r} があります")
+
+
+def _parse(q: str) -> _Node:
+    return _Parser(tokenize(q)).parse()
+
+
+def _eval(node: _Node, e: Expense) -> bool:
+    if isinstance(node, _Term):
+        return node.value in e.memo.casefold() or node.value in e.category.casefold()
+    if isinstance(node, _Cat):
+        return node.value == e.category.casefold()
+    if isinstance(node, _Not):
+        return not _eval(node.operand, e)
+    if isinstance(node, _And):
+        return _eval(node.left, e) and _eval(node.right, e)
+    return _eval(node.left, e) or _eval(node.right, e)
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _eval(_parse(q), e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    node = _parse(q)  # 不正なクエリは rows が空でもエラーにする
+    return [e for e in rows if _eval(node, e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..20fdfaa
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,67 @@
+"""Detect recurring expenses (same category and amount, roughly monthly)."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day of the next month, clamped to that month's last day."""
+    year = d.year + d.month // 12
+    month = d.month % 12 + 1
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def _runs(days: list[date], tolerance: int) -> list[list[date]]:
+    """Split sorted, unique dates into maximal runs where neighbours are linked."""
+    runs: list[list[date]] = []
+    for d in days:
+        if runs:
+            prev = runs[-1][-1]
+            if abs((d - add_month(prev)).days) <= tolerance:
+                runs[-1].append(d)
+                continue
+        runs.append([d])
+    return runs
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError(f"min_count は 2 以上である必要があります: {min_count}")
+    if tolerance < 0:
+        raise ValueError(f"tolerance は 0 以上である必要があります: {tolerance}")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    out: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        for run in _runs(sorted(day_set), tolerance):
+            if len(run) >= min_count:
+                out.append(
+                    Recurring(
+                        category=category,
+                        amount=amount,
+                        days=tuple(run),
+                        next_expected=add_month(run[-1]),
+                    )
+                )
+
+    out.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return out
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..e6f7896
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,259 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+# --- parse_amount ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("-980円", -980),
+        ("¥1000", 1000),
+        ("1,234円", 1234),
+        ("1,,2", 12),  # comma positions are not checked
+        ("-0", 0),
+    ],
+)
+def test_parse_amount_accepts(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "   ",
+        "円",
+        "12.5",
+        "1 200",
+        "--5",
+        "¥-5",
+        "１２３",
+        "-",
+        "¥",
+        ",",
+        "円円",
+        "5円円",
+        "円300",
+        "¥ 300",
+        "1¥",
+        "+5",
+    ],
+)
+def test_parse_amount_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+# --- parse_date -----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/1/5 ", date(2026, 1, 5)),
+        ("2026/1/05", date(2026, 1, 5)),
+        ("2026-12-31", date(2026, 12, 31)),
+        ("2024/2/29", date(2024, 2, 29)),
+    ],
+)
+def test_parse_date_accepts(text: str, expected: date) -> None:
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026/1-5",
+        "2026-1/5",
+        "26/1/5",
+        "2026/02/30",
+        "2026/2/29",
+        "2026/13/1",
+        "2026/0/1",
+        "２０２６/1/5",
+        "2026//1",
+        "2026/1/5/",
+        "2026/001/5",
+        "",
+        "2026.1.5",
+        "2026/1",
+    ],
+)
+def test_parse_date_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+# --- import_rows ----------------------------------------------------------
+
+HEADER = "利用日,分類,利用金額,利用店名"
+
+
+def test_default_mapping_is_expected() -> None:
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_import_basic_default_mapping() -> None:
+    text = f'{HEADER}\n2026/1/5,食費,"1,200円",スーパー A\n'
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 1200, "スーパー A")]
+
+
+def test_explicit_none_mapping_uses_default() -> None:
+    text = f"{HEADER}\n2026-1-5,食費,300,x\n"
+    rows, errors = import_rows(text, None)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 300, "x")]
+
+
+def test_quoted_field_with_comma_and_extra_columns_ignored() -> None:
+    text = '余分,利用日,分類,利用金額,利用店名\nz,2026/1/5,"交通費, 都内","100,円","a, b"\n'
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "交通費, 都内", 100, "a, b")]
+
+
+def test_extra_columns_after_header_ignored() -> None:
+    text = f"{HEADER},余分\n2026/1/5,食費,10,m,zzz\n"
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 10, "m")]
+
+
+def test_values_are_stripped() -> None:
+    text = f"{HEADER}\n 2026/1/5 , 食費 , 10 , 店 \n"
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 10, "店")]
+
+
+def test_category_map_replaces_stripped_category() -> None:
+    text = f"{HEADER}\n2026/1/5, 食費 ,10,a\n2026/1/6,交通,20,b\n"
+    rows, errors = import_rows(text, category_map={"食費": "Food"})
+    assert errors == []
+    assert [r.category for r in rows] == ["Food", "交通"]
+
+
+def test_category_map_not_applied_to_memo() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,10,食費\n"
+    rows, _ = import_rows(text, category_map={"食費": "Food"})
+    assert rows[0].memo == "食費"
+
+
+def test_memo_optional_in_mapping_defaults_to_empty() -> None:
+    mapping = {"date": "利用日", "category": "分類", "amount": "利用金額"}
+    text = f"{HEADER}\n2026/1/5,食費,10,店\n"
+    rows, errors = import_rows(text, mapping)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 10, "")]
+
+
+def test_mapping_missing_required_key_raises() -> None:
+    for key in ("date", "category", "amount"):
+        mapping = {k: v for k, v in DEFAULT_MAPPING.items() if k != key}
+        with pytest.raises(ValueError):
+            import_rows(f"{HEADER}\n", mapping)
+
+
+def test_mapping_column_not_in_header_raises() -> None:
+    mapping = {**DEFAULT_MAPPING, "amount": "存在しない列"}
+    with pytest.raises(ValueError):
+        import_rows(f"{HEADER}\n2026/1/5,食費,10,x\n", mapping)
+
+
+def test_mapping_memo_column_not_in_header_raises() -> None:
+    mapping = {**DEFAULT_MAPPING, "memo": "無い"}
+    with pytest.raises(ValueError):
+        import_rows(f"{HEADER}\n", mapping)
+
+
+def test_custom_mapping_uses_given_column_names() -> None:
+    mapping = {"date": "D", "category": "C", "amount": "A", "memo": "M"}
+    text = "A,C,D,M\n500,食費,2026/3/1,hi\n"
+    rows, errors = import_rows(text, mapping)
+    assert errors == []
+    assert rows == [Expense(date(2026, 3, 1), "食費", 500, "hi")]
+
+
+def test_blank_lines_skipped_but_counted() -> None:
+    text = f"{HEADER}\n\n2026/1/5,食費,10,a\n\n\nbad,食費,10,b\n"
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 10, "a")]
+    assert errors == [(6, "date")]
+
+
+def test_error_line_numbers_are_physical() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,x,a\n2026/1/6,食費,20,b\n"
+    rows, errors = import_rows(text)
+    assert errors == [(2, "amount")]
+    assert rows == [Expense(date(2026, 1, 6), "食費", 20, "b")]
+
+
+def test_multiple_errors_in_one_row_recorded_in_order() -> None:
+    text = f"{HEADER}\nbad,  ,x,m\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "date"), (2, "amount"), (2, "category")]
+
+
+def test_empty_category_is_error() -> None:
+    text = f"{HEADER}\n2026/1/5,   ,10,m\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "category")]
+
+
+def test_row_with_error_excluded_others_kept_in_order() -> None:
+    text = f"{HEADER}\n2026/1/1,食費,1,a\n2026/1/2,食費,zz,b\n2026/1/3,交通,3,c\n"
+    rows, errors = import_rows(text)
+    assert [r.memo for r in rows] == ["a", "c"]
+    assert errors == [(3, "amount")]
+
+
+def test_short_row_missing_values_treated_as_empty() -> None:
+    text = f"{HEADER}\n2026/1/5,食費\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "amount")]
+
+
+def test_short_row_missing_memo_is_empty_string() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,10\n"
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 10, "")]
+
+
+def test_quoted_multiline_field_keeps_line_numbers_for_later_rows() -> None:
+    text = f'{HEADER}\n2026/1/5,食費,10,"a\nb"\nbad,食費,10,c\n'
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 10, "a\nb")]
+    assert errors == [(4, "date")]
+
+
+def test_empty_text_raises_for_missing_columns() -> None:
+    with pytest.raises(ValueError):
+        import_rows("")
+
+
+def test_header_only_returns_nothing() -> None:
+    rows, errors = import_rows(f"{HEADER}\n")
+    assert rows == []
+    assert errors == []
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..0aa2fb1
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,303 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def e(day: str, cat: str, amount: int) -> Expense:
+    return Expense(date.fromisoformat(day), cat, amount)
+
+
+ROWS = [
+    e("2026-01-05", "food", 1000),
+    e("2026-01-20", "food", 500),
+    e("2026-01-10", "rent", 5000),
+    e("2026-01-11", "fun", 300),
+    e("2026-02-03", "food", 1800),
+    e("2026-02-09", "rent", 5000),
+    e("2026-02-12", "tax", 700),
+    e("2026-02-13", "cafe", 0),
+]
+
+
+def by_cat(rows: list[DiffRow]) -> dict[str, DiffRow]:
+    return {r.category: r for r in rows}
+
+
+# --- month_diff: 月の形式 ---
+
+
+@pytest.mark.parametrize(
+    "prev,curr",
+    [
+        ("2026-1", "2026-02"),
+        ("2026-01", "2026-13"),
+        ("2026-00", "2026-02"),
+        ("2026/01", "2026-02"),
+        ("26-01", "2026-02"),
+        ("2026-01", "2026-02 "),
+        ("", "2026-02"),
+    ],
+)
+def test_invalid_month_raises(prev: str, curr: str) -> None:
+    with pytest.raises(ValueError):
+        month_diff(ROWS, prev, curr)
+
+
+def test_invalid_month_raises_even_without_rows() -> None:
+    with pytest.raises(ValueError):
+        month_diff([], "2026-1", "2026-02")
+
+
+def test_month_diff_empty_rows_gives_empty_list() -> None:
+    assert month_diff([], "2026-01", "2026-02") == []
+
+
+# --- month_diff: 行・合計・delta・pct ---
+
+
+def test_one_row_per_category_in_either_month() -> None:
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    assert sorted(r.category for r in diffs) == ["cafe", "food", "fun", "rent", "tax"]
+
+
+def test_totals_and_delta() -> None:
+    rows = by_cat(month_diff(ROWS, "2026-01", "2026-02"))
+    assert rows["food"] == DiffRow("food", 1500, 1800, 300, 20.0, "up")
+    assert rows["rent"] == DiffRow("rent", 5000, 5000, 0, 0.0, "same")
+
+
+def test_missing_side_counts_as_zero() -> None:
+    rows = by_cat(month_diff(ROWS, "2026-01", "2026-02"))
+    assert rows["fun"] == DiffRow("fun", 300, 0, -300, -100.0, "gone")
+    assert rows["tax"] == DiffRow("tax", 0, 700, 700, None, "new")
+
+
+def test_pct_is_rounded_to_one_decimal() -> None:
+    rows = [e("2026-01-01", "x", 3), e("2026-02-01", "x", 4)]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    assert r.pct == round(1 / 3 * 100, 1) == 33.3
+
+
+def test_pct_none_when_prev_total_is_zero_with_entries() -> None:
+    rows = [e("2026-01-01", "x", 0), e("2026-02-01", "x", 300)]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    assert r.prev == 0
+    assert r.pct is None
+    assert r.status == "up"
+
+
+def test_pct_zero_delta_is_positive_zero() -> None:
+    rows = [e("2026-01-01", "x", 0), e("2026-02-01", "x", 0)]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    assert r.pct is None
+    assert r.status == "same"
+
+
+def test_pct_zero_delta_with_nonzero_prev() -> None:
+    rows = [e("2026-01-01", "x", 100), e("2026-02-01", "x", 100)]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    assert str(r.pct) == "0.0"
+
+
+# --- month_diff: status は明細の有無で判定 ---
+
+
+def test_status_new_and_gone_by_presence() -> None:
+    rows = [e("2026-01-01", "a", 100), e("2026-02-01", "b", 100)]
+    got = by_cat(month_diff(rows, "2026-01", "2026-02"))
+    assert got["a"].status == "gone"
+    assert got["b"].status == "new"
+
+
+def test_status_down() -> None:
+    rows = [e("2026-01-01", "a", 500), e("2026-02-01", "a", 200)]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    assert (r.delta, r.status, r.pct) == (-300, "down", -60.0)
+
+
+def test_status_same_when_entries_exist_on_both_sides_with_equal_totals() -> None:
+    rows = [
+        e("2026-01-01", "a", 100),
+        e("2026-02-01", "a", 50),
+        e("2026-02-02", "a", 50),
+    ]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    assert r.status == "same"
+    assert r.delta == 0
+
+
+def test_status_uses_presence_not_zero_total() -> None:
+    # curr の明細が合計 0 でも「gone」にはならない(明細がある)
+    rows = [
+        e("2026-01-01", "a", 100),
+        e("2026-02-01", "a", 50),
+        e("2026-02-02", "a", -50),
+    ]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    assert r.curr == 0
+    assert r.status == "down"
+    assert r.pct == -100.0
+
+
+def test_zero_amount_entry_on_one_side_is_not_gone() -> None:
+    rows = [e("2026-01-01", "a", 100), e("2026-02-01", "a", 0)]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    assert r.status == "down"
+    assert r.pct == -100.0
+
+
+def test_other_months_are_ignored() -> None:
+    rows = [
+        e("2025-12-31", "a", 9999),
+        e("2026-01-01", "a", 100),
+        e("2026-03-01", "b", 9),
+    ]
+    got = month_diff(rows, "2026-01", "2026-02")
+    assert got == [DiffRow("a", 100, 0, -100, -100.0, "gone")]
+
+
+# --- month_diff: 並び順 ---
+
+
+def test_sorted_by_abs_delta_desc_then_category_asc() -> None:
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    # |delta|: tax 700, food 300 / fun 300 (category 昇順で food が先), cafe 0 / rent 0
+    assert [r.category for r in diffs] == ["tax", "food", "fun", "cafe", "rent"]
+
+
+def test_sort_ties_broken_by_category_asc() -> None:
+    rows = [e("2026-01-01", "b", 100), e("2026-02-01", "a", 100)]
+    diffs = month_diff(rows, "2026-01", "2026-02")
+    # |delta| は両方 100。category 昇順
+    assert [r.category for r in diffs] == ["a", "b"]
+
+
+def test_sort_uses_abs_delta() -> None:
+    rows = [
+        e("2026-01-01", "a", 1000),
+        e("2026-02-01", "a", 0),  # delta -1000
+        e("2026-01-01", "b", 0),
+        e("2026-02-01", "b", 600),  # delta +600
+    ]
+    diffs = month_diff(rows, "2026-01", "2026-02")
+    assert [r.category for r in diffs] == ["a", "b"]
+
+
+# --- top_movers ---
+
+
+def test_top_movers_excludes_same_and_takes_first_n() -> None:
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    got = top_movers(diffs, 2)
+    assert [r.category for r in got] == ["tax", "food"]
+
+
+def test_top_movers_default_n_is_3() -> None:
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    # rent(same) を除くと tax, food, fun, cafe の 4 件 -> 先頭 3 件
+    assert [r.category for r in top_movers(diffs)] == ["tax", "food", "fun"]
+
+
+def test_top_movers_n_larger_than_available() -> None:
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    assert len(top_movers(diffs, 100)) == 4
+
+
+def test_top_movers_zero_gives_empty() -> None:
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    assert top_movers(diffs, 0) == []
+
+
+def test_top_movers_negative_raises() -> None:
+    with pytest.raises(ValueError):
+        top_movers([], -1)
+
+
+def test_top_movers_does_not_mutate_input() -> None:
+    diffs = month_diff(ROWS, "2026-01", "2026-02")
+    snapshot = list(diffs)
+    top_movers(diffs, 1)
+    assert diffs == snapshot
+
+
+# --- render_diff ---
+
+
+def test_render_header_and_rows() -> None:
+    diffs = [
+        DiffRow("food", 1500, 1800, 300, 20.0, "up"),
+        DiffRow("fun", 300, 0, -300, -100.0, "gone"),
+        DiffRow("tax", 0, 700, 700, None, "new"),
+        DiffRow("rent", 5000, 5000, 0, 0.0, "same"),
+    ]
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "food\t1500\t1800\t+300\t+20.0%\n"
+        "fun\t300\t0\t-300\t-100.0%\n"
+        "tax\t0\t700\t+700\t-\n"
+        "rent\t5000\t5000\t+0\t+0.0%"
+    )
+
+
+def test_render_no_trailing_newline() -> None:
+    out = render_diff([DiffRow("a", 1, 2, 1, 100.0, "up")])
+    assert not out.endswith("\n")
+    assert out.count("\n") == 1
+
+
+def test_render_empty_is_header_only() -> None:
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_render_negative_zero_delta_pct_is_plus() -> None:
+    out = render_diff([DiffRow("a", 100, 100, 0, 0.0, "same")])
+    assert out.splitlines()[1].endswith("\t+0\t+0.0%")
+
+
+# --- available_months ---
+
+
+def test_available_months_sorted_unique() -> None:
+    assert available_months(ROWS) == ["2026-01", "2026-02"]
+
+
+def test_available_months_across_years_and_order() -> None:
+    rows = [e("2026-02-01", "a", 1), e("2025-12-31", "a", 1), e("2026-02-28", "b", 1)]
+    assert available_months(rows) == ["2025-12", "2026-02"]
+
+
+def test_available_months_empty() -> None:
+    assert available_months([]) == []
+
+
+# --- latest_diff ---
+
+
+def test_latest_diff_uses_last_two_months() -> None:
+    rows = ROWS + [e("2026-03-01", "food", 2000)]
+    assert latest_diff(rows) == month_diff(rows, "2026-02", "2026-03")
+    assert latest_diff(rows) != month_diff(rows, "2026-01", "2026-02")
+
+
+def test_latest_diff_with_two_months() -> None:
+    assert latest_diff(ROWS) == month_diff(ROWS, "2026-01", "2026-02")
+
+
+def test_latest_diff_one_month_raises() -> None:
+    with pytest.raises(ValueError):
+        latest_diff([e("2026-01-01", "a", 1)])
+
+
+def test_latest_diff_no_rows_raises() -> None:
+    with pytest.raises(ValueError):
+        latest_diff([])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..5ad238f
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,235 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def _e(category: str, memo: str = "", amount: int = 100, day: int = 1) -> Expense:
+    return Expense(day=date(2026, 11, day), category=category, amount=amount, memo=memo)
+
+
+# --- tokenize -------------------------------------------------------------
+
+
+def test_tokenize_whitespace_only_gives_no_tokens():
+    assert tokenize("   \t ") == []
+
+
+def test_tokenize_splits_on_whitespace_and_parens():
+    assert tokenize("a(b)c") == [
+        ("TERM", "a"),
+        ("LPAREN", "("),
+        ("TERM", "b"),
+        ("RPAREN", ")"),
+        ("TERM", "c"),
+    ]
+
+
+def test_tokenize_quoted_term_keeps_spaces_and_parens():
+    assert tokenize('"外食 (ランチ)"') == [("TERM", "外食 (ランチ)")]
+
+
+def test_tokenize_quoted_term_has_no_escapes():
+    assert tokenize(r'"a\"') == [("TERM", "a\\")]
+
+
+def test_tokenize_unclosed_quote_is_error():
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_is_error():
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_operators_only_when_uppercase_exact():
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+    assert tokenize("and or not") == [("TERM", "and"), ("TERM", "or"), ("TERM", "not")]
+    assert tokenize("NOTE") == [("TERM", "NOTE")]
+
+
+def test_tokenize_quoted_operator_is_term():
+    assert tokenize('"AND"') == [("TERM", "AND")]
+
+
+def test_tokenize_cat_prefix():
+    assert tokenize("cat:食費") == [("CAT", "食費")]
+
+
+def test_tokenize_cat_prefix_is_case_sensitive():
+    assert tokenize("CAT:食費") == [("TERM", "CAT:食費")]
+
+
+def test_tokenize_empty_cat_is_error():
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+    with pytest.raises(QueryError):
+        tokenize("cat:(")
+
+
+def test_tokenize_cat_followed_by_quote_has_empty_value():
+    # 語は引用符の手前で終わるので、cat: の後ろは空 -> エラー
+    with pytest.raises(QueryError):
+        tokenize('cat:"食費"')
+
+
+def test_tokenize_cat_value_stops_at_whitespace():
+    assert tokenize("cat:食費 ランチ") == [("CAT", "食費"), ("TERM", "ランチ")]
+
+
+# --- parsing / errors -----------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(a",
+        "a)",
+        ")a(",
+        "a OR",
+        "OR a",
+        "AND a",
+        "a AND AND b",
+        "a OR OR b",
+        "NOT",
+        "a AND",
+        "(a OR)",
+    ],
+)
+def test_invalid_queries_raise(q):
+    with pytest.raises(QueryError):
+        matches(q, _e("食費"))
+
+
+def test_invalid_query_raises_even_with_empty_rows():
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
+
+
+def test_valid_query_with_empty_rows_returns_empty():
+    assert filter_rows("食費", []) == []
+
+
+# --- evaluation -----------------------------------------------------------
+
+
+def test_term_matches_memo_substring():
+    assert matches("ランチ", _e("食費", memo="昼ランチ代"))
+
+
+def test_term_matches_category_substring():
+    assert matches("食", _e("食費"))
+
+
+def test_term_does_not_match_amount_or_date():
+    assert not matches("100", _e("食費", amount=100))
+    assert not matches("2026", _e("食費"))
+
+
+def test_term_with_empty_memo_matches_category_only():
+    assert matches("食費", _e("食費", memo=""))
+    assert not matches("x", _e("食費", memo=""))
+
+
+def test_cat_is_exact_match_on_category():
+    assert matches("cat:食費", _e("食費"))
+    assert not matches("cat:食", _e("食費"))
+    assert not matches("cat:食費", _e("食費2"))
+
+
+def test_cat_does_not_match_memo():
+    assert not matches("cat:ランチ", _e("食費", memo="ランチ"))
+
+
+def test_comparison_is_casefold():
+    assert matches("CAFÉ", _e("café"))
+    assert matches("café", _e("CAFÉ"))
+    assert matches("cat:transport", _e("Transport"))
+    assert matches("STRASSE", _e("Straße"))
+
+
+def test_quoted_term_with_space_matches_memo():
+    assert matches('"外食 ランチ"', _e("食費", memo="外食 ランチ"))
+    assert not matches('"外食 ランチ"', _e("食費", memo="外食ランチ"))
+
+
+def test_and_implicit_and_explicit():
+    e = _e("食費", memo="ランチ")
+    assert matches("食費 ランチ", e)
+    assert matches("食費 AND ランチ", e)
+    assert not matches("食費 AND 夕食", e)
+
+
+def test_or():
+    e = _e("食費", memo="ランチ")
+    assert matches("夕食 OR ランチ", e)
+    assert not matches("夕食 OR 交通", e)
+
+
+def test_not():
+    e = _e("食費", memo="ランチ")
+    assert not matches("NOT 食費", e)
+    assert matches("NOT 交通", e)
+    assert matches("NOT NOT 食費", e)
+
+
+def test_precedence_and_binds_tighter_than_or():
+    # a OR (b AND c)
+    assert matches("a OR b c", _e("a"))
+    assert matches("a OR b c", _e("b", memo="c"))
+    assert not matches("a OR b c", _e("b"))
+
+
+def test_precedence_not_binds_tighter_than_and():
+    # (NOT a) AND b
+    assert matches("NOT a b", _e("b"))
+    assert not matches("NOT a b", _e("a", memo="b"))
+
+
+def test_parentheses_override_precedence():
+    # (a OR b) AND c
+    assert not matches("(a OR b) c", _e("a"))
+    assert matches("(a OR b) c", _e("a", memo="c"))
+
+
+def test_nested_parentheses():
+    assert matches("((食費))", _e("食費"))
+
+
+def test_not_applies_to_parenthesised_group():
+    assert not matches("NOT (食費 OR 交通)", _e("交通"))
+    assert matches("NOT (食費 OR 交通)", _e("医療"))
+
+
+def test_lowercase_and_is_a_term_not_operator():
+    assert matches("食費 and", _e("食費", memo="and"))
+    assert not matches("食費 and", _e("食費", memo=""))
+
+
+# --- filter_rows ----------------------------------------------------------
+
+
+def test_filter_rows_keeps_input_order():
+    rows = [
+        _e("食費", memo="ランチ", day=3),
+        _e("交通", day=1),
+        _e("食費", memo="夕食", day=2),
+    ]
+    assert filter_rows("食費", rows) == [rows[0], rows[2]]
+
+
+def test_filter_rows_no_match_returns_empty_list():
+    assert filter_rows("cat:医療", [_e("食費")]) == []
+
+
+def test_filter_rows_does_not_mutate_input():
+    rows = [_e("食費"), _e("交通")]
+    before = list(rows)
+    filter_rows("食費", rows)
+    assert rows == before
