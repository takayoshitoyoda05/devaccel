+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+@pytest.mark.parametrize(
+    "src, expected",
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2024, 1, 31), date(2024, 2, 29)),
+        (date(2026, 12, 15), date(2027, 1, 15)),
+        (date(2026, 4, 30), date(2026, 5, 30)),
+        (date(2026, 5, 31), date(2026, 6, 30)),
+        (date(2026, 11, 1), date(2026, 12, 1)),
+    ],
+)
+def test_add_month(src, expected):
+    assert add_month(src) == expected
+
+
+def _e(day, amount=1000, category="rent", memo=""):
+    return Expense(day, category, amount, memo)
+
+
+def test_empty_input_returns_empty():
+    assert find_recurring([]) == []
+
+
+def test_basic_monthly_detected():
+    rows = [_e(date(2026, 1, 5)), _e(date(2026, 2, 5)), _e(date(2026, 3, 5))]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="rent",
+            amount=1000,
+            days=(date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+            next_expected=date(2026, 4, 5),
+        )
+    ]
+
+
+def test_below_min_count_not_reported():
+    rows = [_e(date(2026, 1, 5)), _e(date(2026, 2, 5))]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_count=2)) == 1
+
+
+def test_min_count_below_two_raises():
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=0)
+
+
+def test_negative_tolerance_raises():
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_tolerance_zero_is_exact_only():
+    exact = [_e(date(2026, 1, 5)), _e(date(2026, 2, 5)), _e(date(2026, 3, 5))]
+    off = [_e(date(2026, 1, 5)), _e(date(2026, 2, 6)), _e(date(2026, 3, 6))]
+    assert len(find_recurring(exact, tolerance=0)) == 1
+    assert find_recurring(off, tolerance=0) == []
+
+
+def test_tolerance_boundary_inclusive():
+    # add_month(2026-01-05) = 2026-02-05; 2026-02-08 is 3 days off.
+    rows = [_e(date(2026, 1, 5)), _e(date(2026, 2, 8)), _e(date(2026, 3, 8))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+    # 2026-02-09 is 4 days off -> chain breaks, nothing reaches min_count 3.
+    rows = [_e(date(2026, 1, 5)), _e(date(2026, 2, 9)), _e(date(2026, 3, 9))]
+    assert find_recurring(rows, tolerance=3) == []
+
+
+def test_month_end_chain_uses_clamped_date():
+    rows = [_e(date(2026, 1, 31)), _e(date(2026, 2, 28)), _e(date(2026, 3, 28))]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 28)
+
+
+def test_duplicate_dates_removed():
+    rows = [
+        _e(date(2026, 1, 5)),
+        _e(date(2026, 1, 5)),
+        _e(date(2026, 2, 5)),
+        _e(date(2026, 3, 5)),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_duplicates_do_not_count_toward_min_count():
+    rows = [_e(date(2026, 1, 5)), _e(date(2026, 1, 5)), _e(date(2026, 2, 5))]
+    assert find_recurring(rows) == []
+
+
+def test_memo_is_ignored_for_grouping():
+    rows = [
+        _e(date(2026, 1, 5), memo="a"),
+        _e(date(2026, 2, 5), memo=""),
+        _e(date(2026, 3, 5), memo="c"),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_different_amount_or_category_grouped_apart():
+    rows = [
+        _e(date(2026, 1, 5), amount=1000),
+        _e(date(2026, 2, 5), amount=1000),
+        _e(date(2026, 3, 5), amount=2000),
+        _e(date(2026, 1, 6), category="food"),
+        _e(date(2026, 2, 6), category="food"),
+        _e(date(2026, 3, 6), category="food"),
+    ]
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [("food", 1000)]
+
+
+def test_unsorted_input_sorted_in_output():
+    rows = [_e(date(2026, 3, 5)), _e(date(2026, 1, 5)), _e(date(2026, 2, 5))]
+    (r,) = find_recurring(rows)
+    assert r.days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_gap_splits_runs_and_only_long_enough_kept():
+    # Run A: Jan-Mar (3 items). Gap in April. Run B: Jun-Jul (2 items, too short).
+    rows = [
+        _e(date(2026, 1, 5)),
+        _e(date(2026, 2, 5)),
+        _e(date(2026, 3, 5)),
+        _e(date(2026, 6, 5)),
+        _e(date(2026, 7, 5)),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_gap_splits_into_two_qualifying_runs():
+    rows = [_e(date(2026, m, 5)) for m in (1, 2, 3, 6, 7, 8)]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 5), date(2026, 6, 5)]
+    assert result[0].next_expected == date(2026, 4, 5)
+    assert result[1].next_expected == date(2026, 9, 5)
+
+
+def test_run_is_maximal_not_overlapping():
+    rows = [_e(date(2026, m, 5)) for m in (1, 2, 3, 4)]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert len(result[0].days) == 4
+
+
+def test_result_sorted_by_category_amount_first_day():
+    rows = []
+    for m in (1, 2, 3):
+        rows.append(_e(date(2026, m, 5), category="b", amount=5))
+        rows.append(_e(date(2026, m, 6), category="a", amount=9))
+        rows.append(_e(date(2026, m, 7), category="a", amount=2))
+    result = [(r.category, r.amount) for r in find_recurring(rows)]
+    assert result == [("a", 2), ("a", 9), ("b", 5)]
