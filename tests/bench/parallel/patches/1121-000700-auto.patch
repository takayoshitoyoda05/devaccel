@@ -0,0 +1,141 @@
+"""Detect monthly recurring expenses (subscriptions, rent...) and predict the next date.
+
+Pure functions only: no I/O, no dependency beyond the standard library.
+
+Decisions (edge cases):
+D1: Same series = same category + same normalized memo + similar amount.
+    Memo normalization: NFKC, casefold, whitespace collapsed, one trailing
+    number removed (`Netflix #3` / `Netflix 3` -> `netflix`). Empty memos group together.
+D2: Amounts are the same series when within `tolerance` (default 10%) of the
+    cluster's smallest amount. A bigger price change starts a new cluster.
+D3: Zero and negative amounts (refunds) are ignored; they never join a series.
+D4: Two series with the same category/amount (e.g. on the 5th and the 20th)
+    are separated into "lanes": one occurrence per month per series.
+D5: A series needs `min_occurrences` (default 3, must be >= 2) occurrences in
+    consecutive months. A missing month breaks the run; only the latest run
+    counts, so a lapsed-then-resumed subscription is judged by its latest run.
+D6: Days of month in the run must stay within MAX_DAY_SPREAD (7) days of each
+    other, otherwise it is irregular spending, not a fixed monthly payment.
+D7: Next date = month after the latest occurrence, on the largest day of month
+    seen in the run, clamped to that month's last day (31, 31, 28 -> next 03-31;
+    Jan-31 -> Feb-28/29, leap years respected, Dec -> Jan of next year).
+D8: Amount reported is the latest amount of the run.
+D9: Result order: next_date, then category, memo, amount (deterministic).
+D10: Empty input or no series returns an empty list.
+"""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+MAX_DAY_SPREAD = 7
+_TRAILING_NUMBER = re.compile(r"[\s#]*[0-9]+$")
+
+
+@dataclass(frozen=True)
+class RecurringExpense:
+    category: str
+    memo: str  # latest raw memo of the run
+    amount: int  # latest amount (yen)
+    occurrences: int  # length of the latest consecutive-month run
+    last_date: date
+    next_date: date
+
+
+def normalize_memo(memo: str) -> str:
+    s = unicodedata.normalize("NFKC", memo).casefold()
+    s = " ".join(s.split())
+    return _TRAILING_NUMBER.sub("", s).strip()
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month - 1
+
+
+def _clusters(items: list[Expense], tolerance: float) -> list[list[Expense]]:
+    out: list[list[Expense]] = []
+    anchor = 0
+    for e in sorted(items, key=lambda x: (x.amount, x.day)):
+        if out and e.amount <= anchor * (1 + tolerance):
+            out[-1].append(e)
+        else:
+            out.append([e])
+            anchor = e.amount
+    return out
+
+
+def _lanes(items: list[Expense]) -> list[list[Expense]]:
+    lanes: list[list[Expense]] = []
+    for e in sorted(items, key=lambda x: x.day):
+        for lane in lanes:
+            if _month_index(lane[-1].day) < _month_index(e.day):
+                lane.append(e)
+                break
+        else:
+            lanes.append([e])
+    return lanes
+
+
+def _latest_run(lane: list[Expense]) -> list[Expense]:
+    run = [lane[-1]]
+    for e in reversed(lane[:-1]):
+        if _month_index(run[0].day) - _month_index(e.day) == 1:
+            run.insert(0, e)
+        else:
+            break
+    return run
+
+
+def _next_date(run: list[Expense]) -> date:
+    last = run[-1].day
+    idx = _month_index(last) + 1
+    year, month = divmod(idx, 12)
+    month += 1
+    day = min(max(e.day.day for e in run), calendar.monthrange(year, month)[1])
+    return date(year, month, day)
+
+
+def find_recurring(
+    rows: list[Expense], *, min_occurrences: int = 3, tolerance: float = 0.1
+) -> list[RecurringExpense]:
+    """Monthly recurring expenses found in rows, with the predicted next date."""
+    if min_occurrences < 2:
+        raise ValueError("min_occurrences は 2 以上である必要があります")
+    if tolerance < 0:
+        raise ValueError("tolerance は 0 以上である必要があります")
+
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        if e.amount <= 0:
+            continue
+        groups.setdefault((e.category, normalize_memo(e.memo)), []).append(e)
+
+    found: list[RecurringExpense] = []
+    for items in groups.values():
+        for cluster in _clusters(items, tolerance):
+            for lane in _lanes(cluster):
+                run = _latest_run(lane)
+                if len(run) < min_occurrences:
+                    continue
+                days = [e.day.day for e in run]
+                if max(days) - min(days) > MAX_DAY_SPREAD:
+                    continue
+                latest = run[-1]
+                found.append(
+                    RecurringExpense(
+                        category=latest.category,
+                        memo=latest.memo,
+                        amount=latest.amount,
+                        occurrences=len(run),
+                        last_date=latest.day,
+                        next_date=_next_date(run),
+                    )
+                )
+    found.sort(key=lambda r: (r.next_date, r.category, r.memo, r.amount))
+    return found
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..4a2869a
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,131 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import find_recurring, normalize_memo
+
+
+def E(d, cat="sub", amount=980, memo="Netflix"):
+    return Expense(date.fromisoformat(d), cat, amount, memo)
+
+
+def test_basic_monthly_and_next_date():
+    rows = [E("2026-08-05"), E("2026-09-05"), E("2026-10-05")]
+    [r] = find_recurring(rows)
+    assert (r.category, r.memo, r.amount, r.occurrences) == ("sub", "Netflix", 980, 3)
+    assert r.last_date == date(2026, 10, 5)
+    assert r.next_date == date(2026, 11, 5)
+
+
+def test_empty_and_too_few():
+    assert find_recurring([]) == []
+    assert find_recurring([E("2026-09-05"), E("2026-10-05")]) == []
+
+
+def test_min_occurrences_param_and_validation():
+    rows = [E("2026-09-05"), E("2026-10-05")]
+    assert len(find_recurring(rows, min_occurrences=2)) == 1
+    with pytest.raises(ValueError):
+        find_recurring(rows, min_occurrences=1)
+    with pytest.raises(ValueError):
+        find_recurring(rows, tolerance=-0.1)
+
+
+def test_december_rolls_to_january():
+    rows = [E("2026-10-10"), E("2026-11-10"), E("2026-12-10")]
+    assert find_recurring(rows)[0].next_date == date(2027, 1, 10)
+
+
+def test_month_end_uses_largest_day_clamped():
+    rows = [E("2026-12-31"), E("2027-01-31"), E("2027-02-28")]
+    assert find_recurring(rows)[0].next_date == date(2027, 3, 31)
+    rows = [E("2026-11-30"), E("2026-12-31"), E("2027-01-31")]
+    assert find_recurring(rows)[0].next_date == date(2027, 2, 28)
+
+
+def test_leap_year_february():
+    rows = [E("2023-11-30"), E("2023-12-31"), E("2024-01-31")]
+    assert find_recurring(rows)[0].next_date == date(2024, 2, 29)
+
+
+def test_missing_month_breaks_run():
+    rows = [E("2026-05-05"), E("2026-06-05"), E("2026-08-05"), E("2026-09-05")]
+    assert find_recurring(rows) == []
+    rows.append(E("2026-10-05"))
+    [r] = find_recurring(rows)
+    assert r.occurrences == 3 and r.next_date == date(2026, 11, 5)
+
+
+def test_two_series_same_category_amount_different_days():
+    rows = [E(f"2026-{m:02d}-{d:02d}", memo="") for m in (8, 9, 10) for d in (5, 20)]
+    out = find_recurring(rows)
+    assert [r.next_date for r in out] == [date(2026, 11, 5), date(2026, 11, 20)]
+
+
+def test_same_month_twice_not_counted_as_extra_months():
+    rows = [E("2026-09-05"), E("2026-10-05"), E("2026-10-06")]
+    assert find_recurring(rows) == []
+
+
+def test_price_change_within_tolerance_same_series():
+    rows = [
+        E("2026-08-05", amount=1000),
+        E("2026-09-05", amount=1050),
+        E("2026-10-05", amount=1080),
+    ]
+    [r] = find_recurring(rows)
+    assert r.amount == 1080
+    assert r.occurrences == 3
+
+
+def test_big_price_change_splits_series():
+    rows = [
+        E("2026-08-05", amount=1000),
+        E("2026-09-05", amount=1000),
+        E("2026-10-05", amount=2000),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_refunds_and_zero_ignored():
+    rows = [E("2026-08-05"), E("2026-09-05", amount=-980), E("2026-10-05", amount=0)]
+    assert find_recurring(rows) == []
+
+
+def test_irregular_days_rejected():
+    rows = [E("2026-08-02"), E("2026-09-15"), E("2026-10-28")]
+    assert find_recurring(rows) == []
+
+
+def test_memo_normalization_groups_variants():
+    assert normalize_memo("ＮＥＴＦＬＩＸ  #12") == "netflix"
+    assert normalize_memo("Netflix 3") == "netflix"
+    rows = [
+        E("2026-08-05", memo="Netflix 8"),
+        E("2026-09-05", memo="ＮＥＴＦＬＩＸ 9"),
+        E("2026-10-05", memo="netflix  10"),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_different_memo_or_category_separate():
+    rows = [
+        E(f"2026-{m:02d}-05", memo=memo)
+        for m in (8, 9, 10)
+        for memo in ("Netflix", "Spotify")
+    ]
+    out = find_recurring(rows)
+    assert sorted(r.memo for r in out) == ["Netflix", "Spotify"]
+
+
+def test_order_by_next_date_then_category():
+    rows = [E(f"2026-{m:02d}-20", cat="b", memo="x") for m in (8, 9, 10)]
+    rows += [E(f"2026-{m:02d}-05", cat="z", memo="y") for m in (8, 9, 10)]
+    rows += [E(f"2026-{m:02d}-05", cat="a", memo="y") for m in (8, 9, 10)]
+    assert [r.category for r in find_recurring(rows)] == ["a", "z", "b"]
+
+
+def test_input_order_irrelevant():
+    rows = [E("2026-10-05"), E("2026-08-05"), E("2026-09-05")]
+    assert find_recurring(rows)[0].next_date == date(2026, 11, 5)
