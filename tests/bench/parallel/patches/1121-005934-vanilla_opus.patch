diff --git a/src/kakeibo/bankimport.py b/src/kakeibo/bankimport.py
new file mode 100644
index 0000000..846c5e8
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,110 @@
+"""Import expenses from other banks' / card companies' CSV exports."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"(-?)[¥￥]?([0-9][0-9,]*)円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+_REQUIRED = ("date", "category", "amount")
+
+
+def parse_amount(s: str) -> int:
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額が不正です: {s!r}")
+    value = int(m.group(2).replace(",", ""))
+    return -value if m.group(1) else value
+
+
+def parse_date(s: str) -> date:
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付が不正です: {s!r}")
+    try:
+        return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in _REQUIRED:
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+    if category_map is None:
+        category_map = {}
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header = next(reader, None)
+    if header is None:
+        raise ValueError("ヘッダー行がありません")
+    if header and header[0].startswith("﻿"):
+        header[0] = header[0][1:]
+
+    index: dict[str, int] = {}
+    for field in ("date", "category", "amount", "memo"):
+        if field not in mapping:
+            continue
+        col = mapping[field]
+        if col not in header:
+            raise ValueError(f"列 {col!r} がヘッダーにありません")
+        index[field] = header.index(col)
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    prev_line = reader.line_num
+    for row in reader:
+        line_no = prev_line + 1
+        prev_line = reader.line_num
+        if not row:
+            continue
+
+        # Missing trailing columns (and an unmapped memo) read as "".
+        cells = {f: row[i] if i < len(row) else "" for f, i in index.items()}
+
+        row_errors: list[str] = []
+        day: date | None = None
+        amount = 0
+        try:
+            day = parse_date(cells["date"])
+        except ValueError:
+            row_errors.append("date")
+        try:
+            amount = parse_amount(cells["amount"])
+        except ValueError:
+            row_errors.append("amount")
+        category = cells["category"].strip()
+        if not category:
+            row_errors.append("category")
+
+        if row_errors:
+            errors.extend((line_no, f) for f in row_errors)
+            continue
+        assert day is not None
+        expenses.append(
+            Expense(
+                day=day,
+                category=category_map.get(category, category),
+                amount=amount,
+                memo=cells.get("memo", "").strip(),
+            )
+        )
+    return expenses, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
new file mode 100644
index 0000000..42527dd
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,89 @@
+"""Month-over-month comparison by category."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _month_key(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def _check_month(m: str) -> None:
+    if not isinstance(m, str) or _MONTH_RE.fullmatch(m) is None:
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {m!r}")
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+
+    prev_tot: dict[str, int] = {}
+    curr_tot: dict[str, int] = {}
+    for e in rows:
+        m = _month_key(e)
+        if m == prev_month:
+            prev_tot[e.category] = prev_tot.get(e.category, 0) + e.amount
+        if m == curr_month:
+            curr_tot[e.category] = curr_tot.get(e.category, 0) + e.amount
+
+    out: list[DiffRow] = []
+    for cat in prev_tot.keys() | curr_tot.keys():
+        prev = prev_tot.get(cat, 0)
+        curr = curr_tot.get(cat, 0)
+        delta = curr - prev
+        pct = None if prev == 0 else round(delta / prev * 100, 1)
+        if cat not in prev_tot:
+            status = "new"
+        elif cat not in curr_tot:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+
+    out.sort(key=lambda r: (-abs(r.delta), r.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上にしてください: {n}")
+    return [d for d in diffs if d.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for d in diffs:
+        pct = "-" if d.pct is None else f"{d.pct:+.1f}%"
+        lines.append(f"{d.category}\t{d.prev}\t{d.curr}\t{d.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month_key(e) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("比較できる月が 2 つ未満です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..f1bdcff
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,152 @@
+"""A small boolean search query language over expenses.
+
+Grammar (lowest to highest precedence: OR < AND < NOT)::
+
+    or_expr  := and_expr ("OR" and_expr)*
+    and_expr := not_expr (["AND"] not_expr)*
+    not_expr := "NOT" not_expr | primary
+    primary  := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+
+from kakeibo.core import Expense
+
+
+class QueryError(ValueError):
+    pass
+
+
+Token = tuple[str, str]
+Predicate = Callable[[Expense], bool]
+
+_KEYWORDS = {"AND", "OR", "NOT"}
+_STOP = set('()"')
+
+
+def tokenize(q: str) -> list[Token]:
+    tokens: list[Token] = []
+    i, n = 0, len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end < 0:
+                raise QueryError("引用符が閉じていません")
+            body = q[i + 1 : end]
+            if not body:
+                raise QueryError("引用の中身が空です")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            j = i
+            while j < n and not q[j].isspace() and q[j] not in _STOP:
+                j += 1
+            word = q[i:j]
+            i = j
+            if word in _KEYWORDS:
+                tokens.append((word, word))
+            elif word.startswith("cat:"):
+                value = word[len("cat:") :]
+                if not value:
+                    raise QueryError("cat: の後ろが空です")
+                tokens.append(("CAT", value))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+_PRIMARY_START = {"TERM", "CAT", "LPAREN", "NOT"}
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self.tokens = tokens
+        self.pos = 0
+
+    def peek(self) -> str | None:
+        return self.tokens[self.pos][0] if self.pos < len(self.tokens) else None
+
+    def take(self) -> Token:
+        if self.pos >= len(self.tokens):
+            raise QueryError("クエリが途中で終わっています")
+        tok = self.tokens[self.pos]
+        self.pos += 1
+        return tok
+
+    def parse(self) -> Predicate:
+        if not self.tokens:
+            raise QueryError("クエリが空です")
+        pred = self.or_expr()
+        if self.pos != len(self.tokens):
+            raise QueryError(f"余分なトークンがあります: {self.tokens[self.pos][1]!r}")
+        return pred
+
+    def or_expr(self) -> Predicate:
+        parts = [self.and_expr()]
+        while self.peek() == "OR":
+            self.take()
+            parts.append(self.and_expr())
+        if len(parts) == 1:
+            return parts[0]
+        return lambda e: any(p(e) for p in parts)
+
+    def and_expr(self) -> Predicate:
+        parts = [self.not_expr()]
+        while True:
+            kind = self.peek()
+            if kind == "AND":
+                self.take()
+            elif kind not in _PRIMARY_START:
+                break
+            parts.append(self.not_expr())
+        if len(parts) == 1:
+            return parts[0]
+        return lambda e: all(p(e) for p in parts)
+
+    def not_expr(self) -> Predicate:
+        if self.peek() == "NOT":
+            self.take()
+            inner = self.not_expr()
+            return lambda e: not inner(e)
+        return self.primary()
+
+    def primary(self) -> Predicate:
+        kind, value = self.take()
+        if kind == "TERM":
+            needle = value.casefold()
+            return lambda e: (
+                needle in e.memo.casefold() or needle in e.category.casefold()
+            )
+        if kind == "CAT":
+            target = value.casefold()
+            return lambda e: e.category.casefold() == target
+        if kind == "LPAREN":
+            inner = self.or_expr()
+            if self.take()[0] != "RPAREN":
+                raise QueryError("括弧が閉じていません")
+            return inner
+        raise QueryError(f"ここに {value!r} は置けません")
+
+
+def _compile(q: str) -> Predicate:
+    return _Parser(tokenize(q)).parse()
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _compile(q)(e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    pred = _compile(q)
+    return [e for e in rows if pred(e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..7ab446d
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,57 @@
+"""Detect recurring (monthly) expenses."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+from itertools import pairwise
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Same day next month, clamped to the last day of that month."""
+    year, month = (d.year + 1, 1) if d.month == 12 else (d.year, d.month + 1)
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError(f"min_count は 2 以上にしてください: {min_count}")
+    if tolerance < 0:
+        raise ValueError(f"tolerance は 0 以上にしてください: {tolerance}")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    result: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        days = sorted(day_set)
+        run: list[date] = [days[0]]
+        runs: list[list[date]] = []
+        for prev, cur in pairwise(days):
+            if abs((cur - add_month(prev)).days) <= tolerance:
+                run.append(cur)
+            else:
+                runs.append(run)
+                run = [cur]
+        runs.append(run)
+        for r in runs:
+            if len(r) >= min_count:
+                result.append(Recurring(category, amount, tuple(r), add_month(r[-1])))
+
+    result.sort(key=lambda x: (x.category, x.amount, x.days[0]))
+    return result
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..a1de490
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,173 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+
+@pytest.mark.parametrize(
+    ("s", "want"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥1,000円", 1000),
+        ("-1,2,3", -123),
+        ("1,", 1),
+        ("\t42\n", 42),
+    ],
+)
+def test_parse_amount_ok(s, want):
+    assert parse_amount(s) == want
+
+
+@pytest.mark.parametrize(
+    "s",
+    [
+        "",
+        "  ",
+        "円",
+        "¥",
+        "-",
+        "12.5",
+        "1 200",
+        "--5",
+        "¥-5",
+        "１２３",
+        ",100",
+        "+5",
+        "5円円",
+        "¥¥5",
+        "5-",
+    ],
+)
+def test_parse_amount_ng(s):
+    with pytest.raises(ValueError):
+        parse_amount(s)
+
+
+@pytest.mark.parametrize(
+    ("s", "want"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/12/31 ", date(2026, 12, 31)),
+        ("2024/2/29", date(2024, 2, 29)),
+        ("2026-1-05", date(2026, 1, 5)),
+    ],
+)
+def test_parse_date_ok(s, want):
+    assert parse_date(s) == want
+
+
+@pytest.mark.parametrize(
+    "s",
+    [
+        "2026/1-5",
+        "26/1/5",
+        "02026/1/5",
+        "2026/02/30",
+        "2026/13/1",
+        "2026/001/5",
+        "2026.1.5",
+        "20260105",
+        "",
+        "２０２６/1/5",
+        "2026/1/5 10:00",
+    ],
+)
+def test_parse_date_ng(s):
+    with pytest.raises(ValueError):
+        parse_date(s)
+
+
+def test_default_mapping():
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+HEADER = "利用日,利用店名,利用金額,分類,備考\n"
+
+
+def test_import_basic():
+    text = (
+        HEADER
+        + '2026/11/1, スーパー ,"¥1,200", 食費 ,x\n2026-11-02,"A, B",300円,交通,\n'
+    )
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [
+        Expense(date(2026, 11, 1), "食費", 1200, "スーパー"),
+        Expense(date(2026, 11, 2), "交通", 300, "A, B"),
+    ]
+
+
+def test_import_errors_and_line_numbers():
+    text = (
+        HEADER
+        + "2026/11/1,a,100,食費\n"  # line 2 ok
+        + "\n"  # line 3 blank
+        + "2026/02/30,b,1.5, \n"  # line 4: date, amount, category
+        + "2026/11/3,c,abc,食費\n"  # line 5: amount
+        + "2026/11/4,d,400,日用品\n"  # line 6 ok
+    )
+    rows, errors = import_rows(text)
+    assert [r.memo for r in rows] == ["a", "d"]
+    assert errors == [(4, "date"), (4, "amount"), (4, "category"), (5, "amount")]
+
+
+def test_short_row_treated_as_empty():
+    text = HEADER + "2026/11/1,a\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "amount"), (2, "category")]
+
+
+def test_multiline_quoted_value_line_numbers():
+    text = HEADER + '2026/11/1,"multi\nline",100,食費\nbad,x,1,食費\n'
+    rows, errors = import_rows(text)
+    assert rows[0].memo == "multi\nline"
+    assert errors == [(4, "date")]
+
+
+def test_category_map_applied_after_strip():
+    text = HEADER + "2026/11/1,a,100, スーパー \n2026/11/2,b,200,other\n"
+    rows, _ = import_rows(text, category_map={"スーパー": "食費"})
+    assert [r.category for r in rows] == ["食費", "other"]
+
+
+def test_custom_mapping_without_memo():
+    text = "d,c,a,extra\n2026/1/2,food,50,zzz\n"
+    rows, errors = import_rows(
+        text, mapping={"date": "d", "category": "c", "amount": "a"}
+    )
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 2), "food", 50, "")]
+
+
+@pytest.mark.parametrize("missing", ["date", "category", "amount"])
+def test_mapping_missing_required_key(missing):
+    mapping = dict(DEFAULT_MAPPING)
+    del mapping[missing]
+    with pytest.raises(ValueError):
+        import_rows(HEADER, mapping=mapping)
+
+
+def test_column_not_in_header():
+    with pytest.raises(ValueError):
+        import_rows("利用日,利用金額,分類\n2026/1/1,1,a\n")  # 利用店名 missing
+
+
+def test_empty_text():
+    with pytest.raises(ValueError):
+        import_rows("")
+
+
+def test_header_only():
+    assert import_rows(HEADER) == ([], [])
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..02d43bf
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,141 @@
+from dataclasses import fields
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def E(d: str, cat: str, amount: int) -> Expense:
+    return Expense(date.fromisoformat(d), cat, amount)
+
+
+ROWS = [
+    E("2026-09-15", "old", 999),
+    E("2026-10-01", "food", 1000),
+    E("2026-10-20", "food", 500),
+    E("2026-10-05", "rent", 80000),
+    E("2026-10-07", "hobby", 2000),
+    E("2026-10-08", "misc", 300),
+    E("2026-11-01", "food", 1800),
+    E("2026-11-05", "rent", 80000),
+    E("2026-11-09", "travel", 300),
+    E("2026-11-10", "misc", 0),
+]
+
+
+def test_diffrow_fields():
+    assert [f.name for f in fields(DiffRow)] == [
+        "category",
+        "prev",
+        "curr",
+        "delta",
+        "pct",
+        "status",
+    ]
+
+
+def test_month_diff():
+    assert month_diff(ROWS, "2026-10", "2026-11") == [
+        DiffRow("hobby", 2000, 0, -2000, -100.0, "gone"),
+        DiffRow("food", 1500, 1800, 300, 20.0, "up"),
+        DiffRow("misc", 300, 0, -300, -100.0, "down"),
+        DiffRow("travel", 0, 300, 300, None, "new"),
+        DiffRow("rent", 80000, 80000, 0, 0.0, "same"),
+    ]
+
+
+def test_status_uses_presence_not_total():
+    rows = [E("2026-10-01", "x", 0), E("2026-11-01", "x", 0), E("2026-11-01", "y", 0)]
+    assert month_diff(rows, "2026-10", "2026-11") == [
+        DiffRow("x", 0, 0, 0, None, "same"),
+        DiffRow("y", 0, 0, 0, None, "new"),
+    ]
+
+
+def test_pct_rounding():
+    rows = [E("2026-10-01", "x", 3), E("2026-11-01", "x", 4)]
+    [d] = month_diff(rows, "2026-10", "2026-11")
+    assert d.pct == 33.3
+
+
+def test_month_diff_empty():
+    assert month_diff([], "2026-10", "2026-11") == []
+
+
+@pytest.mark.parametrize(
+    "m",
+    [
+        "2026-1",
+        "2026-13",
+        "2026-00",
+        "26-01",
+        "2026/01",
+        "2026-01-01",
+        "",
+        "２０２６-01",
+    ],
+)
+def test_month_format_errors(m):
+    with pytest.raises(ValueError):
+        month_diff(ROWS, m, "2026-11")
+    with pytest.raises(ValueError):
+        month_diff(ROWS, "2026-10", m)
+
+
+def test_top_movers():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    assert [d.category for d in top_movers(diffs)] == ["hobby", "food", "misc"]
+    assert [d.category for d in top_movers(diffs, 10)] == [
+        "hobby",
+        "food",
+        "misc",
+        "travel",
+    ]
+    assert top_movers(diffs, 0) == []
+    with pytest.raises(ValueError):
+        top_movers(diffs, -1)
+
+
+def test_render_diff():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "hobby\t2000\t0\t-2000\t-100.0%\n"
+        "food\t1500\t1800\t+300\t+20.0%\n"
+        "misc\t300\t0\t-300\t-100.0%\n"
+        "travel\t0\t300\t+300\t-\n"
+        "rent\t80000\t80000\t+0\t+0.0%"
+    )
+
+
+def test_render_empty():
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_available_months():
+    assert available_months(ROWS) == ["2026-09", "2026-10", "2026-11"]
+    assert available_months([]) == []
+    assert available_months([E("0999-01-01", "x", 1)]) == ["0999-01"]
+
+
+def test_latest_diff():
+    assert latest_diff(ROWS) == month_diff(ROWS, "2026-10", "2026-11")
+    # non-adjacent months still compare the last two present
+    rows = [E("2026-01-01", "a", 1), E("2026-05-01", "a", 3)]
+    assert latest_diff(rows) == [DiffRow("a", 1, 3, 2, 200.0, "up")]
+
+
+def test_latest_diff_needs_two_months():
+    with pytest.raises(ValueError):
+        latest_diff([])
+    with pytest.raises(ValueError):
+        latest_diff([E("2026-01-01", "a", 1), E("2026-01-31", "b", 1)])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..e20efd8
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,136 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def E(cat: str, memo: str = "") -> Expense:
+    return Expense(date(2026, 11, 1), cat, 100, memo)
+
+
+def test_query_error_is_value_error():
+    assert issubclass(QueryError, ValueError)
+
+
+def test_tokenize_all_kinds():
+    assert tokenize('(coffee OR "green tea") AND NOT cat:food and x') == [
+        ("LPAREN", "("),
+        ("TERM", "coffee"),
+        ("OR", "OR"),
+        ("TERM", "green tea"),
+        ("RPAREN", ")"),
+        ("AND", "AND"),
+        ("NOT", "NOT"),
+        ("CAT", "food"),
+        ("TERM", "and"),
+        ("TERM", "x"),
+    ]
+
+
+def test_tokenize_word_boundaries():
+    assert tokenize('a"b c"d(e)') == [
+        ("TERM", "a"),
+        ("TERM", "b c"),
+        ("TERM", "d"),
+        ("LPAREN", "("),
+        ("TERM", "e"),
+        ("RPAREN", ")"),
+    ]
+    assert tokenize("cat:a:b ORx Not") == [
+        ("CAT", "a:b"),
+        ("TERM", "ORx"),
+        ("TERM", "Not"),
+    ]
+    assert tokenize('"cat:x" "OR"') == [("TERM", "cat:x"), ("TERM", "OR")]
+    assert tokenize("   ") == []
+
+
+@pytest.mark.parametrize("q", ['"abc', '""', 'a "', "cat:", "cat: x"])
+def test_tokenize_errors(q):
+    with pytest.raises(QueryError):
+        tokenize(q)
+
+
+ROWS = [
+    E("food", "Coffee beans"),
+    E("food", "green tea"),
+    E("cafe", "latte"),
+    E("transport", "train"),
+    E("Food", ""),
+]
+
+
+def memos(q):
+    return [e.memo for e in filter_rows(q, ROWS)]
+
+
+def test_term_matches_memo_or_category_casefold():
+    assert memos("coffee") == ["Coffee beans"]
+    assert memos("FOO") == ["Coffee beans", "green tea", ""]
+    assert memos('"green tea"') == ["green tea"]
+
+
+def test_cat_exact_casefold():
+    assert memos("cat:food") == ["Coffee beans", "green tea", ""]
+    assert memos("cat:foo") == []
+    assert memos("cat:CAFE") == ["latte"]
+
+
+def test_casefold_not_lower():
+    e = Expense(date(2026, 1, 1), "x", 1, "Straße")
+    assert matches("STRASSE", e)
+
+
+def test_implicit_and_and_explicit_and():
+    assert memos("cat:food tea") == ["green tea"]
+    assert memos("cat:food AND tea") == ["green tea"]
+
+
+def test_precedence():
+    # OR < AND: a OR b c == a OR (b AND c)
+    assert memos("train OR cat:food tea") == ["green tea", "train"]
+    assert memos("(train OR cat:food) tea") == ["green tea"]
+    # NOT binds tighter than AND
+    assert memos("NOT cat:food NOT train") == ["latte"]
+    assert memos("NOT (cat:food OR train)") == ["latte"]
+    assert memos("NOT NOT latte") == ["latte"]
+
+
+def test_lowercase_operator_is_term():
+    e = E("x", "salt and pepper")
+    assert matches("and", e)
+    assert not matches("or", e)
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(a",
+        "a)",
+        "a OR",
+        "OR a",
+        "a AND",
+        "AND a",
+        "NOT",
+        "a NOT",
+        "a OR OR b",
+        "a AND OR b",
+        "(a OR)",
+        ")(",
+        '"unterminated',
+    ],
+)
+def test_syntax_errors(q):
+    with pytest.raises(QueryError):
+        matches(q, E("x"))
+    with pytest.raises(QueryError):
+        filter_rows(q, [])
+
+
+def test_filter_rows_keeps_order():
+    assert memos("NOT xyz") == [e.memo for e in ROWS]
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..33a30a2
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,144 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def E(d: str, cat: str = "sub", amount: int = 980, memo: str = "") -> Expense:
+    return Expense(date.fromisoformat(d), cat, amount, memo)
+
+
+@pytest.mark.parametrize(
+    ("src", "want"),
+    [
+        ("2026-01-31", "2026-02-28"),
+        ("2024-01-31", "2024-02-29"),
+        ("2026-12-15", "2027-01-15"),
+        ("2026-03-31", "2026-04-30"),
+        ("2026-12-31", "2027-01-31"),
+        ("2026-05-10", "2026-06-10"),
+    ],
+)
+def test_add_month(src, want):
+    assert add_month(date.fromisoformat(src)) == date.fromisoformat(want)
+
+
+def test_recurring_field_order():
+    r = Recurring("a", 1, (date(2026, 1, 1),), date(2026, 2, 1))
+    assert (r.category, r.amount, r.days, r.next_expected) == (
+        "a",
+        1,
+        (date(2026, 1, 1),),
+        date(2026, 2, 1),
+    )
+    with pytest.raises(AttributeError):
+        r.amount = 2  # type: ignore[misc]
+
+
+def test_basic_detection():
+    rows = [E("2026-01-10"), E("2026-02-12"), E("2026-03-09")]
+    assert find_recurring(rows) == [
+        Recurring(
+            "sub",
+            980,
+            (date(2026, 1, 10), date(2026, 2, 12), date(2026, 3, 9)),
+            date(2026, 4, 9),
+        )
+    ]
+
+
+def test_input_order_and_duplicates_and_memo_ignored():
+    rows = [
+        E("2026-03-10", memo="c"),
+        E("2026-01-10", memo="a"),
+        E("2026-02-10", memo="b"),
+        E("2026-02-10", memo="dup"),
+    ]
+    [r] = find_recurring(rows)
+    assert r.days == (date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10))
+
+
+def test_duplicates_do_not_count_toward_min_count():
+    rows = [E("2026-01-10"), E("2026-01-10"), E("2026-02-10")]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_count=2)) == 1
+
+
+def test_tolerance_boundary():
+    rows = [E("2026-01-10"), E("2026-02-13"), E("2026-03-16")]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+    assert find_recurring(rows, tolerance=2) == []
+    exact = [E("2026-01-10"), E("2026-02-10"), E("2026-03-10")]
+    assert len(find_recurring(exact, tolerance=0)) == 1
+
+
+def test_early_payment_within_tolerance():
+    rows = [E("2026-01-10"), E("2026-02-07"), E("2026-03-07")]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_month_end_clamp():
+    rows = [E("2026-01-31"), E("2026-02-28"), E("2026-03-28")]
+    [r] = find_recurring(rows, tolerance=0)
+    assert r.next_expected == date(2026, 4, 28)
+
+
+def test_split_into_runs():
+    rows = [
+        E("2025-01-05"),
+        E("2025-02-05"),
+        E("2025-03-05"),
+        # gap
+        E("2025-07-05"),
+        E("2025-08-05"),
+        # gap
+        E("2025-12-05"),
+        E("2026-01-05"),
+        E("2026-02-05"),
+        E("2026-03-05"),
+    ]
+    res = find_recurring(rows)
+    assert [r.days[0] for r in res] == [date(2025, 1, 5), date(2025, 12, 5)]
+    assert [len(r.days) for r in res] == [3, 4]
+    assert res[1].next_expected == date(2026, 4, 5)
+    assert len(find_recurring(rows, min_count=2)) == 3
+
+
+def test_stray_date_breaks_run():
+    # an extra mid-month entry with the same amount breaks the chain
+    rows = [E("2026-01-10"), E("2026-02-10"), E("2026-02-20"), E("2026-03-20")]
+    res = find_recurring(rows, min_count=2)
+    assert [r.days for r in res] == [
+        (date(2026, 1, 10), date(2026, 2, 10)),
+        (date(2026, 2, 20), date(2026, 3, 20)),
+    ]
+
+
+def test_grouping_by_category_and_amount():
+    rows = [
+        E("2026-01-10", "sub", 980),
+        E("2026-02-10", "sub", 1000),
+        E("2026-03-10", "sub", 980),
+    ]
+    assert find_recurring(rows, min_count=2) == []
+
+
+def test_sort_order():
+    months = ["2026-01-01", "2026-02-01", "2026-03-01"]
+    rows = []
+    for cat, amt in [("z", 1), ("a", 500), ("a", 100)]:
+        rows += [E(m, cat, amt) for m in months]
+    res = find_recurring(rows)
+    assert [(r.category, r.amount) for r in res] == [("a", 100), ("a", 500), ("z", 1)]
+
+
+def test_empty():
+    assert find_recurring([]) == []
+
+
+@pytest.mark.parametrize(("mc", "tol"), [(1, 3), (0, 3), (3, -1)])
+def test_invalid_params(mc, tol):
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=mc, tolerance=tol)
