+"""load_csv / monthly_totals の端のケース。
+
+実装は変えず、現状の振る舞いを固定する。不具合と思われるものは xfail(strict)
+にしてあり、直ると XPASS で失敗するので、その時に xfail を外す。
+"""
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import CsvError, Expense, load_csv, monthly_totals
+
+HEADER = "date,category,amount,memo\n"
+
+
+def _write(tmp_path, body, header=HEADER):
+    p = tmp_path / "in.csv"
+    p.write_bytes((header + body).encode("utf-8"))
+    return p
+
+
+def _errors(p):
+    with pytest.raises(CsvError) as ei:
+        load_csv(p)
+    return ei.value.errors
+
+
+# ---------- load_csv: 受け付ける入力 ----------
+
+
+def test_load_csv_empty_file_is_empty_list(tmp_path):
+    p = tmp_path / "in.csv"
+    p.write_text("", encoding="utf-8")
+    assert load_csv(p) == []
+
+
+def test_load_csv_header_only_is_empty_list(tmp_path):
+    assert load_csv(_write(tmp_path, "")) == []
+
+
+def test_load_csv_crlf(tmp_path):
+    p = _write(tmp_path, "2026-11-01,food,1,x\r\n", header=HEADER.replace("\n", "\r\n"))
+    assert load_csv(p) == [Expense(date(2026, 11, 1), "food", 1, "x")]
+
+
+def test_load_csv_skips_blank_lines(tmp_path):
+    p = _write(tmp_path, "\n2026-11-01,food,1,\n\n")
+    assert load_csv(p) == [Expense(date(2026, 11, 1), "food", 1, "")]
+
+
+def test_load_csv_memo_column_optional(tmp_path):
+    p = _write(tmp_path, "2026-11-01,food,1\n", header="date,category,amount\n")
+    assert load_csv(p)[0].memo == ""
+    # 列ヘッダーはあるが値が欠けた行(メモ列が無い行)も空メモ
+    assert load_csv(_write(tmp_path, "2026-11-01,food,1\n"))[0].memo == ""
+
+
+def test_load_csv_extra_columns_ignored(tmp_path):
+    p = _write(tmp_path, "2026-11-01,food,1,m,extra\n")
+    assert load_csv(p) == [Expense(date(2026, 11, 1), "food", 1, "m")]
+
+
+def test_load_csv_quoted_newline_and_comma_in_memo(tmp_path):
+    p = _write(tmp_path, '2026-11-01,"a,b",1,"x\ny"\n')
+    (e,) = load_csv(p)
+    assert (e.category, e.memo) == ("a,b", "x\ny")
+
+
+def test_load_csv_strips_category_but_not_memo(tmp_path):
+    p = _write(tmp_path, "2026-11-01,  food ,1, memo \n")
+    (e,) = load_csv(p)
+    assert (e.category, e.memo) == ("food", " memo ")
+
+
+def test_load_csv_empty_category_is_accepted(tmp_path):
+    (e,) = load_csv(_write(tmp_path, "2026-11-01,,1,\n"))
+    assert e.category == ""
+
+
+@pytest.mark.parametrize(
+    ("text", "yen"),
+    [
+        ("-300", -300),  # 返金は負数として受ける
+        ("+5", 5),
+        ("0", 0),
+        (" 100 ", 100),  # 前後の空白は int() が許す
+        ("１２３", 123),  # 全角数字
+        ("99999999999999999999", 99999999999999999999),
+    ],
+)
+def test_load_csv_amount_accepted(tmp_path, text, yen):
+    (e,) = load_csv(_write(tmp_path, f"2026-11-01,food,{text},\n"))
+    assert e.amount == yen
+
+
+def test_load_csv_leap_day(tmp_path):
+    (e,) = load_csv(_write(tmp_path, "2024-02-29,food,1,\n"))
+    assert e.day == date(2024, 2, 29)
+
+
+# ---------- load_csv: 拒否する入力 ----------
+
+
+@pytest.mark.parametrize(
+    "amount",
+    ["12.5", "1.0", '"1,234"', '"1,234円"', "¥100", "abc", "", "−300", "△500", "(500)"],
+)
+def test_load_csv_amount_rejected(tmp_path, amount):
+    p = _write(tmp_path, f"2026-11-01,food,{amount},\n")
+    errs = _errors(p)
+    assert [n for n, _ in errs] == [2]
+    assert "金額" in errs[0][1]
+
+
+@pytest.mark.parametrize(
+    "day",
+    ["2026/11/01", "2026-02-30", "2025-02-29", "2026-13-01", "２０２６-11-01", "", " "],
+)
+def test_load_csv_date_rejected(tmp_path, day):
+    errs = _errors(_write(tmp_path, f"{day},food,1,\n"))
+    assert [n for n, _ in errs] == [2]
+    assert "日付" in errs[0][1]
+
+
+def test_load_csv_row_with_two_errors_reports_first_only(tmp_path):
+    errs = _errors(_write(tmp_path, "bad,food,abc,\n"))
+    assert len(errs) == 1
+    assert "日付" in errs[0][1]
+
+
+def test_load_csv_short_row_reports_missing_column(tmp_path):
+    errs = _errors(_write(tmp_path, "2026-11-01\n2026-11-02,food\n"))
+    assert [n for n, _ in errs] == [2, 3]
+    assert "category" in errs[0][1]
+    assert "amount" in errs[1][1]
+
+
+def test_load_csv_header_is_case_sensitive(tmp_path):
+    p = _write(tmp_path, "2026-11-01,food,1,\n", header="Date,Category,Amount,Memo\n")
+    assert _errors(p) == [(2, "列 date がありません")]
+
+
+def test_load_csv_tab_separated_is_not_detected(tmp_path):
+    p = _write(tmp_path, "2026-11-01\tfood\t1\t\n", header=HEADER.replace(",", "\t"))
+    assert [n for n, _ in _errors(p)] == [2]
+
+
+def test_load_csv_line_number_after_quoted_newline(tmp_path):
+    body = '2026-11-01,food,1,"a\nb"\nbad,food,1,\n'
+    assert [n for n, _ in _errors(_write(tmp_path, body))] == [4]
+
+
+def test_load_csv_error_message_joins_all_rows(tmp_path):
+    p = _write(tmp_path, "bad,food,1,\n2026-11-02,food,x,\n")
+    msg = str(_errors_exc(p))
+    assert msg.startswith("2: ") and "; 3: " in msg
+
+
+def _errors_exc(p):
+    with pytest.raises(CsvError) as ei:
+        load_csv(p)
+    return ei.value
+
+
+# ---------- load_csv: 不具合の疑い(直さず xfail) ----------
+
+
+@pytest.mark.xfail(
+    strict=True,
+    reason="BOM 付き UTF-8(Excel 保存)だと先頭列名が '\\ufeffdate' になり全行が読めない",
+)
+def test_load_csv_utf8_bom(tmp_path):
+    p = tmp_path / "in.csv"
+    p.write_bytes(b"\xef\xbb\xbf" + (HEADER + "2026-11-01,food,1,\n").encode())
+    assert load_csv(p) == [Expense(date(2026, 11, 1), "food", 1, "")]
+
+
+@pytest.mark.xfail(
+    strict=True,
+    reason="複数行にまたがる不正レコードの行番号が開始行でなく終了行になる",
+)
+def test_load_csv_bad_multiline_record_reports_start_line(tmp_path):
+    p = _write(tmp_path, 'bad,food,1,"a\nb"\n')
+    assert [n for n, _ in _errors(p)] == [2]
+
+
+@pytest.mark.xfail(
+    strict=True,
+    reason="引用符なしの `1,234円` が 2 列に割れ、金額 1 円・メモ '234円' として黙って通る",
+)
+def test_load_csv_unquoted_thousands_separator_is_error(tmp_path):
+    assert _errors(_write(tmp_path, "2026-11-01,food,1,234円\n"))
+
+
+@pytest.mark.xfail(
+    strict=True,
+    reason="int() の仕様で '1_000' が 1000 として通る(桁区切りの '1,000' は拒否)",
+)
+def test_load_csv_amount_underscore_rejected(tmp_path):
+    assert _errors(_write(tmp_path, "2026-11-01,food,1_000,\n"))
+
+
+@pytest.mark.xfail(
+    strict=True,
+    reason="UTF-8 以外(Shift_JIS)だと UnicodeDecodeError が CsvError にならず素通りする",
+)
+def test_load_csv_non_utf8_is_csv_error(tmp_path):
+    p = tmp_path / "in.csv"
+    p.write_bytes((HEADER + "2026-11-01,食費,1,\n").encode("cp932"))
+    with pytest.raises(CsvError):
+        load_csv(p)
+
+
+# ---------- monthly_totals ----------
+
+
+def _e(y, m, d, cat, yen):
+    return Expense(date(y, m, d), cat, yen)
+
+
+def test_monthly_totals_empty():
+    assert monthly_totals([]) == {}
+
+
+def test_monthly_totals_single_row():
+    assert monthly_totals([_e(2026, 11, 1, "food", 5)]) == {"2026-11": {"food": 5}}
+
+
+def test_monthly_totals_orders_months_across_years():
+    rows = [
+        _e(2026, 1, 5, "a", 1),
+        _e(2025, 12, 31, "a", 1),
+        _e(2025, 2, 1, "a", 1),
+    ]
+    assert list(monthly_totals(rows)) == ["2025-02", "2025-12", "2026-01"]
+
+
+def test_monthly_totals_month_boundaries_and_leap_day():
+    rows = [
+        _e(2024, 2, 29, "a", 1),
+        _e(2024, 3, 1, "a", 2),
+        _e(2024, 1, 31, "a", 4),
+    ]
+    assert monthly_totals(rows) == {
+        "2024-01": {"a": 4},
+        "2024-02": {"a": 1},
+        "2024-03": {"a": 2},
+    }
+
+
+def test_monthly_totals_same_month_other_year_is_separate():
+    rows = [_e(2025, 11, 1, "a", 1), _e(2026, 11, 1, "a", 2)]
+    assert monthly_totals(rows) == {"2025-11": {"a": 1}, "2026-11": {"a": 2}}
+
+
+def test_monthly_totals_gap_months_are_not_filled():
+    rows = [_e(2026, 1, 1, "a", 1), _e(2026, 4, 1, "a", 1)]
+    assert list(monthly_totals(rows)) == ["2026-01", "2026-04"]
+
+
+def test_monthly_totals_tie_keeps_first_seen_order():
+    rows = [_e(2026, 11, 1, "food", 100), _e(2026, 11, 2, "book", 100)]
+    assert list(monthly_totals(rows)["2026-11"]) == ["food", "book"]
+
+
+def test_monthly_totals_refund_nets_and_sorts_last():
+    rows = [
+        _e(2026, 11, 1, "food", 1000),
+        _e(2026, 11, 2, "food", -300),
+        _e(2026, 11, 3, "gift", -50),
+        _e(2026, 11, 4, "rent", 0),
+    ]
+    got = monthly_totals(rows)["2026-11"]
+    assert got == {"food": 700, "rent": 0, "gift": -50}
+    assert list(got) == ["food", "rent", "gift"]
+
+
+def test_monthly_totals_full_refund_keeps_zero_category():
+    rows = [_e(2026, 11, 1, "food", 500), _e(2026, 11, 2, "food", -500)]
+    assert monthly_totals(rows) == {"2026-11": {"food": 0}}
+
+
+def test_monthly_totals_categories_are_case_and_space_sensitive():
+    rows = [_e(2026, 11, 1, "Food", 1), _e(2026, 11, 2, "food", 2)]
+    assert monthly_totals(rows) == {"2026-11": {"food": 2, "Food": 1}}
+
+
+def test_monthly_totals_does_not_mutate_or_depend_on_input_order():
+    rows = [_e(2026, 11, 3, "a", 1), _e(2026, 10, 1, "b", 2)]
+    before = list(rows)
+    assert monthly_totals(rows) == monthly_totals(list(reversed(rows)))
+    assert rows == before
