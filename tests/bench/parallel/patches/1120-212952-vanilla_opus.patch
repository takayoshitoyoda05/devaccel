+++ b/src/kakeibo/importer.py
@@ -0,0 +1,337 @@
+"""銀行・カード会社の CSV を Expense に変換する純粋関数群。
+
+ファイル I/O は行わない。呼び出し側がバイト列や文字列を渡す:
+
+    text = decode(path.read_bytes())
+    result = import_csv(text, GENERIC)
+    for err in result.errors:
+        print(err)
+
+金額の符号は既存の Expense に合わせて「支出が正」。入金(収入・返金)は負になる。
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass, field
+from datetime import date
+
+from kakeibo.core import CsvError, Expense
+
+Columns = tuple[str, ...]
+
+
+@dataclass(frozen=True)
+class Profile:
+    """会社ごとの CSV の読み方。
+
+    各列は候補名のタプルで指定し、ヘッダに最初に見つかったものを使う
+    (全角/半角・大文字/小文字・前後の空白・BOM の違いは無視して照合する)。
+
+    金額は次のどちらか(両方指定した場合は amount が見つかればそちらを優先):
+    - amount: 1 列の金額。negate=False なら正が支出(カード明細など)、
+      negate=True なら負が支出(「-1,200」で引落しを表す銀行など)。
+    - withdrawal / deposit: 出金列と入金列。空欄は 0 扱い。金額 = 出金 - 入金。
+    """
+
+    date: Columns
+    amount: Columns = ()
+    withdrawal: Columns = ()
+    deposit: Columns = ()
+    category: Columns = ()
+    memo: Columns = ()
+    negate: bool = False
+    default_category: str = "未分類"
+    max_preamble: int = 20  # ヘッダより前にある説明行(口座番号など)を何行まで読み飛ばすか
+
+
+GENERIC = Profile(
+    date=("日付", "利用日", "ご利用日", "取引日", "お取引日", "年月日", "date"),
+    amount=("金額", "利用金額", "ご利用金額", "支払金額", "お支払金額", "amount"),
+    withdrawal=("出金", "出金金額", "お引出し", "お支払金額(円)", "支払", "引出額"),
+    deposit=("入金", "入金金額", "お預入れ", "お預入金額(円)", "預入", "預入額"),
+    category=("カテゴリ", "費目", "category"),
+    memo=("摘要", "内容", "利用店名", "ご利用店名", "ご利用先", "利用先", "メモ", "備考", "memo"),
+)
+"""よくある列名を広めに拾う汎用プロファイル。"""
+
+
+@dataclass(frozen=True)
+class RowError:
+    """不正な行の 1 つの問題。line は CSV 上の物理行番号(1 始まり)。"""
+
+    line: int
+    column: str | None
+    value: str | None
+    reason: str
+
+    def __str__(self) -> str:
+        where = f"{self.line}行目"
+        if self.column is not None:
+            where += f" 列「{self.column}」"
+        if self.value is not None:
+            return f"{where}: {self.reason}: {self.value!r}"
+        return f"{where}: {self.reason}"
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense] = field(default_factory=list)
+    errors: list[RowError] = field(default_factory=list)
+
+    def raise_if_errors(self) -> None:
+        """エラーがあれば既存 CLI と同じ CsvError((行, 理由) のリスト)として送出する。"""
+        if self.errors:
+            raise CsvError([(e.line, _strip_line(e)) for e in self.errors])
+
+
+class HeaderError(ValueError):
+    """必要な列がヘッダに見つからず、ファイル全体を読めないとき。"""
+
+
+# --- 文字列ヘルパ -----------------------------------------------------------
+
+
+def decode(data: bytes) -> str:
+    """UTF-8(BOM 付き可)を試し、だめなら Shift_JIS(cp932)として読む。"""
+    try:
+        return data.decode("utf-8-sig")
+    except UnicodeDecodeError:
+        return data.decode("cp932")
+
+
+def _norm(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip().lstrip("﻿").strip()
+
+
+# --- 金額 -------------------------------------------------------------------
+
+_MINUS = "-−‐‒–—－"  # 各種ハイフン・マイナス
+_AMOUNT_RE = re.compile(r"(?:\d{1,3}(?:,\d{3})+|\d+)(?:\.0+)?")
+
+
+def _strip_yen(s: str) -> str:
+    # cp932 で読むと円記号は "\" になる
+    return s.removeprefix("¥").removeprefix("\\").removesuffix("円")
+
+
+def parse_amount(text: str) -> int:
+    """会社ごとの金額表記を円の整数にする。読めなければ ValueError(理由つき)。
+
+    受け付ける例: "1200", "1,200", "¥1,200", "￥１，２００", "1,200円",
+    "-1,200", "−1,200", "△1,200", "▲1,200", "(1,200)", "+1,200", "1200.00"
+    """
+    s = _norm(text).replace(" ", "")
+    if not s:
+        raise ValueError("金額が空です")
+    negative = False
+    if s.startswith("(") and s.endswith(")"):
+        negative, s = True, s[1:-1]
+    s = _strip_yen(s)
+    if s and (s[0] in _MINUS or s[0] in "△▲"):
+        negative, s = not negative, s[1:]
+    elif s.startswith("+"):
+        s = s[1:]
+    s = _strip_yen(s)
+    if not _AMOUNT_RE.fullmatch(s):
+        if re.fullmatch(r"[\d,]*\.\d+", s):
+            raise ValueError("円未満の端数は扱えません")
+        raise ValueError("金額として読めません")
+    yen = int(s.split(".")[0].replace(",", ""))
+    return -yen if negative else yen
+
+
+# --- 日付 -------------------------------------------------------------------
+
+_DATE_RES = (
+    re.compile(r"(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})"),
+    re.compile(r"(\d{4})年(\d{1,2})月(\d{1,2})日"),
+    re.compile(r"(\d{4})(\d{2})(\d{2})"),
+)
+
+
+def parse_date(text: str) -> date:
+    """2026-11-01 / 2026/11/1 / 2026.11.01 / 2026年11月1日 / 20261101 を受け付ける。
+
+    後ろに時刻が付いていても(「2026/11/01 12:34」)日付部分だけを使う。
+    """
+    s = _norm(text)
+    if not s:
+        raise ValueError("日付が空です")
+    head = s.split()[0]
+    for pat in _DATE_RES:
+        m = pat.fullmatch(head)
+        if m:
+            y, mo, d = (int(g) for g in m.groups())
+            try:
+                return date(y, mo, d)
+            except ValueError:
+                raise ValueError("存在しない日付です") from None
+    raise ValueError("日付として読めません")
+
+
+# --- 本体 -------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class _Layout:
+    header_line: int
+    date: int
+    amount: int | None
+    withdrawal: int | None
+    deposit: int | None
+    category: int | None
+    memo: int | None
+    names: list[str]
+
+
+def _find(header: list[str], candidates: Columns) -> int | None:
+    normed = [_norm(h).casefold() for h in header]
+    for c in candidates:
+        try:
+            return normed.index(_norm(c).casefold())
+        except ValueError:
+            continue
+    return None
+
+
+def _layout(header: list[str], line: int, profile: Profile) -> _Layout | None:
+    date_i = _find(header, profile.date)
+    amount_i = _find(header, profile.amount)
+    w_i = d_i = None
+    if amount_i is None:
+        w_i = _find(header, profile.withdrawal)
+        d_i = _find(header, profile.deposit)
+    if date_i is None or (amount_i is None and w_i is None and d_i is None):
+        return None
+    return _Layout(
+        header_line=line,
+        date=date_i,
+        amount=amount_i,
+        withdrawal=w_i,
+        deposit=d_i,
+        category=_find(header, profile.category),
+        memo=_find(header, profile.memo),
+        names=[_norm(h) for h in header],
+    )
+
+
+def _missing_message(header: list[str] | None, profile: Profile) -> str:
+    wanted = ["日付(" + "/".join(profile.date) + ")"]
+    money = profile.amount + profile.withdrawal + profile.deposit
+    wanted.append("金額(" + "/".join(money) + ")")
+    found = ", ".join(_norm(h) for h in header) if header else "(なし)"
+    return (
+        f"ヘッダ行が見つかりません。必要な列: {'、'.join(wanted)}。"
+        f"先頭付近にあった列: {found}"
+    )
+
+
+def import_csv(text: str, profile: Profile = GENERIC) -> ImportResult:
+    """CSV 文字列を読み、変換できた行と、不正な行の問題点をすべて返す。
+
+    ヘッダより前の説明行と空行は読み飛ばす。1 行に複数の問題があれば全部報告する。
+    必要な列がそもそも無いときは HeaderError。
+    """
+    reader = csv.reader(io.StringIO(text))
+    layout: _Layout | None = None
+    first_header: list[str] | None = None
+    for i, row in enumerate(reader):
+        if not any(c.strip() for c in row):
+            continue
+        if first_header is None:
+            first_header = row
+        layout = _layout(row, reader.line_num, profile)
+        if layout is not None or i >= profile.max_preamble:
+            break
+    if layout is None:
+        raise HeaderError(_missing_message(first_header, profile))
+
+    result = ImportResult()
+    for row in reader:
+        if not any(c.strip() for c in row):
+            continue
+        expense, errs = _convert(row, reader.line_num, layout, profile)
+        if errs:
+            result.errors.extend(errs)
+        elif expense is not None:
+            result.expenses.append(expense)
+    return result
+
+
+def _convert(
+    row: list[str], line: int, lay: _Layout, profile: Profile
+) -> tuple[Expense | None, list[RowError]]:
+    errors: list[RowError] = []
+
+    def cell(i: int | None) -> str | None:
+        if i is None or i >= len(row):
+            return None
+        return row[i]
+
+    def err(i: int | None, value: str | None, reason: str) -> None:
+        name = lay.names[i] if i is not None and i < len(lay.names) else None
+        errors.append(RowError(line, name, value, reason))
+
+    if any(c.strip() for c in row[len(lay.names) :]):
+        err(
+            None,
+            None,
+            f"列数がヘッダより多いです({len(row)} 個 / ヘッダ {len(lay.names)} 個)。"
+            "金額のカンマが引用符で囲まれていない可能性があります",
+        )
+
+    day: date | None = None
+    raw = cell(lay.date)
+    if raw is None:
+        err(lay.date, None, "列がありません")
+    else:
+        try:
+            day = parse_date(raw)
+        except ValueError as e:
+            err(lay.date, raw, str(e))
+
+    amount: int | None = None
+    if lay.amount is not None:
+        raw = cell(lay.amount)
+        if raw is None:
+            err(lay.amount, None, "列がありません")
+        else:
+            try:
+                amount = parse_amount(raw)
+                if profile.negate:
+                    amount = -amount
+            except ValueError as e:
+                err(lay.amount, raw, str(e))
+    else:
+        parts: list[int] = []
+        ok = True
+        for idx, sign in ((lay.withdrawal, 1), (lay.deposit, -1)):
+            raw = cell(idx)
+            if idx is None or raw is None or not _norm(raw):
+                continue
+            try:
+                parts.append(sign * parse_amount(raw))
+            except ValueError as e:
+                ok = False
+                err(idx, raw, str(e))
+        if ok:
+            if not parts:
+                err(None, None, "出金・入金のどちらも空です")
+            else:
+                amount = sum(parts)
+
+    if errors or day is None or amount is None:
+        return None, errors
+
+    category = _norm(cell(lay.category) or "") or profile.default_category
+    memo = _norm(cell(lay.memo) or "")
+    return Expense(day=day, category=category, amount=amount, memo=memo), []
+
+
+def _strip_line(e: RowError) -> str:
+    """CsvError 用: 行番号は別に持つので、メッセージから「N行目」を除く。"""
+    return str(e).removeprefix(f"{e.line}行目").lstrip(" :")
diff --git a/tests/test_importer.py b/tests/test_importer.py
