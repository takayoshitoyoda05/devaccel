@@ -0,0 +1,291 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import CsvError, Expense
+from kakeibo.importer import (
+    GENERIC,
+    HeaderError,
+    Profile,
+    RowError,
+    decode,
+    import_csv,
+    parse_amount,
+    parse_date,
+)
+
+# --- parse_amount ------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "yen"),
+    [
+        ("1200", 1200),
+        ("1,200", 1200),
+        (" 1,200 ", 1200),
+        ("¥1,200", 1200),
+        ("￥１，２００", 1200),
+        ("\\1,200", 1200),
+        ("1,200円", 1200),
+        ("+1,200", 1200),
+        ("-1,200", -1200),
+        ("−1,200", -1200),
+        ("－1,200", -1200),
+        ("△1,200", -1200),
+        ("▲1,200", -1200),
+        ("(1,200)", -1200),
+        ("¥-1,200", -1200),
+        ("-¥1,200", -1200),
+        ("1,234,567", 1234567),
+        ("1200.00", 1200),
+        ("0", 0),
+    ],
+)
+def test_parse_amount_accepts_company_notations(text, yen):
+    assert parse_amount(text) == yen
+
+
+@pytest.mark.parametrize(
+    ("text", "reason"),
+    [
+        ("", "金額が空です"),
+        ("   ", "金額が空です"),
+        ("abc", "金額として読めません"),
+        ("1,2,00", "金額として読めません"),
+        ("12,00", "金額として読めません"),
+        ("1200.5", "円未満の端数は扱えません"),
+        ("--100", "金額として読めません"),
+        ("$100", "金額として読めません"),
+    ],
+)
+def test_parse_amount_rejects_with_reason(text, reason):
+    with pytest.raises(ValueError, match=reason):
+        parse_amount(text)
+
+
+# --- parse_date --------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026-11-01",
+        "2026/11/01",
+        "2026/11/1",
+        "2026.11.01",
+        "2026年11月1日",
+        "20261101",
+        "２０２６/１１/０１",
+        "2026/11/01 12:34",
+    ],
+)
+def test_parse_date_accepts_formats(text):
+    assert parse_date(text) == date(2026, 11, 1)
+
+
+@pytest.mark.parametrize(
+    ("text", "reason"),
+    [
+        ("", "日付が空です"),
+        ("11/01", "日付として読めません"),
+        ("2026-13-01", "存在しない日付です"),
+        ("2026/02/30", "存在しない日付です"),
+        ("yesterday", "日付として読めません"),
+    ],
+)
+def test_parse_date_rejects_with_reason(text, reason):
+    with pytest.raises(ValueError, match=reason):
+        parse_date(text)
+
+
+# --- decode ------------------------------------------------------------------
+
+
+def test_decode_utf8_with_bom():
+    assert decode("﻿日付,金額\n".encode()) == "日付,金額\n"
+
+
+def test_decode_falls_back_to_cp932():
+    assert decode("日付,金額\n".encode("cp932")) == "日付,金額\n"
+
+
+# --- import_csv: 会社ごとの形式 ----------------------------------------------
+
+
+def test_card_statement_positive_is_spending():
+    text = (
+        "ご利用日,ご利用店名,ご利用金額\n"
+        "2026/11/01,コンビニ,\"1,200\"\n"
+        "2026/11/02,返品,-300\n"
+    )
+    r = import_csv(text)
+    assert r.errors == []
+    assert r.expenses == [
+        Expense(date(2026, 11, 1), "未分類", 1200, "コンビニ"),
+        Expense(date(2026, 11, 2), "未分類", -300, "返品"),
+    ]
+
+
+def test_bank_withdrawal_and_deposit_columns():
+    text = (
+        "取引日,摘要,お引出し,お預入れ,残高\n"
+        "2026年11月1日,ATM,\"10,000\",,\"90,000\"\n"
+        "2026年11月25日,給与,,\"250,000\",\"340,000\"\n"
+    )
+    r = import_csv(text)
+    assert r.errors == []
+    assert [(e.day, e.amount, e.memo) for e in r.expenses] == [
+        (date(2026, 11, 1), 10000, "ATM"),
+        (date(2026, 11, 25), -250000, "給与"),
+    ]
+
+
+def test_negate_for_bank_where_minus_is_withdrawal():
+    profile = Profile(date=("日付",), amount=("金額",), memo=("内容",), negate=True)
+    text = "日付,内容,金額\n20261101,電気代,▲8500\n20261125,給与,250000\n"
+    r = import_csv(text, profile)
+    assert [e.amount for e in r.expenses] == [8500, -250000]
+
+
+def test_custom_profile_with_category_and_default():
+    profile = Profile(
+        date=("Date",),
+        amount=("Amount",),
+        category=("Type",),
+        memo=("Desc",),
+        default_category="その他",
+    )
+    text = "Date,Type,Amount,Desc\n2026-11-01,food,100,x\n2026-11-02,,200,y\n"
+    r = import_csv(text, profile)
+    assert [e.category for e in r.expenses] == ["food", "その他"]
+
+
+def test_header_names_are_normalized():
+    # 全角英数・前後の空白・BOM を吸収する
+    text = "﻿ 利用日 ,ＭＥＭＯ,利用金額\n2026-11-01,a,100\n"
+    r = import_csv(text)
+    assert r.expenses == [Expense(date(2026, 11, 1), "未分類", 100, "a")]
+
+
+def test_preamble_and_blank_lines_are_skipped():
+    text = (
+        "口座番号,1234567\n"
+        "照会期間,2026/11/01～2026/11/30\n"
+        "\n"
+        "日付,摘要,出金,入金\n"
+        "2026/11/01,スーパー,980,\n"
+        "\n"
+        "2026/11/02,カフェ,450,\n"
+    )
+    r = import_csv(text)
+    assert r.errors == []
+    assert [e.amount for e in r.expenses] == [980, 450]
+
+
+def test_amount_column_wins_over_withdrawal_deposit():
+    text = "日付,金額,出金\n2026-11-01,100,999\n"
+    assert [e.amount for e in import_csv(text).expenses] == [100]
+
+
+# --- import_csv: エラー報告 --------------------------------------------------
+
+
+def test_bad_rows_report_line_column_value_and_reason():
+    text = (
+        "利用日,利用店名,利用金額\n"
+        "2026/11/01,ok,100\n"
+        "2026/13/01,bad-date,100\n"
+        "2026/11/03,bad-amount,1.2万\n"
+        "2026/11/04,ok,200\n"
+    )
+    r = import_csv(text)
+    assert [e.amount for e in r.expenses] == [100, 200]
+    assert r.errors == [
+        RowError(3, "利用日", "2026/13/01", "存在しない日付です"),
+        RowError(4, "利用金額", "1.2万", "金額として読めません"),
+    ]
+
+
+def test_all_problems_in_one_row_are_reported():
+    r = import_csv("日付,金額\nfoo,bar\n")
+    assert [(e.line, e.column) for e in r.errors] == [(2, "日付"), (2, "金額")]
+    assert r.expenses == []
+
+
+def test_error_str_is_human_readable():
+    e = RowError(4, "利用金額", "1.2万", "金額として読めません")
+    assert str(e) == "4行目 列「利用金額」: 金額として読めません: '1.2万'"
+    assert str(RowError(7, None, None, "出金・入金のどちらも空です")) == (
+        "7行目: 出金・入金のどちらも空です"
+    )
+
+
+def test_both_withdrawal_and_deposit_empty_is_error():
+    r = import_csv("日付,出金,入金\n2026-11-01,,\n")
+    assert r.errors == [RowError(2, None, None, "出金・入金のどちらも空です")]
+
+
+def test_bad_deposit_is_reported_on_deposit_column():
+    r = import_csv("日付,出金,入金\n2026-11-01,,abc\n")
+    assert r.errors == [RowError(2, "入金", "abc", "金額として読めません")]
+
+
+def test_short_row_reports_missing_column():
+    r = import_csv("日付,摘要,金額\n2026-11-01,x\n")
+    assert r.errors == [RowError(2, "金額", None, "列がありません")]
+
+
+def test_unquoted_comma_amount_is_flagged():
+    # 1,200 を引用符なしで書くと列がずれる
+    r = import_csv("日付,金額,摘要\n2026-11-01,1,200,x\n")
+    assert len(r.errors) == 1
