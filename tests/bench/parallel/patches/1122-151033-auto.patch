+import enum
+
+import pytest
+
 import click
+from click.testing import CliRunner
 
 
 def test_choice_get_invalid_choice_message():
     choice = click.Choice(["a", "b", "c"])
     message = choice.get_invalid_choice_message("d", ctx=None)
     assert message == "'d' is not one of 'a', 'b', 'c'."
+
+
+@pytest.mark.parametrize(
+    ("value", "suffix"),
+    [
+        ("bannana", "Did you mean 'banana'?"),
+        ("cheery", "Did you mean 'cherry'?"),
+        ("banan", "Did you mean 'banana'?"),
+        ("zzz", None),
+        ("", None),
+    ],
+)
+def test_choice_did_you_mean(value, suffix):
+    choice = click.Choice(["banana", "cherry", "apple"])
+    message = choice.get_invalid_choice_message(value, ctx=None)
+    base = f"{value!r} is not one of 'banana', 'cherry', 'apple'."
+    assert message == base if suffix is None else message == f"{base} {suffix}"
+
+
+def test_choice_did_you_mean_multiple():
+    choice = click.Choice(["declare", "refine", "other"])
+    message = choice.get_invalid_choice_message("decline", ctx=None)
+    assert message.endswith("(Did you mean one of: 'declare', 'refine'?)")
+
+
+def test_choice_did_you_mean_single_choice():
+    choice = click.Choice(["banana"])
+    message = choice.get_invalid_choice_message("bananna", ctx=None)
+    assert message == "'bananna' is not 'banana'. Did you mean 'banana'?"
+
+
+def test_choice_did_you_mean_case_insensitive():
+    choice = click.Choice(["Banana", "Cherry"], case_sensitive=False)
+    message = choice.get_invalid_choice_message("BANANNA", ctx=None)
+    assert message.endswith("Did you mean 'banana'?")
+
+
+def test_choice_did_you_mean_case_sensitive():
+    # Case differences count as a mismatch, so a close candidate is suggested.
+    choice = click.Choice(["banana", "cherry"])
+    message = choice.get_invalid_choice_message("Banana", ctx=None)
+    assert message.endswith("Did you mean 'banana'?")
+
+
+def test_choice_did_you_mean_non_str_value():
+    choice = click.Choice(["100", "200"])
+    message = choice.get_invalid_choice_message(101, ctx=None)
+    assert message == "101 is not one of '100', '200'. Did you mean '100'?"
+
+
+def test_choice_did_you_mean_enum():
+    class Fruit(enum.Enum):
+        BANANA = 1
+        CHERRY = 2
+
+    choice = click.Choice(Fruit)
+    message = choice.get_invalid_choice_message("BANANNA", ctx=None)
+    assert message.endswith("Did you mean 'BANANA'?")
+
+
+def test_choice_did_you_mean_token_normalize_func():
+    @click.command(context_settings={"token_normalize_func": str.lower})
+    @click.option("--fruit", type=click.Choice(["banana", "cherry"]))
+    def cli(fruit):
+        pass
+
+    result = CliRunner().invoke(cli, ["--fruit", "BANANNA"])
+    assert result.exit_code == 2
+    assert "Did you mean 'banana'?" in result.output
+
+
+def test_choice_did_you_mean_cli():
+    @click.command()
+    @click.option("--fruit", type=click.Choice(["banana", "cherry"]))
+    def cli(fruit):
+        pass
+
+    result = CliRunner().invoke(cli, ["--fruit", "bannana"])
+    assert result.exit_code == 2
+    assert (
+        "Invalid value for '--fruit': 'bannana' is not one of 'banana', 'cherry'."
+        " Did you mean 'banana'?"
+    ) in result.output
+
+    result = CliRunner().invoke(cli, ["--fruit", "zzz"])
+    assert "Did you mean" not in result.output
