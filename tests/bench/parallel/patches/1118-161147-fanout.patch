@@ -0,0 +1,71 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.topn import top_expenses
+
+
+def _e(day: date, amount: int, memo: str = "") -> Expense:
+    return Expense(day=day, category="food", amount=amount, memo=memo)
+
+
+def test_returns_n_largest_by_amount_descending():
+    rows = [
+        _e(date(2026, 11, 1), 100),
+        _e(date(2026, 11, 2), 500),
+        _e(date(2026, 11, 3), 300),
+    ]
+    assert top_expenses(rows, 2) == [rows[1], rows[2]]
+
+
+def test_equal_amounts_are_ordered_by_earlier_date_first():
+    late = _e(date(2026, 11, 9), 500)
+    early = _e(date(2026, 11, 1), 500)
+    rows = [late, early]
+    assert top_expenses(rows, 2) == [early, late]
+
+
+def test_equal_amount_and_date_keeps_input_order():
+    first = _e(date(2026, 11, 1), 500, memo="first")
+    second = _e(date(2026, 11, 1), 500, memo="second")
+    assert top_expenses([first, second], 2) == [first, second]
+    assert top_expenses([second, first], 2) == [second, first]
+
+
+def test_n_zero_returns_empty_list():
+    rows = [_e(date(2026, 11, 1), 100)]
+    assert top_expenses(rows, 0) == []
+
+
+def test_negative_n_returns_empty_list():
+    rows = [_e(date(2026, 11, 1), 100)]
+    assert top_expenses(rows, -3) == []
+
+
+def test_n_larger_than_input_returns_all_sorted():
+    a = _e(date(2026, 11, 1), 100)
+    b = _e(date(2026, 11, 2), 900)
+    assert top_expenses([a, b], 10) == [b, a]
+
+
+def test_n_equal_to_input_length_returns_all_sorted():
+    a = _e(date(2026, 11, 1), 100)
+    b = _e(date(2026, 11, 2), 900)
+    assert top_expenses([a, b], 2) == [b, a]
+
+
+def test_empty_input_returns_empty_list():
+    assert top_expenses([], 3) == []
+
+
+def test_input_list_is_not_mutated():
+    rows = [_e(date(2026, 11, 1), 100), _e(date(2026, 11, 2), 900)]
+    snapshot = list(rows)
+    top_expenses(rows, 2)
+    assert rows == snapshot
+
+
+def test_negative_amounts_are_ordered_by_value_descending():
+    refund = _e(date(2026, 11, 1), -500)
+    small = _e(date(2026, 11, 2), 0)
+    big = _e(date(2026, 11, 3), 200)
+    assert top_expenses([refund, small, big], 3) == [big, small, refund]
