new file mode 100644
index 0000000..8358382
--- /dev/null
+++ b/src/kakeibo/stats.py
@@ -0,0 +1,27 @@
+"""Statistics over expense records."""
+
+from __future__ import annotations
+
+from collections import defaultdict
+
+from kakeibo.core import Expense
+
+
+def median_by_category(rows: list[Expense]) -> dict[str, float]:
+    """{category: median amount}; categories ascending by name.
+
+    An even number of amounts yields the mean of the two middle values.
+    """
+    by_cat: dict[str, list[int]] = defaultdict(list)
+    for e in rows:
+        by_cat[e.category].append(e.amount)
+    out: dict[str, float] = {}
+    for cat in sorted(by_cat):
+        amounts = sorted(by_cat[cat])
+        n = len(amounts)
+        mid = n // 2
+        if n % 2:
+            out[cat] = float(amounts[mid])
+        else:
+            out[cat] = (amounts[mid - 1] + amounts[mid]) / 2
+    return out
