+"""Tests for kakeibo.stats.median_by_category."""
+
+from __future__ import annotations
+
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.stats import median_by_category
+
+
+def _e(category: str, amount: int) -> Expense:
+    return Expense(day=date(2026, 1, 1), category=category, amount=amount)
+
+
+def test_empty_returns_empty_dict() -> None:
+    assert median_by_category([]) == {}
+
+
+def test_single_row_returns_its_amount_as_float() -> None:
+    result = median_by_category([_e("food", 500)])
+    assert result == {"food": 500.0}
+    assert isinstance(result["food"], float)
+
+
+def test_odd_count_returns_middle_value() -> None:
+    rows = [_e("food", 300), _e("food", 100), _e("food", 200)]
+    assert median_by_category(rows) == {"food": 200.0}
+
+
+def test_even_count_returns_mean_of_middle_two() -> None:
+    rows = [_e("food", 100), _e("food", 200), _e("food", 300), _e("food", 400)]
+    assert median_by_category(rows) == {"food": 250.0}
+
+
+def test_even_count_with_non_integer_mean() -> None:
+    rows = [_e("food", 1), _e("food", 2)]
+    assert median_by_category(rows) == {"food": 1.5}
+
+
+def test_identical_values_return_that_value() -> None:
+    rows = [_e("food", 700), _e("food", 700), _e("food", 700)]
+    assert median_by_category(rows) == {"food": 700.0}
+
+
+def test_identical_values_even_count() -> None:
+    rows = [_e("food", 100), _e("food", 100)]
+    assert median_by_category(rows) == {"food": 100.0}
+
+
+def test_categories_are_computed_separately() -> None:
+    rows = [
+        _e("food", 100),
+        _e("rent", 90000),
+        _e("food", 300),
+        _e("rent", 80000),
+        _e("food", 200),
+    ]
+    assert median_by_category(rows) == {"food": 200.0, "rent": 85000.0}
+
+
+def test_keys_sorted_ascending_by_category_name() -> None:
+    rows = [_e("transport", 1), _e("food", 2), _e("cafe", 3)]
+    result = median_by_category(rows)
+    assert list(result) == ["cafe", "food", "transport"]
+
+
+def test_keys_sorted_by_name_not_by_amount() -> None:
+    rows = [_e("b", 1), _e("a", 999)]
+    assert list(median_by_category(rows)) == ["a", "b"]
+
+
+def test_input_order_does_not_matter() -> None:
+    rows = [_e("food", 400), _e("food", 100), _e("food", 300), _e("food", 200)]
+    assert median_by_category(rows) == median_by_category(list(reversed(rows)))
+
+
+def test_does_not_mutate_input() -> None:
+    rows = [_e("food", 300), _e("food", 100), _e("food", 200)]
+    snapshot = list(rows)
+    median_by_category(rows)
+    assert rows == snapshot
