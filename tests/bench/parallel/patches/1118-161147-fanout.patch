@@ -0,0 +1,78 @@
+"""Tests for kakeibo.weekday.total_by_weekday."""
+
+from __future__ import annotations
+
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.weekday import total_by_weekday
+
+# 2026-11-16 は月曜日。以降 11-17 火 ... 11-22 日。
+MON = date(2026, 11, 16)
+TUE = date(2026, 11, 17)
+WED = date(2026, 11, 18)
+THU = date(2026, 11, 19)
+FRI = date(2026, 11, 20)
+SAT = date(2026, 11, 21)
+SUN = date(2026, 11, 22)
+
+
+def _e(day: date, amount: int, category: str = "食費") -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo="")
+
+
+def test_empty_rows_returns_empty_dict() -> None:
+    assert total_by_weekday([]) == {}
+
+
+def test_single_expense_maps_to_its_weekday() -> None:
+    assert total_by_weekday([_e(WED, 500)]) == {"Wed": 500}
+
+
+def test_same_weekday_amounts_are_summed() -> None:
+    rows = [_e(MON, 300), _e(MON, 200, "交通費")]
+    assert total_by_weekday(rows) == {"Mon": 500}
+
+
+def test_same_weekday_in_different_weeks_is_summed() -> None:
+    rows = [_e(MON, 100), _e(date(2026, 11, 23), 250)]  # 11-23 も月曜
+    assert total_by_weekday(rows) == {"Mon": 350}
+
+
+def test_weekdays_without_expenses_are_omitted() -> None:
+    rows = [_e(MON, 100), _e(FRI, 200)]
+    assert total_by_weekday(rows) == {"Mon": 100, "Fri": 200}
+
+
+def test_zero_amount_expense_still_counts_its_weekday() -> None:
+    # 明細はあるので、金額 0 でも曜日は含める。
+    assert total_by_weekday([_e(SAT, 0)]) == {"Sat": 0}
+
+
+def test_keys_are_in_monday_first_order_regardless_of_input_order() -> None:
+    rows = [_e(SUN, 7), _e(WED, 3), _e(MON, 1), _e(SAT, 6)]
+    result = total_by_weekday(rows)
+    assert list(result) == ["Mon", "Wed", "Sat", "Sun"]
+    assert result == {"Mon": 1, "Wed": 3, "Sat": 6, "Sun": 7}
+
+
+def test_all_seven_weekdays_present_in_order() -> None:
+    rows = [_e(d, i + 1) for i, d in enumerate([SUN, SAT, FRI, THU, WED, TUE, MON])]
+    result = total_by_weekday(rows)
+    assert list(result) == ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
+    assert result == {
+        "Mon": 7,
+        "Tue": 6,
+        "Wed": 5,
+        "Thu": 4,
+        "Fri": 3,
+        "Sat": 2,
+        "Sun": 1,
+    }
+
+
+def test_input_rows_are_not_modified() -> None:
+    rows = [_e(WED, 1), _e(MON, 2)]
+    snapshot = list(rows)
+    total_by_weekday(rows)
+    assert rows == snapshot
