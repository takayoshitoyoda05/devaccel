+"""Yen amount formatting."""
+
+from __future__ import annotations
+
+
+def yen(n: int) -> str:
+    """Format a yen amount with thousands separators and a 円 suffix.
+
+    >>> yen(1234567)
+    '1,234,567円'
+    >>> yen(-1200)
+    '-1,200円'
+    """
+    return f"{n:,}円"
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
new file mode 100644
index 0000000..3f8470e
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,88 @@
+"""Month-over-month comparison of expenses by category."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def _month_of(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+    prev_tot: dict[str, int] = {}
+    curr_tot: dict[str, int] = {}
+    for e in rows:
+        m = _month_of(e)
+        if m == prev_month:
+            prev_tot[e.category] = prev_tot.get(e.category, 0) + e.amount
+        if m == curr_month:
+            curr_tot[e.category] = curr_tot.get(e.category, 0) + e.amount
+
+    out: list[DiffRow] = []
+    for cat in prev_tot.keys() | curr_tot.keys():
+        prev = prev_tot.get(cat, 0)
+        curr = curr_tot.get(cat, 0)
+        delta = curr - prev
+        # +0.0 で -0.0 を 0.0 に正規化する
+        pct = None if prev == 0 else round(delta / prev * 100, 1) + 0.0
+        if cat not in prev_tot:
+            status = "new"
+        elif cat not in curr_tot:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+    out.sort(key=lambda r: (-abs(r.delta), r.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [d for d in diffs if d.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for d in diffs:
+        pct = "-" if d.pct is None else f"{d.pct:+.1f}%"
+        lines.append(f"{d.category}\t{d.prev}\t{d.curr}\t{d.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month_of(e) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には 2 か月以上の明細が必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..f6f9ada
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,174 @@
+"""Search query language for expense rows.
+
+Grammar (lowest precedence first)::
+
+    or_expr  := and_expr ("OR" and_expr)*
+    and_expr := not_expr (["AND"] not_expr)*
+    not_expr := "NOT" not_expr | primary
+    primary  := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+
+from kakeibo.core import Expense
+
+__all__ = ["QueryError", "filter_rows", "matches", "tokenize"]
+
+
+class QueryError(ValueError):
+    """Raised when a search query is malformed."""
+
+
+Token = tuple[str, str]
+Pred = Callable[[Expense], bool]
+
+_SPECIAL = ('"', "(", ")")
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    toks: list[Token] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            toks.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            toks.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError("閉じていない引用符があります")
+            body = q[i + 1 : end]
+            if body == "":
+                raise QueryError("空の引用符は使えません")
+            toks.append(("TERM", body))
+            i = end + 1
+        else:
+            j = i
+            while j < n and not q[j].isspace() and q[j] not in _SPECIAL:
+                j += 1
+            word = q[i:j]
+            i = j
+            if word in ("AND", "OR", "NOT"):
+                toks.append((word, word))
+            elif word.startswith("cat:"):
+                value = word[len("cat:") :]
+                if value == "":
+                    raise QueryError("cat: の後ろにカテゴリ名がありません")
+                toks.append(("CAT", value))
+            else:
+                toks.append(("TERM", word))
+    return toks
+
+
+def _leaf_term(value: str) -> Pred:
+    needle = value.casefold()
+
+    def pred(e: Expense) -> bool:
+        return needle in e.memo.casefold() or needle in e.category.casefold()
+
+    return pred
+
+
+def _leaf_cat(value: str) -> Pred:
+    needle = value.casefold()
+
+    def pred(e: Expense) -> bool:
+        return e.category.casefold() == needle
+
+    return pred
+
+
+class _Parser:
+    def __init__(self, toks: list[Token]) -> None:
+        self._toks = toks
+        self._pos = 0
+
+    def _peek(self) -> str | None:
+        return self._toks[self._pos][0] if self._pos < len(self._toks) else None
+
+    def _take(self) -> Token:
+        tok = self._toks[self._pos]
+        self._pos += 1
+        return tok
+
+    def parse(self) -> Pred:
+        if not self._toks:
+            raise QueryError("検索条件が空です")
+        pred = self._or_expr()
+        if self._pos != len(self._toks):
+            raise QueryError(f"予期しないトークンです: {self._toks[self._pos][1]!r}")
+        return pred
+
+    def _or_expr(self) -> Pred:
+        pred = self._and_expr()
+        while self._peek() == "OR":
+            self._take()
+            pred = _or(pred, self._and_expr())
+        return pred
+
+    def _and_expr(self) -> Pred:
+        pred = self._not_expr()
+        while True:
+            kind = self._peek()
+            if kind == "AND":
+                self._take()
+            elif kind not in ("NOT", "TERM", "CAT", "LPAREN"):
+                break
+            pred = _and(pred, self._not_expr())
+        return pred
+
+    def _not_expr(self) -> Pred:
+        if self._peek() == "NOT":
+            self._take()
+            return _not(self._not_expr())
+        return self._primary()
+
+    def _primary(self) -> Pred:
+        kind = self._peek()
+        if kind == "TERM":
+            return _leaf_term(self._take()[1])
+        if kind == "CAT":
+            return _leaf_cat(self._take()[1])
+        if kind == "LPAREN":
+            self._take()
+            pred = self._or_expr()
+            if self._peek() != "RPAREN":
+                raise QueryError("括弧が閉じていません")
+            self._take()
+            return pred
+        if kind is None:
+            raise QueryError("演算子の後ろに条件がありません")
+        raise QueryError(f"条件が必要な位置に {self._toks[self._pos][1]!r} があります")
+
+
+def _or(a: Pred, b: Pred) -> Pred:
+    return lambda e: a(e) or b(e)
+
+
+def _and(a: Pred, b: Pred) -> Pred:
+    return lambda e: a(e) and b(e)
+
+
+def _not(a: Pred) -> Pred:
+    return lambda e: not a(e)
+
+
+def _compile(q: str) -> Pred:
+    return _Parser(tokenize(q)).parse()
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _compile(q)(e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    pred = _compile(q)
+    return [e for e in rows if pred(e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..c6cae25
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,64 @@
+"""Detect recurring (定期) expenses from monthly patterns."""
+
+from __future__ import annotations
+
+import calendar
+from collections import defaultdict
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day in the next month, clamped to that month's last day."""
+    year, month = (d.year + 1, 1) if d.month == 12 else (d.year, d.month + 1)
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def _runs(days: list[date], tolerance: int) -> list[list[date]]:
+    """Split sorted, unique days into maximal runs whose neighbours are linked."""
+    runs: list[list[date]] = []
+    for d in days:
+        if runs and abs((d - add_month(runs[-1][-1])).days) <= tolerance:
+            runs[-1].append(d)
+        else:
+            runs.append([d])
+    return runs
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    if min_count < 2:
+        raise ValueError("min_count は 2 以上である必要があります")
+    if tolerance < 0:
+        raise ValueError("tolerance は 0 以上である必要があります")
+
+    groups: dict[tuple[str, int], set[date]] = defaultdict(set)
+    for e in rows:
+        groups[(e.category, e.amount)].add(e.day)
+
+    out: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        for run in _runs(sorted(day_set), tolerance):
+            if len(run) >= min_count:
+                out.append(
+                    Recurring(
+                        category=category,
+                        amount=amount,
+                        days=tuple(run),
+                        next_expected=add_month(run[-1]),
+                    )
+                )
+    out.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return out
