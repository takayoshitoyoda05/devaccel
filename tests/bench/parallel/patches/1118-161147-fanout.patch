diff --git a/src/kakeibo/bankimport.py b/src/kakeibo/bankimport.py
new file mode 100644
index 0000000..e262e14
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,111 @@
+"""Import bank statement CSVs (他行 CSV) into Expense records."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"-?[¥￥]?[0-9][0-9,]*円?")
+_DATE_RE = re.compile(r"([0-9]{4})(?P<sep>[/-])([0-9]{1,2})(?P=sep)([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    """Parse amounts like ``-¥1,234`` / ``980円`` into integer yen."""
+    text = s.strip()
+    if not _AMOUNT_RE.fullmatch(text):
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    digits = text.replace("¥", "").replace("￥", "").replace("円", "")
+    return int(digits.replace(",", ""))
+
+
+def parse_date(s: str) -> date:
+    """Parse ``YYYY/M/D`` or ``YYYY-M-D`` into a date."""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    year, month, day = int(m.group(1)), int(m.group(3)), int(m.group(4))
+    try:
+        return date(year, month, day)
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Convert a bank CSV (header on line 1) into expenses.
+
+    Returns ``(expenses, errors)`` where errors are ``(line_number, field)``.
+    Rows with any error are excluded from the expenses.
+    """
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text))
+    header: list[str] = next(reader, [])
+    index = {name: i for i, name in enumerate(header)}
+    for field, col in mapping.items():
+        if col not in index:
+            raise ValueError(f"列 {col!r} (field: {field}) がヘッダーにありません")
+
+    def cell(row: list[str], field: str) -> str:
+        if field not in mapping:
+            return ""
+        i = index[mapping[field]]
+        return row[i] if i < len(row) else ""
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    prev_line = reader.line_num
+    for row in reader:
+        start = prev_line + 1
+        prev_line = reader.line_num
+        if not row:  # 空行は読み飛ばす(行番号は数える)
+            continue
+
+        row_errors: list[tuple[int, str]] = []
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(cell(row, "date"))
+        except ValueError:
+            row_errors.append((start, "date"))
+        try:
+            amount = parse_amount(cell(row, "amount"))
+        except ValueError:
+            row_errors.append((start, "amount"))
+        category = cell(row, "category").strip()
+        if not category:
+            row_errors.append((start, "category"))
+
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        assert day is not None and amount is not None
+        if category_map and category in category_map:
+            category = category_map[category]
+        expenses.append(
+            Expense(
+                day=day,
+                category=category,
+                amount=amount,
+                memo=cell(row, "memo").strip(),
+            )
+        )
+    return expenses, errors
