+import json
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.export import to_json
+
+
+def test_empty_list_is_empty_json_array():
+    assert to_json([]) == "[]"
+
+
+def test_single_row_has_expected_keys_in_order_and_no_indent():
+    out = to_json([Expense(date(2026, 11, 1), "food", 1200, "lunch")])
+    assert out == (
+        '[{"date": "2026-11-01", "category": "food", "amount": 1200, "memo": "lunch"}]'
+    )
+    assert "\n" not in out
+
+
+def test_rows_keep_input_order_and_are_not_sorted():
+    rows = [
+        Expense(date(2026, 11, 3), "b", 3),
+        Expense(date(2026, 11, 1), "a", 1),
+        Expense(date(2026, 11, 2), "c", 2),
+    ]
+    data = json.loads(to_json(rows))
+    assert [r["category"] for r in data] == ["b", "a", "c"]
+
+
+def test_non_ascii_is_not_escaped():
+    out = to_json([Expense(date(2026, 1, 5), "食費", 500, "コンビニ")])
+    assert "食費" in out
+    assert "コンビニ" in out
+    assert "\\u" not in out
+
+
+def test_empty_memo_is_kept_as_empty_string():
+    out = json.loads(to_json([Expense(date(2026, 1, 5), "food", 10)]))
+    assert out[0]["memo"] == ""
+
+
+def test_date_is_zero_padded_iso_format():
+    out = json.loads(to_json([Expense(date(2026, 3, 7), "food", 10, "")]))
+    assert out[0]["date"] == "2026-03-07"
+
+
+def test_amount_is_json_integer_and_quotes_are_escaped():
+    out = json.loads(to_json([Expense(date(2026, 1, 1), 'a"b', 0, 'x"y')]))
+    assert out[0]["amount"] == 0
+    assert isinstance(out[0]["amount"], int)
+    assert out[0]["category"] == 'a"b'
+    assert out[0]["memo"] == 'x"y'
