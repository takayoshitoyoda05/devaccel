+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.streak import longest_no_spend_streak
+
+
+def _e(day: date, amount: int = 100) -> Expense:
+    return Expense(day, "food", amount)
+
+
+def test_no_rows_means_whole_period_is_streak():
+    assert longest_no_spend_streak([], date(2026, 11, 1), date(2026, 11, 3)) == 3
+
+
+def test_single_day_without_spending_is_streak_of_one():
+    d = date(2026, 11, 5)
+    assert longest_no_spend_streak([], d, d) == 1
+
+
+def test_single_day_with_spending_is_zero():
+    d = date(2026, 11, 5)
+    assert longest_no_spend_streak([_e(d)], d, d) == 0
+
+
+def test_spending_on_first_and_last_day_bounds_the_streak():
+    rows = [_e(date(2026, 11, 1)), _e(date(2026, 11, 5))]
+    # 11/2〜11/4 の 3 日が空白
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 5)) == 3
+
+
+def test_longest_run_wins_over_earlier_shorter_run():
+    rows = [
+        _e(date(2026, 11, 2)),  # 11/1 の 1 日
+        _e(date(2026, 11, 6)),  # 11/3〜11/5 の 3 日
+    ]
+    # 11/7〜11/10 の 4 日が最長
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 10)) == 4
+
+
+def test_rows_outside_period_are_ignored():
+    rows = [_e(date(2026, 10, 31)), _e(date(2026, 11, 4))]
+    # 期間外の明細は空白日を塞がない: 11/1〜11/3 の 3 日
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 3)) == 3
+
+
+def test_multiple_rows_on_same_day_count_as_one_spending_day():
+    d = date(2026, 11, 2)
+    rows = [_e(d, 100), _e(d, 200)]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 3)) == 1
+
+
+def test_zero_amount_row_still_counts_as_spending():
+    # 明細が 1 件でもあれば金額にかかわらず使った日扱い
+    d = date(2026, 11, 2)
+    rows = [_e(d, 0)]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 3)) == 1
+
+
+def test_row_order_does_not_matter():
+    # 11/2 と 11/4 で区切られ、空白は 11/1・11/3・11/5 の各 1 日
+    rows = [_e(date(2026, 11, 4)), _e(date(2026, 11, 2))]
+    assert longest_no_spend_streak(rows, date(2026, 11, 1), date(2026, 11, 5)) == 1
+    rows_sorted = list(reversed(rows))
+    assert (
+        longest_no_spend_streak(rows_sorted, date(2026, 11, 1), date(2026, 11, 5)) == 1
+    )
+
+
+def test_start_after_end_is_zero():
+    assert longest_no_spend_streak([], date(2026, 11, 5), date(2026, 11, 1)) == 0
