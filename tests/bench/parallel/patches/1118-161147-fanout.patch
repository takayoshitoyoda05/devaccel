@@ -0,0 +1,22 @@
+"""Detect duplicate expense rows."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+
+def find_duplicates(rows: list[Expense]) -> list[tuple[int, int]]:
+    """Index pairs (i, j), i < j, of rows identical in day, category, amount and memo.
+
+    Sorted by i ascending, then j ascending.
+    """
+    groups: dict[Expense, list[int]] = {}
+    for idx, row in enumerate(rows):
+        groups.setdefault(row, []).append(idx)
+
+    pairs: list[tuple[int, int]] = []
+    for i, row in enumerate(rows):
+        for j in groups[row]:
+            if j > i:
+                pairs.append((i, j))
+    return pairs
