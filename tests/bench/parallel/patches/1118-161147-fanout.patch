@@ -0,0 +1,63 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.dupes import find_duplicates
+
+D = date(2026, 11, 1)
+
+
+def _e(day=D, category="food", amount=1200, memo=""):
+    return Expense(day, category, amount, memo)
+
+
+def test_empty_list_has_no_duplicates():
+    assert find_duplicates([]) == []
+
+
+def test_single_row_has_no_duplicates():
+    assert find_duplicates([_e()]) == []
+
+
+def test_two_identical_rows_form_one_pair():
+    assert find_duplicates([_e(), _e()]) == [(0, 1)]
+
+
+def test_no_duplicates_returns_empty():
+    rows = [_e(), _e(amount=100), _e(category="rent")]
+    assert find_duplicates(rows) == []
+
+
+def test_differs_in_day_is_not_duplicate():
+    assert find_duplicates([_e(), _e(day=date(2026, 11, 2))]) == []
+
+
+def test_differs_in_category_is_not_duplicate():
+    assert find_duplicates([_e(), _e(category="rent")]) == []
+
+
+def test_differs_in_amount_is_not_duplicate():
+    assert find_duplicates([_e(), _e(amount=1201)]) == []
+
+
+def test_differs_in_memo_is_not_duplicate():
+    assert find_duplicates([_e(memo="a"), _e(memo="")]) == []
+
+
+def test_empty_memo_equals_empty_memo():
+    assert find_duplicates([_e(memo=""), _e(memo="")]) == [(0, 1)]
+
+
+def test_three_identical_rows_yield_all_pairs_in_order():
+    assert find_duplicates([_e(), _e(), _e()]) == [(0, 1), (0, 2), (1, 2)]
+
+
+def test_non_adjacent_duplicates_and_i_ascending_order():
+    rows = [_e(), _e(amount=5), _e(amount=6), _e(amount=5), _e()]
+    # group amount=5 at (1,3); group amount=1200 at (0,4)
+    assert find_duplicates(rows) == [(0, 4), (1, 3)]
+
+
+def test_pairs_are_only_i_less_than_j_and_never_self():
+    pairs = find_duplicates([_e(), _e()])
+    assert all(i < j for i, j in pairs)
+    assert (0, 0) not in pairs and (1, 1) not in pairs
