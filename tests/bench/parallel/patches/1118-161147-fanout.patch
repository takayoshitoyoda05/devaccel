+"""Aggregate expenses by day of week."""
+
+from __future__ import annotations
+
+from kakeibo.core import Expense
+
+_WEEKDAY_NAMES = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
+
+
+def total_by_weekday(rows: list[Expense]) -> dict[str, int]:
+    """{"Mon".."Sun": yen}; only weekdays with expenses, Monday first."""
+    sums: dict[int, int] = {}
+    for e in rows:
+        idx = e.day.weekday()  # 0 = Monday
+        sums[idx] = sums.get(idx, 0) + e.amount
+    return {_WEEKDAY_NAMES[i]: sums[i] for i in sorted(sums)}
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..6be736b
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,152 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+HEADER = "利用日,分類,利用金額,利用店名\n"
+
+
+# --- parse_amount ---
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥5", 5),
+        ("￥5", 5),
+        ("-5", -5),
+        ("1,2", 12),  # カンマの位置は検査しない
+        ("-980円", -980),
+    ],
+)
+def test_parse_amount_accepts(text, expected):
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    ["", "円", "12.5", "1 200", "--5", "¥-5", "１２３", ",", "-", "¥", "5円円", "円5"],
+)
+def test_parse_amount_rejects(text):
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+# --- parse_date ---
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/11/18 ", date(2026, 11, 18)),
+        ("2026-1-5", date(2026, 1, 5)),
+        ("2026/12/31", date(2026, 12, 31)),
+    ],
+)
+def test_parse_date_accepts(text, expected):
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    ["2026/1-5", "26/1/5", "2026/02/30", "", "2026.1.5", "2026/13/1", "２０２６/1/5"],
+)
+def test_parse_date_rejects(text):
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+# --- import_rows ---
+
+
+def test_default_mapping_values():
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_import_rows_basic_and_quoted_comma():
+    text = HEADER + '2026/11/1,食費,"1,200円","ＡＢ, C"\n'
+    expenses, errors = import_rows(text)
+    assert errors == []
+    assert expenses == [Expense(date(2026, 11, 1), "食費", 1200, "ＡＢ, C")]
+
+
+def test_import_rows_extra_columns_ignored_and_memo_optional():
+    text = "利用日,分類,利用金額,備考\n2026/11/2, 食費 ,-¥300,x\n"
+    mapping = {"date": "利用日", "category": "分類", "amount": "利用金額"}
+    expenses, errors = import_rows(text, mapping)
+    assert errors == []
+    assert expenses == [Expense(date(2026, 11, 2), "食費", -300, "")]
+
+
+def test_import_rows_mapping_missing_required_key_raises():
+    with pytest.raises(ValueError):
+        import_rows(HEADER, {"date": "利用日", "amount": "利用金額"})
+
+
+def test_import_rows_mapping_missing_memo_column_raises():
+    with pytest.raises(ValueError):
+        import_rows(HEADER, {**DEFAULT_MAPPING, "memo": "存在しない"})
+
+
+def test_import_rows_mapping_column_missing_from_header_raises():
+    with pytest.raises(ValueError):
+        import_rows(HEADER, {**DEFAULT_MAPPING, "amount": "金額"})
+
+
+def test_import_rows_reports_each_field_in_order_and_skips_row():
+    text = HEADER + "bad,   ,xyz,\n"
+    expenses, errors = import_rows(text)
+    assert expenses == []
+    assert errors == [(2, "date"), (2, "amount"), (2, "category")]
+
+
+def test_import_rows_error_row_excluded_but_others_kept():
+    text = HEADER + "2026/11/1,食費,100,a\n2026/11/2,食費,1.5,b\n2026/11/3,食費,200,c\n"
+    expenses, errors = import_rows(text)
+    assert errors == [(3, "amount")]
+    assert [e.amount for e in expenses] == [100, 200]
+
+
+def test_import_rows_line_numbers_count_blank_lines():
+    text = HEADER + "\n2026/11/1,食費,100,a\n\nbad,食費,100,b\n"
+    expenses, errors = import_rows(text)
+    assert [e.amount for e in expenses] == [100]
+    assert errors == [(5, "date")]
+
+
+def test_import_rows_short_row_missing_values_are_empty():
+    text = HEADER + "2026/11/1,食費\n"
+    expenses, errors = import_rows(text)
+    assert expenses == []
+    assert errors == [(2, "amount")]
+
+
+def test_import_rows_category_map_applied_after_strip():
+    text = HEADER + "2026/11/1, 外食 ,100,\n2026/11/2,交通,50,\n"
+    expenses, errors = import_rows(text, category_map={"外食": "食費"})
+    assert errors == []
+    assert [e.category for e in expenses] == ["食費", "交通"]
+
+
+def test_import_rows_memo_stripped():
+    text = HEADER + '2026/11/1,食費,100,"  店 名  "\n'
+    expenses, _ = import_rows(text)
+    assert expenses[0].memo == "店 名"
+
+
+def test_import_rows_empty_input_raises_for_missing_columns():
+    with pytest.raises(ValueError):
+        import_rows("")
