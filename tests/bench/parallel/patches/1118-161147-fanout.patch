new file mode 100644
index 0000000..36e863e
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,153 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+ROWS = [
+    Expense(date(2026, 10, 5), "food", 1000),
+    Expense(date(2026, 10, 20), "food", 500),
+    Expense(date(2026, 10, 3), "rent", 80000),
+    Expense(date(2026, 10, 10), "book", 2000),
+    Expense(date(2026, 11, 2), "food", 1200),
+    Expense(date(2026, 11, 3), "rent", 80000),
+    Expense(date(2026, 11, 4), "cafe", 300),
+]
+
+
+def test_month_diff_statuses_and_order():
+    # 差の絶対値の降順。同じ差(cafe 300 / food 300)は category の昇順。
+    assert month_diff(ROWS, "2026-10", "2026-11") == [
+        DiffRow("book", 2000, 0, -2000, -100.0, "gone"),
+        DiffRow("cafe", 0, 300, 300, None, "new"),
+        DiffRow("food", 1500, 1200, -300, -20.0, "down"),
+        DiffRow("rent", 80000, 80000, 0, 0.0, "same"),
+    ]
+
+
+def test_month_diff_up_and_pct_rounding():
+    rows = [
+        Expense(date(2026, 10, 1), "food", 1000),
+        Expense(date(2026, 11, 1), "food", 1200),
+        Expense(date(2026, 10, 1), "misc", 3),
+        Expense(date(2026, 11, 1), "misc", 4),
+    ]
+    got = {r.category: r for r in month_diff(rows, "2026-10", "2026-11")}
+    assert got["food"] == DiffRow("food", 1000, 1200, 200, 20.0, "up")
+    assert got["misc"] == DiffRow("misc", 3, 4, 1, 33.3, "up")
+
+
+def test_zero_total_prev_gives_none_pct_but_keeps_presence_status():
+    rows = [Expense(date(2026, 11, 1), "misc", 500)]
+    rows.append(Expense(date(2026, 10, 1), "misc", 0))
+    assert month_diff(rows, "2026-10", "2026-11") == [
+        DiffRow("misc", 0, 500, 500, None, "up")
+    ]
+
+
+def test_status_uses_presence_not_sum():
+    # prev に 0 円の明細だけ: 合計 0 でも "new" ではなく、curr に無いので "gone"
+    rows = [Expense(date(2026, 10, 1), "misc", 0)]
+    assert month_diff(rows, "2026-10", "2026-11") == [
+        DiffRow("misc", 0, 0, 0, None, "gone")
+    ]
+    # curr に 0 円の明細だけ: 合計 0 でも "gone" ではなく "down"
+    rows = [
+        Expense(date(2026, 10, 1), "misc", 500),
+        Expense(date(2026, 11, 1), "misc", 0),
+    ]
+    assert month_diff(rows, "2026-10", "2026-11") == [
+        DiffRow("misc", 500, 0, -500, -100.0, "down")
+    ]
+
+
+def test_tiny_negative_pct_is_not_negative_zero():
+    rows = [
+        Expense(date(2026, 10, 1), "food", 10000),
+        Expense(date(2026, 11, 1), "food", 9999),
+    ]
+    (row,) = month_diff(rows, "2026-10", "2026-11")
+    assert row.status == "down"
+    assert row.pct == 0.0
+    assert str(row.pct) == "0.0"
+
+
+def test_empty_rows_give_empty_list():
+    assert month_diff([], "2026-10", "2026-11") == []
+
+
+@pytest.mark.parametrize(
+    "bad", ["2026-1", "2026-13", "2026-00", "26-11", "2026/11", "2026-11\n", "202611"]
+)
+def test_month_diff_rejects_bad_month(bad):
+    with pytest.raises(ValueError):
+        month_diff(ROWS, bad, "2026-11")
+    with pytest.raises(ValueError):
+        month_diff(ROWS, "2026-10", bad)
+    with pytest.raises(ValueError):
+        month_diff([], bad, "2026-11")
+
+
+def test_top_movers_excludes_same_and_keeps_order():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    assert [r.category for r in top_movers(diffs, 2)] == ["book", "cafe"]
+    assert [r.category for r in top_movers(diffs)] == ["book", "cafe", "food"]
+    assert [r.category for r in top_movers(diffs, 10)] == ["book", "cafe", "food"]
+    assert top_movers(diffs, 0) == []
+    assert top_movers([], 3) == []
+
+
+def test_top_movers_rejects_negative_n():
+    with pytest.raises(ValueError):
+        top_movers(month_diff(ROWS, "2026-10", "2026-11"), -1)
+
+
+def test_render_diff_exact_text():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "book\t2000\t0\t-2000\t-100.0%\n"
+        "cafe\t0\t300\t+300\t-\n"
+        "food\t1500\t1200\t-300\t-20.0%\n"
+        "rent\t80000\t80000\t+0\t+0.0%"
+    )
+
+
+def test_render_diff_plus_sign_and_no_trailing_newline():
+    text = render_diff([DiffRow("food", 1000, 1200, 200, 20.0, "up")])
+    assert text == ("category\tprev\tcurr\tdelta\tpct\nfood\t1000\t1200\t+200\t+20.0%")
+    assert not text.endswith("\n")
+
+
+def test_render_diff_empty_is_header_only():
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_available_months_sorted_unique_across_years():
+    rows = [
+        Expense(date(2026, 1, 1), "food", 1),
+        Expense(date(2025, 12, 31), "food", 1),
+        Expense(date(2026, 1, 15), "rent", 1),
+    ]
+    assert available_months(rows) == ["2025-12", "2026-01"]
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months():
+    rows = ROWS + [Expense(date(2026, 9, 1), "food", 9999)]
+    assert latest_diff(rows) == month_diff(ROWS, "2026-10", "2026-11")
+
+
+def test_latest_diff_needs_two_months():
+    with pytest.raises(ValueError):
+        latest_diff([])
+    with pytest.raises(ValueError):
+        latest_diff([Expense(date(2026, 11, 1), "food", 1)])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..449c376
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,213 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+E1 = Expense(date(2026, 11, 1), "food", 1200, "lunch")
+E2 = Expense(date(2026, 11, 2), "rent", 80000, "")
+E3 = Expense(date(2026, 11, 3), "food", 800, "coffee")
+E4 = Expense(date(2026, 11, 4), "Food", 500, "lunch with friends")
+ROWS = [E1, E2, E3, E4]
+
+
+def _texts(q: str) -> list[str]:
+    return [e.memo or e.category for e in filter_rows(q, ROWS)]
+
+
+# --- tokenize -------------------------------------------------------------
+
+
+def test_tokenize_whitespace_only_is_empty():
+    assert tokenize("   \t ") == []
+
+
+def test_tokenize_parens():
+    assert tokenize("(x)") == [("LPAREN", "("), ("TERM", "x"), ("RPAREN", ")")]
+
+
+def test_tokenize_quoted_keeps_spaces_and_parens():
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+
+
+def test_tokenize_unclosed_quote_raises():
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_raises():
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_operators_only_uppercase():
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+    assert tokenize("and") == [("TERM", "and")]
+    assert tokenize("NOTE") == [("TERM", "NOTE")]
+    assert tokenize("ANDx") == [("TERM", "ANDx")]
+
+
+def test_tokenize_quoted_operator_is_term():
+    assert tokenize('"AND"') == [("TERM", "AND")]
+
+
+def test_tokenize_cat_prefix():
+    assert tokenize("cat:food") == [("CAT", "food")]
+    assert tokenize("cat:a:b") == [("CAT", "a:b")]
+
+
+def test_tokenize_cat_empty_raises():
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_tokenize_cat_prefix_is_case_sensitive():
+    assert tokenize("CAT:food") == [("TERM", "CAT:food")]
+
+
+def test_tokenize_quoted_cat_is_term():
+    assert tokenize('"cat:food"') == [("TERM", "cat:food")]
+
+
+def test_tokenize_word_stops_at_quote():
+    assert tokenize('abc"def"') == [("TERM", "abc"), ("TERM", "def")]
+
+
+# --- grammar errors -------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(",
+        ")",
+        "x)",
+        "(x",
+        "AND",
+        "OR",
+        "NOT",
+        "x AND",
+        "x OR",
+        "OR x",
+        "AND x",
+        "x AND AND y",
+        "NOT )",
+        "x OR OR y",
+    ],
+)
+def test_grammar_errors(q):
+    with pytest.raises(QueryError):
+        filter_rows(q, ROWS)
+
+
+def test_grammar_error_raised_even_when_rows_empty():
+    with pytest.raises(QueryError):
+        filter_rows("x AND", [])
+
+
+def test_valid_query_on_empty_rows_is_empty():
+    assert filter_rows("food", []) == []
+
+
+# --- evaluation -----------------------------------------------------------
+
+
+def test_term_matches_memo_substring():
+    assert _texts("lunch") == ["lunch", "lunch with friends"]
+
+
+def test_term_matches_category_substring():
+    assert _texts("foo") == ["lunch", "coffee", "lunch with friends"]
+
+
+def test_term_casefold():
+    assert _texts("LUNCH") == ["lunch", "lunch with friends"]
+
+
+def test_term_empty_memo_only_matches_category():
+    assert matches("rent", E2)
+    assert not matches("80000", E2)
+
+
+def test_cat_exact_match_only():
+    assert _texts("cat:food") == ["lunch", "coffee", "lunch with friends"]
+    assert _texts("cat:foo") == []
+
+
+def test_cat_casefold():
+    assert matches("cat:FOOD", E1)
+
+
+def test_cat_prefix_uppercase_is_term_not_cat():
+    # "CAT:food" is a TERM; it is not a substring of memo or category
+    assert not matches("CAT:food", E1)
+
+
+def test_cat_is_not_substring():
+    assert not matches("cat:lunch", E1)
+
+
+def test_implicit_and():
+    assert _texts("food lunch") == ["lunch", "lunch with friends"]
+
+
+def test_explicit_and():
+    assert _texts("food AND coffee") == ["coffee"]
+
+
+def test_or():
+    assert _texts("rent OR coffee") == ["rent", "coffee"]
+
+
+def test_precedence_and_binds_tighter_than_or():
+    # rent OR (coffee AND lunch) -> only rent
+    assert _texts("rent OR coffee lunch") == ["rent"]
+
+
+def test_not_binds_tighter_than_and():
+    # (NOT lunch) AND food
+    assert _texts("NOT lunch food") == ["coffee"]
+
+
+def test_double_not():
+    assert _texts("NOT NOT coffee") == ["coffee"]
+
+
+def test_parens_override_precedence():
+    # (rent OR coffee) lunch -> nothing has both
+    assert _texts("(rent OR coffee) lunch") == []
+    assert _texts("(lunch OR coffee) food") == [
+        "lunch",
+        "coffee",
+        "lunch with friends",
+    ]
+
+
+def test_nested_parens():
+    assert _texts("((coffee))") == ["coffee"]
+
+
+def test_quoted_term_with_space():
+    assert _texts('"with friends"') == ["lunch with friends"]
+
+
+def test_filter_keeps_input_order():
+    assert filter_rows("food", [E4, E3, E1]) == [E4, E3, E1]
+
+
+def test_no_match_is_empty_list():
+    assert filter_rows("zzz", ROWS) == []
+
+
+def test_matches_single_row():
+    assert matches("cat:food AND NOT friends", E1)
+    assert not matches("cat:food AND NOT friends", E4)
+
+
+def test_matches_invalid_query_raises():
+    with pytest.raises(QueryError):
+        matches("", E1)
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..a483f18
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,239 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def e(
+    day: date, category: str = "家賃", amount: int = 80000, memo: str = ""
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- add_month -------------------------------------------------------------
+
+
+def test_add_month_same_day() -> None:
+    assert add_month(date(2026, 3, 10)) == date(2026, 4, 10)
+
+
+def test_add_month_year_rollover() -> None:
+    assert add_month(date(2026, 12, 15)) == date(2027, 1, 15)
+
+
+def test_add_month_clamps_to_end_of_non_leap_february() -> None:
+    assert add_month(date(2026, 1, 31)) == date(2026, 2, 28)
+
+
+def test_add_month_clamps_to_end_of_leap_february() -> None:
+    assert add_month(date(2024, 1, 31)) == date(2024, 2, 29)
+
+
+def test_add_month_clamps_30_day_month() -> None:
+    assert add_month(date(2026, 3, 31)) == date(2026, 4, 30)
+
+
+def test_add_month_feb_29_to_non_leap_march_keeps_day() -> None:
+    assert add_month(date(2024, 2, 29)) == date(2024, 3, 29)
+
+
+# --- find_recurring: arguments --------------------------------------------
+
+
+def test_min_count_below_2_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+
+
+def test_negative_tolerance_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_tolerance_zero_is_allowed() -> None:
+    rows = [e(date(2026, 1, 15)), e(date(2026, 2, 15)), e(date(2026, 3, 15))]
+    assert len(find_recurring(rows, tolerance=0)) == 1
+
+
+# --- find_recurring: basic ------------------------------------------------
+
+
+def test_empty_input_returns_empty_list() -> None:
+    assert find_recurring([]) == []
+
+
+def test_monthly_series_is_detected() -> None:
+    rows = [e(date(2026, 1, 15)), e(date(2026, 2, 15)), e(date(2026, 3, 15))]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="家賃",
+            amount=80000,
+            days=(date(2026, 1, 15), date(2026, 2, 15), date(2026, 3, 15)),
+            next_expected=date(2026, 4, 15),
+        )
+    ]
+
+
+def test_input_order_does_not_matter() -> None:
+    rows = [e(date(2026, 3, 15)), e(date(2026, 1, 15)), e(date(2026, 2, 15))]
+    (r,) = find_recurring(rows)
+    assert r.days == (date(2026, 1, 15), date(2026, 2, 15), date(2026, 3, 15))
+
+
+def test_fewer_than_min_count_is_not_reported() -> None:
+    rows = [e(date(2026, 1, 15)), e(date(2026, 2, 15))]
+    assert find_recurring(rows) == []
+
+
+def test_run_of_exactly_min_count_is_reported() -> None:
+    rows = [e(date(2026, 1, 15)), e(date(2026, 2, 15)), e(date(2026, 3, 15))]
+    assert len(find_recurring(rows, min_count=3)) == 1
+
+
+def test_min_count_is_respected() -> None:
+    rows = [e(date(2026, 1, 15)), e(date(2026, 2, 15)), e(date(2026, 3, 15))]
+    assert find_recurring(rows, min_count=4) == []
+
+
+# --- find_recurring: grouping ---------------------------------------------
+
+
+def test_memo_is_ignored_when_grouping() -> None:
+    rows = [
+        e(date(2026, 1, 15), memo="a"),
+        e(date(2026, 2, 15), memo="b"),
+        e(date(2026, 3, 15), memo=""),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_different_amounts_are_separate_groups() -> None:
+    rows = [
+        e(date(2026, 1, 15), amount=1000),
+        e(date(2026, 2, 15), amount=2000),
+        e(date(2026, 3, 15), amount=1000),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_different_categories_are_separate_groups() -> None:
+    rows = [
+        e(date(2026, 1, 15), category="A"),
+        e(date(2026, 2, 15), category="B"),
+        e(date(2026, 3, 15), category="A"),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_same_day_duplicates_count_once() -> None:
+    rows = [
+        e(date(2026, 1, 15), memo="x"),
+        e(date(2026, 1, 15), memo="y"),
+        e(date(2026, 2, 15)),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_same_day_duplicates_are_not_listed_twice() -> None:
+    rows = [
+        e(date(2026, 1, 15)),
+        e(date(2026, 1, 15)),
+        e(date(2026, 2, 15)),
+        e(date(2026, 3, 15)),
+    ]
+    (r,) = find_recurring(rows)
+    assert r.days == (date(2026, 1, 15), date(2026, 2, 15), date(2026, 3, 15))
+
+
+# --- find_recurring: tolerance and splitting ------------------------------
+
+
+def test_gap_within_tolerance_connects() -> None:
+    # add_month(2026-01-15) = 2026-02-15; 2026-02-18 is 3 days away (== tolerance)
+    rows = [e(date(2026, 1, 15)), e(date(2026, 2, 18)), e(date(2026, 3, 18))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+
+
+def test_gap_beyond_tolerance_splits_series() -> None:
+    # 2026-02-19 is 4 days from 2026-02-15 (> tolerance 3)
+    rows = [e(date(2026, 1, 15)), e(date(2026, 2, 19)), e(date(2026, 3, 19))]
+    assert find_recurring(rows, tolerance=3) == []
+
+
+def test_early_side_of_tolerance_connects() -> None:
+    # 2026-02-12 is 3 days before 2026-02-15 (abs, inclusive)
+    rows = [e(date(2026, 1, 15)), e(date(2026, 2, 12)), e(date(2026, 3, 12))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+
+
+def test_break_produces_two_recurring_entries() -> None:
+    rows = [
+        e(date(2026, 1, 15)),
+        e(date(2026, 2, 15)),
+        e(date(2026, 3, 15)),
+        # break: expected 2026-04-15, actual 2026-05-01
+        e(date(2026, 5, 1)),
+        e(date(2026, 6, 1)),
+        e(date(2026, 7, 1)),
+    ]
+    got = find_recurring(rows)
+    assert [r.days[0] for r in got] == [date(2026, 1, 15), date(2026, 5, 1)]
+    assert got[0].next_expected == date(2026, 4, 15)
+    assert got[1].next_expected == date(2026, 8, 1)
+
+
+def test_short_run_before_break_is_dropped_but_later_run_kept() -> None:
+    rows = [
+        e(date(2026, 1, 15)),
+        e(date(2026, 2, 15)),
+        e(date(2026, 6, 1)),
+        e(date(2026, 7, 1)),
+        e(date(2026, 8, 1)),
+    ]
+    got = find_recurring(rows)
+    assert len(got) == 1
+    assert got[0].days[0] == date(2026, 6, 1)
+
+
+def test_month_end_clamp_chains_with_tolerance() -> None:
+    # 01-31 -> expected 02-28; 02-28 -> expected 03-28; actual 03-31 is 3 days away
+    rows = [e(date(2026, 1, 31)), e(date(2026, 2, 28)), e(date(2026, 3, 31))]
+    (r,) = find_recurring(rows, tolerance=3)
+    assert r.next_expected == date(2026, 4, 30)
+
+
+# --- find_recurring: ordering ---------------------------------------------
+
+
+def test_results_sorted_by_category_then_amount_then_first_day() -> None:
+    rows = [
+        # category "b", amount 100, starts 2026-02-01
+        e(date(2026, 2, 1), category="b", amount=100),
+        e(date(2026, 3, 1), category="b", amount=100),
+        e(date(2026, 4, 1), category="b", amount=100),
+        # category "a", amount 300
+        e(date(2026, 1, 5), category="a", amount=300),
+        e(date(2026, 2, 5), category="a", amount=300),
+        e(date(2026, 3, 5), category="a", amount=300),
+        # category "a", amount 200
+        e(date(2026, 1, 9), category="a", amount=200),
+        e(date(2026, 2, 9), category="a", amount=200),
+        e(date(2026, 3, 9), category="a", amount=200),
+    ]
+    got = [(r.category, r.amount) for r in find_recurring(rows)]
+    assert got == [("a", 200), ("a", 300), ("b", 100)]
+
+
+def test_same_group_ordered_by_first_day() -> None:
+    rows = [
+        e(date(2026, 5, 1)),
+        e(date(2026, 6, 1)),
+        e(date(2026, 7, 1)),
+        e(date(2026, 1, 15)),
+        e(date(2026, 2, 15)),
+        e(date(2026, 3, 15)),
+    ]
+    got = find_recurring(rows)
+    assert [r.days[0] for r in got] == [date(2026, 1, 15), date(2026, 5, 1)]
