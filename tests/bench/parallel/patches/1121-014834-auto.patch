+def test_cli_modes_mutually_exclusive(tmp_path, monkeypatch, capsys):
+    with pytest.raises(SystemExit) as ei:
+        _run(tmp_path, monkeypatch, capsys, "--balance", "--report")
+    assert ei.value.code == 2
