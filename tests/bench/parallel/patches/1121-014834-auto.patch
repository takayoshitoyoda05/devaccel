+def test_cli_legacy_csv_report_and_unassigned_filter(tmp_path, monkeypatch, capsys):
+    legacy = "2026-11-01,food,100,x\n2026-11-02,food,50,\n"
+    h = "date,category,amount,memo\n"
+    out = _run(tmp_path, monkeypatch, capsys, "--account-report", body=legacy, header=h)
+    assert out.out == f"2026-11\t{UNASSIGNED}\t150\t0\t0\t-150\n"
+    out = _run(
+        tmp_path, monkeypatch, capsys, "--account", UNASSIGNED, body=legacy, header=h
+    )
+    assert out.out == "food\t150\n"
