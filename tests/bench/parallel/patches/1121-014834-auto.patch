+def test_cli_account_report_ignores_memo_with_notice(tmp_path, monkeypatch, capsys):
+    out = _run(
+        tmp_path,
+        monkeypatch,
+        capsys,
+        "--account-report",
+        "--memo",
+        "zzz",
+        "--account",
+        "card",
+    )
+    assert "2026-11\tcard\t1200\t0\t0\t-1200" in out.out
+    assert "--memo" in out.err
