+def test_cli_balance_history(tmp_path, monkeypatch, capsys):
+    out = _run(tmp_path, monkeypatch, capsys, "--balance", "--opening", "cash=10000")
+    lines = out.out.splitlines()
+    assert lines[0] == "2026-10-31\tcash\t8500"
+    assert "2026-11-05\tbank\t-110000" in lines
+    assert "2026-11-05\tcash\t38500" in lines
+    assert lines[-1] == "2027-01-15\tcard\t0"
+    assert lines == sorted(lines, key=lambda s: tuple(s.split("\t")[:2]))
+
+
+def test_cli_balance_single_account(tmp_path, monkeypatch, capsys):
+    out = _run(tmp_path, monkeypatch, capsys, "--balance", "--account", "card")
+    assert out.out == "2026-11-01\tcard\t-1200\n2027-01-15\tcard\t0\n"
