+@pytest.mark.parametrize(
+    "opening",
+    [["cash"], ["cash=1.5"], ["cash=1", "--opening", "cash=2"]],
+)
+def test_cli_opening_errors(tmp_path, monkeypatch, capsys, opening):
+    with pytest.raises(SystemExit) as ei:
+        _run(tmp_path, monkeypatch, capsys, "--balance", "--opening", *opening)
+    assert ei.value.code == 2
