+
+def test_cli_account_report(tmp_path, monkeypatch, capsys):
+    out = _run(tmp_path, monkeypatch, capsys, "--account-report", "--account", "bank")
+    lines = out.out.splitlines()
+    assert lines[0] == "2026-10\tbank\t0\t0\t0\t0"
+    assert lines[1] == "2026-11\tbank\t80000\t0\t30000\t-110000"
+    assert lines[2] == "2026-12\tbank\t0\t0\t0\t-110000"  # 欠けた月
+    assert lines[3] == "2027-01\tbank\t0\t0\t1200\t-111200"
+    assert len(lines) == 4
