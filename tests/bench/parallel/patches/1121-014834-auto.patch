new file mode 100644
index 0000000..134fde9
--- /dev/null
+++ b/src/kakeibo/accounts.py
@@ -0,0 +1,145 @@
+"""口座(現金・銀行・クレジットカードなど)ごとの残高と月次レポート。
+
+Expense(core.py)が account / transfer_to を持つ。ここは集計だけを担う(再利用: Expense・日付は core のまま)。
+
+規則と判断:
+D1: 口座名は前後の空白を除いた文字列で、完全一致で区別する(大文字小文字・全角半角は別物)。
+D2: 口座列の無い従来の CSV・空欄の行は口座 "" (未指定)。表示名は UNASSIGNED。未指定も 1 つの口座として残高を持つ。
+D3: 金額は正が支出(口座から出る)、負が返金・収入(口座に入る)。残高 = 期首残高 - 支出 + 返金。
+D4: 振替は account → transfer_to。金額は正のみ(core が拒否)。振替元から減り、振替先に増える。支出には数えない。
+D5: 期首残高は最初の明細より前の残高。省略した口座は 0。負も可(クレジットカードの未払いなど)。
+    bool・int 以外は TypeError。明細に無い口座でも期首残高があれば口座として存在する。
+D6: 残高の推移は、その口座に動きがあった日ごとの日末残高(同じ日の複数明細は 1 点にまとめる)。
+D7: 月次レポートは最初の月〜最後の月を欠けた月も含めて並べる(動きの無い月は 0 で、残高は前月末のまま)。
+    既知の全口座を各月に出す(月昇順、月内は口座名昇順)。空の入力は空のリスト。
+D8: 月次の spent は振替を除いた支出(返金は引く)、transfer_in / transfer_out は振替の合計。
+D9: 同じ日の明細は入力順に関係なく日末残高に合算される。
+"""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from dataclasses import dataclass
+from datetime import date
+from itertools import groupby
+
+from kakeibo.core import Expense
+
+UNASSIGNED = "(未指定)"
+
+
+def account_label(name: str) -> str:
+    return name or UNASSIGNED
+
+
+def account_name(label: str) -> str:
+    """表示名 → 内部名(UNASSIGNED は "")。"""
+    return "" if label == UNASSIGNED else label
+
+
+def _check_opening(opening: Mapping[str, int] | None) -> dict[str, int]:
+    if opening is None:
+        return {}
+    out: dict[str, int] = {}
+    for name, yen in opening.items():
+        if not isinstance(name, str):
+            raise TypeError(f"opening の口座名は文字列である必要があります: {name!r}")
+        if isinstance(yen, bool) or not isinstance(yen, int):
+            raise TypeError(f"opening[{name!r}] は整数である必要があります: {yen!r}")
+        out[name] = yen
+    return out
+
+
+def _effects(e: Expense) -> list[tuple[str, int]]:
+    if e.transfer_to:
+        return [(e.account, -e.amount), (e.transfer_to, e.amount)]
+    return [(e.account, -e.amount)]
+
+
+def known_accounts(
+    rows: list[Expense], opening: Mapping[str, int] | None = None
+) -> list[str]:
+    """明細・振替先・期首残高に現れる口座(名前昇順。"" が先頭)。"""
+    names = set(_check_opening(opening))
+    for e in rows:
+        names.add(e.account)
+        if e.transfer_to:
+            names.add(e.transfer_to)
+    return sorted(names)
+
+
+def final_balances(
+    rows: list[Expense], opening: Mapping[str, int] | None = None
+) -> dict[str, int]:
+    bal = {a: 0 for a in known_accounts(rows, opening)}
+    bal.update(_check_opening(opening))
+    for e in rows:
+        for acc, delta in _effects(e):
+            bal[acc] += delta
+    return bal
+
+
+def balance_history(
+    rows: list[Expense], opening: Mapping[str, int] | None = None
+) -> dict[str, list[tuple[date, int]]]:
+    """{口座: [(日, 日末残高)]}。動きのあった日だけ、日昇順。動きの無い口座は []。"""
+    bal = {a: 0 for a in known_accounts(rows, opening)}
+    bal.update(_check_opening(opening))
+    hist: dict[str, list[tuple[date, int]]] = {a: [] for a in bal}
+    for day, group in groupby(sorted(rows, key=lambda e: e.day), key=lambda e: e.day):
+        touched: set[str] = set()
+        for e in group:
+            for acc, delta in _effects(e):
+                bal[acc] += delta
+                touched.add(acc)
+        for acc in sorted(touched):
+            hist[acc].append((day, bal[acc]))
+    return hist
+
+
+@dataclass(frozen=True)
+class AccountMonth:
+    month: str  # "YYYY-MM"
+    account: str
+    spent: int  # 振替を除く支出(返金は引く)
+    transfer_in: int
+    transfer_out: int
+    balance: int  # 月末残高
+
+
+def _month_key(d: date) -> tuple[int, int]:
+    return (d.year, d.month)
+
+
+def monthly_account_report(
+    rows: list[Expense], opening: Mapping[str, int] | None = None
+) -> list[AccountMonth]:
+    if not rows:
+        return []
+    bal = {a: 0 for a in known_accounts(rows, opening)}
+    bal.update(_check_opening(opening))
+    by_month: dict[tuple[int, int], list[Expense]] = {}
+    for e in rows:
+        by_month.setdefault(_month_key(e.day), []).append(e)
+    (y, m), last = min(by_month), max(by_month)
+    out: list[AccountMonth] = []
+    while (y, m) <= last:
+        spent = {a: 0 for a in bal}
+        t_in = {a: 0 for a in bal}
+        t_out = {a: 0 for a in bal}
+        for e in by_month.get((y, m), []):
+            if e.transfer_to:
+                t_out[e.account] += e.amount
+                t_in[e.transfer_to] += e.amount
+            else:
+                spent[e.account] += e.amount
+            for acc, delta in _effects(e):
+                bal[acc] += delta
+        for acc in sorted(bal):
+            out.append(
+                AccountMonth(
+                    f"{y:04d}-{m:02d}", acc, spent[acc], t_in[acc], t_out[acc], bal[acc]
+                )
+            )
+        y, m = (y + 1, 1) if m == 12 else (y, m + 1)
+    return out
