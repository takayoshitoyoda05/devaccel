@@ -0,0 +1,273 @@
+import sys
+from datetime import date
+
+import pytest
+
+from kakeibo import main
+from kakeibo.accounts import (
+    UNASSIGNED,
+    AccountMonth,
+    balance_history,
+    final_balances,
+    known_accounts,
+    monthly_account_report,
+)
+from kakeibo.core import CsvError, Expense, load_csv, monthly_totals, total_by_category
+
+HEADER = "date,category,amount,memo,account,transfer_to\n"
+BODY = (
+    "2026-10-31,food,1500,lunch,cash,\n"
+    "2026-11-01,food,1200,lunch,card,\n"
+    "2026-11-02,rent,80000,,bank,\n"
+    "2026-11-05,transfer,30000,ATM,bank,cash\n"
+    "2026-11-10,food,800,coffee,cash,\n"
+    "2027-01-15,pay,1200,,bank,card\n"
+)
+
+
+def E(day, amount, account="", to="", cat="x", memo=""):
+    return Expense(date.fromisoformat(day), cat, amount, memo, account, to)
+
+
+# ---- 読み込み ----
+
+
+def test_legacy_csv_without_account_column(tmp_path):
+    p = tmp_path / "a.csv"
+    p.write_text("date,category,amount,memo\n2026-11-01,food,100,x\n", encoding="utf-8")
+    (e,) = load_csv(p)
+    assert e.account == "" and e.transfer_to == ""
+
+
+def test_account_columns_are_stripped(tmp_path):
+    p = tmp_path / "a.csv"
+    p.write_text(HEADER + "2026-11-01,t,5, ,  bank , cash \n", encoding="utf-8")
+    (e,) = load_csv(p)
+    assert (e.account, e.transfer_to) == ("bank", "cash")
+
+
+@pytest.mark.parametrize(
+    "line",
+    [
+        "2026-11-01,t,5,,,cash",  # 振替元なし
+        "2026-11-01,t,5,,bank,bank",  # 同一口座
+        "2026-11-01,t,-5,,bank,cash",  # 負の振替
+        "2026-11-01,t,0,,bank,cash",  # 0 の振替
+    ],
+)
+def test_invalid_transfer_rejected(tmp_path, line):
+    p = tmp_path / "a.csv"
+    p.write_text(HEADER + line + "\n", encoding="utf-8")
+    with pytest.raises(CsvError) as ei:
+        load_csv(p)
+    assert ei.value.errors[0][0] == 2
+
+
+# ---- 振替は支出ではない ----
+
+
+def test_transfer_not_counted_as_expense():
+    rows = [
+        E("2026-11-01", 100, "bank", cat="food"),
+        E("2026-11-02", 5000, "bank", "cash", cat="t"),
+    ]
+    assert total_by_category(rows) == {"food": 100}
+    assert monthly_totals(rows) == {"2026-11": {"food": 100}}
+
+
+# ---- 残高 ----
+
+
+def test_final_balances_with_opening_and_transfer():
+    rows = [
+        E("2026-11-01", 300, "cash"),
+        E("2026-11-02", 1000, "bank", "cash"),
+        E("2026-11-03", -200, "bank"),  # 返金・収入
+    ]
+    got = final_balances(rows, {"bank": 5000, "card": -100})
+    assert got == {"bank": 5000 - 1000 + 200, "card": -100, "cash": -300 + 1000}
+
+
+def test_opening_only_account_exists():
+    assert known_accounts([], {"wallet": 10}) == ["wallet"]
+    assert final_balances([], {"wallet": 10}) == {"wallet": 10}
+    assert balance_history([], {"wallet": 10}) == {"wallet": []}
+
+
+@pytest.mark.parametrize("bad", [True, 1.5, "100", None])
+def test_opening_type_rejected(bad):
+    with pytest.raises(TypeError, match="bank"):
+        final_balances([], {"bank": bad})  # type: ignore[dict-item]
+
+
+def test_history_daily_points_input_order_independent():
+    rows = [
+        E("2026-11-03", 50, "cash"),
+        E("2026-11-01", 100, "cash"),
+        E("2026-11-01", 20, "cash"),
+    ]
+    assert balance_history(rows, {"cash": 1000})["cash"] == [
+        (date(2026, 11, 1), 880),
+        (date(2026, 11, 3), 830),
+    ]
+
+
+def test_history_transfer_touches_both_accounts():
+    h = balance_history([E("2026-11-01", 100, "bank", "cash")])
+    assert h["bank"] == [(date(2026, 11, 1), -100)]
+    assert h["cash"] == [(date(2026, 11, 1), 100)]
+
+
+def test_legacy_rows_form_unassigned_account():
+    assert final_balances([E("2026-11-01", 100)]) == {"": -100}
+
+
+# ---- 月次レポート ----
+
+
+def test_monthly_report_fills_gap_months_and_carries_balance():
+    rows = [
+        E("2026-11-01", 100, "cash"),
+        E("2027-01-10", 30, "cash"),
+        E("2027-01-11", 500, "bank", "cash"),
+    ]
+    rep = monthly_account_report(rows, {"bank": 1000})
+    assert [r.month for r in rep] == ["2026-11"] * 2 + ["2026-12"] * 2 + ["2027-01"] * 2
+    assert rep[0] == AccountMonth("2026-11", "bank", 0, 0, 0, 1000)
+    assert rep[1] == AccountMonth("2026-11", "cash", 100, 0, 0, -100)
+    assert rep[3] == AccountMonth("2026-12", "cash", 0, 0, 0, -100)  # 動き無し
+    assert rep[4] == AccountMonth("2027-01", "bank", 0, 0, 500, 500)
+    assert rep[5] == AccountMonth("2027-01", "cash", 30, 500, 0, -100 - 30 + 500)
+
+
+def test_monthly_report_year_boundary_and_empty():
+    rows = [E("2026-12-31", 1, "a"), E("2027-01-01", 2, "a")]
+    assert [r.month for r in monthly_account_report(rows)] == ["2026-12", "2027-01"]
+    assert monthly_account_report([]) == []
+
+
+def test_monthly_report_refund_reduces_spent():
+    rows = [E("2026-11-01", 300, "a"), E("2026-11-02", -100, "a")]
+    (r,) = monthly_account_report(rows)
+    assert r.spent == 200 and r.balance == -200
+
+
+# ---- CLI ----
+
+
+def _run(tmp_path, monkeypatch, capsys, *args, body=BODY, header=HEADER):
+    p = tmp_path / "in.csv"
+    p.write_text(header + body, encoding="utf-8")
+    monkeypatch.setattr(sys, "argv", ["kakeibo", str(p), *args])
+    main()
+    return capsys.readouterr()
+
+
+def test_cli_default_excludes_transfers(tmp_path, monkeypatch, capsys):
+    out = _run(tmp_path, monkeypatch, capsys, "--total")
+    # 振替(transfer 30000 と pay 1200)は含まれない
+    assert out.out == "rent\t80,000\nfood\t3,500\nTOTAL\t83,500\n"
+
+
+def test_cli_account_filter(tmp_path, monkeypatch, capsys):
+    out = _run(tmp_path, monkeypatch, capsys, "--account", "cash", "--total")
+    assert out.out == "food\t2,300\nTOTAL\t2,300\n"
+    assert out.err == ""
+
+
+def test_cli_account_filter_with_report_and_memo(tmp_path, monkeypatch, capsys):
