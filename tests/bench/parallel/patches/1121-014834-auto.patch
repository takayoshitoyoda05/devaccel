+def test_cli_budget_uses_account_filtered_totals(tmp_path, monkeypatch, capsys):
+    b = tmp_path / "b.json"
+    b.write_text('{"default": {"food": 1000}}', encoding="utf-8")
+    out = _run(tmp_path, monkeypatch, capsys, "--account", "cash", "--budget", str(b))
+    assert "2026-11" not in out.err  # 現金の 11 月の food は 800 で予算内
+    assert "2026-10 food 500円超過" in out.err
+    b.write_text('{"default": {"food": 100}}', encoding="utf-8")
+    out = _run(tmp_path, monkeypatch, capsys, "--account", "card", "--budget", str(b))
+    assert "2026-11 food 1,100円超過" in out.err
