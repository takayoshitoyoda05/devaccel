diff --git a/src/kakeibo/core.py b/src/kakeibo/core.py
index 178ab9d..4df309a 100644
--- a/src/kakeibo/core.py
+++ b/src/kakeibo/core.py
@@ -1,4 +1,9 @@
-"""Expense records and aggregation."""
+"""Expense records and aggregation.
+
+D1: 月キーは常に `YYYY-MM`(年 4 桁・月 2 桁ゼロ埋め)。budget.json の月と同じ形式で、文字列順 = 時系列順。
+D2: 月が 1 桁の月(1〜9 月)でも予算の超過・月別上書きを判定する(test_budget.py)。
+D3: 欠けた月は補わず、データのある月だけを昇順に並べる(従来どおり)。
+"""
 
 from __future__ import annotations
 
@@ -72,7 +77,7 @@ def monthly_totals(rows: list[Expense]) -> dict[str, dict[str, int]]:
     """{"YYYY-MM": {category: yen}}; months ascending, categories by amount desc."""
     by_month: dict[str, list[Expense]] = {}
     for e in rows:
-        by_month.setdefault(f"{e.day.year}-{e.day.month}", []).append(e)
+        by_month.setdefault(f"{e.day.year:04d}-{e.day.month:02d}", []).append(e)
     return {m: total_by_category(by_month[m]) for m in sorted(by_month)}
 
 
diff --git a/tests/test_budget.py b/tests/test_budget.py
index 3420921..aa33f3a 100644
--- a/tests/test_budget.py
+++ b/tests/test_budget.py
@@ -121,3 +121,31 @@ def test_main_bad_budget(tmp_path, monkeypatch, capsys):
         cap = capsys.readouterr()
         assert cap.out == ""
         assert cap.err and "Traceback" not in cap.err
+
+
+def test_month_keys_zero_padded_and_sorted():
+    rows = [
+        Expense(date(2026, 10, 1), "food", 1),
+        Expense(date(2026, 2, 1), "food", 1),
+        Expense(date(2026, 1, 1), "food", 1),
+    ]
+    assert list(monthly_totals(rows)) == ["2026-01", "2026-02", "2026-10"]
+
+
+def test_overrun_detected_for_single_digit_month(tmp_path):
+    rows = [Expense(date(2026, 3, 5), "food", 1500)]
+    budget = load_budget(_budget(tmp_path, {"default": {"food": 1000}}))
+    assert find_overruns(monthly_totals(rows), budget) == [
+        ("2026-03", "food", 500, 1000, 1500)
+    ]
+
+
+def test_month_override_applies_for_single_digit_month(tmp_path):
+    rows = [Expense(date(2026, 3, 5), "food", 1500)]
+    budget = load_budget(
+        _budget(
+            tmp_path,
+            {"default": {"food": 1000}, "months": {"2026-03": {"food": 2000}}},
+        )
+    )
+    assert find_overruns(monthly_totals(rows), budget) == []
