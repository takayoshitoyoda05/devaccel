diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..0a799f5 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -186,5 +186,133 @@ def test_path_type(runner, cls, expect):
     assert result.return_value == expect
 
 
+@pytest.mark.parametrize("name", ["a.csv", "a.TSV", "dir/A.Csv", "x.tar.csv"])
+def test_path_extensions_accepts(name):
+    type = click.Path(extensions=[".csv", ".tsv"])
+    assert type.convert(name, None, None) == name
+
+
+@pytest.mark.parametrize("name", ["a.txt", "a", "csv", "a.csv.bak", "a.csv/b", ""])
+def test_path_extensions_rejects(name):
+    type = click.Path(extensions=[".csv", ".tsv"])
+
+    with pytest.raises(click.BadParameter, match="must have one of the extensions"):
+        type.convert(name, None, None)
+
+
+def test_path_extensions_message():
+    type = click.Path(extensions=["CSV", ".tsv"])
+
+    with pytest.raises(click.BadParameter, match=r"extensions: \.csv, \.tsv\."):
+        type.convert("a.txt", None, None)
+
+
+def test_path_extensions_without_dot_and_multi_dot():
+    type = click.Path(extensions=["csv", ".tar.gz"])
+    assert type.convert("a.CSV", None, None) == "a.CSV"
+    assert type.convert("a.tar.gz", None, None) == "a.tar.gz"
+
+    with pytest.raises(click.BadParameter):
+        type.convert("a.gz", None, None)
+
+
+def test_path_extensions_accepts_any_iterable_and_pathlike_and_bytes():
+    type = click.Path(extensions=iter(["csv"]))
+    assert type.convert(pathlib.Path("a.CSV"), None, None) == pathlib.Path("a.CSV")
+    assert type.convert(b"a.csv", None, None) == b"a.csv"
+
+    with pytest.raises(click.BadParameter):
+        type.convert(b"a.txt", None, None)
+
+
+def test_path_extensions_default_accepts_everything():
+    assert click.Path().convert("a.txt", None, None) == "a.txt"
+    assert click.Path(extensions=None).convert("a", None, None) == "a"
+
+
+def test_path_extensions_existing_file(tmp_path):
+    good = tmp_path / "a.CSV"
+    bad = tmp_path / "a.txt"
+    good.write_text("x")
+    bad.write_text("x")
+    type = click.Path(exists=True, extensions=[".csv"])
+    assert type.convert(os.fspath(good), None, None) == os.fspath(good)
+
+    with pytest.raises(click.BadParameter, match="must have one of the extensions"):
+        type.convert(os.fspath(bad), None, None)
+
+
+def test_path_extensions_missing_file_checked_without_exists(tmp_path):
+    type = click.Path(extensions=[".csv"])
+
+    with pytest.raises(click.BadParameter, match="must have one of the extensions"):
+        type.convert(os.fspath(tmp_path / "new.txt"), None, None)
+
+
+def test_path_extensions_missing_file_with_exists_reports_missing(tmp_path):
+    type = click.Path(exists=True, extensions=[".csv"])
+
+    with pytest.raises(click.BadParameter, match="does not exist"):
+        type.convert(os.fspath(tmp_path / "nope.txt"), None, None)
+
+
+def test_path_extensions_skips_directories(tmp_path):
+    directory = tmp_path / "data.d"
+    directory.mkdir()
+    type = click.Path(exists=True, extensions=[".csv"])
+    assert type.convert(os.fspath(directory), None, None) == os.fspath(directory)
+
+
+def test_path_extensions_skips_dash():
+    type = click.Path(allow_dash=True, extensions=[".csv"])
+    assert type.convert("-", None, None) == "-"
+
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions=[".csv"]).convert("-", None, None)
+
+
+def test_path_extensions_resolve_path_checks_resolved_name(tmp_path):
+    target = tmp_path / "real.txt"
+    target.write_text("x")
+    link = tmp_path / "link.csv"
+
+    try:
+        link.symlink_to(target)
+    except (OSError, NotImplementedError):
+        pytest.skip("symlinks not supported")
+
+    type = click.Path(resolve_path=True, extensions=[".csv"])
+
+    with pytest.raises(click.BadParameter):
+        type.convert(os.fspath(link), None, None)
+
+
+def test_path_extensions_invalid_arguments():
+    with pytest.raises(TypeError, match="extensions"):
+        click.Path(extensions=".csv")  # type: ignore[arg-type]
+
+    with pytest.raises(ValueError, match="must not be empty"):
+        click.Path(extensions=[])
+
+    with pytest.raises(ValueError, match="empty extension"):
+        click.Path(extensions=[""])
+
+    with pytest.raises(ValueError, match="empty extension"):
+        click.Path(extensions=["."])
+
+
+def test_path_extensions_in_command(runner):
+    @click.command()
+    @click.option("--src", type=click.Path(extensions=[".csv", ".tsv"]))
+    def cli(src):
+        click.echo(src)
+
+    assert runner.invoke(cli, ["--src", "a.TSV"]).output == "a.TSV\n"
+
+    result = runner.invoke(cli, ["--src", "a.json"])
+    assert result.exit_code == 2
+    assert "must have one of the extensions: .csv, .tsv." in result.output
+
+
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
