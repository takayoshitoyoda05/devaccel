diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..671d4d8 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -186,5 +186,146 @@ def test_path_type(runner, cls, expect):
     assert result.return_value == expect
 
 
+CSV_TSV = click.Path(extensions=[".csv", ".tsv"])
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["a.csv", "a.tsv", "A.CSV", "dir/Data.TsV", "a.b.csv", "my data.csv"],
+)
+def test_extensions_accept(value):
+    assert CSV_TSV.convert(value, None, None) == value
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["a.txt", "a", "a.csv.bak", "acsv", "a.csv/", ".csv", "dir.csv/b", ""],
+)
+def test_extensions_reject(value):
+    with pytest.raises(click.BadParameter, match="must have one of the extensions"):
+        CSV_TSV.convert(value, None, None)
+
+
+def test_extensions_message_lists_extensions():
+    with pytest.raises(click.BadParameter) as exc_info:
+        CSV_TSV.convert("a.txt", None, None)
+
+    assert ".csv, .tsv" in exc_info.value.message
+    assert "'a.txt'" in exc_info.value.message
+
+
+def test_extensions_without_dot_and_mixed_case_spec():
+    type = click.Path(extensions=["CSV", ".Tar.GZ"])
+    assert type.extensions == (".csv", ".tar.gz")
+    assert type.convert("x.tar.gz", None, None) == "x.tar.gz"
+    assert type.convert("X.CSV", None, None) == "X.CSV"
+
+    with pytest.raises(click.BadParameter):
+        type.convert("x.gz", None, None)
+
+
+def test_extensions_default_unchanged():
+    type = click.Path()
+    assert type.extensions is None
+    assert type.convert("a.anything", None, None) == "a.anything"
+
+
+def test_extensions_accepts_tuple():
+    type = click.Path(extensions=(".csv",))
+    assert type.convert("a.csv", None, None) == "a.csv"
+
+
+@pytest.mark.parametrize(
+    ("extensions", "error"),
+    [
+        ([], ValueError),
+        ([""], ValueError),
+        (["."], ValueError),
+        (".csv", TypeError),
+        (b".csv", TypeError),
+        ([b".csv"], TypeError),
+        ([None], TypeError),
+        ([1], TypeError),
+        (5, TypeError),
+        ({".csv"}, TypeError),
+    ],
+)
+def test_extensions_invalid_spec(extensions, error):
+    with pytest.raises(error, match="extensions"):
+        click.Path(extensions=extensions)
+
+
+def test_extensions_checked_for_existing_file(tmp_path):
+    good = tmp_path / "a.CSV"
+    good.write_text("x")
+    bad = tmp_path / "a.txt"
+    bad.write_text("x")
+    type = click.Path(exists=True, extensions=[".csv"])
+
+    assert type.convert(os.fspath(good), None, None) == os.fspath(good)
+
+    with pytest.raises(click.BadParameter, match="must have one of"):
+        type.convert(os.fspath(bad), None, None)
+
+
+def test_extensions_checked_when_file_missing(tmp_path):
+    missing = tmp_path / "out.txt"
+
+    with pytest.raises(click.BadParameter, match="must have one of"):
+        click.Path(extensions=[".csv"]).convert(os.fspath(missing), None, None)
+
+    # A missing file with ``exists=True`` still reports that it is missing.
+    with pytest.raises(click.BadParameter, match="does not exist"):
+        click.Path(exists=True, extensions=[".csv"]).convert(
+            os.fspath(missing), None, None
+        )
+
+
+def test_extensions_skipped_for_existing_directory(tmp_path):
+    directory = tmp_path / "data"
+    directory.mkdir()
+    type = click.Path(extensions=[".csv"])
+    assert type.convert(os.fspath(directory), None, None) == os.fspath(directory)
+
+
+def test_extensions_skipped_for_dash():
+    type = click.Path(allow_dash=True, extensions=[".csv"])
+    assert type.convert("-", None, None) == "-"
+
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions=[".csv"]).convert("-", None, None)
+
+
+def test_extensions_with_path_objects_and_bytes():
+    assert CSV_TSV.convert(pathlib.Path("a.CSV"), None, None) == pathlib.Path("a.CSV")
+    assert CSV_TSV.convert(b"a.csv", None, None) == b"a.csv"
+
+    with pytest.raises(click.BadParameter):
+        CSV_TSV.convert(pathlib.Path("a.txt"), None, None)
+
+    with pytest.raises(click.BadParameter):
+        CSV_TSV.convert(b"a.txt", None, None)
+
+
+def test_extensions_with_path_type():
+    type = click.Path(extensions=[".csv"], path_type=pathlib.Path)
+    assert type.convert("a.CSV", None, None) == pathlib.Path("a.CSV")
+
+
+def test_extensions_via_cli(runner):
+    cli = click.Command(
+        "cli",
+        params=[click.Argument(["p"], type=click.Path(extensions=["csv", "tsv"]))],
+        callback=lambda p: click.echo(p),
+    )
+    ok = runner.invoke(cli, ["DATA.CSV"])
+    assert ok.exit_code == 0
+    assert ok.output == "DATA.CSV\n"
+
+    bad = runner.invoke(cli, ["data.txt"])
+    assert bad.exit_code == 2
+    assert "must have one of the extensions: .csv, .tsv." in bad.output
+
+
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
