diff --git a/src/kakeibo/core.py b/src/kakeibo/core.py
index 8c3cbab..8713026 100644
--- a/src/kakeibo/core.py
+++ b/src/kakeibo/core.py
@@ -133,3 +133,48 @@ def find_overruns(
             if cat in limits and actual > limits[cat]:
                 out.append((month, cat, actual - limits[cat], limits[cat], actual))
     return out
+
+
+@dataclass(frozen=True)
+class BudgetAlert:
+    month: str
+    category: str
+    limit: int
+    actual: int
+
+    @property
+    def over(self) -> bool:
+        return self.actual > self.limit
+
+    @property
+    def percent(self) -> int | None:
+        """Usage as a floored integer percent; None when the limit is 0."""
+        return self.actual * 100 // self.limit if self.limit > 0 else None
+
+
+def find_budget_alerts(
+    totals: dict[str, dict[str, int]], budget: Budget
+) -> list[BudgetAlert]:
+    """Categories over budget, or at >= 90% of a non-zero budget.
+
+    Order follows `totals` (months ascending, categories as given).
+    """
+    out: list[BudgetAlert] = []
+    for month, cats in totals.items():
+        limits = budget.for_month(month)
+        for cat, actual in cats.items():
+            if cat not in limits:
+                continue
+            limit = limits[cat]
+            # integer math: actual / limit >= 0.9  <=>  actual * 10 >= limit * 9
+            if actual > limit or (limit > 0 and actual * 10 >= limit * 9):
+                out.append(BudgetAlert(month, cat, limit, actual))
+    return out
+
+
+def format_budget_alert(a: BudgetAlert) -> str:
+    pct = "" if a.percent is None else f" / {a.percent}%"
+    detail = f"(予算 {a.limit:,} / 実績 {a.actual:,}{pct})"
+    if a.over:
+        return f"警告: {a.month} {a.category} {a.actual - a.limit:,}円超過 {detail}"
+    return f"注意: {a.month} {a.category} 残り {a.limit - a.actual:,}円 {detail}"
