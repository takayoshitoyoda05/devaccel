@@ -0,0 +1,132 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def E(d, category="rent", amount=80000, memo=""):
+    return Expense(d, category, amount, memo)
+
+
+@pytest.mark.parametrize(
+    "src, expected",
+    [
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2024, 1, 31), date(2024, 2, 29)),
+        (date(2026, 12, 15), date(2027, 1, 15)),
+        (date(2026, 3, 31), date(2026, 4, 30)),
+        (date(2026, 11, 18), date(2026, 12, 18)),
+    ],
+)
+def test_add_month_clamps_to_last_day(src, expected):
+    assert add_month(src) == expected
+
+
+def test_find_recurring_basic_monthly():
+    rows = [E(date(2026, 9, 1)), E(date(2026, 10, 1)), E(date(2026, 11, 1))]
+    assert find_recurring(rows) == [
+        Recurring(
+            "rent",
+            80000,
+            (date(2026, 9, 1), date(2026, 10, 1), date(2026, 11, 1)),
+            date(2026, 12, 1),
+        )
+    ]
+
+
+def test_tolerance_allows_small_drift():
+    rows = [E(date(2026, 9, 1)), E(date(2026, 10, 3)), E(date(2026, 11, 4))]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 12, 4)
+
+
+def test_drift_beyond_tolerance_breaks_run():
+    rows = [E(date(2026, 9, 1)), E(date(2026, 10, 1)), E(date(2026, 11, 10))]
+    assert find_recurring(rows) == []
+
+
+def test_split_into_runs_by_gap():
+    rows = [
+        E(date(2026, 1, 5)),
+        E(date(2026, 2, 5)),
+        E(date(2026, 3, 5)),
+        E(date(2026, 7, 5)),
+        E(date(2026, 8, 5)),
+        E(date(2026, 9, 5)),
+    ]
+    result = find_recurring(rows)
+    assert [r.days[0] for r in result] == [date(2026, 1, 5), date(2026, 7, 5)]
+    assert all(len(r.days) == 3 for r in result)
+
+
+def test_min_count_filters_short_runs():
+    rows = [E(date(2026, 1, 5)), E(date(2026, 2, 5))]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_count=2)) == 1
+
+
+def test_duplicate_dates_are_deduplicated():
+    rows = [
+        E(date(2026, 1, 5)),
+        E(date(2026, 1, 5), memo="dup"),
+        E(date(2026, 2, 5)),
+        E(date(2026, 3, 5)),
+    ]
+    result = find_recurring(rows)
+    assert result[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_memo_is_ignored_when_grouping():
+    rows = [
+        E(date(2026, 1, 5), memo="a"),
+        E(date(2026, 2, 5), memo="b"),
+        E(date(2026, 3, 5), memo="c"),
+    ]
+    assert len(find_recurring(rows)) == 1
+
+
+def test_different_amount_or_category_are_separate_groups():
+    rows = [
+        E(date(2026, 1, 5), amount=100),
+        E(date(2026, 2, 5), amount=200),
+        E(date(2026, 3, 5), amount=100),
+        E(date(2026, 1, 6), category="food", amount=100),
+        E(date(2026, 2, 6), category="food", amount=100),
+        E(date(2026, 3, 6), category="food", amount=100),
+    ]
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [("food", 100)]
+
+
+def test_result_sorted_by_category_amount_first_day():
+    rows = []
+    for cat, amt in [("rent", 200), ("food", 300), ("rent", 100)]:
+        for m in (1, 2, 3):
+            rows.append(E(date(2026, m, 1), category=cat, amount=amt))
+    result = find_recurring(rows)
+    assert [(r.category, r.amount) for r in result] == [
+        ("food", 300),
+        ("rent", 100),
+        ("rent", 200),
+    ]
+
+
+def test_month_end_recurrence():
+    rows = [E(date(2026, 1, 31)), E(date(2026, 2, 28)), E(date(2026, 3, 31))]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].next_expected == date(2026, 4, 30)
+
+
+def test_empty_input_returns_empty():
+    assert find_recurring([]) == []
+
+
+def test_invalid_arguments_raise():
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
