+++ b/tests/test_bankimport.py
@@ -0,0 +1,125 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+
+@pytest.mark.parametrize(
+    ("s", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥5", 5),
+        ("-1,000円", -1000),
+    ],
+)
+def test_parse_amount_accepts(s: str, expected: int) -> None:
+    assert parse_amount(s) == expected
+
+
+@pytest.mark.parametrize(
+    "s",
+    ["", "円", "12.5", "1 200", "--5", "¥-5", "１２３", ",5", "5円円", "-", "¥"],
+)
+def test_parse_amount_rejects(s: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(s)
+
+
+@pytest.mark.parametrize(
+    ("s", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/12/31 ", date(2026, 12, 31)),
+        ("2026-1-5", date(2026, 1, 5)),
+    ],
+)
+def test_parse_date_accepts(s: str, expected: date) -> None:
+    assert parse_date(s) == expected
+
+
+@pytest.mark.parametrize(
+    "s",
+    ["2026/1-5", "26/1/5", "2026/02/30", "2026.1.5", "２０２６/1/5", "", "2026/13/1"],
+)
+def test_parse_date_rejects(s: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(s)
+
+
+def test_default_mapping() -> None:
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_import_rows_basic_and_extra_columns_ignored() -> None:
+    text = '利用日,分類,利用金額,利用店名,備考\n2026/1/5,食費,"1,200",  スーパー  ,x\n'
+    rows, errors = import_rows(text)
+    assert errors == []
+    assert rows == [Expense(date(2026, 1, 5), "食費", 1200, "スーパー")]
+
+
+def test_import_rows_custom_mapping_and_category_map() -> None:
+    text = "d,c,a\n2026-02-03, 食費 ,-500円\n"
+    mapping = {"date": "d", "category": "c", "amount": "a"}
+    rows, errors = import_rows(text, mapping, {"食費": "Food"})
+    assert errors == []
+    assert rows == [Expense(date(2026, 2, 3), "Food", -500, "")]
+
+
+def test_import_rows_memo_mapping_optional_and_empty_when_absent() -> None:
+    text = "d,c,a\n2026/1/1,食費,100\n"
+    rows, _ = import_rows(text, {"date": "d", "category": "c", "amount": "a"})
+    assert rows[0].memo == ""
+
+
+def test_import_rows_missing_required_key_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows("d,c,a\n", {"date": "d", "category": "c"})
+
+
+def test_import_rows_missing_mapped_column_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows("d,c,a\n", {"date": "d", "category": "c", "amount": "zzz"})
+
+
+def test_import_rows_records_all_errors_in_order_and_excludes_row() -> None:
+    text = "利用日,分類,利用金額,利用店名\n2026/1/5,食費,100,a\nbad,,xyz,b\n2026/1/6,,200,c\n"
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 100, "a")]
+    assert errors == [(3, "date"), (3, "amount"), (3, "category"), (4, "category")]
+
+
+def test_import_rows_short_row_treats_missing_as_empty() -> None:
+    text = "利用日,分類,利用金額,利用店名\n2026/1/5,食費\n"
+    rows, errors = import_rows(text)
+    assert rows == []
+    assert errors == [(2, "amount")]
+
+
+def test_import_rows_blank_lines_skipped_but_counted() -> None:
+    text = "利用日,分類,利用金額,利用店名\n\n2026/1/5,食費,1,\n\nx,食費,1,\n"
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 1, "")]
+    assert errors == [(5, "date")]
+
+
+def test_import_rows_line_numbers_are_physical_with_quoted_newline() -> None:
+    text = '利用日,分類,利用金額,利用店名\n2026/1/5,食費,1,"a\nb"\nbad,食費,1,x\n'
+    rows, errors = import_rows(text)
+    assert rows == [Expense(date(2026, 1, 5), "食費", 1, "a\nb")]
+    assert errors == [(4, "date")]
+
+
+def test_import_rows_empty_input_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows("")
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..f53fcca
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,133 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def E(day: str, cat: str, amount: int) -> Expense:
+    return Expense(date.fromisoformat(day), cat, amount, "")
+
+
+ROWS = [
+    E("2026-09-05", "food", 1000),
+    E("2026-09-20", "food", 500),
+    E("2026-09-10", "rent", 5000),
+    E("2026-09-11", "books", 300),
+    E("2026-10-03", "food", 1200),
+    E("2026-10-04", "rent", 5000),
+    E("2026-10-06", "fun", 700),
+    E("2026-10-07", "zero", 0),
+    E("2026-09-08", "zero", 0),
+]
+
+
+def test_month_diff_rows_and_status():
+    got = {r.category: r for r in month_diff(ROWS, "2026-09", "2026-10")}
+    assert got["food"] == DiffRow("food", 1500, 1200, -300, -20.0, "down")
+    assert got["rent"] == DiffRow("rent", 5000, 5000, 0, 0.0, "same")
+    assert got["books"] == DiffRow("books", 300, 0, -300, -100.0, "gone")
+    assert got["fun"] == DiffRow("fun", 0, 700, 700, None, "new")
+    assert set(got) == {"food", "rent", "books", "fun", "zero"}
+
+
+def test_status_uses_row_presence_not_sum():
+    got = {r.category: r for r in month_diff(ROWS, "2026-09", "2026-10")}
+    # 合計 0 でも明細があれば new/gone ではなく same
+    assert got["zero"] == DiffRow("zero", 0, 0, 0, None, "same")
+
+
+def test_pct_none_when_prev_zero_and_positive_pct():
+    rows = [E("2026-01-01", "a", 3), E("2026-02-01", "a", 4)]
+    (r,) = month_diff(rows, "2026-01", "2026-02")
+    assert r.pct == pytest.approx(33.3)
+    assert r.status == "up"
+
+
+def test_sort_by_abs_delta_desc_then_category():
+    rows = [
+        E("2026-01-01", "b", 100),
+        E("2026-02-01", "b", 200),  # delta +100
+        E("2026-01-01", "a", 500),
+        E("2026-02-01", "a", 400),  # delta -100
+        E("2026-02-01", "c", 1000),  # delta +1000
+    ]
+    cats = [r.category for r in month_diff(rows, "2026-01", "2026-02")]
+    assert cats == ["c", "a", "b"]
+
+
+def test_empty_when_no_rows_in_either_month():
+    assert month_diff(ROWS, "2025-01", "2025-02") == []
+
+
+@pytest.mark.parametrize(
+    "bad", ["2026-9", "2026/09", "2026-13", "2026-00", "26-09", "", "2026-09-01"]
+)
+def test_month_format_errors(bad):
+    with pytest.raises(ValueError):
+        month_diff(ROWS, bad, "2026-10")
+    with pytest.raises(ValueError):
+        month_diff(ROWS, "2026-09", bad)
+
+
+def test_top_movers_skips_same_and_limits():
+    diffs = month_diff(ROWS, "2026-09", "2026-10")
+    names = [r.category for r in top_movers(diffs)]
+    # rent(same) 除外、|delta| 降順、同点は category 昇順(books < food)
+    assert names == ["fun", "books", "food"]
+    assert [r.category for r in top_movers(diffs, 1)] == ["fun"]
+    assert top_movers(diffs, 0) == []
+
+
+def test_top_movers_negative_n():
+    with pytest.raises(ValueError):
+        top_movers([], -1)
+
+
+def test_render_diff_format():
+    diffs = [
+        DiffRow("food", 1000, 1200, 200, 20.0, "up"),
+        DiffRow("books", 300, 0, -300, -100.0, "gone"),
+        DiffRow("rent", 5000, 5000, 0, 0.0, "same"),
+        DiffRow("fun", 0, 700, 700, None, "new"),
+    ]
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "food\t1000\t1200\t+200\t+20.0%\n"
+        "books\t300\t0\t-300\t-100.0%\n"
+        "rent\t5000\t5000\t+0\t+0.0%\n"
+        "fun\t0\t700\t+700\t-"
+    )
+
+
+def test_render_diff_header_only_when_empty():
+    assert render_diff([]) == "category\tprev\tcurr\tdelta\tpct"
+
+
+def test_render_diff_no_trailing_newline():
+    assert not render_diff(month_diff(ROWS, "2026-09", "2026-10")).endswith("\n")
+
+
+def test_available_months_sorted_unique():
+    assert available_months(ROWS) == ["2026-09", "2026-10"]
+    assert available_months([]) == []
+
+
+def test_latest_diff_uses_last_two_months():
+    rows = ROWS + [E("2026-11-01", "food", 100)]
+    assert latest_diff(rows) == month_diff(rows, "2026-10", "2026-11")
+
+
+def test_latest_diff_needs_two_months():
+    with pytest.raises(ValueError):
+        latest_diff([E("2026-09-01", "food", 1)])
+    with pytest.raises(ValueError):
+        latest_diff([])
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..c19caf6
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,176 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def _e(category: str, memo: str = "", amount: int = 100) -> Expense:
+    return Expense(day=date(2026, 1, 1), category=category, amount=amount, memo=memo)
+
+
+ROWS = [
+    _e("食費", "ランチ"),
+    _e("交通費", "電車 通勤"),
+    _e("Food", "Coffee shop"),
+    _e("娯楽", "映画 (レイト)"),
+]
+
+
+# --- tokenize ---
+
+
+def test_tokenize_basic_terms_and_spaces() -> None:
+    assert tokenize("  ランチ   電車 ") == [("TERM", "ランチ"), ("TERM", "電車")]
+
+
+def test_tokenize_parens() -> None:
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+
+
+def test_tokenize_quoted_keeps_spaces_and_parens() -> None:
+    assert tokenize('"電車 通勤" "(x)"') == [("TERM", "電車 通勤"), ("TERM", "(x)")]
+
+
+def test_tokenize_unclosed_quote_raises() -> None:
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_raises() -> None:
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_operators_only_uppercase() -> None:
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+    assert tokenize("and or not") == [
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+    ]
+
+
+def test_tokenize_cat_prefix() -> None:
+    assert tokenize("cat:食費") == [("CAT", "食費")]
+
+
+def test_tokenize_empty_cat_raises() -> None:
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_tokenize_quoted_cat_is_term() -> None:
+    assert tokenize('"cat:食費"') == [("TERM", "cat:食費")]
+
+
+# --- parsing / errors ---
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(a",
+        "a)",
+        "a AND",
+        "OR a",
+        "a OR",
+        "NOT",
+        "a AND OR b",
+        "( )",
+    ],
+)
+def test_malformed_queries_raise(q: str) -> None:
+    with pytest.raises(QueryError):
+        filter_rows(q, ROWS)
+
+
+def test_malformed_query_raises_even_with_no_rows() -> None:
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
+
+
+# --- evaluation ---
+
+
+def test_term_matches_memo_or_category_substring() -> None:
+    assert [e.memo for e in filter_rows("ランチ", ROWS)] == ["ランチ"]
+    assert [e.category for e in filter_rows("交通", ROWS)] == ["交通費"]
+
+
+def test_term_is_case_insensitive() -> None:
+    assert [e.category for e in filter_rows("food", ROWS)] == ["Food"]
+    assert [e.memo for e in filter_rows("COFFEE", ROWS)] == ["Coffee shop"]
+
+
+def test_cat_is_exact_and_case_insensitive() -> None:
+    assert filter_rows("cat:food", ROWS) == [ROWS[2]]
+    assert filter_rows("cat:食", ROWS) == []  # not a substring match
+
+
+def test_implicit_and_between_terms() -> None:
+    assert filter_rows("電車 通勤", ROWS) == [ROWS[1]]
+    assert filter_rows("電車 ランチ", ROWS) == []
+
+
+def test_explicit_and() -> None:
+    assert filter_rows("電車 AND 通勤", ROWS) == [ROWS[1]]
+
+
+def test_or() -> None:
+    assert filter_rows("ランチ OR 映画", ROWS) == [ROWS[0], ROWS[3]]
+
+
+def test_not() -> None:
+    assert filter_rows("NOT cat:食費", ROWS) == [ROWS[1], ROWS[2], ROWS[3]]
+
+
+def test_precedence_and_binds_tighter_than_or() -> None:
+    # a OR b AND c  ==  a OR (b AND c)
+    rows = [_e("x", "a"), _e("x", "b"), _e("x", "c")]
+    assert filter_rows("a OR b AND c", rows) == [rows[0]]
+
+
+def test_precedence_not_binds_tighter_than_and() -> None:
+    # NOT a b  ==  (NOT a) AND b
+    rows = [_e("x", "a b"), _e("x", "b")]
+    assert filter_rows("NOT a b", rows) == [rows[1]]
+
+
+def test_parens_override_precedence() -> None:
+    rows = [_e("x", "a"), _e("x", "b"), _e("x", "c")]
+    assert filter_rows("(a OR b) AND c", rows) == []
+    assert filter_rows("a OR (b AND c)", rows) == [rows[0]]
+
+
+def test_nested_not_and_parens() -> None:
+    assert filter_rows("NOT (NOT ランチ)", ROWS) == [ROWS[0]]
+
+
+def test_quoted_term_with_space() -> None:
+    assert filter_rows('"電車 通勤"', ROWS) == [ROWS[1]]
+
+
+def test_quoted_term_with_paren_is_literal() -> None:
+    assert filter_rows('"(レイト)"', ROWS) == [ROWS[3]]
+
+
+def test_filter_rows_keeps_input_order() -> None:
+    rows = [_e("x", "a", 3), _e("x", "a", 1), _e("x", "a", 2)]
+    assert [e.amount for e in filter_rows("a", rows)] == [3, 1, 2]
+
+
+def test_filter_rows_empty_rows_valid_query() -> None:
+    assert filter_rows("ランチ", []) == []
+
+
+def test_matches_single_expense() -> None:
+    assert matches("cat:食費", ROWS[0]) is True
+    assert matches("cat:食費", ROWS[1]) is False
+    assert matches("NOT 電車", ROWS[1]) is False
