@@ -0,0 +1,89 @@
+"""前月比レポート: 2 つの月のカテゴリ別合計を比較する純粋な関数群。"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not isinstance(month, str) or not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+
+    prev_sum: dict[str, int] = {}
+    curr_sum: dict[str, int] = {}
+    prev_count: dict[str, int] = {}
+    curr_count: dict[str, int] = {}
+    for e in rows:
+        m = e.day.strftime("%Y-%m")
+        if m == prev_month:
+            prev_sum[e.category] = prev_sum.get(e.category, 0) + e.amount
+            prev_count[e.category] = prev_count.get(e.category, 0) + 1
+        elif m == curr_month:
+            curr_sum[e.category] = curr_sum.get(e.category, 0) + e.amount
+            curr_count[e.category] = curr_count.get(e.category, 0) + 1
+
+    out: list[DiffRow] = []
+    for cat in set(prev_count) | set(curr_count):
+        prev = prev_sum.get(cat, 0)
+        curr = curr_sum.get(cat, 0)
+        delta = curr - prev
+        pct = None if prev == 0 else round(delta / prev * 100, 1) + 0.0
+        if prev_count.get(cat, 0) == 0:
+            status = "new"
+        elif curr_count.get(cat, 0) == 0:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+
+    out.sort(key=lambda r: (-abs(r.delta), r.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [d for d in diffs if d.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for d in diffs:
+        pct = "-" if d.pct is None else f"{d.pct:+.1f}%"
+        lines.append(f"{d.category}\t{d.prev}\t{d.curr}\t{d.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({e.day.strftime("%Y-%m") for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には明細のある月が 2 つ以上必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..f898ab9
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,164 @@
+"""Search query language for expense rows.
+
+Grammar (lowest to highest precedence: OR < AND < NOT)::
+
+    or_expr   := and_expr ("OR" and_expr)*
+    and_expr  := not_expr (["AND"] not_expr)*
+    not_expr  := "NOT" not_expr | primary
+    primary   := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+
+from kakeibo.core import Expense
+
+Token = tuple[str, str]
+Node = Callable[[Expense], bool]
+
+
+class QueryError(ValueError):
+    """Raised when a search query is malformed."""
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    tokens: list[Token] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            tokens.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            tokens.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end == -1:
+                raise QueryError(f"閉じていない引用符があります: {q!r}")
+            body = q[i + 1 : end]
+            if body == "":
+                raise QueryError("空の引用符は使えません")
+            tokens.append(("TERM", body))
+            i = end + 1
+        else:
+            start = i
+            while i < n and not (q[i].isspace() or q[i] in '()"'):
+                i += 1
+            word = q[start:i]
+            if word == "AND":
+                tokens.append(("AND", "AND"))
+            elif word == "OR":
+                tokens.append(("OR", "OR"))
+            elif word == "NOT":
+                tokens.append(("NOT", "NOT"))
+            elif word.startswith("cat:"):
+                cat = word[len("cat:") :]
+                if cat == "":
+                    raise QueryError("cat: の後ろに値がありません")
+                tokens.append(("CAT", cat))
+            else:
+                tokens.append(("TERM", word))
+    return tokens
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self.tokens = tokens
+        self.pos = 0
+
+    def _peek_kind(self) -> str | None:
+        return self.tokens[self.pos][0] if self.pos < len(self.tokens) else None
+
+    def _next(self) -> Token:
+        if self.pos >= len(self.tokens):
+            raise QueryError("クエリが途中で終わっています")
+        tok = self.tokens[self.pos]
+        self.pos += 1
+        return tok
+
+    def parse(self) -> Node:
+        if not self.tokens:
+            raise QueryError("クエリが空です")
+        node = self._or()
+        if self.pos != len(self.tokens):
+            raise QueryError(f"想定外のトークンです: {self.tokens[self.pos][1]!r}")
+        return node
+
+    def _or(self) -> Node:
+        node = self._and()
+        while self._peek_kind() == "OR":
+            self._next()
+            node = _or_node(node, self._and())
+        return node
+
+    def _and(self) -> Node:
+        node = self._not()
+        while True:
+            kind = self._peek_kind()
+            if kind == "AND":
+                self._next()
+                node = _and_node(node, self._not())
+            elif kind in ("TERM", "CAT", "LPAREN", "NOT"):
+                node = _and_node(node, self._not())
+            else:
+                return node
+
+    def _not(self) -> Node:
+        if self._peek_kind() == "NOT":
+            self._next()
+            return _not_node(self._not())
+        return self._primary()
+
+    def _primary(self) -> Node:
+        kind, value = self._next()
+        if kind == "TERM":
+            return _term_node(value)
+        if kind == "CAT":
+            return _cat_node(value)
+        if kind == "LPAREN":
+            node = self._or()
+            if self._peek_kind() != "RPAREN":
+                raise QueryError("括弧が閉じていません")
+            self._next()
+            return node
+        raise QueryError(f"項がありません: {value!r}")
+
+
+def _or_node(a: Node, b: Node) -> Node:
+    return lambda e: a(e) or b(e)
+
+
+def _and_node(a: Node, b: Node) -> Node:
+    return lambda e: a(e) and b(e)
+
+
+def _not_node(a: Node) -> Node:
+    return lambda e: not a(e)
+
+
+def _term_node(value: str) -> Node:
+    needle = value.casefold()
+    return lambda e: needle in e.memo.casefold() or needle in e.category.casefold()
+
+
+def _cat_node(value: str) -> Node:
+    target = value.casefold()
+    return lambda e: e.category.casefold() == target
+
+
+def _compile(q: str) -> Node:
+    return _Parser(tokenize(q)).parse()
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _compile(q)(e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    node = _compile(q)
+    return [e for e in rows if node(e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..7151160
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,70 @@
+"""Detect recurring expenses (same category and amount, roughly monthly)."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day next month, clamped to that month's last day."""
+    year, month = (d.year + 1, 1) if d.month == 12 else (d.year, d.month + 1)
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def _runs(days: list[date], min_count: int, tolerance: int) -> list[list[date]]:
+    """Split sorted unique dates into maximal chains of monthly-linked dates."""
+    runs: list[list[date]] = []
+    current: list[date] = []
+    for d in days:
+        if current and abs((d - add_month(current[-1])).days) > tolerance:
+            runs.append(current)
+            current = []
+        current.append(d)
+    if current:
+        runs.append(current)
+    return [r for r in runs if len(r) >= min_count]
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    """Find (category, amount) groups whose dates recur about monthly.
+
+    Raises ValueError if min_count < 2 or tolerance < 0.
+    """
+    if min_count < 2:
+        raise ValueError(f"min_count は 2 以上である必要があります: {min_count}")
+    if tolerance < 0:
+        raise ValueError(f"tolerance は 0 以上である必要があります: {tolerance}")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    found: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        for run in _runs(sorted(day_set), min_count, tolerance):
+            found.append(
+                Recurring(
+                    category=category,
+                    amount=amount,
+                    days=tuple(run),
+                    next_expected=add_month(run[-1]),
+                )
+            )
+
+    found.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return found
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..3a9313b
