index 0000000..a4724e4
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,120 @@
+"""Import bank statement CSV text into Expense records (pure functions)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"-?[¥￥]?[0-9][0-9,]*円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+
+
+def parse_amount(s: str) -> int:
+    """Parse a yen amount such as ``" ￥1,234,567 "`` or ``"-¥300"`` into an int."""
+    text = s.strip()
+    if not _AMOUNT_RE.fullmatch(text):
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    body = text.replace(",", "").replace("¥", "").replace("￥", "").replace("円", "")
+    return int(body)
+
+
+def parse_date(s: str) -> date:
+    """Parse ``YYYY/M/D`` or ``YYYY-M-D`` (the separator must not be mixed)."""
+    text = s.strip()
+    m = _DATE_RE.fullmatch(text)
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    try:
+        return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Convert CSV text (header on line 1) into expenses.
+
+    Returns ``(expenses, errors)``. Each error is ``(physical_line_no, field)``
+    where field is ``"date"``, ``"amount"`` or ``"category"``. A row with any
+    error is excluded from the expenses.
+    """
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text.removeprefix("﻿"), newline=""))
+    try:
+        header = next(reader)
+    except StopIteration:
+        raise ValueError("ヘッダー行がありません") from None
+    if not header or (len(header) == 1 and not header[0].strip()):
+        raise ValueError("ヘッダー行がありません")
+
+    index: dict[str, int] = {}
+    for i, name in enumerate(header):
+        index.setdefault(name, i)
+    for field, column in mapping.items():
+        if column not in index:
+            raise ValueError(f"列 {column!r} がヘッダーにありません({field})")
+
+    def cell(row: list[str], field: str) -> str:
+        if field not in mapping:
+            return ""
+        i = index[mapping[field]]
+        return row[i] if i < len(row) else ""
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    prev_end = reader.line_num  # physical line of the header's last line
+    for row in reader:
+        start = prev_end + 1  # physical line where this record begins
+        prev_end = reader.line_num
+        if not row or (len(row) == 1 and not row[0].strip()):
+            continue  # blank line: skipped, but still counted for line numbers
+
+        row_errors: list[tuple[int, str]] = []
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(cell(row, "date"))
+        except ValueError:
+            row_errors.append((start, "date"))
+        try:
+            amount = parse_amount(cell(row, "amount"))
+        except ValueError:
+            row_errors.append((start, "amount"))
+        category = cell(row, "category").strip()
+        if not category:
+            row_errors.append((start, "category"))
+
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        assert day is not None and amount is not None  # guaranteed by no errors
+        if category_map and category in category_map:
+            category = category_map[category]
+        expenses.append(
+            Expense(
+                day=day,
+                category=category,
+                amount=amount,
+                memo=cell(row, "memo").strip(),
+            )
+        )
+    return expenses, errors
