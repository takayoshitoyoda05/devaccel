+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import matches, search
+
+A = Expense(date(2024, 1, 5), "食費", 1200, "スーパー")
+B = Expense(date(2024, 1, 10), "日用品", 500, "コンビニ")
+C = Expense(date(2024, 2, 1), "住居", 80000, "家賃")
+D = Expense(date(2024, 2, 15), "食費", 10000, "外食")
+E = Expense(date(2024, 3, 31), "交通費", 300, "Suica  チャージ")
+ROWS = [A, B, C, D, E]
+
+
+# --- 例の表 (E3-*) ---
+
+
+@pytest.mark.parametrize(
+    ("cond", "expected"),
+    [
+        pytest.param(
+            {"or": [{"category": "食費"}, {"amount": {"min": 10000}}]},
+            [A, C, D],
+            id="E3-1",
+        ),
+        pytest.param({"not": {"memo": "ｺﾝﾋﾞﾆ"}}, [A, C, D, E], id="E3-2"),
+    ],
+)
+def test_example_table(cond: dict[str, object], expected: list[Expense]) -> None:
+    assert search(ROWS, cond) == expected
+
+
+def test_E3_3_min_greater_than_max_raises() -> None:
+    with pytest.raises(ValueError, match="min"):
+        search(ROWS, {"amount": {"min": 500, "max": 100}})
+
+
+# --- R1 葉の条件 ---
+
+
+def test_R1_category_str_and_list() -> None:
+    assert search(ROWS, {"category": "食費"}) == [A, D]
+    assert search(ROWS, {"category": ["住居", "交通費"]}) == [C, E]
+
+
+def test_R1_amount_min_and_max_are_inclusive() -> None:
+    assert search(ROWS, {"amount": {"min": 1200, "max": 10000}}) == [A, D]
+
+
+def test_R1_amount_one_side_only() -> None:
+    assert search(ROWS, {"amount": {"min": 10000}}) == [C, D]
+    assert search(ROWS, {"amount": {"max": 500}}) == [B, E]
+
+
+def test_R1_memo_partial_match() -> None:
+    assert search(ROWS, {"memo": "ビニ"}) == [B]
+
+
+def test_R1_date_range_inclusive() -> None:
+    assert search(
+        ROWS, {"date": {"from": date(2024, 1, 10), "to": date(2024, 2, 15)}}
+    ) == [
+        B,
+        C,
+        D,
+    ]
+
+
+def test_R1_date_one_side_only() -> None:
+    assert search(ROWS, {"date": {"from": date(2024, 3, 1)}}) == [E]
+    assert search(ROWS, {"date": {"to": date(2024, 1, 5)}}) == [A]
+
+
+# --- R2 複合キー ---
+
+
+def test_R2_and_or_not_nest() -> None:
+    cond: dict[str, object] = {
+        "and": [
+            {"or": [{"category": "食費"}, {"category": "住居"}]},
+            {"not": {"amount": {"max": 5000}}},
+        ]
+    }
+    assert search(ROWS, cond) == [C, D]
+
+
+def test_R2_multiple_keys_in_one_dict_are_and() -> None:
+    assert search(ROWS, {"category": "食費", "memo": "コンビニ"}) == []
+    assert search(ROWS, {"category": "食費", "memo": "外食"}) == [D]
+
+
+# --- R3 空の条件 ---
+
+
+def test_R3_empty_and_is_true() -> None:
+    assert search(ROWS, {"and": []}) == ROWS
+
+
+def test_R3_empty_or_is_false() -> None:
+    assert search(ROWS, {"or": []}) == []
+
+
+def test_R3_empty_dict_matches_all() -> None:
+    assert search(ROWS, {}) == ROWS
+
+
+def test_R3_empty_memo_matches_all() -> None:
+    assert search(ROWS, {"memo": ""}) == ROWS
+
+
+# --- R4 順序・非破壊・空入力 ---
+
+
+def test_R4_keeps_input_order_and_returns_new_list() -> None:
+    rows = [E, A, D]
+    before = list(rows)
+    result = search(rows, {"amount": {"min": 0}})
+    assert result == [E, A, D]
+    assert result is not rows
+    assert rows == before
+
+
+def test_R4_empty_rows_returns_empty_list() -> None:
+    assert search([], {"category": "食費"}) == []
+
+
+# --- R5 不正な条件 ---
+
+
+@pytest.mark.parametrize(
+    ("cond", "key"),
+    [
+        pytest.param({"foo": 1}, "foo", id="unknown-top-key"),
+        pytest.param({"amount": {"min": 1, "avg": 2}}, "avg", id="unknown-amount-key"),
+        pytest.param(
+            {"date": {"from": date(2024, 1, 1), "upto": date(2024, 1, 2)}},
+            "upto",
+            id="unknown-date-key",
+        ),
+        pytest.param(
+            {"date": {"from": date(2024, 3, 1), "to": date(2024, 1, 1)}},
+            "from",
+            id="from-after-to",
+        ),
+        pytest.param({"amount": "1000"}, "amount", id="amount-is-str"),
+        pytest.param({"date": "2024-01-01"}, "date", id="date-is-str"),
+        pytest.param({"and": {"category": "食費"}}, "and", id="and-is-dict"),
+        pytest.param({"category": 1}, "category", id="category-is-int"),
+        pytest.param({"category": ["食費", 1]}, "category", id="category-list-has-int"),
+        pytest.param({"amount": {"min": True}}, "min", id="bool-amount"),
+        pytest.param({"amount": {"max": 1.5}}, "max", id="float-amount"),
+        pytest.param({"amount": {"min": None}}, "min", id="none-amount"),
+    ],
+)
+def test_R5_invalid_condition_raises_naming_key(
+    cond: dict[str, object], key: str
+) -> None:
+    with pytest.raises(ValueError, match=key):
+        search(ROWS, cond)
+
+
+def test_R5_unknown_key_raises_even_with_no_rows() -> None:
+    with pytest.raises(ValueError, match="amount"):
+        search([], {"amount": {"min": 1, "bogus": 2}})
+
+
+def test_R5_unknown_key_raises_even_when_no_row_matches() -> None:
+    with pytest.raises(ValueError, match="bogus"):
+        search(ROWS, {"and": [{"category": "存在しない"}, {"bogus": 1}]})
+
+
+def test_R5_matches_also_validates() -> None:
+    with pytest.raises(ValueError, match="min"):
+        matches(A, {"amount": {"min": 500, "max": 100}})
+
+
+# --- D3 文字列の正規化 ---
+
+
+def test_D3_category_ignores_case_width_and_surrounding_space() -> None:
+    row = Expense(date(2024, 1, 1), "Food", 100, "")
+    assert search([row], {"category": " ｆｏｏｄ "}) == [row]
+
+
+def test_D3_memo_collapses_whitespace() -> None:
+    assert search(ROWS, {"memo": "suica チャージ"}) == [E]
+
+
+# --- matches ---
+
+
+def test_matches_single_row() -> None:
+    assert matches(A, {"category": "食費"}) is True
+    assert matches(B, {"category": "食費"}) is False
+
+
+# --- D2 条件内の金額値に bool は使えない ---
+
+
+def test_D2_bool_amount_in_condition_is_rejected_for_matches() -> None:
+    with pytest.raises(ValueError, match="min"):
+        matches(A, {"amount": {"min": False}})
