@@ -0,0 +1,222 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.month_diff import CategoryChange, compare_months, format_diff_report
+
+
+def ex(y: int, m: int, d: int, cat: str, amount: int) -> Expense:
+    return Expense(day=date(y, m, d), category=cat, amount=amount)
+
+
+def by_cat(changes: list[CategoryChange]) -> dict[str, CategoryChange]:
+    return {c.category: c for c in changes}
+
+
+# --- 例の表 ---------------------------------------------------------------
+
+
+def test_E4_1_increase_food() -> None:
+    # E4-1: 1 月に食費 30000、2 月に 35000 で 2026-02
+    rows = [ex(2026, 1, 10, "食費", 30000), ex(2026, 2, 5, "食費", 35000)]
+    [c] = compare_months(rows, "2026-02")
+    assert c == CategoryChange(
+        category="食費", previous=30000, current=35000, diff=5000, pct=16.7, status="増"
+    )
+
+
+def test_E4_2_new_transport() -> None:
+    # E4-2: 2 月にだけ交通費 3000
+    rows = [ex(2026, 2, 3, "交通費", 3000)]
+    [c] = compare_months(rows, "2026-02")
+    assert c.previous == 0
+    assert c.pct is None
+    assert c.status == "新規"
+
+
+def test_E4_3_rent_gone_from_previous_december() -> None:
+    # E4-3: 2026-01 で前年 12 月に家賃 80000 のみ
+    rows = [ex(2025, 12, 1, "家賃", 80000)]
+    [c] = compare_months(rows, "2026-01")
+    assert c.category == "家賃"
+    assert c.current == 0
+    assert c.status == "なくなった"
+
+
+# --- R1: 月の形式 ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "month", ["2026-13", "2026-00", "2026/01", "26-01", "2026-1", ""]
+)
+def test_R1_bad_month_format_is_value_error(month: str) -> None:
+    with pytest.raises(ValueError):
+        compare_months([], month)
+
+
+@pytest.mark.parametrize("month", [None, 202601, 2026])
+def test_R1_non_str_month_is_type_error(month: object) -> None:
+    with pytest.raises(TypeError):
+        compare_months([], month)  # type: ignore[arg-type]
+
+
+def test_R1_previous_month_crosses_year() -> None:
+    rows = [ex(2025, 12, 31, "食費", 1000), ex(2026, 1, 1, "食費", 1500)]
+    [c] = compare_months(rows, "2026-01")
+    assert (c.previous, c.current) == (1000, 1500)
+
+
+# --- R2: 両側・空の月 -----------------------------------------------------
+
+
+def test_R2_empty_previous_month_is_compared_as_zero() -> None:
+    rows = [ex(2026, 3, 1, "食費", 2000)]
+    [c] = compare_months(rows, "2026-03")
+    assert c.previous == 0
+    assert c.current == 2000
+    assert c.diff == 2000
+
+
+def test_R2_category_only_in_previous_is_included_with_zero_current() -> None:
+    rows = [ex(2026, 1, 1, "趣味", 500), ex(2026, 2, 1, "食費", 100)]
+    changes = by_cat(compare_months(rows, "2026-02"))
+    assert changes["趣味"].current == 0
+    assert changes["趣味"].diff == -500
+
+
+def test_R2_no_rows_in_either_month_returns_empty() -> None:
+    rows = [ex(2026, 5, 1, "食費", 100)]
+    assert compare_months(rows, "2026-02") == []
+
+
+def test_R2_empty_rows_returns_empty() -> None:
+    assert compare_months([], "2026-02") == []
+
+
+# --- R3: status -----------------------------------------------------------
+
+
+def test_R3_increase() -> None:
+    rows = [ex(2026, 1, 1, "食費", 100), ex(2026, 2, 1, "食費", 200)]
+    assert by_cat(compare_months(rows, "2026-02"))["食費"].status == "増"
+
+
+def test_R3_decrease() -> None:
+    rows = [ex(2026, 1, 1, "食費", 200), ex(2026, 2, 1, "食費", 100)]
+    c = by_cat(compare_months(rows, "2026-02"))["食費"]
+    assert c.diff == -100
+    assert c.status == "減"
+
+
+def test_R3_unchanged() -> None:
+    rows = [ex(2026, 1, 1, "食費", 200), ex(2026, 2, 1, "食費", 200)]
+    assert by_cat(compare_months(rows, "2026-02"))["食費"].status == "変わらず"
+
+
+def test_R3_new_takes_precedence_over_increase() -> None:
+    rows = [ex(2026, 2, 1, "食費", 200)]
+    assert by_cat(compare_months(rows, "2026-02"))["食費"].status == "新規"
+
+
+def test_R3_gone_takes_precedence_over_decrease() -> None:
+    rows = [ex(2026, 1, 1, "食費", 200)]
+    assert by_cat(compare_months(rows, "2026-02"))["食費"].status == "なくなった"
+
+
+def test_R3_refund_only_in_current_is_decrease_not_new() -> None:
+    rows = [ex(2026, 2, 1, "食費", -300)]
+    c = by_cat(compare_months(rows, "2026-02"))["食費"]
+    assert c.status == "減"
+
+
+# --- R4: pct --------------------------------------------------------------
+
+
+def test_R4_pct_rounded_to_one_decimal() -> None:
+    rows = [ex(2026, 1, 1, "食費", 30000), ex(2026, 2, 1, "食費", 20000)]
+    c = by_cat(compare_months(rows, "2026-02"))["食費"]
+    assert c.pct == -33.3
+    assert isinstance(c.pct, float)
+
+
+def test_R4_pct_none_when_previous_zero() -> None:
+    rows = [ex(2026, 2, 1, "食費", 100)]
+    assert by_cat(compare_months(rows, "2026-02"))["食費"].pct is None
+
+
+def test_R4_pct_uses_same_formula_when_totals_negative() -> None:
+    # 前月が返金で -1000、当月 0 → diff = +1000、pct = 1000 / -1000 * 100 = -100.0
+    rows = [ex(2026, 1, 1, "食費", -1000)]
+    c = by_cat(compare_months(rows, "2026-02"))["食費"]
+    assert c.diff == 1000
+    assert c.pct == -100.0
+
+
+# --- R5: 並び -------------------------------------------------------------
+
+
+def test_R5_sorted_by_abs_diff_desc_then_category_asc() -> None:
+    rows = [
+        ex(2026, 1, 1, "B", 1000),
+        ex(2026, 1, 1, "A", 1000),
+        ex(2026, 2, 1, "C", 5000),  # diff +5000
+        ex(2026, 2, 1, "B", 0),  # diff -1000 (abs 1000)
+        ex(2026, 2, 1, "A", 2000),  # diff +1000 (abs 1000)
+    ]
+    names = [c.category for c in compare_months(rows, "2026-02")]
+    assert names == ["C", "A", "B"]
+
+
+def test_R5_category_identity_uses_nfkc_case_and_spaces() -> None:
+    # D3: 全角英字・大文字小文字・連続空白は同一視する
+    rows = [ex(2026, 1, 1, "Ｆｏｏｄ  Ｘ", 100), ex(2026, 2, 1, "food x ", 300)]
+    changes = compare_months(rows, "2026-02")
+    assert len(changes) == 1
+    assert changes[0].previous == 100
+    assert changes[0].current == 300
+
+
+# --- R6: format -----------------------------------------------------------
+
+
+def test_R6_format_line_with_pct() -> None:
+    rows = [ex(2026, 1, 1, "食費", 30000), ex(2026, 2, 1, "食費", 35000)]
+    report = format_diff_report(compare_months(rows, "2026-02"))
+    assert report == "食費: 30,000円 → 35,000円 (+5,000円, +16.7%) 増"
+
+
+def test_R6_decrease_has_minus_sign() -> None:
+    rows = [ex(2026, 1, 1, "交通費", 3000), ex(2026, 2, 1, "交通費", 2000)]
+    report = format_diff_report(compare_months(rows, "2026-02"))
+    assert report == "交通費: 3,000円 → 2,000円 (-1,000円, -33.3%) 減"
+
+
+def test_R6_pct_none_omits_percent() -> None:
+    rows = [ex(2026, 2, 1, "交通費", 3000)]
+    report = format_diff_report(compare_months(rows, "2026-02"))
+    assert report == "交通費: 0円 → 3,000円 (+3,000円) 新規"
+
+
+def test_R6_empty_changes_message() -> None:
+    assert format_diff_report([]) == "変化はありません"
+
+
+def test_R6_one_line_per_category() -> None:
+    rows = [
+        ex(2026, 1, 1, "食費", 100),
+        ex(2026, 2, 1, "食費", 100),
+        ex(2026, 2, 1, "家賃", 5),
+    ]
+    report = format_diff_report(compare_months(rows, "2026-02"))
+    assert len(report.splitlines()) == 2
+
+
+def test_R6_unknown_status_is_value_error() -> None:
+    bad = CategoryChange(
+        category="食費", previous=0, current=1, diff=1, pct=None, status="謎"
+    )
+    with pytest.raises(ValueError):
+        format_diff_report([bad])
