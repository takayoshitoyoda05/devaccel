@@ -0,0 +1,131 @@
+"""Detect recurring expenses (subscriptions, rent) from a list of Expense.
+
+Pure functions: no file I/O, standard library only.
+"""
+
+from __future__ import annotations
+
+import calendar
+import re
+import unicodedata
+from collections import defaultdict
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+# R3: a row stays in the series while |amount - latest| <= 10 % of latest.
+_TOLERANCE_PERCENT = 10
+
+# R1: trailing number / month notation dropped from the memo key.
+_TRAILING_RE = re.compile(r"\s*(?:#\d+|(?<![a-z])no\.?\s*\d+|\d+月分)$")
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo: str
+    amount: int
+    months: int
+    last_date: date
+    day: int
+
+
+def _norm(s: str) -> str:
+    """D3: NFKC, lower case, strip, collapse runs of whitespace."""
+    s = unicodedata.normalize("NFKC", s).lower().strip()
+    return re.sub(r"\s+", " ", s)
+
+
+def _memo_key(memo: str) -> str:
+    """R1: normalized memo with trailing #12 / No.3 / 3月分 removed."""
+    s = _norm(memo)
+    while True:
+        t = _TRAILING_RE.sub("", s).strip()
+        if t == s:
+            return s
+        s = t
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month - 1
+
+
+def _check_amount(amount: object) -> None:
+    if isinstance(amount, bool) or not isinstance(amount, int):
+        raise TypeError(f"amount は int である必要があります: {amount!r}")
+
+
+def _series(group: list[Expense], min_months: int) -> Recurring | None:
+    # R2: a month with two or more rows means this is not a repeat.
+    months = [_month_index(e.day) for e in group]
+    if len(set(months)) != len(months):
+        return None
+
+    rows = sorted(group, key=lambda e: e.day)
+    latest = rows[-1]
+
+    # R2: the latest run of consecutive months (only this one is considered).
+    run = [latest]
+    for prev in reversed(rows[:-1]):
+        if _month_index(run[-1].day) - _month_index(prev.day) != 1:
+            break
+        run.append(prev)
+
+    # R3: walking back from the latest row, cut at the first amount outlier.
+    # |a - L| <= 10 % of L  <=>  10 * |a - L| <= L  (L >= 0, integer-exact).
+    window: list[Expense] = []
+    for e in run:
+        if _TOLERANCE_PERCENT * abs(e.amount - latest.amount) > latest.amount:
+            break
+        window.append(e)
+
+    if len(window) < min_months:
+        return None
+
+    # R4
+    return Recurring(
+        category=latest.category,
+        memo=latest.memo,
+        amount=latest.amount,
+        months=len(window),
+        last_date=latest.day,
+        day=max(e.day.day for e in window),
+    )
+
+
+def find_recurring(rows: list[Expense], *, min_months: int = 3) -> list[Recurring]:
+    if isinstance(min_months, bool) or not isinstance(min_months, int):
+        raise TypeError(f"min_months は int である必要があります: {min_months!r}")
+    if min_months < 2:
+        raise ValueError(f"min_months は 2 以上である必要があります: {min_months}")
+
+    groups: dict[tuple[str, str], list[Expense]] = defaultdict(list)
+    for e in rows:
+        _check_amount(e.amount)
+        # R1: refunds / cancellations are not part of any series.
+        if e.amount < 0:
+            continue
+        groups[(_norm(e.category), _memo_key(e.memo))].append(e)
+
+    out: list[Recurring] = []
+    for group in groups.values():
+        r = _series(group, min_months)
+        if r is not None:
+            out.append(r)
+
+    # R6
+    out.sort(key=lambda r: (-r.amount, r.category, r.memo))
+    return out
+
+
+def next_due(r: Recurring) -> date:
+    """R5: the day `r.day` in the month after last_date (clamped to month end)."""
+    if isinstance(r.day, bool) or not isinstance(r.day, int) or not 1 <= r.day <= 31:
+        raise ValueError(f"day は 1〜31 の整数である必要があります: {r.day!r}")
+    year = r.last_date.year
+    month = r.last_date.month + 1
+    if month == 13:
+        year, month = year + 1, 1
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(r.day, last))
