+++ b/src/kakeibo/search.py
@@ -0,0 +1,122 @@
+"""Filter Expense rows with a dict-based condition (pure functions)."""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from collections.abc import Callable
+from datetime import date, datetime
+from typing import Any
+
+from kakeibo.core import Expense
+
+_WS = re.compile(r"\s+")
+_COMPOSITE = ("and", "or")
+
+
+def _norm(s: str) -> str:
+    """D3: NFKC, lower-case, collapse whitespace runs, strip."""
+    return _WS.sub(" ", unicodedata.normalize("NFKC", s).lower()).strip()
+
+
+def _is_int(v: object) -> bool:
+    return isinstance(v, int) and not isinstance(v, bool)
+
+
+def _is_date(v: object) -> bool:
+    return isinstance(v, date) and not isinstance(v, datetime)
+
+
+def _check_range(
+    val: object,
+    key: str,
+    lo: str,
+    hi: str,
+    ok: Callable[[object], bool],
+    desc: str,
+) -> None:
+    """Validate a {lo, hi} range dict (both ends optional, inclusive)."""
+    if not isinstance(val, dict):
+        msg = f"{key}: {{{lo!r}, {hi!r}}} のような dict である必要があります"
+        raise ValueError(msg)  # noqa: TRY004 - R5 は型違いも ValueError
+    for k in val:
+        if k not in (lo, hi):
+            raise ValueError(f"{key}: 未知のキーです: {k!r}")
+    for k, v in val.items():
+        if not ok(v):
+            raise ValueError(f"{key}.{k}: {desc} である必要があります")
+    if lo in val and hi in val and val[lo] > val[hi]:
+        raise ValueError(f"{key}: {lo} が {hi} より大きくなっています")
+
+
+def _validate(cond: object, where: str) -> None:
+    """Check the whole condition tree before any row is looked at (R5)."""
+    if not isinstance(cond, dict):
+        raise ValueError(f"{where}: 条件は dict である必要があります")  # noqa: TRY004 - R5 は型違いも ValueError
+    for key, val in cond.items():
+        if key in _COMPOSITE:
+            if not isinstance(val, list):
+                raise ValueError(f"{where}.{key}: リストである必要があります")
+            for i, sub in enumerate(val):
+                _validate(sub, f"{where}.{key}[{i}]")
+        elif key == "not":
+            _validate(val, f"{where}.not")
+        elif key == "category":
+            if isinstance(val, str):
+                continue
+            if not isinstance(val, list) or not all(isinstance(c, str) for c in val):
+                raise ValueError(
+                    f"{where}.category: str または str のリストである必要があります"
+                )
+        elif key == "memo":
+            if not isinstance(val, str):
+                raise ValueError(f"{where}.memo: str である必要があります")
+        elif key == "amount":
+            _check_range(val, f"{where}.amount", "min", "max", _is_int, "整数")
+        elif key == "date":
+            _check_range(val, f"{where}.date", "from", "to", _is_date, "date")
+        else:
+            raise ValueError(f"{where}: 未知のキーです: {key!r}")
+
+
+def _eval(e: Expense, cond: dict[str, Any]) -> bool:
+    for key, val in cond.items():
+        if key == "and":
+            if not all(_eval(e, c) for c in val):
+                return False
+        elif key == "or":
+            if not any(_eval(e, c) for c in val):
+                return False
+        elif key == "not":
+            if _eval(e, val):
+                return False
+        elif key == "category":
+            cats = [val] if isinstance(val, str) else val
+            if _norm(e.category) not in {_norm(c) for c in cats}:
+                return False
+        elif key == "amount":
+            if "min" in val and e.amount < val["min"]:
+                return False
+            if "max" in val and e.amount > val["max"]:
+                return False
+        elif key == "memo":
+            if _norm(val) not in _norm(e.memo):
+                return False
+        elif key == "date":
+            if "from" in val and e.day < val["from"]:
+                return False
+            if "to" in val and e.day > val["to"]:
+                return False
+    return True
+
+
+def matches(e: Expense, cond: dict[str, object]) -> bool:
+    """Return True if ``e`` satisfies ``cond``. Raises ValueError on a bad condition."""
+    _validate(cond, "cond")
+    return _eval(e, cond)
+
+
+def search(rows: list[Expense], cond: dict[str, object]) -> list[Expense]:
+    """Return the rows matching ``cond``, in input order, as a new list."""
+    _validate(cond, "cond")
+    return [e for e in rows if _eval(e, cond)]
