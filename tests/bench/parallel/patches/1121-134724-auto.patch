@@ -0,0 +1,107 @@
+"""Month-over-month category comparison (pure functions, no I/O)."""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+_STATUSES = frozenset({"増", "減", "変わらず", "新規", "なくなった"})
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    diff: int
+    pct: float | None
+    status: str
+
+
+def _key(name: str) -> str:
+    """D3: NFKC + 小文字化 + 前後の空白除去 + 連続空白を 1 つに。"""
+    s = unicodedata.normalize("NFKC", name).lower().strip()
+    return re.sub(r"\s+", " ", s)
+
+
+def _previous_month(month: str) -> str:
+    y, m = int(month[:4]), int(month[5:7])
+    if m == 1:
+        y, m = y - 1, 12
+    else:
+        m -= 1
+    if y < 1:
+        raise ValueError(f"month は 0001-01 以降を指定してください: {month!r}")
+    return f"{y:04d}-{m:02d}"
+
+
+def compare_months(rows: list[Expense], month: str) -> list[CategoryChange]:
+    if not isinstance(month, str):
+        raise TypeError(f"month は str である必要があります: {type(month).__name__}")
+    if not _MONTH_RE.fullmatch(month):
+        raise ValueError(
+            f"month は YYYY-MM 形式(月 01〜12)である必要があります: {month!r}"
+        )
+    prev_month = _previous_month(month)
+
+    names: dict[str, str] = {}  # 正規化キー -> 最初に現れた表示名
+    current_sums: dict[str, int] = {}
+    previous_sums: dict[str, int] = {}
+    for e in rows:
+        ym = f"{e.day.year:04d}-{e.day.month:02d}"
+        if ym not in (month, prev_month):
+            continue
+        k = _key(e.category)
+        names.setdefault(k, e.category)
+        sums = current_sums if ym == month else previous_sums
+        sums[k] = sums.get(k, 0) + e.amount
+
+    changes: list[CategoryChange] = []
+    for k, name in names.items():
+        current = current_sums.get(k, 0)
+        previous = previous_sums.get(k, 0)
+        diff = current - previous
+        pct = None if previous == 0 else round(diff / previous * 100, 1)
+        if previous == 0 and current > 0:
+            status = "新規"
+        elif previous > 0 and current == 0:
+            status = "なくなった"
+        elif diff > 0:
+            status = "増"
+        elif diff < 0:
+            status = "減"
+        else:
+            status = "変わらず"
+        changes.append(
+            CategoryChange(
+                category=name,
+                previous=previous,
+                current=current,
+                diff=diff,
+                pct=pct,
+                status=status,
+            )
+        )
+    changes.sort(key=lambda c: (-abs(c.diff), c.category))
+    return changes
+
+
+def _line(c: CategoryChange) -> str:
+    if c.status not in _STATUSES:
+        raise ValueError(f"規則にない status です: {c.status!r}")
+    diff_s = f"{c.diff:+,}円"
+    if c.pct is None:
+        detail = diff_s
+    else:
+        detail = f"{diff_s}, {c.pct:+.1f}%"
+    return f"{c.category}: {c.previous:,}円 → {c.current:,}円 ({detail}) {c.status}"
+
+
+def format_diff_report(changes: list[CategoryChange]) -> str:
+    if not changes:
+        return "変化はありません"
+    return "\n".join(_line(c) for c in changes)
