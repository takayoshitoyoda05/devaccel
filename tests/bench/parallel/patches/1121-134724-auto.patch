@@ -0,0 +1,355 @@
+"""銀行 CSV 取り込み (kakeibo.bank_import) のテスト。"""
+
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bank_import import RowError, parse_bank_csv
+from kakeibo.core import Expense
+
+# --- 例の表 (E1-x) ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param(
+            '利用日,ご利用店名,利用金額\n2026/1/5,コンビニ,"1,234円"',
+            ([Expense(date(2026, 1, 5), "未分類", 1234, "コンビニ")], []),
+            id="E1-1",
+        ),
+        pytest.param(
+            "日付,出金,入金\n2026/1/5,,50000",
+            ([], []),
+            id="E1-2",
+        ),
+        pytest.param(
+            "日付,金額\n2026/2/30,▲500",
+            ([], [RowError(2, "日付", "2026/2/30", "存在しない日付です")]),
+            id="E1-3",
+        ),
+    ],
+)
+def test_examples(text: str, expected: tuple[list[Expense], list[RowError]]) -> None:
+    assert parse_bank_csv(text) == expected
+
+
+# --- R1 入力 ----------------------------------------------------------------
+
+
+def test_r1_bom_is_removed() -> None:
+    exp, err = parse_bank_csv("﻿日付,金額\n2026/1/5,100")
+    assert exp == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+    assert err == []
+
+
+@pytest.mark.parametrize("nl", ["\r\n", "\n", "\r"])
+def test_r1_all_newline_styles(nl: str) -> None:
+    text = f"日付,金額{nl}2026/1/5,100{nl}2026/1/6,200"
+    exp, err = parse_bank_csv(text)
+    assert [e.amount for e in exp] == [100, 200]
+    assert err == []
+
+
+def test_r1_tab_delimiter_when_tabs_outnumber_commas() -> None:
+    # ヘッダーはタブ 3 個・カンマ 0 個 → タブ区切り。データ内のカンマは値の一部。
+    exp, err = parse_bank_csv("日付\t金額\t摘要\t備考\n2026/1/5\t100\ta,b\tx")
+    assert exp == [Expense(date(2026, 1, 5), "未分類", 100, "a,b")]
+    assert err == []
+
+
+def test_r1_comma_delimiter_when_commas_outnumber_tabs() -> None:
+    # ヘッダーはカンマ 2 個・タブ 0 個 → カンマ区切り。データ内のタブは値の一部。
+    exp, err = parse_bank_csv("日付,金額,摘要\n2026/1/5,100,a\tb")
+    assert exp == [Expense(date(2026, 1, 5), "未分類", 100, "a\tb")]
+    assert err == []
+
+
+def test_r1_quoted_delimiter_and_newline_are_part_of_value() -> None:
+    exp, err = parse_bank_csv('日付,金額,摘要\n2026/1/5,100,"a,b\nc"')
+    assert exp == [Expense(date(2026, 1, 5), "未分類", 100, "a,b\nc")]
+    assert err == []
+
+
+# --- R2 ヘッダーの別名 / D3 正規化 -------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "header",
+    [
+        "利用日,利用金額,摘要,分類",
+        "取引日,ご利用金額,ご利用店名,カテゴリ",
+        "ご利用日,お支払金額,お取引内容,費目",
+        "年月日,金額,内容,category",
+        "date,amount,description,カテゴリ",
+        "日付,金額,メモ,分類",
+    ],
+)
+def test_r2_header_aliases(header: str) -> None:
+    exp, err = parse_bank_csv(f"{header}\n2026/1/5,100,店,食費")
+    assert exp == [Expense(date(2026, 1, 5), "食費", 100, "店")]
+    assert err == []
+
+
+@pytest.mark.parametrize(
+    "header",
+    ["ＤＡＴＥ,ＡＭＯＵＮＴ", "  Date  ,  Amount ", "DATE,amount", "日付 ,金額　"],
+)
+def test_d3_header_matching_normalizes_width_case_and_spaces(header: str) -> None:
+    exp, err = parse_bank_csv(f"{header}\n2026/1/5,100")
+    assert exp == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+    assert err == []
+
+
+def test_r2_unknown_extra_columns_are_ignored() -> None:
+    exp, err = parse_bank_csv("日付,備考,金額\n2026/1/5,なし,100")
+    assert exp == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+    assert err == []
+
+
+def test_r2_two_columns_for_same_role_is_value_error() -> None:
+    with pytest.raises(ValueError):
+        parse_bank_csv("日付,利用日,金額\n2026/1/5,2026/1/5,100")
+
+
+# --- R3 必須列・優先順位・既定値 ----------------------------------------------
+
+
+def test_r3_missing_date_column_returns_error_not_exception() -> None:
+    assert parse_bank_csv("金額,摘要\n100,x") == (
+        [],
+        [RowError(1, "日付", "", "必須列がありません")],
+    )
+
+
+def test_r3_missing_amount_group_returns_error_not_exception() -> None:
+    # 入金だけでは金額列の代わりにならない
+    assert parse_bank_csv("日付,入金,摘要\n2026/1/5,100,x") == (
+        [],
+        [RowError(1, "金額", "", "必須列がありません")],
+    )
+
+
+def test_r3_missing_both_required_groups_reports_each() -> None:
+    _, err = parse_bank_csv("摘要\nx")
+    assert err == [
+        RowError(1, "日付", "", "必須列がありません"),
+        RowError(1, "金額", "", "必須列がありません"),
+    ]
+
+
+def test_r3_amount_column_takes_precedence_over_out_in() -> None:
+    exp, err = parse_bank_csv("日付,金額,出金,入金\n2026/1/5,300,999,1")
+    assert exp == [Expense(date(2026, 1, 5), "未分類", 300, "")]
+    assert err == []
+
+
+def test_r3_missing_memo_and_category_default() -> None:
+    exp, _ = parse_bank_csv("日付,金額\n2026/1/5,300")
+    assert exp == [Expense(date(2026, 1, 5), "未分類", 300, "")]
+
+
+# --- R4 日付の書式 ------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026/01/05",
+        "2026.1.5",
+        "20260105",
+        "2026年1月5日",
+        "R8.1.5",
+        "令和8.1.5",
+        "2026/1/5 13:45",
+        "2026/1/5　13:45:10",
+    ],
+)
+def test_r4_date_formats(raw: str) -> None:
+    exp, err = parse_bank_csv(f'日付,金額\n"{raw}",100')
+    assert exp == [Expense(date(2026, 1, 5), "未分類", 100, "")]
+    assert err == []
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        ("R元.1.5", date(2019, 1, 5)),
+        ("R1.1.5", date(2019, 1, 5)),
+        ("令和元.12.31", date(2019, 12, 31)),
+    ],
+)
+def test_r4_reiwa_first_year(raw: str, expected: date) -> None:
+    exp, err = parse_bank_csv(f"日付,金額\n{raw},100")
+    assert exp == [Expense(expected, "未分類", 100, "")]
+    assert err == []
+
+
+def test_r4_mixed_separators_are_row_error() -> None:
+    _, err = parse_bank_csv("日付,金額\n2026-1/5,100")
+    assert [(e.line, e.column, e.value) for e in err] == [(2, "日付", "2026-1/5")]
+
+
+def test_r4_nonexistent_date_is_row_error() -> None:
+    _, err = parse_bank_csv("日付,金額\n2026/2/30,100")
+    assert [(e.line, e.column, e.value) for e in err] == [(2, "日付", "2026/2/30")]
+
+
+def test_r4_unrecognized_date_text_is_row_error() -> None:
+    _, err = parse_bank_csv("日付,金額\n5日,100")
+    assert [(e.line, e.column) for e in err] == [(2, "日付")]
+
+
+# --- R5 金額の書式 ------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        ("¥1,234", 1234),
+        ("￥1,234", 1234),
+        ("JPY1,234", 1234),
+        ("1,234円", 1234),
+        ("１，２３４円", 1234),
+        ("1 234円", 1234),
+        ("-300", -300),
+        ("−300", -300),
+        ("－300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("500−", -500),
+    ],
+)
+def test_r5_valid_amount_forms(raw: str, expected: int) -> None:
+    exp, err = parse_bank_csv(f'日付,金額\n2026/1/5,"{raw}"')
+    assert exp == [Expense(date(2026, 1, 5), "未分類", expected, "")]
+    assert err == []
+
+
+@pytest.mark.parametrize("raw", ["12.5", "", "-", "—", "abc", "1,23", "+300", "¥"])
+def test_r5_invalid_amount_is_row_error_without_rounding(raw: str) -> None:
+    exp, err = parse_bank_csv(f'日付,金額\n2026/1/5,"{raw}"')
+    assert exp == []
+    assert [(e.line, e.column) for e in err] == [(2, "金額")]
+
+
+def test_r5_unquoted_thousands_separator_column_count_error() -> None:
+    _, err = parse_bank_csv("利用日,ご利用店名,利用金額\n2026/1/5,コンビニ,1,234円")
+    assert len(err) == 1
+    assert err[0].line == 2
+    assert "列数が合いません" in err[0].reason
+    assert "引用符のない , を含む値の疑い" in err[0].reason
+
+
+# --- R6 出金/入金の 2 列形式 / D1 -----------------------------------------------
+
+
+def test_r6_out_only_is_positive_amount() -> None:
+    exp, err = parse_bank_csv("日付,出金,入金\n2026/1/5,300,")
+    assert exp == [Expense(date(2026, 1, 5), "未分類", 300, "")]
+    assert err == []
+
+
+def test_r6_both_present_is_out_minus_in() -> None:
+    exp, err = parse_bank_csv("日付,出金,入金\n2026/1/5,500,200")
+    assert exp == [Expense(date(2026, 1, 5), "未分類", 300, "")]
+    assert err == []
+
+
+def test_r6_both_present_can_be_negative_refund() -> None:
+    exp, _ = parse_bank_csv("日付,出金,入金\n2026/1/5,200,500")
+    assert exp[0].amount == -300
+
+
+def test_r6_both_empty_is_row_error() -> None:
+    _, err = parse_bank_csv("日付,出金,入金\n2026/1/5,,")
+    assert err == [RowError(2, "出金", "", "出金と入金がどちらも空です")]
+
+
+def test_d1_income_only_rows_are_skipped_without_error() -> None:
+    text = "日付,出金,入金\n2026/1/4,100,\n2026/1/5,,50000\n2026/1/6,200,"
+    exp, err = parse_bank_csv(text)
+    assert [e.amount for e in exp] == [100, 200]
+    assert err == []
+
+
+def test_d1_income_row_with_invalid_income_value_is_still_error() -> None:
+    _, err = parse_bank_csv("日付,出金,入金\n2026/1/5,,abc")
+    assert [(e.line, e.column) for e in err] == [(2, "入金")]
+
+
+# --- R7 空・空行・順序 ---------------------------------------------------------
+
+
+@pytest.mark.parametrize("text", ["", "   ", "  \n\t \r\n"])
+def test_r7_empty_or_whitespace_only_input(text: str) -> None:
+    assert parse_bank_csv(text) == ([], [])
+
+
+def test_r7_header_only_input() -> None:
+    assert parse_bank_csv("日付,金額\r\n") == ([], [])
+
+
+def test_r7_blank_rows_are_skipped_silently_and_order_kept() -> None:
+    text = "日付,金額\n\n2026/1/5,100\n,\n   ,  \n2026/1/6,200"
+    exp, err = parse_bank_csv(text)
+    assert [e.amount for e in exp] == [100, 200]
+    assert err == []
+
+
+def test_r7_errors_are_in_ascending_line_order() -> None:
+    text = "日付,金額\n2026/2/30,1\n2026/1/5,100\nxx,2\n2026/1/7,300"
+    exp, err = parse_bank_csv(text)
+    assert [e.amount for e in exp] == [100, 300]
+    assert [e.line for e in err] == [2, 4]
+
+
+# --- R8 列数・1 行 1 誤り / D6 -----------------------------------------------
+
+
+def test_r8_too_few_columns() -> None:
+    _, err = parse_bank_csv("日付,金額,摘要\n2026/1/5,100")
+    assert len(err) == 1
+    assert (err[0].line, err[0].column, err[0].value) == (2, "", "")
+    assert "期待 3" in err[0].reason and "実際 2" in err[0].reason
+
+
+def test_r8_too_many_columns() -> None:
+    _, err = parse_bank_csv("日付,金額\n2026/1/5,100,x")
+    assert len(err) == 1
+    assert (err[0].line, err[0].column) == (2, "")
+    assert "期待 2" in err[0].reason and "実際 3" in err[0].reason
+
+
+def test_d6_multiple_errors_in_one_row_are_all_reported() -> None:
+    _, err = parse_bank_csv("日付,金額\n2026/2/30,1.5")
+    assert err == [
+        RowError(2, "日付", "2026/2/30", "存在しない日付です"),
+        RowError(2, "金額", "1.5", err[1].reason),
+    ]
+
+
+def test_d6_line_is_record_start_line_for_multiline_quoted_record() -> None:
+    text = '日付,金額,摘要\n2026/2/30,100,"x\ny"\n2026/1/5,100,"p\nq"\n2026/3/1,xx,z'
+    _, err = parse_bank_csv(text)
+    assert [(e.line, e.column) for e in err] == [(2, "日付"), (6, "金額")]
+
+
+def test_d6_record_after_multiline_record_starts_at_its_own_line() -> None:
+    text = '日付,金額,摘要\n2026/1/5,100,"x\ny"\n2026/2/30,100,z'
+    _, err = parse_bank_csv(text)
+    assert [(e.line, e.value) for e in err] == [(4, "2026/2/30")]
+
+
+# --- 型 -----------------------------------------------------------------------
+
+
+def test_non_str_input_is_type_error() -> None:
+    with pytest.raises(TypeError):
+        parse_bank_csv(None)  # type: ignore[arg-type]
