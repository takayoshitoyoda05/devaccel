+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, find_recurring, next_due
+
+
+def E(y, m, d, amount=1000, category="サブスク", memo="動画"):
+    return Expense(date(y, m, d), category, amount, memo)
+
+
+# E2-1: 家賃 80000 を 1/31・2/28・3/31 → 1 件、day=31、next_due = 2026-04-30 (R4 R5)
+def test_E2_1_rent_on_month_end_is_recurring_and_next_due_clamps():
+    rows = [
+        E(2026, 1, 31, 80000, "住居", "家賃"),
+        E(2026, 2, 28, 80000, "住居", "家賃"),
+        E(2026, 3, 31, 80000, "住居", "家賃"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    r = result[0]
+    assert r.day == 31
+    assert r.months == 3
+    assert r.last_date == date(2026, 3, 31)
+    assert (r.category, r.memo, r.amount) == ("住居", "家賃", 80000)
+    assert next_due(r) == date(2026, 4, 30)
+
+
+# E2-2: 同じ月に 2 回ある動画サブスク (1/5, 1/20, 2/5, 3/5) → [] (R2)
+def test_E2_2_same_month_twice_is_not_a_repeat():
+    rows = [
+        E(2026, 1, 5),
+        E(2026, 1, 20),
+        E(2026, 2, 5),
+        E(2026, 3, 5),
+    ]
+    assert find_recurring(rows) == []
+
+
+# E2-3: min_months=True → TypeError (D2)
+def test_E2_3_bool_min_months_is_type_error():
+    with pytest.raises(TypeError):
+        find_recurring([], min_months=True)
+
+
+# --- R1: series key (D3 normalization, trailing number/month notation removed) ---
+
+
+def test_R1_key_normalizes_category_and_strips_trailing_numbers():
+    rows = [
+        E(2026, 1, 5, category="Sub", memo="Netflix #1"),
+        E(2026, 2, 5, category=" ｓｕｂ ", memo="netflix No.2"),
+        E(2026, 3, 5, category="SUB", memo="Ｎｅｔｆｌｉｘ  3月分"),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    # memo / category are the latest row's original spelling
+    assert result[0].memo == "Ｎｅｔｆｌｉｘ  3月分"
+    assert result[0].category == "SUB"
+    assert result[0].months == 3
+
+
+def test_R1_refund_rows_are_not_part_of_a_series():
+    rows = [
+        E(2026, 1, 5, amount=1000),
+        E(2026, 2, 5, amount=1000),
+        E(2026, 2, 6, amount=-1000),  # refund in the same month: ignored
+        E(2026, 3, 5, amount=1000),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].months == 3
+
+
+# --- R2: consecutive months, latest run only, duplicate month excludes ---
+
+
+def test_R2_gap_cuts_series_and_only_latest_run_counts():
+    rows = [
+        E(2026, 1, 5),
+        E(2026, 2, 5),
+        E(2026, 3, 5),
+        E(2026, 5, 5),
+        E(2026, 6, 5),
+        E(2026, 7, 5),
+    ]
+    result = find_recurring(rows, min_months=3)
+    assert len(result) == 1
+    assert result[0].months == 3
+    assert result[0].last_date == date(2026, 7, 5)
+
+
+def test_R2_latest_run_shorter_than_min_months_gives_nothing_even_if_older_run_is_long():
+    rows = [
+        E(2026, 1, 5),
+        E(2026, 2, 5),
+        E(2026, 3, 5),
+        E(2026, 5, 5),
+        E(2026, 6, 5),
+    ]
+    assert find_recurring(rows, min_months=3) == []
+
+
+def test_R2_duplicate_month_excludes_the_series():
+    rows = [E(2026, 1, 5), E(2026, 1, 25), E(2026, 2, 5), E(2026, 3, 5)]
+    assert find_recurring(rows, min_months=2) == []
+
+
+# --- R3: amount within ±10 % of latest (inclusive), cut at first outlier ---
+
+
+def test_R3_boundary_10_percent_is_inclusive():
+    # latest 1100: 1000 is 100 below, 100 / 1100 ≈ 9.09 % <= 10 %, so it stays.
+    rows = [
+        E(2026, 1, 5, amount=1000),
+        E(2026, 2, 5, amount=1000),
+        E(2026, 3, 5, amount=1100),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].months == 3
+    assert result[0].amount == 1100
+
+
+def test_R3_boundary_exactly_10_percent_is_inclusive():
+    # latest 1000: 900 is exactly 10 % below, so it stays in the series.
+    rows = [
+        E(2026, 1, 5, amount=900),
+        E(2026, 2, 5, amount=900),
+        E(2026, 3, 5, amount=1000),
+    ]
+    result = find_recurring(rows)
+    assert len(result) == 1
+    assert result[0].months == 3
+
+
+def test_R3_just_over_10_percent_cuts_the_series():
+    # latest 1000: 1101 is over 10 % above (101 > 100), so the run is cut at Jan.
+    rows = [
+        E(2026, 1, 5, amount=1101),
+        E(2026, 2, 5, amount=1000),
+        E(2026, 3, 5, amount=1000),
+    ]
+    assert find_recurring(rows, min_months=3) == []
+    (r,) = find_recurring(rows, min_months=2)
+    assert r.months == 2
+    assert r.amount == 1000
+
+
+def test_R3_outlier_before_the_run_cuts_it_and_keeps_latest_side():
+    rows = [
+        E(2026, 1, 5, amount=500),
+        E(2026, 2, 5, amount=1000),
+        E(2026, 3, 5, amount=1000),
+    ]
+    assert find_recurring(rows, min_months=3) == []
+    result = find_recurring(rows, min_months=2)
+    assert len(result) == 1
+    assert result[0].months == 2
+    assert result[0].amount == 1000
+
+
+# --- R4: day is the max day within the run; months and last_date ---
+
+
+def test_R4_day_is_max_of_run_not_of_older_outliers():
+    rows = [
+        E(2025, 12, 30, amount=500),  # outside the run (amount outlier)
+        E(2026, 1, 5, amount=1000),
+        E(2026, 2, 7, amount=1000),
+        E(2026, 3, 6, amount=1000),
+    ]
+    (r,) = find_recurring(rows, min_months=3)
+    assert r.day == 7
+    assert r.months == 3
+    assert r.last_date == date(2026, 3, 6)
+
+
+# --- R5: next_due ---
+
+
+def test_R5_december_rolls_to_january():
+    r = Recurring("サブスク", "動画", 1000, 3, date(2026, 12, 15), 15)
+    assert next_due(r) == date(2027, 1, 15)
+
+
+def test_R5_feb_clamp_then_march_31_example():
+    r = Recurring("家賃", "家賃", 80000, 3, date(2026, 2, 28), 31)
+    assert next_due(r) == date(2026, 3, 31)
+
+
+def test_R5_leap_year_february_clamps_to_29():
+    r = Recurring("家賃", "家賃", 80000, 3, date(2028, 1, 31), 31)
+    assert next_due(r) == date(2028, 2, 29)
+
+
+def test_R5_invalid_day_is_value_error():
+    r = Recurring("家賃", "家賃", 80000, 3, date(2026, 1, 31), 32)
+    with pytest.raises(ValueError):
+        next_due(r)
+
+
+# --- R6: order and two subscriptions on different days are two entries ---
+
+
+def test_R6_sorted_by_amount_desc_then_category_then_memo():
+    rows = []
+    for m in (1, 2, 3):
+        rows += [
+            E(2026, m, 5, amount=1000, category="B", memo="x"),
+            E(2026, m, 6, amount=1000, category="A", memo="y"),
+            E(2026, m, 7, amount=1000, category="A", memo="b"),
+            E(2026, m, 8, amount=5000, category="Z", memo="q"),
+        ]
+    result = find_recurring(rows)
+    assert [(r.amount, r.category, r.memo) for r in result] == [
+        (5000, "Z", "q"),
+        (1000, "A", "b"),
+        (1000, "A", "y"),
+        (1000, "B", "x"),
+    ]
+
+
+def test_R6_same_category_and_amount_but_different_memo_are_two_series():
+    rows = []
+    for m in (1, 2, 3):
+        rows += [E(2026, m, 5, memo="sub"), E(2026, m, 20, memo="sub2")]
+    assert len(find_recurring(rows)) == 2
+
+
+def test_R6_empty_input_returns_empty_list():
+    assert find_recurring([]) == []
+
+
+def test_R6_min_months_below_two_is_value_error():
+    with pytest.raises(ValueError):
+        find_recurring([], min_months=1)
+
+
+# --- D2: types ---
+
+
+@pytest.mark.parametrize("bad", [2.0, None])
+def test_D2_non_int_min_months_is_type_error(bad):
+    with pytest.raises(TypeError):
+        find_recurring([], min_months=bad)
+
+
+def test_D2_float_amount_in_row_is_type_error():
+    with pytest.raises(TypeError):
+        find_recurring([Expense(date(2026, 1, 5), "x", 1000.0, "m")])  # type: ignore[arg-type]
