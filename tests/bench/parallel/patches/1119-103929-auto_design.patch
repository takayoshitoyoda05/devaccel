--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,177 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import (
+    amount_between,
+    and_,
+    category_is,
+    date_between,
+    memo_contains,
+    not_,
+    or_,
+    search,
+)
+
+ROWS = [
+    Expense(date(2025, 11, 1), "food", 1200, "Lunch"),
+    Expense(date(2025, 11, 2), "rent", 80000, ""),
+    Expense(date(2025, 11, 3), "food", 800, "coffee"),
+]
+
+
+# --- category_is ---------------------------------------------------------
+
+
+def test_category_is_matches_any_name_exactly() -> None:
+    assert search(ROWS, category_is("food")) == [ROWS[0], ROWS[2]]
+    assert search(ROWS, category_is("rent", "food")) == ROWS
+
+
+def test_category_is_is_not_substring_match() -> None:
+    assert search(ROWS, category_is("foo")) == []
+
+
+def test_category_is_strips_whitespace_on_names_and_category() -> None:
+    padded = [Expense(date(2025, 11, 1), "  food ", 100)]
+    assert search(padded, category_is(" food ")) == padded
+
+
+def test_category_is_without_names_raises() -> None:
+    with pytest.raises(ValueError):
+        category_is()
+
+
+# --- amount_between ------------------------------------------------------
+
+
+def test_amount_between_includes_both_ends() -> None:
+    assert search(ROWS, amount_between(800, 1200)) == [ROWS[0], ROWS[2]]
+
+
+def test_amount_between_min_equals_max() -> None:
+    assert search(ROWS, amount_between(800, 800)) == [ROWS[2]]
+
+
+def test_amount_between_open_ends() -> None:
+    assert search(ROWS, amount_between(min_amount=1200)) == [ROWS[0], ROWS[1]]
+    assert search(ROWS, amount_between(max_amount=1000)) == [ROWS[2]]
+
+
+def test_amount_between_none_none_matches_all() -> None:
+    assert search(ROWS, amount_between(None, None)) == ROWS
+
+
+def test_amount_between_min_greater_than_max_raises() -> None:
+    with pytest.raises(ValueError):
+        amount_between(1000, 999)
+
+
+# --- memo_contains -------------------------------------------------------
+
+
+def test_memo_contains_is_partial_match() -> None:
+    assert search(ROWS, memo_contains("unc")) == [ROWS[0]]
+
+
+def test_memo_contains_is_case_insensitive_by_default() -> None:
+    assert search(ROWS, memo_contains("LUNCH")) == [ROWS[0]]
+
+
+def test_memo_contains_case_sensitive_distinguishes_case() -> None:
+    assert search(ROWS, memo_contains("LUNCH", case_sensitive=True)) == []
+    assert search(ROWS, memo_contains("Lunch", case_sensitive=True)) == [ROWS[0]]
+
+
+def test_memo_contains_does_not_match_empty_memo() -> None:
+    assert search(ROWS, memo_contains("e")) == [ROWS[2]]
+
+
+def test_memo_contains_empty_text_raises() -> None:
+    with pytest.raises(ValueError):
+        memo_contains("")
+
+
+# --- date_between --------------------------------------------------------
+
+
+def test_date_between_includes_both_ends() -> None:
+    assert search(ROWS, date_between(date(2025, 11, 1), date(2025, 11, 2))) == [
+        ROWS[0],
+        ROWS[1],
+    ]
+
+
+def test_date_between_start_equals_end() -> None:
+    assert search(ROWS, date_between(date(2025, 11, 3), date(2025, 11, 3))) == [ROWS[2]]
+
+
+def test_date_between_open_ends_and_none_none() -> None:
+    assert search(ROWS, date_between(start=date(2025, 11, 2))) == [ROWS[1], ROWS[2]]
+    assert search(ROWS, date_between(end=date(2025, 11, 1))) == [ROWS[0]]
+    assert search(ROWS, date_between(None, None)) == ROWS
+
+
+def test_date_between_start_greater_than_end_raises() -> None:
+    with pytest.raises(ValueError):
+        date_between(date(2025, 11, 5), date(2025, 11, 1))
+
+
+# --- and_ / or_ / not_ ---------------------------------------------------
+
+
+def test_and_combines_predicates() -> None:
+    pred = and_(category_is("food"), amount_between(max_amount=1000))
+    assert search(ROWS, pred) == [ROWS[2]]
+
+
+def test_or_combines_predicates() -> None:
+    pred = or_(memo_contains("LUNCH"), category_is("rent"))
+    assert search(ROWS, pred) == [ROWS[0], ROWS[1]]
+
+
+def test_not_negates_predicate() -> None:
+    assert search(ROWS, not_(category_is("food"))) == [ROWS[1]]
+
+
+def test_nested_and_or_not() -> None:
+    pred = and_(
+        or_(category_is("rent"), memo_contains("cof")),
+        not_(amount_between(min_amount=100000)),
+    )
+    assert search(ROWS, pred) == [ROWS[1], ROWS[2]]
+
+
+def test_empty_and_is_always_true() -> None:
+    assert search(ROWS, and_()) == ROWS
+
+
+def test_empty_or_is_always_false() -> None:
+    assert search(ROWS, or_()) == []
+
+
+# --- search --------------------------------------------------------------
+
+
+def test_search_none_predicate_returns_copy_of_all_rows() -> None:
+    result = search(ROWS, None)
+    assert result == ROWS
+    assert result is not ROWS
+
+
+def test_search_preserves_original_order() -> None:
+    rows = [ROWS[2], ROWS[0], ROWS[1], ROWS[2]]
+    assert search(rows, category_is("food")) == [ROWS[2], ROWS[0], ROWS[2]]
+
+
+def test_search_does_not_mutate_input() -> None:
+    rows = list(ROWS)
+    search(rows, category_is("rent"))
+    assert rows == ROWS
+
+
+def test_search_empty_rows() -> None:
+    assert search([], category_is("food")) == []
