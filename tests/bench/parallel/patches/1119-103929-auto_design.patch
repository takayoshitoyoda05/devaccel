index 0000000..00ca707
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,234 @@
+"""Import bank / card statement CSV text into Expense records (pure functions)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass, field
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+class ImportFormatError(ValueError):
+    """Structural problem with the whole CSV (not a single row)."""
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int  # physical line of the record's first line (header is line 1)
+    column: str  # "date" / "amount" / "withdrawal" / "deposit" / "row"
+    reason: str
+    raw: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense] = field(default_factory=list)
+    errors: list[RowError] = field(default_factory=list)
+    skipped: list[int] = field(default_factory=list)
+
+
+DEFAULT_MAPPING: dict[str, tuple[str, ...]] = {
+    "date": ("date", "日付", "利用日", "取引日", "ご利用日", "年月日"),
+    "amount": ("amount", "金額", "利用金額", "ご利用金額", "支払金額"),
+    "withdrawal": ("出金", "出金額", "お支払金額"),
+    "deposit": ("入金", "入金額", "お預り金額"),
+    "memo": ("memo", "摘要", "内容", "ご利用店名", "利用店名", "店名", "備考"),
+    "category": ("category", "カテゴリ", "分類", "費目"),
+}
+
+_AMOUNT_RE = re.compile(r"(?:[0-9]{1,3}(?:,[0-9]{3})+|[0-9]+)(?:\.0+)?")
+_DATE_SEP_RE = re.compile(
+    r"(?P<y>[0-9]{4})(?P<sep>[-/.])(?P<m>[0-9]{1,2})(?P=sep)(?P<d>[0-9]{1,2})"
+)
+_DATE_JP_RE = re.compile(r"(?P<y>[0-9]{4})年(?P<m>[0-9]{1,2})月(?P<d>[0-9]{1,2})日")
+_DATE_COMPACT_RE = re.compile(r"(?P<y>[0-9]{4})(?P<m>[0-9]{2})(?P<d>[0-9]{2})")
+
+
+def parse_amount(s: str) -> int:
+    """Parse a yen amount string such as ``¥1,200`` or ``(1,200)`` into an int."""
+    err = ValueError(f"金額が整数ではありません: {s!r}")
+    t = unicodedata.normalize("NFKC", s).strip()
+    negative = False
+    if t.startswith("△"):
+        negative = True
+        t = t[1:]
+    elif t.startswith("(") and t.endswith(")"):
+        negative = True
+        t = t[1:-1]
+    t = t.removesuffix("円")
+    t = t.strip()
+    t = t.removeprefix("¥")
+    if t.startswith("-"):
+        if negative:
+            raise err
+        negative = True
+        t = t[1:]
+    if _AMOUNT_RE.fullmatch(t) is None:
+        raise err
+    value = int(t.split(".")[0].replace(",", ""))
+    return -value if negative else value
+
+
+def parse_date(s: str) -> date:
+    """Parse a date string in one of the supported notations."""
+    t = unicodedata.normalize("NFKC", s).strip()
+    m = (
+        _DATE_SEP_RE.fullmatch(t)
+        or _DATE_JP_RE.fullmatch(t)
+        or _DATE_COMPACT_RE.fullmatch(t)
+    )
+    if m is None:
+        raise ValueError(f"日付が不正です: {s!r}")
+    try:
+        return date(int(m["y"]), int(m["m"]), int(m["d"]))
+    except ValueError:
+        raise ValueError(f"日付が不正です: {s!r}") from None
+
+
+def _norm(name: str) -> str:
+    return unicodedata.normalize("NFKC", name).strip().lower()
+
+
+def _detect_delimiter(text: str) -> str:
+    first = next((ln for ln in text.splitlines() if ln.strip()), "")
+    counts = {d: first.count(d) for d in (",", "\t", ";")}
+    best = max(counts, key=lambda d: counts[d])
+    return best if counts[best] > 0 else ","
+
+
+def _records(text: str, delimiter: str):
+    """Yield (first physical line, row) for each CSV record."""
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delimiter)
+    while True:
+        start = reader.line_num + 1
+        try:
+            row = next(reader)
+        except StopIteration:
+            return
+        yield start, row
+
+
+def _cell(row: list[str], index: int | None) -> str | None:
+    if index is None or index >= len(row):
+        return None
+    return row[index]
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, tuple[str, ...]] | None = None,
+    category_map: dict[str, str] | None = None,
+    default_category: str = "未分類",
+    negative_is_expense: bool = False,
+) -> ImportResult:
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    if "date" not in mapping:
+        raise ValueError("mapping に必須キー 'date' がありません")
+    text = text.removeprefix("﻿")
+
+    records = _records(text, _detect_delimiter(text))
+    header: list[str] | None = None
+    for _, row in records:
+        if any(c.strip() for c in row):
+            header = row
+            break
+    if header is None:
+        raise ImportFormatError("CSV が空です(ヘッダ行がありません)")
+
+    headers_norm = [_norm(h) for h in header]
+
+    def find(canonical: str) -> int | None:
+        for cand in mapping.get(canonical, ()):
+            n = _norm(cand)
+            if n in headers_norm:
+                return headers_norm.index(n)
+        return None
+
+    idx_date = find("date")
+    idx_amount = find("amount")
+    idx_withdrawal = find("withdrawal")
+    idx_deposit = find("deposit")
+    idx_memo = find("memo")
+    idx_category = find("category")
+
+    if idx_date is None:
+        raise ImportFormatError(
+            f"date 列が見つかりません。見つかったヘッダ: {header!r}"
+        )
+    if idx_amount is None and idx_withdrawal is None:
+        raise ImportFormatError(
+            f"amount も withdrawal も見つかりません。見つかったヘッダ: {header!r}"
+        )
+    use_amount = idx_amount is not None
+
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    skipped: list[int] = []
+
+    for line, row in records:
+        if not any(c.strip() for c in row):
+            continue
+        row_errors: list[RowError] = []
+
+        day: date | None = None
+        raw_date = _cell(row, idx_date)
+        if raw_date is None:
+            row_errors.append(RowError(line, "date", "列がありません", ""))
+        else:
+            try:
+                day = parse_date(raw_date)
+            except ValueError as e:
+                row_errors.append(RowError(line, "date", str(e), raw_date))
+
+        amount: int | None = None
+        is_income = False
+        if use_amount:
+            raw_amount = _cell(row, idx_amount)
+            if raw_amount is None:
+                row_errors.append(RowError(line, "amount", "列がありません", ""))
+            else:
+                try:
+                    amount = parse_amount(raw_amount)
+                except ValueError as e:
+                    row_errors.append(RowError(line, "amount", str(e), raw_amount))
+                if amount is not None and negative_is_expense:
+                    amount = -amount
+        else:
+            raw_withdrawal = _cell(row, idx_withdrawal)
+            if raw_withdrawal is None:
+                row_errors.append(RowError(line, "withdrawal", "列がありません", ""))
+            elif (
+                raw_withdrawal.strip() == "" and (_cell(row, idx_deposit) or "").strip()
+            ):
+                is_income = True
+            else:
+                try:
+                    amount = parse_amount(raw_withdrawal)
+                except ValueError as e:
+                    row_errors.append(
+                        RowError(line, "withdrawal", str(e), raw_withdrawal)
+                    )
+
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        if is_income or amount is None or amount <= 0:
+            skipped.append(line)
+            continue
+
+        category = (_cell(row, idx_category) or "").strip()
+        if category == "":
+            category = default_category
+        elif category_map and category in category_map:
+            category = category_map[category]
+        memo = (_cell(row, idx_memo) or "").strip()
+
+        assert day is not None
+        expenses.append(Expense(day=day, category=category, amount=amount, memo=memo))
+
+    return ImportResult(expenses=expenses, errors=errors, skipped=skipped)
