+++ b/tests/test_importer.py
@@ -0,0 +1,412 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.importer import (
+    ImportFormatError,
+    ImportResult,
+    RowError,
+    import_statement,
+    parse_amount,
+    parse_date,
+)
+
+# ---- parse_amount (D6) ----
+
+
+@pytest.mark.parametrize(
+    ("s", "expected"),
+    [
+        ("1,234円", 1234),
+        ("￥１，２３４", 1234),
+        ("JPY 500", 500),
+        ("0", 0),
+        ("-300", -300),
+        ("−300", -300),  # U+2212
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+    ],
+)
+def test_d6_parse_amount_accepted_forms(s, expected):
+    assert parse_amount(s) == expected
+
+
+@pytest.mark.parametrize("s", ["12.5", "12.0", "", "-", "abc", "1 2 3 4"])
+def test_d6_parse_amount_rejected_raises_value_error(s):
+    with pytest.raises(ValueError) as ei:
+        parse_amount(s)
+    assert str(ei.value) != ""
+
+
+@pytest.mark.parametrize("v", [None, 1234, True])
+def test_d6_parse_amount_non_str_raises_type_error(v):
+    with pytest.raises(TypeError):
+        parse_amount(v)
+
+
+# ---- parse_date (D7) ----
+
+
+@pytest.mark.parametrize(
+    "s",
+    [
+        "2026-01-05",
+        "2026/1/5",
+        "2026.1.5",
+        "2026年1月5日",
+        "2026-01-05 12:30",
+        "2026-01-05T12:30:00",
+    ],
+)
+def test_d7_parse_date_accepted_forms(s):
+    assert parse_date(s) == date(2026, 1, 5)
+
+
+def test_d7_leap_day_2024_is_valid():
+    assert parse_date("2024-02-29") == date(2024, 2, 29)
+
+
+@pytest.mark.parametrize(
+    "s", ["2026-02-29", "2026-02-30", "26/1/5", "令和8年1月5日", ""]
+)
+def test_d7_invalid_date_raises_value_error(s):
+    with pytest.raises(ValueError):
+        parse_date(s)
+
+
+@pytest.mark.parametrize("v", [None, 20260105])
+def test_d7_parse_date_non_str_raises_type_error(v):
+    with pytest.raises(TypeError):
+        parse_date(v)
+
+
+# ---- import_statement: type and format errors (D5) ----
+
+
+@pytest.mark.parametrize("v", [None, b"date,amount\n2026/1/5,100\n"])
+def test_import_statement_non_str_raises_type_error(v):
+    with pytest.raises(TypeError):
+        import_statement(v)
+
+
+def test_d5_format_error_is_value_error_subclass():
+    assert issubclass(ImportFormatError, ValueError)
+
+
+def test_d5_missing_date_column_raises_format_error():
+    with pytest.raises(ImportFormatError) as ei:
+        import_statement("摘要,金額\n x,100\n")
+    assert ei.value.problems
+    assert any("日付" in p for p in ei.value.problems)
+
+
+def test_d5_missing_amount_and_withdrawal_raises_format_error():
+    with pytest.raises(ImportFormatError) as ei:
+        import_statement("日付,摘要\n2026/1/5,x\n")
+    assert ei.value.problems
+
+
+def test_d5_two_date_columns_raise_format_error():
+    with pytest.raises(ImportFormatError):
+        import_statement("日付,利用日,摘要,金額\n2026/1/5,2026/1/5,x,100\n")
+
+
+def test_d5_two_amount_columns_raise_format_error():
+    with pytest.raises(ImportFormatError):
+        import_statement("日付,金額,利用金額\n2026/1/5,100,100\n")
+
+
+@pytest.mark.parametrize("text", ["", "   ", " \n\t \n"])
+def test_d5_empty_or_blank_input_raises_format_error(text):
+    with pytest.raises(ImportFormatError):
+        import_statement(text)
+
+
+def test_d5_header_only_gives_empty_result():
+    result = import_statement("日付,摘要,金額\n")
+    assert isinstance(result, ImportResult)
+    assert result.expenses == []
+    assert result.errors == []
+
+
+# ---- import_statement: row errors and continuation (D1, D2) ----
+
+
+def test_d1_bad_row_does_not_stop_import():
+    text = "日付,摘要,金額\n2026/1/4,good,100\n2026/2/30,bad,200\n2026/1/6,good2,300\n"
+    result = import_statement(text)
+    assert result.expenses == [
+        Expense(date(2026, 1, 4), "未分類", 100, "good"),
+        Expense(date(2026, 1, 6), "未分類", 300, "good2"),
+    ]
+    assert len(result.errors) == 1
+    err = result.errors[0]
+    assert err.line == 3
+    assert err.column == "日付"
+    assert err.value == "2026/2/30"
+    assert err.reason != ""
+
+
+def test_d1_errors_are_in_line_order():
+    text = "日付,摘要,金額\nbad,x,100\n2026/1/5,ok,100\nalso-bad,x,100\n"
+    result = import_statement(text)
+    assert [e.line for e in result.errors] == [2, 4]
+
+
+def test_d2_multiple_errors_in_one_row_all_reported():
+    text = "日付,摘要,金額\n2026/2/30,x,abc\n"
+    result = import_statement(text)
+    assert result.expenses == []
+    assert len(result.errors) == 2
+    assert {e.line for e in result.errors} == {2}
+    assert {e.column for e in result.errors} == {"日付", "金額"}
+
+
+# ---- import_statement: text layout (D3) ----
+
+
+def test_d3_bom_is_ignored():
+    text = "﻿日付,摘要,金額\n2026/1/5,x,100\n"
+    result = import_statement(text)
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "x")]
+
+
+def test_d3_tab_delimiter_when_header_has_tab_and_no_comma():
+    text = "日付\t摘要\t金額\n2026/1/5\tx\t100\n"
+    result = import_statement(text)
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "x")]
+
+
+@pytest.mark.parametrize("nl", ["\n", "\r\n", "\r"])
+def test_d3_any_newline_style_accepted(nl):
+    text = nl.join(["日付,摘要,金額", "2026/1/5,x,100", "2026/1/6,y,200", ""])
+    result = import_statement(text)
+    assert result.expenses == [
+        Expense(date(2026, 1, 5), "未分類", 100, "x"),
+        Expense(date(2026, 1, 6), "未分類", 200, "y"),
+    ]
+
+
+def test_d3_quoted_comma_and_newline_are_one_value_and_line_is_start_line():
+    # header: line 1, first record starts on line 2 and spans lines 2-3,
+    # so the bad second record starts on line 4.
+    text = '日付,摘要,金額\n2026/1/5,"a,b\nc",100\n2026/2/30,x,100\n'
+    result = import_statement(text)
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "a,b\nc")]
+    assert len(result.errors) == 1
+    assert result.errors[0].line == 4
+    assert result.errors[0].column == "日付"
+
+
+def test_d3_error_on_record_starting_at_line_2_reports_line_2():
+    text = '日付,摘要,金額\n2026/1/5,"a\nb",100\n'
+    result = import_statement(text)
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "a\nb")]
+    assert result.errors == []
+
+
+# ---- import_statement: column names (D4) ----
+
+
+@pytest.mark.parametrize(
+    "alias", ["日付", "利用日", "ご利用日", "取引日", "date", " DATE ", "Ｄａｔｅ"]
+)
+def test_d4_date_column_aliases(alias):
+    text = f"{alias},摘要,金額\n2026/1/5,x,100\n"
+    result = import_statement(text)
+    assert result.expenses == [Expense(date(2026, 1, 5), "未分類", 100, "x")]
+
+
+@pytest.mark.parametrize(
+    "alias", ["金額", "利用金額", "ご利用金額", "amount", " Amount "]
+)
+def test_d4_amount_column_aliases(alias):
