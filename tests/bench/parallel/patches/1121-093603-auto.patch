@@ -0,0 +1,288 @@
+"""Import bank / credit-card statement CSVs (pure functions, no file I/O).
+
+Decisions:
+D1: ダメな行があっても止めず、良い行は expenses、ダメな行は errors に入る
+    (2 行目が良・3 行目が日付 "2026/2/30" → expenses 1 件、errors[0].line == 3)。errors は行番号順。
+D2: 1 行に誤りが複数あれば全部 RowError にする(日付も金額も不正 → 同じ line で 2 件)。
+D3: 先頭の BOM は無視。ヘッダー行にタブがありカンマが無ければタブ区切り、それ以外はカンマ。
+    改行は \\n / \\r\\n / \\r。引用符内の区切り・改行は 1 つの値で、line はレコードの開始行。
+D4: 列名の別名は NFKC・大文字小文字無視・前後空白除去で比較する。
+    日付: 日付/利用日/ご利用日/取引日/date。金額: 金額/利用金額/ご利用金額/amount。
+    出金: 出金額/出金/お支払金額/支払金額。入金: 入金額/入金/預入金額/お預かり金額。
+    メモ: 摘要/メモ/利用店名/ご利用店名/内容/description/memo。カテゴリ(任意): カテゴリ/category。
+D5: 日付列が無い、または金額列も出金列も無い → ImportFormatError。同じ項目に当たる列が 2 つ以上
+    → ImportFormatError。空・空白だけの入力 → ImportFormatError。ヘッダーだけ → 空の ImportResult。
+D6: 金額は NFKC 後に前後空白と ¥ ￥ 円 JPY と桁区切り , を除く。"1,234円"→1234、"￥１，２３４"→1234。
+    負数は "-300" "−300"(U+2212) "△500" "▲500" "(500)" "500-" で、返金として負の整数で受ける。
+    小数 "12.5"・空・"-" 単独・"abc"・数字の間の空白は ValueError。str 以外は TypeError。
+D7: 日付は NFKC 後に 2026-01-05 / 2026/1/5 / 2026.1.5 / 2026年1月5日 と、末尾の時刻
+    (2026-01-05 12:30 / 2026-01-05T12:30:00。時刻は捨てる)を受ける。存在しない日付・2 桁年・和暦・空は
+    ValueError。str 以外は TypeError。
+D8: 金額 1 列の形式は値をそのまま Expense.amount に(負なら負)。空の行は金額列の RowError。
+D9: 出金/入金の 2 列形式: 出金が正の行 → amount = 出金額。入金だけの行(出金が空か 0 で入金が正)は
+    収入なので黙って読み飛ばす。両方空 → RowError。両方が 0 でない → RowError。不正な書き方 →
+    その列の RowError。出金列だけで入金列が無い形式も可(空の出金 → RowError)。入金が負 → RowError。
+D10: カテゴリ列が無い・空欄 → "未分類"。カテゴリ・メモは前後空白除去、メモ列が無ければ ""。
+D11: 完全な空行は読み飛ばす(行番号は進む)。列数がヘッダーと違う行 → RowError(column "(行)")。
+    reason に、桁区切りを含む値は引用符で囲むヒントを含める。
+D12: 例: "利用日,ご利用店名,利用金額" + '2026/1/5,セブン,"1,234円"' + "2026/1/6,返品,△500"
+    → [Expense(2026-01-05, "未分類", 1234, "セブン"), Expense(2026-01-06, "未分類", -500, "返品")]
+D13: 金額列と出金列が両方ある → ImportFormatError(どちらを使うか決められないため)。
+"""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+UNCATEGORIZED = "未分類"
+ROW_COLUMN = "(行)"
+
+_ALIASES: dict[str, tuple[str, ...]] = {
+    "date": ("日付", "利用日", "ご利用日", "取引日", "date"),
+    "amount": ("金額", "利用金額", "ご利用金額", "amount"),
+    "withdrawal": ("出金額", "出金", "お支払金額", "支払金額"),
+    "deposit": ("入金額", "入金", "預入金額", "お預かり金額"),
+    "memo": ("摘要", "メモ", "利用店名", "ご利用店名", "内容", "description", "memo"),
+    "category": ("カテゴリ", "category"),
+}
+_FIELD_NAMES = {
+    "date": "日付",
+    "amount": "金額",
+    "withdrawal": "出金",
+    "deposit": "入金",
+    "memo": "メモ",
+    "category": "カテゴリ",
+}
+
+
+def _norm(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip().casefold()
+
+
+_ALIAS_TO_FIELD = {_norm(a): f for f, names in _ALIASES.items() for a in names}
+
+
+class ImportFormatError(ValueError):
+    """The statement as a whole cannot be read (bad header, empty input)."""
+
+    def __init__(self, problems: list[str]) -> None:
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int  # 1-based line where the record starts (header is the first line)
+    column: str  # header text as written, or "(行)" for a whole-row problem
+    value: str  # original value
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+
+
+_PLAIN_RE = re.compile(r"[-−]?([0-9]+)")
+_MARK_RE = re.compile(r"[△▲]([0-9]+)")
+_PAREN_RE = re.compile(r"\(([0-9]+)\)")
+_TRAIL_RE = re.compile(r"([0-9]+)[-−]")
+_DATE_RE = re.compile(
+    r"([0-9]{4})[-/.年]([0-9]{1,2})[-/.月]([0-9]{1,2})日?"
+    r"(?:[ T]+[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?)?"
+)
+
+
+def parse_amount(s: str) -> int:
+    if not isinstance(s, str):
+        raise TypeError(f"金額は str で渡してください: {type(s).__name__}")
+    t = unicodedata.normalize("NFKC", s)
+    for junk in ("¥", "円", ",", "JPY", "jpy"):
+        t = t.replace(junk, "")
+    t = t.strip()
+    if not t:
+        raise ValueError("金額が空です")
+    if m := _PLAIN_RE.fullmatch(t):
+        return -int(m[1]) if t[0] in "-−" else int(m[1])
+    if m := (_MARK_RE.fullmatch(t) or _PAREN_RE.fullmatch(t) or _TRAIL_RE.fullmatch(t)):
+        return -int(m[1])
+    raise ValueError(f"金額として読めません: {s!r}")
+
+
+def parse_date(s: str) -> date:
+    if not isinstance(s, str):
+        raise TypeError(f"日付は str で渡してください: {type(s).__name__}")
+    t = unicodedata.normalize("NFKC", s).strip()
+    if not t:
+        raise ValueError("日付が空です")
+    m = _DATE_RE.fullmatch(t)
+    if not m:
+        raise ValueError(f"日付として読めません: {s!r}")
+    try:
+        return date(int(m[1]), int(m[2]), int(m[3]))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def _read_header(fields: dict[str, int]) -> list[str]:
+    problems: list[str] = []
+    if "date" not in fields:
+        problems.append("日付の列がありません")
+    if "amount" in fields and "withdrawal" in fields:
+        problems.append(
+            "金額の列と出金の列が両方あります(どちらを使うか決められません)"
+        )
+    elif "amount" not in fields and "withdrawal" not in fields:
+        problems.append("金額(または出金)の列がありません")
+    return problems
+
+
+def import_statement(text: str) -> ImportResult:
+    if not isinstance(text, str):
+        raise TypeError(f"text は str で渡してください: {type(text).__name__}")
+    text = text.removeprefix("﻿")
+    if not text.strip():
+        raise ImportFormatError(["入力が空です(ヘッダー行がありません)"])
+
+    first = next(ln for ln in text.splitlines() if ln.strip())
+    delim = "\t" if "\t" in first and "," not in first else ","
+    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delim)
+
+    header: list[str] | None = None
+    fields: dict[str, int] = {}
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    prev = 0
+    try:
+        for rec in reader:
+            start = prev + 1
+            prev = reader.line_num
+            if all(not c.strip() for c in rec):
+                continue
+            if header is None:
+                header = rec
+                problems: list[str] = []
+                for i, cell in enumerate(rec):
+                    f = _ALIAS_TO_FIELD.get(_norm(cell))
+                    if f is None:
+                        continue
+                    if f in fields:
+                        problems.append(
+                            f"{_FIELD_NAMES[f]}に当たる列が複数あります: "
+                            f"{rec[fields[f]]!r} と {cell!r}"
+                        )
+                    else:
+                        fields[f] = i
+                problems += _read_header(fields)
+                if problems:
+                    raise ImportFormatError(problems)
+                continue
+            _read_row(rec, start, header, fields, delim, expenses, errors)
+    except csv.Error as e:
+        errors.append(RowError(prev + 1, ROW_COLUMN, "", f"CSV として読めません: {e}"))
+    return ImportResult(expenses, errors)
+
+
+def _cell(rec: list[str], fields: dict[str, int], key: str) -> str:
+    return rec[fields[key]].strip() if key in fields else ""
+
+
+def _read_row(
+    rec: list[str],
+    line: int,
+    header: list[str],
+    fields: dict[str, int],
+    delim: str,
+    expenses: list[Expense],
+    errors: list[RowError],
+) -> None:
+    if len(rec) != len(header):
+        errors.append(
+            RowError(
+                line,
+                ROW_COLUMN,
+                delim.join(rec),
+                f"列数がヘッダーと合いません(ヘッダー {len(header)} 列・この行 {len(rec)} 列)。"
+                "1,234円 のように桁区切りを含む値は引用符で囲んでください",
+            )
+        )
+        return
+
+    row_errors: list[RowError] = []
+
+    def fail(key: str, reason: str) -> None:
+        i = fields[key]
+        row_errors.append(RowError(line, header[i], rec[i], reason))
+
+    day: date | None = None
+    try:
+        day = parse_date(rec[fields["date"]])
+    except ValueError as e:
+        fail("date", str(e))
+
+    amount = _row_amount(rec, fields, fail)
+
+    if row_errors:
+        errors.extend(row_errors)
+        return
+    if day is None or amount is None:  # skipped income row
+        return
+    expenses.append(
+        Expense(
+            day=day,
+            category=_cell(rec, fields, "category") or UNCATEGORIZED,
+            amount=amount,
+            memo=_cell(rec, fields, "memo"),
+        )
+    )
+
+
+def _optional_amount(
+    rec: list[str], fields: dict[str, int], key: str, fail
+) -> tuple[bool, int | None]:  # type: ignore[no-untyped-def]
+    """(ok, value). value is None when the cell is blank or the column is missing."""
+    if key not in fields or not rec[fields[key]].strip():
+        return True, None
+    try:
+        return True, parse_amount(rec[fields[key]])
+    except ValueError as e:
+        fail(key, str(e))
+        return False, None
+
+
+def _row_amount(rec: list[str], fields: dict[str, int], fail) -> int | None:  # type: ignore[no-untyped-def]
+    if "amount" in fields:
+        try:
+            return parse_amount(rec[fields["amount"]])
+        except ValueError as e:
+            fail("amount", str(e))
+            return None
+
+    ok_w, w = _optional_amount(rec, fields, "withdrawal", fail)
+    ok_d, d = _optional_amount(rec, fields, "deposit", fail)
+    if not (ok_w and ok_d):
+        return None
+    if d is not None and d < 0:
+        fail("deposit", "入金額が負です")
+        return None
+    if w is not None and w != 0 and d:
+        fail("withdrawal", "出金と入金の両方に金額があります")
+        return None
+    if w is None or w == 0:
+        if d:  # deposit only: income, not an expense
+            return None
+        if w is None:
+            fail(
+                "withdrawal",
+                "出金額が空です" if d is None else "出金額が空で、入金額も 0 です",
+            )
+            return None
+    return w
diff --git a/tests/test_importer.py b/tests/test_importer.py
