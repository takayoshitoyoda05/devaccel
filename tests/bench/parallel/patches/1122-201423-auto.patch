diff --git a/tests/test_types/test_Choice.py b/tests/test_types/test_Choice.py
index c34f516..6b9ad3c 100644
--- a/tests/test_types/test_Choice.py
+++ b/tests/test_types/test_Choice.py
@@ -1,7 +1,101 @@
+import enum
+
+import pytest
+
 import click
+from click.testing import CliRunner
 
 
 def test_choice_get_invalid_choice_message():
     choice = click.Choice(["a", "b", "c"])
     message = choice.get_invalid_choice_message("d", ctx=None)
     assert message == "'d' is not one of 'a', 'b', 'c'."
+
+
+def test_choice_suggests_single_close_match():
+    choice = click.Choice(["red", "green", "blue"])
+    message = choice.get_invalid_choice_message("gren", ctx=None)
+    assert message == (
+        "'gren' is not one of 'red', 'green', 'blue'. Did you mean 'green'?"
+    )
+
+
+def test_choice_suggests_multiple_close_matches():
+    choice = click.Choice(["start", "starts", "stark", "other"])
+    message = choice.get_invalid_choice_message("start1", ctx=None)
+    assert "(Did you mean one of: " in message
+    assert "'start'" in message
+    assert "'starts'" in message
+    assert "'other'" not in message.split("Did you mean")[1]
+
+
+def test_choice_single_choice_suggestion():
+    choice = click.Choice(["json"])
+    message = choice.get_invalid_choice_message("jsno", ctx=None)
+    assert message == "'jsno' is not 'json'. Did you mean 'json'?"
+
+
+def test_choice_no_suggestion_when_nothing_is_close():
+    choice = click.Choice(["red", "green", "blue"])
+    assert "Did you mean" not in choice.get_invalid_choice_message("zzz", ctx=None)
+
+
+def test_choice_no_suggestion_for_empty_value():
+    choice = click.Choice(["red", "green"])
+    assert "Did you mean" not in choice.get_invalid_choice_message("", ctx=None)
+
+
+def test_choice_suggestion_case_insensitive():
+    choice = click.Choice(["Red", "Green"], case_sensitive=False)
+    message = choice.get_invalid_choice_message("GREN", ctx=None)
+    # Suggestions use the same normalized form as the listed choices.
+    assert message.endswith("Did you mean 'green'?")
+
+
+def test_choice_suggestion_case_sensitive():
+    choice = click.Choice(["Red", "Green"])
+    message = choice.get_invalid_choice_message("Gren", ctx=None)
+    assert message.endswith("Did you mean 'Green'?")
+
+
+def test_choice_suggestion_with_enum_choices():
+    class Color(enum.Enum):
+        RED = "red"
+        GREEN = "green"
+
+    choice = click.Choice(Color)
+    # Enum members are matched by name, which is case-sensitive by default.
+    message = choice.get_invalid_choice_message("GREN", ctx=None)
+    assert message.endswith("Did you mean 'GREEN'?")
+
+
+def test_choice_suggestion_non_string_value():
+    choice = click.Choice(["1", "2", "3"])
+    message = choice.get_invalid_choice_message(11, ctx=None)
+    assert message.startswith("11 is not one of '1', '2', '3'.")
+
+
+def test_choice_suggestion_in_cli_error():
+    @click.command()
+    @click.option("--color", type=click.Choice(["red", "green", "blue"]))
+    def cli(color):
+        pass
+
+    result = CliRunner().invoke(cli, ["--color", "gren"])
+    assert result.exit_code == 2
+    assert (
+        "Invalid value for '--color': 'gren' is not one of 'red', 'green', 'blue'."
+        " Did you mean 'green'?"
+    ) in result.stderr
+
+
+@pytest.mark.parametrize("value", ["zzz", "yellow"])
+def test_choice_no_suggestion_in_cli_error(value):
+    @click.command()
+    @click.option("--color", type=click.Choice(["red", "green", "blue"]))
+    def cli(color):
+        pass
+
+    result = CliRunner().invoke(cli, ["--color", value])
+    assert result.exit_code == 2
+    assert "Did you mean" not in result.stderr
