index 0000000..0a1de79
--- /dev/null
+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,114 @@
+"""Import expense rows from bank CSV exports (standard library only)."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"(?P<neg>-)?[¥￥]?(?P<num>[0-9][0-9,]*)円?")
+_DATE_RE = re.compile(
+    r"(?P<y>[0-9]{4})(?P<sep>[/-])(?P<m>[0-9]{1,2})(?P=sep)(?P<d>[0-9]{1,2})"
+)
+
+
+def parse_amount(s: str) -> int:
+    """Parse a bank amount such as ``" ￥1,234 "`` or ``"-300円"`` into yen."""
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額として解釈できません: {s!r}")
+    value = int(m.group("num").replace(",", ""))
+    return -value if m.group("neg") else value
+
+
+def parse_date(s: str) -> date:
+    """Parse ``YYYY/M/D`` or ``YYYY-M-D`` (separator must not be mixed)."""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付として解釈できません: {s!r}")
+    try:
+        return date(int(m.group("y")), int(m.group("m")), int(m.group("d")))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def _is_blank(row: list[str]) -> bool:
+    return not any(cell.strip() for cell in row)
+
+
+def _cell(row: list[str], index: dict[str, int], key: str) -> str:
+    i = index[key]
+    return row[i] if i < len(row) else ""
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Convert bank CSV text (header on line 1) into expenses.
+
+    Returns ``(expenses in input order, [(physical line number, field), ...])``.
+    Rows with any error are excluded from the expenses.
+    """
+    if mapping is None:
+        mapping = DEFAULT_MAPPING
+    for key in ("date", "category", "amount"):
+        if key not in mapping:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header = next(reader, [])
+    for key, column in mapping.items():
+        if column not in header:
+            raise ValueError(f"CSV ヘッダーに列 {column!r} がありません")
+    index = {key: header.index(column) for key, column in mapping.items()}
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    line = reader.line_num
+    while True:
+        try:
+            row = next(reader)
+        except StopIteration:
+            break
+        start = line + 1
+        line = reader.line_num
+        if _is_blank(row):
+            continue
+
+        row_errors: list[tuple[int, str]] = []
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(_cell(row, index, "date"))
+        except ValueError:
+            row_errors.append((start, "date"))
+        try:
+            amount = parse_amount(_cell(row, index, "amount"))
+        except ValueError:
+            row_errors.append((start, "amount"))
+        category = _cell(row, index, "category").strip()
+        if not category:
+            row_errors.append((start, "category"))
+
+        if row_errors:
+            errors.extend(row_errors)
+            continue
+        assert day is not None and amount is not None
+        if category_map and category in category_map:
+            category = category_map[category]
+        memo = _cell(row, index, "memo").strip() if "memo" in index else ""
+        expenses.append(Expense(day=day, category=category, amount=amount, memo=memo))
+
+    return expenses, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
new file mode 100644
index 0000000..a7080fa
--- /dev/null
+++ b/src/kakeibo/monthdiff.py
@@ -0,0 +1,96 @@
+"""Month-over-month comparison of expenses by category."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from kakeibo.core import Expense
+
+_MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class DiffRow:
+    category: str
+    prev: int
+    curr: int
+    delta: int
+    pct: float | None
+    status: str
+
+
+def _check_month(month: str) -> None:
+    if not isinstance(month, str) or not _MONTH_RE.fullmatch(month):
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+
+
+def _month_of(e: Expense) -> str:
+    return e.day.strftime("%Y-%m")
+
+
+def month_diff(rows: list[Expense], prev_month: str, curr_month: str) -> list[DiffRow]:
+    _check_month(prev_month)
+    _check_month(curr_month)
+
+    prev_sum: dict[str, int] = {}
+    curr_sum: dict[str, int] = {}
+    prev_count: dict[str, int] = {}
+    curr_count: dict[str, int] = {}
+    for e in rows:
+        m = _month_of(e)
+        if m == prev_month:
+            prev_sum[e.category] = prev_sum.get(e.category, 0) + e.amount
+            prev_count[e.category] = prev_count.get(e.category, 0) + 1
+        if m == curr_month:  # prev_month == curr_month のときは両方に入る
+            curr_sum[e.category] = curr_sum.get(e.category, 0) + e.amount
+            curr_count[e.category] = curr_count.get(e.category, 0) + 1
+
+    out: list[DiffRow] = []
+    for cat in set(prev_count) | set(curr_count):
+        prev = prev_sum.get(cat, 0)
+        curr = curr_sum.get(cat, 0)
+        delta = curr - prev
+        pct: float | None = None
+        if prev != 0:
+            # -0.0 を作らない(+ 0.0 で正のゼロに寄せる)
+            pct = round(delta / prev * 100, 1) + 0.0
+        if cat not in prev_count:
+            status = "new"
+        elif cat not in curr_count:
+            status = "gone"
+        elif delta > 0:
+            status = "up"
+        elif delta < 0:
+            status = "down"
+        else:
+            status = "same"
+        out.append(DiffRow(cat, prev, curr, delta, pct, status))
+
+    out.sort(key=lambda d: (-abs(d.delta), d.category))
+    return out
+
+
+def top_movers(diffs: list[DiffRow], n: int = 3) -> list[DiffRow]:
+    if n < 0:
+        raise ValueError(f"n は 0 以上である必要があります: {n}")
+    return [d for d in diffs if d.status != "same"][:n]
+
+
+def render_diff(diffs: list[DiffRow]) -> str:
+    lines = ["category\tprev\tcurr\tdelta\tpct"]
+    for d in diffs:
+        pct = "-" if d.pct is None else f"{d.pct + 0.0:+.1f}%"  # -0.0 は +0.0 と表示
+        lines.append(f"{d.category}\t{d.prev}\t{d.curr}\t{d.delta:+d}\t{pct}")
+    return "\n".join(lines)
+
+
+def available_months(rows: list[Expense]) -> list[str]:
+    return sorted({_month_of(e) for e in rows})
+
+
+def latest_diff(rows: list[Expense]) -> list[DiffRow]:
+    months = available_months(rows)
+    if len(months) < 2:
+        raise ValueError("前月比には 2 か月以上の明細が必要です")
+    return month_diff(rows, months[-2], months[-1])
diff --git a/src/kakeibo/query.py b/src/kakeibo/query.py
new file mode 100644
index 0000000..b1e9aa4
--- /dev/null
+++ b/src/kakeibo/query.py
@@ -0,0 +1,158 @@
+"""Search query language for expense rows.
+
+Grammar (lowest precedence first)::
+
+    or_expr  := and_expr ("OR" and_expr)*
+    and_expr := not_expr (["AND"] not_expr)*
+    not_expr := "NOT" not_expr | primary
+    primary  := TERM | CAT | "(" or_expr ")"
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+
+from kakeibo.core import Expense
+
+Pred = Callable[[Expense], bool]
+Token = tuple[str, str]
+
+
+class QueryError(ValueError):
+    """Raised when a search query cannot be tokenized or parsed."""
+
+
+def tokenize(q: str) -> list[tuple[str, str]]:
+    out: list[Token] = []
+    i = 0
+    n = len(q)
+    while i < n:
+        c = q[i]
+        if c.isspace():
+            i += 1
+        elif c == "(":
+            out.append(("LPAREN", "("))
+            i += 1
+        elif c == ")":
+            out.append(("RPAREN", ")"))
+            i += 1
+        elif c == '"':
+            end = q.find('"', i + 1)
+            if end < 0:
+                raise QueryError("引用符が閉じられていません")
+            body = q[i + 1 : end]
+            if body == "":
+                raise QueryError("空の引用符は使えません")
+            out.append(("TERM", body))
+            i = end + 1
+        else:
+            j = i
+            while j < n and not (q[j].isspace() or q[j] in '()"'):
+                j += 1
+            word = q[i:j]
+            i = j
+            if word == "AND":
+                out.append(("AND", "AND"))
+            elif word == "OR":
+                out.append(("OR", "OR"))
+            elif word == "NOT":
+                out.append(("NOT", "NOT"))
+            elif word.startswith("cat:"):
+                value = word[len("cat:") :]
+                if value == "":
+                    raise QueryError("cat: の後ろが空です")
+                out.append(("CAT", value))
+            else:
+                out.append(("TERM", word))
+    return out
+
+
+def _and(a: Pred, b: Pred) -> Pred:
+    return lambda e: a(e) and b(e)
+
+
+def _or(a: Pred, b: Pred) -> Pred:
+    return lambda e: a(e) or b(e)
+
+
+def _not(a: Pred) -> Pred:
+    return lambda e: not a(e)
+
+
+class _Parser:
+    def __init__(self, tokens: list[Token]) -> None:
+        self.tokens = tokens
+        self.pos = 0
+
+    def _peek(self) -> str | None:
+        return self.tokens[self.pos][0] if self.pos < len(self.tokens) else None
+
+    def _take(self) -> Token:
+        tok = self.tokens[self.pos]
+        self.pos += 1
+        return tok
+
+    def or_expr(self) -> Pred:
+        left = self.and_expr()
+        while self._peek() == "OR":
+            self._take()
+            left = _or(left, self.and_expr())
+        return left
+
+    def and_expr(self) -> Pred:
+        left = self.not_expr()
+        while True:
+            kind = self._peek()
+            if kind == "AND":
+                self._take()
+            elif kind not in ("NOT", "TERM", "CAT", "LPAREN"):
+                break
+            left = _and(left, self.not_expr())
+        return left
+
+    def not_expr(self) -> Pred:
+        if self._peek() == "NOT":
+            self._take()
+            return _not(self.not_expr())
+        return self.primary()
+
+    def primary(self) -> Pred:
+        kind = self._peek()
+        if kind == "TERM":
+            needle = self._take()[1].casefold()
+            return lambda e: (
+                needle in e.memo.casefold() or needle in e.category.casefold()
+            )
+        if kind == "CAT":
+            name = self._take()[1].casefold()
+            return lambda e: name == e.category.casefold()
+        if kind == "LPAREN":
+            self._take()
+            inner = self.or_expr()
+            if self._peek() != "RPAREN":
+                raise QueryError("括弧が閉じられていません")
+            self._take()
+            return inner
+        if kind is None:
+            raise QueryError("項がありません")
+        raise QueryError(f"予期しないトークンです: {self.tokens[self.pos][1]!r}")
+
+
+def _parse(q: str) -> Pred:
+    tokens = tokenize(q)
+    if not tokens:
+        raise QueryError("検索条件が空です")
+    parser = _Parser(tokens)
+    pred = parser.or_expr()
+    if parser.pos != len(tokens):
+        raise QueryError(f"余分なトークンがあります: {tokens[parser.pos][1]!r}")
+    return pred
+
+
+def matches(q: str, e: Expense) -> bool:
+    return _parse(q)(e)
+
+
+def filter_rows(q: str, rows: list[Expense]) -> list[Expense]:
+    pred = _parse(q)
+    return [e for e in rows if pred(e)]
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..3e32385
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,73 @@
+"""Detect recurring (monthly) expenses."""
+
+from __future__ import annotations
+
+import calendar
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def add_month(d: date) -> date:
+    """Return the same day of the next month, clamped to that month's last day."""
+    if d.month == 12:
+        year, month = d.year + 1, 1
+    else:
+        year, month = d.year, d.month + 1
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(d.day, last))
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    amount: int
+    days: tuple[date, ...]
+    next_expected: date
+
+
+def find_recurring(
+    rows: list[Expense], min_count: int = 3, tolerance: int = 3
+) -> list[Recurring]:
+    """Find monthly-recurring (category, amount) series.
+
+    Dates are grouped by (category, amount) with memo ignored. Within a group,
+    adjacent dates d_i < d_{i+1} are linked when d_{i+1} is within `tolerance`
+    days of add_month(d_i). Maximal linked runs of at least `min_count` dates
+    each yield one Recurring.
+    """
+    if min_count < 2:
+        raise ValueError(f"min_count は 2 以上である必要があります: {min_count}")
+    if tolerance < 0:
+        raise ValueError(f"tolerance は 0 以上である必要があります: {tolerance}")
+
+    groups: dict[tuple[str, int], set[date]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.amount), set()).add(e.day)
+
+    out: list[Recurring] = []
+    for (category, amount), day_set in groups.items():
+        days = sorted(day_set)
+        runs: list[list[date]] = []
+        current = [days[0]]
+        for nxt in days[1:]:
+            if abs((nxt - add_month(current[-1])).days) <= tolerance:
+                current.append(nxt)
+            else:
+                runs.append(current)
+                current = [nxt]
+        runs.append(current)
+        for run in runs:
+            if len(run) >= min_count:
+                out.append(
+                    Recurring(
+                        category=category,
+                        amount=amount,
+                        days=tuple(run),
+                        next_expected=add_month(run[-1]),
+                    )
+                )
+
+    out.sort(key=lambda r: (r.category, r.amount, r.days[0]))
+    return out
diff --git a/tests/test_bankimport.py b/tests/test_bankimport.py
new file mode 100644
index 0000000..b1d379e
--- /dev/null
+++ b/tests/test_bankimport.py
@@ -0,0 +1,239 @@
+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.bankimport import DEFAULT_MAPPING, import_rows, parse_amount, parse_date
+from kakeibo.core import Expense
+
+HEADER = "利用日,分類,利用金額,利用店名"
+
+
+# --- parse_amount ---------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        (" ￥1,234,567 ", 1234567),
+        ("-¥300", -300),
+        ("980円", 980),
+        ("0", 0),
+        ("¥0", 0),
+        ("-0", 0),
+        ("1,,2", 12),  # comma positions are not checked
+        ("1,000円", 1000),
+        ("-1,000円", -1000),
+        ("12345", 12345),
+    ],
+)
+def test_parse_amount_accepts(text: str, expected: int) -> None:
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "   ",
+        "円",
+        "12.5",
+        "1 200",
+        "--5",
+        "¥-5",
+        "１２３",
+        ",5",
+        "5円円",
+        "円5",
+        "¥¥5",
+        "5¥",
+        "-円",
+        "-",
+        "¥",
+        "1,000 円",
+    ],
+)
+def test_parse_amount_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_amount(text)
+
+
+# --- parse_date -----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("2026/1/5", date(2026, 1, 5)),
+        ("2026-01-05", date(2026, 1, 5)),
+        (" 2026/1/5 ", date(2026, 1, 5)),
+        ("2026-1-5", date(2026, 1, 5)),
+        ("2026/12/31", date(2026, 12, 31)),
+        ("2024/02/29", date(2024, 2, 29)),
+    ],
+)
+def test_parse_date_accepts(text: str, expected: date) -> None:
+    assert parse_date(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "2026/1-5",
+        "2026-1/5",
+        "26/1/5",
+        "2026/02/30",
+        "2026/02/29",
+        "2026/13/1",
+        "2026/0/1",
+        "2026/1/5/",
+        "２０２６/1/5",
+        "2026.1.5",
+        "2026//1",
+        "2026/1/123",
+    ],
+)
+def test_parse_date_rejects(text: str) -> None:
+    with pytest.raises(ValueError):
+        parse_date(text)
+
+
+# --- import_rows ----------------------------------------------------------
+
+
+def test_default_mapping_values() -> None:
+    assert DEFAULT_MAPPING == {
+        "date": "利用日",
+        "category": "分類",
+        "amount": "利用金額",
+        "memo": "利用店名",
+    }
+
+
+def test_import_basic_keeps_input_order_and_no_errors() -> None:
+    text = (
+        "利用日,分類,利用金額,利用店名\n"
+        '2026/1/5,食費,"￥1,200",カフェ\n'
+        "2026-01-06,交通,-300円,駅\n"
+    )
+    expenses, errors = import_rows(text)
+    assert errors == []
+    assert expenses == [
+        Expense(date(2026, 1, 5), "食費", 1200, "カフェ"),
+        Expense(date(2026, 1, 6), "交通", -300, "駅"),
+    ]
+
+
+def test_quoted_comma_in_memo_and_extra_columns_ignored() -> None:
+    text = (
+        'extra,利用日,分類,利用金額,利用店名,more\nx,2026/1/5,食費,500,"A店, 本店",y\n'
+    )
+    expenses, errors = import_rows(text)
+    assert errors == []
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 500, "A店, 本店")]
+
+
+def test_blank_lines_are_skipped_but_counted() -> None:
+    text = f"{HEADER}\n\n2026/1/5,食費,100,a\n\n   \n2026/1/6,食費,oops,b\n"
+    expenses, errors = import_rows(text)
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "a")]
+    assert errors == [(6, "amount")]
+
+
+def test_errors_recorded_in_order_date_amount_category() -> None:
+    text = f"{HEADER}\nbad,,xx,m\n"
+    expenses, errors = import_rows(text)
+    assert expenses == []
+    assert errors == [(2, "date"), (2, "amount"), (2, "category")]
+
+
+def test_category_only_whitespace_is_error() -> None:
+    text = f"{HEADER}\n2026/1/5,   ,100,m\n"
+    expenses, errors = import_rows(text)
+    assert expenses == []
+    assert errors == [(2, "category")]
+
+
+def test_error_row_excluded_and_others_kept() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,100,a\n2026/1/6,食費,1.5,b\n2026/1/7,食費,7,c\n"
+    expenses, errors = import_rows(text)
+    assert [e.memo for e in expenses] == ["a", "c"]
+    assert errors == [(3, "amount")]
+
+
+def test_short_row_missing_values_are_empty_strings() -> None:
+    text = f"{HEADER}\n2026/1/5\n"
+    expenses, errors = import_rows(text)
+    assert expenses == []
+    assert errors == [(2, "amount"), (2, "category")]
+
+
+def test_short_row_missing_memo_is_empty_memo() -> None:
+    text = "利用日,分類,利用金額,利用店名\n2026/1/5,食費,100\n"
+    expenses, errors = import_rows(text)
+    assert errors == []
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+def test_custom_mapping_without_memo() -> None:
+    text = "d,c,a\n2026/1/5, 食費 ,100\n"
+    mapping = {"date": "d", "category": "c", "amount": "a"}
+    expenses, errors = import_rows(text, mapping)
+    assert errors == []
+    assert expenses == [Expense(date(2026, 1, 5), "食費", 100, "")]
+
+
+def test_mapping_missing_required_key_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows(f"{HEADER}\n", {"date": "利用日", "amount": "利用金額"})
+
+
+def test_mapping_memo_key_missing_is_fine() -> None:
+    text = "d,c,a\n2026/1/5,食費,100\n"
+    expenses, errors = import_rows(text, {"date": "d", "category": "c", "amount": "a"})
+    assert errors == []
+    assert len(expenses) == 1
+
+
+def test_mapping_column_absent_from_header_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows(
+            "d,c,a\n2026/1/5,食費,100\n", {"date": "d", "category": "c", "amount": "zz"}
+        )
+
+
+def test_mapping_memo_column_absent_from_header_raises() -> None:
+    with pytest.raises(ValueError):
+        import_rows(
+            "利用日,分類,利用金額\n2026/1/5,食費,100\n",
+            {
+                "date": "利用日",
+                "category": "分類",
+                "amount": "利用金額",
+                "memo": "利用店名",
+            },
+        )
+
+
+def test_category_stripped_and_mapped() -> None:
+    text = f"{HEADER}\n2026/1/5, 外食 ,100,m\n2026/1/6,交通,200,n\n"
+    expenses, errors = import_rows(text, category_map={"外食": "食費"})
+    assert errors == []
+    assert [e.category for e in expenses] == ["食費", "交通"]
+
+
+def test_memo_stripped() -> None:
+    text = f"{HEADER}\n2026/1/5,食費,100,  カフェ  \n"
+    expenses, _ = import_rows(text)
+    assert expenses[0].memo == "カフェ"
+
+
+def test_empty_text_raises_missing_columns() -> None:
+    with pytest.raises(ValueError):
+        import_rows("")
+
+
+def test_header_only_returns_nothing() -> None:
+    assert import_rows(f"{HEADER}\n") == ([], [])
diff --git a/tests/test_monthdiff.py b/tests/test_monthdiff.py
new file mode 100644
index 0000000..7e00c3e
--- /dev/null
+++ b/tests/test_monthdiff.py
@@ -0,0 +1,263 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.monthdiff import (
+    DiffRow,
+    available_months,
+    latest_diff,
+    month_diff,
+    render_diff,
+    top_movers,
+)
+
+
+def E(y, m, d, cat, amount):
+    return Expense(date(y, m, d), cat, amount)
+
+
+ROWS = [
+    E(2026, 10, 1, "food", 1000),
+    E(2026, 10, 2, "food", 500),
+    E(2026, 10, 3, "rent", 80000),
+    E(2026, 10, 4, "misc", 300),
+    E(2026, 11, 1, "food", 1500),
+    E(2026, 11, 2, "rent", 80000),
+    E(2026, 11, 3, "fun", 2000),
+    E(2026, 9, 1, "old", 999),  # outside both months
+]
+
+
+def _by_cat(diffs):
+    return {d.category: d for d in diffs}
+
+
+# --- DiffRow ---------------------------------------------------------------
+
+
+def test_diffrow_fields_order_and_frozen():
+    r = DiffRow("food", 1, 2, 1, 100.0, "up")
+    assert (r.category, r.prev, r.curr, r.delta, r.pct, r.status) == (
+        "food",
+        1,
+        2,
+        1,
+        100.0,
+        "up",
+    )
+    with pytest.raises(AttributeError):
+        r.prev = 5  # type: ignore[misc]
+
+
+# --- month_diff: month format ----------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        "2026-1",
+        "2026-13",
+        "2026-00",
+        "2026/11",
+        "26-11",
+        "2026-11\n",
+        " 2026-11",
+        "２０２６-11",
+        "",
+        "202611",
+    ],
+)
+def test_month_diff_rejects_bad_month(bad):
+    with pytest.raises(ValueError):
+        month_diff(ROWS, bad, "2026-11")
+    with pytest.raises(ValueError):
+        month_diff(ROWS, "2026-10", bad)
+
+
+def test_month_diff_accepts_01_and_12():
+    out = month_diff(
+        [E(2026, 1, 1, "a", 1), E(2026, 12, 1, "a", 2)], "2026-01", "2026-12"
+    )
+    assert _by_cat(out)["a"].delta == 1
+
+
+# --- month_diff: values -----------------------------------------------------
+
+
+def test_month_diff_values_and_only_listed_categories():
+    out = _by_cat(month_diff(ROWS, "2026-10", "2026-11"))
+    assert set(out) == {"food", "rent", "misc", "fun"}  # "old" (2026-09) excluded
+    assert out["food"] == DiffRow("food", 1500, 1500, 0, 0.0, "same")
+    assert out["rent"] == DiffRow("rent", 80000, 80000, 0, 0.0, "same")
+    assert out["misc"] == DiffRow("misc", 300, 0, -300, -100.0, "gone")
+    assert out["fun"] == DiffRow("fun", 0, 2000, 2000, None, "new")
+
+
+def test_month_diff_up_down_and_pct_rounding():
+    rows = [
+        E(2026, 10, 1, "a", 300),
+        E(2026, 11, 1, "a", 400),  # +100, 33.3%
+        E(2026, 10, 1, "b", 3000),
+        E(2026, 11, 1, "b", 2000),  # -1000, -33.3%
+    ]
+    out = _by_cat(month_diff(rows, "2026-10", "2026-11"))
+    assert out["a"] == DiffRow("a", 300, 400, 100, 33.3, "up")
+    assert out["b"] == DiffRow("b", 3000, 2000, -1000, -33.3, "down")
+
+
+def test_month_diff_pct_none_when_prev_zero_but_present():
+    # prev に明細はあるが合計 0: status は new ではなく up、pct は None
+    rows = [E(2026, 10, 1, "a", 0), E(2026, 11, 1, "a", 500)]
+    r = _by_cat(month_diff(rows, "2026-10", "2026-11"))["a"]
+    assert r == DiffRow("a", 0, 500, 500, None, "up")
+
+
+def test_month_diff_status_by_presence_not_sum():
+    # curr に明細はあるが合計 0 -> gone ではなく same(delta 0)
+    rows = [E(2026, 10, 1, "a", 700), E(2026, 11, 1, "a", 0)]
+    r = _by_cat(month_diff(rows, "2026-10", "2026-11"))["a"]
+    assert r == DiffRow("a", 700, 0, -700, -100.0, "down")
+    rows2 = [E(2026, 10, 1, "a", 0), E(2026, 11, 1, "a", 0)]
+    r2 = _by_cat(month_diff(rows2, "2026-10", "2026-11"))["a"]
+    assert r2 == DiffRow("a", 0, 0, 0, None, "same")
+
+
+def test_month_diff_gone_status():
+    rows = [E(2026, 10, 1, "a", 100)]
+    r = month_diff(rows, "2026-10", "2026-11")[0]
+    assert r == DiffRow("a", 100, 0, -100, -100.0, "gone")
+
+
+def test_month_diff_same_month_twice():
+    out = month_diff(ROWS, "2026-11", "2026-11")
+    assert all(d.delta == 0 and d.status == "same" for d in out)
+
+
+def test_month_diff_empty_rows():
+    assert month_diff([], "2026-10", "2026-11") == []
+
+
+def test_month_diff_sort_abs_delta_desc_then_category_asc():
+    rows = [
+        E(2026, 10, 1, "b", 100),
+        E(2026, 11, 1, "b", 150),  # +50
+        E(2026, 10, 1, "a", 1000),
+        E(2026, 11, 1, "a", 950),  # -50
+        E(2026, 11, 1, "c", 200),  # +200 (new)
+        E(2026, 10, 1, "d", 0),
+        E(2026, 11, 1, "d", 0),  # 0
+    ]
+    cats = [d.category for d in month_diff(rows, "2026-10", "2026-11")]
+    assert cats == ["c", "a", "b", "d"]
+
+
+# --- top_movers -------------------------------------------------------------
+
+
+def test_top_movers_excludes_same_and_keeps_order():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    got = top_movers(diffs)
+    assert all(d.status != "same" for d in got)
+    assert [d.category for d in got] == [
+        d.category for d in diffs if d.status != "same"
+    ][:3]
+    assert [d.category for d in got] == ["fun", "misc"]  # food/rent は same なので除外
+
+
+def test_top_movers_n_zero_and_large():
+    diffs = month_diff(ROWS, "2026-10", "2026-11")
+    assert top_movers(diffs, 0) == []
+    assert top_movers(diffs, 100) == [d for d in diffs if d.status != "same"]
+    assert top_movers(diffs, 1) == [d for d in diffs if d.status != "same"][:1]
+
+
+def test_top_movers_default_is_3():
+    diffs = [DiffRow(c, 0, 1, 1, None, "new") for c in "abcde"]
+    assert len(top_movers(diffs)) == 3
+
+
+def test_top_movers_negative_n_raises():
+    with pytest.raises(ValueError):
+        top_movers([], -1)
+
+
+def test_top_movers_empty_and_all_same():
+    assert top_movers([]) == []
+    same = [DiffRow("a", 1, 1, 0, 0.0, "same")]
+    assert top_movers(same) == []
+
+
+# --- render_diff ------------------------------------------------------------
+
+
+def test_render_diff_format():
+    diffs = [
+        DiffRow("fun", 0, 2000, 2000, None, "new"),
+        DiffRow("misc", 300, 0, -300, -100.0, "gone"),
+        DiffRow("food", 1000, 1200, 200, 20.0, "up"),
+        DiffRow("zero", 5, 5, 0, 0.0, "same"),
+        DiffRow("neg", 3000, 2000, -1000, -33.3, "down"),
+    ]
+    assert render_diff(diffs) == (
+        "category\tprev\tcurr\tdelta\tpct\n"
+        "fun\t0\t2000\t+2000\t-\n"
+        "misc\t300\t0\t-300\t-100.0%\n"
+        "food\t1000\t1200\t+200\t+20.0%\n"
+        "zero\t5\t5\t+0\t+0.0%\n"
+        "neg\t3000\t2000\t-1000\t-33.3%"
+    )
+
+
+def test_render_diff_no_trailing_newline_and_header_only():
+    out = render_diff([])
+    assert out == "category\tprev\tcurr\tdelta\tpct"
+    assert not out.endswith("\n")
+
+
+def test_render_diff_negative_zero_pct_is_plus_zero():
+    # 極小の負の変化率を丸めると -0.0 になるが、表示は "+0.0%" に統一する
+    d = DiffRow("a", 100000000, 99999999, -1, -0.0, "down")
+    assert render_diff([d]).splitlines()[1].split("\t")[4] == "+0.0%"
+
+
+def test_month_diff_tiny_negative_pct_is_not_negative_zero():
+    rows = [E(2026, 10, 1, "a", 100000000), E(2026, 11, 1, "a", 99999999)]
+    r = _by_cat(month_diff(rows, "2026-10", "2026-11"))["a"]
+    assert r.pct == 0.0 and str(r.pct) == "0.0"
+
+
+# --- available_months -------------------------------------------------------
+
+
+def test_available_months_sorted_unique():
+    assert available_months(ROWS) == ["2026-09", "2026-10", "2026-11"]
+
+
+def test_available_months_empty():
+    assert available_months([]) == []
+
+
+def test_available_months_across_years():
+    rows = [E(2027, 1, 1, "a", 1), E(2026, 12, 31, "a", 1), E(2026, 12, 1, "b", 1)]
+    assert available_months(rows) == ["2026-12", "2027-01"]
+
+
+# --- latest_diff ------------------------------------------------------------
+
+
+def test_latest_diff_uses_last_two_months():
+    assert latest_diff(ROWS) == month_diff(ROWS, "2026-10", "2026-11")
+
+
+def test_latest_diff_fewer_than_two_months_raises():
+    with pytest.raises(ValueError):
+        latest_diff([])
+    with pytest.raises(ValueError):
+        latest_diff([E(2026, 10, 1, "a", 1), E(2026, 10, 2, "b", 2)])
+
+
+def test_latest_diff_three_months_uses_last_two():
+    rows = [E(2026, 9, 1, "a", 9999), E(2026, 10, 1, "a", 1), E(2026, 11, 1, "a", 3)]
+    r = latest_diff(rows)
+    assert r == [DiffRow("a", 1, 3, 2, 200.0, "up")]
diff --git a/tests/test_query.py b/tests/test_query.py
new file mode 100644
index 0000000..d0e4fee
--- /dev/null
+++ b/tests/test_query.py
@@ -0,0 +1,237 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def _e(
+    category: str, memo: str = "", amount: int = 100, day: date = date(2026, 11, 1)
+) -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- tokenize ---------------------------------------------------------------
+
+
+def test_tokenize_whitespace_only_separates():
+    assert tokenize("  a \t b  ") == [("TERM", "a"), ("TERM", "b")]
+
+
+def test_tokenize_blank_gives_no_tokens():
+    assert tokenize("   ") == []
+    assert tokenize("") == []
+
+
+def test_tokenize_parens():
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+
+
+def test_tokenize_quote_keeps_spaces_and_parens():
+    assert tokenize('"a b (c)"') == [("TERM", "a b (c)")]
+
+
+def test_tokenize_quote_has_no_escape():
+    assert tokenize('"a\\"') == [("TERM", "a\\")]
+
+
+def test_tokenize_whitespace_only_quote_is_term():
+    assert tokenize('" "') == [("TERM", " ")]
+
+
+def test_tokenize_unclosed_quote_raises():
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+
+
+def test_tokenize_empty_quote_raises():
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_bare_word_ends_at_quote():
+    assert tokenize('a"b c"') == [("TERM", "a"), ("TERM", "b c")]
+
+
+def test_tokenize_operators_exact_uppercase_only():
+    assert tokenize("AND OR NOT") == [("AND", "AND"), ("OR", "OR"), ("NOT", "NOT")]
+    assert tokenize("and or not ANDx") == [
+        ("TERM", "and"),
+        ("TERM", "or"),
+        ("TERM", "not"),
+        ("TERM", "ANDx"),
+    ]
+
+
+def test_tokenize_quoted_operator_is_term():
+    assert tokenize('"AND"') == [("TERM", "AND")]
+
+
+def test_tokenize_cat_prefix():
+    assert tokenize("cat:food") == [("CAT", "food")]
+    assert tokenize("cat:a:b") == [("CAT", "a:b")]
+
+
+def test_tokenize_cat_prefix_is_case_sensitive():
+    assert tokenize("CAT:food") == [("TERM", "CAT:food")]
+
+
+def test_tokenize_empty_cat_raises():
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_tokenize_cat_with_quote_raises():
+    with pytest.raises(QueryError):
+        tokenize('cat:"food"')
+
+
+# --- parse errors -----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "q",
+    [
+        "",
+        "   ",
+        "()",
+        "(a",
+        "a)",
+        "a OR",
+        "OR a",
+        "a AND",
+        "AND a",
+        "a AND AND b",
+        "a OR OR b",
+        "NOT",
+        "a NOT",
+        ")",
+    ],
+)
+def test_invalid_query_raises(q):
+    with pytest.raises(QueryError):
+        matches(q, _e("food"))
+
+
+# --- evaluation -------------------------------------------------------------
+
+
+def test_term_matches_memo_substring():
+    assert matches("lun", _e("food", memo="lunch"))
+
+
+def test_term_matches_category_substring():
+    assert matches("foo", _e("food", memo=""))
+
+
+def test_term_does_not_match_amount_or_date():
+    e = _e("rent", memo="", amount=1200, day=date(2026, 11, 5))
+    assert not matches("1200", e)
+    assert not matches("2026", e)
+
+
+def test_term_empty_memo_does_not_match():
+    assert not matches("x", _e("food", memo=""))
+
+
+def test_term_is_case_insensitive():
+    assert matches("LUNCH", _e("food", memo="lunch"))
+    assert matches("lunch", _e("food", memo="LUNCH"))
+
+
+def test_term_uses_casefold_not_lower():
+    assert matches("straße", _e("food", memo="STRASSE"))
+
+
+def test_cat_exact_match_only():
+    assert matches("cat:food", _e("food"))
+    assert not matches("cat:foo", _e("food"))
+    assert not matches("cat:foods", _e("food"))
+
+
+def test_cat_is_case_insensitive():
+    assert matches("cat:Food", _e("food"))
+
+
+def test_cat_does_not_match_memo():
+    assert not matches("cat:food", _e("rent", memo="food"))
+
+
+def test_and_is_implicit_and_explicit():
+    e = _e("food", memo="lunch")
+    assert matches("lunch food", e)
+    assert matches("lunch AND food", e)
+    assert not matches("lunch rent", e)
+
+
+def test_or():
+    e = _e("food", memo="lunch")
+    assert matches("rent OR lunch", e)
+    assert not matches("rent OR coffee", e)
+
+
+def test_not_binds_tighter_than_and():
+    e = _e("food", memo="lunch")
+    # (NOT rent) AND lunch
+    assert matches("NOT rent lunch", e)
+    assert not matches("NOT food lunch", e)
+
+
+def test_and_binds_tighter_than_or():
+    e = _e("rent", memo="b")
+    # a OR (b AND c)
+    assert matches("a OR b c", _e("x", memo="a"))
+    assert not matches("a OR b c", e)
+    assert matches("b AND rent OR zzz", e)
+
+
+def test_parens_override_precedence():
+    e = _e("rent", memo="b")
+    assert matches("(a OR b) rent", e)
+    assert not matches("(a OR b) food", e)
+
+
+def test_double_not():
+    assert matches("NOT NOT food", _e("food"))
+    assert not matches("NOT food", _e("food"))
+
+
+def test_not_applies_to_parenthesized_group():
+    e = _e("food", memo="lunch")
+    assert not matches("NOT (lunch OR coffee)", e)
+    assert matches("NOT (rent OR coffee)", e)
+
+
+def test_quoted_term_with_space():
+    assert matches('"fried rice"', _e("food", memo="Fried Rice"))
+    assert not matches('"fried rice"', _e("food", memo="fried  rice"))
+
+
+# --- filter_rows ------------------------------------------------------------
+
+
+def test_filter_rows_keeps_input_order_and_duplicates():
+    a = _e("food", memo="lunch", amount=1)
+    b = _e("rent", memo="", amount=2)
+    c = _e("food", memo="lunch", amount=3)
+    d = _e("food", memo="lunch", amount=1)
+    assert filter_rows("lunch", [a, b, c, d]) == [a, c, d]
+
+
+def test_filter_rows_no_match_is_empty():
+    assert filter_rows("zzz", [_e("food", memo="lunch")]) == []
+
+
+def test_filter_rows_empty_rows_valid_query():
+    assert filter_rows("food", []) == []
+
+
+def test_filter_rows_empty_rows_invalid_query_raises():
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
+
+
+def test_filter_rows_invalid_query_raises_with_rows():
+    with pytest.raises(QueryError):
+        filter_rows("a OR", [_e("food")])
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..2f30e77
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,209 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def e(day: date, category: str = "食費", amount: int = 1000, memo: str = "") -> Expense:
+    return Expense(day=day, category=category, amount=amount, memo=memo)
+
+
+# --- add_month ---
+
+
+@pytest.mark.parametrize(
+    ("src", "expected"),
+    [
+        (date(2026, 1, 15), date(2026, 2, 15)),
+        (date(2026, 12, 15), date(2027, 1, 15)),
+        (date(2026, 1, 31), date(2026, 2, 28)),
+        (date(2024, 1, 31), date(2024, 2, 29)),
+        (date(2024, 2, 29), date(2024, 3, 29)),
+        (date(2026, 3, 31), date(2026, 4, 30)),
+    ],
+)
+def test_add_month(src: date, expected: date) -> None:
+    assert add_month(src) == expected
+
+
+# --- find_recurring: argument validation ---
+
+
+def test_min_count_below_two_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+
+
+def test_negative_tolerance_raises() -> None:
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_zero_tolerance_is_allowed() -> None:
+    rows = [e(date(2026, 1, 10)), e(date(2026, 2, 10)), e(date(2026, 3, 10))]
+    assert len(find_recurring(rows, tolerance=0)) == 1
+
+
+# --- find_recurring: basic behavior ---
+
+
+def test_empty_input_returns_empty() -> None:
+    assert find_recurring([]) == []
+
+
+def test_monthly_series_detected() -> None:
+    rows = [e(date(2026, 1, 10)), e(date(2026, 2, 10)), e(date(2026, 3, 10))]
+    assert find_recurring(rows) == [
+        Recurring(
+            category="食費",
+            amount=1000,
+            days=(date(2026, 1, 10), date(2026, 2, 10), date(2026, 3, 10)),
+            next_expected=date(2026, 4, 10),
+        )
+    ]
+
+
+def test_below_min_count_not_reported() -> None:
+    rows = [e(date(2026, 1, 10)), e(date(2026, 2, 10))]
+    assert find_recurring(rows) == []
+
+
+def test_exactly_min_count_reported() -> None:
