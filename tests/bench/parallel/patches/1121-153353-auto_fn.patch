new file mode 100644
index 0000000..990f4c8
--- /dev/null
+++ b/tests/test__query_tree.py
@@ -0,0 +1,62 @@
+import pytest
+
+from kakeibo._query_tree import evaluate
+
+
+def leaf_from(truth: dict[str, bool], calls: list[str] | None = None):
+    def f(key: str, value: object) -> bool:
+        if calls is not None:
+            calls.append(key)
+        return truth[key]
+
+    return f
+
+
+def test_empty_and_or() -> None:
+    assert evaluate({"and": []}, leaf_from({})) is True
+    assert evaluate({"or": []}, leaf_from({})) is False
+
+
+def test_nested() -> None:
+    q = {"not": {"or": [{"a": 1}, {"b": 2}]}}
+    assert evaluate(q, leaf_from({"a": False, "b": False})) is True
+    assert evaluate(q, leaf_from({"a": False, "b": True})) is False
+    q2 = {"and": [{"a": 1}, {"or": [{"b": 1}, {"not": {"c": 1}}]}]}
+    assert evaluate(q2, leaf_from({"a": True, "b": False, "c": False})) is True
+
+
+def test_short_circuit() -> None:
+    calls: list[str] = []
+    assert (
+        evaluate(
+            {"and": [{"a": 1}, {"b": 1}]}, leaf_from({"a": False, "b": True}, calls)
+        )
+        is False
+    )
+    assert calls == ["a"]
+    calls.clear()
+    assert (
+        evaluate(
+            {"or": [{"a": 1}, {"b": 1}]}, leaf_from({"a": True, "b": False}, calls)
+        )
+        is True
+    )
+    assert calls == ["a"]
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        {"a": 1, "b": 2},
+        {},
+        [],
+        "x",
+        {"and": {"a": 1}},
+        {"or": "x"},
+        {"not": [{"a": 1}]},
+        {"and": [1]},
+    ],
+)
+def test_invalid(bad: object) -> None:
+    with pytest.raises(ValueError):
+        evaluate(bad, leaf_from({"a": True, "b": True}))
