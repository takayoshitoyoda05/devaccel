diff --git a/src/kakeibo/_amount_parse.py b/src/kakeibo/_amount_parse.py
new file mode 100644
index 0000000..39de934
--- /dev/null
+++ b/src/kakeibo/_amount_parse.py
@@ -0,0 +1,40 @@
+"""金額の文字列を円の整数にする。
+
+D4: 負は先頭の `-` `−` `△` `▲`、`(500)`、後置の `500-`。`¥` `￥` `円` `JPY` と桁区切りは無視。
+全角は NFKC。小数・空欄・`-` だけ・符号の重複は ValueError。
+"""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+
+_NEG_PREFIX = ("-", "−", "△", "▲")
+_DIGITS = re.compile(r"[0-9]+(,[0-9]+)*")
+
+
+def parse_amount(s: str) -> int:
+    if not isinstance(s, str):
+        raise TypeError("s は str である必要があります")
+    # NFKC で ▲ は変わらないが − (U+2212) は変わらないため、先に符号を統一する。
+    t = unicodedata.normalize("NFKC", s).replace("　", " ").strip()
+    t = t.replace("−", "-").replace("△", "-").replace("▲", "-")
+    negative = False
+    if t.startswith("(") and t.endswith(")"):
+        negative = True
+        t = t[1:-1].strip()
+    t = re.sub(r"^(?:JPY|¥|￥)\s*", "", t, flags=re.IGNORECASE)
+    t = re.sub(r"\s*(?:円|JPY)$", "", t, flags=re.IGNORECASE).strip()
+    if t.startswith("-"):
+        if negative:
+            raise ValueError(f"金額の符号が重複しています: {s!r}")
+        negative = True
+        t = t[1:].strip()
+    elif t.endswith("-"):
+        negative = True
+        t = t[:-1].strip()
+    t = re.sub(r"^(?:JPY|¥|￥)\s*", "", t, flags=re.IGNORECASE)
+    if not _DIGITS.fullmatch(t):
+        raise ValueError(f"金額として読めません: {s!r}")
+    value = int(t.replace(",", ""))
+    return -value if negative else value
