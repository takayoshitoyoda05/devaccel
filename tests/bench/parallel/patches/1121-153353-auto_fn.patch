@@ -0,0 +1,42 @@
+"""カテゴリ別の前月比(D6)。"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class Change:
+    category: str
+    prev: int
+    cur: int
+    delta: int
+    pct: float | None
+    kind: str  # new / gone / up / down / same
+
+
+def _check(name: str, totals: dict[str, int]) -> None:
+    for cat, yen in totals.items():
+        if isinstance(yen, bool) or not isinstance(yen, int):
+            raise TypeError(f"{name}[{cat!r}] は int である必要があります")
+
+
+def diff_totals(prev: dict[str, int], cur: dict[str, int]) -> list[Change]:
+    _check("prev", prev)
+    _check("cur", cur)
+    out: list[Change] = []
+    for cat in set(prev) | set(cur):
+        p = prev.get(cat, 0)
+        c = cur.get(cat, 0)
+        delta = c - p
+        pct = None if p == 0 else delta / p * 100
+        if delta == 0:
+            kind = "same"
+        elif p == 0 and c > 0:
+            kind = "new"
+        elif c == 0 and p > 0:
+            kind = "gone"
+        else:
+            kind = "up" if delta > 0 else "down"
+        out.append(Change(cat, p, c, delta, pct, kind))
+    return sorted(out, key=lambda ch: (-abs(ch.delta), ch.category))
