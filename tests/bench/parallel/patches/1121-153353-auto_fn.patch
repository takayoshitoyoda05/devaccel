@@ -0,0 +1,31 @@
+"""日付の文字列を date にする(D5)。"""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from datetime import date
+
+_PATTERNS = (
+    re.compile(r"(\d{4})-(\d{1,2})-(\d{1,2})"),
+    re.compile(r"(\d{4})/(\d{1,2})/(\d{1,2})"),
+    re.compile(r"(\d{4})\.(\d{1,2})\.(\d{1,2})"),
+    re.compile(r"(\d{4})(\d{2})(\d{2})"),
+    re.compile(r"(\d{4})年(\d{1,2})月(\d{1,2})日"),
+)
+_TIME = re.compile(r"[ T]\d{1,2}:\d{2}(?::\d{2})?$")
+
+
+def parse_date(s: str) -> date:
+    if not isinstance(s, str):
+        raise TypeError("s は str である必要があります")
+    t = unicodedata.normalize("NFKC", s).strip()
+    body = _TIME.sub("", t)
+    for p in _PATTERNS:
+        g = p.fullmatch(body)
+        if g:
+            try:
+                return date(int(g[1]), int(g[2]), int(g[3]))
+            except ValueError:
+                raise ValueError(f"存在しない日付です: {s!r}") from None
+    raise ValueError(f"日付として読めません: {s!r}")
