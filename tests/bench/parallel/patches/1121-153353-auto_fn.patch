new file mode 100644
index 0000000..26cca2a
--- /dev/null
+++ b/src/kakeibo/_query_tree.py
@@ -0,0 +1,27 @@
+"""検索条件の木(and / or / not / 葉)を評価する。"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+
+
+def evaluate(node: object, leaf: Callable[[str, object], bool]) -> bool:
+    if not isinstance(node, dict):
+        # 設計書 R3: 条件の誤りは全て ValueError
+        raise ValueError(f"条件は dict である必要があります: {node!r}")  # noqa: TRY004
+    if len(node) != 1:
+        raise ValueError(
+            f"条件の dict はキーをちょうど 1 つ持つ必要があります: {node!r}"
+        )
+    ((key, value),) = node.items()
+    if key in ("and", "or"):
+        if not isinstance(value, list):
+            raise ValueError(f"{key} の値は list である必要があります: {value!r}")
+        if key == "and":
+            return all(evaluate(c, leaf) for c in value)
+        return any(evaluate(c, leaf) for c in value)
+    if key == "not":
+        if not isinstance(value, dict):
+            raise ValueError(f"not の値は dict である必要があります: {value!r}")
+        return not evaluate(value, leaf)
+    return leaf(key, value)
diff --git a/src/kakeibo/_recur_detect.py b/src/kakeibo/_recur_detect.py
new file mode 100644
index 0000000..e5ebc8b
--- /dev/null
+++ b/src/kakeibo/_recur_detect.py
@@ -0,0 +1,100 @@
+"""定期支出の検出(純粋関数)。"""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_TRAIL = re.compile(r"[0-9/\-#]+$")
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo_key: str
+    amount: int
+    dates: tuple[date, ...]
+
+
+def _memo_key(memo: str) -> str:
+    s = unicodedata.normalize("NFKC", memo).casefold()
+    s = "".join(s.split())
+    return _TRAIL.sub("", s)
+
+
+def _lower_median(values: list[int]) -> int:
+    v = sorted(values)
+    return v[(len(v) - 1) // 2]
+
+
+def _within(amount: int, med: int) -> bool:
+    return abs(amount - med) * 10 <= med
+
+
+def _split_by_amount(rows: list[Expense]) -> list[list[Expense]]:
+    ordered = sorted(rows, key=lambda r: (r.amount, r.day))
+    clusters: list[list[Expense]] = []
+    for r in ordered:
+        if clusters:
+            med = _lower_median([x.amount for x in clusters[-1]])
+            if _within(r.amount, med):
+                clusters[-1].append(r)
+                continue
+        clusters.append([r])
+    return clusters
+
+
+def _month_index(d: date) -> int:
+    return d.year * 12 + d.month
+
+
+def detect_recurring(rows: list[Expense], min_months: int = 3) -> list[Recurring]:
+    if isinstance(min_months, bool) or not isinstance(min_months, int):
+        raise TypeError("min_months must be int")
+    if min_months < 2:
+        raise ValueError("min_months must be >= 2")
+    if not isinstance(rows, list):
+        raise TypeError("rows must be a list")
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for r in rows:
+        if not isinstance(r, Expense):
+            raise TypeError("rows must contain Expense")
+        if isinstance(r.amount, bool) or not isinstance(r.amount, int):
+            raise TypeError("amount must be int")
+        if r.amount <= 0:
+            continue
+        groups.setdefault((r.category, _memo_key(r.memo)), []).append(r)
+
+    result: list[Recurring] = []
+    for (category, key), members in groups.items():
+        for cluster in _split_by_amount(members):
+            by_month: dict[int, Expense] = {}
+            for r in cluster:
+                m = _month_index(r.day)
+                cur = by_month.get(m)
+                if cur is None or r.day < cur.day:
+                    by_month[m] = r
+            months = sorted(by_month)
+            run = [months[-1]]
+            for m in reversed(months[:-1]):
+                if m == run[-1] - 1:
+                    run.append(m)
+                else:
+                    break
+            if len(run) < min_months:
+                continue
+            counted = [by_month[m] for m in sorted(run)]
+            result.append(
+                Recurring(
+                    category,
+                    key,
+                    _lower_median([r.amount for r in counted]),
+                    tuple(r.day for r in counted),
+                )
+            )
+    result.sort(key=lambda x: (-x.amount, x.category, x.memo_key))
+    return result
diff --git a/src/kakeibo/_recur_next.py b/src/kakeibo/_recur_next.py
new file mode 100644
index 0000000..7e96917
--- /dev/null
+++ b/src/kakeibo/_recur_next.py
@@ -0,0 +1,35 @@
+"""定期支出の次回予測(D3)。標準ライブラリのみ。"""
+
+from __future__ import annotations
+
+import calendar
+from collections import Counter
+from datetime import date
+
+
+def _next_month(year: int, month: int) -> tuple[int, int]:
+    if month == 12:
+        return year + 1, 1
+    return year, month + 1
+
+
+def next_due(dates: list[date]) -> date:
+    """日付列から次回予定日を返す。
+
+    最後の日付の翌月を対象とし、日は全件の日の最頻値(同数なら大きいほう)。
+    その月の日数を超える場合は月末に切り詰める。
+    """
+    if not dates:
+        raise ValueError("dates must contain at least one date")
+    for i, d in enumerate(dates):
+        if not isinstance(d, date):
+            raise TypeError(f"dates[{i}] must be a date, not {type(d).__name__}")
+
+    counts = Counter(d.day for d in dates)
+    best_count = max(counts.values())
+    day = max(k for k, v in counts.items() if v == best_count)
+
+    last = max(dates)
+    year, month = _next_month(last.year, last.month)
+    last_day = calendar.monthrange(year, month)[1]
+    return date(year, month, min(day, last_day))
diff --git a/src/kakeibo/_table_split.py b/src/kakeibo/_table_split.py
new file mode 100644
index 0000000..8e29add
--- /dev/null
+++ b/src/kakeibo/_table_split.py
@@ -0,0 +1,126 @@
+"""CSV 風のテキストを、ヘッダーと「行番号・値の並び」の列に分ける純粋関数。
+
+ファイルは読まない。区切りはヘッダー行から推定する(タブのほうが多ければタブ、それ以外は `,`)。
+"""
+
+import re
+
+_BOM = "﻿"
+_TERMINATOR = re.compile(r"\r\n|\r|\n")
+
+
+def split_table(text: str) -> tuple[list[str], list[tuple[int, list[str]]]]:
+    """表のテキストを (ヘッダー, [(レコードの開始行番号, 値の並び), ...]) に分ける。
+
+    値の前後の空白は残す。列数の揃い方は検査しない。
+    空入力・空行だけは ValueError、引用符が閉じないときも ValueError(開始行番号を含む)。
+    """
+    if not isinstance(text, str):
+        raise TypeError("text は str で渡してください")
+    text = text.removeprefix(_BOM)
+    if text.strip() == "":
+        raise ValueError("入力が空です")
+
+    first, first_line = _skip_blank_lines(text, 0, 1)
+    # 区切りの推定: ヘッダー 1 レコードの引用符の外にある , と タブ の数を比べる。
+    _, seps, _, _ = _scan(text, first, ",\t", first_line)
+    delim = "\t" if seps.count("\t") > seps.count(",") else ","
+
+    header: list[str] | None = None
+    rows: list[tuple[int, list[str]]] = []
+    pos, line = 0, 1
+    while True:
+        pos, line = _skip_blank_lines(text, pos, line)
+        if pos >= len(text):
+            break
+        fields, _, pos, consumed = _scan(text, pos, delim, line)
+        if header is None:
+            header = fields
+        else:
+            rows.append((line, fields))
+        line += consumed
+
+    assert header is not None  # 空でない入力なら必ずヘッダーがある
+    return header, rows
+
+
+def _skip_blank_lines(text: str, pos: int, line: int) -> tuple[int, int]:
+    """空白だけの行を飛ばし、次のレコードの位置と行番号を返す。"""
+    n = len(text)
+    while pos < n:
+        m = _TERMINATOR.search(text, pos)
+        end = m.start() if m else n
+        if text[pos:end].strip() != "":
+            break
+        if m is None:
+            return n, line
+        pos = m.end()
+        line += 1
+    return pos, line
+
+
+def _scan(
+    text: str, pos: int, delims: str, line: int
+) -> tuple[list[str], list[str], int, int]:
+    """pos から 1 レコードを読む。
+
+    戻り値は (値の並び, 区切り文字の並び, 次のレコードの位置, 消費した改行の数)。
+    引用符は値の先頭でだけ開く。引用符の中の区切り・改行は値に含める。
+    """
+    n = len(text)
+    fields: list[str] = []
+    seps: list[str] = []
+    buf: list[str] = []
+    newlines = 0
+    i = pos
+    field_start = True
+    while True:
+        if i >= n:
+            fields.append("".join(buf))
+            return fields, seps, i, newlines
+        ch = text[i]
+        if field_start and ch == '"':
+            i, newlines = _read_quoted(text, i + 1, buf, newlines, line)
+            field_start = False
+            continue
+        if ch in delims:
+            fields.append("".join(buf))
+            buf = []
+            seps.append(ch)
+            field_start = True
+            i += 1
+            continue
+        if ch in "\r\n":
+            m = _TERMINATOR.match(text, i)
+            assert m is not None
+            fields.append("".join(buf))
+            return fields, seps, m.end(), newlines + 1
+        buf.append(ch)
+        field_start = False
+        i += 1
+
+
+def _read_quoted(
+    text: str, i: int, buf: list[str], newlines: int, line: int
+) -> tuple[int, int]:
+    """開き引用符の直後 i から値を読み、閉じ引用符の直後の位置と改行数を返す。"""
+    n = len(text)
+    while True:
+        if i >= n:
+            raise ValueError(f"引用符が閉じていません(行 {line} から)")
+        ch = text[i]
+        if ch == '"':
+            if i + 1 < n and text[i + 1] == '"':
+                buf.append('"')
+                i += 2
+                continue
+            return i + 1, newlines
+        if ch in "\r\n":
+            m = _TERMINATOR.match(text, i)
+            assert m is not None
+            buf.append(text[i : m.end()])
+            newlines += 1
+            i = m.end()
+            continue
+        buf.append(ch)
+        i += 1
diff --git a/src/kakeibo/mom_report.py b/src/kakeibo/mom_report.py
new file mode 100644
index 0000000..43c156e
--- /dev/null
+++ b/src/kakeibo/mom_report.py
@@ -0,0 +1,43 @@
+"""前月比レポート(部品をつなぐ薄い層)。
+
+D1: 月の合計は `core.monthly_totals` を使う。
+D2: 比べる月の途中にデータの無い月があれば、空の月(全カテゴリ 0)として比べる。
+D3: 最初の月は比べる相手が無いので、レポートに含めない。
+"""
+
+from __future__ import annotations
+
+from itertools import pairwise
+
+from kakeibo._mom_diff import Change, diff_totals
+from kakeibo._months import month_span, previous_month
+from kakeibo.core import Expense, monthly_totals
+
+_LABEL = {"up": "増", "down": "減", "new": "新規", "gone": "なし", "same": "変化なし"}
+
+
+def compare_with_previous(rows: list[Expense], month: str) -> list[Change]:
+    totals = monthly_totals(rows)
+    return diff_totals(totals.get(previous_month(month), {}), totals.get(month, {}))
+
+
+def month_over_month(rows: list[Expense]) -> dict[str, list[Change]]:
+    """{月: その月の前月比} 。最初の月は含めない。データが空なら {}。"""
+    totals = monthly_totals(rows)
+    if not totals:
+        return {}
+    months = month_span(min(totals), max(totals))
+    return {
+        cur: diff_totals(totals.get(prev, {}), totals.get(cur, {}))
+        for prev, cur in pairwise(months)
+    }
+
+
+def format_changes(month: str, changes: list[Change]) -> str:
+    lines = [f"{month} 前月比"]
+    for c in changes:
+        pct = "-" if c.pct is None else f"{c.pct:+.1f}%"
+        lines.append(
+            f"  {c.category}: {c.prev:,} → {c.cur:,} ({c.delta:+,}円, {pct}) {_LABEL[c.kind]}"
+        )
+    return "\n".join(lines)
diff --git a/src/kakeibo/recurring.py b/src/kakeibo/recurring.py
new file mode 100644
index 0000000..7a8ce1a
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,45 @@
+"""定期支出の検出と次回予測(部品をつなぐ薄い層)。
+
+D1: 同一視・繰り返しの条件は `_recur_detect` の規則に従う。
+D2: 次回予測は `_recur_next` の規則に従う。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo._recur_detect import Recurring, detect_recurring
+from kakeibo._recur_next import next_due
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Forecast:
+    recurring: Recurring
+    next_date: date
+
+
+def forecast_recurring(rows: list[Expense], min_months: int = 3) -> list[Forecast]:
+    """定期支出と、それぞれの次回予定日。次回が早い順、同日は金額の降順。"""
+    out = [
+        Forecast(r, next_due(list(r.dates))) for r in detect_recurring(rows, min_months)
+    ]
+    return sorted(
+        out, key=lambda f: (f.next_date, -f.recurring.amount, f.recurring.category)
+    )
+
+
+def upcoming(
+    rows: list[Expense], today: date, days: int = 30, min_months: int = 3
+) -> list[Forecast]:
+    """`today` から `days` 日以内(両端を含む)に来そうな定期支出。"""
+    if isinstance(days, bool) or not isinstance(days, int):
+        raise TypeError("days は int である必要があります")
+    if days < 0:
+        raise ValueError("days は 0 以上である必要があります")
+    return [
+        f
+        for f in forecast_recurring(rows, min_months)
+        if 0 <= (f.next_date - today).days <= days
+    ]
diff --git a/src/kakeibo/search.py b/src/kakeibo/search.py
new file mode 100644
index 0000000..ca97c46
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,47 @@
+"""明細の検索(部品をつなぐ薄い層)。
+
+条件は dict の木: `{"and": [...]}` `{"or": [...]}` `{"not": {...}}`、葉は 1 キーの dict
+(`category` `min_amount` `max_amount` `memo_contains` `since` `until`)。
+D1: 結果は元の並びを保つ。
+D2: 条件の誤り(未知のキー・型違い)は、明細が 0 件でも検出するため先に 1 度試す。
+"""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from datetime import date
+
+from kakeibo._query_leaf import match_leaf
+from kakeibo._query_tree import evaluate
+from kakeibo.core import Expense
+
+_PROBE = Expense(day=date(2000, 1, 1), category="", amount=0)
+
+
+def matches(e: Expense, query: Mapping[str, object]) -> bool:
+    return evaluate(query, lambda key, value: match_leaf(e, key, value))
+
+
+def search(rows: list[Expense], query: Mapping[str, object]) -> list[Expense]:
+    # 短絡で葉が評価されない誤りも拾うため、全ての葉を検証する。
+    _validate(query)
+    return [e for e in rows if matches(e, query)]
+
+
+def _validate(node: object) -> None:
+    if not isinstance(node, dict):
+        raise ValueError(f"条件は dict である必要があります: {node!r}")  # noqa: TRY004
+    if len(node) == 1:
+        ((key, value),) = node.items()
+        if key in ("and", "or"):
+            if not isinstance(value, list):
+                raise ValueError(f"{key} の値は list である必要があります")
+            for child in value:
+                _validate(child)
+            return
+        if key == "not":
+            _validate(value)
+            return
+        match_leaf(_PROBE, key, value)
+        return
+    evaluate(node, lambda k, v: True)  # 2 個以上・0 個は ValueError になる
diff --git a/src/kakeibo/statement.py b/src/kakeibo/statement.py
new file mode 100644
index 0000000..4632cf0
--- /dev/null
+++ b/src/kakeibo/statement.py
@@ -0,0 +1,78 @@
+"""銀行・カード会社の CSV の取り込み(部品をつなぐ薄い層)。
+
+D1: 1 行に誤りが複数あれば全て報告する。行番号はレコードの開始行。
+D2: 金額が `出金/入金` の 2 列なら、出金だけを支出にする。入金のみの行は黙って飛ばす。
+D3: 金額が 1 列なら、負(返金)もそのまま取り込む。
+D4: カテゴリ列が無ければ `default_category`。
+D5: 列数が合わない行は、1 件の誤りとして報告して取り込まない。
+D6: ヘッダーが読めない(必須列なし・空入力)ときは `ValueError`。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from kakeibo._amount_parse import parse_amount
+from kakeibo._date_parse import parse_date
+from kakeibo._header_map import map_columns
+from kakeibo._table_split import split_table
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class StatementResult:
+    expenses: list[Expense]
+    errors: list[tuple[int, str]]  # (開始行番号, 理由)
+
+
+def _blank(s: str) -> bool:
+    return s.strip().strip("　") == ""
+
+
+def import_statement(text: str, default_category: str = "未分類") -> StatementResult:
+    header, records = split_table(text)
+    cols = map_columns(header)
+    width = len(header)
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    for line, cells in records:
+        if len(cells) != width:
+            errors.append(
+                (line, f"列数が違います(ヘッダー {width} 列、この行 {len(cells)} 列)")
+            )
+            continue
+        problems: list[str] = []
+        day = None
+        amount: int | None = None
+        try:
+            day = parse_date(cells[cols["date"]])
+        except ValueError as e:
+            problems.append(f"日付({header[cols['date']]}): {e}")
+        skip = False
+        try:
+            if "amount" in cols:
+                amount = parse_amount(cells[cols["amount"]])
+            else:
+                debit = cells[cols["debit"]]
+                credit = cells[cols["credit"]] if "credit" in cols else ""
+                if not _blank(debit):
+                    amount = parse_amount(debit)
+                elif not _blank(credit):
+                    parse_amount(credit)  # 入金の書き方が不正なら報告する
+                    skip = True
+                else:
+                    raise ValueError("出金・入金のどちらも空です")
+        except ValueError as e:
+            name = header[cols["amount"] if "amount" in cols else cols["debit"]]
+            problems.append(f"金額({name}): {e}")
+        if problems:
+            errors.append((line, "; ".join(problems)))
+            continue
+        if skip or day is None or amount is None:
+            continue
+        category = default_category
+        if "category" in cols and not _blank(cells[cols["category"]]):
+            category = cells[cols["category"]].strip()
+        memo = cells[cols["memo"]].strip() if "memo" in cols else ""
+        expenses.append(Expense(day=day, category=category, amount=amount, memo=memo))
+    return StatementResult(expenses, errors)
