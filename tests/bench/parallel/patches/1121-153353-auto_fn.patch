+from datetime import date
+
+import pytest
+
+from kakeibo._recur_detect import Recurring, detect_recurring
+from kakeibo.core import Expense
+
+
+def _e(m: int, d: int, cat: str, amt: int, memo: str) -> Expense:
+    return Expense(date(2026, m, d), cat, amt, memo)
+
+
+CASES = [
+    (
+        [
+            _e(1, 25, "家賃", 80000, "家賃"),
+            _e(2, 25, "家賃", 80000, "家賃"),
+            _e(3, 25, "家賃", 80000, "家賃"),
+        ],
+        [
+            Recurring(
+                "家賃",
+                "家賃",
+                80000,
+                (date(2026, 1, 25), date(2026, 2, 25), date(2026, 3, 25)),
+            )
+        ],
+    ),
+    (
+        [
+            _e(1, 3, "娯楽", 1490, "動画"),
+            _e(2, 3, "娯楽", 1490, "動画"),
+            _e(4, 3, "娯楽", 1490, "動画"),
+        ],
+        [],
+    ),
+    (
+        [_e(m, 5, "x", a, "同じ") for m in (1, 2, 3) for a in (1000, 1200)],
+        [
+            Recurring("x", "同じ", 1200, tuple(date(2026, m, 5) for m in (1, 2, 3))),
+            Recurring("x", "同じ", 1000, tuple(date(2026, m, 5) for m in (1, 2, 3))),
+        ],
+    ),
+]
+
+
+@pytest.mark.parametrize("rows,expected", CASES, ids=["E1-1", "E1-2", "E1-3"])
+def test_examples(rows: list[Expense], expected: list[Recurring]) -> None:
+    assert detect_recurring(rows) == expected
+    assert detect_recurring(list(reversed(rows))) == expected
+
+
+def test_empty_and_errors() -> None:
+    assert detect_recurring([]) == []
+    with pytest.raises(ValueError):
+        detect_recurring([], 1)
+    with pytest.raises(TypeError):
+        detect_recurring([], True)
+    with pytest.raises(TypeError):
+        detect_recurring([], 3.0)  # type: ignore[arg-type]
+
+
+def test_same_month_earliest_and_normalized_memo() -> None:
+    rows = [
+        _e(1, 20, "c", 1000, "ＮＥＴ 12"),
+        _e(1, 5, "c", 1000, "net"),
+        _e(2, 5, "c", 1100, "Net-3"),
+        _e(3, 5, "c", 1000, "net"),
+        _e(3, 6, "c", -500, "net"),
+    ]
+    r = detect_recurring(rows)
+    assert len(r) == 1
+    assert r[0].memo_key == "net"
+    assert r[0].amount == 1000
+    assert r[0].dates == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_last_run_only() -> None:
+    rows = [_e(m, 1, "c", 100, "a") for m in (1, 3, 4, 5)]
+    assert detect_recurring(rows)[0].dates == tuple(date(2026, m, 1) for m in (3, 4, 5))
