+from datetime import date
+
+import pytest
+
+from kakeibo._query_leaf import match_leaf
+from kakeibo.core import Expense
+
+E = Expense(date(2026, 1, 5), "食費", 1000, "ＮＥＴＦＬＩＸ 月額")
+
+
+def test_amount_bounds_inclusive() -> None:
+    assert match_leaf(E, "min_amount", 1000) and match_leaf(E, "max_amount", 1000)
+    assert not match_leaf(E, "min_amount", 1001)
+    assert not match_leaf(E, "max_amount", 999)
+
+
+def test_date_bounds_inclusive() -> None:
+    assert match_leaf(E, "since", date(2026, 1, 5)) and match_leaf(
+        E, "until", date(2026, 1, 5)
+    )
+    assert not match_leaf(E, "since", date(2026, 1, 6))
+    assert not match_leaf(E, "until", date(2026, 1, 4))
+
+
+def test_memo_and_category() -> None:
+    assert match_leaf(E, "memo_contains", "netflix")
+    assert match_leaf(E, "memo_contains", "")
+    assert not match_leaf(E, "memo_contains", "hulu")
+    assert match_leaf(E, "category", " 食費 ")
+    assert match_leaf(E, "category", ["住居", "食費"])
+    assert not match_leaf(E, "category", [])
+
+
+def test_type_errors() -> None:
+    for key, bad in [
+        ("min_amount", True),
+        ("max_amount", 1.5),
+        ("since", "2026-01-01"),
+        ("memo_contains", 1),
+        ("category", 3),
+        ("category", [1]),
+    ]:
+        with pytest.raises(TypeError):
+            match_leaf(E, key, bad)
+
+
+def test_unknown_key() -> None:
+    with pytest.raises(ValueError, match="nope"):
+        match_leaf(E, "nope", 1)
