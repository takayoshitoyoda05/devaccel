+from datetime import date
+
+import pytest
+
+from kakeibo.statement import import_statement
+
+
+def test_card_csv_with_aliases() -> None:
+    text = (
+        '﻿利用日,ご利用店名,利用金額\n2026/1/5,コンビニ,"1,234円"\n2026/1/6,返品,△500\n'
+    )
+    r = import_statement(text)
+    assert r.errors == []
+    assert [(e.day, e.memo, e.amount, e.category) for e in r.expenses] == [
+        (date(2026, 1, 5), "コンビニ", 1234, "未分類"),
+        (date(2026, 1, 6), "返品", -500, "未分類"),
+    ]
+
+
+def test_bank_csv_debit_credit_skips_income() -> None:
+    text = "日付,摘要,出金額,入金額\n2026-01-05,家賃,80000,\n2026-01-25,給与,,300000\n"
+    r = import_statement(text)
+    assert r.errors == []
+    assert [(e.memo, e.amount) for e in r.expenses] == [("家賃", 80000)]
+
+
+def test_errors_report_line_and_reason_for_every_bad_row() -> None:
+    text = (
+        "date,amount,memo\n"
+        "2026-01-05,100,ok\n"
+        "2026-02-30,abc,both bad\n"
+        "2026-01-07,12.5,frac\n"
+        "2026-01-08,1,2,extra\n"
+    )
+    r = import_statement(text)
+    assert len(r.expenses) == 1
+    assert [n for n, _ in r.errors] == [3, 4, 5]
+    assert "日付" in r.errors[0][1] and "金額" in r.errors[0][1]
+    assert "12.5" in r.errors[1][1]
+    assert "列数" in r.errors[2][1]
+
+
+def test_quoted_newline_line_numbers_and_tab_delimiter() -> None:
+    text = 'date\tamount\tmemo\n2026-01-05\t100\t"a\nb"\n2026-01-06\tx\tbad\n'
+    r = import_statement(text)
+    assert [e.memo for e in r.expenses] == ["a\nb"]
+    assert [n for n, _ in r.errors] == [4]
+
+
+def test_category_column_used() -> None:
+    r = import_statement(
+        "date,category,amount\n2026-01-05, 食費 ,100\n2026-01-05,,50\n"
+    )
+    assert [e.category for e in r.expenses] == ["食費", "未分類"]
+
+
+def test_bad_header_raises() -> None:
+    with pytest.raises(ValueError):
+        import_statement("日付,メモ\n2026-01-05,x\n")
+    with pytest.raises(ValueError):
+        import_statement("")
+
+
+def test_debit_credit_both_blank_is_error() -> None:
+    r = import_statement("日付,出金,入金\n2026-01-05,,\n")
+    assert r.expenses == [] and r.errors[0][0] == 2
