@@ -0,0 +1,94 @@
+import pytest
+
+from kakeibo._table_split import split_table
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        pytest.param(
+            "日付\t金額\n2026/1/5\t1,234\n",
+            (["日付", "金額"], [(2, ["2026/1/5", "1,234"])]),
+            id="E3-1",
+        ),
+        pytest.param(
+            'date,memo\n1,"a\nb"\n2,c\n',
+            (["date", "memo"], [(2, ["1", "a\nb"]), (4, ["2", "c"])]),
+            id="E3-2",
+        ),
+        pytest.param(
+            "﻿date,amount\n",
+            (["date", "amount"], []),
+            id="E3-3",
+        ),
+    ],
+)
+def test_example_table(text, expected):
+    assert split_table(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        pytest.param("", id="R5-empty"),
+        pytest.param("\n\r\n  \n", id="R5-blank-lines-only"),
+        pytest.param("﻿", id="R5-bom-only"),
+    ],
+)
+def test_empty_input_raises(text):
+    with pytest.raises(ValueError, match="入力が空です"):
+        split_table(text)
+
+
+def test_unclosed_quote_reports_start_line():
+    with pytest.raises(ValueError, match="3"):
+        split_table('a,b\n1,2\n"x,y\n')
+
+
+def test_doubled_quote_is_single_quote():
+    assert split_table('h\n"say ""hi"""\n') == (["h"], [(2, ['say "hi"'])])
+
+
+def test_crlf_and_cr_line_endings_count_lines():
+    assert split_table("a,b\r\n1,2\r\n3,4\r") == (
+        ["a", "b"],
+        [(2, ["1", "2"]), (3, ["3", "4"])],
+    )
+
+
+def test_blank_and_whitespace_lines_are_skipped():
+    assert split_table("a,b\n\n   \n1,2\n\t\n3,4") == (
+        ["a", "b"],
+        [(4, ["1", "2"]), (6, ["3", "4"])],
+    )
+
+
+def test_values_keep_surrounding_spaces():
+    assert split_table("a, b\n 1 , 2 \n") == (["a", " b"], [(2, [" 1 ", " 2 "])])
+
+
+def test_ragged_rows_are_returned_as_is():
+    assert split_table("a,b,c\n1,2\n1,2,3,4\n") == (
+        ["a", "b", "c"],
+        [(2, ["1", "2"]), (3, ["1", "2", "3", "4"])],
+    )
+
+
+def test_header_only_returns_empty_rows():
+    assert split_table("date,amount\n") == (["date", "amount"], [])
+
+
+def test_delimiter_is_tab_when_more_tabs_than_commas_in_header():
+    assert split_table('a\tb\tc,d\n1\t"x,y"\n') == (
+        ["a", "b", "c,d"],
+        [(2, ["1", "x,y"])],
+    )
+
+
+def test_quotes_in_header_do_not_count_as_delimiters():
+    assert split_table('"a,b,c"\tz\n1\t2\n') == (["a,b,c", "z"], [(2, ["1", "2"])])
+
+
+def test_non_str_input_raises_type_error():
+    with pytest.raises(TypeError):
+        split_table(b"a,b\n")  # type: ignore[arg-type]
