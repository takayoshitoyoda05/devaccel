--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,61 @@
+from collections.abc import Mapping
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import matches, search
+
+ROWS = [
+    Expense(date(2026, 1, 5), "食費", 1200, "スーパー"),
+    Expense(date(2026, 1, 20), "娯楽", 1490, "Netflix 月額"),
+    Expense(date(2026, 2, 1), "住居", 80000, "家賃"),
+    Expense(date(2026, 2, 10), "食費", 300, "コンビニ"),
+]
+
+
+def memos(q: Mapping[str, object]) -> list[str]:
+    return [e.memo for e in search(ROWS, q)]
+
+
+def test_leaf_filters() -> None:
+    assert memos({"category": "食費"}) == ["スーパー", "コンビニ"]
+    assert memos({"min_amount": 1490}) == ["Netflix 月額", "家賃"]
+    assert memos({"max_amount": 300}) == ["コンビニ"]
+    assert memos({"memo_contains": "ＮＥＴＦＬＩＸ"}) == ["Netflix 月額"]
+    assert memos({"since": date(2026, 2, 1)}) == ["家賃", "コンビニ"]
+    assert memos({"until": date(2026, 1, 5)}) == ["スーパー"]
+
+
+def test_and_or_not() -> None:
+    q = {"and": [{"category": ["食費", "娯楽"]}, {"max_amount": 1200}]}
+    assert memos(q) == ["スーパー", "コンビニ"]
+    q2 = {"or": [{"category": "住居"}, {"memo_contains": "netflix"}]}
+    assert memos(q2) == ["Netflix 月額", "家賃"]
+    assert memos({"not": {"category": "食費"}}) == ["Netflix 月額", "家賃"]
+    assert len(search(ROWS, {"and": []})) == 4
+    assert search(ROWS, {"or": []}) == []
+
+
+def test_range_inclusive_and_inverted_range_matches_nothing() -> None:
+    both = {"and": [{"min_amount": 300}, {"max_amount": 300}]}
+    assert memos(both) == ["コンビニ"]
+    assert memos({"and": [{"min_amount": 500}, {"max_amount": 100}]}) == []
+
+
+def test_invalid_queries_raise_even_when_short_circuited() -> None:
+    with pytest.raises(ValueError):
+        search(ROWS, {"nope": 1})
+    with pytest.raises(ValueError):
+        search([], {"nope": 1})
+    with pytest.raises(ValueError):
+        search(ROWS, {"or": [{"category": "住居"}, {"bogus": 1}]})
+    with pytest.raises(TypeError):
+        search(ROWS, {"min_amount": True})
+    with pytest.raises(ValueError):
+        search(ROWS, {"category": "a", "min_amount": 1})
+
+
+def test_matches_single() -> None:
+    assert matches(ROWS[0], {"category": "食費"})
+    assert not matches(ROWS[0], {"category": "住居"})
