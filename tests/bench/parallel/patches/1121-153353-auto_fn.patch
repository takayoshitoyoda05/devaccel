@@ -0,0 +1,36 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import forecast_recurring, upcoming
+
+
+def _rows() -> list[Expense]:
+    rows = [Expense(date(2026, m, 25), "住居", 80000, "家賃") for m in (1, 2, 3)]
+    rows += [Expense(date(2026, m, 5), "娯楽", 1490, "動画配信") for m in (1, 2, 3)]
+    rows += [Expense(date(2026, 3, 9), "食費", 1200, "スーパー")]
+    return rows
+
+
+def test_forecast_sorted_by_next_date() -> None:
+    result = forecast_recurring(_rows())
+    assert [f.recurring.category for f in result] == ["娯楽", "住居"]
+    assert [f.next_date for f in result] == [date(2026, 4, 5), date(2026, 4, 25)]
+
+
+def test_upcoming_window_inclusive() -> None:
+    rows = _rows()
+    assert [
+        f.recurring.category for f in upcoming(rows, date(2026, 3, 26), days=10)
+    ] == ["娯楽"]
+    assert len(upcoming(rows, date(2026, 3, 26), days=30)) == 2
+    assert upcoming(rows, date(2026, 4, 5), days=0)[0].recurring.category == "娯楽"
+    assert upcoming(rows, date(2026, 4, 6), days=0) == []
+
+
+def test_upcoming_validates_days() -> None:
+    with pytest.raises(ValueError):
+        upcoming([], date(2026, 1, 1), days=-1)
+    with pytest.raises(TypeError):
+        upcoming([], date(2026, 1, 1), days=True)
