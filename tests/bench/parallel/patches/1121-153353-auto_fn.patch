@@ -0,0 +1,45 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.mom_report import compare_with_previous, format_changes, month_over_month
+
+
+def _rows() -> list[Expense]:
+    return [
+        Expense(date(2026, 1, 5), "食費", 1000),
+        Expense(date(2026, 1, 6), "交通", 300),
+        Expense(date(2026, 2, 5), "食費", 1500),
+        Expense(date(2026, 2, 6), "医療", 800),
+        Expense(date(2026, 4, 1), "食費", 500),
+    ]
+
+
+def test_compare_with_previous() -> None:
+    by_cat = {c.category: c for c in compare_with_previous(_rows(), "2026-02")}
+    assert by_cat["食費"].kind == "up" and by_cat["食費"].delta == 500
+    assert by_cat["交通"].kind == "gone"
+    assert by_cat["医療"].kind == "new" and by_cat["医療"].pct is None
+
+
+def test_missing_month_is_empty_month() -> None:
+    result = month_over_month(_rows())
+    assert list(result) == ["2026-02", "2026-03", "2026-04"]
+    assert {c.category: c.kind for c in result["2026-03"]} == {
+        "食費": "gone",
+        "医療": "gone",
+    }
+    assert {c.category: c.kind for c in result["2026-04"]} == {"食費": "new"}
+
+
+def test_first_month_and_empty() -> None:
+    assert month_over_month([]) == {}
+    assert month_over_month([Expense(date(2026, 1, 1), "食費", 1)]) == {}
+    # 前月に何もなければ全て new
+    assert [c.kind for c in compare_with_previous(_rows(), "2026-01")] == ["new", "new"]
+
+
+def test_format_changes() -> None:
+    text = format_changes("2026-02", compare_with_previous(_rows(), "2026-02"))
+    assert text.splitlines()[0] == "2026-02 前月比"
+    assert "食費: 1,000 → 1,500 (+500円, +50.0%) 増" in text
+    assert "医療: 0 → 800 (+800円, -) 新規" in text
