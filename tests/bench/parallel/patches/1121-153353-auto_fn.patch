+import pytest
+
+from kakeibo._mom_diff import Change, diff_totals
+
+
+def test_up_gone_new() -> None:
+    assert diff_totals({"食費": 1000}, {"食費": 1500}) == [
+        Change("食費", 1000, 1500, 500, 50.0, "up")
+    ]
+    assert diff_totals({"交通": 300}, {}) == [
+        Change("交通", 300, 0, -300, -100.0, "gone")
+    ]
+    assert diff_totals({}, {"医療": 800}) == [Change("医療", 0, 800, 800, None, "new")]
+
+
+def test_down_same_and_zero_prev() -> None:
+    assert diff_totals({"a": 200}, {"a": 100})[0].kind == "down"
+    assert diff_totals({"a": 5}, {"a": 5})[0] == Change("a", 5, 5, 0, 0.0, "same")
+    assert diff_totals({"a": 0}, {"a": 0})[0].pct is None
+    assert diff_totals({"a": 0}, {"a": 7})[0].kind == "new"
+
+
+def test_order_abs_delta_then_category() -> None:
+    result = diff_totals({"b": 0, "a": 0, "c": 100}, {"b": 50, "a": 50, "c": 0})
+    assert [c.category for c in result] == ["c", "a", "b"]
+
+
+def test_empty_and_negative_totals() -> None:
+    assert diff_totals({}, {}) == []
+    assert diff_totals({"a": -100}, {"a": -300})[0].delta == -200
+
+
+def test_type_errors() -> None:
+    with pytest.raises(TypeError):
+        diff_totals({"a": True}, {})
+    with pytest.raises(TypeError):
+        diff_totals({}, {"a": 1.5})  # type: ignore[dict-item]
