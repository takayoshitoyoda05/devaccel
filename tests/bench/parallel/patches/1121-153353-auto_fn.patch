+"""CSV ヘッダーの列名を date/amount/debit/credit/memo/category に割り当てる。"""
+
+from __future__ import annotations
+
+import unicodedata
+
+_ALIASES: dict[str, tuple[str, ...]] = {
+    "date": ("日付", "利用日", "取引日", "ご利用日", "年月日", "date"),
+    "amount": ("金額", "利用金額", "ご利用金額", "amount"),
+    "debit": ("出金", "出金額", "お支払金額", "お引出し", "支払", "debit"),
+    "credit": ("入金", "入金額", "お預入れ", "預入", "credit"),
+    "memo": (
+        "摘要",
+        "メモ",
+        "利用店名",
+        "ご利用店名",
+        "内容",
+        "備考",
+        "description",
+        "memo",
+    ),
+    "category": ("カテゴリ", "分類", "費目", "category"),
+}
+_LOOKUP = {a: name for name, al in _ALIASES.items() for a in al}
+
+
+def _norm(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).strip().strip("　").casefold()
+
+
+def map_columns(header: list[str]) -> dict[str, int]:
+    if not header:
+        raise ValueError("ヘッダーが空です")
+    found: dict[str, int] = {}
+    for i, h in enumerate(header):
+        name = _LOOKUP.get(_norm(h))
+        if name is None:
+            continue
+        if name in found:
+            raise ValueError(f"列名が曖昧です({name} に当たる列が複数): {header}")
+        found[name] = i
+    if "date" not in found:
+        raise ValueError(f"日付の列がありません。見つかった列: {header}")
+    if "amount" not in found and "debit" not in found:
+        raise ValueError(f"金額(または出金)の列がありません。見つかった列: {header}")
+    if "amount" in found:
+        found.pop("debit", None)
+    return found
