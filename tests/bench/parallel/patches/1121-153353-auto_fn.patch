+from datetime import date
+
+import pytest
+
+from kakeibo._recur_next import next_due
+
+
+@pytest.mark.parametrize(
+    ("dates", "expected"),
+    [
+        # E2-1: 最頻値は 31 → 翌月 4 月は 30 日に切り詰め
+        pytest.param(
+            [date(2026, 1, 31), date(2026, 2, 28), date(2026, 3, 31)],
+            date(2026, 4, 30),
+            id="E2-1",
+        ),
+        # E2-2: 年跨ぎ、最頻値 5 → 2026-01-05
+        pytest.param(
+            [date(2025, 11, 5), date(2025, 12, 5)],
+            date(2026, 1, 5),
+            id="E2-2",
+        ),
+        # E2-3: 同数 29/30 → 大きい 30 → 閏年 2 月は 29 に切り詰め
+        pytest.param(
+            [date(2024, 1, 29), date(2024, 1, 30)],
+            date(2024, 2, 29),
+            id="E2-3",
+        ),
+    ],
+)
+def test_example_table(dates: list[date], expected: date) -> None:
+    assert next_due(dates) == expected
+
+
+def test_unsorted_input_uses_latest_month() -> None:
+    assert next_due([date(2026, 3, 5), date(2026, 1, 5), date(2026, 2, 5)]) == date(
+        2026, 4, 5
+    )
+
+
+def test_same_month_entries_all_count_for_mode() -> None:
+    # R2: 同じ月の複数件も日の集計に入れる。日 10 が 3 件、日 20 が 1 件 → 10
+    dates = [date(2026, 1, 10), date(2026, 1, 10), date(2026, 2, 10), date(2026, 2, 20)]
+    assert next_due(dates) == date(2026, 3, 10)
+
+
+def test_mode_tie_picks_larger_day() -> None:
+    dates = [date(2026, 1, 3), date(2026, 2, 7)]
+    assert next_due(dates) == date(2026, 3, 7)
+
+
+def test_december_rolls_to_january_next_year() -> None:
+    assert next_due([date(2025, 12, 15)]) == date(2026, 1, 15)
+
+
+def test_non_leap_february_clips_to_28() -> None:
+    # 2026 は平年: 翌 2 月の 31 日 → 28 日
+    assert next_due([date(2026, 1, 31)]) == date(2026, 2, 28)
+
+
+def test_empty_list_raises_value_error() -> None:
+    with pytest.raises(ValueError):
+        next_due([])
+
+
+def test_non_date_element_raises_type_error() -> None:
+    with pytest.raises(TypeError):
+        next_due([date(2026, 1, 5), "2026-02-05"])  # type: ignore[list-item]
