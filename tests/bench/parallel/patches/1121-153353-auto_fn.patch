@@ -0,0 +1,34 @@
+"""`YYYY-MM` の月の計算。"""
+
+from __future__ import annotations
+
+import re
+
+_RE = re.compile(r"([0-9]{4})-(0[1-9]|1[0-2])")
+
+
+def _parse(month: str) -> tuple[int, int]:
+    if not isinstance(month, str):
+        raise TypeError("month は str である必要があります")
+    m = _RE.fullmatch(month)
+    if m is None:
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+    return int(m[1]), int(m[2])
+
+
+def previous_month(month: str) -> str:
+    y, m = _parse(month)
+    y, m = (y - 1, 12) if m == 1 else (y, m - 1)
+    return f"{y:04d}-{m:02d}"
+
+
+def month_span(first: str, last: str) -> list[str]:
+    y, m = _parse(first)
+    ly, lm = _parse(last)
+    if (y, m) > (ly, lm):
+        raise ValueError(f"first が last より後です: {first!r} > {last!r}")
+    out: list[str] = []
+    while (y, m) <= (ly, lm):
+        out.append(f"{y:04d}-{m:02d}")
+        y, m = (y + 1, 1) if m == 12 else (y, m + 1)
+    return out
diff --git a/src/kakeibo/_query_leaf.py b/src/kakeibo/_query_leaf.py
new file mode 100644
index 0000000..c527b5f
--- /dev/null
+++ b/src/kakeibo/_query_leaf.py
@@ -0,0 +1,46 @@
+"""検索条件の葉(1 キーの条件)を明細に当てる(D6)。"""
+
+from __future__ import annotations
+
+import unicodedata
+from datetime import date, datetime
+
+from kakeibo.core import Expense
+
+
+def _norm(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).casefold().strip()
+
+
+def _need_int(key: str, value: object) -> int:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{key} は int である必要があります")
+    return value
+
+
+def _need_date(key: str, value: object) -> date:
+    if not isinstance(value, date) or isinstance(value, datetime):
+        raise TypeError(f"{key} は date である必要があります")
+    return value
+
+
+def match_leaf(e: Expense, key: str, value: object) -> bool:
+    if key == "category":
+        if isinstance(value, str):
+            return _norm(e.category) == _norm(value)
+        if isinstance(value, list) and all(isinstance(v, str) for v in value):
+            return _norm(e.category) in {_norm(v) for v in value}
+        raise TypeError("category は str か str の list である必要があります")
+    if key == "min_amount":
+        return e.amount >= _need_int(key, value)
+    if key == "max_amount":
+        return e.amount <= _need_int(key, value)
+    if key == "memo_contains":
+        if not isinstance(value, str):
+            raise TypeError("memo_contains は str である必要があります")
+        return _norm(value) in unicodedata.normalize("NFKC", e.memo).casefold()
+    if key == "since":
+        return e.day >= _need_date(key, value)
+    if key == "until":
+        return e.day <= _need_date(key, value)
+    raise ValueError(f"未知の条件キーです: {key!r}")
