+++ b/src/kakeibo/bankimport.py
@@ -0,0 +1,111 @@
+"""Import rows from other-bank CSV exports into Expense records."""
+
+from __future__ import annotations
+
+import csv
+import io
+import re
+from datetime import date
+
+from kakeibo.core import Expense
+
+DEFAULT_MAPPING: dict[str, str] = {
+    "date": "利用日",
+    "category": "分類",
+    "amount": "利用金額",
+    "memo": "利用店名",
+}
+
+_AMOUNT_RE = re.compile(r"(-?)[¥￥]?([0-9][0-9,]*)円?")
+_DATE_RE = re.compile(r"([0-9]{4})([/-])([0-9]{1,2})\2([0-9]{1,2})")
+_REQUIRED_FIELDS = ("date", "category", "amount")
+
+
+def parse_amount(s: str) -> int:
+    """Parse '-¥1,234円'-style amounts into yen. Raises ValueError otherwise."""
+    m = _AMOUNT_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"金額の形式が不正です: {s!r}")
+    value = int(m.group(2).replace(",", ""))
+    return -value if m.group(1) else value
+
+
+def parse_date(s: str) -> date:
+    """Parse 'YYYY/M/D' or 'YYYY-M-D' (separator must match). Raises ValueError otherwise."""
+    m = _DATE_RE.fullmatch(s.strip())
+    if m is None:
+        raise ValueError(f"日付の形式が不正です: {s!r}")
+    try:
+        return date(int(m.group(1)), int(m.group(3)), int(m.group(4)))
+    except ValueError:
+        raise ValueError(f"存在しない日付です: {s!r}") from None
+
+
+def _cell(row: list[str], idx: int) -> str:
+    return row[idx] if idx < len(row) else ""
+
+
+def import_rows(
+    text: str,
+    mapping: dict[str, str] | None = None,
+    category_map: dict[str, str] | None = None,
+) -> tuple[list[Expense], list[tuple[int, str]]]:
+    """Convert a CSV string (header on line 1) into expenses.
+
+    Returns (valid expenses in input order, errors as (physical line number, field)).
+    Rows with any error are excluded from the expenses.
+    """
+    cols = DEFAULT_MAPPING if mapping is None else mapping
+    for key in _REQUIRED_FIELDS:
+        if key not in cols:
+            raise ValueError(f"mapping に {key} がありません")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    header: list[str] = next(reader, [])
+    index: dict[str, int] = {}
+    for field in ("date", "category", "amount", "memo"):
+        if field not in cols:
+            continue
+        name = cols[field]
+        if name not in header:
+            raise ValueError(f"CSV に列 {name!r} がありません")
+        index[field] = header.index(name)
+
+    expenses: list[Expense] = []
+    errors: list[tuple[int, str]] = []
+    while True:
+        start = reader.line_num + 1
+        row = next(reader, None)
+        if row is None:
+            break
+        if not row:  # blank line: skipped but still counted in line numbers
+            continue
+
+        raw_date = _cell(row, index["date"])
+        raw_amount = _cell(row, index["amount"])
+        category = _cell(row, index["category"]).strip()
+
+        row_errors: list[tuple[int, str]] = []
+        day: date | None = None
+        amount: int | None = None
+        try:
+            day = parse_date(raw_date)
+        except ValueError:
+            row_errors.append((start, "date"))
+        try:
+            amount = parse_amount(raw_amount)
+        except ValueError:
+            row_errors.append((start, "amount"))
+        if not category:
+            row_errors.append((start, "category"))
+
+        if row_errors or day is None or amount is None:
+            errors.extend(row_errors)
+            continue
+
+        if category_map is not None and category in category_map:
+            category = category_map[category]
+        memo = _cell(row, index["memo"]).strip() if "memo" in index else ""
+        expenses.append(Expense(day=day, category=category, amount=amount, memo=memo))
+
+    return expenses, errors
diff --git a/src/kakeibo/monthdiff.py b/src/kakeibo/monthdiff.py
