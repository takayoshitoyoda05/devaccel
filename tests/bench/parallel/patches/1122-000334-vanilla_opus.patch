+@pytest.mark.parametrize(
+    ("type", "expect"),
+    [
+        (click.FloatRange(0.5, 1.5), "0.5<=x<=1.5"),
+        (click.FloatRange(0.5, 1.5, min_open=True, max_open=True), "0.5<x<1.5"),
+        (click.FloatRange(0.5), "x>=0.5"),
+        (click.FloatRange(0.5, min_open=True), "x>0.5"),
+        (click.FloatRange(max=1.5), "x<=1.5"),
+        (click.FloatRange(max=1.5, max_open=True), "x<1.5"),
+    ],
+)
+def test_floatrange_default_help_text(type, expect):
+    option = click.Option(["--num"], type=type, show_default=True, default=1.0)
+    context = click.Context(click.Command("test"))
+    assert option.get_help_extra(context) == {"default": "1.0", "range": expect}
+    result = option.get_help_record(context)[1]
+    assert expect in result
+
+
+@pytest.mark.parametrize("range_type", [click.IntRange, click.FloatRange])
+def test_range_min_only_help_includes_bound(range_type):
+    """A closed lower bound accepts the bound itself, so the help must
+    say ``>=``, not ``>``. Check the described range against actual
+    validation so the two can't drift apart.
+    """
+    closed = range_type(1)
+    assert closed._describe_range() == "x>=1"
+    assert closed.convert("1", None, None) == 1
+
+    opened = range_type(1, min_open=True)
+    assert opened._describe_range() == "x>1"
+    with pytest.raises(click.BadParameter, match="x>1"):
+        opened.convert("1", None, None)
+
+
