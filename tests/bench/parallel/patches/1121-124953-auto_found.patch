+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo.account_report import monthly_account_report
+from kakeibo.account_types import AccountMonth
+from kakeibo.core import Expense
+
+
+def _jan(**kw: object) -> Expense:
+    base: dict[str, object] = {"day": date(2026, 1, 5), "category": "食費", "amount": 0}
+    base.update(kw)
+    return Expense(**base)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize(
+    ("rows", "balances", "expected"),
+    [
+        pytest.param(
+            [
+                _jan(amount=300, account="現金"),
+                _jan(category="振替", amount=1000, account="現金", to_account="銀行"),
+            ],
+            {"2026-01": {"現金": -1300, "銀行": 1000}},
+            {
+                "2026-01": {
+                    "現金": AccountMonth(300, 0, 1000, -1300),
+                    "銀行": AccountMonth(0, 1000, 0, 1000),
+                }
+            },
+            id="E3-1",
+        ),
+        pytest.param(
+            [],
+            {"2026-02": {"現金": 500, "銀行": 200}},
+            {
+                "2026-02": {
+                    "現金": AccountMonth(0, 0, 0, 500),
+                    "銀行": AccountMonth(0, 0, 0, 200),
+                }
+            },
+            id="E3-2",
+        ),
+        pytest.param(
+            [_jan(amount=100, account="カード")],
+            {"2026-01": {"現金": 0}},
+            {"2026-01": {"現金": AccountMonth(0, 0, 0, 0)}},
+            id="E3-3",
+        ),
+    ],
+)
+def test_example_table(rows: list[Expense], balances: dict, expected: dict) -> None:
+    assert monthly_account_report(rows, balances) == expected
+
+
+def test_R3_refund_reduces_spent_and_transfers_count_separately() -> None:
+    rows = [
+        _jan(amount=300, account="現金"),
+        _jan(amount=-50, account="現金"),
+        _jan(category="振替", amount=200, account="銀行", to_account="現金"),
+    ]
+    report = monthly_account_report(rows, {"2026-01": {"現金": 0, "銀行": 0}})
+    assert report["2026-01"]["現金"] == AccountMonth(250, 200, 0, 0)
+    assert report["2026-01"]["銀行"] == AccountMonth(0, 0, 200, 0)
+
+
+def test_R2_months_and_accounts_outside_balances_are_ignored() -> None:
+    rows = [
+        _jan(amount=100, account="現金"),
+        Expense(day=date(2026, 3, 1), category="食費", amount=999, account="現金"),
+    ]
+    report = monthly_account_report(rows, {"2026-01": {"現金": 0}})
+    assert list(report) == ["2026-01"]
+    assert report["2026-01"]["現金"] == AccountMonth(100, 0, 0, 0)
+
+
+def test_R5_empty_balances_gives_empty_report() -> None:
+    assert monthly_account_report([_jan(amount=100, account="現金")], {}) == {}
+
+
+def test_D5_months_ascending_and_accounts_by_name() -> None:
