+        pytest.param({"2026-01": {"": -5}}, ["2026-01\t(未指定)\t-5"], id="E4-2"),
+        # R5: 空なら空リスト
+        pytest.param({}, [], id="R5-empty"),
+        # R2: 負は '-' 付き / 月・口座の順は入力 dict の順のまま (D3)
+        pytest.param(
+            {"2026-01": {"銀行": -300, "現金": 0}, "2026-02": {"銀行": 10}},
+            ["2026-01\t銀行\t-300", "2026-01\t現金\t0", "2026-02\t銀行\t10"],
+            id="R2-negative-and-order",
+        ),
+    ],
+)
+def test_format_balances(
+    balances: dict[str, dict[str, int]], expected: list[str]
+) -> None:
+    assert format_balances(balances) == expected
+
+
+@pytest.mark.parametrize(
+    ("report", "expected"),
+    [
+        # E4-3 (R3)
+        pytest.param(
+            {"2026-01": {"現金": AccountMonth(1, 2, 3, 4)}},
+            ["2026-01\t現金\t1\t2\t3\t4"],
+            id="E4-3",
+        ),
+        # R4: 口座名 "" は (未指定)
