+"""Text formatting for balance and account reports (tab-separated lines).
+
+D1: 行は `\t` 区切り、金額は桁区切り無しの整数(負は `-` 付き)。ヘッダー行は付けない。
+D2: 口座名は account_label で表示名にする(NO_ACCOUNT -> "(未指定)")。
+D3: 並びは入力の dict の順(月昇順・口座名昇順は呼び出し側が保証)。空なら空リスト。
+"""
+
+from __future__ import annotations
+
+from kakeibo.account_types import AccountReport, Balances, account_label
+
+
+def format_balances(balances: Balances) -> list[str]:
+    """One line per (month, account): `YYYY-MM<TAB>account<TAB>balance`."""
+    return [
+        f"{month}\t{account_label(account)}\t{balance}"
+        for month, by_account in balances.items()
+        for account, balance in by_account.items()
+    ]
+
+
+def format_account_report(report: AccountReport) -> list[str]:
+    """One line per (month, account): `month<TAB>account<TAB>spent<TAB>in<TAB>out<TAB>end_balance`."""
+    return [
+        f"{month}\t{account_label(account)}\t{m.spent}\t{m.transfer_in}\t{m.transfer_out}\t{m.end_balance}"
+        for month, by_account in report.items()
+        for account, m in by_account.items()
+    ]
