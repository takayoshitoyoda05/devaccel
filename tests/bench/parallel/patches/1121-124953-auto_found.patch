+from datetime import date
+
+import pytest
+
+from kakeibo.accounts import account_names, filter_by_account, parse_opening
+from kakeibo.core import Expense
+
+
+def _e(account: str = "", to_account: str = "", amount: int = 100) -> Expense:
+    return Expense(date(2024, 1, 1), "食費", amount, "", account, to_account)
+
+
+@pytest.mark.parametrize(
+    ("specs", "expected"),
+    [
+        (["銀行=1,000", "現金=-50"], {"銀行": 1000, "現金": -50}),
+    ],
+    ids=["E1-1"],
+)
+def test_parse_opening_ok(specs: list[str], expected: dict[str, int]) -> None:
+    assert parse_opening(specs) == expected
+
+
+@pytest.mark.parametrize("specs", [["銀行=1", "銀行=2"]], ids=["E1-2"])
+def test_parse_opening_duplicate(specs: list[str]) -> None:
+    with pytest.raises(ValueError, match="銀行=2"):
+        parse_opening(specs)
+
+
+def test_filter_transfer_includes_destination() -> None:  # E1-3
+    t = _e("現金", "銀行")
+    other = _e("現金")
+    assert filter_by_account([other, t], "銀行") == [t]
+    assert filter_by_account([other, t], "現金") == [other, t]
+
+
+def test_filter_no_account() -> None:
+    a, b, c = _e(""), _e("銀行"), _e("銀行", "")
+    assert filter_by_account([a, b, c], "") == [a]
+    assert filter_by_account([a, b, c], "(未指定)") == [a]
+
+
+@pytest.mark.parametrize("yen", ["+300", "0", "-300"])
+def test_parse_yen_ok(yen: str) -> None:
+    assert parse_opening([f"A={yen}"]) == {"A": int(yen)}
+
+
+@pytest.mark.parametrize("yen", ["12.5", "abc", "", "１２３"])
+def test_parse_yen_bad(yen: str) -> None:
+    with pytest.raises(ValueError):
+        parse_opening([f"A={yen}"])
+
+
+def test_parse_misc() -> None:
+    assert parse_opening([]) == {}
+    assert parse_opening([" 銀行 =1=2".replace("=1=2", "=5")]) == {"銀行": 5}
+    assert parse_opening(["(未指定)=7"]) == {"": 7}
+    for bad in [
+        "=5",
+        "  =5",
+        "銀行",
+        "(未指定)=1",
+    ]:
+        if bad == "(未指定)=1":
+            with pytest.raises(ValueError):
+                parse_opening([bad, "=" + "1"])
+        else:
+            with pytest.raises(ValueError, match=bad.strip() or "="):
+                parse_opening([bad])
+    with pytest.raises(ValueError):
+        parse_opening(["(未指定)=1", "=2"])
+
+
+def test_account_names() -> None:
+    rows = [_e("銀行", "現金"), _e("カード")]
+    assert account_names(rows, {"貯金": 1}) == sorted(
+        ["", "カード", "貯金", "現金", "銀行"]
+    )
+    assert account_names([]) == [""]
