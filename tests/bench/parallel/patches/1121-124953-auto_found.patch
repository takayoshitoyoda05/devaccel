@@ -0,0 +1,50 @@
+"""Monthly per-account report.
+
+D1: 月と口座の集合は `balances` のキーに従う(balances が空なら {})。rows にだけ出る月・口座は無視する。
+D2: spent = その月その口座の非振替明細の amount 合計(返金=負は引く)。
+D3: transfer_out = 振替元(account)としての amount 合計、transfer_in = 振替先(to_account)としての合計。どちらも正の数。
+D4: end_balance は balances からそのまま取る。明細の無い月・口座は spent/in/out が 0。
+D5: 月は昇順、口座は名前昇順。
+"""
+
+from __future__ import annotations
+
+from kakeibo.account_types import AccountMonth, AccountReport, Balances, account_label
+from kakeibo.core import Expense
+
+
+def _month_of(e: Expense) -> str:
+    return f"{e.day.year:04d}-{e.day.month:02d}"
+
+
+def monthly_account_report(rows: list[Expense], balances: Balances) -> AccountReport:
+    """{"YYYY-MM": {account: AccountMonth}} for months/accounts in balances."""
+    report: AccountReport = {}
+    for month in sorted(balances):
+        month_rows = [e for e in rows if _month_of(e) == month]
+        accounts: dict[str, AccountMonth] = {}
+        for account in sorted(balances[month]):
+            key = account_label(account)  # D5: "" と "(未指定)" は同じ口座
+            spent = sum(
+                e.amount
+                for e in month_rows
+                if not e.is_transfer and account_label(e.account) == key
+            )
+            transfer_out = sum(
+                e.amount
+                for e in month_rows
+                if e.is_transfer and account_label(e.account) == key
+            )
+            transfer_in = sum(
+                e.amount
+                for e in month_rows
+                if e.is_transfer and account_label(e.to_account) == key
+            )
+            accounts[account] = AccountMonth(
+                spent=spent,
+                transfer_in=transfer_in,
+                transfer_out=transfer_out,
+                end_balance=balances[month][account],
+            )
+        report[month] = accounts
+    return report
