+from datetime import date
+
+import pytest
+
+from kakeibo.core import (
+    CsvError,
+    Expense,
+    load_csv,
+    monthly_totals,
+    total_by_category,
+)
+
+
+def _write(tmp_path, text):
+    p = tmp_path / "in.csv"
+    p.write_text(text, encoding="utf-8")
+    return p
+
+
+def test_legacy_csv_without_account_columns_loads(tmp_path):
+    p = _write(tmp_path, "date,category,amount,memo\n2026-11-01,food,100,x\n")
+    assert load_csv(p) == [Expense(date(2026, 11, 1), "food", 100, "x", "", "")]
+
+
+def test_account_and_transfer_columns(tmp_path):
+    p = _write(
+        tmp_path,
+        "date,category,amount,memo,account,to_account\n"
+        "2026-11-01,food,100,, 現金 ,\n"
+        "2026-11-02,,5000,,現金,銀行\n"
+        "2026-11-03,food,300,,\n",  # short row: account columns missing -> unspecified
+    )
+    rows = load_csv(p)
+    assert [(r.account, r.to_account, r.is_transfer) for r in rows] == [
+        ("現金", "", False),
+        ("現金", "銀行", True),
+        ("", "", False),
+    ]
+
+
+@pytest.mark.parametrize(
+    "line",
+    [
+        "2026-11-01,,0,,現金,銀行",  # zero transfer
+        "2026-11-01,,-5,,現金,銀行",  # negative transfer
+        "2026-11-01,,5,,現金,現金",  # same account
+    ],
+)
+def test_invalid_transfers_are_row_errors(tmp_path, line):
+    p = _write(tmp_path, "date,category,amount,memo,account,to_account\n" + line + "\n")
+    with pytest.raises(CsvError) as ei:
+        load_csv(p)
+    assert [n for n, _ in ei.value.errors] == [2]
+
+
+def test_transfers_are_not_counted_as_spending():
+    rows = [
+        Expense(date(2026, 11, 1), "food", 100, "", "現金"),
+        Expense(date(2026, 11, 2), "transfer", 5000, "", "現金", "銀行"),
+    ]
+    assert total_by_category(rows) == {"food": 100}
+    assert monthly_totals(rows) == {"2026-11": {"food": 100}}
