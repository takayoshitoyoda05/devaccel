+            {"2026-01": {"": AccountMonth(0, 0, 0, 0)}},
+            ["2026-01\t(未指定)\t0\t0\t0\t0"],
+            id="R4-unspecified",
+        ),
+        # R3: 負の残高 (クレジットカード想定) は '-' 付き
+        pytest.param(
+            {"2026-01": {"銀行": AccountMonth(300, 0, 1000, -1300)}},
+            ["2026-01\t銀行\t300\t0\t1000\t-1300"],
+            id="R3-negative-end-balance",
+        ),
+        # R5: 空なら空リスト
+        pytest.param({}, [], id="R5-empty"),
