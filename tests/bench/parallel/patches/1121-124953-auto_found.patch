+++ b/src/kakeibo/accounts.py
@@ -0,0 +1,64 @@
+"""Account helpers: filtering rows and parsing opening balances.
+
+D1: 口座名の一致は完全一致(大文字小文字を区別、前後空白は呼び出し側で除去済み)。
+D2: `"" ` と "(未指定)" はどちらも NO_ACCOUNT を指す。
+D3: filter_by_account は、その口座が account か to_account に現れる明細(振替の入金側も含む)を残す。並びは元のまま。
+D4: parse_opening は `NAME=YEN`。YEN は整数(符号可・桁区切り `,` 可)。小数・空・bool 相当は ValueError。
+D5: 同じ口座名の重複指定、空の口座名は ValueError(どの指定が悪いかをメッセージに含める)。
+"""
+
+from __future__ import annotations
+
+import re
+
+from kakeibo.account_types import NO_ACCOUNT, NO_ACCOUNT_LABEL
+from kakeibo.core import Expense
+
+_YEN = re.compile(r"([+-]?)([0-9]+(?:,[0-9]+)*)")
+
+
+def _key(name: str) -> str:
+    return NO_ACCOUNT if name == NO_ACCOUNT_LABEL else name
+
+
+def filter_by_account(rows: list[Expense], name: str) -> list[Expense]:
+    """Rows involving account `name` (as account or to_account)."""
+    key = _key(name)
+    return [
+        r for r in rows if r.account == key or (r.is_transfer and r.to_account == key)
+    ]
+
+
+def account_names(
+    rows: list[Expense], opening: dict[str, int] | None = None
+) -> list[str]:
+    """All accounts seen in rows (account and to_account) and opening, sorted ascending."""
+    names: set[str] = {NO_ACCOUNT}
+    for r in rows:
+        names.add(r.account)
+        if r.to_account:
+            names.add(r.to_account)
+    if opening:
+        names.update(opening)
+    return sorted(names)
+
+
+def parse_opening(specs: list[str]) -> dict[str, int]:
+    """["銀行=100000", "現金=-500"] -> {"銀行": 100000, "現金": -500}."""
+    result: dict[str, int] = {}
+    for spec in specs:
+        if "=" not in spec:
+            raise ValueError(f"invalid opening balance (expected NAME=YEN): {spec!r}")
+        raw_name, raw_yen = spec.split("=", 1)
+        name = raw_name.strip()
+        if not name:
+            raise ValueError(f"empty account name in opening balance: {spec!r}")
+        key = _key(name)
+        m = _YEN.fullmatch(raw_yen.strip())
+        if m is None:
+            raise ValueError(f"invalid yen amount in opening balance: {spec!r}")
+        if key in result:
+            raise ValueError(f"duplicate account in opening balance: {spec!r}")
+        value = int(m.group(2).replace(",", ""))
+        result[key] = -value if m.group(1) == "-" else value
+    return result
