+"""Shared types for multi-account support (fully implemented; not a parallel part).
+
+D1: 口座は明細の任意列 `account`。列が無い・空欄は NO_ACCOUNT("")。前後空白は除く。大文字小文字は区別する。
+D2: 振替は任意列 `to_account` が空でない明細。`account` から `to_account` へ `amount`(>0)円動く。
+    支出ではないので total_by_category / monthly_totals / 予算には数えない。
+D3: 表示では NO_ACCOUNT を "(未指定)" と書く。CLI の `--account "(未指定)"` も NO_ACCOUNT を指す。
+D4: 残高 = 開始残高(既定 0) − 支出 + 返金(負の amount) − 振替元 + 振替先。クレジットカードは負になりうる。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+NO_ACCOUNT = ""
+NO_ACCOUNT_LABEL = "(未指定)"
+
+# {"YYYY-MM": {account: end-of-month balance in yen}}
+Balances = dict[str, dict[str, int]]
+
+
+def account_label(name: str) -> str:
+    """NO_ACCOUNT -> "(未指定)"; other names unchanged."""
+    return NO_ACCOUNT_LABEL if name == NO_ACCOUNT else name
+
+
+@dataclass(frozen=True)
+class AccountMonth:
+    spent: int  # 支出の合計(振替を除く。返金は引く)
+    transfer_in: int  # 振替で入った合計
+    transfer_out: int  # 振替で出た合計(正の数)
+    end_balance: int  # 月末残高
+
+
+# {"YYYY-MM": {account: AccountMonth}}
+AccountReport = dict[str, dict[str, AccountMonth]]
