@@ -0,0 +1,76 @@
+"""Month-end account balances.
+
+D1: 残高の動き(D4 は account_types 参照): 支出 −amount(account)、返金(負の amount)は +、
+    振替は account から −amount、to_account へ +amount。
+D2: 開始残高 opening は最初の月の前の残高(既定 0)。rows に出ない口座も opening にあれば含める。
+D3: 返す月は rows の最初の月〜最後の月を連続で並べる(明細の無い月は前月末の残高を引き継ぐ)。
+    すべての月に、rows と opening に現れる全口座を含める(まだ動いていない口座は開始残高)。
+D4: rows が空なら {}(opening だけでは月が決まらない)。月は昇順、口座は名前昇順。
+D5: 同じ月の中の明細の順序は残高(月末)に影響しない。
+"""
+
+from __future__ import annotations
+
+from kakeibo.account_types import NO_ACCOUNT, NO_ACCOUNT_LABEL, Balances
+from kakeibo.core import Expense
+
+
+def _norm(name: str) -> str:
+    """D5: "(未指定)" は NO_ACCOUNT と同じ口座として扱う。"""
+    return NO_ACCOUNT if name == NO_ACCOUNT_LABEL else name
+
+
+def _month_key(year: int, month: int) -> str:
+    return f"{year:04d}-{month:02d}"
+
+
+def _month_range(first: tuple[int, int], last: tuple[int, int]) -> list[str]:
+    """first 〜 last(両端含む)の月キーを昇順で連続して返す。"""
+    out: list[str] = []
+    y, m = first
+    while (y, m) <= last:
+        out.append(_month_key(y, m))
+        m += 1
+        if m > 12:
+            y, m = y + 1, 1
+    return out
+
+
+def monthly_balances(
+    rows: list[Expense], opening: dict[str, int] | None = None
+) -> Balances:
+    """{"YYYY-MM": {account: end-of-month balance}} with gap months filled."""
+    if not rows:
+        return {}
+
+    start: dict[str, int] = {}
+    for name, yen in (opening or {}).items():
+        key = _norm(name)
+        start[key] = start.get(key, 0) + yen
+
+    # 月ごとの増減(R2, R3)と、全口座の集合(R5)
+    deltas: dict[str, dict[str, int]] = {}
+    accounts: set[str] = set(start)
+    for e in rows:
+        month = _month_key(e.day.year, e.day.month)
+        bucket = deltas.setdefault(month, {})
+        src = _norm(e.account)
+        accounts.add(src)
+        bucket[src] = bucket.get(src, 0) - e.amount
+        if e.is_transfer:
+            dst = _norm(e.to_account)
+            accounts.add(dst)
+            bucket[dst] = bucket.get(dst, 0) + e.amount
+
+    first = min(e.day for e in rows)
+    last = max(e.day for e in rows)
+    months = _month_range((first.year, first.month), (last.year, last.month))
+
+    running = {a: start.get(a, 0) for a in accounts}
+    result: Balances = {}
+    for month in months:
+        for acct, delta in deltas.get(month, {}).items():
+            running[acct] += delta
+        # R4: 明細の無い月は前月末をそのまま引き継ぐ。R5: 口座は名前昇順。
+        result[month] = {a: running[a] for a in sorted(accounts)}
+    return result
