+
+
+def _transfer(day: date, amount: int, src: str, dst: str) -> Expense:
+    return Expense(day=day, category="振替", amount=amount, account=src, to_account=dst)
+
+
+@pytest.mark.parametrize(
+    ("case_id", "rows", "opening", "expected"),
+    [
+        pytest.param(
+            "E2-1",
+            [
+                _spend(date(2026, 1, 5), 300, "現金"),
+                _transfer(date(2026, 3, 2), 200, "銀行", "現金"),
+            ],
+            {"銀行": 1000},
+            {
+                "2026-01": {"現金": -300, "銀行": 1000},
+                "2026-02": {"現金": -300, "銀行": 1000},
+                "2026-03": {"現金": -100, "銀行": 800},
+            },
+            id="E2-1",
+        ),
+        pytest.param(
+            "E2-2",
+            [
+                _spend(date(2026, 12, 31), 100, "現金"),
+                _spend(date(2027, 1, 1), 100, "現金"),
+            ],
+            None,
+            {
+                "2026-12": {"現金": -100},
+                "2027-01": {"現金": -200},
+            },
+            id="E2-2",
+        ),
+        pytest.param(
+            "E2-3",
+            [
+                Expense(
+                    day=date(2026, 4, 1), category="返金", amount=-500, account="カード"
+                )
+            ],
+            None,
+            {"2026-04": {"カード": 500}},
+            id="E2-3",
+        ),
+    ],
+)
+def test_example_table(
+    case_id: str,
+    rows: list[Expense],
+    opening: dict[str, int] | None,
+    expected: dict[str, dict[str, int]],
+) -> None:
+    assert monthly_balances(rows, opening) == expected
+
+
+def test_empty_rows_returns_empty_even_with_opening() -> None:  # R6 / D4
+    assert monthly_balances([], {"銀行": 1000}) == {}
+    assert monthly_balances([]) == {}
+
+
+def test_opening_none_starts_all_accounts_at_zero() -> None:  # R6
+    rows = [_spend(date(2026, 2, 1), 50, "現金")]
+    assert monthly_balances(rows) == {"2026-02": {"現金": -50}}
+
+
+def test_gap_months_carry_previous_month_end() -> None:  # R4
+    rows = [
+        _spend(date(2026, 1, 1), 100, "現金"),
+        _spend(date(2026, 4, 1), 100, "現金"),
+    ]
+    result = monthly_balances(rows)
+    assert list(result) == ["2026-01", "2026-02", "2026-03", "2026-04"]
+    assert result["2026-02"] == {"現金": -100}
+    assert result["2026-03"] == {"現金": -100}
+    assert result["2026-04"] == {"現金": -200}
+
+
+def test_opening_only_account_is_included_in_every_month() -> None:  # R5 / D2
+    rows = [_spend(date(2026, 1, 1), 10, "現金")]
+    result = monthly_balances(rows, {"貯金": 5000})
+    assert result == {"2026-01": {"現金": -10, "貯金": 5000}}
+
+
+def test_accounts_sorted_by_name_and_no_account_included() -> None:  # R5
+    rows = [
+        _spend(date(2026, 1, 1), 10, "銀行"),
+        _spend(date(2026, 1, 2), 20, NO_ACCOUNT),
+    ]
+    result = monthly_balances(rows, {"カード": 0})
+    assert list(result["2026-01"]) == ["", "カード", "銀行"]
+    assert result["2026-01"] == {"": -20, "カード": 0, "銀行": -10}
+
+
+def test_unspecified_label_is_same_account_as_empty() -> None:  # D5
+    rows = [
+        _spend(date(2026, 1, 1), 10, NO_ACCOUNT),
+        _spend(date(2026, 1, 2), 20, "(未指定)"),
+    ]
+    assert monthly_balances(rows) == {"2026-01": {"": -30}}
+
+
+def test_unspecified_label_in_opening_matches_empty_account() -> None:  # D5
+    rows = [_spend(date(2026, 1, 1), 10, NO_ACCOUNT)]
+    assert monthly_balances(rows, {"(未指定)": 100}) == {"2026-01": {"": 90}}
+
+
+def test_refund_increases_balance() -> None:  # R2
+    rows = [
+        Expense(day=date(2026, 5, 1), category="返金", amount=-500, account="カード")
+    ]
+    assert monthly_balances(rows, {"カード": -1000}) == {"2026-05": {"カード": -500}}
+
+
+def test_transfer_is_not_counted_as_spending_but_moves_balance() -> None:  # R3
+    rows = [_transfer(date(2026, 6, 1), 300, "A", "B")]
+    assert monthly_balances(rows, {"A": 1000}) == {"2026-06": {"A": 700, "B": 300}}
+
+
+def test_order_of_rows_within_month_does_not_matter() -> None:  # D5
+    a = _spend(date(2026, 7, 1), 100, "現金")
+    b = _transfer(date(2026, 7, 9), 50, "現金", "銀行")
+    assert monthly_balances([a, b], {"現金": 500}) == monthly_balances(
+        [b, a], {"現金": 500}
+    )
+
+
+def test_month_range_crosses_year_boundary() -> None:  # R4 / E2-2
+    rows = [
+        _spend(date(2026, 11, 1), 1, "現金"),
+        _spend(date(2027, 2, 1), 1, "現金"),
+    ]
+    assert list(monthly_balances(rows)) == ["2026-11", "2026-12", "2027-01", "2027-02"]
