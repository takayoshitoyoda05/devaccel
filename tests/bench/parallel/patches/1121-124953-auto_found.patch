+import pytest
+
+from kakeibo import main
+
+CSV = (
+    "date,category,amount,memo,account,to_account\n"
+    "2026-01-05,food,300,lunch,現金,\n"
+    "2026-01-10,,1000,atm,銀行,現金\n"
+    "2026-01-20,food,2000,shop,カード,\n"
+    "2026-03-02,rent,800,,銀行,\n"
+    "2026-03-03,misc,50,,,\n"
+)
+
+
+@pytest.fixture
+def csv_path(tmp_path):
+    p = tmp_path / "in.csv"
+    p.write_text(CSV, encoding="utf-8")
+    return p
+
+
+def run(monkeypatch, capsys, *argv):
+    monkeypatch.setattr("sys.argv", ["kakeibo", *argv])
+    try:
+        main()
+        code = 0
+    except SystemExit as e:
+        code = e.code
+    cap = capsys.readouterr()
+    return code, cap.out, cap.err
+
+
+def test_default_output_excludes_transfers(csv_path, monkeypatch, capsys):
+    code, out, _ = run(monkeypatch, capsys, str(csv_path))
+    assert code == 0
+    assert out == "food\t2,300\nrent\t800\nmisc\t50\n"
+
+
+def test_account_filter_on_default_output(csv_path, monkeypatch, capsys):
+    code, out, _ = run(monkeypatch, capsys, str(csv_path), "--account", "現金")
+    assert (code, out) == (0, "food\t300\n")  # the incoming transfer is not spending
+
+
+def test_account_filter_unspecified_label(csv_path, monkeypatch, capsys):
+    _, out, _ = run(monkeypatch, capsys, str(csv_path), "--account", "(未指定)")
+    assert out == "misc\t50\n"
+
+
+def test_account_filter_no_match_notifies(csv_path, monkeypatch, capsys):
+    code, out, err = run(monkeypatch, capsys, str(csv_path), "--account", "nope")
+    assert (code, out) == (0, "")
+    assert "nope" in err
+
+
+def test_account_filter_combines_with_memo_and_report(csv_path, monkeypatch, capsys):
+    _, out, _ = run(
+        monkeypatch,
+        capsys,
+        str(csv_path),
+        "--report",
+        "--account",
+        "銀行",
+        "--memo",
+        "x",
+    )
+    assert out == ""
+    _, out, _ = run(monkeypatch, capsys, str(csv_path), "--report", "--account", "銀行")
+    assert out == "2026-03\trent\t800\n"
+
+
+def test_balance_with_opening(csv_path, monkeypatch, capsys):
+    code, out, _ = run(
+        monkeypatch, capsys, str(csv_path), "--balance", "--opening", "銀行=10,000"
+    )
+    assert code == 0
+    lines = out.splitlines()
+    assert "2026-01\t銀行\t9000" in lines
+    assert "2026-01\t現金\t700" in lines  # -300 + 1000
+    assert "2026-01\tカード\t-2000" in lines
+    assert "2026-02\t銀行\t9000" in lines  # gap month carries forward
+    assert "2026-03\t銀行\t8200" in lines
+    assert "2026-03\t(未指定)\t-50" in lines
+    assert len(lines) == 3 * 4
+
+
+def test_balance_account_filter_shows_only_that_account(csv_path, monkeypatch, capsys):
+    _, out, _ = run(
+        monkeypatch, capsys, str(csv_path), "--balance", "--account", "現金"
+    )
+    assert out.splitlines() == [
+        "2026-01\t現金\t700",
+        "2026-02\t現金\t700",
+        "2026-03\t現金\t700",
+    ]
+
+
+def test_account_report(csv_path, monkeypatch, capsys):
+    code, out, _ = run(monkeypatch, capsys, str(csv_path), "--account-report")
+    assert code == 0
+    lines = out.splitlines()
+    assert "2026-01\t現金\t300\t1000\t0\t700" in lines
+    assert "2026-01\t銀行\t0\t0\t1000\t-1000" in lines
+    assert "2026-02\tカード\t0\t0\t0\t-2000" in lines
+
+
+def test_bad_opening_exits_2(csv_path, monkeypatch, capsys):
+    code, out, err = run(
+        monkeypatch, capsys, str(csv_path), "--balance", "--opening", "x"
+    )
+    assert (code, out) == (2, "")
+    assert "x" in err
+
+
+def test_report_modes_are_exclusive(csv_path, monkeypatch, capsys):
+    code, out, _ = run(monkeypatch, capsys, str(csv_path), "--balance", "--report")
+    assert (code, out) == (2, "")
+
+
+def test_budget_ignores_transfers(csv_path, monkeypatch, capsys, tmp_path):
+    b = tmp_path / "b.json"
+    b.write_text('{"default": {"food": 2000}}', encoding="utf-8")
+    code, _, err = run(monkeypatch, capsys, str(csv_path), "--budget", str(b))
+    assert code == 0
+    assert "food" in err and "300円超過" in err
