index 0000000..75e06e7
--- /dev/null
+++ b/tests/test_types/test_Path_extensions.py
@@ -0,0 +1,146 @@
+import pathlib
+
+import pytest
+
+import click
+
+
+def convert(type_, value):
+    return type_.convert(value, None, None)
+
+
+@pytest.mark.parametrize(
+    "name", ["a.csv", "a.tsv", "A.CSV", "a.Tsv", "dir.d/a.csv", "a.b.csv"]
+)
+def test_allowed(name):
+    t = click.Path(extensions=(".csv", ".tsv"))
+    assert convert(t, name) == name
+
+
+@pytest.mark.parametrize("name", ["a.txt", "a", "a.csv.bak", "csv", "a.csvx", ".csv"])
+def test_rejected(name):
+    t = click.Path(extensions=(".csv", ".tsv"))
+
+    with pytest.raises(click.BadParameter, match="must have one of these extensions"):
+        convert(t, name)
+
+
+def test_message_lists_extensions():
+    t = click.Path(extensions=["csv", ".TSV"])
+
+    with pytest.raises(click.BadParameter, match=r"\.csv, \.tsv"):
+        convert(t, "a.txt")
+
+
+def test_dot_optional_and_case_insensitive_spec():
+    t = click.Path(extensions=["CSV"])
+    assert convert(t, "a.csv") == "a.csv"
+    assert t.extensions == (".csv",)
+
+
+def test_multi_part_extension():
+    t = click.Path(extensions=[".tar.gz"])
+    assert convert(t, "x.TAR.GZ") == "x.TAR.GZ"
+
+    with pytest.raises(click.BadParameter):
+        convert(t, "x.gz")
+
+
+def test_default_accepts_anything():
+    assert convert(click.Path(), "a.whatever") == "a.whatever"
+
+
+def test_checked_for_missing_file_without_exists():
+    with pytest.raises(click.BadParameter):
+        convert(click.Path(extensions=[".csv"]), "no-such.txt")
+
+
+def test_existing_file(tmp_path):
+    good = tmp_path / "a.CSV"
+    bad = tmp_path / "a.txt"
+    good.touch()
+    bad.touch()
+    t = click.Path(exists=True, extensions=[".csv"])
+    assert convert(t, str(good)) == str(good)
+
+    with pytest.raises(click.BadParameter, match="extensions"):
+        convert(t, str(bad))
+
+
+def test_missing_file_with_exists_reports_nonexistence(tmp_path):
+    t = click.Path(exists=True, extensions=[".csv"])
+
+    with pytest.raises(click.BadParameter, match="does not exist"):
+        convert(t, str(tmp_path / "nope.csv"))
+
+
+def test_directory_is_not_checked(tmp_path):
+    d = tmp_path / "data.d"
+    d.mkdir()
+    t = click.Path(exists=True, extensions=[".csv"])
+    assert convert(t, str(d)) == str(d)
+
+
+def test_dash_is_not_checked():
+    t = click.Path(allow_dash=True, extensions=[".csv"])
+    assert convert(t, "-") == "-"
+
+    with pytest.raises(click.BadParameter):
+        convert(click.Path(extensions=[".csv"]), "-")
+
+
+def test_bytes_and_pathlib():
+    t = click.Path(extensions=[".csv"])
+    assert convert(t, b"a.CSV") == b"a.CSV"
+    assert convert(t, pathlib.PurePath("a.csv")) == pathlib.PurePath("a.csv")
+
+    with pytest.raises(click.BadParameter):
+        convert(t, b"a.txt")
+
+
+def test_path_type_still_applies():
+    t = click.Path(extensions=[".csv"], path_type=pathlib.Path)
+    assert convert(t, "a.csv") == pathlib.Path("a.csv")
+
+
+def test_duplicates_collapsed():
+    t = click.Path(extensions=[".csv", "CSV", ".csv"])
+    assert t.extensions == (".csv",)
+
+
+@pytest.mark.parametrize(
+    ("value", "exc"),
+    [
+        (".csv", TypeError),
+        (b".csv", TypeError),
+        ([], ValueError),
+        ([""], ValueError),
+        ([".csv", "."], ValueError),
+        ([1], TypeError),
+        ([None], TypeError),
+    ],
+)
+def test_invalid_extensions_argument(value, exc):
+    with pytest.raises(exc):
+        click.Path(extensions=value)
+
+
+def test_info_dict():
+    assert click.Path(extensions=["csv"]).to_info_dict()["extensions"] == [".csv"]
+    assert click.Path().to_info_dict()["extensions"] is None
+
+
+def test_as_option(runner):
+    @click.command()
+    @click.option("--f", type=click.Path(extensions=[".csv", ".tsv"]))
+    def cli(f):
+        click.echo(f)
+
+    ok = runner.invoke(cli, ["--f", "x.TSV"])
+    assert ok.exit_code == 0
+    assert ok.output == "x.TSV\n"
+
+    bad = runner.invoke(cli, ["--f", "x.json"])
+    assert bad.exit_code == 2
+    assert "Invalid value for '--f'" in bad.output
+    assert ".csv, .tsv" in bad.output
