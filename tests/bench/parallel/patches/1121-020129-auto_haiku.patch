+"""カテゴリ別の月予算に対する使いすぎ判定(純粋関数。I/O・print なし)。
+
+D1: 予算の値は int のみ受ける。bool・float・str・None は TypeError。負の予算は ValueError。
+D2: month は (年, 月)。月が 1〜12 の外なら ValueError。年・月が int 以外なら TypeError。
+D3: near_ratio は int/float(bool 除く)で 0 以上 1 以下。範囲外と NaN は ValueError。
+    比較は float 誤差を避けるため str(near_ratio) を Fraction にして行う(0.7 × 1000 = 700 が正しく出る)。
+D4: over は spent > budget。予算 0 で支出 > 0 も over(超過率は無限大扱いで同 status の先頭)。
+D5: near は 0 < spent かつ budget × near_ratio <= spent <= budget。
+    spent == 0 は near にしない(支出のないカテゴリは警告対象外)。
+D6: 返金などで spent が負になるカテゴリは ok(返さない)。
+D7: カテゴリ名は完全一致で照合する。予算にないカテゴリの支出は無視する。
+D8: 並び: over が先、次に near。同じ status は超過率 spent/budget の大きい順、同点はカテゴリ名の昇順。
+D9: 支出の無いカテゴリ(予算 0 を含む)は ok なので返らない。
+"""
+
+from __future__ import annotations
+
+import math
+from collections import defaultdict
+from dataclasses import dataclass
+from fractions import Fraction
+from typing import Literal
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class BudgetAlert:
+    category: str
+    spent: int
+    budget: int
+    status: Literal["over", "near"]
+
+
+def _require_int(value: object, where: str) -> int:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(f"{where} は int である必要があります: {value!r}")
+    return value
+
+
+def check_budgets(
+    expenses: list[Expense],
+    budgets: dict[str, int],
+    month: tuple[int, int],
+    near_ratio: float = 0.8,
+) -> list[BudgetAlert]:
+    """month(年, 月)の支出をカテゴリ別に合計し、予算に対して over / near のものを返す。"""
+    year = _require_int(month[0], "month の年")
+    mon = _require_int(month[1], "month の月")
+    if not 1 <= mon <= 12:
+        raise ValueError(f"month の月は 1〜12 である必要があります: {mon}")
+
+    if isinstance(near_ratio, bool) or not isinstance(near_ratio, (int, float)):
+        raise TypeError(f"near_ratio は数値である必要があります: {near_ratio!r}")
+    if not 0 <= near_ratio <= 1:  # NaN もここで弾かれる
+        raise ValueError(
+            f"near_ratio は 0 以上 1 以下である必要があります: {near_ratio}"
+        )
+    ratio = Fraction(str(near_ratio))
+
+    for cat, limit in budgets.items():
+        _require_int(limit, f"budgets[{cat!r}]")
+        if limit < 0:
+            raise ValueError(f"予算は 0 以上である必要があります: {cat!r}={limit}")
+
+    spent: dict[str, int] = defaultdict(int)
+    for e in expenses:
+        if e.day.year == year and e.day.month == mon:
+            spent[e.category] += e.amount
+
+    alerts: list[BudgetAlert] = []
+    for cat, limit in budgets.items():
+        s = spent.get(cat, 0)
+        if s > limit:
+            status: Literal["over", "near"] = "over"
+        elif s > 0 and s >= limit * ratio:
+            # elif に来た時点で s <= limit。near のときは limit > 0 が保証される。
+            status = "near"
+        else:
+            continue
+        alerts.append(BudgetAlert(cat, s, limit, status))
+
+    def order(a: BudgetAlert) -> tuple[int, float | Fraction, str]:
+        rank = 0 if a.status == "over" else 1
+        rate = Fraction(a.spent, a.budget) if a.budget else math.inf
+        return (rank, -rate, a.category)
+
+    return sorted(alerts, key=order)
diff --git a/tests/test_budget_alert.py b/tests/test_budget_alert.py
new file mode 100644
index 0000000..7216751
--- /dev/null
+++ b/tests/test_budget_alert.py
@@ -0,0 +1,188 @@
+from dataclasses import FrozenInstanceError
+from datetime import date
+
+import pytest
+
+from kakeibo.budget_alert import BudgetAlert, check_budgets
+from kakeibo.core import Expense
+
+NOV = (2026, 11)
+
+
+def _food(
+    amount: int, day: date = date(2026, 11, 1), category: str = "food"
+) -> Expense:
+    return Expense(day, category, amount)
+
+
+def _one(spent: int, limit: int = 1000, ratio: float = 0.8) -> list[BudgetAlert]:
+    return check_budgets([_food(spent)], {"food": limit}, NOV, ratio)
+
+
+def test_example_boundaries():
+    assert _one(800) == [BudgetAlert("food", 800, 1000, "near")]
+    assert _one(1000) == [BudgetAlert("food", 1000, 1000, "near")]
+    assert _one(1001) == [BudgetAlert("food", 1001, 1000, "over")]
+    assert _one(799) == []
+
+
+def test_zero_spend_is_not_reported():
+    assert check_budgets([], {"food": 1000}, NOV) == []
+    assert _one(0) == []
+
+
+def test_float_ratio_is_exact_at_boundary():
+    # 0.7 * 1000 を float で計算すると誤差が出うるので、境界は厳密に判定する
+    assert _one(700, ratio=0.7) == [BudgetAlert("food", 700, 1000, "near")]
+    assert _one(699, ratio=0.7) == []
+
+
+def test_near_ratio_one_only_at_exact_budget():
+    assert _one(1000, ratio=1) == [BudgetAlert("food", 1000, 1000, "near")]
+    assert _one(999, ratio=1) == []
+    assert _one(1001, ratio=1) == [BudgetAlert("food", 1001, 1000, "over")]
+
+
+def test_near_ratio_zero_keeps_any_positive_spend_near():
+    assert _one(1, ratio=0) == [BudgetAlert("food", 1, 1000, "near")]
+    assert _one(0, ratio=0) == []
+
+
+def test_only_selected_month_is_summed():
+    rows = [
+        _food(600, date(2026, 11, 1)),
+        _food(300, date(2026, 11, 30)),
+        _food(5000, date(2026, 10, 31)),  # 前月
+        _food(5000, date(2025, 11, 15)),  # 前年の同月
+        _food(5000, date(2027, 11, 15)),  # 翌年の同月
+    ]
+    assert check_budgets(rows, {"food": 1000}, (2026, 11)) == [
+        BudgetAlert("food", 900, 1000, "near")
+    ]
+    assert check_budgets(rows, {"food": 1000}, (2026, 10)) == [
+        BudgetAlert("food", 5000, 1000, "over")
+    ]
+
+
+def test_multiple_rows_of_one_category_are_summed():
+    rows = [_food(400), _food(400), _food(201)]
+    assert check_budgets(rows, {"food": 1000}, NOV) == [
+        BudgetAlert("food", 1001, 1000, "over")
+    ]
+
+
+def test_category_without_budget_is_ignored():
+    rows = [_food(9999, category="rent"), _food(100)]
+    assert check_budgets(rows, {"food": 1000}, NOV) == []
+
+
+def test_category_name_matches_exactly():
+    # D7: 大文字小文字・前後空白は同一視しない
+    rows = [_food(900, category="Food"), _food(900, category="food ")]
+    assert check_budgets(rows, {"food": 1000}, NOV) == []
+    assert check_budgets(rows, {"Food": 1000}, NOV) == [
+        BudgetAlert("Food", 900, 1000, "near")
+    ]
+
+
+def test_budget_without_expense_is_ignored():
+    assert check_budgets([_food(900)], {"food": 1000, "rent": 80000}, NOV) == [
+        BudgetAlert("food", 900, 1000, "near")
+    ]
+
+
+def test_zero_budget():
+    assert check_budgets([], {"food": 0}, NOV) == []
+    assert check_budgets([_food(0)], {"food": 0}, NOV) == []
+    assert check_budgets([_food(1)], {"food": 0}, NOV) == [
+        BudgetAlert("food", 1, 0, "over")
+    ]
+
+
+def test_refund_makes_spend_negative_and_not_reported():
+    assert check_budgets([_food(-500)], {"food": 1000}, NOV) == []
+    # 支出と返金を合わせて 800 になれば near
+    assert check_budgets([_food(1200), _food(-400)], {"food": 1000}, NOV) == [
+        BudgetAlert("food", 800, 1000, "near")
+    ]
+
+
+def test_order_over_before_near_then_ratio_then_name():
+    rows = [
+        _food(850, category="near_b"),
+        _food(850, category="near_a"),
+        _food(1500, category="over_small"),  # 超過率 1.5
+        _food(3000, category="over_big"),  # 超過率 3.0
+        _food(1100, category="over_tie_b"),  # 超過率 1.1
+        _food(1100, category="over_tie_a"),
+    ]
+    budgets = {
+        "near_a": 1000,
+        "near_b": 1000,
+        "over_small": 1000,
+        "over_big": 1000,
+        "over_tie_a": 1000,
+        "over_tie_b": 1000,
+    }
+    got = [a.category for a in check_budgets(rows, budgets, NOV)]
+    assert got == [
+        "over_big",
+        "over_small",
+        "over_tie_a",
+        "over_tie_b",
+        "near_a",
+        "near_b",
+    ]
+
+
+def test_zero_budget_over_sorts_first_among_over():
+    rows = [_food(1, category="zero"), _food(2000, category="big")]
+    got = check_budgets(rows, {"zero": 0, "big": 1000}, NOV)
+    assert [a.category for a in got] == ["zero", "big"]
+
+
+def test_empty_inputs():
+    assert check_budgets([], {}, NOV) == []
+    assert check_budgets([_food(5000)], {}, NOV) == []
+
+
+def test_alert_is_frozen():
+    a = BudgetAlert("food", 1, 2, "near")
+    with pytest.raises(FrozenInstanceError):
+        a.spent = 3  # type: ignore[misc]
+
+
+@pytest.mark.parametrize("ratio", [-0.1, 1.5, float("nan")])
+def test_near_ratio_out_of_range_raises(ratio):
+    with pytest.raises(ValueError):
+        check_budgets([], {"food": 1000}, NOV, near_ratio=ratio)
+
+
+@pytest.mark.parametrize("budget", [-1, -1000])
+def test_negative_budget_raises(budget):
+    with pytest.raises(ValueError):
+        check_budgets([], {"food": budget}, NOV)
+
+
+@pytest.mark.parametrize("budget", [True, 1000.0, "1000", None])
+def test_non_int_budget_raises_type_error(budget):
+    with pytest.raises(TypeError):
+        check_budgets([], {"food": budget}, NOV)  # type: ignore[dict-item]
+
+
+@pytest.mark.parametrize("ratio", [True, "0.8", None])
+def test_non_number_near_ratio_raises_type_error(ratio):
+    with pytest.raises(TypeError):
+        check_budgets([], {"food": 1000}, NOV, near_ratio=ratio)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("month", [(2026, 0), (2026, 13), (2026, -1)])
+def test_invalid_month_number_raises(month):
+    with pytest.raises(ValueError):
+        check_budgets([], {"food": 1000}, month)
+
+
+@pytest.mark.parametrize("month", [("2026", 11), (2026, "11"), (2026, True)])
+def test_non_int_month_raises_type_error(month):
+    with pytest.raises(TypeError):
+        check_budgets([], {"food": 1000}, month)  # type: ignore[arg-type]
