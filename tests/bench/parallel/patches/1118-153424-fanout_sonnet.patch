@@ -0,0 +1,94 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.query import QueryError, filter_rows, matches, tokenize
+
+
+def ex(category: str = "Food", memo: str = "lunch box") -> Expense:
+    return Expense(date(2024, 1, 1), category, 100, memo)
+
+
+def test_tokenize_basic():
+    assert tokenize("  ") == []
+    assert tokenize("(a)") == [("LPAREN", "("), ("TERM", "a"), ("RPAREN", ")")]
+
+
+def test_tokenize_quote():
+    assert tokenize('"a (b) c"') == [("TERM", "a (b) c")]
+
+
+def test_tokenize_quote_errors():
+    with pytest.raises(QueryError):
+        tokenize('"abc')
+    with pytest.raises(QueryError):
+        tokenize('""')
+
+
+def test_tokenize_keywords():
+    assert tokenize("AND OR NOT and") == [
+        ("AND", "AND"),
+        ("OR", "OR"),
+        ("NOT", "NOT"),
+        ("TERM", "and"),
+    ]
+
+
+def test_tokenize_cat():
+    assert tokenize("cat:food") == [("CAT", "food")]
+    with pytest.raises(QueryError):
+        tokenize("cat:")
+
+
+def test_tokenize_word_stops_at_paren_and_quote():
+    assert tokenize('a(b"c d"') == [
+        ("TERM", "a"),
+        ("LPAREN", "("),
+        ("TERM", "b"),
+        ("TERM", "c d"),
+    ]
+
+
+@pytest.mark.parametrize(
+    "q",
+    ["", "  ", "()", "(a", "a)", "a AND", "OR a", "a OR", "NOT", "a OR OR b", "AND"],
+)
+def test_syntax_errors(q):
+    with pytest.raises(QueryError):
+        matches(q, ex())
+
+
+def test_term_matches_memo_or_category_casefold():
+    assert matches("LUNCH", ex())
+    assert matches("food", ex())
+    assert not matches("dinner", ex())
+
+
+def test_cat_exact():
+    assert matches("cat:FOOD", ex())
+    assert not matches("cat:foo", ex())
+
+
+def test_implicit_and_and_precedence():
+    e = ex()
+    assert matches("lunch food", e)
+    assert not matches("lunch dinner", e)
+    assert matches("dinner OR lunch food", e)
+    assert not matches("NOT lunch food", e)
+    assert matches("NOT dinner food", e)
+    assert matches("lunch AND food", e)
+
+
+def test_parens_and_not():
+    e = ex()
+    assert matches("(dinner OR lunch) AND food", e)
+    assert not matches("NOT (dinner OR lunch)", e)
+    assert matches("NOT NOT lunch", e)
+
+
+def test_filter_rows_order_and_invalid():
+    a, b, c = ex("Food", "x"), ex("Misc", "y"), ex("Food", "z")
+    assert filter_rows("cat:food", [a, b, c]) == [a, c]
+    with pytest.raises(QueryError):
+        filter_rows("(", [])
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..8ca68d9
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,126 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.recurring import Recurring, add_month, find_recurring
+
+
+def e(d: date, cat: str = "rent", amount: int = 1000, memo: str = "") -> Expense:
+    return Expense(d, cat, amount, memo)
+
+
+def test_add_month_cases():
+    assert add_month(date(2026, 1, 31)) == date(2026, 2, 28)
+    assert add_month(date(2024, 1, 31)) == date(2024, 2, 29)
+    assert add_month(date(2026, 12, 15)) == date(2027, 1, 15)
+    assert add_month(date(2026, 3, 31)) == date(2026, 4, 30)
+    assert add_month(date(2026, 5, 10)) == date(2026, 6, 10)
+
+
+def test_invalid_args():
+    with pytest.raises(ValueError):
+        find_recurring([], min_count=1)
+    with pytest.raises(ValueError):
+        find_recurring([], tolerance=-1)
+
+
+def test_empty():
+    assert find_recurring([]) == []
+
+
+def test_basic_and_memo_ignored():
+    rows = [
+        e(date(2026, 1, 5), memo="a"),
+        e(date(2026, 2, 5), memo="b"),
+        e(date(2026, 3, 5), memo="c"),
+    ]
+    assert find_recurring(rows) == [
+        Recurring(
+            "rent",
+            1000,
+            (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5)),
+            date(2026, 4, 5),
+        )
+    ]
+
+
+def test_below_min_count():
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 5))]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_count=2)) == 1
+
+
+def test_duplicates_removed_and_unsorted():
+    rows = [
+        e(date(2026, 3, 5)),
+        e(date(2026, 1, 5)),
+        e(date(2026, 1, 5)),
+        e(date(2026, 2, 5)),
+    ]
+    r = find_recurring(rows)
+    assert len(r) == 1
+    assert r[0].days == (date(2026, 1, 5), date(2026, 2, 5), date(2026, 3, 5))
+
+
+def test_duplicates_do_not_count_twice():
+    rows = [e(date(2026, 1, 5)), e(date(2026, 1, 5)), e(date(2026, 2, 5))]
+    assert find_recurring(rows) == []
+
+
+def test_tolerance_boundary():
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 8)), e(date(2026, 3, 11))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+    assert find_recurring(rows, tolerance=2) == []
+    # tolerance 0 は完全一致のみ(月末の丸めも一致とみなす)
+    exact = [e(date(2026, 1, 31)), e(date(2026, 2, 28)), e(date(2026, 3, 28))]
+    assert len(find_recurring(exact, tolerance=0)) == 1
+    off = [e(date(2026, 1, 5)), e(date(2026, 2, 6)), e(date(2026, 3, 6))]
+    assert find_recurring(off, tolerance=0) == []
+
+
+def test_negative_side_tolerance():
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 2)), e(date(2026, 3, 1))]
+    assert len(find_recurring(rows, tolerance=3)) == 1
+
+
+def test_split_runs():
+    rows = [e(date(2026, m, 5)) for m in (1, 2, 3)] + [
+        e(date(2026, m, 5)) for m in (6, 7, 8, 9)
+    ]
+    r = find_recurring(rows)
+    assert [len(x.days) for x in r] == [3, 4]
+    assert r[0].next_expected == date(2026, 4, 5)
+    assert r[1].next_expected == date(2026, 10, 5)
+
+
+def test_short_run_dropped_long_kept():
+    rows = [e(date(2026, 1, 5)), e(date(2026, 2, 5))] + [
+        e(date(2026, m, 5)) for m in (5, 6, 7)
+    ]
+    r = find_recurring(rows)
+    assert len(r) == 1
+    assert r[0].days[0] == date(2026, 5, 5)
+
+
+def test_groups_by_category_and_amount_sorted():
+    rows = []
+    for cat, amt in [("b", 1), ("a", 2), ("a", 1)]:
+        rows += [e(date(2026, m, 1), cat, amt) for m in (1, 2, 3)]
+    r = find_recurring(rows)
+    assert [(x.category, x.amount) for x in r] == [("a", 1), ("a", 2), ("b", 1)]
+
+
+def test_different_amount_not_mixed():
+    rows = [
+        e(date(2026, 1, 5), amount=1),
+        e(date(2026, 2, 5), amount=2),
+        e(date(2026, 3, 5), amount=1),
+    ]
+    assert find_recurring(rows) == []
+
+
+def test_month_end_chain():
+    rows = [e(date(2026, 1, 31)), e(date(2026, 2, 28)), e(date(2026, 3, 31))]
+    r = find_recurring(rows, tolerance=0)
+    assert r == []  # 2/28 -> 3/28 であり 3/31 とは 3 日ずれる
