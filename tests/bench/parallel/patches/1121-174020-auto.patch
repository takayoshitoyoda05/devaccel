diff --git a/src/kakeibo/core.py b/src/kakeibo/core.py
index 8c3cbab..58d694e 100644
--- a/src/kakeibo/core.py
+++ b/src/kakeibo/core.py
@@ -1,4 +1,13 @@
-"""Expense records and aggregation."""
+"""Expense records and aggregation.
+
+Budget alert decisions (find_budget_alerts):
+D1: 注意 = actual/limit が 90% 以上 100% 以下(整数演算。89.9% は対象外)。
+D2: 超過 = actual > limit。ちょうど 100% は超過ではなく注意。
+D3: 割合は整数に切り捨て(1001/1000 → 100%、999/1000 → 99%)。
+D4: limit 0 は割合なし(0 割り回避)。actual > 0 なら超過、actual 0 は対象外。
+D5: actual が 0 以下(返金のみ)は対象外。
+D6: 予算のないカテゴリは対象外。
+"""
 
 from __future__ import annotations
 
@@ -122,6 +131,37 @@ def load_budget(path: Path) -> Budget:
     return Budget(default, months)
 
 
+def budget_percent(actual: int, limit: int) -> int | None:
+    """actual/limit in whole percent (floored); None when limit is 0."""
+    if limit <= 0:
+        return None
+    return actual * 100 // limit
+
+
+def find_budget_alerts(
+    totals: dict[str, dict[str, int]], budget: Budget, near_pct: int = 90
+) -> list[tuple[str, str, str, int, int, int | None]]:
+    """(month, category, kind, limit, actual, percent) for over / near budget.
+
+    kind is "over" (actual > limit) or "near" (near_pct% <= actual/limit <= 100%).
+    Compared with integers, so 89.99% is not near. limit 0 can only be "over"
+    (percent None); actual <= 0 never alerts.
+    """
+    out: list[tuple[str, str, str, int, int, int | None]] = []
+    for month, cats in totals.items():
+        limits = budget.for_month(month)
+        for cat, actual in cats.items():
+            if cat not in limits or actual <= 0:
+                continue
+            limit = limits[cat]
+            pct = budget_percent(actual, limit)
+            if actual > limit:
+                out.append((month, cat, "over", limit, actual, pct))
+            elif actual * 100 >= limit * near_pct:
+                out.append((month, cat, "near", limit, actual, pct))
+    return out
+
+
 def find_overruns(
