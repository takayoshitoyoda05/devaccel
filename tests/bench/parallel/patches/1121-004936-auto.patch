@@ -0,0 +1,102 @@
+"""Month-over-month comparison of per-category spending.
+
+Pure functions only. Builds on ``core.monthly_totals`` (no second copy of the
+monthly aggregation) and ``core.Expense``.
+
+Decisions:
+D1: Input is ``list[Expense]`` (or the ``{"YYYY-MM": {category: yen}}`` dict
+    that ``monthly_totals`` returns); aggregation is delegated to core.
+D2: Months missing between the first and last month are treated as empty months
+    (every category 0) and appear in the result. A category in January and not in
+    February is "gone" in February; if it returns in March it is "new" again.
+D3: The first month is compared with an empty month: all its categories are "new".
+D4: Status is decided by presence of the category in the month: absent before and
+    present now = "new"; present before and absent now = "gone"; present in both
+    = "increased" / "decreased" / "unchanged" by the sign of the delta.
+D5: ``delta`` = current - previous (a missing side counts as 0). ``ratio`` =
+    delta / abs(previous) as a fraction (0.5 = +50%), or None when previous is 0
+    (new categories, or a zero total last month).
+D6: Within a month, entries are sorted by abs(delta) descending, ties by category
+    name ascending. Months are ascending.
+D7: Refunds (negative amounts) are simply summed into the category total; a
+    category whose total is 0 is still "present".
+D8: Empty input gives an empty list; a single month gives one month of "new".
+D9: Month stepping crosses year boundaries (2025-12 -> 2026-01).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Literal
+
+from kakeibo.core import Expense, monthly_totals
+
+Status = Literal["increased", "decreased", "unchanged", "new", "gone"]
+
+
+@dataclass(frozen=True)
+class CategoryChange:
+    category: str
+    previous: int
+    current: int
+    delta: int
+    ratio: float | None
+    status: Status
+
+
+@dataclass(frozen=True)
+class MonthComparison:
+    month: str  # "YYYY-MM"
+    changes: tuple[CategoryChange, ...]
+
+
+def _index(month: str) -> int:
+    year, mon = month.split("-")
+    return int(year) * 12 + int(mon) - 1
+
+
+def _label(index: int) -> str:
+    return f"{index // 12:04d}-{index % 12 + 1:02d}"
+
+
+def _change(category: str, prev: int | None, cur: int | None) -> CategoryChange:
+    p = prev or 0
+    c = cur or 0
+    delta = c - p
+    ratio = None if p == 0 else delta / abs(p)
+    status: Status
+    if prev is None:
+        status = "new"
+    elif cur is None:
+        status = "gone"
+    elif delta > 0:
+        status = "increased"
+    elif delta < 0:
+        status = "decreased"
+    else:
+        status = "unchanged"
+    return CategoryChange(category, p, c, delta, ratio, status)
+
+
+def compare_totals(totals: dict[str, dict[str, int]]) -> list[MonthComparison]:
+    """Compare each month's category totals with the previous calendar month."""
+    if not totals:
+        return []
+    indexes = [_index(m) for m in totals]
+    by_index = {_index(m): cats for m, cats in totals.items()}
+    out: list[MonthComparison] = []
+    prev: dict[str, int] = {}
+    for i in range(min(indexes), max(indexes) + 1):
+        cur = by_index.get(i, {})
+        changes = [
+            _change(c, prev.get(c), cur.get(c)) for c in prev.keys() | cur.keys()
+        ]
+        changes.sort(key=lambda ch: (-abs(ch.delta), ch.category))
+        out.append(MonthComparison(_label(i), tuple(changes)))
+        prev = cur
+    return out
+
+
+def compare_months(rows: list[Expense]) -> list[MonthComparison]:
+    """Per-month, per-category spending with change versus the previous month."""
+    return compare_totals(monthly_totals(rows))
diff --git a/tests/test_monthly_diff.py b/tests/test_monthly_diff.py
new file mode 100644
index 0000000..63da145
--- /dev/null
+++ b/tests/test_monthly_diff.py
@@ -0,0 +1,94 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.monthly_diff import compare_months, compare_totals
+
+
+def e(d: str, cat: str, amount: int) -> Expense:
+    return Expense(date.fromisoformat(d), cat, amount)
+
+
+def by_cat(month):
+    return {c.category: c for c in month.changes}
+
+
+def test_empty_input():
+    assert compare_months([]) == []
+
+
+def test_first_month_is_all_new():
+    (m,) = compare_months([e("2026-01-05", "food", 1000)])
+    ch = by_cat(m)["food"]
+    assert (m.month, ch.status, ch.previous, ch.current, ch.ratio) == (
+        "2026-01",
+        "new",
+        0,
+        1000,
+        None,
+    )
+
+
+def test_increase_decrease_unchanged_new_gone():
+    rows = [
+        e("2026-01-01", "food", 1000),
+        e("2026-01-02", "rent", 5000),
+        e("2026-01-03", "fun", 800),
+        e("2026-01-04", "gas", 300),
+        e("2026-02-01", "food", 1500),
+        e("2026-02-02", "rent", 5000),
+        e("2026-02-03", "fun", 400),
+        e("2026-02-04", "tea", 200),
+    ]
+    feb = by_cat(compare_months(rows)[1])
+    assert feb["food"].status == "increased" and feb["food"].ratio == 0.5
+    assert feb["fun"].status == "decreased" and feb["fun"].ratio == -0.5
+    assert feb["rent"].status == "unchanged" and feb["rent"].delta == 0
+    assert feb["tea"].status == "new" and feb["tea"].ratio is None
+    assert feb["gas"].status == "gone" and feb["gas"].current == 0
+    assert feb["gas"].delta == -300
+
+
+def test_amounts_summed_within_month():
+    rows = [e("2026-01-01", "food", 100), e("2026-01-20", "food", 200)]
+    assert by_cat(compare_months(rows)[0])["food"].current == 300
+
+
+def test_gap_month_is_empty_month():
+    rows = [e("2026-01-10", "food", 1000), e("2026-03-10", "food", 700)]
+    months = compare_months(rows)
+    assert [m.month for m in months] == ["2026-01", "2026-02", "2026-03"]
+    assert by_cat(months[1])["food"].status == "gone"
+    assert by_cat(months[2])["food"].status == "new"
+
+
+def test_year_boundary():
+    rows = [e("2025-12-31", "food", 100), e("2026-01-01", "food", 150)]
+    months = compare_months(rows)
+    assert [m.month for m in months] == ["2025-12", "2026-01"]
+    assert by_cat(months[1])["food"].status == "increased"
+
+
+def test_sort_by_abs_delta_then_name():
+    totals = {
+        "2026-01": {"a": 100, "b": 100, "c": 100},
+        "2026-02": {"a": 150, "b": 50, "c": 400},
+    }
+    names = [c.category for c in compare_totals(totals)[1].changes]
+    assert names == ["c", "a", "b"]  # |300|, then |50| tie -> name order
+
+
+def test_zero_previous_total_has_no_ratio():
+    totals = {"2026-01": {"x": 0}, "2026-02": {"x": 100}}
+    ch = by_cat(compare_totals(totals)[1])["x"]
+    assert ch.status == "increased" and ch.ratio is None and ch.delta == 100
+
+
+def test_negative_total_ratio_uses_abs_previous():
+    totals = {"2026-01": {"x": -100}, "2026-02": {"x": 100}}
+    ch = by_cat(compare_totals(totals)[1])["x"]
+    assert ch.delta == 200 and ch.ratio == 2.0
+
+
+def test_months_ascending_regardless_of_row_order():
+    rows = [e("2026-03-01", "a", 1), e("2026-01-01", "a", 1)]
+    assert [m.month for m in compare_months(rows)] == ["2026-01", "2026-02", "2026-03"]
