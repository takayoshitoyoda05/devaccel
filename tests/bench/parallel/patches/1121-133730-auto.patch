+"""Month-over-month change of per-category spending (pure functions).
+
+Reuses ``core.monthly_totals`` for aggregation; this module only compares.
+
+D1: 入力は ``monthly_totals`` と同じ ``{"YYYY-MM": {category: yen}}``。月の形式が不正なら ValueError。
+D2: データに無い途中の月は空の月(全カテゴリ無し)として比べる。1 月にあって 2 月に無ければ 2 月は「なくなった」。
+D3: 最初の月は空の月と比べる(全カテゴリが「新しく出てきた」)。
+D4: 状態は new(前月に無く今月にある)/ removed(前月にあり今月に無い)/
+    up / down / same(両月にある)。合計 0 円でもキーがあれば「ある」。
+D5: 増減率は前月が 0 円(new を含む)のとき None(0 で割らない)。それ以外は % を float で返す。
+D6: 並びは月の昇順、月の中は 増減額の絶対値の降順、同点はカテゴリ名の昇順。
+D7: 負の金額(返金)はそのまま足し引きされ、検証しない。
+D8: 入力の dict は変更しない。空の入力は空のリストを返す。
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from typing import Literal
+
+from kakeibo.core import Expense, monthly_totals
+
+Status = Literal["new", "removed", "up", "down", "same"]
+
+_MONTH_RE = re.compile(r"([0-9]{4})-(0[1-9]|1[0-2])")
+
+
+@dataclass(frozen=True)
+class Change:
+    month: str
+    category: str
+    previous: int  # yen; 0 if absent last month
+    current: int  # yen; 0 if absent this month
+    status: Status
+
+    @property
+    def diff(self) -> int:
+        return self.current - self.previous
+
+    @property
+    def pct(self) -> float | None:
+        if self.previous == 0:
+            return None
+        return self.diff / self.previous * 100
+
+
+def _parse_month(m: str) -> tuple[int, int]:
+    match = _MONTH_RE.fullmatch(m) if isinstance(m, str) else None
+    if match is None:
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {m!r}")
+    return int(match.group(1)), int(match.group(2))
+
+
+def _next_month(m: str) -> str:
+    y, mo = _parse_month(m)
+    y, mo = (y + 1, 1) if mo == 12 else (y, mo + 1)
+    return f"{y:04d}-{mo:02d}"
+
+
+def _status(prev: dict[str, int], cur: dict[str, int], cat: str) -> Status:
+    if cat not in prev:
+        return "new"
+    if cat not in cur:
+        return "removed"
+    if cur[cat] > prev[cat]:
+        return "up"
+    if cur[cat] < prev[cat]:
+        return "down"
+    return "same"
+
+
+def month_over_month(totals: dict[str, dict[str, int]]) -> list[Change]:
+    """Compare each month with the one before it (gaps count as empty months)."""
+    for m in totals:
+        _parse_month(m)
+    if not totals:
+        return []
+    months = sorted(totals)
+    out: list[Change] = []
+    prev: dict[str, int] = {}
+    m = months[0]
+    while m <= months[-1]:
+        cur = totals.get(m, {})
+        changes = [
+            Change(m, cat, prev.get(cat, 0), cur.get(cat, 0), _status(prev, cur, cat))
+            for cat in set(prev) | set(cur)
+        ]
+        changes.sort(key=lambda c: (-abs(c.diff), c.category))
+        out.extend(changes)
+        prev = cur
+        m = _next_month(m)
+    return out
+
+
+def expenses_month_over_month(rows: list[Expense]) -> list[Change]:
+    return month_over_month(monthly_totals(rows))
diff --git a/tests/test_trend.py b/tests/test_trend.py
new file mode 100644
index 0000000..83282e4
--- /dev/null
+++ b/tests/test_trend.py
@@ -0,0 +1,88 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.trend import expenses_month_over_month, month_over_month
+
+
+def by(changes, month):
+    return {c.category: c for c in changes if c.month == month}
+
+
+def test_up_down_same_new_removed():
+    t = {
+        "2026-01": {"食費": 1000, "交通": 500, "家賃": 800, "娯楽": 300},
+        "2026-02": {"食費": 1500, "交通": 200, "家賃": 800, "本": 400},
+    }
+    feb = by(month_over_month(t), "2026-02")
+    assert feb["食費"].status == "up" and feb["食費"].diff == 500
+    assert feb["食費"].pct == 50.0
+    assert feb["交通"].status == "down" and feb["交通"].diff == -300
+    assert feb["家賃"].status == "same" and feb["家賃"].diff == 0
+    assert feb["本"].status == "new" and feb["本"].pct is None
+    assert feb["娯楽"].status == "removed" and feb["娯楽"].current == 0
+    assert feb["娯楽"].pct == -100.0
+
+
+def test_first_month_all_new():
+    out = month_over_month({"2026-01": {"食費": 100}})
+    assert [(c.category, c.status) for c in out] == [("食費", "new")]
+
+
+def test_gap_month_counts_as_empty():
+    t = {"2026-01": {"食費": 100}, "2026-03": {"食費": 100}}
+    out = month_over_month(t)
+    assert by(out, "2026-02")["食費"].status == "removed"
+    assert by(out, "2026-03")["食費"].status == "new"
+
+
+def test_year_boundary_gap():
+    t = {"2025-12": {"a": 1}, "2026-02": {"a": 1}}
+    months = {c.month for c in month_over_month(t)}
+    assert months == {"2025-12", "2026-01", "2026-02"}
+
+
+def test_zero_previous_pct_none_but_not_new():
+    t = {"2026-01": {"a": 0}, "2026-02": {"a": 50}}
+    c = by(month_over_month(t), "2026-02")["a"]
+    assert c.status == "up" and c.pct is None
+
+
+def test_ordering_abs_diff_then_name():
+    t = {
+        "2026-01": {"b": 100, "a": 100, "c": 100},
+        "2026-02": {"b": 50, "a": 150, "c": 400},
+    }
+    feb = [c.category for c in month_over_month(t) if c.month == "2026-02"]
+    assert feb == ["c", "a", "b"]  # 300, then tie 50/50 by name
+
+
+def test_refund_negative_amount_passes_through():
+    t = {"2026-01": {"a": 100}, "2026-02": {"a": -50}}
+    c = by(month_over_month(t), "2026-02")["a"]
+    assert c.status == "down" and c.diff == -150 and c.pct == -150.0
+
+
+def test_empty_and_input_unchanged():
+    assert month_over_month({}) == []
+    t = {"2026-02": {"a": 1}, "2026-01": {"a": 2}}
+    snapshot = {k: dict(v) for k, v in t.items()}
+    month_over_month(t)
+    assert t == snapshot
+
+
+@pytest.mark.parametrize("bad", ["2026-13", "2026/01", "26-01", "", "2026-1"])
+def test_bad_month_raises(bad):
+    with pytest.raises(ValueError, match="月の形式"):
+        month_over_month({bad: {"a": 1}})
+
+
+def test_from_expenses():
+    rows = [
+        Expense(date(2026, 1, 5), "食費", 300),
+        Expense(date(2026, 1, 9), "食費", 200),
+        Expense(date(2026, 2, 1), "食費", 100),
+    ]
+    feb = by(expenses_month_over_month(rows), "2026-02")
+    assert feb["食費"].previous == 500 and feb["食費"].status == "down"
