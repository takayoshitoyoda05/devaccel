+def test_bad_rows_report_line_column_value_reason():
+    text = (
+        "利用日,利用店名,利用金額\n"  # 1
+        "2026/11/01,A,1200\n"  # 2
+        "2026/13/01,B,800\n"  # 3 日付不正
+        "2026/11/03,C,1,20\n"  # 4 列ずれ(カンマ未引用)→ 金額は '1'
+        '2026/11/04,D,"1,20"\n'  # 5 桁区切り不正
+        "昨日,E,abc\n"  # 6 日付も金額も不正
+        "2026/11/06\n"  # 7 列不足
+        "2026/11/07,F,\n"  # 8 金額空
+    )
+    r = import_statement(text)
+    assert not r.ok
+    assert [e.memo for e in r.expenses] == ["A", "C"]
+    assert r.issues == [
+        ImportIssue(
+            3, "利用日", "2026/13/01", "日付として解釈できません: '2026/13/01'"
+        ),
+        ImportIssue(5, "利用金額", "1,20", "桁区切りのカンマ位置が不正です: '1,20'"),
+        ImportIssue(6, "利用日", "昨日", "日付として解釈できません: '昨日'"),
+        ImportIssue(6, "利用金額", "abc", "金額として解釈できません: 'abc'"),
+        ImportIssue(7, None, None, "列数が足りません(1 列 / ヘッダは 3 列)"),
+        ImportIssue(8, "利用金額", "", "金額が空です"),
+    ]
