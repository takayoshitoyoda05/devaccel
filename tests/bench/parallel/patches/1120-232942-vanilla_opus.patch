@@ -0,0 +1,306 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.importer import (
+    ImportFormatError,
+    ImportIssue,
+    ImportProfile,
+    decode_bytes,
+    import_statement,
+    parse_amount,
+    parse_date,
+)
+
+# ---------------------------------------------------------------- parse_amount
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("1200", 1200),
+        ("1,200", 1200),
+        ("1,234,567", 1234567),
+        ("¥1,200", 1200),
+        ("\\1,200", 1200),  # CP932 で ¥ が \ になったもの
+        ("1,200円", 1200),
+        ("１，２００", 1200),  # 全角
+        ("￥１，２００円", 1200),
+        (" 1200 ", 1200),
+        ("+1200", 1200),
+        ("-1200", -1200),
+        ("－１２００", -1200),  # 全角マイナス
+        ("−1200", -1200),  # 数学のマイナス記号
+        ("▲1,200", -1200),
+        ("△1,200", -1200),
+        ("(1,200)", -1200),
+        ("1200-", -1200),
+        ("-¥1,200", -1200),
+        ("¥-1,200", -1200),
+        ("1200.00", 1200),
+        ("1,200.0", 1200),
+        ("0", 0),
+    ],
+)
+def test_parse_amount_ok(text, expected):
+    assert parse_amount(text) == expected
+
+
+@pytest.mark.parametrize(
+    ("text", "reason"),
+    [
+        ("", "金額が空です"),
+        ("   ", "金額が空です"),
+        ("abc", "金額として解釈できません"),
+        ("¥", "金額として解釈できません"),
+        ("12a0", "金額として解釈できません"),
+        ("1,20", "桁区切りのカンマ位置が不正です"),
+        ("12,00,000", "桁区切りのカンマ位置が不正です"),
+        ("1200.5", "円未満の端数があります"),
+        ("1200.x", "金額として解釈できません"),
+        ("--1200", "金額として解釈できません"),
+    ],
+)
+def test_parse_amount_bad(text, reason):
+    with pytest.raises(ValueError, match=reason):
+        parse_amount(text)
+
+
+# ---------------------------------------------------------------- parse_date
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "2026-11-01",
+        "2026/11/01",
+        "2026/11/1",
+        "2026.11.01",
+        "20261101",
+        "2026年11月1日",
+        "２０２６／１１／０１",
+        "26/11/01",
+        "2026/11/01 12:34",
+        " 2026/11/01 ",
+    ],
+)
+def test_parse_date_ok(text):
+    assert parse_date(text) == date(2026, 11, 1)
+
+
+@pytest.mark.parametrize(
+    ("text", "reason"),
+    [
+        ("", "日付が空です"),
+        ("2026/13/01", "日付として解釈できません"),
+        ("2026/02/30", "日付として解釈できません"),
+        ("昨日", "日付として解釈できません"),
+    ],
+)
+def test_parse_date_bad(text, reason):
+    with pytest.raises(ValueError, match=reason):
+        parse_date(text)
+
+
+def test_parse_date_custom_formats():
+    assert parse_date("01/11/2026", ("%d/%m/%Y",)) == date(2026, 11, 1)
+    with pytest.raises(ValueError):
+        parse_date("2026/11/01", ("%d/%m/%Y",))
+
+
+# ---------------------------------------------------------------- decode_bytes
+
+
+def test_decode_bytes_utf8_bom_and_cp932():
+    text = "利用日,利用金額\n2026/11/01,1200\n"
+    assert decode_bytes(text.encode("utf-8-sig")) == text
+    assert decode_bytes(text.encode("utf-8")) == text
+    assert decode_bytes(text.encode("cp932")) == text
+
+
+def test_decode_bytes_unknown():
+    with pytest.raises(ImportFormatError, match="文字コード"):
+        decode_bytes(b"\x81\xff\xfe")
+
+
+# ---------------------------------------------------------------- import_statement
+
+
+def test_card_statement():
+    text = (
+        "利用日,利用店名・商品名,利用者,支払方法,利用金額,支払手数料,支払総額\n"
+        '2026/11/01,スーパー,本人,1回払い,"1,200",0,"1,200"\n'
+        "2026/11/03,カフェ,本人,1回払い,800,0,800\n"
+        "2026/11/05,返品,本人,1回払い,-500,0,-500\n"
+    )
+    r = import_statement(text)
+    assert r.ok
+    assert r.expenses == [
+        Expense(date(2026, 11, 1), "未分類", 1200, "スーパー"),
+        Expense(date(2026, 11, 3), "未分類", 800, "カフェ"),
+        Expense(date(2026, 11, 5), "未分類", -500, "返品"),
+    ]
+
+
+def test_bank_statement_with_preamble_and_split_columns():
+    text = (
+        "口座番号,普通 1234567\n"
+        "照会期間,2026/11/01～2026/11/30\n"
+        "\n"
+        "取引日,摘要,お引出し,お預入れ,差引残高\n"
+        '2026年11月1日,カード,"10,000",,"90,000"\n'
+        '2026年11月2日,給与,,"250,000","340,000"\n'
+        '2026年11月3日,電気代,0,,"335,000"\n'
+        '2026年11月4日,振替,"5,000",0,"330,000"\n'
+    )
+    r = import_statement(text)
+    assert r.ok, r.issues
+    assert [(e.day.day, e.amount, e.memo) for e in r.expenses] == [
+        (1, 10000, "カード"),
+        (2, -250000, "給与"),
+        (3, 0, "電気代"),
+        (4, 5000, "振替"),
+    ]
+
+
+def test_bank_row_with_trailing_cells_omitted():
