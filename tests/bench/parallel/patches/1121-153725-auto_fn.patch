@@ -0,0 +1,50 @@
+"""Import bank / card CSV rows with varied headers and amount styles."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from kakeibo._imp_amount import parse_amount
+from kakeibo._imp_date import parse_date
+from kakeibo._imp_header import map_columns
+from kakeibo._imp_row import convert_row
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class RowError:
+    line: int  # 1-based line number in the source
+    reason: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    expenses: list[Expense]
+    errors: list[RowError]
+
+
+def import_rows(
+    rows: list[list[str]], *, flip: bool = False, first_line: int = 1
+) -> ImportResult:
+    """rows[0] is the header. Blank rows are skipped; bad rows are reported, not fatal.
+
+    flip=True for sources where outflows are negative.
+    """
+    if not rows:
+        return ImportResult([], [RowError(first_line, "ヘッダー行がありません")])
+    try:
+        cols = map_columns(rows[0])
+    except ValueError as e:
+        return ImportResult([], [RowError(first_line, str(e))])
+    expenses: list[Expense] = []
+    errors: list[RowError] = []
+    for i, cells in enumerate(rows[1:], start=1):
+        if not any(c.strip() for c in cells):
+            continue
+        try:
+            expenses.append(
+                convert_row(cells, cols, parse_date, parse_amount, flip=flip)
+            )
+        except ValueError as e:
+            errors.append(RowError(first_line + i, str(e)))
+    return ImportResult(expenses, errors)
