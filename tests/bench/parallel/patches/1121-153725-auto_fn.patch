@@ -0,0 +1,25 @@
+"""Map bank / card CSV header names to canonical columns."""
+
+from __future__ import annotations
+
+import unicodedata
+
+_ALIASES: dict[str, tuple[str, ...]] = {
+    "date": ("日付", "利用日", "取引日", "date"),
+    "category": ("カテゴリ", "分類", "種別", "category"),
+    "amount": ("金額", "利用金額", "出金額", "amount"),
+    "memo": ("メモ", "摘要", "内容", "店名", "memo"),
+}
+_LOOKUP = {a: k for k, names in _ALIASES.items() for a in names}
+
+
+def map_columns(header: list[str]) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for i, h in enumerate(header):
+        key = _LOOKUP.get(unicodedata.normalize("NFKC", h).strip().lower())
+        if key is not None and key not in out:
+            out[key] = i
+    missing = [k for k in ("date", "category", "amount") if k not in out]
+    if missing:
+        raise ValueError(f"必要な列がありません: {', '.join(missing)}")
+    return out
