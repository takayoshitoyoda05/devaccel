new file mode 100644
index 0000000..d08ec45
--- /dev/null
+++ b/src/kakeibo/search.py
@@ -0,0 +1,44 @@
+"""Simple expense search: category / amount range / memo text / period, AND or OR."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from datetime import date
+
+from kakeibo._q_combine import all_of, any_of, not_, search
+from kakeibo._q_pred import by_amount, by_category, by_memo, by_period
+from kakeibo.core import Expense
+
+__all__ = ["all_of", "any_of", "find", "not_", "search"]
+
+
+def find(
+    rows: list[Expense],
+    *,
+    categories: tuple[str, ...] = (),
+    amount_min: int | None = None,
+    amount_max: int | None = None,
+    memo: str | None = None,
+    start: date | None = None,
+    end: date | None = None,
+    mode: str = "and",
+) -> list[Expense]:
+    """Filter by the given conditions; unspecified conditions are ignored.
+
+    mode is "and" or "or". With no conditions, all rows are returned.
+    """
+    if mode not in ("and", "or"):
+        raise ValueError(f"mode は and / or のどちらかです: {mode!r}")
+    preds: list[Callable[[Expense], bool]] = []
+    if categories:
+        preds.append(by_category(*categories))
+    if amount_min is not None or amount_max is not None:
+        preds.append(by_amount(amount_min, amount_max))
+    if memo is not None:
+        preds.append(by_memo(memo))
+    if start is not None or end is not None:
+        preds.append(by_period(start, end))
+    if not preds:
+        return list(rows)
+    combined = all_of(*preds) if mode == "and" else any_of(*preds)
+    return search(rows, combined)
