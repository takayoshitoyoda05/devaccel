+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo._recur_next import next_due
+
+
+@pytest.mark.parametrize(
+    ("last", "day", "after", "expected"),
+    [
+        (date(2026, 10, 5), 5, None, date(2026, 11, 5)),
+        (date(2026, 12, 5), 5, None, date(2027, 1, 5)),
+        (date(2026, 1, 31), 31, None, date(2026, 2, 28)),
+        (date(2028, 1, 31), 31, None, date(2028, 2, 29)),
+        (date(2026, 10, 5), 5, date(2026, 12, 20), date(2027, 1, 5)),
+        (date(2026, 10, 5), 5, date(2026, 11, 5), date(2026, 12, 5)),
+    ],
+    ids=[
+        "next-month",
+        "year-rollover",
+        "month-end-clip-feb-2026",
+        "month-end-clip-leap-2028",
+        "after-skips-ahead",
+        "after-equal-is-not-later",
+    ],
+)
+def test_next_due_table(
+    last: date, day: int, after: date | None, expected: date
+) -> None:
+    assert next_due(last, day, after=after) == expected
+
+
+@pytest.mark.parametrize("day", [0, 32, -1])
+def test_day_out_of_range_raises(day: int) -> None:
+    with pytest.raises(ValueError, match=repr(day)):
+        next_due(date(2026, 10, 5), day)
