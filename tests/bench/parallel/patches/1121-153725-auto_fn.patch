+from datetime import date
+
+from kakeibo.compare import format_report, month_over_month
+from kakeibo.core import Expense
+
+ROWS = [
+    Expense(date(2026, 10, 3), "food", 1000),
+    Expense(date(2026, 10, 9), "home", 900),
+    Expense(date(2026, 11, 2), "food", 1500),
+    Expense(date(2026, 11, 8), "fun", 300),
+]
+
+
+def test_month_over_month():
+    ch = {c.category: c for c in month_over_month(ROWS, "2026-11")}
+    assert ch["food"].delta == 500 and ch["food"].kind == "増"
+    assert ch["home"].delta == -900 and ch["home"].kind == "減"
+    assert ch["fun"].pct is None
+
+
+def test_year_boundary_and_missing_previous_month():
+    rows = [Expense(date(2026, 1, 5), "food", 700)]
+    ch = month_over_month(rows, "2026-01")
+    assert [(c.category, c.prev, c.cur) for c in ch] == [("food", 0, 700)]
+
+
+def test_format_report():
+    text = format_report("2026-11", month_over_month(ROWS, "2026-11"))
+    lines = text.splitlines()
+    assert lines[0] == "2026-10 → 2026-11"
+    assert any("food: 1,000 → 1,500 (+500円, +50.0%) 増" in ln for ln in lines)
+    assert any("fun" in ln and "—" in ln for ln in lines)
+
+
+def test_format_report_empty():
+    assert format_report("2026-11", []).endswith("(データなし)")
