@@ -0,0 +1,43 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import Expense
+from kakeibo.search import all_of, find, not_, search
+
+ROWS = [
+    Expense(date(2026, 11, 1), "food", 800, "lunch"),
+    Expense(date(2026, 11, 5), "fun", 1490, "Netflix"),
+    Expense(date(2026, 10, 20), "food", 3000, "dinner"),
+    Expense(date(2026, 11, 9), "home", 80000, "rent"),
+]
+
+
+def test_and_is_default():
+    out = find(ROWS, categories=("food",), amount_max=1000)
+    assert [e.memo for e in out] == ["lunch"]
+
+
+def test_or_mode():
+    out = find(ROWS, categories=("home",), memo="netflix", mode="or")
+    assert [e.memo for e in out] == ["Netflix", "rent"]
+
+
+def test_period_and_amount_range():
+    out = find(ROWS, start=date(2026, 11, 1), end=date(2026, 11, 30), amount_min=1000)
+    assert [e.memo for e in out] == ["Netflix", "rent"]
+
+
+def test_no_conditions_returns_copy():
+    out = find(ROWS)
+    assert out == ROWS and out is not ROWS
+
+
+def test_bad_mode():
+    with pytest.raises(ValueError):
+        find(ROWS, mode="xor")
+
+
+def test_combinators_reexported():
+    pred = all_of(lambda e: e.category == "food", not_(lambda e: e.amount > 1000))
+    assert [e.memo for e in search(ROWS, pred)] == ["lunch"]
