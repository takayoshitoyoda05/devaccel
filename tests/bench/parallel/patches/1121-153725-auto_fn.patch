+"""Month-over-month report by category."""
+
+from __future__ import annotations
+
+from kakeibo._diff_cat import Change, compare
+from kakeibo._diff_prev import prev_month
+from kakeibo.core import Expense, monthly_totals
+
+
+def month_over_month(rows: list[Expense], month: str) -> list[Change]:
+    """Changes in category totals from the previous month to `month` (YYYY-MM)."""
+    totals = monthly_totals(rows)
+    return compare(totals.get(prev_month(month), {}), totals.get(month, {}))
+
+
+def format_report(month: str, changes: list[Change]) -> str:
+    lines = [f"{prev_month(month)} → {month}"]
+    if not changes:
+        lines.append("(データなし)")
+    for c in changes:
+        pct = "—" if c.pct is None else f"{c.pct:+.1f}%"
+        lines.append(
+            f"{c.category}: {c.prev:,} → {c.cur:,} ({c.delta:+,}円, {pct}) {c.kind}"
+        )
+    return "\n".join(lines)
