+from datetime import date
+
+import pytest
+
+from kakeibo._imp_row import convert_row
+from kakeibo.core import Expense
+
+COLS = {"date": 0, "category": 1, "amount": 2, "memo": 3}
+
+
+def _pd(s: str) -> date:
+    if s == "bad":
+        raise ValueError("x")
+    return date.fromisoformat(s)
+
+
+def _pa(s: str) -> int:
+    if s == "bad":
+        raise ValueError("y")
+    return int(s)
+
+
+def test_ok():
+    got = convert_row(["2026-11-01", "食費", "1200", "昼"], COLS, _pd, _pa)
+    assert got == Expense(date(2026, 11, 1), "食費", 1200, "昼")
+
+
+def test_no_memo_column_and_blank_category():
+    cols = {"date": 0, "category": 1, "amount": 2}
+    got = convert_row(["2026-11-01", " ", "1200"], cols, _pd, _pa)
+    assert got.category == "未分類" and got.memo == ""
+
+
+def test_flip():
+    assert (
+        convert_row(["2026-11-01", "a", "-1200"], COLS, _pd, _pa, flip=True).amount
+        == 1200
+    )
+
+
+def test_zero_amount():
