--- /dev/null
+++ b/src/kakeibo/_recur_key.py
@@ -0,0 +1,32 @@
+"""Memo normalization and grouping for recurring-expense detection."""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+
+from kakeibo.core import Expense
+
+_STRIP_RE = re.compile(r"[\s0-9]+")
+
+
+def normalize_memo(memo: str) -> str:
+    """NFKC -> lowercase -> remove whitespace and digits."""
+    text = unicodedata.normalize("NFKC", memo).lower()
+    return _STRIP_RE.sub("", text)
+
+
+def group_by_key(rows: list[Expense]) -> dict[tuple[str, str], list[Expense]]:
+    """Group by (category, normalized memo). Rows with empty normalized memo are skipped.
+
+    Each group is sorted by day ascending. The input list is not modified.
+    """
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        key_memo = normalize_memo(e.memo)
+        if not key_memo:
+            continue
+        groups.setdefault((e.category, key_memo), []).append(e)
+    for members in groups.values():
+        members.sort(key=lambda e: e.day)
+    return groups
