+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo._recur_key import group_by_key, normalize_memo
+from kakeibo.core import Expense
+
+
+@pytest.mark.parametrize(
+    ("memo", "expected"),
+    [
+        ("Netflix 11月", "netflix月"),
+        ("ＮＥＴＦＬＩＸ", "netflix"),
+        ("  12345 ", ""),
+    ],
+)
+def test_normalize_memo_table(memo: str, expected: str) -> None:
+    assert normalize_memo(memo) == expected
+
+
+def test_normalize_memo_same_for_month_variants() -> None:
+    assert normalize_memo("Netflix 11月") == normalize_memo("netflix 12月")
+
+
+def test_normalize_memo_empty_input() -> None:
+    assert normalize_memo("") == ""
+
+
+def test_group_by_key_table_counts() -> None:
+    rows = [
+        Expense(date(2026, 1, 1), "food", 100, "A 1"),
+        Expense(date(2026, 2, 1), "food", 100, "a 2"),
+        Expense(date(2026, 3, 1), "fun", 100, "a"),
+    ]
+    groups = group_by_key(rows)
+    assert len(groups) == 2
+    assert len(groups[("food", "a")]) == 2
+    assert len(groups[("fun", "a")]) == 1
+
+
+def test_group_by_key_sorts_each_group_by_day_ascending() -> None:
+    rows = [
+        Expense(date(2026, 3, 1), "food", 100, "a"),
+        Expense(date(2026, 1, 1), "food", 100, "a"),
+        Expense(date(2026, 2, 1), "food", 100, "a"),
+    ]
+    days = [e.day for e in group_by_key(rows)[("food", "a")]]
+    assert days == [date(2026, 1, 1), date(2026, 2, 1), date(2026, 3, 1)]
+
+
+def test_group_by_key_excludes_empty_normalized_memo() -> None:
+    rows = [
+        Expense(date(2026, 1, 1), "food", 100, "  12345 "),
+        Expense(date(2026, 1, 2), "food", 100, ""),
+        Expense(date(2026, 1, 3), "food", 100, "a"),
+    ]
+    groups = group_by_key(rows)
+    assert list(groups) == [("food", "a")]
+
+
+def test_group_by_key_does_not_modify_input() -> None:
+    rows = [
+        Expense(date(2026, 3, 1), "food", 100, "a"),
+        Expense(date(2026, 1, 1), "food", 100, "a"),
+    ]
+    snapshot = list(rows)
+    group_by_key(rows)
+    assert rows == snapshot
