+"""Convert one CSV row into an Expense."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from datetime import date
+
+from kakeibo.core import Expense
+
+
+def convert_row(
+    cells: list[str],
+    cols: dict[str, int],
+    parse_date: Callable[[str], date],
+    parse_amount: Callable[[str], int],
+    *,
+    flip: bool = False,
+) -> Expense:
+    def cell(name: str) -> str:
+        i = cols.get(name)
+        if i is None or i >= len(cells):
+            raise ValueError(f"列 {name} がありません")
+        return cells[i]
+
+    try:
+        day = parse_date(cell("date"))
+    except ValueError as e:
+        raise ValueError(f"日付: {e}") from None
+    try:
+        amount = parse_amount(cell("amount"))
+    except ValueError as e:
+        raise ValueError(f"金額: {e}") from None
+    if flip:
+        amount = -amount
+    if amount <= 0:
+        raise ValueError(f"金額が支出ではありません: {amount}")
+    category = cell("category").strip() or "未分類"
+    memo = (
+        cells[cols["memo"]].strip() if cols.get("memo", len(cells)) < len(cells) else ""
+    )
+    return Expense(day, category, amount, memo)
