@@ -0,0 +1,29 @@
+"""Per-category change between two months."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class Change:
+    category: str
+    prev: int
+    cur: int
+    delta: int
+    pct: float | None
+    kind: str
+
+
+def compare(prev: dict[str, int], cur: dict[str, int]) -> list[Change]:
+    out: list[Change] = []
+    for cat in set(prev) | set(cur):
+        p, c = prev.get(cat, 0), cur.get(cat, 0)
+        delta = c - p
+        pct = None if p == 0 else round(delta / p * 100, 1)
+        if p == 0 and delta == 0:
+            pct = 0.0
+        kind = "増" if delta > 0 else "減" if delta < 0 else "変化なし"
+        out.append(Change(cat, p, c, delta, pct, kind))
+    out.sort(key=lambda ch: (-abs(ch.delta), ch.category))
+    return out
