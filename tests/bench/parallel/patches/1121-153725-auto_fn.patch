@@ -0,0 +1,18 @@
+"""Parse amount strings from bank / card CSVs into signed yen integers."""
+
+from __future__ import annotations
+
+import unicodedata
+
+
+def parse_amount(s: str) -> int:
+    t = unicodedata.normalize("NFKC", s).strip()
+    neg = False
+    if t.startswith("(") and t.endswith(")"):
+        neg, t = True, t[1:-1].strip()
+    if t[:1] in ("▲", "△", "-", "−"):
+        neg, t = True, t[1:].strip()
+    t = t.replace("¥", "").replace("円", "").replace(",", "").strip()
+    if not t.isascii() or not t.isdigit():
+        raise ValueError(f"金額を解釈できません: {s!r}")
+    return -int(t) if neg else int(t)
