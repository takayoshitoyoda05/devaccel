new file mode 100644
index 0000000..65bf4f4
--- /dev/null
+++ b/src/kakeibo/_recur_detect.py
@@ -0,0 +1,42 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import date
+from itertools import pairwise
+
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Monthly:
+    day: int
+    amount: int
+    count: int
+    last: date
+
+
+def _lower_median(values: list[int]) -> int:
+    s = sorted(values)
+    return s[(len(s) - 1) // 2]
+
+
+def detect_monthly(
+    rows: list[Expense],
+    *,
+    min_count: int = 3,
+    day_tol: int = 3,
+    amount_tol: float = 0.1,
+) -> Monthly | None:
+    if not rows or len(rows) < min_count:
+        return None
+    ordered = sorted(rows, key=lambda e: e.day)
+    idx = [e.day.year * 12 + e.day.month for e in ordered]
+    if any(b - a != 1 for a, b in pairwise(idx)):
+        return None
+    day = _lower_median([e.day.day for e in ordered])
+    amount = _lower_median([e.amount for e in ordered])
+    if any(abs(e.day.day - day) > day_tol for e in ordered):
+        return None
+    if any(abs(e.amount - amount) > abs(amount) * amount_tol for e in ordered):
+        return None
+    return Monthly(day, amount, len(ordered), ordered[-1].day)
