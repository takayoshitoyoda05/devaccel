+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.recurring import find_recurring
+
+
+def _e(m: int, d: int, cat: str, amt: int, memo: str) -> Expense:
+    return Expense(date(2026, m, d), cat, amt, memo)
+
+
+def test_finds_subscription_and_predicts_next():
+    rows = [
+        _e(8, 5, "fun", 1490, "Netflix 8月"),
+        _e(9, 5, "fun", 1490, "Netflix 9月"),
+        _e(10, 5, "fun", 1490, "Netflix 10月"),
+        _e(10, 12, "food", 800, "lunch"),
+    ]
+    out = find_recurring(rows)
+    assert len(out) == 1
+    r = out[0]
+    assert r.category == "fun"
+    assert r.monthly.amount == 1490
+    assert r.next_due == date(2026, 11, 5)
+
+
+def test_today_moves_next_due_forward():
+    rows = [_e(m, 5, "home", 80000, "家賃") for m in (8, 9, 10)]
+    out = find_recurring(rows, today=date(2026, 11, 21))
+    assert out[0].next_due == date(2026, 12, 5)
+
+
+def test_sorted_by_amount_desc_and_ignores_irregular():
+    rows = (
+        [_e(m, 25, "home", 80000, "家賃") for m in (8, 9, 10)]
+        + [_e(m, 1, "fun", 500, "music") for m in (8, 9, 10)]
+        + [_e(8, 3, "food", 300, "cafe"), _e(10, 3, "food", 300, "cafe")]
+    )
+    out = find_recurring(rows)
+    assert [r.category for r in out] == ["home", "fun"]
+
+
+def test_empty():
+    assert find_recurring([]) == []
