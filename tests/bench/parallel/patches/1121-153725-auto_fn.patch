+from datetime import date
+
+from kakeibo.bank_import import import_rows
+from kakeibo.core import Expense
+
+
+def test_bank_style_csv():
+    rows = [
+        ["利用日", "店名", "利用金額", "分類"],
+        ["2026/11/1", "コンビニ", "¥1,234", "食費"],
+        ["2026年11月2日", "電車", "320円", ""],
+    ]
+    r = import_rows(rows)
+    assert r.errors == []
+    assert r.expenses == [
+        Expense(date(2026, 11, 1), "食費", 1234, "コンビニ"),
+        Expense(date(2026, 11, 2), "未分類", 320, "電車"),
+    ]
+
+
+def test_bad_rows_report_line_and_reason_and_good_rows_survive():
+    rows = [
+        ["date", "category", "amount"],
+        ["2026-11-01", "food", "100"],
+        ["not-a-date", "food", "100"],
+        [],
+        ["2026-11-03", "food", "abc"],
+    ]
+    r = import_rows(rows)
+    assert len(r.expenses) == 1
+    assert [e.line for e in r.errors] == [3, 5]
+    assert r.errors[0].reason.startswith("日付")
+    assert r.errors[1].reason.startswith("金額")
+
+
+def test_flip_for_negative_outflows():
+    rows = [["date", "category", "amount"], ["2026-11-01", "food", "-500"]]
+    assert import_rows(rows, flip=True).expenses[0].amount == 500
+    assert import_rows(rows).errors[0].line == 2
+
+
+def test_missing_columns_reported_once():
+    r = import_rows([["日付", "金額"], ["2026-11-01", "100"]])
+    assert r.expenses == []
+    assert len(r.errors) == 1
+    assert r.errors[0].line == 1
+    assert "category" in r.errors[0].reason
+
+
+def test_empty_input_and_first_line_offset():
+    assert import_rows([]).errors[0].line == 1
+    rows = [["date", "category", "amount"], ["bad", "x", "1"]]
+    assert import_rows(rows, first_line=4).errors[0].line == 5
