diff --git a/tests/test__q_combine.py b/tests/test__q_combine.py
new file mode 100644
index 0000000..67e4d46
--- /dev/null
+++ b/tests/test__q_combine.py
@@ -0,0 +1,35 @@
+from datetime import date
+
+from kakeibo._q_combine import all_of, any_of, not_, search
+from kakeibo.core import Expense
+
+E = Expense(date(2026, 11, 1), "a", 1)
+T = lambda e: True
+F = lambda e: False
+
+
+def test_truth_table():
+    assert not all_of(T, F)(E)
+    assert any_of(T, F)(E)
+    assert all_of()(E)
+    assert not any_of()(E)
+    assert not not_(T)(E)
+
+
+def test_any_of_short_circuits():
+    calls: list[int] = []
+
+    def boom(e: Expense) -> bool:
+        calls.append(1)
+        return True
+
+    assert any_of(T, boom)(E)
+    assert calls == []
+
+
+def test_search_keeps_order_and_input():
+    rows = [Expense(date(2026, 11, 1), "a", n) for n in (50, 500, 5)]
+    out = search(rows, lambda e: e.amount > 100)
+    assert out == [rows[1]]
+    assert len(rows) == 3
+    assert [e.amount for e in search(rows, T)] == [50, 500, 5]
