+from __future__ import annotations
+
+from datetime import date
+
+import pytest
+
+from kakeibo._recur_detect import Monthly, detect_monthly
+from kakeibo.core import Expense
+
+
+def _rows(*items: tuple[date, int]) -> list[Expense]:
+    return [Expense(d, "c", a, "m") for d, a in items]
+
+
+def _d(m: int, d: int, y: int = 2026) -> date:
+    return date(y, m, d)
+
+
+@pytest.mark.parametrize(
+    ("items", "expected"),
+    [
+        (
+            [(_d(8, 5), 1000), (_d(9, 5), 1000), (_d(10, 5), 1000)],
+            Monthly(5, 1000, 3, _d(10, 5)),
+        ),
+        (
+            [(_d(8, 5), 1000), (_d(9, 7), 1050), (_d(10, 4), 980)],
+            Monthly(5, 1000, 3, _d(10, 4)),
+        ),
+        ([(_d(8, 5), 1000), (_d(10, 5), 1000), (_d(11, 5), 1000)], None),
+        (
+            [(_d(8, 5), 1), (_d(9, 5), 1), (_d(9, 20), 1), (_d(10, 5), 1)],
+            None,
+        ),
+        ([(_d(8, 5), 1000), (_d(9, 5), 1000)], None),
+        ([(_d(8, 5), 1000), (_d(9, 5), 1000), (_d(10, 5), 2000)], None),
+    ],
+    ids=["E1", "E2", "E3-gap", "E4-two-in-month", "E5-short", "E6-amount"],
+)
+def test_table(items: list[tuple[date, int]], expected: Monthly | None) -> None:
+    assert detect_monthly(_rows(*items)) == expected
+
+
+def test_unordered() -> None:
+    r = _rows((_d(10, 5), 1000), (_d(8, 5), 1000), (_d(9, 5), 1000))
+    assert detect_monthly(r) == Monthly(5, 1000, 3, _d(10, 5))
+
+
+def test_year_wrap() -> None:
+    r = _rows(
+        (date(2025, 11, 5), 1000), (date(2025, 12, 5), 1000), (date(2026, 1, 5), 1000)
+    )
+    assert detect_monthly(r) == Monthly(5, 1000, 3, date(2026, 1, 5))
+
+
+def test_empty() -> None:
+    assert detect_monthly([]) is None
+
+
+def test_day_tol_exceeded() -> None:
+    r = _rows((_d(8, 5), 1000), (_d(9, 5), 1000), (_d(10, 10), 1000))
+    assert detect_monthly(r) is None
