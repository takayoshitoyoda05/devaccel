new file mode 100644
index 0000000..09224eb
--- /dev/null
+++ b/src/kakeibo/recurring.py
@@ -0,0 +1,35 @@
+"""Find monthly recurring expenses and predict the next due date."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo._recur_detect import Monthly, detect_monthly
+from kakeibo._recur_key import group_by_key
+from kakeibo._recur_next import next_due
+from kakeibo.core import Expense
+
+
+@dataclass(frozen=True)
+class Recurring:
+    category: str
+    memo_key: str
+    monthly: Monthly
+    next_due: date
+
+
+def find_recurring(rows: list[Expense], today: date | None = None) -> list[Recurring]:
+    """Monthly recurring expenses, with the next expected date.
+
+    If today is given, next_due is the first expected date after today.
+    Sorted by monthly amount (desc), then category and memo key.
+    """
+    out: list[Recurring] = []
+    for (category, memo_key), group in group_by_key(rows).items():
+        m = detect_monthly(group)
+        if m is None:
+            continue
+        out.append(Recurring(category, memo_key, m, next_due(m.last, m.day, today)))
+    out.sort(key=lambda r: (-r.monthly.amount, r.category, r.memo_key))
+    return out
