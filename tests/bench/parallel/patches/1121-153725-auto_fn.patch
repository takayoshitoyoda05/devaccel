+"""Previous month for a YYYY-MM string."""
+
+from __future__ import annotations
+
+import re
+
+_RE = re.compile(r"([0-9]{4})-(0[1-9]|1[0-2])")
+
+
+def prev_month(month: str) -> str:
+    m = _RE.fullmatch(month)
+    if m is None:
+        raise ValueError(f"月の形式が不正です(YYYY-MM): {month!r}")
+    y, mo = int(m[1]), int(m[2])
+    if mo == 1:
+        return f"{y - 1:04d}-12"
+    return f"{y:04d}-{mo - 1:02d}"
