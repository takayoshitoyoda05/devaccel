@@ -0,0 +1,37 @@
+"""Search predicates over Expense."""
+
+from __future__ import annotations
+
+import unicodedata
+from collections.abc import Callable
+from datetime import date
+
+from kakeibo.core import Expense
+
+Pred = Callable[[Expense], bool]
+
+
+def by_category(*names: str) -> Pred:
+    wanted = frozenset(names)
+    return lambda e: e.category in wanted
+
+
+def by_amount(lo: int | None = None, hi: int | None = None) -> Pred:
+    if lo is not None and hi is not None and lo > hi:
+        raise ValueError(f"金額の範囲が逆です: {lo!r} > {hi!r}")
+    return lambda e: (lo is None or e.amount >= lo) and (hi is None or e.amount <= hi)
+
+
+def _norm(s: str) -> str:
+    return unicodedata.normalize("NFKC", s).lower()
+
+
+def by_memo(text: str) -> Pred:
+    needle = _norm(text)
+    return lambda e: needle in _norm(e.memo)
+
+
+def by_period(start: date | None = None, end: date | None = None) -> Pred:
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"期間が逆です: {start!r} > {end!r}")
+    return lambda e: (start is None or e.day >= start) and (end is None or e.day <= end)
