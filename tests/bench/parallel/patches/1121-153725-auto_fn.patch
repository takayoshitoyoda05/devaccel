--- /dev/null
+++ b/src/kakeibo/_recur_next.py
@@ -0,0 +1,34 @@
+from __future__ import annotations
+
+import calendar
+from datetime import date
+
+
+def _due_in(year: int, month: int, day: int) -> date:
+    """その年月の day 日を返す。存在しない日は月末に丸める (D4)。"""
+    last = calendar.monthrange(year, month)[1]
+    return date(year, month, min(day, last))
+
+
+def _next_month(year: int, month: int) -> tuple[int, int]:
+    if month == 12:
+        return year + 1, 1
+    return year, month + 1
+
+
+def next_due(last: date, day: int, after: date | None = None) -> date:
+    """固定費の次回日を返す。
+
+    last の翌月の day 日を返す。after が与えられた場合は、after より後に
+    なるまで 1 か月ずつ進める。day は 1〜31 でなければならない。
+    """
+    if not 1 <= day <= 31:
+        raise ValueError(f"日は 1〜31 の範囲で指定してください: {day!r}")
+
+    year, month = _next_month(last.year, last.month)
+    cand = _due_in(year, month, day)
+    if after is not None:
+        while cand <= after:
+            year, month = _next_month(year, month)
+            cand = _due_in(year, month, day)
+    return cand
