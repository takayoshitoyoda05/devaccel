+from datetime import date
+
+import pytest
+
+from kakeibo._q_pred import by_amount, by_category, by_memo, by_period
+from kakeibo.core import Expense
+
+
+def _e(day=date(2026, 11, 5), cat="food", amt=1000, memo=""):
+    return Expense(day, cat, amt, memo)
+
+
+def test_category():
+    assert by_category("food", "fun")(_e(cat="fun"))
+    assert not by_category()(_e())
+    assert not by_category("fun")(_e(cat="food"))
+
+
+def test_amount_inclusive_and_open_ends():
+    p = by_amount(1000, 2000)
+    assert [p(_e(amt=a)) for a in (1000, 2000, 999, 2001)] == [True, True, False, False]
+    assert by_amount(lo=1000)(_e(amt=99999))
+    assert by_amount(hi=10)(_e(amt=10))
+
+
+def test_amount_reversed():
+    with pytest.raises(ValueError):
+        by_amount(2000, 1000)
+
+
+def test_memo_case_and_width():
+    assert by_memo("netflix")(_e(memo="NETFLIX 11月"))
+    assert by_memo("ＮＥＴ")(_e(memo="net"))
+    assert by_memo("")(_e(memo=""))
+    assert not by_memo("x")(_e(memo="abc"))
+
+
+def test_period():
+    p = by_period(date(2026, 11, 1), date(2026, 11, 30))
+    assert p(_e(day=date(2026, 11, 1))) and p(_e(day=date(2026, 11, 30)))
+    assert not p(_e(day=date(2026, 10, 31)))
+    assert by_period(start=date(2026, 11, 1))(_e(day=date(2030, 1, 1)))
+    with pytest.raises(ValueError):
+        by_period(date(2026, 12, 1), date(2026, 11, 1))
