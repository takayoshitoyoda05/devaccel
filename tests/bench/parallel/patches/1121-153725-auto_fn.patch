@@ -0,0 +1,25 @@
+"""Combine predicates (AND / OR / NOT) and run a search."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+
+from kakeibo.core import Expense
+
+Pred = Callable[[Expense], bool]
+
+
+def all_of(*preds: Pred) -> Pred:
+    return lambda e: all(p(e) for p in preds)
+
+
+def any_of(*preds: Pred) -> Pred:
+    return lambda e: any(p(e) for p in preds)
+
+
+def not_(pred: Pred) -> Pred:
+    return lambda e: not pred(e)
+
+
+def search(rows: list[Expense], pred: Pred) -> list[Expense]:
+    return [e for e in rows if pred(e)]
