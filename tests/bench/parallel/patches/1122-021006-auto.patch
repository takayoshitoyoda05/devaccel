diff --git a/tests/test_types/test_Path.py b/tests/test_types/test_Path.py
index 09df7bc..e2eea11 100644
--- a/tests/test_types/test_Path.py
+++ b/tests/test_types/test_Path.py
@@ -188,3 +188,116 @@ def test_path_type(runner, cls, expect):
 
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
+
+
+@pytest.mark.parametrize(
+    "name", ["a.csv", "a.TSV", "A.Csv", "dir.d/a.csv", "a.b.tsv", ".csv"]
+)
+def test_extensions_accepts(name):
+    path_type = click.Path(extensions=[".csv", ".tsv"])
+    assert path_type.convert(name, None, None) == name
+
+
+@pytest.mark.parametrize("name", ["a.txt", "a", "a.csv.bak", "csv", "a.csvx", ""])
+def test_extensions_rejects(name):
+    path_type = click.Path(extensions=[".csv", ".tsv"])
+
+    with pytest.raises(click.BadParameter, match="must have one of these extensions"):
+        path_type.convert(name, None, None)
+
+
+def test_extensions_message_lists_allowed():
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Path(extensions=["CSV", ".tsv"]).convert("a.txt", None, None)
+
+    assert "'a.txt'" in exc_info.value.message
+    assert ".csv, .tsv" in exc_info.value.message
+
+
+def test_extensions_dot_optional_and_multi_dot():
+    assert click.Path(extensions=["csv"]).convert("A.CSV", None, None) == "A.CSV"
+    assert click.Path(extensions=[".tar.gz"]).convert("a.TAR.GZ", None, None)
+
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions=[".tar.gz"]).convert("a.gz", None, None)
+
+
+def test_extensions_default_accepts_anything():
+    assert click.Path().convert("a.whatever", None, None) == "a.whatever"
+
+
+@pytest.mark.parametrize("value", [b"a.CSV", pathlib.Path("a.csv")])
+def test_extensions_bytes_and_pathlike(value):
+    assert click.Path(extensions=[".csv"]).convert(value, None, None) == value
+
+
+def test_extensions_bytes_rejected():
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions=[".csv"]).convert(b"a.txt", None, None)
+
+
+def test_extensions_existing_file(tmp_path):
+    good = tmp_path / "a.CSV"
+    bad = tmp_path / "a.txt"
+    good.touch()
+    bad.touch()
+    path_type = click.Path(exists=True, extensions=[".csv"])
+    assert path_type.convert(str(good), None, None) == str(good)
+
+    with pytest.raises(click.BadParameter, match="extensions"):
+        path_type.convert(str(bad), None, None)
+
+
+def test_extensions_missing_file_checked_without_exists():
+    path_type = click.Path(extensions=[".csv"])
+
+    with pytest.raises(click.BadParameter, match="extensions"):
+        path_type.convert("no-such.txt", None, None)
+
+
+def test_extensions_missing_file_with_exists_reports_missing():
+    with pytest.raises(click.BadParameter, match="does not exist"):
+        click.Path(exists=True, extensions=[".csv"]).convert("no-such.csv", None, None)
+
+
+def test_extensions_directory_not_checked(tmp_path):
+    d = tmp_path / "data.txt"
+    d.mkdir()
+    assert click.Path(extensions=[".csv"]).convert(str(d), None, None) == str(d)
+
+
+def test_extensions_dash_not_checked():
+    path_type = click.Path(allow_dash=True, extensions=[".csv"])
+    assert path_type.convert("-", None, None) == "-"
+
+    with pytest.raises(click.BadParameter):
+        click.Path(extensions=[".csv"]).convert("-", None, None)
+
+
+def test_extensions_in_command(runner):
+    @click.command()
+    @click.argument("p", type=click.Path(extensions=[".csv", ".tsv"]))
+    def cli(p):
+        click.echo(p)
+
+    ok = runner.invoke(cli, ["x.TSV"])
+    assert ok.exit_code == 0
+    assert ok.output == "x.TSV\n"
+
+    bad = runner.invoke(cli, ["x.json"])
+    assert bad.exit_code == 2
+    assert "must have one of these extensions: .csv, .tsv." in bad.output
+
+
+def test_extensions_invalid_arguments():
+    with pytest.raises(TypeError, match="single string"):
+        click.Path(extensions=".csv")  # type: ignore[arg-type]
+
+    with pytest.raises(ValueError, match="must not be empty"):
+        click.Path(extensions=[])
+
+    with pytest.raises(ValueError, match="empty extension"):
+        click.Path(extensions=[""])
+
+    with pytest.raises(ValueError, match="empty extension"):
+        click.Path(extensions=["."])
