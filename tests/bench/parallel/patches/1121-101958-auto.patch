@@ -0,0 +1,206 @@
+from datetime import date
+
+import pytest
+
+from kakeibo.core import CsvError, Expense
+from kakeibo.importer import (
+    decode_csv_bytes,
+    import_bank_csv,
+    parse_amount,
+    parse_date,
+)
+
+
+@pytest.mark.parametrize(
+    "raw,want",
+    [
+        ("1234", 1234),
+        ("1,234", 1234),
+        ("¥1,234", 1234),
+        ("￥１，２３４", 1234),
+        ("1,234円", 1234),
+        ("JPY 1234", 1234),
+        ("　500　", 500),
+        ("-300", -300),
+        ("−300", -300),
+        ("△500", -500),
+        ("▲500", -500),
+        ("(500)", -500),
+        ("500-", -500),
+        ("¥-500", -500),
+        ("0", 0),
+    ],
+)
+def test_parse_amount_ok(raw, want):
+    assert parse_amount(raw) == want
+
+
+@pytest.mark.parametrize(
+    "raw", ["", "-", "12.5", "1234.0", "1,23", "abc", "(5", "--5", "1,,234"]
+)
+def test_parse_amount_bad(raw):
+    with pytest.raises(ValueError):
+        parse_amount(raw)
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "2026/1/5",
+        "2026-01-05",
+        "2026.1.5",
+        "20260105",
+        "2026年1月5日",
+        "２０２６／１／５",
+        "2026-01-05 12:34:56",
+        "2026-01-05T09:00",
+    ],
+)
+def test_parse_date_ok(raw):
+    assert parse_date(raw) == date(2026, 1, 5)
+
+
+@pytest.mark.parametrize(
+    "raw", ["2026/2/30", "26/1/5", "令和8年1月5日", "", "2026-13-01"]
+)
+def test_parse_date_bad(raw):
+    with pytest.raises(ValueError):
+        parse_date(raw)
+
+
+def test_leap_day():
+    assert parse_date("2024/2/29") == date(2024, 2, 29)
+    with pytest.raises(ValueError):
+        parse_date("2026/2/29")
+
+
+def test_card_headers_and_bom():
+    text = '﻿利用日,ご利用店名,利用金額\n2026/11/01,コンビニ,"1,200円"\n'
+    assert import_bank_csv(text) == [
+        Expense(date(2026, 11, 1), "未分類", 1200, "コンビニ")
+    ]
+
+
+def test_header_case_space_fullwidth():
+    text = " Date , AMOUNT ,ｍｅｍｏ\n2026-11-01,500,x\n"
+    assert import_bank_csv(text) == [Expense(date(2026, 11, 1), "未分類", 500, "x")]
+
+
+def test_tab_delimited():
+    text = "取引日\t摘要\t金額\n2026-11-01\tランチ\t800\n"
+    assert import_bank_csv(text)[0].amount == 800
+
+
+def test_category_column_and_default():
+    text = "date,category,amount\n2026-11-01,food,100\n2026-11-02,,200\n"
+    rows = import_bank_csv(text, default_category="other")
+    assert [r.category for r in rows] == ["food", "other"]
+
+
+def test_refund_kept_negative():
+    rows = import_bank_csv("date,amount\n2026-11-01,△500\n")
+    assert rows[0].amount == -500
+
+
+def test_split_columns_skip_deposit_only():
+    text = (
+        '日付,摘要,出金額,入金額\n2026-11-01,家賃,"80,000",\n2026-11-02,給与,,300000\n'
+    )
+    rows = import_bank_csv(text)
+    assert [(r.day.day, r.amount) for r in rows] == [(1, 80000)]
+
+
+def test_split_both_filled_is_error():
+    with pytest.raises(CsvError) as e:
+        import_bank_csv("日付,出金額,入金額\n2026-11-01,100,200\n")
+    assert e.value.errors[0][0] == 2
+    assert "両方" in e.value.errors[0][1]
+
+
+def test_split_neither_filled_is_error():
+    with pytest.raises(CsvError) as e:
+        import_bank_csv("日付,出金額,入金額\n2026-11-01,-,\n")
+    assert e.value.errors == [(2, "出金額も入金額も空です")]
+
+
+def test_single_column_blank_amount_is_error():
+    with pytest.raises(CsvError) as e:
+        import_bank_csv("date,amount\n2026-11-01,\n")
+    assert e.value.errors[0][0] == 2
+
+
+def test_errors_name_column_and_value_and_collect_all():
+    text = "日付,利用金額\n2026/2/30,100\n2026/1/1,12.5\n2026/13/1,abc\n2026/1/2,50\n"
+    with pytest.raises(CsvError) as e:
+        import_bank_csv(text)
+    errs = e.value.errors
+    assert [n for n, _ in errs] == [2, 3, 4, 4]
+    assert "日付" in errs[0][1] and "'2026/2/30'" in errs[0][1]
+    assert "利用金額" in errs[1][1] and "'12.5'" in errs[1][1]
+
+
+def test_unquoted_comma_amount_is_column_count_error():
+    with pytest.raises(CsvError) as e:
+        import_bank_csv("date,memo,amount\n2026-11-01,x,1,234円\n")
+    assert e.value.errors == [(2, "列数が違います: ヘッダー 3 列に対し 4 列")]
+
+
+def test_missing_required_columns():
+    with pytest.raises(CsvError) as e:
+        import_bank_csv("memo,foo\nx,y\n")
+    n, why = e.value.errors[0]
+    assert n == 1 and "日付" in why and "金額" in why
+
+
+def test_ambiguous_columns():
+    with pytest.raises(CsvError):
+        import_bank_csv("date,利用日,amount\n2026-11-01,2026-11-01,1\n")
+    with pytest.raises(CsvError):
+        import_bank_csv("date,amount,出金額\n2026-11-01,1,1\n")
+
+
+def test_empty_and_header_only():
+    with pytest.raises(CsvError):
+        import_bank_csv("")
+    with pytest.raises(CsvError):
+        import_bank_csv("\n  \n")
+    assert import_bank_csv("date,amount\n") == []
+
+
+def test_blank_lines_skipped_and_line_numbers_kept():
+    text = "date,amount\n\n2026-11-01,100\n\n2026-11-02,x\n"
+    with pytest.raises(CsvError) as e:
+        import_bank_csv(text)
+    assert e.value.errors[0][0] == 5
+
+
+def test_quoted_newline_reports_start_line():
+    text = 'date,memo,amount\n2026-11-01,"a\nb",100\n2026-11-02,c,bad\n'
+    with pytest.raises(CsvError) as e:
+        import_bank_csv(text)
+    assert e.value.errors[0][0] == 4
+    rows = import_bank_csv('date,memo,amount\n2026-11-01,"a\nb",100\n')
+    assert rows[0].memo == "a\nb"
+
+
+def test_crlf():
+    rows = import_bank_csv("date,amount\r\n2026-11-01,100\r\n")
+    assert rows[0].amount == 100
+
+
+def test_argument_validation():
+    with pytest.raises(TypeError):
+        import_bank_csv(b"date,amount\n")  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        import_bank_csv(None)  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        import_bank_csv("date,amount\n", default_category=None)  # type: ignore[arg-type]
+    with pytest.raises(ValueError):
+        import_bank_csv("date,amount\n", default_category="  ")
+
+
+def test_decode_csv_bytes():
+    assert decode_csv_bytes("﻿日付".encode()) == "日付"
+    assert decode_csv_bytes("日付".encode("cp932")) == "日付"
+    with pytest.raises(TypeError):
+        decode_csv_bytes("x")  # type: ignore[arg-type]
