+def test_monthly_totals_zero_pads_and_sorts_chronologically():
+    rows = [
+        Expense(date(2026, 10, 1), "food", 100),
+        Expense(date(2026, 2, 1), "food", 200),
+        Expense(date(2026, 12, 1), "food", 300),
+        Expense(date(2026, 1, 1), "food", 400),
+    ]
+    assert list(monthly_totals(rows)) == ["2026-01", "2026-02", "2026-10", "2026-12"]
+
+
+def test_main_report_single_digit_months(tmp_path, monkeypatch, capsys):
+    body = "2026-10-05,food,100,\n2026-02-05,food,3000,\n2026-03-05,food,500,\n"
+    b = _budget(
+        tmp_path,
+        {"default": {"food": 1000}, "months": {"2026-03": {"food": 400}}},
+    )
+    assert _run(monkeypatch, _csv(tmp_path, body), "--report", "--budget", b) == 0
+    cap = capsys.readouterr()
+    assert cap.out == "2026-02\tfood\t3000\n2026-03\tfood\t500\n2026-10\tfood\t100\n"
+    assert cap.err == (
+        "警告: 2026-02 food 2,000円超過 (予算 1,000 / 実績 3,000)\n"
+        "警告: 2026-03 food 100円超過 (予算 400 / 実績 500)\n"
+    )
+
