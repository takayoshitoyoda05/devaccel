@@ -0,0 +1,92 @@
+"""Detect monthly recurring expenses and predict their next occurrence."""
+
+from __future__ import annotations
+
+import calendar
+import statistics
+from dataclasses import dataclass
+from datetime import date
+
+from kakeibo.core import Expense
+
+_MIN_GAP_DAYS = 26
+_MAX_GAP_DAYS = 35
+
+
+@dataclass(frozen=True)
+class RecurringExpense:
+    category: str
+    memo: str
+    amount: int  # median yen
+    count: int
+    last_date: date
+    next_date: date
+
+
+def predict_next(last: date, typical_day: int) -> date:
+    """Same day-of-month in the month after `last`, clamped to month end."""
+    y, m = (last.year + 1, 1) if last.month == 12 else (last.year, last.month + 1)
+    return date(y, m, min(typical_day, calendar.monthrange(y, m)[1]))
+
+
+def _as_recurring(
+    category: str,
+    memo: str,
+    items: list[Expense],
+    min_occurrences: int,
+    amount_tolerance: float,
+    day_tolerance: int,
+) -> RecurringExpense | None:
+    if len(items) < min_occurrences:
+        return None
+    items = sorted(items, key=lambda e: e.day)
+    # roughly one per month
+    for a, b in zip(items, items[1:]):
+        if not _MIN_GAP_DAYS <= (b.day - a.day).days <= _MAX_GAP_DAYS:
+            return None
+    typical_day = round(statistics.median(e.day.day for e in items))
+    # day-of-month may drift only within tolerance (short months are clamped)
+    for e in items:
+        limit = calendar.monthrange(e.day.year, e.day.month)[1]
+        if abs(e.day.day - min(typical_day, limit)) > day_tolerance:
+            return None
+    amount = round(statistics.median(e.amount for e in items))
+    if any(abs(e.amount - amount) > amount * amount_tolerance for e in items):
+        return None
+    last = items[-1].day
+    return RecurringExpense(
+        category=category,
+        memo=memo,
+        amount=amount,
+        count=len(items),
+        last_date=last,
+        next_date=predict_next(last, typical_day),
+    )
+
+
+def find_recurring(
+    rows: list[Expense],
+    *,
+    min_occurrences: int = 3,
+    amount_tolerance: float = 0.1,
+    day_tolerance: int = 3,
+) -> list[RecurringExpense]:
+    """Find expenses that recur about once a month.
+
+    Rows are grouped by (category, memo). A group counts as recurring when it has at
+    least `min_occurrences` entries, consecutive entries are about a month apart,
+    the day of month stays within `day_tolerance`, and every amount is within
+    `amount_tolerance` (relative) of the median. Result is sorted by next_date,
+    then category and memo.
+    """
+    groups: dict[tuple[str, str], list[Expense]] = {}
+    for e in rows:
+        groups.setdefault((e.category, e.memo.strip().casefold()), []).append(e)
+    found: list[RecurringExpense] = []
+    for (category, memo), items in groups.items():
+        r = _as_recurring(
+            category, memo, items, min_occurrences, amount_tolerance, day_tolerance
+        )
+        if r is not None:
+            found.append(r)
+    return sorted(found, key=lambda r: (r.next_date, r.category, r.memo))
diff --git a/tests/test_recurring.py b/tests/test_recurring.py
new file mode 100644
index 0000000..a3d2a7e
--- /dev/null
+++ b/tests/test_recurring.py
@@ -0,0 +1,77 @@
+from datetime import date
+
+from kakeibo.core import Expense
+from kakeibo.recurring import find_recurring, predict_next
+
+
+def _e(d: str, cat: str, amount: int, memo: str = "") -> Expense:
+    return Expense(date.fromisoformat(d), cat, amount, memo)
+
+
+def test_detects_monthly_rent():
+    rows = [_e(f"2026-{m:02d}-02", "rent", 80000) for m in (8, 9, 10)]
+    [r] = find_recurring(rows)
+    assert (r.category, r.amount, r.count) == ("rent", 80000, 3)
+    assert r.last_date == date(2026, 10, 2)
+    assert r.next_date == date(2026, 11, 2)
+
+
+def test_ignores_non_recurring_and_too_few():
+    rows = [
+        _e("2026-09-01", "food", 1200),
+        _e("2026-09-03", "food", 800),
+        _e("2026-10-01", "rent", 80000),
+        _e("2026-11-01", "rent", 80000),
+    ]
+    assert find_recurring(rows) == []
+    assert len(find_recurring(rows, min_occurrences=2)) == 1
+
+
+def test_groups_by_memo_and_ignores_case():
+    rows = [
+        _e("2026-08-10", "sub", 1000, "Netflix"),
+        _e("2026-09-10", "sub", 1000, "netflix "),
+        _e("2026-10-10", "sub", 1000, "NETFLIX"),
+        _e("2026-08-15", "sub", 500, "music"),
+        _e("2026-09-15", "sub", 500, "music"),
+        _e("2026-10-15", "sub", 500, "music"),
+    ]
+    res = find_recurring(rows)
+    assert [r.memo for r in res] == ["netflix", "music"]  # by next_date
+
+
+def test_amount_tolerance():
+    rows = [
+        _e("2026-08-05", "util", 5000),
+        _e("2026-09-05", "util", 5200),
+        _e("2026-10-05", "util", 4900),
+    ]
+    assert len(find_recurring(rows)) == 1
+    assert find_recurring(rows, amount_tolerance=0.01) == []
+    rows[2] = _e("2026-10-05", "util", 9000)
+    assert find_recurring(rows) == []
+
+
+def test_gap_in_months_is_not_recurring():
+    rows = [_e(d, "x", 100) for d in ("2026-05-01", "2026-06-01", "2026-08-01")]
+    assert find_recurring(rows) == []
+
+
+def test_day_drift_and_month_end_clamp():
+    rows = [_e(d, "gym", 3000) for d in ("2026-11-30", "2026-12-30", "2027-01-30")]
+    [r] = find_recurring(rows)
+    assert r.next_date == date(2027, 2, 28)
+    far = [_e(d, "x", 100) for d in ("2026-08-01", "2026-09-15", "2026-10-30")]
+    assert find_recurring(far) == []
+
+
+def test_predict_next_year_wrap_and_leap():
+    assert predict_next(date(2026, 12, 25), 25) == date(2027, 1, 25)
+    assert predict_next(date(2027, 12, 31), 31) == date(2028, 1, 31)
+    assert predict_next(date(2028, 1, 31), 31) == date(2028, 2, 29)
+
+
+def test_unsorted_input_and_empty():
+    assert find_recurring([]) == []
+    rows = [_e(f"2026-{m:02d}-20", "rent", 500) for m in (10, 8, 9)]
+    assert find_recurring(rows)[0].next_date == date(2026, 11, 20)
