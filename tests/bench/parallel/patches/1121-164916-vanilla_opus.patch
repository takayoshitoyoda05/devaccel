+def test_monthly_totals_single_digit_months_zero_padded_and_sorted():
+    rows = [
+        Expense(date(2026, 10, 5), "food", 100),
+        Expense(date(2026, 2, 1), "food", 200),
+        Expense(date(2026, 1, 3), "food", 300),
+        Expense(date(2025, 12, 31), "food", 400),
+    ]
+    assert list(monthly_totals(rows)) == ["2025-12", "2026-01", "2026-02", "2026-10"]
+
+
+def test_main_budget_warns_for_single_digit_month(tmp_path, monkeypatch, capsys):
+    csv = _csv(tmp_path, "2026-02-01,food,1500,\n2026-10-01,food,500,\n")
+    b = _budget(
+        tmp_path,
+        {"default": {"food": 5000}, "months": {"2026-02": {"food": 1000}}},
+    )
+    assert _run(monkeypatch, csv, "--report", "--budget", b) == 0
+    cap = capsys.readouterr()
+    assert cap.out == "2026-02\tfood\t1500\n2026-10\tfood\t500\n"
+    assert cap.err == "警告: 2026-02 food 500円超過 (予算 1,000 / 実績 1,500)\n"
+
